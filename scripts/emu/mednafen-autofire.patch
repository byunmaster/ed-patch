 #include <atomic>
 
+#ifdef __APPLE__
+#include <objc/runtime.h>
+#include <objc/message.h>
+
+// 맥 App Nap 을 끈다(한글패치 레포) — 창이 뒤로 가거나 가려지면 macOS 가 프로세스의 타이머를
+// 늦춰 에뮬레이션이 거의 멈춘다. 자동 연타를 켜 두고 다른 일을 하려면 뒤에서도 제 속도로 돌아야
+// 한다. NSProcessInfo beginActivityWithOptions:reason: 를 objc 런타임으로 부른다(.mm 를 안 더하려고).
+static void DisableAppNap(void)
+{
+ Class pi_cls = (Class)objc_getClass("NSProcessInfo");
+ Class str_cls = (Class)objc_getClass("NSString");
+
+ if(!pi_cls || !str_cls)
+  return;
+
+ id pi = ((id (*)(Class, SEL))objc_msgSend)(pi_cls, sel_registerName("processInfo"));
+ id reason = ((id (*)(Class, SEL, const char*))objc_msgSend)(str_cls, sel_registerName("stringWithUTF8String:"), "Emulation keeps running in background");
+ // NSActivityUserInitiated(0x00FFFFFF) | NSActivityLatencyCritical(0xFF00000000)
+ id act = ((id (*)(id, SEL, unsigned long long, id))objc_msgSend)(pi, sel_registerName("beginActivityWithOptions:reason:"), 0x00FFFFFFULL | 0xFF00000000ULL, reason);
+
+ if(act)
+  ((id (*)(id, SEL))objc_msgSend)(act, sel_registerName("retain"));	// 끝날 때까지 쥐고 있는다
+}
+#endif
+
 #include "input.h"
 #include "Joystick.h"
 #include "video.h"
