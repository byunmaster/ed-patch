+//
+// 창 크기 단계 1~4 (한글패치 레포 추가). 전체화면 토글과 같은 길을 쓴다 —
+// 설정을 바꾸고 NeedVideoSync 로 비디오 스레드를 깨울 뿐이라 에뮬레이션은 안 멈춘다.
+// Video_Sync() 가 <module>.xscale/yscale 을 매번 다시 읽으므로 그대로 반영된다.
+//
+// 단계 n → 배율 n+1 (1 매우 작음=2배 … 4 큼=5배).
+//
+void GT_SetScale(unsigned n)
+{
+ static const char* const scales[5] = { "", "2.000000", "3.000000", "4.000000", "5.000000" };
+
+ if(n < 1 || n > 4 || !CurGame || !CurGame->shortname)
+  return;
+
+ MThreading::Mutex_Lock(VTMutex);
+ {
+  const std::string pfx = std::string(CurGame->shortname) + ".";
+  MDFNI_SetSetting(pfx + "xscale", scales[n]);
+  MDFNI_SetSetting(pfx + "yscale", scales[n]);
+ }
+ NeedVideoSync = true;
+ MThreading::Mutex_Unlock(VTMutex);
+
+ MThreading::Sem_Post(VTWakeupSem);
+ while(NeedVideoSync && GameThreadRun)
+ {
+  Time::SleepMS(2);
+ }
+}
+
+//
+// 지금 배율에서 한 단계 오르내린다(⌥+ / ⌥-). 설정값을 그대로 읽으므로
+// 밖에서 정한 값(emu.sh --size)과도 이어진다. 1~4 를 벗어나면 붙든다.
+//
+void GT_StepScale(int delta)
+{
+ if(!CurGame || !CurGame->shortname)
+  return;
+
+ const std::string pfx = std::string(CurGame->shortname) + ".";
+ int n = (int)(MDFN_GetSettingF(pfx + "yscale") + 0.5) - 1;
+
+ n += delta;
+ if(n < 1) n = 1;
+ if(n > 4) n = 4;
+
+ GT_SetScale((unsigned)n);
+}
+
+//
+// 소리 끄기/켜기 토글 (한글패치 레포 추가).
+//
+// mednafen 엔 mute 명령이 없다. 그런데 sound.volume 은 프레임마다 다시 읽히므로
+// (아래 espec.SoundVolume) **설정만 바꾸면 바로 먹는다** — 사운드 장치를 다시 열지
+// 않아 끊김도 리셋도 없다. 창 크기와 같은 수다.
+//
+// ⚠ 켤 때 되돌릴 값을 우리가 들고 있어야 한다. 0 에서 「원래 얼마였나」를 알 길이
+//   없기 때문이다. 처음부터 0 으로 떠 있었으면 100 으로 켠다.
+//
+void GT_ToggleMute(void)
+{
+ static unsigned saved_volume = 100;
+ const unsigned cur = MDFN_GetSettingUI("sound.volume");
+
+ if(cur)
+ {
+  saved_volume = cur;
+  MDFNI_SetSetting("sound.volume", "0");
+  MDFN_Notify(MDFN_NOTICE_STATUS, _("Sound muted."));
+ }
+ else
+ {
+  const unsigned v = saved_volume ? saved_volume : 100;
+  char tmp[16];
+  snprintf(tmp, sizeof(tmp), "%u", v);
+  MDFNI_SetSetting("sound.volume", tmp);
+  MDFN_Notify(MDFN_NOTICE_STATUS, _("Sound unmuted (%u%%)."), v);
+ }
+}
