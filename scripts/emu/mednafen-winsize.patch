+//
+// 창 크기 단계 1~4 (한글패치 레포 추가). 전체화면 토글과 같은 길을 쓴다 —
+// 설정을 바꾸고 NeedVideoSync 로 비디오 스레드를 깨울 뿐이라 에뮬레이션은 안 멈춘다.
+// Video_Sync() 가 <module>.xscale/yscale 을 매번 다시 읽으므로 그대로 반영된다.
+//
+void GT_SetScale(unsigned n)
+{
+ static const char* const scales[5] = { "", "2.000000", "3.000000", "4.000000", "5.000000" };
+
+ if(n < 1 || n > 4 || !CurGame || !CurGame->shortname)
+  return;
+
+ MThreading::Mutex_Lock(VTMutex);
+ {
+  const std::string pfx = std::string(CurGame->shortname) + ".";
+  MDFNI_SetSetting(pfx + "xscale", scales[n]);
+  MDFNI_SetSetting(pfx + "yscale", scales[n]);
+ }
+ NeedVideoSync = true;
+ MThreading::Mutex_Unlock(VTMutex);
+
+ MThreading::Sem_Post(VTWakeupSem);
+ while(NeedVideoSync && GameThreadRun)
+ {
+  Time::SleepMS(2);
+ }
+}
