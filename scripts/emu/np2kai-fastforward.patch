diff --git a/sdl/taskmng.c b/sdl/taskmng.c
index dbd8a20..ac609fd 100755
--- a/sdl/taskmng.c
+++ b/sdl/taskmng.c
@@ -2,6 +2,34 @@
 #define _POSIX_C_SOURCE 199309L
 #endif
 #include	<compiler.h>
+
+/* eiyuu-densetsu-patch: 빨리감기 키 — ` 토글 · Tab 누르는 동안 (emucap 규약과 같다) */
+#include	<fdd/diskdrv.h>
+#include	<diskimage/fddfile.h>
+#include	<pccore.h>
+#include	<nevent.h>
+static UINT8 ed_ff_hold_prev = 0;
+static int ed_mouse_locked = 0;   /* 시작은 안 잡은 상태(np2.c) */
+/* eiyuu-densetsu-patch: \ = FDD1 의 event.d88 ↔ program.d88 교체 (DOSBox-X 매퍼와 같은 키).
+   영웅전설 PC-98 이 오프닝 끝에서 「프로그램 디스크를 드라이브 1 에」라고 할 때 쓴다. */
+static void ed_swap_fdd1(void) {
+	const OEMCHAR *cur = fdd_diskname(0);
+	OEMCHAR path[MAX_PATH];
+	const char *hit; size_t base;
+	if (cur == NULL || cur[0] == '\0') return;
+	if ((hit = strstr(cur, "event.d88")) != NULL) {
+		base = (size_t)(hit - cur);
+		if (base + sizeof("program.d88") > sizeof(path)) return;
+		memcpy(path, cur, base); memcpy(path + base, "program.d88", sizeof("program.d88"));
+	} else if ((hit = strstr(cur, "program.d88")) != NULL) {
+		base = (size_t)(hit - cur);
+		if (base + sizeof("event.d88") > sizeof(path)) return;
+		memcpy(path, cur, base); memcpy(path + base, "event.d88", sizeof("event.d88"));
+	} else {
+		return;
+	}
+	diskdrv_setfdd(0, path, 0);
+}
 #include	"inputmng.h"
 #include	"taskmng.h"
 #include	"kbtrans.h"
@@ -259,6 +287,42 @@ void taskmng_rol(void) {
 				}
 			}
 #endif
+#if USE_SDL == 2
+			/* eiyuu-densetsu-patch: ` = NOWAIT 토글, Tab = 누르는 동안 NOWAIT (게스트엔 안 보낸다) */
+			if (e.key.keysym.scancode == SDL_SCANCODE_GRAVE) {
+				if (!e.key.repeat) np2oscfg.NOWAIT ^= 1;
+				break;
+			}
+			if (e.key.keysym.scancode == SDL_SCANCODE_TAB) {
+				if (!e.key.repeat) { ed_ff_hold_prev = np2oscfg.NOWAIT; np2oscfg.NOWAIT = 1; }
+				break;
+			}
+			if (e.key.keysym.scancode == SDL_SCANCODE_BACKSLASH) {
+				if (!e.key.repeat) ed_swap_fdd1();
+				break;
+			}
+			/* eiyuu-densetsu-patch: Cmd+R = 재시작(메뉴 Reset 과 같다) · Cmd+L = 마우스 잠금 토글
+			   (Cmd+M 은 macOS 최소화와 겹친다 — 유저 실측 2026-09-06) */
+			if (e.key.keysym.mod & (KMOD_LGUI | KMOD_RGUI)) {
+				if (e.key.keysym.scancode == SDL_SCANCODE_R) {
+					if (!e.key.repeat) {
+						sdlkbd_reset();
+						pccore_cfgupdate();
+						if (nevent_iswork(NEVENT_CDWAIT)) nevent_forceexecute(NEVENT_CDWAIT);
+						pccore_reset();
+					}
+					break;
+				}
+				if (e.key.keysym.scancode == SDL_SCANCODE_L) {
+					if (!e.key.repeat) {
+						ed_mouse_locked = !ed_mouse_locked;
+						SDL_SetRelativeMouseMode(ed_mouse_locked ? SDL_TRUE : SDL_FALSE);
+						SDL_ShowCursor(ed_mouse_locked ? SDL_DISABLE : SDL_ENABLE);
+					}
+					break;
+				}
+			}
+#endif
 #if USE_SDL >= 3
 			/* use command-f to toggle fullscreen/windowed mode */
 			if ((e.key.mod == SDL_KMOD_LGUI) || (e.key.mod == SDL_KMOD_RGUI)) {
@@ -318,6 +382,11 @@ void taskmng_rol(void) {
 #endif
 #endif  // __OPENDINGUX__
 
+#if USE_SDL == 2
+      if (e.key.keysym.scancode == SDL_SCANCODE_TAB) { np2oscfg.NOWAIT = ed_ff_hold_prev; break; }
+      if (e.key.keysym.scancode == SDL_SCANCODE_GRAVE) { break; }
+      if (e.key.keysym.scancode == SDL_SCANCODE_BACKSLASH) { break; }
+#endif
 #if USE_SDL >= 3
       sdlkbd_keyup(e.key.scancode);
 #elif USE_SDL == 2
