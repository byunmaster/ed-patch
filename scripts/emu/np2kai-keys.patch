+/* eiyuu-densetsu-patch: 창 크기 단계 넷 (유저 요청 2026-09-07 — 실행기 셋을 한 손가락으로).
+   ⚠ **에뮬 해상도는 안 건드린다.** SDL2 렌더러가 `SDL_RenderSetLogicalSize` 로 논리 크기를
+   잡고 있으므로, 창만 키우면 내용이 그대로 늘어난다. `scrnmng_setwidth/setheight` 는
+   **에뮬 화면 크기**(640x400 <-> 640x480 …)를 바꾸는 자리라 저기에 손대면 게임이 깨진다.
+   🔴 그런데 그 둘이 `SDL_SetWindowSize` 를 직접 불러 **우리 배율을 되돌린다** — 게임이
+   해상도를 바꾸는 순간 창이 1배로 돌아간다. 그래서 그 둘의 끝에서도 다시 건다.
+   단계는 mednafen 과 **물리 크기가 맞도록** 골랐다(PC-98 640x400 기준):
+     1 = 1배(640x400) · 2 = 1.5배(960x600) · 3 = 2배(1280x800) · 4 = 2.5배(1600x1000) */
+static const int ed_scale_num[5] = { 0, 1, 3, 2, 5 };
+static const int ed_scale_den[5] = { 0, 1, 2, 1, 2 };
+static int ed_scale_step = 0;   /* 0 = 아직 안 정했다 (첫 apply 때 환경변수/기본값으로 정한다) */
+
+void ed_scrn_applyscale(void) {
+#if !defined(__LIBRETRO__) && USE_SDL == 2
+	int w, h;
+	if (ed_scale_step == 0) {
+		const char *e = getenv("NP2KAI_WIN_SIZE");
+		ed_scale_step = (e != NULL) ? atoi(e) : 2;
+		if (ed_scale_step < 1) ed_scale_step = 1;
+		if (ed_scale_step > 4) ed_scale_step = 4;
+	}
+	if (s_window == NULL || s_renderer == NULL) return;
+	/* 🔑 **렌더러의 논리 크기를 되읽는다** — `scrnmng.width/height` 를 회전 마스크로 뒤집어
+	   맞추지 않는다. 논리 크기는 create·setwidth·setheight 가 회전까지 반영해 이미 정해
+	   놓은 값이라, 여기서 같은 판단을 되풀이하면 한쪽만 고쳐질 때 조용히 갈린다. */
+	SDL_RenderGetLogicalSize(s_renderer, &w, &h);
+	if (w <= 0 || h <= 0) return;
+	SDL_SetWindowSize(s_window,
+	                  w * ed_scale_num[ed_scale_step] / ed_scale_den[ed_scale_step],
+	                  h * ed_scale_num[ed_scale_step] / ed_scale_den[ed_scale_step]);
+#endif
+}
+
+/* 단계를 바로 건다(⌥1~4). 범위 밖이면 아무 일도 안 한다. */
+void ed_scrn_setscale(int step) {
+#if !defined(__LIBRETRO__) && USE_SDL == 2
+	if (step < 1 || step > 4) return;
+	ed_scale_step = step;
+	ed_scrn_applyscale();
+#else
+	(void)step;
+#endif
+}
+
+/* delta 만큼 단계를 옮긴다. 양끝에서는 조용히 머문다(경고음 대신 아무 일도 안 일어난다). */
+void ed_scrn_stepscale(int delta) {
+#if !defined(__LIBRETRO__) && USE_SDL == 2
+	int n;
+	if (ed_scale_step == 0) ed_scrn_applyscale();   /* 먼저 지금 단계를 확정한다 */
+	n = ed_scale_step + delta;
+	if (n < 1 || n > 4) return;
+	ed_scale_step = n;
+	ed_scrn_applyscale();
+#else
+	(void)delta;
+#endif
+}
+
