+			/* eiyuu-densetsu-patch: F5 = 퀵세이브(상태 s00) · F7 = 퀵로드 — mednafen 기본과 같은 키.
+			   flagsave/flagload 는 np2.h 에 공개돼 있다(메뉴 Status Save/Load 와 같은 경로, 강제 로드). */
+			if (e.key.keysym.scancode == SDL_SCANCODE_F5) {
+				if (!e.key.repeat) flagsave("s00");
+				break;
+			}
+			if (e.key.keysym.scancode == SDL_SCANCODE_F7) {
+				if (!e.key.repeat) flagload("s00", "Quick Load", TRUE);
+				break;
+			}
+			/* eiyuu-densetsu-patch: F10 = 재시작 — 실행기 공통(mednafen 기본 · DOSBox Staging 매퍼) */
+			if (e.key.keysym.scancode == SDL_SCANCODE_F10) {
+				if (!e.key.repeat) { sdlkbd_reset(); pccore_cfgupdate(); if (nevent_iswork(NEVENT_CDWAIT)) nevent_forceexecute(NEVENT_CDWAIT); pccore_reset(); }
+				break;
+			}
+			/* eiyuu-densetsu-patch: Cmd+R = 재시작(메뉴 Reset 과 같다) · Cmd+L = 마우스 잠금 토글
+			   (Cmd+M 은 macOS 최소화와 겹친다 — 유저 실측 2026-09-06) */
+			if (e.key.keysym.mod & (KMOD_LGUI | KMOD_RGUI)) {
+				if (e.key.keysym.scancode == SDL_SCANCODE_R) {
+					if (!e.key.repeat) {
+						sdlkbd_reset();
+						pccore_cfgupdate();
+						if (nevent_iswork(NEVENT_CDWAIT)) nevent_forceexecute(NEVENT_CDWAIT);
+						pccore_reset();
+					}
+					break;
+				}
+				if (e.key.keysym.scancode == SDL_SCANCODE_L) {
+					if (!e.key.repeat) {
+						ed_mouse_locked = !ed_mouse_locked;
+						SDL_SetRelativeMouseMode(ed_mouse_locked ? SDL_TRUE : SDL_FALSE);
+						SDL_ShowCursor(ed_mouse_locked ? SDL_DISABLE : SDL_ENABLE);
+					}
+					break;
+				}
+			}
+			/* eiyuu-densetsu-patch: ⌥- · ⌥+ = 창 크기 한 단계 (실행기 셋이 같은 손가락).
+			   🔴 **⌘가 아니라 ⌥인 이유는 mednafen 이 정했다**(유저 실측 2026-09-07).
+			      mednafen 은 수정자를 alt·shift·ctrl 로만 세고 ⌘는 아예 안 세므로,
+			      ⌘를 눌러도 기본 `-`/`=`(세이브 슬롯 증감)가 같이 먹는다. ⌥면 안 겹친다.
+			      np2kai 는 ⌘로도 되지만 **손가락이 갈리면 눈금이 아니다.**
+			   ⚠ 숫자(⌥1~4)는 쓰지 않는다 — 실행기마다 세이브 슬롯에 물려 있다. */
+			if (e.key.keysym.mod & (KMOD_LALT | KMOD_RALT)) {
+				if (e.key.keysym.scancode == SDL_SCANCODE_MINUS ||
+				    e.key.keysym.scancode == SDL_SCANCODE_KP_MINUS) {
+					if (!e.key.repeat) ed_scrn_stepscale(-1);
+					break;
+				}
+				if (e.key.keysym.scancode == SDL_SCANCODE_EQUALS ||
+				    e.key.keysym.scancode == SDL_SCANCODE_KP_PLUS) {
+					if (!e.key.repeat) ed_scrn_stepscale(+1);
+					break;
+				}
+							/* ⌥M = 소리 끄기/켜기 (mednafen 과 같은 손가락).
+				   장치를 멈췄다 다시 트는 것이라 볼륨 개념이 없어도 된다 —
+				   np2kai 엔 마스터 볼륨 API 가 없다. */
+				if (e.key.keysym.scancode == SDL_SCANCODE_M) {
+					if (!e.key.repeat) {
+						ed_muted = !ed_muted;
+						if (ed_muted) soundmng_stop(); else soundmng_play();
+					}
+					break;
+				}
+				/* ⌥1~4 = 단계를 바로. ⌥가 눌린 동안이라 게스트 숫자와 안 겹친다. */
+				if (e.key.keysym.scancode >= SDL_SCANCODE_1 &&
+				    e.key.keysym.scancode <= SDL_SCANCODE_4) {
+					if (!e.key.repeat)
+						ed_scrn_setscale(e.key.keysym.scancode - SDL_SCANCODE_1 + 1);
+					break;
+				}
+			}
+#endif
 #if USE_SDL >= 3
