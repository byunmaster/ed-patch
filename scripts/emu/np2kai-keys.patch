+void
+changescreen(UINT8 newmode)
+{
+	UINT8 change;
+	UINT8 renewal;
+	UINT8 res;
+
+	change = scrnmode ^ newmode;
+	renewal = (change & SCRNMODE_FULLSCREEN);
+	if (newmode & SCRNMODE_FULLSCREEN) {
+		renewal |= (change & SCRNMODE_HIGHCOLOR);
+	} else {
+		renewal |= (change & SCRNMODE_ROTATEMASK);
+	}
+	if (renewal) {
+		if(menuvram) {
+			menubase_close();
+		}
+		changescreeninit = 1;
+		soundmng_stop();
+		scrnmng_destroy();
+		sysmenu_destroy();
+
+		if(scrnmng_create(newmode) == SUCCESS) {
+			scrnmode = newmode;
+		} else {
+			if(scrnmng_create(scrnmode) != SUCCESS) {
+				return;
+			}
+		}
+		sysmenu_create();
+		changescreeninit = 0;
+		scrndraw_redraw();
+		soundmng_play();
+	} else {
+		scrnmode = newmode;
+	}
+}
