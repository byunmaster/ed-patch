 "lines": {
  "0": {
   "jp": "3acf1199",
   "kr": "레뮤라스"
  },
  "1": {
   "jp": "31b038d2",
   "kr": "소년 시절은 눈 깜짝할 새에 지나갔다."
  },
  "2": {
   "jp": "8ccffd65",
   "kr": "...어빈."
  },
  "3": {
   "jp": "e052efcb",
   "kr": "벌써 열여덟이 되었구나..."
  },
  "4": {
   "jp": "9995fe17",
   "kr": "이만큼 훌륭히 자라 주었으니"
  },
  "5": {
   "jp": "95dd0353",
   "kr": "나도 마지막 소임을 다한 셈이다."
  },
  "6": {
   "jp": "1291a82d",
   "kr": "네 여동생 아이멜 말인데..."
  },
  "7": {
   "jp": "f79e4909",
   "kr": "입 밖에 내지는 않았다만,"
  },
  "8": {
   "jp": "c7506d4e",
   "kr": "늘 동생을 마음에 두고 있었다는 건"
  },
  "9": {
   "jp": "355c8a5f",
   "kr": "이 할애비도 잘 안다..."
  },
  "10": {
   "jp": "4959c84f",
   "kr": "둘이 함께 있으면"
  },
  "11": {
   "jp": "3f24c039",
   "kr": "금세 눈에 띄고 마니까 말이다."
  },
  "12": {
   "jp": "e162c6d6",
   "kr": "사교도의 눈을 돌리려고"
  },
  "13": {
   "jp": "1c4434a2",
   "kr": "남매를 떼어 놓았던 것이다만..."
  },
  "14": {
   "jp": "3222d874",
   "kr": "그로부터 여덟 해인가..."
  },
  "15": {
   "jp": "e1d019ff",
   "kr": "네가 바란다면"
  },
  "16": {
   "jp": "92de6a43",
   "kr": "여기를 떠나 아이멜을 찾으러 가거라."
  },
  "17": {
   "jp": "3adae119",
   "kr": "........"
  },
  "18": {
   "jp": "0067352a",
   "kr": "아이멜이 어디 있는지는"
  },
  "19": {
   "jp": "2ff4d00c",
   "kr": "치브리 마을 어귀에 사는 디너켄이 안다."
  },
  "20": {
   "jp": "edaa4971",
   "kr": "여기 남든, 바깥세상으로 나가든..."
  },
  "21": {
   "jp": "2b381887",
   "kr": "이제는... 네 뜻대로다..."
  },
  "22": {
   "jp": "cec1a9d5",
   "kr": "앞으로는 네가 살고 싶은 대로 살거라."
  },
  "23": {
   "jp": "c8013373",
   "kr": "알겠느냐."
  },
  "24": {
   "jp": "122a6ea4",
   "kr": "할아버지..."
  },
  "25": {
   "jp": "56b11694",
   "kr": "어빈..."
  },
  "26": {
   "jp": "88a7aa4c",
   "kr": "너를 만나서... 다행이었다..."
  },
  "27": {
   "jp": "187a2587",
   "kr": "...잘 가거라."
  },
  "28": {
   "jp": "3adae119",
   "kr": "........"
  },
  "29": {
   "jp": "0bc76f6e",
   "kr": "........"
  },
  "30": {
   "jp": "70354164",
   "kr": "....."
  },
  "31": {
   "jp": "e9782c29",
   "kr": "...나, 갈게."
  },
  "32": {
   "jp": "918f7940",
   "kr": "할아버지 말씀대로"
  },
  "33": {
   "jp": "604c49b4",
   "kr": "사교도가 노리고 올지도 모르지만..."
  },
  "34": {
   "jp": "54add9c3",
   "kr": "그래도 난 역시 아이멜을 만나고 싶어."
  },
  "35": {
   "jp": "63e44b26",
   "kr": "놈들이 내가 지닌 카베사와"
  },
  "36": {
   "jp": "45d1d30a",
   "kr": "아이멜의 쿠에르포를 노린다면 더더욱."
  },
  "37": {
   "jp": "599e7100",
   "kr": "어빈은 품속의 카베사에 손을 얹고 결심했다."
  },
  "38": {
   "jp": "9b809c8e",
   "kr": "아이멜을 만나 카베사와 쿠에르포가 모이면,"
  },
  "39": {
   "jp": "0f322ba1",
   "kr": "정신전에 신보를 맡기고 여기로 돌아온다."
  },
  "40": {
   "jp": "872a93e5",
   "kr": "우리가 신보를 지니고 있지 않으면"
  },
  "41": {
   "jp": "30c703fb",
   "kr": "사교도에게 쫓길 걱정도 없을 테니까."
  },
  "42": {
   "jp": "fd9ee4e6",
   "kr": "기다려 줘, 할아버지."
  },
  "43": {
   "jp": "d3ad9b96",
   "kr": "현자 레뮤라스 여기 잠들다."
  },
  "44": {
   "jp": "c5d05312",
   "kr": "어빈은"
  },
  "45": {
   "jp": "e9d91b01",
   "kr": "을(를) 손에 넣었다."
  },
  "46": {
   "jp": "54b02234",
   "kr": "보물상자에는"
  },
  "47": {
   "jp": "4c12129a",
   "kr": "이(가) 들어 있다."
  },
  "48": {
   "jp": "7333f1f5",
   "kr": "어빈은 짐이 가득 차서"
  },
  "49": {
   "jp": "27426d28",
   "kr": "을(를) 포기했다."
  },
  "50": {
   "jp": "5d365554",
   "kr": "보물상자에는 아무것도 들어 있지 않다."
  },
  "51": {
   "jp": "c5d05312",
   "kr": "어빈은"
  },
  "52": {
