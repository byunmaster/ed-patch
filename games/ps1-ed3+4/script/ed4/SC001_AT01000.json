  },
  "66": {
   "jp": "4b3b4089",
   "kr": "여기가,"
  },
  "67": {
   "jp": "e7d314ae",
   "kr": "내가 사교도를 피해 여덟 해를 산 집이다."
  },
  "68": {
   "jp": "3adae119",
   "kr": "........"
  },
  "69": {
   "jp": "dd8eabcb",
   "kr": "변한 게 없구나."
  },
  "70": {
   "jp": "beb34b40",
   "kr": "내가 아이멜을 찾으러 떠났을 때와"
  },
  "71": {
   "jp": "86b53ee6",
   "kr": "하나도 변하지 않았어."
  },
  "72": {
   "jp": "ab78a592",
   "kr": "할아버지. 아이멜과는 만났어."
  },
  "73": {
   "jp": "fa089e6e",
   "kr": "하지만..."
  },
  "74": {
   "jp": "1901c44c",
   "kr": "이미 알고 계시겠지."
  },
  "75": {
   "jp": "3adae119",
   "kr": "........"
  },
  "76": {
   "jp": "243c1cf4",
   "kr": "...마일도 말이야..."
  },
  "77": {
   "jp": "cfbc3d8f",
   "kr": "할아버지. 내 여행은 아직 끝나지 않았어."
  },
  "78": {
   "jp": "aee224ba",
   "kr": "여기 돌아오는 건 좀 더 뒤가 될 것 같아."
  },
  "79": {
   "jp": "3adae119",
   "kr": "........"
  },
  "80": {
   "jp": "c64c8d89",
   "kr": "자, 이야기는 이쯤 해 둘게."
  },
  "81": {
   "jp": "7389ed1a",
   "kr": "진실의 섬에서 본 곳을 확인해야 하거든."
  },
  "82": {
   "jp": "14e7c6de",
   "kr": "진실의 섬에서 당신이 본 광경이 뭐였는데요?"
  },
  "83": {
   "jp": "55aaead3",
   "kr": "돌아가신 할아버지가,"
  },
  "84": {
   "jp": "2ab179e1",
   "kr": "뒤뜰 허수아비에 뭔가를 숨기는 모습이었어."
  },
  "85": {
   "jp": "ffe53db6",
   "kr": "허수아비에... 그것뿐이야?"
  },
  "86": {
   "jp": "b9981979",
   "kr": "그래. 그것뿐이다."
  },
  "87": {
   "jp": "34019618",
   "kr": "어빈은 허수아비를 살폈다."
  },
  "88": {
   "jp": "2fa7b1dd",
   "kr": "묶은 볏짚 틈에서"
  },
  "89": {
   "jp": "930ed5c4",
   "kr": "이(가) 나왔다."
  },
  "90": {
   "jp": "c5d05312",
   "kr": "어빈은"
  },
  "91": {
   "jp": "e9d91b01",
   "kr": "을(를) 손에 넣었다."
  },
  "92": {
   "jp": "363cdcb6",
   "kr": "할아버지의 편지다."
  },
  "93": {
   "jp": "79f87a44",
   "kr": "읽어 봐."
  },
  "94": {
   "jp": "6de2c0a2",
   "kr": "《레뮤라스의 편지》"
  },
  "95": {
   "jp": "e2394622",
   "kr": "네프티스의 사당."
  },
  "96": {
   "jp": "aedb974c",
   "kr": "발두스의 신령, 이스브라를 지키는 소임도"
  },
  "97": {
   "jp": "d198cc84",
   "kr": "내 대에서 그 일을 마치게 되겠지."
  },
  "98": {
   "jp": "92701620",
   "kr": "사태는 빠르게 나아가고 있다."
  },
  "99": {
   "jp": "08f6eb34",
   "kr": "신령을 둘러싼 다툼은,"
  },
  "100": {
   "jp": "c665033b",
   "kr": "사람의 앞날을 정할 만한 선택을 강요하리라."
  },
  "101": {
   "jp": "4e39d525",
   "kr": "허나 이로써 긴 대립에 결말이 난다."
  },
  "102": {
   "jp": "3b60b322",
   "kr": "노토스 숲에 사당으로 드는 입구가 있다."
  },
  "103": {
   "jp": "0d9dcbe2",
   "kr": "사당 안에서 허수아비에 숨긴 열쇠를 써라."
  },
  "104": {
   "jp": "9279ebfd",
   "kr": "알고 계셨던 거야..."
  },
  "105": {
   "jp": "9756b653",
   "kr": "할아버지는, 알고 계셨던 거야."
  },
  "106": {
   "jp": "cc0542b1",
   "kr": "레뮤라스 할아버지는"
  },
  "107": {
   "jp": "bb58a5f5",
   "kr": "이 산에서 네프티스를 지켜보고 계셨던 거야."
  },
  "108": {
   "jp": "5dbde22d",
   "kr": "노토스 숲."
  },
  "109": {
   "jp": "f1fb94fd",
   "kr": "우리가 북쪽 산이라고 부르던 곳이야."
  },
  "110": {
