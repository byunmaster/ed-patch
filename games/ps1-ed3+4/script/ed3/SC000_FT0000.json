 "lines": {
  "0": {
   "jp": "bb708123",
   "kr": "라그픽 마을"
  },
  "1": {
   "jp": "1c3909b6",
   "kr": "쥬리오 아빠"
  },
  "2": {
   "jp": "ad0e2a6b",
   "kr": "쥬리오 엄마"
  },
  "3": {
   "jp": "9f793979",
   "kr": "트리타촌장"
  },
  "4": {
   "jp": "f41cc21e",
   "kr": "크리스 아빠"
  },
  "5": {
   "jp": "14600308",
   "kr": "크리스 엄마"
  },
  "6": {
   "jp": "493dcc93",
   "kr": "페르나 부인"
  },
  "7": {
   "jp": "0b8d576a",
   "kr": "로그"
  },
  "8": {
   "jp": "d0b6da59",
   "kr": "도구점 테르노"
  },
  "9": {
   "jp": "1b89384a",
   "kr": "스콜"
  },
  "10": {
   "jp": "b9f92fd3",
   "kr": "치아나"
  },
  "11": {
   "jp": "3cfb8627",
   "kr": "픽"
  },
  "12": {
   "jp": "5b35d437",
   "kr": "날아라형제（하이퍼）"
  },
  "13": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "14": {
   "jp": "5dc71db7",
   "kr": "드디어 내일부터 순례 여행이구나."
  },
  "15": {
   "jp": "7bbaa941",
   "kr": "...내일부터인데"
  },
  "16": {
   "jp": "71e6cce2",
   "kr": "왜, 벌써 순례복을 입고 있냐?"
  },
  "17": {
   "jp": "fabe1846",
   "kr": "좋잖아."
  },
  "18": {
   "jp": "1e8b1940",
   "kr": "닳는 것도 아니고."
  },
  "19": {
   "jp": "d8590632",
   "kr": "난 걱정이에요."
  },
  "20": {
   "jp": "026dd80d",
   "kr": "이 애랑 크리스 둘만으로 괜찮을까요?"
  },
  "21": {
   "jp": "c7163cf7",
   "kr": "괜찮다니까."
  },
  "22": {
   "jp": "2df4b96c",
   "kr": "그렇게 걱정 안 해도."
  },
  "23": {
   "jp": "fbebd1b7",
   "kr": "정말이냐?"
  },
  "24": {
   "jp": "ffe6b32f",
   "kr": "전에 라그나까지 심부름 갔을 땐"
  },
  "25": {
   "jp": "ec2d7b53",
   "kr": "길 잃고 엉엉 울었으면서."
  },
  "27": {
   "jp": "86a9476d",
   "kr": "어쨌든, 길치가 날 닮으면 큰일인데."
  },
  "28": {
   "jp": "916b0cbc",
   "kr": "최악이네요."
  },
  "29": {
   "jp": "0f07a474",
   "kr": "...아무튼, 오늘 밤은 잔치다."
  },
  "30": {
   "jp": "5640932e",
   "kr": "그러네요."
  },
  "31": {
   "jp": "1ff7752e",
   "kr": "맛있는 걸 만들어야겠어요."
  },
  "32": {
   "jp": "1a8ede94",
   "kr": "그래서, 말인데."
  },
  "34": {
   "jp": "758905bb",
   "kr": "그렇지."
  },
  "35": {
   "jp": "d8012800",
   "kr": "큰 멧돼지 고기라면 출발을 축하하기에"
  },
  "36": {
   "jp": "0b53ada5",
   "kr": "딱 좋지."
  },
  "37": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는"
  },
  "38": {
   "jp": "c27974d5",
   "kr": "을(를) 건네받았다."
  },
  "39": {
   "jp": "87abd1b5",
   "kr": "자, 잠깐, 무슨 말이 하고 싶은 거야."
  },
  "40": {
   "jp": "2612908f",
   "kr": "너도 사냥꾼의 아들이라면"
  },
  "41": {
   "jp": "202ebd93",
   "kr": "제 출발을 축하할 요리 재료쯤은"
  },
  "42": {
   "jp": "922d05a2",
   "kr": "직접 잡아 오너라."
  },
  "43": {
   "jp": "be91885d",
   "kr": "난 여기서 기다리고 있으마."
  },
  "44": {
   "jp": "015caa01",
   "kr": "냄비는 준비해 둘 테니까요."
  },
  "45": {
   "jp": "1f1e4808",
   "kr": "어디가 내 축하인 거야!"
  },
  "46": {
   "jp": "151d81c7",
   "kr": "좋아, 다녀오너라."
  },
  "47": {
   "jp": "7e85f059",
   "kr": "오늘 밤은 오랜만에"
  },
  "48": {
   "jp": "b02f64b2",
   "kr": "큰 멧돼지 고기를 먹겠구나."
  },
  "49": {
   "jp": "a40a05b5",
   "kr": "서쪽 들판이라면 헤맬 일은 없으니"
  },
  "50": {
   "jp": "97685fb8",
   "kr": "마음 놓고 기다릴 수 있겠네."
  },
  "51": {
   "jp": "1518fba6",
   "kr": "그래도, 얼른 돌아오렴."
  },
  "52": {
   "jp": "26bf40ea",
   "kr": "오늘 안에 크리스랑 촌장님께 가서"
  },
  "53": {
   "jp": "857f087b",
   "kr": "여행 마음가짐을 들어 둬야 하니까요."
  },
  "54": {
   "jp": "5e1908f3",
   "kr": "큰 멧돼지 말고는"
  },
  "55": {
   "jp": "311148cc",
   "kr": "축하 재료로 안 쳐 준다."
  },
  "56": {
   "jp": "e55e7355",
   "kr": "자, 힘내고 오렴."
  },
  "57": {
   "jp": "c2fb2416",
   "kr": "요리는 엄마한테 맡기렴."
  },
  "58": {
   "jp": "ca5fb119",
   "kr": "깜짝 놀랄 만큼"
  },
  "59": {
   "jp": "93e31c92",
   "kr": "맛있는 냄비를 만들 테니까."
  },
  "60": {
   "jp": "0a0c0f22",
   "kr": "작년엔 크리스가 감기에 걸려서"
  },
  "61": {
   "jp": "3379a8a0",
   "kr": "순례가 미뤄지고 말았지만"
  },
  "62": {
   "jp": "57489044",
   "kr": "생각하기에 따라선 다행이었을지도 모르지."
  },
  "63": {
   "jp": "224e4796",
   "kr": "아무리, 말괄량이라고 해도"
  },
  "64": {
   "jp": "10640d82",
   "kr": "크리스 혼자 순례를 보내는 건"
  },
  "65": {
   "jp": "bfd5c43b",
   "kr": "역시 걱정이었으니까."
  },
  "66": {
   "jp": "260ed8cf",
   "kr": "오, 쥬리오구나. 잘 왔다."
  },
  "67": {
   "jp": "b2088af4",
   "kr": "크리스 말이냐?"
  },
  "68": {
   "jp": "3d6dfd0c",
   "kr": "그 애라면 서쪽 들판에"
  },
  "69": {
   "jp": "18f844cb",
   "kr": "약초 캐러 갔단다."
  },
  "70": {
   "jp": "40443663",
   "kr": "크리스티나, 내일 준비는 다 했니?"
  },
  "71": {
   "jp": "b691830b",
   "kr": "내일 허둥대지 않게"
  },
  "72": {
   "jp": "200daf55",
   "kr": "필요한 건 오늘 안에 챙겨 두렴."
  },
  "73": {
   "jp": "04207aa6",
   "kr": "괜찮아, 엄마."
  },
  "74": {
   "jp": "97a6ecfb",
   "kr": "내 걱정보다"
  },
  "75": {
   "jp": "b74aec09",
   "kr": "같이 가는 쥬리오가 더 걱정인걸."
  },
  "76": {
   "jp": "57b51a6f",
   "kr": "정말이지 쥬리오는"
  },
  "77": {
   "jp": "0e2116d3",
   "kr": "언제까지나 울보인 데다"
  },
  "78": {
   "jp": "7c5b42c9",
   "kr": "내가 없으면 아무것도 못 하니까...."
  },
  "79": {
   "jp": "0936c844",
   "kr": "드디어 내일부터 순례 여행인데"
  },
  "80": {
   "jp": "5be6f14b",
   "kr": "정말 괜찮을까?"
  },
  "81": {
   "jp": "fc2f78b8",
   "kr": "어머, 크리스도 참...."
  },
  "82": {
   "jp": "bc7bb9ae",
   "kr": "누나 노릇은."
  },
  "83": {
   "jp": "b06a504b",
   "kr": "쥬리오도 저래 봬도 사내다운 데가 있으니"
  },
  "84": {
   "jp": "22f32881",
   "kr": "걱정 없단다."
  },
  "85": {
   "jp": "2c192126",
   "kr": "아, 맞다 크리스."
  },
  "86": {
   "jp": "0c98bcc3",
   "kr": "약초가 떨어졌을지도 모르겠구나."
  },
  "88": {
   "jp": "2c39643b",
   "kr": "분명 여기였는데."
  },
  "89": {
   "jp": "637e821e",
   "kr": "정말이네. 약초 떨어졌어."
  },
  "90": {
   "jp": "3fcdff39",
   "kr": "저번에, 로그 씨가 목수 일로 다쳤을 때"
  },
  "92": {
   "jp": "97d5e979",
   "kr": "크리스,"
  },
  "93": {
   "jp": "e46970e0",
   "kr": "서쪽 들판에서 약초를 캐다 주지 않으련?"
  },
  "94": {
   "jp": "bb90cd33",
   "kr": "응, 알았어."
  },
  "95": {
   "jp": "9fc09ca2",
   "kr": "아.... 엄마의 오르골."
  },
  "97": {
   "jp": "4ea6c515",
   "kr": "고운 소리...."
  },
  "98": {
   "jp": "488f2b8f",
   "kr": "있잖아, 엄마!"
  },
  "99": {
   "jp": "744ffa82",
   "kr": "이 오르골 약속, 기억해?"
  },
  "100": {
   "jp": "333b04b4",
   "kr": "그럼, 기억하고말고."
  },
  "101": {
   "jp": "83d0745b",
   "kr": "성인식이 끝나면, 축하 선물로"
  },
  "102": {
   "jp": "b032460a",
   "kr": "크리스에게 준다는 약속이었지."
  },
  "103": {
   "jp": "2e5e6373",
   "kr": "꼭이야."
  },
  "104": {
   "jp": "eb12b068",
   "kr": "그럼, 서쪽 들판에 가서 약초 캐 올게."
  },
  "105": {
   "jp": "1ef6a471",
   "kr": "조심해서 다녀오렴."
  },
  "106": {
   "jp": "401020cb",
   "kr": "내일부터 먼 길인데"
  },
  "107": {
   "jp": "cb89606f",
   "kr": "너무 말괄량이 굴면 안 돼요."
  },
  "108": {
   "jp": "57b9db70",
   "kr": "네, 알겠습니다아."
  },
  "109": {
   "jp": "d5f923e4",
   "kr": "어머, 쥬리오. 어서 오렴."
  },
  "110": {
   "jp": "f23dcf86",
   "kr": "내일부터 크리스를 잘 부탁해."
  },
  "111": {
   "jp": "e3240212",
   "kr": "오오, 잘 왔네."
  },
  "112": {
   "jp": "aef76942",
   "kr": "내일부터의 순례 여행 얘기를"
  },
  "113": {
   "jp": "f86e3ff5",
   "kr": "해 둬야겠구먼."
  },
  "114": {
   "jp": "c462697e",
   "kr": "뭐, 큰 멧돼지를 잡으러?"
  },
  "115": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "116": {
   "jp": "d2f4898b",
   "kr": "그럼, 일이 끝나거든"
  },
  "117": {
   "jp": "07289dd1",
   "kr": "크리스티나와 함께 오게."
  },
  "118": {
   "jp": "4cfd3a17",
   "kr": "일이 끝났거든"
  },
  "119": {
   "jp": "28cd7ce9",
   "kr": "크리스티나와 함께 오게."
  },
  "120": {
   "jp": "e11d97d3",
   "kr": "이걸로 너희들도 어른 대열이구나."
  },
  "121": {
   "jp": "84b5655f",
   "kr": "오, 쥬리오냐."
  },
  "122": {
   "jp": "8c8d4c18",
   "kr": "창문 수리를 부탁받았다."
  },
  "123": {
   "jp": "5dc71db7",
   "kr": "드디어 내일부터 순례 여행이구나."
  },
  "124": {
   "jp": "0b126d84",
   "kr": "난 쥬리오네와 달리 혼자 떠났지만"
  },
  "126": {
   "jp": "4a791c20",
   "kr": "마법의 거울은 아름다웠지."
  },
  "127": {
   "jp": "7a81a051",
   "kr": "잘 들어, 마법의 거울을 볼 땐"
  },
  "128": {
   "jp": "372a31db",
   "kr": "눈 한 번 깜빡이지 마라."
  },
  "129": {
   "jp": "638f858c",
   "kr": "놓치면 분해서 잠도 안 온다고."
  },
  "130": {
   "jp": "0d948a65",
   "kr": "야, 쥬리오. 내일 준비냐?"
  },
  "131": {
   "jp": "9f12f638",
   "kr": "내일은 나도 장사 안 하니까."
  },
  "132": {
   "jp": "d71f26f7",
   "kr": "살 거면 지금이 기회야."
  },
  "133": {
   "jp": "265b31c5",
   "kr": "자, 무슨 볼일이지?"
  },
  "134": {
   "jp": "ba91b9ae",
   "kr": "뭐가 필요하냐?"
  },
  "135": {
   "jp": "ca7d7f5c",
   "kr": "그래,"
  },
  "136": {
   "jp": "d57fc884",
   "kr": "맞지?"
  },
  "137": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "138": {
   "jp": "0acce0d1",
   "kr": "면 되겠어."
  },
  "139": {
   "jp": "90cfedee",
   "kr": "뭘 팔아 줄 건데?"
  },
  "140": {
   "jp": "d57fc884",
   "kr": "맞지?"
  },
  "141": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "142": {
   "jp": "0acce0d1",
   "kr": "면 되겠어."
  },
  "143": {
   "jp": "efb0080c",
   "kr": "환전이냐?"
  },
  "145": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "146": {
   "jp": "2094011a",
   "kr": "이구나."
  },
  "147": {
   "jp": "54904258",
   "kr": "이봐 이봐, 쥬리오."
  },
  "148": {
   "jp": "3c0948d4",
   "kr": "환전할 게 없잖아."
  },
  "149": {
   "jp": "d1e1d9f3",
   "kr": "그 밖에, 무슨 볼일이 있지?"
  },
  "150": {
   "jp": "aa17ca97",
   "kr": "내일이 기대되는구나!"
  },
  "151": {
   "jp": "4c49174b",
   "kr": "성인식을 앞둔 중요한 때니"
  },
  "152": {
   "jp": "81d4fb50",
   "kr": "맨몸으로 마을 밖에 나가지 마라."
  },
  "153": {
   "jp": "509f6d7e",
   "kr": "네가 생각하는 것만큼 마수는 약하지 않다."
  },
  "154": {
   "jp": "798ea464",
   "kr": "생각나는구나."
  },
  "155": {
   "jp": "74980e64",
   "kr": "나와 그이도 순례 여행이 인연이 되어"
  },
  "156": {
   "jp": "6a70fc96",
   "kr": "맺어졌단다."
  },
  "157": {
   "jp": "17a18cb3",
   "kr": "쥬리오오, 놀자."
  },
  "158": {
   "jp": "f8cb6104",
   "kr": "좋아, 술래잡기다."
  },
  "159": {
   "jp": "a34b6d30",
   "kr": "놀아 줘, 놀아 줘어!"
  },
  "160": {
   "jp": "e5c79387",
   "kr": "아아, 눈이 핑 돈다."
  },
  "161": {
   "jp": "7ef9443e",
   "kr": "더어!"
  },
  "162": {
   "jp": "02a00e47",
   "kr": "이제부터는 워프는 나 혼자로 충분하다."
  },
  "163": {
   "jp": "8efd6ccb",
   "kr": "어디로 가고 싶은지 골라 봐라."
  },
  "164": {
   "jp": "b464d0e8",
   "kr": "제１장"
  },
  "165": {
   "jp": "8fb1d29e",
   "kr": "제２장"
  },
  "166": {
   "jp": "4f4b22cb",
   "kr": "제３장"
  },
  "167": {
   "jp": "63776a5d",
   "kr": "제４장"
  },
  "168": {
   "jp": "0255cd92",
   "kr": "제５장"
  },
  "169": {
   "jp": "e3741ea1",
   "kr": "제６장"
  },
  "170": {
   "jp": "40cb8c8e",
   "kr": "제７장"
