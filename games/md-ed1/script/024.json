  "0414": {
   "jp": "ec7d846815",
   "ours": "<1e>현자<04><01>나는 이 나라 제일의 현자일세. 그대들에게 주문을 내려 주지.<0d>",
   "src": "ps1:ED1SCN1:1132"
  },
  "0455": {
   "jp": "f1d8408af3",
   "ours": "<08>어느 주문을 원하는가?<07>",
   "src": "ps1:ED1SCN1:662"
  },
  "0473": {
   "jp": "4393c0166b",
   "ours": "누구의 주문책에 적어 줄까?<06>",
   "src": "ps1:ED1SCN1:663"
  },
  "0496": {
   "jp": "57576d04dd",
   "ours": "어디에 적어 줄까?<07>",
   "src": "ps1:ED1SCN1:664"
  },
  "04b0": {
   "jp": "39bed79825",
   "ours": "어디 보자, 적어 주도록 하지.<0a>",
   "src": "ps1:ED1SCN1:665"
  },
  "04cf": {
   "jp": "12b88647d2",
   "ours": "자, 다 적었네.<01><07>",
   "src": "scene:p4"
  },
  "04e5": {
   "jp": "e809d07431",
   "ours": "또 필요해지거든 언제든 오도록 하게.<00>",
   "src": "ps1:ED1SCN1:666"
  },
  "06b8": {
   "jp": "5a1495b41f",
   "ours": "<1e>여자<04><01>여긴 조리장이옵니다. 점심은 왕자님이 즐기시는 비프 스튜이옵니다.\f왕자님을 위해 온 솜씨를 기울여 요리하겠사옵니다.<00>",
   "src": "ps1:ED1SCN1:1111,ED1SCN1:1112"
  },
  "0736": {
   "jp": "086fbb45b4",
   "ours": "<1e>여자<04><01>계단 아래는 식료품 창고로 되어 있사옵니다.<00>",
   "src": "ps1:ED1SCN1:1114"
  },
  "0764": {
   "jp": "9a3b1d2523",
   "ours": "<1e>병사<04><01>아니, 세리오스 왕자님. 마을에 나가시옵니까?<00>",
   "src": "ps1:ED1SCN1:1116"
  },
  "0796": {
   "jp": "02acf7c573",
   "ours": "<1e>병사<04><01>왕자님 덕분에 베르가 광산도 활기를 되찾았다고 하옵니다.<00>",
   "src": "ps1:ED1SCN1:1118"
  },
  "07dc": {
   "jp": "164fb65f37",
   "ours": "<1e>병사<04><01>여기는 지하 감옥으로 가는 입구이옵니다. 안에 들어가셔도 재미있는 것은 하나도 없사옵니다.<00>",
   "src": "ps1:ED1SCN1:1120"
  },
  "0836": {
   "jp": "4beb07cc8b",
   "ours": "<1e>병사<04><01>아, 왕자님. 이 보물창고에는 무슨 볼일이시옵니까?<00>",
   "src": "ps1:ED1SCN1:1122"
  },
  "0870": {
   "jp": "816c4fadc0",
   "ours": "<1e>병사<04><01>아, 세리오스 왕자님. 건강해 보이시니 무엇보다 다행이옵니다.<00>",
   "src": "ps1:ED1SCN1:1123"
  },
  "08a8": {
   "jp": "93597547bb",
   "ours": "<1e>병사<04><01>아크담이 달아나 버리니 그 몬스터들도 자취를 감춰 버린 듯하옵니다.<00>",
   "src": "ps1:ED1SCN1:1125"
  },
  "08fe": {
   "jp": "001967020b",
   "ours": "<1e>병사<04><01>예전에 아크담 밑에 있던 병사들은 모두 농민이 되었다고 하옵니다.<00>",
   "src": "ps1:ED1SCN1:1126"
  }
 }
