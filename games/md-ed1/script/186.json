   "src": "ps1:ED1SCN3:44"
  },
  "0c9f": {
   "jp": "24ac4f41be",
   "ours": "돈이 없으니까 그만둘래.<06>",
   "src": "ps1:ED1SCN3:45"
  },
  "0cbe": {
   "jp": "02ba19c506",
   "ours": "너무 비싸잖아. 그런 건 못 사!!<06>",
   "src": "ps1:ED1SCN3:46"
  },
  "0ce0": {
   "jp": "e4119851a8",
   "ours": "<01>그렇습니까, 그거 아쉽군요.<00>",
   "src": "ps1:ED1SCN3:48"
  },
  "0d9c": {
   "jp": "377731cdea",
   "ours": "<1e>신부<04><01>곤란한 일이 있거든 무엇이든 내게 이야기하시오.<00>",
