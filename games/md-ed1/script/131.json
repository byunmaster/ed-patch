  "0484": {
   "jp": "03908592dd",
   "ours": "<1e>현자<04><01>나는 이 나라 사람들에게 주문을 전수하는 것이 소임일세.<0d>",
   "src": "ps1:ED1SCN1:661"
  },
  "04bd": {
   "jp": "f1d8408af3",
   "ours": "<08>어느 주문을 원하는가?<07>",
   "src": "ps1:ED1SCN1:662"
  },
  "04db": {
   "jp": "4393c0166b",
   "ours": "누구의 주문책에 적어 줄까?<06>",
   "src": "ps1:ED1SCN1:663"
  },
  "04fe": {
   "jp": "57576d04dd",
   "ours": "어디에 적어 줄까?<07>",
   "src": "ps1:ED1SCN1:664"
  },
  "0518": {
   "jp": "39bed79825",
   "ours": "어디 보자, 적어 주도록 하지.<0a>",
   "src": "ps1:ED1SCN1:665"
  },
  "0537": {
   "jp": "12b88647d2",
   "ours": "자, 다 적었네.<01><07>",
   "src": "scene:p4"
  },
  "054d": {
   "jp": "e809d07431",
   "ours": "또 필요해지거든 언제든 오도록 하게.<00>",
   "src": "ps1:ED1SCN1:666"
  },
  "05bb": {
   "jp": "fab4ecd94e",
   "ours": "<1e>밀매상<04><01>헤헤헤, 어서 옵쇼. 이번엔 떳떳한 장사입죠.\f<06>",
   "src": "ps1:ED1SCN1:1082"
  },
  "0600": {
   "jp": "6afd4432e9",
   "ours": "이런, 더는 못 가지시겠는뎁쇼.\f<06>",
   "src": "ps1:ED1SCN1:656"
  },
  "0623": {
   "jp": "210610ca32",
   "ours": "뭘 원하십니까요?<07>",
   "src": "ps1:ED1SCN1:657"
  },
  "063b": {
   "jp": "2877ff951a",
   "ours": "<0e>입니까요. 보십쇼, 진짜 있잖습니까요.\f<06>",
   "src": "ps1:ED1SCN1:1086"
  },
  "0664": {
   "jp": "66f19a1f8d",
   "ours": "또 들러 주십쇼.<00>",
   "src": "ps1:ED1SCN1:655"
  },
  "06cc": {
   "jp": "2adccceaf9",
   "ours": "<1e>무기점<04><01>아니 왕자님, 건강해 보이시니 무엇보다 다행입니다.<07>",
   "src": "ps1:ED1SCN1:1047"
  },
  "0707": {
   "jp": "fd7fc2c659",
   "ours": "또 오십시오.<00>",
   "src": "ps1:ED1SCN1:1048"
  },
  "079e": {
   "jp": "492a946f75",
   "ours": "<1e>도구점<04><01>아니 왕자님, 건강해 보이시니 무엇보다 다행입니다.<07>",
   "src": "ps1:ED1SCN1:1047"
  },
  "07d9": {
   "jp": "227a564cd1",
   "ours": "어떻게 하시겠습니까?<07>",
   "src": "scene:p4"
  },
  "07ec": {
   "jp": "fd7fc2c659",
   "ours": "또 오십시오.<00>",
   "src": "ps1:ED1SCN1:1048"
  },
  "080d": {
   "jp": "de6c9b3cf8",
   "ours": "이런? 더는 못 가지실 것 같군요.\f<06>",
   "src": "ps1:ED1SCN1:124"
  },
  "0831": {
   "jp": "b324606d0b",
   "ours": "어느 것을 사시겠습니까?<07>",
   "src": "ps1:ED1SCN1:125"
  },
  "084b": {
   "jp": "6582e5a4b8",
   "ours": "<0e> 말이군요. 감사합니다.\f<06>",
   "src": "scene:p4"
  },
  "0876": {
   "jp": "f33fb80d40",
   "ours": "어느 것을 파시겠습니까?<07>",
   "src": "ps1:ED1SCN1:127"
  },
  "0891": {
   "jp": "2070a9476a",
   "ours": " Gold가 되는데 그래도 괜찮으시겠습니까?<01><07>",
   "src": "scene:p4"
  },
  "08bd": {
   "jp": "10b48fb91a",
   "ours": "그거 아쉽습니다…\f<07>",
   "src": "ps1:ED1SCN1:129"
  },
  "08d6": {
   "jp": "bde3297c7a",
   "ours": "정말 감사합니다.<07>",
   "src": "ps1:ED1SCN1:130"
  },
  "09e6": {
   "jp": "ed3eeb1b4f",
   "ours": "<1e>여자<04><01>왕자님 덕분에 이 마을도 예전의 평화로운 항구 마을로 돌아왔어요. 정말 감사합니다.<00>",
   "src": "ps1:ED1SCN1:676"
  },
  "0a48": {
   "jp": "b0b6cd3a76",
   "ours": "<1e>남자<04><01>왕자님, 마을 외곽에 있던 그 밀매상 말씀인데요.\f그자 풀려난 모양인데 이번에는 뭔가 이상한 걸 팔고 있습니다.<00>",
