  },
  "0472": {
   "jp": "de6c9b3cf8",
   "ours": "이런? 더는 못 가지실 것 같군요.\f<06>",
   "src": "ps1:ED1SCN1:124"
  },
  "0496": {
   "jp": "b324606d0b",
