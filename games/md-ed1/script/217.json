 "streams": {
  "0550": {
   "jp": "2c462c579a",
   "ours": "<1e>현자<04><01>나는 매우 강력한 주문을 알고 있네. 그대들에게도 가르쳐 주겠네.<0d>",
   "src": "ps1:ED1SCN5:936"
  },
  "059f": {
   "jp": "57092ac622",
   "ours": "<08>어느 주문을 적을까?<07>",
   "src": "ps1:ED1SCN3:533"
  },
  "05bb": {
   "jp": "ca53360999",
   "ours": "누구의 주문책에 적을까?<07>",
   "src": "ps1:ED1SCN3:534"
  },
  "05da": {
