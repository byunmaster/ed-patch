  },
  "03b2": {
   "jp": "2070a9476a",
   "ours": " Gold가 되는데 그래도 괜찮으시겠습니까?<01><07>",
   "src": "scene:p4"
  },
  "03de": {
   "jp": "f89e715618",
   "ours": "그거 아쉽습니다…\f<07>",
