  },
  "39": {
   "jp": "89aee16d23",
   "kr": "죄송합니다."
  },
  "40": {
   "jp": "fe191385d6",
   "kr": "이런 말을 당신께 해 봐야 소용없는데."
  },
  "41": {
   "jp": "ae99fa6de1",
   "kr": "디너켄 님을 만나서"
  },
  "42": {
   "jp": "1891073be3",
