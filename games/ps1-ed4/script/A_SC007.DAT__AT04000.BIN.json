  "0": {
   "jp": "5c6ab64022",
   "kr": "셴나"
  },
  "1": {
   "jp": "b363d9ce3d",
   "kr": "바스터"
  },
  "2": {
   "jp": "00cdf72cca",
   "kr": "칸"
  },
  "3": {
   "jp": "e3b023c9b4",
   "kr": "어빈은 문을 노크했다."
  },
  "4": {
   "jp": "1bf4f88345",
   "kr": "부재중인가?"
  },
  "5": {
   "jp": "4963128e21",
   "kr": "네, 네."
  },
  "6": {
   "jp": "ac7e986dff",
   "kr": "무슨 일이신가요?"
  },
  "7": {
   "jp": "bf8e815baa",
   "kr": "여기는 디너켄 님의 저택 맞죠?"
  },
  "8": {
   "jp": "93e7897d98",
   "kr": "어빈이라고 합니다."
  },
  "9": {
   "jp": "113fcb755e",
   "kr": "레뮤라스 할아버지 곁에서 왔습니다."
  },
  "10": {
   "jp": "405b09c7ea",
   "kr": "디너켄 님을 뵙고 싶은데요."
  },
  "11": {
   "jp": "c289997395",
   "kr": "디너켄 님은 그, 저기…"
  },
  "12": {
   "jp": "3d2e3a70f6",
   "kr": "누구도 만나지 않으신다고 합니다."
  },
  "13": {
   "jp": "70fcb62281",
   "kr": "죄송하지만 돌아가 주세요."
  },
  "14": {
   "jp": "9e07d6ff32",
   "kr": "모처럼 울트 마을에서 왔는데요."
  },
  "15": {
   "jp": "4fbab4f6c3",
   "kr": "어떻게든 만나게 해 주실 수 없을까요?"
  },
  "16": {
   "jp": "a75fc54397",
   "kr": "저로서는 어쩔 도리가 없습니다."
  },
  "17": {
   "jp": "b716f05a01",
   "kr": "부디 돌아가 주세요."
  },
  "18": {
   "jp": "7a3644d4a5",
   "kr": "시간을 두고 다시 와 보는 수밖에 없겠어."
  },
  "19": {
   "jp": "1df8719032",
   "kr": "문은 잠겨 있다."
  },
  "20": {
   "jp": "fcacb62283",
   "kr": "잠시만 기다려 주세요!"
  },
  "21": {
   "jp": "dc39f24d57",
   "kr": "아, 저기…"
  },
  "22": {
   "jp": "a6b777409b",
   "kr": "디, 디너켄 님의 조수 루티스가"
  },
  "23": {
   "jp": "79e88e452d",
   "kr": "만나 주시겠다고 합니다."
  },
  "24": {
   "jp": "f8c61f79fe",
   "kr": "자, 거실로 오세요."
  },
  "25": {
   "jp": "3ebbffc426",
   "kr": "모셔 왔습니다."
  },
  "26": {
   "jp": "9d1ce67ca1",
   "kr": "물러가도 좋아."
  },
  "27": {
   "jp": "9035d72eba",
   "kr": "제가 조수 루티스입니다."
  },
  "28": {
   "jp": "e5d920e2ef",
   "kr": "디너켄 님은 명상 중이시라"
  },
  "29": {
   "jp": "68cd1e31d5",
   "kr": "용건은 제가 듣겠습니다."
  },
  "30": {
   "jp": "4dfb79e9e8",
   "kr": "여동생을 찾고 있어요."
  },
  "31": {
   "jp": "68cbde60a8",
   "kr": "할아버지가… 레뮤라스가"
  },
  "32": {
   "jp": "fd0b59698c",
   "kr": "여기 오면 알 수 있을 거라고 했어요."
  },
  "33": {
   "jp": "350ad3ef60",
   "kr": "…그렇습니까."
  },
  "34": {
   "jp": "aafce486fb",
   "kr": "여동생분과"
  },
  "35": {
   "jp": "68815f0f01",
   "kr": "떨어져 지내셨나요?"
  },
  "36": {
   "jp": "b88617f94b",
   "kr": "어째서입니까?"
  },
  "37": {
   "jp": "fb1b6016b6",
   "kr": "사교도 탓이에요."
  },
  "38": {
   "jp": "56f3929fa8",
