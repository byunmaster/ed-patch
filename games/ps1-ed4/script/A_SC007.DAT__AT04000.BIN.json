  },
  "45": {
   "jp": "8a131d68db",
   "kr": "만나 주실 겁니다."
  },
  "46": {
   "jp": "c182f05cd0",
   "kr": "이 거실 오른쪽 서재에서"
  },
  "47": {
   "jp": "68ef30447e",
   "kr": "뒤쪽 동굴로 갈 수 있습니다."
  },
  "48": {
   "jp": "5b54ded1cb",
   "kr": "동굴 입구에 있는 바스터가"
  },
  "49": {
   "jp": "6e0fbd4719",
   "kr": "디너켄 님이 계신 곳까지 안내할 겁니다."
  },
  "50": {
   "jp": "c182f05cd0",
   "kr": "이 거실 오른쪽 서재에서"
  },
  "51": {
   "jp": "68ef30447e",
   "kr": "뒤쪽 동굴로 갈 수 있습니다."
  },
  "52": {
   "jp": "5b54ded1cb",
   "kr": "동굴 입구에 있는 바스터가"
  },
  "53": {
