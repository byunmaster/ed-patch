{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02200A.BIN",
 "segments": {
  "0": {
   "jp": "cd9c8b5dae",
   "kr": "알선소 소개로 온 사람인가요?"
  },
  "1": {
   "jp": "e2d3c8ad33",
   "kr": "기다리고 있었어요."
  },
  "2": {
   "jp": "4d479fcb20",
   "kr": "우리 애가 며칠째 돌아오지 않아요."
  },
  "3": {
   "jp": "636c0dddf4",
   "kr": "가출이야 늘 있는 일이지만 이번엔 너무 길어요."
  },
  "4": {
   "jp": "6a55e3e5fe",
   "kr": "제가 너무 심하게 야단친 것 같아요."
  },
  "5": {
   "jp": "52fdf5fc28",
   "kr": "아무리 그 애가 거짓말을 했다고 해도…"
  },
  "6": {
   "jp": "dcee3edbdc",
   "kr": "그 애가 내 목걸이를 잃어버려 놓고"
  },
  "7": {
   "jp": "7b894396c2",
   "kr": "도적에게 뺏겼다고 하지 뭐예요."
  },
  "8": {
   "jp": "8ca15bda61",
   "kr": "목걸이는 아무래도 좋지만"
  },
  "9": {
   "jp": "efaad1f477",
   "kr": "이상한 변명을 하는 건 좋지 않잖아요?"
  },
  "10": {
   "jp": "dc89aed677",
   "kr": "여기가 교육할 때라고 생각해서"
  },
  "11": {
   "jp": "63ad7dfecb",
   "kr": "호되게 벌을 줬어요."
  },
  "12": {
   "jp": "878d0fa69c",
   "kr": "그랬더니… 없어져 버렸어요."
  },
  "13": {
   "jp": "1c5db27e5d",
   "kr": "릭의 친구들에게 물어도 모른다고 해요."
  },
  "14": {
   "jp": "6a1782857e",
   "kr": "케니라는 아이인데요."
  },
  "15": {
   "jp": "51205f1b9b",
   "kr": "늘 저기 광장에서 릭이랑 놀았는데."
  },
  "16": {
   "jp": "8d58482366",
   "kr": "부탁이에요. 릭을 찾아 주세요."
  },
  "17": {
   "jp": "5aff90dc5d",
   "kr": "그 애는 지금쯤 배가 고플 거예요."
  },
  "18": {
   "jp": "4a6f96622a",
   "kr": "이제 화 안 났으니 돌아오라고 전해 주세요."
  },
  "19": {
   "jp": "1c5db27e5d",
   "kr": "릭의 친구들에게 물어도 모른다고 해요."
  },
  "20": {
   "jp": "6a1782857e",
   "kr": "케니라는 아이인데요."
  },
  "21": {
   "jp": "51205f1b9b",
   "kr": "늘 저기 광장에서 릭이랑 놀았는데."
  },
  "22": {
   "jp": "13b6c7309a",
   "kr": "정말 고마웠어요."
  },
  "23": {
   "jp": "6655f61597",
   "kr": "앞으로는 릭을 제대로 지켜볼게요."
  },
  "24": {
   "jp": "479bc4388c",
   "kr": "릭은 지금 모험하러 갔어."
  },
  "25": {
   "jp": "316fb30f1c",
   "kr": "이거, 비밀이야."
  },
  "26": {
   "jp": "fcd662a257",
   "kr": "뭐야, 나한테 볼일이야?"
  },
  "27": {
   "jp": "a16c61da62",
   "kr": "하하, 알았다."
  },
  "28": {
   "jp": "a0dc8f1d53",
   "kr": "릭네 아줌마가 부탁한 사람이"
  },
  "29": {
   "jp": "5bd30abf69",
   "kr": "형이구나."
  },
  "30": {
   "jp": "93217bd846",
   "kr": "말해 두는데,"
  },
  "31": {
   "jp": "4e254a7502",
   "kr": "난 릭 아줌마 편은 안 들어."
  },
  "32": {
   "jp": "1a4d3eee17",
   "kr": "아줌마는 릭을 믿지 않아."
  },
  "33": {
   "jp": "a8dc501052",
   "kr": "아줌마 목걸이는 진짜로 도적이 훔쳐 갔다고."
  },
  "34": {
   "jp": "41a49d0972",
   "kr": "릭은 목걸이를 되찾으러 갔어."
  },
  "35": {
   "jp": "98184a17e7",
   "kr": "저 지지키 동굴에 말이야. 알아?"
  },
  "36": {
   "jp": "44e4319f2f",
   "kr": "지지키 동굴엔 마수가 우글거려."
  },
  "37": {
   "jp": "c306dd915d",
   "kr": "도적들이 보물을 숨기는 곳이지."
  },
  "38": {
   "jp": "db779699ae",
   "kr": "치브리 마을 가는 길 갈림길에서 왼쪽으로 간 곳이야."
  },
  "39": {
   "jp": "38049d2969",
   "kr": "지지키 동굴까지의 산길에도 마수가 많아."
  },
  "40": {
   "jp": "433c030454",
   "kr": "릭은 거기 갔어."
  },
  "41": {
   "jp": "7e8b8cbd46",
   "kr": "지지키 동굴에는 센 마수가 득실거려."
  },
  "42": {
   "jp": "ec08e431f4",
   "kr": "릭이라면 괜찮지만 형은 가까이 가지 않는 게 좋아."
  },
  "43": {
   "jp": "67be007c2e",
   "kr": "있잖아, 형. 릭 대단하지?"
  },
  "44": {
   "jp": "f0a963d61c",
   "kr": "아줌마 목걸이를 되찾았다고."
  },
  "45": {
   "jp": "1bb40440b0",
   "kr": "릭!"
  },
  "46": {
   "jp": "ec1336feed",
   "kr": "무사해서 다행이야."
  },
  "47": {
   "jp": "bb39eb65dd",
   "kr": "창피하잖아, 엄마."
  },
  "48": {
   "jp": "ca608dacc1",
   "kr": "그만해."
  },
  "49": {
   "jp": "45bdca49f9",
   "kr": "다친 데는 없니? 아픈 데 없어?"
  },
  "50": {
   "jp": "df1cba2302",
   "kr": "배고프지 않니?"
  },
  "51": {
   "jp": "547c536c84",
   "kr": "괜찮아, 나는 어른이니까."
  },
  "52": {
   "jp": "e2efef4fe9",
   "kr": "…자, 소중한 목걸이."
  },
  "53": {
   "jp": "e5f6ade05d",
   "kr": "릭은 어머니에게 목걸이를 건넸다."
  },
  "54": {
   "jp": "2479096d19",
   "kr": "어머나!"
  },
  "55": {
   "jp": "f53db536ac",
   "kr": "또 뺏겨도 내가 되찾아 줄 테니까."
  },
  "56": {
   "jp": "dad72ac195",
   "kr": "…정말…"
  },
  "57": {
   "jp": "094d72c72c",
   "kr": "어이가 없어서 말도 안 나오네."
  },
  "58": {
   "jp": "a71306d22f",
   "kr": "정말 바보 같은 애야, 이 애는."
  },
  "59": {
   "jp": "e8839a57c8",
   "kr": "뭐야."
  },
  "60": {
   "jp": "c286595abc",
   "kr": "되찾아 줬는데 왜 바보야."
  },
  "61": {
   "jp": "632a828701",
   "kr": "이럴 땐 '고마워'라고 하는 거잖아, 보통."
  },
  "62": {
   "jp": "e022adb3e0",
   "kr": "『고마워』는 어빈 씨 일행한테 하는 거야!"
  },
  "63": {
   "jp": "48a3f9c398",
   "kr": "여러분, 정말 고맙습니다."
  },
  "64": {
   "jp": "57424d06c3",
   "kr": "뭐라고 감사 인사를 드려야 할지…"
  },
  "65": {
   "jp": "6b09a6126f",
   "kr": "어, 엄마."
  },
  "66": {
   "jp": "cc0a28bde2",
   "kr": "눈에서 침 나온다."
  },
  "67": {
   "jp": "8813216607",
   "kr": "시끄러워!"
  },
  "68": {
   "jp": "bc6b128f2b",
   "kr": "쓸데없는 소리 하지 말라고"
  },
  "69": {
   "jp": "6531691c6f",
   "kr": "늘 말하잖아!!"
  },
  "70": {
   "jp": "0b4c42927b",
   "kr": "너도 어빈 씨 일행한테 인사드려!"
  },
  "71": {
   "jp": "5fae2956b0",
   "kr": "가출이야 늘 있는 일이지만"
  },
  "72": {
   "jp": "4b8c831b10",
   "kr": "이번엔 너무 길어요."
  },
  "73": {
   "jp": "bfcc2acc0b",
   "kr": "그 애가"
  },
  "74": {
   "jp": "8f5fe50d7d",
   "kr": "내 목걸이를 잃어버려 놓고"
  },
  "75": {
   "jp": "534418fcba",
   "kr": "아줌마의 목걸이는"
  },
  "76": {
   "jp": "4bf1eb1ffb",
   "kr": "진짜로 도적이 가져간 거라고."
  },
  "77": {
   "jp": "404ad68ea5",
   "kr": "치브리 가는 길 갈림길에서"
  },
  "78": {
   "jp": "28b2c18d03",
   "kr": "왼쪽으로 가면 돼."
  },
  "79": {
   "jp": "ba625bbac0",
   "kr": "릭이라면 괜찮지만"
  },
  "80": {
   "jp": "60f1b9647f",
   "kr": "형은 가까이 가지 않는 게 좋아."
  },
  "81": {
   "jp": "1cfe6d3948",
   "kr": "이럴 땐 『고마워』라고 하는 거잖아,"
  },
  "82": {
   "jp": "2e11e05543",
   "kr": "보통."
  }
 }
}
