{
 "archive": "/D/SC307.DAT",
 "member": "..\\BIN\\DT02100.BIN",
 "segments": {
  "0": {
   "jp": "1b6c2ae7d1",
   "kr": "어이쿠…"
  },
  "1": {
   "jp": "4f89f9fadb",
   "kr": "이건 맹점이었네요."
  },
  "2": {
   "jp": "9729842cad",
   "kr": "분명 이 신전을 떠난 사람들은"
  },
  "3": {
   "jp": "1744272bdb",
   "kr": "악한 자들이 여기를 짓밟지 못하도록"
  },
  "4": {
   "jp": "cffde30f43",
   "kr": "입구에는 강력한 봉인을 해 두었을 거예요."
  },
  "5": {
   "jp": "4751ea3452",
   "kr": "그런데도 자연 낙반으로 무너진 곳으로"
  },
  "6": {
   "jp": "d2bac04217",
   "kr": "쉽게 침입할 수 있다니…"
  },
  "7": {
   "jp": "7eb8bfd7e0",
   "kr": "거기까지 계산할 수는 없겠지."
  },
  "8": {
   "jp": "916f5c5393",
   "kr": "정말이에요.",
   "auto": 1
  },
  "9": {
   "jp": "ceab5c2ee0",
   "kr": "저도 뭔가 봉인할 때는"
  },
  "10": {
   "jp": "40b3cf5c32",
   "kr": "조심해야겠어요."
  },
  "11": {
   "jp": "fc79d002d2",
   "kr": "이게 성스러운 물…"
  },
  "12": {
   "jp": "08ac07a195",
   "kr": "이 물에 호랑가시나무 잎을 담그면"
  },
  "13": {
   "jp": "ed08993f2e",
   "kr": "루티스의 저주를 푸는 약이 되는 건가."
  },
  "14": {
   "jp": "e4014ffadc",
   "kr": "저기에 담글 수 있겠네요."
  },
  "15": {
   "jp": "060d71a324",
   "kr": "그래, 해 볼게."
  },
  "16": {
   "jp": "5845b16f59",
   "kr": "어빈은 호랑가시나무 잎을 성스러운 물에 담갔다."
  },
  "17": {
   "jp": "4a138e76e8",
   "kr": "어빈은 호랑가시나무 잎을 조심스레 품에 넣었다."
  },
  "18": {
   "jp": "6521ac70f0",
   "kr": "이걸로 루티스 씨는 살 수 있어요."
  },
  "19": {
   "jp": "6af99606e7",
   "kr": "다행이야."
  },
  "20": {
   "jp": "35f21088bf",
   "kr": "이 앞은 어떻게 되어 있을까."
  },
  "21": {
   "jp": "76498e7036",
   "kr": "이 앞으로 가면 진정한 의미에서"
  },
  "22": {
   "jp": "eed62ba86d",
   "kr": "진실의 섬이 진실의 섬인 핵심에 닿을 수"
  },
  "23": {
   "jp": "3ebc17c252",
   "kr": "있을지도 모르겠네요."
  },
  "24": {
   "jp": "071141e068",
   "kr": "이 벽화는 대체…?"
  },
  "25": {
   "jp": "9fa7b35bf6",
   "kr": "대단하군."
  },
  "26": {
   "jp": "457a1f8e79",
   "kr": "도크스 사람들은 문자를 갖지 않아요."
  },
  "27": {
   "jp": "d47470f96e",
   "kr": "이게 그들이 남긴 메시지겠죠."
  },
  "28": {
   "jp": "e021bf0c66",
   "kr": "그나저나 훌륭한 벽화네요."
  },
  "29": {
   "jp": "40bd2b7415",
   "kr": "용 두 마리가 싸우고 있어."
  },
  "30": {
   "jp": "89f9b7eef5",
   "kr": "이 용은 말 그대로 용을 나타낸 게 아니라"
  },
  "31": {
   "jp": "5c658109d2",
   "kr": "신들의 싸움을 표현한 그림 같네요."
  },
  "32": {
   "jp": "d8eeb7aa57",
   "kr": "신들의 싸움…"
  },
  "33": {
   "jp": "234e27b5c8",
   "kr": "아마도 발두스와 오크툼이겠죠."
  },
  "34": {
   "jp": "000d2c9ce5",
   "kr": "이 그림만 봐서는"
  },
  "35": {
   "jp": "daa9f4c594",
   "kr": "어느 쪽이 어느 쪽인지도 알 수 없어."
  },
  "36": {
   "jp": "1059d8b55e",
   "kr": "그뿐 아니라."
  },
  "37": {
   "jp": "6feb470d42",
   "kr": "나한텐 둘 다 사악하게 보여."
  },
  "38": {
   "jp": "666f9b13ae",
   "kr": "이 벽화를 남긴 사람의 마음이 전해져서"
  },
  "39": {
   "jp": "442b807f44",
   "kr": "그렇게 느끼는 걸지도 모르겠네요."
  },
  "40": {
   "jp": "717b8083f0",
   "kr": "분명 도크스의 조상들도"
  },
  "41": {
   "jp": "69d9b44fd6",
   "kr": "같은 걸 느꼈을 거예요."
  },
  "42": {
   "jp": "af3861d8ce",
   "kr": "그건 그렇고……"
  },
  "43": {
   "jp": "9e8dacc424",
   "kr": "그들이 이 신들을 숭배한다면"
  },
  "44": {
   "jp": "6c8e6acdf4",
   "kr": "여기에 새겨 둔 것도 어느 정도 납득이 되지만"
  },
  "45": {
   "jp": "5a9efdcde1",
   "kr": "마을 모습으로 보면 그렇지도 않은 것 같군."
  },
  "46": {
   "jp": "94c09300d4",
   "kr": "그렇다면."
  },
  "47": {
   "jp": "9dae416152",
   "kr": "답은 하나예요."
  },
  "48": {
   "jp": "8052a1bbb5",
   "kr": "경고."
  },
  "49": {
   "jp": "4e1ecaec4e",
   "kr": "네, 그렇게밖에 생각할 수 없어요."
  },
  "50": {
   "jp": "3fc4aaca28",
   "kr": "후세 사람들에게 보내는 경고예요."
  },
  "51": {
   "jp": "e71bc35b97",
   "kr": "응…?"
  },
  "52": {
   "jp": "040c32b55b",
   "kr": "무슨 일이야?"
  },
  "53": {
   "jp": "994c96edb4",
   "kr": "이 공간에는 특별한 힘이 흐르고 있어요."
  },
  "54": {
   "jp": "3e99b2ff72",
   "kr": "역시 그래."
  },
  "55": {
   "jp": "967469a846",
   "kr": "이 느낌은 전에 느껴 본 적이 있는 것과"
  },
  "56": {
   "jp": "71d9dbb52a",
   "kr": "같은 것이었거든요."
  },
  "57": {
   "jp": "c1230dcb9b",
   "kr": "제 나라에 있는"
  },
  "58": {
   "jp": "82d6bccec5",
   "kr": "샤리네라 불리는 시설과 아주 비슷해요."
  },
  "59": {
   "jp": "b4db253abb",
   "kr": "그렇다면… 역시."
  },
  "60": {
   "jp": "e8c83cd299",
   "kr": "일정한 조건이 갖춰지면 영상으로 된 신탁을"
  },
  "61": {
   "jp": "74da3ebf36",
   "kr": "얻을 수 있는 걸까…"
  },
  "62": {
   "jp": "4e4457ee71",
   "kr": "그렇구나… 이거야."
  },
  "63": {
   "jp": "92bfea7ef3",
   "kr": "이곳에는 찾아온 사람에게 신탁을 내리는"
  },
  "64": {
   "jp": "255c5db638",
   "kr": "신비한 힘이 있는 것 같아요."
  },
  "65": {
   "jp": "4671d6a177",
   "kr": "신탁…?"
  },
  "66": {
   "jp": "ffe5473525",
   "kr": "그 사람이 앞으로 겪을 일."
  },
  "67": {
   "jp": "69d47cf018",
   "kr": "또 과거의 일이라도"
  },
  "68": {
   "jp": "cbbfc49584",
   "kr": "앞으로 필요해질 일."
  },
  "69": {
   "jp": "f958eb7c41",
   "kr": "행동하는 데 힌트가 될 만한 것들이에요."
  },
  "70": {
   "jp": "f6bdeb3650",
   "kr": "물론 그걸 안다고 해도"
  },
  "71": {
   "jp": "2be9176dcf",
   "kr": "활용하지 못하면 힌트가 되지 않지만요."
  },
  "72": {
   "jp": "dcd37a33a3",
   "kr": "게다가 어빈 씨라면 말이지."
  },
  "73": {
   "jp": "5a0b9416ea",
   "kr": "자기 운명이 정해져 있는 것 같아서"
  },
  "74": {
   "jp": "263707b086",
   "kr": "반발해 버릴지도 몰라요…"
  },
  "75": {
   "jp": "6f5e70aae0",
   "kr": "하지만 알아서 손해는 없다고 생각해요."
  },
  "76": {
   "jp": "1f738f7334",
   "kr": "신탁을 받는다는 건"
  },
  "77": {
   "jp": "fee2e344cc",
   "kr": "운명의 선택지를 늘린다는 거예요."
  },
  "78": {
   "jp": "b838cdf7a3",
   "kr": "선택지는 많은 편이 좋지."
  },
  "79": {
   "jp": "841a218f7f",
   "kr": "말려드는 기분인데."
  },
  "80": {
   "jp": "c3bae7aa4e",
   "kr": "그래도 이런 기회는 흔치 않아."
  },
  "81": {
   "jp": "679ee16c58",
   "kr": "볼 수 있다면 보고 싶어."
  },
  "82": {
   "jp": "9a74290f32",
   "kr": "원래라면 신탁의 힘을 끌어내기 위해"
  },
  "83": {
   "jp": "5f49432e20",
   "kr": "열쇠가 되는 특정한 물건이 필요하지만"
  },
  "84": {
   "jp": "b5969a0d6e",
   "kr": "아마 제 마법으로 대신할 수 있을 거예요."
  },
  "85": {
   "jp": "9a02c225f5",
   "kr": "저쪽에서"
  },
  "86": {
   "jp": "50403b690f",
   "kr": "이 성스러운 물의 수면을 보세요."
  },
  "87": {
   "jp": "7cea46e9cd",
   "kr": "좋아. 보여 줘."
  },
  "88": {
   "jp": "364924f5b5",
   "kr": "그럼 시작할게요."
  },
  "89": {
   "jp": "e890a70b5f",
   "kr": "흐읍!!!"
  }
 }
}
