{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02200E.BIN",
 "segments": {
  "0": {
   "jp": "246b3f5254",
   "kr": "어머, 어서 와."
  },
  "1": {
   "jp": "596c808f11",
   "kr": "크레이 씨는 만났어?"
  },
  "2": {
   "jp": "27b39b1843",
   "kr": "만났어."
  },
  "3": {
   "jp": "6ef6a8b495",
   "kr": "이게 방패…"
  },
  "4": {
   "jp": "acf144c0d5",
   "kr": "어빈은 교환한 방패를 건넸다."
  },
  "5": {
   "jp": "0ac880461b",
   "kr": "아, 다행이다, 다행이야, 다행이야!!"
  },
  "6": {
   "jp": "f7dc95202d",
   "kr": "이게 없었으면 어쩌나 했단 말이야!"
  },
  "7": {
   "jp": "603491a7fb",
   "kr": "３년 동안의 내 고생이…"
  },
  "8": {
   "jp": "9a94e020c1",
   "kr": "어이, 여보."
  },
  "9": {
   "jp": "b2777b3aad",
   "kr": "뭘 그렇게 들떠 있는 거야?"
  },
  "10": {
   "jp": "a8b618df5c",
   "kr": "뜨끔."
  },
  "11": {
   "jp": "f33f326bd5",
   "kr": "…호호호, 여보, 아무것도 아니에요."
  },
  "12": {
   "jp": "b7bee6cbd7",
   "kr": "그냥 이 애들이랑 얘기에 빠져서"
  },
  "13": {
   "jp": "5f75d9efc6",
   "kr": "너무 즐거워서."
  },
  "14": {
   "jp": "9d7f89eb05",
   "kr": "그래?"
  },
  "15": {
   "jp": "f680d36952",
   "kr": "너무 게으름 피우지 말고 일해라."
  },
  "16": {
   "jp": "3ad7206f76",
   "kr": "알고 있어요, 여보."
  },
  "17": {
   "jp": "4e39ee03db",
   "kr": "…아아, 깜짝이야."
  },
  "18": {
   "jp": "85457bb138",
   "kr": "이 방패에 비상금이 숨겨져 있다는 걸"
  },
  "19": {
   "jp": "1ec0d62440",
   "kr": "그이는 모르거든."
  },
  "20": {
   "jp": "23015d7ec7",
   "kr": "어빈, 정말 고마워."
  },
  "21": {
   "jp": "bb243d3cbb",
   "kr": "덕분에 ３년간 모은 돈을 잃지 않고 끝났어."
  },
  "22": {
   "jp": "522374ebc7",
   "kr": "손님은 중년 남자이고 크레이 씨라고 해."
  },
  "23": {
   "jp": "3d332b66c5",
   "kr": "바로아 쪽으로 간다고 했으니"
  },
  "24": {
   "jp": "e163b1ab11",
   "kr": "그 근처 여관 술집을 찾아보면"
  },
  "25": {
   "jp": "2aeb844593",
   "kr": "잡을 수 있을 것 같은데 말이야."
  },
  "26": {
   "jp": "7b705a6b68",
   "kr": "그리고 교환한 방패는"
  },
  "27": {
   "jp": "24c6412f4d",
   "kr": "꼭 나한테 가져다줘."
  },
  "28": {
   "jp": "0bcbf3a2cb",
   "kr": "아주 급해, 부탁해."
  },
  "29": {
   "jp": "fafc11bc95",
   "kr": "어서 와."
  },
  "30": {
   "jp": "7cb6c92113",
   "kr": "우리 가게는 좋은 상품이 많아."
  },
  "31": {
   "jp": "e36fc7632a",
   "kr": "안녕."
  },
  "32": {
   "jp": "24d38d11f3",
   "kr": "알선소에서 보내서 왔어."
  },
  "33": {
   "jp": "e746b8d92b",
   "kr": "어머나."
  },
  "34": {
   "jp": "fb78ede415",
   "kr": "꼬마들이?"
  },
  "35": {
   "jp": "9a390b2553",
   "kr": "실은 말이야."
  },
  "36": {
   "jp": "96b09c1254",
   "kr": "너무 큰 소리로는 말 못 하는데."
  },
  "37": {
   "jp": "094c24ff4e",
   "kr": "얼마 전에 불량품 방패를 팔아 버렸어."
  },
  "38": {
   "jp": "e9e07fb515",
   "kr": "우리로서는 당장 반품 교환하지 않으면"
  },
  "39": {
   "jp": "7cb15511ed",
   "kr": "신용 문제거든."
  },
  "40": {
   "jp": "e70db99931",
   "kr": "가능한 한 빨리"
  },
  "41": {
   "jp": "b505cff58c",
   "kr": "이 새 방패와 불량품을 교환해 줬으면 해."
  },
  "42": {
   "jp": "4578041010",
   "kr": "다행히 손님 이름은 장부에 남아 있었어."
  },
  "43": {
   "jp": "8798c01b2b",
   "kr": "중년 남자이고 크레이 씨라고 해."
  },
  "44": {
   "jp": "3d332b66c5",
   "kr": "바로아 쪽으로 간다고 했으니"
  },
  "45": {
   "jp": "e163b1ab11",
   "kr": "그 근처 여관 술집을 찾아보면"
  },
  "46": {
   "jp": "1be8fd2c38",
   "kr": "잡을 수 있을 것 같은데."
  },
  "47": {
   "jp": "f6e0ffeac2",
   "kr": "교환하면 불량품 방패를 가져다줘."
  },
  "48": {
   "jp": "0a97c06496",
   "kr": "절대 버리지 말고"
  },
  "49": {
   "jp": "6a82723b5a",
   "kr": "나한테 가져다줬으면 해."
  },
  "50": {
   "jp": "197afdcc08",
   "kr": "장사하는 사람으로서는"
  },
  "51": {
   "jp": "ecaf436b96",
   "kr": "확인하지 않으면 마음이 안 놓여서 말이야."
  },
  "52": {
   "jp": "7fb6d24639",
   "kr": "꼭 부탁이야."
  },
  "53": {
   "jp": "728bd947d4",
   "kr": "교환용 방패를 맡았다."
  },
  "54": {
   "jp": "a3685d4761",
   "kr": "미안하지만 심부름을 부탁하고 싶어."
  },
  "55": {
   "jp": "82786d4f50",
   "kr": "날라 줬으면 하는 게 있으니"
  },
  "56": {
   "jp": "727a8ef82a",
   "kr": "짐을 좀 줄이고 와 줘."
  },
  "57": {
   "jp": "5de0bc7020",
   "kr": "어빈, 정말 고마워."
  },
  "58": {
   "jp": "37b5a0b1c6",
   "kr": "덕분에"
  },
  "59": {
   "jp": "e56dcf8313",
   "kr": "３년간 모은 비상금을 잃지 않았어."
  }
 }
}
