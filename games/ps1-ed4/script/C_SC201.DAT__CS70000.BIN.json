 "segments": {
  "0": {
   "jp": "7c31be1670",
   "kr": "바위 표면에 본 적 없는 빛깔의 금속이 드러나 있다."
  },
  "1": {
   "jp": "48f45d823d",
   "kr": "이게 레어메탈?"
  },
  "2": {
   "jp": "ae4f4f2633",
   "kr": "신기하게 빛나는 금속이네."
  },
  "3": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "4": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다.",
   "auto": 1
  },
  "5": {
   "jp": "fc94920b59",
   "kr": "이걸 도리아 교수님께 갖다 드리면"
  },
  "6": {
   "jp": "5f1a01e6b9",
   "kr": "의뢰 완료네."
  },
  "7": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "8": {
   "jp": "ccd7176466",
   "kr": "을(를) 입수할 수 없다.",
   "auto": 1
  },
  "9": {
   "jp": "5963b6f198",
   "kr": "여기에는 레어메탈이 없는 것 같다."
  }
 }
}
