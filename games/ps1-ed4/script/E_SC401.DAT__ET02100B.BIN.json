{
 "archive": "/E/SC401.DAT",
 "member": "..\\BIN\\ET02100B.BIN",
 "segments": {
  "0": {
   "jp": "f418b93d48",
   "kr": "루티스.",
   "auto": 1
  },
  "1": {
   "jp": "9747608424",
   "kr": "내가 같이 갈게."
  },
  "2": {
   "jp": "f8093de6a1",
   "kr": "구해 준 은혜를 생각해서"
  },
  "3": {
   "jp": "a5218d7f57",
   "kr": "그런 말을 하는 거라면 잊어."
  },
  "4": {
   "jp": "948538c3e9",
   "kr": "그때는 목적이 필요했어."
  },
  "5": {
   "jp": "60e4671f3d",
   "kr": "그냥 변덕이었어."
  },
  "6": {
   "jp": "4dc8272e32",
   "kr": "그뿐이야."
  },
  "7": {
   "jp": "b1b77f9d70",
   "kr": "하지만 진실의 섬에 가 줬잖아."
  },
  "8": {
   "jp": "25e6acfd07",
   "kr": "그래서 내가 살아 있는 거야."
  },
  "9": {
   "jp": "6d3f19a773",
   "kr": "어렵게 살아난 목숨이야."
  },
  "10": {
   "jp": "fd5d0f2057",
   "kr": "나도 목적이 필요해."
  },
  "11": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "12": {
   "jp": "aaba360f45",
   "kr": "네가 진실의 섬에서 받았다는 신탁은"
  },
  "13": {
   "jp": "cc823a46ea",
   "kr": "나와도 무관하지 않아."
  },
  "14": {
   "jp": "83b312d7be",
   "kr": "무슨 소리야."
  },
  "15": {
   "jp": "873d7f7252",
   "kr": "나는 오크툼 신의 가르침을 믿었어."
  },
  "16": {
   "jp": "4e1e786a73",
   "kr": "아니, 볼게이드 일당에게 왜곡되었지만"
  },
  "17": {
   "jp": "751cb8abfc",
   "kr": "지금도 진리 자체는 틀리지 않았다고 믿어."
  },
  "18": {
   "jp": "79ea52054b",
   "kr": "근거 없는 마음이라는 것도 알아."
  },
  "19": {
   "jp": "37ecf0324e",
   "kr": "하지만 네가 진실의 섬에서 받은 신탁에는"
  },
  "20": {
   "jp": "09802051b0",
   "kr": "발두스 신에게도 오크툼 신에게도 치우치지 않은"
  },
  "21": {
   "jp": "42878da8e0",
   "kr": "진짜 역사가 있을 거야."
  },
  "22": {
   "jp": "b8f5d942a9",
   "kr": "나는 진실을 알고 싶어."
  },
  "23": {
   "jp": "b7170a9380",
   "kr": "진실이라…"
  },
  "24": {
   "jp": "fa312d7928",
   "kr": "네가 섬에서 본 장소에 가 보고 싶어."
  },
  "25": {
   "jp": "0a3fa9eac5",
   "kr": "그리고 네 곳이라는 게 마음에 걸려."
  },
  "26": {
   "jp": "3686f8140d",
   "kr": "무슨 말이오?"
  },
  "27": {
   "jp": "2cffbe081e",
   "kr": "나와 바스터는"
  },
  "28": {
   "jp": "242dbacb22",
   "kr": "산산이 흩어진 발두스의 신체인"
  },
  "29": {
   "jp": "5cafea9607",
   "kr": "여섯 개의 신보를 모으는 게 임무였어."
  },
  "30": {
   "jp": "d20a58e483",
   "kr": "너희가 가지고 있던 카베사와 쿠에르포."
  },
  "31": {
   "jp": "ce1b4e942c",
   "kr": "그게 둘."
  },
  "32": {
   "jp": "8e24f30cb3",
   "kr": "그러니까 그 밖에 네 개가 더 있다는 거야."
  },
  "33": {
   "jp": "6e4211e3e1",
   "kr": "내가 아는 정보로는"
  },
  "34": {
   "jp": "c60b2dc922",
   "kr": "이둔, 스코티아, 네프티스, 잘의 사정령이"
  },
  "35": {
   "jp": "5510b60777",
   "kr": "지키고 있다는 것까지는 조사해 뒀어."
  },
  "36": {
   "jp": "d99650166a",
   "kr": "사정령…?"
  },
  "37": {
   "jp": "93eddc1469",
   "kr": "발두스 신과 오크툼 신의 종복이오."
  },
  "38": {
   "jp": "8ed9988e40",
   "kr": "대정령 둘가 신이 거느리는 정령들을 말하오."
  },
  "39": {
   "jp": "f024b614a5",
   "kr": "어빈도 코르나 마을에 둘가 신을 기리는"
  },
  "40": {
   "jp": "58dac7134b",
   "kr": "얼음 신전이 있다는 것쯤은 알 것이오."
  },
  "41": {
   "jp": "b4b53fe617",
   "kr": "오크툼 신도의 조사로는"
  },
  "42": {
   "jp": "607f6dc187",
   "kr": "남은 네 개의 신보 중"
  },
  "43": {
   "jp": "2c517bf929",
   "kr": "이미 두 곳까지는 단서를 잡았어."
  },
  "44": {
   "jp": "ac00aec4b2",
   "kr": "하나는 가든힐."
  },
  "45": {
   "jp": "9d61807d29",
   "kr": "그 어딘가에 있다는 이둔의 사당."
  },
  "46": {
   "jp": "70aac7a7de",
   "kr": "그리고 또 하나는 키트 마을의 전설."
  },
  "47": {
   "jp": "c2aff9e10f",
   "kr": "스코티아와 관련된 전설이 있대."
  },
  "48": {
   "jp": "2722a6f847",
   "kr": "아마 스코티아의 사당도 그 근처에 있을 거야."
  },
  "49": {
   "jp": "4e8ffe4726",
   "kr": "내가 아는 범위는 여기까지인데"
  },
  "50": {
   "jp": "9b797e7ae0",
   "kr": "지금은 조사가 더 진행됐을지도 몰라."
  },
  "51": {
   "jp": "0c4fb1ba4e",
   "kr": "어빈이 봤다는 장소와 겹치는군."
  },
  "52": {
   "jp": "1dca2a3ed4",
   "kr": "네.",
   "auto": 1
  },
  "53": {
   "jp": "a593bef06d",
   "kr": "카베사와 쿠에르포 탈취에 실패한 이상"
  },
  "54": {
   "jp": "9863163485",
   "kr": "볼게이드 일당이니"
  },
  "55": {
   "jp": "77cc8c37e7",
   "kr": "남은 네 개를 노리고 있을 게 틀림없어."
  },
  "56": {
   "jp": "712414d773",
   "kr": "그렇다면…"
  },
  "57": {
   "jp": "56e75997a9",
   "kr": "어빈에게 여섯 신보를 모으라고"
  },
  "58": {
   "jp": "28f5204d00",
   "kr": "진실의 섬에서 계시가 있었다고 보는 것이"
  },
  "59": {
   "jp": "b74a5c2a2e",
   "kr": "타당하겠구려."
  },
  "60": {
   "jp": "83e977e933",
   "kr": "그렇게 되겠지."
  },
  "61": {
   "jp": "e990b8a515",
   "kr": "적어도 나는 어빈을 따라가면"
  },
  "62": {
   "jp": "7bea4816e2",
   "kr": "두 신의 진짜 모습을 볼 수 있을 것 같아."
  },
  "63": {
   "jp": "f324be9d9f",
   "kr": "이제 신보에는 관심 없고"
  },
  "64": {
   "jp": "bba0faf5ac",
   "kr": "오크툼 신도로 돌아갈 생각도 없어."
  },
  "65": {
   "jp": "c6eaf6d20b",
   "kr": "나는 내가 믿었던 것의"
  },
  "66": {
   "jp": "1b4b0053d9",
   "kr": "정체를 알고 싶을 뿐이야."
  },
  "67": {
   "jp": "0f793b8a36",
   "kr": "부탁이야. 같이 가게 해 줘."
  },
  "68": {
   "jp": "006954b1a7",
   "kr": "정체를 알고 어쩔 건데?"
  },
  "69": {
   "jp": "18a7c547d0",
   "kr": "그것이 참으로 올바른 것이라면"
  },
  "70": {
   "jp": "806854f8df",
   "kr": "오크툼을 더럽힌 베리어스 경이나 볼게이드를"
  },
  "71": {
   "jp": "1c5c20c6aa",
   "kr": "이 손으로 쓰러뜨리겠어요."
  },
  "72": {
   "jp": "d280c8f9e0",
   "kr": "오크툼이 사악한 존재라는 걸 알게 되면?"
  },
  "73": {
   "jp": "3055625f70",
   "kr": "그때는 오크툼 신과 싸우겠어요."
  },
  "74": {
   "jp": "d2cb262983",
   "kr": "어쩔 셈이오, 어빈?"
  },
  "75": {
   "jp": "6fdd96969a",
   "kr": "부탁이야."
  },
  "76": {
   "jp": "72d22ea3ae",
   "kr": "………",
   "auto": 1
  },
  "77": {
   "jp": "29c6ac3580",
   "kr": "마음대로 해."
  },
  "78": {
   "jp": "e83e30cb71",
   "kr": "말해 두는데"
  },
  "79": {
   "jp": "ddbdd8ca97",
   "kr": "나는 신보를 모아서 뭘 할 생각은 없어."
  },
  "80": {
   "jp": "534d7e2c7e",
   "kr": "진실의 섬에서 본 장소에 가 보고 싶을 뿐이야."
  },
  "81": {
   "jp": "84f697fbf4",
   "kr": "만약 루티스 말대로"
  },
  "82": {
   "jp": "8cc3905a68",
   "kr": "거기에 신보가 있다 해도 그때가 되기 전엔"
  },
  "83": {
   "jp": "a8b3e96629",
   "kr": "내가 어떻게 할지 나도 몰라."
  },
  "84": {
   "jp": "0e9f428f21",
   "kr": "적어도"
  },
  "85": {
   "jp": "504e9124a2",
   "kr": "오크툼 놈들에게 넘기지 않는 편이 좋다고는"
  },
  "86": {
   "jp": "d7a6eacad2",
   "kr": "생각하지만…"
  },
  "87": {
   "jp": "957d7dc97b",
   "kr": "음."
  },
  "88": {
   "jp": "f418b93d48",
   "kr": "루티스.",
   "auto": 1
  },
  "89": {
   "jp": "d34678840c",
   "kr": "볼게이드가 신보를 모으는 데"
  },
  "90": {
   "jp": "d5bb366dbe",
   "kr": "혈안이 돼 있다고 했지?"
  },
  "91": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "92": {
   "jp": "93dddaddec",
   "kr": "볼게이드는 왜 신보를 모으려는 것이오?"
  },
  "93": {
   "jp": "bf20b47ba3",
   "kr": "그건…"
  },
  "94": {
   "jp": "6580ca2ac2",
   "kr": "우리한테는 아무것도 알려 주지 않았어."
  },
  "95": {
   "jp": "0b098746cb",
   "kr": "음."
  },
  "96": {
   "jp": "d539fc3b9b",
   "kr": "신보를 모으면"
  },
  "97": {
   "jp": "9614702731",
   "kr": "볼게이드는 막대한 이익을 얻을 수 있는 것인가."
  },
  "98": {
   "jp": "980ea8d586",
   "kr": "아니면 자신에게 닥친 중대한 위기를 피할 수 있는 것인가."
  },
  "99": {
   "jp": "b10c0cc508",
   "kr": "어느 쪽이든"
  },
  "100": {
   "jp": "a28c485822",
   "kr": "볼게이드의 이익이라는 게"
  },
  "101": {
   "jp": "a0e0507ffe",
   "kr": "우리에게도 이익이라고는 생각되지 않는군."
  },
  "102": {
   "jp": "fae8d5f98d",
   "kr": "그 말이 맞소."
  },
  "103": {
   "jp": "272640e99b",
   "kr": "그자들의 목적도 조사할 필요가 있을 것이오."
  },
  "104": {
   "jp": "7cc39e1556",
   "kr": "우리가 모르는 곳에서"
  },
  "105": {
   "jp": "fa7a365ec7",
   "kr": "무서운 계획이 진행되고 있을 가능성이 높소."
  },
  "106": {
   "jp": "0ba58845b0",
   "kr": "나는 아직 소재가 밝혀지지 않은 정령을"
  },
  "107": {
   "jp": "5408c0859b",
   "kr": "찾으러 가겠소."
  },
  "108": {
   "jp": "f8616d8405",
   "kr": "…그래, 자르에 대해서라면…"
  },
  "109": {
   "jp": "65a8b72c9a",
   "kr": "짐작 가는 것이 없지도 않소."
  },
  "110": {
   "jp": "2e3172e829",
   "kr": "뭔가 알게 되면 크로웰 님께 연락하겠소."
  },
  "111": {
   "jp": "fa1f69ac48",
   "kr": "알았어.",
   "auto": 1
  },
  "112": {
   "jp": "e4eb8eb436",
   "kr": "…그렇지."
  },
  "113": {
   "jp": "f0f22f44e5",
   "kr": "나는 여기서 헤어지지만"
  },
  "114": {
   "jp": "96fadfc00c",
   "kr": "떠나기 전에 크로웰 님께 인사드리고 가거라."
  },
  "115": {
   "jp": "4b58b05e6c",
   "kr": "우리 여행의 목적을 이야기하면"
  },
  "116": {
   "jp": "cb0ff0b56d",
   "kr": "반드시 힘이 되어 주실 것이오."
  },
  "117": {
   "jp": "b631bc7c95",
   "kr": "몸조심하세요, 가웨인."
  },
  "118": {
   "jp": "e86921b89a",
   "kr": "자네들이야말로."
  },
  "119": {
   "jp": "91d7e6cc8d",
   "kr": "이둔, 스코티아,"
  },
  "120": {
   "jp": "c19e3bf01d",
   "kr": "네프티스, 자르의 사정령이"
  },
  "121": {
   "jp": "97eb6cc244",
   "kr": "떠나기 전에 크로웰 님께"
  },
  "122": {
   "jp": "bc34b2a3e8",
   "kr": "인사를 드리고 가도록 하시오."
  }
 }
}
