 "segments": {
  "0": {
   "jp": "5b14f587e0",
   "kr": "율 할머니"
  },
  "1": {
   "jp": "debb571654",
   "kr": "오스카"
  },
  "2": {
   "jp": "f61ae2b6ac",
   "kr": "제라르"
  },
  "3": {
   "jp": "f32b75a18d",
   "kr": "르네"
  },
  "4": {
   "jp": "87e000aad8",
   "kr": "앙리"
  },
  "5": {
   "jp": "87b9db2c05",
   "kr": "로베르"
  },
  "6": {
   "jp": "eb578425d9",
   "kr": "새끼 고양이",
   "auto": 1
  },
  "7": {
   "jp": "430ff21a35",
   "kr": "셀린"
  },
  "8": {
   "jp": "f32b75a18d",
   "kr": "르네"
  },
  "9": {
   "jp": "3bfcfee17b",
   "kr": "눈"
  },
  "10": {
   "jp": "fe924e349e",
   "kr": "여어, 어빈."
  },
  "11": {
   "jp": "d72cb32225",
   "kr": "어때, 차라도 한잔할래?"
  },
  "12": {
   "jp": "4e6e3442ad",
   "kr": "이렇게 호수 위에서 흔들리고 있으면"
  },
  "13": {
   "jp": "6edd36d7e8",
   "kr": "정말 기분이 좋아…"
  },
  "14": {
   "jp": "a4a02e7318",
   "kr": "어빈이라고 한다면서요?"
  },
  "15": {
   "jp": "bd498d6962",
   "kr": "오스카랑 친구가 됐군요."
  },
  "16": {
   "jp": "c4ca31fb84",
   "kr": "성스러운 크리스탈이라… 두근두근한걸."
  },
  "17": {
   "jp": "6be090e67f",
   "kr": "반드시 찾아내자."
  },
  "18": {
   "jp": "57a650b689",
   "kr": "어때, 제라르는"
  },
  "19": {
   "jp": "cefc96251c",
   "kr": "뭔가 건졌대?"
  },
  "20": {
   "jp": "97fb0b390b",
   "kr": "아니, 전혀."
  },
  "21": {
   "jp": "9ede403060",
   "kr": "그렇군. 뭐, 이제 막 시작했으니까."
  },
  "22": {
   "jp": "9e6d03e697",
   "kr": "그리 쉽게는 안 되겠지."
  },
  "23": {
   "jp": "efb1bb45e3",
   "kr": "오스카!"
  },
  "24": {
   "jp": "96075d706c",
   "kr": "이번에는 크리스탈을 찾으면 좋겠다."
  },
  "25": {
   "jp": "b560f82189",
   "kr": "키는 내가 잡을게."
  },
  "26": {
   "jp": "6f3618cbf7",
   "kr": "어빈은 호수를 잘 지켜봐 줘."
  },
  "27": {
   "jp": "259a11ebee",
   "kr": "여어, 나는 망꾼 르네야. 잘 부탁해."
  },
  "28": {
   "jp": "781c661da4",
   "kr": "망꾼?"
  },
  "29": {
   "jp": "a6251a2745",
   "kr": "그래. 이렇게 호수를 감시하는 역할이야."
  },
  "30": {
   "jp": "3d2087bcf6",
   "kr": "스코티아호가 안전하게 항해할 수 있게."
  },
  "31": {
   "jp": "25040a9bc8",
   "kr": "모스 호수는 잔잔해 보이지만"
  },
  "32": {
   "jp": "58b4759912",
   "kr": "사실은 엄청난 말괄량이야."
  },
  "33": {
   "jp": "bd007a4e6b",
   "kr": "특히 모시의 재채기가 나오면"
  },
  "34": {
   "jp": "de76cc0953",
   "kr": "손을 쓸 수가 없어."
  },
  "35": {
   "jp": "f244d0fff2",
   "kr": "모시의 재채기?"
  },
  "36": {
   "jp": "14639f1915",
   "kr": "호수가 거칠어질 징조지."
  },
  "37": {
   "jp": "faee5d3b5c",
   "kr": "한순간 돌풍이 수면에서 하늘로 솟구쳐 올라."
  },
  "38": {
   "jp": "1150d11212",
   "kr": "공기 기둥이 구름을 뚫고 올라갈 때도 있어."
  },
  "39": {
   "jp": "c8a1846f00",
   "kr": "마치 커다란 용이 재채기한 것처럼."
  },
  "40": {
   "jp": "ffdd762564",
   "kr": "그래서 우리는"
  },
  "41": {
   "jp": "dd8d8f60f3",
   "kr": "모스 호수의 괴물 모시가 재채기했다고"
  },
  "42": {
   "jp": "941e6f344e",
   "kr": "말하는 거야."
  },
  "43": {
   "jp": "7636c0d22d",
   "kr": "이 호수에는 마수가 살고 있어?"
  },
  "44": {
   "jp": "b4f807a1cf",
   "kr": "하하하."
  },
  "45": {
   "jp": "9aa7fa39a5",
   "kr": "아니, 그런 소문이 있을 뿐이야."
  },
  "46": {
   "jp": "e13f1724da",
   "kr": "진짜로 있다면 호수에 못 나가지."
  },
  "47": {
   "jp": "9a77484083",
   "kr": "오늘은 아직 모시의 재채기가 안 보이네."
  },
  "48": {
   "jp": "a02a3c2718",
   "kr": "성스러운 크리스탈을 찾고 있다며?"
  },
  "49": {
   "jp": "62049af486",
   "kr": "스코티아 님의 사당에 들어가서 뭘 하려는 거야?"
  },
  "50": {
   "jp": "de8676ad5c",
   "kr": "하필이면 어린 리타를 납치하다니."
  },
  "51": {
   "jp": "cdc73a4667",
   "kr": "모시 녀석, 용서 못 해."
  },
  "52": {
   "jp": "e9e6bb7c80",
   "kr": "크리스탈, 크리스탈… 어디 보자."
  },
  "53": {
   "jp": "9d648b4c8a",
   "kr": "뭐, 그리 쉽게 건져질 리가 없지만."
  },
  "54": {
   "jp": "5b87f69b64",
   "kr": "이번에야말로 크리스탈을 찾아내자."
  },
  "55": {
   "jp": "cfa52e5bad",
   "kr": "모시 녀석,"
  },
  "56": {
   "jp": "06baead5a1",
   "kr": "찾아내기만 해 봐라, 아주 박살을 내 주겠다!!"
  },
  "57": {
   "jp": "251eae5e36",
   "kr": "사금이란 건 돈이 될 것 같으면서도"
  },
  "58": {
   "jp": "24d5ba21b3",
   "kr": "안 되는 거란 말이지."
  },
  "59": {
   "jp": "c03e6a9691",
   "kr": "스코티아 님의 성스러운 크리스탈이라."
  },
  "60": {
   "jp": "7a7b39c054",
   "kr": "어떤 걸까."
  },
  "61": {
   "jp": "2d1914972b",
   "kr": "우리가 힘을 합치면"
  },
  "62": {
   "jp": "7210425449",
   "kr": "모시쯤은 문제없어."
  },
  "63": {
   "jp": "a16247d7ff",
   "kr": "스코티아호가 생기기 전에는"
  },
  "64": {
   "jp": "0347d82616",
   "kr": "맨몸으로 잠수해서 사금을 캤다고."
  },
  "65": {
   "jp": "951ab58d3d",
   "kr": "스코티아 님의 성스러운 크리스탈…"
  },
  "66": {
   "jp": "fcb9ce117c",
   "kr": "두근두근하네."
  },
  "67": {
   "jp": "772aef8091",
   "kr": "리타는 괜찮을까…"
  },
  "68": {
   "jp": "92e83bf2bb",
   "kr": "저는 여기서 호수를 지켜볼게요."
  },
  "69": {
   "jp": "01812732eb",
   "kr": "모시가 나타나면 절대 놓치지 않을 거예요."
  },
  "70": {
   "jp": "eb0c05cf78",
   "kr": "야옹."
  },
  "71": {
   "jp": "db02c1bb38",
   "kr": "이 녀석, 그 아이의 고양이잖아."
  },
  "72": {
   "jp": "2ca07aaf86",
   "kr": "같이 타고 와 버렸구나."
  },
  "73": {
   "jp": "cd7baff185",
   "kr": "리타가 걱정되는 걸까?"
  },
  "74": {
   "jp": "eb0c05cf78",
   "kr": "야옹."
  },
  "75": {
   "jp": "a44ba11391",
   "kr": "그래그래."
  },
  "76": {
   "jp": "9fb58eae9d",
   "kr": "리타는 너한테 은인이니까."
  }
 }
}
