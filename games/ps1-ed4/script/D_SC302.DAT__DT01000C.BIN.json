{
 "archive": "/D/SC302.DAT",
 "member": "..\\BIN\\DT01000C.BIN",
 "segments": {
  "0": {
   "jp": "a2939d7176",
   "kr": "마수 퇴치를 위해 모험가 ３명이"
  },
  "1": {
   "jp": "074b78be42",
   "kr": "노카크 동굴에 들어갔는데,"
  },
  "2": {
   "jp": "8bd329a6fd",
   "kr": "예상보다 난항인 모양이야."
  },
  "3": {
   "jp": "ecd26f9712",
   "kr": "그래서 모험가 모두에게 레어의 부적을"
  },
  "4": {
   "jp": "d0644999d2",
   "kr": "한 개씩 전해 주셨으면 해요."
  },
  "5": {
   "jp": "a5413bacc8",
   "kr": "３명의 모험가 이름은"
  },
  "6": {
   "jp": "e7066ff95f",
   "kr": "사가, 로웨이, 내쉬예요."
  },
  "7": {
   "jp": "fdddd2352a",
   "kr": "레어의 부적 구입비는 자기 부담이니"
  },
  "8": {
   "jp": "3cf6649274",
   "kr": "주의하세요."
  },
  "9": {
   "jp": "3c31b4bac2",
   "kr": "요즘 세타와 도크스 사이 가도에서"
  },
  "10": {
   "jp": "c5596c06ea",
   "kr": "척후조 때문에 피해가 속출하고 있어요."
  },
  "11": {
   "jp": "1a7726e262",
   "kr": "무차별로 사람을 덮치는지"
  },
  "12": {
   "jp": "3b06dd0805",
   "kr": "상인과 나그네가 곤란해하고 있어요."
  },
  "13": {
   "jp": "72ca86d7c5",
   "kr": "이대로는 가도를"
  },
  "14": {
   "jp": "78a3a87be4",
   "kr": "이용할 수 없게 돼요."
  },
  "15": {
   "jp": "ff22794c71",
   "kr": "어떻게든 척후조를 퇴치해 줬으면 해."
  },
  "16": {
   "jp": "06e89c5746",
   "kr": "어쩐 일인지 샤카 동굴에"
  },
  "17": {
   "jp": "7e882b22f1",
   "kr": "여자아이가 길을 잃고 들어갔나 봐."
  },
  "18": {
   "jp": "3b2fde8f49",
   "kr": "샤카 동굴에는 마수가 많아서"
  },
  "19": {
   "jp": "6ffce07cb0",
   "kr": "서둘러 손쓰지 않으면"
  },
  "20": {
   "jp": "967ca298c6",
   "kr": "돌이킬 수 없는 일이 돼요."
  },
  "21": {
   "jp": "3b43466fc4",
   "kr": "실력에 자신 있는 사람에게만 권하는 일이야."
  },
  "22": {
   "jp": "aebd331e27",
   "kr": "최근 발크드로 가는 가도에 흉악한 마수가 나타나"
  },
  "23": {
   "jp": "2320abff6e",
   "kr": "나그네 몇 명이 피해를 입었어."
  },
  "24": {
   "jp": "53a2cd0a11",
   "kr": "희생자가 더 늘기 전에"
  },
  "25": {
   "jp": "8a4a044928",
   "kr": "마수 라켈타 용을 퇴치해 주셨으면 해요."
  },
  "26": {
   "jp": "f17512e4b9",
   "kr": "모처의 정보에 따르면 사플 동굴에"
  },
  "27": {
   "jp": "2319efa227",
   "kr": "예전에 왕성에서 도둑맞은 백은 지팡이가"
  },
  "28": {
   "jp": "bee4b8b7a0",
   "kr": "숨겨져 있는 모양이에요."
  },
  "29": {
   "jp": "1181de23cc",
   "kr": "사플 동굴은 마수가 많아 위험한 곳이지만"
  },
  "30": {
   "jp": "89f72a9d6a",
   "kr": "거꾸로 생각하면 보물 은닉처로는 최적이지."
  },
  "31": {
   "jp": "65e01fd48b",
   "kr": "정보가 사실이라면 어떻게든"
  },
  "32": {
   "jp": "325e19d904",
   "kr": "되찾아야 해요."
  },
  "33": {
   "jp": "7c355f4b85",
   "kr": "도크스 서쪽에 동굴 세 개가 나란히 있는 건"
  },
  "34": {
   "jp": "280043c181",
   "kr": "알고 있죠?"
  },
  "35": {
   "jp": "fecbe7fe43",
   "kr": "그 가운데 노카크 동굴에"
  },
  "36": {
   "jp": "5e85466dea",
   "kr": "은잔이 숨겨져 있다는 전승이 있어."
  },
  "37": {
   "jp": "fd52ef54e4",
   "kr": "하지만 마수 소굴 같은 동굴이라"
  },
  "38": {
   "jp": "27ffe2f341",
   "kr": "만만치는 않을 거예요."
  },
  "39": {
   "jp": "a0f95c03d6",
   "kr": "최근 카시살 산길에"
  },
  "40": {
   "jp": "508fd1feb3",
   "kr": "하자만이라는 마수가 나타나"
  },
  "41": {
   "jp": "389cf73114",
   "kr": "나그네들에게 피해를 주고 있어."
  },
  "42": {
   "jp": "b1ab1d0f28",
   "kr": "가도의 위험은 서둘러 없애야 해."
  },
  "43": {
   "jp": "cacab517b1",
   "kr": "카시살 산길은 도크스로 향하는 왕도 가도에서"
  },
  "44": {
   "jp": "95eee8afe8",
   "kr": "갈라진 산길이야."
  },
  "45": {
   "jp": "9a7b8798ce",
   "kr": "짐을 나르기만 하는"
  },
  "46": {
   "jp": "6468080a6d",
   "kr": "간단한 일이야."
  },
  "47": {
   "jp": "bf6501c2d9",
   "kr": "짐과 배달처는"
  },
  "48": {
   "jp": "94c38dd5c2",
   "kr": "코넬리 씨에게 물어봐."
  },
  "49": {
   "jp": "a1db31daac",
   "kr": "좀 거리가 있지만,"
  },
  "50": {
   "jp": "3833ca3468",
   "kr": "배달 의뢰예요."
  },
  "51": {
   "jp": "1d458a4d31",
   "kr": "여관 술집에 머무는 숀 씨가"
  },
  "52": {
   "jp": "083a580f69",
   "kr": "키트까지 짐을 배달해 달래요."
  },
  "53": {
   "jp": "14eea93ef3",
   "kr": "짐은 숀 씨에게서 직접 받아."
  },
  "54": {
   "jp": "8ccccc4d36",
   "kr": "이건 익명 의뢰야."
  },
  "55": {
   "jp": "7ddfbbd729",
   "kr": "의뢰인은 어떤 주부인데."
  },
  "56": {
   "jp": "ae834f5d8e",
   "kr": "남편이 가르시아 씨를 다루인 동굴에 납치해서"
  },
  "57": {
   "jp": "f5090d627d",
   "kr": "두고 와 버렸대요."
  },
  "58": {
   "jp": "69e168e416",
   "kr": "아시다시피"
  },
  "59": {
   "jp": "0dce1c857a",
   "kr": "가르시아 씨는 악덕 장사를 하잖아요?"
  },
  "60": {
   "jp": "e81ee3ffef",
   "kr": "의뢰인의 남편도 상당히 심한 꼴을 당했대."
  },
  "61": {
   "jp": "573656f862",
   "kr": "하지만 부인은 상대가 아무리 나쁜 사람이라도"
  },
  "62": {
   "jp": "c7bfa2d8d6",
   "kr": "납치하는 건 안 된다고 생각하고 있어요."
  },
  "63": {
   "jp": "66e2790530",
   "kr": "게다가 관청에 들키면"
  },
  "64": {
   "jp": "41fba5155f",
   "kr": "처벌받는 건 남편 쪽이잖아?"
  },
  "65": {
   "jp": "af67a0e73b",
   "kr": "그러니 사태가 커지기 전에"
  },
  "66": {
   "jp": "253c260b8d",
   "kr": "가르시아 씨를 구출해 줬으면 해요."
  },
  "67": {
   "jp": "b35ebcd8c2",
   "kr": "샴실단이 황금 조각상을"
  },
  "68": {
   "jp": "d77e0aac4d",
   "kr": "훔쳐서 발파 동굴로"
  },
  "69": {
   "jp": "9f770d41f4",
   "kr": "도망친 모양이야."
  },
  "70": {
   "jp": "7306361104",
   "kr": "서둘러 황금 조각상을 되찾아 주셨으면 해요."
  },
  "71": {
   "jp": "155082a1b8",
   "kr": "상대는 무장 도적 집단."
  },
  "72": {
   "jp": "98a5cafa1c",
   "kr": "어느 정도 실력이 없으면 힘들 거예요."
  },
  "73": {
   "jp": "bb5642afd4",
   "kr": "이건 뭐라고 해야 할지…"
  },
  "74": {
   "jp": "9840071115",
   "kr": "스투프 씨는"
  },
  "75": {
   "jp": "aa51cefac7",
   "kr": "발크드에 상품을 배달하던 참이었어."
  },
  "76": {
   "jp": "74c88f2bc7",
   "kr": "그런데 이 세타까지 와서"
  },
  "77": {
   "jp": "d92575d1fd",
   "kr": "주사위 도박에 빠져 버렸대."
  },
  "78": {
   "jp": "1dccb9b4bb",
   "kr": "가진 돈은 물론 소중한 상품까지 빼앗겼어."
  },
  "79": {
   "jp": "8ec58df336",
   "kr": "도박꾼은"
  },
  "80": {
   "jp": "c8f98e6424",
   "kr": "내기에서 이기면 상품을 돌려준다고 해요."
  },
  "81": {
   "jp": "5d4a462c4c",
   "kr": "스투프 씨에게는 이제 걸 만한 게 남아 있지 않아요."
  },
  "82": {
   "jp": "ebe9cdd46e",
   "kr": "바로 이곳 의뢰료가 마지막 재산인 셈이죠."
  },
  "83": {
   "jp": "d7963574c6",
   "kr": "다소 점잖지 못한 의뢰지만,"
  },
  "84": {
   "jp": "30726ef937",
   "kr": "승부에 자신이 있다면 해 봐도 되지 않을까?"
  },
  "85": {
   "jp": "4da2d16747",
   "kr": "승부에서 이긴 만큼은 당신 것이 되니까."
  },
  "86": {
   "jp": "2722738f73",
   "kr": "스투프 씨는 밖을 서성이고 있어요."
  },
  "87": {
   "jp": "0172e9199b",
   "kr": "이 일의 상대는 샴실단이야."
  },
  "88": {
   "jp": "3da08a7605",
   "kr": "무슨 목적인지는 모르지만,"
  },
  "89": {
   "jp": "632cdd6a15",
   "kr": "죄 없는 농민을 끌고 가 납치하고 있어."
  },
  "90": {
   "jp": "8254af6d83",
   "kr": "어서 도와줘."
  },
  "91": {
   "jp": "708dd282f6",
   "kr": "도구점 리리카 씨가"
  },
  "92": {
   "jp": "f5f5b80c46",
   "kr": "심부름을 부탁하고 싶대요."
  },
  "93": {
   "jp": "12b0384590",
   "kr": "필딘에 가는 김에 하실 수 있다면"
  },
  "94": {
   "jp": "c0d0719b3a",
   "kr": "맡아도 되지 않을까?"
  },
  "95": {
   "jp": "5ccfb939e9",
   "kr": "듣자 하니, 십 년 수행하면 산을 내려오겠다고 하고"
  },
  "96": {
   "jp": "42153e95ae",
   "kr": "발파 동굴에 들어갔다고 해요."
  },
  "97": {
   "jp": "543092e06a",
   "kr": "올해로 딱 십 년째예요."
  },
  "98": {
   "jp": "5190a8ae1b",
   "kr": "돌아와야 하는데"
  },
  "99": {
   "jp": "f06788ae0b",
   "kr": "십 년이 지나도 아직 나타나지 않아서"
  },
  "100": {
   "jp": "d4489cb3c9",
   "kr": "수색을 부탁하고 싶다는 거예요."
  },
  "101": {
   "jp": "838b1b3a75",
   "kr": "의뢰인 첸트 씨를 만나면"
  },
  "102": {
   "jp": "97baf51d52",
   "kr": "자세한 이야기를 해 줄 거예요."
  },
  "103": {
   "jp": "38c6fb833b",
   "kr": "첸트 씨는 항구 창고에서 일하고 있을 거예요."
  },
  "104": {
   "jp": "01f0646446",
   "kr": "세타와 발크드를 잇는 신도의 길에"
  },
  "105": {
   "jp": "82911081f5",
   "kr": "나그네가 있어요."
  },
  "106": {
   "jp": "2de4c5b92b",
   "kr": "일은 그 나그네에게 텐트를 갖다주기만 하면 돼요."
  },
  "107": {
   "jp": "fedf4c3a6c",
   "kr": "간단하죠?"
  },
  "108": {
   "jp": "c50f622ecf",
   "kr": "다만 텐트 비용은 자기 부담이에요."
  },
  "109": {
   "jp": "85f289b04a",
   "kr": "가진 돈은 물론이고"
  },
  "110": {
   "jp": "e36771e42c",
   "kr": "소중한 상품까지 빼앗겼어."
  },
  "111": {
   "jp": "194bcbca29",
   "kr": "스투프 씨에게는"
  },
  "112": {
   "jp": "85bc38c354",
   "kr": "이제 걸 만한 게 남아 있지 않아요."
  },
  "113": {
   "jp": "320b25361a",
   "kr": "승부에서 이긴 만큼은"
  },
  "114": {
   "jp": "d5edce2adf",
   "kr": "당신 것이 되니까."
  }
 }
}
