{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02200D.BIN",
 "segments": {
  "0": {
   "jp": "1a44e796e2",
   "kr": "어머, 저한테 무슨 용건이라도?"
  },
  "1": {
   "jp": "00b1415e63",
   "kr": "간프 어르신께 듣고 왔어요."
  },
  "2": {
   "jp": "c8ddb22e84",
   "kr": "루크레프 씨 일로…"
  },
  "3": {
   "jp": "d209079c93",
   "kr": "아, 큰일이 났다면서."
  },
  "4": {
   "jp": "5f359bafe4",
   "kr": "우리 일이 끝나자마자 사라져 버렸다면서?"
  },
  "5": {
   "jp": "97390fe2b9",
   "kr": "간프 어르신도 물으러 왔어."
  },
  "6": {
   "jp": "469a5def99",
   "kr": "마지막으로 만난 날의 일을 알려 주실 수 없을까요?"
  },
  "7": {
   "jp": "7e757d28ae",
   "kr": "글쎄, 그날…"
  },
  "8": {
   "jp": "40cbc7ccbb",
   "kr": "저기 찬장 열쇠를 고쳐 줘서…"
  },
  "9": {
   "jp": "c4069db6ab",
   "kr": "음… 일이 끝나자 바로 가 버렸어."
  },
  "10": {
   "jp": "7c7e04c4b9",
   "kr": "일이 끝난 뒤 어딘가 들를 용무가 있다는"
  },
  "11": {
   "jp": "81d609f280",
   "kr": "그런 이야기는 하지 않았나요?"
  },
  "12": {
   "jp": "607f71728b",
   "kr": "전혀."
  },
  "13": {
   "jp": "17a692e68c",
   "kr": "거의 수다도 떨지 않고 묵묵히 일하고 돌아갔어."
  },
  "14": {
   "jp": "9d2cc691e4",
   "kr": "루크레프 씨는 성실한 사람이지."
  },
  "15": {
   "jp": "408ebe7a53",
   "kr": "…아!"
  },
  "16": {
   "jp": "040c32b55b",
   "kr": "무슨 일이죠?"
  },
  "17": {
   "jp": "0283e3db76",
   "kr": "『성실』 하니까 생각났어."
  },
  "18": {
   "jp": "e24693fbe3",
   "kr": "그러고 보니 우리 마스터가 말했거든."
  },
  "19": {
   "jp": "2b8766ef6a",
   "kr": "'그 성실한 루크레프 씨가 술을 마시러 왔다'고요."
  },
  "20": {
   "jp": "51c806e21d",
   "kr": "위층에 올라가서 마스터에게 물어봐."
  },
  "21": {
   "jp": "b61ca3293f",
   "kr": "뭔가 알 수 있을지도 몰라."
  },
  "22": {
   "jp": "41fd9fe410",
   "kr": "루크레프 씨가 무사하다면서?"
  },
  "23": {
   "jp": "fb92afadf2",
   "kr": "다행이네."
  },
  "24": {
   "jp": "ffe57da5fd",
   "kr": "어서 옵쇼."
  },
  "25": {
   "jp": "30c3cfe799",
   "kr": "와인입니까요, 맥주입니까요?"
  },
  "26": {
   "jp": "b579f571ba",
   "kr": "아니, 좀 묻고 싶은 게 있어서 왔어."
  },
  "27": {
   "jp": "b08709a5f2",
   "kr": "아저씨, 루크레프라는 장인 알아?"
  },
  "28": {
   "jp": "5bdc693605",
   "kr": "열쇠 장인 말인가?"
  },
  "29": {
   "jp": "36742f3dca",
   "kr": "아아, 얼마 전에 웬일로 우리 가게에 왔지."
  },
  "30": {
   "jp": "a239897356",
   "kr": "장사 얘기였나."
  },
  "31": {
   "jp": "da51d7dbff",
   "kr": "뻣뻣한 머리의 덩치 큰 남자가 같이 있었어."
  },
  "32": {
   "jp": "5dbc1592b5",
   "kr": "어떤 이야기를 하고 있었나요?"
  },
  "33": {
   "jp": "affbd38734",
   "kr": "글쎄… 들은 건 아니라서 말이야."
  },
  "34": {
   "jp": "521bba2edf",
   "kr": "다만 다이아몬드니 뭐니"
  },
  "35": {
   "jp": "a39a8b434c",
   "kr": "그런 말이 들렸지."
  },
  "36": {
   "jp": "4c598d3608",
   "kr": "덩치와 다이아몬드라."
  },
  "37": {
   "jp": "b6525ee128",
   "kr": "전혀 관계없는 조합이군."
  },
  "38": {
   "jp": "3457fcc382",
   "kr": "아, 그러고 보니 생각났다."
  },
  "39": {
   "jp": "bddbee787b",
   "kr": "루크레프 씨는 『다이아몬드를 갖고 싶다』는 게"
  },
  "40": {
   "jp": "7c5320bf9c",
   "kr": "입버릇이라는 소문을 들은 적이 있어."
  },
  "41": {
   "jp": "695d10c43c",
   "kr": "듣자니 부인에게 청혼했을 때"
  },
  "42": {
   "jp": "ca62cf11aa",
   "kr": "유리알 반지밖에 못 샀다더군."
  },
  "43": {
   "jp": "d38d1b70da",
   "kr": "그게 엄청나게 마음에 걸리는 모양이라"
  },
  "44": {
   "jp": "d5afff52d1",
   "kr": "늘 『진짜 다이아몬드를 사 주고 싶다』"
  },
  "45": {
   "jp": "6c83e88c91",
   "kr": "고 말해 왔다나."
  },
  "46": {
   "jp": "2f2bf9e4fc",
   "kr": "아마 그 덩치 큰 남자가 루크레프 씨에게"
  },
  "47": {
   "jp": "441372e34b",
   "kr": "『다이아몬드를 살 만한 돈벌이가 있다』"
  },
  "48": {
   "jp": "77d709702c",
   "kr": "고 꼬드긴 게 아닐까."
  },
  "49": {
   "jp": "b9917f5b90",
   "kr": "부인에게 진짜 다이아몬드를 사 주고 싶다, 이거지."
  },
  "50": {
   "jp": "826ec22e89",
   "kr": "좋은 이야기야."
  },
  "51": {
   "jp": "5c8c983070",
   "kr": "우리 일이 끝나자마자"
  },
  "52": {
   "jp": "e5f9c5f2ca",
   "kr": "사라져 버렸다면서?"
  },
  "53": {
   "jp": "af5764b84d",
   "kr": "음…"
  },
  "54": {
   "jp": "a7e630eb3e",
   "kr": "일이 끝나자마자 바로 가 버렸어."
  },
  "55": {
   "jp": "90dbabdd7b",
   "kr": "거의 수다도 떨지 않고"
  },
  "56": {
   "jp": "70f6db46ca",
   "kr": "묵묵히 일하고 돌아갔어."
  },
  "57": {
   "jp": "766b8a947a",
   "kr": "『그 성실한 루크레프 씨가 술을 마시러 왔다』"
  },
  "58": {
   "jp": "2a225d3c7d",
   "kr": "라고."
  },
  "59": {
   "jp": "dc588ad927",
   "kr": "부인에게 진짜 다이아몬드를 사 주고 싶다,"
  },
  "60": {
   "jp": "a4136accf2",
   "kr": "이거지."
  }
 }
}
