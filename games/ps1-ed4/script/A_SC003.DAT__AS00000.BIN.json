{
 "archive": "/A/SC003.DAT",
 "member": "..\\BIN\\AS00000.BIN",
 "segments": {
  "0": {
   "jp": "8354970aab",
   "kr": "광산 관리인"
  },
  "1": {
   "jp": "4214a60953",
   "kr": "남자"
  },
  "2": {
   "jp": "c3f0fbbfac",
   "kr": "광부",
   "auto": 1
  },
  "3": {
   "jp": "9f300b88b0",
   "kr": "이봐, 형씨!"
  },
  "4": {
   "jp": "bf0782312b",
   "kr": "장난 삼아 들어오면 곤란해."
  },
  "5": {
   "jp": "47f6e1c5eb",
   "kr": "동료의 목숨이 걸려 있다고!"
  },
  "6": {
   "jp": "bcc28ce751",
   "kr": "빨리 마발 씨한테 가져다주는 게"
  },
  "7": {
   "jp": "bbb41f9473",
   "kr": "좋지 않을까?"
  },
  "8": {
   "jp": "ee6a008d5c",
   "kr": "일단 보수를 받으러 돌아가는 게 어때?"
  },
  "9": {
   "jp": "29159141f2",
   "kr": "수고했어."
  },
  "10": {
   "jp": "05a7a42e5e",
   "kr": "광부들은 무사히 돌아갔어."
  },
  "11": {
   "jp": "312f6fffe0",
   "kr": "여, 알선소 소개를 받았나?"
  },
  "12": {
   "jp": "95704fd1f4",
   "kr": "여기는 허가 없이는 들어올 수 없거든."
  },
  "13": {
   "jp": "c272b054a9",
   "kr": "이봐, 잠깐 괜찮을까?"
  },
  "14": {
   "jp": "b8d7afc41c",
   "kr": "드디어 와 줬군."
  },
  "15": {
   "jp": "c85c29f7c1",
   "kr": "알선소 의뢰를 받은 사람들이군."
  },
  "16": {
   "jp": "14ff45a467",
   "kr": "사태가 급해."
  },
  "17": {
   "jp": "ca9e1eeafd",
   "kr": "서둘러 가 줘!"
  },
  "18": {
   "jp": "21d8ce003a",
   "kr": "여기에는 허가 없이 들어올 수 없어."
  },
  "19": {
   "jp": "da78f804dc",
   "kr": "발크드의 마발 씨 심부름으로 왔습니다."
  },
  "20": {
   "jp": "b950bba35f",
   "kr": "소개장을 건넸다."
  },
  "21": {
   "jp": "e29a235e18",
   "kr": "마발 씨의 심부름?"
  },
  "22": {
   "jp": "600b92f678",
   "kr": "…아, 에메리를 가지러 왔구나."
  },
  "23": {
   "jp": "43f36336b5",
   "kr": "좋아, 자유롭게 들어가서 가져가."
  },
  "24": {
   "jp": "e8c5ce1443",
   "kr": "에메리가 뭔지 모르겠으면 내가 봐 줄게."
  },
  "25": {
   "jp": "d4c72eac81",
   "kr": "어때, 에메리는 구했어?"
  },
  "26": {
   "jp": "90f3b8f8fe",
   "kr": "원석을 건넸다."
  },
  "27": {
   "jp": "a442804997",
   "kr": "응, 확실히 에메리군."
  },
  "28": {
   "jp": "bc25f52ff7",
   "kr": "보석이 되다 만 거야."
  },
  "29": {
   "jp": "216b023acc",
   "kr": "이래 봬도 경도는 충분하니까"
  },
  "30": {
   "jp": "ebd603117a",
   "kr": "좋은 연마제가 될 거야."
  },
  "31": {
   "jp": "843e08d89f",
   "kr": "마발 씨에게 안부 전해 줘."
  },
  "32": {
   "jp": "e8f7be25b9",
   "kr": "에메리를 받았다."
  },
  "33": {
   "jp": "a4383eb829",
   "kr": "으음…"
  },
  "34": {
   "jp": "4637852845",
   "kr": "이건 좀 곤란한데."
  },
  "35": {
   "jp": "79421d438e",
   "kr": "보석 원석이잖아."
  },
  "36": {
   "jp": "9ab7e8c083",
   "kr": "미안하지만 여기서 맡아 두겠어."
  },
  "37": {
   "jp": "ed016b4470",
   "kr": "규칙이니까."
  },
  "38": {
   "jp": "bb8a9e4ccb",
   "kr": "얼른 그 에메리를 마발 씨에게"
  },
  "39": {
   "jp": "4e9b90bee8",
   "kr": "가져다드려."
  },
  "40": {
   "jp": "cea563b3a2",
   "kr": "에메리가 뭔지 모르겠으면"
  },
  "41": {
   "jp": "35be3a987d",
   "kr": "내가 봐 줄게."
  },
  "42": {
   "jp": "5e6bd296fd",
   "kr": "여, 수고했어."
  },
  "43": {
   "jp": "2299f220bb",
   "kr": "일의 내용은 알고 있나?"
  },
  "44": {
   "jp": "16795de61e",
   "kr": "먼저 설명해 줄까?"
  },
  "45": {
   "jp": "759cb764b2",
   "kr": "설명을 듣는다"
  },
  "46": {
   "jp": "a5b4f5ac4e",
   "kr": "설명은 필요 없다"
  },
  "47": {
   "jp": "204d312fb3",
   "kr": "그럼 간단히."
  },
  "48": {
   "jp": "d182363bfd",
   "kr": "이 광산 안에는"
  },
  "49": {
   "jp": "21714aa51d",
   "kr": "다양한 보석 원석이 잠들어 있어."
  },
  "50": {
   "jp": "51dc8431dd",
   "kr": "하지만 아무거나"
  },
  "51": {
   "jp": "9f93f9f875",
   "kr": "찾아오면 되는 건 아니야."
  },
  "52": {
   "jp": "2043f79661",
   "kr": "특정 보석만 나돌면"
  },
  "53": {
   "jp": "c7435d92f6",
   "kr": "가격 조정이 틀어져서 인플레이션이 되거든."
  },
  "54": {
   "jp": "c9c46ce3cf",
   "kr": "그래서 「오늘의 추천」이라는 게 있어."
  },
  "55": {
   "jp": "5375972bc7",
   "kr": "날마다"
  },
  "56": {
   "jp": "9552f23ee0",
   "kr": "채굴할 보석을 한정하고 있지."
  },
  "57": {
   "jp": "5a8f75c1c3",
   "kr": "참고로 오늘의 추천은"
  },
  "58": {
   "jp": "9b99593353",
   "kr": "(이)야."
  },
  "59": {
   "jp": "52a4012f92",
   "kr": "그 외에는 안 돼."
  },
  "60": {
   "jp": "195e0dea31",
   "kr": "을(를) 찾지 못하면"
  },
  "61": {
   "jp": "793d7f189b",
   "kr": "일을 마친 걸로 안 쳐."
  },
  "62": {
   "jp": "65baad280b",
   "kr": "다른 원석은 여기서 몰수하니까"
  },
  "63": {
   "jp": "bb59e7577e",
   "kr": "아무리 찾아도"
  },
  "64": {
   "jp": "d456aec1d7",
   "kr": "돈벌이는 안 돼."
  },
  "65": {
   "jp": "55ee71b79c",
   "kr": "그리고 한 번에 가져올 수 있는 원석은"
  },
  "66": {
   "jp": "0857062d0c",
   "kr": "하나뿐이야."
  },
  "67": {
   "jp": "cfa98e8819",
   "kr": "한몫 챙기고 싶은 녀석들은 얼마든지 있으니까"
  },
  "68": {
   "jp": "611b7cf0eb",
   "kr": "반칙하면 찍힌다고."
  },
  "69": {
   "jp": "19a8fc4778",
   "kr": "그럼 바로 일을 시작해 볼까."
  },
  "70": {
   "jp": "6aada4b926",
   "kr": "오늘의 추천은"
  },
  "71": {
   "jp": "9b99593353",
   "kr": "(이)야."
  },
  "72": {
   "jp": "048416b08d",
   "kr": "행운을 빌어!"
  },
  "73": {
   "jp": "dbceb89c14",
   "kr": "여, 성과는 어때?"
  },
  "74": {
   "jp": "3b7952c22c",
   "kr": "원석을 보여 줄래?"
  },
  "75": {
   "jp": "328cfe4f41",
   "kr": "어빈은 원석을 건넸다."
  },
  "76": {
   "jp": "20b63ccbe9",
   "kr": "아쉽지만 이건 안 되겠네."
  },
  "77": {
   "jp": "c2dc101e17",
   "kr": "이런 걸 에메리라고 하거든."
  },
  "78": {
   "jp": "bc25f52ff7",
   "kr": "보석이 되다 만 거야."
  },
  "79": {
   "jp": "2904fec7a8",
   "kr": "기껏해야 연마용 모래밖에 안 돼."
  },
  "80": {
   "jp": "0e88240f74",
   "kr": "다시 한번 도전해 줘."
  },
  "81": {
   "jp": "61df8ff5d3",
   "kr": "음, 훌륭해!"
  },
  "82": {
   "jp": "148bb61020",
   "kr": "이건 멋진"
  },
  "83": {
   "jp": "fac312b123",
   "kr": "(이)로군."
  },
  "84": {
   "jp": "bc2c95c14e",
   "kr": "알선소에서 보수를 받아 가."
  },
  "85": {
   "jp": "6aada4b926",
   "kr": "오늘의 추천은"
  },
  "86": {
   "jp": "ce0cea0b96",
   "kr": "(이)야."
  },
  "87": {
   "jp": "d3b244b373",
   "kr": "힘내."
  },
  "88": {
   "jp": "7883680da7",
   "kr": "자네들, 제법인걸."
  },
  "89": {
   "jp": "9ed58249b9",
   "kr": "가끔 또 부탁하지."
  },
  "90": {
   "jp": "ecb1ad427e",
   "kr": "사파이어"
  },
  "91": {
   "jp": "af1209887f",
   "kr": "루비"
  },
  "92": {
   "jp": "aad00d7157",
   "kr": "자수정"
  },
  "93": {
   "jp": "62498f4cda",
   "kr": "알선소에서 온 사람이지?"
  },
  "94": {
   "jp": "80fd23dffc",
   "kr": "이 짐을 틀림없이"
  },
  "95": {
   "jp": "1921a814f6",
   "kr": "알선소에 전해 줘."
  },
  "96": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "97": {
   "jp": "f8851237f7",
   "kr": "을(를) 받았다."
  },
  "98": {
   "jp": "7615375e51",
   "kr": "꼭 좀 부탁해."
  },
  "99": {
   "jp": "1ad5b58907",
   "kr": "이 짐을 알선소에…"
  },
  "100": {
   "jp": "c5830ee0fc",
   "kr": "더는 짐을 못 들겠군."
  },
  "101": {
   "jp": "084dd6d6f4",
   "kr": "소지품을 정리하고 와 줘."
  },
  "102": {
   "jp": "d2861eef79",
   "kr": "갱도를 넓히다가"
  },
  "103": {
   "jp": "901c32bf9b",
   "kr": "마수 소굴을 건드려 버렸어."
  },
  "104": {
   "jp": "cfdd76b16f",
   "kr": "동료 셋이 도망치지 못했어."
  },
  "105": {
   "jp": "13379f586f",
   "kr": "알선소는 뭘 하고 있는 거야."
  },
  "106": {
   "jp": "5333aebd69",
   "kr": "빨리 사람을 보내 주지 않으면"
  },
  "107": {
   "jp": "ef3a92e2be",
   "kr": "동료들이 당해 버린다고!"
  },
  "108": {
   "jp": "be62af0edf",
   "kr": "알선소에서 보낸 사람이지?"
  },
  "109": {
   "jp": "d2769f19f2",
   "kr": "얼른 동료들을 구해 줘!"
  },
  "110": {
   "jp": "002af2c394",
   "kr": "내가 조금만 더 젊었어도"
  },
  "111": {
   "jp": "2d61cf0d07",
   "kr": "마수쯤은 단숨에 해치울 텐데…"
  },
  "112": {
   "jp": "960cdb058c",
   "kr": "…그 녀석들 괜찮을까."
  },
  "113": {
   "jp": "4d16488ad6",
   "kr": "제발 무사해 줘."
  }
 }
}
