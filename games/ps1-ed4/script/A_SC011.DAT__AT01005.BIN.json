{
 "archive": "/A/SC011.DAT",
 "member": "..\\BIN\\AT01005.BIN",
 "segments": {
  "0": {
   "jp": "50b5b3aefd",
   "kr": "레뮤라스",
   "auto": 1
  },
  "1": {
   "jp": "a4a4f898bd",
   "kr": "사신 오크툼 숭배를 부르짖던,"
  },
  "2": {
   "jp": "acb7c281c4",
   "kr": "예전에 카테드랄에서 추방된 이단자들의"
  },
  "3": {
   "jp": "d70458a401",
   "kr": "갑작스러운 습격이었다."
  },
  "4": {
   "jp": "771c6c1994",
   "kr": "카테드랄에서 탈출한 우리는"
  },
  "5": {
   "jp": "050ef99dcf",
   "kr": "가웨인의 지인인 현자 디너켄을 의지해"
  },
  "6": {
   "jp": "c865303428",
   "kr": "노토스 지방의 프레아우드로 몸을 의탁했다."
  },
  "7": {
   "jp": "ad86121e06",
   "kr": "에스페리우스 님께 받은 신보를 찾아"
  },
  "8": {
   "jp": "11cb1d54f8",
   "kr": "오크툼 신도들도 혈안이 되어 우리를 찾고 있었다."
  },
  "9": {
   "jp": "d230916aa3",
   "kr": "우리 남매는 헤어져 숨는 수밖에 없었다."
  },
  "10": {
   "jp": "ad93270570",
   "kr": "만약 어느 한쪽이 발각되더라도"
  },
  "11": {
   "jp": "86c0860571",
   "kr": "다른 한 사람의 거처는 결코 알려지지 않도록"
  },
  "12": {
   "jp": "75fb8124bc",
   "kr": "서로의 거처도 알리지 않고 헤어졌다."
  },
  "13": {
   "jp": "2c8e31025a",
   "kr": "나는 가웨인의 손에 이끌려"
  },
  "14": {
   "jp": "1afef54125",
   "kr": "전망 좋은 오두막에 사는 현자 레뮤라스에게로…"
  },
  "15": {
   "jp": "5c0816df46",
   "kr": "아이멜이 어디로 갔는지… 나는 모른다."
  },
  "16": {
   "jp": "2261e3a1df",
   "kr": "어빈, 기억하느냐?"
  },
  "17": {
   "jp": "2749dcaf24",
   "kr": "네가 이곳에 처음 왔을 때를."
  },
  "18": {
   "jp": "0d100cc4e5",
   "kr": "……",
   "auto": 1
  },
  "19": {
   "jp": "e973a0e980",
   "kr": "가웨인에게 이끌려,"
  },
  "20": {
   "jp": "a3560dabb6",
   "kr": "익숙지 않은 산길에 발이 걸렸는지"
  },
  "21": {
   "jp": "df82c598a6",
   "kr": "진흙투성이로 내 앞에 나타났었지."
  },
  "22": {
   "jp": "90f75edef7",
   "kr": "마치 어제 일 같구먼."
  },
  "23": {
   "jp": "f3c542498d",
   "kr": "그때 네 얼굴을 지금도 똑똑히 기억하고 있다."
  },
  "24": {
   "jp": "5970fc130d",
   "kr": "아주 슬픈 얼굴을 하고 있었지."
  },
  "25": {
   "jp": "67adcc89ac",
   "kr": "나도 꽤 걱정했었다만…"
  },
  "26": {
   "jp": "4e3244d785",
   "kr": "이제는 걱정 없겠지."
  },
  "27": {
   "jp": "d03f7ce8d1",
   "kr": "그렇지."
  },
  "28": {
   "jp": "1a962694eb",
   "kr": "겨울을 맞으려면 장작이 좀 더 필요하다."
  },
  "29": {
   "jp": "0d3bccc896",
   "kr": "오늘도 좀 패 놔 주렴."
  },
  "30": {
   "jp": "4b8a7eaf8c",
   "kr": "일을 좀 하면 밥도 맛있을 게다."
  },
  "31": {
   "jp": "fdfeaa2e36",
   "kr": "그리고 서재 청소도 부탁한다."
  },
  "32": {
   "jp": "fa1f69ac48",
   "kr": "알았어."
  },
  "33": {
   "jp": "824ae2abc4",
   "kr": "할아버지는 허리가 안 좋으니까"
  },
  "34": {
   "jp": "75da6c532e",
   "kr": "무리하지 말고 앉아 있어."
  },
  "35": {
   "jp": "6dcb363ab4",
   "kr": "미안하구나."
  },
  "36": {
   "jp": "55f103dd55",
   "kr": "하지만 식사 준비는 맡겨 두거라."
  },
  "37": {
   "jp": "ade4183cdd",
   "kr": "오늘은 뭐가 먹고 싶으냐?"
  },
  "38": {
   "jp": "73a24e61a8",
   "kr": "고기 요리"
  },
  "39": {
   "jp": "671ade5bc0",
   "kr": "채소 요리"
  },
  "40": {
   "jp": "f51a997e26",
   "kr": "둘 다"
  },
  "41": {
   "jp": "afb8c0dabd",
   "kr": "허허허."
  },
  "42": {
   "jp": "027c498941",
   "kr": "그럼 기대에 부응하도록 힘써 볼까."
  },
  "43": {
   "jp": "285c6c0558",
   "kr": "한창 먹을 때니까."
  },
  "44": {
   "jp": "1512b7fac3",
   "kr": "그 정도가 믿음직하지."
  },
  "45": {
   "jp": "cda9a64224",
   "kr": "좋아, 맡겨 두거라."
  },
  "46": {
   "jp": "c0f4606d07",
   "kr": "어빈!",
   "auto": 1
  },
  "47": {
   "jp": "41b596ea06",
   "kr": "여, 장작 패는 거야?"
  },
  "48": {
   "jp": "d7e36b257b",
   "kr": "마일. 놀러 와 줬구나."
  },
  "49": {
   "jp": "d1ebd25798",
   "kr": "잠깐만 기다려,"
  },
  "50": {
   "jp": "a0a2f9c918",
   "kr": "지금 장작 패기랑 서재 청소를 끝낼 테니까."
  },
  "51": {
   "jp": "efffad806e",
   "kr": "그럼 내가 둘 중 하나를 해 줄게."
  },
  "52": {
   "jp": "1517e0ffb0",
   "kr": "그래도 돼?"
  },
  "53": {
   "jp": "15007bb891",
   "kr": "되고말고. 어빈은 어느 쪽을 할래?"
  },
  "54": {
   "jp": "871a50bb90",
   "kr": "장작 패기"
  },
  "55": {
   "jp": "82e1816647",
   "kr": "서재 청소"
  },
  "56": {
   "jp": "631558a487",
   "kr": "좋아, 난 서재 청소네."
  },
  "57": {
   "jp": "7f13152411",
   "kr": "좋아, 난 장작 패기네."
  },
  "58": {
   "jp": "cb5ac78473",
   "kr": "그럼 장작 패기 부탁해."
  },
  "59": {
   "jp": "8c504f0560",
   "kr": "맡겨 두라고."
  },
  "60": {
   "jp": "27c25a9ad3",
   "kr": "자, 오늘은 어떻게 팰까."
  },
  "61": {
   "jp": "f8c3363e91",
   "kr": "굵기를 맞춘다"
  },
  "62": {
   "jp": "27b98004f8",
   "kr": "많이 팬다"
  },
  "63": {
   "jp": "a3c1c1e274",
   "kr": "바로 시작해 볼까."
  },
  "64": {
   "jp": "be67278028",
   "kr": "이 정도면 되려나."
  },
  "65": {
   "jp": "e21b88c5e2",
   "kr": "마일이 왔느냐?"
  },
  "66": {
   "jp": "f778ec08ab",
   "kr": "응."
  },
  "67": {
   "jp": "b36da6a06e",
   "kr": "장작 패 준대."
  },
  "68": {
   "jp": "f98acd49d9",
   "kr": "좋은 친구를 만났구나."
  },
  "69": {
   "jp": "f778ec08ab",
   "kr": "응."
  },
  "70": {
   "jp": "24cbf65467",
   "kr": "언제 봐도 대단한 책이야."
  },
  "71": {
   "jp": "79a2dadafa",
   "kr": "잠깐 들여다볼까."
  },
  "72": {
   "jp": "32ba3c4165",
   "kr": "역사책을 본다"
  },
  "73": {
   "jp": "89f6cb180d",
   "kr": "모험 책을 본다"
  },
  "74": {
   "jp": "9561d42172",
   "kr": "표지에 《엘 필딘 연대기》라고"
  },
  "75": {
   "jp": "8992cb52c8",
   "kr": "적혀 있다."
  },
  "76": {
   "jp": "cd161338ba",
   "kr": "그 옛날 헛된 인간의 길을 두고"
  },
  "77": {
   "jp": "e889a69f9f",
   "kr": "신들을 갈라놓은 싸움이 있었다."
  },
  "78": {
   "jp": "a32f085364",
   "kr": "비할 데 없는 다툼은 끝없는 폭주의 물결을 불렀다."
  },
  "79": {
   "jp": "c4e5107e55",
   "kr": "칠흑 같은 구름 틈에서 나온 사신 오크툼,"
  },
  "80": {
   "jp": "e2f10cce8e",
   "kr": "그 포악한 맹위에"
  },
  "81": {
   "jp": "30aa35e7fb",
   "kr": "인간도 신도 그저 떨 뿐이었다."
  },
  "82": {
   "jp": "de89a3d5af",
   "kr": "사신 오크툼을 봉인하기 위해"
  },
  "83": {
   "jp": "36963dbf0f",
   "kr": "인간을 지킨 발두스 신은 하늘에서 부서져"
  },
  "84": {
   "jp": "39a76bcf21",
   "kr": "여섯 개의 「분령」이 되어 대지로 떨어졌다."
  },
  "85": {
   "jp": "8568f0ce22",
   "kr": "신들의 싸움은 이렇게 막을 내렸다."
  },
  "86": {
   "jp": "d2dbc0a2b9",
   "kr": "대지에 흩어진"
  },
  "87": {
   "jp": "df5091db7c",
   "kr": "신의 넋과 함께…"
  },
  "88": {
   "jp": "f3205ee0de",
   "kr": "표지에 《모험가들에게》라고 적혀 있다."
  },
  "89": {
   "jp": "5204223301",
   "kr": "모험이란 평생의 여정이며 종착은 없다."
  },
  "90": {
   "jp": "f86d324b6f",
   "kr": "인간의 일생 또한"
  },
  "91": {
   "jp": "a9bfde7d1f",
   "kr": "종착 없는 모험의 여정이다."
  },
  "92": {
   "jp": "0d100cc4e5",
   "kr": "……",
   "auto": 1
  },
  "93": {
   "jp": "ad4915d040",
   "kr": "오크툼 신도들도"
  },
  "94": {
   "jp": "3fb6573f46",
   "kr": "혈안이 되어 우리를 찾고 있었다."
  }
 }
}
