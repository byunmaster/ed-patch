{
 "archive": "/E/SC400.DAT",
 "member": "..\\BIN\\ET01100A.BIN",
 "segments": {
  "0": {
   "jp": "6ac268ac2d",
   "kr": "프레곤 동굴은 흉포한 마수가 많아"
  },
  "1": {
   "jp": "d28e948fe7",
   "kr": "여행자에게 해가 미치니"
  },
  "2": {
   "jp": "0799117776",
   "kr": "봉인하게 되었어."
  },
  "3": {
   "jp": "75aa384463",
   "kr": "하지만 동굴에는 마리의 흉상이라는"
  },
  "4": {
   "jp": "fc8640e84a",
   "kr": "예술적 가치가 있는 조각이 남아 있어요."
  },
  "5": {
   "jp": "072c50ea85",
   "kr": "동굴을 봉인하면"
  },
  "6": {
   "jp": "5264a9f8e2",
   "kr": "그 흉상이 영원히 사라지는 게 아까워."
  },
  "7": {
   "jp": "743b83a68c",
   "kr": "어떻게든 마리의 흉상을 가져와 줘."
  },
  "8": {
   "jp": "8ff589851b",
   "kr": "이 마을 북서쪽에"
  },
  "9": {
   "jp": "2669ca0bc8",
   "kr": "에이프 동굴이 있어요."
  },
  "10": {
   "jp": "4bb567516f",
   "kr": "만만치 않은 마수가 많은 곳이라"
  },
  "11": {
   "jp": "a7ee30b2a5",
   "kr": "지금까지 아무도 조사한 적이 없지만"
  },
  "12": {
   "jp": "3d6b79bf35",
   "kr": "금 목걸이가 숨겨져 있다는 전승이 있어."
  },
  "13": {
   "jp": "a5959d6f73",
   "kr": "자신 있다면"
  },
  "14": {
   "jp": "da9aac647f",
   "kr": "발견자가 되어 보지 않겠어?"
  },
  "15": {
   "jp": "bf0bbaca72",
   "kr": "발크드에서 브리작으로"
  },
  "16": {
   "jp": "f0eb218371",
   "kr": "이어지는 가도에 푸른뿔 개구리가 나타나"
  },
  "17": {
   "jp": "c9e77a36ad",
   "kr": "여행자와 상인들이 발이 묶여 있어요."
  },
  "18": {
   "jp": "7e83e2e5b0",
   "kr": "되도록 서둘러 마수를 퇴치해서"
  },
  "19": {
   "jp": "a61315519f",
   "kr": "가도를 지날 수 있게 해 줘."
  },
  "20": {
   "jp": "56cdfb3d5d",
   "kr": "편지를 전하는 일이야."
  },
  "21": {
   "jp": "4a930e5046",
   "kr": "자세한 건 맥래인 씨에게"
  },
  "22": {
   "jp": "3c61704d48",
   "kr": "물어보세요."
  },
  "23": {
   "jp": "3ccd059ebb",
   "kr": "맥래인 씨의 집은"
  },
  "24": {
   "jp": "605175dde6",
   "kr": "마법 길드 근처에 있어."
  },
  "25": {
   "jp": "27e5a34603",
   "kr": "프레곤 동굴에 마수를 퇴치하러 간 채"
  },
  "26": {
   "jp": "34f007dd21",
   "kr": "돌아오지 않는 모험가가 있어요."
  },
  "27": {
   "jp": "5adcf7b4be",
   "kr": "마수와의 전투가 길어지고 있거나,"
  },
  "28": {
   "jp": "cbdcdd0403",
   "kr": "아니면 문제에 휘말렸을지도 몰라."
  },
  "29": {
   "jp": "33dfd55673",
   "kr": "서둘러 모험가를 찾아내 도와줘."
  },
  "30": {
   "jp": "ebe95436f4",
   "kr": "물론 아무 문제도 없다면"
  },
  "31": {
   "jp": "bb528d480b",
   "kr": "안부만 확인하면 돼."
  },
  "32": {
   "jp": "0d65fef207",
   "kr": "모험가는 니플과 네페레, 두 사람이에요."
  },
  "33": {
   "jp": "eb34d308f0",
   "kr": "브리작까지의 가도에"
  },
  "34": {
   "jp": "b16736b7f4",
   "kr": "마수 휴노비우스가 자리 잡은 것 같아."
  },
  "35": {
   "jp": "4b38dda10f",
   "kr": "지금은 이렇다 할 피해는 없지만"
  },
  "36": {
   "jp": "f8457e9bd0",
   "kr": "이대로 둘 수는 없어요."
  },
  "37": {
   "jp": "3c2bebcaee",
   "kr": "마수 휴노비우스는 만만치 않은 상대이고"
  },
  "38": {
   "jp": "35780dfce4",
   "kr": "마법도 꽤 쓴다고 알려져 있어요."
  },
  "39": {
   "jp": "612f474a82",
   "kr": "보수만큼 위험한 일이지."
  },
  "40": {
   "jp": "619758b272",
   "kr": "여행자가 에이프 동굴에 들어가 버렸어."
  },
  "41": {
   "jp": "50b50c5982",
   "kr": "샘물을 찾다가 헤맨 모양이야."
  },
  "42": {
   "jp": "6e34adef2f",
   "kr": "그곳은 마수가 많아서"
  },
  "43": {
   "jp": "6f603903e7",
   "kr": "마을 사람들은 절대 다가가지 않는 곳이야."
  },
  "44": {
   "jp": "88db187573",
   "kr": "그런 동굴에서 여행자를 구출할 수 있는 건"
  },
  "45": {
   "jp": "b77850b012",
   "kr": "당신 같은 모험가뿐이에요."
  },
  "46": {
   "jp": "bcfb42bde1",
   "kr": "발크드 북쪽에"
  },
  "47": {
   "jp": "6ade544545",
   "kr": "마수의 소굴이 된 오오스 동굴이 있어요."
  },
  "48": {
   "jp": "140d5d6dad",
   "kr": "위험한 곳인데도"
  },
  "49": {
   "jp": "32ad693d77",
   "kr": "단이라는 할아버지가 틀어박혀 버렸어."
  },
  "50": {
   "jp": "a981950f1f",
   "kr": "조상이 숨긴 재보가 동굴 안에 있다고"
  },
  "51": {
   "jp": "dd765b7581",
   "kr": "굳게 믿고 있대요."
  },
  "52": {
   "jp": "93bf668d44",
   "kr": "언제 마수에게 습격당할지 모르는데…"
  },
  "53": {
   "jp": "fe77145832",
   "kr": "어떻게든 단 씨를 설득해서"
  },
  "54": {
   "jp": "09b7ecd6c8",
   "kr": "동굴에서 데리고 나와 줘."
  },
  "55": {
   "jp": "b273fc1372",
   "kr": "스틸은 동굴을 털어서는"
  },
  "56": {
   "jp": "36a62a392c",
   "kr": "귀중한 재보를 뒷세계에"
  },
  "57": {
   "jp": "9fcb841d48",
   "kr": "빼돌리는 도굴꾼이에요."
  },
  "58": {
   "jp": "9e84764769",
   "kr": "그의 활동은 가치 있는 재보를"
  },
  "59": {
   "jp": "435589d634",
   "kr": "어둠에 묻는 불법 행위예요."
  },
  "60": {
   "jp": "282ab0b1ea",
   "kr": "무슨 일이 있어도 막아야 해요."
  },
  "61": {
   "jp": "f9930d7b05",
   "kr": "그 스틸이 아이톤 동굴에서"
  },
  "62": {
   "jp": "83f07cf030",
   "kr": "일하고 있다는 정보가 들어왔어요."
  },
  "63": {
   "jp": "20b8ce1b76",
   "kr": "꼭 붙잡아 주세요."
  },
  "64": {
   "jp": "d555bdcf18",
   "kr": "짐을 나르기만 하는 간단한 일이야.",
   "auto": 1
  },
  "65": {
   "jp": "bf6501c2d9",
   "kr": "짐과 배달처는"
  },
  "66": {
   "jp": "dcc7600bcb",
   "kr": "오테로 할아버지에게 물어봐."
  },
  "67": {
   "jp": "8b42451e18",
   "kr": "오테로 할아버지는 이 여관 동쪽으로 가서"
  },
  "68": {
   "jp": "d63c664587",
   "kr": "도구점 옆집에 살고 있어."
  },
  "69": {
   "jp": "6e13c568ae",
   "kr": "이건 꼭 어빈 씨,"
  },
  "70": {
   "jp": "a752d37882",
   "kr": "해결해 주셨으면 하는 일이에요."
  },
  "71": {
   "jp": "1233d143c9",
   "kr": "샴실단은 조수의 지팡이라는,"
  },
  "72": {
   "jp": "0ecbc23f5b",
   "kr": "마수를 마음대로 조종하는 도구를 만들어 냈어요."
  },
  "73": {
   "jp": "21069f68ab",
   "kr": "샴실단이"
  },
  "74": {
   "jp": "07bd19a5da",
   "kr": "그 지팡이를 평화적으로 쓸 리가 없어요."
  },
  "75": {
   "jp": "0f8f854eed",
   "kr": "현재 조수의 지팡이를 가진 돌크라는 남자는"
  },
  "76": {
   "jp": "2e539aa81c",
   "kr": "오오스 동굴에 잠복해 있는 모양이에요."
  },
  "77": {
   "jp": "538a2c59c4",
   "kr": "한시라도 빨리 지팡이를 파괴해 주세요."
  },
  "78": {
   "jp": "d15e5919fe",
   "kr": "이건 특별히 어려운 일은 아니야."
  },
  "79": {
   "jp": "1659447369",
   "kr": "율 씨를 위해 간단한 심부름만 하면 돼."
  },
  "80": {
   "jp": "7f101a7d75",
   "kr": "키트 마을 율 씨 댁에서 자세한 이야기를 들어."
  },
  "81": {
   "jp": "75a5710cc1",
   "kr": "에린 씨는 손주 생일에"
  },
  "82": {
   "jp": "6ce2f16a57",
   "kr": "스웨터를 선물하고 싶대요."
  },
  "83": {
   "jp": "c830826f72",
   "kr": "몰래 작업하고 싶어서"
  },
  "84": {
   "jp": "deb07d3d58",
   "kr": "누군가 손자 대신"
  },
  "85": {
   "jp": "fd796e0076",
   "kr": "치수를 재게 해 줄 사람을 모집하고 있어요."
  },
  "86": {
   "jp": "28bf8774f6",
   "kr": "에린 씨 댁은 세타 방면 출구 옆이에요."
  },
  "87": {
   "jp": "908dd2c953",
   "kr": "수로 앞이니까"
  },
  "88": {
   "jp": "b8c5fcd051",
   "kr": "계단을 내려가세요."
  },
  "89": {
   "jp": "bcefe33295",
   "kr": "마발 씨는 솜씨 좋은 보석 장인이야."
  },
  "90": {
   "jp": "f865ee58de",
   "kr": "보석 연마에 쓰는 연마 모래를"
  },
  "91": {
   "jp": "aa4bad5f70",
   "kr": "필딘 채굴장까지"
  },
  "92": {
   "jp": "b41d920ff0",
   "kr": "가지러 가 달래요."
  },
  "93": {
   "jp": "aa1ac16dc6",
   "kr": "채굴장 담당관에게 줄 소개장이 필요하니"
  },
  "94": {
   "jp": "fc6c9ea516",
   "kr": "먼저 마발 씨에게 들러 줘."
  },
  "95": {
   "jp": "5b6a64dc8f",
   "kr": "마발 씨 댁은"
  },
  "96": {
   "jp": "18adafe669",
   "kr": "수로로 내려가는 계단을 내려간 곳이야."
  },
  "97": {
   "jp": "c9b9087bea",
   "kr": "율 씨를 위해"
  },
  "98": {
   "jp": "59b1ba59d2",
   "kr": "잠깐 심부름만 해 주면 돼."
  }
 }
}
