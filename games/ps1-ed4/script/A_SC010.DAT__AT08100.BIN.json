 "segments": {
  "0": {
   "jp": "0224567e7f",
   "kr": "네프티스"
  },
  "1": {
   "jp": "da75e15548",
   "kr": "어빈은 정령 네프티스의 목소리를 들었다."
  },
  "2": {
   "jp": "dff7983271",
   "kr": "발두스의 신령을 바라는 자여."
  },
  "3": {
   "jp": "efba758c5c",
   "kr": "붙잡혀 있던 내 마음을 되찾아 준 자여."
  },
  "4": {
   "jp": "7694728975",
   "kr": "그대에게 신의 늠름한 왼팔의 자취,"
  },
  "5": {
   "jp": "72814c7e6e",
   "kr": "을(를) 맡기노라."
  },
  "6": {
   "jp": "6554251f82",
   "kr": "해냈네."
  },
  "7": {
   "jp": "c3f8c2f40e",
   "kr": "응."
  },
  "8": {
   "jp": "b0992d8cdf",
   "kr": "그나저나"
  },
  "9": {
   "jp": "bd3721a2f9",
   "kr": "어째서 정령의 마음이 흐트러져 있었던 거지?"
  },
  "10": {
   "jp": "6116dcdca3",
   "kr": "설마, 볼게이드 일당이 먼저 와서…"
  },
  "11": {
   "jp": "c8bd8e9b5d",
   "kr": "오크툼 신도들이…?"
  },
  "12": {
   "jp": "b421ae7007",
   "kr": "충분히 있을 수 있는 일이야."
  },
  "13": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "14": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다.",
   "auto": 1
  },
  "15": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "16": {
   "jp": "ccd7176466",
   "kr": "을(를) 입수할 수 없다.",
   "auto": 1
  }
 }
