{
 "archive": "/A/SC007.DAT",
 "member": "..\\BIN\\AT05000.BIN",
 "segments": {
  "0": {
   "jp": "2392d74e84",
   "kr": "디너켄"
  },
  "1": {
   "jp": "b363d9ce3d",
   "kr": "바스터"
  },
  "2": {
   "jp": "00cdf72cca",
   "kr": "칸"
  },
  "3": {
   "jp": "077adf4721",
   "kr": "손님을 모셔 왔습니다."
  },
  "4": {
   "jp": "01b3ec7525",
   "kr": "…어빈?"
  },
  "5": {
   "jp": "41fb6c4b63",
   "kr": "어째서 여기에…"
  },
  "6": {
   "jp": "3afe04b8bc",
   "kr": "관계없는 자를 끌어들이지 마라!"
  },
  "7": {
   "jp": "ce74749ca7",
   "kr": "정말 관계가 없을까?"
  },
  "8": {
   "jp": "1267dd154d",
   "kr": "너희는 대체…?"
  },
  "9": {
   "jp": "3c084aff7d",
   "kr": "질문하고 있는 건 나야."
  },
  "10": {
   "jp": "007732d9d0",
   "kr": "카테드랄에 신보는 없었어."
  },
  "11": {
   "jp": "84565bad50",
   "kr": "누군가가 가지고 나간 거야."
  },
  "12": {
   "jp": "e1e321a5fa",
   "kr": "거기에는 발두스의 신보 중에서"
  },
  "13": {
   "jp": "b5adcb5b35",
   "kr": "카베사와 쿠엘포가 있었을 텐데."
  },
  "14": {
   "jp": "a74b1c7380",
   "kr": "이 현자님은 정말 과묵해."
  },
  "15": {
   "jp": "c71d23f0ed",
   "kr": "오랫동안 눈싸움이 이어졌는데"
  },
  "16": {
   "jp": "ac3ad0d7ab",
   "kr": "네가 와 준 덕분에 끝낼 수 있겠네."
  },
  "17": {
   "jp": "0ecbf3a404",
   "kr": "카테드랄에서 달아나"
  },
  "18": {
   "jp": "183b79230b",
   "kr": "레뮤라스 곁에 있었잖아?"
  },
  "19": {
   "jp": "cfb706d932",
   "kr": "게다가 현자님도 너를 알고 있고."
  },
  "20": {
   "jp": "0ff57692f6",
   "kr": "우리는 카베사와"
  },
  "21": {
   "jp": "be3726668d",
   "kr": "쿠엘포를 원할 뿐이야."
  },
  "22": {
   "jp": "e874ef7c3d",
   "kr": "너라면 기대에 부응해 줄 것 같은데?"
  },
  "23": {
   "jp": "ee87dc36c1",
   "kr": "이 영감의 목숨이 아깝다면"
  },
  "24": {
   "jp": "afd525154f",
   "kr": "허튼 생각은 하지 마라."
  },
  "25": {
   "jp": "ab75e5a3d4",
   "kr": "네놈들… 사교도냐."
  },
  "26": {
   "jp": "3ae8176afb",
   "kr": "오크툼 신을 숭배하는 자라고 불러 줬으면 좋겠네."
  },
  "27": {
   "jp": "ae50a2cacf",
   "kr": "아직 대답을 못 들었는데."
  },
  "28": {
   "jp": "dd06a0426e",
   "kr": "신보의 행방을 알고 있어?"
  },
  "29": {
   "jp": "340faaf587",
   "kr": "아니, 「가지고 있어?」라고"
  },
  "30": {
   "jp": "42b3e09d48",
   "kr": "물어야 하려나."
  },
  "31": {
   "jp": "98d8a2bc56",
   "kr": "…카베사를 넘기면"
  },
  "32": {
   "jp": "9c7e2c1313",
   "kr": "얌전히 물러가는 거겠지?"
  },
  "33": {
   "jp": "3b04896971",
   "kr": "그래…"
  },
  "34": {
   "jp": "bd63a2b5c7",
   "kr": "역시 가지고 있었구나."
  },
  "35": {
   "jp": "c0f4606d07",
   "kr": "어빈!",
   "auto": 1
  },
  "36": {
   "jp": "71b1570b46",
   "kr": "너희끼리라면 도망칠 수 있다."
  },
  "37": {
   "jp": "ad9a580f4e",
   "kr": "가거라!"
  },
  "38": {
   "jp": "18210ce0da",
   "kr": "닥치고 있어!"
  },
  "39": {
   "jp": "cc8aefd4a1",
   "kr": "……"
  },
  "40": {
   "jp": "e3ff7db1b8",
   "kr": "이리 넘겨 주지?"
  },
  "41": {
   "jp": "c0f4606d07",
   "kr": "어빈!",
   "auto": 1
  },
  "42": {
   "jp": "50842963fa",
   "kr": "카베사는 되찾을 수 있어."
  },
  "43": {
   "jp": "630391c849",
   "kr": "하지만 사람의 목숨은"
  },
  "44": {
   "jp": "b4162a77b5",
   "kr": "돌이킬 수 없잖아."
  },
  "45": {
   "jp": "a2f4e2cef2",
   "kr": "말이 통하는 꼬마라서 다행이군."
  },
  "46": {
   "jp": "dddd29580a",
   "kr": "…어빈.",
   "auto": 1
  },
  "47": {
   "jp": "eb4bdbfc81",
   "kr": "젠장, 이 개 녀석이!"
  },
  "48": {
   "jp": "e04b3abbd4",
   "kr": "이렇게 된 이상 힘으로 빼앗을 뿐이다."
  },
  "49": {
   "jp": "86509e1eb5",
   "kr": "바스터! 물러나!"
  },
  "50": {
   "jp": "354072f57f",
   "kr": "하지만 루티스!"
  },
  "51": {
   "jp": "4e20730c50",
   "kr": "신보를 눈앞에 두고 이대로 물러나다니…"
  },
  "52": {
   "jp": "c95d2d0005",
   "kr": "카베사의 주인을 알아낸 것만으로도"
  },
  "53": {
   "jp": "11f0dc3b7e",
   "kr": "충분한 수확이야."
  },
  "54": {
   "jp": "6916b93078",
   "kr": "지금 싸우면 그들은 디너켄을 지키려고"
  },
  "55": {
   "jp": "8039f305d2",
   "kr": "필사적으로 저항할 거야."
  },
  "56": {
   "jp": "78659644d8",
   "kr": "윽."
  },
  "57": {
   "jp": "7df9c6f8d3",
   "kr": "꼬마, 승부는 다음으로 미뤄 두마."
  },
  "58": {
   "jp": "61b4493889",
   "kr": "다친 데는 없느냐?"
  },
  "59": {
   "jp": "77f2d9dc7f",
   "kr": "카베사가 무사해서 다행이었다."
  },
  "60": {
   "jp": "09165096a1",
   "kr": "거실로 가자."
  },
  "61": {
   "jp": "c67283b791",
   "kr": "하고 싶은 얘기가 산더미처럼 많다."
  }
 }
}
