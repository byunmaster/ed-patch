  "7": {
   "jp": "10c52ed174",
   "kr": "돌크",
   "auto": 1
  },
  "8": {
   "jp": "366172bf6b",
   "kr": "도적",
   "auto": 1
  },
  "9": {
   "jp": "e2902eeea7",
   "kr": "뭐야, 자네들은."
  },
  "10": {
   "jp": "7ec0e7ea0e",
   "kr": "날 데리러 온 건가?"
  },
  "11": {
   "jp": "44a296cff6",
   "kr": "알선소에서 의뢰를 받았어."
  },
  "12": {
   "jp": "6658575dce",
   "kr": "이 동굴은 위험하다고."
  },
  "13": {
   "jp": "c87b12f2fb",
   "kr": "그런 건 나도 잘 알고 있다네."
  },
  "14": {
   "jp": "0836259bc1",
   "kr": "이 동굴에는 내 조상이 남겨 준"
  },
  "15": {
   "jp": "ea31c201d5",
   "kr": "고마운 보물이 있지."
  },
  "16": {
   "jp": "58e680a2ff",
   "kr": "그 보물을 찾을 때까지"
  },
  "17": {
   "jp": "45ed08e06a",
   "kr": "난 절대 동굴에서 나가지 않을 걸세!"
  },
  "18": {
   "jp": "05a22f42f3",
   "kr": "마수에게 습격당하면 어쩌려고?"
  },
  "19": {
   "jp": "6e2bef63ce",
   "kr": "보물보다 목숨이 더 소중하잖아."
  },
  "20": {
   "jp": "a4fd152a13",
   "kr": "애송이가 아는 척 떠들지 말게!"
  },
  "21": {
   "jp": "88375fd337",
   "kr": "내가 찾는 보물이 있으면"
  },
  "22": {
   "jp": "b841874637",
   "kr": "얼마나 많은 농부가 도움을 받겠나."
  },
  "23": {
   "jp": "fc2c8f916b",
   "kr": "…농부가 도움을 받는다고?"
  },
  "24": {
   "jp": "a653c66a2e",
   "kr": "보리를 효과적으로 키우는 법과"
  },
  "25": {
   "jp": "96eb4973e8",
   "kr": "방충 작용이 있는 비료 만드는 법을 적은 양피지일세."
  },
  "26": {
   "jp": "ff11c58157",
   "kr": "농부에게는 꿈같은 보물이지."
  },
  "27": {
   "jp": "8da515b9be",
   "kr": "그런데 도무지 찾을 수가 없어."
  },
  "28": {
   "jp": "313b978721",
   "kr": "흐음.",
   "auto": 1
  },
  "29": {
   "jp": "e468826ab6",
   "kr": "그 『양피지』만 찾으면"
  },
  "30": {
   "jp": "9684f397a9",
   "kr": "얌전히 돌아갈 거야?"
  },
  "31": {
   "jp": "d03f7ce8d1",
   "kr": "그렇다네."
  },
  "32": {
   "jp": "5c453e7b25",
   "kr": "자네, 같이 찾아 주겠나?"
  },
  "33": {
   "jp": "30efeaec9f",
   "kr": "오, 고맙구먼."
  },
  "34": {
   "jp": "461e0f1767",
   "kr": "자네가 양피지를 찾아서"
  },
  "35": {
   "jp": "836ea36c2f",
   "kr": "돌아오기를 여기서 기다리겠네."
  },
  "36": {
   "jp": "01a0af3d94",
   "kr": "그렇다면 할 말은 없네."
  },
  "37": {
   "jp": "253740763f",
   "kr": "내가 직접 찾아낼 뿐일세."
  },
  "38": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "39": {
   "jp": "415f49326f",
   "kr": "을(를) 입수했다.",
   "auto": 1
  },
  "40": {
   "jp": "889ceea3f2",
   "kr": "보물상자에는 "
  },
  "41": {
   "jp": "665e4d5705",
   "kr": "이(가) 들어 있다.",
   "auto": 1
  },
  "42": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "43": {
   "jp": "f5fc3dee34",
   "kr": "을(를) 포기했다.",
   "auto": 1
  },
  "44": {
   "jp": "f99ec25289",
   "kr": "보물상자 안에는 아무것도 없다.",
   "auto": 1
  },
  "45": {
   "jp": "3f6bf5be84",
   "kr": "양피지는 찾았는가?"
  },
  "46": {
   "jp": "0d1384a9bf",
   "kr": "이건 온 세상 사람들에게 도움이 될 걸세."
  },
  "47": {
   "jp": "01eafcb18d",
   "kr": "도와줄 마음이 생겼나?"
  },
  "48": {
   "jp": "b212dc5571",
   "kr": "양피지를 찾아 주겠는가?"
  },
  "49": {
   "jp": "9c014c91b4",
   "kr": "오, 양피지를 손에 넣었구먼!"
  },
  "50": {
   "jp": "1ac5fee342",
   "kr": "어빈은 양피지를 건넸다."
  },
  "51": {
   "jp": "75993e3d53",
   "kr": "이것으로 우리 살림도 윤택해지겠군."
  },
  "52": {
   "jp": "da8efd59db",
   "kr": "젊은이, 이것저것 무리한 말을 해서 미안했네."
  },
  "53": {
   "jp": "416b994b55",
   "kr": "진심으로 고맙게 생각하네."
  },
  "54": {
   "jp": "dea4992c54",
   "kr": "고맙네."
  },
  "55": {
   "jp": "1ab1a3a91d",
   "kr": "음?",
   "auto": 1
  },
  "56": {
   "jp": "a5ea2180a6",
   "kr": "어째서 여기에?"
  },
  "57": {
   "jp": "6dc672f668",
   "kr": "돌크한테서 조수의 지팡이를 빼앗을 거지?"
  },
  "58": {
   "jp": "477aeb8a3a",
   "kr": "우리도 도울게."
  },
  "59": {
   "jp": "e84c80db31",
   "kr": "네페레는 돌크에게 속은 걸"
  },
  "60": {
   "jp": "2c0ef410b8",
   "kr": "아직도 마음에 담아 두고 있어요."
  },
  "61": {
   "jp": "4930d26e94",
   "kr": "당연하지!"
  },
  "62": {
   "jp": "055ec10e76",
   "kr": "니플은 너무 느긋하다니까."
  },
  "63": {
   "jp": "76d3135ac6",
   "kr": "돌크 따위, 흠씬 두들겨 줘야 해!"
  },
  "64": {
   "jp": "4576f20d35",
   "kr": "흠씬 두들기는 건 그렇다 치고"
  },
  "65": {
   "jp": "bd19240988",
   "kr": "도와주겠다니 고맙군."
  },
  "66": {
   "jp": "fe3d66bbb5",
   "kr": "서둘러 돌크를 찾자."
  },
  "67": {
   "jp": "92f6a1935f",
   "kr": "우리가 먼저 잡아도"
  },
  "68": {
   "jp": "f5fc7a0513",
   "kr": "불평은 없기야!"
  },
  "69": {
   "jp": "e49845d86f",
   "kr": "아, 저도 갈게요."
  },
  "70": {
   "jp": "b97e2a8d96",
   "kr": "네페레, 기다려."
  },
  "71": {
   "jp": "40fb4f9ce6",
   "kr": "어쩐지 떠들썩해졌네."
  },
  "72": {
   "jp": "e739a684a2",
   "kr": "쟤들, 무리하지 않으면 좋겠는데."
  },
  "73": {
   "jp": "9e7bebd628",
   "kr": "믿음직한 원군이네요."
  },
  "74": {
   "jp": "5ecc5a229b",
   "kr": "우리도 돌크를 찾아요."
  },
  "75": {
   "jp": "bac44e2328",
   "kr": "어쩐지 떠들썩해졌군."
  },
  "76": {
   "jp": "a729449a65",
   "kr": "어이, 늦었구나."
  },
  "77": {
   "jp": "2e8a00fa7a",
   "kr": "와 줬구나."
  },
  "78": {
   "jp": "3d8ab58606",
   "kr": "알선소에 돌크 관련 일이 나와 있더라."
  },
  "79": {
   "jp": "2359eb5e91",
   "kr": "앞질러 와서 기다렸지."
  },
  "80": {
   "jp": "0c2f159709",
   "kr": "너한테 진 빚을 갚기에는"
  },
  "81": {
   "jp": "a2b468a7ab",
   "kr": "딱 좋은 때야."
  },
  "82": {
   "jp": "9f4391c209",
   "kr": "힘이 돼 주겠어."
  },
  "83": {
   "jp": "dafe7e5b81",
   "kr": "그리고 이번에야말로 워스를 데려갈 거야."
  },
  "84": {
   "jp": "fb6e396c66",
   "kr": "이제 폭주는 없기다."
  },
  "85": {
   "jp": "f636666ee3",
   "kr": "알고 있어."
  },
  "86": {
   "jp": "45eaa665ce",
