  "112": {
   "jp": "2077d94255",
   "kr": "나머지는 우리에게 맡겨 둬."
  },
  "113": {
   "jp": "e27dc45736",
   "kr": "텔레포터 장치를 간파하다니 제법이군!"
  },
  "114": {
   "jp": "05a84bc111",
   "kr": "하지만 아무리 쫓아와도"
  },
  "115": {
   "jp": "e40effe186",
   "kr": "나에겐 이게 있다."
  },
  "116": {
   "jp": "a73e752e0c",
   "kr": "돌크는 조수의 지팡이를 움켜쥐고"
  },
  "117": {
   "jp": "6f331f53b0",
   "kr": "주문 같은 것을 읊었다.",
   "auto": 1
  },
  "118": {
   "jp": "713fd9ff37",
   "kr": "네놈 같은 애송이한테"
  },
  "119": {
   "jp": "9558b9a8f2",
   "kr": "잡힐 수는 없다고!"
  },
  "120": {
   "jp": "d702b9c301",
   "kr": "정말 끈질기군."
  },
  "121": {
   "jp": "360dd02b1a",
   "kr": "미안해요, 돌아갈게요 하고"
  },
  "122": {
   "jp": "84672941d0",
   "kr": "빌어 봐야 늦었다."
  },
  "123": {
   "jp": "752453fa7e",
   "kr": "조수의 지팡이를 전력으로 써 본 적은 없지만"
  },
  "124": {
   "jp": "93b84e3e54",
   "kr": "시험해 볼 좋은 기회다."
  },
  "125": {
   "jp": "161d889523",
   "kr": "거기서 손가락이나 빨며 구경해라!"
  },
  "126": {
   "jp": "a73e752e0c",
   "kr": "돌크는 조수의 지팡이를 움켜쥐고"
  },
  "127": {
   "jp": "6f331f53b0",
   "kr": "주문 같은 것을 읊었다.",
   "auto": 1
  },
  "128": {
   "jp": "f3361cb89e",
   "kr": "대, 대단한 마력이야!"
  },
  "129": {
   "jp": "27d3c53f85",
   "kr": "뭐야, 이 마력은!"
  },
  "130": {
   "jp": "c8c8b27831",
   "kr": "지금까지와는 비교도 안 될 만큼 강력해!"
  },
  "131": {
   "jp": "b59100c07f",
   "kr": "앗, 안 돼요!"
  },
  "132": {
   "jp": "411a56cd71",
   "kr": "마력이 엄청나게 휘몰아치고 있어요."
  },
  "133": {
   "jp": "3eca95c41d",
   "kr": "뭐, 뭐야 이 마력은!"
  },
  "134": {
   "jp": "278c282006",
   "kr": "위, 위험해!!"
  },
  "135": {
   "jp": "4eb515c834",
   "kr": "하하!"
  },
  "136": {
   "jp": "b901910371",
   "kr": "놀라 자빠져라."
  },
  "137": {
   "jp": "8fdb54afdf",
   "kr": "이 지팡이의… 지, 팡, 이의…"
  },
  "138": {
   "jp": "b071896c19",
   "kr": "돌크의 상태가 이상해."
  },
  "139": {
   "jp": "bed9dd3e19",
   "kr": "…마력이 폭주하고 있어!"
  },
  "140": {
   "jp": "52cb90a71e",
   "kr": "돌크, 지팡이를 놓아!"
  },
  "141": {
   "jp": "0e364dbe09",
   "kr": "마력이 폭주하는 게 안 보여!?"
  },
  "142": {
   "jp": "0639e423c7",
   "kr": "아아!"
  },
  "143": {
   "jp": "b09a7d9aa3",
   "kr": "지팡이의 마력에 돌크가 삼켜지고 있어요!"
  },
  "144": {
   "jp": "ec1c0381a2",
   "kr": "도, 돌크!"
  },
  "145": {
   "jp": "c8d58ce32b",
   "kr": "지팡이에 삼켜진다!"
  },
  "146": {
   "jp": "bf26cb2ede",
   "kr": "으아아～!!"
  },
  "147": {
   "jp": "8a1a5b55c6",
   "kr": "…이럴 수가."
  },
  "148": {
   "jp": "5d924f4e6f",
   "kr": "지팡이의 마력이 돌크를 마수로…"
  },
  "149": {
   "jp": "91f18495f1",
   "kr": "으, 으으."
  },
  "150": {
   "jp": "631f31e090",
   "kr": "나는 마수가, 된, 건가…?"
  },
  "151": {
   "jp": "a42d6ed757",
   "kr": "젠장, 이렇게 된 이상"
  },
  "152": {
   "jp": "9fb5621789",
   "kr": "하다못해, 너희를, 저승으로 보내 주마!"
  },
  "153": {
   "jp": "3ab54e4a0f",
   "kr": "어빈, 조수의 지팡이가"
  },
  "154": {
   "jp": "aa0a0dfa53",
   "kr": "산산조각 났어."
  },
  "155": {
