  },
  "11": {
   "jp": "64b39cf745",
   "kr": "……"
  },
  "12": {
   "jp": "b283c4b26e",
   "kr": "어빈, 무슨 생각 해?"
  },
  "13": {
   "jp": "437fc7fa4a",
   "kr": "응?"
  },
  "14": {
   "jp": "4a34b9ff84",
   "kr": "아이멜 생각이야?"
  },
  "15": {
   "jp": "de1fb819ce",
   "kr": "괜찮아. 곧 따라잡을 거야."
  },
  "16": {
   "jp": "c3f8c2f40e",
   "kr": "그래."
  },
  "17": {
   "jp": "ca195a2998",
   "kr": "바닷바람이 기분 좋네."
  },
  "18": {
   "jp": "2affe5aabf",
   "kr": "어빈이랑 같이 오길 잘했어."
  },
  "19": {
   "jp": "e7b386191a",
   "kr": "울트 마을엔 산밖에 없으니까."
  },
  "20": {
   "jp": "ec962419d6",
   "kr": "배 여행은 처음이라"
  },
  "21": {
   "jp": "0c7ed5c911",
   "kr": "왠지 두근두근해."
  },
  "22": {
   "jp": "c9882fd356",
   "kr": "세타에 도착할 때까지는 바람 가는 대로니까."
  },
  "23": {
   "jp": "64c48ba209",
   "kr": "서두르지 말고 배 여행을 즐기자."
  },
  "24": {
   "jp": "47f301e723",
   "kr": "어이! 저걸 봐!"
  },
  "25": {
   "jp": "af60a436e4",
   "kr": "앞서 가던 정기선이 해적의 습격을 받고 있다!!"
  },
  "26": {
   "jp": "16690e3af0",
   "kr": "어이, 보테!!"
  },
  "27": {
   "jp": "7cfe4ce3fa",
   "kr": "무슨 일이야?"
  },
  "28": {
   "jp": "05ff6dcd5a",
   "kr": "앗!?"
  },
  "29": {
   "jp": "990a108d24",
   "kr": "저건 앞 배 아닌가?"
  },
  "30": {
   "jp": "53c16cc2fd",
   "kr": "어떻게든 도울 수 없나?"
  },
  "31": {
   "jp": "e881a570a8",
   "kr": "이 조류로는 항로 변경이 어렵다."
  },
  "32": {
   "jp": "308b222949",
   "kr": "잘못하면 앞질러 버려."
  },
  "33": {
   "jp": "188c6409a3",
   "kr": "죽게 내버려 두자는 거냐…?"
  },
  "34": {
   "jp": "a75d7d7c66",
   "kr": "도울 방법은 없나요?"
  },
  "35": {
   "jp": "9bdd73bc50",
   "kr": "저 배에는 아이멜이…"
  },
  "36": {
   "jp": "0fbd33c91c",
   "kr": "저희 아는 사람이 타고 있을지도 몰라요."
  },
  "37": {
   "jp": "dbe3a3dc41",
   "kr": "으음…"
  },
  "38": {
   "jp": "bd7330a83c",
   "kr": "저쪽 배는 조류에서 벗어나 멈춰 있는 것 같다."
  },
  "39": {
   "jp": "0829b2c2f2",
   "kr": "하려면…"
  },
  "40": {
   "jp": "d647f7acb7",
   "kr": "이쪽 승객에게도 위험이 따르지만…"
  },
  "41": {
   "jp": "bbdb5dd956",
   "kr": "저쪽 배에 부딪쳐서 멈추게 하는 수밖에 없다."
  },
  "42": {
   "jp": "aadcdc8e41",
   "kr": "해적은 저희가 어떻게든 할게요."
  },
  "43": {
   "jp": "2b00aa3c7b",
   "kr": "잘 부탁드려요."
  },
  "44": {
   "jp": "7f629a7675",
   "kr": "좋아, 좀 거칠지만 해 보자."
  },
  "45": {
   "jp": "e9f40122a1",
   "kr": "흔들릴 테니 꽉 잡고 있어라!"
  },
  "46": {
   "jp": "e707627cec",
   "kr": "승객 여러분!"
  },
  "47": {
   "jp": "42c3bfaaf5",
   "kr": "본선은 앞쪽 배를 구조하기 위해"
  },
  "48": {
   "jp": "8cedb5bb53",
   "kr": "가속하겠습니다."
  },
  "49": {
   "jp": "b4eee87b3d",
   "kr": "모든 분은 가까운 기둥을 꼭 잡아 주십시오."
  },
  "50": {
   "jp": "4a4f38d81b",
   "kr": "…간다～!!"
  },
  "51": {
   "jp": "e85fdfd347",
   "kr": "아이멜……"
  },
  "52": {
   "jp": "d0779765cc",
   "kr": "오빠.",
   "auto": 1
  },
  "53": {
   "jp": "44120b91fd",
   "kr": "분명 또 만날 수 있을 거라고 생각했어."
  },
  "54": {
   "jp": "be420bbf7b",
   "kr": "잘 지냈어?"
  },
  "55": {
   "jp": "f778ec08ab",
   "kr": "응.",
   "auto": 1
  },
  "56": {
   "jp": "b5727976d8",
   "kr": "오레시아 선생님이 데려가 주셔서"
  },
  "57": {
   "jp": "6938b177d2",
   "kr": "그 뒤로 베네키아 수도원에서 지냈어."
  },
  "58": {
   "jp": "536798019d",
   "kr": "다들 잘해 주셨어."
  },
  "59": {
   "jp": "262c655510",
   "kr": "그래, 베네키아 수도원에서 오레시아 선생님을 만났어."
  },
  "60": {
   "jp": "2f51bc8cf7",
   "kr": "다들 좋은 사람 같더라."
  },
  "61": {
   "jp": "1dca2a3ed4",
   "kr": "응."
  },
  "62": {
   "jp": "30e44c0cd1",
   "kr": "누브 씨도 미스란도, 에레타 씨도 프랑도"
  },
  "63": {
   "jp": "d5b9008385",
   "kr": "그리고 드라크 할아버지도…"
  },
  "64": {
   "jp": "703f1db4f0",
   "kr": "다들 정말 좋은 사람들뿐이야."
  },
  "65": {
   "jp": "3a5b0b2ffd",
   "kr": "…앗?!"
  },
  "66": {
   "jp": "633171ac72",
   "kr": "수도원은…! 수도원은 괜찮았어?"
  },
  "67": {
   "jp": "f02808e453",
   "kr": "오레시아 선생님이…"
  },
  "68": {
   "jp": "1e6611ae9d",
   "kr": "사교도가 쳐들어올지도 모른다고 하셨어."
  },
  "69": {
   "jp": "9a91e84359",
   "kr": "그래서 쿠엘포를 발크드에 전하라고…"
  },
  "70": {
   "jp": "6bc2f521c2",
   "kr": "우리가 도착하기 조금 전에 습격을 받았다더군."
  },
  "71": {
   "jp": "aab193e9c7",
   "kr": "하지만 안심해. 다친 사람은 한 명도 없었어."
  },
  "72": {
   "jp": "389491cb8e",
   "kr": "쿠엘포를 찾느라"
  },
  "73": {
   "jp": "15851e0d6d",
   "kr": "수도원을 꽤 어지럽힌 모양이지만."
  },
  "74": {
   "jp": "9c8d700f91",
   "kr": "수도원에서 다른 곳으로 옮긴 걸 알고"
  },
  "75": {
   "jp": "b05427d737",
   "kr": "포기한 모양이야."
  },
  "76": {
   "jp": "67d0c54c31",
   "kr": "그놈들도"
  },
  "77": {
   "jp": "c6fd64e6fd",
   "kr": "오레시아 선생님들이 입을 열지 않을 거라는 걸"
  },
  "78": {
   "jp": "87db1b9a5a",
   "kr": "알았겠지."
  },
  "79": {
   "jp": "2e6d1b50f5",
   "kr": "다행이다. 무사해서…"
  },
  "80": {
   "jp": "3ddb4c986a",
   "kr": "８년 만의 재회였다."
  },
  "81": {
   "jp": "71c98f4487",
   "kr": "두 사람은 헤어진 뒤 오늘까지의 일을 이야기했다."
  },
  "82": {
   "jp": "8cae154b6b",
   "kr": "어빈은 산에서 레뮤라스와 보낸 생활을…"
  },
  "83": {
   "jp": "84225c420b",
   "kr": "아이멜은 수도원 생활을…"
  },
  "84": {
   "jp": "1187a82f8a",
   "kr": "…두 사람의 이야기는 끝날 줄 몰랐다."
  },
  "85": {
   "jp": "8398d4ec70",
   "kr": "마일 님. 역시 와 주셨네."
  },
  "86": {
   "jp": "bcd9327e87",
   "kr": "섀넌이 위기일 때는 마일 님이 나타나."
  },
  "87": {
   "jp": "c62f6de35f",
   "kr": "마일 님이 위기일 때는 섀넌이 나타나."
  },
  "88": {
   "jp": "8a47dab587",
   "kr": "생각한 대로야."
  },
  "89": {
   "jp": "6a3f3ddda6",
   "kr": "……저, 저기 말이야."
  },
  "90": {
   "jp": "b29e5d06a6",
   "kr": "난 아직 한 번도"
  },
  "91": {
   "jp": "be2f6d2046",
   "kr": "위기에서 도움받은 적은 없는데?"
  },
  "92": {
   "jp": "395cb69b7c",
   "kr": "괜찮아, 신경 쓰지 마."
  },
  "93": {
   "jp": "e3960fd58f",
   "kr": "괜찮다니…"
  },
  "94": {
   "jp": "764095a0a9",
   "kr": "마일 님은 역시 섀넌의 왕자님이야."
  },
  "95": {
   "jp": "eb549d4723",
   "kr": "또 그런 소리를…"
  },
  "96": {
   "jp": "c15755f78a",
   "kr": "해적 소동이 있었지만"
  },
  "97": {
   "jp": "d26305ee65",
   "kr": "어빈과 아이멜은 바다 위에서 무사히 재회했다."
  },
  "98": {
   "jp": "afcc4b90d1",
   "kr": "항해는 순조롭게 이어졌다."
  },
  "99": {
   "jp": "d5a0bda504",
   "kr": "발크드로 가자."
  },
  "100": {
   "jp": "1d5d12dcdb",
   "kr": "카베사와 쿠엘포를 전하는 거야."
  },
  "101": {
   "jp": "b0088e8f1f",
   "kr": "전한 다음엔 어떻게 해?"
  },
  "102": {
   "jp": "3de7cc9a28",
   "kr": "어떻게 하냐니?"
  },
  "103": {
   "jp": "3e5f64e073",
   "kr": "루티스가 말했잖아."
  },
  "104": {
   "jp": "8982e32c92",
   "kr": "사교도들도 발두스의 신보를"
  },
  "105": {
   "jp": "2d114d787c",
   "kr": "노리고 있다고."
  },
  "106": {
   "jp": "27feadbaf2",
   "kr": "무슨 속셈인지는 모르지만"
  },
  "107": {
   "jp": "c2588efd67",
   "kr": "좋은 일이 아니라는 것만은 분명하다고 생각해."
  },
  "108": {
   "jp": "887cdb0336",
   "kr": "남은 네 개의 신보도 우리가 찾아서"
  },
  "109": {
   "jp": "329f58f7c6",
   "kr": "발크드에 맡기는 게 좋지 않을까."
  },
  "110": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "111": {
   "jp": "106dfc9f70",
   "kr": "앞으로의 일은… 나중에 생각하자."
  },
  "112": {
   "jp": "e6476044fb",
   "kr": "지금은 아이멜의 일을 해내기 위해"
  },
  "113": {
   "jp": "219c538041",
   "kr": "발크드에 가서 쿠엘포와"
  },
  "114": {
   "jp": "b34ce19bd1",
   "kr": "내가 가진 카베사를 전하는 것뿐이야."
  },
  "115": {
   "jp": "bf70b025c9",
   "kr": "뭐야… 어빈답지 않네?"
  },
  "116": {
   "jp": "530a8a4ff0",
   "kr": "오빠는…"
  },
  "117": {
   "jp": "565c8e9880",
   "kr": "어릴 적 일을 떠올리고 있는 거예요."
  },
  "118": {
   "jp": "381ad89331",
   "kr": "분명……"
  },
  "119": {
   "jp": "dd56a022dd",
   "kr": "어…?",
   "auto": 1
  },
  "120": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "121": {
   "jp": "2a4feb7594",
   "kr": "우리가 헤어져야 했던 것도"
  },
  "122": {
   "jp": "5cfb88b077",
   "kr": "정교도와 사교도의"
  },
  "123": {
   "jp": "b337f6008c",
   "kr": "싸움에 휘말렸기 때문이에요."
  },
  "124": {
   "jp": "1b77f97bd4",
   "kr": "그래서 마음 한구석에서"
  },
  "125": {
   "jp": "4356680885",
   "kr": "이제 신보에는 되도록 얽히고 싶지 않다고"
  },
  "126": {
   "jp": "fc00406938",
   "kr": "생각하고 있는 거예요."
  },
  "127": {
   "jp": "5afb1c2159",
   "kr": "그렇구나… 그랬던 거구나."
  },
  "128": {
   "jp": "9bea930d57",
   "kr": "미안, 어빈."
  },
  "129": {
   "jp": "b407200947",
   "kr": "괜찮아.",
   "auto": 1
  },
  "130": {
   "jp": "96b6409d69",
   "kr": "있잖아요, 마일 님."
  },
  "131": {
   "jp": "0171b03fd8",
   "kr": "저도 따라가도 되죠?"
  },
  "132": {
   "jp": "af93c82271",
   "kr": "에엣. 왜, 왜?"
  },
  "133": {
   "jp": "c299cb9ce6",
   "kr": "마일 님이 발크드에 가신다면"
  },
  "134": {
   "jp": "a0fbebfe4f",
   "kr": "섀넌도 가겠어요."
  },
  "135": {
   "jp": "c6f3ff47d1",
   "kr": "이렇게 짧은 사이에 몇 번이나 만나다니"
  },
  "136": {
   "jp": "1eac47ef76",
   "kr": "이제 우연이 아니에요."
  },
  "137": {
   "jp": "e577188867",
   "kr": "이건 섀넌과 마일 님의 운명이에요."
  },
  "138": {
   "jp": "9409c99f6f",
   "kr": "또, 또 그런 소리를…"
  },
  "139": {
   "jp": "d90f49c658",
   "kr": "하지만… 마일."
  },
  "140": {
   "jp": "67bc955566",
   "kr": "배는 벌써 세타 항구에 도착하려 하고 있어."
  },
  "141": {
   "jp": "ef1d4de6da",
   "kr": "여기까지 와서"
  },
  "142": {
   "jp": "21ab9549ae",
   "kr": "세타 항구에 닿으면 안녕이라고 할 수도"
  },
  "143": {
   "jp": "160b843002",
   "kr": "없잖아."
  },
  "144": {
   "jp": "af3ccc3648",
   "kr": "신난다! 역시 어빈 님."
  },
  "145": {
   "jp": "627c99482f",
   "kr": "말이 통하네."
  },
  "146": {
   "jp": "1182a7cb4f",
   "kr": "휴… 어쩔 수 없나…"
  },
  "147": {
   "jp": "f014142e3b",
   "kr": "곧 세타 항구입니다."
  },
  "148": {
   "jp": "52182126dc",
   "kr": "하선 준비를 부탁드립니다."
  },
  "149": {
   "jp": "ce41a0f806",
   "kr": "어빈 일행을 태운 배는 무사히 바다를 건너"
  },
  "150": {
   "jp": "d2f21f9524",
   "kr": "세타 항구에 도착했다."
  },
  "151": {
   "jp": "2fd10da974",
   "kr": "여, 너희."
  },
  "152": {
   "jp": "310edaf28d",
   "kr": "이 배, 타 보니 어때?"
  },
  "153": {
   "jp": "d570f68f0a",
   "kr": "최고예요."
  },
  "154": {
   "jp": "73a88df2d7",
   "kr": "배가 이렇게 좋은 건지 몰랐어."
  },
  "155": {
