{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02210.BIN",
 "segments": {
  "0": {
   "jp": "03e53a5d41",
   "kr": "사서관"
  },
  "1": {
   "jp": "1f23b35c4f",
   "kr": "버너"
  },
  "2": {
   "jp": "9284b36bbc",
   "kr": "박사"
  },
  "3": {
   "jp": "b0d9252542",
   "kr": "소녀"
  },
  "4": {
   "jp": "cbff005b84",
   "kr": "여기서는 누구든 책을 빌릴 수 있어요."
  },
  "5": {
   "jp": "2cf87473e2",
   "kr": "괜찮으시면 짐을 줄이고 오시겠어요?"
  },
  "6": {
   "jp": "07fa3872ee",
   "kr": "대출인가요?"
  },
  "7": {
   "jp": "3cc35b0def",
   "kr": "부탁받은 일이라서요."
  },
  "8": {
   "jp": "4ead4cd59d",
   "kr": "『질풍의 라빈』을 빌리고 싶은데요."
  },
  "9": {
   "jp": "b564acaeed",
   "kr": "『질풍의 라빈』이요."
  },
  "10": {
   "jp": "f45ae932dc",
   "kr": "지금 엄청 인기죠."
  },
  "11": {
   "jp": "99bff51b55",
   "kr": "음… 꽤 권수가 있는데요,"
  },
  "12": {
   "jp": "eccaed8dc1",
   "kr": "전부 빌리시겠어요?"
  },
  "13": {
   "jp": "e61544a72b",
   "kr": "전권 세트로 묶은 팩이 있어요."
  },
  "14": {
   "jp": "0cf0d14bfc",
   "kr": "그거 마침 좋네요."
  },
  "15": {
   "jp": "1ad67fdc18",
   "kr": "그럼 빌리시는 분의 성함과 주소를."
  },
  "16": {
   "jp": "0ab4ecb061",
   "kr": "세타 도구점의 리리카 씨요."
  },
  "17": {
   "jp": "635b795a4c",
   "kr": "네, 됐습니다."
  },
  "18": {
   "jp": "e377fd5789",
   "kr": "그럼 소중히 가져가세요."
  },
  "19": {
   "jp": "72afc34210",
   "kr": "책을 빌렸다."
  },
  "20": {
   "jp": "68647c57e5",
   "kr": "고문서 연구로 오신 분이시군요."
  },
  "21": {
   "jp": "b8f61ab6b1",
   "kr": "박사님은 안쪽 개인실에 계십니다."
  },
  "22": {
   "jp": "db6b874c1e",
   "kr": "고생 많으셨습니다."
  },
  "23": {
   "jp": "4ad674fc3b",
   "kr": "데이지 씨에게는"
  },
  "24": {
   "jp": "c50412dfda",
   "kr": "다음부터 기한을 잘 지키라고 전해 주세요."
  },
  "25": {
   "jp": "6cc29e0cec",
   "kr": "이 도서관에는 ２만 권의 장서가 있어요."
  },
  "26": {
   "jp": "8b92165823",
   "kr": "누구든 자유롭게 읽을 수 있어요."
  },
  "27": {
   "jp": "c770652c69",
   "kr": "요즘 대출한 책의 반납을 미루는 분이 많아서"
  },
  "28": {
   "jp": "c21b9ccb74",
   "kr": "곤란합니다."
  },
  "29": {
   "jp": "dd5429e919",
   "kr": "네, 무슨 일이신가요?"
  },
  "30": {
   "jp": "2aeb180b15",
   "kr": "대출이신가요, 반납이신가요?"
  },
  "31": {
   "jp": "a02f09a654",
   "kr": "…어라, 그 책!"
  },
  "32": {
   "jp": "a3823714ce",
   "kr": "『여검사 사피』 최종권이잖아요!"
  },
  "33": {
   "jp": "5ba3891ce6",
   "kr": "어빈은 책을 건넸다."
  },
  "34": {
   "jp": "e445256ece",
   "kr": "분명 이 책은 데이지 씨가 빌렸을 텐데요."
  },
  "35": {
   "jp": "ca5a91d94e",
   "kr": "그렇다면 대출 기한이 지나서"
  },
  "36": {
   "jp": "ebd8174d32",
   "kr": "부끄러워서 못 오고 있었군요."
  },
  "37": {
   "jp": "d85a9169df",
   "kr": "뭐, 안 돌려주는 것보단 낫지만요."
  },
  "38": {
   "jp": "8e0380d7f9",
   "kr": "이 도서관에는 ２만 권의 장서가 있어요."
  },
  "39": {
   "jp": "8b92165823",
   "kr": "누구든 자유롭게 읽을 수 있어요."
  },
  "40": {
   "jp": "ef5cb1824e",
   "kr": "으헉!?"
  },
  "41": {
   "jp": "e5ff01cfa2",
   "kr": "여기까지 쫓아왔냐!"
  },
  "42": {
   "jp": "cda240085e",
   "kr": "도구점 외상 ９００로제!!"
  },
  "43": {
   "jp": "baf9cfdd54",
   "kr": "와하하, 알게 뭐냐, 그런 거!"
  },
  "44": {
   "jp": "d127cd71c8",
   "kr": "잘 있거라～앙!!"
  },
  "45": {
   "jp": "d880433486",
   "kr": "뭐야, 너는."
  },
  "46": {
   "jp": "3644fcdbe1",
   "kr": "내버려 둬, 숨바꼭질하는 중이야."
  },
  "47": {
   "jp": "570e686412",
   "kr": "젠장, 그 술주정뱅이 영감!!"
  },
  "48": {
   "jp": "79ddf6ab3e",
   "kr": "반드시 잡고 만다!!"
  },
  "49": {
   "jp": "ffe7cf0ac8",
   "kr": "이걸로 마지막이군요."
  },
  "50": {
   "jp": "9981de5821",
   "kr": "그래, 그렇지."
  },
  "51": {
   "jp": "9f5b33eb79",
   "kr": "『행여』의 뜻은 『여행』이다."
  },
  "52": {
   "jp": "5070e3ac6a",
   "kr": "호오, 여행이라는 뜻인가."
  },
  "53": {
   "jp": "c2a5671702",
   "kr": "수고했네."
  },
  "54": {
   "jp": "b9f5886989",
   "kr": "어디, 붙여 볼까."
  },
  "55": {
   "jp": "f32a561d4b",
   "kr": "『곳세』는 『세 곳』"
  },
  "56": {
   "jp": "24b9b25d16",
   "kr": "『점지』는 『지점』"
  },
  "57": {
   "jp": "7c61b3dba8",
   "kr": "『는잇』은 『잇는』"
  },
  "58": {
   "jp": "74906d7b56",
   "kr": "『살빛』은 『빛살』"
  },
  "59": {
   "jp": "027705f071",
   "kr": "『문관』은 『관문』"
  },
  "60": {
   "jp": "49d5705edb",
   "kr": "『리우』는 『우리』"
  },
  "61": {
   "jp": "c2701fe326",
   "kr": "『에간식순』은 『순식간에』"
  },
  "62": {
   "jp": "730b774afd",
   "kr": "『행여』는 『여행』"
  },
  "63": {
   "jp": "cc6d0b1157",
   "kr": "음, 이걸 이으면…"
  },
  "64": {
   "jp": "d3b815b910",
   "kr": "세 곳, 지점, 잇는, 빛살, 관문."
  },
  "65": {
   "jp": "5fa8e040aa",
   "kr": "우리, 순식간에, 여행."
  },
  "66": {
   "jp": "df7a7e1930",
   "kr": "이렇게 되는 건가…"
  },
  "67": {
   "jp": "b225ce99dc",
   "kr": "세 곳의 지점을 잇는 빛살의 관문."
  },
  "68": {
   "jp": "c385e8f5ff",
   "kr": "우리 순식간에 여행… 한다."
  },
  "69": {
   "jp": "7585764bb5",
   "kr": "…이려나?"
  },
  "70": {
   "jp": "8ab63f7c44",
   "kr": "음. 그쯤이겠지."
  },
  "71": {
   "jp": "1e222bde94",
   "kr": "뭐, 하루 일의 성과로는"
  },
  "72": {
   "jp": "4c2110055f",
   "kr": "잘 진행된 편이야."
  },
  "73": {
   "jp": "ac13d3217b",
   "kr": "나머지는 천천히 어순을 다듬으면 끝이네."
  },
  "74": {
   "jp": "2167440a86",
   "kr": "완성되면 번역본을 도서관 책장에 꽂아 둘 테니"
  },
  "75": {
   "jp": "474a660806",
   "kr": "기대해 주게."
  },
  "76": {
   "jp": "d1fa5002e6",
   "kr": "약속한 보수는 알선소에 손을 써 뒀네."
  },
  "77": {
   "jp": "7a61ce9065",
   "kr": "수고했네."
  },
  "78": {
   "jp": "90952b1d71",
   "kr": "호오, 과연."
  },
  "79": {
   "jp": "e57d674a28",
   "kr": "그런 뜻이었구먼."
  },
  "80": {
   "jp": "eda01a0681",
   "kr": "고문서 해독을 하고 있는데"
  },
  "81": {
   "jp": "7d5c96e2f1",
   "kr": "혼자 조사하기엔 여러모로 힘이 들어서 말이야."
  },
  "82": {
   "jp": "bb4a95e3d8",
   "kr": "당장 좀 도와주겠나."
  },
  "83": {
   "jp": "072bd6c247",
   "kr": "우선"
  },
  "84": {
   "jp": "bfea39a1e5",
   "kr": "자, 지금 이걸 번역하고 있네."
  },
  "85": {
   "jp": "8cdbdf3883",
   "kr": "좀 봐 주게."
  },
  "86": {
   "jp": "e191aedb91",
   "kr": "어빈 일행은 박사가 펼친 고문서를 들여다보았다."
  },
  "87": {
   "jp": "399f3b3449",
   "kr": "고문서에는 본 적 없는 문자가 적혀 있었다."
  },
  "88": {
   "jp": "7c58ddbc4a",
   "kr": "이런 걸 번역할 수 있나?"
  },
  "89": {
   "jp": "6f0e31b36d",
   "kr": "착실하게 사전을 찾아 해독하는 것이지."
  },
  "90": {
   "jp": "149b0c2ad0",
   "kr": "학문이란 착실한 노력의 축적이라네."
  },
  "91": {
   "jp": "9790b9e3ca",
   "kr": "머리가 아파 오네."
  },
  "92": {
   "jp": "6b87611f34",
   "kr": "당장 이 부분부터 부탁하네."
  },
  "93": {
   "jp": "9f8c6b76c2",
   "kr": "열람실에 있는 『대번역 해설서』로 찾아 주게."
  },
  "94": {
   "jp": "60c5d67907",
   "kr": "서쪽 책장에 「ㄱ」부터 차례대로 있네."
  },
  "95": {
   "jp": "a4133af45b",
   "kr": "틀리지 않게"
  },
  "96": {
   "jp": "a6f310250b",
   "kr": "한 글자씩 찾아서 나에게 보고해 주게."
  },
  "97": {
   "jp": "7a7724f2b7",
   "kr": "이 한 페이지 분량의 번역을 도와주면"
  },
  "98": {
   "jp": "2494cac09b",
   "kr": "자네들의 일은"
  },
  "99": {
   "jp": "37b7ef48ca",
   "kr": "무사히 달성한 것으로 하지."
  },
  "100": {
   "jp": "ce0f5239eb",
   "kr": "고문서 연구는 깊고도 깊구나."
  },
  "101": {
   "jp": "13ba183ffc",
   "kr": "마치 향기로운 와인을 음미하는 것 같아."
  },
  "102": {
   "jp": "e6172b5255",
   "kr": "먼저"
  },
  "103": {
   "jp": "5bf00eb715",
   "kr": "이 『곳세』라는 말이 무슨 뜻인지"
  },
  "104": {
   "jp": "d64564918b",
   "kr": "조사해 오게."
  },
  "105": {
   "jp": "50c0d9b2fd",
   "kr": "다음은"
  },
  "106": {
   "jp": "92e7b534f0",
   "kr": "이 『점지』라는 말이 무슨 뜻인지"
  },
  "107": {
   "jp": "d64564918b",
   "kr": "조사해 오게."
  },
  "108": {
   "jp": "50c0d9b2fd",
   "kr": "다음은"
  },
  "109": {
   "jp": "428a2ce341",
   "kr": "이 『는잇』이라는 말이 무슨 뜻인지"
  },
  "110": {
   "jp": "d64564918b",
   "kr": "조사해 오게."
  },
  "111": {
   "jp": "50c0d9b2fd",
   "kr": "다음은"
  },
  "112": {
   "jp": "e07dcc23f6",
   "kr": "이 『살빛』이라는 말이 무슨 뜻인지"
  },
  "113": {
   "jp": "d64564918b",
   "kr": "조사해 오게."
  },
  "114": {
   "jp": "50c0d9b2fd",
   "kr": "다음은"
  },
  "115": {
   "jp": "0685fb8b5f",
   "kr": "이 『문관』이라는 말이 무슨 뜻인지"
  },
  "116": {
   "jp": "d64564918b",
   "kr": "조사해 오게."
  },
  "117": {
   "jp": "50c0d9b2fd",
   "kr": "다음은"
  },
  "118": {
   "jp": "16509525ec",
   "kr": "이 『리우』라는 말이 무슨 뜻인지"
  },
  "119": {
   "jp": "d64564918b",
   "kr": "조사해 오게."
  },
  "120": {
   "jp": "50c0d9b2fd",
   "kr": "다음은"
  },
  "121": {
   "jp": "c1f0d42329",
   "kr": "이 『에간식순』이라는 말이 무슨 뜻인지"
  },
  "122": {
   "jp": "d64564918b",
   "kr": "조사해 오게."
  },
  "123": {
   "jp": "7649304361",
   "kr": "그럼 다음이 마지막이네."
  },
  "124": {
   "jp": "e0bd6075d4",
   "kr": "이 『행여』라는 말이 무슨 뜻인지"
  },
  "125": {
   "jp": "d64564918b",
   "kr": "조사해 오게."
  },
  "126": {
   "jp": "20a39d8855",
   "kr": "고대 엘 필딘 문자군요."
  },
  "127": {
   "jp": "b9e36390b2",
   "kr": "호오, 이걸 한눈에 보고서"
  },
  "128": {
   "jp": "a30f601b83",
   "kr": "고대 엘 필딘 문자임을 알다니…"
  },
  "129": {
   "jp": "02fc237356",
   "kr": "자네, 제법이군."
  },
  "130": {
   "jp": "510d49d01e",
   "kr": "그래서 어디를 읽으면 되나요?"
  },
  "131": {
   "jp": "dd56a022dd",
   "kr": "어…?"
  },
  "132": {
   "jp": "edc64395c4",
   "kr": "어디를이라니…"
  },
  "133": {
   "jp": "00e12f21d7",
   "kr": "자네…"
  },
  "134": {
   "jp": "67759f8fd5",
   "kr": "혹시 이걸 읽을 수 있나…?"
  },
  "135": {
   "jp": "b112984f49",
   "kr": "네, 뭐. 이 정도는요."
  },
  "136": {
   "jp": "5ef20978a1",
   "kr": "이, 이 정도라니…"
  },
  "137": {
   "jp": "281695c384",
   "kr": "내가 온갖 번역서와 씨름해서"
  },
  "138": {
   "jp": "eb5eaaeca3",
   "kr": "한 페이지를 번역하는 데"
  },
  "139": {
   "jp": "56427585d0",
   "kr": "반년이나 걸렸단 말일세."
  },
  "140": {
   "jp": "cb36900b12",
   "kr": "그거 힘드셨겠네요."
  },
  "141": {
   "jp": "0263547e5a",
   "kr": "그야 힘들었지."
  },
  "142": {
   "jp": "396ba3700c",
   "kr": "번역서를 찾아가면서라면"
  },
  "143": {
   "jp": "36f756040b",
   "kr": "역시 그 정도는 걸리겠죠."
  },
  "144": {
   "jp": "a182b9397b",
   "kr": "하지만 이 고대 문자에는"
  },
  "145": {
   "jp": "2fffed3803",
   "kr": "더 간단한 법칙이 있어요."
  },
  "146": {
   "jp": "2612c8cc87",
   "kr": "모르세요?"
  },
  "147": {
   "jp": "ff434a948b",
   "kr": "아니… 모르는데…?"
  },
  "148": {
   "jp": "723f5b1332",
   "kr": "트릭 같은 거예요."
  },
  "149": {
   "jp": "019e4aeee4",
   "kr": "트릭?"
  },
  "150": {
   "jp": "b7256913e2",
   "kr": "원래 엘 필딘의 문자예요."
  },
  "151": {
   "jp": "efe38971ff",
   "kr": "아무리 먼 옛날 것이라도"
  },
  "152": {
   "jp": "4e38c3f624",
   "kr": "그렇게 달라질 리가 없잖아요."
  },
  "153": {
   "jp": "31362d507f",
   "kr": "만약 판독할 수 없을 만큼 달라졌다면"
  },
  "154": {
   "jp": "59e49b709f",
   "kr": "그건 의도적인 트릭이거나"
  },
  "155": {
   "jp": "ea83cacf70",
   "kr": "다른 문명의 것이라는 얘기가 돼요."
  },
  "156": {
   "jp": "bbeffab1a9",
   "kr": "하지만 어느 정도는 번역서로 번역할 수 있어요."
  },
  "157": {
   "jp": "2cee786a33",
   "kr": "그렇다면 이 문자는"
  },
  "158": {
   "jp": "bd746f2325",
   "kr": "의도적으로 암호화된 것으로 보여요."
  },
  "159": {
   "jp": "aacb1b3f25",
   "kr": "과연…"
  },
  "160": {
   "jp": "2d98409dd4",
   "kr": "그렇군."
  },
  "161": {
   "jp": "fb38482b46",
   "kr": "자, 이 문자."
  },
  "162": {
   "jp": "1bf5380151",
   "kr": "왼쪽에서부터 가로쓰기로 되어 있죠?"
  },
  "163": {
   "jp": "0080bcada6",
   "kr": "이걸 투명한 거울에 비춰서"
  },
  "164": {
   "jp": "a751d64b0a",
   "kr": "좌우로 뒤집었다고 생각해 보세요."
  },
  "165": {
   "jp": "6557d7d0a6",
   "kr": "으음."
  },
  "166": {
   "jp": "db2f611509",
   "kr": "이대로는"
  },
  "167": {
   "jp": "4df5f0e858",
   "kr": "아직 도통 모르겠는데요."
  },
  "168": {
   "jp": "2dc2211dfc",
   "kr": "뭐야."
  },
  "169": {
   "jp": "8f244f6135",
   "kr": "여기서 순서를 거꾸로 읽으면… 자."
  },
  "170": {
   "jp": "83647dcf81",
   "kr": "앗!"
  },
  "171": {
   "jp": "e598354313",
   "kr": "이, 이건!?"
  },
  "172": {
   "jp": "a6f9999a04",
   "kr": "대, 대단해!"
  },
  "173": {
   "jp": "33203a67c8",
   "kr": "대발견이야!"
  },
  "174": {
   "jp": "d69b298488",
   "kr": "이제 읽히죠?"
  },
  "175": {
   "jp": "ce5b9151c1",
   "kr": "어순은 뒤죽박죽이지만 단어는 읽을 수 있어요."
  },
  "176": {
   "jp": "5920b61680",
   "kr": "나머지는 접속사와 언어 변화를 고쳐"
  },
  "177": {
   "jp": "0a307bba01",
   "kr": "문절을 올바르게 배열하면 돼요."
  },
  "178": {
   "jp": "d5a2bc6e0e",
   "kr": "음, 참고로"
  },
  "179": {
   "jp": "9ed9a70240",
   "kr": "이 페이지를 읽어 보면."
  },
  "180": {
   "jp": "e5efb92867",
   "kr": "세 곳의… 지점을… 잇는…"
  },
  "181": {
   "jp": "c422a1e7c3",
   "kr": "음. 빛살의… 관문… 있어…"
  },
  "182": {
   "jp": "a251cf55e2",
   "kr": "우리… 순식간에… 여행, 어쩌고."
  },
  "183": {
   "jp": "07f5f16524",
   "kr": "뭐, 그런 내용이 적혀 있어요."
  },
  "184": {
   "jp": "5e93a2cf70",
   "kr": "대단해!"
  },
  "185": {
   "jp": "66ad55cfa0",
   "kr": "자네!"
  },
  "186": {
   "jp": "d56d9796ed",
   "kr": "아니, 아니, 당신께서는"
  },
  "187": {
   "jp": "c0b78adc05",
   "kr": "필시 이름 높으신 분이시겠지요."
  },
  "188": {
   "jp": "1f1da3d96e",
   "kr": "아뇨, 저는 그냥… 저기…"
  },
  "189": {
   "jp": "4dd0ca33f7",
   "kr": "번역서를 찾기가 귀찮아서"
  },
  "190": {
   "jp": "4fbca37287",
   "kr": "휙휙 넘기다가 우연히 발견했을 뿐이에요."
  },
  "191": {
   "jp": "52332a42f8",
   "kr": "그렇다 해도 대단하네. 대발견이야."
  },
  "192": {
   "jp": "73a152e91f",
   "kr": "당장 이 기세로"
  },
  "193": {
   "jp": "af4b4824bb",
   "kr": "이 고문서를 전부 번역해 버리세."
  },
  "194": {
   "jp": "01d000320c",
   "kr": "세세한 문법은 내가 다듬겠네."
  },
  "195": {
   "jp": "fc01f79b97",
   "kr": "부탁하네."
  },
  "196": {
   "jp": "6824f0bce4",
   "kr": "어빈 일행은 고문서 번역 작업을 시작했다."
  },
  "197": {
   "jp": "aa07ef7763",
   "kr": "마티가 예상보다 훨씬 활약한 덕에"
  },
  "198": {
   "jp": "af051a7600",
   "kr": "고문서 번역 작업은 눈에 띄게 진행됐다."
  },
  "199": {
   "jp": "9b71b83ed9",
   "kr": "됐다! 됐어!"
  },
  "200": {
   "jp": "faaf18cdcf",
   "kr": "평생이 걸려도"
  },
  "201": {
   "jp": "55698bb5e9",
   "kr": "전부 번역하기는 불가능할 줄 알았는데"
  },
  "202": {
   "jp": "041a301d87",
   "kr": "반나절도 안 되어 해냈어!"
  },
  "203": {
   "jp": "15dbb69953",
   "kr": "오늘은 얼마나 멋진 날인가."
  },
  "204": {
   "jp": "ecb0002009",
   "kr": "고맙네. 고맙네."
  },
  "205": {
   "jp": "03a385a7c0",
   "kr": "다행이에요."
  },
  "206": {
   "jp": "ac13d3217b",
   "kr": "나머지는 천천히 문절을 다듬으면 끝이야."
  },
  "207": {
   "jp": "2167440a86",
   "kr": "완성되면 번역본을 도서관 책장에 꽂아 둘 테니"
  },
  "208": {
   "jp": "474a660806",
   "kr": "기대해 주게."
  },
  "209": {
   "jp": "d1fa5002e6",
   "kr": "약속한 보수는 알선소에 손을 써 뒀네."
  },
  "210": {
   "jp": "7a61ce9065",
   "kr": "수고했네."
  },
  "211": {
   "jp": "9712663c4f",
   "kr": "《대번역해서 ㄱ·ㄴ행》"
  },
  "212": {
   "jp": "34b90a1820",
   "kr": "ㄱ행【가르두】둘가, 대정령"
  },
  "213": {
   "jp": "9c586f3d4b",
   "kr": "【곳세】세 곳, 세 지점"
  },
  "214": {
   "jp": "c213b1b4ac",
   "kr": "ㄴ행【는잇】잇다, 연결하다"
  },
  "215": {
   "jp": "4414000694",
   "kr": "《대번역해서 ㄷ·ㄹ행》"
  },
  "216": {
   "jp": "fcdf2b6246",
   "kr": "ㄷ행【다바의선위】위선의 바다"
  },
  "217": {
   "jp": "da0b83d715",
   "kr": "【땅의인봉】봉인의 땅, 카라 로쿠스"
  },
  "218": {
   "jp": "c57c08ce43",
   "kr": "【드크발】발크드"
  },
  "219": {
   "jp": "d9d496c592",
   "kr": "ㄹ행【리우】우리"
  },
  "220": {
   "jp": "75cc92c3d1",
   "kr": "《대번역해서 ㅁ·ㅂ·ㅅ행》"
  },
  "221": {
   "jp": "237ea1f4b6",
   "kr": "ㅁ행【문관】관문, 입구"
  },
  "222": {
   "jp": "4fa36d3c40",
   "kr": "ㅂ행【브가가】가가브, 연못"
  },
  "223": {
   "jp": "5b485525ee",
   "kr": "ㅅ행【살빛】빛살, 성스러운 것"
  },
  "224": {
   "jp": "078068eec1",
   "kr": "《대번역해서 ㅅ·ㅇ·ㅈ행》"
  },
  "225": {
   "jp": "bc38b0395f",
   "kr": "ㅅ행【스두르발】발두스, 시간의 신"
  },
  "226": {
   "jp": "07f7146fd5",
   "kr": "ㅇ행【아로바】바로아, 항구 마을"
  },
  "227": {
   "jp": "bf10597e25",
   "kr": "【에간식순】순식간에"
  },
  "228": {
   "jp": "51abdda4e4",
   "kr": "ㅈ행【점지】지점, 장소"
  },
  "229": {
   "jp": "ecbed24d73",
   "kr": "《대번역해서 ㅌ·ㅎ행》"
  },
  "230": {
   "jp": "32da7f078e",
   "kr": "ㅌ행【툼옥】오크툼, 옛 신"
  },
  "231": {
   "jp": "638aaff58e",
   "kr": "ㅎ행【행여】여행, 이동하다"
  },
  "232": {
   "jp": "9f68cf6e4e",
   "kr": "《전이문 전승～번역판》"
  },
  "233": {
   "jp": "4ced61a5da",
   "kr": "예전에 신속히 이동하는 길이 있었다."
  },
  "234": {
   "jp": "b225ce99dc",
   "kr": "세 곳의 지점을 잇는 빛살의 관문."
  },
  "235": {
   "jp": "065713999e",
   "kr": "우리는 순식간에 여행할 수 있노라."
  },
  "236": {
   "jp": "3565a8e5cb",
   "kr": "세 지점이란 필딘, 바로아, 발크드.",
   "fix": 1
  },
  "237": {
   "jp": "da1ba9306f",
   "kr": "이 수단은 오크툼 신이"
  },
  "238": {
   "jp": "aa76e0f830",
   "kr": "봉인되기 전부터 존재했으며"
  },
  "239": {
   "jp": "97af7a1f42",
   "kr": "신들의 싸움과는 무관하다."
  },
  "240": {
   "jp": "d3ff98d6bd",
   "kr": "해설"
  },
  "241": {
   "jp": "12a51e87fc",
   "kr": "필딘 왕가에 전해지는 이 책은 태고에"
  },
  "242": {
   "jp": "fdab222064",
   "kr": "빛살의 관문이라는 이동 수단이 있었음을 전한다."
  },
  "243": {
   "jp": "1c38ee91f1",
   "kr": "사실이라면 태고의 낭만을 자극하는 이야기다."
  },
  "244": {
   "jp": "ea72b702dc",
   "kr": "좋아, 외웠다."
  },
  "245": {
   "jp": "d19969d4c8",
   "kr": "좀 헷갈리네."
  },
  "246": {
   "jp": "7efab93863",
   "kr": "…좋아, 외웠다."
  },
  "247": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "248": {
   "jp": "117bbb5933",
   "kr": "을(를) 사용했다."
  },
  "249": {
   "jp": "08618115e7",
   "kr": "문 자물쇠가 열렸다."
  },
  "250": {
   "jp": "1df8719032",
   "kr": "문은 잠겨 있다."
  },
  "251": {
   "jp": "1f0853c2e2",
   "kr": "쿨쿨～…"
  },
  "252": {
   "jp": "88d15b7e71",
   "kr": "…쿨쿨～…"
  },
  "253": {
   "jp": "84487176bc",
   "kr": "조용히 해."
  },
  "254": {
   "jp": "9f0bace0ff",
   "kr": "잠을 못 자잖아."
  },
  "255": {
   "jp": "7572ad9e0f",
   "kr": "다음부터"
  },
  "256": {
   "jp": "1d7fcfcab5",
   "kr": "기한을 잘 지키라고 전해 주세요."
  }
 }
}
