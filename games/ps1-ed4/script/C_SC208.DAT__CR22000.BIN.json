  "0": {
   "jp": "e76b6c00fa",
   "kr": "두목"
  },
  "1": {
   "jp": "21795bdd80",
   "kr": "보물상자는 잠겨 있다.",
   "auto": 1
  },
  "2": {
   "jp": "f99ec25289",
   "kr": "보물상자 안에는 아무것도 없다.",
   "auto": 1
  },
  "3": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "4": {
   "jp": "415f49326f",
   "kr": "을(를) 입수했다.",
   "auto": 1
  },
  "5": {
   "jp": "524d372594",
   "kr": "의뢰 완료다.",
   "auto": 1
  },
  "6": {
   "jp": "02d23750a1",
   "kr": "어빈은 보물상자 열쇠를 입수했다."
  },
  "7": {
   "jp": "5eb7ee83f2",
   "kr": "보물상자 열쇠가 들어 있다."
  },
  "8": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "9": {
   "jp": "02488b7a2b",
   "kr": "보물상자 열쇠를 포기했다."
  },
  "10": {
   "jp": "f99ec25289",
   "kr": "보물상자 안에는 아무것도 없다.",
   "auto": 1
  },
  "11": {
   "jp": "1f46f33713",
   "kr": "그 나이에 여기까지 쳐들어오다니 대단하군."
  },
  "12": {
   "jp": "0afc971c79",
   "kr": "내 부하로 삼고 싶군."
  },
  "13": {
   "jp": "190263d8e2",
   "kr": "하지만 알선소의 개라면 얘기는 다르지."
  },
  "14": {
   "jp": "a5dc7ce39d",
   "kr": "여기서 결판을 내 주마."
  },
  "15": {
   "jp": "8e8d687ee5",
   "kr": "해냈네, 형!"
  },
  "16": {
   "jp": "0007c3bb82",
   "kr": "우리한테 걸리면 도적 따위는 박살이야."
  },
  "17": {
   "jp": "1a95909f72",
   "kr": "보수 받으면 내 도끼 사 줘, 알았지?"
  },
  "18": {
   "jp": "7da742cca9",
   "kr": "을(를) 발견했다.",
   "auto": 1
  },
  "19": {
   "jp": "e456144dea",
   "kr": "꽤 낡았네…"
  },
  "20": {
   "jp": "0c6637a549",
   "kr": "루티스는 보따리를 풀었다."
  },
  "21": {
   "jp": "fe53a75539",
   "kr": "안에는"
  },
  "22": {
   "jp": "605ad94591",
   "kr": "이(가) 들어 있었다."
  },
  "23": {
   "jp": "3f7eb57c70",
   "kr": "이게 아버지가 남기신 물건인가…"
  },
  "24": {
   "jp": "3fd2ee3d2a",
   "kr": "더글라스는 보따리를 풀었다."
  },
  "25": {
   "jp": "fe53a75539",
   "kr": "내용물은"
  },
  "26": {
   "jp": "605ad94591",
   "kr": "이었다."
  },
  "27": {
   "jp": "dedb6871fa",
   "kr": "오오!"
  },
  "28": {
   "jp": "a5934e0bf0",
   "kr": "굉장한 검이다!"
  },
  "29": {
   "jp": "9616d45886",
   "kr": "해냈네!"
  },
  "30": {
   "jp": "ee48920f18",
   "kr": "노라 씨가 분명 크게 기뻐할 거야."
  },
  "31": {
   "jp": "21795bdd80",
   "kr": "보물상자는 잠겨 있다.",
   "auto": 1
  },
  "32": {
   "jp": "f99ec25289",
   "kr": "보물상자 안에는 아무것도 없다.",
   "auto": 1
  },
  "33": {
   "jp": "c3e42403aa",
   "kr": "이 근처가 가장 안쪽인가."
  },
  "34": {
   "jp": "2b6bd201a9",
   "kr": "노만 할아버지의 추억이 발견되면 좋겠는데."
  },
  "35": {
   "jp": "b2d6a31015",
   "kr": "꽤 허술한 벽이군."
  },
  "36": {
   "jp": "1b96909944",
   "kr": "…음?"
  },
  "37": {
   "jp": "6424d5d27c",
   "kr": "어빈은 벽에서 글씨 같은 것을 발견했다."
  },
  "38": {
   "jp": "c4530df34c",
   "kr": "노만, 미안해요."
  },
  "39": {
   "jp": "bd8e90acfe",
   "kr": "나는 당신이 세상에서 제일 좋아서"
  },
  "40": {
   "jp": "f274fc8f61",
   "kr": "말하지 못했어요."
  },
  "41": {
   "jp": "07f90f9ecb",
   "kr": "아버지 일로 이사 가요. 에밀리"
  },
  "42": {
   "jp": "881bf0fd0d",
   "kr": "할아버지 게 아니라 에밀리 쪽 메시지인가."
  },
  "43": {
   "jp": "b7887ff946",
   "kr": "분명 에밀리 씨는 나중에 이 동굴에 와서"
  },
  "44": {
   "jp": "94920530b0",
   "kr": "할아버지의 메시지를 읽은 거야."
  },
  "45": {
   "jp": "7d91d844f2",
   "kr": "그래서 이걸 새긴 거고…"
  },
  "46": {
   "jp": "9e05cc6172",
   "kr": "아마"
  },
  "47": {
   "jp": "a243574d34",
   "kr": "이 메시지는 나중에 새긴 거라서"
  },
  "48": {
   "jp": "03cb2723e4",
   "kr": "무너지지 않고 남았나 봐."
  },
  "49": {
   "jp": "86ad579431",
   "kr": "이걸 알려 드리면"
  },
  "50": {
   "jp": "0119c55912",
   "kr": "할아버지도 안심하시겠지."
  },
  "51": {
   "jp": "38564b91ac",
   "kr": "우리한테 걸리면"
  },
  "52": {
   "jp": "1dc6aaaac1",
   "kr": "도적 따위는 박살이야."
  }
 }
}
