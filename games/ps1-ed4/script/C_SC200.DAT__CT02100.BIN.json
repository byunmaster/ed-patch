 "segments": {
  "0": {
   "jp": "5ad020afcb",
   "kr": "페르나"
  },
  "1": {
   "jp": "b8784eece9",
   "kr": "코레"
  },
  "2": {
   "jp": "8d2a527a4f",
   "kr": "하루"
  },
  "3": {
   "jp": "56c8785eb9",
   "kr": "프리트"
  },
  "4": {
   "jp": "87a5230a56",
   "kr": "루카"
  },
  "5": {
   "jp": "9767bdcf12",
   "kr": "라브로아"
  },
  "6": {
   "jp": "2396d1483d",
   "kr": "나콜"
  },
  "7": {
   "jp": "5a7ba522e5",
   "kr": "오, 견학이냐?"
  },
  "8": {
   "jp": "e181237991",
   "kr": "톱니바퀴에 말려들지 않게 조심해라."
  },
  "9": {
   "jp": "3c94676a60",
   "kr": "오, 순찰이군."
  },
  "10": {
   "jp": "278c9018fd",
   "kr": "이상 없음. 전부 양호해."
  },
  "11": {
   "jp": "1b8d7bd997",
   "kr": "어빈은 제１용광로 점검을 마쳤다."
  },
  "12": {
   "jp": "d5be6ffea2",
   "kr": "순찰 수고하네."
  },
  "13": {
   "jp": "d17e06607d",
   "kr": "자네도 고생이 많군."
  },
  "14": {
   "jp": "e7e27708e8",
   "kr": "순찰하고 돈 좀 벌었나?"
  },
  "15": {
   "jp": "92e18c6609",
   "kr": "이 가마는 멀쩡했나 보네."
  },
  "16": {
   "jp": "5b855c303e",
   "kr": "풀가동! 이상 없음!"
  },
  "17": {
   "jp": "20a71df6bd",
   "kr": "안심해. 이제 괜찮아."
  },
  "18": {
   "jp": "a0e7c02aca",
   "kr": "여, 나도 용광로도 건강해."
  },
  "19": {
   "jp": "341d3ad1b0",
   "kr": "검 만들기는 오랜만이라 재미있었어."
  },
  "20": {
   "jp": "4a85c512c2",
   "kr": "이제 무기 만들 예정은 없나?"
  },
  "21": {
   "jp": "3435ac0bd4",
   "kr": "레어메탈 합금이 완성되면"
  },
  "22": {
   "jp": "6da66a607e",
   "kr": "그다음은 나한테 맡겨 두라고."
  },
  "23": {
   "jp": "d4a916a04e",
   "kr": "이래 봬도 공장에서 일하기 전엔"
  },
  "24": {
   "jp": "e0e7d15b08",
   "kr": "대장간에서 수행했거든."
  },
  "25": {
   "jp": "314064b94e",
   "kr": "무기 만들기라면 자신 있다고."
  },
  "26": {
   "jp": "75290736ef",
   "kr": "루카는 마법대학교의"
  },
  "27": {
   "jp": "253065f753",
   "kr": "높으신 교수님께 불려 나갔어."
  },
  "28": {
   "jp": "37c3ad9737",
   "kr": "레어메탈을 찾아내는 녀석은"
  },
  "29": {
   "jp": "49eab83377",
   "kr": "어지간히 운 좋은 녀석이야."
  },
  "30": {
   "jp": "1147c8f3d2",
   "kr": "좀처럼 발견되지 않으니까."
  },
  "31": {
   "jp": "b8a3ae0b28",
   "kr": "무슨 일이 있어도 펄펄 끓는 쇠에는 손대지 마."
  },
  "32": {
   "jp": "183e10c7ae",
   "kr": "화상으로 끝나지 않으니까."
  },
  "33": {
   "jp": "3100cb9edb",
   "kr": "부글부글 끓고 있잖아."
  },
  "34": {
   "jp": "66b520dcee",
   "kr": "덥기가 이루 말할 수 없어."
  },
  "35": {
   "jp": "141a133352",
   "kr": "나만 더울 뿐, 용광로 상태는 최고야."
  },
  "36": {
   "jp": "9a997b6af6",
   "kr": "어빈은 제２용광로 점검을 마쳤다."
  },
  "37": {
   "jp": "4a35ee4cbf",
   "kr": "이상 없어."
  },
  "38": {
   "jp": "60fe83aaf9",
   "kr": "평소와 다름없어."
  },
  "39": {
   "jp": "e9eb84c64d",
   "kr": "오, 너희인가."
  },
  "40": {
   "jp": "f5d23597db",
   "kr": "용광로는 아무 걱정 없어."
  },
  "41": {
   "jp": "3b66d086ce",
   "kr": "아차, 순찰은 끝났었지?"
  },
  "42": {
   "jp": "94059173d6",
   "kr": "이상 없～음!"
  },
  "43": {
   "jp": "af5a3500a2",
   "kr": "우리는 회복이 빠르거든."
  },
  "44": {
   "jp": "d61f3ee2f8",
   "kr": "이제 괜찮아."
  },
  "45": {
   "jp": "8699f7658b",
   "kr": "순조로워, 순조로워."
  },
  "46": {
   "jp": "9c1150e8e1",
   "kr": "이상 없어."
  },
  "47": {
   "jp": "ec2bdaac47",
   "kr": "여기서 일하면 한겨울에도 더워!"
  },
  "48": {
   "jp": "8705636419",
   "kr": "후끈～ 하다니까."
  },
  "49": {
   "jp": "df93793605",
   "kr": "봐 봐, 이 용광로의 늠름한 모습."
  },
  "50": {
   "jp": "a88815d54e",
   "kr": "힘이 넘쳐서 멋지잖아."
  },
  "51": {
   "jp": "5579ce5d41",
   "kr": "여, 순찰 수고하네."
  },
  "52": {
   "jp": "1b9c175eb8",
   "kr": "또 라브로아 녀석이 땡땡이쳤구나."
  },
  "53": {
   "jp": "e24aee1e81",
   "kr": "용광로는 아주 순조로워. 문제없어."
  },
  "54": {
   "jp": "99c36356ce",
   "kr": "어빈은 제３용광로 점검을 마쳤다."
  },
  "55": {
   "jp": "4e85d4fa8e",
   "kr": "용광로가 붉게 타오르는 한"
  },
  "56": {
   "jp": "38fb5589ed",
   "kr": "기아의 내일도 밝은 법이지."
  },
  "57": {
   "jp": "c6b382ece5",
   "kr": "너희도 기아에 정착해 보는 게 어때?"
  },
  "58": {
   "jp": "91e74c59fb",
   "kr": "보람 있는 일을 할 수 있다는 건"
  },
  "59": {
   "jp": "a850ef4173",
   "kr": "행복한 거라고."
  },
  "60": {
   "jp": "fefd113aad",
   "kr": "신세 많이 졌어."
  },
  "61": {
   "jp": "9a420f2789",
   "kr": "덕분에 공장이 예전대로 돌아왔어."
  },
  "62": {
   "jp": "4f8de5b47c",
   "kr": "여기는 프라이팬에 구워지는 것처럼 뜨거워."
  },
  "63": {
   "jp": "5c47ab1eed",
   "kr": "달걀이 있으면"
  },
  "64": {
   "jp": "0fecd87a91",
   "kr": "틀림없이 햄 달걀부침이 되고 말걸."
  },
  "65": {
   "jp": "fa6193e3cf",
   "kr": "이거, 농담이야."
  },
  "66": {
   "jp": "9c1150e8e1",
   "kr": "이상 없어."
  },
  "67": {
   "jp": "02c9f52d18",
   "kr": "전부 양호."
  },
  "68": {
   "jp": "5acf3803bc",
   "kr": "흐르는 땀은 노동의 증표라니까!"
  },
  "69": {
   "jp": "b6685c1696",
   "kr": "이게 기분 좋단 말이야."
  },
  "70": {
   "jp": "1d89f7437c",
   "kr": "…여기 오래 있으면 열 때문에 멍해져."
  },
  "71": {
   "jp": "c48be528eb",
   "kr": "하지만 난 프로니까."
  },
  "72": {
   "jp": "719d617bb4",
   "kr": "목욕탕에 들어와 있다고 생각하면 기분 좋은 법이야."
  },
  "73": {
   "jp": "ff2aee6b4a",
   "kr": "제４용광로는 아주 기분이 좋은 상태야."
  },
  "74": {
   "jp": "758008298c",
   "kr": "어빈은 제４용광로 점검을 마쳤다."
  },
  "75": {
   "jp": "2c9b656c91",
   "kr": "걱정 마!"
  },
  "76": {
   "jp": "ff2aee6b4a",
   "kr": "제４용광로는 아주 기분이 좋은 상태야."
  },
  "77": {
   "jp": "7bdadfe2fd",
   "kr": "내가 맡고 있는 한"
  },
  "78": {
   "jp": "c11153ca36",
   "kr": "제４용광로는 기분 최고야!"
  },
  "79": {
   "jp": "90cd0793b5",
   "kr": "여기 용광로는 무사했어."
  },
  "80": {
   "jp": "b6e8391bf5",
   "kr": "전부 평소대로, 상태 최고야."
  },
  "81": {
   "jp": "b55c4066ec",
   "kr": "여기 일도 더워서 힘들지만"
  },
  "82": {
   "jp": "be618df3df",
   "kr": "갱도에 들어가는 일도 힘들겠구나."
  },
  "83": {
   "jp": "b1867e1ca4",
   "kr": "이 공장의 가마에 불이 켜져 있는 한"
  },
  "84": {
   "jp": "d4770742fa",
   "kr": "필딘 경제는 끄떡없을 거야."
  },
  "85": {
   "jp": "bf4d585b44",
   "kr": "견학하시는 분들이군요."
  },
  "86": {
   "jp": "3884828491",
   "kr": "물건을 만들어 낸다는 건 즐거워요."
  },
  "87": {
   "jp": "dee9cdeb8a",
   "kr": "모두 그 기쁨을 알고 있으니까"
  },
  "88": {
   "jp": "ca1a2e8134",
   "kr": "기아에 활기가 넘치는 거겠죠."
  },
  "89": {
   "jp": "6c350c4e09",
   "kr": "네. 수고 많으세요."
  },
  "90": {
   "jp": "931bf6a49f",
   "kr": "라브로아 씨는 오늘도 쉬시나요?"
  },
  "91": {
   "jp": "926ba315d9",
   "kr": "제５용광로, ＨＦ형은 양호합니다."
  },
  "92": {
   "jp": "989401b4a2",
   "kr": "이상 없습니다."
  },
  "93": {
   "jp": "1b1a17bad6",
   "kr": "어빈은 제５용광로 점검을 마쳤다."
  },
  "94": {
   "jp": "c37979b9df",
   "kr": "이 ＨＦ형은 신형인데"
  },
  "95": {
   "jp": "380e160d41",
   "kr": "상당히 성질이 까다로워서"
  },
  "96": {
   "jp": "baee217953",
   "kr": "저 아니면 안 돼요."
  },
  "97": {
   "jp": "4339b1fd4f",
   "kr": "오늘은 기분이 좋은 모양이라"
  },
  "98": {
   "jp": "5eebfe9320",
   "kr": "상태가 좋아요."
  },
  "99": {
   "jp": "89a044f3ed",
   "kr": "라브로아 씨 대신 수고 많으셨어요."
  },
  "100": {
   "jp": "02c5ed040d",
   "kr": "고맙습니다."
  },
  "101": {
   "jp": "34b9ede8cb",
   "kr": "저는 이제 괜찮아요."
  },
  "102": {
   "jp": "8bb1af9e98",
   "kr": "루티스 누나. 저는 잘 지내고 있어요."
  },
  "103": {
   "jp": "66e809f796",
   "kr": "걱정하지 않으셔도 되니 안심하세요."
  },
  "104": {
   "jp": "b01283d516",
   "kr": "루티스 누나."
  },
  "105": {
   "jp": "a731ae18d9",
   "kr": "내 걱정은 하지 마."
  },
  "106": {
   "jp": "e63051fcd0",
   "kr": "누나가 믿는 여행을 계속해 주세요."
  },
  "107": {
   "jp": "87a09cf4a4",
   "kr": "어빈 씨와 루티스 누나께"
  },
  "108": {
   "jp": "b4fda96bcc",
   "kr": "도움이 될 수 있어서 다행이야."
  },
  "109": {
   "jp": "a8fee10559",
   "kr": "레어메탈 합금이 완성되었어요."
  },
  "110": {
   "jp": "80ba0bbf7e",
   "kr": "지금 페르나 씨가 두드려 벼리고 있어요."
  },
  "111": {
   "jp": "88d6a86150",
   "kr": "검을 벼리는 건"
  },
  "112": {
   "jp": "d8e28a8b91",
   "kr": "집중력 싸움이라 아무도 들이지 말라고 했어요."
  },
  "113": {
   "jp": "4de1c03f9a",
   "kr": "조금만 더 여기서 기다려 주세요."
  },
  "114": {
   "jp": "41461ca5c0",
   "kr": "레어메탈은 상당한 고온이 아니면"
  },
  "115": {
   "jp": "17408a6561",
   "kr": "다른 금속과 융합하지 않는 모양이에요."
  },
  "116": {
   "jp": "955da44d67",
   "kr": "하지만 괜찮아요."
  },
  "117": {
   "jp": "61f092cc82",
   "kr": "이 제５용광로 ＨＦ형의 힘이라면"
  },
  "118": {
   "jp": "e29d56dd53",
   "kr": "충분히 가열할 수 있어요."
  },
  "119": {
   "jp": "b01283d516",
   "kr": "루티스 누나."
  },
  "120": {
   "jp": "83e82465a7",
   "kr": "너무 무리하지 마."
  },
  "121": {
   "jp": "0c9e85343e",
   "kr": "어빈 씨, 누나를 잘 부탁드려요."
  },
  "122": {
   "jp": "3b6d355160",
   "kr": "이걸로 전부 점검이 끝났네."
  },
  "123": {
   "jp": "4b4b9e2f31",
   "kr": "초소의 경비원에게 보고하러 가자."
  },
  "124": {
   "jp": "d8291fd8ad",
   "kr": "하아암～, 심심하다."
  },
  "125": {
   "jp": "9b6c441e69",
   "kr": "변명 같지만 여기 녀석들은"
  },
  "126": {
   "jp": "ef04921313",
   "kr": "다들 솜씨가 좋아."
  },
  "127": {
   "jp": "309ba62c27",
   "kr": "순찰 같은 건 필요 없다고."
  },
  "128": {
   "jp": "0d5f0c568e",
   "kr": "특히 루카는 아직 어린데"
  },
  "129": {
   "jp": "4e66c60be4",
   "kr": "어른 뺨치는 솜씨라니까."
  },
  "130": {
   "jp": "c418fbcd7a",
   "kr": "호오～, 너희가 도리아 교수의 의뢰를 받았구나."
  },
  "131": {
   "jp": "ad49407ff1",
   "kr": "마수가 우글거리는 기아 광산에"
  },
  "132": {
   "jp": "9603f68d7a",
   "kr": "용케 들어갈 생각을 했군."
  },
  "133": {
   "jp": "26c34d5c04",
   "kr": "레어메탈을 찾는 김에"
  },
  "134": {
   "jp": "1d300fbb30",
   "kr": "마수도 퇴치해 주면"
  },
  "135": {
   "jp": "aa83ef0d8a",
   "kr": "우리도 엄청 도움이 되겠는데."
  },
  "136": {
   "jp": "f41431fd80",
   "kr": "자, 원하는 만큼 광차를 써."
  },
  "137": {
   "jp": "7b3f0ea688",
   "kr": "여기서부터는 관계자 외 출입 금지야."
  },
  "138": {
   "jp": "e9fc328696",
   "kr": "광차를 타 보고 싶다는"
  },
  "139": {
   "jp": "0b74966708",
   "kr": "이유로는 안에 못 들어가."
  },
  "140": {
   "jp": "26c34d5c04",
   "kr": "레어메탈을 찾는 김에"
  },
  "141": {
   "jp": "1d300fbb30",
   "kr": "마수도 퇴치해 주면"
  },
  "142": {
   "jp": "aa83ef0d8a",
   "kr": "우리도 엄청 도움이 되겠는데."
  },
  "143": {
   "jp": "f41431fd80",
   "kr": "자, 원하는 만큼 광차를 써."
  },
  "144": {
   "jp": "ad88856f10",
   "kr": "호오～, 레어메탈을 찾았구나."
  },
  "145": {
   "jp": "94c576e450",
   "kr": "베테랑 광부라도"
  },
  "146": {
   "jp": "60aef37831",
   "kr": "１년에 하나라도 발견하면 다행이라고."
  },
  "147": {
   "jp": "557fd630c0",
   "kr": "어서 도리아 교수에게 가져다줘서"
  },
  "148": {
   "jp": "996928b666",
   "kr": "기쁘게 해 드려."
  },
