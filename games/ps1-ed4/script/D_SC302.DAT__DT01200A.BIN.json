{
 "archive": "/D/SC302.DAT",
 "member": "..\\BIN\\DT01200A.BIN",
 "segments": {
  "0": {
   "jp": "bd9f80ae5d",
   "kr": "바닷바람이 나를 부르는군."
  },
  "1": {
   "jp": "276edfc682",
   "kr": "…………",
   "auto": 1
  },
  "2": {
   "jp": "051a8844d7",
   "kr": "나는 바다 사나이 코넬리다."
  },
  "3": {
   "jp": "21ad38bb86",
   "kr": "전해 줬으면 하는 건 이거다."
  },
  "4": {
   "jp": "72e91e1c06",
   "kr": "기아에 있는 우리 어머니께 전해 줘."
  },
  "5": {
   "jp": "ce50accd51",
   "kr": "코넬리에게서 반지를 받았다."
  },
  "6": {
   "jp": "3caf5cc342",
   "kr": "나는… 집에 돌아갈 수 없는 사정이"
  },
  "7": {
   "jp": "d07e113f2c",
   "kr": "있는 몸이야."
  },
  "8": {
   "jp": "07d21635d1",
   "kr": "그러니 대신 반지를 전해 줬으면 해."
  },
  "9": {
   "jp": "115a30856e",
   "kr": "아, 내가 집에 못 가는 이유를"
  },
  "10": {
   "jp": "21f61eefc8",
   "kr": "물으려고는 하지 말아 줘."
  },
  "11": {
   "jp": "829c643458",
   "kr": "나는 바다 사나이다."
  },
  "12": {
   "jp": "13743925c2",
   "kr": "촌스러운 소리는 하지 말자고. 훗."
  },
  "13": {
   "jp": "ea6f993aa8",
   "kr": "어머니는 기아에서 아버지와"
  },
  "14": {
   "jp": "1585c645e4",
   "kr": "도구점을 하고 있다."
  },
  "15": {
   "jp": "418aa83f06",
   "kr": "도구점에 가면 금방 알 거다."
  },
  "16": {
   "jp": "039fad124b",
   "kr": "그럼 부탁한다."
  },
  "17": {
   "jp": "b01be2b833",
   "kr": "짐이 가득하잖아."
  },
  "18": {
   "jp": "c206f4dbb0",
   "kr": "짐을 정리하고 나서",
   "auto": 1
  },
  "19": {
   "jp": "24912e8c47",
   "kr": "다시 와 주지 않겠어?"
  },
  "20": {
   "jp": "4cae2ec523",
   "kr": "전해 줄 곳은 기아 도구점 안주인이다."
  },
  "21": {
   "jp": "cb4aa2347b",
   "kr": "잘 부탁한다."
  },
  "22": {
   "jp": "c2d207fd06",
   "kr": "그럼, 어빈."
  },
  "23": {
   "jp": "c3f8c2f40e",
   "kr": "그래."
  },
  "24": {
   "jp": "68840754dd",
   "kr": "너희 덕분에 살았어."
  },
  "25": {
   "jp": "9fd4713b10",
   "kr": "이제 항로가 안전해졌어."
  },
  "26": {
   "jp": "149892d2b8",
   "kr": "배가 한 척 가라앉았지만요."
  },
  "27": {
   "jp": "c265a70432",
   "kr": "뭐, 보충은 금방 돼."
  },
  "28": {
   "jp": "0a19ad9f5b",
   "kr": "부수는 녀석도 없어졌고."
  },
  "29": {
   "jp": "7b40292892",
   "kr": "복구되면 또 타 줘."
  },
  "30": {
   "jp": "3be2dbb604",
   "kr": "그래, 기꺼이."
  },
  "31": {
   "jp": "6fe0eff78b",
   "kr": "그럼, 라더 씨…"
  },
  "32": {
   "jp": "3a48368959",
   "kr": "조심해서 가."
  },
  "33": {
   "jp": "80010ce92c",
   "kr": "또 보자."
  },
  "34": {
   "jp": "b9e7d4cf30",
   "kr": "자, 그럼."
  },
  "35": {
   "jp": "668a98e561",
   "kr": "드디어 듀시스 지방에 도착했네."
  },
  "36": {
   "jp": "a7792bbbb2",
   "kr": "발크드는 이제 조금만 가면 돼."
  },
  "37": {
   "jp": "96b6409d69",
   "kr": "저기, 마일 님."
  },
  "38": {
   "jp": "b6ca489e7f",
   "kr": "분명 발크드라면"
  },
  "39": {
   "jp": "18632dcc44",
   "kr": "정신전의 역사가 가장 오래된 마을이지요?"
  },
  "40": {
   "jp": "ed9865e9d5",
   "kr": "훌륭한 사원이 있다고 들었어요."
  },
  "41": {
   "jp": "c3448c0ca1",
   "kr": "기대돼요."
  },
  "42": {
   "jp": "c3f8c2f40e",
   "kr": "응."
  },
  "43": {
   "jp": "b086d0d514",
   "kr": "하지만 사실은 사교도에게 빼앗긴 카테드랄 쪽이"
  },
  "44": {
   "jp": "fac238326c",
   "kr": "훨씬 오래됐어."
  },
  "45": {
   "jp": "191e288eca",
   "kr": "정신전 사람들은 ８년 전 사교도의 습격으로"
  },
  "46": {
   "jp": "e29ce46014",
   "kr": "카테드랄에서 쫓겨나서"
  },
  "47": {
   "jp": "cdec980126",
   "kr": "다음으로 역사가 오래된 발크드에 본전을 세운 거예요."
  },
  "48": {
   "jp": "9d79091977",
   "kr": "발크드는"
  },
  "49": {
   "jp": "1b769cb0a6",
   "kr": "오래되고도 새로운 정신전의 마을이라는 거군…"
  },
  "50": {
   "jp": "5e19280085",
   "kr": "어빈.",
   "auto": 1
  },
  "51": {
   "jp": "7afa9a8044",
   "kr": "사교도도 신경 쓰이고"
  },
  "52": {
   "jp": "689c5a693a",
   "kr": "이 마을에서도 정보를 좀 모아 두는 편이"
  },
  "53": {
   "jp": "34eeec1619",
   "kr": "좋겠어."
  },
  "54": {
   "jp": "e3511831f0",
   "kr": "그래."
  },
  "55": {
   "jp": "463c33085b",
   "kr": "하지만 놈들이니까"
  },
  "56": {
   "jp": "94adde1934",
   "kr": "어딘가에서 잠복하고 있을 가능성도 있어."
  },
  "57": {
   "jp": "dca0a4bbf8",
   "kr": "함부로 돌아다니는 건 위험하겠군…"
  },
  "58": {
   "jp": "d9c0fd0dd3",
   "kr": "아이멜과 섀넌은 여관 술집에서 기다리게 하자."
  },
  "59": {
   "jp": "6d740cd96a",
   "kr": "괜찮지, 섀넌?"
  },
  "60": {
   "jp": "52ee815257",
   "kr": "네, 마일 님."
  },
  "61": {
   "jp": "0defef318e",
   "kr": "섀넌은 마일 님 말씀은"
  },
  "62": {
   "jp": "0b0dcfb3c3",
   "kr": "반드시 지키겠어요."
  },
  "63": {
   "jp": "099fae833c",
   "kr": "그럼, 오빠."
  },
  "64": {
   "jp": "ca668ae4c7",
   "kr": "저는 여관 술집을 찾아서"
  },
  "65": {
   "jp": "e99b6f797b",
   "kr": "섀넌 씨와 함께 거기서 기다릴게요."
  },
  "66": {
   "jp": "26ca1f88d6",
   "kr": "그래, 조심해."
  },
  "67": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "68": {
   "jp": "5bb77f1e77",
   "kr": "아이멜과"
  },
  "69": {
   "jp": "c9967a0d99",
   "kr": "섀넌은 여관 술집에서 기다려 줘."
  }
 }
}
