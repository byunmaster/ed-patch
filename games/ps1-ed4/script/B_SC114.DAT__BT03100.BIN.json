  },
  "99": {
   "jp": "a575a70bf2",
   "kr": "부디 데레브라는 어빈 씨가"
  },
  "100": {
   "jp": "660fe93f40",
   "kr": "가지고 계십시오."
  },
  "101": {
   "jp": "2c86b93ebc",
