  },
  "65": {
   "jp": "f71196da2a",
   "kr": "그래도 괜찮겠어?"
  },
  "66": {
   "jp": "78d9f464e4",
   "kr": "하긴 그렇게 되면…"
  },
  "67": {
   "jp": "d7e697d9ac",
   "kr": "우리가 당할 수도 있지."
  },
  "68": {
   "jp": "90e34e9800",
   "kr": "당신들이 오신 이상"
  },
  "69": {
   "jp": "1b3f0288f5",
   "kr": "이둔 님의 말씀에 따라 통과시키는 것이"
  },
  "70": {
   "jp": "c58f5d4bbc",
   "kr": "제 역할이겠지요."
  },
  "71": {
   "jp": "67031a8c2c",
   "kr": "결과적으로"
  },
  "72": {
   "jp": "9202bffaa1",
   "kr": "이둔 님과 당신들이 싸우게 되더라도"
  },
  "73": {
   "jp": "5d488489fc",
   "kr": "어쩔 수 없습니다."
  },
  "74": {
   "jp": "5628b47c8f",
   "kr": "사당으로 가는 길을 열겠습니다."
  },
  "75": {
   "jp": "2462be5ced",
   "kr": "내 이름은 레이트르!"
  },
  "76": {
   "jp": "e8da10c156",
   "kr": "제72대 신전지기의 이름으로 원하노라."
  },
  "77": {
   "jp": "71a853f69b",
   "kr": "사당으로 가는 길이여!"
  },
  "78": {
   "jp": "d3b69961cb",
   "kr": "내 소망을 전하여 열려라!"
  },
  "79": {
   "jp": "61edd79374",
   "kr": "여기가 비밀 입구였구나."
  },
  "80": {
   "jp": "5aa38c1aff",
   "kr": "조심하십시오."
  },
  "81": {
   "jp": "070c8fe841",
   "kr": "정령의 사당이라 해도 어둠은 마수의 거처입니다."
  },
  "82": {
   "jp": "8226dbc2ba",
   "kr": "게다가… 제 나쁜 예감이 맞는다면"
  },
  "83": {
   "jp": "10ccf553e2",
   "kr": "당신들은 이둔 님과"
  },
  "84": {
   "jp": "fb90d87f46",
   "kr": "싸워야 할지도…"
  },
  "85": {
   "jp": "9864b5e17b",
   "kr": "여기서 무사하시길 기도하고 있겠습니다."
  },
  "86": {
   "jp": "ba46d99eba",
   "kr": "이둔 님의 영혼의 외침에 응할 수 있는 건"
  },
  "87": {
   "jp": "4adcc99663",
   "kr": "당신들 말고는"
  },
  "88": {
   "jp": "aaf237f9ce",
   "kr": "아마 없을 겁니다."
  },
  "89": {
   "jp": "8a5291cbd4",
   "kr": "오오, 무사하셨군요."
  },
  "90": {
   "jp": "995ff76202",
   "kr": "이둔 님을 뵈었군요."
  },
  "91": {
   "jp": "fad2b24613",
   "kr": "데레브라를 받아 왔어."
  },
  "92": {
   "jp": "47a54dc508",
   "kr": "사교도가 건 주법으로"
  },
  "93": {
   "jp": "80508c68a2",
   "kr": "이둔은 마수가 되어 있었어."
  },
  "94": {
   "jp": "80004d9cfe",
   "kr": "하지만 안심해."
  },
  "95": {
   "jp": "0b2e657de4",
   "kr": "원래 정령으로 돌아왔으니까."
  },
  "96": {
   "jp": "1b518aea21",
