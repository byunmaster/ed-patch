{
 "archive": "/B/SC114.DAT",
 "member": "..\\BIN\\BT03100.BIN",
 "segments": {
  "0": {
   "jp": "874ada80aa",
   "kr": "레이트르"
  },
  "1": {
   "jp": "88fbee5004",
   "kr": "앗…?"
  },
  "2": {
   "jp": "c6e700fac0",
   "kr": "명상하고 있어."
  },
  "3": {
   "jp": "763c01eb0e",
   "kr": "이렇게 마수가 나오는 곳에서 대단하네."
  },
  "4": {
   "jp": "b0d882829a",
   "kr": "이 사람이다…"
  },
  "5": {
   "jp": "42fb1e014b",
   "kr": "내가 진실의 섬에서 본 사람이야."
  },
  "6": {
   "jp": "19ca92b594",
   "kr": "굉장한 집중력으로 명상하고 있네."
  },
  "7": {
   "jp": "fb6515445c",
   "kr": "이래서는 때려도 걷어차도"
  },
  "8": {
   "jp": "89d9c62b5b",
   "kr": "명상에서 빠져나올 것 같지 않아."
  },
  "9": {
   "jp": "1254f98a5b",
   "kr": "육체의 기능 자체를 정지하고"
  },
  "10": {
   "jp": "e4ee23fad9",
   "kr": "의식을 완전히 분리해서 명상하고 있어."
  },
  "11": {
   "jp": "433f14e6d2",
   "kr": "그런 게 가능해?"
  },
  "12": {
   "jp": "954961411d",
   "kr": "꽤 수행을 쌓은 신관이라면."
  },
  "13": {
   "jp": "2e47ecef39",
   "kr": "명상에서 깨워 줘야"
  },
  "14": {
   "jp": "2324f8a136",
   "kr": "얘기가 안 돼."
  },
  "15": {
   "jp": "15b72cd992",
   "kr": "진실의 섬에서 본 건 분명 이 사람이었어."
  },
  "16": {
   "jp": "a057e84241",
   "kr": "…탁선을 흘리는 신전지기…"
  },
  "17": {
   "jp": "f8653e4aeb",
   "kr": "그 영상대로라면"
  },
  "18": {
   "jp": "ca8d97605e",
   "kr": "이 사람이 흘린 탁선의 종이가 어딘가 있을 거야."
  },
  "19": {
   "jp": "e470c70626",
   "kr": "그 부적을 이마에 붙여 보자."
  },
  "20": {
   "jp": "9864b5e17b",
   "kr": "여기서 무사하시길 기도하고 있겠습니다."
  },
  "21": {
   "jp": "ba46d99eba",
   "kr": "이둔 님의 영혼의 외침에 응할 수 있는 건"
  },
  "22": {
   "jp": "4adcc99663",
   "kr": "당신들 말고는"
  },
  "23": {
   "jp": "aaf237f9ce",
   "kr": "아마 없을 겁니다."
  },
  "24": {
   "jp": "a5ec824ef5",
   "kr": "저는 앞으로도 신전지기 일에 힘쓰겠습니다."
  },
  "25": {
   "jp": "4796a98ff4",
   "kr": "세상이 이어지는 한. 살아 있는 한."
  },
  "26": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "27": {
   "jp": "6fa73ce335",
   "kr": "을(를)"
  },
  "28": {
   "jp": "1a5b833502",
   "kr": "레이트르의 이마에 붙였다."
  },
  "29": {
   "jp": "dc83220f4b",
   "kr": "기다리고 있었습니다."
  },
  "30": {
   "jp": "0dd8e07909",
   "kr": "…………후우."
  },
  "31": {
   "jp": "a66a5b6896",
   "kr": "명상을 시작하고"
  },
  "32": {
   "jp": "ea67c6e9ad",
   "kr": "얼마나 지났을까…"
  },
  "33": {
   "jp": "a4ce05176c",
   "kr": "몸이 좀 무겁군."
  },
  "34": {
   "jp": "4707d7341e",
   "kr": "그건 그렇고",
   "auto": 1
  },
  "35": {
   "jp": "f8ee206e62",
   "kr": "이렇게 위험한 데서 명상하지 않아도"
  },
  "36": {
   "jp": "410d8550ce",
   "kr": "되잖아?"
  },
  "37": {
   "jp": "e21d763f6e",
   "kr": "아뇨, 명상하고 있으니 안전한 겁니다."
  },
  "38": {
   "jp": "f0911668fd",
   "kr": "이 주변에 출몰하는 마수는"
  },
  "39": {
   "jp": "0fa2038831",
   "kr": "기의 흐름에 반응해서 덮쳐 오거든요."
  },
  "40": {
   "jp": "972d5a3773",
   "kr": "의식을 떼어 놓으면 괜찮습니다."
  },
  "41": {
   "jp": "c32d663e9f",
   "kr": "그럼 바로 본론으로 들어가죠."
  },
  "42": {
   "jp": "67b63bbc19",
   "kr": "당신들이 발두스 신의 신령을"
  },
  "43": {
   "jp": "76a2fbd746",
   "kr": "모으고 계신 분들이시죠."
  },
  "44": {
   "jp": "f2e2f145fe",
   "kr": "어떻게 알지?"
  },
  "45": {
   "jp": "3cbc4bb3a1",
   "kr": "몇 번 전의 명상 때부터"
  },
  "46": {
   "jp": "3f785c343a",
   "kr": "이둔 님의 목소리가 들렸습니다."
  },
  "47": {
   "jp": "a946bb9d30",
   "kr": "데레브라를 구하는 두 힘이 있다."
  },
  "48": {
   "jp": "1ad1b006fc",
   "kr": "탁선 흘리기의 상념을 받아"
  },
  "49": {
   "jp": "b1afe19493",
   "kr": "제 명상을 푼 자에게 데레브라를 맡기라고."
  },
  "50": {
   "jp": "69b71a57fe",
   "kr": "그렇게 말씀하셨습니다."
  },
  "51": {
   "jp": "43c4c5da2a",
   "kr": "그랬구나…"
  },
  "52": {
   "jp": "9014e63185",
   "kr": "저는 지금까지 신전지기로서 이둔 님의 사당을"
  },
  "53": {
   "jp": "0baf92f3e2",
   "kr": "지켜 왔습니다만, 사실"
  },
  "54": {
   "jp": "760c383c47",
   "kr": "요즘 이둔 님에게 변화가 느껴집니다."
  },
  "55": {
   "jp": "a32876fead",
   "kr": "사악한 느낌이라고 할까…"
  },
  "56": {
   "jp": "947094dfd3",
   "kr": "뭔가… 지금까지와는 다릅니다."
  },
  "57": {
   "jp": "af2f901dd7",
   "kr": "아마 누군가…"
  },
  "58": {
   "jp": "6cf72c7273",
   "kr": "사악하고 강력한 법력을 지닌 자가"
  },
  "59": {
   "jp": "f6588f63ff",
   "kr": "이둔 님께 영향을 주고 있을 겁니다."
  },
  "60": {
   "jp": "79b6e2a873",
   "kr": "제가 명상으로 들은 목소리는 이둔 님의 진짜 의지입니다."
  },
  "61": {
   "jp": "66c60272d2",
   "kr": "부디 이둔 님의 사당을 찾아가"
  },
  "62": {
   "jp": "86d7f2d75b",
