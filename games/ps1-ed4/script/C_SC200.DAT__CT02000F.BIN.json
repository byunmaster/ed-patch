{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02000F.BIN",
 "segments": {
  "0": {
   "jp": "9ca2969844",
   "kr": "무슨 일인가, 젊은이."
  },
  "1": {
   "jp": "cd6cde000a",
   "kr": "고장 난 자물쇠라도 있나?"
  },
  "2": {
   "jp": "837b79d697",
   "kr": "아니요.",
   "auto": 1
  },
  "3": {
   "jp": "bd70b55842",
   "kr": "루크레프 씨에 대해 이야기를 듣고 싶어서."
  },
  "4": {
   "jp": "19f80f4c84",
   "kr": "자네들, 메리안한테 고용된 건가?"
  },
  "5": {
   "jp": "1bee387cfc",
   "kr": "알선소에 의뢰했다고 들었는데…"
  },
  "6": {
   "jp": "622fb5fba7",
   "kr": "그런데 말이야, 나도 루크레프가 어디 있는지는"
  },
  "7": {
   "jp": "10112cd24d",
   "kr": "짐작도 못 하겠네."
  },
  "8": {
   "jp": "00a187695d",
   "kr": "메리안한테 선수를 뺏겼지만"
  },
  "9": {
   "jp": "fc3c3d20ce",
   "kr": "나야말로 알선소에 의뢰를 낼까 생각하던 참이야."
  },
  "10": {
   "jp": "1bd9aac37b",
   "kr": "루크레프는 성실하고 요즘 보기 드문 좋은 장인이거든."
  },
  "11": {
   "jp": "e3c943b751",
   "kr": "얼른 돌아왔으면 좋겠구먼, 응."
  },
  "12": {
   "jp": "d88fb40272",
   "kr": "루크레프가 마지막으로 일한 곳은"
  },
  "13": {
   "jp": "dfbd4c51c5",
   "kr": "알리사 씨 집인데 말이야."
  },
  "14": {
   "jp": "bda47b351a",
   "kr": "알리사 씨는"
  },
  "15": {
   "jp": "a5ccc1ade6",
   "kr": "루크레프가 곧장 돌아갔다고 하더군."
  },
  "16": {
   "jp": "ec40c4294f",
   "kr": "알리사 씨…?"
  },
  "17": {
   "jp": "a0a394dfd2",
   "kr": "그래, 여관 주점에서 일하는 아가씨야."
  },
  "18": {
   "jp": "81d3c9cb02",
   "kr": "직접 만나서 얘기해 보게."
  },
  "19": {
   "jp": "47a23a828c",
   "kr": "이런 일은 자네들 쪽이 전문일 테니 말이야."
  },
  "20": {
   "jp": "2199bd8b22",
   "kr": "알리사 씨를 직접 만나서 확인해 보게."
  },
  "21": {
   "jp": "25100773b7",
   "kr": "여관 주점에서 일하고 있으니까."
  },
  "22": {
   "jp": "e2bee81b26",
   "kr": "어때, 수사는 진척됐나?"
  },
  "23": {
   "jp": "4efc59db4d",
   "kr": "도울 일이 있으면 뭐든 말해 줘."
  },
  "24": {
   "jp": "4fd9f72871",
   "kr": "나도 루크레프가 얼른 돌아와 줬으면 좋겠어."
  },
  "25": {
   "jp": "e2bee81b26",
   "kr": "어때, 수사는 진척됐나?"
  },
  "26": {
   "jp": "894a93ac59",
   "kr": "단편적인 단서뿐이에요."
  },
  "27": {
   "jp": "de3280418d",
   "kr": "어르신은 머리가 뻣뻣한 덩치 큰 남자를"
  },
  "28": {
   "jp": "856476e49f",
   "kr": "본 적 있으세요?"
  },
  "29": {
   "jp": "72d8b468ed",
   "kr": "부스스한 머리의 덩치라…"
  },
  "30": {
   "jp": "6be55352fb",
   "kr": "아, 그러고 보니 그런 손님이 있었지."
  },
  "31": {
   "jp": "46dfcc4d82",
   "kr": "초록색으로 곤두선 머리카락이"
  },
  "32": {
   "jp": "db071337f5",
   "kr": "꼭 시금치 같다고 생각했었어."
  },
  "33": {
   "jp": "5188a91ff2",
   "kr": "분명 그 손님일 거야…"
  },
  "34": {
   "jp": "dd87eb13db",
   "kr": "온갖 종류의 자물쇠며 열쇠를"
  },
  "35": {
   "jp": "43382ebbde",
   "kr": "잔뜩 사 갔거든."
  },
  "36": {
   "jp": "d23c2559ac",
   "kr": "어디에 쓰는지, 뭐에 쓰는지"
  },
  "37": {
   "jp": "8ee3bc24ef",
   "kr": "전혀 모르겠지만 말이야."
  },
  "38": {
   "jp": "1fabf88c37",
   "kr": "유난히 열쇠에 관심이 많아 보였어."
  },
  "39": {
   "jp": "8279f2f5fa",
   "kr": "루크레프한테 끈질기게"
  },
  "40": {
   "jp": "27b32af428",
   "kr": "실린더 자물쇠 구조를 물어보더군."
  },
  "41": {
   "jp": "a67ef3a51d",
   "kr": "뭐, 그 뒤로는 아무 주문도 없고 만나지도 못했지만 말이야."
  },
  "42": {
   "jp": "2181df89b6",
   "kr": "생각해 보니 수상쩍은 사내였어."
  },
  "43": {
   "jp": "564e0550ea",
   "kr": "그 덩치가 루크레프를 납치했나?"
  },
  "44": {
   "jp": "86eb03532d",
   "kr": "나야말로"
  },
  "45": {
   "jp": "4b2473fa6e",
   "kr": "알선소에 의뢰할까 하던 참이었어."
  },
  "46": {
   "jp": "79b411adf4",
   "kr": "루크레프는 성실하고"
  },
  "47": {
   "jp": "7d31570a95",
   "kr": "요즘엔 보기 드문 훌륭한 장인이거든."
  },
  "48": {
   "jp": "6c2b3e7d00",
   "kr": "이런 건"
  },
  "49": {
   "jp": "25a92bf293",
   "kr": "자네들 쪽이 전문이겠지."
  },
  "50": {
   "jp": "963611bcd5",
   "kr": "나도 루크레프가"
  },
  "51": {
   "jp": "ced9082e95",
   "kr": "얼른 돌아와 줬으면 좋겠어."
  },
  "52": {
   "jp": "a113b166ba",
   "kr": "뭐, 그 뒤로는 아무 주문도 없고"
  },
  "53": {
   "jp": "cd7758be13",
   "kr": "만나지도 못했지만 말이야."
  }
 }
}
