{
 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT02010.BIN",
 "segments": {
  "0": {
   "jp": "a44f210b27",
   "kr": "드라크 할아버지"
  },
  "1": {
   "jp": "9f0cab90e5",
   "kr": "프랑"
  },
  "2": {
   "jp": "7cf3ebffeb",
   "kr": "끔찍한 짓을 하는 녀석들이네."
  },
  "3": {
   "jp": "1ca7437add",
   "kr": "그래도 그들도 신을 믿는 사람들이잖아."
  },
  "4": {
   "jp": "551389cfbf",
   "kr": "뭔가 잘못됐어, 이런 건."
  },
  "5": {
   "jp": "32eea06d77",
   "kr": "그래, 정말 그래."
  },
  "6": {
   "jp": "6d25d54fca",
   "kr": "빨리 아이멜을 만나면 좋겠구먼."
  },
  "7": {
   "jp": "5f1586ff62",
   "kr": "아이고, 깜짝 놀랐다."
  },
  "8": {
   "jp": "02c13682cc",
   "kr": "갑자기 승병이 쳐들어와서 말이네."
  },
  "9": {
   "jp": "fc17f8f33e",
   "kr": "뭐니 뭐니 해도"
  },
  "10": {
   "jp": "3e9a1008a1",
   "kr": "이 수도원에서 남자 손은 나뿐이니까."
  },
  "11": {
   "jp": "fc4c6f934d",
   "kr": "한때는 어쩌나 싶었어."
  },
  "12": {
   "jp": "74b59656a6",
   "kr": "여하튼 모두의 목숨이 무사해서 다행이네."
  },
  "13": {
   "jp": "ddb2e3618e",
   "kr": "뭐, 여기저기 수리가 힘들겠지만."
  },
  "14": {
   "jp": "cded37fa15",
   "kr": "나이 탓인가…"
  },
  "15": {
   "jp": "4ca46d4cc3",
   "kr": "자네 얼굴을 보면"
  },
  "16": {
   "jp": "bd7a4ad5c6",
   "kr": "대충은 알 수 있네."
  },
  "17": {
   "jp": "8fb0e58720",
   "kr": "기운 내라고는 하지 않겠네만"
  },
  "18": {
   "jp": "d6835b4838",
   "kr": "언제까지고 가라앉아 있으면"
  },
  "19": {
   "jp": "bacb0d19a2",
   "kr": "진실을 놓치게 되네."
  },
  "20": {
   "jp": "3897fc0b0c",
   "kr": "또 왔는가."
  },
  "21": {
   "jp": "1088f2fe84",
   "kr": "하나 말해 둘게."
  },
  "22": {
   "jp": "958a400be2",
   "kr": "맞서는 두 존재가 있을 때 말이다."
  },
  "23": {
   "jp": "a9a1e64ef2",
   "kr": "대개는 한쪽이 옳고"
  },
  "24": {
   "jp": "89452af36e",
   "kr": "한쪽이 틀렸네."
  },
  "25": {
   "jp": "fef9db3d29",
   "kr": "하지만 그 밖의 답이 없는 것도 아니네."
  },
  "26": {
   "jp": "1ac0ac8e28",
   "kr": "둘 다 옳은 경우도 있고"
  },
  "27": {
   "jp": "790cf42bff",
   "kr": "둘 다 틀린 경우도 있네."
  },
  "28": {
   "jp": "9cd001cdb0",
   "kr": "또, 둘 다 옳은데"
  },
  "29": {
   "jp": "3050620c0b",
   "kr": "동시에 틀린 경우도 있지."
  },
  "30": {
   "jp": "48b4c992be",
   "kr": "진실을 바라본다는 건"
  },
  "31": {
   "jp": "16895f42bb",
   "kr": "아마 그런 것이겠지."
  },
  "32": {
   "jp": "f6a0c622e5",
   "kr": "어렵구먼."
  },
  "33": {
   "jp": "3b01c58664",
   "kr": "어빈 씨는"
  },
  "34": {
   "jp": "ae11b594e3",
   "kr": "아이멜 씨의 오빠시라면서요."
  },
  "35": {
   "jp": "630d4d563b",
   "kr": "그러고 보니 어빈 씨의 눈매가"
  },
  "36": {
   "jp": "fcf7a30a9d",
   "kr": "아이멜 씨와 꼭 닮았네."
  },
  "37": {
   "jp": "bada7ae789",
   "kr": "어머, 손님."
  },
  "38": {
   "jp": "f363ad8248",
   "kr": "수도원 모습은 보셨나요?"
  },
  "39": {
   "jp": "a4abbda418",
   "kr": "심한 사람들도 있네요."
  },
  "40": {
   "jp": "0ee5655d17",
   "kr": "수도원 안이 온통 어지럽혀져서"
  },
  "41": {
   "jp": "536a1bfb3e",
   "kr": "이제 청소하기가 힘들어."
  },
  "42": {
   "jp": "cab19c819e",
   "kr": "이제야 정리가 되어 가요."
  },
  "43": {
   "jp": "7f3c88e63e",
   "kr": "여기 사람들은 분명 모두 느끼고 있어."
  },
  "44": {
   "jp": "2b23e298bb",
   "kr": "일상은 늘 그렇듯 흘러가지만"
  },
  "45": {
   "jp": "24b02cbc7e",
   "kr": "뭔가 달라."
  },
  "46": {
   "jp": "3f7a6b64aa",
   "kr": "인간 세계가 아니라"
  },
  "47": {
   "jp": "cf6b6d236a",
   "kr": "신들의 세계에서 뭔가 바뀌고 있는 거야."
  },
  "48": {
   "jp": "b51a19940a",
   "kr": "싸움은 슬픔밖에 낳지 않아요."
  },
  "49": {
   "jp": "1d3bc970bb",
   "kr": "하지만 그걸 알면서도"
  },
  "50": {
   "jp": "81b9225f9e",
   "kr": "싸워야만 할 때도 있어요."
  },
  "51": {
   "jp": "8637639556",
   "kr": "우리는"
  },
  "52": {
   "jp": "0f41d05d95",
   "kr": "얼마나 슬픈 존재일까요."
  }
 }
}
