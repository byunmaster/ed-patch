  },
  "17": {
   "jp": "87e000aad8",
   "kr": "앙리"
  },
  "18": {
   "jp": "87b9db2c05",
   "kr": "로베르"
  },
  "19": {
   "jp": "debb571654",
   "kr": "오스카"
  },
  "20": {
   "jp": "f61ae2b6ac",
   "kr": "제라르"
  },
  "21": {
   "jp": "f32b75a18d",
   "kr": "르네"
  },
  "22": {
   "jp": "87b9db2c05",
   "kr": "로베르"
  },
  "23": {
   "jp": "1565a4d4c2",
   "kr": "안타깝지만 어쩔 수가 없어."
  },
  "24": {
   "jp": "fd7cb8ab62",
   "kr": "호수가 잠잠해질 때까지 기다리자."
  },
  "25": {
   "jp": "ea859787ed",
   "kr": "아무것도 없는 마을이라 지루하겠지만,"
  },
  "26": {
   "jp": "05e3d5b482",
   "kr": "조금만 참아 줘."
  },
  "27": {
   "jp": "1758a9498a",
   "kr": "출항할 수 있게 되면"
  },
  "28": {
   "jp": "abcbf298a1",
   "kr": "곧바로 떠나자."
  },
  "29": {
   "jp": "a612ba2b43",
   "kr": "어이, 오스카, 슬슬 가자고."
  },
  "30": {
   "jp": "ef45588742",
   "kr": "그런데 저쪽 형씨들은 누구야?"
  },
  "31": {
   "jp": "c7524ed39d",
   "kr": "아, 음…"
  },
  "32": {
   "jp": "f17f43daeb",
   "kr": "그러고 보니 이름을 못 물어봤네."
  },
  "33": {
   "jp": "3b18cd3934",
   "kr": "어빈이야."
  },
  "34": {
   "jp": "f0c9011f9a",
   "kr": "좋은 이름이네."
  },
  "35": {
   "jp": "9624c6c41f",
   "kr": "난 오스카."
  },
  "36": {
   "jp": "935e3fa184",
   "kr": "저쪽은 제라르야."
  },
  "37": {
   "jp": "d065444db8",
   "kr": "잘 부탁해."
  },
  "38": {
   "jp": "0a59f1aea3",
   "kr": "우리는 이 크레인으로 사금을 캐고 있어."
  },
  "39": {
   "jp": "042f82132a",
   "kr": "사금?"
  },
  "40": {
   "jp": "eac72c434c",
   "kr": "모스 호수 바닥에는 금이 섞인 모래가 쌓여 있거든."
  },
  "41": {
   "jp": "c49845fd62",
   "kr": "사금이란 놈은 보통 모래보다 무겁거든."
  },
  "42": {
   "jp": "c59598debd",
   "kr": "호수 바닥 더 깊은 곳에 쌓이는 성질이 있어."
  },
  "43": {
   "jp": "77b1400a57",
   "kr": "그래서 이 스코티아호로 캐러 가는 거야."
  },
  "44": {
   "jp": "485cd9437d",
   "kr": "헤에, 대단하네…"
  },
  "45": {
   "jp": "09584fa45c",
   "kr": "있잖아, 어빈."
  },
  "46": {
   "jp": "4b64546f71",
   "kr": "셀린 씨가 말했던"
  },
  "47": {
   "jp": "0c5ed0abc7",
   "kr": "스코티아 사당으로 이어지는 미궁의 열쇠…"
  },
  "48": {
   "jp": "d7541a1e41",
   "kr": "성스러운 크리스탈도 호수 바닥에 가라앉아 있다고 했지?"
  },
  "49": {
   "jp": "c3f8c2f40e",
   "kr": "응."
  },
  "50": {
   "jp": "15e077a61c",
   "kr": "…그렇구나."
  },
  "51": {
   "jp": "5bbf6e9048",
   "kr": "오스카 씨, 부탁이 좀 있는데요."
  },
  "52": {
   "jp": "9701d713ee",
   "kr": "루티스는 성스러운 크리스탈 이야기를 했다."
  },
  "53": {
   "jp": "29dda4b099",
   "kr": "헤에, 이 모스 호수 바닥에 크리스탈이라."
  },
  "54": {
   "jp": "42fea4956d",
   "kr": "게다가 스코티아 님과 관계가 있다고?"
  },
  "55": {
   "jp": "537da2ab25",
   "kr": "낭만이네."
  },
  "56": {
   "jp": "dff3aa8eed",
   "kr": "야, 남자의 낭만이잖아, 오스카."
  },
  "57": {
   "jp": "3db80a7369",
   "kr": "넓은 호수에 반짝이는 크리스탈 하나."
  },
  "58": {
   "jp": "074af22a88",
   "kr": "고대의 보물을 찾아라…"
  },
  "59": {
   "jp": "e8a878c56c",
   "kr": "크으, 불타오르는걸!"
  },
  "60": {
   "jp": "1973b34185",
   "kr": "진흙 퍼내는 건 늘 하던 일이잖아."
  },
  "61": {
   "jp": "93bb6db575",
   "kr": "사금을 캐면서 크리스탈도 같이 찾자고."
  },
  "62": {
   "jp": "4305962b45",
   "kr": "좋아, 한번 해 볼까."
  },
  "63": {
   "jp": "d14066c914",
   "kr": "어빈, 그 얘기 나도 끼겠어."
  },
  "64": {
   "jp": "43955ba425",
   "kr": "우리도 협력하게 해 줘."
  },
  "65": {
   "jp": "959e1d2707",
   "kr": "정말이야?"
  },
  "66": {
   "jp": "1c50e5aa69",
   "kr": "맡겨 두라고."
  },
  "67": {
   "jp": "02b187968e",
   "kr": "키트의 사나이는 믿음직하다니까."
  },
  "68": {
   "jp": "993c2a7292",
   "kr": "어이!"
  },
  "69": {
   "jp": "5a80e19565",
   "kr": "르네, 앙리, 로베르!"
  },
  "70": {
   "jp": "a8025e2cbc",
   "kr": "출항한다!!"
  },
  "71": {
   "jp": "c1782308e4",
   "kr": "남자들의 목소리"
  },
  "72": {
   "jp": "b467b96e6d",
   "kr": "어이～"
  },
  "73": {
   "jp": "1ab5c28fa3",
   "kr": "출항 준비 완료!!"
  },
  "74": {
   "jp": "768c866b51",
   "kr": "미속 전진, 이대로 곧장!!"
  },
  "75": {
   "jp": "76f6394970",
   "kr": "흔들린다, 꽉 잡아!"
  },
  "76": {
   "jp": "ae1bba0d56",
   "kr": "심심하네."
  },
  "77": {
   "jp": "0a4af442dc",
   "kr": "낮잠 자기 딱 좋은 날이라니까."
  },
  "78": {
   "jp": "2db3f3d52c",
   "kr": "안녕. 너, 장로님 댁에 왔던 손님이지?"
  },
  "79": {
   "jp": "48b216e415",
   "kr": "곧 출항하니까 마을 쪽으로 돌아가 있는 게 좋아."
  },
  "80": {
   "jp": "a6ab927788",
   "kr": "출항?"
  },
  "81": {
   "jp": "45c076ee99",
   "kr": "저기 저 사슬부터 이쪽은 마을이 아니야."
  },
  "82": {
   "jp": "ab616db7e1",
   "kr": "스코티아호라고 하는 배거든."
  },
  "83": {
   "jp": "05aa5b4310",
   "kr": "배!?"
  },
  "84": {
   "jp": "3ae8da69af",
   "kr": "여기가?"
  },
  "85": {
   "jp": "a0372f3530",
   "kr": "맞아."
  },
  "86": {
   "jp": "125ee01e4c",
   "kr": "이게 키야."
  },
  "87": {
   "jp": "e94f0a245f",
   "kr": "이렇게 큰 배로 뭘 하는데?"
  },
  "88": {
   "jp": "f747b35b03",
   "kr": "그렇게 큰 물고기라도 있어?"
  },
  "89": {
   "jp": "a562519f9b",
   "kr": "하하하, 물고기도 잡긴 하지만."
  },
  "90": {
   "jp": "d60fbb8925",
   "kr": "우리가 캐는 건 훨씬 작은 거야."
  },
  "91": {
   "jp": "8108c6c234",
   "kr": "자, 잠깐 이쪽으로 와 봐."
  },
  "92": {
   "jp": "9d6fe69dc1",
   "kr": "분하지만 호수한테는 못 이겨."
  },
  "93": {
   "jp": "5af24f6e6a",
   "kr": "조금만 더 기다려 줘."
  },
  "94": {
   "jp": "0991b35d1e",
   "kr": "여어, 마침 잘 왔어."
  },
  "95": {
   "jp": "73c5cbb175",
   "kr": "드디어 호수가 잠잠해졌어."
  },
  "96": {
   "jp": "7eeeacaa67",
   "kr": "다행이다.",
   "auto": 1
  },
  "97": {
   "jp": "f41880c9df",
   "kr": "이대로 며칠씩 발이 묶이면 어쩌나 했다니까."
  },
  "98": {
   "jp": "03f3af5add",
   "kr": "바로 출항하자."
  },
  "99": {
   "jp": "993c2a7292",
   "kr": "어이!"
  },
  "100": {
   "jp": "a9286f6580",
   "kr": "출항한다!"
  },
  "101": {
   "jp": "c1782308e4",
   "kr": "남자들의 목소리"
  },
  "102": {
   "jp": "b467b96e6d",
   "kr": "어이～"
  },
  "103": {
   "jp": "dc8101752d",
   "kr": "무슨 일이야, 어빈."
  },
  "104": {
   "jp": "1a056d001c",
   "kr": "우리 힘이 필요하면 사양 말고 말해."
  },
  "105": {
   "jp": "fe924e349e",
   "kr": "야, 어빈."
  },
  "106": {
   "jp": "ddf0387df3",
   "kr": "한가하면 같이 사금 캐러 가자."
  },
  "107": {
   "jp": "613a1005e7",
   "kr": "아～아."
  },
  "108": {
   "jp": "7e515a7351",
   "kr": "이렇게 호수를 보고 있으면 졸려."
  },
  "109": {
   "jp": "f6da4762b2",
   "kr": "우는 애와 모시의 재채기는 이길 수가 없다니까."
  },
  "110": {
   "jp": "f733d19dd1",
   "kr": "장사 공쳤네."
  },
  "111": {
   "jp": "c62b706377",
   "kr": "슬슬 호수가 잠잠해지고 있어."
  },
  "112": {
   "jp": "388992758b",
   "kr": "출항할 수 있지 않을까."
  },
  "113": {
   "jp": "c4cb71f211",
   "kr": "리타랑 셀린 씨는"
  },
  "114": {
   "jp": "142afed561",
   "kr": "무사히 데리고 돌아왔으니까."
  },
  "115": {
   "jp": "7bd91cc4e7",
   "kr": "어빈도 힘내!"
  },
  "116": {
   "jp": "fe924e349e",
   "kr": "야, 어빈."
  },
  "117": {
   "jp": "233fba9c5a",
   "kr": "그 뒤로 모시의 재채기는 안 보여."
  },
  "118": {
   "jp": "e911178fac",
   "kr": "하～ 배고프다."
  },
  "119": {
   "jp": "b307dbef45",
   "kr": "정말이지, 의욕이 났을 때 이 모양이라니."
  },
  "120": {
   "jp": "263d11fb70",
   "kr": "모시의 재채기에는 화가 치밀어."
  },
  "121": {
   "jp": "f467b016bf",
   "kr": "어이, 어빈. 오스카한테 말해 줘."
  },
  "122": {
   "jp": "bfd50efb88",
   "kr": "출항해도 괜찮을 것 같다고."
  },
  "123": {
   "jp": "468cc7c0af",
   "kr": "어서 스코티아 님을 구해 드려."
  },
  "124": {
   "jp": "7b26be19eb",
   "kr": "우리 모두"
  },
  "125": {
   "jp": "7f8adbd9aa",
   "kr": "어빈한테 신세를 졌네."
  },
  "126": {
   "jp": "8f66180668",
   "kr": "어, 고양이 소리 안 나?"
  },
  "127": {
   "jp": "dbdb82aa4a",
   "kr": "헛들은 건가…"
  },
  "128": {
   "jp": "fe2e8f88e6",
   "kr": "낙담하지 마."
  },
  "129": {
   "jp": "497379cd05",
   "kr": "곧 출항할 수 있게 될 거야."
  },
  "130": {
   "jp": "7c909a787f",
   "kr": "야, 오스카 만났어?"
  },
  "131": {
   "jp": "dd010a7894",
   "kr": "출항할 수 있을 것 같더라."
  },
  "132": {
   "jp": "cbe06d2b10",
   "kr": "도울 일이 있으면 언제든 좋아."
  },
  "133": {
   "jp": "19e39f2045",
   "kr": "어이, 어빈."
  },
  "134": {
   "jp": "5857bd0db7",
   "kr": "다시 만나서 반가워."
  },
  "135": {
   "jp": "877aaee150",
   "kr": "너도 모시 구경하러 온 관광객이야?"
  },
  "136": {
   "jp": "7d15f4c7ec",
   "kr": "그런 건 사실 없다고."
  },
  "137": {
   "jp": "3bf23534f2",
   "kr": "이런, 이런. 이렇게 되면 속수무책이야."
  },
  "138": {
   "jp": "8271d68565",
   "kr": "낮잠이나 자고 있을 수밖에."
  },
  "139": {
   "jp": "f9c8c22df2",
   "kr": "마침내 호수가 잠잠해졌어."
  },
  "140": {
   "jp": "62c09744eb",
   "kr": "오스카한테 준비 ＯＫ라고 전해 줘."
  },
  "141": {
   "jp": "48c4a4916d",
   "kr": "스코티아 님은 괜찮은 거야?"
  },
  "142": {
   "jp": "cdff27b55d",
   "kr": "또 놀러 와, 어빈."
  },
  "143": {
   "jp": "caab0230f9",
   "kr": "있잖아, 오빠."
  },
  "144": {
   "jp": "3b117cefc8",
   "kr": "이 아이 귀여워?"
  },
  "145": {
   "jp": "437fc7fa4a",
   "kr": "어?"
  },
  "146": {
   "jp": "7698418c1b",
   "kr": "이 고양이 말이니?"
  },
  "147": {
   "jp": "5ccca761b0",
   "kr": "정말 귀엽네."
  },
  "148": {
   "jp": "7c6c0fcbfb",
   "kr": "이 아이, 좋아해?"
  },
  "149": {
   "jp": "1abf790905",
   "kr": "응. 고양이는 아주 좋아해."
  },
  "150": {
   "jp": "3eabf72ae0",
   "kr": "그럼 소중히 대해 줄 거지?"
  },
  "151": {
   "jp": "42072f1b16",
   "kr": "이 아이, 데려가 주지 않을래?"
  },
  "152": {
   "jp": "437fc7fa4a",
   "kr": "어?"
  },
  "153": {
   "jp": "7525f73350",
   "kr": "그건 좀…"
  },
  "154": {
   "jp": "a0372f3530",
   "kr": "그렇구나."
  },
  "155": {
   "jp": "8e0f252b0c",
   "kr": "…역시 그렇구나…"
  },
  "156": {
   "jp": "9da7401298",
   "kr": "나, 계속 친구로 지내자고"
  },
  "157": {
   "jp": "15f114aa16",
   "kr": "이 아이랑 약속했어."
  },
  "158": {
   "jp": "26bed16601",
   "kr": "그런데 언니는 버리라고 하는 거야."
  },
  "159": {
   "jp": "c1cee3b159",
   "kr": "친구를 버리는 게 말이 돼?"
  },
  "160": {
   "jp": "8fe7855997",
   "kr": "리타야."
  },
  "161": {
   "jp": "a24a306292",
   "kr": "어?"
  },
  "162": {
   "jp": "3e91aaa834",
   "kr": "어떻게 내 이름을 알아?"
  },
  "163": {
   "jp": "0e1addcc9a",
   "kr": "셀린 씨를 만났거든."
  },
  "164": {
   "jp": "6682c1bef7",
   "kr": "고양이 때문에 가출했다며?"
  },
  "165": {
   "jp": "c04c321b4d",
   "kr": "그치만 이 아이,"
  },
  "166": {
   "jp": "e3b6fb8aab",
   "kr": "외톨이라서 불쌍하잖아."
  },
  "167": {
   "jp": "38e1f8e2e4",
   "kr": "리타는 마음씨가 곱구나."
  },
  "168": {
   "jp": "4cc036063f",
   "kr": "하지만 이제 괜찮아."
  },
  "169": {
   "jp": "fb0f92bca5",
   "kr": "언니가 키워도 된다고 했어."
  },
  "170": {
   "jp": "ec7acad623",
   "kr": "정말?"
  },
  "171": {
   "jp": "1dca2a3ed4",
   "kr": "그래."
  },
  "172": {
   "jp": "47e70a0d3f",
   "kr": "어서 같이 돌아가렴."
  },
  "173": {
   "jp": "0db4e04fcd",
   "kr": "우와. 잘됐다, 미미야."
  },
  "174": {
   "jp": "e555018214",
   "kr": "야옹."
  },
  "175": {
   "jp": "bc085cbf9e",
   "kr": "고마워, 언니."
  },
  "176": {
   "jp": "e0e8818fec",
   "kr": "안녕."
  },
  "177": {
   "jp": "88a8d30ebb",
   "kr": "미미한테 물고기를 보여 주고 있어."
  },
  "178": {
   "jp": "bd0453f6d3",
   "kr": "키워 보니 고양이는 귀엽더라고."
  },
  "179": {
   "jp": "c43aa10bde",
   "kr": "야옹."
  },
  "180": {
   "jp": "5ccd459a7b",
   "kr": "저는 신경통이 있어서요."
  },
  "181": {
   "jp": "9a6d86cc6e",
   "kr": "움직이는 게 좀 귀찮답니다."
  },
  "182": {
   "jp": "9eda53b1ac",
   "kr": "모시의 재채기라고?"
  },
  "183": {
   "jp": "77705fa279",
   "kr": "요즘 부쩍 많아졌지…"
  },
  "184": {
   "jp": "b1699bc404",
   "kr": "어쩐지 호수가 얌전해진 것 같아."
  },
  "185": {
   "jp": "d228bba9ff",
   "kr": "오스카는 또 출항하려나."
  },
  "186": {
   "jp": "9db7956405",
   "kr": "모시가 정말 있다니…"
  },
  "187": {
   "jp": "134d858ed7",
   "kr": "직접 보고도 아직 믿기지 않아."
  },
  "188": {
   "jp": "5cc963edcc",
   "kr": "어빈, 정말 조심하렴."
  },
  "189": {
   "jp": "94c1a97e55",
   "kr": "무서워지면 도망쳐도 부끄러운 게 아니란다."
  },
  "190": {
   "jp": "c6e9746e37",
   "kr": "어머나, 어빈이잖니."
  },
  "191": {
   "jp": "20846f9691",
   "kr": "차라도 마시고 가지 않겠니?"
  },
  "192": {
   "jp": "c12909ff4b",
   "kr": "곧 출항하니까"
  },
  "193": {
   "jp": "63726ba0a2",
   "kr": "마을 쪽으로 돌아가 있는 게 좋아."
  },
  "194": {
   "jp": "c12909ff4b",
   "kr": "곧 출항할 테니까"
  },
  "195": {
   "jp": "63726ba0a2",
   "kr": "마을 쪽으로 돌아가 있는 게 좋아."
  },
  "196": {
   "jp": "f77c483135",
   "kr": "이대로 며칠씩 발이 묶이면 어쩌나"
  },
  "197": {
   "jp": "eb0df8124f",
   "kr": "싶었어."
  }
 }
}
