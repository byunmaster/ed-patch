{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02200B.BIN",
 "segments": {
  "0": {
   "jp": "1936ecf342",
   "kr": "오, 편지를 운반해 주는 사람이구먼."
  },
  "1": {
   "jp": "b0955c9791",
   "kr": "이걸 보른에 사는"
  },
  "2": {
   "jp": "f509ddc41a",
   "kr": "내 친구 에르토포에게 전해 주게."
  },
  "3": {
   "jp": "3f45020773",
   "kr": "어빈은 카르의 편지를 받았다."
  },
  "4": {
   "jp": "3a20494b70",
   "kr": "에르토포는 보른에서 뱃사공을 하고 있으니"
  },
  "5": {
   "jp": "19950d1e77",
   "kr": "금방 알 수 있을 게야."
  },
  "6": {
   "jp": "1cee0de3f7",
   "kr": "부탁하네."
  },
  "7": {
   "jp": "0e0a94b0e9",
   "kr": "그 편지를 보른에 사는"
  },
  "8": {
   "jp": "f509ddc41a",
   "kr": "내 친구 에르토포에게 전해 주게."
  },
  "9": {
   "jp": "3a20494b70",
   "kr": "에르토포는 보른에서 뱃사공을 하고 있으니"
  },
  "10": {
   "jp": "19950d1e77",
   "kr": "금방 알 수 있을 게야."
  },
  "11": {
   "jp": "1cee0de3f7",
   "kr": "부탁하네."
  },
  "12": {
   "jp": "1b914f8e48",
   "kr": "이 나이가 되면 시간은 무정하게 흐르는 법일세."
  },
  "13": {
   "jp": "cd7e0e1498",
   "kr": "옛날에는 지금이 영원히 계속될 알았네."
  },
  "14": {
   "jp": "c5968c053b",
   "kr": "새 마을이 생기고 다리가 놓이고."
  },
  "15": {
   "jp": "b15b2938f3",
   "kr": "나도 모르는 새 늙어 버렸네."
  },
  "16": {
   "jp": "f1911e3078",
   "kr": "슬픈 일일세."
  },
  "17": {
   "jp": "1936ecf342",
   "kr": "오, 편지를 운반해 주는 사람이구먼."
  },
  "18": {
   "jp": "27458405b5",
   "kr": "이걸 가든힐에 사는"
  },
  "19": {
   "jp": "0e18127777",
   "kr": "내 친구 로이만에게 전해 주게."
  },
  "20": {
   "jp": "3f45020773",
   "kr": "어빈은 카르의 편지를 받았다."
  },
  "21": {
   "jp": "1cee0de3f7",
   "kr": "부탁하네."
  },
  "22": {
   "jp": "a1b078c1a1",
   "kr": "그 편지를 가든힐에 사는"
  },
  "23": {
   "jp": "0e18127777",
   "kr": "내 친구 로이만에게 전해 주게."
  },
  "24": {
   "jp": "1cee0de3f7",
   "kr": "부탁하네."
  },
  "25": {
   "jp": "2143625574",
   "kr": "이런, 짐이 꽤 많구먼."
  },
  "26": {
   "jp": "6dc293ea78",
   "kr": "알선소에서 왔다면"
  },
  "27": {
   "jp": "5d3c2fa694",
   "kr": "짐 배달 일이라는 건 알고 있을 텐데?"
  },
  "28": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "29": {
   "jp": "0a327bcd66",
   "kr": "짐을 운반해 주실 분이군요."
  },
  "30": {
   "jp": "b0c0074311",
   "kr": "응, 알선소에서 일을 맡았어."
  },
  "31": {
   "jp": "2ce487efd4",
   "kr": "지금부터 건넬 물건을 발크드에 있는"
  },
  "32": {
   "jp": "d3f4e2651f",
   "kr": "감정사 에딘 씨에게 보여 주세요."
  },
  "33": {
   "jp": "4742f10b3a",
   "kr": "자세한 건 이미 편지로 전했으니"
  },
  "34": {
   "jp": "f6132abadf",
   "kr": "가시면 바로 받아 주실 거예요."
  },
  "35": {
   "jp": "4eab79eea7",
   "kr": "노이의 짐을 맡았다."
  },
  "36": {
   "jp": "37028785ab",
   "kr": "이건 은 스푼 세트예요."
  },
  "37": {
   "jp": "1e5ba39db8",
   "kr": "어느 왕가에서 쓰던 유서 깊은 물건이에요."
  },
  "38": {
   "jp": "ca07921566",
   "kr": "굉장히 값나가는 물건이죠."
  },
  "39": {
   "jp": "94bfd5c5ba",
   "kr": "…라고 말하고 싶지만요."
  },
  "40": {
   "jp": "2fac8f86cb",
   "kr": "그게 진짜인지 아닌지 모르겠어요."
  },
  "41": {
   "jp": "df8bf85f45",
   "kr": "감정해서 진짜라면 에딘 씨가"
  },
  "42": {
   "jp": "9ba6931b60",
   "kr": "그 자리에서 사 줄 거예요."
  },
  "43": {
   "jp": "f4b7d22ef6",
   "kr": "그때는 판매가의 1할을 알선소 보수에"
  },
  "44": {
   "jp": "d96a815a23",
   "kr": "보너스로 얹어 드릴게요."
  },
  "45": {
   "jp": "abfe4de648",
   "kr": "스푼이 정말 왕가에서 쓰던 물건이라면"
  },
  "46": {
   "jp": "7d685e5540",
   "kr": "판매가의 1할이라도 알선소 보수의 10배쯤 되는"
  },
  "47": {
   "jp": "5b148fe909",
   "kr": "값어치가 있어요."
  },
  "48": {
   "jp": "9a19a2a228",
   "kr": "제가 부탁드릴 건 그것뿐이에요."
  },
  "49": {
   "jp": "699ac7c0da",
   "kr": "잘 부탁드려요. 가는 길 조심하세요."
  },
  "50": {
   "jp": "3282444ba7",
   "kr": "알선소 소개를 받은 분이시죠."
  },
  "51": {
   "jp": "ca68d2f71c",
   "kr": "작은 짐을 옮겨 주셨으면 하는데요…"
  },
  "52": {
   "jp": "9da375b22d",
   "kr": "어머! 짐이 가득하네요."
  },
  "53": {
   "jp": "37ad7a4e8f",
   "kr": "짐을 정리하고 와 주시겠어요?"
  },
  "54": {
   "jp": "71f2525bd1",
   "kr": "전할 곳은 발크드의 에딘이에요."
  },
  "55": {
   "jp": "787c2e85c1",
   "kr": "무기점에 있어요. 부탁드려요."
  },
  "56": {
   "jp": "6fae1a4bbb",
   "kr": "돌아왔네요. 수고했어요."
  },
  "57": {
   "jp": "40c01bd299",
   "kr": "바로 묻는데, 에딘 씨 감정 결과는 어땠어요?"
  },
  "58": {
   "jp": "7713d40846",
   "kr": "유감이지만… 가짜였어."
  },
  "59": {
   "jp": "530674beb0",
   "kr": "진짜라면 자루 뒤쪽에 작은 각인이"
  },
  "60": {
   "jp": "eb58a20c6a",
   "kr": "있다고 하더라."
  },
  "61": {
   "jp": "91fbe6b18c",
   "kr": "그래도 품질이 좋은 물건이니"
  },
  "62": {
   "jp": "4111110739",
   "kr": "소중히 쓰라고 하더군."
  },
  "63": {
   "jp": "cdb7e99344",
   "kr": "노이에게 은 스푼을 돌려주었다."
  },
  "64": {
   "jp": "edd10b1434",
   "kr": "그래요… 가짜였군요. 역시."
  },
  "65": {
   "jp": "84bf021a6b",
   "kr": "아, 미안해요. 모처럼 발크드까지 가 줬는데"
  },
  "66": {
   "jp": "dc1b6e8bdd",
   "kr": "이런 결과가 되고 말았네요."
  },
  "67": {
   "jp": "ade6b207a4",
   "kr": "그럼 이 스푼은 에딘 씨 말대로"
  },
  "68": {
   "jp": "90a25dedcb",
   "kr": "마음껏 쓰기로 할게요."
  },
  "69": {
   "jp": "0aade50fe0",
   "kr": "결국 물건은 팔리지 않았으니"
  },
  "70": {
   "jp": "73a48718c0",
   "kr": "특별 보너스는 못 드리게 됐네요."
  },
  "71": {
   "jp": "28c02a35a6",
   "kr": "괜히 기뻐하게 해서 미안해요."
  },
  "72": {
   "jp": "08bacbaa24",
   "kr": "하지만 발크드까지 가 주셨으니"
  },
  "73": {
   "jp": "60f4e3c07f",
   "kr": "그만큼의 보수는 제대로 알선소에서"
  },
  "74": {
   "jp": "68f6cef724",
   "kr": "받을 수 있도록 해 둘게요."
  },
  "75": {
   "jp": "b778500e04",
   "kr": "휴…"
  },
  "76": {
   "jp": "4862215730",
   "kr": "좋아, 다음엔 꼭 진짜 물건을"
  },
  "77": {
   "jp": "3469483239",
   "kr": "찾아서 한몫 챙기겠어."
  },
  "78": {
   "jp": "efe7159959",
   "kr": "좋은 물건을 찾으면 또 알선소에 의뢰를"
  },
  "79": {
   "jp": "e8a2506778",
   "kr": "낼 테니 그때 부탁드려요."
  },
  "80": {
   "jp": "9c9cfdbf48",
   "kr": "어라, 짐은 어떻게 했어요?"
  }
 }
}
