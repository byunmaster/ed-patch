  },
  "20": {
   "jp": "f61ae2b6ac",
   "kr": "제라르"
  },
  "21": {
   "jp": "543d09c576",
   "kr": "어빈!!"
  },
  "22": {
   "jp": "a442bcdcb2",
   "kr": "그럼 또 보자!"
  },
  "23": {
   "jp": "117bbb5933",
   "kr": "을(를) 사용했다.",
   "auto": 1
  },
  "24": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다.",
   "auto": 1
  },
  "25": {
   "jp": "246acb31c6",
   "kr": "가자, 어빈!"
  },
  "26": {
   "jp": "50603a1f4a",
   "kr": "스코티아 님과 리타를 구하는 거야!!"
  },
  "27": {
   "jp": "86e207e76c",
   "kr": "오늘도 날씨가 좋네."
  },
  "28": {
   "jp": "6557d1dfa5",
   "kr": "자, 빨래, 빨래."
  },
  "29": {
   "jp": "374983bde0",
   "kr": "아, 드디어 빨래가 끝났네."
  },
  "30": {
   "jp": "835898719b",
   "kr": "차를 마실 건데, 여러분도 같이 어떠세요?"
  },
  "31": {
   "jp": "90582f6338",
   "kr": "어머, 기뻐라."
  },
  "32": {
   "jp": "847aeed1ab",
   "kr": "그런데 셀린 씨,"
  },
  "33": {
   "jp": "51630d320b",
   "kr": "장로님께 이야기를 듣고 왔는데요,"
  },
  "34": {
   "jp": "b8eaca67bc",
   "kr": "스코티아의 사당에 관한 고문서를 보여 주실 수 없을까요?"
  },
  "35": {
   "jp": "a3aebf6d26",
   "kr": "그런 일이라면 어렵지 않아요."
  },
  "36": {
   "jp": "2f63aa7a8e",
   "kr": "잠깐만 기다려요."
  },
  "37": {
   "jp": "8c9dcd6f35",
   "kr": "짐은 괜찮죠?"
  },
  "38": {
   "jp": "fd66a18456",
   "kr": "그럼 열쇠를 드릴게요."
  },
  "39": {
   "jp": "3417f1da19",
   "kr": "을(를) 맡았다."
  },
  "40": {
   "jp": "c78c0beb95",
   "kr": "짐에 여유가 있으면"
  },
  "41": {
   "jp": "970c77bbb0",
   "kr": "열쇠를 빌려 드릴게요."
  },
  "42": {
   "jp": "c5757c95c3",
   "kr": "별로 도움이 못 된 모양이라"
  },
  "43": {
   "jp": "6e5fbf8bd8",
   "kr": "미안해요."
  },
  "44": {
   "jp": "b3b831ac77",
   "kr": "어머, 어빈 씨."
  },
  "45": {
   "jp": "717b4f4195",
   "kr": "빨간 옷 입은 여자아이 못 보셨어요?"
  },
  "46": {
   "jp": "6005a73660",
   "kr": "제 동생인데, 리타라는 이름이에요."
  },
  "47": {
   "jp": "4c756ed3fa",
   "kr": "무슨 일이에요?"
  },
  "48": {
   "jp": "2d75db0ec4",
   "kr": "그 애가 어디선가 새끼 고양이를 주워 와서요."
  },
  "49": {
   "jp": "762962b6d1",
   "kr": "『키울 수 없어』 하고 야단쳤더니…"
  },
  "50": {
   "jp": "4c6567276b",
   "kr": "집을 뛰쳐나갔구나."
  },
  "51": {
   "jp": "beebd1000f",
   "kr": "그래요."
  },
  "52": {
   "jp": "0cb15d8760",
   "kr": "제가 너무 심하게 말했나 봐요."
  },
  "53": {
   "jp": "ecaaf274fe",
   "kr": "고양이쯤은 키우게 해 줄걸 그랬어요."
  },
  "54": {
   "jp": "486c59bcbb",
   "kr": "혹시 리타를 보면 알려 주세요."
  },
  "55": {
   "jp": "e709cff3e7",
   "kr": "리타를 보면 알려 주세요."
  },
  "56": {
   "jp": "6102986430",
   "kr": "부탁드려요."
  },
  "57": {
   "jp": "ee496fc9bb",
   "kr": "아까는 신세 많이 졌어요."
  },
  "58": {
   "jp": "558ecdd9b9",
   "kr": "이렇게 보니 고양이도 귀엽네요."
  },
  "59": {
   "jp": "fda0dabcdc",
   "kr": "어서 그 상자를 열어 보세요."
  },
  "60": {
   "jp": "012ae9359c",
   "kr": "빨리 스코티아 님께 가요."
  },
  "61": {
   "jp": "e1765f2adf",
   "kr": "스코티아 님을 구할 수 있는 건"
  },
  "62": {
   "jp": "cc3a6268e3",
   "kr": "어빈 씨뿐이에요."
  },
  "63": {
   "jp": "9823e195f8",
   "kr": "부디 부탁드려요."
  },
  "64": {
   "jp": "2cab26990e",
   "kr": "어빈 씨께 뭐라고 감사해야 할지."
  },
  "65": {
   "jp": "ebed55b275",
   "kr": "정말 고마워요."
  },
  "66": {
   "jp": "b9fb9c21fb",
   "kr": "저, 멋진 노래를 만들었어요."
  },
  "67": {
   "jp": "3610450716",
   "kr": "라라라, 토끼도 고양이도"
  },
  "68": {
   "jp": "e43df7ba01",
   "kr": "다 같이 즐겁게 춤춰요. 라라라…"
  },
  "69": {
   "jp": "9ec8b2b184",
   "kr": "저랑 미미는 절친이에요."
  },
  "70": {
   "jp": "dde164c23a",
   "kr": "오빠, 절친이 뭔지 알아요?"
  },
  "71": {
   "jp": "5c916d135d",
   "kr": "모시의 친구들을"
  },
  "72": {
   "jp": "8254af6d83",
   "kr": "어서 구해 주세요."
  },
  "73": {
   "jp": "e23b8c3806",
   "kr": "어빈 오빠, 또 놀러 와요."
  },
  "74": {
   "jp": "94b335d006",
   "kr": "야옹."
  },
  "75": {
   "jp": "c617970d9a",
   "kr": "두근두근하네!"
  },
  "76": {
   "jp": "231e4a3409",
   "kr": "어서 보물상자를 열어 봐."
  },
  "77": {
   "jp": "c6a319ce77",
   "kr": "우리도 같이 싸울 거야!"
  },
  "78": {
   "jp": "7421a680a3",
   "kr": "헤헤, 싸움이라면 나도 세다고."
  },
  "79": {
   "jp": "17ea8cdc3a",
   "kr": "셀린 씨도 가는 거야?"
  },
  "80": {
   "jp": "36f3248b7a",
   "kr": "무, 무, 무섭지 않아. 하하하…"
  },
  "81": {
   "jp": "2ff57fa65e",
   "kr": "동",
   "auto": 1
  },
  "82": {
   "jp": "b81eea7416",
   "kr": "…흠흠, 상징학적 견해에 따르면"
  },
  "83": {
   "jp": "0dd0ca20e1",
   "kr": "키트의 모시 전설에는"
  },
  "84": {
   "jp": "d229b953ac",
   "kr": "…중얼중얼…"
  },
  "85": {
   "jp": "4a03cfdb92",
   "kr": "네네, 무슨 일이시죠?"
  },
  "86": {
   "jp": "48996f9db4",
   "kr": "쇼핑은 일단"
  },
  "87": {
   "jp": "7f91a82cfa",
   "kr": "카운터 앞으로 와 주세요."
  },
  "88": {
   "jp": "da9ead0c6c",
   "kr": "아, 이쪽으로 들어오시면 안 돼요."
  },
  "89": {
   "jp": "63c464779d",
   "kr": "관계자 외 출입 금지예요."
  },
  "90": {
   "jp": "21795bdd80",
   "kr": "보물상자는 잠겨 있다.",
   "auto": 1
  },
  "91": {
   "jp": "63c4c357c2",
   "kr": "보물상자에는 아무것도 들어 있지 않다."
  },
  "92": {
   "jp": "fd06d4c082",
   "kr": "스코티아 사당에 관한"
  },
  "93": {
   "jp": "1d7b5ff9e7",
   "kr": "고문서를 보여 주실 수 있을까요?"
  }
 }
}
