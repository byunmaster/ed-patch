  "1": {
   "jp": "1e195f6292",
   "kr": "섀넌",
   "auto": 1
  },
  "2": {
   "jp": "0d49427e8a",
   "kr": "할아버지, 돌아왔어."
  },
  "3": {
   "jp": "30773c4173",
   "kr": "봐, 아이멜도 건강해."
  },
  "4": {
   "jp": "ae89197dd7",
   "kr": "긴 여행이었어."
  },
  "5": {
   "jp": "638d205f5d",
   "kr": "생각했던 것보다 이런저런 일이 많았지."
  },
  "6": {
   "jp": "1cdc01ec0f",
   "kr": "여행 동료와 헤어질 때는 묘하게 슬펐어."
  },
  "7": {
   "jp": "b2413957ad",
   "kr": "쓸쓸하다고 느낀 건 오랜만이야."
  },
  "8": {
   "jp": "54f1c65ef5",
   "kr": "하지만 평생 여행만 할 수도 없잖아."
  },
  "9": {
   "jp": "b1d934ac79",
   "kr": "어쩔 수 없지."
  },
  "10": {
   "jp": "df66bec3f4",
   "kr": "루티스…"
  },
  "11": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "12": {
   "jp": "1b853959e2",
   "kr": "…같이 가자고 해 줬으니까."
  },
  "13": {
   "jp": "fad05a835f",
   "kr": "환영해요, 루티스 씨."
  },
  "14": {
   "jp": "69a85cf902",
   "kr": "와 줘서 고마워."
  },
  "15": {
   "jp": "6fc5c513b4",
   "kr": "아이멜과 헤어진 뒤 레뮤라스 할아버지가 돌아가실 때까지"
  },
  "16": {
   "jp": "0bf13028c8",
   "kr": "줄곧 이 전망 좋은 오두막에서 자랐어."
  },
  "17": {
   "jp": "4a550d6dd9",
   "kr": "밖에 나가는 일이 있어도"
  },
  "18": {
   "jp": "d8d03141b1",
   "kr": "북쪽 숲이나, 기껏해야 마일이 있는 울트 마을에 가는 정도가"
  },
  "19": {
   "jp": "91fa7af4ea",
   "kr": "고작이었어."
  },
  "20": {
   "jp": "411113c425",
   "kr": "사교도가 노리고 있다고는 해도"
  },
  "21": {
   "jp": "84c649e486",
   "kr": "내가 있을 곳은 너무나 좁아서"
  },
  "22": {
   "jp": "c11543c155",
   "kr": "매일 숨이 막힐 것 같은 기분이었어."
  },
  "23": {
   "jp": "625f2b78e1",
   "kr": "아이멜이 걱정돼서 견딜 수 없었고"
  },
  "24": {
   "jp": "3e6664555c",
   "kr": "여기 있어서는"
  },
  "25": {
   "jp": "d53772510a",
   "kr": "아무것도 시작할 수 없다고 생각했어."
  },
  "26": {
   "jp": "b9ba2c3d38",
   "kr": "오빠…"
  },
  "27": {
   "jp": "3186908f14",
   "kr": "할아버지와 마일이 기분을 풀어 줬지만."
  },
  "28": {
   "jp": "be2f3f7469",
   "kr": "역시 나는 여기서 나가고 싶었어."
  },
  "29": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "30": {
   "jp": "dc6022b8d9",
   "kr": "………"
  },
  "31": {
   "jp": "cd51788ebe",
   "kr": "하지만 지금은 여기가 어디보다도 정겨워."
  },
  "32": {
   "jp": "3f6855043c",
   "kr": "에헴!"
  },
  "33": {
   "jp": "845045dc49",
   "kr": "이런… 제가 방해를 했나 봅니다."
