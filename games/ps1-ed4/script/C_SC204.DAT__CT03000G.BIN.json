{
 "archive": "/C/SC204.DAT",
 "member": "..\\BIN\\CT03000G.BIN",
 "segments": {
  "0": {
   "jp": "1a8f9c919a",
   "kr": "그럼 내가 상대를 해 드리겠소."
  },
  "1": {
   "jp": "74d8dbda37",
   "kr": "허어! 당신도 이야기를 해 주시려는가?"
  },
  "2": {
   "jp": "60ee5caad4",
   "kr": "허허, 어째 황송해지는구먼."
  },
  "3": {
   "jp": "0179ee0e87",
   "kr": "숨겨도 다 보인다오."
  },
  "4": {
   "jp": "a7d7d492ed",
   "kr": "당신의 온몸에서 배어 나오는 그 풍격."
  },
  "5": {
   "jp": "97b20120f7",
   "kr": "보통 분이 아니시구먼."
  },
  "6": {
   "jp": "e5ecc67cff",
   "kr": "당치도 않소."
  },
  "7": {
   "jp": "719717a45f",
   "kr": "나는 어빈 일행의 여행에 편승한 늙은이일 뿐이오."
  },
  "8": {
   "jp": "992d875626",
   "kr": "그리 대단한 사람이 아니오."
  },
  "9": {
   "jp": "2fc5a7c35a",
   "kr": "또 그런 말씀을 하시고…"
  },
  "10": {
   "jp": "fdf023cd6b",
   "kr": "더 수상하구먼."
  },
  "11": {
   "jp": "f26ede54d9",
   "kr": "자, 무슨 이야기를 할까."
  },
  "12": {
   "jp": "e3511831f0",
   "kr": "글쎄."
  },
  "13": {
   "jp": "b02e08cafa",
   "kr": "너무 어두운 이야기는 마음이 가라앉으니"
  },
  "14": {
   "jp": "1848003324",
   "kr": "희망이 보이는 이야기를 하겠소."
  },
  "15": {
   "jp": "0c8aa88633",
   "kr": "정령신 둘가의 이야기는 어떻소?"
  },
  "16": {
   "jp": "c515ce18cd",
   "kr": "엘 필딘에서는"
  },
  "17": {
   "jp": "65a85a0ed9",
   "kr": "오크툼 신과 발두스 신은 잘 알려져 있지만"
  },
  "18": {
   "jp": "e90214f076",
   "kr": "정령신 둘가는 그다지 알려지지 않았소."
  },
  "19": {
   "jp": "2869d4e9a6",
   "kr": "정령신 둘가. 아아, 들어 본 적은 있네."
  },
  "20": {
   "jp": "0a76c66f14",
   "kr": "코르나 마을에서 모시는 신이지."
  },
  "21": {
   "jp": "31471d8736",
   "kr": "진실의 섬과도 관련이 있다던가…"
  },
  "22": {
   "jp": "1950b3e7b6",
   "kr": "오크툼 신과 발두스 신에게 끼여서"
  },
  "23": {
   "jp": "2c11e4ce45",
   "kr": "그리 유명하지는 않지만 말이네."
  },
  "24": {
   "jp": "db0b3a811a",
   "kr": "확실히 세상의 인식은 그 정도지."
  },
  "25": {
   "jp": "b175bd6ce0",
   "kr": "하지만 그것도 다 정령신 둘가의 존재를"
  },
  "26": {
   "jp": "3a40d551f3",
   "kr": "동화 정도로만 여겼던 우리 쪽에"
  },
  "27": {
   "jp": "922cc5eaa2",
   "kr": "문제가 있었는지도 모르오."
  },
  "28": {
   "jp": "a3911c5ee9",
   "kr": "정령신 둘가는"
  },
  "29": {
   "jp": "92b7ee7c71",
   "kr": "모든 죽음을 관장하는 네 정령의 우두머리이며"
  },
  "30": {
   "jp": "696a93d390",
   "kr": "명부문의 관리자요."
  },
  "31": {
   "jp": "3314b16023",
   "kr": "어떤 의미로는 발두스 신이나 오크툼 신보다"
  },
  "32": {
   "jp": "9c23821f6a",
   "kr": "인간에 가까운 존재라 해도 좋을 거요."
  },
  "33": {
   "jp": "58df7e8fbe",
   "kr": "으음, 누구에게나 죽음은 찾아오니 말이네…"
  },
  "34": {
   "jp": "ee80d1ac9b",
   "kr": "그렇다 해도 소문뿐, 정령신 둘가의 기적을"
  },
  "35": {
   "jp": "3b0e8035c7",
   "kr": "체험한 이의 이야기는 들은 적이 없소만."
  },
  "36": {
   "jp": "950be798dc",
   "kr": "기적이라면…"
  },
  "37": {
   "jp": "5d992d32e2",
   "kr": "여기 있는 어빈과 루티스가 체험했소."
  },
  "38": {
   "jp": "5816d79fe9",
   "kr": "루티스는 회복 불능으로 보일 만큼 저주에 걸렸지만"
  },
  "39": {
   "jp": "0abdcc1b81",
   "kr": "정령신 둘가가 전한 해주법으로"
  },
  "40": {
   "jp": "514c85cd9a",
   "kr": "어빈이 저주를 풀어 루티스의 목숨을 구했소."
  },
  "41": {
   "jp": "850cd2611e",
   "kr": "이런… 정말인가?"
  },
  "42": {
   "jp": "6a50ab422a",
   "kr": "대, 대단하구먼…"
  },
  "43": {
   "jp": "e3aee16d4f",
   "kr": "그런 모험을 했었나, 자네들?"
  },
  "44": {
   "jp": "3a8943b4c1",
   "kr": "발두스 신과 오크툼 신."
  },
  "45": {
   "jp": "1e64a3c682",
   "kr": "대극의 신과 중립에 자리한 정령신 둘가."
  },
  "46": {
   "jp": "ee6e8bcfb9",
   "kr": "앞으로 어떤 동란이 일어나더라도"
  },
  "47": {
   "jp": "3208a9eabf",
   "kr": "이 세 신의 진실한 구조를 이해할 수 있다면"
  },
  "48": {
   "jp": "cde480b4dd",
   "kr": "우리는 더는… 절망의 구렁텅이에 떨어지지 않소."
  },
  "49": {
   "jp": "71d3a7b530",
   "kr": "어빈이 루티스의 저주를 푼 일이"
  },
  "50": {
   "jp": "2bcfa92182",
   "kr": "그런 희망을 내게 품게 해 주었소."
  },
  "51": {
   "jp": "e6f40e3a0c",
   "kr": "으음. 어둡지는 않으나 묵직한 이야기로군."
  },
  "52": {
   "jp": "e4b0d8baa8",
   "kr": "전승이란 으레 어딘가 각색되기 마련이니."
  },
  "53": {
   "jp": "3495749d4b",
   "kr": "진실의 구조라…"
  },
  "54": {
   "jp": "043a10027d",
   "kr": "오랜만에 지성을 자극하는 이야기였네."
  },
  "55": {
   "jp": "002d90bfd7",
   "kr": "생각하게 하는 좋은 이야기를 들었네."
  },
  "56": {
   "jp": "05ec360cf7",
   "kr": "２００로제를 지불하리다."
  },
  "57": {
   "jp": "5fa91ddb2f",
   "kr": "가웨인은 ２００로제를 받았다."
  },
  "58": {
   "jp": "1fa2161c84",
   "kr": "또 말동무가 되어 주러 오시게."
  },
  "59": {
   "jp": "03dbf01df9",
   "kr": "단, 새 이야기를 구해 오시게."
  },
  "60": {
   "jp": "be60d90d46",
   "kr": "루티스는"
  },
  "61": {
   "jp": "1f3414d0eb",
   "kr": "회복 불능으로 보일 만큼 저주에 걸렸지만"
  }
 }
}
