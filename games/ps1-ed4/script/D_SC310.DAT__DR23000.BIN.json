  "156": {
   "jp": "3dc8a4139a",
   "kr": "「끝」이라고 할 때까지 말하면 안 돼."
  },
  "157": {
   "jp": "b1ca02d248",
   "kr": "자자, 그러지 말고."
  },
  "158": {
   "jp": "edc1269c41",
   "kr": "뭐든 경험이잖아."
  },
  "159": {
   "jp": "4137e42f40",
   "kr": "잠깐만 해 봐."
  },
  "160": {
   "jp": "f53875244c",
   "kr": "그럼 해 보자."
  },
  "161": {
   "jp": "af72830264",
   "kr": "시작!"
  },
  "162": {
   "jp": "a8cb12e05e",
   "kr": "어빈은 묵언 수행을 시작했다."
  },
  "163": {
   "jp": "798c3ca34e",
   "kr": "자. 절대 말하면 안 돼."
  },
  "164": {
   "jp": "f592e8a837",
   "kr": "예"
  },
  "165": {
   "jp": "fcaf88bce5",
   "kr": "아니요"
  },
  "166": {
   "jp": "8b0f2c46ee",
   "kr": "무시"
  },
  "167": {
   "jp": "8242cdda22",
   "kr": "앗, 안 돼."
  },
  "168": {
   "jp": "c29267d879",
   "kr": "대답도 소리 내서 하면 안 되거든."
  },
  "169": {
   "jp": "f763dce5ef",
   "kr": "묵언이니까 알겠지?"
  },
  "170": {
   "jp": "18028667e7",
   "kr": "그래, 그렇지."
  },
  "171": {
   "jp": "5bb97e74a4",
   "kr": "그거면 돼."
  },
  "172": {
   "jp": "b68ee71676",
   "kr": "주위에서 무슨 일이 일어나도"
  },
  "173": {
   "jp": "119659d304",
   "kr": "마음을 가라앉히고 묵언 수행을 계속하는 거야."
  },
  "174": {
   "jp": "62953ab3b5",
   "kr": "집중함으로써"
  },
  "175": {
   "jp": "e9eb13da23",
   "kr": "마음속에서 외부의 유혹을 차단하는 것이"
  },
  "176": {
   "jp": "006c994201",
   "kr": "바로 묵언 수행이야."
  },
  "177": {
   "jp": "e4d979258f",
   "kr": "알겠지?"
  },
  "178": {
   "jp": "08111f960b",
   "kr": "제법이네."
  },
  "179": {
   "jp": "fa290ba6ff",
   "kr": "걸려들 줄 알았는데…"
  },
  "180": {
   "jp": "3cdb9c5ab9",
   "kr": "자, 끝!"
  },
  "181": {
   "jp": "63c114717e",
   "kr": "묵언 수행이 끝났다."
  },
  "182": {
   "jp": "1d6aafa9d2",
   "kr": "휴…"
  },
  "183": {
   "jp": "bc43166044",
   "kr": "자칫하면 말하고 싶어지네."
  },
  "184": {
   "jp": "744b93b273",
   "kr": "그렇지?"
  },
  "185": {
   "jp": "c07de6cb6e",
   "kr": "물론"
  },
  "186": {
   "jp": "dfc9ee7d03",
   "kr": "나는 혼자 수행했기 때문에"
  },
  "187": {
   "jp": "d80bdd8c63",
   "kr": "말을 거는 일은 없었지만."
  },
  "188": {
   "jp": "4e1d81a23e",
   "kr": "오래 묵언 수행을 하다 보면 말이야."
  },
  "189": {
   "jp": "7b521491f5",
   "kr": "정신을 차리면 저도 모르게 혼잣말을"
  },
  "190": {
   "jp": "50906d0253",
   "kr": "중얼거리게 돼."
  },
  "191": {
   "jp": "3b9ba5f2f1",
   "kr": "얼마나 오래 말을 안 했어?"
  },
  "192": {
   "jp": "3a8a9d2891",
   "kr": "최고 기록이 １０일쯤인가."
  },
  "193": {
   "jp": "56de1211de",
   "kr": "１０일이 한계야."
  },
  "194": {
   "jp": "792f9caa0b",
   "kr": "３일 단식, ７일 묵언을 한 세트로 해서"
  },
  "195": {
   "jp": "79428e3f84",
   "kr": "이걸 십 년간 계속했어."
  },
  "196": {
   "jp": "1a2818ff61",
   "kr": "그 덕에"
  },
  "197": {
   "jp": "f2b3080adb",
   "kr": "조금은 신선에 가까워진 듯한"
  },
  "198": {
   "jp": "f71e0313c2",
   "kr": "기분이 들긴 하지만."
  },
  "199": {
   "jp": "0dd86c63f6",
   "kr": "그럼 돌아가 볼까."
  },
  "200": {
   "jp": "3f3ca237b6",
   "kr": "그래?"
  },
  "201": {
   "jp": "466a73767e",
   "kr": "정 싫다면 억지로 하라곤 안 하지만."
  },
  "202": {
   "jp": "ae9d808503",
   "kr": "시시하네."
  },
  "203": {
   "jp": "0dd86c63f6",
   "kr": "그럼 돌아갈까."
  },
  "204": {
   "jp": "04a29dfdce",
   "kr": "어빈은"
  },
  "205": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다.",
   "auto": 1
  },
  "206": {
   "jp": "889ceea3f2",
   "kr": "보물상자에는"
  },
  "207": {
   "jp": "665e4d5705",
   "kr": "이(가) 들어 있다.",
   "auto": 1
  },
  "208": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "209": {
   "jp": "f5fc3dee34",
   "kr": "을(를) 포기했다.",
   "auto": 1
  },
  "210": {
   "jp": "63c4c357c2",
   "kr": "보물상자 안에는 아무것도 없다."
  }
 }
}
