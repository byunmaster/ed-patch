 "segments": {
  "0": {
   "jp": "c7835842e0",
   "kr": "아이멜",
   "auto": 1
  },
  "1": {
   "jp": "a60cd79ca9",
   "kr": "가웨인"
  },
  "2": {
   "jp": "1414651fa3",
   "kr": "토마스"
  },
  "3": {
   "jp": "1e195f6292",
   "kr": "섀넌",
   "auto": 1
  },
  "4": {
   "jp": "01c0285e88",
   "kr": "정말 신세 많이 졌습니다."
  },
  "5": {
   "jp": "5c0cce3736",
   "kr": "이걸, 미첼 씨께."
  },
  "6": {
   "jp": "74c80b9192",
   "kr": "어빈은 미첼에게 에류시온을 건넸다."
  },
  "7": {
   "jp": "b23be063f3",
   "kr": "네? 저에게… 이 검을요?"
  },
  "8": {
   "jp": "e5ecc67cff",
   "kr": "말도 안 돼요."
  },
  "9": {
   "jp": "69067345a0",
   "kr": "이렇게 소중한 건 받을 수 없어요."
  },
  "10": {
   "jp": "25c6277c52",
   "kr": "다 같이 의논했어요."
  },
  "11": {
   "jp": "c476125e43",
   "kr": "우리 마음을 전하려면"
  },
  "12": {
   "jp": "1b8911eb18",
   "kr": "이게 가장 좋지 않을까 해서요."
  },
  "13": {
   "jp": "f2e8935d7b",
   "kr": "받아 주세요."
  },
  "14": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "15": {
   "jp": "7cd3e653d1",
   "kr": "그렇군요."
  },
  "16": {
   "jp": "a290d56ebc",
   "kr": "그럼 감사히 받겠어요."
  },
  "17": {
   "jp": "aabf1b6eae",
   "kr": "이것이 에류시온…"
  },
  "18": {
   "jp": "5bcc4323b5",
   "kr": "…훌륭한 물건이군요."
  },
  "19": {
   "jp": "ddac0c61d1",
   "kr": "발두스의 힘은 사라졌으니"
  },
  "20": {
   "jp": "35a2406ef2",
   "kr": "이제 에류시온이라고는 부를 수 없으려나."
  },
  "21": {
   "jp": "496005ed05",
   "kr": "아, 맞아요."
  },
  "22": {
   "jp": "ebc68e666d",
   "kr": "기왕 받는 거니"
  },
  "23": {
   "jp": "7e30fcefb7",
   "kr": "이 검에 새 이름을 붙여 주시겠어요?"
  },
  "24": {
   "jp": "73c6e30946",
   "kr": "새 이름…?"
  },
  "25": {
   "jp": "efab1fcbc8",
   "kr": "글쎄요."
  },
  "26": {
   "jp": "e4eb8eb436",
   "kr": "…아, 그렇지."
  },
  "27": {
   "jp": "98a2689cb4",
   "kr": "에스페리우스 님의 이름을 따서"
  },
  "28": {
   "jp": "aeec561b74",
   "kr": "에스페란서라고 하는 건 어떨까요?"
  },
  "29": {
   "jp": "33091f7cc2",
   "kr": "좋네요. 그 이름. 그걸로 정할게요."
  },
  "30": {
   "jp": "46dda46a5d",
   "kr": "그럼 이 에스페란서는 사양하지 않고 받겠어요."
  },
  "31": {
   "jp": "7cfb355f84",
   "kr": "미첼 씨, 건강하세요."
  },
  "32": {
   "jp": "a0dde4aa4f",
   "kr": "당신도요."
  },
  "33": {
   "jp": "07cefa9b65",
   "kr": "그럼, 실례할게요."
  },
  "34": {
   "jp": "a0d2886939",
   "kr": "저기…"
  },
  "35": {
   "jp": "701ad7ed93",
   "kr": "무슨 일이세요?"
  },
  "36": {
   "jp": "23bb499fde",
   "kr": "저는 지팡이밖에 쓰지 않아서"
  },
  "37": {
   "jp": "717a369e3b",
   "kr": "이 검을 제대로 다룰 사람을 만나면"
  },
  "38": {
   "jp": "6d565f8beb",
   "kr": "그 사람에게 줘도 괜찮을까요?"
  },
  "39": {
   "jp": "aff8f8477c",
   "kr": "미첼 씨가"
  },
  "40": {
   "jp": "c3ad7ebc00",
   "kr": "그러고 싶다고 생각할 만한 사람이라면 문제없어요."
  },
  "41": {
   "jp": "e4ad207204",
   "kr": "그렇게 하세요."
  },
  "42": {
   "jp": "6af99606e7",
   "kr": "다행이네요."
  },
  "43": {
   "jp": "e326e92418",
   "kr": "그럼 갈까요?"
  },
  "44": {
   "jp": "70d4ed08e1",
   "kr": "토마스 씨."
  },
  "45": {
   "jp": "9dd87b1a35",
   "kr": "가웨인 영감님!"
  },
  "46": {
   "jp": "f7f0369b31",
   "kr": "다녀올게요!"
  },
  "47": {
   "jp": "6f55f07231",
   "kr": "오오. 몸조심하게!"
  },
  "48": {
   "jp": "7a70ebb395",
   "kr": "미첼 씨 정도의 마법사라면"
  },
  "49": {
   "jp": "076330017e",
   "kr": "배 같은 건 안 써도"
  },
  "50": {
   "jp": "baecf51815",
   "kr": "자기 나라까지 한 번에 날아가지 않을까."
  },
  "51": {
   "jp": "05966ba85c",
   "kr": "그게 그 사람의 고집이야."
  },
  "52": {
   "jp": "fa30621f2e",
   "kr": "그런 사람이야. 미첼 씨는."
  },
  "53": {
   "jp": "cf40d24066",
   "kr": "토마스도 잘해 줬으니 말이오."
  },
  "54": {
   "jp": "b118d8d478",
   "kr": "프라네토스호는 은퇴하는 내가 주는 선물이오."
  }
 }
}
