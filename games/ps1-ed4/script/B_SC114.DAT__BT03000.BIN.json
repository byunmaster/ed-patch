  },
  "9": {
   "jp": "3e2d10f462",
   "kr": "보론"
  },
  "10": {
   "jp": "2cb28d2429",
   "kr": "로이만"
  },
  "11": {
   "jp": "97226b4cbc",
   "kr": "멜크"
  },
  "12": {
   "jp": "e99cb9bc55",
   "kr": "닥터 반들",
   "auto": 1
  },
  "13": {
   "jp": "4a27a1f29d",
   "kr": "이런 이런."
  },
  "14": {
   "jp": "ad0c68b194",
   "kr": "물건을 사시려면 카운터로 와 주세요."
  },
  "15": {
   "jp": "6169ab2a27",
   "kr": "손님이군."
  },
  "16": {
   "jp": "60314080d8",
   "kr": "카운터로 와 줘."
  },
  "17": {
   "jp": "0b0298e708",
   "kr": "별일이네."
  },
  "18": {
   "jp": "102acb0470",
   "kr": "올라오는 사람이 있다니."
  },
  "19": {
   "jp": "4c5cb6bd0a",
   "kr": "힘들었겠어."
  },
  "20": {
   "jp": "0adbf76f18",
   "kr": "산길에 익숙하지 않으면 꽤 힘들거든."
  },
  "21": {
   "jp": "86ad1e4f2c",
   "kr": "이런 산꼭대기에 마을이 있어서 놀랐지?"
  },
  "22": {
   "jp": "b555690aed",
   "kr": "가든힐은"
  },
  "23": {
   "jp": "c592c16829",
   "kr": "세상에서 가장 높은 곳에 있는 마을이야."
  },
  "24": {
   "jp": "e5491d7fd5",
   "kr": "가든힐은 비가 안 오지만"
  },
  "25": {
   "jp": "4a51929a55",
   "kr": "산에서 맑은 샘물이"
  },
  "26": {
   "jp": "c4f1202596",
   "kr": "솟아나니까 생활에는 문제없어."
  },
  "27": {
   "jp": "1c2f45cd47",
   "kr": "산의 은혜지."
  },
  "28": {
   "jp": "8b7f6d78f4",
   "kr": "나는 여기 생활밖에 모르지만"
  },
  "29": {
   "jp": "4686612a59",
   "kr": "지상을 여행하며 도는 생활도 즐거워 보이네."
  },
  "30": {
   "jp": "8f1a41e5d2",
   "kr": "왠지 부러워."
  },
  "31": {
   "jp": "ccbfaec165",
   "kr": "언젠가 나도 지상 마을에서 살아 보고 싶어."
  },
  "32": {
   "jp": "617e4c58f3",
   "kr": "어머, 지상에서 올라왔니?"
  },
  "33": {
   "jp": "70329ff16d",
   "kr": "건물이 유적 같아서 놀랐지?"
  },
  "34": {
   "jp": "76e2b3f456",
   "kr": "가든힐은 지상의 어느 마을보다 역사가 오래됐어."
  },
  "35": {
   "jp": "cccc3b72cc",
   "kr": "그러니 건물이 낡은 건 당연하지."
  },
  "36": {
   "jp": "fd2d23305b",
   "kr": "원래 유적에 살고 있는걸."
  },
  "37": {
   "jp": "eb69457697",
   "kr": "마을 북쪽에 신전이 있는 건 알아?"
  },
  "38": {
   "jp": "33cdb9735b",
   "kr": "가든힐에는"
  },
  "39": {
   "jp": "3b043a7f0c",
   "kr": "대대로 신전을 지키는 성자님이 있는데"
  },
  "40": {
   "jp": "c460252b83",
   "kr": "그게 레이트르 님의 가문이야."
  },
  "41": {
   "jp": "9ebbff5ad1",
   "kr": "그 레이트르 님의 모습이 요즘 안 보여."
  },
  "42": {
   "jp": "e253122faa",
   "kr": "무슨 일 있나…"
  },
  "43": {
   "jp": "116a4b40c5",
   "kr": "가든힐의 신전이"
  },
  "44": {
   "jp": "bd83f43246",
   "kr": "이둔 님의 사당이었다니"
  },
  "45": {
   "jp": "efd193f263",
   "kr": "몰랐어."
  },
  "46": {
   "jp": "a1604ccb8f",
   "kr": "혹시 이둔 님의 힘 덕분에"
  },
  "47": {
   "jp": "89d598290d",
   "kr": "맑은 물이 솟았던 걸까…"
  },
  "48": {
   "jp": "32bf5527bc",
   "kr": "어, 형들 지상 사람이야?"
  },
  "49": {
   "jp": "1d7200e42c",
   "kr": "관광이야?"
  },
  "50": {
   "jp": "41ed62803f",
   "kr": "가끔 와."
  },
  "51": {
   "jp": "cc35436df7",
   "kr": "유적을 구경하러"
  },
  "52": {
   "jp": "341e407946",
   "kr": "가든힐에 올라오는 사람들이 말이야."
  },
  "53": {
   "jp": "ef6f1ce89d",
   "kr": "구경해도 좋지만"
  },
  "54": {
   "jp": "8d2b182dca",
   "kr": "너무 빤히 쳐다보지는 마."
  },
  "55": {
   "jp": "53e556f27c",
   "kr": "우리가 사는 집이니까."
  },
  "56": {
   "jp": "4f24fc91d4",
   "kr": "사실은 구경거리가 아니라고."
  },
  "57": {
   "jp": "6b5be35297",
   "kr": "어, 지상 사람은 약골이라고 들었는데"
  },
  "58": {
   "jp": "e601513167",
   "kr": "형들은"
  },
  "59": {
   "jp": "a9aba03191",
   "kr": "그렇지도 않은 모양이네."
  },
  "60": {
   "jp": "c103e81b7b",
   "kr": "그래도 한마디 해 두겠는데,"
  },
  "61": {
   "jp": "96c9c112b4",
   "kr": "촌놈 얕보지 마."
  },
  "62": {
   "jp": "6d46855ee9",
   "kr": "아～아, 이 마을은 자극이 부족해."
  },
  "63": {
   "jp": "29136abf72",
   "kr": "언젠가 지상으로 내려가…"
  },
  "64": {
   "jp": "e2b40b51b4",
   "kr": "그래, 필딘 같은 데가 좋겠다."
  },
  "65": {
   "jp": "16d2dd671b",
   "kr": "도시 생활을 하고 싶어."
  },
  "66": {
   "jp": "e7419daf39",
   "kr": "찾아오신 분들이 자주 말씀하세요."
  },
  "67": {
   "jp": "22bbeef6de",
   "kr": "가든힐은 고대부터"
  },
  "68": {
   "jp": "10f3ddc3e3",
   "kr": "시간이 멈춘 것 같은 마을이라고."
  },
  "69": {
   "jp": "e9424f388c",
   "kr": "예전에 왔던 학자 얘기로는"
  },
  "70": {
   "jp": "aab5bcf68c",
   "kr": "여기 건물은 유사 이전의 것이라고 하니까요."
  },
  "71": {
   "jp": "2bfa5bc7d9",
   "kr": "뭐, 그런 말을 들어도 어쩔 수 없죠."
  },
  "72": {
   "jp": "5311695586",
   "kr": "가든힐이라는 이름은"
  },
  "73": {
   "jp": "176f676b43",
   "kr": "『신들의 정원』이라는 뜻이라고 해요."
  },
  "74": {
   "jp": "ef498a4d61",
   "kr": "그게 무슨 뜻인지"
  },
  "75": {
   "jp": "352f673af3",
   "kr": "여기 사는 저희도 모르겠지만"
  },
  "76": {
   "jp": "896591da3f",
   "kr": "왠지 깊은 말이죠."
  },
  "77": {
   "jp": "8d0bbdaec2",
   "kr": "신들의 정원이라…"
  },
  "78": {
   "jp": "37d8e819e8",
   "kr": "조금 알 것 같은 기분이 들어."
  },
  "79": {
   "jp": "aa7c7a9cb5",
   "kr": "여기는 신들이 인간의 세계를 만들려고"
  },
  "80": {
   "jp": "16b973ce39",
   "kr": "먼저 시험 삼아 만든"
  },
  "81": {
   "jp": "5842b8b599",
   "kr": "정원인지도 모르겠어…"
  },
  "82": {
   "jp": "fd41501dee",
   "kr": "요즘 그런 생각을 한답니다."
  },
  "83": {
   "jp": "b75ad03614",
   "kr": "어머, 어빈 군."
  },
  "84": {
   "jp": "43258aa6de",
   "kr": "저번엔 폐를 끼쳤구나."
  },
  "85": {
   "jp": "a82abc42fc",
   "kr": "앤디는 아직도 어딘가를 헤매고 있나 봐."
  },
  "86": {
   "jp": "58714396c8",
   "kr": "보게 되면 얼른 돌아오라고 전해 줘."
  },
  "87": {
   "jp": "62fbe5384b",
   "kr": "어머, 어빈 군 아니니."
  },
  "88": {
   "jp": "5240c4ec89",
   "kr": "요전에는 정말 신세 많이 졌구나."
  },
  "89": {
   "jp": "978f15b96f",
   "kr": "앤디를 만나면"
  },
  "90": {
   "jp": "faef3ad44d",
   "kr": "얼른 돌아오라고 전해 줘."
  },
  "91": {
   "jp": "4ea1239dae",
   "kr": "이 마을 아이들도"
  },
  "92": {
   "jp": "50d096633b",
   "kr": "다들 처음엔 도시보다"
  },
  "93": {
   "jp": "9ad025531c",
   "kr": "여기가 좋다고 하지만."
  },
  "94": {
   "jp": "19b4cb10af",
   "kr": "그래도 젊은 사람들은"
  },
  "95": {
   "jp": "5a86357113",
   "kr": "거의 이 마을을 떠나 버렸어."
  },
  "96": {
   "jp": "cb11294ab9",
   "kr": "나한테도 아들이 하나 있는데."
  },
  "97": {
   "jp": "6b67421e38",
   "kr": "산을 내려간 뒤로 소식이 없어."
  },
  "98": {
   "jp": "0b7e686eb0",
   "kr": "나도 젊을 때는"
  },
  "99": {
   "jp": "1147fe1208",
   "kr": "몇 번이고 이 마을을 나가려고 했지."
  },
  "100": {
   "jp": "b114a59a69",
   "kr": "하지만 이 나이가 되면"
  },
  "101": {
   "jp": "778a484987",
   "kr": "다른 곳에서의 삶은 생각도 못 해."
  },
  "102": {
   "jp": "b45e2f7d92",
   "kr": "자네 고향은 어딘가?"
  },
  "103": {
   "jp": "9b4e1dd038",
   "kr": "고향은 멀리서 그리워하는 거라고들"
  },
  "104": {
   "jp": "54b742f8b4",
   "kr": "하지만 말이야."
  },
  "105": {
   "jp": "83ade155c3",
   "kr": "살아 봐야 고향이지."
  },
  "106": {
   "jp": "08d7db9c7d",
   "kr": "아, 맞다."
  },
  "107": {
   "jp": "3914ff2249",
   "kr": "여기 올라올 때"
  },
  "108": {
   "jp": "566914151b",
   "kr": "벼랑을 지나왔지?"
  },
  "109": {
   "jp": "3bdc06f10f",
   "kr": "비밀 지름길을 가르쳐 줄게."
  },
  "110": {
   "jp": "6f02c423e1",
   "kr": "저기 구멍"
  },
  "111": {
   "jp": "a3a3f8f895",
   "kr": "직통 엘리베이터의"
  },
  "112": {
   "jp": "402038aaff",
   "kr": "비밀 입구야."
  },
  "113": {
   "jp": "3927877f1a",
   "kr": "알고 있었어?"
  },
  "114": {
   "jp": "d04c22451a",
   "kr": "직통 엘리베이터는 말이야."
  },
  "115": {
   "jp": "ae11c2f06c",
   "kr": "한 번 위에서 내려오면"
  },
  "116": {
   "jp": "fad6f4dad9",
   "kr": "언제든 쓸 수 있게 돼."
  },
  "117": {
   "jp": "2010e3184d",
   "kr": "다행이지?"
  },
  "118": {
   "jp": "a455d86c22",
   "kr": "있잖아, 북쪽 신전에도"
  },
  "119": {
   "jp": "f5cdb43a8c",
   "kr": "비밀 입구가 있다는 얘기야."
  },
  "120": {
   "jp": "da70054a8e",
   "kr": "정말일까…?"
  },
  "121": {
   "jp": "8f4d5be739",
   "kr": "안녕, 잘 지내? 나도 새끼 고양이도 잘 지내."
  },
  "122": {
   "jp": "c76544ecf4",
   "kr": "너는 어때?"
  },
  "123": {
   "jp": "6c390f76cb",
   "kr": "다른 사람들한테는 비밀인데."
  },
  "124": {
   "jp": "129c87c495",
   "kr": "나 말이야, 커서"
  },
  "125": {
   "jp": "0c77a01d7f",
   "kr": "프리오와 사랑의 도피를 해서"
  },
  "126": {
   "jp": "4480bede2f",
   "kr": "가든힐을 떠날 거야."
  },
  "127": {
   "jp": "2aadc74c4e",
   "kr": "왜냐면 여기"
  },
  "128": {
   "jp": "31c42c79d9",
   "kr": "따분하단 말이야."
  },
  "129": {
   "jp": "510fae73d4",
   "kr": "뭐야, 뭐야?"
  },
  "130": {
   "jp": "8b04f571ac",
   "kr": "와, 귀여운 고양이!"
  },
  "131": {
   "jp": "b2a03cbea8",
   "kr": "바로아의 디암 씨한테서 맡아 왔어."
  },
  "132": {
   "jp": "fedd44fbc9",
   "kr": "에엑, 갑자기 그런 말 들어도 곤란해."
  },
  "133": {
   "jp": "cb5aaea2ca",
   "kr": "나더러 이 새끼 고양이를 키우라고?!"
  },
  "134": {
   "jp": "b0b6399e9e",
   "kr": "안 돼, 그런 건."
  },
  "135": {
   "jp": "723b9be445",
   "kr": "그대로 가져가."
  },
  "136": {
   "jp": "025533190d",
   "kr": "곤란하네."
  },
  "137": {
   "jp": "979d7d2bba",
   "kr": "나도 이 녀석을 키울 수는…"
  },
  "138": {
   "jp": "a6e6b2cbcd",
   "kr": "그런 말 해도～."
  },
  "139": {
   "jp": "bbb3e190d3",
   "kr": "정말～! 어쩔 수 없네."
  },
  "140": {
   "jp": "6bad1dc6a6",
   "kr": "그럼 그 근처에 놓고 가면 되잖아."
  },
  "141": {
   "jp": "d29ee38b74",
   "kr": "아무튼 새끼 고양이를 준에게 건넸다."
  },
  "142": {
   "jp": "831ac64f2e",
   "kr": "준은 새끼 고양이를 바라보며 뭔가 생각하는 듯하다."
  },
  "143": {
   "jp": "211af20f17",
   "kr": "있잖아, 하나 물어봐도 될까?"
  },
  "144": {
   "jp": "4884579426",
   "kr": "뭔데?"
  },
  "145": {
   "jp": "9598e6efaf",
   "kr": "새끼 고양이는 뭘 먹지?"
  },
  "146": {
   "jp": "03d69d78c2",
   "kr": "어…!!"
  },
  "147": {
   "jp": "79010ba956",
   "kr": "새끼 고양이를 키워 본 적이 없거든."
  },
  "148": {
   "jp": "59cddf438b",
   "kr": "나, 어떻게 키워야 할지 모르겠어."
  },
  "149": {
   "jp": "081936cefe",
   "kr": "고양이 기르는 법을 자세히 설명하게 됐다."
  },
  "150": {
   "jp": "acaa650e8e",
   "kr": "음, 대충 알았어."
  },
  "151": {
   "jp": "ec72ca2820",
   "kr": "뭔가 손이 많이 갈 것 같네."
  },
  "152": {
   "jp": "65ec1ae1f8",
   "kr": "그래도 최대한 힘내 볼게."
  },
  "153": {
   "jp": "1245f0ac33",
   "kr": "잘 돌보면 좋은 친구가 될 거야."
  },
  "154": {
   "jp": "eb578425d9",
   "kr": "새끼 고양이",
   "auto": 1
  },
  "155": {
   "jp": "c2db1f96e9",
