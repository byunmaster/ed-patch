  "1": {
   "jp": "de6223e0de",
   "kr": "릭"
  },
  "2": {
   "jp": "41e71542e2",
   "kr": "케니"
  },
  "3": {
   "jp": "d1d8f990db",
   "kr": "카르 할아버지"
  },
  "4": {
   "jp": "65c04b6bb5",
   "kr": "빈센"
  },
  "5": {
   "jp": "72c1401010",
   "kr": "빅토리아"
  },
  "6": {
   "jp": "0d7a6c238b",
   "kr": "노이"
  },
  "7": {
   "jp": "e0fcacb5ae",
   "kr": "서 ",
   "auto": 1
  },
  "8": {
   "jp": "88836f7051",
   "kr": "정말이지, 원!"
  },
  "9": {
   "jp": "706fe925a8",
   "kr": "우리 애는 어쩜 그렇게 못된 말썽꾸러기인지!"
  },
  "10": {
   "jp": "447a4c7113",
   "kr": "여, 어빈 형!!"
  },
  "11": {
   "jp": "6ee57d0f98",
   "kr": "같이 놀자!!"
  },
  "12": {
   "jp": "8857ffd2e3",
   "kr": "정말 어른이란 건"
  },
  "13": {
   "jp": "53e76c04ff",
   "kr": "아무것도 모른다니까."
  },
  "14": {
   "jp": "be79199f7d",
   "kr": "무슨 일이오."
  },
  "15": {
   "jp": "1323384078",
   "kr": "나는 편지 쓰는 게 취미라서 말이오."
  },
  "16": {
   "jp": "dec58b4ed2",
   "kr": "지금부터 편지 한 통을 쓰려던 참이오."
  },
  "17": {
   "jp": "e0766af371",
   "kr": "방해하지 마시오."
  },
  "18": {
   "jp": "ecf03c9447",
   "kr": "자, 어디로 보낼까."
  },
  "19": {
   "jp": "ba51b91526",
   "kr": "성의 공주님은"
  },
  "20": {
   "jp": "b1bbb8eb36",
   "kr": "엄청난 말괄량이래."
  },
  "21": {
   "jp": "da944a6d8a",
   "kr": "본 적은 없지만."
  },
  "22": {
   "jp": "de2a6394d2",
   "kr": "누가 빅토리아 좀 산책시켜 주지 않을까."
  },
  "23": {
   "jp": "671161e340",
   "kr": "이 애는 필딘의 공주님처럼 까다로워."
  },
  "24": {
   "jp": "a380e9e561",
   "kr": "요전에 지하에서 이상한 소리가 들렸어."
  },
  "25": {
   "jp": "787624f0a0",
   "kr": "우리 빅토리아가 무서워해서 곤란했어."
  },
  "26": {
   "jp": "9c806bce72",
   "kr": "빅토리아는 기분이 좋아."
  },
  "27": {
   "jp": "50c02d081b",
   "kr": "늘 이러면 좋을 텐데."
  },
  "28": {
   "jp": "4ceb9bf8e2",
   "kr": "끄응～"
  },
  "29": {
   "jp": "e07fd6477a",
   "kr": "멍!"
  },
  "30": {
   "jp": "ec072bf379",
   "kr": "산책에서 돌아오면"
  },
  "31": {
   "jp": "2054bbe499",
   "kr": "사례를 낼게."
  },
  "32": {
   "jp": "68936f4f3e",
   "kr": "부디 잘 부탁해."
  },
  "33": {
   "jp": "51b839a45f",
   "kr": "멍!"
  },
  "34": {
   "jp": "fbf0f23ba3",
   "kr": "으으으～"
  },
  "35": {
   "jp": "a1ee7c2af2",
   "kr": "눈이 빙빙 돌아～"
  },
  "36": {
   "jp": "bc81d43c42",
   "kr": "멍! 멍!"
  },
  "37": {
   "jp": "5617c826d8",
   "kr": "앗, 기다려～!"
  },
  "38": {
   "jp": "cb3e144f6f",
   "kr": "이 마을 지하에는 하수도가 있지만"
  },
  "39": {
   "jp": "d1c0f45864",
   "kr": "들어가면 안 돼."
  },
  "40": {
   "jp": "f90e8733f0",
   "kr": "흉포한 마수가 득실거리니까."
  },
  "41": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "42": {
   "jp": "0a327bcd66",
   "kr": "짐을 운반해 주실 분이군요."
  },
  "43": {
   "jp": "b0c0074311",
   "kr": "응, 알선소에서 일을 맡았어."
  },
  "44": {
   "jp": "2ce487efd4",
   "kr": "지금부터 건넬 물건을 발크드에 있는"
  },
  "45": {
   "jp": "d3f4e2651f",
   "kr": "감정사 에딘 씨에게 보여 주세요."
  },
  "46": {
   "jp": "4742f10b3a",
   "kr": "자세한 건 이미 편지로 전했으니"
  },
  "47": {
   "jp": "f6132abadf",
   "kr": "가시면 바로 받아 주실 거예요."
  },
  "48": {
   "jp": "4eab79eea7",
   "kr": "노이의 짐을 맡았다."
  },
  "49": {
   "jp": "37028785ab",
   "kr": "이건 은 스푼 세트예요."
  },
  "50": {
   "jp": "1e5ba39db8",
   "kr": "어느 왕가에서 쓰던 유서 깊은 물건이에요."
  },
  "51": {
   "jp": "ca07921566",
   "kr": "굉장히 값나가는 물건이죠."
  },
  "52": {
   "jp": "94bfd5c5ba",
   "kr": "…라고 말하고 싶지만요."
  },
  "53": {
   "jp": "2fac8f86cb",
   "kr": "그게 진짜인지 아닌지 모르겠어요."
  },
  "54": {
   "jp": "df8bf85f45",
   "kr": "감정해서 진짜라면 에딘 씨가"
  },
  "55": {
   "jp": "9ba6931b60",
   "kr": "그 자리에서 사 줄 거예요."
  },
  "56": {
   "jp": "f4b7d22ef6",
   "kr": "그때는 판매가의 １할을 알선소 보수에"
  },
  "57": {
   "jp": "d96a815a23",
   "kr": "보너스로 얹어 드릴게요."
  },
  "58": {
   "jp": "abfe4de648",
   "kr": "스푼이 정말 왕가에서 쓰던 물건이라면"
  },
  "59": {
   "jp": "7d685e5540",
   "kr": "판매가의 １할이라도 알선소 보수의 １０배쯤 되는"
  },
  "60": {
   "jp": "5b148fe909",
   "kr": "값어치가 있어요."
  },
  "61": {
   "jp": "9a19a2a228",
   "kr": "제가 부탁드릴 건 그것뿐이에요."
  },
  "62": {
   "jp": "699ac7c0da",
   "kr": "잘 부탁드려요. 가는 길 조심하세요."
  },
  "63": {
   "jp": "3282444ba7",
   "kr": "알선소 소개를 받은 분이시죠."
  },
  "64": {
   "jp": "ca68d2f71c",
   "kr": "작은 짐을 옮겨 주셨으면 하는데요…"
  },
  "65": {
   "jp": "dc58a1be40",
   "kr": "짐이 가득하네요."
  },
  "66": {
   "jp": "71f2525bd1",
   "kr": "전할 곳은 발크드의 에딘이에요."
  },
  "67": {
   "jp": "787c2e85c1",
   "kr": "무기점에 있어요. 부탁드려요."
  },
  "68": {
   "jp": "6fae1a4bbb",
   "kr": "돌아왔네요. 수고했어요."
  },
  "69": {
   "jp": "40c01bd299",
   "kr": "바로 묻는데, 에딘 씨 감정 결과는 어땠어요?"
  },
  "70": {
   "jp": "7713d40846",
   "kr": "유감이지만… 가짜였어."
  },
  "71": {
   "jp": "530674beb0",
   "kr": "진짜라면 자루 뒤쪽에 작은 각인이"
  },
  "72": {
   "jp": "eb58a20c6a",
   "kr": "있다고 하더라."
  },
  "73": {
   "jp": "91fbe6b18c",
   "kr": "그래도 품질이 좋은 물건이니"
  },
  "74": {
   "jp": "4111110739",
   "kr": "소중히 쓰라고 하더군."
  },
  "75": {
   "jp": "cdb7e99344",
   "kr": "노이에게 은 스푼을 돌려주었다."
  },
  "76": {
   "jp": "edd10b1434",
   "kr": "그래요… 가짜였군요. 역시."
  },
  "77": {
   "jp": "84bf021a6b",
   "kr": "아, 미안해요. 모처럼 발크드까지 가 줬는데"
  },
  "78": {
   "jp": "dc1b6e8bdd",
   "kr": "이런 결과가 되고 말았네요."
  },
  "79": {
   "jp": "ade6b207a4",
   "kr": "그럼 이 스푼은 에딘 씨 말대로"
  },
  "80": {
   "jp": "90a25dedcb",
   "kr": "마음껏 쓰기로 할게요."
  },
  "81": {
   "jp": "0aade50fe0",
   "kr": "결국 물건은 팔리지 않았으니"
  },
  "82": {
   "jp": "73a48718c0",
   "kr": "특별 보너스는 못 드리게 됐네요."
  },
  "83": {
   "jp": "28c02a35a6",
   "kr": "괜히 기뻐하게 해서 미안해요."
  },
  "84": {
   "jp": "08bacbaa24",
   "kr": "하지만 발크드까지 가 주셨으니"
  },
  "85": {
   "jp": "60f4e3c07f",
   "kr": "그만큼의 보수는 제대로 알선소에서"
  },
  "86": {
   "jp": "68f6cef724",
   "kr": "받을 수 있도록 해 둘게요."
  },
  "87": {
   "jp": "b778500e04",
   "kr": "휴…"
  },
  "88": {
   "jp": "4862215730",
   "kr": "좋아, 다음엔 꼭 진짜 물건을"
  },
  "89": {
   "jp": "3469483239",
   "kr": "찾아서 한몫 챙기겠어."
  },
  "90": {
   "jp": "efe7159959",
   "kr": "좋은 물건을 찾으면 또 알선소에 의뢰를"
  },
  "91": {
   "jp": "e8a2506778",
   "kr": "낼 테니 그때 부탁드려요."
  },
  "92": {
   "jp": "27cf47a903",
   "kr": "다음엔 꼭 진짜 물건을"
  },
  "93": {
   "jp": "3469483239",
   "kr": "찾아서 한몫 챙기겠어."
  },
  "94": {
   "jp": "efe7159959",
   "kr": "좋은 물건을 찾으면 또 알선소에 의뢰를"
  },
  "95": {
   "jp": "e8a2506778",
   "kr": "낼 테니 그때 부탁드려요."
  },
  "96": {
   "jp": "223b17c78f",
   "kr": "저기, 여행하는 동안 좋은 물건 같은 거"
  },
  "97": {
   "jp": "60eed46f37",
   "kr": "찾지 못했어요?"
  },
  "98": {
   "jp": "8cec956d46",
   "kr": "손해 안 보는 값이면 사 줄게요."
  },
  "99": {
   "jp": "bc8e51613e",
   "kr": "…………어라."
  },
  "100": {
   "jp": "c24ca53137",
   "kr": "너희 짐은"
  },
  "101": {
   "jp": "6ccf832d9b",
   "kr": "값나갈 것 없는 물건뿐이네요."
  },
  "102": {
   "jp": "2229e6d924",
   "kr": "이 애는 필딘의"
  },
  "103": {
   "jp": "e264eea57d",
   "kr": "공주님처럼 까다로워."
  },
  "104": {
   "jp": "9297574e6f",
   "kr": "치브리 마을은 이쪽이 아니야～."
  }
 }
