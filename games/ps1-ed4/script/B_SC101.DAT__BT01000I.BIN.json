{
 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT01000I.BIN",
 "segments": {
  "0": {
   "jp": "1b90ca8726",
   "kr": "오빠가 컬리를 찾아 주는 거네."
  },
  "1": {
   "jp": "bb3ff6b843",
   "kr": "있잖아, 컬리는 하얀 새끼 고양이야."
  },
  "2": {
   "jp": "92d36f97a8",
   "kr": "이 마을에는 컬리를 쏙 닮은 형제가 있어서"
  },
  "3": {
   "jp": "42c7475b08",
   "kr": "얼핏 봐서는 몰라."
  },
  "4": {
   "jp": "37667d4344",
   "kr": "하지만 '컬리야!' 하고 부르면"
  },
  "5": {
   "jp": "b147fe616c",
   "kr": "목을 가르랑거리는 건 컬리뿐이야."
  },
  "6": {
   "jp": "93915451d2",
   "kr": "컬리야…라고 부르는 건가."
  },
  "7": {
   "jp": "6932d12a4a",
   "kr": "안 돼, 오빠."
  },
  "8": {
   "jp": "8ef6a863ea",
   "kr": "컬리야!"
  },
  "9": {
   "jp": "26fa48770c",
   "kr": "하고 큰 소리로 불러야 해."
  },
  "10": {
   "jp": "6a89fd3b4e",
   "kr": "아, 알았어."
  },
  "11": {
   "jp": "c179ec6d56",
   "kr": "열심히 해 볼게."
  },
  "12": {
   "jp": "394db19b80",
   "kr": "꼭 찾아 줘, 오빠."
  },
  "13": {
   "jp": "0ee37dd2c4",
   "kr": "정말, 컬리,"
  },
  "14": {
   "jp": "e1324a29a7",
   "kr": "어디 갔다 왔어?"
  },
  "15": {
   "jp": "5ce735d0ce",
   "kr": "오빠, 고마워."
  },
  "16": {
   "jp": "a45471675a",
   "kr": "새끼 고양이는 아무 반응도 보이지 않는다."
  },
  "17": {
   "jp": "c527cfdcd3",
   "kr": "컬리가 아닌 것 같네."
  },
  "18": {
   "jp": "fd63199603",
   "kr": "캬악!"
  },
  "19": {
   "jp": "2210765c59",
   "kr": "으악."
  },
  "20": {
   "jp": "acce614c35",
   "kr": "이 고양이는 아닌 것 같네."
  },
  "21": {
   "jp": "55a1fca644",
   "kr": "미야, 미야."
  },
  "22": {
   "jp": "e7ee7d28f1",
   "kr": "으음."
  },
  "23": {
   "jp": "c938b8ed3f",
   "kr": "좋아하긴 하는데 가르랑거리지는 않으니"
  },
  "24": {
   "jp": "c527cfdcd3",
   "kr": "컬리가 아닌 것 같네."
  },
  "25": {
   "jp": "a093f6c0a6",
   "kr": "그르릉…"
  },
  "26": {
   "jp": "ebf9a8e35d",
   "kr": "이름을 불렀더니 가르랑거렸어."
  },
  "27": {
   "jp": "636cdb307f",
   "kr": "컬리가 틀림없어."
  },
  "28": {
   "jp": "d608f2ecba",
   "kr": "이리 와, 컬리."
  },
  "29": {
   "jp": "c1d456fd8e",
   "kr": "자, 컬리를 니키타에게 데려다주자."
  },
  "30": {
   "jp": "7f9a91d4ca",
   "kr": "고양이 이름을 큰 소리로 부르기는 좀 쑥스러운데."
  },
  "31": {
   "jp": "7f8eb71df1",
   "kr": "자, 어빈."
  },
  "32": {
   "jp": "8522cac89b",
   "kr": "일이잖아."
  },
  "33": {
   "jp": "d36db0bc07",
   "kr": "니키타가 기다리고 있어."
  },
  "34": {
   "jp": "1bdca22e17",
   "kr": "얼른 불러."
  },
  "35": {
   "jp": "3c83e5a254",
   "kr": "어빈 씨.",
   "auto": 1
  },
  "36": {
   "jp": "40484dbc7f",
   "kr": "부끄러워할 때가 아니에요."
  },
  "37": {
   "jp": "1bd47f334a",
   "kr": "…남의 일이라고 쉽게들 말하네."
  },
  "38": {
   "jp": "86ba2846d8",
   "kr": "부르면 되잖아, 부르면."
  },
  "39": {
   "jp": "8ef6a863ea",
   "kr": "컬리야!"
  },
  "40": {
   "jp": "f2bea46978",
   "kr": "'야'를 붙여서 부르는 게 정말 못 견디겠어."
  },
  "41": {
   "jp": "896cd9c7ef",
   "kr": "곧 익숙해질 거야."
  },
  "42": {
   "jp": "c254a07702",
   "kr": "경쾌하게 가자."
  },
  "43": {
   "jp": "8d6899ad9e",
   "kr": "니키타를 위해서야."
  },
  "44": {
   "jp": "337fe62423",
   "kr": "여기선 참아."
  },
  "45": {
   "jp": "ca1bf79afc",
   "kr": "어린 여자아이를 위해서예요."
  },
  "46": {
   "jp": "db13006f13",
   "kr": "힘내요."
  },
  "47": {
   "jp": "010b23e85b",
   "kr": "알았다고.",
   "auto": 1
  },
  "48": {
   "jp": "8ef6a863ea",
   "kr": "컬리야!"
  },
  "49": {
   "jp": "82e2c8fd3d",
   "kr": "이렇게 된 이상 막 간다."
  },
  "50": {
   "jp": "8ef6a863ea",
   "kr": "컬리야!"
  },
  "51": {
   "jp": "4b91f2c0f7",
   "kr": "이번에야말로 부탁한다."
  },
  "52": {
   "jp": "8ef6a863ea",
   "kr": "컬리야!"
  }
 }
}
