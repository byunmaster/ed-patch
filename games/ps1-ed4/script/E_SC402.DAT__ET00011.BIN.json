  },
  "46": {
   "jp": "837b79d697",
   "kr": "아니요.",
   "auto": 1
  },
  "47": {
   "jp": "d82bba6cdb",
   "kr": "덕분에 저는 팔팔해요."
  },
  "48": {
   "jp": "440b18205e",
   "kr": "선생님께는 따로 중요한 볼일이 있어요."
  },
  "49": {
   "jp": "849f3e0dc5",
   "kr": "정기 검진 날까지는 기다릴 수가 없거든요."
  },
  "50": {
   "jp": "2d0fcc6a61",
   "kr": "반들 선생님은 여기저기 여행을 다니셔서"
