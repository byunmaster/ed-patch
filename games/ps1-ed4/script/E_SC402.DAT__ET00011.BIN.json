  "30": {
   "jp": "19e39f2045",
   "kr": "어이, 어빈."
  },
  "31": {
   "jp": "5857bd0db7",
   "kr": "다시 만나서 반가워."
  },
  "32": {
   "jp": "cdff27b55d",
   "kr": "또 놀러 와, 어빈."
  },
  "33": {
   "jp": "3730300d0d",
   "kr": "어머나, 오랜만이에요."
  },
  "34": {
   "jp": "086fdfb13d",
   "kr": "어빈이잖니."
  },
  "35": {
   "jp": "f3f7a2387f",
   "kr": "어쩐지 지난번보다 키가 큰 것 같지 않아요?"
  },
  "36": {
   "jp": "1dd8aefc21",
   "kr": "어엿한 청년이 되었네요."
  },
  "37": {
   "jp": "a34cf19f7c",
   "kr": "그만해, 할머니."
  },
  "38": {
   "jp": "e28fecc33d",
   "kr": "대답하기 곤란하잖아."
  },
  "39": {
   "jp": "26311f23b2",
   "kr": "그보다 뭐더라… 그래, 일손이 필요하다고?"
  },
  "40": {
   "jp": "7d3d8d9497",
   "kr": "알선소에서 일을 맡아 왔어."
  },
  "41": {
   "jp": "16d4b77dda",
   "kr": "어머, 어빈이 일을 해 주려고요?"
  },
  "42": {
   "jp": "6e07511a27",
   "kr": "든든하네요."
  },
  "43": {
   "jp": "6199f9d5a6",
   "kr": "실은 반들 선생님을 모셔 와 줬으면 해서요."
  },
  "44": {
   "jp": "5834199a01",
   "kr": "반들 선생님을?"
