{
 "archive": "/C/SC203.DAT",
 "member": "..\\BIN\\CT00010.BIN",
 "segments": {
  "0": {
   "jp": "2406ca2712",
   "kr": "니트 할머니"
  },
  "1": {
   "jp": "4d1f03402f",
   "kr": "린도스 할아버지"
  },
  "2": {
   "jp": "d594ba308d",
   "kr": "라틀"
  },
  "3": {
   "jp": "1b0121fd31",
   "kr": "쿨라"
  },
  "4": {
   "jp": "fc4326bc51",
   "kr": "스노"
  },
  "5": {
   "jp": "8e06878ad4",
   "kr": "리오"
  },
  "6": {
   "jp": "23113b40e8",
   "kr": "도구점 주인",
   "auto": 1
  },
  "7": {
   "jp": "c38777be3f",
   "kr": "이 근처는 산바람이 차가워서 말이야."
  },
  "8": {
   "jp": "ea6ad675d8",
   "kr": "여름에도 긴소매 옷을 입지 않으면"
  },
  "9": {
   "jp": "39ebaee293",
   "kr": "감기에 걸릴 정도예요."
  },
  "10": {
   "jp": "888609b716",
   "kr": "오, 무슨 일인고?"
  },
  "11": {
   "jp": "78775f1e4a",
   "kr": "기아의 헤임 씨한테 짐을 맡아 왔어."
  },
  "12": {
   "jp": "2b528e74d3",
   "kr": "글쎄, 헤임이라. 대체 누구일꼬."
  },
  "13": {
   "jp": "5c6e4a5fdb",
   "kr": "니트에게 목도리를 건넸다."
  },
  "14": {
   "jp": "cead615481",
   "kr": "이 더러운 목도리는 뭔고…"
  },
  "15": {
   "jp": "b35452c8a5",
   "kr": "오, 그러고 보니."
  },
  "16": {
   "jp": "af0cc28214",
   "kr": "이건 전에 여기 온 나그네에게 빌려준 것."
  },
  "17": {
   "jp": "f1cf8de63e",
   "kr": "추워 보이는 차림의 젊은이에게 줬었지."
  },
  "18": {
   "jp": "5b2556acb5",
   "kr": "이제 버릴까 하던 물건이라"
  },
  "19": {
   "jp": "a717f86959",
   "kr": "돌려주지 않아도 된다고 했는데…"
  },
  "20": {
   "jp": "241708e4c9",
   "kr": "참 의리 있는 분도 다 있구먼."
  },
  "21": {
   "jp": "6ba0eb9e89",
   "kr": "나는 까맣게 잊고 있었다오."
  },
  "22": {
   "jp": "ad3604c3e1",
   "kr": "모처럼 가져다주었으니"
  },
  "23": {
   "jp": "3fbea0de35",
   "kr": "다시 간직해 두기로 하지요."
  },
  "24": {
   "jp": "9af38fe1ac",
   "kr": "추워 보이는 차림의 나그네가 오면"
  },
  "25": {
   "jp": "ed195ce409",
   "kr": "빌려주기로 하지요."
  },
  "26": {
   "jp": "4daea2cfb0",
   "kr": "젊은이들, 먼 길 오느라 수고했구먼."
  },
  "27": {
   "jp": "953a3b61ef",
   "kr": "무슨 일인가. 어쩐 일인고?"
  },
  "28": {
   "jp": "957d7dc97b",
   "kr": "음."
  },
  "29": {
   "jp": "bef0860568",
   "kr": "오늘도 여전히 춥구먼…"
  },
  "30": {
   "jp": "26557a62ec",
   "kr": "늙은 몸에는 고되구먼."
  },
  "31": {
   "jp": "7d4ad8fab4",
   "kr": "조금만 더 따뜻하면 좋으련만."
  },
  "32": {
   "jp": "fe4a1c0043",
   "kr": "무슨 일인가?"
  },
  "33": {
   "jp": "b7a3d8a025",
   "kr": "바로아의 멜 씨한테 편지를 맡아 왔어."
  },
  "34": {
   "jp": "3ff6060e03",
   "kr": "린도스 씨에게 편지를 건넸다."
  },
  "35": {
   "jp": "003eaf9406",
   "kr": "허허, 이거 참."
  },
  "36": {
   "jp": "43809f0711",
   "kr": "먼 길 고생이 많았구려."
  },
  "37": {
   "jp": "1c731a143b",
   "kr": "정말 고맙소이다."
  },
  "38": {
   "jp": "f3ce6f987f",
   "kr": "멜은 내 귀여운 손녀라오."
  },
  "39": {
   "jp": "a89dc3fac1",
   "kr": "이렇게 편지를 주고받고 있다오."
  },
  "40": {
   "jp": "c6a47a5c01",
   "kr": "이 손녀의 편지가 매번 즐거워서 말이오."
  },
  "41": {
   "jp": "7ebb997eb5",
   "kr": "내가 장수하는 비결은 이 편지일지도 모르겠소."
  },
  "42": {
   "jp": "0f2fe3213d",
   "kr": "허허허."
  },
  "43": {
   "jp": "a5ce79e23e",
   "kr": "뭔가 가져다주었나?"
  },
  "44": {
   "jp": "f6243f5d7e",
   "kr": "아무것도 없는 곳이지?"
  },
  "45": {
   "jp": "58d632738c",
   "kr": "이 마을은 느긋하니까."
  },
  "46": {
   "jp": "64ff8a1a1e",
   "kr": "낙이라고 하면"
  },
  "47": {
   "jp": "0a6f61ed84",
   "kr": "가끔 오는 지인의 소식 정도야."
  },
  "48": {
   "jp": "a99651f933",
   "kr": "참례당은 보셨어요?"
  },
  "49": {
   "jp": "300892c64a",
   "kr": "정말 훌륭하죠."
  },
  "50": {
   "jp": "9ef47817aa",
   "kr": "코르나는 신앙이 두터운 마을이에요."
  },
  "51": {
   "jp": "6ef25bc9d6",
   "kr": "발두스 신이나 오크툼 신처럼"
  },
  "52": {
   "jp": "f6e9216cd8",
   "kr": "유명하지는 않지만요."
  },
  "53": {
   "jp": "152051caed",
   "kr": "둘가 님은 네 정령을 거느릴 정도로"
  },
  "54": {
   "jp": "499c83d9b2",
   "kr": "지위가 높은 신이에요."
  },
  "55": {
   "jp": "027a8820ca",
   "kr": "이 마을에 오면 머리가 맑아지지?"
  },
  "56": {
   "jp": "7ea6511305",
   "kr": "추워서 정신이 바짝 들거든."
  },
  "57": {
   "jp": "38840b43d4",
   "kr": "하지만 너무 먹으면"
  },
  "58": {
   "jp": "35cef0d8f9",
   "kr": "추워도 배는 나오니까 조심하자."
  },
  "59": {
   "jp": "c0c3bebf6e",
   "kr": "이 강에 물고기가 꽤 있어."
  },
  "60": {
   "jp": "1019cb465d",
   "kr": "따뜻한 날엔 헤엄치는 게 보이는데"
  },
  "61": {
   "jp": "1582be7ea4",
   "kr": "오늘은 유난히 추워서"
  },
  "62": {
   "jp": "9b178ca110",
   "kr": "강바닥에서 얌전히 있는 모양이야…"
  },
  "63": {
   "jp": "a0330e4017",
   "kr": "만년설까지는 아니지만"
  },
  "64": {
   "jp": "ab604a3404",
   "kr": "코르나는 일 년 내내 춥잖아."
  },
  "65": {
   "jp": "8c89a51d22",
   "kr": "물고기도 겨울잠을 자려나…"
  }
 }
}
