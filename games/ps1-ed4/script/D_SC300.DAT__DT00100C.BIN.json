 "segments": {
  "0": {
   "jp": "2f35f163e5",
   "kr": "어머? 혹시 알선소에서"
  },
  "1": {
   "jp": "70992d370d",
   "kr": "오신 거예요?"
  },
  "2": {
   "jp": "24d73556cf",
   "kr": "배달 이야기를 듣고 왔는데."
  },
  "3": {
   "jp": "86bae1ce85",
   "kr": "전해 줬으면 하는 건 이 짐이에요."
  },
  "4": {
   "jp": "3a2d2e8ccb",
   "kr": "우리 남편 다니엘이"
  },
  "5": {
   "jp": "c8f1de86eb",
   "kr": "모처럼 만든 도시락을 두고 나가"
  },
  "6": {
   "jp": "3221bb8ab5",
   "kr": "버렸지 뭐예요."
  },
  "7": {
   "jp": "1ac898891f",
   "kr": "다니엘은 여기서 동쪽에 있는"
  },
  "8": {
   "jp": "829c5cd1a8",
   "kr": "은광산으로 갔어요."
  },
  "9": {
   "jp": "234f87ebff",
   "kr": "그 사람이 은광산에 들어가기 전에"
  },
  "10": {
   "jp": "bf091b49b3",
   "kr": "이 도시락을 전해 주었으면 해요."
  },
  "11": {
   "jp": "e63cdf4a88",
   "kr": "마사의 짐을 맡았다."
  },
  "12": {
   "jp": "6767924084",
   "kr": "후후훗."
  },
  "13": {
   "jp": "645d26ed43",
   "kr": "물론 알고 계시겠지만"
  },
  "14": {
   "jp": "1e8532d0c1",
   "kr": "몰래 집어 먹으면 안 돼요."
  },
  "15": {
   "jp": "58cab4da5b",
   "kr": "작은 짐 하나를 날라 주셨으면 해요."
  },
  "16": {
   "jp": "d23b6b9727",
   "kr": "그런데 짐이 가득하신 것 같네요."
  },
  "17": {
   "jp": "6bbfb9092a",
   "kr": "짐을 정리하고 오세요."
  },
  "18": {
   "jp": "4580a58468",
   "kr": "지금 가면 도중 산길쯤에서"
  },
  "19": {
   "jp": "c489d52756",
   "kr": "따라잡을 거예요. 잘 부탁해요."
  },
  "20": {
   "jp": "b7fafe0d66",
   "kr": "편지를 전해 주는군요."
  },
  "21": {
   "jp": "481951b694",
   "kr": "이 편지를 코르나에 있는"
  },
  "22": {
   "jp": "ebceb8e7f2",
   "kr": "내 할아버지 린도스에게 전해 줘."
  },
  "23": {
   "jp": "6e4e5a326b",
   "kr": "코르나의 린도스 씨군. 꼭 전할게."
  },
  "24": {
   "jp": "94cf7dd5bb",
   "kr": "페이의 편지를 맡았다."
  },
  "25": {
   "jp": "abd62f9e93",
   "kr": "그렇게 급한 편지는 아니지만"
  },
  "26": {
   "jp": "d3f2f0ba90",
   "kr": "분명 목이 빠지게 기다릴 거야."
  },
  "27": {
   "jp": "f6145ab689",
   "kr": "부탁해.",
   "auto": 1
  },
  "28": {
   "jp": "938ce558d2",
   "kr": "짐이 가득한 것 같네."
  },
  "29": {
   "jp": "c206f4dbb0",
   "kr": "짐을 정리하고 나서",
   "auto": 1
  },
  "30": {
   "jp": "1ef03a1851",
   "kr": "다시 와 주지 않겠어?"
  },
  "31": {
   "jp": "110d23f477",
   "kr": "전해 줄 곳은"
  },
  "32": {
   "jp": "d5088cebd2",
   "kr": "코르나에 있는 할아버지 린도스야."
  },
  "33": {
   "jp": "f6145ab689",
   "kr": "부탁해.",
   "auto": 1
  },
  "34": {
   "jp": "805534fa86",
   "kr": "제 행복을 날라다 줄 분이군요."
  },
  "35": {
   "jp": "4aef7556b9",
   "kr": "행복…?"
  },
  "36": {
   "jp": "94478b4524",
   "kr": "알선소에서 짐 나르는 일이라고 듣고 왔는데."
  },
  "37": {
   "jp": "7b27ace9e0",
   "kr": "전해 줬으면 하는 건… 이, 거."
  },
  "38": {
   "jp": "0d0fc2578b",
   "kr": "아주 달콤한 향이 나는 꾸러미를 맡았다."
  },
  "39": {
   "jp": "593f225cc7",
   "kr": "기아에 있는 사랑하는 사람 포스터를 위해"
  },
  "40": {
   "jp": "6c969be063",
   "kr": "구운 쿠키예요."
  },
  "41": {
   "jp": "77705dd443",
   "kr": "꺄아 부끄러워, 어쩜 좋아. 몰라～"
  },
  "42": {
   "jp": "276edfc682",
   "kr": "…………",
   "auto": 1
  },
  "43": {
   "jp": "a3858da8d5",
   "kr": "혹시 네가 초원에서 몬스터에게"
  },
  "44": {
   "jp": "b76e1d2235",
   "kr": "잡아먹히는 일이 있더라도…"
  },
  "45": {
   "jp": "b7ed6423d7",
   "kr": "이 쿠키만은 꼭 지켜"
  },
  "46": {
   "jp": "1b9ee97f8c",
   "kr": "줘야 해요. 잘 부탁해요."
  },
  "47": {
   "jp": "58cab4da5b",
   "kr": "작은 짐 하나를 날라 줬으면 해요."
  },
  "48": {
   "jp": "ac0479dd7c",
   "kr": "그런데 짐이 가득하지 않아요?"
  },
  "49": {
   "jp": "790f3956c2",
   "kr": "짐을 정리하고 나서 다시 와 줘요."
  },
  "50": {
   "jp": "5a466e2ed3",
   "kr": "있잖아요."
  },
  "51": {
   "jp": "d395a395e6",
   "kr": "전할 곳은 기아의 포스터예요."
  },
  "52": {
   "jp": "7fef889121",
   "kr": "잊지 마세요."
  }
 }
