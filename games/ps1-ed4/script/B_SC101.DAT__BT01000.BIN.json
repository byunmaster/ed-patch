  },
  "24": {
   "jp": "81f395be89",
   "kr": "마법 길드원",
   "auto": 1
  },
  "25": {
   "jp": "2adc3f6e02",
   "kr": "여행하시는 분이시군요."
  },
  "26": {
   "jp": "e2a1a5aacd",
   "kr": "자, 피로를 푸세요."
  },
  "27": {
   "jp": "3c680c990f",
   "kr": "그러고 보니 저 구석에 있던 손님은"
  },
  "28": {
   "jp": "c228de25d8",
   "kr": "어느새 사라졌네요."
  },
  "29": {
   "jp": "8be2530a3b",
   "kr": "손님, 여행하시는 분이시죠."
  },
  "30": {
   "jp": "e2a1a5aacd",
   "kr": "자, 피로를 푸세요."
  },
  "31": {
   "jp": "90717ce91f",
   "kr": "당신도 모험가인가요?"
  },
  "32": {
   "jp": "62ec349f97",
   "kr": "큰 소리로는 말 못 하지만"
  },
  "33": {
   "jp": "50808aea52",
   "kr": "왕성의 병사보다 모험가 쪽이"
  },
  "34": {
   "jp": "cb89cdce69",
   "kr": "훨씬 믿음직하죠."
  },
  "35": {
   "jp": "99bab1be8a",
   "kr": "곤란해, 이런 데까지 들어오면."
  },
  "36": {
   "jp": "71bc947b89",
   "kr": "나한테 묻고 싶은 게 있어?"
  },
  "37": {
   "jp": "8304bf9a89",
   "kr": "모험가 정보",
   "auto": 1
  },
  "38": {
   "jp": "a29585b603",
   "kr": "비밀 정보",
   "auto": 1
  },
  "39": {
   "jp": "6ff9e4dcff",
   "kr": "잘 가라."
  },
  "40": {
   "jp": "2ff57fa65e",
   "kr": "동 ",
   "auto": 1
  },
  "41": {
   "jp": "7d5dcd98ce",
   "kr": "부크 ",
   "auto": 1
  },
  "42": {
   "jp": "7722745105",
   "kr": "…",
   "auto": 1
  },
  "43": {
   "jp": "e0fcacb5ae",
   "kr": "서 "
  },
  "44": {
   "jp": "2c1db82ba8",
   "kr": "어빈은 엄청난 살기를 느꼈다."
  },
  "45": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "46": {
   "jp": "b6476776fc",
   "kr": "뭐, 뭐야. 방금 그건…"
  },
  "47": {
   "jp": "b960077c82",
   "kr": "저런 걸 엄청난 살기라고 하는 걸까."
  },
  "48": {
   "jp": "fcec4b18e2",
   "kr": "등골이 얼어붙을 뻔했어."
  },
  "49": {
   "jp": "8423b928ac",
   "kr": "누구지…?"
  },
  "50": {
   "jp": "54ce83558b",
   "kr": "수도원을 습격한 놈들의 동료가…"
  },
  "51": {
   "jp": "c2efd91451",
   "kr": "설마… 수도원을 습격한 뒤에"
  },
  "52": {
   "jp": "13e065622c",
   "kr": "이런 곳을 유유히 걷고 있진 않겠지."
  },
  "53": {
   "jp": "8c7b2d972e",
   "kr": "게다가 수도원을 습격한 건 승병이고"
  },
  "54": {
   "jp": "78599a621f",
   "kr": "그놈들을 지휘한 건 볼게이드야."
  },
  "55": {
   "jp": "dc595dc37b",
   "kr": "방금 건 외톨이 늑대 같은 느낌이었어."
  },
  "56": {
   "jp": "57d404bab2",
   "kr": "듣고 보니 그러네."
  },
  "57": {
   "jp": "c56eea6937",
   "kr": "어느 쪽이든"
  },
  "58": {
   "jp": "74ce4052e8",
   "kr": "저런 것과는 엮이고 싶지 않아."
  },
  "59": {
   "jp": "0bca348c09",
   "kr": "자, 서두르자."
  },
  "60": {
   "jp": "354b1526a2",
   "kr": "섀넌은 조용히 숨을 쉬며 자고 있다."
  },
  "61": {
   "jp": "33f7e78743",
   "kr": "이런 이런, 여행하시는 분이구먼."
  },
  "62": {
   "jp": "057e83ab0f",
   "kr": "젊을 때는 나도 여행을 자주 했다오."
  },
  "63": {
   "jp": "580a4468a1",
   "kr": "이제 먼 추억이지."
  },
  "64": {
   "jp": "63864b55dc",
   "kr": "걱정이구먼."
  },
  "65": {
   "jp": "ba8926169f",
   "kr": "은(는) 마을 북쪽에 있다오."
  },
  "66": {
   "jp": "814dde30f8",
   "kr": "부디 아가씨를 찾아 주시게."
  },
  "67": {
   "jp": "054ece5041",
   "kr": "몸조심하게나."
  },
  "68": {
   "jp": "87b80de06e",
   "kr": "또 근처에 올 일이 있으면"
  },
  "69": {
   "jp": "ddc93df536",
   "kr": "들러 주시게."
  },
  "70": {
   "jp": "9017810e06",
   "kr": "응? 자네는…"
  },
  "71": {
   "jp": "0ad6257fc5",
   "kr": "기억하고 있다네."
  },
  "72": {
   "jp": "f403f2ad88",
   "kr": "잘 들러 주었네."
  },
  "73": {
   "jp": "94c23846fa",
   "kr": "그때의 아가씨라면"
  },
  "74": {
   "jp": "401d9468f7",
   "kr": "그 뒤에도 여행을 계속하겠다며"
  },
  "75": {
   "jp": "dfe207c1f2",
   "kr": "씩씩하게 떠났지."
  },
  "76": {
   "jp": "11b2e84fa4",
   "kr": "어쩌면 아가씨와"
  },
  "77": {
   "jp": "85a447ea78",
   "kr": "여행지에서 또 만날지도 모르겠군."
  },
  "78": {
   "jp": "20e56ab016",
   "kr": "혹시 벌써 만났으려나."
  },
  "79": {
   "jp": "00b1a120d5",
   "kr": "어쨌든 아가씨에게는"
  },
  "80": {
   "jp": "443da3a57c",
   "kr": "운명의 여신이 붙어 있는 듯하니"
  },
  "81": {
   "jp": "c26d358049",
   "kr": "분명 또 만나게 될 걸세."
  },
  "82": {
   "jp": "00b4be3074",
   "kr": "아는 사람이 느는 건 좋은 일이지."
  },
  "83": {
   "jp": "5ea04d1a5f",
   "kr": "나이를 먹으면"
  },
  "84": {
   "jp": "cd57703580",
   "kr": "더욱 그렇지…"
  },
  "85": {
   "jp": "b7bb0462b0",
   "kr": "친구를 소중히 하시게."
  },
  "86": {
   "jp": "5347a0b0f4",
   "kr": "할아버지도 옛날에는 모험가였답니다."
  },
  "87": {
   "jp": "9faae1b859",
   "kr": "그야말로 멋졌다니까요."
  },
  "88": {
   "jp": "6deea10f91",
   "kr": "숲 안쪽은 길을 잃기 쉽고"
  },
  "89": {
   "jp": "0c464154ee",
   "kr": "마수도 나오니까 안쪽으로는 가지 말라고"
  },
  "90": {
   "jp": "ecae650c53",
   "kr": "말했는데 말이에요."
  },
  "91": {
   "jp": "57bc5e9fa4",
   "kr": "아가씨를 보내는 게 아니었어."
  },
  "92": {
   "jp": "332912074e",
   "kr": "아가씨라면 걱정 마세요."
  },
  "93": {
   "jp": "ba477eba27",
   "kr": "집에 돌아가라고 말해 둘게요."
  },
  "94": {
   "jp": "15502233a4",
   "kr": "어머나,"
  },
  "95": {
   "jp": "fa7f5d4415",
   "kr": "잘 들러 주셨네요."
  },
  "96": {
   "jp": "ca016781dd",
   "kr": "아가씨에게는"
  },
  "97": {
   "jp": "0e4deac1dc",
   "kr": "집에 돌아가라고 했는데"
  },
  "98": {
   "jp": "2e888950b4",
   "kr": "사랑하는 마음은 막을 수 없었나 봐요."
  },
  "99": {
   "jp": "92a432c687",
   "kr": "아가씨,"
  },
  "100": {
   "jp": "b9372ce9f9",
   "kr": "지금쯤 어떻게 지낼까요."
  },
  "101": {
   "jp": "8cf9335094",
   "kr": "피트 동굴에는 바람 정령의 보물이 있대요."
  },
  "102": {
   "jp": "331732f0f7",
   "kr": "하지만 거대한 오징어 떼에 가로막혀서"
  },
  "103": {
   "jp": "e36a85c22b",
   "kr": "아무도 손을 못 대고 있어요."
  },
  "104": {
   "jp": "7fb87518b0",
   "kr": "모험가는 멋있어."
  },
  "105": {
   "jp": "8b2eede650",
   "kr": "강하고 다정하고 여자애 부탁이라면"
  },
  "106": {
   "jp": "cb78519b34",
   "kr": "뭐든 들어줄 것 같아."
  },
  "107": {
   "jp": "162b9e0b37",
   "kr": "가든힐 쪽으로는 가지 않는 게 좋아."
  },
  "108": {
   "jp": "1712433c75",
   "kr": "라켈타 용이라는 굉장한 마수가 나와."
  },
  "109": {
   "jp": "5a4feed735",
   "kr": "마을 밖은 마수와 도적이 나와서 힘든가 봐."
  },
  "110": {
   "jp": "1635fbeb01",
   "kr": "여러분 같은 모험가는"
  },
  "111": {
   "jp": "ffbd24be1e",
   "kr": "엄청 바쁘겠죠."
  },
  "112": {
   "jp": "852398bec7",
   "kr": "니키타는 귀여운 컬리가 있어서 좋겠다."
  },
  "113": {
   "jp": "45b7d1f191",
   "kr": "나도 지지 않고 뭔가 키워 볼까."
  },
  "114": {
   "jp": "5c04b91cb2",
   "kr": "컬리를 찾아 줘서 고마워."
  },
  "115": {
   "jp": "109c79c2e7",
   "kr": "컬리는 하얗고 작은 새끼 고양이야."
  },
  "116": {
   "jp": "528450fb85",
   "kr": "꼭 찾아 줘."
  },
  "117": {
   "jp": "395a726eac",
   "kr": "내 고양이 컬리는 끝내 돌아오지 않았어."
  },
  "118": {
   "jp": "a8bfd32935",
   "kr": "쓸쓸해."
  },
  "119": {
   "jp": "92af965ee5",
   "kr": "저기, 내 컬리 못 봤어?"
  },
  "120": {
   "jp": "109c79c2e7",
   "kr": "컬리는 하얗고 작은 새끼 고양이야."
  },
  "121": {
   "jp": "b0d9303c4f",
   "kr": "그르릉, 야옹."
  },
  "122": {
   "jp": "d715afc5a6",
   "kr": "이 새끼 고양이는 컬리가 아닌 것 같다."
  },
  "123": {
   "jp": "70bda8d6dc",
   "kr": "냥."
  },
  "124": {
   "jp": "d715afc5a6",
   "kr": "이 새끼 고양이는 컬리가 아닌 것 같다."
  },
  "125": {
   "jp": "0527cec8e5",
   "kr": "하악!"
  },
  "126": {
   "jp": "d715afc5a6",
   "kr": "이 새끼 고양이는 컬리가 아닌 것 같다."
  },
  "127": {
   "jp": "5a341bc8da",
   "kr": "야옹."
  },
  "128": {
   "jp": "b0d9303c4f",
   "kr": "그르릉, 야옹."
  },
  "129": {
   "jp": "fb07450987",
   "kr": "시간이 흘러가는 것은 끝없이…"
  },
  "130": {
   "jp": "5d5f9eb6b1",
   "kr": "사람은 늙고서야 그 흐름이 얼마나 빠른지"
  },
  "131": {
   "jp": "481e91e0bb",
   "kr": "아는 법이지. 하아."
  },
  "132": {
   "jp": "0b39d9a670",
   "kr": "오오, 잘 오셨소."
  },
  "133": {
   "jp": "c68892af15",
   "kr": "여행하는 분, 어서 편히 쉬시게."
  },
  "134": {
   "jp": "2ca781c7d7",
   "kr": "그 뒤로 보른의 베키가"
  },
  "135": {
   "jp": "740d53af3a",
   "kr": "이곳을 찾아와 주었네."
  },
  "136": {
   "jp": "9f4a7a7f57",
   "kr": "정신 차리라며 혼이"
  },
  "137": {
   "jp": "f9ba5f8c3f",
   "kr": "나고 말았지. 호호호."
  },
  "138": {
   "jp": "c68892af15",
   "kr": "여행하는 분, 어서 편히 쉬시게."
  },
  "139": {
   "jp": "e1522f43a7",
   "kr": "…중얼중얼."
  },
  "140": {
   "jp": "125499111e",
   "kr": "여기까진 괜찮아… 그래. 괜찮아."
  },
  "141": {
   "jp": "aeed7b3420",
   "kr": "발크드까지는 어떻게 하지."
  },
  "142": {
   "jp": "b96c0489cf",
   "kr": "그래! 알선소야… 중얼중얼."
  },
  "143": {
   "jp": "88e3e894ef",
   "kr": "짐은 제대로 전해 줬겠지?"
  },
  "144": {
   "jp": "6bd00d98a2",
   "kr": "뭐 좋아. 남에게 말하면 안 돼… 중얼중얼."
  },
  "145": {
   "jp": "d6f6611217",
   "kr": "그 술맛은 평소 마시던 술맛과"
  },
  "146": {
   "jp": "016a7244fc",
   "kr": "다르지 않았어… 어째서지?"
  },
  "147": {
   "jp": "d7c5ac97ca",
   "kr": "하지만… 아니."
  },
  "148": {
   "jp": "1ebf46d56d",
   "kr": "분명 그럴 거야… 중얼중얼."
  },
  "149": {
   "jp": "250b6e3f09",
   "kr": "콜록콜록."
  },
  "150": {
   "jp": "8a81416736",
   "kr": "…가야 해. 기다려 줘, 형."
  },
  "151": {
   "jp": "a198edb9bc",
   "kr": "바로아의 술집까지…"
  },
  "152": {
   "jp": "5ad82816de",
   "kr": "기다려 줘, 형."
  },
  "153": {
   "jp": "38fa55ccaf",
   "kr": "…콜록콜록."
  },
  "154": {
   "jp": "6a04047101",
   "kr": "바로아까지……"
  },
  "155": {
   "jp": "af2196eb34",
   "kr": "…누가 바로아까지."
  },
  "156": {
   "jp": "edeb5aca71",
   "kr": "아. 좀 멋있을지도."
  },
  "157": {
   "jp": "5a495e1f20",
   "kr": "저기요, 어디서 오셨어요?"
  },
  "158": {
   "jp": "37eb270ca6",
   "kr": "다음에 여행 이야기 좀 들려주지 않을래요?"
  },
  "159": {
   "jp": "503341f55e",
   "kr": "저는 지나라고 해요."
  },
  "160": {
   "jp": "0710155c82",
   "kr": "언제든 말 걸어 주세요. 후훗."
  },
  "161": {
   "jp": "57ea2305a6",
   "kr": "조심해서 여행을 계속해."
  },
  "162": {
   "jp": "d59779bd88",
   "kr": "수취인은 가든힐의 로이만 씨일세."
  },
  "163": {
   "jp": "68344b7c37",
   "kr": "소중하고, 소중하고, 아주아주 소중한 상품이니 말이야."
  },
  "164": {
   "jp": "efca87652f",
   "kr": "아무래도 상품은 되찾은 모양이군."
  },
  "165": {
   "jp": "d5ac916cfa",
   "kr": "얼른 로이만 씨에게 전해 주고 와."
  },
  "166": {
   "jp": "3ab5621025",
   "kr": "이번엔 빼앗기지 않게 해."
  },
  "167": {
   "jp": "bb855739a1",
   "kr": "어이 어이, 뭘 하고 있나, 자네는."
  },
  "168": {
   "jp": "2fa68679d4",
   "kr": "로이만 씨한테서 독촉이 왔다네."
  },
  "169": {
   "jp": "9ae43ba1d8",
   "kr": "아니, 그게 사실은…"
  },
  "170": {
   "jp": "e19094ed1e",
   "kr": "어빈은 상품을 빼앗긴 일을 이야기했다."
  },
  "171": {
   "jp": "2634fd3066",
   "kr": "뭐, 뭐, 뭐라고!"
  },
  "172": {
   "jp": "42b74b21aa",
   "kr": "상품을 빼앗겼다고!?"
  },
  "173": {
   "jp": "f4c13dab9d",
   "kr": "으음… ２２０１６로제…"
  },
  "174": {
   "jp": "6a6ae5153a",
   "kr": "죄송합니다."
  },
  "175": {
   "jp": "b3fced29b8",
   "kr": "하지만 꼭 되찾겠습니다."
  },
  "176": {
   "jp": "5d5eca3984",
   "kr": "당연하지!!"
  },
  "177": {
   "jp": "ef59f249da",
   "kr": "얼른얼른 되찾아서"
  },
  "178": {
   "jp": "b9ad546b99",
   "kr": "똑바로 로이만 씨에게 전해야 한다!!"
  },
  "179": {
   "jp": "3353f63732",
   "kr": "빨리 다녀와!!!"
  },
  "180": {
   "jp": "92fb872100",
   "kr": "얼른 안 가고 뭐 해!!"
  },
  "181": {
   "jp": "ad065095fe",
   "kr": "…이대로 상품을 못 되찾으면"
  },
  "182": {
   "jp": "c6282c6cdf",
   "kr": "２２０１６로제, 자네한테 받아 내겠어."
  },
  "183": {
   "jp": "50a96e0ecf",
   "kr": "빚은 샴실단보다 무서운 법이야!!"
  },
  "184": {
   "jp": "1502fa72b5",
   "kr": "자네들이 의뢰를 맡아 줬나."
  },
  "185": {
   "jp": "404cd03c4d",
   "kr": "검 쪽은 강하겠지?"
  },
  "186": {
   "jp": "aa76d65645",
   "kr": "아니면 굉장한 마법을 쓸 줄 아나?"
  },
  "187": {
   "jp": "6074ff89a3",
   "kr": "오, 오, 오, 어빈 아닌가."
  },
  "188": {
   "jp": "a828013577",
   "kr": "자네라면 뭐, 안심이지."
  },
  "189": {
   "jp": "b6fa2a38d4",
   "kr": "큰돈을 내는 일이니까."
  },
  "190": {
   "jp": "2473a96033",
   "kr": "절대, 절대, 절대 실수가 있으면 곤란해."
  },
  "191": {
   "jp": "68344b7c37",
   "kr": "소중하고, 소중하고, 아주아주 소중한 상품이니 말이야."
  },
  "192": {
   "jp": "3b9e9e1a97",
   "kr": "２２０１６로제나 한다고."
  },
  "193": {
   "jp": "384b2ffd92",
   "kr": "만에 하나, 만만에 하나라도"
  },
  "194": {
   "jp": "a04ca8ac68",
   "kr": "빼앗기는 일이 있어서는 안 돼."
  },
  "195": {
   "jp": "5982df9d6b",
   "kr": "알겠나?"
  },
  "196": {
   "jp": "5ea5086cf1",
   "kr": "수취인은 가든힐의 로이만 씨일세."
  },
  "197": {
   "jp": "b8b9930f5a",
   "kr": "확실히 부탁하네."
  },
  "198": {
   "jp": "9dc4a8e7ff",
   "kr": "가르시아의 상품을 맡았다."
  },
  "199": {
   "jp": "5016bed550",
   "kr": "뭐야, 뭐야, 뭐야."
  },
  "200": {
   "jp": "b79ce82031",
   "kr": "그렇게 짐이 많아서 무슨 일을 하겠나."
  },
  "201": {
   "jp": "c8b5f007a0",
   "kr": "줄여서 다시 와."
  },
  "202": {
   "jp": "6d2dcb09b0",
   "kr": "보른에서 ５０００로제, 도크스에서 １００００로제…"
  },
  "203": {
   "jp": "e50cfebd45",
   "kr": "이번 달은 아직 벌이가 모자라군…"
  },
  "204": {
   "jp": "20100580c1",
   "kr": "내 고양이 컬리는"
  },
  "205": {
   "jp": "ad0e930574",
   "kr": "끝내 돌아오지 않았어."
  }
 }
}
