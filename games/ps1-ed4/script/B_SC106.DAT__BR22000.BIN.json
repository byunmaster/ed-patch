  "31": {
   "jp": "7f3c14beb3",
   "kr": "어빈 군 아닌가!"
  },
  "32": {
   "jp": "8b1af9c1e3",
   "kr": "오랜만이야."
  },
  "33": {
   "jp": "98f1396304",
   "kr": "앤디!"
  },
  "34": {
   "jp": "a663ab2f17",
   "kr": "당신, 인질로 잡혀 있었던 거 아니었어…"
