  "18": {
   "jp": "d23501ccb5",
   "kr": "흥."
  },
  "19": {
   "jp": "dc6e9a1ddb",
   "kr": "그럼 같이 따라와라."
  },
  "20": {
   "jp": "9826e4ce14",
   "kr": "애송이는 안쪽에서 쿨쿨 자고 있으니까."
  },
  "21": {
   "jp": "7b293fcabc",
   "kr": "메고 가면 되지."
  },
  "22": {
   "jp": "c0e44e86a4",
   "kr": "말해 두는데, 수상한 마음은 먹지 마라."
  },
  "23": {
   "jp": "8995bb5a95",
   "kr": "우리는 인원이 많으니까."
  },
  "24": {
   "jp": "326a9143d5",
   "kr": "섣불리 날뛰면 네놈들도 목숨을 잃게 될 거다."
  },
  "25": {
   "jp": "016ecece98",
   "kr": "뭐야, 네놈들은."
  },
  "26": {
   "jp": "038d5a3492",
   "kr": "여기가 샴실단 아지트인 줄 알고 왔냐?"
  },
  "27": {
   "jp": "1fec71d9ce",
   "kr": "다치기 싫으면 썩 꺼져!"
