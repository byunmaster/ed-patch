 "segments": {
  "0": {
   "jp": "a46b791597",
   "kr": "사신관의 목소리"
  },
  "1": {
   "jp": "1e195f6292",
   "kr": "섀넌",
   "auto": 1
  },
  "2": {
   "jp": "921766275e",
   "kr": "베리어스 경",
   "auto": 1
  },
  "3": {
   "jp": "0a1f8821d4",
   "kr": "호오…?"
  },
  "4": {
   "jp": "009a8451db",
   "kr": "기념할 만한 순간을 보고 싶어서"
  },
  "5": {
   "jp": "26e2c78b47",
   "kr": "와 준 것이냐?"
  },
  "6": {
   "jp": "c7082884f4",
   "kr": "이제 너희 덕분에 네 정령의 봉인은 약해졌고,"
  },
  "7": {
   "jp": "3d32b0ff8a",
   "kr": "둘가의 힘도 우리 오크툼 신도의 손에 떨어졌다."
  },
  "8": {
   "jp": "c3ac189b99",
   "kr": "저주받은 둘가를 길들이고"
  },
  "9": {
   "jp": "cc02121c1a",
   "kr": "드디어 오크툼 신을 저승 밑바닥에서"
  },
  "10": {
   "jp": "6962be5646",
   "kr": "불러내려는 참이지."
  },
  "11": {
   "jp": "f2b9b4048a",
   "kr": "보아라!!"
  },
  "12": {
   "jp": "458b6692d6",
   "kr": "하늘을 날아 달려오는, 명계신 둘가의 모습을!"
  },
  "13": {
   "jp": "5b7a2e767e",
   "kr": "명계신 둘가여!"
  },
  "14": {
   "jp": "ea196f39d6",
   "kr": "이제 오크툼을 속박하던 봉인은 풀렸다!"
  },
  "15": {
   "jp": "e71446eea7",
   "kr": "명부의 문을 열고"
  },
  "16": {
   "jp": "c253322e52",
   "kr": "오크툼을 이 세상에 불러내라!"
  },
  "17": {
   "jp": "bd8d0a9baa",
   "kr": "이로써 둘가가 오크툼 신을 부활시킬 것이다."
  },
  "18": {
   "jp": "1798247599",
   "kr": "수고했다."
  },
  "19": {
   "jp": "2911ae0dae",
   "kr": "너희에게는 감사의 말도 모자라군."
  },
  "20": {
   "jp": "25ebbd6369",
   "kr": "크윽…"
  },
  "21": {
   "jp": "9c9e14dc0b",
   "kr": "이런… 움직이지 마라."
  },
  "22": {
   "jp": "fadc6615b7",
   "kr": "얌전히 여기서 오크툼 신의 부활을"
  },
  "23": {
   "jp": "6e7e31543b",
   "kr": "지켜봐 줘야겠다."
  },
  "24": {
   "jp": "f38f47b310",
   "kr": "너희의 처분은 나중에 천천히 정해 주마."
  },
  "25": {
   "jp": "5c57a91814",
   "kr": "우리는 이제 오크툼 신을 맞이하기 위해"
  },
  "26": {
   "jp": "aef538eb05",
   "kr": "마지막 의식을 치러야 한다."
  },
  "27": {
   "jp": "fd739315ea",
   "kr": "여기서 기다려 줘야겠다."
  },
  "28": {
   "jp": "597be6eae8",
   "kr": "허튼 생각은 하지 마라. 저기를 보아라."
  },
  "29": {
   "jp": "4dc38e8af5",
   "kr": "헉…?!"
  },
  "30": {
   "jp": "56270c0e3e",
   "kr": "마… 마일!!"
  },
  "31": {
   "jp": "240a38b10a",
   "kr": "섀넌!"
  },
  "32": {
   "jp": "40a82c3e23",
   "kr": "살아 있었구나…"
  },
  "33": {
   "jp": "c090e903f0",
   "kr": "어빈 님…"
  },
  "34": {
   "jp": "78c165547b",
   "kr": "마일이라는 자는 분명 한 번 죽었다."
  },
  "35": {
   "jp": "98ba1f3c9b",
   "kr": "볼게이드의 습격으로 너희가 기절해 있을 때,"
  },
  "36": {
   "jp": "0a2bb98219",
   "kr": "내가 섀넌에게 계약을 제안했지."
  },
  "37": {
   "jp": "ab078bf9c2",
   "kr": "마일의 혼을 오크툼 신에게 바친다면"
  },
  "38": {
   "jp": "ccbdaba0ad",
   "kr": "되살릴 수도 있다고 말이다."
  },
  "39": {
   "jp": "9f072ff61b",
   "kr": "그 아이는 망설이지 않았다."
  },
  "40": {
   "jp": "f9fb4d3844",
   "kr": "마일을 되살릴 유일한 방법이었으니까."
  },
  "41": {
   "jp": "c4abb59067",
   "kr": "오히려 내가 부탁받았다고 해도 좋다."
  },
  "42": {
   "jp": "c1afbd2f16",
   "kr": "마일은 혼이 빠져나간 듯 미소 짓고 있다."
  },
  "43": {
   "jp": "e26ad5fd10",
   "kr": "어빈 님… 미안해…"
  },
  "44": {
   "jp": "c5d5c712a5",
   "kr": "섀넌은… 섀넌은…"
  },
  "45": {
   "jp": "2b00818c84",
   "kr": "그래, 살아는 있지만 혼은 오크툼 신의 것이다."
  },
  "46": {
   "jp": "4c8e6d614c",
   "kr": "그에게는 살아 있는 인간의 의식이 없다."
  },
  "47": {
   "jp": "c8abe41a48",
   "kr": "너무해…"
  },
  "48": {
   "jp": "6dcca4e8f4",
   "kr": "그런 말은 너무하군. 나는 부탁받았을 뿐이다."
  },
  "49": {
   "jp": "36398029f7",
   "kr": "후후후후…"
  },
  "50": {
   "jp": "c0f4606d07",
   "kr": "어빈!",
   "auto": 1
  },
  "51": {
   "jp": "67a4fc97a0",
   "kr": "마일과 섀넌이 인질로 잡혀 있어서는"
  },
  "52": {
   "jp": "8bc1b11fda",
   "kr": "마음껏 싸울 수 없어!"
  },
  "53": {
   "jp": "18b481f7f1",
   "kr": "하지만 이제 시간이 없어!"
  },
  "54": {
   "jp": "4e0c03785a",
   "kr": "여기서 허무하게 죽으라는 거냐!"
  },
  "55": {
   "jp": "5613c8462c",
   "kr": "어빈 씨, 걱정 마세요."
  },
  "56": {
   "jp": "e71bc35b97",
   "kr": "응…?"
  },
  "57": {
   "jp": "8212b174a5",
   "kr": "실례."
  },
  "58": {
   "jp": "a634160cbd",
   "kr": "미첼 씨?!"
  },
  "59": {
   "jp": "bd077c6c15",
   "kr": "이제 괜찮아요. 마음껏 싸우세요."
  },
  "60": {
   "jp": "5d9a295e66",
   "kr": "어째서 미첼 씨가 여기에?"
  },
  "61": {
   "jp": "3a196091f8",
   "kr": "일에 끼어든 이상 책임이 있으니까요."
  },
  "62": {
   "jp": "ff812deadb",
   "kr": "모른 척하고 있을 수는 없지요."
  },
  "63": {
   "jp": "a9efdd344e",
   "kr": "여러분께 방해가 되지 않게 조사하고 있었어요."
  },
  "64": {
   "jp": "21aeee2c1b",
   "kr": "마일 씨와 섀넌 씨는 제가 맡겠습니다."
  },
  "65": {
   "jp": "c3d751689b",
   "kr": "자, 베리어스 경을 쫓아가세요."
  },
  "66": {
   "jp": "a606c63b47",
   "kr": "어빈 님… 미안해."
  },
  "67": {
   "jp": "5cebb714d7",
   "kr": "섀넌은… 마일 님이…"
  },
  "68": {
   "jp": "076198675a",
   "kr": "더 살아 줬으면 했으니까…"
  },
  "69": {
   "jp": "d74f5f9e49",
   "kr": "섀넌…"
  },
  "70": {
   "jp": "3a4dd108c2",
   "kr": "하지만 마일 님은…"
  },
  "71": {
   "jp": "2563b7d0c8",
   "kr": "마일 님은…"
  },
  "72": {
   "jp": "cc7178f7ea",
   "kr": "마일은 혼이 빠져나간 듯 미소 지을 뿐이다."
  },
  "73": {
   "jp": "c1d2f2b908",
   "kr": "기절해 있는 것 같다."
  },
  "74": {
   "jp": "121d021810",
   "kr": "둘가의 힘도"
  },
  "75": {
   "jp": "ed8b7c3466",
   "kr": "우리 오크툼 신도의 손에 떨어졌다."
  }
 }
