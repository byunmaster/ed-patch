{
 "archive": "/E/SC401.DAT",
 "member": "..\\BIN\\ET02200D.BIN",
 "segments": {
  "0": {
   "jp": "01be4b89f9",
   "kr": "전이문 문을 여는 열쇠는"
  },
  "1": {
   "jp": "0862073b8c",
   "kr": "지하에 있는 파수 신관에게 받게."
  },
  "2": {
   "jp": "676a90d7c9",
   "kr": "어빈은 루티스의 저주를 풀기 위해"
  },
  "3": {
   "jp": "54b3447f26",
   "kr": "진실의 섬으로 향할 것을 알렸다."
  },
  "4": {
   "jp": "27e0e87db2",
   "kr": "그렇군. 그게 좋겠네."
  },
  "5": {
   "jp": "69e28d2d05",
   "kr": "미첼 공도 함께 가 주시는 건가."
  },
  "6": {
   "jp": "75d6ec5452",
   "kr": "든든하군."
  },
  "7": {
   "jp": "31df4b8051",
   "kr": "사람 목숨의 존귀함에"
  },
  "8": {
   "jp": "480b5e7313",
   "kr": "오크툼 신도, 발두스 신도가 따로 없소."
  },
  "9": {
   "jp": "f09ac06785",
   "kr": "부디 부탁하오."
  },
  "10": {
   "jp": "31df4b8051",
   "kr": "사람 목숨의 존귀함에"
  },
  "11": {
   "jp": "480b5e7313",
   "kr": "오크툼 신도도 발두스 신도도 없소."
  },
  "12": {
   "jp": "f09ac06785",
   "kr": "부디 부탁하오."
  },
  "13": {
   "jp": "a10c06e81d",
   "kr": "오, 어빈.",
   "auto": 1
  },
  "14": {
   "jp": "629e831bb1",
   "kr": "루티스도 완전히 좋아진 모양이군."
  },
  "15": {
   "jp": "b5980b97cc",
   "kr": "어빈은 진실의 섬에서 본 풍경을 찾아"
  },
  "16": {
   "jp": "7c071cb99f",
   "kr": "여행을 떠날 것을 크로웰에게 알렸다."
  },
  "17": {
   "jp": "11b0244d00",
   "kr": "진실의 섬에서 받은 계시를 확인하는 여행인가."
  },
  "18": {
   "jp": "bb074824b1",
   "kr": "음… 나도 찬성일세."
  },
  "19": {
   "jp": "e863b41e4e",
   "kr": "실은 나도 그것을 권하려던 참이었네."
  },
  "20": {
   "jp": "1ca33a4dc1",
   "kr": "아, 그렇지. 좋은 소식도 있네."
  },
  "21": {
   "jp": "05dce42341",
   "kr": "발크드의 오래된 문헌을 조사하다 보니"
  },
  "22": {
   "jp": "801a4dd481",
   "kr": "이 신전 지하에 전이문이라 불리는 특수한 이동 장치가"
  },
  "23": {
   "jp": "edfa4079ea",
   "kr": "설치되어 있다는 것을 알았네."
  },
  "24": {
   "jp": "86218161d8",
   "kr": "전이문을 쓰면 순식간에 이동할 수 있네."
  },
  "25": {
   "jp": "fb9f5e8dd1",
   "kr": "…라고는 해도"
  },
  "26": {
   "jp": "2ff56a40b3",
   "kr": "그 장치가 설치된 발크드, 바로아,"
  },
  "27": {
   "jp": "9b6305f966",
   "kr": "필딘에 한해서지만."
  },
  "28": {
   "jp": "c0a6607a64",
   "kr": "전이문을 효과적으로 활용하면"
  },
  "29": {
   "jp": "8be25c5a8a",
   "kr": "세계를 도는 긴 여행도 어느 정도는 편해질 걸세."
  },
  "30": {
   "jp": "01be4b89f9",
   "kr": "전이문 문을 여는 열쇠는"
  },
  "31": {
   "jp": "0862073b8c",
   "kr": "지하에 있는 파수 신관에게 받게."
  },
  "32": {
   "jp": "343bce9ffa",
   "kr": "감사합니다.",
   "auto": 1
  },
  "33": {
   "jp": "31b00eb516",
   "kr": "…그래."
  },
  "34": {
   "jp": "66f53b07fb",
   "kr": "얼마 안 되지만 노잣돈에 보태게."
  },
  "35": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "36": {
   "jp": "b27b3bd263",
   "kr": "을(를) 받았다."
  },
  "37": {
   "jp": "3a48368959",
   "kr": "조심해서 가게."
  },
  "38": {
   "jp": "6efb96b12f",
   "kr": "가끔은 내게도 얼굴을 보여 주게."
  },
  "39": {
   "jp": "258c707418",
   "kr": "진실의 섬에서 본 영상을 확인하려면"
  },
  "40": {
   "jp": "1a2a43e452",
   "kr": "네 정령 말고도 가 보는 편이 좋을 곳이 있네."
  },
  "41": {
   "jp": "2ec2d6ad6e",
   "kr": "코르나 마을의 둘가 신앙은 알고 있나?"
  },
  "42": {
   "jp": "4b0256261d",
   "kr": "둘가는 네 정령을 거느리는 존재일세."
  },
  "43": {
   "jp": "f5320015bc",
   "kr": "코르나 마을 북쪽에 고대부터 둘가 신을 기리는"
  },
  "44": {
   "jp": "d647da9042",
   "kr": "얼음 신전이 있다고 들었네."
  },
  "45": {
   "jp": "bf59dada7c",
   "kr": "찾아가 보면 단서가 있을지도 모르네…"
  },
  "46": {
   "jp": "87e50b7e0e",
   "kr": "어떤가, 어빈. 진전은 있었는가?"
  },
  "47": {
   "jp": "8a46101bb0",
   "kr": "유감이지만 가웨인 공에게서는 아직 연락이 없네."
  },
  "48": {
   "jp": "7cd3e653d1",
   "kr": "그렇군요."
  },
  "49": {
   "jp": "ffa2b17071",
   "kr": "진실의 섬에서 본 영상 중 아직 확인하지 않은"
  },
  "50": {
   "jp": "e4fc4947ad",
   "kr": "네 정령과 관련 있을 만한 곳으로 남은 건…"
  },
  "51": {
   "jp": "b3dd8dddeb",
   "kr": "전망 좋은 오두막 주변과,"
  },
  "52": {
   "jp": "3720f7f57b",
   "kr": "가든힐과,"
  },
  "53": {
   "jp": "b3953039e3",
   "kr": "모스 호수 주변과,"
  },
  "54": {
   "jp": "1fbd78b8c6",
   "kr": "묘지인가."
  },
  "55": {
   "jp": "10650cc181",
   "kr": "묘지는 가웨인 공의 말을 믿고 기대하기로 하고"
  },
  "56": {
   "jp": "9d31c9ad48",
   "kr": "다른 곳부터 찾아보면 어떻겠나."
  },
  "57": {
   "jp": "b6d20a92e4",
   "kr": "신중하게."
  },
  "58": {
   "jp": "de3d36c6da",
   "kr": "부디 무리하지 않도록 하게."
  }
 }
}
