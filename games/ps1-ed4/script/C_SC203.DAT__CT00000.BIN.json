   "auto": 1
  },
  "5": {
   "jp": "c2dee80e3a",
   "kr": "바람이 차가워…"
  },
  "6": {
   "jp": "ed133e0c10",
   "kr": "유난히 춥구나."
  },
  "7": {
   "jp": "f2cf006699",
   "kr": "여어, 여행하는 사람이로군."
  },
  "8": {
   "jp": "b04463864e",
   "kr": "코르나 마을에 잘 왔어!"
  },
  "9": {
   "jp": "de94d474e6",
   "kr": "여기가 그 유명한 이둔, 네프티스,"
  },
  "10": {
   "jp": "28afc6f50a",
   "kr": "스코티아, 자르의 네 정령을 거느린다는"
  },
  "11": {
   "jp": "02f3b5a7c2",
   "kr": "둘가 님의 참례당이야."
  },
  "12": {
   "jp": "49f8f53586",
   "kr": "헤헤, 관광 안내를 해 버렸네."
  },
  "13": {
   "jp": "817d1c572f",
   "kr": "이 마을은 춥기만 하고 별 볼거리가 없어서"
  },
  "14": {
   "jp": "2b8d8eca99",
   "kr": "나그네를 보면"
  },
  "15": {
   "jp": "4a32b6b8ea",
   "kr": "그만 설명하게 된다니까."
  },
  "16": {
   "jp": "3f13aa3c1e",
   "kr": "모처럼 코르나 마을에 왔으니"
  },
  "17": {
   "jp": "99ae531e69",
   "kr": "느긋하게 둘가 님의 참례당이라도"
  },
  "18": {
   "jp": "d2018894b3",
   "kr": "구경하고 가라고."
  },
  "19": {
   "jp": "c9f4e85848",
   "kr": "둘가 님의 참례당은 어땠어?"
  },
  "20": {
   "jp": "7c4529bd18",
   "kr": "그런 건 본 적 없지?"
  },
  "21": {
   "jp": "8abc927046",
   "kr": "이 마을은 나한테 소중한 곳이야."
  },
  "22": {
   "jp": "4262c10d7c",
   "kr": "죽은 남편과의 추억이 가득 담겨 있거든."
  },
  "23": {
   "jp": "829545825c",
   "kr": "더글라스와 사이좋게 지내 줘."
  },
  "24": {
   "jp": "baa6f9b740",
   "kr": "정말 좋은 아이니까."
  },
  "25": {
   "jp": "75b7c7d6a7",
   "kr": "이봐요, 그런 말투는"
  },
  "26": {
   "jp": "195b01d087",
   "kr": "그만둬요, 어머니…"
  },
  "27": {
   "jp": "0b5e746396",
   "kr": "이게 둘가인가…"
  }
