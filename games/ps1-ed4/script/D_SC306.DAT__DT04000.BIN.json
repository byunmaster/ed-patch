 "segments": {
  "0": {
   "jp": "23113b40e8",
   "kr": "도구점 주인",
   "auto": 1
  },
  "1": {
   "jp": "7e711961f2",
   "kr": "피네스"
  },
  "2": {
   "jp": "8b04ed8182",
   "kr": "로소"
  },
  "3": {
   "jp": "036f6dbe12",
   "kr": "수사나"
  },
  "4": {
   "jp": "9da4c34c63",
   "kr": "포르토"
  },
  "5": {
   "jp": "fcd51c21af",
   "kr": "엔리오"
  },
  "6": {
   "jp": "ea8e94f2c9",
   "kr": "르그랑"
  },
  "7": {
   "jp": "7e5fcc49c1",
   "kr": "어이, 어이어이어이, 어이."
  },
  "8": {
   "jp": "94281b2ddc",
   "kr": "내 배는 쪼끄마니께"
  },
  "9": {
   "jp": "15db0d91e6",
   "kr": "탈 수 있는 건 기껏해야 둘이여."
  },
  "10": {
   "jp": "1a4624eb67",
   "kr": "가라앉는다고."
  },
  "11": {
   "jp": "4ba941df55",
   "kr": "곤란하게 됐네요."
  },
  "12": {
   "jp": "56fbf22fa3",
   "kr": "…어쩔 수 없지."
  },
  "13": {
   "jp": "7921ac46da",
   "kr": "진실의 섬에 건너가는 건"
  },
  "14": {
   "jp": "178f8195ab",
   "kr": "나랑 미첼 씨, 둘만 간다."
  },
  "15": {
   "jp": "e513cbe5a1",
   "kr": "미안하지만 여기서 헤어지자."
  },
  "16": {
   "jp": "97916ecdc5",
   "kr": "그럼 출발하죠."
  },
  "17": {
   "jp": "fe91c78398",
   "kr": "키는 제가 잡을게요."
  },
  "18": {
   "jp": "97916ecdc5",
   "kr": "그럼 출발하죠."
  },
  "19": {
   "jp": "fe91c78398",
   "kr": "키는 제가 잡을게요."
  },
  "20": {
   "jp": "e0636cb023",
   "kr": "자, 타세요."
  },
  "21": {
   "jp": "fcf5a9a9a2",
   "kr": "갑니다!"
  },
  "22": {
   "jp": "95acf7f2cd",
   "kr": "여기는 작은 마을이잖아요."
  },
  "23": {
   "jp": "4c91d412a6",
   "kr": "그래도 인정이 두터워서 정말 좋아해요."
  },
  "24": {
   "jp": "debae70574",
   "kr": "다들 가족처럼 사이가 좋답니다."
  },
  "25": {
   "jp": "bb12f3d02a",
   "kr": "좋아요."
  },
  "26": {
   "jp": "7c72a497b0",
   "kr": "하지만 마을의 소중한 신목이라"
  },
  "27": {
   "jp": "67fcbb2761",
   "kr": "다른 사람들한테도 일단 물어보세요."
  },
  "28": {
   "jp": "1fa17ae57b",
   "kr": "호랑가시나무 잎이 필요하군요."
  },
  "29": {
   "jp": "6cd25ec03e",
   "kr": "저는 상관없지만요."
  },
  "30": {
   "jp": "70d24c06a0",
   "kr": "형제는 있어요?"
  },
  "31": {
   "jp": "5f6c0c8cd6",
   "kr": "나는 언니가 한 명 있어요."
  },
  "32": {
   "jp": "5094eeffd5",
   "kr": "언니는요, 세타에 일하러 가 있어요."
  },
  "33": {
   "jp": "953155c7bf",
   "kr": "어릴 땐 싸움만 했지만"
  },
  "34": {
   "jp": "9e541c5e60",
   "kr": "자매는 역시 좋아요."
  },
  "35": {
   "jp": "6257160564",
   "kr": "가끔 편지를 주고받는 게 다지만."
  },
  "36": {
   "jp": "3b055a8b7f",
   "kr": "떨어져 있어도 마음의 유대가 느껴지거든요."
  },
  "37": {
   "jp": "dbb0a20d33",
   "kr": "오랜만에 세타에 있는 언니가"
  },
  "38": {
   "jp": "595a8b6077",
   "kr": "보고 싶어졌네."
  },
  "39": {
   "jp": "898cc82217",
   "kr": "날씨가 좋은 날에는"
  },
  "40": {
   "jp": "a0e49e5d11",
   "kr": "바다 건너편에 진실의 섬이 보여."
  },
  "41": {
   "jp": "eb402b468c",
   "kr": "동그마니 떠 있는 진실의 섬은"
  },
  "42": {
   "jp": "277bf62cf2",
   "kr": "우리 도크스 사람들 마음의 고향이야."
  },
  "43": {
   "jp": "b39242d983",
   "kr": "가 본 적은 없지만."
  },
  "44": {
   "jp": "2e0c428beb",
   "kr": "좋아."
  },
  "45": {
   "jp": "56cf0c4589",
   "kr": "하지만 마을의 특별 천연기념물이라"
  },
  "46": {
   "jp": "67fcbb2761",
   "kr": "다른 사람들한테도 일단 물어봐."
  },
  "47": {
   "jp": "3077a39d3a",
   "kr": "흐음. 호랑가시나무 잎이 필요하다고?"
  },
  "48": {
   "jp": "41b52638f4",
   "kr": "나는 상관없는데."
  },
  "49": {
   "jp": "e520f5b3fd",
   "kr": "와쿠라는 낙엽을 태우는 담당이야."
  },
  "50": {
   "jp": "cb070ff6af",
   "kr": "큰일 날 뻔했네."
  },
  "51": {
   "jp": "feca281408",
   "kr": "우리한텐 발두스도 오크툼도 상관없어."
  },
  "52": {
   "jp": "a0d7875448",
   "kr": "그딴 건 다툼의 씨앗밖에 안 돼."
  },
  "53": {
   "jp": "c6da6c801e",
   "kr": "마음의 양식은 마을 사람 한 명 한 명의 마음속에 있는 거야."
  },
  "54": {
   "jp": "625be5b334",
   "kr": "그게 도크스가 이른 결론이야."
  },
  "55": {
   "jp": "8ff81efec8",
   "kr": "어머, 여행하시는 분이네."
  },
  "56": {
   "jp": "eff50b25ac",
   "kr": "신목을 보러 오셨나?"
  },
  "57": {
   "jp": "d433294160",
   "kr": "네? 신목…?"
  },
  "58": {
   "jp": "44f6d189f7",
   "kr": "어머, 신목을 보러 온 게 아니었네."
  },
  "59": {
   "jp": "eede68a73a",
   "kr": "도크스의 신목은 유명하답니다."
  },
  "60": {
   "jp": "be7acec074",
   "kr": "마법의 나무가 아니냐는 말까지 들을 정도라니까."
  },
  "61": {
   "jp": "e4ad207204",
   "kr": "자, 가져가세요."
  },
  "62": {
   "jp": "765468e839",
   "kr": "하지만 모두의 소중한 나무라서"
  },
  "63": {
   "jp": "6a14d64dee",
   "kr": "다른 사람들한테도 일단 물어보세요."
  },
  "64": {
   "jp": "69d567a490",
   "kr": "그래요. 호랑가시나무 잎이 필요하군요."
  },
  "65": {
   "jp": "7ad304764a",
   "kr": "어서 가져가세요."
  },
  "66": {
   "jp": "3e9c18f0c1",
   "kr": "당신도 도크스의 소문을 어디선가 들었군요."
  },
  "67": {
   "jp": "e59babb2fe",
   "kr": "이 마을은 발두스 신이나 오크툼 신보다"
  },
  "68": {
   "jp": "4d966974cc",
   "kr": "오래된 신들의 계보를 지키고 있어요."
  },
  "69": {
   "jp": "3ec707edb7",
   "kr": "문자를 갖지 않는 가르침은"
  },
  "70": {
   "jp": "a48b01912a",
   "kr": "구전에 의지하는 전승으로밖에 남길 수 없거든요."
  },
  "71": {
   "jp": "2aba236d96",
   "kr": "그래서 우리 조상들은"
  },
  "72": {
   "jp": "b67451e11f",
   "kr": "선악이 잘못 전해지지 않도록 마음을 썼답니다."
  },
  "73": {
   "jp": "a73e0e5606",
   "kr": "그래도 남은 전승을 요약하면"
  },
  "74": {
   "jp": "670cf8a847",
   "kr": "말하는 바는 단 하나예요."
  },
  "75": {
   "jp": "497b1d2644",
   "kr": "발두스도 오크툼도 아무것도 믿지 마라."
  },
  "76": {
   "jp": "93e4573d4b",
   "kr": "스스로 생각하라."
  },
  "77": {
   "jp": "dc92bf6190",
   "kr": "그뿐이에요."
  },
  "78": {
   "jp": "183db1293a",
   "kr": "도크스의 전승에 따르면 발두스도 오크툼도"
  },
  "79": {
   "jp": "fbf58a75b7",
   "kr": "이둔도, 그리고 스코티아나 자르 같은 정령도"
  },
  "80": {
   "jp": "7d3b512df0",
   "kr": "신계의 존재 중 하나에 불과해요."
  },
  "81": {
   "jp": "9853e80f78",
   "kr": "그들을 특별한 존재로 숭배하는 것이"
  },
  "82": {
   "jp": "a9dbcdf69c",
   "kr": "애초에 잘못의 근원이에요."
  },
  "83": {
   "jp": "795eca768c",
   "kr": "진실의 섬에 가까워지면 갑자기 물살이 거칠어지기 시작혀."
  },
  "84": {
   "jp": "0ed9115e2b",
   "kr": "이게 뭔 일인지 원. 참말로."
  },
  "85": {
   "jp": "2ebb75caa7",
   "kr": "가져가."
  },
  "86": {
   "jp": "fd764a0c1e",
   "kr": "근디 다들 쓰는 나무니께"
  },
  "87": {
   "jp": "c58de958e2",
   "kr": "딴 놈들한테도 일단 물어봐."
  },
  "88": {
   "jp": "10b36a162f",
   "kr": "호랑가시나무 잎이 갖고 싶다고?"
  },
  "89": {
   "jp": "7191972d05",
   "kr": "자네들 별나구먼."
  },
  "90": {
   "jp": "cc5de45a97",
   "kr": "내가 보기엔 낙엽으로 지저분해져서"
  },
  "91": {
   "jp": "f144f46791",
   "kr": "청소하기 힘든 것밖에 없는디."
  },
  "92": {
   "jp": "8212b174a5",
   "kr": "실례.",
   "auto": 1
  },
  "93": {
   "jp": "9c2cc8effe",
   "kr": "진실의 섬에 건너가고 싶은데"
  },
  "94": {
   "jp": "41482df140",
   "kr": "이 배를 빌릴 수 있을까요?"
  },
  "95": {
   "jp": "4944cfd35e",
   "kr": "바라는 것도 많은 놈들이구먼."
  },
  "96": {
   "jp": "7e6c2c358e",
   "kr": "마을 사람 전원에게 물어보고 오면 빌려 주시겠어요?"
  },
  "97": {
   "jp": "d938fa5490",
   "kr": "이건 내 배여. 그럴 필요 없어."
  },
  "98": {
   "jp": "f9ef8d2a96",
   "kr": "어차피 물살이 거칠어서 고기도 못 잡으니께"
  },
  "99": {
   "jp": "b2647979a9",
   "kr": "빌려 줘도 되긴 하는디."
  },
  "100": {
   "jp": "8777074e65",
   "kr": "물살에 삼켜질지도 모른다고."
  },
  "101": {
   "jp": "3a851c75b1",
   "kr": "네, 조심할게요."
  },
  "102": {
   "jp": "2ee8931b4d",
   "kr": "괜찮아요. 아마도요."
  },
  "103": {
   "jp": "564deb45db",
   "kr": "진실의 섬이라…"
  },
  "104": {
   "jp": "6fe38156a7",
   "kr": "좋아."
  },
  "105": {
   "jp": "d6566b04ae",
   "kr": "그런 거라면 빌려 주지."
  },
  "106": {
   "jp": "b56bab5da0",
   "kr": "앗, 내 배… 어찌 된 거여?"
  },
  "107": {
   "jp": "a175216c20",
   "kr": "역시 물살에 삼켜졌구먼."
  },
  "108": {
   "jp": "5f9757db9d",
   "kr": "그러니께 위험하다고"
  },
  "109": {
   "jp": "110c5254b0",
   "kr": "말렸잖여."
  },
  "110": {
   "jp": "dfe574a131",
   "kr": "뭐, 배 일은 됐어."
  },
  "111": {
   "jp": "5a25976281",
   "kr": "자네 목숨이 무사한 것만 해도 건진 거여."
  },
  "112": {
   "jp": "389b638303",
   "kr": "내 걱정은 말어."
  },
  "113": {
   "jp": "a049453acd",
   "kr": "위선의 바다 물살이 거칠어져"
  },
  "114": {
   "jp": "a70db8d963",
   "kr": "우리가 진실의 섬에 건너갈 수 없게 된 데에는"
  },
  "115": {
   "jp": "81a19416fd",
   "kr": "신들의 악의가 느껴진단 말이여."
  },
  "116": {
   "jp": "f3f7815eb4",
   "kr": "위선의 바다는 언제부터 거칠었을까…"
  },
  "117": {
   "jp": "333af8ed55",
   "kr": "어릴 적부터 배를 타고"
  },
  "118": {
   "jp": "c9199171c9",
   "kr": "한 번은 마음의 고향 진실의 섬에 가 보고 싶었는데"
  },
  "119": {
   "jp": "486ffe1a78",
   "kr": "바다가 계속 거칠어서 건널 수가 없어."
  },
  "120": {
   "jp": "57144e55d7",
   "kr": "가깝고도 먼 진실의 섬인가."
  },
  "121": {
   "jp": "b2ff56eeb6",
   "kr": "그래, 좋아."
  },
  "122": {
   "jp": "0dd556dfd2",
   "kr": "다만 그건 마을 공유 재산이니까"
  },
  "123": {
   "jp": "a1698d2b65",
   "kr": "다른 사람들한테도 일단 물어봐 줘."
  },
  "124": {
   "jp": "a6440af114",
   "kr": "설마 요즘 세상에 호랑가시나무 잎 전설을 믿고"
  },
  "125": {
   "jp": "279b17d18e",
   "kr": "저주를 푸는 약을 만들겠다는 건 아니겠지?"
  },
  "126": {
   "jp": "3f479d8e32",
   "kr": "그 전설은 아직 아무도 시험해 본 적이 없거든."
  },
  "127": {
   "jp": "2114c9fdc1",
   "kr": "아무리 그래도 위선의 바다는 물살이 거세서"
  },
  "128": {
   "jp": "da46782005",
   "kr": "진실의 섬까지 위험을 무릅쓰고"
  },
  "129": {
   "jp": "e18b079b5d",
   "kr": "노 저어 가려는 놈은 없으니까."
  },
  "130": {
   "jp": "c4a79d3317",
   "kr": "뭐, 필요하면 가져가. 어서."
  },
  "131": {
   "jp": "d17bb89f54",
   "kr": "어라, 전에 본 얼굴이네."
  },
  "132": {
   "jp": "e791d2afe1",
   "kr": "별로 친하지 않아도"
  },
  "133": {
   "jp": "830d4b4ab0",
   "kr": "아는 얼굴이 잘 지내는 걸 보면"
  },
  "134": {
   "jp": "d19ded7200",
   "kr": "기쁜 법이지."
  },
  "135": {
   "jp": "8f2409aebf",
   "kr": "이 마을은 무슨 일이 있어도"
  },
  "136": {
   "jp": "c7d15a539e",
   "kr": "마이페이스가 모토야."
  },
  "137": {
   "jp": "f8d2a6a605",
   "kr": "하지만 결코…"
  },
  "138": {
   "jp": "6a2b33b8ab",
   "kr": "죽을 때는 죽는다, 하고 체념하는 건 아니야."
  },
  "139": {
   "jp": "78d6704287",
   "kr": "그 점이 대단한 거지."
  },
  "140": {
   "jp": "2e83e49bca",
   "kr": "도착했네요."
  },
  "141": {
   "jp": "78bd17bb17",
   "kr": "여기가 도크스예요."
  },
  "142": {
   "jp": "3b4584b2ce",
   "kr": "자, 마을 사람들에게 호랑가시나무 잎을 나눠 달라고"
  },
  "143": {
   "jp": "30a9bb1234",
   "kr": "부탁해 보죠."
  },
  "144": {
   "jp": "c3f8c2f40e",
   "kr": "그래."
  },
  "145": {
   "jp": "c4e3cb3b31",
   "kr": "뭐니 뭐니 해도 신목의 잎이니까요."
  },
  "146": {
   "jp": "74c56fbae9",
   "kr": "쉽게는 나눠 주지 않을지도 몰라요."
  },
  "147": {
   "jp": "06cb15c057",
   "kr": "호랑가시나무 잎을 구한 모양이네."
