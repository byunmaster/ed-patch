{
 "archive": "/C/SC204.DAT",
 "member": "..\\BIN\\CT03000F.BIN",
 "segments": {
  "0": {
   "jp": "b4ae46b6b5",
   "kr": "어서 오게, 자네들. 잘 와 주었군."
  },
  "1": {
   "jp": "bfe3dd771f",
   "kr": "때마침 잘 왔네."
  },
  "2": {
   "jp": "717081d8b7",
   "kr": "앗… 루카?"
  },
  "3": {
   "jp": "b01283d516",
   "kr": "루티스 누나."
  },
  "4": {
   "jp": "353175f799",
   "kr": "방금 누나들을 찾으러 갈까"
  },
  "5": {
   "jp": "c9e3ac8cdf",
   "kr": "하고 얘기하던 참이었어."
  },
  "6": {
   "jp": "1bb28afebf",
   "kr": "어, 무슨 일 있어?"
  },
  "7": {
   "jp": "c314dedf4a",
   "kr": "자, 앉게나."
  },
  "8": {
   "jp": "bc95469ab2",
   "kr": "차근차근 이야기해 보세."
  },
  "9": {
   "jp": "90535282f4",
   "kr": "실은 레어메탈 연금법을 알아냈거든."
  },
  "10": {
   "jp": "c0788f660a",
   "kr": "최고의 무기라도 만들어 볼까 싶어서 말이야."
  },
  "11": {
   "jp": "a9021248d4",
   "kr": "용광로에 대해 물으려고 루카를 불렀더니"
  },
  "12": {
   "jp": "d8bfbcbe2a",
   "kr": "자네 동생이라지 뭔가."
  },
  "13": {
   "jp": "6633fdf030",
   "kr": "참 세상 좁구먼."
  },
  "14": {
   "jp": "87322aaeab",
   "kr": "도리아 교수님은 기아의 용광로로"
  },
  "15": {
   "jp": "61de91c5c9",
   "kr": "레어메탈을 정련하려고 하세요."
  },
  "16": {
   "jp": "2eb624ff30",
   "kr": "간단히 설명하면 레어메탈은 불순물이 많고"
  },
  "17": {
   "jp": "f48911bf70",
   "kr": "경도가 높은 반면"
  },
  "18": {
   "jp": "7a89cef2c8",
   "kr": "휘어지는 유연성도 풍부하다네."
  },
  "19": {
   "jp": "dfc82dc219",
   "kr": "그러니 이대로 검을 만들어 봤자"
  },
  "20": {
   "jp": "8a7b6c6c01",
   "kr": "단단하긴 해도 금방 휘어 버리는"
  },
  "21": {
   "jp": "30553b4b4e",
   "kr": "흐물흐물한 검밖에 안 나온다는 얘기지."
  },
  "22": {
   "jp": "c63b3a5686",
   "kr": "내가 생각해 봤네."
  },
  "23": {
   "jp": "ddf44340d0",
   "kr": "비밀은 섬유 모양으로 얽힌 분자 구조에 있다네～"
  },
  "24": {
   "jp": "2e3d7c81db",
   "kr": "그래서 말인데, 적당한 열을 가해"
  },
  "25": {
   "jp": "16375aa332",
   "kr": "불순한 금속을 녹이고"
  },
  "26": {
   "jp": "c591d0ed81",
   "kr": "대신 형상력이 높은 금속을 부어 넣는 걸세."
  },
  "27": {
   "jp": "33da85790b",
   "kr": "즉, 합금이지."
  },
  "28": {
   "jp": "5da4f4ad15",
   "kr": "순수한 레어메탈이 열로는 변하지 않는다는 건"
  },
  "29": {
   "jp": "4da92df91b",
   "kr": "시료로 실험이 끝났다네."
  },
  "30": {
   "jp": "5031f19dfc",
   "kr": "게다가 레어메탈에 다른 금속을 부으면"
  },
  "31": {
   "jp": "dd53cc0d1d",
   "kr": "부피에 맞춰 섬유 구조를 고르게 넓히는"
  },
  "32": {
   "jp": "cf6675da62",
   "kr": "성질이 있어, 그것이 곧 이음매가 되지."
  },
  "33": {
   "jp": "0507cb5efd",
   "kr": "알겠나?"
  },
  "34": {
   "jp": "c1638697ed",
   "kr": "어렴풋이는…"
  },
  "35": {
   "jp": "269d06e1df",
   "kr": "뭐, 아무튼."
  },
  "36": {
   "jp": "6bfe08677a",
   "kr": "합금으로 만들면 아주 쓸모가 많다는"
  },
  "37": {
   "jp": "a58b61cf97",
   "kr": "얘기일세."
  },
  "38": {
   "jp": "2e803a3943",
   "kr": "그 합금을 단련한 무기라면"
  },
  "39": {
   "jp": "ca89b9f389",
   "kr": "그야말로 최강이겠지."
  },
  "40": {
   "jp": "eebba8fa0c",
   "kr": "용광로 다루는 솜씨는 루카가 천재적이라네."
  },
  "41": {
   "jp": "d3d6650561",
   "kr": "게다가 동료 페르나는 대장간에서 일한 적도 있지."
  },
  "42": {
   "jp": "c9d15771e3",
   "kr": "이 둘에게 맡기면 틀림없네."
  },
  "43": {
   "jp": "e862c61c15",
   "kr": "그런데 레어메탈은 갖고 있겠지?"
  },
  "44": {
   "jp": "746e103ebe",
   "kr": "그걸 루카에게 건네주지 않겠나."
  },
  "45": {
   "jp": "c3f8c2f40e",
   "kr": "그래."
  },
  "46": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "47": {
   "jp": "df44b5d671",
   "kr": "을(를) 루카에게 건넸다."
  },
  "48": {
   "jp": "4efce56ba9",
   "kr": "그럼 저는 도리아 교수님 지시대로"
  },
  "49": {
   "jp": "28c91354ea",
   "kr": "레어메탈 합금을 만들게요."
  },
  "50": {
   "jp": "da27400671",
   "kr": "어빈 씨, 루티스 누나."
  },
  "51": {
   "jp": "fbd4396dff",
   "kr": "잠시 후에 상황을 보러 와 주세요."
  },
  "52": {
   "jp": "2bb1f46f17",
   "kr": "그렇게 오래 걸리지 않고"
  },
  "53": {
   "jp": "2049381c6e",
   "kr": "완성될 거예요."
  },
  "54": {
   "jp": "39917e7d79",
   "kr": "그럼 도리아 교수님."
  },
  "55": {
   "jp": "c0c01334fd",
   "kr": "저는 기아로 돌아갈게요."
  },
  "56": {
   "jp": "3436f67891",
   "kr": "오오, 잘 부탁하네."
  },
  "57": {
   "jp": "675054e5ee",
   "kr": "도리아 교수님, 감사합니다."
  },
  "58": {
   "jp": "c1fd14f6b3",
   "kr": "인사받을 일이 아닐세."
  },
  "59": {
   "jp": "433528b4d2",
   "kr": "나는 취미로 연구했을 뿐일세."
  },
  "60": {
   "jp": "c4adaf94d8",
   "kr": "나머지는 루카 일행이 얼마나 힘내느냐에 달렸지."
  }
 }
}
