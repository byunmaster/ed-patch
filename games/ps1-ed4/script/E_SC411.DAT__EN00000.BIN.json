 "segments": {
  "0": {
   "jp": "c7835842e0",
   "kr": "아이멜",
   "auto": 1
  },
  "1": {
   "jp": "a60cd79ca9",
   "kr": "가웨인"
  },
  "2": {
   "jp": "32a36a2040",
   "kr": "최고 도사 크로웰"
  },
  "3": {
   "jp": "c379aae702",
   "kr": "로네"
  },
  "4": {
   "jp": "1e195f6292",
   "kr": "섀넌",
   "auto": 1
  },
  "5": {
   "jp": "9bc0cb809b",
   "kr": "스테인드글라스, 봤어?"
  },
  "6": {
   "jp": "659f670548",
   "kr": "응. 전보다 훨씬 멋있어진 것 같아."
  },
  "7": {
   "jp": "c7c36e6e46",
   "kr": "열심히 했어."
  },
  "8": {
   "jp": "732454dc7a",
   "kr": "허어, 그나저나."
  },
  "9": {
   "jp": "b87a810884",
   "kr": "참으로 감탄했소."
  },
  "10": {
   "jp": "6c425a0387",
   "kr": "어빈이 여기까지 해낼 줄이야."
  },
  "11": {
   "jp": "b09f6f8aef",
   "kr": "모두가 있어 준 덕분입니다."
  },
  "12": {
   "jp": "91568c9103",
   "kr": "저 혼자서는 무리였을 겁니다."
  },
  "13": {
   "jp": "ca0cfc0698",
   "kr": "고독하게 시작된 여행이"
  },
  "14": {
   "jp": "7f41f19c2c",
   "kr": "어느새 서로 의지하는 벗을 낳았군요."
  },
  "15": {
   "jp": "f38b894035",
   "kr": "미첼 님."
  },
  "16": {
   "jp": "e61a243f4c",
   "kr": "음으로 양으로 도와주셔서 감사했습니다."
  },
  "17": {
   "jp": "2078139273",
   "kr": "정말 고맙게 생각합니다."
  },
  "18": {
   "jp": "e41a24534a",
   "kr": "아니요, 저 같은 건…"
  },
  "19": {
   "jp": "d657e43848",
   "kr": "그보다, 크로웰 님."
  },
  "20": {
   "jp": "828d3322a9",
   "kr": "앞으로 정신전을 어떻게 하실 생각이세요?"
  },
  "21": {
   "jp": "adf1a6ff38",
   "kr": "예. 그 일 말입니다만."
  },
  "22": {
   "jp": "d9c3f4a02e",
   "kr": "아시다시피"
  },
  "23": {
   "jp": "20a0860ebc",
   "kr": "정신전은 발두스 신을 숭배하는 신도들의 가르침입니다."
  },
  "24": {
   "jp": "7f84115135",
   "kr": "원래대로라면 혼란을 막기 위해"
  },
  "25": {
   "jp": "3ac86e96c6",
   "kr": "발두스 신의 소멸을 당분간 알리지 않는 것도"
  },
  "26": {
   "jp": "e0bef25a6d",
   "kr": "한 방법이라 생각했습니다만…"
  },
  "27": {
   "jp": "013a093bc9",
   "kr": "저는 어빈이 체험한 일을"
  },
  "28": {
   "jp": "544bfaadb3",
   "kr": "솔직하게 모두에게 전하려고 합니다."
  },
  "29": {
   "jp": "d9b8ce45f5",
   "kr": "현실을 받아들여야 진리가 보이는 법."
  },
  "30": {
   "jp": "25e196b994",
   "kr": "그것이 아마"
  },
  "31": {
   "jp": "84ff6540fd",
   "kr": "진실이라 부를 수 있는 것이 아닐까요."
  },
  "32": {
   "jp": "015c8a4cb0",
   "kr": "가르침에 신은 필요 없습니다."
  },
  "33": {
   "jp": "6486a01949",
   "kr": "그것이 정말 존귀한 것이라면"
  },
  "34": {
   "jp": "7bb408f902",
   "kr": "사람들 속에 반드시 신은 존재할 것입니다."
  },
  "35": {
   "jp": "cec96687bc",
   "kr": "오크툼의 베리어스 경도"
  },
  "36": {
   "jp": "a67d4df7af",
   "kr": "사실은 그런 마음이었을 거라고 생각해…"
  },
  "37": {
   "jp": "bbb35bae40",
   "kr": "녀석은 분명 그것을 확인하고 싶었던 거야."
  },
  "38": {
   "jp": "abd2585706",
   "kr": "나도… 그렇게 믿고 싶어."
  },
  "39": {
   "jp": "7ed39bfea9",
   "kr": "그런데, 여러분은 앞으로 어떻게 하실 건가요?"
  },
  "40": {
   "jp": "2d69cbdd30",
   "kr": "나는 브리작으로 돌아가겠소."
  },
  "41": {
   "jp": "1ed598abd4",
   "kr": "이제 은거해도 될 나이지."
  },
  "42": {
   "jp": "fa0d2a3bf2",
   "kr": "저도 제 나라로 돌아가요."
  },
  "43": {
   "jp": "0725fe1486",
   "kr": "토마스 씨와 바다를 건너려고요."
  },
  "44": {
   "jp": "90e3802526",
   "kr": "대항해예요."
  },
  "45": {
   "jp": "7b3047ea2d",
   "kr": "우리도 집으로 돌아갈게."
  },
  "46": {
   "jp": "38d623c9ad",
   "kr": "오레시아 선생님께 보고드린 다음"
  },
  "47": {
   "jp": "1f746d1ab6",
   "kr": "오빠가 살던"
  },
  "48": {
   "jp": "447c281043",
   "kr": "레뮤라스 님 계신 곳으로 가겠어요."
  },
  "49": {
   "jp": "1aa7c12989",
   "kr": "마일하고 섀넌은 어떻게 할 거야?"
  },
  "50": {
   "jp": "7394d4cf75",
   "kr": "갈 거야. 물론 돌아가야지, 울트 마을로."
  },
  "51": {
   "jp": "227fc0fd90",
   "kr": "울트 마을 사람들 모두"
  },
  "52": {
   "jp": "078eef4536",
   "kr": "마일이 죽은 줄 알고 있을걸."
  },
  "53": {
   "jp": "b29cac2f48",
   "kr": "무덤도 있을지 몰라…"
  },
  "54": {
   "jp": "ac2573b5bf",
   "kr": "너무해…"
  },
  "55": {
   "jp": "0f579995fc",
   "kr": "섀넌은 마일 님이 가시는 곳이라면"
  },
  "56": {
   "jp": "e57cca47f3",
   "kr": "어디든 따라가겠어요."
  },
  "57": {
   "jp": "706ef3b235",
   "kr": "아버님과 어머님께 인사드리고…"
  },
  "58": {
   "jp": "82c941e101",
   "kr": "그리고, 그리고…"
  },
  "59": {
   "jp": "af9c266c90",
   "kr": "앗… 이제 됐어."
  },
  "60": {
   "jp": "722f883775",
   "kr": "루티스는…?"
  },
  "61": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "62": {
   "jp": "95bfb545ff",
   "kr": "…응."
  },
  "63": {
   "jp": "47f3b9c67f",
   "kr": "그러게.",
   "auto": 1
  },
  "64": {
   "jp": "50be0a117f",
   "kr": "기아에라도 가서 루카를 만날 거야."
  },
  "65": {
   "jp": "bf92a44763",
   "kr": "그런가.",
   "auto": 1
  },
  "66": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "67": {
   "jp": "4bc0a7ca80",
   "kr": "……루티스."
  },
  "68": {
   "jp": "2635203b22",
   "kr": "괜찮으면 우리랑 같이 가지 않을래?"
  },
  "69": {
   "jp": "4e9a26682b",
   "kr": "어빈…",
   "auto": 1
  },
  "70": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "71": {
   "jp": "dea4992c54",
   "kr": "고마워."
  },
  "72": {
   "jp": "a8f07b9346",
   "kr": "어딘지는 아니까."
  },
  "73": {
   "jp": "9277c91fb1",
   "kr": "마음이 내키면 분명 갈게."
  },
  "74": {
   "jp": "c3f8c2f40e",
   "kr": "그래."
  },
  "75": {
   "jp": "fec5cc19f7",
   "kr": "기다릴게."
  }
 }
}
