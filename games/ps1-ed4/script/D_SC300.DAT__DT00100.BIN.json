  },
  "4": {
   "jp": "b876243eb3",
   "kr": "페이"
  },
  "5": {
   "jp": "aa54278d9f",
   "kr": "멜"
  },
  "6": {
   "jp": "dd351ec89f",
   "kr": "노만"
  },
  "7": {
   "jp": "531a4534b1",
   "kr": "엘리제"
  },
  "8": {
   "jp": "c152b80f1f",
   "kr": "에밀리"
  },
  "9": {
   "jp": "a42ecc03cf",
   "kr": "피에트"
  },
  "10": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "11": {
   "jp": "117bbb5933",
   "kr": "을(를) 사용했다.",
   "auto": 1
  },
  "12": {
   "jp": "08618115e7",
   "kr": "문 자물쇠가 열렸다.",
   "auto": 1
  },
  "13": {
   "jp": "1df8719032",
   "kr": "문은 잠겨 있다.",
   "auto": 1
  },
  "14": {
   "jp": "8afc0e26f0",
   "kr": "꽤 훌륭한 등대가 있지 않나."
  },
  "15": {
   "jp": "148428a07b",
   "kr": "이 바로아의 등대는 말이야,"
  },
  "16": {
   "jp": "42ab57728e",
   "kr": "내가 태어나기 훨씬 전부터 이곳의 명물이라네."
  },
  "17": {
   "jp": "7961e637c1",
   "kr": "아주아주 오래전부터 있었지."
  },
  "18": {
   "jp": "e9f12a6265",
   "kr": "누가 지었는지는 모르지만 옛날부터 있었다네."
  },
  "19": {
   "jp": "3e6cc5076c",
   "kr": "걷고, 배 타고, 산을 넘고."
  },
  "20": {
   "jp": "36c122aa22",
   "kr": "여행이란 게 이래저래 힘들단 말이지…"
  },
  "21": {
   "jp": "8470e23df7",
   "kr": "한순간에 원하는 곳으로 이동할 수 있다면"
  },
  "22": {
   "jp": "a926a17f26",
   "kr": "나 같은 늙은이도"
  },
  "23": {
   "jp": "88f40fa9fb",
   "kr": "가볍게 여행을 즐길 텐데…"
  },
  "24": {
   "jp": "3f1739a384",
   "kr": "자네들…"
  },
  "25": {
   "jp": "11ff95bc4c",
   "kr": "내 기분 탓일지도 모르지만…"
  },
  "26": {
   "jp": "e94fd9ff9a",
   "kr": "유난히 자주 보이는 것 같구먼."
  },
  "27": {
   "jp": "e1e7732593",
   "kr": "그냥 여행자가 아니지?"
  },
  "28": {
   "jp": "35126c5937",
   "kr": "그렇다면…"
  },
  "29": {
   "jp": "a003cb1fd0",
   "kr": "………"
  },
  "30": {
   "jp": "f43767ee6c",
   "kr": "우편배달부인가?"
  },
  "31": {
   "jp": "d71d53f479",
   "kr": "딸 아니타는 듀카 남작 저택에"
  },
  "32": {
   "jp": "814629d934",
   "kr": "초대받아 갔다네."
  },
  "33": {
   "jp": "182a725bca",
   "kr": "이제 나도 한시름 놓았네."
  },
  "34": {
   "jp": "742046bfe8",
   "kr": "자네들에겐 수고를 끼쳤네."
  },
  "35": {
   "jp": "182a725bca",
   "kr": "이제 나도 한시름 놓았네."
  },
  "36": {
   "jp": "83aeb98cd7",
   "kr": "뭐라고요?"
  },
  "37": {
   "jp": "ae2ff16ef8",
   "kr": "벌써 퇴치하셨습니까?"
  },
  "38": {
   "jp": "2e29e617dc",
   "kr": "…훌륭하십니다."
  },
  "39": {
   "jp": "84606303ac",
   "kr": "그럼 딸을 불러와 주시지 않겠습니까?"
  },
  "40": {
   "jp": "0e42917c10",
   "kr": "어라, 콘로드 남작은 어떻게 되셨습니까?"
  },
  "41": {
   "jp": "9fcf762fb5",
   "kr": "티아 다리 근처에 나타나는 마수를"
  },
  "42": {
   "jp": "f373272697",
   "kr": "쓰러뜨려 주십시오."
  },
  "43": {
   "jp": "a51768c052",
   "kr": "멋지게 해치우신다면"
  },
  "44": {
   "jp": "a651321704",
   "kr": "딸과의 교제를 허락하겠습니다."
  },
  "45": {
   "jp": "c12321052c",
   "kr": "무슨 일인가?"
  },
  "46": {
   "jp": "c12321052c",
   "kr": "무슨 일인가?"
  },
  "47": {
   "jp": "f2fd86c61b",
   "kr": "정말 고마워요."
  },
  "48": {
   "jp": "f9e95b9f9d",
   "kr": "저, 행복해질게요."
  },
  "49": {
   "jp": "5460af5eda",
   "kr": "콘로드 님!"
  },
  "50": {
   "jp": "45b696979c",
   "kr": "무사하셨군요."
  },
  "51": {
   "jp": "78cb50ac93",
   "kr": "콘로드 님이 안 계시면"
  },
  "52": {
   "jp": "0368a10bc4",
   "kr": "아버지는 납득하지 않으세요."
  },
  "53": {
   "jp": "e06768363a",
   "kr": "부디 콘로드 님을"
  },
  "54": {
   "jp": "ae6f357502",
   "kr": "데려와 주세요."
  },
  "55": {
   "jp": "44ee711e0a",
   "kr": "무리한 부탁을 해서 죄송해요."
  },
  "56": {
   "jp": "de28db958b",
   "kr": "하지만 달리 의지할 분이 없어요."
  },
  "57": {
   "jp": "cec11d92c9",
   "kr": "누구 데려와 주셨나요?"
  },
  "58": {
   "jp": "de9a3c647b",
   "kr": "아버지를 납득시킬 만한 분이"
  },
  "59": {
   "jp": "d5ba899500",
   "kr": "떠오르시면 부탁드려요."
  },
  "60": {
   "jp": "8b84ed0359",
   "kr": "그런데… 듀카 공작은"
  },
  "61": {
   "jp": "3b49b52cb5",
   "kr": "대체 어떤 분일까…"
  },
  "62": {
   "jp": "454cbf78a5",
   "kr": "아니타 씨는 지금까지 만난 여성 중에서"
  },
  "63": {
   "jp": "b5a4db8fc7",
   "kr": "가장 아름답고 가장 총명한 분입니다."
  },
  "64": {
   "jp": "e85c95a51a",
   "kr": "멀리서 온 보람이 있었습니다."
  },
  "65": {
   "jp": "04496a55df",
   "kr": "우리 남편은 은광산 조사원이에요."
  },
  "66": {
   "jp": "283186eac1",
   "kr": "매일 은광산에 나가고 있죠."
  },
  "67": {
   "jp": "798184f320",
   "kr": "도시락은 무사히 다니엘에게 전해졌군요."
  },
  "68": {
   "jp": "b069c1b103",
   "kr": "정말 수고하셨어요."
  },
  "69": {
   "jp": "e16359ef20",
   "kr": "우리 남편은"
  },
  "70": {
   "jp": "988d00cb1d",
   "kr": "일 때문에 늘 나가 있어요."
  },
  "71": {
   "jp": "5ff0a65605",
   "kr": "돌아오는 건 밤늦게나 되고요."
  },
  "72": {
   "jp": "5c8e6f6bab",
   "kr": "제대로 얘기할 수 있는 건"
  },
  "73": {
   "jp": "d5ecf4cf8a",
   "kr": "매일 아침 도시락을 건넬 때 정도예요."
  },
  "74": {
   "jp": "743405855f",
   "kr": "잘 지내고 있니?"
  },
  "75": {
   "jp": "8cd271c290",
   "kr": "젊다고 무리하면 안 돼."
  },
  "76": {
   "jp": "2f1297a96b",
   "kr": "우리 남편이 이번에 휴가를 내서"
  },
  "77": {
   "jp": "7cd972c81a",
   "kr": "소풍을 가자고 했어요."
  },
  "78": {
   "jp": "142370a7f9",
   "kr": "솜씨를 한껏 발휘해서"
  },
  "79": {
   "jp": "f484e0a146",
   "kr": "근사한 도시락을 만들 거예요."
  },
  "80": {
   "jp": "a1fbc51162",
   "kr": "어서 오세요."
  },
  "81": {
   "jp": "912a5d2549",
   "kr": "린도스 할아버지는 잘 지내세요?"
  },
  "82": {
   "jp": "5c102eb2b0",
   "kr": "편히 쉬었다 가요, 여행자님."
  },
  "83": {
   "jp": "35de454224",
   "kr": "힘든 여행이네요…"
  },
  "84": {
   "jp": "8b35b5d24f",
   "kr": "하지만 저도 응원해 줄게요."
  },
  "85": {
   "jp": "dd27d95c71",
   "kr": "힘내요. 여행자님."
  },
  "86": {
   "jp": "fafc11bc95",
   "kr": "어서 와요. "
  },
  "87": {
   "jp": "774c9ab01e",
   "kr": "아, 알선소에서 와 주셨군요."
  },
  "88": {
   "jp": "b90123589e",
   "kr": "잠깐 이쪽으로 와 줄래요?"
  },
  "89": {
   "jp": "dda1f14940",
   "kr": "코르나의 린도스 할아버지는 잘 지내실까."
  },
  "90": {
   "jp": "ca5951bee2",
   "kr": "편지 배달, 부탁해요."
  },
  "91": {
   "jp": "b1ba7af23c",
   "kr": "안녕하세요, 여행자님. 컨디션은 어때요?"
  },
  "92": {
   "jp": "4080799a5b",
   "kr": "좀 우울한 얼굴이네요."
  },
  "93": {
   "jp": "421b4e3721",
   "kr": "기운을 내야 해요."
  },
  "94": {
   "jp": "18cd19a7af",
   "kr": "또 와 주셨군요. 기뻐요."
  },
  "95": {
   "jp": "6ca3f77bd3",
   "kr": "모처럼 왔으니 등대도 구경하고 가세요."
  },
  "96": {
   "jp": "e178278b0f",
   "kr": "여기 있는 등대는요, 바다의 안전뿐 아니라"
  },
  "97": {
   "jp": "9716ca3093",
   "kr": "우리 모두의 삶도 지켜봐 왔어요."
  },
  "98": {
   "jp": "2813503155",
   "kr": "정말 수고하셨소."
  },
  "99": {
   "jp": "f79f6d9d19",
   "kr": "알선소 쪽에 연락해 둘 테니"
  },
  "100": {
   "jp": "6e8029e978",
   "kr": "잊지 말고 보수를 받아 가시게."
  },
  "101": {
   "jp": "313d8212e6",
   "kr": "(추억으로만 남겨 둘 걸 그랬나…)"
  },
  "102": {
   "jp": "313d8212e6",
   "kr": "(추억으로만 남겨 둘 걸 그랬나…)"
  },
  "103": {
   "jp": "e77306a9d0",
   "kr": "나이를 먹으면 낙이라곤 하나도 없지."
  },
  "104": {
   "jp": "c34ab05b9e",
   "kr": "그저 옛날을 그리워하며 지금을 잊을 뿐이야."
  },
  "105": {
   "jp": "7a74f2c27e",
   "kr": "자네도 젊을 때 추억을 많이"
  },
  "106": {
   "jp": "621c36f76e",
   "kr": "만들어 두게."
  },
  "107": {
   "jp": "09f91164c5",
   "kr": "(줄곧 혼자였던 걸까…)"
  },
  "108": {
   "jp": "3da4587c96",
   "kr": "그리워서 말도 안 나오나 봐."
  },
  "109": {
   "jp": "6070dc129d",
   "kr": "오랜만이에요."
  },
  "110": {
   "jp": "ac2b4facc6",
   "kr": "아, 아, 아, 아, 아…"
  },
  "111": {
   "jp": "6aab3930f7",
   "kr": "사랑은 지난날의 환영… 인가."
  },
  "112": {
   "jp": "325255ed71",
   "kr": "그럼 안녕, 할아버지."
  },
  "113": {
   "jp": "9543ab7987",
   "kr": "행복하게."
  },
  "114": {
   "jp": "df25c80ec4",
   "kr": "내가 태어나기"
  },
  "115": {
   "jp": "d918559185",
   "kr": "훨씬 전부터 이곳의 명물이라네."
  }
 }
}
