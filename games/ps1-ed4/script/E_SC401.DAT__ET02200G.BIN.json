{
 "archive": "/E/SC401.DAT",
 "member": "..\\BIN\\ET02200G.BIN",
 "segments": {
  "0": {
   "jp": "a10c06e81d",
   "kr": "오, 어빈.",
   "auto": 1
  },
  "1": {
   "jp": "24780fede2",
   "kr": "기다리고 있었소."
  },
  "2": {
   "jp": "51f23c1bc3",
   "kr": "가웨인 공에게서 연락이 왔소."
  },
  "3": {
   "jp": "55456bec48",
   "kr": "가웨인에게서요?!"
  },
  "4": {
   "jp": "09968a5980",
   "kr": "마침 잘됐군요."
  },
  "5": {
   "jp": "c231076515",
   "kr": "이쪽도 잘 말고 다른 정령을 만났어요."
  },
  "6": {
   "jp": "a015248b4e",
   "kr": "신보도 세 개가 모인 참이에요."
  },
  "7": {
   "jp": "28a9a02fa8",
   "kr": "어빈은 사당에서 얻은 신보를 꺼냈다."
  },
  "8": {
   "jp": "58f59c5818",
   "kr": "오오… 발두스 신의 신보가 세 개나 모였군."
  },
  "9": {
   "jp": "6882ecb996",
   "kr": "어느 사당에서든 정령의 모습이 사라지면… 이게 남았어요."
  },
  "10": {
   "jp": "3b7584830a",
   "kr": "하지만 신보를 맡기셔도"
  },
  "11": {
   "jp": "25d4f23ee1",
   "kr": "저는 어떻게 하면 좋을지 모르겠어요."
  },
  "12": {
   "jp": "d8f3bee69e",
   "kr": "이 신보는 저에게 필요 없어요."
  },
  "13": {
   "jp": "83875c34c1",
   "kr": "오크툼 신도들에게 빼앗기지 않도록"
  },
  "14": {
   "jp": "9d185e7ae0",
   "kr": "정신전에서 가져가 주세요."
  },
  "15": {
   "jp": "510f50bcf6",
   "kr": "아니, 그건 자네가 가지고 있으시오."
  },
  "16": {
   "jp": "b7589d0584",
   "kr": "…왜죠?"
  },
  "17": {
   "jp": "0e0348ff10",
   "kr": "저는 이제 싸움에 휘말리는 건 사양이에요."
  },
  "18": {
   "jp": "5326cf1728",
   "kr": "카베사와 쿠엘포는"
  },
  "19": {
   "jp": "f6e58271a6",
   "kr": "대대로 정신전이 맡아 관리해 온 것이지만"
  },
  "20": {
   "jp": "e2a483e07c",
   "kr": "그건 자네가 정령에게서 직접 받은 것이오."
  },
  "21": {
   "jp": "47b75ad377",
   "kr": "자네가 가지고 있어야 의미가 있다고"
  },
  "22": {
   "jp": "7a261b5fb2",
   "kr": "…나는 그렇게 생각하오."
  },
  "23": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "24": {
   "jp": "3f01d14007",
   "kr": "괜찮겠소…?"
  },
  "25": {
   "jp": "9433f22727",
   "kr": "아, 그렇지. 가웨인 공이 전한 말에 따르면"
  },
  "26": {
   "jp": "5996061335",
   "kr": "자네가 진실의 섬에서 계시로 본 듯한 묘지를"
  },
  "27": {
   "jp": "c7ca5e6154",
   "kr": "카나피아 섬에서 발견했다고 하오."
  },
  "28": {
   "jp": "bafd95a6cd",
   "kr": "가웨인 공은 브리작에서 배를 마련해"
  },
  "29": {
   "jp": "dbab87e1c7",
   "kr": "기다리고 있다는구려."
  },
  "30": {
   "jp": "6c22d0b397",
   "kr": "어서 가시오."
  },
  "31": {
   "jp": "eeb1a7aacd",
   "kr": "브리작에서 가웨인 공이 기다리고 계시오."
  },
  "32": {
   "jp": "1eb608763f",
   "kr": "어빈은 카베사와 쿠엘포를 받았다."
  },
  "33": {
   "jp": "b3c43253c8",
   "kr": "원래 카테드랄은"
  },
  "34": {
   "jp": "8ffce84384",
   "kr": "봉인의 땅을 지키기 위해 지은 대성당이오."
  },
  "35": {
   "jp": "82f7086390",
   "kr": "카테드랄 지하에는 비밀 통로가 있어"
  },
  "36": {
   "jp": "9dbde9d6bd",
   "kr": "해저 동굴을 지나 봉인의 땅까지 건널 수 있다."
  },
  "37": {
   "jp": "4c47e69538",
   "kr": "비밀 통로는 에류시온에 반응할 것이오."
  },
  "38": {
   "jp": "98bd4fdbbb",
   "kr": "카테드랄까지 가는 성자의 길은"
  },
  "39": {
   "jp": "64bf1a58e0",
   "kr": "오크툼 신도의 파괴 공작으로 지날 수 없소."
  },
  "40": {
   "jp": "ecb6f357bf",
   "kr": "브리작에서 배로 돌아가는 수밖에 없겠지."
  },
  "41": {
   "jp": "5c9883bfa1",
   "kr": "절벽 아래 바다에서 카테드랄로 오르는 동굴이 있소."
  },
  "42": {
   "jp": "7f9a2bbfba",
   "kr": "이제 나는 기도밖에 할 수 없지만"
  },
  "43": {
   "jp": "cdfba60d33",
   "kr": "진심으로 기도하겠소."
  },
  "44": {
   "jp": "20925c78e1",
   "kr": "대지의 미래와 정령의 가호가 있기를."
  },
  "45": {
   "jp": "212940c0c9",
   "kr": "짐이 가득 차서 카베사와 쿠엘포를 받을 수 없다."
  },
  "46": {
   "jp": "432da8bb07",
   "kr": "해저 동굴을 지나"
  },
  "47": {
   "jp": "0ac71229dd",
   "kr": "봉인의 땅까지 건너갈 수 있다네."
  },
  "48": {
   "jp": "3cf94c6c54",
   "kr": "짐이 가득해서"
  },
  "49": {
   "jp": "cb9777a89f",
   "kr": "카베사와 쿠엘포를 받을 수 없다."
  }
 }
}
