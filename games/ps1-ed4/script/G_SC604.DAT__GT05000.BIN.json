 "segments": {
  "0": {
   "jp": "921766275e",
   "kr": "베리어스 경",
   "auto": 1
  },
  "1": {
   "jp": "eb8fefb8c7",
   "kr": "얌전히 있으라고 했을 텐데."
  },
  "2": {
   "jp": "b0bde414ba",
   "kr": "역시 그렇게는 안 되었나 보군."
  },
  "3": {
   "jp": "b05049a278",
   "kr": "하지만 이제 와서 소란을 피워도 마찬가지다."
  },
  "4": {
   "jp": "6bea93be71",
   "kr": "아무것도 달라지지 않는다."
  },
  "5": {
   "jp": "9b0849bf73",
   "kr": "오크툼 신 부활의 의식은 모두 끝났다."
  },
  "6": {
   "jp": "6a27c2b754",
   "kr": "이 문 뒤에."
  },
  "7": {
   "jp": "6e3a3364b4",
   "kr": "인간이 유일하게 숭배해야 할 오크툼 신이"
  },
  "8": {
   "jp": "e1e0fbd779",
   "kr": "계시는 것이다."
  },
  "9": {
   "jp": "99e54e10c1",
   "kr": "그거 잘됐군."
  },
  "10": {
   "jp": "288febcb2e",
   "kr": "우리는 부활을 막으러 온 게 아니다."
  },
  "11": {
   "jp": "c1febcfc5f",
   "kr": "오크툼을 베러 온 거다."
  },
  "12": {
   "jp": "9eca1d1918",
   "kr": "헛소리를."
  },
  "13": {
   "jp": "95548dd64c",
   "kr": "말도 안 돼… 이런 흐름은 우주에 없다…"
  },
  "14": {
   "jp": "f52193c883",
   "kr": "이런 흐름이…"
  },
  "15": {
   "jp": "e6fedd85c0",
   "kr": "존재해서… 될 말인가…"
  },
  "16": {
   "jp": "4e3fb69e20",
   "kr": "나는… 이상으로 삼는 신의 모습을 구했을 뿐이다…"
  },
  "17": {
   "jp": "5931c84c0c",
   "kr": "지상에 신을 되살려…"
  },
  "18": {
   "jp": "c7d1933da3",
   "kr": "신을 느낄 수 있는 세계로 만들고 싶었다…"
  },
  "19": {
   "jp": "fcce5576a8",
   "kr": "어째서냐… 그것이 죄란 말인가…"
  },
  "20": {
   "jp": "147760685e",
   "kr": "어째서 그렇게까지…?"
  },
  "21": {
   "jp": "4ec10175a1",
   "kr": "내가 받은 계시는…"
  },
  "22": {
   "jp": "fdf3cb00c4",
   "kr": "사나운 신 오크툼을 부활시킴으로써…"
  },
  "23": {
   "jp": "8515d0ddd4",
   "kr": "세계에 조화를 가져오는 것이었다…"
  },
  "24": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "25": {
   "jp": "e03a90139a",
   "kr": "그렇군… 너도 진실의 섬에 건너갔구나…"
  },
  "26": {
   "jp": "207c13d1dd",
   "kr": "공포로 이끄느냐… 해방으로 이끄느냐…"
  },
  "27": {
   "jp": "dc356aa515",
   "kr": "그 차이일 뿐이라는 말인가…"
  },
  "28": {
   "jp": "295126c8fe",
   "kr": "그것도… 받아들이는 자의 마음에 달렸구나…"
  },
  "29": {
   "jp": "5f42176754",
   "kr": "좋다… 문을 지나가라."
  },
  "30": {
   "jp": "e8ec9c99bc",
   "kr": "그 답을 똑똑히 확인하여라!"
  }
 }
}
