{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02000C.BIN",
 "segments": {
  "0": {
   "jp": "09f27da976",
   "kr": "이 앞은 공장이야."
  },
  "1": {
   "jp": "cd1aa1d643",
   "kr": "견학자의 출입을"
  },
  "2": {
   "jp": "fa7a637d5f",
   "kr": "금지하는 건 아니지만"
  },
  "3": {
   "jp": "117ea4ef62",
   "kr": "위험한 곳도 많아."
  },
  "4": {
   "jp": "20e3b8ff9e",
   "kr": "부디 조심하고"
  },
  "5": {
   "jp": "2d8273e24e",
   "kr": "작업에 방해가 되지 않게 해 줘."
  },
  "6": {
   "jp": "f08e79e055",
   "kr": "루카네를 만나러 와 줬구나."
  },
  "7": {
   "jp": "1a426e2e63",
   "kr": "아쉽지만 제５용광로 수리가 끝날 때까지"
  },
  "8": {
   "jp": "7e27a26b22",
   "kr": "공장에는 들어갈 수 없어."
  },
  "9": {
   "jp": "324a7f1839",
   "kr": "또 기회가 있으면 들러 줘."
  },
  "10": {
   "jp": "52eba4ff4a",
   "kr": "지금은 용광로 점검을 하고 있어."
  },
  "11": {
   "jp": "b1cefcf029",
   "kr": "그것만 끝나면 자유롭게 견학할 수 있어."
  },
  "12": {
   "jp": "9ee4e4eb3d",
   "kr": "잠시만 기다려 주지 않겠어?"
  },
  "13": {
   "jp": "61e6d2250e",
   "kr": "라브로아!"
  },
  "14": {
   "jp": "4ac819a8d4",
   "kr": "용광로 점검은 끝났나!?"
  },
  "15": {
   "jp": "173fb29d2b",
   "kr": "너무 깐깐하게 굴지 말라고."
  },
  "16": {
   "jp": "2aa56a4b2e",
   "kr": "중요한 볼일이 생겨 버렸으니까!"
  },
  "17": {
   "jp": "9c5adf5930",
   "kr": "안 돼!"
  },
  "18": {
   "jp": "44868c68e6",
   "kr": "점검을 마치고 나서 가."
  },
  "19": {
   "jp": "cbf1c8bef8",
   "kr": "정말이지, 성실한 경비원이라니까."
  },
  "20": {
   "jp": "b2090caca3",
   "kr": "오."
  },
  "21": {
   "jp": "a27b5bfd9d",
   "kr": "너희 모험가지?"
  },
  "22": {
   "jp": "bf58484379",
   "kr": "곤란한 사람을 도와야 모험가지!"
  },
  "23": {
   "jp": "c9168a48f8",
   "kr": "뭘～, 걱정 없어."
  },
  "24": {
   "jp": "dc641507eb",
   "kr": "간단한 일이야."
  },
  "25": {
   "jp": "75aa3695b9",
   "kr": "점검이라고 해도 담당자에게 용광로 상태를"
  },
  "26": {
   "jp": "ffa6ba1159",
   "kr": "물어보고 다니기만 하면 되니까!"
  },
  "27": {
   "jp": "5f6e99688b",
   "kr": "하아…",
   "auto": 1
  },
  "28": {
   "jp": "e4674753a6",
   "kr": "좋았어, 정해졌네."
  },
  "29": {
   "jp": "114e582e36",
   "kr": "그럼 뒷일은 부탁한다!"
  },
  "30": {
   "jp": "2fdb722f83",
   "kr": "…정말 곤란한 녀석이야."
  },
  "31": {
   "jp": "277760e594",
   "kr": "이봐, 너희들."
  },
  "32": {
   "jp": "a12c45bc69",
   "kr": "미안하지만 용광로 점검을 도와주지 않겠어?"
  },
  "33": {
   "jp": "7c3c02811a",
   "kr": "빠질 수 없는 일이거든."
  },
  "34": {
   "jp": "7f894e0278",
   "kr": "라브로아가 말한 대로 일은 간단해."
  },
  "35": {
   "jp": "dd8d12e192",
   "kr": "보수도 확실히 준비할게."
  },
  "36": {
   "jp": "0ec22b3e3a",
   "kr": "자세한 건 저기 초소에 있는 사람이 설명해 줄 거야."
  },
  "37": {
   "jp": "d64c0a2b50",
   "kr": "갑작스러운 일이라 민폐겠지만 부탁할게."
  },
  "38": {
   "jp": "5f6e99688b",
   "kr": "하아…",
   "auto": 1
  },
  "39": {
   "jp": "2da9ca82d2",
   "kr": "마일도 사람 참 좋단 말이야…"
  },
  "40": {
   "jp": "a2bd2b14d1",
   "kr": "그런 건 아니지만."
  },
  "41": {
   "jp": "d158a47aed",
   "kr": "그렇게 막무가내로 부탁하는데… 거절할 수가 없잖아."
  },
  "42": {
   "jp": "cc00a5a626",
   "kr": "그런 걸 사람이 좋다고 하는 거야."
  },
  "43": {
   "jp": "a1f1196d1c",
   "kr": "너희도 봉변이었겠다."
  },
  "44": {
   "jp": "00ab87a8bf",
   "kr": "라브로아는 늘 저런 식이야."
  },
  "45": {
   "jp": "1df2224f93",
   "kr": "바로 일을 설명할게."
  },
  "46": {
   "jp": "5fcc2cc5f6",
   "kr": "공장에는 용광로가 ５개 있어."
  },
  "47": {
   "jp": "e600fa9046",
   "kr": "그 옆에 담당자가 있으니까"
  },
  "48": {
   "jp": "4c6e856def",
   "kr": "이상이 없는지 물어보고 와 줘."
  },
  "49": {
   "jp": "290c366bb5",
   "kr": "한 바퀴 돌고 나한테 보고하면 끝이야."
  },
  "50": {
   "jp": "4e917525fa",
   "kr": "간단한 일이지만"
  },
  "51": {
   "jp": "f649a86dbd",
   "kr": "게을리하면 큰 사고로 이어질 수 있는 중요한 일이야."
  },
  "52": {
   "jp": "63c082deae",
   "kr": "너희에게 무리하게 부탁했으니"
  },
  "53": {
   "jp": "e649deae98",
   "kr": "보수도 500로제 준비할게."
  },
  "54": {
   "jp": "adbaaa5f20",
   "kr": "힘내 줘."
  },
  "55": {
   "jp": "fd4b167a38",
   "kr": "라브로아."
  },
  "56": {
   "jp": "a8b401f676",
   "kr": "이번엔 똑바로 해라."
  },
  "57": {
   "jp": "69a9d1b43c",
   "kr": "예예."
  },
  "58": {
   "jp": "ccce3acfb0",
   "kr": "맡겨 두라니까."
  },
  "59": {
   "jp": "159e3f7e76",
   "kr": "미안하지만"
  },
  "60": {
   "jp": "6b690d774e",
   "kr": "용광로 점검을 도와주지 않겠어?"
  }
 }
}
