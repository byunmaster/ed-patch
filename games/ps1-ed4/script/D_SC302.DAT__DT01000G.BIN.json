{
 "archive": "/D/SC302.DAT",
 "member": "..\\BIN\\DT01000G.BIN",
 "segments": {
  "0": {
   "jp": "9103e32a9a",
   "kr": "응, 이쯤이면 됐어."
  },
  "1": {
   "jp": "5c3e06e79d",
   "kr": "그 아저씨 주사위, 사기인 거냐?"
  },
  "2": {
   "jp": "4de13d097a",
   "kr": "사기는 아니지만"
  },
  "3": {
   "jp": "99981d96d5",
   "kr": "속임수야."
  },
  "4": {
   "jp": "5764d49069",
   "kr": "응?"
  },
  "5": {
   "jp": "fd7c8d321d",
   "kr": "그 남자는 주사위 눈을 마음대로 낼 수 있어."
  },
  "6": {
   "jp": "e8338a350d",
   "kr": "장치 없이 손끝 하나로 말이지."
  },
  "7": {
   "jp": "7657b2e7a5",
   "kr": "처음에 주사위를 살펴보게 하는 것부터가"
  },
  "8": {
   "jp": "85a6cfd36e",
   "kr": "100퍼센트 자신이 없으면 못 해."
  },
  "9": {
   "jp": "381524bc49",
   "kr": "거짓말…"
  },
  "10": {
   "jp": "63909be4ae",
   "kr": "그럼 왜 이겼던 거야?"
  },
  "11": {
   "jp": "35d6954b57",
   "kr": "그게 수법이야."
  },
  "12": {
   "jp": "722c6f5abe",
   "kr": "처음에 몇 번 이기게 해 놓고"
  },
  "13": {
   "jp": "b1f2fe3262",
   "kr": "도박 맛을 들이게 하는 거지."
  },
  "14": {
   "jp": "5e1e066108",
   "kr": "판돈의 트릭을 눈치챘어?"
  },
  "15": {
   "jp": "20e97d5c9e",
   "kr": "그자는 절대 손해를 안 봐."
  },
  "16": {
   "jp": "b88617f94b",
   "kr": "어째서?"
  },
  "17": {
   "jp": "9d432e90d8",
   "kr": "판돈은 갈수록 두 배씩 올라갔지?"
  },
  "18": {
   "jp": "fa7228b1dc",
   "kr": "몇 번을 져도 마지막 한 번만 이기면"
  },
  "19": {
   "jp": "8bbed2b074",
   "kr": "손해는 되찾을 수 있어."
  },
  "20": {
   "jp": "af5764b84d",
   "kr": "음…"
  },
  "21": {
   "jp": "8b56ce829d",
   "kr": "첫 판이 10로제, 다음이 20로제, 40로제…"
  },
  "22": {
   "jp": "156c24e60a",
   "kr": "합쳐서 70로제."
  },
  "23": {
   "jp": "507c688e60",
   "kr": "다음 판돈은 40의 두 배인 80로제."
  },
  "24": {
   "jp": "d6c25c720b",
   "kr": "여기서 이기면…"
  },
  "25": {
   "jp": "a737635929",
   "kr": "진짜다, 전부 되찾을 수 있어!"
  },
  "26": {
   "jp": "74dd0dafba",
   "kr": "그렇지?"
  },
  "27": {
   "jp": "cfdde31ab4",
   "kr": "하지만 무서운 건 이제부터야."
  },
  "28": {
   "jp": "4c129f794f",
   "kr": "딴 돈을 전부 도로 뺏겼지만"
  },
  "29": {
   "jp": "e928fb17a4",
   "kr": "진 횟수는 겨우 한 번이야."
  },
  "30": {
   "jp": "e7a8107097",
   "kr": "그래서 다음 승부를 걸어."
  },
  "31": {
   "jp": "77ee433a6e",
   "kr": "거기서 지면"
  },
  "32": {
   "jp": "cd87a294d3",
   "kr": "지금까지 오간 돈의 두 배를 뜯기게 돼."
  },
  "33": {
   "jp": "d753a0f709",
   "kr": "그런데 진 횟수는 아직 2번에 불과하니까…"
  },
  "34": {
   "jp": "e3df514d09",
   "kr": "반복하면 점점 뺏기게 되잖아!"
  },
  "35": {
   "jp": "c02437532d",
   "kr": "엄청난 사기구나!!"
  },
  "36": {
   "jp": "f466eb0e2f",
   "kr": "이래선 절대 이길 수가 없어."
  },
  "37": {
   "jp": "c8f3fba8c5",
   "kr": "스투프 씨의 상품도 되찾을 수 없고."
  },
  "38": {
   "jp": "5dc4ccec94",
   "kr": "그런 셈이지."
  },
  "39": {
   "jp": "01973deb8b",
   "kr": "…남은 건 훔쳐 내는 것 정도려나…"
  },
  "40": {
   "jp": "edba7ea775",
   "kr": "음?"
  },
  "41": {
   "jp": "5a43021ff8",
   "kr": "왜 그래?"
  },
  "42": {
   "jp": "2187690d0b",
   "kr": "뭔가 냄새가 나… 이 달콤한 냄새!"
  },
  "43": {
   "jp": "4d9ded2088",
   "kr": "라즈베리야!"
  },
  "44": {
   "jp": "50ffed8cea",
   "kr": "지미냐?"
  },
  "45": {
   "jp": "b8a8c3f5c9",
   "kr": "헤헤헤, 들켰나."
  },
  "46": {
   "jp": "521dae10c2",
   "kr": "누님한텐 못 당하겠네."
  },
  "47": {
   "jp": "7a3de7cb36",
   "kr": "당연하지."
  },
  "48": {
   "jp": "d870269988",
   "kr": "달콤한 냄새를 풀풀 풍기는데."
  },
  "49": {
   "jp": "8796d9bf6e",
   "kr": "이런 데서 뭐 하는 거야?"
  },
  "50": {
   "jp": "8f02c45fad",
   "kr": "아니이, 누님 모습이 보이기에 말이죠."
  },
  "51": {
   "jp": "eb21d304b6",
   "kr": "인사나 드릴까 해서요."
  },
  "52": {
   "jp": "df595265ee",
   "kr": "거짓말 마."
  },
  "53": {
   "jp": "a99f2af263",
   "kr": "사실은 나를 감시하고 있었지?"
  },
  "54": {
   "jp": "2227eda7da",
   "kr": "내가 이 마을을 떠나길 기다렸다가"
  },
  "55": {
   "jp": "0305b665b8",
   "kr": "일을 벌이려는 거지."
  },
  "56": {
   "jp": "3f9ee44862",
   "kr": "그, 그건 너무하십니다."
  },
  "57": {
   "jp": "a52f132d38",
   "kr": "말씀이 너무하시네요!"
  },
  "58": {
   "jp": "b57237d05d",
   "kr": "저는 누님의 아름다운 모습에 끌려서…"
  },
  "59": {
   "jp": "b18b098249",
   "kr": "바보.",
   "auto": 1
  },
  "60": {
   "jp": "b522570eb2",
   "kr": "…그래도 마침 잘 만났어."
  },
  "61": {
   "jp": "256ddd249e",
   "kr": "지미, 부탁할 일이 있는데."
  },
  "62": {
   "jp": "f7ef3b0670",
   "kr": "예예, 알고 있습죠."
  },
  "63": {
   "jp": "0fd938153c",
   "kr": "사기꾼을 혼내 주자는 거죠?"
  },
  "64": {
   "jp": "18c143b354",
   "kr": "뭐야, 너."
  },
  "65": {
   "jp": "421e215408",
   "kr": "알고 있는 거야?"
  },
  "66": {
   "jp": "3356e35fe1",
   "kr": "그럼요."
  },
  "67": {
   "jp": "db8b485024",
   "kr": "누님은 딱 붙어서 감시하고…"
  },
  "68": {
   "jp": "9d959c90d5",
   "kr": "아이고…"
  },
  "69": {
   "jp": "41fd35571b",
   "kr": "본심이 나왔네."
  },
  "70": {
   "jp": "eb20c2be3c",
   "kr": "뭐, 오늘은 봐 줄게."
  },
  "71": {
   "jp": "1f4f3e56d3",
   "kr": "얼른 가서"
  },
  "72": {
   "jp": "adf2ab97c7",
   "kr": "스투프 씨의 상품을 찾아다 줘."
  },
  "73": {
   "jp": "2876de5eaa",
   "kr": "헤헤헤, 그쯤이야 식은 죽 먹기죠."
  },
  "74": {
   "jp": "1636eb74bf",
   "kr": "근데 누님, 그것만으로 괜찮겠습니까?"
  },
  "75": {
   "jp": "6b3dba2713",
   "kr": "그 사기꾼을 혼내 주지 않아도요?"
  },
  "76": {
   "jp": "3686f8140d",
   "kr": "그건 무슨 말이야?"
  },
  "77": {
   "jp": "38408c404e",
   "kr": "선량한 사람 물건을 속여 뺏다니"
  },
  "78": {
   "jp": "6a5a8cfaf9",
   "kr": "용서할 수 없는 악당입니다."
  },
  "79": {
   "jp": "61b39a172b",
   "kr": "저런 놈을 내버려 두면 안 됩니다요."
  },
  "80": {
   "jp": "48b1fcfd9d",
   "kr": "네 입에서 나올 말 같지 않네."
  },
  "81": {
   "jp": "b0fc5c5f9a",
   "kr": "세상엔 의리라는 게 있다고요!"
  },
  "82": {
   "jp": "5e3382fc57",
   "kr": "빼앗아선 안 될 데서는 빼앗지 않습니다!"
  },
  "83": {
   "jp": "9f3fe0569e",
   "kr": "…저한테 좋은 생각이 있는데요."
  },
  "84": {
   "jp": "6439d18ac3",
   "kr": "잠깐 귀 좀…"
  },
  "85": {
   "jp": "634a595ba1",
   "kr": "지미는 루키어스에게 귓속말을 했다."
  },
  "86": {
   "jp": "483d9ef9fe",
   "kr": "…과연!"
  },
  "87": {
   "jp": "0b3fab3068",
   "kr": "그거 재미있겠네."
  },
  "88": {
   "jp": "1d920c5cc8",
   "kr": "그렇죠, 그렇죠?"
  },
  "89": {
   "jp": "95cb023b82",
   "kr": "그럼 저는 먼저 가 있겠습니다."
  },
  "90": {
   "jp": "7a3d8fc8cd",
   "kr": "누님들은 호구인 척하고 오세요."
  },
  "91": {
   "jp": "866ce15da1",
   "kr": "이봐, 뭐 하는 거냐?"
  },
  "92": {
   "jp": "c184c57e6c",
   "kr": "남의 물건에 손대면 안 되지?"
  },
  "93": {
   "jp": "54a20446c9",
   "kr": "스투프의 상품을 손에 넣었다."
  },
  "94": {
   "jp": "e8a8cb26f9",
   "kr": "스투프의 상품을 발견했다."
  },
  "95": {
   "jp": "a3d2902742",
   "kr": "하지만 소지품이 가득 차서"
  },
  "96": {
   "jp": "247f360a7a",
   "kr": "더 이상 아이템을 가질 수 없다."
  },
  "97": {
   "jp": "0819d1229c",
   "kr": "선반에는 별다른 물건이"
  },
  "98": {
   "jp": "0898f1b5b3",
   "kr": "놓여 있지 않다."
  },
  "99": {
   "jp": "b65aeada3c",
   "kr": "선반에 짐이 몇 개 놓여 있지만"
  },
  "100": {
   "jp": "59014d90cb",
   "kr": "별다른 물건은 없다."
  },
  "101": {
   "jp": "ace540e29f",
   "kr": "여어, 어빈 군!"
  },
  "102": {
   "jp": "71f2edd6ad",
   "kr": "내 짐을 되찾아 줬다며?"
  },
  "103": {
   "jp": "1399903453",
   "kr": "벌써 알고 있어?"
  },
  "104": {
   "jp": "bf5b84695d",
   "kr": "아까 남자아이가 알려 줬어."
  },
  "105": {
   "jp": "dd4cac843e",
   "kr": "내 짐은 어디 있지?"
  },
  "106": {
   "jp": "641fe99a23",
   "kr": "어빈은 스투프에게 짐을 건넸다."
  },
  "107": {
   "jp": "27049f5e92",
   "kr": "아, 이거, 이거, 이거야!"
  },
  "108": {
   "jp": "92682c9218",
   "kr": "다행이다, 드디어 돌아갈 수 있겠어!"
  },
  "109": {
   "jp": "997ed5a537",
   "kr": "고마워, 어빈 군."
  },
  "110": {
   "jp": "27049f5e92",
   "kr": "아, 이거, 이거, 이거야!"
  },
  "111": {
   "jp": "0387689096",
   "kr": "고마워, 어빈 군!"
  },
  "112": {
   "jp": "f8411402b9",
   "kr": "이번에 혼났으니"
  },
  "113": {
   "jp": "0cc72099bd",
   "kr": "다시는 도박 같은 데 손대지 마."
  },
  "114": {
   "jp": "0e6a60e3e9",
   "kr": "명심하겠어."
  },
  "115": {
   "jp": "adaccb9415",
   "kr": "…아, 맞다, 깜빡할 뻔했네."
  },
  "116": {
   "jp": "593335b656",
   "kr": "당신, 루키어스 씨 맞지?"
  },
  "117": {
   "jp": "164c4f5e0e",
   "kr": "그런데?"
  },
  "118": {
   "jp": "f06a8d1c14",
   "kr": "아까 그 남자아이한테 편지를 맡았거든."
  },
  "119": {
   "jp": "20501b1a54",
   "kr": "이거."
  },
  "120": {
   "jp": "6688d0238d",
   "kr": "스투프는 루키어스에게 편지를 건넸다."
  },
  "121": {
   "jp": "6db6889c8e",
   "kr": "자, 이제 돌아갈 수 있겠다."
  },
  "122": {
   "jp": "652e58282a",
   "kr": "여러분, 건강하세요."
  },
  "123": {
   "jp": "f2fd86c61b",
   "kr": "정말 고마워요."
  },
  "124": {
   "jp": "aae44f7a86",
   "kr": "정신없는 남자네…"
  },
  "125": {
   "jp": "44fc675d16",
   "kr": "앞날이 걱정돼."
  },
  "126": {
   "jp": "2e8ef4af0c",
   "kr": "저기, 루키어스."
  },
  "127": {
   "jp": "856052da37",
   "kr": "편지에 뭐라고 쓰여 있어?"
  },
  "128": {
   "jp": "4b011d5485",
   "kr": "남자아이라면 지미 아니야?"
  },
  "129": {
   "jp": "4760f901e2",
   "kr": "루키어스는 편지를 열었다."
  },
  "130": {
   "jp": "3f87e8ff84",
   "kr": "보여 줘."
  },
  "131": {
   "jp": "a5eed8a765",
   "kr": "…음, 그러니까…"
  },
  "132": {
   "jp": "d7b3f3b74d",
   "kr": "《사랑하는 누님께》"
  },
  "133": {
   "jp": "54ee93cb10",
   "kr": "이건 그 사기꾼의 돈입니다."
  },
  "134": {
   "jp": "95ca19ffb8",
   "kr": "제가 빼앗아 두었습니다."
  },
  "135": {
   "jp": "c07574d60a",
   "kr": "사실은 10000로제쯤 있었는데"
  },
  "136": {
   "jp": "cfef33222b",
   "kr": "약간 수고비를 받았습니다."
  },
  "137": {
   "jp": "35690d6f72",
   "kr": "좋아하는 누님께, 사랑을 담아."
  },
  "138": {
   "jp": "03e0a1c72c",
   "kr": "지미 올림"
  },
  "139": {
   "jp": "bf8c723fb7",
   "kr": "8000로제를 손에 넣었다."
  },
  "140": {
   "jp": "29241dfa26",
   "kr": "…그 녀석도 참."
  },
  "141": {
   "jp": "a498783583",
   "kr": "2000로제나 떼먹고."
  },
  "142": {
   "jp": "cab47681b3",
   "kr": "재밌는 녀석이야."
  },
  "143": {
   "jp": "4aeb8f2095",
   "kr": "분명 지금쯤"
  },
  "144": {
   "jp": "07cf9027a3",
   "kr": "라즈베리 파이를 배 터지게 먹고 있겠지."
  }
 }
