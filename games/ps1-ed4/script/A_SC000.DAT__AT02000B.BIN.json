{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02000B.BIN",
 "segments": {
  "0": {
   "jp": "2dd414715c",
   "kr": "거의 돈은 안 되지만"
  },
  "1": {
   "jp": "064f8140b5",
   "kr": "바쁘지 않다면 맡아 봐도 좋지 않을까?"
  },
  "2": {
   "jp": "fdcefc9be7",
   "kr": "데이지 씨는 용 동상이 있는 작은 공원에 있어."
  },
  "3": {
   "jp": "e2bdfcc2b6",
   "kr": "먼 곳으로 가는 일이지만"
  },
  "4": {
   "jp": "d43518b1b3",
   "kr": "일 자체는 그렇게 어렵지 않아요."
  },
  "5": {
   "jp": "e32148de5a",
   "kr": "편지 한 통을 전하기만 하면 돼요."
  },
  "6": {
   "jp": "8d360d6b49",
   "kr": "로벨 씨 댁에 가서"
  },
  "7": {
   "jp": "085360080b",
   "kr": "편지를 받으면"
  },
  "8": {
   "jp": "83b41ed81a",
   "kr": "받을 사람을 알려 줄 거예요."
  },
  "9": {
   "jp": "0d5fd6f4d8",
   "kr": "로벨 씨 댁은"
  },
  "10": {
   "jp": "637a59895e",
   "kr": "마법 길드 옆집 지하이니"
  },
  "11": {
   "jp": "50d6b56f75",
   "kr": "착각하지 않도록 해."
  },
  "12": {
   "jp": "69ddf6e295",
   "kr": "케이트는 얀크 씨의 조카인데"
  },
  "13": {
   "jp": "b9e86b847b",
   "kr": "필딘에는 처음 왔대요."
  },
  "14": {
   "jp": "58bbd20ec8",
   "kr": "이 도시는 크니까"
  },
  "15": {
   "jp": "b3a583f478",
   "kr": "오자마자 길을 잃은 모양이야."
  },
  "16": {
   "jp": "ca8d4c1f90",
   "kr": "케이트의 특징에 대해서는"
  },
  "17": {
   "jp": "71ab8515f9",
   "kr": "얀크 씨에게 들어."
  },
  "18": {
   "jp": "f7399b3950",
   "kr": "얀크 씨 집은 저기 다리를 건넌 곳."
  },
  "19": {
   "jp": "e24ffd3886",
   "kr": "무기점 뒤쪽이야."
  },
  "20": {
   "jp": "9c60083460",
   "kr": "케이트와 얀크 씨 일은 기억하고 있어?"
  },
  "21": {
   "jp": "88455bae01",
   "kr": "이번에는 케이트의 의뢰야."
  },
  "22": {
   "jp": "e0d5800371",
   "kr": "얀크 씨가 없어졌대요."
  },
  "23": {
   "jp": "fbef40993b",
   "kr": "그 둘, 술래잡기라도 하듯이"
  },
  "24": {
   "jp": "6ebacdd1f3",
   "kr": "계속 엇갈리고 있네요."
  },
  "25": {
   "jp": "9c4a5a2d85",
   "kr": "시간이 있다면 찾아 주면 어때?"
  },
  "26": {
   "jp": "0afaef4ff6",
   "kr": "얀크 씨 집에서 케이트가 기다리고 있어."
  },
  "27": {
   "jp": "86c9a7681d",
   "kr": "도구점에서 외상으로 물건을 사 놓고"
  },
  "28": {
   "jp": "438f6bf781",
   "kr": "전혀 갚지 않는 사람이 있대요."
  },
  "29": {
   "jp": "51fb899595",
   "kr": "밀린 외상값을"
  },
  "30": {
   "jp": "ebf23315f8",
   "kr": "수금해 달라는 의뢰야."
  },
  "31": {
   "jp": "de4870e369",
   "kr": "자세한 건 도구점 안주인에게 물어보세요."
  },
  "32": {
   "jp": "3ab9dcac3f",
   "kr": "릭이 너무 심한 장난을 쳐서"
  },
  "33": {
   "jp": "2b59e9c000",
   "kr": "마리카도 화가 나서 꽤 야단을 친 모양이야."
  },
  "34": {
   "jp": "7eb4d4c088",
   "kr": "가출은 늘 있는 일이라고 생각했는데"
  },
  "35": {
   "jp": "541e11864c",
   "kr": "이번에는 좀처럼 돌아오지 않아요."
  },
  "36": {
   "jp": "2034e9d299",
   "kr": "마리카도 걱정돼서 잠을 못 잔대."
  },
  "37": {
   "jp": "4e7157892d",
   "kr": "이 의뢰 전에 마리카에게 가서 탐문해 줘."
  },
  "38": {
   "jp": "185efe6abb",
   "kr": "마리카의 집은 보른 방면 출구 근처야."
  },
  "39": {
   "jp": "e2bdfcc2b6",
   "kr": "먼 곳으로 가는 일이지만"
  },
  "40": {
   "jp": "d43518b1b3",
   "kr": "일 자체는 그렇게 어렵지 않아요."
  },
  "41": {
   "jp": "e32148de5a",
   "kr": "편지 한 통을 전하기만 하면 돼요."
  },
  "42": {
   "jp": "ce34ef6c9e",
   "kr": "카르 할아버지 댁에 가서"
  },
  "43": {
   "jp": "085360080b",
   "kr": "편지를 받으면"
  },
  "44": {
   "jp": "83b41ed81a",
   "kr": "수취인을 들을 수 있어요."
  },
  "45": {
   "jp": "969e24d1b0",
   "kr": "애정이 듬뿍 담긴 소포예요."
  },
  "46": {
   "jp": "ee70b33cdf",
   "kr": "조금 먼 곳으로 가는 일이지만"
  },
  "47": {
   "jp": "08949a6555",
   "kr": "받는 분이 기뻐하는 얼굴이 눈에 선하네요."
  },
  "48": {
   "jp": "3a1ac0608e",
   "kr": "밀튼 씨 댁에 가서 짐을 맡으면"
  },
  "49": {
   "jp": "c771dec662",
   "kr": "자세한 수취인을 들을 수 있어요."
  },
  "50": {
   "jp": "79d028d9f2",
   "kr": "요즘 질 나쁜 마수가 나와요."
  },
  "51": {
   "jp": "347b20e6fa",
   "kr": "꽤 만만치 않은 마수니까"
  },
  "52": {
   "jp": "1ae45ec067",
   "kr": "실력에 자신이 없다면 그만두는 편이 좋아요."
  },
  "53": {
   "jp": "50cd4a083a",
   "kr": "혹시 흑마법을 쓰는 동료가 있다면"
  },
  "54": {
   "jp": "a4dd10794a",
   "kr": "조금은 편하게 싸울 수 있을지도 모르지만요."
  },
  "55": {
   "jp": "4581a2fbe8",
   "kr": "개 산책만으로 이만큼 받을 수 있다니"
  },
  "56": {
   "jp": "5fc5610fc7",
   "kr": "달리 없지 않을까."
  },
  "57": {
   "jp": "f8a6c0c729",
   "kr": "빈센 씨 집에 가서"
  },
  "58": {
   "jp": "f446c10d1f",
   "kr": "개를 산책시키기만 하면 되니까"
  },
  "59": {
   "jp": "5059d17990",
   "kr": "편한 일이야."
  },
  "60": {
   "jp": "df3e75aba4",
   "kr": "관심이 있다면"
  },
  "61": {
   "jp": "9f152ec054",
   "kr": "빈센 씨 집에 가 봐."
  },
  "62": {
   "jp": "79d028d9f2",
   "kr": "요즘 질 나쁜 마수가 나와요."
  },
  "63": {
   "jp": "15709d72af",
   "kr": "꽤 만만치 않은 마수니까"
  },
  "64": {
   "jp": "aa7b39a3f6",
   "kr": "실력에 자신이 없다면 그만두는 편이 좋을지도 몰라요."
  },
  "65": {
   "jp": "d555bdcf18",
   "kr": "짐을 나르기만 하는 간단한 일이야."
  },
  "66": {
   "jp": "a947f4968c",
   "kr": "짐과 수취인은 타크 씨에게 물어봐."
  },
  "67": {
   "jp": "2514ebce44",
   "kr": "타크 씨는 소드 길드에 있어."
  },
  "68": {
   "jp": "d555bdcf18",
   "kr": "짐을 나르기만 하는 간단한 일이야."
  },
  "69": {
   "jp": "5eea0f4778",
   "kr": "짐과 수취인은 노이에게 물어봐."
  },
  "70": {
   "jp": "c2ec58263a",
   "kr": "노이의 집은 여기서 북쪽으로 가다가"
  },
  "71": {
   "jp": "819c9c2020",
   "kr": "소드 길드에서 서쪽으로 꺾으면 바로야."
  },
  "72": {
   "jp": "7ee5560087",
   "kr": "샴실단은 뭘 꾸몄는지"
  },
  "73": {
   "jp": "36b5b856fa",
   "kr": "왕성에서 고문서를 훔쳐 갔어."
  },
  "74": {
   "jp": "1b18008766",
   "kr": "고문서의 내용은 밝혀지지 않았지만"
  },
  "75": {
   "jp": "4199ec33a7",
   "kr": "샴실단이 악용하게 둬서는"
  },
  "76": {
   "jp": "0b8d6022ef",
   "kr": "안 된다는 것만은 확실해."
  },
  "77": {
   "jp": "9d1b5e1d78",
   "kr": "샴실단은 지지키 동굴에"
  },
  "78": {
   "jp": "aea6670979",
   "kr": "잠복해 있는 모양이야."
  },
  "79": {
   "jp": "b91ba2b2d3",
   "kr": "한시라도 빨리 고문서를 되찾아야 해."
  },
  "80": {
   "jp": "543c06b275",
   "kr": "사파이어, 루비, 자수정 같은 원석을"
  },
  "81": {
   "jp": "03e3d40748",
   "kr": "채집하는 일이에요."
  },
  "82": {
   "jp": "1799d60648",
   "kr": "보석에 밝은 동료가 없으면"
  },
  "83": {
   "jp": "d60aa366e4",
   "kr": "원하는 원석을"
  },
  "84": {
   "jp": "082a165357",
   "kr": "찾지 못할지도 몰라요."
  },
  "85": {
   "jp": "cdadca7b0c",
   "kr": "꽤 머리를 써야 하는 일인 모양이에요."
  },
  "86": {
   "jp": "fd6dc36a14",
   "kr": "어지간히"
  },
  "87": {
   "jp": "e22460b31f",
   "kr": "박식한 동료라도 있다면 다르겠지만요…"
  },
  "88": {
   "jp": "659a3fdae1",
   "kr": "도서관에 가면 박사님께 자세한 내용을 들을 수 있어요."
  },
  "89": {
   "jp": "af97504892",
   "kr": "코레트 씨는 필딘에서도 소문난 미인이야."
  },
  "90": {
   "jp": "42f9d8ef7c",
   "kr": "슬슬 혼기가 됐고"
  },
  "91": {
   "jp": "f23aa53bd9",
   "kr": "아버님 오울 씨도 무척 아꼈어."
  },
  "92": {
   "jp": "45222cf778",
   "kr": "그런데 얼마 전 갑자기 모습을 감춰 버렸어요."
  },
  "93": {
   "jp": "cbb0ac1a27",
   "kr": "연인이 부른 듯한"
  },
  "94": {
   "jp": "439e00b8bd",
   "kr": "편지 한 통을 남기고."
  },
  "95": {
   "jp": "c0109b3e93",
   "kr": "수수께끼 풀이에 자신이 있다면"
  },
  "96": {
   "jp": "7b289c5273",
   "kr": "꼭 맡아 줬으면 하는 일이야."
  },
  "97": {
   "jp": "7379da3335",
   "kr": "요즘 사신관이 왕성 주변에"
  },
  "98": {
   "jp": "bc7f270455",
   "kr": "나타나는 모양이야."
  },
  "99": {
   "jp": "f83d0c1a88",
   "kr": "사신관의 목적은 알 수 없지만"
  },
  "100": {
   "jp": "057b16d8de",
   "kr": "왕가에 위험이 미치면 안 되니까요."
  },
  "101": {
   "jp": "48288e6553",
   "kr": "서둘러 사신관을 찾아내"
  },
  "102": {
   "jp": "c57c240843",
   "kr": "쓰러뜨려 주셨으면 해요."
  },
  "103": {
   "jp": "509faccec1",
   "kr": "킬 노인은 디너켄 님을"
  },
  "104": {
   "jp": "774798919c",
   "kr": "존경하셔서 한 번 찾아뵙고 싶다고"
  },
  "105": {
   "jp": "1c3df92ce9",
   "kr": "예전부터 말씀하셨대요."
  },
  "106": {
   "jp": "55dbbc7017",
   "kr": "그래서 마침내 방문하기로 마음먹고"
  },
  "107": {
   "jp": "685af9feb3",
   "kr": "출발한 것까지는 좋았는데"
  },
  "108": {
   "jp": "8a11d7fbee",
   "kr": "언제까지고 돌아오지 않는대요."
  },
  "109": {
   "jp": "6831f9cea1",
   "kr": "아마 "
  },
  "110": {
   "jp": "a02431cf7c",
   "kr": "에서 "
  },
  "111": {
   "jp": "c7b1be8804",
   "kr": "헤매고 있을 거예요."
  },
  "112": {
   "jp": "82b7bbf27d",
   "kr": "그래서 "
  },
  "113": {
   "jp": "6915c698c4",
   "kr": "에서부터 킬 노인을"
  },
  "114": {
   "jp": "619e901216",
   "kr": "찾아내 줬으면 해."
  },
  "115": {
   "jp": "9d381a03db",
   "kr": "알선소 의뢰로 움직이는 남자에게서"
  },
  "116": {
   "jp": "105fc0dd01",
   "kr": "어떤 짐을 받아"
  },
  "117": {
   "jp": "b668507c60",
   "kr": "알선소로 가져오세요."
  },
  "118": {
   "jp": "afdc54626c",
   "kr": "짐이 무엇인지는 알려 드릴 수 없어요."
  },
  "119": {
   "jp": "eccc9e6522",
   "kr": "남자는 보석 채굴장 입구에서 기다리고 있어요."
  },
  "120": {
   "jp": "75506c3a94",
   "kr": "케이트가 삼촌인 얀크 씨와 싸우고"
  },
  "121": {
   "jp": "06dffc96b4",
   "kr": "집을 뛰쳐나갔대요."
  },
  "122": {
   "jp": "60075cce99",
   "kr": "지지키 동굴로 들어가는 케이트를"
  },
  "123": {
   "jp": "9cc5e42e6f",
   "kr": "친구 릭이 봤다고 해요."
  },
  "124": {
   "jp": "0a088e3b21",
   "kr": "본인은 가출 생각이어도 서둘러 구하지 않으면"
  },
  "125": {
   "jp": "239d841769",
   "kr": "마수에게 습격당할지도 몰라요."
  },
  "126": {
   "jp": "6d9e99d285",
   "kr": "최근 보석 채굴장의 마수가"
  },
  "127": {
   "jp": "f1f8df082e",
   "kr": "흉포해졌어."
  },
  "128": {
   "jp": "4e026816d7",
   "kr": "갱도 안에서 오도 가도 못하는 광부도 있어요."
  },
  "129": {
   "jp": "fbc11bfcc0",
   "kr": "한시라도 빨리 구출해 줘."
  },
  "130": {
   "jp": "6e151d7e02",
   "kr": "바쁘지 않다면"
  },
  "131": {
   "jp": "703421cecb",
   "kr": "맡아 봐도 좋지 않을까?"
  },
  "132": {
   "jp": "fdf2c2c35a",
   "kr": "이 의뢰를 맡기 전에"
  },
  "133": {
   "jp": "d94b63ba6a",
   "kr": "마리카에게 가서 탐문해 줘."
  }
 }
}
