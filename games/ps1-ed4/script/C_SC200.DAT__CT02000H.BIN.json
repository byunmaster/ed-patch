{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02000H.BIN",
 "segments": {
  "0": {
   "jp": "5448347594",
   "kr": "저기요."
  },
  "1": {
   "jp": "8fd01f6e53",
   "kr": "잠깐 괜찮을까요?"
  },
  "2": {
   "jp": "2911b83cc9",
   "kr": "대단히 죄송하지만"
  },
  "3": {
   "jp": "23d5fca963",
   "kr": "짐 검사를 하겠습니다."
  },
  "4": {
   "jp": "edd14d2ac9",
   "kr": "샴실단 끄나풀이"
  },
  "5": {
   "jp": "1580dc3ac4",
   "kr": "이 마을에 있다는 정보가 들어와서요."
  },
  "6": {
   "jp": "c44a10133b",
   "kr": "아무래도 이 마을을 거쳐"
  },
  "7": {
   "jp": "266d89f8a4",
   "kr": "장물이 운반되고 있는 모양입니다."
  },
  "8": {
   "jp": "7ccdf32739",
   "kr": "잠깐 짐을 보여 주실 수 있겠습니까?"
  },
  "9": {
   "jp": "018906f25a",
   "kr": "짐을 보여 주시겠습니까?"
  },
  "10": {
   "jp": "3310317f13",
   "kr": "맡아 둔 짐도 있어."
  },
  "11": {
   "jp": "5db595fbd7",
   "kr": "멋대로 보여 줄 수는 없어."
  },
  "12": {
   "jp": "a0a7b2bb58",
   "kr": "죄송하지만 규칙입니다."
  },
  "13": {
   "jp": "2a4d122c43",
   "kr": "아니면"
  },
  "14": {
   "jp": "8cfb41134c",
   "kr": "보여 줄 수 없는 물건을 맡아 두셨습니까?"
  },
  "15": {
   "jp": "36718f9177",
   "kr": "실례지만 열어 보겠습니다."
  },
  "16": {
   "jp": "ca21ee3033",
   "kr": "관리는 지작의 짐을 열었다."
  },
  "17": {
   "jp": "1b96909944",
   "kr": "…음?"
  },
  "18": {
   "jp": "aebe99ab2c",
   "kr": "이건."
  },
  "19": {
   "jp": "ee6f935551",
   "kr": "맡아 둔 거야."
  },
  "20": {
   "jp": "4282bc1dd6",
   "kr": "함부로 만지지 말아 줘."
  },
  "21": {
   "jp": "0e4f3c2355",
   "kr": "…호, 맡아 둔 거라고?"
  },
  "22": {
   "jp": "6b75616135",
   "kr": "변명치고는 영 시원찮군."
  },
  "23": {
   "jp": "de29c2ebb6",
   "kr": "하고 싶은 말이 뭐야?"
  },
  "24": {
   "jp": "ce5cc5f1f8",
   "kr": "시치미 떼지 마라!"
  },
  "25": {
   "jp": "18453edc63",
   "kr": "잡았다, 샴실단!"
  },
  "26": {
   "jp": "947477f01e",
   "kr": "뭐라고!"
  },
  "27": {
   "jp": "b072b2d9b4",
   "kr": "말도 안 돼!"
  },
  "28": {
   "jp": "d23250975c",
   "kr": "말도 안 되는 건 이쪽이다."
  },
  "29": {
   "jp": "6bc54d18b9",
   "kr": "수배된 물건을 가지고 있으면서"
  },
  "30": {
   "jp": "0db5a5f30b",
   "kr": "발뺌할 수 있을 것 같으냐!"
  },
  "31": {
   "jp": "60f0f52e05",
   "kr": "이건 알선소 일이야."
  },
  "32": {
   "jp": "98fdcd493a",
   "kr": "지작이라는 남자한테 맡아서"
  },
  "33": {
   "jp": "6de5c59e8d",
   "kr": "바로아에 전해 주기로 되어 있어!"
  },
  "34": {
   "jp": "0dbe5a482e",
   "kr": "닥쳐!!"
  },
  "35": {
   "jp": "749b355c3b",
   "kr": "체포한다!!"
  },
  "36": {
   "jp": "62acc214bb",
   "kr": "…그러니까, 어떻게 해야 알아듣겠어."
  },
  "37": {
   "jp": "310d32fc41",
   "kr": "우리는 의뢰를 받았을 뿐이야."
  },
  "38": {
   "jp": "676cfc377e",
   "kr": "현행범이면서 아직도 시치미를 떼는 거냐."
  },
  "39": {
   "jp": "3349a82145",
   "kr": "나는 범인이 아니야!"
  },
  "40": {
   "jp": "53987320ac",
   "kr": "그래, 알았다, 알았어."
  },
  "41": {
   "jp": "2a0e2b4a8b",
   "kr": "그런 변명은 장관님께 해 봐라."
  },
  "42": {
   "jp": "287205858a",
   "kr": "금방 거짓말이라고 밝혀 주실 테니까."
  },
  "43": {
   "jp": "e81fd47f6d",
   "kr": "앗, 장관님, 기다리고 있었습니다."
  },
  "44": {
   "jp": "0dc23b3733",
   "kr": "보십시오. 이놈들이 범인입니다."
  },
  "45": {
   "jp": "f5ce42779c",
   "kr": "아니, 아니.",
   "auto": 1
  },
  "46": {
   "jp": "b81760763e",
   "kr": "잠깐 기다리게."
  },
  "47": {
   "jp": "47258380b6",
   "kr": "방금 알선소에서 연락이 왔네.",
   "merge": 1
  },
  "48": {
   "jp": "665a6bdfb8",
   "kr": "어빈이라는 인물이 짐 운반 의뢰를 맡았다는 것이"
  },
  "49": {
   "jp": "5bd281f019",
   "kr": "증명되었네."
  },
  "50": {
   "jp": "5764d49069",
   "kr": "예?"
  },
  "51": {
   "jp": "d8e04e8a24",
   "kr": "그, 그게 무슨 말씀이십니까?"
  },
  "52": {
   "jp": "7b2290a1f9",
   "kr": "여기 있는 이들은 무고한 사람들일세."
  },
  "53": {
   "jp": "2f622bbfb6",
   "kr": "이제야 알아줬군."
  },
  "54": {
   "jp": "c5cd154252",
   "kr": "미안하게 됐네."
  },
  "55": {
   "jp": "59789afe32",
   "kr": "워낙 그 도적 샴실단이"
  },
  "56": {
   "jp": "73ab5b6eaa",
   "kr": "또다시 새로운 범행을 저지르려 하고 있네."
  },
  "57": {
   "jp": "e88119c75d",
   "kr": "엄중한 경계 태세를 펴야 하네."
  },
  "58": {
   "jp": "38c9a15c3f",
   "kr": "불쾌한 일을 겪게 한 것을 용서해 주게."
  },
  "59": {
   "jp": "3d14086f77",
   "kr": "뭐, 혐의가 풀렸으면 됐어."
  },
  "60": {
   "jp": "83ffd6f7f7",
   "kr": "진범은 찾았어?"
  },
  "61": {
   "jp": "6c9a19bfee",
   "kr": "그게…"
  },
  "62": {
   "jp": "9eaba07c17",
   "kr": "자네들에게 장물을 맡긴 지작이라는 자가"
  },
  "63": {
   "jp": "d2f72063c3",
   "kr": "종적을 감춰 버렸네."
  },
  "64": {
   "jp": "6f3e6795d8",
   "kr": "날 심문하느라 놓친 거잖아."
  },
  "65": {
   "jp": "c89fccebb5",
   "kr": "면목이 없네."
  },
  "66": {
   "jp": "c95f38ba45",
   "kr": "그래서 새로 부탁할 일이 있는데"
  },
  "67": {
   "jp": "a12732ceff",
   "kr": "아까 알선소에서 자네들 얘기를 들었다네."
  },
  "68": {
   "jp": "8cbc2613fc",
   "kr": "꽤 실력이 좋다는 평판이더군."
  },
  "69": {
   "jp": "8ef4c688c7",
   "kr": "염치없는 부탁이지만"
  },
  "70": {
   "jp": "fa94107da3",
   "kr": "지작 체포에 협력해 주지 않겠나?"
  },
  "71": {
   "jp": "efa6b285a3",
   "kr": "물론 그에 맞는 보수는 마련하겠네."
  },
  "72": {
   "jp": "e3634e664b",
   "kr": "어떤가, 협력해 주겠나?"
  },
  "73": {
   "jp": "51213cccd7",
   "kr": "맡아 주겠다고?"
  },
  "74": {
   "jp": "b3804e13f6",
   "kr": "이야, 고맙네."
  },
  "75": {
   "jp": "27440e7678",
   "kr": "알선소에는 내가 신고 변경을 내 두겠네."
  },
  "76": {
   "jp": "3b46ffe7d1",
   "kr": "우리는 지작의 얼굴을 모르거든."
  },
  "77": {
   "jp": "7eca23696e",
   "kr": "믿고 있겠네."
  },
  "78": {
   "jp": "64feb638c3",
   "kr": "그런가."
  },
  "79": {
   "jp": "aecb306338",
   "kr": "뭐, 이쪽도 무례를 저질렀으니"
  },
  "80": {
   "jp": "2bf7fe587a",
   "kr": "억지를 부릴 수는 없지."
  },
  "81": {
   "jp": "be44a93b0f",
   "kr": "알선소에는 약소하지만 위로금을 보내겠네."
  },
  "82": {
   "jp": "733b95d0b2",
   "kr": "그걸로 부디 용서해 주게."
  },
  "83": {
   "jp": "170c38e27d",
   "kr": "그럴 만한 자가 없었다고?"
  },
  "84": {
   "jp": "825233e95b",
   "kr": "그렇다면 엇갈린 모양이군."
  },
  "85": {
   "jp": "2a60c3c6dd",
   "kr": "어쨌든 마중이 없으면"
  },
  "86": {
   "jp": "387c2fd735",
   "kr": "둘이서만 여기까지 올 수는 없을 걸세."
  },
  "87": {
   "jp": "4061cdceb0",
   "kr": "아마 마법대학교에서 마중이 오기를"
  },
  "88": {
   "jp": "1cb54fb281",
   "kr": "기다리고 있지 않겠나."
  },
  "89": {
   "jp": "55166ffeff",
   "kr": "미안하지만 마법대학교에 가 봐 주지 않겠나?"
  },
  "90": {
   "jp": "3de5b01719",
   "kr": "이런, 이런."
  },
  "91": {
   "jp": "fbb73a46f1",
   "kr": "이번에는 꼭"
  },
  "92": {
   "jp": "131cba2353",
   "kr": "타이거와 체리를 데려와 주세요."
  },
  "93": {
   "jp": "37f4fab1e7",
   "kr": "아아, 잘 와 주셨습니다."
  },
  "94": {
   "jp": "f38192779c",
   "kr": "제가 알선소에 일을 의뢰한 와곤입니다."
  },
  "95": {
   "jp": "116eb45d55",
   "kr": "조카분들을 마중하는 일이었죠."
  },
  "96": {
   "jp": "8369a103a0",
   "kr": "네, 맞습니다."
  },
  "97": {
   "jp": "8ba1f72550",
   "kr": "요즘은 이 근방도 뒤숭숭해져서요."
  },
  "98": {
   "jp": "730de3b614",
   "kr": "해적 잔당이 나옵니다."
  },
  "99": {
   "jp": "47e5babe18",
   "kr": "걱정이 되니 저 대신"
  },
  "100": {
   "jp": "7074129d53",
   "kr": "마법대학교 근처에 있는 다리까지"
  },
  "101": {
   "jp": "fb89b57aa9",
   "kr": "마중 나가 주셨으면 합니다."
  },
  "102": {
   "jp": "5b3cee1dbe",
   "kr": "조카분들 이름이 어떻게 되나요?"
  },
  "103": {
   "jp": "912e05e474",
   "kr": "오빠가 타이거, 여동생이 체리입니다."
  },
  "104": {
   "jp": "d97a2f72e8",
   "kr": "마법대학교 근처에 있는 다리 부근에서"
  },
  "105": {
   "jp": "09e506087e",
   "kr": "기다리고 있으면 반드시 지나갈 겁니다."
  },
  "106": {
   "jp": "d3eec3c158",
   "kr": "잘 부탁드립니다."
  },
  "107": {
   "jp": "44c728c527",
   "kr": "어빈이라는 인물이"
  },
  "108": {
   "jp": "293c12fc3a",
   "kr": "짐 운반 의뢰를 받았다는 것이"
  },
  "109": {
   "jp": "97f7fa6016",
   "kr": "아까"
  },
  "110": {
   "jp": "e2c76d0b0c",
   "kr": "알선소에서 자네들 이야기를 들었네."
  },
  "111": {
   "jp": "b0b7f2ed1b",
   "kr": "알선소에는"
  },
  "112": {
   "jp": "4d95cffe24",
   "kr": "내가 신고 변경을 내 두겠네."
  }
 }
}
