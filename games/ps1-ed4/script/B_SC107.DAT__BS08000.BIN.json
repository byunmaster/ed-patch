  "0": {
   "jp": "8f3c586884",
   "kr": "전갈 공주"
  },
  "1": {
   "jp": "e99cb9bc55",
   "kr": "닥터 반들",
   "auto": 1
  },
  "2": {
   "jp": "366172bf6b",
   "kr": "도적",
   "auto": 1
  },
  "3": {
   "jp": "a5252728f0",
   "kr": "여자"
  },
  "4": {
   "jp": "0986453f7a",
   "kr": "도와주세요, 쫓기고 있어요…!"
  },
  "5": {
   "jp": "38fc17b6c8",
   "kr": "이봐, 형씨."
  },
  "6": {
   "jp": "7ae4f9170e",
   "kr": "우리는 그 여자한테 볼일이 있어."
  },
  "7": {
   "jp": "27c08a4d3a",
   "kr": "얌전히 넘겨주면"
  },
  "8": {
   "jp": "78aa14722e",
   "kr": "형씨들은 다치게 안 할 테니까."
  },
  "9": {
   "jp": "0c93ce8d37",
   "kr": "샴실단 녀석들이네."
  },
  "10": {
   "jp": "df2f576e06",
   "kr": "알아보는군."
  },
  "11": {
   "jp": "64da1df875",
   "kr": "우리는 무섭다고…?"
  },
  "12": {
   "jp": "800c3055a5",
   "kr": "으…?"
  },
  "13": {
   "jp": "3cf9a537f8",
   "kr": "…아야!?"
  },
  "14": {
   "jp": "836756b4aa",
   "kr": "어, 어째서… 몸이…"
  },
  "15": {
   "jp": "44d7396385",
   "kr": "…아아, 뻗었네."
  },
  "16": {
   "jp": "df1ccf86ff",
   "kr": "늘 그렇지만 싱겁군요."
  },
  "17": {
   "jp": "a5252728f0",
   "kr": "여자"
  },
  "18": {
   "jp": "6f4d313d08",
   "kr": "내 독침은 일발필중이야."
  },
  "19": {
   "jp": "7da57ee1ee",
   "kr": "전갈 공주라는 별명은 괜히 붙은 게 아니란다."
  },
  "20": {
   "jp": "0607c12444",
   "kr": "무섭네."
  },
  "21": {
   "jp": "a2ea47c17a",
   "kr": "누님만큼은 적으로 돌리고 싶지 않아."
  },
  "22": {
   "jp": "0bc40ea3b7",
   "kr": "잠깐 방심해서 등을 보였다간"
  },
  "23": {
   "jp": "864187cfe9",
   "kr": "따끔, 이거잖아."
  },
  "24": {
   "jp": "c583ffb006",
   "kr": "호호호."
  },
  "25": {
   "jp": "e72503d528",
   "kr": "자, 떠들지 말고"
  },
  "26": {
   "jp": "65e1e4a8e4",
   "kr": "얼른 물건을 챙겨."
  },
  "27": {
   "jp": "02c8204ff7",
   "kr": "목소리"
  },
  "28": {
   "jp": "bdaef21ae2",
   "kr": "…어빈 군."
  },
  "29": {
   "jp": "8a959736b8",
   "kr": "어빈 군, 정신 차려…"
  },
  "30": {
   "jp": "8a13b2f9b3",
   "kr": "…으… 응?"
  },
  "31": {
   "jp": "e4049590c4",
   "kr": "다행이에요."
  },
  "32": {
   "jp": "ac420131a7",
   "kr": "아픈 데는 없어요?"
  },
  "33": {
   "jp": "224c3a70bd",
   "kr": "아… 당신은?"
  },
  "34": {
   "jp": "33f3d46f18",
   "kr": "저는 닥터 반들이에요."
  },
  "35": {
   "jp": "606aabf5e6",
   "kr": "이래 봬도 의사예요."
  },
  "36": {
   "jp": "d008357295",
   "kr": "…마침 지나가서 다행이었어요."
  },
  "37": {
   "jp": "16459229ee",
   "kr": "당신들, 위험할 뻔했어요."
  },
  "38": {
   "jp": "1a03db9d3b",
   "kr": "다행이에요, 어빈 군."
  },
  "39": {
   "jp": "ac420131a7",
   "kr": "아픈 데는 없어요?"
  },
  "40": {
   "jp": "55744e4d99",
   "kr": "반들 선생님… 어떻게?"
  },
  "41": {
   "jp": "997d1afa81",
   "kr": "깜짝 놀랐어요."
  },
  "42": {
   "jp": "6f2c49872e",
   "kr": "가든힐로 가려는데"
  },
  "43": {
   "jp": "479112b12a",
   "kr": "당신이 쓰러져 있더군요."
  },
  "44": {
   "jp": "563b240333",
   "kr": "어떻게 된 거지, 나…"
  },
  "45": {
   "jp": "51e2f2c40a",
   "kr": "여자를 도우려고 했더니 갑자기 몸이 마비돼서…"
  },
  "46": {
   "jp": "af57ec7138",
   "kr": "목덜미에 독침을 맞았군요."
  },
  "47": {
   "jp": "f57fe47be3",
   "kr": "어?",
   "auto": 1
  },
  "48": {
   "jp": "d5d52afc0a",
   "kr": "샴실단에 독침 쓰는 사람이 있다고"
  },
  "49": {
   "jp": "e14af578ba",
   "kr": "들은 적이 있어요."
  },
  "50": {
   "jp": "ef42bd4974",
   "kr": "분명 전갈 공주라는 이름의 여도적이에요."
  },
  "51": {
   "jp": "fd051b6562",
   "kr": "신경을 마비시키는 독을 놓고"
  },
  "52": {
   "jp": "841fe75b2d",
   "kr": "상대가 기절한 틈에 금품을 강탈하죠."
  },
  "53": {
   "jp": "b14d37e1b0",
   "kr": "금품을 강탈…!"
  },
  "54": {
   "jp": "804c1fd34c",
   "kr": "설마 가르시아 씨의 짐은?"
  },
  "55": {
   "jp": "73fa987fa2",
   "kr": "어빈은 짐을 뒤졌다."
  },
  "56": {
   "jp": "f783c05f26",
   "kr": "없어!"
  },
  "57": {
   "jp": "dba5763374",
   "kr": "어디에도 없어…"
  },
  "58": {
   "jp": "c7c7793c51",
   "kr": "당했다!!"
  },
  "59": {
   "jp": "42858a9826",
   "kr": "값비싼 물건이라고 했으니까…"
  },
  "60": {
   "jp": "7690c31491",
   "kr": "처음부터 우리를 노렸을지도 몰라."
  },
  "61": {
   "jp": "ffaf727afa",
   "kr": "젠장!"
  },
  "62": {
   "jp": "68d3bc056d",
   "kr": "선생님, 전갈 공주는 어디 있죠!?"
  },
  "63": {
   "jp": "5fa246ea6b",
   "kr": "거기까지는 저도 몰라요."
  },
  "64": {
   "jp": "32f49eca09",
   "kr": "그녀의 소굴에 쳐들어갈 생각이에요?"
  },
  "65": {
   "jp": "cee99dc3bc",
   "kr": "당연하죠!"
  },
  "66": {
   "jp": "049a4d8f92",
   "kr": "당하고만 있을 순 없어요!"
  },
  "67": {
   "jp": "102853ebd4",
   "kr": "그렇다면 독에 대항할 것을 가져가야죠."
  },
  "68": {
   "jp": "f9b692d57f",
   "kr": "이걸 가져가세요."
  },
  "69": {
   "jp": "0246d02a49",
   "kr": "해독초를 받았다."
  },
  "70": {
   "jp": "de3ef451da",
   "kr": "고마워요, 선생님."
  },
  "71": {
   "jp": "19f15ed9cd",
   "kr": "저는 한동안 가든힐에 있어요."
  },
  "72": {
   "jp": "8f3aee6b6f",
   "kr": "곤란한 일이 있으면 만나러 와요."
  }
 }
