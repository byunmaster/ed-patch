{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02000I.BIN",
 "segments": {
  "0": {
   "jp": "cac3fcc912",
   "kr": "자네가 짐을 날라 주는 거로군."
  },
  "1": {
   "jp": "a658fa77bf",
   "kr": "필딘에 불면증으로 고생하는 친구가 있어서 말이야."
  },
  "2": {
   "jp": "91e1a94919",
   "kr": "그 친구에게 이 검은 램프를 전해 줬으면 해."
  },
  "3": {
   "jp": "252dd46f8c",
   "kr": "이 램프는"
  },
  "4": {
   "jp": "6ca46abf67",
   "kr": "켜기만 하면 금세 졸음이 오는 물건이라네."
  },
  "5": {
   "jp": "9ff73b000b",
   "kr": "…라고 남이 말해서 샀는데"
  },
  "6": {
   "jp": "b275641086",
   "kr": "난 불면증이 아니라서 사실은"
  },
  "7": {
   "jp": "a4a452076b",
   "kr": "잘 모르겠지만 말이야."
  },
  "8": {
   "jp": "ed27164519",
   "kr": "이게 운반해 달라는 검은 램프야."
  },
  "9": {
   "jp": "a8c363e307",
   "kr": "챕의 짐을 맡았다."
  },
  "10": {
   "jp": "dae6f60a45",
   "kr": "호오, 신기한 물건도 다 있네."
  },
  "11": {
   "jp": "16448af130",
   "kr": "램프 냄새를 맡아 보았다."
  },
  "12": {
   "jp": "51a94fd6be",
   "kr": "은은하게 허브 향이 났다."
  },
  "13": {
   "jp": "6548462c74",
   "kr": "기름에 마음을 차분하게 해 주는 허브 추출액을"
  },
  "14": {
   "jp": "a2913782a9",
   "kr": "넣어 둔 거야."
  },
  "15": {
   "jp": "78dc8d361e",
   "kr": "불을 붙이면 향 성분이 방에 퍼져서"
  },
  "16": {
   "jp": "4697959122",
   "kr": "마음이 차분해지는 장치지."
  },
  "17": {
   "jp": "8b2e17779d",
   "kr": "불면증에는 딱이야."
  },
  "18": {
   "jp": "0a2cdb5214",
   "kr": "그럼 이 짐을"
  },
  "19": {
   "jp": "a3665540dd",
   "kr": "필딘 성문을 지키고 있는"
  },
  "20": {
   "jp": "b8fa82872d",
   "kr": "병사 트란에게 전해 줘."
  },
  "21": {
   "jp": "9a99365254",
   "kr": "트란한테는 이번에는 공짜로 해 준다고"
  },
  "22": {
   "jp": "d0e92c0f8f",
   "kr": "말해 줘. 그러면 알 테니까."
  },
  "23": {
   "jp": "463937e08f",
   "kr": "잘 부탁하네.",
   "auto": 1
  },
  "24": {
   "jp": "4dafc2461e",
   "kr": "짐이 가득한 것 같군.",
   "auto": 1
  },
  "25": {
   "jp": "c206f4dbb0",
   "kr": "짐을 정리하고 나서",
   "auto": 1
  },
  "26": {
   "jp": "69a0515e4a",
   "kr": "다시 와 주겠나?",
   "auto": 1
  },
  "27": {
   "jp": "0111cd8389",
   "kr": "전할 곳은 필딘 성문을 지키는"
  },
  "28": {
   "jp": "f028f1bf0b",
   "kr": "병사 트란이야. 잘 부탁해."
  },
  "29": {
   "jp": "a405346bee",
   "kr": "당신이 편지를 배달해 주는 거군요."
  },
  "30": {
   "jp": "3ffec280dd",
   "kr": "반드시 전해 줄게."
  },
  "31": {
   "jp": "d759311078",
   "kr": "그래서 누구한테 전하면 돼?"
  },
  "32": {
   "jp": "16665a436d",
   "kr": "바로아에 있는 게이니예요."
  },
  "33": {
   "jp": "f6145ab689",
   "kr": "잘 부탁해요."
  },
  "34": {
   "jp": "b7fce524e6",
   "kr": "게이니는 바로아 소드 길드에"
  },
  "35": {
   "jp": "e06187337d",
   "kr": "늘 있다고 들었어요."
  },
  "36": {
   "jp": "89bb9628c3",
   "kr": "마르세한테서 편지를 맡았다."
  },
  "37": {
   "jp": "83e0e50b83",
   "kr": "당신처럼 믿음직한 사람이라면"
  },
  "38": {
   "jp": "b819b4844a",
   "kr": "저도 안심이에요. 잘 부탁해요."
  },
  "39": {
   "jp": "938ce558d2",
   "kr": "짐이 가득한 것 같네요."
  },
  "40": {
   "jp": "c206f4dbb0",
   "kr": "짐을 정리하고 나서",
   "auto": 1
  },
  "41": {
   "jp": "aa01dac85c",
   "kr": "다시 와 주지 않을래요?"
  },
  "42": {
   "jp": "1a5cb3d505",
   "kr": "전할 곳은 바로아의 게이니예요."
  },
  "43": {
   "jp": "f6145ab689",
   "kr": "잘 부탁해요."
  },
  "44": {
   "jp": "cac3fcc912",
   "kr": "자네가 짐을 날라 주는 거로군."
  },
  "45": {
   "jp": "e30963fa07",
   "kr": "그래, 어디든 전해 줄게."
  },
  "46": {
   "jp": "8465093991",
   "kr": "응, 믿음직한 대답이네."
  },
  "47": {
   "jp": "db8a22add7",
   "kr": "운반해 줬으면 하는 건 이거야."
  },
  "48": {
   "jp": "03d4452376",
   "kr": "헤임의 짐을 맡았다."
  },
  "49": {
   "jp": "362e2d23c0",
   "kr": "꽤 많이 쓴 머플러 같다."
  },
  "50": {
   "jp": "344b58db86",
   "kr": "꽤 낡은 머플러네."
  },
  "51": {
   "jp": "ca8cf09389",
   "kr": "이 머플러는 내가 코르나에 갔을 때"
  },
  "52": {
   "jp": "56100201b5",
   "kr": "간단한 여행 채비밖에 안 한 걸 보다 못해"
  },
  "53": {
   "jp": "3b9257d04f",
   "kr": "니트 씨라는 친절한 분이 빌려주셨어."
  },
  "54": {
   "jp": "f06b44b0fe",
   "kr": "다음에 또 갔을 때 돌려주려고"
  },
  "55": {
   "jp": "a21883c87b",
   "kr": "생각했는데, 좀처럼 갈 짬이 안 나서 말이야."
  },
  "56": {
   "jp": "ae4bff85ee",
   "kr": "그래서 나 대신 코르나까지 가 줄 사람을"
  },
  "57": {
   "jp": "adca0a79b6",
   "kr": "알선소에 의뢰를 내서 찾고 있었어."
  },
  "58": {
   "jp": "563e67cefe",
   "kr": "코르나에 도착하면 가장 북쪽 집으로 가."
  },
  "59": {
   "jp": "1930b6cd32",
   "kr": "니트 씨는 거기서 혼자 살고 있어."
  },
  "60": {
   "jp": "ab4190b61e",
   "kr": "그분께 전해 줬으면 해."
  },
  "61": {
   "jp": "c951556591",
   "kr": "코르나는 무척 춥다고 하더라."
  },
  "62": {
   "jp": "fe0100f7d7",
   "kr": "감기 걸리지 않도록 해."
  },
  "63": {
   "jp": "ce5c94c0e4",
   "kr": "그럼 잘 부탁해."
  },
  "64": {
   "jp": "4dafc2461e",
   "kr": "짐이 가득한 것 같네."
  },
  "65": {
   "jp": "643fcd9e1c",
   "kr": "그럼 짐을 줄 수 없겠는걸."
  },
  "66": {
   "jp": "7eb1b2260e",
   "kr": "짐을 정리하고 나서 와 줄래?"
  },
  "67": {
   "jp": "526bddb1d0",
   "kr": "전할 곳은 코르나의 니트 씨야."
  },
  "68": {
   "jp": "ff3c08fbbd",
   "kr": "코르나 가장 북쪽 집에 살고 있어."
  },
  "69": {
   "jp": "463937e08f",
   "kr": "잘 부탁해."
  },
  "70": {
   "jp": "771f48f5d3",
   "kr": "당신이 편지를 운반해 주는 거군요."
  },
  "71": {
   "jp": "110d23f477",
   "kr": "전해 줬으면 하는 곳은"
  },
  "72": {
   "jp": "44fb5fdf49",
   "kr": "뉴보른의 베트예요."
  },
  "73": {
   "jp": "6fd4c9b6dc",
   "kr": "아마 여관 주점 2층에서 기다리고 있을 거예요."
  },
  "74": {
   "jp": "dc1e3f7f5a",
   "kr": "크레라에게서 편지를 맡았다."
  },
  "75": {
   "jp": "f6145ab689",
   "kr": "잘 부탁해요."
  },
  "76": {
   "jp": "938ce558d2",
   "kr": "짐이 가득한 것 같네요."
  },
  "77": {
   "jp": "c206f4dbb0",
   "kr": "짐을 정리하고 나서",
   "auto": 1
  },
  "78": {
   "jp": "d271b3fbe5",
   "kr": "와 주는 편이 좋겠어요."
  },
  "79": {
   "jp": "5e85c784b8",
   "kr": "전할 곳은 뉴보른의 베트예요."
  },
  "80": {
   "jp": "51ee08fe44",
   "kr": "여관 주점 2층에서 기다리고 있을 거예요."
  },
  "81": {
   "jp": "f6145ab689",
   "kr": "잘 부탁해요."
  },
  "82": {
   "jp": "159a8f2c26",
   "kr": "넌 누구지?"
  },
  "83": {
   "jp": "1c9ebd59e3",
   "kr": "나한테 무슨 볼일이라도 있어?"
  },
  "84": {
   "jp": "1115ce8e75",
   "kr": "포스터 씨지?"
  },
  "85": {
   "jp": "12ec26bf07",
   "kr": "짐을 전하러 왔어."
  },
  "86": {
   "jp": "bc9b29e71d",
   "kr": "멜이 만든 쿠키를 건넸다."
  },
  "87": {
   "jp": "f7ab63839e",
   "kr": "킁킁."
  },
  "88": {
   "jp": "63528ef69a",
   "kr": "오오, 맛있어 보이는 쿠키잖아."
  },
  "89": {
   "jp": "c364ad175f",
   "kr": "그래, 멜이 나를 위해서…"
  },
  "90": {
   "jp": "dd93bd6d33",
   "kr": "왠지 쑥스러운걸."
  },
  "91": {
   "jp": "489206e7e9",
   "kr": "혹시 멜을 만나면 안부 좀"
  },
  "92": {
   "jp": "adb4faf9bc",
   "kr": "전해 줘."
  },
  "93": {
   "jp": "62430296ac",
   "kr": "지금 일이 일단락되면"
  },
  "94": {
   "jp": "9b8168bd1a",
   "kr": "꼭 만나러 간다고 말이야."
  },
  "95": {
   "jp": "9f35d699d0",
   "kr": "자네들은 누구지?"
  },
  "96": {
   "jp": "04abf24dfc",
   "kr": "뭔가 가져다준 것 같은데?"
  }
 }
