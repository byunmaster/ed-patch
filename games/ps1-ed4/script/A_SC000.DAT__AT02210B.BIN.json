{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02210B.BIN",
 "segments": {
  "0": {
   "jp": "7d97595e84",
   "kr": "《여검사 사피 최종권》"
  },
  "1": {
   "jp": "0e91861a56",
   "kr": "카라무로 카라무스"
  },
  "2": {
   "jp": "f11289c239",
   "kr": "～복수의 칼날～"
  },
  "3": {
   "jp": "93f9fea6d2",
   "kr": "사피는 미동도 없이"
  },
  "4": {
   "jp": "e9b3e3bfe1",
   "kr": "토파즈 국왕이 옥좌에서 내려오기를 기다렸다."
  },
  "5": {
   "jp": "33865f043f",
   "kr": "『남자였다면 궁정 검사가 되었을 것을.』"
  },
  "6": {
   "jp": "d43ef04415",
   "kr": "다정하게 다가온 국왕은 사피가 차고 있는"
  },
  "7": {
   "jp": "8cece4af7d",
   "kr": "검을 보고 힘없이 중얼거렸다."
  },
  "8": {
   "jp": "dac15e264a",
   "kr": "『…실핑…』"
  },
  "9": {
   "jp": "0541667d46",
   "kr": "예전에 이 명검을 자유자재로 다루던 검사가 있었다."
  },
  "10": {
   "jp": "813809bbd4",
   "kr": "그 유능함 탓에 왕족의 비밀을 알게 되어"
  },
  "11": {
   "jp": "3305f2ef5e",
   "kr": "정해진 죽음을 맞았다."
  },
  "12": {
   "jp": "205aba51db",
   "kr": "그 명령을 내린 것은 토파즈 국왕이다."
  },
  "13": {
   "jp": "db4e55a8f2",
   "kr": "국왕의 이변을 알아채고 달려오는 병사보다 빠르게"
  },
  "14": {
   "jp": "e7d77fefe0",
   "kr": "사브르의 끝이 국왕의 목에 닿았다."
  },
  "15": {
   "jp": "2af931a48c",
   "kr": "사피의 눈동자는 이제 차갑게 타오르는 보석이었다."
  },
  "16": {
   "jp": "66ce53088e",
   "kr": "증오를 양식 삼아 타오르는 사파이어."
  },
  "17": {
   "jp": "91de6b239c",
   "kr": "한 걸음 내디디면 아버지를 죽인 자의 목숨을 끊을 수 있다."
  },
  "18": {
   "jp": "a8cb4c7502",
   "kr": "하지만 국왕의 늙은 눈동자에 자신의 모습을 보았을 때"
  },
  "19": {
   "jp": "572f8d3b90",
   "kr": "사피는 블러드의 말을 떠올렸다."
  },
  "20": {
   "jp": "03c672171c",
   "kr": "『검에 담은 증오는 너 자신을 먹어 치울 것이다.』"
  },
  "21": {
   "jp": "c3381347ac",
   "kr": "증오는 새로운 증오를 불러일으킨다."
  },
  "22": {
   "jp": "f47009e171",
   "kr": "사피가 싸워 온 것은 자기 자신 안에서"
  },
  "23": {
   "jp": "2a95d5c244",
   "kr": "푸르게 타오르는 증오였던 것이다."
  },
  "24": {
   "jp": "02552a97fc",
   "kr": "그녀는 조용히 실핑을 칼집에 꽂고"
  },
  "25": {
   "jp": "6479775797",
   "kr": "천천히 그 자리를 떠났다."
  },
  "26": {
   "jp": "c29134a3f5",
   "kr": "아무도 움직이려 하지 않는 가운데, 그녀의 눈동자 속 불꽃은"
  },
  "27": {
   "jp": "32b1e5a399",
   "kr": "점차 호수의 고요함으로 변해 갔다."
  },
  "28": {
   "jp": "fd9d213d97",
   "kr": "여검사 사피 완"
  },
  "29": {
   "jp": "c28f71a80a",
   "kr": "《질풍의 라빈 제１권》"
  },
  "30": {
   "jp": "0e91861a56",
   "kr": "카라무로 카라무스"
  },
  "31": {
   "jp": "1b0d0027d5",
   "kr": "첫 일은 왕의 의뢰였다."
  },
  "32": {
   "jp": "94c705eadc",
   "kr": "왕가에 전해지는 비밀 고문서가 도적에게 도난당했다."
  },
  "33": {
   "jp": "9a4441c5a9",
   "kr": "그것을 되찾아 달라는 것이었다."
  },
  "34": {
   "jp": "2960fd27bc",
   "kr": "게시판의 글을 보고 라빈은 코웃음을 쳤다."
  },
  "35": {
   "jp": "8cd66f25e9",
   "kr": "왕가의 물건이 도난당한 것은 분명 큰일일지도 모르지만,"
  },
  "36": {
   "jp": "fe331397e7",
   "kr": "상대가 평범한 도적이라면 그리 어려운 일은 아니다."
  },
  "37": {
   "jp": "b26ca52561",
   "kr": "이쯤에서 이름을 좀 올려"
  },
  "38": {
   "jp": "99f12b59b4",
   "kr": "모험가로 이름을 알리는 것도 나쁘지 않겠군…"
  },
  "39": {
   "jp": "3e7b947418",
   "kr": "먼지 냄새 나는 인파를 헤치고 라빈은 도시를 나섰다."
  },
  "40": {
   "jp": "8e3a539c78",
   "kr": "가도를 벗어나 짐승이 지나간 듯한 길을 따라"
  },
  "41": {
   "jp": "be78c44f99",
   "kr": "도적이 둥지를 튼 동굴로."
  },
  "42": {
   "jp": "70b78def0a",
   "kr": "젊은 라빈의 발은 가벼워"
  },
  "43": {
   "jp": "e7e4a36d2e",
   "kr": "험한 산도 힘들지 않았다."
  },
  "44": {
   "jp": "8a87decbba",
   "kr": "눈 깜짝할 새에 목표인 동굴에 도착했다."
  },
  "45": {
   "jp": "511c9672a3",
   "kr": "입구를 들여다보니"
  },
  "46": {
   "jp": "0d94519740",
   "kr": "서늘한 공기의 흐름이"
  },
  "47": {
   "jp": "e3d1c697b0",
   "kr": "아무렇게나 기른 머리카락을 좌우로 흩날렸다."
  },
  "48": {
   "jp": "bef790f11c",
   "kr": "날뛰는 앞머리 틈새로 검은 공간이 보였다."
  },
  "49": {
   "jp": "8a4eea4a9b",
   "kr": "라빈은 작게 고개를 젓고"
  },
  "50": {
   "jp": "b66ca0fe55",
   "kr": "그 공간 속으로 발을 들였다."
  },
  "51": {
   "jp": "c38a1588a9",
   "kr": "《질풍의 라빈 제２권》"
  },
  "52": {
   "jp": "0e91861a56",
   "kr": "카라무로 카라무스"
  },
  "53": {
   "jp": "eb5f585053",
   "kr": "「애송이!」"
  },
  "54": {
   "jp": "b4ad0bc436",
   "kr": "짐승 같은 팔로 만도를 치켜든 도적들이"
  },
  "55": {
   "jp": "8efea3e87a",
   "kr": "양쪽에서 덮쳐 왔다."
  },
  "56": {
   "jp": "e2228cc802",
   "kr": "고문서는 되찾았지만"
  },
  "57": {
   "jp": "ff8f2d8ad5",
   "kr": "도적들의 추격을 받고 말았다."
  },
  "58": {
   "jp": "9cc9f44dc5",
   "kr": "좁은 동굴 안에서는 달리는 것도 여의치 않았다."
  },
  "59": {
   "jp": "c22245db7f",
   "kr": "분노한 도적들이 여기저기서 솟아나"
  },
  "60": {
   "jp": "a05dc43aa7",
   "kr": "순식간에 라빈을 에워쌌다."
  },
  "61": {
   "jp": "94b72a5792",
   "kr": "후퇴를 거듭하다 마침내"
  },
  "62": {
   "jp": "ac2f167374",
   "kr": "라빈의 등은 벽에 딱 붙고 말았다."
  },
  "63": {
   "jp": "d2b04f23de",
   "kr": "짐승들이 한 걸음, 또 한 걸음 거리를 좁혀 온다."
  },
  "64": {
   "jp": "8643680959",
   "kr": "번뜩이는 만도가 라빈의 머리에 닿을 거리까지 다가왔다."
  },
  "65": {
   "jp": "3a1e57a6b7",
   "kr": "치켜든 칼날."
  },
  "66": {
   "jp": "8a65dee793",
   "kr": "누런 이를 드러내고 웃는 도적."
  },
  "67": {
   "jp": "a1e3531ba1",
   "kr": "잔혹한 웃음소리."
  },
  "68": {
   "jp": "998a2a1505",
   "kr": "그 찰나."
  },
  "69": {
   "jp": "706cce911e",
   "kr": "톡, 하는 발뒤꿈치 소리와 함께 시간이 멈췄다."
  },
  "70": {
   "jp": "d7700a97e5",
   "kr": "벽을 찬 라빈의 몸이 공중에서 춤췄다."
  },
  "71": {
   "jp": "eef0b6e364",
   "kr": "시간의 톱니바퀴가 다시 돌기 시작하자"
  },
  "72": {
   "jp": "282e0e04b8",
   "kr": "도적들이 풀썩 쓰러졌다."
  },
  "73": {
   "jp": "6084c06599",
   "kr": "「멈춰라!」"
  },
  "74": {
   "jp": "2bf2d112f6",
   "kr": "라빈이 공중에서 내려섰을 때"
  },
  "75": {
   "jp": "08294a097a",
   "kr": "늠름한 목소리가 공기를 때렸다."
  },
  "76": {
   "jp": "7186f52611",
   "kr": "《질풍의 라빈 제３권》"
  },
  "77": {
   "jp": "0e91861a56",
   "kr": "카라무로 카라무스"
  },
  "78": {
   "jp": "3ffba68825",
   "kr": "목소리의 주인은 랜턴을 높이 들었다."
  },
  "79": {
   "jp": "65ed5e8416",
   "kr": "탁한 어둠 속에 빛의 구름이 떠올랐다."
  },
  "80": {
   "jp": "91c54f5c65",
   "kr": "주변의 사악한 기운을 몰아내는 듯한 모습이 또렷이 나타났다."
  },
  "81": {
   "jp": "b1ae9b77b1",
   "kr": "비단 같은 검은 머리, 흑요석 같은 눈동자."
  },
  "82": {
   "jp": "87f98f6726",
   "kr": "표범의 우아함을 두르고 선 한 여성."
  },
  "83": {
   "jp": "e3f16344e4",
   "kr": "도적의 아지트에는 어울리지 않았다."
  },
  "84": {
   "jp": "8994ce6b3d",
   "kr": "「누구냐」"
  },
  "85": {
   "jp": "1d23b6bc03",
   "kr": "라빈은 검을 칼집에 넣고 물었다."
  },
  "86": {
   "jp": "62c63a4984",
   "kr": "「그 고문서를 내놓으렴」"
  },
  "87": {
   "jp": "330735fb7d",
   "kr": "검은 머리의 여성은 하얀 팔을 라빈 쪽으로 뻗었다."
  },
  "88": {
   "jp": "59d6d79bcd",
   "kr": "「세상에는 몰라도 되는 일이 아주 많단다."
  },
  "89": {
   "jp": "0fcc8a6583",
   "kr": "지금 나에게 그 고문서를 건네도"
  },
  "90": {
   "jp": "9f2d94ffa5",
   "kr": "죄를 묻지는 않아."
  },
  "91": {
   "jp": "aed6dfc398",
   "kr": "…수고했어요, 라빈."
  },
  "92": {
   "jp": "79fd501f06",
   "kr": "이건 처음부터 정해져 있던"
  },
  "93": {
   "jp": "698df4528f",
   "kr": "네 역할이야」"
  },
  "94": {
   "jp": "1e8c3e6edf",
   "kr": "《질풍의 라빈 제４권》"
  },
  "95": {
   "jp": "0e91861a56",
   "kr": "카라무로 카라무스"
  },
  "96": {
   "jp": "ade2c93bf1",
   "kr": "「누구냐, 너는…」"
  },
  "97": {
   "jp": "40b05d11bb",
   "kr": "라빈은 누구에게랄 것 없이 중얼거렸다."
  },
  "98": {
   "jp": "81d1fd6cfd",
   "kr": "술집 카운터.",
   "fix": 1
  },
  "99": {
   "jp": "501b2fdcd1",
   "kr": "취객들이 요란하게 웃는 가운데",
   "fix": 1
  },
  "100": {
   "jp": "1d64b228c4",
   "kr": "라빈의 귀에는 오직 한 가지 소리만 들리고 있었다."
  },
  "101": {
   "jp": "1602313927",
   "kr": "동굴에 나타난 검은 머리의 여자."
  },
  "102": {
   "jp": "46a1472422",
   "kr": "활시위를 튕긴 듯 맑게 울리던 그녀의 목소리."
  },
  "103": {
   "jp": "cc7392cf5b",
   "kr": "…수고했어요, 라빈. 또 만나요…"
  },
  "104": {
   "jp": "0199ffc29d",
   "kr": "떨쳐도 떨쳐도 들려오는 환청을 지우려고"
  },
  "105": {
   "jp": "fb1fa5ccec",
   "kr": "라빈은 주먹을 내리쳤다."
  },
  "106": {
   "jp": "287a440fdf",
   "kr": "진동에 물결치는 포도주 속에서"
  },
  "107": {
   "jp": "780275d30e",
   "kr": "떠나가는 그녀의 모습이 일렁였다."
  },
  "108": {
   "jp": "2042c7aef1",
   "kr": "내가 어쩌다 잠자코 고문서를 넘겨줬을까."
  },
  "109": {
   "jp": "bcd14ae078",
   "kr": "모험가로 이름을 알릴 기회였는데."
  },
  "110": {
   "jp": "3507d12d67",
   "kr": "라빈은 애꿎은 카운터에 화풀이를 해 댔다."
  },
  "111": {
   "jp": "87feafe9cf",
   "kr": "《질풍의 라빈 제５권》"
  },
  "112": {
   "jp": "0e91861a56",
   "kr": "카라무로 카라무스"
  },
  "113": {
   "jp": "bdb458bdf7",
   "kr": "정말 시시한 일이었다."
  },
  "114": {
   "jp": "d782e98d39",
   "kr": "고문서 사건 이후"
  },
  "115": {
   "jp": "be1d464609",
   "kr": "운마저 따라 주지 않는지도 모른다."
  },
  "116": {
   "jp": "42742b0e52",
   "kr": "라빈은 짐을 어깨에 메고 느릿느릿 가도를 걷고 있었다."
  },
  "117": {
   "jp": "e83edfa1e3",
   "kr": "…내가 왜 이런 짐 나르기 따위를."
  },
  "118": {
   "jp": "d26de09d84",
   "kr": "…이딴 거 내던져 버릴까 보다."
  },
  "119": {
   "jp": "6ea636405d",
   "kr": "짐을 휙 들어 올렸을 때"
  },
  "120": {
   "jp": "20307fbf0b",
   "kr": "심상치 않은 살기가 스쳤다."
  },
  "121": {
   "jp": "e99844852a",
   "kr": "소리는 없어도 팽팽한 공기가 숲을 흔들고 있다."
  },
  "122": {
   "jp": "7297704a9a",
   "kr": "라빈은 정말로 짐을 내던지고 달렸다."
  },
  "123": {
   "jp": "09cdef0c06",
   "kr": "「앗!」"
  },
  "124": {
   "jp": "a3e1c4a753",
   "kr": "눈앞의 광경을 보고"
  },
  "125": {
   "jp": "59b663b2b6",
   "kr": "라빈은 저도 모르게 소리를 질렀다."
  },
  "126": {
   "jp": "759032a96b",
   "kr": "…그 검은 머리의 여자가 쓰러져 있다."
  },
  "127": {
   "jp": "f295285543",
   "kr": "손끝을 잘게 떨면서."
  },
  "128": {
   "jp": "82c7d2f844",
   "kr": "그건 독에 당했다는 증거였다."
  },
  "129": {
   "jp": "5ec04d78e1",
   "kr": "라빈은 그녀에게 달려가"
  },
  "130": {
   "jp": "f0fa182dba",
   "kr": "굳어 가는 여린 몸을 안아 일으켰다."
  },
  "131": {
   "jp": "f199ea558c",
   "kr": "「…부탁이야, 그 고문서를 되찾아 줘…」"
  },
  "132": {
   "jp": "a6fb742382",
   "kr": "보랏빛 입술에서 겨우 목소리가 새어 나온다."
  },
  "133": {
   "jp": "780749e790",
   "kr": "활시위의 울림은 이미 없다."
  },
  "134": {
   "jp": "ed50581290",
   "kr": "「기다려, 곧 구해 줄게!」"
  },
  "135": {
   "jp": "5a9f1086d1",
   "kr": "라빈은 그녀를 안고 달리기 시작했다."
  },
  "136": {
   "jp": "a7f7849b8f",
   "kr": "왕가에 전해지는 비밀 고문서가"
  },
  "137": {
   "jp": "4eb9cac83e",
   "kr": "도적에게 도난당했다."
  },
  "138": {
   "jp": "fb3fb71173",
   "kr": "왕가의 물건이 도난당한 것은"
  },
  "139": {
   "jp": "26331163a2",
   "kr": "분명 큰일일지도 모르지만,"
  },
  "140": {
   "jp": "e168732f39",
   "kr": "라빈의 등은"
  },
  "141": {
   "jp": "17cdcde387",
   "kr": "벽에 딱 붙고 말았다."
  },
  "142": {
   "jp": "13d8e41f3b",
   "kr": "짐승들이"
  },
  "143": {
   "jp": "9f485e531f",
   "kr": "한 걸음, 또 한 걸음 거리를 좁혀 왔다."
  },
  "144": {
   "jp": "155446396c",
   "kr": "번쩍이는 만도가"
  },
  "145": {
   "jp": "674a89055a",
   "kr": "라빈의 머리에 닿을 거리까지 다가왔다."
  },
  "146": {
   "jp": "04cb644173",
   "kr": "「이 세상에는"
  },
  "147": {
   "jp": "5e99f2b15c",
   "kr": "몰라도 되는 것이 많이 있어."
  },
  "148": {
   "jp": "6639258dad",
   "kr": "라빈의 귀에는",
   "fix": 1
  },
  "149": {
   "jp": "fdb21d072f",
   "kr": "단 하나의 소리만 들리고 있었다.",
   "fix": 1
  },
  "150": {
   "jp": "b5d957a460",
   "kr": "…수고했어요, 라빈."
  },
  "151": {
   "jp": "4d60641def",
   "kr": "또 만나요…"
  },
  "152": {
   "jp": "858f4c39a8",
   "kr": "나라는 놈이"
  },
  "153": {
   "jp": "b3cef111d3",
   "kr": "어째서 순순히 고문서를 넘겼을까."
  },
  "154": {
   "jp": "79e15cf693",
   "kr": "라빈은 짐을 어깨에 메고"
  },
  "155": {
   "jp": "580f71dc7e",
   "kr": "터덜터덜 가도를 걷고 있었다."
  },
  "156": {
   "jp": "5c9b9e07f5",
   "kr": "소리는 없지만"
  },
  "157": {
   "jp": "d4839f290d",
   "kr": "팽팽한 공기가 주변 수풀을 흔들고 있었다."
  }
 }
