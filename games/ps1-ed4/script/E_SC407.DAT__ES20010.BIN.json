  "4": {
   "jp": "2dc26b3fce",
   "kr": "내시",
   "auto": 1
  },
  "5": {
   "jp": "6a6f8fd7d5",
   "kr": "워스",
   "auto": 1
  },
  "6": {
   "jp": "0fb1fcd1e9",
   "kr": "내 기분 탓일지도 모르지만"
  },
  "7": {
   "jp": "1453cf673f",
   "kr": "이 벽이 수상해."
  },
  "8": {
   "jp": "b8d48b7e79",
   "kr": "약간의 마력이 느껴져."
  },
  "9": {
   "jp": "2d71198079",
   "kr": "네페레라도 느끼고 있지만"
  },
  "10": {
   "jp": "bf554c0267",
   "kr": "희미한 마력의 일렁임이 있어요."
  },
  "11": {
   "jp": "6326f2246f",
   "kr": "어떤 건지는 모르겠지만요."
  },
  "12": {
   "jp": "356a1a3c79",
   "kr": "그 반지는 뭐야?"
  },
  "13": {
   "jp": "360b291a34",
   "kr": "내시 말로는"
  },
  "14": {
   "jp": "00e6d93db5",
   "kr": "텔레포터의 열쇠래."
  },
  "15": {
   "jp": "d3b804fbf0",
   "kr": "써야 할 곳에서 쓰면 텔레포트한다나 봐."
  },
  "16": {
   "jp": "29422125ee",
   "kr": "그래서 수수께끼가 풀렸어요!"
  },
  "17": {
   "jp": "e708f958b4",
   "kr": "이 동굴에는 돌크의 모습이 안 보여요."
  },
  "18": {
   "jp": "b69391dd14",
   "kr": "분명 어딘가 다른 곳에 있는 거예요."
  },
  "19": {
   "jp": "ce25d97c7b",
   "kr": "그렇구나!"
  },
  "20": {
   "jp": "4075a02a27",
   "kr": "이 벽에서 마력이 느껴지는 게 그래서였네!"
  },
  "21": {
   "jp": "faf8f1d418",
   "kr": "벽 근처에서 반지를 쓰면"
  },
  "22": {
   "jp": "f67297c832",
   "kr": "돌크가 숨은 곳으로 갈 수 있을 거야!"
  },
  "23": {
   "jp": "17338b7c66",
   "kr": "있잖아, 빨리 써, 얼른 써, 지금 써!"
  },
  "24": {
   "jp": "61f95cb70c",
   "kr": "조심하세요."
  },
  "25": {
   "jp": "c64bba9f2b",
   "kr": "텔레포트한 곳에 돌크가 있을 거예요."
  },
  "26": {
   "jp": "6e392c80dc",
   "kr": "앗, 돌아왔다!"
  },
  "27": {
   "jp": "7fb0054a00",
   "kr": "워스!",
   "auto": 1
  },
  "28": {
   "jp": "60b3b703b7",
   "kr": "로웨이."
  },
  "29": {
   "jp": "e994be2d17",
   "kr": "내가 잘못했어."
  },
  "30": {
   "jp": "13410ba3cf",
   "kr": "이제 어빈 씨와 알선소에 가서"
  },
  "31": {
   "jp": "c7fc04f7d7",
   "kr": "벌을 받을 생각이야."
  },
  "32": {
   "jp": "1e9c6acda9",
   "kr": "무슨 소리지?"
  },
  "33": {
   "jp": "bd66b89b1a",
   "kr": "내 일은 조수의 지팡이를 부수는 거였어."
  },
  "34": {
   "jp": "da5a3a6992",
   "kr": "그건 무사히 끝났어."
  },
  "35": {
   "jp": "2f035911fb",
   "kr": "어빈 씨…"
  },
  "36": {
   "jp": "72f871c3bc",
   "kr": "하하하!"
  },
  "37": {
   "jp": "db54c0fdb5",
   "kr": "그렇게 딱 끊는 거, 마음에 들어."
  },
  "38": {
   "jp": "7dbf257a0b",
   "kr": "미안하다."
  },
  "39": {
   "jp": "6bfff37950",
   "kr": "끝까지 빚만 지는군."
  },
  "40": {
   "jp": "43b750d5dc",
   "kr": "그래서 돌크는 어떻게 됐어?"
  },
  "41": {
   "jp": "bf69536fce",
   "kr": "지팡이의 마력에 삼켜져서"
  },
  "42": {
   "jp": "0edddf96e0",
   "kr": "마수가 되어 버렸어."
  },
  "43": {
   "jp": "dd1fdc7b6b",
   "kr": "…그 마수는 우리가 쓰러뜨렸어."
  },
  "44": {
   "jp": "f2816439a3",
   "kr": "…그렇구나."
  },
  "45": {
   "jp": "bf900c684f",
   "kr": "조금 전까지의 기세는 어쩌고?"
  },
  "46": {
   "jp": "9efdc11c60",
   "kr": "돌크가 불쌍해졌나?"
  },
  "47": {
   "jp": "85651da4e6",
   "kr": "동정 같은 거 아니야!"
  },
  "48": {
   "jp": "eea4684261",
   "kr": "난 붙잡고 싶었을 뿐이야!"
  },
  "49": {
   "jp": "592e30c61d",
   "kr": "어떤 사람이든 목숨을 잃는 건"
  },
  "50": {
   "jp": "a479f75925",
   "kr": "슬프고 쓸쓸한 일이에요."
  },
  "51": {
   "jp": "65824ce1d6",
   "kr": "네페레라는 그렇게 느끼고 있어요."
  },
  "52": {
   "jp": "7338cffa69",
   "kr": "뭐야, 니플까지."
  },
  "53": {
   "jp": "4302bb43d6",
   "kr": "더는 못 어울려 주겠어!"
  },
  "54": {
   "jp": "215ecb5773",
   "kr": "니플, 가자."
  },
  "55": {
   "jp": "c2883fe11d",
   "kr": "미안해요, 실례할게요."
  },
  "56": {
   "jp": "0273281916",
   "kr": "기다려, 네페레라!"
  },
  "57": {
   "jp": "6eabd4b6a7",
