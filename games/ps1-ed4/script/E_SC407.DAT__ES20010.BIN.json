  },
  "58": {
   "jp": "45b87c70a3",
   "kr": "우리도 갈까."
  },
  "59": {
   "jp": "ee7a7a5d1c",
   "kr": "어빈 씨, 뭐라고 감사해야 할지."
  },
  "60": {
   "jp": "069dd7d179",
   "kr": "나도 고맙다는 말 좀 하자."
  },
  "61": {
   "jp": "357f91d910",
   "kr": "신세 많이 졌어."
  },
  "62": {
   "jp": "40fa346851",
   "kr": "서로를 아껴 주는 친구가 있어서"
  },
  "63": {
   "jp": "91e1f4f098",
   "kr": "부럽군."
  },
  "64": {
   "jp": "f9066b5b4f",
   "kr": "너희라면 괜찮을 거야."
  },
  "65": {
   "jp": "dea4992c54",
   "kr": "고마워."
  },
  "66": {
   "jp": "de111c1e86",
   "kr": "무슨 일 있으면 불러 줘."
  },
  "67": {
   "jp": "aecf5e5023",
   "kr": "이번에야말로 힘이 돼 줄 테니까!"
  },
  "68": {
   "jp": "2ee52a19a5",
   "kr": "넌 훌륭한 모험가가 될 거다."
  },
  "69": {
   "jp": "31d00957d7",
   "kr": "그럼 간다."
  },
  "70": {
   "jp": "a6269033f8",
   "kr": "인연이 있으면 또 만나겠지."
  },
  "71": {
   "jp": "564108dce3",
   "kr": "워스도 도적단에서 손 떼고"
  },
  "72": {
   "jp": "edd4c54c49",
   "kr": "돌크 일도 정리돼서 다행이야."
  },
  "73": {
   "jp": "966c21d315",
   "kr": "워스가 원래 생활로 돌아가서 다행이야."
  },
  "74": {
   "jp": "736de1e704",
   "kr": "조수의 지팡이도 부쉈고."
  },
  "75": {
   "jp": "e2fc5a7a2b",
   "kr": "워스 씨는 이제 괜찮을 거예요."
  },
  "76": {
