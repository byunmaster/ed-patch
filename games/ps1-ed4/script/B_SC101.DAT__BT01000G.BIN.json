{
 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT01000G.BIN",
 "segments": {
  "0": {
   "jp": "0619c9ac7a",
   "kr": "울트의 팜 씨는"
  },
  "1": {
   "jp": "80fccd2dfd",
   "kr": "옛날부터 모험가가 되고 싶었나 봐."
  },
  "2": {
   "jp": "e53171042e",
   "kr": "하지만 농부 일을 그만둘 수도 없어."
  },
  "3": {
   "jp": "037d3d9300",
   "kr": "그래서 하다못해 "
  },
  "4": {
   "jp": "6fa73ce335",
   "kr": "을(를)"
  },
  "5": {
   "jp": "86bb2a299a",
   "kr": "곁에 두고 싶대요."
  },
  "6": {
   "jp": "264dd83327",
   "kr": "중고품이라도 좋다고 하니"
  },
  "7": {
   "jp": "4ee9c01ae1",
   "kr": "당신이 쓰던 물건이라도 기뻐하지 않을까?"
  },
  "8": {
   "jp": "8612bd13fc",
   "kr": "피트 동굴은"
  },
  "9": {
   "jp": "821ea85f79",
   "kr": "도적 샴실단의 아지트로 쓰였어요."
  },
  "10": {
   "jp": "a123e44be3",
   "kr": "도적단은 쫓아냈지만"
  },
  "11": {
   "jp": "d77c21de75",
   "kr": "동굴 안에는 장물이 몇 개"
  },
  "12": {
   "jp": "8efbe732d6",
   "kr": "남아 있을 거야."
  },
  "13": {
   "jp": "8b9f64d055",
   "kr": "그 장물 중에 어느 귀족이 도난당한"
  },
  "14": {
   "jp": "d82f063a12",
   "kr": "이(가) 있을지도 몰라."
  },
  "15": {
   "jp": "0bd484858d",
   "kr": "동굴 안을 탐색해서"
  },
  "16": {
   "jp": "eed58efa6d",
   "kr": "을(를) 찾아내 주셨으면 해요."
  },
  "17": {
   "jp": "142b326bd8",
   "kr": "의뢰인은 안젤라 씨예요."
  },
  "18": {
   "jp": "9ab9c4b968",
   "kr": "앤디 씨의 어머니지."
  },
  "19": {
   "jp": "4e1351012b",
   "kr": "도적 샴실단에게서 협박장이 왔대요."
  },
  "20": {
   "jp": "92390f218a",
   "kr": "샴실단 녀석들이 몸값을 요구하고 있어."
  },
  "21": {
   "jp": "a635cbe8b5",
   "kr": "이 일을 맡을 생각이 있다면"
  },
  "22": {
   "jp": "9e249d9406",
   "kr": "２층으로 가 봐."
  },
  "23": {
   "jp": "43a46a0014",
   "kr": "안젤라 씨가 머물고 있으니까."
  },
  "24": {
   "jp": "19dd00f48d",
   "kr": "뉴보른의 소녀가"
  },
  "25": {
   "jp": "ad00edcdff",
   "kr": "심부름을 나간 채 돌아오지 않아요."
  },
  "26": {
   "jp": "5022708290",
   "kr": "아무래도 근처 동굴에 사는"
  },
  "27": {
   "jp": "06a6c63310",
   "kr": "마수에게 붙잡힌 모양이에요."
  },
  "28": {
   "jp": "7e062ea26d",
   "kr": "무사히 소녀를 구출하면 의뢰 완료예요."
  },
  "29": {
   "jp": "75f9a3c5da",
   "kr": "골다 동굴에 어쩐 일인지"
  },
  "30": {
   "jp": "a086c4a513",
   "kr": "꽤 많은 수의 마수가 눌러살게 됐어."
  },
  "31": {
   "jp": "cb3efde315",
   "kr": "그것도 흉포한 마수뿐이에요."
  },
  "32": {
   "jp": "af4c45ef43",
   "kr": "여행자와 행상인의 피해가 속출해서"
  },
  "33": {
   "jp": "3ca8984b68",
   "kr": "이대로는 가도 봉쇄도"
  },
  "34": {
   "jp": "a89481809b",
   "kr": "생각해야 해요."
  },
  "35": {
   "jp": "e92ff2bb49",
   "kr": "더 이상 피해자가 나오기 전에"
  },
  "36": {
   "jp": "a2d7b3026b",
   "kr": "동굴 안의 마수를 일소해야 해."
  },
  "37": {
   "jp": "8df589a48c",
   "kr": "보레아스 다리 근처 가도에서"
  },
  "38": {
   "jp": "58692bb207",
   "kr": "흉포한 거대 박쥐가 날뛰어서 아주 위험해."
  },
  "39": {
   "jp": "4de403eed0",
   "kr": "그 주변에는 여행자뿐 아니라"
  },
  "40": {
   "jp": "15ddb86f1e",
   "kr": "사냥꾼이나 산나물 캐는 사람들도 가서"
  },
  "41": {
   "jp": "32e73da48a",
   "kr": "정말 곤란해요."
  },
  "42": {
   "jp": "f3fae83b43",
   "kr": "얼마 전 잔비야의 부하를 한 명 붙잡았어."
  },
  "43": {
   "jp": "497916c18e",
   "kr": "그 샴실단 간부 말이야."
  },
  "44": {
   "jp": "e75d6c0a31",
   "kr": "어느 공작가의 가보인 조각상을"
  },
  "45": {
   "jp": "a33a2aa796",
   "kr": "보른 서쪽의 톨카스 동굴에 숨겼다는군."
  },
  "46": {
   "jp": "2c3e292b72",
   "kr": "그 조각상은 아주 귀중한 것이라"
  },
  "47": {
   "jp": "1f5f5b9c98",
   "kr": "서둘러 되찾아야 해요."
  },
  "48": {
   "jp": "a71fd1a27c",
   "kr": "지금 동굴에는 그리 강한 마수도 없고"
  },
  "49": {
   "jp": "a0071ac906",
   "kr": "무사히 조각상을 가져오기만 하면 되니까"
  },
  "50": {
   "jp": "0c1f8b796f",
   "kr": "당신이라면 쉬운 일이 되겠네."
  },
  "51": {
   "jp": "2acb7e93c0",
   "kr": "니키타가 귀여워하는"
  },
  "52": {
   "jp": "5564f89e66",
   "kr": "새끼 고양이가 돌아오지 않는대."
  },
  "53": {
   "jp": "a1d9847ba6",
   "kr": "아마 마을을 돌아다니고 있을 거야."
  },
  "54": {
   "jp": "7cc475b41d",
   "kr": "마수 퇴치와 달리 위험도 없으니"
  },
  "55": {
   "jp": "94b8554468",
   "kr": "가볍게 해결할 수 있을 거야."
  },
  "56": {
   "jp": "fd0c172877",
   "kr": "니키타에게 새끼 고양이의 자세한 특징을 물어봐."
  },
  "57": {
   "jp": "69d1138ab6",
   "kr": "기묘한 사건이야."
  },
  "58": {
   "jp": "094b44a37b",
   "kr": "아이 셋이 갑자기 실종됐어요."
  },
  "59": {
   "jp": "0f8691202a",
   "kr": "유괴됐을 가능성도 있어요."
  },
  "60": {
   "jp": "49a839aa8b",
   "kr": "전혀 단서가 없어서"
  },
  "61": {
   "jp": "1f5e32e8f4",
   "kr": "우리도 속수무책이야."
  },
  "62": {
   "jp": "4b9a54b34b",
   "kr": "실종된 아이들의 이름은"
  },
  "63": {
   "jp": "bb19daf482",
   "kr": "디노, 팜, 에뉴예요."
  },
  "64": {
   "jp": "7941714d94",
   "kr": "어떻게든 찾아내 주세요."
  },
  "65": {
   "jp": "dd5688655f",
   "kr": "보른까지 짐을 나르는 일이야."
  },
  "66": {
   "jp": "28c2d1427c",
   "kr": "짐에 대해서는 랑 씨에게 물어보세요."
  },
  "67": {
   "jp": "5bc0d3730d",
   "kr": "보른이라면 금방 도착하니까"
  },
  "68": {
   "jp": "093c23ffeb",
   "kr": "그리 힘들지 않아."
  },
  "69": {
   "jp": "53efa99b8f",
   "kr": "하지만 충분히 조심해서 가세요."
  },
  "70": {
   "jp": "66b6f9f8cd",
   "kr": "발크드까지 짐을 나르는 일이야."
  },
  "71": {
   "jp": "43cc4ea063",
   "kr": "짐에 대해서는 다론 씨에게 물어보세요."
  },
  "72": {
   "jp": "e63ce3e075",
   "kr": "다론 씨는 이 여관 바로 서쪽에 있는"
  },
  "73": {
   "jp": "799cc8ecac",
   "kr": "술통 오두막에서 기다리고 있어."
  },
  "74": {
   "jp": "dcdf4a3933",
   "kr": "바로아까지 짐을 나르는 일이야."
  },
  "75": {
   "jp": "d95164042f",
   "kr": "짐에 대해서는 에리트 씨에게 물어보세요."
  },
  "76": {
   "jp": "f92f9a968a",
   "kr": "에리트 씨는 맞은편 여관 술집에 있어."
  },
  "77": {
   "jp": "9a7b8798ce",
   "kr": "짐을 나르기만 하는"
  },
  "78": {
   "jp": "6468080a6d",
   "kr": "간단한 일이야."
  },
  "79": {
   "jp": "02296d3725",
   "kr": "짐과 수취인은 지나에게"
  },
  "80": {
   "jp": "8a41a2789f",
   "kr": "물어봐."
  },
  "81": {
   "jp": "8bc51a8d32",
   "kr": "지나는 도구점에 있을 거야."
  },
  "82": {
   "jp": "320712c7cf",
   "kr": "알렉 씨는 요즘 보기 드문 효자야."
  },
  "83": {
   "jp": "7d7b7487a1",
   "kr": "나이 든 아버지와 둘이 살고 있어."
  },
  "84": {
   "jp": "54a6e2df2e",
   "kr": "얼마 전 아버지가 다리를 다치셨거든."
  },
  "85": {
   "jp": "c9d20b0cad",
   "kr": "제대로 걷지 못하게 됐어요."
  },
  "86": {
   "jp": "1a534d1f71",
   "kr": "알렉 씨 대신 의사를 부르러 가 줄 사람을"
  },
  "87": {
   "jp": "311ea60016",
   "kr": "찾고 있어."
  },
  "88": {
   "jp": "8e2ed27db0",
   "kr": "알렉 씨는 무기점 지하에 있어."
  },
  "89": {
   "jp": "58c0521759",
   "kr": "의뢰인은 여관 술집에 묵고 있는 가르시아 씨예요."
  },
  "90": {
   "jp": "5cb2cb9308",
   "kr": "일전에 보른을 떠났을 때"
  },
  "91": {
   "jp": "b819e31b27",
   "kr": "마수에게 습격당해 상품을 도둑맞았어."
  },
  "92": {
   "jp": "67c3f70b1e",
   "kr": "상품은 캐비어 ２킬로그램."
  },
  "93": {
   "jp": "59b9516895",
   "kr": "하필이면 짐 중에서 가장 비싼 게"
  },
  "94": {
   "jp": "a30cbd699a",
   "kr": "도둑맞은 거지."
  },
  "95": {
   "jp": "8e6796b3d2",
   "kr": "마수의 소굴이 스콜파 동굴에 있다는 건 알고 있어요."
  },
  "96": {
   "jp": "924cc212de",
   "kr": "캐비어를 되찾아서"
  },
  "97": {
   "jp": "a0872f276f",
   "kr": "여관 술집에 있는 가르시아 씨에게 전해 주세요."
  },
  "98": {
   "jp": "0935c7dd1b",
   "kr": "그냥 편지 배달이지만"
  },
  "99": {
   "jp": "46ac4a52af",
   "kr": "여기서 필딘까지는 좀 멀지."
  },
  "100": {
   "jp": "82b3489e44",
   "kr": "그쪽에 갈 일이 있으면 맡아도 좋지 않을까?"
  },
  "101": {
   "jp": "2d8df6916c",
   "kr": "먼저 가르시아 씨에게 가 봐."
  },
  "102": {
   "jp": "8a454754c7",
   "kr": "아무튼 『실력 좋은 사람』이 조건이야."
  },
  "103": {
   "jp": "60996ea1c3",
   "kr": "배달할 상품이 꽤 값비싼 물건인가 봐."
  },
  "104": {
   "jp": "c08ae6a63a",
   "kr": "가도 주변에는 그 샴실단이 나오고"
  },
  "105": {
   "jp": "bb0b48523a",
   "kr": "마수도 얕볼 수 없으니까."
  },
  "106": {
   "jp": "58f54bf181",
   "kr": "가르시아 씨에게 가서"
  },
  "107": {
   "jp": "2ebb7a2009",
   "kr": "직접 짐을 받으세요."
  },
  "108": {
   "jp": "d878803f5f",
   "kr": "루마 동굴에는 룬크리스탈이라는"
  },
  "109": {
   "jp": "61c84feb4f",
   "kr": "비보가 있다고 전해지고 있어요."
  },
  "110": {
   "jp": "9f7e1933df",
   "kr": "그 전승을 믿고"
  },
  "111": {
   "jp": "3f5280de8c",
   "kr": "지금까지 여러 모험가가 동굴에 도전했지만"
  },
  "112": {
   "jp": "a38d0a363d",
   "kr": "비보를 가져온 사람은 없어요."
  },
  "113": {
   "jp": "166194ddc4",
   "kr": "동굴이 복잡하게 얽혀 있어서"
  },
  "114": {
   "jp": "9e5817c328",
   "kr": "수색이 어려운 모양이야."
  },
  "115": {
   "jp": "108ca405d9",
   "kr": "분명 끈기 싸움이 될 거예요."
  },
  "116": {
   "jp": "e95fc60cec",
   "kr": "알선소는 직속 조사원을 통해"
  },
  "117": {
   "jp": "9a6c9c590a",
   "kr": "여러 정보를 얻고 있어요."
  },
  "118": {
   "jp": "fa36af7f46",
   "kr": "조사원은 모든 마을에서 다양한 직업을 가지고"
  },
  "119": {
   "jp": "6de4a1b32c",
   "kr": "생활하고 있어."
  },
  "120": {
   "jp": "1974991cf5",
   "kr": "한눈에 조사원임을 알면 의미가 없으니까."
  },
  "121": {
   "jp": "36e80b7a2c",
   "kr": "그런 조사원 한 명에게서"
  },
  "122": {
   "jp": "0fd0eca5ff",
   "kr": "보고서를 받아 줬으면 해."
  },
  "123": {
   "jp": "c3e62b1ad3",
   "kr": "조사 내용은 샴실단에 대해서예요."
  },
  "124": {
   "jp": "aae61408f0",
   "kr": "받는 장소는 골다 동굴이야."
  },
  "125": {
   "jp": "a7c09c5425",
   "kr": "톨카스 동굴에는"
  },
  "126": {
   "jp": "3cc938264c",
   "kr": "꽤 많은 마수가 눌러살고 있어요."
  },
  "127": {
   "jp": "c6fa2a6658",
   "kr": "이대로 마수가 늘어나면"
  },
  "128": {
   "jp": "94f5d52a72",
   "kr": "여행자에게까지 위험이 미쳐."
  },
  "129": {
   "jp": "aaf79a41f4",
   "kr": "하루빨리 마수를 퇴치해 줬으면 해."
  },
  "130": {
   "jp": "ab36cdfe34",
   "kr": "마수의 강함과 수를 생각하면"
  },
  "131": {
   "jp": "ee9425b9ff",
   "kr": "꽤 높은 역량이 요구되는 일이야."
  },
  "132": {
   "jp": "198c616fa7",
   "kr": "이건 급한 일이야."
  },
  "133": {
   "jp": "dfbe01a23d",
   "kr": "탄제라는 남자아이가"
  },
  "134": {
   "jp": "f73d0cba9b",
   "kr": "가라일 동굴로 향한 것 같아."
  },
  "135": {
   "jp": "870c016c16",
   "kr": "왜 마수의 소굴이 된 동굴로"
  },
  "136": {
   "jp": "248e45c87f",
   "kr": "향했는지는 모르지만"
  },
  "137": {
   "jp": "ef7f5b650b",
   "kr": "탄제의 신변에 위험이 닥친 건 확실해요."
  },
  "138": {
   "jp": "bef1c25c24",
   "kr": "하루빨리 탄제를 데려와 줘."
  },
  "139": {
   "jp": "e36badc6e3",
   "kr": "이 일은 단순명쾌해."
  },
  "140": {
   "jp": "9b4b49d96f",
   "kr": "루마 동굴에서 마수를 토벌 중인 병사에게"
  },
  "141": {
   "jp": "1c3b2d61cb",
   "kr": "필딘으로 돌아오라고 전해 줘."
  },
  "142": {
   "jp": "37d0d90fdd",
   "kr": "루마 동굴에는 병사가 세 명 있을 거야."
  },
