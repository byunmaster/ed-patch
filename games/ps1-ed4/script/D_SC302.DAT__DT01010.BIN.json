  },
  "63": {
   "jp": "a49c1b96fe",
   "kr": "발크드의 할아버지가 아주 기뻐하세요."
  },
  "64": {
   "jp": "ebee0fefec",
   "kr": "오테로 할아버지를 만나면"
  },
  "65": {
   "jp": "b346561911",
   "kr": "오필리아가 감격했다고 전해 주세요."
  },
  "66": {
   "jp": "3eca45ec2f",
   "kr": "나, 곧 시집가요."
  },
  "67": {
   "jp": "a49c1b96fe",
