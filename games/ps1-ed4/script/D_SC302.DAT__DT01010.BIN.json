  },
  "55": {
   "jp": "d89f8695b9",
   "kr": "뭘까?"
  },
  "56": {
   "jp": "1185e091a0",
   "kr": "오테로한테서 맡은 짐을 건넸다."
  },
  "57": {
   "jp": "1308a8ca8e",
   "kr": "어머, 멋져!!"
  },
  "58": {
   "jp": "8c9661fb81",
