  },
  "14": {
   "jp": "d7387d55f7",
   "kr": "와하하하하하!"
  },
  "15": {
   "jp": "cf6568821e",
   "kr": "여기 통과 병 속은 뭘까…?"
  },
  "16": {
   "jp": "f70a0bafd8",
   "kr": "혹시 금제 밀수품이…"
  },
  "17": {
   "jp": "e3f9ad39ca",
   "kr": "짜잔～!"
  },
  "18": {
   "jp": "171b576eaf",
   "kr": "…하고 상상하며 나는 즐기고 있다네."
  },
  "19": {
   "jp": "121ea975fd",
   "kr": "내버려 두게. 이게 꽤 재미있다네."
  },
  "20": {
   "jp": "ad380d4d2a",
   "kr": "그 사람은 선원."
  },
  "21": {
   "jp": "1701f40f68",
   "kr": "나는 등대 곁에서 그 사람을 기다리는"
  },
  "22": {
   "jp": "aa273d464a",
   "kr": "조금 센티멘털한 소녀."
  },
  "23": {
   "jp": "c6fdf8009e",
   "kr": "순애보야."
  },
  "24": {
   "jp": "b54a8000ca",
   "kr": "너는 해적."
  },
  "25": {
   "jp": "7531100799",
   "kr": "나는 등대 곁에서 그 사람을 기다리는"
  },
  "26": {
   "jp": "b47e252fb1",
   "kr": "좀 우울한 항구의 여자."
  },
  "27": {
   "jp": "b251d9cd33",
   "kr": "트로트야."
  },
  "28": {
   "jp": "dd8ffeb991",
   "kr": "그 사람은 없어."
  },
  "29": {
   "jp": "192a1a80e9",
   "kr": "나는 등대 곁에서 그 사람의 모습을 좇는"
  },
  "30": {
   "jp": "5958c044db",
   "kr": "조금 슬픈 이방인."
  },
  "31": {
   "jp": "f549d8ddc4",
   "kr": "비극이야."
  },
  "32": {
   "jp": "cb158e23c0",
   "kr": "정말이지."
  },
  "33": {
   "jp": "d1b4799d39",
   "kr": "해적 소동 때문에 항구 장사가 파리를 날려."
  },
  "34": {
   "jp": "4d1d606d29",
   "kr": "누가 한 방 먹여 주지 않으려나."
  },
  "35": {
   "jp": "26bc8a5628",
   "kr": "어? 한 방 먹여 줬다고?"
  },
  "36": {
   "jp": "8e2c0e58a3",
   "kr": "정말이야? 그 말 들으니 속이 시원하네."
  },
  "37": {
   "jp": "0c776db58d",
   "kr": "해적 걱정을 안 해도 되면"
  },
  "38": {
   "jp": "85da6ff434",
   "kr": "일할 기운도 솟는 법이지."
  },
  "39": {
   "jp": "0fc6ebb882",
   "kr": "좋아, 힘내자!"
  },
  "40": {
   "jp": "9141db60e0",
   "kr": "알아?"
  },
  "41": {
   "jp": "54fa45393c",
   "kr": "세가레 영감과 페페리는 할아버지와 손녀인데."
  },
  "42": {
   "jp": "0ec2a1c369",
   "kr": "이게 또 성격이 닮았거든."
  },
  "43": {
   "jp": "9193ec3fc1",
   "kr": "몽상가랄까. 뭐랄까…"
  },
  "44": {
   "jp": "8bde51e692",
   "kr": "뭐, 신경 쓰지 말고 내버려 두는 게 좋아."
  },
  "45": {
   "jp": "574ccdf2ff",
   "kr": "그러고 보니"
  },
  "46": {
   "jp": "ec06da0ac8",
   "kr": "삼현자 중 한 분인 가웨인 님이 고용한 선원 중에"
  },
  "47": {
   "jp": "31488c679e",
   "kr": "토마스라는 우수한 녀석이 있었지."
  },
  "48": {
   "jp": "840fc5b054",
   "kr": "예전에 만났을 때"
  },
  "49": {
   "jp": "97d8f104b5",
   "kr": "가가브를 넘는 게 꿈이라고 했는데"
  },
  "50": {
   "jp": "60094ded7e",
   "kr": "넘었을까."
  },
  "51": {
   "jp": "6e849b7876",
   "kr": "어머, 무슨 일이세요?"
  },
  "52": {
   "jp": "aa8fde03a2",
   "kr": "전해 줄 물건을 가져왔어."
  },
  "53": {
   "jp": "f1ef6e2dab",
   "kr": "발크드의 오테로 할아버지가 보낸 거야."
  },
  "54": {
   "jp": "a806768e4d",
