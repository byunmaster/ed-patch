  "170": {
   "jp": "95fd6af003",
   "kr": "만나서 이야기는 할 수 있었는데."
  },
  "171": {
   "jp": "61b3eff14a",
   "kr": "아무래도 유령이었던 모양이야."
  },
  "172": {
   "jp": "ed8c599bd5",
   "kr": "역시 그랬나."
  },
  "173": {
   "jp": "1c4d3aff10",
   "kr": "그런 느낌이 들었어."
  },
  "174": {
   "jp": "690b255809",
   "kr": "어빈은 타오제의 뼈를 첸트에게 건넸다."
  },
  "175": {
   "jp": "14bc8fe964",
   "kr": "미안했다."
