   "auto": 1
  },
  "123": {
   "jp": "cd257d347a",
   "kr": "…오오, 지금이다! 써야 해!!",
   "auto": 1
  },
  "124": {
   "jp": "1aa882b44f",
   "kr": "작가란 힘들구나."
  },
  "125": {
   "jp": "6bc782686a",
   "kr": "참 나. 곤란한 예술가네."
  },
  "126": {
   "jp": "9ec327e1db",
   "kr": "무슨 일이지?"
  },
  "127": {
   "jp": "b9dd3c63fc",
   "kr": "나는 보시다시피 그저 그런 창고지기야."
