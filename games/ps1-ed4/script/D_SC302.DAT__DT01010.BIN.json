  },
  "6": {
   "jp": "d8d77969e5",
   "kr": "해적 소동에는 정말 곤란하구먼."
  },
  "7": {
   "jp": "6f4090855a",
   "kr": "이런 일로 세타와 바로아의 왕래가 끊기면"
  },
  "8": {
   "jp": "12b0051554",
   "kr": "엘 필딘의 발전도 미래도 없네."
  },
  "9": {
   "jp": "bf4601d02b",
   "kr": "해적 놈들도"
  },
  "10": {
   "jp": "b7237639a9",
   "kr": "그 점을 생각해 주면 좋으련만."
  },
  "11": {
   "jp": "8b17255c9a",
   "kr": "보레아스와 듀시스 지구가 배로 이어져"
  },
  "12": {
   "jp": "d96e9fe788",
   "kr": "상인의 물건이 유통되어 나라가 번영하는 것이네."
  },
  "13": {
   "jp": "bb8b29cec9",
