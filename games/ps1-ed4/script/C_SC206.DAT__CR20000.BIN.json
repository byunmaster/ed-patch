  },
  "25": {
   "jp": "9a08bb3858",
   "kr": "어머, 세상에!"
  },
  "26": {
   "jp": "6788226523",
   "kr": "호호호호…!"
  },
  "27": {
   "jp": "676e91c518",
   "kr": "왜 웃어?"
  },
  "28": {
   "jp": "bba46c8c6c",
   "kr": "여성"
  },
  "29": {
   "jp": "b0b78c08e1",
