  "0": {
   "jp": "4ab7037171",
   "kr": "선원 토마스"
  },
  "1": {
   "jp": "fe534985e4",
   "kr": "선원 폴"
  },
  "2": {
   "jp": "776125a118",
   "kr": "선원 한스"
  },
  "3": {
   "jp": "f0f266751b",
   "kr": "카나피아에는 대형선용 항구가 없소."
  },
  "4": {
   "jp": "833d1b7a80",
   "kr": "연안에 대기하다 작은 배로 갈아타야 하오."
  },
  "5": {
   "jp": "d33dbf269f",
   "kr": "불편한 곳이지만,"
  },
  "6": {
   "jp": "294496f515",
   "kr": "그렇기에 오크툼 신도에게 노려지지 않았을 것이오."
  },
  "7": {
   "jp": "0a847746ef",
   "kr": "하지만 놈들이 잘의 사당 위치를 알고"
  },
  "8": {
   "jp": "2f883be565",
   "kr": "그 이용 가치에 눈을 돌린다면…"
  },
  "9": {
   "jp": "f7a98d65ab",
   "kr": "카나피아는 순식간에 전장이 되오."
  },
  "10": {
   "jp": "03c1d8d3d4",
   "kr": "네 정령의 마지막 사당이오."
  },
  "11": {
   "jp": "85a80deece",
   "kr": "무엇이 기다리고 있을지… 예상도 못 하겠소."
  },
  "12": {
   "jp": "091531ed8a",
   "kr": "마음 단단히 먹고 가야 하오."
  },
  "13": {
   "jp": "07bf06d1cb",
   "kr": "그렇기에"
  },
  "14": {
   "jp": "0b308d1bca",
   "kr": "오크툼 신도의 표적이 되지 않았을 것이오."
  }
 }
}
