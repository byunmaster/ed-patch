 "segments": {
  "0": {
   "jp": "5094ed70e8",
   "kr": "으, 응, 어서 와. 기다리고 있었어."
  },
  "1": {
   "jp": "97f2c3dcfd",
   "kr": "일 맡아 주는 거지?"
  },
  "2": {
   "jp": "65124f2f1f",
   "kr": "내가 스투프야."
  },
  "3": {
   "jp": "7707197c93",
   "kr": "주사위 승부로 상품을 되찾는다고 들었는데."
  },
  "4": {
   "jp": "5da05b3c95",
   "kr": "나는 어디로 가면 되지?"
  },
  "5": {
   "jp": "564596071a",
   "kr": "뭐, 바로 저기 방 안이야."
  },
  "6": {
   "jp": "226587cad1",
   "kr": "저 작은 입구로 가면 작은 방이 나와."
  },
  "7": {
   "jp": "3be5d17066",
   "kr": "그런데 말이야, 하나 물어볼 게 있는데…"
  },
  "8": {
   "jp": "731b30bbf9",
   "kr": "군자금은 있어?"
  },
  "9": {
   "jp": "676a837887",
   "kr": "군자금?"
  },
  "10": {
   "jp": "9b1f732acd",
   "kr": "난 빈털터리거든."
  },
  "11": {
   "jp": "bdea5a9a40",
   "kr": "이제부터 자네는"
  },
  "12": {
   "jp": "a1549330de",
   "kr": "주사위 도박을 해 줘야 해."
  },
  "13": {
   "jp": "8fdc44c43b",
   "kr": "도박을 하려면 판돈이 필요하잖아."
  },
  "14": {
   "jp": "212523ab45",
   "kr": "경비는 우리가 대라는 거지?"
  },
  "15": {
   "jp": "3f5d6525a1",
   "kr": "알았어."
  },
  "16": {
   "jp": "eae0cfd6f9",
   "kr": "상품만 되찾아 주면 돼."
  },
  "17": {
   "jp": "485c5c30b1",
   "kr": "그 밖에 딴 건 전부 자네 거야."
  },
  "18": {
   "jp": "05d288bf90",
   "kr": "부탁해."
  },
  "19": {
   "jp": "05afbed2c0",
   "kr": "이번에 실패하면 목을 매는 수밖에 없어."
  },
  "20": {
   "jp": "8ec58df336",
   "kr": "도박꾼은"
  },
  "21": {
   "jp": "3e7bcb115f",
   "kr": "저 작은 입구로 가면 나오는 작은 방에 있어."
  },
  "22": {
   "jp": "adbaaa5f20",
   "kr": "힘내 줘."
  },
  "23": {
   "jp": "cebbfe43de",
   "kr": "인생은 주사위 눈 나름이지."
  },
  "24": {
   "jp": "5606dd3d9d",
   "kr": "꼬마야, 한 판 걸어 보겠냐?"
  },
  "25": {
   "jp": "1c7d901807",
   "kr": "그렇게 해서"
  },
  "26": {
   "jp": "7bbf45521f",
   "kr": "스투프 씨 것도 빼앗은 거야?"
  },
  "27": {
   "jp": "e10674ce39",
   "kr": "스투프?"
  },
  "28": {
   "jp": "72adec38cf",
   "kr": "당신한테 장사 물건을 빼앗긴 사람이"
  },
  "29": {
   "jp": "8fe614497e",
   "kr": "되찾아 달라고 부탁했어."
  },
  "30": {
   "jp": "a7f0f414cf",
   "kr": "이봐, 빼앗았다니 듣기 거북하군."
  },
  "31": {
   "jp": "6938fa9c9a",
   "kr": "승부에서 진 만큼 받았을 뿐이야."
  },
  "32": {
   "jp": "02be00a1af",
   "kr": "이것도 엄연한 거래라고."
  },
  "33": {
   "jp": "856d36b7ce",
   "kr": "법정에 가도 내가 이겨. 어때?"
  },
  "34": {
   "jp": "22335beed3",
   "kr": "…하지만 꼬마들 상대로"
  },
  "35": {
   "jp": "30602f64e6",
   "kr": "야박하게 굴 생각도 없어."
  },
  "36": {
   "jp": "6da48a5ab7",
   "kr": "한 판 어때, 놀이 삼아."
  },
  "37": {
   "jp": "4fe506f5ec",
   "kr": "내기에서 이기면 상품은 돌려주지."
  },
  "38": {
   "jp": "d7b8fb59d8",
   "kr": "잘하면 용돈까지 생길지도 모른다고?"
  },
  "39": {
   "jp": "5f71d7775a",
   "kr": "규칙은 간단해."
  },
  "40": {
   "jp": "e627b2c7de",
   "kr": "내가 던질 주사위 눈이 홀수인지 짝수인지."
  },
  "41": {
   "jp": "562d480fd0",
   "kr": "그걸 맞히기만 하면 돼."
  },
  "42": {
   "jp": "c275b52128",
   "kr": "해 보겠나?"
  },
  "43": {
   "jp": "70a9811514",
   "kr": "어이, 어때?"
  },
  "44": {
   "jp": "792f89e969",
   "kr": "승부 재개냐?"
  },
  "45": {
   "jp": "a44ba11391",
   "kr": "좋아, 좋아."
  },
  "46": {
   "jp": "93fb169be6",
   "kr": "사내라면 이래야지."
  },
  "47": {
   "jp": "311aa08246",
   "kr": "뭐, 안심해."
  },
  "48": {
   "jp": "e96cc172c0",
   "kr": "초보 꼬마 상대로 치사한 짓은 안 해."
  },
  "49": {
   "jp": "eee313be4f",
   "kr": "처음엔 가볍게 몸풀기다."
  },
  "50": {
   "jp": "ec2872b8e0",
   "kr": "１０로제부터 가자고."
  },
  "51": {
   "jp": "5440ec7a74",
   "kr": "고작 １０로제?"
  },
  "52": {
   "jp": "0208daee0e",
   "kr": "크게 걸었다가"
  },
  "53": {
   "jp": "a3aa0ac1df",
   "kr": "오늘 운이 나쁜 날이면 어쩔 건데?"
  },
  "54": {
   "jp": "a6310d65a3",
   "kr": "일단 시험 삼아 해 보는 거야."
  },
  "55": {
   "jp": "29226a8dcf",
   "kr": "자, 속임수 없다는 걸 증명하지."
  },
  "56": {
   "jp": "5049078da4",
   "kr": "주사위를 살펴보라고."
  },
  "57": {
   "jp": "3d6e0feacf",
   "kr": "어빈은 주사위를 확인해 보았다."
  },
  "58": {
   "jp": "995b50a910",
   "kr": "특별히 수상한 장치는 보이지 않는다."
  },
  "59": {
   "jp": "20b57b2841",
   "kr": "좋아, 그럼 간다."
  },
  "60": {
   "jp": "656c717dfa",
   "kr": "오오, 대박이다!!"
  },
  "61": {
   "jp": "78ed6b03c5",
   "kr": "운이 좋군."
  },
  "62": {
   "jp": "6c4c13c107",
   "kr": "그럼 １０로제."
  },
  "63": {
   "jp": "479a8cb5e5",
   "kr": "１０로제를 손에 넣었다."
  },
  "64": {
   "jp": "50b04ca693",
   "kr": "이 기세면 판돈을 올려도 괜찮을지 몰라."
  },
  "65": {
   "jp": "3f438f9b85",
   "kr": "이번엔 ２０로제로 걸어 보지 않겠나?"
  },
  "66": {
   "jp": "2586b3f70c",
   "kr": "헤헤헤, 그래야지."
  },
  "67": {
   "jp": "0018decc9f",
   "kr": "오오, 또 대박이다!!"
  },
  "68": {
   "jp": "c17a23e8f5",
   "kr": "운이 좋군!"
  },
  "69": {
   "jp": "fb3bf6d412",
   "kr": "또 내가 손해네…"
  },
  "70": {
   "jp": "cdb47935f3",
   "kr": "２０로제를 손에 넣었다."
  },
  "71": {
   "jp": "c72ab5f951",
   "kr": "지기만 해서야 나도 분하지."
  },
  "72": {
   "jp": "d355b52a85",
   "kr": "단숨에 되찾아 주마."
  },
  "73": {
   "jp": "bb05f97bef",
   "kr": "다시 두 배인 ４０로제로 승부다."
  },
  "74": {
   "jp": "1ed0efd3b3",
   "kr": "괜찮지?"
  },
  "75": {
   "jp": "2586b3f70c",
   "kr": "헤헤헤, 그래야지."
  },
  "76": {
   "jp": "f4c955657a",
   "kr": "우와, 이럴 수가!!"
  },
  "77": {
   "jp": "beb171993d",
   "kr": "젠장, 가져가라, 이 도둑놈아!"
  },
  "78": {
   "jp": "bf623be0a1",
   "kr": "４０로제를 손에 넣었다."
  },
  "79": {
   "jp": "d36010a9ef",
   "kr": "너, 나보다 도박꾼 아니냐?"
  },
  "80": {
   "jp": "3c091a2742",
   "kr": "이래선 장사 못 해먹겠다."
  },
  "81": {
   "jp": "2495e6bf98",
