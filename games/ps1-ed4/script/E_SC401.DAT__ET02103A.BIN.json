{
 "archive": "/E/SC401.DAT",
 "member": "..\\BIN\\ET02103A.BIN",
 "segments": {
  "0": {
   "jp": "02e1ece872",
   "kr": "먼저 충고해 두마."
  },
  "1": {
   "jp": "f4b8f580fd",
   "kr": "얌전히 신보를 넘기면 목숨만은 살려 주겠다."
  },
  "2": {
   "jp": "8a11f8f9de",
   "kr": "어리석은 소리를…!"
  },
  "3": {
   "jp": "4b24108d85",
   "kr": "신보는 강자의 증표다."
  },
  "4": {
   "jp": "fda93a41ee",
   "kr": "일찍이 오크툼 신의 봉인과 맞바꿔 묻힌"
  },
  "5": {
   "jp": "583f0e9a07",
   "kr": "발두스 신의 신체."
  },
  "6": {
   "jp": "879028dc8c",
   "kr": "카테드랄뿐 아니라"
  },
  "7": {
   "jp": "5cfd0f590b",
   "kr": "발크드에까지 우리의 침입을 허용한 너희에게"
  },
  "8": {
   "jp": "49d18aa53d",
   "kr": "강자의 증표를 가질 권리는 없다."
  },
  "9": {
   "jp": "ee9e64cce3",
   "kr": "기다려, 볼게이드!!"
  },
  "10": {
   "jp": "d7a064d651",
   "kr": "호오, 루티스인가."
  },
  "11": {
   "jp": "905b972896",
   "kr": "어떠냐. 기회를 주마."
  },
  "12": {
   "jp": "38e31a9b42",
   "kr": "나를 위해 일할 마음이 있다면"
  },
  "13": {
   "jp": "458c32b600",
   "kr": "우리를 애먹인 어빈과 아이멜을"
  },
  "14": {
   "jp": "e545378847",
   "kr": "이 자리에서 베어 버려라."
  },
  "15": {
   "jp": "123bfebb1d",
   "kr": "그리고 두 개의 신보를 선물로 들고"
  },
  "16": {
   "jp": "8eca97aeab",
   "kr": "내게 충성을 맹세하는 것이다."
  },
  "17": {
   "jp": "202bd7b836",
   "kr": "농담하지 마."
  },
  "18": {
   "jp": "a976c794c6",
   "kr": "너를 움직이는 건"
  },
  "19": {
   "jp": "27061eafec",
   "kr": "오크툼 신의 가르침도 뭣도 아니야."
  },
  "20": {
   "jp": "5141400eee",
   "kr": "그저 권력을 손에 넣기 위한 야망일 뿐이야."
  },
  "21": {
   "jp": "a115305a03",
   "kr": "그런 것에 힘을 보탤 까닭은 없어!"
  },
  "22": {
   "jp": "c99b274ccf",
   "kr": "어빈, 크로웰 님과 신보를 지켜!"
  },
  "23": {
   "jp": "162488c32e",
   "kr": "볼게이드는 나한테 맡겨!"
  },
  "24": {
   "jp": "d64ccf2238",
   "kr": "서둘러!!"
  },
  "25": {
   "jp": "53d0e3b8c5",
   "kr": "안 맞아… 실체가 아니야!?"
  },
  "26": {
   "jp": "5853f440f5",
   "kr": "후후후… 꿰뚫어 봤나."
  },
  "27": {
   "jp": "a5b31ec5dd",
   "kr": "과연 루티스로군."
  },
  "28": {
   "jp": "532667e95b",
   "kr": "그림자라서 발크드의 결계를 빠져나가는 것도"
  },
  "29": {
   "jp": "1bf0701dee",
   "kr": "가능했다는 거구나."
  },
  "30": {
   "jp": "0b8c8b795b",
   "kr": "얼빠진 바스터와 달리"
  },
  "31": {
   "jp": "2de40568d7",
   "kr": "이용 가치가 있을 것 같은 녀석이라 생각했건만…"
  },
  "32": {
   "jp": "61526a3f55",
   "kr": "기대 이하였군."
  },
  "33": {
   "jp": "ad6ae394f4",
   "kr": "루티스, 괴로워하며 죽어라."
  },
  "34": {
   "jp": "04bc0ad3de",
   "kr": "크로웰 님!"
  },
  "35": {
   "jp": "1c351f6eff",
   "kr": "무사하십니까!"
  },
  "36": {
   "jp": "42a44ebadb",
   "kr": "나는 걱정할 것 없네."
  },
  "37": {
   "jp": "42472be8c9",
   "kr": "자네들은 괜찮은가?"
  },
  "38": {
   "jp": "b6c024efaf",
   "kr": "오크툼 신도로 보이는 붉은 머리 남자가 침입했습니다."
  },
  "39": {
   "jp": "73e71d15c4",
   "kr": "다행히 다친 사람은 없습니다만"
  },
  "40": {
   "jp": "46c30d0138",
   "kr": "남자는 신전 안에 잠복 중입니다."
  },
  "41": {
   "jp": "faccf98e6a",
   "kr": "오오…"
  },
  "42": {
   "jp": "fb7292c606",
   "kr": "참배객들은?"
  },
  "43": {
   "jp": "0e84a6afd1",
   "kr": "신전 밖으로 대피시켰습니다."
  },
  "44": {
   "jp": "c4bb2abd6b",
   "kr": "현명한 판단이네."
  },
  "45": {
   "jp": "6792073521",
   "kr": "대체 왜 이런 일이…"
  },
  "46": {
   "jp": "9caf6bf6cd",
   "kr": "놈들이 노리는 건 카베사와 쿠엘포다."
  },
  "47": {
   "jp": "9f1ef8df70",
   "kr": "신보는 내가 가지고 있네."
  },
  "48": {
   "jp": "886c14642a",
   "kr": "하지만 예배당에…"
  },
  "49": {
   "jp": "2efe3689f8",
   "kr": "루티스 씨가 걱정돼요!"
  },
  "50": {
   "jp": "6a6f957f61",
   "kr": "신관장,"
  },
  "51": {
   "jp": "edba232f16",
   "kr": "전 승려를 동원해 크로웰 님과 신보를 지켜라."
  },
  "52": {
   "jp": "7dcff80c3b",
   "kr": "어빈, 돌아가자!"
  },
  "53": {
   "jp": "dde6f40fbc",
   "kr": "흥, 뜻밖의 훼방이 들어왔군."
  },
  "54": {
   "jp": "4707d7341e",
   "kr": "그건 그렇고",
   "auto": 1
  },
  "55": {
   "jp": "719507173c",
   "kr": "매드람 녀석은 어디로 갔지…"
  },
  "56": {
   "jp": "bba90c348b",
   "kr": "매드람!"
  },
  "57": {
   "jp": "e1bb2f0721",
   "kr": "뭘 하고 있었느냐!"
  },
  "58": {
   "jp": "93ba6a5d17",
   "kr": "서둘러 최고 도사 크로웰을 쫓아라!"
  },
  "59": {
   "jp": "abdd0e8eab",
   "kr": "그자가 신보를 가지고 있다."
  },
  "60": {
   "jp": "c928b9225f",
   "kr": "카베사와 쿠엘포를 빼앗아라!"
  },
  "61": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "62": {
   "jp": "fe83df95e5",
   "kr": "그건… 계약에 없다."
  },
  "63": {
   "jp": "a05c23fb4d",
   "kr": "말도 안 돼!"
  },
  "64": {
   "jp": "eaa4d1db5b",
   "kr": "모처럼의 기회를 헛되이 날릴 셈이냐!"
  },
  "65": {
   "jp": "6a9a0ca4c7",
   "kr": "알 바 아니다."
  },
  "66": {
   "jp": "cbc6256e15",
   "kr": "나는 살수다."
  },
  "67": {
   "jp": "ccf5540cb0",
   "kr": "일을 시키고 싶으면 계약을 맺어라."
  },
  "68": {
   "jp": "c4316d58c9",
   "kr": "…하긴 그림자와 계약할 마음은 없지만."
  },
  "69": {
   "jp": "42a10f8702",
   "kr": "신보가 갖고 싶거든 직접 가져라."
  },
  "70": {
   "jp": "52039281f2",
   "kr": "음…"
  },
  "71": {
   "jp": "3c6de15b3b",
   "kr": "안심해라."
  },
  "72": {
   "jp": "5f8246c506",
   "kr": "이미 맺은 계약은 반드시 지킨다."
  },
  "73": {
   "jp": "a71bff80dc",
   "kr": "…흥."
  },
  "74": {
   "jp": "0c52ce8544",
   "kr": "실체 없는 손으로 신보를 쥘 수 있을까 보냐."
  },
  "75": {
   "jp": "0dd7deb03c",
   "kr": "기껏해야 원격 마법으로"
  },
  "76": {
   "jp": "e1740136da",
   "kr": "약한 자를 괴롭히는 게 고작이지."
  },
  "77": {
   "jp": "6b395e7fae",
   "kr": "…이 아가씨도 불쌍하게도…"
  },
  "78": {
   "jp": "37b228b5e7",
   "kr": "…루티스 씨이!!"
  },
  "79": {
   "jp": "b80af2f4d7",
   "kr": "오크툼 신도로 보이는"
  },
  "80": {
   "jp": "d00151a486",
   "kr": "붉은 머리 남자가 침입했습니다."
  }
 }
}
