{
 "archive": "/E/SC400.DAT",
 "member": "..\\BIN\\ET01200.BIN",
 "segments": {
  "0": {
   "jp": "f4cd7a0904",
   "kr": "에린 할머니"
  },
  "1": {
   "jp": "2551373db5",
   "kr": "마발"
  },
  "2": {
   "jp": "4370be6449",
   "kr": "아직도 저의 훌륭함을 모르시는군요."
  },
  "3": {
   "jp": "77b6d5be21",
   "kr": "그래서는 한 사람 몫을 할 수 없어요."
  },
  "4": {
   "jp": "86eabe4a71",
   "kr": "발크드는 대도시니까"
  },
  "5": {
   "jp": "ee66d36e19",
   "kr": "어떤 지식이 굴러다닐지 기대돼요."
  },
  "6": {
   "jp": "b812532e79",
   "kr": "네가 헤어지겠다면 어쩔 수 없지."
  },
  "7": {
   "jp": "6e781003f6",
   "kr": "멍하니 가도를 걷지 마."
  },
  "8": {
   "jp": "6284131dbc",
   "kr": "도시에서 한 걸음만 나가면 마수의 위험이 기다리고 있어요."
  },
  "9": {
   "jp": "fcacf245b4",
   "kr": "장비를 잘 챙기세요."
  },
  "10": {
   "jp": "0adbfc8b23",
   "kr": "저, 함께 여행할 수 있어서 기뻤어요."
  },
  "11": {
   "jp": "66c529ca80",
   "kr": "너도 오래 살아라."
  },
  "12": {
   "jp": "6a6e8b6f61",
   "kr": "언젠가 또 만나자고."
  },
  "13": {
   "jp": "fa2a58d1d9",
   "kr": "정말로, 정말로 괜찮은 거지?"
  },
  "14": {
   "jp": "7ffb401897",
   "kr": "나 진짜 간다?"
  },
  "15": {
   "jp": "2fc7d82976",
   "kr": "…바이바이."
  },
  "16": {
   "jp": "b2bfe87039",
   "kr": "이별은 새로운 만남의 시작."
  },
  "17": {
   "jp": "ca50d35547",
   "kr": "기꺼이 떠나기로 하지요."
  },
  "18": {
   "jp": "e35a0ff947",
   "kr": "어빈아.",
   "auto": 1
  },
  "19": {
   "jp": "8a83f49ba5",
   "kr": "젊음에 맡겨 폭주하지 마라."
  },
  "20": {
   "jp": "64109de307",
   "kr": "저에게도 당신 또래의 손자가 있답니다."
  },
  "21": {
   "jp": "621b2b40d8",
   "kr": "곧 １７세가 되려나…"
  },
  "22": {
   "jp": "49b98fa624",
   "kr": "괜찮으면 친구분을 소개해 주시겠어요?"
  },
  "23": {
   "jp": "281ac7bd4b",
   "kr": "키가 조금 작은 친구가 좋아요."
  },
  "24": {
   "jp": "f08380e000",
   "kr": "어머, 어빈이구나…"
  },
  "25": {
   "jp": "4867f57bde",
   "kr": "할머니, 꼬마를 데려왔어."
  },
  "26": {
   "jp": "8638427545",
   "kr": "꼬마!?"
  },
  "27": {
   "jp": "e8fa4f1104",
   "kr": "형, 그건 너무하잖아."
  },
  "28": {
   "jp": "e9af64e64c",
   "kr": "나 이래 봬도 큰 편이라고."
  },
  "29": {
   "jp": "f547329386",
   "kr": "나보다 작으면 꼬마지."
  },
  "30": {
   "jp": "adf853382e",
   "kr": "칫, 두고 봐."
  },
  "31": {
   "jp": "f646ae19fe",
   "kr": "한창 클 나이를 얕보지 마."
  },
  "32": {
   "jp": "5e12459635",
   "kr": "호호호, 사이가 좋아서 보기 좋네요."
  },
  "33": {
   "jp": "09191c7ef8",
   "kr": "그럼 바로 도와줄래요?"
  },
  "34": {
   "jp": "3f164ddc6f",
   "kr": "에린은 라엘의 치수를 쟀다."
  },
  "35": {
   "jp": "12a1318e2d",
   "kr": "이제 됐어?"
  },
  "36": {
   "jp": "93e7ce10e6",
   "kr": "네, 완벽해요."
  },
  "37": {
   "jp": "b8a468e73f",
   "kr": "헤헤헤, 내가 도움이 된다면 뭐든 말해."
  },
  "38": {
   "jp": "d2ae28d221",
   "kr": "고마워요, 라엘."
  },
  "39": {
   "jp": "911643191d",
   "kr": "손자도 기뻐할 거예요."
  },
  "40": {
   "jp": "87af06262a",
   "kr": "자, 이제부터 바빠지겠네."
  },
  "41": {
   "jp": "2e82b9b572",
   "kr": "열심히 스웨터 만들어야지."
  },
  "42": {
   "jp": "e1d110c90f",
   "kr": "잠깐 말 걸지 말아 줘."
  },
  "43": {
   "jp": "a9d858b75e",
   "kr": "지금 아이디어를 짜는 중이야."
  },
  "44": {
   "jp": "d6c9892413",
   "kr": "최고의 반지를 만들기 위해서…"
  },
  "45": {
   "jp": "5a79b49783",
   "kr": "이야, 고마워, 고마워."
  },
  "46": {
   "jp": "7a2a9cf7fd",
   "kr": "기다리고 있었어."
  },
  "47": {
   "jp": "90f3b8f8fe",
   "kr": "원석을 건넸다."
  },
  "48": {
   "jp": "4efea39a7e",
   "kr": "…응?"
  },
  "49": {
   "jp": "a64dab1e98",
   "kr": "이건 보석 원석이잖아."
  },
  "50": {
   "jp": "05cac87040",
   "kr": "안 돼, 이래선."
  },
  "51": {
   "jp": "7c3a2f5984",
   "kr": "내가 부탁한 건 보석이 되다 만 에메리야."
  },
  "52": {
   "jp": "1a37c58f23",
   "kr": "담당관에게 돌려줘."
  },
  "53": {
   "jp": "13b1a1734a",
   "kr": "응, 훌륭한 에메리야."
  },
  "54": {
   "jp": "94f4ad3bf0",
   "kr": "좋은 작업을 할 수 있을 것 같아."
  },
  "55": {
   "jp": "f2fd86c61b",
   "kr": "정말 고마워."
  },
  "56": {
   "jp": "1b9d4454bf",
   "kr": "이야, 급히 부탁할 게 있는데…"
  },
  "57": {
   "jp": "d8543bfd8d",
   "kr": "…아."
  },
  "58": {
   "jp": "3290bdac92",
   "kr": "너희, 짐이 꽤 많구나."
  },
  "59": {
   "jp": "49874199e4",
   "kr": "조금 가볍게 하고 다시 와 주지 않겠어?"
  },
  "60": {
   "jp": "20282cacc6",
   "kr": "급하거든."
  },
  "61": {
   "jp": "194a18034a",
   "kr": "이야, 알선소에서 와 준 사람?"
  },
  "62": {
   "jp": "6ead828994",
   "kr": "귀찮은 일을 부탁해서 미안해."
  },
  "63": {
   "jp": "0671256230",
   "kr": "납기가 코앞인데 연마제가 떨어졌지 뭐야."
  },
  "64": {
   "jp": "0a56052e0a",
   "kr": "알선소에서 들었겠지만"
  },
  "65": {
   "jp": "83c4490c9f",
   "kr": "나는 보석을 가공하고 있어."
  },
  "66": {
   "jp": "46a1d716ff",
   "kr": "루비나 사파이어 같은 단단한 보석을 깎으려면"
  },
  "67": {
   "jp": "d56d44715d",
   "kr": "단단한 연마 모래를 써야 해."
  },
  "68": {
   "jp": "6700bee3cc",
   "kr": "에메리라는 게 필요해."
  },
  "69": {
   "jp": "b477113c51",
   "kr": "쉽게 말해 루비나 사파이어가 되다 만 거라네."
  },
  "70": {
   "jp": "e69d4014de",
   "kr": "필딘 채굴장에"
  },
  "71": {
   "jp": "c2a3aa8cf8",
   "kr": "굴러다니는 거야."
  },
  "72": {
   "jp": "5ae27e9acb",
   "kr": "이 소개장을 입구 담당관에게 주면"
  },
  "73": {
   "jp": "9152d94d11",
   "kr": "갱 안에 들여보내 줄 거야."
  },
  "74": {
   "jp": "8728e243d2",
   "kr": "한달음에 다녀와 주지 않겠어?"
  },
  "75": {
   "jp": "58d4829a92",
   "kr": "소개장을 맡았다."
  },
  "76": {
   "jp": "d7e2d1b865",
   "kr": "필딘 채굴장의 돌은"
  },
  "77": {
   "jp": "0467749357",
   "kr": "좋은 연마제가 되거든."
  },
  "78": {
   "jp": "def72cdae9",
   "kr": "납기가 가까우니 서둘러 부탁해."
  },
  "79": {
   "jp": "0de047847c",
   "kr": "자, 좋은 작품을 만들자."
  },
  "80": {
   "jp": "bdcecf09d2",
   "kr": "내 대표작으로 삼을 거야."
  },
  "81": {
   "jp": "dd1d56b916",
   "kr": "어머, 안녕하세요."
  },
  "82": {
   "jp": "4680b64014",
   "kr": "알선소에서 일을 맡아 주셨나요?"
  },
  "83": {
   "jp": "43f11cc631",
   "kr": "몇 살이에요?"
  },
  "84": {
   "jp": "1c029dec0e",
   "kr": "１７살이야."
  },
  "85": {
   "jp": "fc70557d5c",
   "kr": "어머."
  },
  "86": {
   "jp": "133bc20998",
   "kr": "마침 손자와 같은 나이네요."
  },
  "87": {
   "jp": "1891184516",
   "kr": "손자 생일 선물로"
  },
  "88": {
   "jp": "0914e8ef04",
   "kr": "스웨터를 선물하고 싶어요."
  },
  "89": {
   "jp": "ee0365e2af",
   "kr": "몰래 만들어서 깜짝 놀라게 하고 싶거든요."
  },
  "90": {
   "jp": "f106bba655",
   "kr": "그래서 본인을 잴 수는 없어서요."
  },
  "91": {
   "jp": "195d44d383",
   "kr": "이상한 부탁이라 미안해요."
  },
  "92": {
   "jp": "a1d49a4590",
   "kr": "바로 이쪽으로 오세요."
  },
  "93": {
   "jp": "7a48edd7b9",
   "kr": "…어머?"
  },
  "94": {
   "jp": "815a4a4819",
   "kr": "왜 그래, 할머니?"
  },
  "95": {
   "jp": "fa00aabe1a",
   "kr": "어머, 키가 아주 크네요."
  },
  "96": {
   "jp": "2d1172a020",
   "kr": "게다가 손자보다 훨씬 다부진 것 같아요."
  },
  "97": {
   "jp": "88a8e3a92f",
   "kr": "나로는 안 돼?"
  },
  "98": {
   "jp": "349e1efae1",
   "kr": "글쎄요."
  },
  "99": {
   "jp": "a53f02bf24",
   "kr": "제 손자는 오히려 작은 편일지도 몰라요."
  },
  "100": {
   "jp": "906b8f3817",
   "kr": "당신을 보고 있으니 그런 생각이 들었어요."
  },
  "101": {
   "jp": "453ddd9189",
   "kr": "글쎄요."
  },
  "102": {
   "jp": "c744561e2d",
   "kr": "…어머, 잠깐, 거기 꼬마."
  },
  "103": {
   "jp": "3d7f747ec1",
   "kr": "나 말이야?"
  },
  "104": {
   "jp": "1dca2a3ed4",
   "kr": "네.",
   "auto": 1
  },
  "105": {
   "jp": "35ba9042a9",
   "kr": "당신이라면 딱 알맞을지도 몰라요."
  },
  "106": {
   "jp": "11dd4299ef",
   "kr": "잘됐네."
  },
  "107": {
   "jp": "d2f2cc5684",
   "kr": "라엘, 도와드려."
  },
  "108": {
   "jp": "5323d35a32",
   "kr": "오케이!"
  },
  "109": {
   "jp": "849796e415",
   "kr": "자, 할머니, 어서요."
  },
  "110": {
   "jp": "f2fd86c61b",
   "kr": "고마워요."
  },
  "111": {
   "jp": "8b9855e84d",
   "kr": "그럼 잠깐 실례할게요."
  },
  "112": {
   "jp": "3f164ddc6f",
   "kr": "에린은 라엘의 치수를 쟀다."
  },
  "113": {
   "jp": "12a1318e2d",
   "kr": "이제 됐어?"
  },
  "114": {
   "jp": "93e7ce10e6",
   "kr": "네, 완벽해요."
  },
  "115": {
   "jp": "b8a468e73f",
   "kr": "헤헤헤, 내가 도움이 된다면 뭐든 말해."
  },
  "116": {
   "jp": "d2ae28d221",
   "kr": "고마워요, 라엘."
  },
  "117": {
   "jp": "911643191d",
   "kr": "손자도 기뻐할 거예요."
  },
  "118": {
   "jp": "741ecedbb3",
   "kr": "납기가 다가오는데"
  },
  "119": {
   "jp": "0bbd961f10",
   "kr": "연마제가 떨어졌지 뭐야."
  },
  "120": {
   "jp": "5ccfbf5cf6",
   "kr": "쉽게 말하면"
  },
  "121": {
   "jp": "4d2a42848b",
   "kr": "루비나 사파이어가 되다 만 거지."
  }
 }
