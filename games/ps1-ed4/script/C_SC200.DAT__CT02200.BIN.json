   "auto": 1
  },
  "8": {
   "jp": "795356a357",
   "kr": "무기점 안주인"
  },
  "9": {
   "jp": "23113b40e8",
   "kr": "도구점 주인",
   "auto": 1
  },
  "10": {
   "jp": "9abf801c67",
   "kr": "알리사"
  },
  "11": {
   "jp": "dfd66782fd",
   "kr": "도구점 안주인"
  },
  "12": {
   "jp": "7729ad8382",
   "kr": "용무가 있으시면"
  },
  "13": {
   "jp": "f545961981",
   "kr": "카운터로 와 주세요."
  },
  "14": {
   "jp": "aa0757d2a9",
   "kr": "헤어지고 나서야 제가 얼마나 필요한지 깨달을 거예요."
  },
  "15": {
   "jp": "de44ff3af8",
   "kr": "위층에서 읽던 책을 읽고 있을게요."
  },
  "16": {
   "jp": "a27bf50080",
   "kr": "마음이 내키면 불러 주세요."
  },
  "17": {
   "jp": "d180efd3f4",
   "kr": "싸움에서는 검 한 번 휘두르는 것이 목숨을 구하지."
  },
  "18": {
   "jp": "d8b6b60a81",
   "kr": "겁먹으면 안 돼."
  },
  "19": {
   "jp": "4fb15bb1ff",
   "kr": "서두를 때일수록 주변 경치에 눈을 돌려 보세요."
  },
  "20": {
   "jp": "a578350f92",
   "kr": "분명 상쾌한 바람을 느낄 수 있을 거예요."
  },
  "21": {
   "jp": "a1a95971f4",
   "kr": "여기서 헤어지는 건 슬퍼요."
  },
  "22": {
   "jp": "be138b23c7",
   "kr": "하지만 또 만날 수 있겠죠?"
  },
  "23": {
   "jp": "0ecb8148ff",
   "kr": "무기, 마법, 아이템을 자유자재로 써야"
  },
  "24": {
   "jp": "cca7fac5cd",
   "kr": "진짜 모험가라 할 수 있겠지."
  },
  "25": {
   "jp": "4fb00952b1",
   "kr": "다음에 만날 때까지"
  },
  "26": {
   "jp": "4ab9d6eaa6",
   "kr": "한 뼘 더 커져 있으라고."
  },
  "27": {
   "jp": "60d972586b",
   "kr": "그만둬, 말려 봐야 소용없어.",
   "auto": 1
  },
  "28": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "29": {
   "jp": "be551240c3",
   "kr": "이 마을엔 추억이 있으니까"
  },
  "30": {
   "jp": "ddbafd3b6f",
   "kr": "한동안 어슬렁거려 볼까."
  },
  "31": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "32": {
   "jp": "a4f46c7154",
   "kr": "이별은 달콤한 슬픔.",
   "auto": 1
  },
  "33": {
   "jp": "d8a37340af",
   "kr": "재회는 고향의 향기."
  },
  "34": {
   "jp": "ad1ad2e376",
   "kr": "어느 길모퉁이에서 또 뵙지요."
  },
  "35": {
   "jp": "4b59f66212",
   "kr": "내 힘이 필요할 때는",
   "auto": 1
  },
  "36": {
   "jp": "fc84a547dc",
   "kr": "찾아오너라."
  },
  "37": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "38": {
   "jp": "7cb6c92113",
   "kr": "우리 가게는 좋은 물건이 다 갖춰져 있어요."
  },
  "39": {
   "jp": "007175d3bd",
   "kr": "공장 쪽에서 사고라도 있었나요?"
  },
  "40": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "41": {
   "jp": "3e2ccf0887",
   "kr": "안쪽이 알선소, 지하가 여관입니다."
  },
  "42": {
   "jp": "fe8b8cd1ce",
   "kr": "집 지하에 아지트를 만들다니."
  },
  "43": {
   "jp": "60feaf7838",
   "kr": "지작도 그 정도 근성이 있다면"
  },
  "44": {
   "jp": "19ed2810b3",
   "kr": "착실히 일하면 좋았을 것을."
  },
  "45": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "46": {
   "jp": "9fcdd8afc1",
   "kr": "편히 쉬다 가세요."
  },
  "47": {
   "jp": "f77a705688",
   "kr": "아무튼 손님과 나, 곤트 이렇게"
  },
  "48": {
   "jp": "56e806ad02",
   "kr": "셋이서 연락을 주고받읍시다."
  },
  "49": {
   "jp": "28994cb4f5",
   "kr": "분명 뭔가 단서가 나올 겁니다요."
  },
  "50": {
   "jp": "0cb42e63ce",
   "kr": "어떻습니까?"
  },
  "51": {
   "jp": "603b099d4f",
   "kr": "지작 그 녀석은 찾았습니까?"
  },
  "52": {
   "jp": "c82a5b3f06",
   "kr": "루크레프 씨가 발견됐다더군요."
  },
  "53": {
   "jp": "d759f00b1d",
   "kr": "여러분이 찾아내셨습니까?"
  },
  "54": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "55": {
   "jp": "65b3eed4b2",
   "kr": "일을 찾으시면 안쪽 알선소로,"
  },
  "56": {
   "jp": "293411ee7a",
   "kr": "피곤하시면 지하 여관으로 가세요."
  },
  "57": {
   "jp": "ffe10177c3",
   "kr": "이 마을에서는 점이 대유행이야."
  },
  "58": {
   "jp": "3e659697b9",
   "kr": "근처에 마법대학교가 있잖아?"
  },
  "59": {
   "jp": "e6dc39fe00",
   "kr": "학생들 상담을 자주 해 주곤 해."
  },
  "60": {
   "jp": "ff4d01be76",
   "kr": "나는 점쟁이가 아니야."
  },
  "61": {
   "jp": "15c23dbdbf",
   "kr": "점 가게 주인이거든."
  },
  "62": {
   "jp": "35e88c79df",
   "kr": "별점이니 꿈점이니 이런저런 점이니 해서"
  },
  "63": {
   "jp": "e7675f7979",
   "kr": "점쳐 봤자"
  },
  "64": {
   "jp": "bf7411db23",
   "kr": "별일 없는 것만 다뤄."
  },
  "65": {
   "jp": "e3dd8c291e",
   "kr": "예언이나 신탁은 심각해서 싫잖아."
  },
  "66": {
   "jp": "ee94375f73",
   "kr": "게다가 자주 빗나가고."
  },
  "67": {
   "jp": "1f1ca04d64",
   "kr": "손님들도"
  },
  "68": {
   "jp": "71e9d3341b",
   "kr": "내 점으로 기뻐하는 것 같으니"
  },
  "69": {
   "jp": "f0a1d4ac96",
   "kr": "이만하면 됐어."
  },
  "70": {
   "jp": "60af53c02b",
   "kr": "점 보시겠어요?"
  },
  "71": {
   "jp": "5853d16326",
   "kr": "１회에 ６０로제를 받는데요."
  },
  "72": {
   "jp": "72b9c954d4",
   "kr": "그럼 먼저 돈을 받고…"
  },
  "73": {
   "jp": "b37590010d",
   "kr": "자, ６０로제. 확실히 받았어요."
  },
  "74": {
   "jp": "72b9c954d4",
   "kr": "그럼 먼저 돈을 받고…"
  },
  "75": {
   "jp": "dacaf7d87a",
   "kr": "어머?"
  },
  "76": {
   "jp": "129220f6f0",
   "kr": "돈이 모자라잖아."
  },
  "77": {
   "jp": "7a0a84567c",
   "kr": "일단 장사니까"
  },
  "78": {
   "jp": "f3d27f10ed",
   "kr": "돈이 있을 때"
  },
  "79": {
   "jp": "86719cad17",
   "kr": "다시 와 주세요."
  },
  "80": {
   "jp": "e696572ef3",
   "kr": "또 봐."
  },
  "81": {
   "jp": "9b2b440d7e",
   "kr": "후훗…"
  },
  "82": {
   "jp": "275101a640",
   "kr": "점 보는 게 무서워?"
  },
  "83": {
   "jp": "aac5ca4bb6",
   "kr": "걱정 안 해도 돼."
  },
  "84": {
   "jp": "eec4cbd313",
   "kr": "어차피 안 맞으니까."
  },
  "85": {
   "jp": "34673cc65d",
   "kr": "그럼 마음이 내키면 들러 봐."
  },
  "86": {
   "jp": "08b4877b89",
   "kr": "언제든 봐 줄 테니까."
  },
  "87": {
   "jp": "87669c67ed",
   "kr": "공장 쪽이 시끄러운 모양이군."
  },
  "88": {
   "jp": "47f587ac06",
   "kr": "비번이라 다행이야."
  },
  "89": {
   "jp": "ba1e812ca0",
   "kr": "나?"
  },
  "90": {
   "jp": "9ce97a0d38",
   "kr": "땡땡이치는 거 아니라고."
  },
  "91": {
   "jp": "17934309b9",
   "kr": "야근이 끝났거든."
  },
  "92": {
   "jp": "ba1e812ca0",
   "kr": "나?"
  },
  "93": {
   "jp": "ae86d26f59",
   "kr": "아까까지 일하고 있었으니까."
  },
  "94": {
   "jp": "a2364fe44c",
   "kr": "진짜라니까."
  },
  "95": {
   "jp": "ba1e812ca0",
   "kr": "나?"
  },
  "96": {
   "jp": "39d4551205",
   "kr": "헤헤… 땡땡이치는 중이지."
  },
  "97": {
   "jp": "437fc7fa4a",
   "kr": "어?"
  },
  "98": {
   "jp": "7f57b43fc3",
   "kr": "공장에서 무슨 일이 일어났어?"
  },
  "99": {
   "jp": "1a44e796e2",
   "kr": "어머, 나한테 무슨 볼일이라도?"
  },
  "100": {
   "jp": "fafc11bc95",
   "kr": "어서 와."
  },
  "101": {
   "jp": "797e409732",
   "kr": "살 게 있으면 주인한테 말해."
  },
  "102": {
   "jp": "3718d8a155",
   "kr": "저기 카운터에 있으니까."
  },
  "103": {
   "jp": "fafc11bc95",
   "kr": "어서 와."
  },
  "104": {
   "jp": "8c9a7f8093",
   "kr": "우리 물건은 믿을 만한 것뿐이야."
  },
  "105": {
   "jp": "51b5d28fef",
   "kr": "어라, 너희들이구나."
  },
  "106": {
   "jp": "cb9235f688",
   "kr": "가끔은 부모한테 효도 좀 해라."
  },
  "107": {
   "jp": "f1048aedda",
   "kr": "어머, 잘 왔다. 편히 있다 가렴."
  },
  "108": {
   "jp": "d70d6dd61e",
   "kr": "뭐니. 살 게 있으면 주인한테 말해."
  },
  "109": {
   "jp": "a86dc840bb",
   "kr": "저기 카운터에 있잖아."
  },
  "110": {
   "jp": "320238f865",
   "kr": "세타에서 코넬리 씨한테서"
  },
  "111": {
   "jp": "705a7c03d8",
   "kr": "이걸 맡아 왔어요."
  },
  "112": {
   "jp": "df95b810ac",
   "kr": "코넬리라면 내 아들이야."
  },
  "113": {
   "jp": "62fc973e64",
   "kr": "뭘 맡아 와 줬니?"
  },
  "114": {
   "jp": "29a3934091",
   "kr": "코넬리한테서 맡은 반지를 건넸다."
  },
  "115": {
   "jp": "a7a33882e5",
   "kr": "그러고 보니 그 아이가 어엿한 선원이 되면"
  },
  "116": {
   "jp": "ff64adc2e0",
   "kr": "나한테 커다란 보석이 박힌 반지를"
  },
  "117": {
   "jp": "98c25b5df9",
   "kr": "선물해 준다고 했었지."
  },
  "118": {
   "jp": "0ff0576099",
   "kr": "건방진 소리를 하며 나갔지만…"
  },
  "119": {
   "jp": "11ceb14c48",
   "kr": "어엿한 선원이 되었다는 뜻일까."
  },
  "120": {
   "jp": "51377ac40c",
   "kr": "어머나, 커다란 보석은 박혀 있지 않네."
  },
  "121": {
   "jp": "e81b083a1b",
   "kr": "그 아이가 집에 못 돌아올 이유 같은 건"
  },
  "122": {
   "jp": "06d926d676",
   "kr": "없다니까."
  },
  "123": {
   "jp": "d3415f1fa4",
   "kr": "쑥스러워서 폼 잡고 있을 뿐이야."
  },
  "124": {
   "jp": "76e9531fe9",
   "kr": "못 말리는 녀석이라니까."
  },
  "125": {
   "jp": "d10e034ead",
   "kr": "언제까지 폼만 잡지 말고 가끔은"
  },
  "126": {
   "jp": "791d533c40",
   "kr": "돌아오면 좋을 텐데."
  },
  "127": {
   "jp": "c0870a1d92",
   "kr": "너도 가끔은 부모님 계신 집에"
  },
  "128": {
   "jp": "40b738058c",
   "kr": "돌아가 보렴."
  },
  "129": {
   "jp": "4e93ddabf5",
   "kr": "분명 기뻐하실 테니까."
  },
  "130": {
   "jp": "8a4e26f079",
   "kr": "오늘은 멋진 물건을 가져다줘서"
  },
  "131": {
   "jp": "71ff16869b",
   "kr": "정말 고마워."
  },
  "132": {
   "jp": "32ababd56e",
   "kr": "무슨 일이니?"
  },
  "133": {
   "jp": "2807717e54",
   "kr": "뭘 가져다준 거니?"
  },
  "134": {
   "jp": "0babbc8bda",
   "kr": "서두를 때일수록"
  },
  "135": {
   "jp": "e6a249f23d",
   "kr": "주변 경치에 눈을 돌려 보세요."
  }
 }
