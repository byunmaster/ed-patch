  "0": {
   "jp": "c7c23f1d6a",
   "kr": "관리관"
  },
  "1": {
   "jp": "6e3cf1f518",
   "kr": "저기, 자네들."
  },
  "2": {
   "jp": "36f03ed692",
   "kr": "허가 없이 갱에 들어갈 수는 없어."
  },
  "3": {
   "jp": "51092bf9ae",
   "kr": "알선소 의뢰를 받은 모험가지?"
  },
  "4": {
   "jp": "c3f8c2f40e",
   "kr": "응."
  },
  "5": {
   "jp": "9ad6410aed",
   "kr": "사건이 일어났다고 들었는데?"
  },
  "6": {
   "jp": "307d2429d8",
   "kr": "아니, 그건 쑥스러워서 한 말이야."
  },
  "7": {
   "jp": "78447df108",
   "kr": "사건이라면 사건이긴 하지만."
  },
  "8": {
   "jp": "0c00297683",
   "kr": "곧 나와 아내의 결혼기념일이거든."
  },
  "9": {
   "jp": "032d4c5556",
   "kr": "그래서 선물로 진주 목걸이를"
  },
  "10": {
   "jp": "624e20e672",
   "kr": "사 뒀어."
  },
  "11": {
   "jp": "ebe986ab9e",
   "kr": "아내에게 주기 전까지 숨겨 두려고"
  },
  "12": {
   "jp": "749c67b8cc",
   "kr": "광산 보물상자에 넣어 둔 것까지는"
  },
  "13": {
   "jp": "d9a6181d1f",
   "kr": "좋았는데…"
  },
  "14": {
   "jp": "47e3decdd8",
   "kr": "막상 가지러 가려니"
  },
  "15": {
   "jp": "a665a4d3f8",
   "kr": "마수가 어슬렁거리지 뭐야."
  },
  "16": {
   "jp": "f0a4973768",
   "kr": "그래서 알선소에 울며 매달렸지."
  },
  "17": {
   "jp": "c3c1637a99",
   "kr": "그건 분명 사건이네요."
  },
  "18": {
   "jp": "8a005f4005",
   "kr": "저희가 진주 목걸이를"
  },
  "19": {
   "jp": "7149cdc052",
   "kr": "가져오면 되는 거죠?"
  },
  "20": {
   "jp": "17c017004e",
   "kr": "그거 곤란하셨겠어요."
  },
  "21": {
   "jp": "25ffc4f3d3",
   "kr": "저희가 진주 목걸이를"
  },
  "22": {
   "jp": "7149cdc052",
   "kr": "가져오면 되는 거죠?"
  },
  "23": {
   "jp": "3eec66b432",
   "kr": "아내분을 생각하시는군요."
  },
  "24": {
   "jp": "25ffc4f3d3",
   "kr": "저희가 진주 목걸이를"
  },
  "25": {
   "jp": "d45a17eb31",
   "kr": "가져오면 해결이죠?"
  },
  "26": {
   "jp": "64501a76b9",
   "kr": "참 난감한 아저씨네."
  },
  "27": {
   "jp": "c691779450",
   "kr": "그럼 그 진주 목걸이라는 걸"
  },
  "28": {
   "jp": "8e1ef054fa",
   "kr": "가져오면 되는 거지?"
  },
  "29": {
   "jp": "731a609ec8",
   "kr": "그래.",
   "auto": 1
  },
  "30": {
   "jp": "787d293a86",
   "kr": "진주 목걸이는 보물상자에 들어 있어."
  },
  "31": {
   "jp": "8477a361cb",
   "kr": "부디 부탁하네."
  },
  "32": {
   "jp": "787d293a86",
   "kr": "진주 목걸이는 보물상자에 들어 있어."
