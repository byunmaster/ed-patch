  "1": {
   "jp": "366172bf6b",
   "kr": "도적",
   "auto": 1
  },
  "2": {
   "jp": "c717c7213e",
   "kr": "두목"
  },
  "3": {
   "jp": "92908f926a",
   "kr": "루게이"
  },
  "4": {
   "jp": "3c42d6c051",
   "kr": "코레트"
  },
  "5": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "6": {
   "jp": "415f49326f",
   "kr": "을(를) 입수했다.",
   "auto": 1
  },
  "7": {
   "jp": "a1d26797a8",
   "kr": "과연, 이게 왕가의 보물이네."
  },
  "8": {
   "jp": "3c86c24725",
   "kr": "요란하게 덕지덕지 붙어서 좀 천박해 보여."
  },
  "9": {
   "jp": "19a3a8a283",
   "kr": "자, 얼른 알선소에 전하러 가자."
  },
  "10": {
   "jp": "6ee9a21765",
   "kr": "과연, 이것이 왕가의 보물이군요."
  },
  "11": {
   "jp": "e1f56370c5",
   "kr": "얼른 알선소에 전하러 가요."
  },
  "12": {
   "jp": "889ceea3f2",
   "kr": "보물상자에는 "
  },
  "13": {
   "jp": "665e4d5705",
   "kr": "이(가) 들어 있다.",
   "auto": 1
  },
  "14": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "15": {
   "jp": "f5fc3dee34",
   "kr": "을(를) 포기했다.",
   "auto": 1
  },
  "16": {
   "jp": "f99ec25289",
   "kr": "보물상자 안에는 아무것도 없다.",
   "auto": 1
  },
  "17": {
   "jp": "14f50aa66c",
   "kr": "뭐야, 네놈들은!"
  },
  "18": {
   "jp": "8fa919f28b",
   "kr": "잠깐."
  },
  "19": {
   "jp": "178f9b7af7",
   "kr": "이놈들, 그 계집애와 관련 있는 거 아냐?"
  },
  "20": {
   "jp": "c1010ac7b3",
   "kr": "그 루게이 형님의 통신문을 받은…"
  },
  "21": {
   "jp": "7fa4292041",
   "kr": "멍청아, 쓸데없는 말 마!"
  },
  "22": {
   "jp": "6b9c6ce31f",
   "kr": "어서 이놈들을 해치워!"
  },
  "23": {
   "jp": "ee73f56a5f",
   "kr": "여기는 샴실단의 구역이다!"
  },
  "24": {
   "jp": "43830ad312",
   "kr": "살아서 돌아가고 싶으면 당장 꺼져라!!"
  },
  "25": {
   "jp": "3eff51d056",
   "kr": "그런데 루게이 형님도"
  },
  "26": {
   "jp": "5767a2da24",
   "kr": "실수를 했단 말이지."
  },
  "27": {
   "jp": "ee855ea63e",
   "kr": "그 통신문이 일반인 아가씨한테 배달돼 버리다니."
  },
  "28": {
   "jp": "4f4dc7bd24",
   "kr": "뭐, 보통으로 읽을 때는 그냥 낯간지러운 편지니까…"
  },
  "29": {
   "jp": "da4948780e",
   "kr": "아니아니, 그렇게 방심하다가"
  },
  "30": {
   "jp": "7d1393302b",
   "kr": "목숨을 잃는 놈이 많다고."
  },
  "31": {
   "jp": "4b537dce7d",
   "kr": "그 정도 암호는 나도 알아."
  },
  "32": {
   "jp": "06c4602502",
   "kr": "가로로 쓴 글을 세로로 읽을 뿐이잖아."
  },
  "33": {
   "jp": "ddbeff9b2e",
   "kr": "『도크스 남쪽 사플에서 기다린다』인가."
  },
  "34": {
   "jp": "5c4086fb13",
   "kr": "관리 눈에 띄기라도 해 봐."
  },
  "35": {
   "jp": "5abfd50352",
   "kr": "이번 보물 분배회는 망한다."
  },
  "36": {
   "jp": "407bd65364",
   "kr": "맞는 말이야."
  },
  "37": {
   "jp": "74143de729",
   "kr": "그래서 루게이 형님도 그 계집애를 납치해 온 거군."
  },
  "38": {
   "jp": "9ce706d8ff",
   "kr": "그렇지."
  },
  "39": {
   "jp": "063793cbd0",
   "kr": "위험한 놈은 일찍 처리하는 게 좋아…"
  },
  "40": {
   "jp": "83647dcf81",
   "kr": "앗!",
   "auto": 1
  },
  "41": {
   "jp": "14f50aa66c",
   "kr": "뭐야, 네놈들은!"
  },
  "42": {
   "jp": "8a7a760067",
   "kr": "수상한 놈이다!"
  },
  "43": {
   "jp": "39edd2f938",
   "kr": "죽여라!!"
  },
  "44": {
   "jp": "dce04b4bf7",
   "kr": "네놈들은…!"
  },
  "45": {
   "jp": "10ac92ea66",
   "kr": "어디로 들어왔지?"
  },
  "46": {
   "jp": "6ad6fc7cb9",
   "kr": "…살려 주세요!"
  },
  "47": {
   "jp": "fe58a46b0c",
   "kr": "이런, 또 돌발 사태인가."
  },
  "48": {
   "jp": "499c46834d",
   "kr": "루게이,"
  },
  "49": {
   "jp": "ef6d5b4c96",
   "kr": "이 뒷수습을 어떻게 할 거냐?"
  },
  "50": {
   "jp": "e62e3e14f9",
   "kr": "그건…"
  },
  "51": {
   "jp": "5ccff05c49",
   "kr": "아, 아무튼 이놈들을!"
  },
  "52": {
   "jp": "ac58d9985a",
   "kr": "이 일은 잔비야 님 귀에 들어가게 할 거다."
  },
  "53": {
   "jp": "d2fbcd3651",
   "kr": "이놈들아!"
  },
  "54": {
   "jp": "9356ed1476",
   "kr": "쓸어버려!!"
  },
  "55": {
   "jp": "c80bfb6b01",
   "kr": "괜찮으세요?!"
  },
  "56": {
   "jp": "5d98c24985",
   "kr": "아아… 무서웠어."
  },
  "57": {
   "jp": "6a3ba2563f",
   "kr": "죽는 줄 알았어…"
  },
  "58": {
   "jp": "708c54a146",
   "kr": "늦지 않아서 다행이에요."
  },
  "59": {
   "jp": "0406db6d4e",
   "kr": "집까지 바래다줄게요."
  },
  "60": {
   "jp": "343bce9ffa",
   "kr": "감사합니다.",
   "auto": 1
  },
  "61": {
   "jp": "268f1dbf9b",
   "kr": "저는 필딘의 코레트예요."
  },
  "62": {
   "jp": "1dca2a3ed4",
   "kr": "네.",
   "auto": 1
  },
  "63": {
   "jp": "d94fa70a6d",
   "kr": "아버님께 의뢰를 받았어요."
  },
  "64": {
   "jp": "6eb1f8f681",
   "kr": "얼른 돌아가서 안심시켜 드려요."
  },
  "65": {
   "jp": "0e8c5e8000",
   "kr": "뭐, 그냥 읽으면"
  },
  "66": {
   "jp": "6dcc3c1fd5",
   "kr": "그냥 낯간지러운 편지니까…"
  }
 }
}
