{
 "archive": "/E/SC401.DAT",
 "member": "..\\BIN\\ET02100A.BIN",
 "segments": {
  "0": {
   "jp": "2a2fb4709d",
   "kr": "미첼 씨가 진실의 섬에 같이 가 줘서"
  },
  "1": {
   "jp": "542fa8ac13",
   "kr": "정말 살았어."
  },
  "2": {
   "jp": "000db0f698",
   "kr": "나 혼자서는 도저히 도착하지 못했을 거야."
  },
  "3": {
   "jp": "5e19280085",
   "kr": "어빈.",
   "auto": 1
  },
  "4": {
   "jp": "a99930f073",
   "kr": "앞으로 어쩔 셈이오?"
  },
  "5": {
   "jp": "07b9e52ae8",
   "kr": "글쎄. 이제 딱히 목적도 없어."
  },
  "6": {
   "jp": "b8fdc2e89b",
   "kr": "…다만."
  },
  "7": {
   "jp": "91fa945a6c",
   "kr": "다만?"
  },
  "8": {
   "jp": "24710b5e3c",
   "kr": "진실의 섬에서 영상을 몇 개 봤어요."
  },
  "9": {
   "jp": "12f87b295f",
   "kr": "영상이라니?"
  },
  "10": {
   "jp": "e96fbe49d8",
   "kr": "미첼 씨 말로는"
  },
  "11": {
   "jp": "12dbf260ce",
   "kr": "앞으로 내 인생의 힌트가 숨어 있다는군."
  },
  "12": {
   "jp": "6648e896ea",
   "kr": "신탁 같은 것이오?"
  },
  "13": {
   "jp": "6c15314f33",
   "kr": "아마도."
  },
  "14": {
   "jp": "cf9318dfaf",
   "kr": "보인 풍경은 아는 곳도 있었지만"
  },
  "15": {
   "jp": "31d25d0f00",
   "kr": "전혀 모르는 곳도 있었어."
  },
  "16": {
   "jp": "18bf452454",
   "kr": "레뮤라스 할아버지와 살던 집."
  },
  "17": {
   "jp": "1082bfd3fb",
   "kr": "수로가 지나는 유적에서 명상하는 신관 같은 사람."
  },
  "18": {
   "jp": "a2d2c830c9",
   "kr": "호수 위에 떠 있는 마을."
  },
  "19": {
   "jp": "77f2082ce1",
   "kr": "그리고 쓸쓸한 묘지."
  },
  "20": {
   "jp": "44d0d5489f",
   "kr": "네 곳이오?"
  },
  "21": {
   "jp": "c3f8c2f40e",
   "kr": "그래."
  },
  "22": {
   "jp": "bd40bf1c93",
   "kr": "흠… 수로가 지나는 유적이라면"
  },
  "23": {
   "jp": "8b3873f772",
   "kr": "아마 가든힐의 천공 유적일 것이오."
  },
  "24": {
   "jp": "a9c1ef7643",
   "kr": "호수에 떠 있는 마을은 서쪽 모스 호수에 있는 키트 마을인가."
  },
  "25": {
   "jp": "10ae7ebda6",
   "kr": "나머지는 묘지…"
  },
  "26": {
   "jp": "cb0ba3bf33",
   "kr": "그것만으로는 특징이 없어 짐작이 가지 않는구려."
  },
  "27": {
   "jp": "2d60951b4e",
   "kr": "아무튼 찾아가 보려고."
  },
  "28": {
   "jp": "dd3d9fd204",
   "kr": "알선소 일이라도 하면서"
  },
  "29": {
   "jp": "44c1c602f2",
   "kr": "어떻게든 먹고살며"
  },
  "30": {
   "jp": "feb120f486",
   "kr": "그 네 곳을 찾아볼 생각이야."
  },
  "31": {
   "jp": "7f571b6e25",
   "kr": "모처럼 진실의 섬에서 받은 신탁을"
  },
  "32": {
   "jp": "f4722efb71",
   "kr": "이대로 헛되이 하기도 마음에 걸리니까."
  },
  "33": {
   "jp": "4343fcb731",
   "kr": "마일도 아이멜도 이제 없어."
  },
  "34": {
   "jp": "17daba4d8e",
   "kr": "나는 이제 혼자니까."
  },
  "35": {
   "jp": "dba693ca99",
   "kr": "혼자서 여행을 계속할 수밖에 없어."
  },
  "36": {
   "jp": "e786b69874",
   "kr": "혼자가 아니야."
  }
 }
}
