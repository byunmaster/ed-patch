  },
  "23": {
   "jp": "d57b435237",
   "kr": "망설일 시간 없어요."
  },
  "24": {
   "jp": "fad8416ed6",
   "kr": "저 아이를 구해요!"
  },
  "25": {
   "jp": "b0d9252542",
   "kr": "소녀",
   "auto": 1
  },
  "26": {
   "jp": "3f5aa0851c",
   "kr": "오빠, 고마워."
