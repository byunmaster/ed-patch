  },
  "37": {
   "jp": "2c540261e5",
   "kr": "잠깐, 너희."
  },
  "38": {
   "jp": "7f49bd25b4",
   "kr": "자, 잠깐만 기다려 줘!"
  },
  "39": {
   "jp": "c37f49af30",
   "kr": "여, 순찰 수고했어!"
  },
  "40": {
   "jp": "ddaa534ae4",
   "kr": "너희 덕분에 살았어."
  },
  "41": {
   "jp": "7eb0de15c7",
   "kr": "역시 내가 눈여겨본 보람이 있다니까."
  },
  "42": {
   "jp": "73f58c46db",
   "kr": "나는 이런 차림이지만"
  },
  "43": {
   "jp": "e92569220d",
   "kr": "싸움 훈련 같은 건 받은 적이 없어."
  },
  "44": {
   "jp": "adf0f315d7",
   "kr": "부탁이야, 너희. 어떻게든 해 줘."
  },
  "45": {
   "jp": "f4a685d6ff",
   "kr": "요즘은 공장에서 일하고 싶다는 젊은이가 많군."
  },
  "46": {
   "jp": "022dde80d0",
   "kr": "기아에서 자란 나로서는 기쁘기 그지없어."
  },
  "47": {
   "jp": "e5c7fb8ce0",
   "kr": "마음만 먹으면 순찰은 금방 끝나."
  },
  "48": {
   "jp": "4f9256161c",
   "kr": "빠뜨리지 않고 물어봐 줘."
  },
  "49": {
   "jp": "2159f3646c",
   "kr": "순찰 수고했네."
  },
  "50": {
   "jp": "539ec6320a",
   "kr": "보수 받는 걸 잊지 말게."
  },
  "51": {
   "jp": "36d97cf3b5",
   "kr": "여, 자네들인가."
  },
  "52": {
   "jp": "8d93838795",
   "kr": "또 무슨 일이 있으면 부탁하네."
  },
  "53": {
   "jp": "2eb47a048f",
   "kr": "이제 험악한 놈들은 안 오겠지."
  },
  "54": {
   "jp": "499452235c",
   "kr": "그게 걱정돼서 매일 몸을 단련하고 있어."
  },
  "55": {
   "jp": "ee89046232",
   "kr": "매일 훈련한 보람이 있어서"
  },
  "56": {
   "jp": "a72af569a0",
   "kr": "체력이 꽤 붙었어."
  },
  "57": {
   "jp": "5c8a742672",
   "kr": "오크툼 신도가 쳐들어와도"
  },
  "58": {
   "jp": "0c387dfbe2",
   "kr": "이번엔 막아 내고 말겠어."
  },
  "59": {
   "jp": "43d6c4bb1b",
   "kr": "무, 무서운 건 아닌데"
  },
  "60": {
   "jp": "ff97857c2e",
   "kr": "모, 몸이 안 움직여."
  },
  "61": {
   "jp": "4a299e19b1",
   "kr": "저, 정말이라고."
  },
  "62": {
   "jp": "c7292547f7",
   "kr": "기아는 공장과 광산으로 번성한 마을이야."
  },
  "63": {
   "jp": "6a7a4f2bfa",
   "kr": "여기 사는 사람 대부분이"
  },
  "64": {
   "jp": "b30ac8a38f",
   "kr": "공장과 관련된 일을 하고 있지."
  },
  "65": {
   "jp": "5fcc2cc5f6",
   "kr": "공장에는 용광로가 ５개 있어."
  },
  "66": {
   "jp": "e600fa9046",
   "kr": "그 옆에 담당자가 있으니까"
  },
  "67": {
   "jp": "4c6e856def",
   "kr": "이상이 없는지 물어보고 와 줘."
  },
  "68": {
   "jp": "290c366bb5",
   "kr": "한 바퀴 돌고 나한테 보고하면 끝이야."
  },
  "69": {
   "jp": "4e917525fa",
   "kr": "간단한 일이지만"
  },
  "70": {
   "jp": "f649a86dbd",
   "kr": "게을리하면 큰 사고로 이어질 수 있는 중요한 일이야."
  },
  "71": {
   "jp": "63c082deae",
   "kr": "너희에게 무리하게 부탁했으니"
  },
  "72": {
   "jp": "e649deae98",
   "kr": "보수도 ５００로제 준비할게."
  },
  "73": {
   "jp": "adbaaa5f20",
   "kr": "힘내 줘."
  },
  "74": {
   "jp": "203f324cad",
   "kr": "라브로아 때문에 날벼락을 맞았는데도"
  },
  "75": {
   "jp": "9b7d927de1",
   "kr": "정말 잘해 줬어."
  },
  "76": {
   "jp": "9da0ab10ea",
   "kr": "약속한 ５００로제야."
  },
  "77": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "78": {
   "jp": "f8851237f7",
   "kr": "을(를) 받았다.",
   "auto": 1
  },
  "79": {
   "jp": "898304f625",
   "kr": "아이고, 수고했어."
  },
  "80": {
   "jp": "51bab57b27",
   "kr": "잘해 줬어."
  },
  "81": {
   "jp": "3db9208853",
   "kr": "라브로아, 네가 잘난 척할 소리가 아니잖아."
  },
  "82": {
   "jp": "04ece7983e",
   "kr": "정말 어이가 없군!"
  },
  "83": {
   "jp": "f2decf7260",
   "kr": "어이쿠, 형세가 불리해졌네."
  },
  "84": {
   "jp": "aafd6be831",
   "kr": "그럼 공장 쪽으로 돌아가 볼까."
  },
  "85": {
   "jp": "67f72c5813",
   "kr": "라브로아보다는 너희 같은 젊은이를"
  },
  "86": {
   "jp": "78f92795db",
   "kr": "고용해야 하는데 말이야, 응."
  },
  "87": {
   "jp": "0779a374c5",
   "kr": "공장도 원래대로 가동하고 있고"
  },
  "88": {
   "jp": "3b9d6ca1b6",
   "kr": "아주 순조로워."
  },
  "89": {
   "jp": "14bdd1ba01",
   "kr": "공장 사람들은 정말 열심히 일하는군."
  },
  "90": {
   "jp": "c79ba7ed83",
   "kr": "대단하다니까."
  },
  "91": {
   "jp": "2ff57fa65e",
   "kr": "동 ",
   "auto": 1
  },
  "92": {
   "jp": "7722745105",
   "kr": "…"
  },
  "93": {
   "jp": "e0fcacb5ae",
   "kr": "서 ",
   "auto": 1
  },
  "94": {
   "jp": "7722745105",
   "kr": "…"
  },
  "95": {
   "jp": "7722745105",
   "kr": "…"
  },
  "96": {
   "jp": "29c0815c5c",
   "kr": "공장은 괜찮을까."
  },
  "97": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "98": {
   "jp": "4ce5672724",
   "kr": "열쇠 주문이신가요?"
  },
  "99": {
   "jp": "fafc11bc95",
   "kr": "어서 와."
  },
  "100": {
   "jp": "06f6a17fa0",
   "kr": "우리 남편한테 볼일이 있나?"
  },
  "101": {
   "jp": "3de16b3ea4",
   "kr": "저기, 여보…"
  },
  "102": {
   "jp": "76b75159a4",
   "kr": "루크레프는 정말 좋은 청년이야."
  },
  "103": {
   "jp": "f462385dd0",
   "kr": "제발 얼른 찾아 줘."
  },
  "104": {
   "jp": "3526e795db",
   "kr": "머리가 뻣뻣한 그 사람, 설마"
  },
  "105": {
   "jp": "daf9f8736c",
   "kr": "수배자인 건 아니겠죠?"
  },
  "106": {
   "jp": "d81318bcb1",
   "kr": "정보상한테 확인해 보는 게 좋으려나."
  },
  "107": {
   "jp": "d87209ed3a",
   "kr": "루크레프를 구해 주셨다면서요?"
  },
  "108": {
   "jp": "b5ca059e35",
   "kr": "저도 감사 인사를 드릴게요."
  },
  "109": {
   "jp": "497e141b42",
   "kr": "어빈 씨 아냐."
  },
  "110": {
   "jp": "61933ddbbb",
   "kr": "잠깐 차라도 마시고 가지 않을래?"
  },
  "111": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "112": {
   "jp": "4ce5672724",
   "kr": "열쇠 주문이신가요?"
  },
  "113": {
   "jp": "4a18b59a55",
   "kr": "엄청난 연기가 보였다고!"
  },
  "114": {
   "jp": "c97d5226f4",
   "kr": "공장은 괜찮은 거야?"
  },
  "115": {
   "jp": "1c538d0ea0",
   "kr": "고맙다, 어빈."
  },
  "116": {
   "jp": "7691b4f73d",
   "kr": "정말 고맙다니까."
  },
  "117": {
   "jp": "fd67125255",
   "kr": "여어, 어빈!"
  },
  "118": {
   "jp": "a036d62bb7",
   "kr": "잘 지내고 있냐?"
  },
  "119": {
   "jp": "a780f21363",
   "kr": "열쇠 일이라면 이 간프에게 맡겨 주세요."
  },
  "120": {
   "jp": "c9c8457159",
   "kr": "무서워…"
  },
  "121": {
   "jp": "614bbfe3e6",
   "kr": "공장 사람들은 괜찮을까."
  },
  "122": {
   "jp": "73bbb9535f",
   "kr": "루크레프는 최고의 열쇠 장인이야."
  },
  "123": {
   "jp": "9f1ce3cdd7",
   "kr": "이 사람과 함께하게 되어서 난 행복해."
  },
  "124": {
   "jp": "813753ac47",
   "kr": "너, 공장 쪽 보고 왔어?"
  },
  "125": {
   "jp": "fefc0b7d1c",
   "kr": "어땠어?"
  },
  "126": {
   "jp": "4d49d3630a",
   "kr": "정말 감사했습니다."
  },
  "127": {
   "jp": "7d45136c82",
   "kr": "여, 어빈 씨.",
   "auto": 1
  },
  "128": {
   "jp": "b8f1596d82",
   "kr": "혹시 만들었으면 하는 열쇠라도 있나요?"
  },
  "129": {
   "jp": "a68d8b502a",
   "kr": "안녕하세요."
  },
  "130": {
   "jp": "41408c1543",
   "kr": "저한테 무슨 볼일이라도 있으세요?"
  },
  "131": {
   "jp": "71bc947b89",
   "kr": "나한테 묻고 싶은 게 있어?",
   "auto": 1
  },
  "132": {
   "jp": "8304bf9a89",
   "kr": "모험가 정보",
   "auto": 1
  },
  "133": {
   "jp": "a29585b603",
   "kr": "비밀 정보",
   "auto": 1
  },
  "134": {
   "jp": "6ff9e4dcff",
   "kr": "잘 가라.",
   "auto": 1
  },
  "135": {
   "jp": "1e36f639e7",
   "kr": "자, 힘껏"
  },
  "136": {
   "jp": "56aa48f124",
   "kr": "어머님께 효도하는 거야!"
  },
  "137": {
   "jp": "9e4ae9ae3f",
   "kr": "이제부터는 느긋하게 살 거야."
  },
  "138": {
   "jp": "e8067f888e",
   "kr": "다정한 맥스가 보살펴 주기도 하고."
  },
  "139": {
   "jp": "d7acff9cd0",
   "kr": "무슨 일이라도 있는 건가?"
  },
  "140": {
   "jp": "f4e77951e2",
   "kr": "꽤 소란스럽군."
  },
  "141": {
   "jp": "b05e89ee35",
   "kr": "…끄응."
  },
  "142": {
   "jp": "31e97b05fe",
   "kr": "무슨 말을 해야 좋을지…"
  },
  "143": {
   "jp": "3d9f39ce85",
   "kr": "아들들 덕분에 요즘 겨우 부족함 없이"
  },
  "144": {
   "jp": "0867e888b4",
   "kr": "살 수 있게 되었다."
  },
  "145": {
   "jp": "bc9f505495",
   "kr": "좋은 아들을 둬서 나는 행복하다."
  },
  "146": {
   "jp": "d244532fca",
   "kr": "나는…"
  },
  "147": {
   "jp": "ca7902741b",
   "kr": "내 부모님께 똑같이 효도를 했던가?"
  },
  "148": {
   "jp": "74cf834cf7",
   "kr": "아이고, 고맙습니다."
  },
  "149": {
   "jp": "70b0d28bce",
   "kr": "신세 졌습니다."
  },
  "150": {
   "jp": "3a7dd18bc9",
   "kr": "오빠가 이 모양이라서요."
  },
  "151": {
   "jp": "cce033a697",
   "kr": "저도 이 모양이에요."
  },
  "152": {
   "jp": "31c1b9011a",
   "kr": "오오, 데려와 주었는가."
  },
  "153": {
   "jp": "c3dc50025f",
   "kr": "수고했네.",
   "auto": 1
  },
  "154": {
   "jp": "0a1f8821d4",
   "kr": "어라…?"
  },
  "155": {
   "jp": "c603c7c13b",
   "kr": "이 사람은 아닌데."
  },
  "156": {
   "jp": "696fcafb79",
   "kr": "사람을 잘못 봤군."
  },
  "157": {
   "jp": "d7f9cbbb4b",
   "kr": "어…"
  },
  "158": {
   "jp": "e64e258b3f",
   "kr": "우리 친척 아이는"
  },
  "159": {
   "jp": "1627d98f47",
   "kr": "타이거와 체리 남매라네."
  },
  "160": {
   "jp": "9ca298e5cc",
   "kr": "한 번만 더 다녀와 주게."
  },
  "161": {
   "jp": "0a1f8821d4",
   "kr": "어라…?"
  },
  "162": {
   "jp": "dacb82660b",
   "kr": "이쪽이… 타이거와 체리란 말인가?"
  },
  "163": {
   "jp": "8c2f8a4da3",
   "kr": "오빠와 여동생이라는 건"
  },
  "164": {
   "jp": "e9f60ec860",
   "kr": "알고 있겠지만 위가 남자고, 아래가 여자라는"
