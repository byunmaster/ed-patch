{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02000E.BIN",
 "segments": {
  "0": {
   "jp": "8caac833e8",
   "kr": "그래, 어서 와."
  },
  "1": {
   "jp": "65bd5d6476",
   "kr": "어이쿠, 자네들."
  },
  "2": {
   "jp": "2617a3f767",
   "kr": "신참 모험가들이로군."
  },
  "3": {
   "jp": "8ad656a31e",
   "kr": "알선소에 대해 설명해 줄까?"
  },
  "4": {
   "jp": "7e2702a2a7",
   "kr": "여비를 벌면서 하는 여행이라면"
  },
  "5": {
   "jp": "1573164dde",
   "kr": "알선소 일을 맡는 게 좋아."
  },
  "6": {
   "jp": "22d3682031",
   "kr": "제대로 된 기관이라"
  },
  "7": {
   "jp": "2dfbcd9b0f",
   "kr": "보수가 안 나오는 일도 없고 말이야."
  },
  "8": {
   "jp": "7fc18366a6",
   "kr": "알선소에는 정말 다양한 일이 등록되어 있어."
  },
  "9": {
   "jp": "bc3007483a",
   "kr": "편지나 짐 배달부터 시작해서"
  },
  "10": {
   "jp": "5a6a9f5f7d",
   "kr": "마수 퇴치나 어려운 사건 해결까지 뭐든 있지."
  },
  "11": {
   "jp": "26d6fc9165",
   "kr": "보수가 높은 일에는 그만큼 위험이 따라."
  },
  "12": {
   "jp": "510a29b4d7",
   "kr": "쉬운 일은 그만큼 벌이도 적고."
  },
  "13": {
   "jp": "a8e66c15f0",
   "kr": "자네들의 능력에 맞는 일을 고르게."
  },
  "14": {
   "jp": "e9466a9830",
   "kr": "특히 동굴이나 가도를 벗어난 산길 같은 곳에"
  },
  "15": {
   "jp": "031bb8dafb",
   "kr": "가야 하는 일은"
  },
  "16": {
   "jp": "fcd32208b0",
   "kr": "흉악한 마수와 마주치는 일이 많아."
  },
  "17": {
   "jp": "db8281c64b",
   "kr": "단련이 부족할 때는"
  },
  "18": {
   "jp": "e5c1c82dbb",
   "kr": "되도록 쉬운 일을 맡는 게 좋아."
  },
  "19": {
   "jp": "e6558bba0b",
   "kr": "그리고 어려운 일일 때는"
  },
  "20": {
   "jp": "028860b6e2",
   "kr": "정보상의 이야기를 들어 두면 좋지."
  },
  "21": {
   "jp": "a82f5448b3",
   "kr": "그 녀석들 대부분은 전직 모험가라"
  },
  "22": {
   "jp": "a97da183a7",
   "kr": "독자적인 네트워크를 갖고 있어."
  },
  "23": {
   "jp": "3c76de2bd5",
   "kr": "돈은 받지만 확실한 정보를 얻을 수 있지."
  },
  "24": {
   "jp": "eec741b0c5",
   "kr": "곤란한 일이 있으면 서로 돕는 거니까."
  },
  "25": {
   "jp": "7dfc19ee1c",
   "kr": "또 가게에 들러."
  },
  "26": {
   "jp": "ef28f7048d",
   "kr": "피곤하면 2층에서 쉬어도 좋아."
  },
  "27": {
   "jp": "fbb16e885e",
   "kr": "우리 집이 엘 필딘에서 제일 싼 여관이니까."
  },
  "28": {
   "jp": "e72c2a7a1e",
   "kr": "마수 퇴치나 어려운 사건 해결까지"
  },
  "29": {
   "jp": "5e8cd955f2",
   "kr": "뭐든 다 있지."
  }
 }
}
