{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02000J.BIN",
 "segments": {
  "0": {
   "jp": "1bd73790b7",
   "kr": "여, 요즘 어때."
  },
  "1": {
   "jp": "acc2fd226d",
   "kr": "힘든 때지."
  },
  "2": {
   "jp": "eed0e7244f",
   "kr": "이제 놀라고만 있을 때가 아니라는"
  },
  "3": {
   "jp": "c5a16b139e",
   "kr": "느낌이야."
  },
  "4": {
   "jp": "eb17bce4b4",
   "kr": "영차, 영차."
  },
  "5": {
   "jp": "12c14a0d80",
   "kr": "뭘 하고 있냐고?"
  },
  "6": {
   "jp": "42d8b749ca",
   "kr": "일 이미지 트레이닝이야."
  },
  "7": {
   "jp": "b00586a17e",
   "kr": "일하다 사고 나지 않도록"
  },
  "8": {
   "jp": "994877593d",
   "kr": "집에 있어도 정신 바짝 차리고 있거든."
  },
  "9": {
   "jp": "72f10a0c7e",
   "kr": "어이, 여행은 순조로워?"
  },
  "10": {
   "jp": "b07ba3ec74",
   "kr": "트란은 그 검은 램프를"
  },
  "11": {
   "jp": "ae86a2eb9c",
   "kr": "마음에 들어 했나?"
  },
  "12": {
   "jp": "5b864f33a7",
   "kr": "난 여행 상인한테 이것저것"
  },
  "13": {
   "jp": "06664b307f",
   "kr": "사는 게 아주 좋거든."
  },
  "14": {
   "jp": "7a43df1179",
   "kr": "뭐 좋은 물건 없어?"
  },
  "15": {
   "jp": "35b3f4d8a5",
   "kr": "어라, 또 왔네."
  },
  "16": {
   "jp": "e26ffec725",
   "kr": "우리 일에는 끝이 없어."
  },
  "17": {
   "jp": "1c8cb4ba43",
   "kr": "자, 일하자고."
  },
  "18": {
   "jp": "95edc9a34a",
   "kr": "무슨 일일까."
  },
  "19": {
   "jp": "8e56fd943b",
   "kr": "기아에 어서 와."
  },
  "20": {
   "jp": "df3204f246",
   "kr": "말은 그렇지만 용광로밖에 없어."
  },
  "21": {
   "jp": "7611880500",
   "kr": "어머, 편지 배달부 아냐?"
  },
  "22": {
   "jp": "41bb990fcb",
   "kr": "게이니한테 답장을 전해 줬지?"
  },
  "23": {
   "jp": "7a5a054718",
   "kr": "당신들은 여행이 본업이죠?"
  },
  "24": {
   "jp": "64f3f42cef",
   "kr": "그런데 여행자도 직업인가?"
  },
  "25": {
   "jp": "ac9c982f41",
   "kr": "잘 모르겠네."
  },
  "26": {
   "jp": "02d3a5bf17",
   "kr": "여행자라는 직업도 꽤 괜찮다고 생각해."
  },
  "27": {
   "jp": "2abfc533f7",
   "kr": "멋있잖아."
  },
  "28": {
   "jp": "7e33595bc4",
   "kr": "이런 이런, 큰일이 났군."
  },
  "29": {
   "jp": "bcf1e3cea5",
   "kr": "오늘의 일기 '오늘은 아무 일도 없었다.'라고"
  },
  "30": {
   "jp": "83ec4cfa48",
   "kr": "쓰려고 했는데 '눈앞에서 여행자가 보고 있다'"
  },
  "31": {
   "jp": "bf0d575554",
   "kr": "…라고."
  },
  "32": {
   "jp": "5e7a5e80fb",
   "kr": "코르나는 추운 곳이었지?"
  },
  "33": {
   "jp": "7b9211b6ac",
   "kr": "니트 씨는 얼어붙지 않았어?"
  },
  "34": {
   "jp": "ac9757859b",
   "kr": "자, 오늘도 일기를 써 볼까."
  },
  "35": {
   "jp": "891ffbd5ae",
   "kr": "'또 눈앞에 여행자가 있다.'라고."
  },
  "36": {
   "jp": "648f4b9dbe",
   "kr": "아아, 자네들이군."
  },
  "37": {
   "jp": "18e589281f",
   "kr": "저기, 너희 여행 이야기 좀 들려줘."
  },
  "38": {
   "jp": "f8e34243ca",
   "kr": "내 일기에 써 줄 테니까."
  },
  "39": {
   "jp": "8edca72b2e",
   "kr": "부탁한 물건은 제대로 도착한 모양이네요."
  },
  "40": {
   "jp": "f2fd86c61b",
   "kr": "정말 고마워요."
  },
  "41": {
   "jp": "c05ecc7a3c",
   "kr": "대체 무슨 일일까."
  },
  "42": {
   "jp": "efa2c84c0d",
   "kr": "공장에서 사고…?"
  },
  "43": {
   "jp": "4e02bf2be5",
   "kr": "역시 부탁할 일은"
  },
  "44": {
   "jp": "727879fbc1",
   "kr": "알선소에 맡기는 게 제일이네요."
  },
  "45": {
   "jp": "11d00bbfc9",
   "kr": "베트는 잘 지내고 있을까."
  },
  "46": {
   "jp": "860cba6031",
   "kr": "저기, 여행을 계속하다 보면 여러 사람과"
  },
  "47": {
   "jp": "c14886eff1",
   "kr": "알게 되잖아요."
  },
  "48": {
   "jp": "912ce40b6c",
   "kr": "그건 정말 소중한 일이라고 생각해요."
  },
  "49": {
   "jp": "b58e78540c",
   "kr": "당신들은 늘 건강해 보이네요."
  },
  "50": {
   "jp": "3ea80ab71e",
   "kr": "조금 늠름해진 느낌이에요."
  },
  "51": {
   "jp": "981f3a42f1",
   "kr": "'여행은 사람을 성장시킨다'"
  },
  "52": {
   "jp": "a2421116f1",
   "kr": "들어 본 적 있어요? 방금 제가 생각한 거예요."
  },
  "53": {
   "jp": "38000dab55",
   "kr": "사고일까… 걱정돼."
  },
  "54": {
   "jp": "66f096300a",
   "kr": "이 마을은 가도의 요충지라서"
  },
  "55": {
   "jp": "d892fa6cec",
   "kr": "여러 여행자를 만날 수 있어서 재밌어."
  },
  "56": {
   "jp": "3a72e0cc14",
   "kr": "으음, 자네들을 보고 있으니"
  },
  "57": {
   "jp": "381e08217d",
   "kr": "나도 여행이 하고 싶어졌어."
  },
  "58": {
   "jp": "3258bf1ab4",
   "kr": "예전엔 나도 여기저기 여행했거든."
  },
  "59": {
   "jp": "76d6a95a6b",
   "kr": "여어, 자네들이군."
  },
  "60": {
   "jp": "80a269cba4",
   "kr": "여전히 여행을 계속하고 있구나."
  },
  "61": {
   "jp": "7a957e7473",
   "kr": "여행자는 멋져."
  },
  "62": {
   "jp": "cc47a0e354",
   "kr": "뭐가…냐고 물으면 곤란하지만"
  },
  "63": {
   "jp": "ff0fd134b6",
   "kr": "어떤 어려움이 있어도 여행을 계속하는 점이"
  },
  "64": {
   "jp": "8ba0bd667b",
   "kr": "대단해."
  },
  "65": {
   "jp": "96127abfea",
   "kr": "응! 분명 그럴 거야."
  }
 }
}
