  },
  "3": {
   "jp": "7f0965c1c7",
   "kr": "지금 이 동굴은 우리가 쓰는 중이다."
  },
  "4": {
   "jp": "e9b668e970",
   "kr": "다치기 싫으면 돌아가라!"
  },
  "5": {
   "jp": "bbb5a4fffd",
   "kr": "이 동굴은 샴실단이 장악하고 있다."
  },
  "6": {
   "jp": "f89460a917",
   "kr": "알선소의 개들은 얌전히 꼬리 말고 돌아가라."
  },
  "7": {
   "jp": "c188eaefa2",
   "kr": "그럴 수는 없지."
  },
  "8": {
   "jp": "8d53e59499",
   "kr": "도굴꾼 스틸을 체포하려고"
  },
  "9": {
   "jp": "b2dd80e667",
   "kr": "여기까지 왔다."
  },
  "10": {
   "jp": "a612d87c53",
   "kr": "스틸이 있는 걸 아는 건가."
  },
  "11": {
   "jp": "50603717d7",
   "kr": "그럼 그냥 돌려보낼 수 없지."
  },
  "12": {
   "jp": "a567b0dfab",
   "kr": "상대해 주마!"
  },
  "13": {
   "jp": "90e9acaf13",
   "kr": "용케도 다시 돌아왔구나, 배짱 좋은 놈."
  },
  "14": {
   "jp": "a567b0dfab",
   "kr": "상대해 주마!"
  },
  "15": {
   "jp": "6b8b83795e",
   "kr": "스틸, 서둘러라."
  },
  "16": {
   "jp": "accc355ad4",
   "kr": "방해꾼이 나타났다."
  },
  "17": {
   "jp": "aed47ad614",
   "kr": "그렇게 서두르지 마시죠."
  },
  "18": {
   "jp": "475d3f12f8",
   "kr": "오, 이것도 훌륭한 보석이군요."
  },
  "19": {
   "jp": "849ec654ec",
   "kr": "어떠세요, 보시겠습니까?"
  },
  "20": {
   "jp": "d2c1066bff",
   "kr": "한가한 소리 할 때냐."
  },
  "21": {
   "jp": "e97c837713",
   "kr": "널 잡으러 모험가가 왔단 말이다."
  },
  "22": {
   "jp": "8390eac874",
   "kr": "그런 위험을 없애려고"
  },
  "23": {
   "jp": "598a18458d",
   "kr": "당신네 샴실단과"
  },
  "24": {
   "jp": "6fa3118303",
   "kr": "손을 잡은 것 아닙니까."
  },
  "25": {
   "jp": "6115b28766",
   "kr": "뒷일은 부탁드립니다."
  },
  "26": {
   "jp": "16014a9473",
   "kr": "피 보는 건 질색이라서요."
  },
  "27": {
   "jp": "31bf215219",
   "kr": "멈춰라!"
  },
  "28": {
   "jp": "673cec65ba",
   "kr": "어딜, 우리가 상대해 주지."
  },
  "29": {
   "jp": "90e9acaf13",
   "kr": "용케도 다시 돌아왔구나, 배짱 좋은 놈."
  },
  "30": {
   "jp": "d932f38da5",
   "kr": "해치워라!",
   "auto": 1
  },
  "31": {
   "jp": "3ef8b4f5cf",
   "kr": "보물상자가 열리는 순간의 행복감."
  },
  "32": {
   "jp": "426c1a33b0",
   "kr": "이 장사는 끊을 수가 없다니까요."
  },
  "33": {
   "jp": "1b9344e895",
   "kr": "자, 그럼 슬슬 돌아갈까요."
  },
  "34": {
   "jp": "f4b069c8e1",
   "kr": "거기까지다."
  },
  "35": {
   "jp": "a51e778291",
   "kr": "설마… 샴실단을"
  },
  "36": {
   "jp": "a5e35445b8",
   "kr": "따돌리고 여기까지 온 건가?"
  },
  "37": {
   "jp": "68acdfb26b",
   "kr": "자네 같은 애송이가?"
  },
  "38": {
   "jp": "83d8b89505",
   "kr": "이제 도망갈 곳은 없다."
  },
  "39": {
   "jp": "dc913d9eb5",
   "kr": "…제가 완패한 모양이군요."
  },
  "40": {
   "jp": "0400ad0cdc",
   "kr": "어떤 보물의 가치도 꿰뚫어 보는 제가"
  },
  "41": {
   "jp": "fea2a657b4",
   "kr": "당신의 역량은 알아보지 못했군요."
  },
  "42": {
   "jp": "9aca095871",
   "kr": "무사하셨습니까!?"
  },
  "43": {
   "jp": "0fb0b8f5d6",
   "kr": "스틸이 샴실단과"
  },
  "44": {
   "jp": "283a147bf5",
   "kr": "손을 잡았다는 정보가 들어와서"
  },
  "45": {
   "jp": "8a3f70c2cf",
   "kr": "지원하러 왔습니다."
  },
  "46": {
   "jp": "35a5072a52",
   "kr": "하지만 전부 해결된 모양이군요."
  },
  "47": {
   "jp": "7da69ef509",
   "kr": "뒷일은 저희에게 맡겨 주십시오."
  },
  "48": {
   "jp": "4740cc8f6b",
   "kr": "스틸을 연행하고"
  },
  "49": {
   "jp": "d41bcf0398",
   "kr": "그가 가진 보물은 알선소에"
  },
  "50": {
   "jp": "effa30b219",
   "kr": "넘겨 두겠습니다."
  },
  "51": {
   "jp": "1640e0d37d",
   "kr": "일 끝났군."
  },
  "52": {
   "jp": "b45aab4f75",
   "kr": "보물상자는 이미 열려 있다."
  },
  "53": {
   "jp": "e3054e924b",
   "kr": "스틸이 벌써 털어 간 모양이군."
  },
  "54": {
   "jp": "63c4c357c2",
   "kr": "보물상자에는 아무것도 들어 있지 않다."
