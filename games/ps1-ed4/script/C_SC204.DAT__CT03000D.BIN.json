{
 "archive": "/C/SC204.DAT",
 "member": "..\\BIN\\CT03000D.BIN",
 "segments": {
  "0": {
   "jp": "a4ff1ca258",
   "kr": "그럼 제가 상대해 드리죠."
  },
  "1": {
   "jp": "c5b4c995f4",
   "kr": "그런가. 그럼 기대하겠네."
  },
  "2": {
   "jp": "0a39277da8",
   "kr": "어떤 이야기를 들려줄 건가?"
  },
  "3": {
   "jp": "efab1fcbc8",
   "kr": "글쎄요."
  },
  "4": {
   "jp": "26d1ebc443",
   "kr": "꿈 이야기를 하고 싶어요."
  },
  "5": {
   "jp": "2ea5cebbb8",
   "kr": "호오… 꿈이라면?"
  },
  "6": {
   "jp": "2e6b59b624",
   "kr": "장래에 뭐가 되고 싶다든가 하는 꿈인가?"
  },
  "7": {
   "jp": "837b79d697",
   "kr": "아니요.",
   "auto": 1
  },
  "8": {
   "jp": "9643b206e1",
   "kr": "잠잘 때 꾸는 쪽 꿈이에요."
  },
  "9": {
   "jp": "886eb8c6c8",
   "kr": "그렇다 해도"
  },
  "10": {
   "jp": "a14f86f7b5",
   "kr": "꿈에는 꾸는 사람의 정신 상태가 반영된다니"
  },
  "11": {
   "jp": "9bc5fec138",
   "kr": "두 꿈이 전혀 무관하지는 않겠지만요."
  },
  "12": {
   "jp": "df63c8d9df",
   "kr": "호오. 이거 흥미롭군."
  },
  "13": {
   "jp": "dc5206d0a0",
   "kr": "교수님은 요즘 어떤 꿈을 꾸세요?"
  },
  "14": {
   "jp": "068c172915",
   "kr": "글쎄. 요즘은 나이 탓인지 잘 기억이 안 나네만."
  },
  "15": {
   "jp": "e49f9eb518",
   "kr": "예전엔 자주 꾸었지."
  },
  "16": {
   "jp": "2b9faefda8",
   "kr": "좋아하던 아가씨 꿈이라든가."
  },
  "17": {
   "jp": "4dee358b69",
   "kr": "세기의 대발견을 하고 필딘상을 받는 꿈이라든가."
  },
  "18": {
   "jp": "aa62f0e5df",
   "kr": "좋아하던 아가씨와는 맺어지지 못했고"
  },
  "19": {
   "jp": "392d017fe9",
   "kr": "대발견은커녕"
  },
  "20": {
   "jp": "8f3bbbe347",
   "kr": "일에 파묻혀 지내는 나날이었지."
  },
  "21": {
   "jp": "d458b030c8",
   "kr": "꿈이란 덧없는 것이로군."
  },
  "22": {
   "jp": "916f5c5393",
   "kr": "정말이에요.",
   "auto": 1
  },
  "23": {
   "jp": "fd97087a65",
   "kr": "그런데 지금 교수님이 말씀하신 꿈은"
  },
  "24": {
   "jp": "959193002d",
   "kr": "동경이나 희망, 소원이 꿈에"
  },
  "25": {
   "jp": "72fd0fdafa",
   "kr": "나타난 것 같은데요."
  },
  "26": {
   "jp": "17999d954f",
   "kr": "풀이할 수 없는 꿈을 꾸신 적은 없으세요?"
  },
  "27": {
   "jp": "b3adb20754",
   "kr": "공포나 소원과 관련된 것이라면"
  },
  "28": {
   "jp": "8e934d4fee",
   "kr": "그 꿈을 꾼 이유는 쉽게 짐작이 가지."
  },
  "29": {
   "jp": "241974a3e9",
   "kr": "말하자면"
  },
  "30": {
   "jp": "3f8fef55f8",
   "kr": "꿈 풀이로는 설명이 안 되는 꿈이로군."
  },
  "31": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "32": {
   "jp": "93c8108d76",
   "kr": "확실히 꿈에서 모르는 사람이나 땅이 나오고"
  },
  "33": {
   "jp": "549774ec98",
   "kr": "얼마 뒤 실제로…"
  },
  "34": {
   "jp": "17ae363c10",
   "kr": "하는 일도 몇 번 있었지."
  },
  "35": {
   "jp": "681eb7b0d6",
   "kr": "꿈의 계시라고 해야 할까요."
  },
  "36": {
   "jp": "aeaf7a232a",
   "kr": "실은 저도"
  },
  "37": {
   "jp": "b1c63aae0c",
   "kr": "어릴 때부터 여러 번 꾸는 같은 꿈이 있는데"
  },
  "38": {
   "jp": "f4cf9c7896",
   "kr": "그게 도무지 풀리지 않아요."
  },
  "39": {
   "jp": "7095506b16",
   "kr": "나이는 １４, ５세쯤…"
  },
  "40": {
   "jp": "365a43a767",
   "kr": "여행 차림의 남자아이와 여자아이가 나오는데"
  },
  "41": {
   "jp": "ae15a45d23",
   "kr": "아직 만나지 못했어요."
  },
  "42": {
   "jp": "03fa3c7a9f",
   "kr": "두 사람 다 눈이 아주 맑아요."
  },
  "43": {
   "jp": "5da64bb68a",
   "kr": "항상 콧노래를 부르며"
  },
  "44": {
   "jp": "fdc4d575f6",
   "kr": "즐겁게 가도를 걷는 꿈을 꿔요."
  },
  "45": {
   "jp": "16c45bc611",
   "kr": "음. 그건 분명 만날 수 있을 걸세."
  },
  "46": {
   "jp": "6afe549553",
   "kr": "네. 저도 그렇게 생각해요."
  },
  "47": {
   "jp": "e3700405ed",
   "kr": "그들과 제가 어떤 관계인지"
  },
  "48": {
   "jp": "41068ff2c1",
   "kr": "지금은 알 수 없지만"
  },
  "49": {
   "jp": "1153be5cc5",
   "kr": "반드시 만날 수 있다고 믿어요."
  },
  "50": {
   "jp": "93b1e4c4d7",
   "kr": "아니, 오히려 저는 그들을 만나기 위해"
  },
  "51": {
   "jp": "efcecb0eda",
   "kr": "여행을 계속한다 해도 과언이 아니에요."
  },
  "52": {
   "jp": "d8c3cb5231",
   "kr": "당장 제 꿈은"
  },
  "53": {
   "jp": "52680fb430",
   "kr": "꿈에서 본 그들을 만나는 것이 꿈이라는 셈이죠."
  },
  "54": {
   "jp": "b6cbdd50f4",
   "kr": "말로 하니 좀 이상하네요."
  },
  "55": {
   "jp": "370887ac85",
   "kr": "아무튼 죄송해요. 그뿐인 이야기지만요."
  },
  "56": {
   "jp": "f32eb0d7d1",
   "kr": "만남을 기대하며 사는가."
  },
  "57": {
   "jp": "3a29c43852",
   "kr": "정말 그렇군."
  },
  "58": {
   "jp": "7784532df7",
   "kr": "내 나이쯤 되면"
  },
  "59": {
   "jp": "4c90a5405f",
   "kr": "그리운 추억만 돌아보느라"
  },
  "60": {
   "jp": "14cbe7951e",
   "kr": "앞날을 꿈꾸는 걸 잊기 쉽지."
  },
  "61": {
   "jp": "715624f893",
   "kr": "반성해야겠군."
  },
  "62": {
   "jp": "038d16b756",
   "kr": "허허, 정말 좋은 이야기를 들었네."
  },
  "63": {
   "jp": "8dc3b301ad",
   "kr": "１００로제, 지불하겠네."
  },
  "64": {
   "jp": "d1a5b4f40f",
   "kr": "미첼은 １００로제를 받았다."
  },
  "65": {
   "jp": "65c5b13b8d",
   "kr": "또 말동무가 되어 주러 오게나."
  },
  "66": {
   "jp": "03dbf01df9",
   "kr": "단, 새 이야기를 구해서 말일세."
  },
  "67": {
   "jp": "b54f6e0fee",
   "kr": "내가 이야기 상대를 할게."
  },
  "68": {
   "jp": "6a45062b7d",
   "kr": "호오, 자네인가. 재미난 이야기를 부탁하네."
  },
  "69": {
   "jp": "674cafdab0",
   "kr": "재미있을지는 모르겠지만요."
  },
  "70": {
   "jp": "eb57ec6c05",
   "kr": "저 자신의 이야기를 할게요."
  },
  "71": {
   "jp": "7db4ce9401",
   "kr": "지금까지 남에게 들려줄 만한 재미있는 일을"
  },
  "72": {
   "jp": "d23b2d9f01",
   "kr": "겪은 적도 없고 전해 들은 재미난 이야기도"
  },
  "73": {
   "jp": "9b66240019",
   "kr": "재미있다고 느낄 기분이 아니었어요."
  },
  "74": {
   "jp": "90a7569477",
   "kr": "하지만 요즘 들어"
  },
  "75": {
   "jp": "890bb85979",
   "kr": "겨우 즐거운 건 즐겁고 재미있는 건 재미있다고"
  },
  "76": {
   "jp": "db970d554c",
   "kr": "느낄 수 있게 되었어요."
  },
  "77": {
   "jp": "b0025cbcf2",
   "kr": "분명 지금은 조직에 얽매이지 않고"
  },
  "78": {
   "jp": "49df6d3ef3",
   "kr": "내 마음 가는 대로 여행하고 있기 때문일 거예요."
  },
  "79": {
   "jp": "954024b2cd",
   "kr": "그렇구먼."
  },
  "80": {
   "jp": "2b1ced775e",
   "kr": "얼마 전까지는 명령에 모순을 느끼면서도"
  },
  "81": {
   "jp": "5c33e89735",
   "kr": "억지로 자신을 정당화했어요."
  },
  "82": {
   "jp": "e149bfd8ee",
   "kr": "그게 저를 몰아세웠던 것 같아요."
  },
  "83": {
   "jp": "6557d7d0a6",
   "kr": "으음.",
   "auto": 1
  },
  "84": {
   "jp": "0d9c31b80e",
   "kr": "하지만 그것만은 아닌 듯하군."
  },
  "85": {
   "jp": "437fc7fa4a",
   "kr": "네?"
  },
  "86": {
   "jp": "ccdf9269f9",
   "kr": "사랑을 하고 있어서가 아닌가."
  },
  "87": {
   "jp": "73c84982e3",
   "kr": "좋아하는 사람이 생기면 세상이 그것만으로 장밋빛이 되지."
  },
  "88": {
   "jp": "1af7df90be",
   "kr": "내 눈에는 그렇게 보이네만."
  },
  "89": {
   "jp": "69759a5cc0",
   "kr": "뭐, 뭐라고요? 그런 거 아니에요."
  },
  "90": {
   "jp": "64547c9fb6",
   "kr": "루티스의 얼굴이 살짝 붉어졌다."
  },
  "91": {
   "jp": "7f64205548",
   "kr": "하하하."
  },
  "92": {
   "jp": "fcdfd0fa72",
   "kr": "재미난 이야기보다 당황한 자네 쪽이"
  },
  "93": {
   "jp": "8d0eb2e69a",
   "kr": "훨씬 재미있군."
  },
  "94": {
   "jp": "8dc3b301ad",
   "kr": "１００로제, 지불하겠네."
  },
  "95": {
   "jp": "bef29845ed",
   "kr": "루티스는 １００로제를 받았다."
  },
  "96": {
   "jp": "65c5b13b8d",
   "kr": "또 말동무가 되어 주러 오게나."
  },
  "97": {
   "jp": "03dbf01df9",
   "kr": "단, 새 이야기를 구해서 말일세."
  },
  "98": {
   "jp": "da7eaca91a",
   "kr": "괜찮다면 제가 상대해 드릴게요."
  },
  "99": {
   "jp": "dbd6256505",
   "kr": "그런데 글쎄요."
  },
  "100": {
   "jp": "8e64da3c88",
   "kr": "제 이야기보다 공부를 위해"
  },
  "101": {
   "jp": "8735f11c42",
   "kr": "교수님 이야기를 듣고 싶어요."
  },
  "102": {
   "jp": "583fafc20f",
   "kr": "내 이야기를?"
  },
  "103": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "104": {
   "jp": "76fc67ef82",
   "kr": "제 입으로 말하기 뭐하지만"
  },
  "105": {
   "jp": "2338a7bf88",
   "kr": "저는 세상 물정에 어둡고 지식을"
  },
  "106": {
   "jp": "b760ba12ca",
   "kr": "어떻게 써야 할지 잘 몰라요."
  },
  "107": {
   "jp": "6437004df8",
   "kr": "인생 경험이 풍부한 도리아 교수님께"
  },
  "108": {
   "jp": "833ac51175",
   "kr": "꼭 가르침을 받고 싶어요."
  },
  "109": {
   "jp": "7fa1c5c38f",
   "kr": "나, 나에게?"
  },
  "110": {
   "jp": "37fb9db7ed",
   "kr": "으흠."
  },
  "111": {
   "jp": "1382cac722",
   "kr": "젊은 사람이 기특한 마음가짐이군."
  },
  "112": {
   "jp": "539eb5e9d8",
   "kr": "좋아."
  },
  "113": {
   "jp": "786f134a91",
   "kr": "그래, 무엇에 대해 듣고 싶은가?"
  },
  "114": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "115": {
   "jp": "32bccfc01c",
   "kr": "지식을 효과적으로 활용하는 방법에 대해"
  },
  "116": {
   "jp": "48258fb01b",
   "kr": "가르쳐 주시면 감사하겠어요."
  },
  "117": {
   "jp": "87cc1eaf41",
   "kr": "그렇군…"
  },
  "118": {
   "jp": "96b7bd8eeb",
   "kr": "좋은 질문일세."
  },
  "119": {
   "jp": "05b5d02ba5",
   "kr": "애초에 지식이란"
  },
  "120": {
   "jp": "67588ea505",
   "kr": "누구를 위해 있는 것인가."
  },
  "121": {
   "jp": "87478af34d",
   "kr": "민중의 생활 향상과…"
  },
  "122": {
   "jp": "d2d31e9b21",
   "kr": "흠흠."
  },
  "123": {
   "jp": "0e66d57c18",
   "kr": "각종 기술의 혁신!"
  },
  "124": {
   "jp": "8e11b337b3",
   "kr": "…나아가 문화의 발전을 가져오는"
  },
  "125": {
   "jp": "2784a15344",
   "kr": "형체 없는 보물일세."
  },
  "126": {
   "jp": "3a456d6509",
   "kr": "그렇군요."
  },
  "127": {
   "jp": "308a68e5f1",
   "kr": "도리아 교수의 이야기는 끝없이 이어졌다."
  },
  "128": {
   "jp": "cc59e14491",
   "kr": "그러게요, 정말."
  },
  "129": {
   "jp": "9113995db2",
   "kr": "도리아 교수의 이야기는 길어졌다."
  },
  "130": {
   "jp": "30bbfaf55a",
   "kr": "아니, 말씀하신 대로예요."
  },
  "131": {
   "jp": "c1ca8ef662",
   "kr": "도리아 교수의 이야기는 아직도 이어졌다."
  },
  "132": {
   "jp": "cc8fb6cf02",
   "kr": "동감이에요."
  },
  "133": {
   "jp": "15cdb8ff1b",
   "kr": "도리아 교수는 지쳐 가는 듯하다."
  },
  "134": {
   "jp": "5583a86f9c",
   "kr": "…그러하니 말일세."
  },
  "135": {
   "jp": "7f008c430f",
   "kr": "후우… 지식도 경험도"
  },
  "136": {
   "jp": "158867f94e",
   "kr": "쌓기만 해서는 쓸모가 없네."
  },
  "137": {
   "jp": "6720fa40fe",
   "kr": "유효하게 써야만"
  },
  "138": {
   "jp": "acadaab6cb",
   "kr": "비로소 의의 있는 지식이 되는 걸세."
  },
  "139": {
   "jp": "8390a9f3ce",
   "kr": "…아아, 말하느라 지쳤군."
  },
  "140": {
   "jp": "1d6aafa9d2",
   "kr": "후우…"
  },
  "141": {
   "jp": "2c236dbb28",
   "kr": "자, 이쯤에서 됐으려나."
  },
  "142": {
   "jp": "9aaaefa66a",
   "kr": "네, 큰 공부가 되었어요."
  },
  "143": {
   "jp": "b57ed8603f",
   "kr": "조금 지쳤지만"
  },
  "144": {
   "jp": "c67f9d6b75",
   "kr": "나도 현역 시절이 생각나서"
  },
  "145": {
   "jp": "238654bd21",
   "kr": "기분이 좋군."
  },
  "146": {
   "jp": "80ad773bbb",
   "kr": "진지하게 들어 주었고"
  },
  "147": {
   "jp": "424ed63919",
   "kr": "자네는 좋은 학생이었네."
  },
  "148": {
   "jp": "8dc3b301ad",
   "kr": "１００로제, 지불하겠네."
  },
