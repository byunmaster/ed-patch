{
 "archive": "/F/SC500.DAT",
 "member": "..\\BIN\\FT01020.BIN",
 "segments": {
  "0": {
   "jp": "1bc90676e6",
   "kr": "파로스"
  },
  "1": {
   "jp": "3ab5787c12",
   "kr": "배는 준비해 두었소."
  },
  "2": {
   "jp": "29611e7306",
   "kr": "준비가 되면 선착장으로 오시오."
  },
  "3": {
   "jp": "6215c55917",
   "kr": "나도 가만히 있을 수만은 없는 모양이오.",
   "auto": 1
  },
  "4": {
   "jp": "b6d2d5599f",
   "kr": "함께 데려가 주지 않겠소?",
   "auto": 1
  },
  "5": {
   "jp": "e3c8691df8",
   "kr": "가웨인을 일행에 넣겠습니까?"
  },
  "6": {
   "jp": "9737f6ef41",
   "kr": "좋소, 그럼 가 보세."
  },
  "7": {
   "jp": "4b55c8ef1d",
   "kr": "가웨인이 일행에 합류했다."
  },
  "8": {
   "jp": "622f537e4e",
   "kr": "일행은 충분한 모양이오.",
   "auto": 1
  },
  "9": {
   "jp": "cb9935d90d",
   "kr": "그럼 여기서 기다리고 있겠소."
  },
  "10": {
   "jp": "527beccd3c",
   "kr": "내 힘이 필요해지면 언제든 오시오."
  },
  "11": {
   "jp": "da5c704aa1",
   "kr": "주인님은 지금 부재중이십니다."
  },
  "12": {
   "jp": "5f47761219",
   "kr": "용무가 있으시면 제가 받들겠습니다."
  },
  "13": {
   "jp": "218985ef75",
   "kr": "주인님은 부재중이십니다만."
  },
  "14": {
   "jp": "2879b3ebe1",
   "kr": "주인님…?"
  },
  "15": {
   "jp": "d3076489b8",
   "kr": "어라, 주인님을 찾아오신 게"
  },
  "16": {
   "jp": "1fb93a01e2",
   "kr": "아닌가요?"
  },
  "17": {
   "jp": "8700461a3f",
   "kr": "저기… 실례지만, 이곳 주인은 누구신가요?"
  },
  "18": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "19": {
   "jp": "03e22fd997",
   "kr": "가웨인 님은 의지할 곳 없는 아이들을 거두시고"
  },
  "20": {
   "jp": "19484b0c37",
   "kr": "무법자를 갱생시키시고… 그리고, 그리고…"
  },
  "21": {
   "jp": "87fbb99be0",
   "kr": "가웨인…!?"
  },
  "22": {
   "jp": "cbb1b5aca7",
   "kr": "무슨 일이십니까?"
  },
  "23": {
   "jp": "4bbff8f515",
   "kr": "발크드에서 만났는데."
  },
  "24": {
   "jp": "801efcc0de",
   "kr": "아무 말도 안 해 줬어."
  },
  "25": {
   "jp": "44afa33ed2",
   "kr": "어머, 혹시. 어빈 님이십니까?"
  },
  "26": {
   "jp": "6b333741fc",
   "kr": "그래. 가웨인에게는 늘 신세를 지고 있어."
  },
  "27": {
   "jp": "ba8d7129c1",
   "kr": "고생이 많으셨다고 들었습니다."
  },
  "28": {
   "jp": "0c8d125861",
   "kr": "그나저나 아무 말도 안 해 주다니."
  },
  "29": {
   "jp": "504651ee46",
   "kr": "가웨인 님은 생김새와 달리"
  },
  "30": {
   "jp": "5005ef5929",
   "kr": "그렇게 보여도 꽤 수줍음이 많으십니다."
  },
  "31": {
   "jp": "115bd8a879",
   "kr": "누구에게나 오래된 상처는 있는 법입니다."
  },
  "32": {
   "jp": "51b05b7f36",
   "kr": "그래서 상냥해질 수 있는 것입니다."
  },
  "33": {
   "jp": "2e67db4c75",
   "kr": "그렇습니까."
  },
  "34": {
   "jp": "3c672ebe16",
   "kr": "그 녀석다운, 매드람다운 최후군요."
  },
  "35": {
   "jp": "432a187c43",
   "kr": "매드람의 마음도 알 것 같습니다."
  },
  "36": {
   "jp": "0ce5bf89ad",
   "kr": "사람의 행복이란 무엇일까요."
  },
  "37": {
   "jp": "700f9e4253",
   "kr": "누구나 모두 행복해질 수 있다는 선택지는"
  },
  "38": {
   "jp": "c7277445b9",
   "kr": "없는 걸까요?"
  },
  "39": {
   "jp": "73a4671a24",
   "kr": "비관적으로 생각하면"
  },
  "40": {
   "jp": "021cb49ea3",
   "kr": "점점 가라앉기만 할 것 같아서"
  },
  "41": {
   "jp": "49e564fba0",
   "kr": "싫어지네요."
  },
  "42": {
   "jp": "4a80bfe3cf",
   "kr": "주인님의 분부대로"
  },
  "43": {
   "jp": "811909bdae",
   "kr": "언제든 배를 낼 수 있게 해 두었습니다."
  },
  "44": {
   "jp": "da9a626b55",
   "kr": "선착장에서 토마스가 기다리고 있습니다."
  },
  "45": {
   "jp": "f315aed7f1",
   "kr": "잘의 사당."
  },
  "46": {
   "jp": "4333498d98",
   "kr": "즉, 발두스의 혼 중 하나,"
  },
  "47": {
   "jp": "d518a662cd",
   "kr": "이스피에가 있는 곳을 알아냈다."
  },
  "48": {
   "jp": "b80f0c7d51",
   "kr": "역시 가웨인이야."
  },
  "49": {
   "jp": "58e1adb182",
   "kr": "아무리 돌아다녀도 잘의 사당에 관해서는"
  },
  "50": {
   "jp": "f13105b02b",
   "kr": "단서를 찾지 못했으니까."
  },
  "51": {
   "jp": "fa3a634271",
   "kr": "그나마 그럴싸한 거라면"
  },
  "52": {
   "jp": "b12b842965",
   "kr": "진실의 섬에서 본 묘지 풍경 정도인데."
  },
  "53": {
   "jp": "27d1ade789",
   "kr": "그 묘지는 카나피아 섬에 있소."
  },
  "54": {
   "jp": "f803b26761",
   "kr": "아마 어빈이 진실의 섬에서 본 영상과"
  },
  "55": {
   "jp": "2da2402802",
   "kr": "한 치도 다르지 않은 묘지가 있을 것이오."
  },
  "56": {
   "jp": "0a25c43683",
   "kr": "어째서 가웨인이 그걸?"
  },
  "57": {
   "jp": "56b740ecc7",
   "kr": "카나피아에 아는 사람이 있어서 말이오."
  },
  "58": {
   "jp": "1da7a3cf35",
   "kr": "예전에 묘지가 있다고 했던 게 기억나"
  },
  "59": {
   "jp": "789e4910f6",
   "kr": "알아본 것이오."
  },
  "60": {
   "jp": "90786c3107",
   "kr": "바로 가자."
  },
  "61": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "62": {
   "jp": "0c85f0ff11",
   "kr": "왜 그래, 가웨인?"
  },
  "63": {
   "jp": "c5f79e078e",
   "kr": "문제가 있소."
  },
  "64": {
   "jp": "a437c64d41",
   "kr": "…문제?"
  },
  "65": {
   "jp": "ef12c70bfc",
   "kr": "여기까지 네 정령을 찾아온 그대들이라면"
  },
  "66": {
   "jp": "1fbbd3072d",
   "kr": "알겠지만…"
  },
  "67": {
   "jp": "18aa15b110",
   "kr": "장소를 알았다 해도 사당에 들어가려면"
  },
  "68": {
   "jp": "c21dc4cb57",
   "kr": "어떤 절차를 밟아야만 하오."
  },
  "69": {
   "jp": "ebc808fa73",
   "kr": "그것이 특별한 열쇠로 이루어지는지,"
  },
  "70": {
   "jp": "04b4813fbd",
   "kr": "아니면 특별한 인물에 의해 이루어지는지는"
  },
  "71": {
   "jp": "64916a8696",
   "kr": "장소에 따라 다르지만…"
  },
  "72": {
   "jp": "291b3b5471",
   "kr": "사당에 들어가려는 자는"
  },
  "73": {
   "jp": "81c3b67141",
   "kr": "그 요구를 충족해야 하오."
  },
  "74": {
   "jp": "5bb1a2e11c",
   "kr": "이둔 때는 신전지기 레이트르가 있었어."
  },
  "75": {
   "jp": "86727875d0",
   "kr": "네프티스 때는 레뮤라스 할아버지의 열쇠."
  },
  "76": {
   "jp": "67b33865fb",
   "kr": "스코티아 때는 리타가…"
  },
  "77": {
   "jp": "ebb77afa88",
   "kr": "확실히 그래."
  },
  "78": {
   "jp": "719efc551f",
   "kr": "어느 사당이든 뭔가 관련된 사람이 있어서"
  },
  "79": {
   "jp": "cd5584e4bb",
   "kr": "들어갈 수 있었던 거야."
  },
  "80": {
   "jp": "0357030954",
   "kr": "그런데."
  },
  "81": {
   "jp": "914e92683a",
   "kr": "잘의 사당을 열어야 할 인물이"
  },
  "82": {
   "jp": "404aafe884",
   "kr": "이미 죽었다는 걸 알게 되었소."
  },
  "83": {
   "jp": "92843149b0",
   "kr": "돌아가셨어?"
  },
  "84": {
   "jp": "c6bc173d6d",
   "kr": "하지만…"
  },
  "85": {
   "jp": "f1659969c1",
   "kr": "레뮤라스 할아버지는 돌아가셨지만"
  },
  "86": {
   "jp": "d4ee121f2b",
   "kr": "열쇠를 남겨 줬잖아."
  },
  "87": {
   "jp": "30d83da4e2",
   "kr": "뭔가 남아 있을 가능성도 있지 않을까?"
  },
  "88": {
   "jp": "4e7fc198f9",
   "kr": "그럴 가능성은 없소."
  },
  "89": {
   "jp": "ca508b6a2e",
   "kr": "잘의 사당은 열쇠로 닫혀 있는 것이 아니라"
  },
  "90": {
   "jp": "e11c0d4fea",
   "kr": "무녀의 기도로 닫혀 있기 때문이오."
  },
  "91": {
   "jp": "2175fcb36f",
   "kr": "그 무녀가 죽은 이상,"
  },
  "92": {
   "jp": "977e908eaf",
   "kr": "기도는 닫힌 상태 그대로 이어질 뿐이오."
  },
  "93": {
   "jp": "13339a0c02",
   "kr": "그런…"
  },
  "94": {
   "jp": "37cbbfe1a3",
   "kr": "잘의 사당에는 절대 들어갈 수 없다는 건가…"
  },
  "95": {
   "jp": "c4476adfab",
   "kr": "가웨인 씨."
  },
  "96": {
   "jp": "62696941ba",
   "kr": "잘의 사당 무녀였던 사람이…"
  },
  "97": {
   "jp": "49b69f38e6",
   "kr": "혹시"
  },
  "98": {
   "jp": "a238e1523f",
   "kr": "아시는 분이었나요?"
  },
  "99": {
   "jp": "dd56a022dd",
   "kr": "어…?",
   "auto": 1
  },
  "100": {
   "jp": "36c012d6fc",
   "kr": "…역시나."
  },
  "101": {
   "jp": "b72e843401",
   "kr": "이야기해 둬야겠군."
  },
  "102": {
   "jp": "d0bbd0c06b",
   "kr": "잘의 사당 무녀는 도미니크라고 하오."
  },
  "103": {
   "jp": "61e6cd280a",
   "kr": "전에 내 밑에 있던 제자의 약혼자였소."
  },
  "104": {
   "jp": "ad2ac2835a",
   "kr": "하긴…"
  },
  "105": {
   "jp": "c82d2bfe30",
   "kr": "그 아이가 그런 사명을 지니고 있었을 줄은"
  },
  "106": {
   "jp": "b2699f1ac7",
   "kr": "생각도 못 했지만."
  },
  "107": {
   "jp": "7050332179",
   "kr": "３년쯤 전의 일이오."
  },
  "108": {
   "jp": "3ab7648d38",
   "kr": "세력을 키운 오크툼 신도들이"
  },
  "109": {
   "jp": "0ea5d13dd9",
   "kr": "카나피아 섬을 새 거점으로 삼을 계획을 진행하고 있었소."
  },
  "110": {
   "jp": "374cb5471f",
   "kr": "나는 미리 그 정보를 알고,"
  },
  "111": {
   "jp": "43c35bce68",
   "kr": "계획을 막기 위해"
  },
  "112": {
   "jp": "147a08794e",
   "kr": "제자 몇 명을 데리고 카나피아 섬으로 건너갔소."
  },
  "113": {
   "jp": "2594718b19",
   "kr": "완전한 패배였소."
  },
  "114": {
   "jp": "0a66b9df25",
   "kr": "우리의 결속 따위는"
  },
  "115": {
   "jp": "825336c614",
   "kr": "사람 목숨을 가지고 노는 볼게이드의 광기에"
  },
  "116": {
   "jp": "44d730b540",
   "kr": "짓밟히고 말았소."
  },
  "117": {
   "jp": "212dc6aeb5",
   "kr": "간신히 목숨만은 건졌지만"
  },
  "118": {
   "jp": "a0f466871a",
   "kr": "정신을 차려 보니 이미 적의 모습은 없었소."
  },
  "119": {
   "jp": "7d034cef0a",
   "kr": "도미니크도… 제자의 모습도 말이오."
  },
  "120": {
   "jp": "17387a7bc3",
   "kr": "유일한 위안은"
  },
  "121": {
   "jp": "dc4e23ee81",
   "kr": "놈들이 카나피아 섬을 거점으로 삼는 것을"
  },
  "122": {
   "jp": "31fe279232",
   "kr": "포기했다는 것이었소."
  },
  "123": {
   "jp": "4bab990f2e",
   "kr": "우리 같은 자들이라도"
  },
  "124": {
   "jp": "3d93399b31",
   "kr": "눈을 부릅뜨고 지켜보는 자가 있음을 알게 된 것이"
  },
  "125": {
   "jp": "bbe16cebf5",
   "kr": "조금은 효과가 있었다고."
  },
  "126": {
   "jp": "a7cfc15a61",
   "kr": "나는 그렇게 믿고 싶소."
  },
  "127": {
   "jp": "b6efbff5c0",
   "kr": "볼게이드 그 녀석…"
  },
  "128": {
   "jp": "4533139e2e",
   "kr": "그 녀석은… 저주를 거는 걸"
  },
  "129": {
   "jp": "adbb676150",
   "kr": "즐기고 있는 거야."
  },
  "130": {
   "jp": "639170083c",
   "kr": "얼마나 비열한 놈이야…"
  },
  "131": {
   "jp": "52a5003c5e",
   "kr": "…하지만."
  },
  "132": {
   "jp": "0c53abdb6e",
   "kr": "그때 도미니크를 되살릴 방법이 있다고"
  },
  "133": {
   "jp": "d13543bba0",
   "kr": "볼게이드가 말했다면."
  },
  "134": {
   "jp": "8a360423cc",
   "kr": "그게 사실이라면…"
  },
  "135": {
   "jp": "9115d1aa0e",
   "kr": "그러나 그 방법을 아는 것은 볼게이드뿐이오."
  },
  "136": {
   "jp": "526f7ad824",
   "kr": "필요하다면 볼게이드를 찾아내서"
  },
  "137": {
   "jp": "cfb14a4e4e",
   "kr": "족쳐 버리는 수도 있어."
  },
  "138": {
   "jp": "8f166323bd",
   "kr": "어빈, 그건 안 되오."
  },
  "139": {
   "jp": "f090ba7f6e",
   "kr": "볼게이드의 힘을 얕보지 마시오."
  },
  "140": {
   "jp": "9d2e4e2dd3",
   "kr": "슬픈 일이지만,"
  },
  "141": {
   "jp": "f1e12a872b",
   "kr": "지금의 우리가 손댈 수 있는 상대가 아니오."
  },
  "142": {
   "jp": "3a7aa23d7c",
   "kr": "그럼 가웨인 씨의 제자였던 분은요?"
  },
  "143": {
   "jp": "7067ac55cf",
   "kr": "그분은 도미니크 씨를 구할 방법을"
  },
  "144": {
   "jp": "85b979b319",
   "kr": "볼게이드에게서 들었을 것 아니에요?"
  },
  "145": {
   "jp": "0d100cc4e5",
   "kr": "……",
   "auto": 1
  },
  "146": {
   "jp": "a8673a9f09",
   "kr": "그것에 기대할 수는 없소."
  },
  "147": {
   "jp": "695ba9a236",
   "kr": "놈은 마도에 빠졌소."
  },
  "148": {
   "jp": "b394bcbed2",
   "kr": "설령 도미니크를 구할 방법이 백 가지 있다 해도"
  },
  "149": {
   "jp": "281f4d06a9",
   "kr": "그것을 위해 놈이 할 수 있는 일은"
  },
  "150": {
   "jp": "bb9d155d83",
   "kr": "슬픈 악업을 쌓는 것뿐일 것이오."
  },
  "151": {
   "jp": "59c8e78989",
   "kr": "아무튼 카나피아 섬에 가 보자."
  },
  "152": {
   "jp": "56587c3cdd",
   "kr": "장소가 확실하다면"
  },
  "153": {
   "jp": "3617496492",
   "kr": "아직 단서가 있을지도 몰라."
  },
  "154": {
   "jp": "efd6faa8b6",
   "kr": "나는 내 눈으로 묘지를 보고 싶어."
  },
  "155": {
   "jp": "f4c8a79c36",
   "kr": "그러면"
  },
  "156": {
   "jp": "32969bd83a",
   "kr": "진실의 섬에서 왜 그게 보였는지"
  },
  "157": {
   "jp": "833a70b0e3",
   "kr": "알 수 있을 것 같아."
  },
  "158": {
   "jp": "b2026e0784",
   "kr": "아무 관계도 없는데 묘지가 보였을 리 없어."
  },
  "159": {
   "jp": "f288965533",
   "kr": "그리고 내 목적은 네 정령의 사당에 들어가는 것도"
  },
  "160": {
   "jp": "6052f48b4d",
   "kr": "신보를 손에 넣는 것도 아니야."
  },
  "161": {
   "jp": "2ea94ebee8",
   "kr": "진실의 섬에서 본 것을 확인하고 싶을 뿐이야."
  },
  "162": {
   "jp": "0037b13a65",
   "kr": "그래.",
   "auto": 1
  },
  "163": {
   "jp": "031aaf5503",
   "kr": "여기서 고민해도 소용없어."
  },
  "164": {
   "jp": "f36a9ff22d",
   "kr": "거기까지 확실하다면"
  },
  "165": {
   "jp": "b6729e9f84",
   "kr": "카나피아로 건너가자."
  },
  "166": {
   "jp": "260d77525e",
   "kr": "역시… 그것이 옳은 길일지도 모르겠군."
  },
  "167": {
   "jp": "57db1dcd4d",
   "kr": "좋소."
  },
  "168": {
   "jp": "3ab5787c12",
   "kr": "배는 준비해 두었소."
  },
  "169": {
   "jp": "29611e7306",
   "kr": "준비가 되면 선착장으로 오시오."
  },
  "170": {
   "jp": "7ac3d4d0ed",
   "kr": "자, 이제 어떻게 할 것인가."
  },
  "171": {
   "jp": "2cecdf78c6",
   "kr": "우선 발크드로 가서"
  },
  "172": {
   "jp": "6c667943c8",
   "kr": "크로웰 님께 신보가 모두 모였음을 보고해야"
  },
  "173": {
   "jp": "8b1658ed00",
   "kr": "하겠지."
  },
  "174": {
   "jp": "863c9bd580",
   "kr": "바로 발크드로 가요."
  },
  "175": {
   "jp": "074f0199f9",
   "kr": "시간을 끌면"
  },
  "176": {
   "jp": "e541f43692",
   "kr": "그만큼 볼게이드 일당에게 시간을"
  },
  "177": {
   "jp": "3559e79c4b",
   "kr": "주게 돼요."
  },
  "178": {
   "jp": "957d7dc97b",
   "kr": "음."
  },
  "179": {
   "jp": "4e6e5141aa",
   "kr": "그게 좋겠군."
  }
 }
