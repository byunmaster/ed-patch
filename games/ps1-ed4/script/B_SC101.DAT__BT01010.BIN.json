{
 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT01010.BIN",
 "segments": {
  "0": {
   "jp": "fa4eeeaa0d",
   "kr": "여관 안주인"
  },
  "1": {
   "jp": "91910bfa72",
   "kr": "안젤라"
  },
  "2": {
   "jp": "8a3f96d64c",
   "kr": "베트"
  },
  "3": {
   "jp": "af8a0dc260",
   "kr": "알렉"
  },
  "4": {
   "jp": "33f45e0919",
   "kr": "오리오"
  },
  "5": {
   "jp": "e99cb9bc55",
   "kr": "닥터 반들"
  },
  "6": {
   "jp": "991bcc2f6b",
   "kr": "가르시아"
  },
  "7": {
   "jp": "cb372a9a47",
   "kr": "나중에 내 소중함을 깨닫고"
  },
  "8": {
   "jp": "98db3016d5",
   "kr": "울며불며 해도 몰라."
  },
  "9": {
   "jp": "5955f16d31",
   "kr": "언젠가 내가 필요한 날이 올지도 몰라.",
   "auto": 1
  },
  "10": {
   "jp": "afd7f8ca38",
   "kr": "그날을 위해 지식을 쌓아 둘게."
  },
  "11": {
   "jp": "f0913f0da1",
   "kr": "싸움은 신중하게."
  },
  "12": {
   "jp": "ac3855d781",
   "kr": "적이 잡졸이라도 방심하지 마."
  },
  "13": {
   "jp": "58b69ba808",
   "kr": "몸조심하세요."
  },
  "14": {
   "jp": "cd1d629eaa",
   "kr": "헤어지는 건 슬퍼요."
  },
  "15": {
   "jp": "152213c808",
   "kr": "언젠가 또 만날 수 있겠죠?"
  },
  "16": {
   "jp": "ff6b6f66b7",
   "kr": "내가 없다고 무리하지 마."
  },
  "17": {
   "jp": "fbcdf3245e",
   "kr": "위험하면 망설이지 말고 도망쳐."
  },
  "18": {
   "jp": "60d972586b",
   "kr": "그만둬, 말려 봐야 소용없어.",
   "auto": 1
  },
  "19": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "20": {
   "jp": "d1a7d6488d",
   "kr": "이 마을에는 강이 있었지."
  },
  "21": {
   "jp": "bb4c15846e",
   "kr": "한동안 강이나 보고 있을까."
  },
  "22": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "23": {
   "jp": "a4f46c7154",
   "kr": "이별은 달콤한 슬픔.",
   "auto": 1
  },
  "24": {
   "jp": "f77320295e",
   "kr": "재회를 꿈꾸며 떠나도록 하지요.",
   "auto": 1
  },
  "25": {
   "jp": "4b59f66212",
   "kr": "내 힘이 필요할 때는",
   "auto": 1
  },
  "26": {
   "jp": "fc84a547dc",
   "kr": "찾아오너라.",
   "auto": 1
  },
  "27": {
   "jp": "c9080fc54f",
   "kr": "어머나, 어빈 군 아니니."
  },
  "28": {
   "jp": "e94e902019",
   "kr": "나, 지금 정말 곤란한데 말이야…"
  },
  "29": {
   "jp": "e8903937a9",
   "kr": "하아…"
  },
  "30": {
   "jp": "0088c17fc9",
   "kr": "와 줘서 고마워."
  },
  "31": {
   "jp": "2027590b53",
   "kr": "침대는 언제든 쓸 수 있게"
  },
  "32": {
   "jp": "e2eed91357",
   "kr": "준비해 뒀어."
  },
  "33": {
   "jp": "dd1942e82c",
   "kr": "아, 어서 와."
  },
  "34": {
   "jp": "3c9b111282",
   "kr": "있잖아, 여행하는 동안엔 여러 일이"
  },
  "35": {
   "jp": "061bfd99d2",
   "kr": "있겠지."
  },
  "36": {
   "jp": "17b3c69fef",
   "kr": "처음 이 여관에 와 준 건"
  },
  "37": {
   "jp": "b94f603626",
   "kr": "아주 옛날 같은 느낌이 들어."
  },
  "38": {
   "jp": "c49b3ab2ad",
   "kr": "여긴 전혀 변하지 않았지?"
  },
  "39": {
   "jp": "6dca59a488",
   "kr": "편히 쉬다 가."
  },
  "40": {
   "jp": "48fd4c6757",
   "kr": "어서 와. 편히 쉬다 가."
  },
  "41": {
   "jp": "6c432cedd8",
   "kr": "베트 씨지?"
  },
  "42": {
   "jp": "5d7f558a81",
   "kr": "기아의 크레라 씨한테서 편지를 맡아 왔어."
  },
  "43": {
   "jp": "fbd7c3a64b",
   "kr": "어, 크레라한테서 편지라고?"
  },
  "44": {
   "jp": "dea4992c54",
   "kr": "고마워."
  },
  "45": {
   "jp": "99c4fdb59c",
   "kr": "크레라와는 어릴 적부터 친구야."
  },
  "46": {
   "jp": "017e8ce728",
   "kr": "그 애에게 남편이 생기고"
  },
  "47": {
   "jp": "6288e8e036",
   "kr": "내가 뉴보른에서 일하게 된 뒤로도"
  },
  "48": {
   "jp": "9dc1394678",
   "kr": "이렇게 편지를 주고받고 있어."
  },
  "49": {
   "jp": "134d231a15",
   "kr": "크레라에게서 받은 편지를 건넸다."
  },
  "50": {
   "jp": "396b7c5362",
   "kr": "어디 보자… 어머, 크레라도 참,"
  },
  "51": {
   "jp": "a48057b5c8",
   "kr": "「이번에 남편과 함께 뉴보른으로 놀러 갈게」"
  },
  "52": {
   "jp": "bb893b84f1",
   "kr": "라고 적혀 있네."
  },
  "53": {
   "jp": "38a948f5d0",
   "kr": "「그때 네 애인을 소개해 줘」래."
  },
  "54": {
   "jp": "670e37736a",
   "kr": "얘도 참, 애인이 그렇게 쉽게"
  },
  "55": {
   "jp": "3e9ff50774",
   "kr": "생기나. 아하하."
  },
  "56": {
   "jp": "32ddaf345f",
   "kr": "어머, 이런 얘기를 너한테 해 봐야"
  },
  "57": {
   "jp": "0d4a27f739",
   "kr": "소용없지."
  },
  "58": {
   "jp": "58490b9606",
   "kr": "일해야겠다."
  },
  "59": {
   "jp": "6408cfd336",
   "kr": "편지를 전해 줘서 고마워."
  },
  "60": {
   "jp": "6dca59a488",
   "kr": "편히 쉬다 가."
  },
  "61": {
   "jp": "48fd4c6757",
   "kr": "어서 와. 편히 쉬다 가."
  },
  "62": {
   "jp": "fcb16772ce",
   "kr": "선생님, 어떤가요?"
  },
  "63": {
   "jp": "bdddf6aead",
   "kr": "아버지는 나을까요?"
  },
  "64": {
   "jp": "47741aa89d",
   "kr": "네, 걱정 없어요."
  },
  "65": {
   "jp": "2faa235531",
   "kr": "맛있는 걸 많이 먹고 푹 쉬면"
  },
  "66": {
   "jp": "fd8a96d6ad",
   "kr": "금방 좋아질 거야."
  },
  "67": {
   "jp": "f57fe47be3",
   "kr": "어?",
   "auto": 1
  },
  "68": {
   "jp": "04c42e9b46",
   "kr": "저, 그것뿐인가요?"
  },
  "69": {
   "jp": "8f053455b5",
   "kr": "약이라든가…"
  },
  "70": {
   "jp": "9183a34b38",
   "kr": "아무것도 필요 없어요."
  },
  "71": {
   "jp": "4fd0d1ff66",
   "kr": "하지만 다른 의사 선생님들은"
  },
  "72": {
   "jp": "aad214f2f4",
   "kr": "여러 가지 처방을 해 주셨는데요…"
  },
  "73": {
   "jp": "01356f20a9",
   "kr": "노인이나 아이는 저항력이 약하니까"
  },
  "74": {
   "jp": "3042c65025",
   "kr": "약은 조심해야 해."
  },
  "75": {
   "jp": "4d5c569944",
   "kr": "상처를 고치는 약은 성분이 강해서"
  },
  "76": {
   "jp": "115f49851c",
   "kr": "환자의 몸에 뜻밖의 부담을 줄 때도 있어요."
  },
  "77": {
   "jp": "860cc18476",
   "kr": "그럼 상처가 낫지 않았던 건"
  },
  "78": {
   "jp": "734ffcb5dc",
   "kr": "치료를 너무 많이 해서…"
  },
  "79": {
   "jp": "277ca0be7b",
   "kr": "의술의 기본은"
  },
  "80": {
   "jp": "cd2fea9f6b",
   "kr": "환자 몸에서 나쁜 것을 떼어 내는 게 아니라"
  },
  "81": {
   "jp": "30e5cfdebf",
   "kr": "환자가 스스로 낫도록 돕는 거예요."
  },
  "82": {
   "jp": "bbce82b6a1",
   "kr": "…좀 참아요, 할아버지."
  },
  "83": {
   "jp": "fff225bf3c",
   "kr": "닥터 반들은 오리오 할아버지의 다리에 손을 댔다."
  },
  "84": {
   "jp": "f56cb3f334",
   "kr": "으헉!"
  },
  "85": {
   "jp": "1f086f55b7",
   "kr": "이, 이게 무슨 일이야!"
  },
  "86": {
   "jp": "ee46d8e695",
   "kr": "거짓말처럼 다리가…"
  },
  "87": {
   "jp": "799bdd7601",
   "kr": "몸의 움직임을 가볍게 하는 혈을 자극했어요."
  },
  "88": {
   "jp": "081ea938e2",
   "kr": "하지만 안정을 취하지 않으면 또 나빠질 테니까요."
  },
  "89": {
   "jp": "bd539e9a16",
   "kr": "영양을 섭취하고 따뜻하게 지내세요."
  },
  "90": {
   "jp": "f91fa045d4",
   "kr": "감사합니다, 선생님."
  },
  "91": {
   "jp": "c129a64086",
   "kr": "어떻게 사례를 해야 할지…"
  },
  "92": {
   "jp": "32adfd6ccd",
   "kr": "할 수 있는 한 사례를 지불하겠습니다."
  },
  "93": {
   "jp": "d9cf732b41",
   "kr": "부디 금액을 말씀해 주세요."
  },
  "94": {
   "jp": "41c7f4fe88",
   "kr": "알렉 씨."
  },
  "95": {
   "jp": "337a7dc1c0",
   "kr": "아까 말했죠."
  },
  "96": {
   "jp": "9fbe85f2d4",
   "kr": "저는 아버님의 상처를 고친 게 아니에요."
  },
  "97": {
   "jp": "089c259908",
   "kr": "아버님이 상처와 싸우는 걸 도왔을 뿐이에요."
  },
  "98": {
   "jp": "d781bc2740",
   "kr": "아버님을 낫게 하는 건 아버님 자신과 당신이에요."
  },
  "99": {
   "jp": "632abac7c9",
   "kr": "사례라면 어빈 군 일행에게 하세요."
  },
  "100": {
   "jp": "f552aeb097",
   "kr": "저를 찾아"
  },
  "101": {
   "jp": "197fe9464a",
   "kr": "마수투성이 동굴까지 와 줬으니까요."
  },
  "102": {
   "jp": "6f61d85a49",
   "kr": "반들 선생님…"
  },
  "103": {
   "jp": "346e4f981b",
   "kr": "자."
  },
  "104": {
   "jp": "47428b9cfe",
   "kr": "그럼 저는 이만 실례할게요."
  },
  "105": {
   "jp": "cb399748ad",
   "kr": "알렉 씨도 어빈 군도 건강히 지내."
  },
  "106": {
   "jp": "976854dc31",
   "kr": "어, 벌써 가시는 건가요?"
  },
  "107": {
   "jp": "5c208307b7",
   "kr": "피트 동굴에는 찾던 약초가 없었어."
  },
  "108": {
   "jp": "0429f3293d",
   "kr": "저는 파나케아라는 꽃을 찾고 있어요."
  },
  "109": {
   "jp": "61289fa546",
   "kr": "어떤 병이든 고친다는 굉장한 약초야."
  },
  "110": {
   "jp": "a5f62ee9a3",
   "kr": "그걸 찾아내는 게 아버지의 유언이에요."
  },
  "111": {
   "jp": "b04a453754",
   "kr": "안녕히 계세요, 여러분."
  },
  "112": {
   "jp": "19fab29377",
   "kr": "건강에는 충분히 조심해."
  },
  "113": {
   "jp": "2ddc63d0ba",
   "kr": "기다리고 있었어요.",
   "auto": 1
  },
  "114": {
   "jp": "bd599ea4b6",
   "kr": "알선소 소개로 오신 분이시죠."
  },
  "115": {
   "jp": "0fa6238088",
   "kr": "아버지의 상처가 좀처럼 낫지 않아요."
  },
  "116": {
   "jp": "558560a2dc",
   "kr": "의사 선생님도 '나이가 있어 어려울지도'라고"
  },
  "117": {
   "jp": "1148cd523f",
   "kr": "말만 들어서."
  },
  "118": {
   "jp": "66c9d5870c",
   "kr": "하지만 유명한 닥터 반들이라면"
  },
  "119": {
   "jp": "5a8a99c668",
   "kr": "고칠 수 있을지도 몰라요."
  },
  "120": {
   "jp": "972ca0d6c5",
   "kr": "아시나요…"
  },
  "121": {
   "jp": "b0f0a03d6f",
   "kr": "닥터 반들은 어떤 상처도 병도 고치는"
  },
  "122": {
   "jp": "8df4d42e40",
   "kr": "굉장한 의사라고 해요."
  },
  "123": {
   "jp": "0f0bb0344b",
   "kr": "약초를 찾는 여행을 하면서"
  },
  "124": {
   "jp": "d41d1c20a4",
   "kr": "전 세계에서 기적을 일으키고 있대요."
  },
  "125": {
   "jp": "1aa6685358",
   "kr": "그 선생님이 보른에 있다는 소문을 들었어요."
  },
  "126": {
   "jp": "e24ed0169b",
   "kr": "하지만 아버지 곁을 떠날 수도 없고…"
  },
  "127": {
   "jp": "a73b258859",
   "kr": "저 대신 선생님을 모셔 와 주셨으면 해요."
  },
  "128": {
   "jp": "66d8a87336",
   "kr": "부디 서둘러 보른으로 가 주세요."
  },
  "129": {
   "jp": "2f0a2cad77",
   "kr": "닥터 반들은"
  },
  "130": {
   "jp": "dd08cc4e8a",
   "kr": "보른의 여관 술집에 머무른다고 해요."
  },
  "131": {
   "jp": "41175695b2",
   "kr": "부디 서둘러 부탁드려요."
  },
  "132": {
   "jp": "104a6fd55f",
   "kr": "어빈 씨, 정말 고마웠어요."
  },
  "133": {
   "jp": "4707d7341e",
   "kr": "그건 그렇고",
   "auto": 1
  },
  "134": {
   "jp": "8b1905c87c",
   "kr": "반들 선생님은 어디로 가시는 걸까요…"
  },
  "135": {
   "jp": "7d45136c82",
   "kr": "여, 어빈 씨."
  },
  "136": {
   "jp": "6179ae9045",
   "kr": "저번엔 정말 신세 많이 졌어요."
  },
  "137": {
   "jp": "8abbb251ad",
   "kr": "덕분에 아버지는 완전히 나았어요."
  },
  "138": {
   "jp": "d643849289",
   "kr": "무슨 용건이신가요?"
  },
  "139": {
   "jp": "08bc372480",
   "kr": "아이고…"
  },
  "140": {
   "jp": "1362f608f9",
   "kr": "다리가 아파서 견딜 수가 없어…"
  },
  "141": {
   "jp": "ec36896538",
   "kr": "오, 어빈 씨."
  },
  "142": {
   "jp": "c9fb4f302e",
   "kr": "보시오."
  },
  "143": {
   "jp": "6f9e371942",
   "kr": "아주 건강해졌소."
  },
  "144": {
   "jp": "ec36896538",
   "kr": "오, 어빈 씨."
  },
  "145": {
   "jp": "c9fb4f302e",
   "kr": "보시오."
  },
  "146": {
   "jp": "6f9e371942",
   "kr": "아주 건강해졌소."
  },
  "147": {
   "jp": "e35afa8d99",
   "kr": "다행이네, 할아버지."
  },
  "148": {
   "jp": "a3214791c0",
   "kr": "그런데 알선소에서 일을 맡아 왔어."
  },
  "149": {
   "jp": "38d5d6c4ab",
   "kr": "아니, 어빈 씨가?"
  },
  "150": {
   "jp": "5737df897e",
   "kr": "아이고, 황송하오."
  },
  "151": {
