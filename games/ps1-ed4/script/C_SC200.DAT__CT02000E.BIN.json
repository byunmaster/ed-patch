 "segments": {
  "0": {
   "jp": "7b532c3144",
   "kr": "남편이 돌아오지 않아요…"
  },
  "1": {
   "jp": "88c85e9ee0",
   "kr": "그 사람, 대체 어디로 가 버렸을까…"
  },
  "2": {
   "jp": "3e3c07746a",
   "kr": "당신이 어빈 씨죠?"
  },
  "3": {
   "jp": "04adbe1314",
   "kr": "알선소에서 소개받고 오신…"
  },
  "4": {
   "jp": "7fd9f30ede",
   "kr": "대강의 이야기는 이미 들으셨나요?"
  },
  "5": {
   "jp": "07e87f2ce2",
   "kr": "남편 루크레프가 돌아오지 않아요."
  },
  "6": {
   "jp": "94f2dc34c1",
   "kr": "생각나는 사람마다 전부 물어봤는데"
  },
  "7": {
   "jp": "248649dabe",
   "kr": "다들 똑같은 말만 해요."
  },
  "8": {
   "jp": "641224a41a",
   "kr": "'루크레프는 일을 마치고 곧장 돌아갔다'"
  },
  "9": {
   "jp": "90915821d6",
   "kr": "…라고요."
  },
  "10": {
   "jp": "72f4624fa4",
   "kr": "남편 일은 부름을 받은 집에 찾아가서"
  },
  "11": {
   "jp": "8ed384e51c",
   "kr": "열쇠를 만들거나 고치는 거예요."
  },
  "12": {
   "jp": "148ec9e9cb",
   "kr": "시간은 손님 사정에 따라 달라서"
  },
  "13": {
   "jp": "aba7bec2c4",
   "kr": "돌아오는 시각은 날마다 제각각이에요."
  },
  "14": {
   "jp": "422680ad61",
   "kr": "대체로 해가 지면 일은 끝나는 걸로"
  },
  "15": {
   "jp": "b9ec421c82",
   "kr": "되어 있고요."
  },
  "16": {
   "jp": "f9fc41e540",
   "kr": "간프 사부님께 물어보면"
  },
  "17": {
   "jp": "0c12e23e3e",
   "kr": "더 자세한 걸 알 수 있을 거예요."
  },
  "18": {
   "jp": "8c6cb909a8",
   "kr": "간프 사부님?"
  },
  "19": {
   "jp": "1d76fee96f",
   "kr": "남편의 스승님이에요."
  },
  "20": {
   "jp": "5969492c62",
   "kr": "일감도 사부님이 소개해 주시고요."
  },
  "21": {
   "jp": "a82bec2620",
   "kr": "남편에 대해서는 저보다"
  },
  "22": {
   "jp": "07c79be4ce",
   "kr": "사부님이 더 잘 아실지도 몰라요…"
  },
  "23": {
   "jp": "cbf82a1e2e",
   "kr": "남편에 대해 잘 아는 분은 간프 사부님이에요."
  },
  "24": {
   "jp": "db1e757900",
   "kr": "부디 그 사람을… 루크레프를 찾아 주세요."
  },
  "25": {
   "jp": "88bf6862b5",
   "kr": "뭔가 알게 되면 바로 알려 주세요."
  },
  "26": {
   "jp": "0e788a7431",
   "kr": "제가 아는 것과 맞춰 보면"
  },
  "27": {
   "jp": "4fa1cfc119",
   "kr": "단서를 잡을 수 있을지도 모르니까요."
  },
  "28": {
   "jp": "0b68aa2884",
   "kr": "어때요, 뭔가 알아내셨나요?"
  },
  "29": {
   "jp": "caaa1ff024",
   "kr": "단편적인 단서뿐이지만요."
  },
  "30": {
   "jp": "15e424bd64",
   "kr": "머리가 뻣뻣한 덩치 큰 남자라면"
  },
  "31": {
   "jp": "488f3b1a09",
   "kr": "짚이는 데가 있나요?"
  },
  "32": {
   "jp": "bdb5ffb95a",
   "kr": "덩치 큰 남자요?"
  },
  "33": {
   "jp": "00fc38c75a",
   "kr": "글쎄요…"
  },
  "34": {
   "jp": "3f8b75dbce",
   "kr": "본 적이 없는 것 같아요."
  },
  "35": {
   "jp": "ba2e1dfc32",
   "kr": "그 사람… 손님일까요?"
  },
  "36": {
   "jp": "19fa49f53a",
   "kr": "사부님께 물어보면 짚이는 데가 있으실지도 모르겠네요."
  },
  "37": {
   "jp": "38b62d76f2",
   "kr": "이 사람이 없으면 저는 못 살아요."
  },
  "38": {
   "jp": "02c5ed040d",
   "kr": "고맙습니다."
  },
  "39": {
   "jp": "45b3122fec",
   "kr": "오랜만이네, 더글라스."
  },
  "40": {
   "jp": "0ba0364b2b",
   "kr": "어, 지난번에 왔던 친구들이군."
  },
  "41": {
   "jp": "505c5532d4",
   "kr": "더글라스는 잘 지내?"
  },
  "42": {
   "jp": "5a7977786d",
   "kr": "기아는 좋은 곳이지?"
  },
  "43": {
   "jp": "0a7467ce9f",
   "kr": "이 나라에서 가장 큰 산업 도시야."
  },
  "44": {
   "jp": "1cd80a0abf",
   "kr": "너희, 공장 쪽에서 왔어?"
  },
  "45": {
   "jp": "d6946773d5",
   "kr": "사고라도 났어?"
  },
  "46": {
   "jp": "5a7977786d",
   "kr": "기아는 좋은 곳이지?"
  },
  "47": {
   "jp": "0a7467ce9f",
   "kr": "이 나라에서 가장 큰 산업 도시야."
  },
  "48": {
   "jp": "ddc80e1b61",
   "kr": "어머니는 어떻게 지내시려나."
  },
  "49": {
   "jp": "3b37fa1a42",
   "kr": "코르나는 춥고, 이제 슬슬 같이 살아 주지 않으려나."
  },
  "50": {
   "jp": "1c790fd9af",
   "kr": "더글라스, 오늘은 시간 있어?"
  },
  "51": {
   "jp": "8df2e96dde",
   "kr": "오."
  },
  "52": {
   "jp": "3194761a76",
   "kr": "너한테 볼일이 있어서 왔지."
  },
  "53": {
   "jp": "520990e609",
   "kr": "알선소 의뢰를 맡아 줬거든."
  },
  "54": {
   "jp": "89b9f65313",
   "kr": "뭐야, 네가 맡았다고?!"
  },
  "55": {
   "jp": "fb850c5587",
   "kr": "그럼 이야기가 빠르지."
  },
  "56": {
   "jp": "1ce41ade03",
   "kr": "…어머니 일이야."
  },
  "57": {
   "jp": "925f449ac2",
   "kr": "아버지가 돌아가신 뒤로도 계속 코르나에 계시는데."
  },
  "58": {
   "jp": "ad7e52a46f",
   "kr": "코르나가 큰 한파를 당한 건 알지?"
  },
  "59": {
   "jp": "ef10d97da4",
   "kr": "그래, 그건 지독하더군."
  },
  "60": {
   "jp": "f7fc80f81d",
   "kr": "하긴 어머님도 이제 젊지 않으시니까…"
  },
  "61": {
   "jp": "c36f81c50f",
   "kr": "저기… 이야기 중에 죄송한데요"
  },
  "62": {
   "jp": "683e0425c8",
   "kr": "아버지니 어머니니 하시는 건 누구예요?"
  },
  "63": {
   "jp": "b9cea2a723",
   "kr": "스승 카스톨과 그 아내 노라야."
  },
  "64": {
   "jp": "6ef57c69f4",
   "kr": "우리를 키워 줬으니까"
  },
  "65": {
   "jp": "2dfd3c58d9",
   "kr": "아버지와 어머니나 다름없지."
  },
  "66": {
   "jp": "ff168e3ceb",
   "kr": "피는 안 섞였어도"
  },
  "67": {
   "jp": "138fcc9d4e",
   "kr": "진짜 부모라고 생각하고 있어."
  },
  "68": {
   "jp": "0958967fd3",
   "kr": "큰 은혜를 입은 어머니가"
  },
  "69": {
   "jp": "45a9f43e01",
   "kr": "추위에 떨고 있다니, 가만있을 수 없지."
  },
  "70": {
   "jp": "f778ec08ab",
   "kr": "응.",
   "auto": 1
  },
  "71": {
   "jp": "32e58d0d41",
   "kr": "그래서 나도 몇 번이나 편지를 보냈어."
