  },
  "73": {
   "jp": "a3e87504e2",
   "kr": "절대로 우리 집에서 살겠다고 안 하시거든."
  },
  "74": {
   "jp": "bdf8d26757",
   "kr": "흐음…"
  },
  "75": {
   "jp": "145c23525a",
   "kr": "여전하네."
  },
  "76": {
   "jp": "5accb303d0",
