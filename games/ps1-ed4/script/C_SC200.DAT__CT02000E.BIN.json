  },
  "85": {
   "jp": "ef6b45e2de",
   "kr": "알선소 의뢰로 여기 왔어요."
  },
  "86": {
   "jp": "445d37b181",
   "kr": "뭐야, 너희가 맡아 줬구나."
  },
  "87": {
   "jp": "04f8c6c5ac",
