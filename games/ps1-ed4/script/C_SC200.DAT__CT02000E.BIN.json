  "122": {
   "jp": "5eb0811776",
   "kr": "오기를 부리시는 걸지도 모르겠어."
  },
  "123": {
   "jp": "d1f1c166c5",
   "kr": "어떻게든 설득해 주지 않겠어?"
  },
  "124": {
   "jp": "7176feb30b",
