  "114": {
   "jp": "626ee06505",
   "kr": "나도 그 얘기를 듣고 어머님이 걱정이야."
  },
  "115": {
   "jp": "bd9a28efe5",
   "kr": "이제 젊지도 않으시고…"
  },
  "116": {
   "jp": "82f4e47e46",
   "kr": "그래서 이 집에서 같이 사시자고"
  },
  "117": {
   "jp": "ba74c3ba84",
