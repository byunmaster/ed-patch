  },
  "88": {
   "jp": "0615fd7f5c",
   "kr": "어머니 일인데…"
  },
  "89": {
   "jp": "ca553d893a",
   "kr": "음, 어디서부터 말할까."
  },
  "90": {
   "jp": "e6f98cb438",
   "kr": "사실 어머니라고 해도 진짜 부모는 아니야."
  },
  "91": {
   "jp": "719cdf43e1",
   "kr": "내 스승 카스톨의 아내야."
  },
  "92": {
   "jp": "993ffeb427",
   "kr": "더글라스와 내가 카스톨의 집에서 자란 건"
  },
  "93": {
   "jp": "d4a1085350",
   "kr": "전에 얘기했지?"
  },
  "94": {
   "jp": "f3c3a804bb",
   "kr": "우리한테 카스톨 부부는"
  },
  "95": {
   "jp": "1350aec433",
   "kr": "아버지와 어머니나 다름없어."
  },
  "96": {
   "jp": "7971368c0a",
   "kr": "그 큰 은혜를 입은 어머니가 지금 코르나에서 사셔."
  },
  "97": {
   "jp": "c87b7a5bc6",
   "kr": "그런데 코르나에 대한파가 덮친 건 알고 있지?"
  },
  "98": {
   "jp": "d363a7ab7e",
   "kr": "어, 너희가 일을 맡아 준 거야?"
  },
  "99": {
   "jp": "0394ddfba6",
   "kr": "여자애도 있다니 든든한걸."
  },
  "100": {
   "jp": "a9b8108a40",
   "kr": "좀 미묘한 문제라서 말이야."
