  "54": {
   "jp": "ed5177fe5f",
   "kr": "거대한 틈이 정말 있다면 말일세."
  },
  "55": {
   "jp": "d6ea1fad79",
   "kr": "바다에는 그 틈을 향한"
  },
  "56": {
   "jp": "59c069a005",
   "kr": "거대한 흐름이 있어야 하지."
  },
  "57": {
   "jp": "d42cf944ae",
   "kr": "강물에 휩쓸리는 낙엽과 같지."
  },
  "58": {
   "jp": "82cb3e38f6",
   "kr": "그런 바다에 배를 띄우면"
  },
  "59": {
   "jp": "200e036287",
   "kr": "금세 틈에 빨려 들어가 끝장일세."
  },
  "60": {
