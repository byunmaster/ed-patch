  },
  "26": {
   "jp": "1c7c0fc6aa",
   "kr": "안 돼.",
   "auto": 1
  },
  "27": {
   "jp": "344ec6c456",
   "kr": "나는 역시 재미가"
  },
  "28": {
   "jp": "535bff3440",
