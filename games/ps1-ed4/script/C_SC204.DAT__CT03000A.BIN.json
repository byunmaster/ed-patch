  },
  "44": {
   "jp": "fc101698c9",
   "kr": "재미있는 이야기는 아닐지 모르지만"
  },
  "45": {
   "jp": "33fe1a484d",
   "kr": "이런 이야기를 들은 적이 있어."
  },
  "46": {
   "jp": "3db1f3def1",
   "kr": "이 세계 동남쪽에는 거대한 대지의 틈이 있는데"
  },
  "47": {
   "jp": "1feb8185eb",
   "kr": "거기서는 바닷물까지 폭포처럼"
  },
  "48": {
   "jp": "ed5eb90860",
   "kr": "틈 속으로 빨려 들어간대."
  },
  "49": {
   "jp": "bfaf99c06c",
   "kr": "호오, 가가브 말이군."
  },
  "50": {
   "jp": "b872f4378d",
   "kr": "그거라면 나도 들은 적이 있네."
  },
  "51": {
   "jp": "b42294754a",
   "kr": "하지만 이론적으로 생각하면"
