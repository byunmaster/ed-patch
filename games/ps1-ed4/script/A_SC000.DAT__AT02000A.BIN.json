  "0": {
   "jp": "d89f8695b9",
   "kr": "뭐지?"
  },
  "1": {
   "jp": "680e41c354",
   "kr": "나에게 도움을 부탁하고 싶은 거지?"
  },
  "2": {
   "jp": "fa2b4bd1b3",
   "kr": "그래, 재미있겠네."
  },
  "3": {
   "jp": "accf415056",
   "kr": "도와줄 수도 있지만"
  },
  "4": {
   "jp": "f9cb671490",
   "kr": "1000로제쯤 받을 수 있을까?"
  },
  "5": {
   "jp": "c9f124ba5d",
   "kr": "이럴 때는"
  },
  "6": {
   "jp": "8132e5b4ea",
   "kr": "조력비를 청구하는 법이잖아요."
