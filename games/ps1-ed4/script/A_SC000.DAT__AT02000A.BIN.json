  "7": {
   "jp": "a627102306",
   "kr": "딱히 나는"
  },
  "8": {
   "jp": "48117b4ffe",
   "kr": "돈에 쪼들리는 건 아니지만"
  },
  "9": {
   "jp": "b270cdbef5",
   "kr": "호호호, 한 번 말해 보고 싶었어."
  },
  "10": {
   "jp": "94e1881fb7",
   "kr": "호호호, 생각한 대로네."
  },
  "11": {
   "jp": "2ec121c994",
   "kr": "내가 없으면 불안한 거지?"
  },
  "12": {
   "jp": "9ec27151a0",
   "kr": "글쎄, 한 번은 여행을 함께했으니"
  },
  "13": {
   "jp": "0d6c989555",
   "kr": "200로제만 주면"
  },
  "14": {
   "jp": "541f3f5037",
   "kr": "일행에 들어가 줘도 좋아."
  },
  "15": {
   "jp": "4d251ec40f",
   "kr": "을(를) 일행에 넣겠습니까?"
  },
  "16": {
   "jp": "56fd492b1c",
   "kr": "내가 들어갈 여유는 없는 것 같네."
