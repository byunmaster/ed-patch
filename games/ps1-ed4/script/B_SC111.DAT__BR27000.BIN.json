   "auto": 1
  },
  "1": {
   "jp": "9abab603c0",
   "kr": "사가",
   "auto": 1
  },
  "2": {
   "jp": "2dc26b3fce",
   "kr": "내시",
   "auto": 1
  },
  "3": {
   "jp": "6a6f8fd7d5",
   "kr": "워스",
   "auto": 1
  },
  "4": {
   "jp": "366172bf6b",
   "kr": "도적",
   "auto": 1
  },
  "5": {
   "jp": "bfb69c0227",
   "kr": "젠장, 또 워스를 놓쳤어."
  },
  "6": {
   "jp": "6841479485",
   "kr": "로웨이, 무사했구나!"
  },
  "7": {
   "jp": "60adb412ee",
   "kr": "또 이 사람한테 폐를 끼쳤지만."
  },
  "8": {
   "jp": "b6f14bae86",
   "kr": "늘 미안하군."
  },
  "9": {
   "jp": "97d6da81f7",
   "kr": "그런데 이번엔 무슨 일로"
  },
  "10": {
   "jp": "bb87845885",
   "kr": "여기 온 거야?"
  },
  "11": {
   "jp": "ff6ec7b0b2",
   "kr": "신경 쓰지 마."
  },
  "12": {
   "jp": "24ad558afd",
   "kr": "이 광산에서 샴실단이"
  },
  "13": {
   "jp": "9cdd3d62e9",
   "kr": "뭘 하는지 조사하러 왔는데"
  },
  "14": {
   "jp": "aebf79c386",
   "kr": "대충은 파악했어."
  },
  "15": {
   "jp": "96e9155019",
   "kr": "아무래도 샴실단은"
  },
  "16": {
   "jp": "dc812a8520",
   "kr": "마수를 부리는 지팡이를 만들려는 모양이야."
  },
  "17": {
   "jp": "c9cfdfd372",
   "kr": "워스가 그걸 위해"
  },
  "18": {
   "jp": "35188869a8",
   "kr": "운반책 같은 짓을 하고 있어."
  },
  "19": {
   "jp": "d5b9910e95",
   "kr": "아무래도 이 일은 이걸로 끝나지 않겠군."
  },
  "20": {
   "jp": "01d2d08e3d",
   "kr": "우리 나름대로 조사해 보겠어."
  },
  "21": {
   "jp": "2f58f04c96",
   "kr": "안 그러면 또 로웨이가 폭주한다."
  },
  "22": {
   "jp": "20aa29ae9c",
   "kr": "미안했어."
  },
  "23": {
   "jp": "4eba10c5fa",
   "kr": "하지만 어떻게든 워스를"
  },
  "24": {
   "jp": "7900c96b7f",
   "kr": "샴실단에서 빼내고 말겠어."
  },
  "25": {
   "jp": "efd1e24757",
   "kr": "우린 가자."
  },
  "26": {
   "jp": "66eb12a20b",
   "kr": "빚이 불어 버렸군."
  },
  "27": {
   "jp": "67761bc2df",
   "kr": "당신과는 또 만날 것 같아."
  },
  "28": {
   "jp": "e164a01db2",
   "kr": "그때까지 잘 있어."
  },
  "29": {
   "jp": "8212b174a5",
   "kr": "실례."
  },
  "30": {
   "jp": "c2fb6a4f72",
   "kr": "좋아, 의뢰 완료다."
  },
  "31": {
   "jp": "b1fd3b6475",
   "kr": "우리 일이 끝날 때까지"
  },
  "32": {
   "jp": "ff6b1b46c8",
   "kr": "얌전히 있어 줘야겠다."
  },
  "33": {
   "jp": "a9081f8f9a",
   "kr": "놔라!"
  },
  "34": {
   "jp": "e48b218d70",
   "kr": "나는 워스를 막아야 해!"
  },
  "35": {
   "jp": "4fb7fd7b9b",
   "kr": "이 이상 소란 피우면 성가시다."
  },
  "36": {
   "jp": "4adc94fffb",
   "kr": "처치할까."
  },
  "37": {
   "jp": "1bea606865",
   "kr": "그만둬!"
  },
  "38": {
   "jp": "b54a05fcb5",
   "kr": "뭐야, 너는?"
  },
  "39": {
   "jp": "fea720de27",
   "kr": "그렇게 죽고 싶냐!"
  },
  "40": {
   "jp": "28cae3d29a",
   "kr": "얼른 도망쳤으면 좋았을 것을!"
  },
  "41": {
   "jp": "674687e168",
   "kr": "살았다!"
  },
  "42": {
   "jp": "d3555f2e08",
   "kr": "이 빚은 꼭 갚을게."
  },
  "43": {
   "jp": "3b27546f92",
   "kr": "오, 자네인가."
  },
  "44": {
   "jp": "788c80cfc2",
   "kr": "또 로웨이 녀석이 폭주해서 말이야."
  },
  "45": {
   "jp": "ab04a74d01",
   "kr": "여기서 샴실단이"
  },
  "46": {
   "jp": "ff303099cf",
   "kr": "뭔가를 주고받으려고 꾸미는 모양이야."
  },
  "47": {
   "jp": "719d13a105",
   "kr": "게다가 로웨이의 친구 워스가"
  },
  "48": {
   "jp": "9c380007dc",
   "kr": "관련된 것 같아."
  },
  "49": {
   "jp": "22aa0e5d99",
   "kr": "로웨이 녀석, 친구 일이라면"
  },
  "50": {
   "jp": "399f37a853",
   "kr": "아무것도 안 보이게 된다니까."
  },
  "51": {
   "jp": "6a5324cb27",
   "kr": "상대는 샴실단이야."
  },
  "52": {
   "jp": "4ef4ffaf21",
   "kr": "돌이킬 수 없는 일이 되기 전에"
  },
  "53": {
   "jp": "da1908ae3d",
   "kr": "로웨이를 찾아내야 해."
  },
  "54": {
   "jp": "4d32a7750d",
   "kr": "틀림없이 이걸 돌크에게 전해 줘."
  },
  "55": {
   "jp": "cab2d639af",
   "kr": "이게 없으면 마수를 부리는 지팡이는"
  },
  "56": {
   "jp": "f60d4950c6",
   "kr": "못 만드니까."
  },
  "57": {
   "jp": "4285319d78",
   "kr": "알겠습니다."
  },
  "58": {
   "jp": "35228f5feb",
   "kr": "반드시 전하겠습니다."
  },
  "59": {
   "jp": "166cb44940",
   "kr": "멈춰!"
  },
  "60": {
   "jp": "30a6b5057a",
   "kr": "가라!"
  },
  "61": {
   "jp": "22fc215d00",
   "kr": "여긴 우리가 막는다!"
  },
  "62": {
   "jp": "7fb0054a00",
