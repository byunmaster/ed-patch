 "segments": {
  "0": {
   "jp": "cf21194e79",
   "kr": "밀리건 １６세"
  },
  "1": {
   "jp": "273c6fa9d2",
   "kr": "스튜어트"
  },
  "2": {
   "jp": "ce99dfa8d2",
   "kr": "시녀"
  },
  "3": {
   "jp": "1a06c74339",
   "kr": "스틸"
  },
  "4": {
   "jp": "c9d09e3e76",
   "kr": "가렛"
  },
  "5": {
   "jp": "6e764a7d5d",
   "kr": "병사"
  },
  "6": {
   "jp": "12138841fe",
   "kr": "뮤즈여."
  },
  "7": {
   "jp": "eddef88b6b",
   "kr": "나는 무관심한 척 도망치는 것이 아니다."
  },
  "8": {
   "jp": "765701acb4",
   "kr": "오크툼 신도와 발두스 신도의 문제는"
  },
  "9": {
   "jp": "5af71267ef",
   "kr": "왕가가 참견할 문제가 아니다."
  },
  "10": {
   "jp": "bf1db039cc",
   "kr": "알아줘."
  },
  "11": {
   "jp": "0b736ac5e5",
   "kr": "나도 분하단다."
  },
  "12": {
   "jp": "96b29afacc",
   "kr": "하지만 왕가가 움직이면 혼란을 키울 것이다."
  },
  "13": {
   "jp": "a3fe5d9e12",
   "kr": "불에 기름을 붓는 격이지."
  },
  "14": {
   "jp": "9e9ef3766b",
   "kr": "괴로운 처지란다."
  },
  "15": {
   "jp": "e2c38e244d",
   "kr": "뮤즈가 신세를 졌다고 하더군."
  },
  "16": {
   "jp": "92ffaf5d4f",
   "kr": "내가 말하기 뭣하네만 그 아이는 세상 물정을 몰라서"
  },
  "17": {
   "jp": "4d28f2115e",
   "kr": "폐를 끼치는 일이 많을 게야."
  },
  "18": {
   "jp": "26ed2ffa34",
   "kr": "나 개인으로서는 그 아이가 생각하는 것을"
  },
  "19": {
   "jp": "f2cf99fe83",
   "kr": "억지로 막을 생각이 없네."
  },
  "20": {
   "jp": "c8bb31c214",
   "kr": "자네들의 여행에 동행하며"
  },
  "21": {
   "jp": "b073452c96",
   "kr": "사람들의 마음을 아는 사람으로 성장해 주었으면 하네."
  },
  "22": {
   "jp": "159e3f7e76",
   "kr": "미안하지만"
  },
  "23": {
   "jp": "7e8eacbddc",
   "kr": "가끔은 힘을 보태 주지 않겠나."
  },
  "24": {
   "jp": "3832c390c1",
   "kr": "뮤즈 님, 어디로 가십니까?"
  },
  "25": {
   "jp": "f50df566a7",
   "kr": "또 나가시는 건가요?"
  },
  "26": {
   "jp": "069049976a",
   "kr": "그래요, 서민들의 생활을 보고 들으러 가는 거예요."
  },
  "27": {
   "jp": "1c2d91eddb",
   "kr": "부디 조심하시옵소서."
  },
  "28": {
   "jp": "f16eb9c113",
   "kr": "성 밖에는 위험도 많사옵니다."
  },
  "29": {
   "jp": "951b3bd94c",
   "kr": "걱정할 것 없어요."
  },
  "30": {
   "jp": "9e44217ea5",
   "kr": "서민 따위, 두려울 것 없어요."
  },
  "31": {
   "jp": "a88f9dbcbd",
   "kr": "뮤즈 님은"
  },
  "32": {
   "jp": "8143ed18c0",
   "kr": "어릴 때 왕비님을 여의신 탓인지"
  },
  "33": {
   "jp": "9cac9b52ae",
   "kr": "말괄량이로 자라 버리셔서…"
  },
  "34": {
   "jp": "409eed7062",
   "kr": "폐를 끼치는 일도 있을 줄 압니다만"
  },
  "35": {
   "jp": "cefc4e5a9d",
   "kr": "본래는 마음씨 고운 분이십니다."
  },
  "36": {
   "jp": "6886db617b",
   "kr": "함께 나가실 때는"
  },
  "37": {
   "jp": "81045d6731",
   "kr": "부디 잘 부탁드립니다."
  },
  "38": {
   "jp": "9e6edbef25",
   "kr": "저, 감격이에요."
  },
  "39": {
   "jp": "7a86e2dccd",
   "kr": "세상을 바로잡는 여행을 하시는 공주님을"
  },
  "40": {
   "jp": "e5530d352b",
   "kr": "도울 수 있다니…"
  },
  "41": {
   "jp": "313dcf7637",
   "kr": "뮤즈 님의 정체를 아는 사람은"
  },
  "42": {
   "jp": "3c1a6e6f59",
   "kr": "저뿐이군요."
  },
  "43": {
   "jp": "dd56a022dd",
   "kr": "어…?"
  },
  "44": {
   "jp": "5069930ccb",
   "kr": "임금님도 스튜어트 님도 알고 있어."
  },
  "45": {
   "jp": "181071b5a1",
   "kr": "하지만 그 두 사람뿐이잖아."
  },
  "46": {
   "jp": "9e6edbef25",
   "kr": "저, 감격이에요."
  },
  "47": {
   "jp": "7a86e2dccd",
   "kr": "세상을 바로잡는 여행을 하시는 공주님을"
  },
  "48": {
   "jp": "e5530d352b",
   "kr": "도울 수 있다니…"
  },
  "49": {
   "jp": "a1fbc51162",
   "kr": "어서 오세요."
  },
  "50": {
   "jp": "1c8062503d",
   "kr": "세상을 바로잡는 여행은 어떠세요?"
  },
  "51": {
   "jp": "efadec57cf",
   "kr": "악인을 팍팍 해치워 주세요."
  },
  "52": {
   "jp": "3dab963e24",
   "kr": "힘내세요."
  },
  "53": {
   "jp": "53f94efdb5",
   "kr": "뮤즈 님, 열심이시군요."
  },
  "54": {
   "jp": "21b0ab1c4b",
   "kr": "호호호호…"
  },
  "55": {
   "jp": "cc9b40f84a",
   "kr": "신분 낮은 자들이 어슬렁거리다니."
  },
  "56": {
   "jp": "7df4e95325",
   "kr": "뭐라고 했어?"
  },
  "57": {
   "jp": "9ee74c47d4",
   "kr": "아, 아니요… 아, 아무것도…"
  },
  "58": {
   "jp": "c43063a5a0",
   "kr": "어머, 뮤즈 님."
  },
  "59": {
   "jp": "dccb5a2a38",
   "kr": "문안 올리옵니다."
  },
  "60": {
   "jp": "c4937e8093",
   "kr": "그런 자들과"
  },
  "61": {
   "jp": "1e8cd4aa7b",
   "kr": "무엇을 하고 계십니까?"
  },
  "62": {
   "jp": "b37e9f710b",
   "kr": "(그런 자들이라고…?)"
  },
  "63": {
   "jp": "abe57c9102",
   "kr": "어머나, 무서운 얼굴의 동료들이네요."
  },
  "64": {
   "jp": "d9ff077c03",
   "kr": "이 성 안이 평화롭다면 그걸로 됐어."
  },
  "65": {
   "jp": "f4a9e7514b",
   "kr": "오호호호호."
  },
  "66": {
   "jp": "2deb9c6dd9",
   "kr": "우리는 많은 것을 바라지 않아."
  },
  "67": {
   "jp": "898bf245b8",
   "kr": "오호호호…"
  },
  "68": {
   "jp": "6bd01a91a4",
   "kr": "이 앞은 개인실이라"
  },
  "69": {
   "jp": "4792e47558",
   "kr": "아무리 뮤즈 님의 부탁이라도"
  },
  "70": {
   "jp": "0fc89dd7e2",
   "kr": "여기서 안으로는 들여보낼 수 없습니다."
  },
  "71": {
   "jp": "6bd01a91a4",
   "kr": "이 앞은 개인실이라"
  },
  "72": {
   "jp": "fcfc35e19f",
   "kr": "아무리 어빈 씨의 부탁이라도"
  },
  "73": {
   "jp": "0fc89dd7e2",
   "kr": "여기서 안으로는 들여보낼 수 없습니다."
  },
  "74": {
   "jp": "84fce64213",
   "kr": "이상 없습니다!"
  },
  "75": {
   "jp": "df4be42438",
   "kr": "이상 없다고."
  },
  "76": {
   "jp": "16c08249a4",
   "kr": "뮤즈 님."
  },
  "77": {
   "jp": "fe9a1ec60b",
   "kr": "２층 궁정 구역에 손님을 모시는 것은"
  },
  "78": {
   "jp": "41be78b163",
   "kr": "삼가 주십시오."
  },
  "79": {
   "jp": "0ce241f4b7",
   "kr": "죄송하지만"
  },
  "80": {
   "jp": "46f30ac983",
   "kr": "필딘 왕가 16대에 걸쳐 내려온 규칙입니다."
  },
  "81": {
   "jp": "56a81e9535",
   "kr": "양해해 주십시오."
  },
  "82": {
   "jp": "9957a1374f",
   "kr": "２층 궁정 구역 출입은 삼가 주십시오."
  },
  "83": {
   "jp": "0ce241f4b7",
   "kr": "죄송하지만"
  },
  "84": {
   "jp": "46f30ac983",
   "kr": "필딘 왕가 16대의 역사로 이루어진 규칙입니다."
  },
  "85": {
   "jp": "56a81e9535",
   "kr": "양해해 주십시오."
  },
  "86": {
   "jp": "eeab32b344",
   "kr": "어머, 성에 와 버렸네."
  },
  "87": {
   "jp": "6bc94c9195",
   "kr": "성…?"
  },
  "88": {
   "jp": "ed085a524f",
   "kr": "여기는 필딘 성의 비밀 통로였나?"
  },
  "89": {
   "jp": "1aa94211b4",
   "kr": "와 버렸으니 어쩔 수 없네요."
  },
  "90": {
   "jp": "130a8f5ceb",
   "kr": "잠시 쉬었다 갈까요."
  },
  "91": {
   "jp": "93f69fdcd6",
   "kr": "벽에는 많은 스위치가 늘어서 있다."
  },
  "92": {
   "jp": "26b1e4f9f1",
   "kr": "뮤즈는 익숙한 손놀림으로"
  },
  "93": {
   "jp": "011f3314d8",
   "kr": "여러 스위치를 눌렀다."
  },
  "94": {
   "jp": "c269b602b6",
   "kr": "이런 장치였구나."
  },
  "95": {
   "jp": "283e96c562",
   "kr": "수고했어."
  },
  "96": {
   "jp": "0b88990b81",
   "kr": "뮤즈 님, 손님도 함께이십니까."
  },
  "97": {
   "jp": "45ad514a94",
   "kr": "차라도 내어 올릴까요?"
  },
  "98": {
   "jp": "5f8b60d77c",
   "kr": "우리가 마시는 고급 차는"
  },
  "99": {
   "jp": "9b7aea154b",
   "kr": "아마 서민의 입에는 맞지 않을 테니"
  },
  "100": {
   "jp": "f265ec4cad",
   "kr": "됐어요."
  },
  "101": {
   "jp": "c8c426557a",
   "kr": "그것보다 아버님의 상태는?"
  },
  "102": {
   "jp": "7667c1d4bd",
   "kr": "네."
  },
  "103": {
   "jp": "5702215d3e",
   "kr": "전하께서는 여전히 뮤즈 님을"
  },
  "104": {
   "jp": "5f982e95d4",
   "kr": "걱정하고 계십니다."
  },
  "105": {
   "jp": "63ddd172bf",
   "kr": "걱정할 필요 없는데."
  },
  "106": {
   "jp": "93f69fdcd6",
   "kr": "벽에는 많은 스위치가 늘어서 있다."
  },
  "107": {
   "jp": "fa1f0d136e",
   "kr": "…어디를 어떻게 누르는지"
  },
  "108": {
   "jp": "797024af5c",
   "kr": "뮤즈가 아니면 모르겠군."
  },
  "109": {
