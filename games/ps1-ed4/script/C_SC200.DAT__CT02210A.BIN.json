{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02210A.BIN",
 "segments": {
  "0": {
   "jp": "9a3a6da880",
   "kr": "짐 받을 곳은 바로아의 다렌이니까."
  },
  "1": {
   "jp": "74258ad4ec",
   "kr": "중요한 물건이니 조심해 줘."
  },
  "2": {
   "jp": "d05bb03dd4",
   "kr": "어, 잘 와 줬어."
  },
  "3": {
   "jp": "3085f29e48",
   "kr": "바로 부탁인데, 이 짐을 맡아 줘."
  },
  "4": {
   "jp": "78fbec1e52",
   "kr": "지작의 짐을 맡았다."
  },
  "5": {
   "jp": "b94cb86177",
   "kr": "바로아의 다렌이라는 남자에게 전해 줘."
  },
  "6": {
   "jp": "74258ad4ec",
   "kr": "중요한 물건이니 조심해 줘."
  },
  "7": {
   "jp": "d05bb03dd4",
   "kr": "어, 잘 와 줬어."
  },
  "8": {
   "jp": "f00725c624",
   "kr": "그럼 바로, 이걸…"
  },
  "9": {
   "jp": "1ac26607e8",
   "kr": "뭐야, 짐이 꽤 많구나."
  },
  "10": {
   "jp": "62bf448563",
   "kr": "그럼 내 짐을 부탁할 수 없잖아."
  },
  "11": {
   "jp": "3ebf9e250a",
   "kr": "어이, 자네들 지작의 지인인가?"
  },
  "12": {
   "jp": "3ede1c2ca4",
   "kr": "아니면 그 녀석에게 돈이라도 빌려줬나."
  },
  "13": {
   "jp": "fdf369649e",
   "kr": "그렇다면 헛수고만 했군."
  },
  "14": {
   "jp": "c1380bdd3c",
   "kr": "그 친구, 야반도주했거든."
  },
  "15": {
   "jp": "ed388d28b4",
   "kr": "우리도 호되게 당했어."
  },
  "16": {
   "jp": "92ea89e244",
   "kr": "지작의 행방을 찾고 있어."
  },
  "17": {
   "jp": "a9ba912a0c",
   "kr": "자네들도 그런가."
  },
  "18": {
   "jp": "cf7f9b0c71",
   "kr": "나는 여기 집주인이네만."
  },
  "19": {
   "jp": "3973b70aeb",
   "kr": "석 달이나 집세를 밀려 놓고서."
  },
  "20": {
   "jp": "3a89ad7c8e",
   "kr": "슬쩍 사라져서 큰 손해라니까."
  },
  "21": {
   "jp": "f74bb0e1bf",
   "kr": "그 녀석이 갈 만한 곳을 몰라?"
  },
  "22": {
   "jp": "ecfaac0995",
   "kr": "알았으면 내가 진작 잡았지!"
  },
  "23": {
   "jp": "644e4c379a",
   "kr": "아무튼 자네와 나는 한편이야."
  },
  "24": {
   "jp": "e86e560cbc",
   "kr": "그 밖에도 술집 주인이"
  },
  "25": {
   "jp": "6a5b35efdf",
   "kr": "엄청난 손해를 봤네."
  },
  "26": {
   "jp": "ab27411444",
   "kr": "외상을 쌓아 놓고 도망쳤다는군."
  },
  "27": {
   "jp": "09029e3d79",
   "kr": "다 같이 연락을 주고받아서"
  },
  "28": {
   "jp": "8ca7be0d09",
   "kr": "지작을 붙잡아 혼쭐을 내 주세."
  },
  "29": {
   "jp": "890d06d44c",
   "kr": "오, 어빈, 어빈."
  },
  "30": {
   "jp": "ad0f0d414e",
   "kr": "기다리고 있었네."
  },
  "31": {
   "jp": "d0989583b9",
   "kr": "이상한 소리가 나는군."
  },
  "32": {
   "jp": "e8d08c0cfa",
   "kr": "이상한 소리?"
  },
  "33": {
   "jp": "5f1d71fa0c",
   "kr": "지작에게 빌려준 방 지하에는"
  },
  "34": {
   "jp": "0b6654e095",
   "kr": "창고가 있는데 말이지."
  },
  "35": {
   "jp": "c7bc0b2c37",
   "kr": "평소에는 짐을 둬서 못 들어가게 해 뒀네."
  },
  "36": {
   "jp": "27bd776e98",
   "kr": "그래서 짐을 치우고 지하로 내려가려니…"
  },
  "37": {
   "jp": "06451bd01c",
   "kr": "와드득와드득 으스스한 소리가 나지 뭔가."
  },
  "38": {
   "jp": "07e92ee4ad",
   "kr": "나는 무서워져서…"
  },
  "39": {
   "jp": "ed341f97ba",
   "kr": "…",
   "auto": 1
  },
  "40": {
   "jp": "388dba36f2",
   "kr": "좀 조사해 주지 않겠나?"
  },
  "41": {
   "jp": "89e3d2cc38",
   "kr": "나는 으스스해서 말이야."
  },
  "42": {
   "jp": "116de0a33e",
   "kr": "오, 어빈 군!"
  },
  "43": {
   "jp": "8dbea172a7",
   "kr": "장관… 그리고 곤트 아저씨."
  },
  "44": {
   "jp": "835909d068",
   "kr": "걱정돼서 관청에 알렸네."
  },
  "45": {
   "jp": "4879bbe111",
   "kr": "소리의 원인은 알아냈나?"
  },
  "46": {
   "jp": "4e084f493f",
   "kr": "응, 확실히 알아냈어."
  },
  "47": {
   "jp": "39d383e92b",
   "kr": "마침 장관이 잘 와 줬어."
  },
  "48": {
   "jp": "c9f8e8cafd",
   "kr": "어빈은 지작과 다렌의 이야기를 했다."
  },
  "49": {
   "jp": "f137646c0b",
   "kr": "…세상에!"
  },
  "50": {
   "jp": "03de4aefa5",
   "kr": "이 아래에 샴실단의 아지트라고?"
  },
  "51": {
   "jp": "8d8c0345e1",
   "kr": "이거 큰 공이다!"
  },
  "52": {
   "jp": "2720564ca2",
   "kr": "어서 놈들을 체포하자!"
  },
  "53": {
   "jp": "e49b1a7303",
   "kr": "제군!"
  },
  "54": {
   "jp": "9f7f0b5358",
   "kr": "넷!"
  },
  "55": {
   "jp": "a7d3770b7e",
   "kr": "지작 이 녀석,"
  },
  "56": {
   "jp": "5bf77480de",
   "kr": "집주인 몰래 엄청난 짓을 했구먼."
  },
  "57": {
   "jp": "7b2af29580",
   "kr": "이거 뒤처리가 큰일이겠군."
  },
  "58": {
   "jp": "47e1932af3",
   "kr": "아저씨도 좀 더 나은 세입자를 찾아야겠어."
  },
  "59": {
   "jp": "8df2e96dde",
   "kr": "오오."
  },
  "60": {
   "jp": "6419b450b9",
   "kr": "어빈에게는 신세를 졌구나."
  },
  "61": {
   "jp": "9267302505",
   "kr": "괜찮다면 여기서 살지 않겠나?"
  },
  "62": {
   "jp": "a5fce3a08b",
   "kr": "집세는 공짜로."
  },
  "63": {
   "jp": "072afd2787",
   "kr": "하하하, 고마워, 아저씨."
  },
  "64": {
   "jp": "fc54d93960",
   "kr": "하지만 우린 갈 길이 급해서."
  },
  "65": {
   "jp": "bf92a44763",
   "kr": "그런가.",
   "auto": 1
  },
  "66": {
   "jp": "76b3655ce6",
   "kr": "그렇다면 놀러 오는 것만이라도 좋네."
  },
  "67": {
   "jp": "515eef7fc6",
   "kr": "자네라면 언제든 대환영이니까."
  }
 }
}
