{
 "archive": "/D/SC300.DAT",
 "member": "..\\BIN\\DT00000K.BIN",
 "segments": {
  "0": {
   "jp": "62668c3fe1",
   "kr": "아, 알선소에서 의뢰를 맡아 준 거구나."
  },
  "1": {
   "jp": "319fe0eeb8",
   "kr": "실은 좀 부탁하기 어려운 건데…"
  },
  "2": {
   "jp": "68d9a5e50e",
   "kr": "전해 줬으면 하는 편지가 있어."
  },
  "3": {
   "jp": "3c8482f8a9",
   "kr": "가든힐까지."
  },
  "4": {
   "jp": "97a01b25e9",
   "kr": "멀어서 미안해."
  },
  "5": {
   "jp": "0461484184",
   "kr": "천만에요."
  },
  "6": {
   "jp": "bc159a04e7",
   "kr": "일인걸요, 괜찮아요."
  },
  "7": {
   "jp": "dea4992c54",
   "kr": "고마워."
  },
  "8": {
   "jp": "8132ad49c8",
   "kr": "어머니께 보내는 편지야."
  },
  "9": {
   "jp": "d8bd3e9ade",
   "kr": "사정이 있어서 못 돌아가니까…"
  },
  "10": {
   "jp": "34d916523a",
   "kr": "아마 어머니한테서 답장이 있을 거야."
  },
  "11": {
   "jp": "b48470918a",
   "kr": "어머님의 답장을 받아 오면 되는 거죠?"
  },
  "12": {
   "jp": "e032b8b884",
   "kr": "어빈은 편지를 맡았다."
  },
  "13": {
   "jp": "05d288bf90",
   "kr": "부탁해."
  },
  "14": {
   "jp": "4da5e078fb",
   "kr": "가든힐의 안젤라라는 분이야."
  },
  "15": {
   "jp": "d9281a191c",
   "kr": "안녕!"
  },
  "16": {
   "jp": "bf65d69f26",
   "kr": "…어빈 군이라고 했던가?"
  },
  "17": {
   "jp": "88e31da06e",
   "kr": "혹시 너희가 내 의뢰를 맡아 준 거야?"
  },
  "18": {
   "jp": "b69a77eb2c",
   "kr": "뭐, 그런 셈이지.",
   "auto": 1
  },
  "19": {
   "jp": "b36547fc14",
   "kr": "든든하네."
  },
  "20": {
   "jp": "aed6594955",
   "kr": "그래도 좀 부끄럽다."
  },
  "21": {
   "jp": "105dffdebe",
   "kr": "이건 어머니께 보내는 편지야."
  },
  "22": {
   "jp": "3c8482f8a9",
   "kr": "가든힐까지."
  },
  "23": {
   "jp": "97a01b25e9",
   "kr": "멀어서 미안해."
  },
  "24": {
   "jp": "208b39db52",
   "kr": "…사정이 있어서 난 돌아갈 수 없어."
  },
  "25": {
   "jp": "67142005f2",
   "kr": "그래서 아마"
  },
  "26": {
   "jp": "f8269e2009",
   "kr": "어머니의 답장을 받아 와 주길 부탁하게 될 것"
  },
  "27": {
   "jp": "e898e431ae",
   "kr": "같은데."
  },
  "28": {
   "jp": "953dc5e71c",
   "kr": "맡겨 두라고."
  },
  "29": {
   "jp": "e032b8b884",
   "kr": "어빈은 편지를 맡았다."
  },
  "30": {
   "jp": "78c0a741ea",
   "kr": "어라, 너희들."
  },
  "31": {
   "jp": "efd0e84f34",
   "kr": "짐이 엄청 많네."
  },
  "32": {
   "jp": "1c9147df37",
   "kr": "이래서는 부탁도 못 하겠다."
  },
  "33": {
   "jp": "8a754ce0da",
   "kr": "가든힐의 안젤라라고 하면 금방 알 거야."
  },
  "34": {
   "jp": "ba6a029d0a",
   "kr": "기운찬 어머니야."
  },
  "35": {
   "jp": "5f8065e999",
   "kr": "그래도 꽤 나이가 드셨겠지…"
  },
  "36": {
   "jp": "d185e7823e",
   "kr": "아, 어빈 군."
  },
  "37": {
   "jp": "a92a8fae1d",
   "kr": "어머니는 만났어?"
  },
  "38": {
   "jp": "f733f22d3f",
   "kr": "답장을 받아 왔어."
  },
  "39": {
   "jp": "165c9c800a",
   "kr": "어빈은 답장을 건넸다."
  },
  "40": {
   "jp": "58f8968fd3",
   "kr": "아아, 다행이다, 이제 살았…"
  },
  "41": {
   "jp": "dd56a022dd",
   "kr": "어…?",
   "auto": 1
  },
  "42": {
   "jp": "4fe2059f78",
   "kr": "너무해, 어머니!!"
  },
  "43": {
   "jp": "38245fa39c",
   "kr": "뭐라고 적혀 있어?"
  },
  "44": {
   "jp": "d57d74e687",
   "kr": "『로제는 가라일 동굴에 놓아 두마."
  },
  "45": {
   "jp": "3cff3bf631",
   "kr": "좋아하는 보물찾기를 즐기렴』이래!!"
  },
  "46": {
   "jp": "28f2339e8b",
   "kr": "와…"
  },
  "47": {
   "jp": "f0891b3666",
   "kr": "엄한 어머니네."
  },
  "48": {
   "jp": "9e5bf9174a",
   "kr": "농담이 아니야."
  },
  "49": {
   "jp": "652875580d",
   "kr": "으헝헝…"
  },
  "50": {
   "jp": "38e50826da",
   "kr": "가라일 동굴이라니."
  },
  "51": {
   "jp": "cc1927ddce",
   "kr": "농담 아니야…"
  },
  "52": {
   "jp": "c9134489c6",
   "kr": "잠깐, 갑자기 말 걸지 말아 줄래."
  },
  "53": {
   "jp": "21a30c386b",
   "kr": "심장 튀어나오는 줄 알았잖아."
  },
  "54": {
   "jp": "f38770aad6",
   "kr": "기분 나쁜 아저씨네."
  },
  "55": {
   "jp": "db52cd3888",
   "kr": "평범하게 말 못 해?"
  },
  "56": {
   "jp": "f2cd31ae9a",
   "kr": "아저씨라니 말이 심하잖아."
  },
  "57": {
   "jp": "edca9fd7c9",
   "kr": "난 어엿한 이름이 있다구."
  },
  "58": {
   "jp": "db74a5f02d",
   "kr": "자마네 씨라고 불러."
  },
  "59": {
   "jp": "c3dec7d32b",
   "kr": "자마네!?"
  },
  "60": {
   "jp": "c9aed67d87",
   "kr": "그럼 네가 의뢰인이야?"
  },
  "61": {
   "jp": "ca8dbd4d54",
   "kr": "뭐야."
  },
  "62": {
   "jp": "99c2575daa",
   "kr": "그럼 댁이 의뢰를 맡아 줄 사람이라는 거야?"
  },
  "63": {
   "jp": "762b096689",
   "kr": "왠지 불안해지네."
  },
  "64": {
   "jp": "c2f8072a29",
   "kr": "이건 대형 스캔들이라구."
  },
  "65": {
   "jp": "a26ef16f76",
   "kr": "대작가 카라무스가 실종됐다니"
  },
  "66": {
   "jp": "67869b24e1",
   "kr": "엄청난 사건이란 말이야."
  },
  "67": {
   "jp": "a839841b2a",
   "kr": "떠들고 있는 건 너뿐인 것 같은데."
  },
  "68": {
   "jp": "8813216607",
   "kr": "시끄러워!",
   "auto": 1
  },
  "69": {
   "jp": "205477a8d4",
   "kr": "아무튼 빨리 선생님을 찾아 줘."
  },
  "70": {
   "jp": "0204e4a0d7",
   "kr": "지금 당장 찾아, 후딱 찾아,"
  },
  "71": {
   "jp": "b224c6f9e8",
   "kr": "시급히, 즉시, ２시간 이내…"
  },
  "72": {
   "jp": "62f7f05e62",
   "kr": "무리한 소리 좀 그만 해!"
  },
  "73": {
   "jp": "f081ca30ec",
   "kr": "…찾아 줄 테니 진정하고 말해."
  },
  "74": {
   "jp": "f7d71ace30",
   "kr": "소중한 선생님이 갈 만한 곳이라든가"
  },
  "75": {
   "jp": "4d9e8809bc",
   "kr": "단서가 있으면 뭐든 좋으니 알려 줘."
  },
  "76": {
   "jp": "fd26d81f56",
   "kr": "바보네. 단서가 하나도 없으니까"
  },
  "77": {
   "jp": "afd0da3c48",
   "kr": "알선소에 의뢰를 낸 거잖아."
  },
  "78": {
   "jp": "4884579426",
   "kr": "뭐라고?",
   "auto": 1
  },
  "79": {
   "jp": "02465f7f4b",
   "kr": "뭐니 뭐니 해도 선생은 작가잖아."
  },
  "80": {
   "jp": "3d9794ca8e",
   "kr": "실종 방법이니 트릭이니 산더미처럼 알고 있다고."
  },
  "81": {
   "jp": "fee37466e4",
   "kr": "여관 술집에 가둬 놓고 지켜봤는데"
  },
  "82": {
   "jp": "9e61ce0af0",
   "kr": "어느새 감쪽같이 증발!"
  },
  "83": {
   "jp": "c5e2fb0116",
   "kr": "…이라니까."
  },
  "84": {
   "jp": "81f69a1ba2",
   "kr": "참나, 이런 트릭만큼은"
  },
  "85": {
   "jp": "9b9e423acb",
   "kr": "소재가 안 떨어진다니까, 그 선생!"
  },
  "86": {
   "jp": "c06eb65bb2",
   "kr": "아무튼 빨리 찾아 줘."
  },
  "87": {
   "jp": "97a6806cb8",
   "kr": "마감은 벌써 지났다고."
  },
  "88": {
   "jp": "40812422b1",
   "kr": "팬들한테 항의가 오면 댁 탓이야."
  },
  "89": {
   "jp": "7f76775569",
   "kr": "어머나, 어빈이잖아!"
  },
  "90": {
   "jp": "ca051f3ddd",
   "kr": "있잖아, 우리 선생 못 봤어?"
  },
  "91": {
   "jp": "a802a1368a",
   "kr": "알선소에서 들었어."
  },
  "92": {
   "jp": "ea74023c7e",
   "kr": "또 없어졌다며?"
  },
  "93": {
   "jp": "d486a4f3fd",
   "kr": "그래, 그 망할 영감!"
  },
  "94": {
   "jp": "6b6354df7a",
   "kr": "소재가 떨어질 때마다 튀어 버린다니까."
  },
  "95": {
   "jp": "11a3371375",
   "kr": "이 장사는 시류를 타니까"
  },
  "96": {
   "jp": "3fe39ea348",
   "kr": "인기 있을 때 팍팍 내야 하는데 말이야."
  },
  "97": {
   "jp": "f56c35e706",
   "kr": "어빈, 또 찾아다 줘."
  },
  "98": {
   "jp": "4d4ac531e3",
   "kr": "다음 작품은 너한테 달렸어."
  },
  "99": {
   "jp": "3f6e544dd0",
   "kr": "들었어, 어빈!"
  },
  "100": {
   "jp": "693a1dd3f1",
   "kr": "망할 영감을 찾아 준다며?"
  },
  "101": {
   "jp": "7a337dbb92",
   "kr": "망할 영감…"
  },
  "102": {
   "jp": "df82100476",
   "kr": "그런 말 해도 돼?"
  },
  "103": {
   "jp": "ac3d9c01a9",
   "kr": "괜찮아!"
  },
  "104": {
   "jp": "fa70131d09",
   "kr": "소재가 떨어질 때마다 튀는 선생 따위"
  },
  "105": {
   "jp": "b7831e0bbc",
   "kr": "그냥 망할 영감이야, 망할 영감!!"
  },
  "106": {
   "jp": "4894a67f8b",
   "kr": "고생이 많네…"
  },
  "107": {
   "jp": "5edc555b5e",
   "kr": "부탁해, 어빈."
  },
  "108": {
   "jp": "508b88256e",
   "kr": "또 도와줘."
  },
  "109": {
   "jp": "b6086bb38b",
   "kr": "가든힐의"
  },
  "110": {
   "jp": "4e72b1d661",
   "kr": "안젤라라고 하면 금방 알 거야."
  },
  "111": {
   "jp": "03ebbe3cb7",
   "kr": "단서가 있으면"
  },
  "112": {
   "jp": "29393da2aa",
   "kr": "뭐든 좋으니 알려 줘."
  },
  "113": {
   "jp": "7af4c7a935",
   "kr": "실종 방법이니"
  },
  "114": {
   "jp": "4c715e4610",
   "kr": "트릭이니 산더미처럼 알고 있다고."
  }
 }
