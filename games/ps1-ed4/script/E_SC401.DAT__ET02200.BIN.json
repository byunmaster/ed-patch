  },
  "9": {
   "jp": "0c50896447",
   "kr": "파블로"
  },
  "10": {
   "jp": "c379aae702",
   "kr": "로네"
  },
  "11": {
   "jp": "a794321d13",
   "kr": "이대로는… 살릴 수 없다."
  },
  "12": {
   "jp": "f470628e94",
   "kr": "유감이지만… 손쓸 방도가 없다."
  },
  "13": {
   "jp": "360c73b26f",
   "kr": "이 저주 마법은 강력하다."
  },
  "14": {
   "jp": "4b756e573b",
   "kr": "아무것도 해 줄 수 없다."
  },
  "15": {
   "jp": "5e19280085",
   "kr": "어빈.",
   "auto": 1
  },
  "16": {
   "jp": "8a8a0a5550",
   "kr": "너에게 손님을 데려왔다."
  },
  "17": {
   "jp": "150ffd2263",
   "kr": "들어오게."
  },
  "18": {
   "jp": "eb20ec7f1d",
   "kr": "미첼이 일행에 합류했다."
  },
  "19": {
   "jp": "8e3d0173a1",
   "kr": "한눈팔고 있을 시간은 없어요."
  },
  "20": {
   "jp": "2959847d7f",
   "kr": "시간이 없다. 서둘러야 한다."
  },
  "21": {
   "jp": "850485db27",
   "kr": "도크스에 있는 신목의 잎을"
  },
  "22": {
   "jp": "467347d227",
   "kr": "진실의 섬에 있다는 성수에 담그는 거군요."
  },
  "23": {
   "jp": "3cd8234365",
   "kr": "음. 그거라면 효과가 있겠네."
  },
  "24": {
   "jp": "895f31d208",
   "kr": "반드시 늦지 않을 거라 믿어요."
  },
  "25": {
   "jp": "d3fe69a1e1",
   "kr": "이상해."
  },
  "26": {
   "jp": "90a98b94e4",
   "kr": "소문으로는 오크툼 신도와 발두스 신도 사이의"
  },
  "27": {
   "jp": "23447ca0bb",
   "kr": "긴장 상태가 요즘 악화되고 있다고 퍼져서"
  },
  "28": {
   "jp": "16b001a548",
   "kr": "모두 경계하고 있는데…"
  },
  "29": {
   "jp": "af1c73e1e0",
   "kr": "오크툼 신도들의 구체적인 움직임이"
  },
  "30": {
   "jp": "9f1e419fb6",
   "kr": "전혀 보이지 않아."
  },
  "31": {
   "jp": "1e9a537b65",
   "kr": "어쩌면"
  },
  "32": {
   "jp": "5eeca3e34e",
   "kr": "소문은 우리를 이 신전에 붙잡아 두기 위한 것이고"
  },
  "33": {
   "jp": "91cab1d179",
   "kr": "그들은 뭔가 꾸미고 있는지도 몰라."
  },
  "34": {
   "jp": "3e5fe73440",
   "kr": "목숨은 하나뿐이다."
  },
  "35": {
   "jp": "64b4914945",
   "kr": "누구에게나 하나다."
  },
  "36": {
   "jp": "e018bc999d",
   "kr": "그걸 잊지 말아 줘."
  },
  "37": {
   "jp": "230a4a8506",
   "kr": "으윽…"
  },
  "38": {
   "jp": "1ed9427555",
   "kr": "루티스는 괴로운 듯 작게 신음하고 있다."
  },
  "39": {
   "jp": "6c22d0b397",
   "kr": "곧장 가게."
  },
  "40": {
   "jp": "eeb1a7aacd",
   "kr": "브리작에서 가웨인 님이 기다리고 계시네."
  },
  "41": {
   "jp": "c2c2bd569d",
   "kr": "어떤가,"
  },
  "42": {
   "jp": "66ff93c694",
   "kr": "짐 정리는 되었는가."
  },
  "43": {
   "jp": "98bd4fdbbb",
   "kr": "카테드랄까지의 성자의 길은"
  },
  "44": {
   "jp": "64bf1a58e0",
   "kr": "오크툼 신도의 파괴 공작으로 지나갈 수 없네."
  },
  "45": {
   "jp": "ecb6f357bf",
   "kr": "브리작에서 배로 우회할 수밖에 없겠지."
  },
  "46": {
   "jp": "5c9883bfa1",
   "kr": "절벽 아래 바다에서 카테드랄로 올라가는 동굴이 있네."
  },
  "47": {
   "jp": "7f9a2bbfba",
   "kr": "이제 나는 기도하는 것밖에 할 수 없지만"
  },
  "48": {
   "jp": "cdfba60d33",
   "kr": "진심으로 기도하고 있네."
  },
  "49": {
   "jp": "20925c78e1",
   "kr": "대지의 미래와 정령의 가호가 있기를."
  },
  "50": {
   "jp": "7f9a2bbfba",
   "kr": "이제 나는 기도하는 것밖에 할 수 없지만"
  },
  "51": {
   "jp": "cdfba60d33",
   "kr": "진심으로 기도하고 있네."
  },
  "52": {
   "jp": "20925c78e1",
   "kr": "대지의 미래와 정령의 가호가 있기를."
  },
  "53": {
   "jp": "b4a5126cf4",
   "kr": "이곳에는 여러 서적이 갖춰져 있지만"
  },
  "54": {
   "jp": "e64175aafe",
   "kr": "정작 발두스 신과 오크툼 신에 대한 전승이"
  },
  "55": {
   "jp": "c9747c10eb",
   "kr": "빠져 있다네."
  },
  "56": {
   "jp": "818e9a3070",
   "kr": "중요한 서적은 모두"
  },
  "57": {
   "jp": "7fb6660889",
   "kr": "카테드랄에 모아 두었으니까."
  },
  "58": {
   "jp": "4b126595f2",
   "kr": "카테드랄이 습격을 받아"
  },
  "59": {
   "jp": "000b6e401b",
   "kr": "오크툼 신도들의 손에 넘어간 것이"
  },
  "60": {
   "jp": "cd10d12188",
   "kr": "정말 안타까울 따름이라네."
  },
  "61": {
   "jp": "2b4b285265",
   "kr": "미첼 씨한테 들었는데…"
  },
  "62": {
   "jp": "8241370d17",
   "kr": "가가브 저편에도"
  },
  "63": {
   "jp": "0063ceb926",
   "kr": "다른 세계가 있다면서."
  },
  "64": {
   "jp": "00e6765ae8",
   "kr": "흐음."
  },
  "65": {
   "jp": "f7e5849d3d",
   "kr": "분명 카베사와 쿠엘포는 정신전이"
  },
  "66": {
   "jp": "b3d7945ec9",
   "kr": "예로부터 소유하고 있었지…"
  },
  "67": {
   "jp": "646dd03508",
   "kr": "하지만… 남은 신보는…?"
  },
  "68": {
   "jp": "2981a6512e",
   "kr": "모르겠군."
  },
  "69": {
   "jp": "e73e50eeb3",
   "kr": "남은 네 개의 신보는 대체 어디에 있을까?"
  },
  "70": {
   "jp": "a9ff57518a",
   "kr": "고대 엘 필딘의 전승에서는"
  },
  "71": {
   "jp": "f22b0e81f4",
   "kr": "발두스 신과 오크툼 신이 두 대신으로서 정점에 있고,"
  },
  "72": {
   "jp": "3689613600",
   "kr": "그 아래에 정령신 둘가께서 계십니다."
  },
  "73": {
   "jp": "7b2b9ee354",
   "kr": "또한 그 정령신 둘가가 거느리는"
  },
  "74": {
   "jp": "b3575b4ee5",
   "kr": "이둔, 네프티스, 잘, 스코티아의 사대 정령이"
  },
  "75": {
   "jp": "86f2372352",
   "kr": "지상의 질서를 지키고 계신다고 합니다."
  },
  "76": {
   "jp": "313ab570fe",
   "kr": "요즘 근시가 심해진 모양이군."
  },
  "77": {
   "jp": "3cd801aeba",
   "kr": "방심하면 금세 새우등이 된다니까."
  },
  "78": {
   "jp": "c0a66152ca",
   "kr": "안 되지, 안 되지."
  },
  "79": {
   "jp": "722a08aae1",
   "kr": "《진실의 섬》"
  },
  "80": {
   "jp": "0efcdcfd42",
   "kr": "듀시스 지방은 도크스 북동쪽에 위치하며,"
  },
  "81": {
   "jp": "d8508c8792",
   "kr": "그 섬은 위선의 바다에 떠 있다."
  },
  "82": {
   "jp": "4b3ccb02aa",
   "kr": "소소한 진실을 지키는 작은 섬이니라."
  },
  "83": {
   "jp": "ea22275748",
   "kr": "발두스 신에게도 오크툼 신에게도 가담하지 않고"
  },
  "84": {
   "jp": "f68ec62eb1",
   "kr": "또한 선도 악도 아니며"
  },
  "85": {
   "jp": "d87c0b5cf7",
   "kr": "태곳적부터 거짓의 세상에 진실을 비춘다."
  },
  "86": {
   "jp": "524f610512",
   "kr": "《둘가 신》"
  },
  "87": {
   "jp": "e4ad4d88cd",
   "kr": "보레아스 지구 북단에 위치하며,"
  },
  "88": {
   "jp": "797d988e43",
   "kr": "코르나 마을 북쪽에서 『얼음 신전』으로 가는 길이 있다."
  },
  "89": {
   "jp": "b5d315c4e5",
   "kr": "그 신전이야말로 정령신 둘가의 사당."
  },
  "90": {
   "jp": "fa30a54ef6",
   "kr": "엘 필딘의 사대 정령",
   "fix": 1
  },
  "91": {
   "jp": "95d6ad25d6",
   "kr": "이둔, 네프티스, 잘, 스코티아를 아우르는,"
  },
  "92": {
   "jp": "301ef4cf9e",
   "kr": "정령신의 사당이다.",
   "fix": 1
  },
  "93": {
   "jp": "f6c3688cb0",
   "kr": "남은 네 개의 신보는"
  },
  "94": {
   "jp": "3a4a0e167b",
   "kr": "대체 어디에 있는 걸까?"
  },
  "95": {
   "jp": "7dce9d28fc",
   "kr": "발두스 신과"
  },
  "96": {
   "jp": "b21ad587b6",
   "kr": "오크툼 신이 양대 신으로서 정점에 있고"
  },
  "97": {
   "jp": "30e77b0de4",
   "kr": "이둔, 네프티스,"
  },
  "98": {
   "jp": "2089c01c92",
   "kr": "잘, 스코티아의 사대 정령이"
  },
  "99": {
   "jp": "30e77b0de4",
   "kr": "이둔, 네프티스,",
   "fix": 1
  },
  "100": {
   "jp": "9b55b15346",
   "kr": "잘, 스코티아를 거느리는",
   "fix": 1
  }
 }
}
