 "member": "..\\BIN\\DT04000A.BIN",
 "segments": {
  "0": {
   "jp": "6af99606e7",
   "kr": "다행이에요."
  },
  "1": {
   "jp": "7e91b5f283",
   "kr": "저, 사실 바다를 싫어하거든요."
  },
  "2": {
   "jp": "f1550b065d",
   "kr": "바닷물은 끈적끈적하잖아요."
  },
  "3": {
   "jp": "d9cb586495",
   "kr": "애써 입은 옷이 엉망이 되어 버리니까요."
  },
  "4": {
   "jp": "bbbf02ec94",
   "kr": "어쩔 수 없네요."
  },
  "5": {
   "jp": "4c2914acbb",
   "kr": "그런 이유라면 저는 이만 가 보겠어요."
  },
  "6": {
   "jp": "10aa316cc9",
   "kr": "읽던 책도 있고"
  },
  "7": {
   "jp": "474c980452",
   "kr": "어디선가 독서나 계속하겠어요."
  },
  "8": {
   "jp": "e78481255b",
   "kr": "나는 고용됐을 뿐이야."
  },
  "9": {
   "jp": "f43602f7e0",
   "kr": "돈도 받았으니"
  },
  "10": {
   "jp": "7b7d07f0b8",
   "kr": "필요 없다면 그걸로 됐어."
  },
  "11": {
   "jp": "46400df475",
   "kr": "어빈 씨, 미첼 씨. 조심하세요."
  },
  "12": {
   "jp": "196bfd33f4",
   "kr": "두 분의 여행이 순조롭도록"
  },
  "13": {
   "jp": "ae4655d648",
   "kr": "저, 기도할게요."
  },
  "14": {
   "jp": "60eeaf0bd4",
   "kr": "어빈이 정했다면 이견은 없어."
  },
  "15": {
   "jp": "3a48368959",
   "kr": "조심해서 가."
  },
  "16": {
   "jp": "535caaa66a",
   "kr": "뭐야, 형."
  },
  "17": {
   "jp": "22b5be6a5c",
   "kr": "이런 데서 헤어진다는 거야?!"
  },
  "18": {
   "jp": "ef5abe4c1c",
   "kr": "쳇, 쌀쌀맞네～"
  },
  "19": {
   "jp": "62c3171eb7",
   "kr": "뭐, 됐어."
  },
  "20": {
   "jp": "e698d91abc",
   "kr": "무슨 사정이 있나 보니까."
  },
  "21": {
   "jp": "adf069d2f8",
   "kr": "미첼 형, 우리 형 좀 부탁해."
  },
  "22": {
   "jp": "adc003bb61",
   "kr": "이 작은 배가"
  },
  "23": {
   "jp": "5ccc2bddb1",
   "kr": "폭풍에 휩쓸려 떠도는 낙엽이 되지 않으면"
  },
  "24": {
   "jp": "f087ee6bc7",
   "kr": "좋겠습니다만."
  },
  "25": {
   "jp": "7197330888",
   "kr": "조심해서 가세요.",
   "auto": 1
  },
  "26": {
   "jp": "233c963034",
   "kr": "미첼, 어빈을 부탁하오."
  },
  "27": {
   "jp": "3a99e1bcad",
   "kr": "이(가) 파티에서 빠졌다."
  }
 }
}
