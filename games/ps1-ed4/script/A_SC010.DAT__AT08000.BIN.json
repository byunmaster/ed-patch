 "archive": "/A/SC010.DAT",
 "member": "..\\BIN\\AT08000.BIN",
 "segments": {
  "0": {
   "jp": "0224567e7f",
   "kr": "네프티스"
  },
  "1": {
   "jp": "b78db731a4",
   "kr": "나는… 신보를 지키는 자, 네프티스."
  },
  "2": {
   "jp": "c5d8db9b50",
   "kr": "이곳을 찾아오는 자를 기다리고 있었노라."
  },
  "3": {
   "jp": "277f85f85e",
   "kr": "내 혼은 사악한 자의 술수로 탁한 기운에 더럽혀졌도다."
  },
  "4": {
   "jp": "9d78b7db83",
   "kr": "이 저주를 깨뜨리는 자는"
  },
  "5": {
   "jp": "c6e529cfc5",
   "kr": "내 힘을 꺾은 강한 혼뿐…"
  },
  "6": {
   "jp": "c88a33c941",
   "kr": "평온한 정령으로… 나를 되돌려 다오."
  },
  "7": {
   "jp": "52a9d4337d",
   "kr": "그리하면 인정하리라."
  },
  "8": {
   "jp": "f67dac469e",
   "kr": "네가 신보를 맡길 만한 혼임을…"
  },
  "9": {
   "jp": "47c19edb97",
   "kr": "참 나."
  },
  "10": {
   "jp": "42368a8790",
   "kr": "정령이란 놈들은 제멋대로인 소리만 해 대는군."
  },
  "11": {
   "jp": "70012c4ac3",
   "kr": "문은 잠겨 있다."
  },
  "12": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "13": {
   "jp": "117bbb5933",
   "kr": "을(를) 사용했다."
  }
 }
}
