 "segments": {
  "0": {
   "jp": "a824ac59fc",
   "kr": "신관장"
  },
  "1": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "2": {
   "jp": "117bbb5933",
   "kr": "을(를) 사용했다.",
   "auto": 1
  },
  "3": {
   "jp": "08618115e7",
   "kr": "문 자물쇠가 열렸다.",
   "auto": 1
  },
  "4": {
   "jp": "1df8719032",
   "kr": "문은 잠겨 있다.",
   "auto": 1
  },
  "5": {
   "jp": "c83b17b454",
   "kr": "아, 어빈 씨."
  },
  "6": {
   "jp": "8c57ea3558",
   "kr": "크로웰 님께"
  },
  "7": {
   "jp": "e73054f8b1",
   "kr": "전이문 이야기는 들으셨습니까?"
  },
  "8": {
   "jp": "5a96c8cfd4",
   "kr": "크로웰 님과의 이야기가 끝나면"
  },
  "9": {
   "jp": "f7427aac19",
   "kr": "다시 와 주세요.",
   "auto": 1
  },
  "10": {
   "jp": "05df04e7c3",
   "kr": "크로웰 님께 이야기는 들었습니다."
  },
  "11": {
   "jp": "268c99a15b",
   "kr": "이곳 보물상자에 "
  },
  "12": {
   "jp": "da8109ab90",
   "kr": "이(가) 있습니다."
  },
  "13": {
   "jp": "07edd547f6",
   "kr": "자, 가져가십시오."
  },
  "14": {
   "jp": "f5f09d0aad",
   "kr": "가장 북쪽 문이 전이문 입구입니다."
  },
  "15": {
   "jp": "594734fc43",
   "kr": "문 앞에서 "
  },
  "16": {
   "jp": "a48e5560ea",
   "kr": "을(를) 쓰시면 문이 열립니다."
  },
  "17": {
   "jp": "1ed33bd639",
   "kr": "그리고 보물상자에 들어 있는 물건은"
  },
  "18": {
   "jp": "9723b3153e",
   "kr": "무엇이든 자유롭게 쓰셔도 된다고 하십니다."
  },
  "19": {
   "jp": "bf82a8e399",
   "kr": "쓸 만한 물건이 있으면"
  },
  "20": {
   "jp": "22595c899e",
   "kr": "부담 갖지 마시고 가져가십시오."
  },
  "21": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "22": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다.",
   "auto": 1
  },
  "23": {
   "jp": "889ceea3f2",
   "kr": "보물상자에는 "
  },
  "24": {
   "jp": "665e4d5705",
   "kr": "이(가) 들어 있다.",
   "auto": 1
  },
  "25": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "26": {
   "jp": "f5fc3dee34",
   "kr": "을(를) 포기했다.",
   "auto": 1
  },
  "27": {
   "jp": "63c4c357c2",
   "kr": "보물상자에는 아무것도 들어 있지 않다."
  }
 }
}
