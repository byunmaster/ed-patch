{
 "archive": "/E/SC402.DAT",
 "member": "..\\BIN\\ET00000D.BIN",
 "segments": {
  "0": {
   "jp": "beb47d0a6d",
   "kr": "이곳 호수는 모스 호수라고 하오."
  },
  "1": {
   "jp": "dc8b7162b3",
   "kr": "모시라는 수수께끼의 생물이 있다고들 하오."
  },
  "2": {
   "jp": "539aae56e6",
   "kr": "별일이구려. 이런 시골에 손님이라니."
  },
  "3": {
   "jp": "1d0fcbcd40",
   "kr": "무슨 볼일이라도 있으신가?"
  },
  "4": {
   "jp": "1c80de6dc0",
   "kr": "스코티아의 사당에 대해 여쭙고 싶어요."
  },
  "5": {
   "jp": "54eb83611b",
   "kr": "호, 이거 놀랍구먼."
  },
  "6": {
   "jp": "643ed88b00",
   "kr": "스코티아 님을 아는 사람이 계시다니."
  },
  "7": {
   "jp": "a0507e6528",
   "kr": "스코티아 님은 이 키트 마을의 수호신이시오."
  },
  "8": {
   "jp": "0150a860f4",
   "kr": "우리 선조를 이 땅으로 이끌어"
  },
  "9": {
   "jp": "9679f7e2a4",
   "kr": "키트 마을을 일구어 주셨다고 전해지오."
  },
  "10": {
   "jp": "4e107ad39c",
   "kr": "모신 사당이 지금도"
  },
  "11": {
   "jp": "17601d5255",
   "kr": "이 마을 북쪽에 남아 있소."
  },
  "12": {
   "jp": "a69564f57f",
   "kr": "마을 북쪽이군요."
  },
  "13": {
   "jp": "87612cd4b3",
   "kr": "그렇소, 젊은이 걸음이라면 바로 저기라오."
  },
  "14": {
   "jp": "da1418cf13",
   "kr": "다만 안으로 들어갈 수는 없소만."
  },
  "15": {
   "jp": "844c562cc8",
   "kr": "들어갈 수 없다고?"
  },
  "16": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "17": {
   "jp": "c3d8b34419",
   "kr": "벌써 몇백 년째 들어간 이가 없었소."
  },
  "18": {
   "jp": "c5bea3bb3c",
   "kr": "스코티아 님의 사당에 들어가려면"
  },
  "19": {
   "jp": "7def77c5e4",
   "kr": "숲 깊은 곳의 성스러운 통로를 지나야 하오."
  },
  "20": {
   "jp": "2cdaaa7a76",
   "kr": "그런데 그 통로는 문이 닫혀 있어"
  },
  "21": {
   "jp": "084ebb10e7",
   "kr": "아무도 지나갈 수 없다오."
  },
  "22": {
   "jp": "879899291a",
   "kr": "먼 옛날 스코티아 님의 무녀들은"
  },
  "23": {
   "jp": "59148456f7",
   "kr": "자유롭게 드나들었다고 하오만."
  },
  "24": {
   "jp": "dd51ece96e",
   "kr": "그럼 어쩔 도리가 없잖아."
  },
  "25": {
   "jp": "95b0800bb2",
   "kr": "하다못해 무녀의 자손이라도 남아 있지 않을까?"
  },
  "26": {
   "jp": "db7f1f8ed3",
   "kr": "오오, 그렇다면 있소."
  },
  "27": {
   "jp": "c7354e5bbe",
   "kr": "우리 이웃집 셀린이 그 자손이오."
  },
  "28": {
   "jp": "e45b6d4e85",
   "kr": "오래된 문서도 남아 있다 하니"
  },
  "29": {
   "jp": "cc6b5a1271",
   "kr": "보여 달라고 해 보는 게 어떻소?"
  },
  "30": {
   "jp": "7d3d347747",
   "kr": "셀린에게 부탁하면 고문서를 보여 줄 것이오."
  },
  "31": {
   "jp": "e498be5b99",
   "kr": "꽤 흥미로운 내용이오."
  },
  "32": {
   "jp": "49bab6b9b0",
   "kr": "셀린에게 고문서를 보여 달라고 해 보았소?"
  },
  "33": {
   "jp": "fc13864cf3",
   "kr": "어빈 씨는 그 크리스탈을 찾고 있다고요?"
  },
  "34": {
   "jp": "d109dc45ae",
   "kr": "이런, 고생스러운 일이구려."
  },
  "35": {
   "jp": "531a325f6e",
   "kr": "이제 모시의 재채기도 가라앉을 때가 됐구먼."
  },
  "36": {
   "jp": "dd735d2d33",
   "kr": "어빈 씨도"
  },
  "37": {
   "jp": "4779e5d78e",
   "kr": "이런 마을에서는 어서 떠나시는 게 좋소."
  },
  "38": {
   "jp": "216485285d",
   "kr": "호수로 나가려는 생각은 하면 안 되오."
  },
  "39": {
   "jp": "0f0507682a",
   "kr": "스코티아 님을 습격하는 자란…"
  },
  "40": {
   "jp": "9d01f7e9e2",
   "kr": "대체 어떤 자란 말이오?"
  },
  "41": {
   "jp": "03b4213a52",
   "kr": "어쨌든"
  },
  "42": {
   "jp": "1746b9b71c",
   "kr": "리타가 무사해서 다행이구먼…"
  },
  "43": {
   "jp": "55ebc9f48d",
   "kr": "어빈 씨, 스코티아 님을"
  },
  "44": {
   "jp": "8a27083fc5",
   "kr": "잘 부탁하오."
  },
  "45": {
   "jp": "c49744abca",
   "kr": "어빈 씨에게는 뭐라 감사해야 할지."
  },
  "46": {
   "jp": "1e80be357c",
   "kr": "또 이 마을에 와 주시게."
  },
  "47": {
   "jp": "6af3b617c0",
   "kr": "지금 우리 집에"
  },
  "48": {
   "jp": "246225f323",
   "kr": "필딘의 학생을 맡아 두고 있소."
  },
  "49": {
   "jp": "6bec5fbddf",
   "kr": "스코티아 님을 연구하고 있습니다."
  },
  "50": {
   "jp": "5d03044cac",
   "kr": "모시라는 수수께끼의 생물이"
  },
  "51": {
   "jp": "f8d6b554c9",
   "kr": "있다고들 하오."
  },
  "52": {
   "jp": "3b01c58664",
   "kr": "어빈 씨는"
  },
  "53": {
   "jp": "c0dd15697d",
   "kr": "그 크리스탈을 찾고 있다고요?"
  },
  "54": {
   "jp": "6b032110c5",
   "kr": "어빈 씨에게는"
  },
  "55": {
   "jp": "58557069ee",
   "kr": "뭐라 감사해야 할지."
  }
 }
}
