  "27": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "28": {
   "jp": "3cf31a5e3e",
   "kr": "가웨인."
  },
  "29": {
   "jp": "e511329d23",
   "kr": "끼어들지 말아 줘."
  },
  "30": {
   "jp": "c1bda2c427",
   "kr": "이 녀석은 각오를 하고 있어."
  },
  "31": {
   "jp": "2d1db2cbc2",
   "kr": "알고서 기다렸던 거야."
  },
  "32": {
   "jp": "d4842e4d28",
   "kr": "스승님, 저는 사람을 아끼는 정을 버렸습니다."
  },
  "33": {
   "jp": "17b9ca3e30",
   "kr": "그 선택이 잘못됐다는 것도 알고 있습니다."
