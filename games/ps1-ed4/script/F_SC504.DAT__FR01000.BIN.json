  },
  "22": {
   "jp": "028f2b8592",
   "kr": "자네들이 싸워서 무엇 하겠소?"
  },
  "23": {
   "jp": "4cec708401",
   "kr": "볼게이드의 함정에"
  },
  "24": {
   "jp": "8f120b3260",
   "kr": "놀아나고 있는 걸 모르겠단 말이오!"
  },
  "25": {
   "jp": "09af63988c",
   "kr": "스승님, 알고 있습니다."
  },
  "26": {
   "jp": "90ca9745dd",
   "kr": "하지만 제게는 도미니크가 전부입니다."
