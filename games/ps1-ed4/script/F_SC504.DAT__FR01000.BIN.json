   "kr": "매드람"
  },
  "1": {
   "jp": "f32a76ca63",
   "kr": "매드람의 목소리"
  },
  "2": {
   "jp": "55ad31e47e",
   "kr": "드디어 여기까지 왔나."
  },
  "3": {
   "jp": "db8f0cc66a",
   "kr": "네놈은!"
  },
  "4": {
   "jp": "e021d94244",
   "kr": "매드람!!"
  },
  "5": {
   "jp": "f38968a25e",
   "kr": "남은 건 잘의 신보뿐인가."
  },
  "6": {
   "jp": "edb2c36a57",
   "kr": "어째서 네가 여기에…?!"
  },
  "7": {
   "jp": "d7cab35156",
   "kr": "설마…"
  },
  "8": {
   "jp": "8e5096ceeb",
   "kr": "가웨인의 제자라는 게…?"
  },
  "9": {
   "jp": "e4eb8eb436",
   "kr": "…그렇다."
  },
  "10": {
   "jp": "f2f0f45946",
   "kr": "도미니크가… 볼게이드의 저주 때문에"
  },
  "11": {
   "jp": "d35e29cf50",
   "kr": "죽기 전까지는 말이다."
  },
  "12": {
   "jp": "196ee4479a",
   "kr": "저주에 대해선 가웨인에게 들었다."
  },
  "13": {
   "jp": "e455f4b9d5",
   "kr": "도미니크에게 걸린 저주는,"
  },
  "14": {
   "jp": "cfd5be6797",
   "kr": "내가 정신전 사람을 １０명 죽이면 사라지고"
  },
  "15": {
   "jp": "397d834e58",
   "kr": "되살아난다는 것이다."
  },
  "16": {
   "jp": "3cfd805ffd",
   "kr": "지금까지 네 여동생 아이멜을 포함해"
