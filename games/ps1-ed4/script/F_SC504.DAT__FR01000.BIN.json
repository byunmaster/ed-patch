  },
  "39": {
   "jp": "a0a0cda60f",
   "kr": "자, 덤벼라."
  },
  "40": {
   "jp": "453d00e649",
   "kr": "윽…"
  },
  "41": {
   "jp": "5c4856ec89",
   "kr": "과연… 스승님이 인정한 자들이다."
