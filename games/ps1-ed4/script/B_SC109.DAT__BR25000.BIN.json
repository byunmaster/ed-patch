{
 "archive": "/B/SC109.DAT",
 "member": "..\\BIN\\BR25000.BIN",
 "segments": {
  "0": {
   "jp": "a003a10a74",
   "kr": "니플"
  },
  "1": {
   "jp": "75bc16d87a",
   "kr": "네페레"
  },
  "2": {
   "jp": "10c52ed174",
   "kr": "돌크"
  },
  "3": {
   "jp": "366172bf6b",
   "kr": "도적",
   "auto": 1
  },
  "4": {
   "jp": "68d5203982",
   "kr": "케레스"
  },
  "5": {
   "jp": "1f4f3cfebf",
   "kr": "후우…"
  },
  "6": {
   "jp": "10590863b4",
   "kr": "이 근처에서 전부인가?"
  },
  "7": {
   "jp": "2ff9c7e03e",
   "kr": "슬슬 알선소에서 보수를 받자."
  },
  "8": {
   "jp": "e63e43a489",
   "kr": "아무래도 방금 게 끝인가 봐."
  },
  "9": {
   "jp": "71b1739149",
   "kr": "근처에 마수의 기척은 없어."
  },
  "10": {
   "jp": "80ca641319",
   "kr": "알선소에 보고하자."
  },
  "11": {
   "jp": "8a922a3f8b",
   "kr": "아."
  },
  "12": {
   "jp": "d9a18a1c9a",
   "kr": "당신은…"
  },
  "13": {
   "jp": "8100630fdb",
   "kr": "예전에 신세 졌어요."
  },
  "14": {
   "jp": "215e4efa10",
   "kr": "아니, 나야말로."
  },
  "15": {
   "jp": "a5ea2180a6",
   "kr": "어째서 여기에?"
  },
  "16": {
   "jp": "ea3afb3be4",
   "kr": "기억하지?"
  },
  "17": {
   "jp": "f7f5147f51",
   "kr": "샴실단의 돌크."
  },
  "18": {
   "jp": "abdfed1380",
   "kr": "마수를 부리려고 재료를 모으던 남자."
  },
  "19": {
   "jp": "68e71f34c7",
   "kr": "그 녀석한테 놓친 게 분해서"
  },
  "20": {
   "jp": "399ceb51ae",
   "kr": "계속 찾고 있어."
  },
  "21": {
   "jp": "fa76fc219b",
   "kr": "소문으로는 샴실단이"
  },
  "22": {
   "jp": "29655482df",
   "kr": "마수를 부리는 지팡이를 완성한 모양이에요."
  },
  "23": {
   "jp": "a00bd53f37",
   "kr": "그때 돌크를 놓치지 않았다면"
  },
  "24": {
   "jp": "84a0231032",
   "kr": "이런 일은 없었을 텐데."
  },
  "25": {
   "jp": "02c58b2d96",
   "kr": "그래그래, 돌크야, 돌크!"
  },
  "26": {
   "jp": "7726649b70",
   "kr": "돌크가 나빠."
  },
  "27": {
   "jp": "3dd0b54a53",
   "kr": "가짜 병사까지 써서"
  },
  "28": {
   "jp": "18d7ba69e9",
   "kr": "나를 속이다니 용서 못 해!"
  },
  "29": {
   "jp": "d334112073",
   "kr": "네페레, 그렇게 흥분하면 안 돼."
  },
  "30": {
   "jp": "d3c6681c93",
   "kr": "그런데 이 앞에 돌크는 없었나요?"
  },
  "31": {
   "jp": "7263d696dc",
   "kr": "돌크는커녕 사람은 아무도 없었어."
  },
  "32": {
   "jp": "a4f46c64b1",
   "kr": "가는 곳마다 마수투성이야."
  },
  "33": {
   "jp": "a34adce78b",
   "kr": "마수라고 하니 이 동굴 이상해."
  },
  "34": {
   "jp": "c983106515",
   "kr": "한 번 쓰러뜨려도 조금 있으면 같은 곳에"
  },
  "35": {
   "jp": "a549a2fd6b",
   "kr": "마수가 있다니까."
  },
  "36": {
   "jp": "1a45414e04",
   "kr": "하지만 돌크가 없다면"
  },
  "37": {
   "jp": "9a5260d37d",
   "kr": "이 동굴을 조사해도 소용없겠네."
  },
  "38": {
   "jp": "1dca2a3ed4",
   "kr": "네.",
   "auto": 1
  },
  "39": {
   "jp": "1413903e36",
   "kr": "다른 동굴로 가요."
  },
  "40": {
   "jp": "eac22867c1",
   "kr": "그럼 실례할게요."
  },
  "41": {
   "jp": "a916a0b9ab",
   "kr": "실수하지 않게 일해."
  },
  "42": {
   "jp": "c4bd0d8575",
   "kr": "너는… 돌크!"
  },
  "43": {
   "jp": "f4c030525e",
   "kr": "오랜만이군."
  },
  "44": {
   "jp": "c2ab286ea8",
   "kr": "루마 동굴 이후로군."
  },
  "45": {
   "jp": "d7ea81b212",
   "kr": "방금 나간 꼬맹이들은"
  },
  "46": {
   "jp": "de3fa6e77a",
   "kr": "상대가 안 될 것 같았으니까."
  },
  "47": {
   "jp": "930813e353",
   "kr": "네가 올 때까지 기다렸지."
  },
  "48": {
   "jp": "031a3c4db5",
   "kr": "작은 실험에 어울려 줘야겠어."
  },
  "49": {
   "jp": "ec58445673",
   "kr": "도망만 다녀서는 얘기가 안 되지."
  },
  "50": {
   "jp": "ff2b9605ab",
   "kr": "이번엔 제대로 싸워 봐."
  },
  "51": {
   "jp": "6a6aa50351",
   "kr": "돌크는 지팡이를 움켜쥐고"
  },
  "52": {
   "jp": "6f331f53b0",
   "kr": "주문 같은 것을 읊었다."
  },
  "53": {
   "jp": "dba545d86c",
   "kr": "어떠냐?"
  },
  "54": {
   "jp": "8bb58f34af",
   "kr": "이게 조수의 지팡이의 힘이다."
  },
  "55": {
   "jp": "6b32dede60",
   "kr": "마수를 끌어당겨 마음대로 부릴 수 있다."
  },
  "56": {
   "jp": "f82299fb0f",
   "kr": "이 동굴을 실험장으로 썼는데"
  },
  "57": {
   "jp": "e8ffc11973",
   "kr": "그럭저럭 성과가 있었어."
  },
  "58": {
   "jp": "ba8ed4bdce",
   "kr": "남은 건 어느 정도 전력이 되느냐인데"
  },
  "59": {
   "jp": "6e94f63472",
   "kr": "그건 네가 확인해 줘."
  },
  "60": {
   "jp": "1a69a8f08a",
   "kr": "제대로 싸워 줘."
  },
  "61": {
   "jp": "ff61bcf6b2",
   "kr": "과연이군."
  },
  "62": {
   "jp": "3c27c729e7",
   "kr": "역시 마수를 물리쳤구나."
  },
  "63": {
   "jp": "41fed3be9e",
   "kr": "하지만 조수의 지팡이는 충분히 쓸 만하다는 게 증명됐다."
  },
  "64": {
   "jp": "d84d81c0d5",
   "kr": "이걸로 실험은 끝내자."
  },
  "65": {
   "jp": "0b4cb60fd9",
   "kr": "협력, 고맙다!"
  },
  "66": {
   "jp": "36a3c4b6a4",
   "kr": "알선소 일은 끝났지만"
  },
  "67": {
   "jp": "e9c30fefdc",
   "kr": "돌크가 마음에 걸리네."
  },
  "68": {
   "jp": "f778ec08ab",
   "kr": "응.",
   "auto": 1
  },
  "69": {
   "jp": "e50274ec4b",
   "kr": "그런 지팡이를 갖고 있다니"
  },
  "70": {
   "jp": "ad2c5411d2",
   "kr": "무슨 짓을 저지를지 몰라."
  },
  "71": {
   "jp": "47f3b9c67f",
   "kr": "그러게."
  },
  "72": {
   "jp": "dd46702c00",
   "kr": "그런 위험한 지팡이를"
  },
  "73": {
   "jp": "6dc3d424ca",
   "kr": "샴실단이 가지게 둬서는 안 돼."
  },
  "74": {
   "jp": "916f5c5393",
   "kr": "정말이에요."
  },
  "75": {
   "jp": "4d790fd5b0",
   "kr": "마수를 부리는 지팡이는"
  },
  "76": {
   "jp": "a47f446a66",
   "kr": "쓸데없는 싸움을 피하기 위해 써야 해요."
  },
  "77": {
   "jp": "6af92e7571",
   "kr": "샴실단은 분명"
  },
  "78": {
   "jp": "282201a4a8",
   "kr": "악용하려 하고 있어요."
  },
  "79": {
   "jp": "cfaf450d5d",
   "kr": "내버려 둬서는 안 돼요."
  },
  "80": {
   "jp": "dea1ff05cf",
   "kr": "서둘러 소지품을 줄이고 와."
  },
  "81": {
   "jp": "bb72d5624d",
   "kr": "샴실단이 언제 보고서를"
  },
  "82": {
   "jp": "211fc77c31",
   "kr": "빼앗으러 올지 몰라."
  },
  "83": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "84": {
   "jp": "f8851237f7",
   "kr": "을(를) 받았다.",
   "auto": 1
  },
  "85": {
   "jp": "71babd03b9",
   "kr": "그럼 알선소까지 보고서를 전해 줘."
  },
  "86": {
   "jp": "4a642ed128",
   "kr": "이 동굴에서 무사히 나가면"
  },
  "87": {
   "jp": "98475bf7fe",
   "kr": "샴실단의 습격은 없을 거야."
  },
  "88": {
   "jp": "f99ec25289",
   "kr": "보물상자 안에는 아무것도 없다.",
   "auto": 1
  },
  "89": {
   "jp": "21795bdd80",
   "kr": "보물상자는 잠겨 있다."
  },
  "90": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "91": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다."
  },
  "92": {
   "jp": "8cd5f50208",
   "kr": "알선소에서 보낸 사람이지?"
  },
  "93": {
   "jp": "c175707d33",
   "kr": "보고서는 이 동굴 안 보물상자에 있어."
  },
  "94": {
   "jp": "7310f8272b",
   "kr": "이게 열쇠야."
  },
  "95": {
   "jp": "c389898e72",
   "kr": "여기저기 우릴"
  },
  "96": {
   "jp": "d283fbf497",
   "kr": "캐고 다니던 여자는 어디 있어?"
  },
  "97": {
   "jp": "a6172b1d7e",
   "kr": "너도 그 여자 동료지."
  },
  "98": {
   "jp": "d932f38da5",
   "kr": "해치워라!",
   "auto": 1
  },
  "99": {
   "jp": "7c3ebb8e06",
   "kr": "또 돌아오다니"
  },
  "100": {
   "jp": "607b6bd6f2",
   "kr": "어지간히 죽고 싶은가 보군!"
  }
 }
}
