  },
  "40": {
   "jp": "3b8fc1b9e0",
   "kr": "인질을 잡혔어!"
  },
  "41": {
   "jp": "e75df3b69e",
   "kr": "그 바람에 손도 못 쓰고 있어."
  },
  "42": {
   "jp": "6d673a9eb8",
