{
 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT02000.BIN",
 "segments": {
  "0": {
   "jp": "b8d103cea7",
   "kr": "오레시아 원장"
  },
  "1": {
   "jp": "973814012c",
   "kr": "미스란"
  },
  "2": {
   "jp": "f28c4e6cf6",
   "kr": "엘레타"
  },
  "3": {
   "jp": "81f395be89",
   "kr": "마법 길드원",
   "auto": 1
  },
  "4": {
   "jp": "2058ee3fe2",
   "kr": "어머…"
  },
  "5": {
   "jp": "b4d111d97a",
   "kr": "어빈!?"
  },
  "6": {
   "jp": "52215b9853",
   "kr": "기억해 주셨나요?"
  },
  "7": {
   "jp": "e785419725",
   "kr": "잊을 리가 있겠어요."
  },
  "8": {
   "jp": "2a9883ef5e",
   "kr": "아무리 자랐어도"
  },
  "9": {
   "jp": "6fa89f45d0",
   "kr": "당신이라면 알아볼 수 있어요."
  },
  "10": {
   "jp": "4eb78b3305",
   "kr": "오랜만입니다. 오레시아 선생님."
  },
  "11": {
   "jp": "1b1753db3e",
   "kr": "정말 오랜만이네요."
  },
  "12": {
   "jp": "10eefbecb8",
   "kr": "훌륭하게 자랐군요."
  },
  "13": {
   "jp": "06ab65c821",
   "kr": "이쪽은 같이 여행하고 있는 마일이에요."
  },
  "14": {
   "jp": "6018273f32",
   "kr": "할아버지 댁에 간 뒤로 둘도 없는 친구예요."
  },
  "15": {
   "jp": "d41955f56b",
   "kr": "처음 뵙겠습니다, 마일이라고 합니다."
  },
  "16": {
   "jp": "db4e5818f4",
   "kr": "어머, 처음 뵙겠습니다."
  },
  "17": {
   "jp": "1004dbf35c",
   "kr": "아주 좋은 친구인 것 같네요."
  },
  "18": {
   "jp": "616d244754",
   "kr": "저, 오레시아 선생님."
  },
  "19": {
   "jp": "977599f711",
   "kr": "아이멜 말인데요…"
  },
  "20": {
   "jp": "ca321a526a",
   "kr": "네, 그 얘기를 해야겠죠."
  },
  "21": {
   "jp": "f7f8da014c",
   "kr": "아이멜이라면"
  },
  "22": {
   "jp": "a75f023b28",
   "kr": "그 뒤로 쭉 이 수도원에서"
  },
  "23": {
   "jp": "397b925c83",
   "kr": "함께 지냈어요."
  },
  "24": {
   "jp": "90f088968b",
   "kr": "어제 일이에요."
  },
  "25": {
   "jp": "11cda75dea",
   "kr": "그 아이에게 제 심부름으로"
  },
  "26": {
   "jp": "4f9283ab36",
   "kr": "발크드에 다녀와 달라고 했어요."
  },
  "27": {
   "jp": "bb0ccd010f",
   "kr": "발크드요?"
  },
  "28": {
   "jp": "e09d2fbff9",
   "kr": "바다 건너 듀시스 지방에 있는 정신전의 성도예요."
  },
  "29": {
   "jp": "17d126565e",
   "kr": "원래는"
  },
  "30": {
   "jp": "b300e113a7",
   "kr": "우리가 있던 카테드랄이"
  },
  "31": {
   "jp": "488d140d83",
   "kr": "그랬는데…"
  },
  "32": {
   "jp": "8ad9eb41af",
   "kr": "그 습격으로 사교도의 신전이 되어 버려서"
  },
  "33": {
   "jp": "dfa43c2e4b",
   "kr": "다음으로 오래된 정신전의 사원이 있는"
  },
  "34": {
   "jp": "47891519d4",
   "kr": "발크드를 성도로 삼은 거예요."
  },
  "35": {
   "jp": "43355d9332",
   "kr": "됐다. 그럼 아이멜은"
  },
  "36": {
   "jp": "1e5752a000",
   "kr": "심부름을 갔을 뿐이고 무사하잖아."
  },
  "37": {
   "jp": "f76311e74e",
   "kr": "다행이다, 어빈."
  },
  "38": {
   "jp": "61a0183fab",
   "kr": "응, 안심했어."
  },
  "39": {
   "jp": "4dd5271dfc",
   "kr": "오레시아 선생님."
  },
  "40": {
   "jp": "3e987d4b8c",
   "kr": "아이멜은 어떤 용무로 발크드에?"
  },
  "41": {
   "jp": "1d00eb60ef",
   "kr": "실은 어빈,"
  },
  "42": {
   "jp": "5c69060b7d",
   "kr": "당신에게도 아주 관계있는 일이에요."
  },
  "43": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "44": {
   "jp": "c5172602f7",
   "kr": "혹시"
  },
  "45": {
   "jp": "c76c38bce9",
   "kr": "아이멜이 가진 쿠에르포와"
  },
  "46": {
   "jp": "3d0b18066d",
   "kr": "제가 가진 카베사 일인가요?"
  },
  "47": {
   "jp": "e25e7e99cc",
   "kr": "네, 그래요."
  },
  "48": {
   "jp": "60c6f54fc9",
   "kr": "최근 몇 달 사이 일이에요."
  },
  "49": {
   "jp": "3ce46e5f1b",
   "kr": "사교도의 움직임이 눈에 띄게 되어서"
  },
  "50": {
   "jp": "d8c5b5f3d3",
   "kr": "만일을 생각해…"
  },
  "51": {
   "jp": "f4b512cfa3",
   "kr": "아이멜이 가진 쿠에르포를"
  },
  "52": {
   "jp": "ad02f85c8c",
   "kr": "결계가 강한 발크드에 전하도록"
  },
  "53": {
   "jp": "54b54592e1",
   "kr": "어제 가 달라고 했어요."
  },
  "54": {
   "jp": "d2227ef2dd",
   "kr": "정말 엇갈렸던 거네."
  },
  "55": {
   "jp": "c738215908",
   "kr": "그런데 어빈,"
  },
  "56": {
   "jp": "bc8e1bbef5",
   "kr": "당신이 여기 왔다는 건"
  },
  "57": {
   "jp": "767a617bc6",
   "kr": "레뮤라스 님이…?"
  },
  "58": {
   "jp": "30ec2de00d",
   "kr": "할아버지는 조용히 숨을 거두셨어요."
  },
  "59": {
   "jp": "ece8b00d3e",
   "kr": "그랬군요…"
  },
  "60": {
   "jp": "a0d6007f7d",
   "kr": "레뮤라스 님은 마지막까지"
  },
  "61": {
   "jp": "d45116791e",
   "kr": "당신을 키운다는 소중한 일을"
  },
  "62": {
   "jp": "2e16cfed48",
   "kr": "해내셨군요."
  },
  "63": {
   "jp": "6f212229f9",
   "kr": "그렇군요, 하늘의 부르심을 받으셨군요…"
  },
  "64": {
   "jp": "05551340ae",
   "kr": "여동생을 만나고 싶으면 그것도 좋다고."
  },
  "65": {
   "jp": "9606393e81",
   "kr": "디너켄 님을 찾아가서 있는 곳을 가르쳐 달라고."
  },
  "66": {
   "jp": "5700c0a870",
   "kr": "그래서 여기를 알게 됐어요."
  },
  "67": {
   "jp": "2c67d56917",
   "kr": "이게 디너켄 님이"
  },
  "68": {
   "jp": "28b875dec9",
   "kr": "써 주신"
  },
  "69": {
   "jp": "9b99593353",
   "kr": "(이)에요."
  },
  "70": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "71": {
   "jp": "f6bca41636",
   "kr": "을(를) 건넸다.",
   "auto": 1
  },
  "72": {
   "jp": "018ff85ab0",
   "kr": "오레시아 선생님. 여기를 알아내려고"
  },
  "73": {
   "jp": "e02f8472d8",
   "kr": "디너켄 님을 찾아갔을 때"
  },
  "74": {
   "jp": "a6253ecb06",
   "kr": "카베사를 노리는 사교도에게 습격당했어요."
  },
  "75": {
   "jp": "e54cb26a68",
   "kr": "그때는 잘 피했지만"
  },
  "76": {
   "jp": "540ab444f9",
   "kr": "그들은 이 수도원에 쿠에르포가 있다는 것도"
  },
  "77": {
   "jp": "adc5504f1a",
   "kr": "아는 듯했어요."
  },
  "78": {
   "jp": "5af3ba0c6e",
   "kr": "루티스와 바스터라는"
  },
  "79": {
   "jp": "658e7a2645",
   "kr": "젊은 아가씨와 흉포해 보이는 남자였는데"
  },
  "80": {
   "jp": "1255257d29",
   "kr": "여기를 습격한 건…?"
  },
  "81": {
   "jp": "b9bc687438",
   "kr": "…아닌 것 같아요."
  },
  "82": {
   "jp": "ad844f0e8e",
   "kr": "분명… 볼게이드라고 불리던 남자가"
  },
  "83": {
   "jp": "c61ec6d253",
   "kr": "사교도 승병을 지휘하고 있었어요."
  },
  "84": {
   "jp": "3cedba7957",
   "kr": "볼게이드…"
  },
  "85": {
   "jp": "bd3856b97d",
   "kr": "루티스 일행이 말하던 다른 남자구나."
  },
  "86": {
   "jp": "e24fef87d3",
   "kr": "디너켄 님께서 오레시아 선생님을 만나"
  },
  "87": {
   "jp": "1a4e948e09",
   "kr": "카베사를 어떻게 할지"
  },
  "88": {
   "jp": "729b2b68ee",
   "kr": "여쭤보라고 하셨는데…"
  },
  "89": {
   "jp": "f627e0a882",
   "kr": "사교도가 이렇게 움직이기 시작했으니"
  },
  "90": {
   "jp": "a0d66ac80c",
   "kr": "카베사도 발크드에 전하는 편이"
  },
  "91": {
   "jp": "e64d2622ba",
   "kr": "좋을 것 같아요."
  },
  "92": {
   "jp": "de574e7107",
   "kr": "오레시아 선생님의 의견을 들려주세요."
  },
  "93": {
   "jp": "58c2fb935f",
   "kr": "그렇군요. 그게 좋겠어요."
  },
  "94": {
   "jp": "298f5c28d9",
   "kr": "아이멜도 걱정이에요."
  },
  "95": {
   "jp": "bf976b1320",
   "kr": "그 아이 걸음이라면 지금부터 당신들이 쫓으면"
  },
  "96": {
   "jp": "9f157db6ff",
   "kr": "따라잡을 수 있을 거예요."
  },
  "97": {
   "jp": "8efc59b10d",
   "kr": "분명 도중에 아이멜을 만날 수 있을 거예요."
  },
  "98": {
   "jp": "1b51730a7e",
   "kr": "우선 바로아로 가서 거기서 배를 타세요."
  },
  "99": {
   "jp": "34f4342ab1",
   "kr": "아이멜과 합류해서"
  },
  "100": {
   "jp": "8e4093ebc4",
   "kr": "카베사와 쿠에르포를 발크드까지"
  },
  "101": {
   "jp": "04a7775e56",
   "kr": "무사히 전해 주세요."
  },
  "102": {
   "jp": "4e81280a10",
   "kr": "좋아, 가자, 마일."
  },
  "103": {
   "jp": "784386239c",
   "kr": "응, 그러자."
  },
  "104": {
   "jp": "09888d8da9",
   "kr": "그럼 오레시아 선생님,"
  },
  "105": {
   "jp": "d1573bdca6",
   "kr": "바로 떠날게요."
  },
  "106": {
   "jp": "47528a79f0",
   "kr": "부디 조심하세요."
  },
  "107": {
   "jp": "4e9a26682b",
   "kr": "어빈…",
   "auto": 1
  },
  "108": {
   "jp": "41e0f6d2d8",
   "kr": "…오레시아 선생님."
  },
  "109": {
   "jp": "e7b0b6f280",
   "kr": "어빈은 지금까지의 일을 오레시아에게 설명했다."
  },
  "110": {
   "jp": "2ae4e3ccc7",
   "kr": "오레시아는 이야기가 끝날 때까지"
  },
  "111": {
   "jp": "4863836937",
   "kr": "작게 고개를 끄덕이며 조용히 들었다."
  },
  "112": {
   "jp": "473d175d8e",
   "kr": "그랬군요…"
  },
  "113": {
   "jp": "b60f7ddc61",
   "kr": "아이멜도, 마일 씨까지…"
  },
  "114": {
   "jp": "1d9f0cdc66",
   "kr": "저와 아이멜이 가지고 있던 카베사와 쿠에르포."
  },
  "115": {
   "jp": "0126954df6",
   "kr": "그리고 나머지 네 개의 신보를 손에 넣어"
  },
  "116": {
   "jp": "11b914aa2f",
   "kr": "모든 신보를 모아야 한다고 최고 도사님께"
  },
  "117": {
   "jp": "36530cff8f",
   "kr": "들었는데요."
  },
  "118": {
   "jp": "6308b45603",
   "kr": "신보 여섯 개가 모이면 무슨 일이 일어나나요?"
  },
  "119": {
   "jp": "37d63665a5",
   "kr": "글쎄요…"
  },
  "120": {
   "jp": "37666cf102",
   "kr": "그건 저도 알 수 없어요."
  },
  "121": {
   "jp": "096e775870",
   "kr": "다만 신보는 사신 오크툼에게 부서진"
  },
  "122": {
   "jp": "f09311bdae",
   "kr": "시간의 신 발두스의 신령이라고 해요."
  },
  "123": {
   "jp": "5396a116df",
   "kr": "세계에 흩어진 신령이 한곳에 모이면"
  },
  "124": {
   "jp": "b1e4a6c9a0",
   "kr": "신의 기적을 기대할 수 있을지도 몰라요."
  },
  "125": {
   "jp": "a083964714",
   "kr": "신의 기적…"
  },
  "126": {
   "jp": "16434e8d7c",
   "kr": "그게 아무리 대단한 일을 일으키는 힘이라 해도"
  },
  "127": {
   "jp": "d645b24d9e",
   "kr": "저에게는 아이멜이나 마일이"
  },
  "128": {
   "jp": "9726d714f1",
   "kr": "살아 있는 쪽이 훨씬 멋진 일이에요."
  },
  "129": {
   "jp": "4102a1ff06",
   "kr": "설령 시시한 세상이라도"
  },
  "130": {
   "jp": "f57e80864a",
   "kr": "소중한 사람들이 살아 있는 편이 좋아요."
  },
  "131": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "132": {
   "jp": "af8091cb15",
   "kr": "그런 생각은 틀렸나요?"
  },
  "133": {
   "jp": "083d458a2f",
   "kr": "아니요… 당신 말이 맞아요."
  },
  "134": {
   "jp": "6be9cf5b39",
   "kr": "이 세상에 사람의 목숨보다 귀한 것은 없어요."
  },
  "135": {
   "jp": "12ade8bf69",
   "kr": "하지만 세상을 떠난 이들이 바라던 것을"
  },
  "136": {
   "jp": "2a23110b4f",
   "kr": "실현하는 것도"
  },
  "137": {
   "jp": "4a5b8391ba",
   "kr": "살아 있는 이들의 사명이에요."
  },
  "138": {
   "jp": "5c91fd2588",
   "kr": "어빈, 귀를 기울이세요."
  },
  "139": {
   "jp": "5d89f98cf9",
   "kr": "누구의 속셈도 아닌"
  },
  "140": {
   "jp": "65a485d277",
   "kr": "진실의 목소리가 마음에 닿을 때까지."
  },
  "141": {
   "jp": "b7b4f2331c",
   "kr": "당신이라면 들릴 거예요."
  },
  "142": {
   "jp": "2f055da658",
   "kr": "잘 찾아와 주었군요."
  },
  "143": {
   "jp": "5e19280085",
   "kr": "어빈.",
   "auto": 1
  },
  "144": {
   "jp": "c5827f032d",
   "kr": "당신과 아이멜을 카테드랄에서"
  },
  "145": {
   "jp": "4837800faf",
   "kr": "데리고 나왔을 때."
  },
  "146": {
   "jp": "2c042f12f1",
   "kr": "설마"
  },
  "147": {
   "jp": "cdf15b532d",
   "kr": "이런 사태에까지 이를 줄은"
  },
  "148": {
   "jp": "b899f429c0",
   "kr": "생각도 못 했어요."
  },
  "149": {
   "jp": "089c4d805c",
   "kr": "오크툼 신을 숭배하는 자들이"
  },
  "150": {
   "jp": "f18a5a8885",
   "kr": "봉인의 땅에 침입한 모양이군요."
  },
  "151": {
   "jp": "ca801f4930",
