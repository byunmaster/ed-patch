{
 "archive": "/D/SC300.DAT",
 "member": "..\\BIN\\DT00000L.BIN",
 "segments": {
  "0": {
   "jp": "fa1ef1429b",
   "kr": "무슨 일이냐?"
  },
  "1": {
   "jp": "8304bf9a89",
   "kr": "모험가 정보",
   "auto": 1
  },
  "2": {
   "jp": "a29585b603",
   "kr": "비밀 정보",
   "auto": 1
  },
  "3": {
   "jp": "31d00957d7",
   "kr": "그럼 이만."
  },
  "4": {
   "jp": "5a27646d5e",
   "kr": "그래, １０로제만 주면 좋은 정보가 있지.",
   "auto": 1
  },
  "5": {
   "jp": "3ab1200b57",
   "kr": "들어 볼래?",
   "auto": 1
  },
  "6": {
   "jp": "bd7393be13",
   "kr": "아니타의 아버지는"
  },
  "7": {
   "jp": "10eb5dfd4f",
   "kr": "직함에 집착하는 양반이야."
  },
  "8": {
   "jp": "acf16964a2",
   "kr": "지금 진행 중인 혼담 상대도 귀족이거든."
  },
  "9": {
   "jp": "646c2d22dd",
   "kr": "그 아버지를 납득시키려면"
  },
  "10": {
   "jp": "5ea6d18c89",
   "kr": "그만한 신분의 동료를 데려가야"
  },
  "11": {
   "jp": "1cf7d3271f",
   "kr": "할걸."
  },
  "12": {
   "jp": "a5f4272f75",
   "kr": "저는 일단 귀족입니다만."
  },
  "13": {
   "jp": "7bcba35e12",
   "kr": "콘로드가 있다면 걱정할 것 없겠군."
  },
  "14": {
   "jp": "585320210c",
   "kr": "정보료는 돌려주지."
  },
  "15": {
   "jp": "5f8ee3bb32",
   "kr": "미안하지만 이쪽도 장사라서.",
   "auto": 1
  },
  "16": {
   "jp": "3b853b94c4",
   "kr": "로제가 없는 녀석은 다음에 다시 와.",
   "auto": 1
  },
  "17": {
   "jp": "d274af4dfe",
   "kr": "자신 있다면 네 힘으로 어떻게든 해 봐."
  },
  "18": {
   "jp": "587c1cd11a",
   "kr": "『약초 찾기』를 맡았나."
  },
  "19": {
   "jp": "804b441b15",
   "kr": "그렇다면 솔깃한 정보가 있어."
  },
  "20": {
   "jp": "17c1bf2ae1",
   "kr": "１００로제 내면 알려 주지."
  },
  "21": {
   "jp": "0f0a84da23",
   "kr": "이건 어디까지나 소문이지만."
  },
  "22": {
   "jp": "ef0a9bae16",
   "kr": "약초는 쿠크일 동굴에 있다더군."
  },
  "23": {
   "jp": "406790f640",
   "kr": "그런데 어떤 멍청이가"
  },
  "24": {
   "jp": "cacd4b8760",
   "kr": "동굴 앞 흔들다리를"
  },
  "25": {
   "jp": "5ffb88b7f7",
   "kr": "떨어뜨려 버렸어."
  },
  "26": {
   "jp": "5ab5bb4987",
   "kr": "그걸 어떻게든 하지 않으면"
  },
  "27": {
   "jp": "9d857c5a6d",
   "kr": "안에 못 들어갈걸."
  },
  "28": {
   "jp": "7498116eb3",
   "kr": "이봐, 돈이 모자라잖아."
  },
  "29": {
   "jp": "b605e53c90",
   "kr": "코 묻은 돈이랑 같이 취급하지 마."
  },
  "30": {
   "jp": "5f0176be9b",
   "kr": "『의사 구출』을 맡았나."
  },
  "31": {
   "jp": "f205846f24",
   "kr": "바딘 동굴에는 협객 오징어니 회혈 박쥐니"
  },
  "32": {
   "jp": "3cf0d8d547",
   "kr": "흉악한 마수가 우글우글하거든."
  },
  "33": {
   "jp": "7be967a996",
   "kr": "반들이라는 선생이 꽤 솜씨가 좋다던데"
  },
  "34": {
   "jp": "f04722fc0d",
   "kr": "그 오징어들을 상대하기엔 어떨지 모르겠군."
  },
  "35": {
   "jp": "87b552c22e",
   "kr": "아무튼 서두르는 게 좋아."
  },
  "36": {
   "jp": "193c5b2402",
   "kr": "작가 선생을 찾고 있다면"
  },
  "37": {
   "jp": "ca3750829d",
   "kr": "좋은 걸 알려 주지."
  },
  "38": {
   "jp": "f1fa93ab74",
   "kr": "２５로제 어때?"
  },
  "39": {
   "jp": "bf93544355",
   "kr": "카라무스 선생은 먹고살기 힘들던 시절"
  },
  "40": {
   "jp": "151a1cad01",
   "kr": "술집이며 식당에서 아르바이트하며"
  },
  "41": {
   "jp": "8c7e7da37b",
   "kr": "작품을 썼다더군."
  },
  "42": {
   "jp": "9176929118",
   "kr": "그때 여러 손님의 이야기에서 힌트를 얻어"
  },
  "43": {
   "jp": "e609f31a1a",
   "kr": "재미있는 이야기를 쓸 수 있었다나."
  },
  "44": {
   "jp": "1283c86a6f",
   "kr": "소재가 떨어지면"
  },
  "45": {
   "jp": "704a8ff500",
   "kr": "초심으로 돌아가는 게 작가라는 족속 아니겠어?"
  },
  "46": {
   "jp": "937da1bdc4",
   "kr": "분명 처음 아르바이트한 곳이"
  },
  "47": {
   "jp": "8b9105aaa1",
   "kr": "보른의 여관 술집이라고 들었어."
  },
  "48": {
   "jp": "b6a00083e3",
   "kr": "돈이 모자란 모양이군."
  },
  "49": {
   "jp": "32b2b43584",
   "kr": "미안하지만 다시 와."
  },
  "50": {
   "jp": "193c5b2402",
   "kr": "작가 선생을 찾고 있다면"
  },
  "51": {
   "jp": "ca3750829d",
   "kr": "좋은 걸 알려 주지."
  },
  "52": {
   "jp": "f1fa93ab74",
   "kr": "２５로제 어때?"
  },
  "53": {
   "jp": "d507536f6f",
   "kr": "별로 확실한 정보는 아닌데."
  },
  "54": {
   "jp": "df6b948ced",
   "kr": "세타에 유난히 쾌활한 영감 바텐더가 있다더군."
  },
  "55": {
   "jp": "d05e1da318",
   "kr": "그 영감, 카라무스 선생을 닮았다는 소문이야."
  },
  "56": {
   "jp": "b6a00083e3",
   "kr": "돈이 모자란 모양이군."
  },
  "57": {
   "jp": "32b2b43584",
   "kr": "미안하지만 다시 와."
  },
  "58": {
   "jp": "ae1dfcbded",
   "kr": "작가 선생이 또 없어졌지?"
  },
  "59": {
   "jp": "a47bd4fcb5",
   "kr": "좋은 걸 알려 줄 테니 ５０로제 내지 않겠어?"
  },
  "60": {
   "jp": "831b0814dd",
   "kr": "카라무스 선생은 발크드에 있어."
  },
  "61": {
   "jp": "d00bfcdcbe",
   "kr": "우리 정보꾼들의 네트워크로 흘러들어온 소식이니까"
  },
  "62": {
   "jp": "6588d60bcc",
   "kr": "틀림없어."
  },
  "63": {
   "jp": "89bb7a048e",
   "kr": "발크드에서 헤매면 내 친구한테 물어봐."
  },
  "64": {
   "jp": "0e4f4aad97",
   "kr": "정보료는 넉넉히 쳐 줘야 해."
  },
  "65": {
   "jp": "b6a00083e3",
   "kr": "돈이 모자란 모양이군."
  },
  "66": {
   "jp": "32b2b43584",
   "kr": "미안하지만 다시 와."
  },
  "67": {
   "jp": "beca8ce922",
   "kr": "카라무스 선생이 또 제멋대로 구는 거지?"
  },
  "68": {
   "jp": "2ee0738440",
   "kr": "특별히 １００로제에 좋은 걸 알려 줄까?"
  },
  "69": {
   "jp": "f94b1691b6",
   "kr": "카라무스 선생의 소재가 될 만한 이야기라면"
  },
  "70": {
   "jp": "c4aad6e830",
   "kr": "화려한 모험담이 좋겠지."
  },
  "71": {
   "jp": "3f9e14b00f",
   "kr": "소문으로는 샴실단 놈들이"
  },
  "72": {
   "jp": "215063cf87",
   "kr": "마수를 부리는 아이템을 연구한다더군."
  },
  "73": {
   "jp": "1063decb52",
   "kr": "아무튼 알선소를 알아봐."
  },
  "74": {
   "jp": "b6a00083e3",
   "kr": "돈이 모자란 모양이군."
  },
  "75": {
   "jp": "32b2b43584",
   "kr": "미안하지만 다시 와."
  },
  "76": {
   "jp": "3034c21ba3",
   "kr": "지금으로선 별 정보가 없어."
  },
  "77": {
   "jp": "53dbcf3efb",
   "kr": "짐을 어디로 가져갈지 모르겠으면"
  },
  "78": {
   "jp": "5b31d28b57",
   "kr": "구멍이 나도록 짐을 살펴봐.",
   "auto": 1
  },
  "79": {
   "jp": "2a5d6f42d6",
   "kr": "누구에게 전해야 하는지 생각날 테니까.",
   "auto": 1
  },
  "80": {
   "jp": "5a27646d5e",
   "kr": "그래, １０로제만 주면 좋은 정보가 있지.",
   "auto": 1
  },
  "81": {
   "jp": "fbcc966c41",
   "kr": "들을 마음 있어?"
  },
  "82": {
   "jp": "b32e74cf87",
   "kr": "비샤나 동굴 입구는 절벽 건너편에 있어."
  },
  "83": {
   "jp": "cfe9fc8a9a",
   "kr": "공교롭게 다리가 부서져서"
  },
  "84": {
   "jp": "e7ab8e0c0d",
   "kr": "걸어서 건너기는 도저히 무리야."
  },
  "85": {
   "jp": "cadcafd983",
   "kr": "텔레포트를 쓸 수 있는 동료가 없으면"
  },
  "86": {
   "jp": "b37f3c5f81",
   "kr": "동굴 안에 들어가지도 못할걸."
  },
  "87": {
   "jp": "63b5736271",
   "kr": "아저씨, 아저씨."
  },
  "88": {
   "jp": "178db7a034",
   "kr": "텔레포트라면 내 특기라고."
  },
  "89": {
   "jp": "539306a06a",
   "kr": "미래의 대마법사에게 불가능은 없지!"
  },
  "90": {
   "jp": "ad6fff9db1",
   "kr": "아차, 실례했군.",
   "auto": 1
  },
  "91": {
   "jp": "faeea1a4b7",
   "kr": "그럼 정보료를 받을 수는 없겠어.",
   "auto": 1
  },
  "92": {
   "jp": "5f8ee3bb32",
   "kr": "미안하지만 이쪽도 장사라서.",
   "auto": 1
  },
  "93": {
   "jp": "3b853b94c4",
   "kr": "로제가 없는 녀석은 다음에 다시 와.",
   "auto": 1
  },
  "94": {
   "jp": "b897779e96",
   "kr": "정보료를 아끼다가"
  },
  "95": {
   "jp": "199a0b47a8",
   "kr": "후회하지 않으면 좋겠군."
  },
  "96": {
   "jp": "2d19631e7d",
   "kr": "지금은 별다른 정보가 없어.",
   "auto": 1
  },
  "97": {
   "jp": "9f13840241",
   "kr": "그보다 너야말로 뭔가 알려 줄 거 없어?"
  },
  "98": {
   "jp": "86e98cc57c",
   "kr": "정보료를 아끼다 실패하는 놈이 많아."
  },
  "99": {
   "jp": "6ed801faaa",
   "kr": "너도 조심하라고."
  },
  "100": {
   "jp": "226c91f06d",
   "kr": "세타에"
  },
  "101": {
   "jp": "783ee57c10",
   "kr": "유난히 쾌활한 영감 바텐더가 있다더군."
  },
  "102": {
   "jp": "37d41507ba",
   "kr": "우리 정보꾼들의 네트워크로"
  },
  "103": {
   "jp": "bd58bb6dee",
   "kr": "흘러들어온 소식이니까"
  }
 }
}
