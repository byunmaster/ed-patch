{
 "archive": "/C/SC204.DAT",
 "member": "..\\BIN\\CT03000B.BIN",
 "segments": {
  "0": {
   "jp": "aed58c1d3e",
   "kr": "그럼 이런 이야기는 어떨까요."
  },
  "1": {
   "jp": "7aaedbb118",
   "kr": "여행 중에 들은 이야기인데"
  },
  "2": {
   "jp": "d732f3865c",
   "kr": "마음에 남는 이야기라고 생각해요."
  },
  "3": {
   "jp": "c19cefec5f",
   "kr": "호오, 어떤 이야기인가?"
  },
  "4": {
   "jp": "d679fae91c",
   "kr": "옛날에 한 나그네가 인적이 드문 길에서"
  },
  "5": {
   "jp": "ff9ed789c6",
   "kr": "배고파 금방이라도 쓰러질 듯한 들개를"
  },
  "6": {
   "jp": "8cd4d8599a",
   "kr": "만났대요."
  },
  "7": {
   "jp": "da01236fa6",
   "kr": "나그네는 들개를 내버려 둘 수 없어서"
  },
  "8": {
   "jp": "cffca08b66",
   "kr": "자기가 가진 마지막 빵과 우유를"
  },
  "9": {
   "jp": "7ecae1416a",
   "kr": "들개에게 주었어요."
  },
  "10": {
   "jp": "9b459a9268",
   "kr": "들개가 맛있게 먹는 사이에"
  },
  "11": {
   "jp": "d93ef766b9",
   "kr": "나그네는 그 자리를 살며시 떠났고"
  },
  "12": {
   "jp": "ae7567026d",
   "kr": "그걸로 나그네와 들개는 헤어졌지요."
  },
  "13": {
   "jp": "b3e41bcdc1",
   "kr": "하지만 들개는"
  },
  "14": {
   "jp": "d96003c3aa",
   "kr": "나그네에 대한 고마움을"
  },
  "15": {
   "jp": "ed92ebfb6a",
   "kr": "결코 잊지 않았답니다."
  },
  "16": {
   "jp": "b900ac8989",
   "kr": "몇 달이 지나 나그네가 눈보라 치는 고개에서"
  },
  "17": {
   "jp": "4cf29cb482",
   "kr": "길을 잃었을 때의 일이에요."
  },
  "18": {
   "jp": "498835356f",
   "kr": "바람 소리 속에서 개 짖는 소리가 들렸어요."
  },
  "19": {
   "jp": "2bf2d19896",
   "kr": "개는 몇 번이고 계속 짖고 있었어요."
  },
  "20": {
   "jp": "872b7c540c",
   "kr": "나그네는 그 소리에 의지해 나아가"
  },
  "21": {
   "jp": "741580168a",
   "kr": "가도로 돌아올 수 있었어요."
  },
  "22": {
   "jp": "8386b87cad",
   "kr": "주변 모습이 보이게 되고 나서"
  },
  "23": {
   "jp": "65c42e0efb",
   "kr": "나그네는 쓰러져 있는 개를 발견했어요."
  },
  "24": {
   "jp": "dd622d6ed0",
   "kr": "그때의 들개였어요."
  },
  "25": {
   "jp": "59085e4235",
   "kr": "들개는 나그네가 안전한 곳에 올 때까지"
  },
  "26": {
   "jp": "486e9b00e5",
   "kr": "자기 힘이 다하는 것도 돌보지 않고"
  },
  "27": {
   "jp": "1c58614261",
   "kr": "나그네를 구하려고 계속 짖고 있었던 거예요."
  },
  "28": {
   "jp": "5378561597",
   "kr": "사람도 동물도 아주 조금이라도"
  },
  "29": {
   "jp": "137c550724",
   "kr": "마음을 나눌 수 있으면"
  },
  "30": {
   "jp": "7d1843a933",
   "kr": "확실한 인연으로 이어지는 거군요."
  },
  "31": {
   "jp": "65778998bc",
   "kr": "이 이야기를 처음 들었을 때"
  },
  "32": {
   "jp": "693480a746",
   "kr": "저는 그걸 강하게 느꼈어요."
  },
  "33": {
   "jp": "83498dc753",
   "kr": "훌쩍… 그렇구먼."
  },
  "34": {
   "jp": "9240d32e34",
   "kr": "이 고개는 지금 『개 짖는 고개』라고"
  },
  "35": {
   "jp": "cabd591f7c",
   "kr": "불린다고 해요."
  },
  "36": {
   "jp": "f2f6c9f075",
   "kr": "좋은 이야기를 들었네."
  },
  "37": {
   "jp": "a762f2611c",
   "kr": "보너스로 100로제를 주지."
  },
  "38": {
   "jp": "c2c72d5d9c",
   "kr": "아니, 눈물이 났네, 났어."
  },
  "39": {
   "jp": "8f9412b7be",
   "kr": "알쳄은 100로제를 받았다."
  },
  "40": {
   "jp": "1fa2161c84",
   "kr": "또 말동무가 되어 주러 오게나."
  },
  "41": {
   "jp": "03dbf01df9",
   "kr": "단, 새 이야기를 구해서 말일세."
  },
  "42": {
   "jp": "6828ee5cd6",
   "kr": "내가 이야기할게."
  },
  "43": {
   "jp": "b27bcc49e3",
   "kr": "라엘이…?"
  },
  "44": {
   "jp": "7817a997b0",
   "kr": "괜찮겠어?"
  },
  "45": {
   "jp": "081419d2e5",
   "kr": "뭐, 맡겨 두라고."
  },
  "46": {
   "jp": "729ddc69e7",
   "kr": "사람을 지루하게 하지 않는 게"
  },
  "47": {
   "jp": "6c6d6449fe",
   "kr": "내 장점이니까."
  },
  "48": {
   "jp": "21ba47c3b4",
   "kr": "재미난 이야기 열이나 스물쯤은"
  },
  "49": {
   "jp": "4070beb897",
   "kr": "줄줄이 나온다고."
  },
  "50": {
   "jp": "b1e15f34cb",
   "kr": "음, 그러니까."
  },
  "51": {
   "jp": "b6966ec91c",
   "kr": "학교에서 있었던"
  },
  "52": {
   "jp": "553c24cf13",
   "kr": "진짜 재미있는 이야기는 어때?"
  },
  "53": {
   "jp": "ef09c03b52",
   "kr": "호오…"
  },
  "54": {
   "jp": "a2776a66c6",
   "kr": "어느 날 오후였어."
  },
  "55": {
   "jp": "4e23490570",
   "kr": "난 수업을 땡땡이치고"
  },
  "56": {
   "jp": "ce9ba5c02d",
   "kr": "중정에서 자고 있었지."
  },
  "57": {
   "jp": "66306724ca",
   "kr": "그러자 관리인실 창문이 열리고"
  },
  "58": {
   "jp": "65e9973dea",
   "kr": "관리인 아저씨가"
  },
  "59": {
   "jp": "ed25c0a8b9",
   "kr": "날 부르는 거야."
  },
  "60": {
   "jp": "bce234487f",
   "kr": "라엘… 라엘… 하고."
  },
  "61": {
   "jp": "ed7a9b48f3",
   "kr": "아주 힘없는 목소리로 말이야."
  },
  "62": {
   "jp": "9f304b9a28",
   "kr": "난 무슨 일인가 싶어서"
  },
  "63": {
   "jp": "4b8086cc48",
   "kr": "허둥지둥 관리인실로 갔지."
  },
  "64": {
   "jp": "afbcde76ac",
   "kr": "그랬더니 글쎄…"
  },
  "65": {
   "jp": "65e9973dea",
   "kr": "관리인 아저씨가"
  },
  "66": {
   "jp": "36d3dc7049",
   "kr": "점심을 너무 많이 먹어서"
  },
  "67": {
   "jp": "d8679f4c95",
   "kr": "괴로운 듯이 끙끙대고 있는 거야."
  },
  "68": {
   "jp": "f0d353274a",
   "kr": "어쩔 수 없으니까"
  },
  "69": {
   "jp": "f520979645",
   "kr": "내가 차를 끓여 주고 아저씨"
  },
  "70": {
   "jp": "ae9a1d2559",
   "kr": "등을 쓸어 줬어."
  },
  "71": {
   "jp": "ff895182ee",
   "kr": "어때, 재미있지?"
  },
  "72": {
   "jp": "d03c0013da",
   "kr": "어디가 말인가."
  },
  "73": {
   "jp": "d7869f74ff",
   "kr": "재미없어?"
  },
  "74": {
   "jp": "a6b545b9d5",
   "kr": "조금도."
  },
  "75": {
   "jp": "114123194e",
   "kr": "그보다"
  },
  "76": {
   "jp": "9ec080b49d",
   "kr": "마법학교에서 더 즐거운 추억은"
  },
  "77": {
   "jp": "8f19b3d059",
   "kr": "없었나?"
  },
  "78": {
   "jp": "4829ff4489",
   "kr": "즐거운 추억…?"
  },
  "79": {
   "jp": "06c3f682ef",
   "kr": "글쎄."
  },
  "80": {
   "jp": "306513577a",
   "kr": "그치만 난…"
  },
  "81": {
   "jp": "85fcee2aba",
   "kr": "중간에 학교를 뛰쳐나와 버렸으니까."
  },
  "82": {
   "jp": "c0e9f59d1c",
   "kr": "있지 않은가?"
  },
  "83": {
   "jp": "db9144de52",
   "kr": "화단에 서서 오줌을 눈다든가."
  },
  "84": {
   "jp": "ce0b3a606d",
   "kr": "앗, 했어, 했어."
  },
  "85": {
   "jp": "16d09c6ac5",
   "kr": "여자애 치마를 들춘다든가."
  },
  "86": {
   "jp": "ab182b5f59",
   "kr": "했어. 했어."
  },
  "87": {
   "jp": "319cddc40f",
   "kr": "교장 동상에 낙서를 한다든가."
  },
  "88": {
   "jp": "e181d8ca80",
   "kr": "응. 했어, 했어."
  },
  "89": {
   "jp": "8441f998cf",
   "kr": "………?!"
  },
  "90": {
   "jp": "21e4136dfe",
   "kr": "……어라."
  },
  "91": {
   "jp": "b9f553a689",
   "kr": "어떻게… 알아?"
  },
  "92": {
   "jp": "6b7abb2db2",
   "kr": "기억 안 나나, 라엘."
  },
  "93": {
   "jp": "139c14e7f0",
   "kr": "으, 으엑…!!"
  },
  "94": {
   "jp": "835f8a83cb",
   "kr": "내가 전 마법대학교 교장."
  },
  "95": {
   "jp": "5f18e62bda",
   "kr": "도리아 교수이시다."
  },
  "96": {
   "jp": "ae1f48cac4",
   "kr": "와하하하하하…"
  },
  "97": {
   "jp": "075ac851b3",
   "kr": "유쾌, 유쾌."
  },
  "98": {
   "jp": "271aeadc0f",
   "kr": "아아, 재미있었다."
  },
  "99": {
   "jp": "a3b8af3bdb",
   "kr": "그때 동상 청소비를 빼면"
  },
  "100": {
   "jp": "63047fe7c4",
   "kr": "보너스는 30로제쯤이겠군."
  },
  "101": {
   "jp": "d69da7dc66",
   "kr": "이런 게 어딨어."
  },
  "102": {
   "jp": "e5dabc5c53",
   "kr": "참으로 유쾌, 유쾌."
  },
  "103": {
   "jp": "c950c516b7",
   "kr": "라엘은 30로제를 받았다."
  },
  "104": {
   "jp": "1fa2161c84",
   "kr": "또 말동무가 되어 주러 오게나."
  },
  "105": {
   "jp": "03dbf01df9",
   "kr": "단, 새 이야기를 구해서 말일세."
  },
  "106": {
   "jp": "3e7e1147bc",
   "kr": "내가 이야기하지."
  },
  "107": {
   "jp": "3a9555e7a7",
   "kr": "호오, 기대되는군."
  },
  "108": {
   "jp": "8db1792c07",
   "kr": "예전에 인적 드문 길에서"
  },
  "109": {
   "jp": "283d72f7ff",
   "kr": "요괴를 만났을 때의 이야기다."
  },
  "110": {
   "jp": "a14515d844",
   "kr": "재미있겠군."
  },
  "111": {
   "jp": "ed8a926da4",
   "kr": "너무 기대하면 곤란하지만"
  },
  "112": {
   "jp": "15e1dea342",
   "kr": "시시한 이야기는 아닐 거다."
  },
  "113": {
   "jp": "b5ebe6d7a7",
   "kr": "그 요괴는 근처 마을에서는"
  },
  "114": {
   "jp": "20f83a5f99",
   "kr": "꽤 장난꾸러기로 통했다."
  },
  "115": {
   "jp": "248878dd63",
   "kr": "자주 그 길에 나타나 사람을 놀라게 하고"
  },
  "116": {
   "jp": "4b537fa35e",
   "kr": "사람이 겁먹는 걸 보며 즐거워했지."
  },
  "117": {
   "jp": "e0d034647d",
   "kr": "그렇다고 그 이상 못된 짓을 하지도 않아서"
  },
  "118": {
   "jp": "0d4b2a2dea",
   "kr": "피해라 부를 만한 피해는 없었다."
  },
  "119": {
   "jp": "58b2b25919",
   "kr": "마침 내가 그 길을 지나가던 때"
  },
  "120": {
   "jp": "8037c5bcec",
   "kr": "소문대로"
  },
  "121": {
   "jp": "0c96039056",
   "kr": "요괴가 날 놀라게 하려고 나타났다."
  },
  "122": {
   "jp": "18de726f4c",
   "kr": "커다란 마수로 둔갑해서 말이야."
  },
  "123": {
   "jp": "fa82ebb143",
   "kr": "그, 그래서?"
  },
  "124": {
   "jp": "677b3add11",
   "kr": "공격해 올 경우를 대비해서"
  },
  "125": {
   "jp": "6b05d8f513",
   "kr": "일단 자세를 잡아 봤지만"
  },
  "126": {
   "jp": "2e54a613d8",
   "kr": "역시 덮쳐 올 기색은 없었다."
  },
  "127": {
   "jp": "4ccd73c47a",
   "kr": "나는 검을 칼집에 넣고"
  },
  "128": {
   "jp": "f572821dcd",
   "kr": "무시하고 지나가기로 했다."
  },
  "129": {
   "jp": "625e5c415c",
   "kr": "그랬더니 요괴는 대항 의식이 불탔는지"
  },
  "130": {
   "jp": "dbcf45632f",
   "kr": "차례차례 흉포해 보이는 마수로 변해서"
  },
  "131": {
   "jp": "c850410b28",
   "kr": "달라붙듯이 뒤를 따라왔다."
  },
  "132": {
   "jp": "1b2e9b4593",
   "kr": "외눈박이 거인, 거대한 용…"
  },
  "133": {
   "jp": "fa58f7cd91",
   "kr": "굉장한 마수의 퍼레이드였지."
  },
  "134": {
   "jp": "0ec7ceab2f",
   "kr": "다음엔 뭐로 둔갑해서 나올지"
  },
  "135": {
   "jp": "4eb6884006",
   "kr": "기대될 정도였다."
  },
  "136": {
   "jp": "7f6d2b1788",
   "kr": "한동안 나는"
  },
  "137": {
   "jp": "4e77d108e3",
   "kr": "그런 요괴를 데리고"
  },
  "138": {
   "jp": "55ab32c0fc",
   "kr": "함께 걸었다."
  },
  "139": {
   "jp": "99cb528e08",
   "kr": "그런데…"
  },
  "140": {
   "jp": "8c408ef2cd",
   "kr": "그, 그런데?"
  },
  "141": {
   "jp": "ded6bddd2a",
   "kr": "한참 가자"
  },
  "142": {
   "jp": "7cbc7e9734",
   "kr": "길가에 다친 들토끼가"
  },
  "143": {
   "jp": "f4f3c5a8a6",
   "kr": "웅크리고 있더군."
  },
  "144": {
   "jp": "51375d9a26",
   "kr": "요괴는 나에게 달라붙기를 그만두고"
  },
  "145": {
   "jp": "63bc8ee32c",
   "kr": "아기 너구리 같은 귀여운 진짜 모습을 보이며"
  },
  "146": {
   "jp": "b5ad59bb46",
   "kr": "들토끼에게 다가갔다."
  },
  "147": {
   "jp": "6df8ad74cd",
   "kr": "나와 요괴는 서로 고개를 끄덕이고"
  },
  "148": {
   "jp": "b7ba08319e",
   "kr": "둘이서 들토끼를 치료해 주기로 했다."
  },
  "149": {
   "jp": "1614a280e1",
   "kr": "요괴의 신기한 힘으로"
  },
  "150": {
   "jp": "d38fac9239",
   "kr": "들토끼의 상처는 금세 나았다."
  },
  "151": {
   "jp": "2c3ec98384",
   "kr": "장난꾸러기지만"
  },
  "152": {
   "jp": "2d35320936",
   "kr": "상냥한 요괴였구먼."
  },
  "153": {
   "jp": "e3511831f0",
   "kr": "그렇지."
  },
  "154": {
   "jp": "8e4232e865",
   "kr": "사람이 이상한 참견만"
  },
  "155": {
