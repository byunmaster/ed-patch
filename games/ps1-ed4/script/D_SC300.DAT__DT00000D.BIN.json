 "segments": {
  "0": {
   "jp": "32c009387b",
   "kr": "포포스와 브라코스 일로 와 주었나?"
  },
  "1": {
   "jp": "5542b2800b",
   "kr": "허허, 수고를 끼쳐 미안하네."
  },
  "2": {
   "jp": "cc105a5944",
   "kr": "정말이지, 그 촐랑이들은…"
  },
  "3": {
   "jp": "5ab0f46f04",
   "kr": "호신술을 조금 배웠다고"
  },
  "4": {
   "jp": "ab86fa636c",
   "kr": "자기들이 강해진 줄 착각하더니만."
  },
  "5": {
   "jp": "350e9fd2e3",
   "kr": "하필이면"
  },
  "6": {
   "jp": "0d6229fd81",
   "kr": "벨우드의 갑각 스퀼라를 퇴치하러 나갔다네."
  },
  "7": {
   "jp": "c7a9da729c",
   "kr": "갑각 스퀼라는 바로아 근방에 사는 마수 중에서도"
  },
  "8": {
   "jp": "1236819031",
   "kr": "꽤 사납다고들 하네."
  },
  "9": {
   "jp": "eeeb52aa26",
   "kr": "지금까지 겁 없는 이들이 퇴치를 시도했지만"
  },
  "10": {
   "jp": "8b99d4ee70",
   "kr": "아무도 성공하지 못했다네."
  },
  "11": {
   "jp": "c4b82cfe26",
   "kr": "수고스럽지만"
  },
  "12": {
   "jp": "11142648ec",
   "kr": "포포스와 브라코스를 찾아내어"
  },
  "13": {
   "jp": "113f583620",
   "kr": "데려와 주지 않겠나?"
  },
  "14": {
   "jp": "cb15afb249",
   "kr": "벨우드는 다리를 건넌 뒤 가도에서 왼쪽으로 빠진 곳일세."
  },
  "15": {
   "jp": "5f0b2c943c",
   "kr": "부디 포포스와 브라코스를 데려와 주게."
  },
  "16": {
   "jp": "0a0116000b",
   "kr": "걱정이야…"
  },
  "17": {
   "jp": "2480aeb393",
   "kr": "포포스와 브라코스는 괜찮을는지…"
  },
  "18": {
   "jp": "78562ca5a3",
   "kr": "마수의 피해는 정말 심각하네."
  },
  "19": {
   "jp": "82a95692c4",
   "kr": "일반 시민도 스스로 지킬 수 있어야 하는데 말이네."
  },
  "20": {
   "jp": "770a293704",
   "kr": "오, 자네가 어빈 군인가?"
  },
  "21": {
   "jp": "3cd608a996",
   "kr": "내 일을 맡아 주었다고 알선소에서 연락이 왔소."
  },
  "22": {
   "jp": "b28c9056e5",
   "kr": "포포스와 브라코스는 무사할는지…"
  },
  "23": {
   "jp": "44c0b4e6c8",
   "kr": "부디 어서 구해 주게."
  },
  "24": {
   "jp": "e84578ae3b",
   "kr": "폐를 끼쳐 미안하네."
  },
  "25": {
   "jp": "aae7755b0b",
   "kr": "포포스와 브라코스를 구해 주게."
  },
  "26": {
   "jp": "0a0116000b",
   "kr": "걱정이야…"
  },
  "27": {
   "jp": "2480aeb393",
   "kr": "포포스와 브라코스는 괜찮을는지…"
  },
  "28": {
   "jp": "7588fbabd1",
   "kr": "어빈 군에게는 정말 감사하네."
  },
  "29": {
   "jp": "c27061275d",
   "kr": "포포스와 브라코스도 충분히 혼이 났을 것이네."
  },
  "30": {
   "jp": "a811ddebec",
   "kr": "누가 구해 줬는지는 모르나"
  },
  "31": {
   "jp": "108d01ccac",
   "kr": "포포스와 브라코스가 무사해서 다행이야."
  },
  "32": {
   "jp": "8a0dd42753",
   "kr": "…이런 참, 무사히 돌아왔기에 망정이지."
  },
  "33": {
   "jp": "40fec44068",
   "kr": "다시는 위험한 짓을 하지 말거라."
  },
  "34": {
   "jp": "bcf608605a",
   "kr": "촌장님, 죄송해요."
  },
  "35": {
   "jp": "3d9f1afec9",
   "kr": "자, 포포스도 사과해야지."
