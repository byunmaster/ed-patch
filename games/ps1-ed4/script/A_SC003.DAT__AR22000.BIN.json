  "0": {
   "jp": "c3f0fbbfac",
   "kr": "광부"
  },
  "1": {
   "jp": "7f873b5f84",
   "kr": "이런 일은 인내가 중요하지."
  },
  "2": {
   "jp": "1110290340",
   "kr": "서두르지 말고 느긋하게 꼼꼼히."
  },
  "3": {
   "jp": "4885031a19",
   "kr": "벽이란 벽은 샅샅이 훑을 각오로 해야지."
  },
  "4": {
   "jp": "aad6105772",
   "kr": "언젠가 엄청난 보물을 손에 넣을 거야."
  },
  "5": {
   "jp": "7ba10bfb54",
   "kr": "안 그래, 동업자?"
  },
  "6": {
   "jp": "96ea7014e8",
   "kr": "아까 찾았다고 생각해서"
  },
  "7": {
   "jp": "1b118cb177",
   "kr": "잠깐 기뻐했거든."
  },
  "8": {
   "jp": "33c9510ebe",
   "kr": "찾던 물건이 아니었어."
  },
  "9": {
   "jp": "58e7ce6c0d",
   "kr": "괜히 좋아했네."
  },
  "10": {
   "jp": "17757bd290",
   "kr": "맥이 빠져."
  },
  "11": {
   "jp": "e78c2b78d0",
