  },
  "14": {
   "jp": "acb04d9920",
   "kr": "와하하하하…!"
  },
  "15": {
   "jp": "55914a1599",
   "kr": "벌써 원석은 손에 넣었어."
  },
  "16": {
   "jp": "cfff449ab9",
   "kr": "담당자에게 감정받자."
  },
  "17": {
   "jp": "253e75f56c",
   "kr": "뭐 하는 거야, 어빈."
  },
  "18": {
   "jp": "a0e933c961",
   "kr": "내가 찾아 준 에메리가"
  },
  "19": {
   "jp": "bc841987c0",
   "kr": "마음에 안 든다는 거야?"
  },
  "20": {
   "jp": "693de414c8",
   "kr": "안 돼, 어빈."
  },
  "21": {
