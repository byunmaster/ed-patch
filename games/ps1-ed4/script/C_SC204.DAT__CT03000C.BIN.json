{
 "archive": "/C/SC204.DAT",
 "member": "..\\BIN\\CT03000C.BIN",
 "segments": {
  "0": {
   "jp": "c75a8b96c6",
   "kr": "제가 상대해 드리겠습니다."
  },
  "1": {
   "jp": "a567a60ecb",
   "kr": "오오, 정중하기도 하구려. 부탁하오."
  },
  "2": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "3": {
   "jp": "fbdf5f1cb2",
   "kr": "저는 가난하다고는 하나 귀족 가문에 태어나"
  },
  "4": {
   "jp": "154de6d660",
   "kr": "사소한 불편은 있었으나"
  },
  "5": {
   "jp": "24e901de24",
   "kr": "괴로움이라 부를 만한 것은 모르고 자랐소이다."
  },
  "6": {
   "jp": "9c13722127",
   "kr": "차츰 키가 자라면서"
  },
  "7": {
   "jp": "859fe194be",
   "kr": "세상의 모순이 클라스타 벌의 침처럼"
  },
  "8": {
   "jp": "fc95a4f475",
   "kr": "깊이 가슴에 박힌 아픔이 되었으나…"
  },
  "9": {
   "jp": "db774701a2",
   "kr": "하아…"
  },
  "10": {
   "jp": "7d6f76e46c",
   "kr": "마음속에 들어온 세정의 흐름과의 간극에"
  },
  "11": {
   "jp": "f1b348a7df",
   "kr": "아프지 않을 가슴은 없으리니… 그러하여…"
  },
  "12": {
   "jp": "33c83ec800",
   "kr": "콘로드의 영문 모를 이야기는 끝없이 이어졌다."
  },
  "13": {
   "jp": "249925e896",
   "kr": "…하여 자기를 아는 마음의 여행은"
  },
  "14": {
   "jp": "c8fbcb0b8b",
   "kr": "위선의 바다에 뜬 외딴섬, 진실의 섬처럼"
  },
  "15": {
   "jp": "38ce1ef0d5",
   "kr": "작은 존재이나 뜨거운 탐구가 되어…"
  },
  "16": {
   "jp": "db774701a2",
   "kr": "하아…"
  },
  "17": {
   "jp": "ed33bba4a5",
   "kr": "콘로드는… 멋을 부려 말하려 들면"
  },
  "18": {
   "jp": "f63a844a08",
   "kr": "영문 모를 귀족 말이 되는구나."
  },
  "19": {
   "jp": "1c1db9125b",
   "kr": "이상이옵니다. 실례가 많았사옵니다."
  },
  "20": {
   "jp": "2591170946",
   "kr": "어라, 끝났나?"
  },
  "21": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "22": {
   "jp": "663a152ce8",
   "kr": "재미있다면 재미있었지만…"
  },
  "23": {
   "jp": "aed0867d94",
   "kr": "잘 모르겠더구먼."
  },
  "24": {
   "jp": "752a2db8f0",
   "kr": "뭐, 자네 말투 자체에"
  },
  "25": {
   "jp": "7bd317c1ad",
   "kr": "묘한 재미가 있었으니"
  },
  "26": {
   "jp": "70673fe87f",
   "kr": "보너스를 50로제 얹어 주는 정도겠군."
  },
  "27": {
   "jp": "18f7ae7010",
   "kr": "잘 이해하지 못하셨습니까?"
  },
  "28": {
   "jp": "a126829b08",
   "kr": "다시 한번 처음부터 말씀드릴까요?"
  },
  "29": {
   "jp": "3a0fed36f3",
   "kr": "아니, 됐네."
  },
  "30": {
   "jp": "368d2810d1",
   "kr": "수고했네."
  },
  "31": {
   "jp": "9895d58e5f",
   "kr": "콘로드는 50로제를 받았다."
  },
  "32": {
   "jp": "1fa2161c84",
   "kr": "또 말동무가 되어 주러 오게나."
  },
  "33": {
   "jp": "03dbf01df9",
   "kr": "단, 새 이야기를 구해서 말일세."
  },
  "34": {
   "jp": "80e5a91b3f",
   "kr": "글쎄. 어쩌면"
  },
  "35": {
   "jp": "a6da324298",
   "kr": "어빈 너희도 어디선가 만났을지 몰라."
  },
  "36": {
   "jp": "b7bfdb5081",
   "kr": "몇 년 전, 지금처럼 여행하던 때"
  },
  "37": {
   "jp": "cad6570756",
   "kr": "이상한 소설가 노인과 알게 됐어."
  },
  "38": {
   "jp": "83d84c9d27",
   "kr": "자네는 모험가니까"
  },
  "39": {
   "jp": "d6b66a1bf2",
   "kr": "손에 땀을 쥐는 스릴이나 서스펜스를"
  },
  "40": {
   "jp": "284298fd81",
   "kr": "잔뜩 겪었겠지."
  },
  "41": {
   "jp": "6d7c15050d",
   "kr": "이것도 예술에 대한 공헌이다."
  },
  "42": {
   "jp": "f54d542bba",
   "kr": "소재가 없으니 뭐라도 이야기를 들려 달라며"
  },
  "43": {
   "jp": "7f60894cce",
   "kr": "끈질기게 따라붙더라고."
  },
  "44": {
   "jp": "4d94078556",
   "kr": "어라."
  },
  "45": {
   "jp": "9a61f1093a",
   "kr": "혹시…"
  },
  "46": {
   "jp": "fa4fe5ecc9",
   "kr": "그놈은 카라무스가 아닐까?"
  },
  "47": {
   "jp": "e023d40be5",
   "kr": "알고 있어?"
  },
  "48": {
   "jp": "c64799dcfb",
   "kr": "알고말고."
  },
  "49": {
   "jp": "d21c541ea3",
   "kr": "카라무스는 옛날에 여기서 관리인 아르바이트를"
  },
  "50": {
   "jp": "1ac9f4e6de",
   "kr": "했거든."
  },
  "51": {
   "jp": "d4b2b73547",
   "kr": "그때부터 『예술에 대한 공헌이니까』가"
  },
  "52": {
   "jp": "ba46d787ee",
   "kr": "카라무스 녀석의 입버릇이었지."
  },
  "53": {
   "jp": "696dd062db",
   "kr": "자주 나그네를 붙잡고 억지로 이야기를 시켰어."
  },
  "54": {
   "jp": "d36cd1b3b8",
   "kr": "뭐, 녀석도 출세했으니 잘됐군, 잘됐어."
  },
  "55": {
   "jp": "4559c91555",
   "kr": "그러고 보니"
  },
  "56": {
   "jp": "09c31b0db6",
   "kr": "나그네 이야기를 들어 견문을 넓힌다는 건"
  },
  "57": {
   "jp": "23228f1f09",
   "kr": "같은 수잖아."
  },
  "58": {
   "jp": "4f90e2c583",
   "kr": "하하하… 들켰나."
  },
  "59": {
   "jp": "68731360bf",
   "kr": "사실 이 방법은"
  },
  "60": {
   "jp": "cc23d70104",
   "kr": "카라무스의 정보 수집법을 흉내 낸 걸세."
  },
  "61": {
   "jp": "0b54779ae8",
   "kr": "로제를 주는 것만 봐도"
  },
  "62": {
   "jp": "5bedbecb68",
   "kr": "도리아 교수 쪽이 양심적이라는 건가."
  },
  "63": {
   "jp": "c6d24bf6bc",
   "kr": "정말 그렇다니까."
  },
  "64": {
   "jp": "0b3fd868c4",
   "kr": "결국 내 이야기를 바탕으로"
  },
  "65": {
   "jp": "2d744fc1c6",
   "kr": "『여검사 사피』라는 소설을 썼다던데."
  },
  "66": {
   "jp": "bf6d09eb9c",
   "kr": "이야기 속 여검사의 이미지가 붙어 버려서"
  },
  "67": {
   "jp": "5e67feb7d4",
   "kr": "곤란하기 짝이 없어."
  },
  "68": {
   "jp": "6f1209e2a4",
   "kr": "덕분에 알선소 녀석들 중에는"
  },
  "69": {
   "jp": "0b21eb9d1b",
   "kr": "오늘은 아메지스랑 같이 안 왔어요?"
  },
  "70": {
   "jp": "8a32b5cffc",
   "kr": "같은 소리를 하는 놈까지 있어…"
  },
  "71": {
   "jp": "cd6425754d",
   "kr": "아메지스는 사피의 동생인데 말이지."
  },
  "72": {
   "jp": "cdcba34481",
   "kr": "그건 가공의 인물이라고 해도"
  },
  "73": {
   "jp": "402f8e8b29",
   "kr": "『알고 있어요』 하고 웃으며 대답할 뿐이고"
  },
  "74": {
   "jp": "d1ae703f88",
   "kr": "하나도 모르고 있어."
  },
  "75": {
   "jp": "404ef4a0cd",
   "kr": "돌아갈 때 동생분에게 주라며 사탕을 주기도 하고."
  },
  "76": {
   "jp": "c01150c332",
   "kr": "정말 민폐야."
  },
  "77": {
   "jp": "9ad9350667",
   "kr": "하하하하… 이거 재미있군!"
  },
  "78": {
   "jp": "cf15cf4f7a",
   "kr": "걸작, 걸작!"
  },
  "79": {
   "jp": "adaa363927",
   "kr": "후후후… 하하하…!"
  },
  "80": {
   "jp": "779b595046",
   "kr": "재미있다! 보너스로 150로제를 얹어 주지."
  },
  "81": {
   "jp": "9440cfc821",
   "kr": "카라무스의 민폐료 포함이겠군, 이건."
  },
  "82": {
   "jp": "9e684c2ef4",
   "kr": "히히히… 하하하…!"
  },
  "83": {
   "jp": "c9063a4e19",
   "kr": "루키어스는 150로제를 받았다."
  },
  "84": {
   "jp": "1fa2161c84",
   "kr": "또 말동무가 되어 주러 오게나."
  },
  "85": {
   "jp": "03dbf01df9",
   "kr": "단, 새 이야기를 구해서 말일세."
  },
  "86": {
   "jp": "a801361fb4",
   "kr": "그럼 제 이야기를 들어 주시겠어요?"
  },
  "87": {
   "jp": "815c746ed3",
   "kr": "오오? 어쩐지 이건…"
  },
  "88": {
   "jp": "446e9beb0b",
   "kr": "정중한 아가씨로군."
  },
  "89": {
   "jp": "fce2b75834",
   "kr": "어디, 잘 부탁하오."
  },
  "90": {
   "jp": "cd3a24d10d",
   "kr": "저야말로 잘 부탁드립니다."
  },
  "91": {
   "jp": "9e97df9ae2",
   "kr": "저는 「친절」에 대해서"
  },
  "92": {
   "jp": "529e8b5810",
   "kr": "이야기하려고 해요."
  },
  "93": {
   "jp": "33968afbfd",
   "kr": "친절?"
  },
  "94": {
   "jp": "23ce676ba2",
   "kr": "네, 친절이에요."
  },
  "95": {
   "jp": "1264c665b6",
   "kr": "실은… 제가 길을 잃고"
  },
  "96": {
   "jp": "bcaa6e87e5",
   "kr": "인적이 드문 가도에"
  },
  "97": {
   "jp": "4589cd388c",
   "kr": "우두커니 서 있던 때의 일이에요."
  },
  "98": {
   "jp": "8534d66a1e",
   "kr": "우연히 지나가던 여행자분이"
  },
  "99": {
   "jp": "ffcf4b30ef",
   "kr": "걱정하며 빵과 물을 나눠 주셨어요."
  },
  "100": {
   "jp": "184d33fb0f",
   "kr": "정말 친절하게 대해 주셨죠."
  },
  "101": {
   "jp": "93675517f7",
   "kr": "그때 저는 마음속 깊이 사람의 따뜻함과"
  },
  "102": {
   "jp": "c37db9207a",
   "kr": "친절을 받았을 때의 고마움을 느꼈어요."
  },
  "103": {
   "jp": "c7405314bf",
   "kr": "분명 자신이 모르는 곳에서도"
  },
  "104": {
   "jp": "52f1c79b62",
   "kr": "우리는 누군가의 친절을 받으며 살고 있을 거예요…"
  },
  "105": {
   "jp": "cad27e4c8d",
   "kr": "그러니 저 자신도 친절한 사람이고 싶어요."
  },
  "106": {
   "jp": "c48cdb2e1e",
   "kr": "그렇게 생각했어요."
  },
  "107": {
   "jp": "4e82625cbc",
   "kr": "이야, 정말 그렇군."
  },
  "108": {
   "jp": "f2f6c9f075",
   "kr": "좋은 이야기를 들었네."
  },
  "109": {
   "jp": "8dc3b301ad",
   "kr": "100로제, 지불하겠네."
  },
  "110": {
   "jp": "300acb54b3",
   "kr": "엘레노아는 100로제를 받았다."
  },
  "111": {
   "jp": "1fa2161c84",
   "kr": "또 말동무가 되어 주러 오게나."
  },
  "112": {
   "jp": "03dbf01df9",
   "kr": "단, 새 이야기를 구해서 말일세."
  },
  "113": {
   "jp": "6788c710bd",
   "kr": "『여검사 사피』라는"
  },
  "114": {
   "jp": "8ff1c9e4fd",
   "kr": "소설을 썼다는데."
  }
 }
}
