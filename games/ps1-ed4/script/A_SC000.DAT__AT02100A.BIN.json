 "segments": {
  "0": {
   "jp": "88ad920d36",
   "kr": "저를 일행에 넣어 주시는 건가요?"
  },
  "1": {
   "jp": "645e8bd79c",
   "kr": "싸움은 별로 좋아하지 않지만"
  },
  "2": {
   "jp": "447ad72c7c",
   "kr": "백마법으로 동료를 지키는 일이라면"
  },
  "3": {
   "jp": "a65263d7fe",
   "kr": "도움이 될 거라고 생각해요."
  },
  "4": {
   "jp": "2ddc63d0ba",
   "kr": "기다리고 있었어요."
  },
  "5": {
   "jp": "4ad30cff1b",
   "kr": "또 함께 여행할 수 있는 거네요?"
  },
  "6": {
   "jp": "4d251ec40f",
   "kr": "을(를) 일행에 넣겠습니까?"
  },
  "7": {
   "jp": "8a310ef00d",
   "kr": "잘 부탁드려요."
  },
  "8": {
   "jp": "ed1b9cb7bf",
   "kr": "이(가) 일행에 합류했다."
  },
  "9": {
   "jp": "d86cb2917c",
   "kr": "제가 들어갈 여유는 없는 것 같네요."
  },
  "10": {
   "jp": "af5806d726",
   "kr": "또 말씀해 주세요."
  },
  "11": {
   "jp": "57390ade8d",
   "kr": "한동안은 여기 머물고 있으니"
  },
  "12": {
   "jp": "ee5cab682f",
   "kr": "제가 필요할 때는 말을 걸어 주세요."
  },
  "13": {
   "jp": "08db845a96",
   "kr": "내 입으로 말하기 뭣하지만"
  },
  "14": {
   "jp": "f8d64aacb0",
   "kr": "날 넣으면 여행이 순조롭다고."
  },
  "15": {
   "jp": "2ea292bfdc",
   "kr": "검 솜씨에는 좀 자신이 있어."
  },
  "16": {
   "jp": "f20424bd86",
   "kr": "계약금으로 800로제 정도 내 준다면"
  },
  "17": {
   "jp": "7522aca103",
   "kr": "더할 나위 없지."
  },
  "18": {
   "jp": "9538bbc15e",
   "kr": "오, 기다렸다고."
  },
  "19": {
   "jp": "0b85668ec4",
   "kr": "난 언제든 출발할 수 있어."
  },
  "20": {
   "jp": "6da6519858",
   "kr": "계약금으로 80로제 정도 내 준다면"
  },
  "21": {
   "jp": "7522aca103",
   "kr": "더할 나위 없지."
  },
  "22": {
   "jp": "4d251ec40f",
   "kr": "을(를) 일행에 넣겠습니까?"
  },
  "23": {
   "jp": "c70c086deb",
   "kr": "이봐, 이봐, 날 놀리는 거야?"
  },
  "24": {
   "jp": "7420f5b11c",
   "kr": "이미 멤버는 충분하잖아."
  },
  "25": {
   "jp": "6a0ff8dbcb",
   "kr": "내 차례는 아니라는 거야?"
  },
  "26": {
   "jp": "1614badab6",
   "kr": "뭐, 좋아."
  },
  "27": {
   "jp": "bd4622f79c",
   "kr": "머지않아 내 힘이 필요해질 거야."
  },
  "28": {
   "jp": "40967d2fcf",
   "kr": "나는 미래의 대마법사 라엘 님이시다!"
  },
  "29": {
   "jp": "dd3d75a1e6",
   "kr": "어떤 위기도 마법 하나로 간단히 해결!"
  },
  "30": {
   "jp": "a195f46d56",
   "kr": "형이 꼭 그러겠다면"
  },
  "31": {
   "jp": "9fc97bb054",
   "kr": "동료가 되어 줄 수도 있어."
  },
  "32": {
   "jp": "5436fc56ed",
   "kr": "계약금은 50000로제야!"
  },
  "33": {
   "jp": "3c216ada83",
   "kr": "…비싸?"
  },
  "34": {
   "jp": "7d8eda05e1",
   "kr": "그럼 200로제면 돼."
  },
  "35": {
   "jp": "6568d2994f",
   "kr": "역시 내가 필요하구나!"
  },
  "36": {
   "jp": "112d0a1434",
   "kr": "그렇게까지 의지하는데 싫다고는 못 하지."
  },
  "37": {
   "jp": "191a00736b",
   "kr": "미래의 대마법사는 약한 자의 편이야!"
  },
  "38": {
   "jp": "6badf08211",
   "kr": "계약금?"
  },
  "39": {
   "jp": "14efb61794",
   "kr": "좋아, 형 부탁이니까."
  },
  "40": {
   "jp": "fbbb15f24b",
   "kr": "공짜로 해 줄게～."
  },
  "41": {
   "jp": "4d251ec40f",
   "kr": "을(를) 일행에 넣겠습니까?"
  },
  "42": {
   "jp": "6492a8aa9a",
   "kr": "형, 요즘 세상에 200로제도 없으면"
  },
  "43": {
   "jp": "9b8c9aa347",
   "kr": "여자애들한테 인기 없어."
  },
  "44": {
   "jp": "bc4e837b88",
   "kr": "뭐야～!"
  },
  "45": {
   "jp": "c058b12727",
   "kr": "애라고 무시하지 마!"
  },
  "46": {
   "jp": "8a8e844324",
   "kr": "미래의 대마법사를 동료로 안 삼다니"
  },
  "47": {
   "jp": "76f06fbbe6",
   "kr": "형의 역량도 뻔하지."
  },
  "48": {
   "jp": "bda4ab324c",
   "kr": "오케이."
  },
  "49": {
   "jp": "21737f9355",
   "kr": "앞으로 잘 부탁해."
  },
  "50": {
   "jp": "ed1b9cb7bf",
   "kr": "이(가) 일행에 합류했다."
  },
  "51": {
   "jp": "e8566a6fd7",
   "kr": "이봐이봐, 사람 마음 들뜨게 해 놓고"
  },
  "52": {
   "jp": "27fab51968",
   "kr": "계약금이 없다는 건 말도 안 돼."
  },
  "53": {
   "jp": "2c9863c207",
   "kr": "이제부터는 든든한 배에 탔다 생각하고"
  },
  "54": {
   "jp": "7ecc00e7c6",
   "kr": "나한테 맡겨!"
  },
  "55": {
   "jp": "ed1b9cb7bf",
   "kr": "이(가) 일행에 합류했다."
  }
 }
}
