{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02210C.BIN",
 "segments": {
  "0": {
   "jp": "199e8dcf52",
   "kr": "《질풍의 라빈 제６권》"
  },
  "1": {
   "jp": "06fefb115e",
   "kr": "카라무로 카라무스"
  },
  "2": {
   "jp": "2bdf8eb61a",
   "kr": "「루디. 내 이름은 루디」"
  },
  "3": {
   "jp": "77d0191dfc",
   "kr": "의사가 떠나자 여인이 입을 열었다."
  },
  "4": {
   "jp": "2d2e9511bb",
   "kr": "「나를 덮친 건 평범한 도적이 아니에요."
  },
  "5": {
   "jp": "6da282e324",
   "kr": "이 나라를 멸망시키려는 무서운 조직이에요."
  },
  "6": {
   "jp": "d661fc139b",
   "kr": "그들은 금단의 비술서를 손에 넣었어요."
  },
  "7": {
   "jp": "1055bdae36",
   "kr": "그건 마수를 부리는 법이 적힌 책이에요…」"
  },
  "8": {
   "jp": "38783f6dc3",
   "kr": "루디는 침대 위에서 몸을 일으켰다."
  },
  "9": {
   "jp": "5b8ac22429",
   "kr": "「가야 해요."
  },
  "10": {
   "jp": "7b5be790ea",
   "kr": "그들이 마수를 부리게 되면 이 나라는…"
  },
  "11": {
   "jp": "e460d4e5f3",
   "kr": "아니, 이 세계는 멸망하고 말 거예요!」"
  },
  "12": {
   "jp": "5d26542d19",
   "kr": "「기다려」"
  },
  "13": {
   "jp": "6e013446fb",
   "kr": "라빈은 루디의 어깨에 손을 얹었다."
  },
  "14": {
   "jp": "579d6285a2",
   "kr": "「혼자 갈 생각이야?」"
  },
  "15": {
   "jp": "704ec2fced",
   "kr": "잠깐…"
  },
  "16": {
   "jp": "6af34580e9",
   "kr": "『루디』라니, 어떻게 된 거야?"
  },
  "17": {
   "jp": "d85a0311c7",
   "kr": "《질풍의 라빈 제７권》"
  },
  "18": {
   "jp": "06fefb115e",
   "kr": "카라무로 카라무스"
  },
  "19": {
   "jp": "bf725f8fda",
   "kr": "「네놈 따위에게… 네놈 같은 자에게,"
  },
  "20": {
   "jp": "ab01ac1a61",
   "kr": "이 계획이 깨지다니!」"
  },
  "21": {
   "jp": "5e9a08b033",
   "kr": "돌크는 형형히 빛나는 눈으로 라빈을 쏘아보았다."
  },
  "22": {
   "jp": "9b94a057dd",
   "kr": "머리카락과 수염이 곤두서고 움켜쥔 주먹에 핏줄이 돋았다."
  },
  "23": {
   "jp": "8785618a0e",
   "kr": "드러낸 이빨이 날카로운 송곳니로 변했다!"
  },
  "24": {
   "jp": "bd8aa61cfa",
   "kr": "…그리고 섬광!"
  },
  "25": {
   "jp": "b914e850fe",
   "kr": "라빈은 루디를 뒤로 감쌌다."
  },
  "26": {
   "jp": "3ac9fba58d",
   "kr": "손을 앞으로 내밀며"
  },
  "27": {
   "jp": "6fdef072f8",
   "kr": "돌크의 몸이 일그러지고 물결치며"
  },
  "28": {
   "jp": "a8bc23cf09",
   "kr": "대지를 뒤흔드는 포효가 사방에 울려 퍼졌다."
  },
  "29": {
   "jp": "9e87863db6",
   "kr": "다음에 라빈이 본 것은 이미 인간이 아니었다."
  },
  "30": {
   "jp": "bf42c65e02",
   "kr": "마수로 모습을 바꾼 돌크였다."
  },
  "31": {
   "jp": "15f06a1a9f",
   "kr": "라빈은 검을 움켜쥐었다."
  },
  "32": {
   "jp": "64fba98186",
   "kr": "《질풍의 라빈 제８권》"
  },
  "33": {
   "jp": "06fefb115e",
   "kr": "카라무로 카라무스"
  },
  "34": {
   "jp": "7022fb53b9",
   "kr": "…그리고 모든 악몽은 사라졌다."
  },
  "35": {
   "jp": "5e3d6e1253",
   "kr": "라빈의 어깨에는 이제 검을 치켜들 힘도 남아 있지 않다."
  },
  "36": {
   "jp": "a63aa79206",
   "kr": "돌크의 시체를 뒤로하고 라빈과 루디는 동굴을 나섰다."
  },
  "37": {
   "jp": "f14bf5df22",
   "kr": "금빛 햇살이 두 사람을 맞이했다."
  },
  "38": {
   "jp": "bf1d0d121f",
   "kr": "「당신은 영웅이에요, 라빈」"
  },
  "39": {
   "jp": "470275c142",
   "kr": "루디는 살며시 라빈의 팔을 잡았다."
  },
  "40": {
   "jp": "f87060ff8f",
   "kr": "「…설마. 나는 영웅 같은 게 아니야」"
  },
  "41": {
   "jp": "4c07593cc6",
   "kr": "「그럼 뭐란 말이에요?」"
  },
  "42": {
   "jp": "a72ef70311",
   "kr": "라빈은 루디의 말을 미소로 받았다."
  },
  "43": {
   "jp": "13370a2de1",
   "kr": "갑자기 일어난 바람이 라빈의 머리카락을 흐트러뜨렸다."
  },
  "44": {
   "jp": "607e98ceb9",
   "kr": "잠시 앞이 안 보이더니 다시 바람이 머리칼을 쓸었다."
  },
  "45": {
   "jp": "8a6146dfb5",
   "kr": "「글쎄. 그건 앞으로 정해지겠지」"
  },
  "46": {
   "jp": "b3f29b3d96",
   "kr": "라빈은 바람이 부는 방향을 손가락으로 가리켰다."
  },
  "47": {
   "jp": "6b6b11cd9e",
   "kr": "「일단 이쪽으로 가 보자."
  },
  "48": {
   "jp": "bf75231058",
   "kr": "뭔가 새로운 것을 찾으러」"
  },
  "49": {
   "jp": "c6ae251375",
   "kr": "질풍의 라빈 완"
  },
  "50": {
   "jp": "52d761af46",
   "kr": "그들이 마수를 부리게 되면"
  },
  "51": {
   "jp": "af5f37cba5",
   "kr": "이 나라는…"
  },
  "52": {
   "jp": "1cd962dbc6",
   "kr": "손을 앞으로 내밀며"
  },
  "53": {
   "jp": "ca532f229e",
   "kr": "필사적으로 섬광의 정체를 확인한다."
  },
  "54": {
   "jp": "296d61567d",
   "kr": "라빈의 어깨에는"
  },
  "55": {
   "jp": "e20ec624eb",
   "kr": "이제 검을 치켜들 힘도 남아 있지 않았다."
  },
  "56": {
   "jp": "fc5e987418",
   "kr": "돌크의 추악한 시체를 뒤로하고"
  },
  "57": {
   "jp": "6016396547",
   "kr": "라빈과 루디는 동굴을 나섰다."
  },
  "58": {
   "jp": "5e7a01d168",
   "kr": "순간, 앞이 보이지 않게 되었다가"
  },
  "59": {
   "jp": "ddb2e8b7c8",
   "kr": "다시 바람이 머리카락을 쓸어 넘겼다."
  }
 }
}
