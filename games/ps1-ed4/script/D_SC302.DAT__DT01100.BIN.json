 "segments": {
  "0": {
   "jp": "fa4eeeaa0d",
   "kr": "여관 안주인",
   "auto": 1
  },
  "1": {
   "jp": "80e109208e",
   "kr": "나중에 울고불고해도 몰라요."
  },
  "2": {
   "jp": "5955f16d31",
   "kr": "언젠가 내가 필요한 날이 올지도 몰라.",
   "auto": 1
  },
  "3": {
   "jp": "f9096004e2",
   "kr": "그날을 믿고 공부해 둘게."
  },
  "4": {
   "jp": "b3db9e339b",
   "kr": "싸움에서 인정은 금물이야."
  },
  "5": {
   "jp": "89938de3ea",
   "kr": "상대가 움직임을 멈출 때까지 공격의 손을 늦추지 마."
  },
  "6": {
   "jp": "faca7ced15",
   "kr": "서두르는 여행일수록 휴식이 필요해요."
  },
  "7": {
   "jp": "1acae46521",
   "kr": "너무 무리하지 마세요."
  },
  "8": {
   "jp": "ca5319ae61",
   "kr": "짧은 시간이었지만 즐거웠어요."
  },
  "9": {
   "jp": "247a4a465b",
   "kr": "무기와 마법을 효율적으로 나눠 써."
  },
  "10": {
   "jp": "f559c6e21a",
   "kr": "힘으로만 밀어붙이면 언젠가 막히니까."
  },
  "11": {
   "jp": "60d972586b",
   "kr": "그만둬, 말려 봐야 소용없어.",
   "auto": 1
  },
  "12": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "13": {
   "jp": "10591ace30",
   "kr": "이 마을에는 등대가 있었지."
  },
  "14": {
   "jp": "507f54df62",
   "kr": "잠시 등대라도 보고 있을까."
  },
  "15": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "16": {
   "jp": "a4f46c7154",
   "kr": "이별은 달콤한 슬픔.",
   "auto": 1
  },
  "17": {
   "jp": "f77320295e",
   "kr": "재회를 꿈꾸며 떠나도록 하지요.",
   "auto": 1
  },
  "18": {
   "jp": "4b59f66212",
   "kr": "내 힘이 필요할 때는",
   "auto": 1
  },
  "19": {
   "jp": "fc84a547dc",
   "kr": "찾아오너라.",
   "auto": 1
  }
 }
}
