  "0": {
   "jp": "c3f0fbbfac",
   "kr": "광부"
  },
  "1": {
   "jp": "e9dfcdffe5",
   "kr": "우릴 구하러 와 준 거냐!"
  },
  "2": {
   "jp": "6d837df227",
   "kr": "바로 저기에 마수가 자리 잡고 있어서"
  },
  "3": {
   "jp": "c0702bbfe8",
   "kr": "꼼짝도 못 했어."
  },
  "4": {
   "jp": "b34278b2b1",
   "kr": "어떻게 됐어? 마수는 쓰러뜨렸나?!"
  },
  "5": {
   "jp": "31e0abcdf1",
   "kr": "거기 있던 마수라면 우리가 쓰러뜨렸다."
  },
  "6": {
   "jp": "8c267001d5",
   "kr": "이제 위험은 없을 거다."
  },
  "7": {
   "jp": "1a03e5c83e",
   "kr": "살았다, 고마워!"
  },
  "8": {
   "jp": "9f4499533e",
   "kr": "얼른 마수를 쓰러뜨리고 우리한테 알려 줘."
  },
  "9": {
   "jp": "96f7045bf1",
   "kr": "얼른 마수를 쓰러뜨려 줘."
  },
  "10": {
   "jp": "1464c38c7e",
   "kr": "알선소에서 온 사람이지?"
  },
  "11": {
   "jp": "587acb3fd9",
   "kr": "어떻게든 해 줘."
  },
  "12": {
   "jp": "f974f4d176",
   "kr": "언제까지 여기 있어야 하는 거야."
  }
