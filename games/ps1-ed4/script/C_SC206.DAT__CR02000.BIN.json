 "segments": {
  "0": {
   "jp": "250774871f",
   "kr": "산적"
  },
  "1": {
   "jp": "4631d9a8dc",
   "kr": "어이, 여긴 우리 구역이다."
  },
  "2": {
   "jp": "91350be6e6",
   "kr": "지나가고 싶으면 ５０로제 내놔라."
  },
  "3": {
   "jp": "dcecf625aa",
   "kr": "어이, 돌아가냐?"
  },
  "4": {
   "jp": "10f96074eb",
   "kr": "여길 지나가고 싶으면 ５０로제 내놔라."
  },
  "5": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "6": {
   "jp": "f6bb453e78",
   "kr": "을(를) 냈다."
  },
  "7": {
   "jp": "37fc811ce7",
   "kr": "좋아, 지나가도 좋다."
  },
  "8": {
   "jp": "b368cb7a0e",
   "kr": "돈이 없잖아!"
  },
  "9": {
   "jp": "b9dd70b9a8",
   "kr": "배짱 한번 좋군."
  },
  "10": {
   "jp": "89f609ee0e",
   "kr": "홀딱 벗겨서 통행료로 받아 주마!"
  },
  "11": {
   "jp": "524d372594",
   "kr": "의뢰 완료다.",
   "auto": 1
  },
  "12": {
   "jp": "9e76df7612",
   "kr": "자, 어서 가!"
  },
  "13": {
   "jp": "105d352144",
   "kr": "얼쩡거리면"
  },
  "14": {
   "jp": "c6ba2a5199",
   "kr": "또 통행료를 받는다."
  },
  "15": {
   "jp": "9ca07f13be",
   "kr": "겁쟁이들한테서 통행료를 받다니"
  },
  "16": {
   "jp": "1d64bce8ec",
   "kr": "최고의 아이디어라니까."
  },
  "17": {
   "jp": "a73381ff0e",
   "kr": "너희 같은 봉이 있어서 살맛 난다."
  },
  "18": {
   "jp": "23d1517852",
   "kr": "티끌 모아 태산이라지."
  },
  "19": {
   "jp": "b409b04e66",
   "kr": "곧 부자가 될 거다."
  },
  "20": {
   "jp": "da0ab6546d",
   "kr": "헤헤헤."
  },
  "21": {
   "jp": "28abdabff7",
   "kr": "또 와라."
  },
  "22": {
   "jp": "aea7879957",
   "kr": "아무도 때려잡으러 오지 않는 걸 보니"
  },
  "23": {
   "jp": "4bf8e09d43",
   "kr": "우리 장사는 허락된 건가?"
  },
  "24": {
   "jp": "0487f2a5e3",
   "kr": "세상은 센 놈이 득을 보는 법이지."
  },
  "25": {
   "jp": "490d927678",
   "kr": "약한 놈은 울며 참을 수밖에 없다고."
  },
  "26": {
   "jp": "c3effc00b4",
   "kr": "빨리 가라고."
  },
  "27": {
   "jp": "a329a087ef",
   "kr": "우리도 한가하지 않으니까."
  }
 }
}
