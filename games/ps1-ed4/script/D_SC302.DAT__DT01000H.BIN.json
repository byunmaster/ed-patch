 "segments": {
  "0": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "1": {
   "jp": "b0e6c76498",
   "kr": "무기라면 우리 집에 맡겨요."
  },
  "2": {
   "jp": "12289568e3",
   "kr": "발크드의 맥래인 씨가"
  },
  "3": {
   "jp": "f4a3bc68a5",
   "kr": "편지를 맡겨서 가져왔어요."
  },
  "4": {
   "jp": "9a88e2dc74",
   "kr": "어머, 나한테 편지라니 별일이네."
  },
  "5": {
   "jp": "39a308b004",
   "kr": "무기점 안주인에게 편지를 건넸다."
  },
  "6": {
   "jp": "e99bafbc0a",
   "kr": "먼 데서 수고 많았네."
  },
  "7": {
   "jp": "f2fd86c61b",
   "kr": "정말 고마워."
  },
  "8": {
   "jp": "81c74d92e7",
   "kr": "하는 김에 하는 말인데,"
  },
  "9": {
   "jp": "7c8bb99266",
   "kr": "모처럼 왔으니 우리 집 물건도"
  },
  "10": {
   "jp": "8c84473b86",
   "kr": "보고 가 줘."
  },
  "11": {
   "jp": "a28dcb5618",
   "kr": "천천히 보고 가."
  },
  "12": {
   "jp": "9c4c6f775f",
   "kr": "어머, 무슨 일이니?"
  }
 }
}
