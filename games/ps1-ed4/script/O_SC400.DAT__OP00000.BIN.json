{
 "archive": "/O/SC400.DAT",
 "member": "..\\BIN\\OP00000.BIN",
 "segments": {
  "0": {
   "jp": "c7835842e0",
   "kr": "아이멜"
  },
  "1": {
   "jp": "cfe80e7d37",
   "kr": "오레시아"
  },
  "2": {
   "jp": "921766275e",
   "kr": "베리어스 경"
  },
  "3": {
   "jp": "c6cf8ccc3e",
   "kr": "승병"
  },
  "4": {
   "jp": "130dd5ba93",
   "kr": "자, 어빈, 아이멜."
  },
  "5": {
   "jp": "0fb9327f29",
   "kr": "기도할 시간이에요."
  },
  "6": {
   "jp": "d0779765cc",
   "kr": "오빠."
  },
  "7": {
   "jp": "9a6ac5bd3b",
   "kr": "기도가 끝나면 꽃밭에 가요."
  },
  "8": {
   "jp": "6cbabdb0c7",
   "kr": "너희 남매는 정말 사이가 좋네요."
  },
  "9": {
   "jp": "3245d3cc21",
   "kr": "부러워요."
  },
  "10": {
   "jp": "331109e9ad",
   "kr": "그치만 선생님, 오빠는 치사해요."
  },
  "11": {
   "jp": "b942374499",
   "kr": "늘 고개만 끄덕일 뿐이에요."
  },
  "12": {
   "jp": "a57d8fadb3",
   "kr": "약속해도 금방 어디론가 가 버려요."
  },
  "13": {
   "jp": "cd0c729a38",
   "kr": "어빈은 사내아이니까요."
  },
  "14": {
   "jp": "fe3cde9ce3",
   "kr": "꽃 따기 같은 건 지루할지도 모르죠."
  },
  "15": {
   "jp": "abd10e84d4",
   "kr": "고아였던 나와 아이멜은"
  },
  "16": {
   "jp": "22f70eefa0",
   "kr": "카테드랄에 거두어져 신전에서 살고 있었다."
  },
  "17": {
   "jp": "5166b9b3b9",
   "kr": "웬 놈이냐!"
  },
  "18": {
   "jp": "28e09a0aac",
   "kr": "…음?"
  },
  "19": {
   "jp": "19f233230d",
   "kr": "베, 베리어스 경…!?"
  },
  "20": {
   "jp": "515a05a8d6",
   "kr": "카테드랄에서 추방된 자가 무슨 일이냐!"
  },
  "21": {
   "jp": "1db0b0ca0f",
   "kr": "당장 물러가라!"
  },
  "22": {
   "jp": "9f6d92bf2c",
   "kr": "길을 비켜 줘야겠다."
  },
  "23": {
   "jp": "82b02773b3",
   "kr": "비키지 않으면 목숨은 없다."
  },
  "24": {
   "jp": "62579f09c4",
   "kr": "뭐, 뭐라고…"
  },
  "25": {
   "jp": "bad417e31e",
   "kr": "너희 신이 가르치는 것은"
  },
  "26": {
   "jp": "34e0727891",
   "kr": "언제까지고 어리석음뿐인가…"
  },
  "27": {
   "jp": "af10b15654",
   "kr": "후후후후…"
  },
  "28": {
   "jp": "d3e6dc1362",
   "kr": "그렇다면 바라는 대로 죽어라."
  },
  "29": {
   "jp": "d8cccaefe4",
   "kr": "가라. 카테드랄을 점거해라."
  }
 }
}
