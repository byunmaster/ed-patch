{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02000D.BIN",
 "segments": {
  "0": {
   "jp": "6fcc7cb0b9",
   "kr": "무슨 일이에요?"
  },
  "1": {
   "jp": "60e0b10252",
   "kr": "크, 큰일이야!"
  },
  "2": {
   "jp": "13b4e49f61",
   "kr": "갑자기 이상한 놈들이 쳐들어와서"
  },
  "3": {
   "jp": "03a8e61ab1",
   "kr": "공장을 내놓으라고 소리치고 있어!"
  },
  "4": {
   "jp": "0855979afa",
   "kr": "이상한 놈들?"
  },
  "5": {
   "jp": "b6ebe08c33",
   "kr": "저건 분명 사교도 놈들이야."
  },
  "6": {
   "jp": "b1ac7736f0",
   "kr": "여기 설비를 내놓으라고"
  },
  "7": {
   "jp": "faa78017b1",
   "kr": "몇 번 말한 적이 있었거든."
  },
  "8": {
   "jp": "034771ae17",
   "kr": "사교도…?!"
  },
  "9": {
   "jp": "afa93b738d",
   "kr": "여기서 나오는 광석과"
  },
  "10": {
   "jp": "4952898777",
   "kr": "공장의 권리를 노리고 있었어."
  },
  "11": {
   "jp": "322a07092b",
   "kr": "터무니없는 놈들이야!"
  },
  "12": {
   "jp": "65bb0c67a3",
   "kr": "너희 모험가잖아."
  },
  "13": {
   "jp": "758789b221",
   "kr": "어떻게든 해 줘!"
  },
  "14": {
   "jp": "ec0f75318c",
   "kr": "가 볼까."
  },
  "15": {
   "jp": "c379c98784",
   "kr": "하지만 정말로 사교도 놈들이라면"
  },
  "16": {
   "jp": "9c8e01f47a",
   "kr": "귀찮아질지도 몰라…"
  },
  "17": {
   "jp": "7c9962c418",
   "kr": "아이멜도 쫓아가야 하고."
  },
  "18": {
   "jp": "1b6c24a4ff",
   "kr": "도망만 다녀 봤자 소용없어."
  },
  "19": {
   "jp": "75af1428f9",
   "kr": "게다가"
  },
  "20": {
   "jp": "a7a9da3115",
   "kr": "우린 사교도에 대해 잘 몰라."
  },
  "21": {
   "jp": "63da0ae3a2",
   "kr": "놈들의 수법을 알 좋은 기회야."
  },
  "22": {
   "jp": "5973e24f78",
   "kr": "으음～, 확실히 그렇네."
  },
  "23": {
   "jp": "02a0231c3a",
   "kr": "알았어. 공장에 가 보자."
  },
  "24": {
   "jp": "f2071b9885",
   "kr": "정말 잘해 줬어."
  },
  "25": {
   "jp": "a441070bb1",
   "kr": "나도 고맙다는 말을 해야겠군."
  },
  "26": {
   "jp": "6446a909fe",
   "kr": "내가 망을 부탁한 것도"
  },
  "27": {
   "jp": "94f75f9c91",
   "kr": "대단한 사람들이라는 걸 알아봤기 때문이야."
  },
  "28": {
   "jp": "dc6af49dca",
   "kr": "흥, 말은 잘하는군."
  },
  "29": {
   "jp": "8271812e70",
   "kr": "공장 쪽은 제５용광로가 고쳐질 때까지 못 들어가지만"
  },
  "30": {
   "jp": "919a82bd9a",
   "kr": "가까운 시일 안에 루카네를 찾아가 줘."
  },
  "31": {
   "jp": "fcef5ca531",
   "kr": "그럼 조심해서 가!"
  }
 }
}
