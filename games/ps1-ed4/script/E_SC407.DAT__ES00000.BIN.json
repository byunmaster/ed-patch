  "0": {
   "jp": "915db4426a",
   "kr": "관리",
   "auto": 1
  },
  "1": {
   "jp": "e1d2f3fe59",
   "kr": "여기는 오오스 동굴입니다."
  },
  "2": {
   "jp": "706659da9b",
   "kr": "위험하므로 출입을 금지하고 있습니다."
  },
  "3": {
   "jp": "723f851ebf",
   "kr": "알선소 의뢰를 받고 왔어.",
   "auto": 1
  },
  "4": {
   "jp": "08aa7bf0ad",
   "kr": "아, 혹시 어빈 씨입니까?"
  },
  "5": {
   "jp": "cfd9e876fa",
   "kr": "네네, 들었습니다."
  },
  "6": {
   "jp": "c04aa476b2",
   "kr": "정말이지, 곤란해 죽겠어요."
  },
  "7": {
   "jp": "e1c6b5f260",
   "kr": "단 영감님 때문에!"
  },
  "8": {
   "jp": "0485027728",
   "kr": "듣자 하니 조상이 남긴 보물이 이 동굴에 있다고 해서"
  },
  "9": {
   "jp": "72cec15604",
   "kr": "안에 틀어박혀 버렸어요."
  },
  "10": {
   "jp": "200bde78cf",
   "kr": "마수투성이라 위험한데 말이죠."
  },
  "11": {
   "jp": "fe8caec8f4",
   "kr": "어떻게든 설득해 주세요."
  },
  "12": {
   "jp": "fa99ac30ce",
   "kr": "아이고, 어빈 씨."
  },
  "13": {
   "jp": "620fd98992",
   "kr": "그 고집쟁이 영감님을 용케 설득하셨네요."
  },
  "14": {
   "jp": "e1d2b729c2",
   "kr": "단 영감님, 춤추며 돌아가셨어요."
  },
  "15": {
   "jp": "3962b99616",
   "kr": "이제 저도 집에 갈 수 있겠네요."
  },
  "16": {
   "jp": "6bdc0fc368",
   "kr": "이거 참, 수고 많으셨습니다."
  },
  "17": {
   "jp": "748a441398",
   "kr": "어빈 씨죠?"
  },
  "18": {
   "jp": "bd1973e1bb",
   "kr": "연락은 받았습니다."
  },
  "19": {
   "jp": "e4ad207204",
   "kr": "들어가세요."
  },
  "20": {
   "jp": "a3acb1c062",
   "kr": "저희가 상상도 못 할 일이"
  },
  "21": {
   "jp": "4166081254",
   "kr": "진행되고 있는 모양입니다."
  },
  "22": {
   "jp": "fd0af93ece",
   "kr": "부디 충분히 조심하세요."
  },
  "23": {
   "jp": "131b8321c3",
   "kr": "단 영감님은 지독하게 고집불통이라서요."
  },
  "24": {
   "jp": "351b65157b",
   "kr": "조심하세요."
  },
  "25": {
   "jp": "ba5b5798fc",
   "kr": "어떠셨어요?"
  },
  "26": {
   "jp": "8b964ac24f",
   "kr": "단 영감님은 만나셨나요?"
  },
  "27": {
   "jp": "babd39b23d",
   "kr": "글쎄,"
  },
  "28": {
   "jp": "98b63d478e",
   "kr": "조상이 남긴 재물이 이 동굴에 있다면서"
  }
 }
}
