{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02000G.BIN",
 "segments": {
  "0": {
   "jp": "776adf92e7",
   "kr": "루크레프!"
  },
  "1": {
   "jp": "131990adb2",
   "kr": "다행이다, 무사했구나."
  },
  "2": {
   "jp": "5fb1ed8b2d",
   "kr": "걱정 끼쳤네, 메리안…"
  },
  "3": {
   "jp": "4876086d97",
   "kr": "정말이지, 어쩌다 도적 따위한테 붙잡힌 거야?"
  },
  "4": {
   "jp": "05f32d9090",
   "kr": "그 덩치가 부탁하고 싶은 일이 있다며"
  },
  "5": {
   "jp": "f362934524",
   "kr": "따라오라고 했어요."
  },
  "6": {
   "jp": "f58ae97bf7",
   "kr": "평범한 일인 줄 알고 갔더니"
  },
  "7": {
   "jp": "8994e10279",
   "kr": "다짜고짜 동굴로 끌고 갔어요."
  },
  "8": {
   "jp": "714810b654",
   "kr": "놈들은 필딘 왕가의 보물을 노리고 있었어요."
  },
  "9": {
   "jp": "91f652f1a6",
   "kr": "저더러 왕성 금고를 열게 할 속셈이었고요."
  },
  "10": {
   "jp": "4e9aa7959f",
   "kr": "이 멍청한 놈!"
  },
  "11": {
   "jp": "53e8237a46",
   "kr": "나한테 상의도 없이 손님하고 일을 진행하니까"
  },
  "12": {
   "jp": "1e2d26e381",
   "kr": "이런 꼴이 나는 거야."
  },
  "13": {
   "jp": "89aee16d23",
   "kr": "죄송합니다.",
   "auto": 1
  },
  "14": {
   "jp": "80a77420d7",
   "kr": "그래도 좀 납득이 안 가는군."
  },
  "15": {
   "jp": "54d8b7a951",
   "kr": "나 몰래 일을 맡은 적은 한 번도 없었는데"
  },
  "16": {
   "jp": "a96c1a657f",
   "kr": "어째서 이번에만 멋대로 손님을 만난 거냐?"
  },
  "17": {
   "jp": "b8e8f72f27",
   "kr": "이유를 듣지 않고는 찜찜해서 안 되겠어."
  },
  "18": {
   "jp": "bf20b47ba3",
   "kr": "그건…"
  },
  "19": {
   "jp": "8bf9681165",
   "kr": "도적이 루크레프 씨한테 보수를"
  },
  "20": {
   "jp": "2a2095efbc",
   "kr": "다이아몬드로 주겠다고 했죠?"
  },
  "21": {
   "jp": "a24a306292",
   "kr": "어?"
  },
  "22": {
   "jp": "75b86df9d0",
   "kr": "어떻게 그걸?"
  },
  "23": {
   "jp": "3531be3bff",
   "kr": "술집 아저씨한테 들었어요."
  },
  "24": {
   "jp": "20c9eeadb8",
   "kr": "루크레프 씨는 메리안 씨한테"
  },
  "25": {
   "jp": "51831b6437",
   "kr": "진짜 다이아몬드를 주고 싶었던 거죠?"
  },
  "26": {
   "jp": "1f121df41a",
   "kr": "당신… 나를 위해서?"
  },
  "27": {
   "jp": "dc49ce6d91",
   "kr": "미, 미안."
  },
  "28": {
   "jp": "03e6fb1c15",
   "kr": "일이 이렇게 될 줄은 몰랐어…"
  },
  "29": {
   "jp": "0791447a31",
   "kr": "루크레프."
  },
  "30": {
   "jp": "a182a23afa",
   "kr": "난 당신이 준 반지가 마음에 들어."
  },
  "31": {
   "jp": "0cd30c1d85",
   "kr": "하지만 유리알 반지 따위…"
  },
  "32": {
   "jp": "283e0652ff",
   "kr": "유리알이 아니야!"
  },
  "33": {
   "jp": "3f725cd009",
   "kr": "이건 다이아몬드야…"
  },
  "34": {
   "jp": "f9cb92bebc",
   "kr": "…허, 이거 전적으로 내 잘못이로군."
  },
  "35": {
   "jp": "637781d0ff",
   "kr": "루크레프한테 넉넉한 급료를 못 줬으니 말이야."
  },
  "36": {
   "jp": "129f5a48a6",
   "kr": "미안하네, 메리안."
  },
  "37": {
   "jp": "ee4fbc510b",
   "kr": "그렇지 않아요!"
  },
  "38": {
   "jp": "02adcb2d5c",
   "kr": "사부님께는 충분히 신세 지고 있어요."
  },
  "39": {
   "jp": "f5ce42779c",
   "kr": "아니, 아니.",
   "auto": 1
  },
  "40": {
   "jp": "3643d82d66",
   "kr": "다음 달부터는 조금이지만 급료를 올려 주마."
  },
  "41": {
   "jp": "fb697241e2",
   "kr": "너 같은 훌륭한 장인은 아껴야지."
  },
  "42": {
   "jp": "f0d71883b3",
   "kr": "어빈 일행에게 줄 보수도"
  },
  "43": {
   "jp": "e0aa773b93",
   "kr": "내가 알선소에 갖다 놓을 테니까."
  },
  "44": {
   "jp": "2571bbf42f",
   "kr": "어머, 사부님!"
  },
  "45": {
   "jp": "8386183042",
   "kr": "사부님이 아니지."
  },
  "46": {
   "jp": "1364fc4186",
   "kr": "어빈 일행한테 똑바로 인사해!"
  },
  "47": {
   "jp": "58e17ca440",
   "kr": "다음 달부터는"
  },
  "48": {
   "jp": "475d275556",
   "kr": "조금이지만 급료를 올려 주마."
  }
 }
}
