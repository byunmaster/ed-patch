  },
  "22": {
   "jp": "c717a6431c",
   "kr": "헤헤헤…"
  },
  "23": {
   "jp": "fce1c554ff",
   "kr": "우리가 안전한 곳으로 도망칠 때까지"
  },
  "24": {
   "jp": "9041412db1",
   "kr": "인질이 돼 줘야겠다."
  },
  "25": {
   "jp": "39191b9fbe",
   "kr": "꺄!"
  },
  "26": {
   "jp": "862c82ce3d",
   "kr": "어쩔 셈이야!?"
  },
  "27": {
   "jp": "202e68cfc7",
   "kr": "만약 나한테 이상한 짓을 하면"
  },
  "28": {
   "jp": "feb3f43cbc",
   "kr": "마일 님이 어디선가 나타나서"
  },
  "29": {
   "jp": "376de77681",
   "kr": "너희를 혼내 줄 테니까!"
  },
  "30": {
   "jp": "3379f4657a",
   "kr": "아야야～!!"
  },
  "31": {
   "jp": "2f47ecaa74",
   "kr": "뭐 하는 거야!"
  },
  "32": {
   "jp": "71f6fe8d54",
   "kr": "이게 숙녀를 대하는 방식이야!?"
  },
  "33": {
   "jp": "8e0c3e9e4e",
   "kr": "우하하하,"
  },
  "34": {
   "jp": "f33158bae6",
   "kr": "숙녀래!"
  },
  "35": {
   "jp": "9de23994b9",
   "kr": "숙녀든 아기든 알 바 아니지만,"
  },
  "36": {
   "jp": "080ad4434b",
   "kr": "자기 처지가 어떤지는 알아 둬야지."
  },
  "37": {
   "jp": "18caf273c5",
   "kr": "자, 잠깐, 뭐 하는 거야!"
  },
  "38": {
   "jp": "e593addbf5",
   "kr": "손대지 마!"
  },
  "39": {
   "jp": "6e7b59341a",
   "kr": "어이, 얌전히 있지 못해?"
  },
  "40": {
   "jp": "bbed6f7253",
   "kr": "나와레스 님이 기다리고 계신단 말이다."
  },
  "41": {
   "jp": "a6da2d5213",
   "kr": "놔 줘!"
  },
  "42": {
   "jp": "6ad6fc7cb9",
   "kr": "…도와줘!"
  },
  "43": {
   "jp": "28d8c5bb99",
   "kr": "마일 님…!!"
  },
  "44": {
   "jp": "48295c4758",
   "kr": "……응?"
  },
  "45": {
   "jp": "cdd190b87f",
   "kr": "거기 있는 게 누구냐?"
  },
  "46": {
   "jp": "ea3d61e4dd",
   "kr": "…들켰나."
  },
  "47": {
   "jp": "465c66e7a4",
   "kr": "뭐야?"
  },
  "48": {
   "jp": "77576b4cdb",
   "kr": "아직 젖비린내 나는 애송이잖아."
  },
  "49": {
   "jp": "1eccaaae4e",
   "kr": "정의의 사자인 척하다가 당하러 왔냐?"
  },
  "50": {
   "jp": "95f7791919",
   "kr": "당하러 왔나?"
  },
  "51": {
   "jp": "347b740435",
   "kr": "좀 쫄았나 본데."
  },
  "52": {
   "jp": "ae2d2ae00c",
   "kr": "우리가 해적 나와레스단인 줄 알면서"
  },
  "53": {
   "jp": "6f072d8b68",
   "kr": "겁도 없이 나온 거냐?"
  },
  "54": {
   "jp": "747909775e",
   "kr": "호오～, 배짱 좋군."
  },
  "55": {
   "jp": "39ea911991",
   "kr": "상대해 주지!"
  },
  "56": {
   "jp": "66ad6ed57c",
   "kr": "음,"
  },
  "57": {
   "jp": "c097fe581e",
   "kr": "뭐야, 이놈들은."
  },
  "58": {
   "jp": "95f9bd5350",
   "kr": "아아, 마일 님!"
  },
  "59": {
   "jp": "ed3ba3dc74",
   "kr": "역시 와 주셨네!"
  },
  "60": {
   "jp": "b1721be5b9",
   "kr": "너희, 각오하는 게 좋을걸."
  },
  "61": {
   "jp": "52c339b5b5",
   "kr": "마일 님은 강하다고!!"
  },
  "62": {
   "jp": "12ecc43fb6",
   "kr": "흥, 아는 사이냐?"
  },
  "63": {
   "jp": "85318d8000",
   "kr": "어쨌든"
  },
  "64": {
   "jp": "f05f1b9502",
   "kr": "분수도 모르는 애송이들이군."
  },
  "65": {
   "jp": "ea7c48e118",
   "kr": "해적 나와레스의 무서움을 똑똑히 알려 주마."
  },
  "66": {
   "jp": "8e313d7231",
   "kr": "녀석들, 해치워라!"
  },
  "67": {
   "jp": "f7a4af6df0",
   "kr": "마일 님～!"
  },
  "68": {
   "jp": "faaf4a2881",
   "kr": "……어째서?"
  },
  "69": {
   "jp": "a90112fcbf",
   "kr": "아이멜…"
  },
  "70": {
   "jp": "4d9caab025",
   "kr": "오, 오빠…"
  },
  "71": {
   "jp": "afe82d5b9b",
   "kr": "…어빈 오빠."
  },
  "72": {
   "jp": "d598738fad",
   "kr": "어빈, 이 사람이 아이멜이구나."
  },
  "73": {
   "jp": "53f1a6b272",
   "kr": "네 여동생이구나."
  },
  "74": {
   "jp": "900615f02b",
   "kr": "해냈어! 해냈잖아."
  },
  "75": {
   "jp": "967714b83c",
   "kr": "드디어 만났구나."
  },
  "76": {
   "jp": "09aff89978",
   "kr": "아이멜… 아이멜!"
  },
  "77": {
   "jp": "83647dcf81",
   "kr": "앗!",
   "auto": 1
  },
  "78": {
   "jp": "7fdcafba34",
   "kr": "선원 아저씨들이 신호를 보내는 것 같아."
  },
  "79": {
   "jp": "8a56a043e0",
   "kr": "무슨 일 있나?"
  },
  "80": {
   "jp": "2813ba7d8a",
   "kr": "…으으… 으으."
  },
  "81": {
   "jp": "2521eaf16d",
   "kr": "이봐, 이 녀석들아!!"
  },
  "82": {
   "jp": "6d73f75032",
   "kr": "일어나라!!"
  },
  "83": {
   "jp": "67f553086a",
   "kr": "…으으, 두목…"
  },
  "84": {
   "jp": "9495c14195",
   "kr": "이 멍청이들아!!"
  },
  "85": {
   "jp": "12e55410ab",
   "kr": "놈들이 도망쳤다!"
  },
  "86": {
   "jp": "4b6d60bcc4",
   "kr": "어서 쫓아라!!"
