{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02100C.BIN",
 "segments": {
  "0": {
   "jp": "8f7aea6bd4",
   "kr": "오오, 자네들이 짐을 운반해 주는 건가."
  },
  "1": {
   "jp": "5882730b98",
   "kr": "듀시스의 키트 마을에 있는 딸에게"
  },
  "2": {
   "jp": "2762a76e37",
   "kr": "소포를 부치려고 하네."
  },
  "3": {
   "jp": "7804d8436b",
   "kr": "자, 이 짐이야. 부탁하네."
  },
  "4": {
   "jp": "a3402f7b08",
   "kr": "어빈은 짐을 받았다."
  },
  "5": {
   "jp": "9a425176b2",
   "kr": "딸 이름은 리플."
  },
  "6": {
   "jp": "d8eb8e1289",
   "kr": "대학 연수생으로 모스 호수 조사를"
  },
  "7": {
   "jp": "639523e9a2",
   "kr": "하고 있어."
  },
  "8": {
   "jp": "27aaf24538",
   "kr": "자랑스러운 딸이야."
  },
  "9": {
   "jp": "e1aec0f5e5",
   "kr": "그럼 부탁하네. 부탁드립니다."
  },
  "10": {
   "jp": "233ff9a868",
   "kr": "키트 마을에서 딸을 만나면"
  },
  "11": {
   "jp": "9d34b9a37b",
   "kr": "아버지는 변함없이 건강하다고"
  },
  "12": {
   "jp": "f71f4de52b",
   "kr": "전해 주게."
  },
  "13": {
   "jp": "746e3d07bb",
   "kr": "아아, 전에는 신세 졌지."
  },
  "14": {
   "jp": "4bcb43e8ba",
   "kr": "딸에게서 감사 편지가 왔어."
  },
  "15": {
   "jp": "4750c64e3d",
   "kr": "자네들을 만나면"
  },
  "16": {
   "jp": "f5933ba2ec",
   "kr": "안부 전해 달라더군."
  },
  "17": {
   "jp": "9c8cbe2912",
   "kr": "딸이 낯선 땅에서 애쓰고 있다고 생각하면"
  },
  "18": {
   "jp": "88ce7a1e3e",
   "kr": "자랑스러운 동시에"
  },
  "19": {
   "jp": "4784e9908e",
   "kr": "나도 아직 더 힘내야겠다는 생각이 들어."
  },
  "20": {
   "jp": "548e410d80",
   "kr": "아니, 정말이야."
  },
  "21": {
   "jp": "b1d6d5a61f",
   "kr": "자네들, 짐이 꽤 많군."
  },
  "22": {
   "jp": "750d8941e4",
   "kr": "좀 줄여 오는 게 좋겠어."
  }
 }
}
