 "segments": {
  "0": {
   "jp": "5ad020afcb",
   "kr": "페르나"
  },
  "1": {
   "jp": "b8784eece9",
   "kr": "코레"
  },
  "2": {
   "jp": "8d2a527a4f",
   "kr": "하루"
  },
  "3": {
   "jp": "56c8785eb9",
   "kr": "프리트"
  },
  "4": {
   "jp": "87a5230a56",
   "kr": "루카"
  },
  "5": {
   "jp": "9767bdcf12",
   "kr": "라브로아"
  },
  "6": {
   "jp": "2396d1483d",
   "kr": "나콜"
  },
  "7": {
   "jp": "31237f83d4",
   "kr": "볼게이드"
  },
  "8": {
   "jp": "2e7bad5dbb",
   "kr": "놈들, 요구를 안 들어주면"
  },
  "9": {
   "jp": "5b1f198a9c",
   "kr": "용광로를 부수겠다고 하더라고."
  },
  "10": {
   "jp": "8145aa6273",
   "kr": "폭발하면 큰일이 나."
  },
  "11": {
   "jp": "da5ac28249",
   "kr": "어떻게든 해야 하는데…"
  },
  "12": {
   "jp": "831104f8a7",
   "kr": "큰일 났군…"
  },
  "13": {
   "jp": "1b7c47632d",
   "kr": "사교도 놈들, 무슨 짓을 하려는 거야."
  },
  "14": {
   "jp": "890c515648",
   "kr": "사교도 놈들이 루카를 인질로 잡았어!"
  },
  "15": {
   "jp": "b69f1855d6",
   "kr": "어쩜 저리 비열한 놈들이 다 있어!"
  },
  "16": {
   "jp": "efd1fb72bc",
   "kr": "어디야?!"
  },
  "17": {
   "jp": "88f3a77751",
   "kr": "제５용광로야."
  },
  "18": {
   "jp": "abde969abb",
   "kr": "제５용광로?"
  },
  "19": {
   "jp": "19fdefca03",
   "kr": "가장 안쪽 용광로 말이죠?"
  },
  "20": {
   "jp": "c3f8c2f40e",
   "kr": "그래."
  },
  "21": {
   "jp": "2e7bad5dbb",
   "kr": "놈들, 요구를 안 들어주면"
  },
  "22": {
   "jp": "5b1f198a9c",
   "kr": "용광로를 부수겠다고 하더라고."
  },
  "23": {
   "jp": "8145aa6273",
   "kr": "폭발하면 큰일이 나."
  },
  "24": {
   "jp": "da5ac28249",
   "kr": "어떻게든 해야 하는데…"
  },
  "25": {
   "jp": "3c60209619",
   "kr": "거듭 호소했음에도"
  },
  "26": {
   "jp": "f945b5c3a7",
   "kr": "기아의 대응은 우리에게 호의적이지 않은 듯하다."
  },
  "27": {
   "jp": "711aa82a1c",
   "kr": "우리는 강경 수단을 쓰기로 했다."
  },
  "28": {
   "jp": "d686510a74",
   "kr": "제멋대로 지껄이지 마!"
  },
  "29": {
   "jp": "4562ccb6e1",
   "kr": "루카를 놔줘!"
  },
  "30": {
   "jp": "da23ccb8e6",
   "kr": "더 견고하게 무장하기 위해"
  },
  "31": {
   "jp": "90b979dff7",
   "kr": "이곳에서 채굴된다는 레어메탈이 필요하다."
  },
  "32": {
   "jp": "05f8b0bff6",
   "kr": "모르는군."
  },
  "33": {
   "jp": "0f569487a9",
   "kr": "레어메탈은 좀처럼 발견되지 않는 금속이야."
  },
  "34": {
   "jp": "4969e91105",
   "kr": "여기를 차지해 봤자 찾을 수 있을 리 없어!"
  },
  "35": {
   "jp": "9e838959df",
   "kr": "찾아내 보이겠다."
  },
  "36": {
   "jp": "ebb69ecfe9",
   "kr": "우리의 이상을 위해"
  },
  "37": {
   "jp": "80eb63e521",
   "kr": "광산과 제철소를 넘겨받겠다."
  },
  "38": {
   "jp": "a9d4a1d4c0",
   "kr": "거부하면 모조리 파괴한다."
  },
  "39": {
   "jp": "1c49c463a3",
   "kr": "협박이 아니라는 증거로"
  },
  "40": {
   "jp": "197ed071b3",
   "kr": "이 제５용광로를 파괴해 주지."
  },
  "41": {
   "jp": "1bea606865",
   "kr": "그만둬!"
  },
  "42": {
   "jp": "5f4a79473d",
   "kr": "대형 사고가 날 거야!"
  },
  "43": {
   "jp": "291b5c3552",
   "kr": "짖어라, 짖어."
  },
  "44": {
   "jp": "5764ef9146",
   "kr": "희생이 클수록 너희는 고분고분해진다."
  },
  "45": {
   "jp": "e02fbe8d54",
   "kr": "그것이 이상을 갖지 못한 자의 슬픈 본성이다."
  },
  "46": {
   "jp": "1f65b5c50e",
   "kr": "하지만 나도 비정하지는 않다."
  },
  "47": {
   "jp": "e15995e78a",
   "kr": "오늘은 본보기로"
  },
  "48": {
   "jp": "994fed8af9",
   "kr": "용광로 하나로 봐주겠다."
  },
  "49": {
   "jp": "ce1c0dfa21",
   "kr": "위험하다."
  },
  "50": {
   "jp": "ad15b392dc",
   "kr": "물러나 있어라."
  },
  "51": {
   "jp": "3ce3a3fb8e",
   "kr": "으윽…"
  },
  "52": {
   "jp": "e704fa2aff",
   "kr": "페르나 씨!"
  },
  "53": {
   "jp": "4d0531b9ec",
   "kr": "작업원 상대도 질렸군."
  },
  "54": {
   "jp": "6fde91628a",
   "kr": "해라!"
  },
  "55": {
   "jp": "01f2975d6a",
   "kr": "안 돼!"
  },
  "56": {
   "jp": "1baca89556",
   "kr": "그 이상 출력을 올리면…!"
  },
  "57": {
   "jp": "a941386936",
   "kr": "얌전히 있었으면 좋았을 것을."
  },
  "58": {
   "jp": "5703e9a8dc",
   "kr": "분명 이 꼬마는 루티스의 동생이었지."
  },
  "59": {
   "jp": "089db68d32",
   "kr": "그렇다면 우리의 이상을 위해"
  },
  "60": {
   "jp": "c3d65d5cda",
   "kr": "순교하는 것도 기쁨이겠지."
  },
  "61": {
   "jp": "2403f7cb94",
   "kr": "눈엣가시인 루티스에 대한 본보기도 된다."
  },
  "62": {
   "jp": "a007083653",
   "kr": "이봐, 이봐."
  },
  "63": {
   "jp": "a04e5f7f40",
   "kr": "잠깐 기다려. 이봐."
  },
  "64": {
   "jp": "dff44caf2a",
   "kr": "어디 가려는 거야."
  },
  "65": {
   "jp": "61ee28d13b",
   "kr": "상대는 사교도 볼게이드라고."
  },
  "66": {
   "jp": "506c5d9bff",
   "kr": "네가 감당할 놈이 아니야."
  },
  "67": {
   "jp": "942d3ee0a8",
   "kr": "됐으니까 이쪽으로 와."
  },
  "68": {
   "jp": "3635c9fc3a",
   "kr": "자, 잠깐만요."
  },
  "69": {
   "jp": "83dd25d5b8",
   "kr": "놔 주세요!"
  },
  "70": {
   "jp": "049605fd11",
   "kr": "저 녀석이…"
  },
  "71": {
   "jp": "38788a7a03",
   "kr": "볼게이드냐!"
  },
  "72": {
   "jp": "49e5d5fcfb",
   "kr": "그러니까 물러나 있으라고!"
  }
 }
}
