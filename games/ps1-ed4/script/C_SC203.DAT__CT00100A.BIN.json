{
 "archive": "/C/SC203.DAT",
 "member": "..\\BIN\\CT00100A.BIN",
 "segments": {
  "0": {
   "jp": "1d7a2d70e1",
   "kr": "어머, 너…"
  },
  "1": {
   "jp": "f905bb5a86",
   "kr": "더글라스!"
  },
  "2": {
   "jp": "eab0187368",
   "kr": "더글라스 아니니?"
  },
  "3": {
   "jp": "cea577b9c5",
   "kr": "어머니…"
  },
  "4": {
   "jp": "201a936d58",
   "kr": "어머, 그립구나!"
  },
  "5": {
   "jp": "a9a3feebdb",
   "kr": "여전히 덩치가 크구나!!"
  },
  "6": {
   "jp": "764393f1ef",
   "kr": "잘 지냈니?"
  },
  "7": {
   "jp": "2e0870ce0a",
   "kr": "어머니야말로…"
  },
  "8": {
   "jp": "5e016ea4d3",
   "kr": "더글라스, 어머님이야?"
  },
  "9": {
   "jp": "e2b8e38b75",
   "kr": "아니, 진짜 어머니는 아니지만"
  },
  "10": {
   "jp": "b14eb16037",
   "kr": "어머니나 다름없어."
  },
  "11": {
   "jp": "3d91a4f1fe",
   "kr": "뭐야, 그게."
  },
  "12": {
   "jp": "46617b2e79",
   "kr": "옛날에 말이야."
  },
  "13": {
   "jp": "ca7f29cc4d",
   "kr": "나는 카스톨이라는 달인에게 검을 배웠어."
  },
  "14": {
   "jp": "de9ca87d17",
   "kr": "이분이 그 카스톨의 부인이야."
  },
  "15": {
   "jp": "01d755a0a6",
   "kr": "고아였던 나를 키워 준,"
  },
  "16": {
   "jp": "88c1a5cd72",
   "kr": "소중한 어머니야."
  },
  "17": {
   "jp": "df1361993f",
   "kr": "얘도 참, 더글라스."
  },
  "18": {
   "jp": "a1f09ca9eb",
   "kr": "궁상맞은 얘기는 그만하렴."
  },
  "19": {
   "jp": "36282fac11",
   "kr": "와"
  },
  "20": {
   "jp": "fbcb163a47",
   "kr": "는 찾았니?"
  },
  "21": {
   "jp": "87a94e91d1",
   "kr": "…이제 그 수수께끼를 풀어야 하는데…"
  },
  "22": {
   "jp": "49fe7f29be",
   "kr": "무슨 일이니?"
  },
  "23": {
   "jp": "5aa60e66f7",
   "kr": "나한테 무슨 볼일이라도 있니?"
  },
  "24": {
   "jp": "ebe3a16d1a",
   "kr": "맥스 씨 심부름으로 왔어요."
  },
  "25": {
   "jp": "7297bf8e90",
   "kr": "맥스가?"
  },
  "26": {
   "jp": "16a56e9f46",
   "kr": "…아, 그 애 얘기라면 몇 번이나 들었어."
  },
  "27": {
   "jp": "e3ef1633ff",
   "kr": "하지만 난 여기를 떠날 생각 없다."
  },
  "28": {
   "jp": "6d2f61453b",
   "kr": "맥스 씨는"
  },
  "29": {
   "jp": "f845dbd3e8",
   "kr": "노라 씨를 걱정하고 있어요."
  },
  "30": {
   "jp": "b921f490b1",
   "kr": "그 애는 착한 아이니까."
  },
  "31": {
   "jp": "84eec93095",
   "kr": "하지만."
  },
  "32": {
   "jp": "a44af81a19",
   "kr": "그렇다고 이것만은 들어줄 수 없구나."
  },
  "33": {
   "jp": "1d1f7435b2",
   "kr": "누가 뭐라 하든 난 절대 여기를 안 떠난다."
  },
  "34": {
   "jp": "944edcd93f",
   "kr": "맥스에게 전해 주렴."
  },
  "35": {
   "jp": "9f0869b7e3",
   "kr": "나는 죽을 때까지 이 마을에 있겠다고."
  },
  "36": {
   "jp": "dae989fb1b",
   "kr": "저쪽 다리 난간을 살펴보렴."
  },
  "37": {
   "jp": "6dca2ca1d2",
   "kr": "카스톨의 편지와 열쇠가 숨겨져 있으니."
  },
  "38": {
   "jp": "85787ca448",
   "kr": "그걸 가지고 검을 찾아오렴."
  },
  "39": {
   "jp": "6a36e04166",
   "kr": "더글라스, 이상하게 심각한 얼굴이구나."
  },
  "40": {
   "jp": "c1dbdc46cb",
   "kr": "뭐 하러 여기 왔니?"
  },
  "41": {
   "jp": "1f9daf1e20",
   "kr": "…저기, 어머니."
  },
  "42": {
   "jp": "0e1fc7ecb0",
   "kr": "들어 줬으면 하는 게 있어."
  },
  "43": {
   "jp": "59d83a7d9f",
   "kr": "맥스 편지, 읽었어?"
  },
  "44": {
   "jp": "2a9aeab3b7",
   "kr": "뭐라고!"
  },
  "45": {
   "jp": "60fbfbb5ef",
   "kr": "너도 맥스랑 한패냐!"
  },
  "46": {
   "jp": "3d5fd4d7e6",
   "kr": "다들 몰려서 늙은이 취급하지 마라!"
  },
  "47": {
   "jp": "2dbb5da4dd",
   "kr": "여전하네, 어머니는."
  },
  "48": {
   "jp": "2a9658249a",
   "kr": "그 기운이면 걱정 없겠어."
  },
  "49": {
   "jp": "e9bbb0fded",
   "kr": "당연하지!"
  },
  "50": {
   "jp": "ef59d8b004",
   "kr": "난 너보다 젊다."
  },
  "51": {
   "jp": "b2c232f656",
   "kr": "하하하."
  },
  "52": {
   "jp": "e5c037d028",
   "kr": "하지만 어머니."
  },
  "53": {
   "jp": "7c2e443ce3",
   "kr": "나는 맥스와 달리"
  },
  "54": {
   "jp": "9155ac9a91",
   "kr": "몸 쪽은 걱정 안 하지만…"
  },
  "55": {
   "jp": "588ea04fe3",
   "kr": "다른 걸 걱정하고 있어."
  },
  "56": {
   "jp": "558e38a826",
   "kr": "…무슨 소리니?"
  },
  "57": {
   "jp": "cf5f53cd9c",
   "kr": "아버지에게 의리를 지키고 있는 거지?"
  },
  "58": {
   "jp": "6572876aa5",
   "kr": "이 마을에서 아버지가 남긴 걸"
  },
  "59": {
   "jp": "00516248a4",
   "kr": "지키려는 거지?"
  },
  "60": {
   "jp": "d7b803ed93",
   "kr": "…더글라스."
  },
  "61": {
   "jp": "5e6202c923",
   "kr": "얄미운 아이라니까, 이 녀석은."
  },
  "62": {
   "jp": "1b42c9a292",
   "kr": "옛날부터 눈치가 빨랐지."
  },
  "63": {
   "jp": "4a4d22e0c5",
   "kr": "…그래, 그 바보 같은 남편."
  },
  "64": {
   "jp": "fb53b198d5",
   "kr": "쓸데없는 걸 남기고 갔지."
  },
  "65": {
   "jp": "c3b531425f",
   "kr": "『신검 휘페리온』이라니,"
  },
  "66": {
   "jp": "66b4c70d17",
   "kr": "혀가 꼬일 것 같은 이름까지 붙여서."
  },
  "67": {
   "jp": "463fe2fe61",
   "kr": "제일 강한 아들에게 주라니."
  },
  "68": {
   "jp": "558d82a8e4",
   "kr": "말도 안 되는 소리를 유언으로 남기고 갔어."
  },
  "69": {
   "jp": "6322770dd6",
   "kr": "제일 강한 아들에게?"
  },
  "70": {
   "jp": "5e43518d89",
   "kr": "그래."
  },
  "71": {
   "jp": "426044062f",
   "kr": "너희의 졸업을 지켜보지 못했으니"
  },
  "72": {
   "jp": "97564a1c99",
   "kr": "마지막으로 억지 난제를 남긴 거야."
  },
  "73": {
   "jp": "2672a3d4d9",
   "kr": "졸업 시험 삼아 그랬겠지만."
  },
  "74": {
   "jp": "e88259174c",
   "kr": "위험한 곳에서 검을 가져오라는 거야."
  },
  "75": {
   "jp": "6dd5a0cb01",
   "kr": "정말 말도 안 돼."
  },
  "76": {
   "jp": "0a58016ceb",
   "kr": "…재밌군!!"
  },
  "77": {
   "jp": "acebe72b87",
   "kr": "조금도 재미없어!"
  },
  "78": {
   "jp": "61786ba8ee",
   "kr": "검 같은 걸 가지러 가서"
  },
  "79": {
   "jp": "9ea4aa0185",
   "kr": "다치기라도 하면 어쩔 거니."
  },
  "80": {
   "jp": "03ee9d2e27",
   "kr": "굳이 위험한 곳에 갈 필요는 없다."
  },
  "81": {
   "jp": "9091c371b8",
   "kr": "아니, 난 굳이 가고 싶은데."
  },
  "82": {
   "jp": "75873d26e1",
   "kr": "어머니, 나한테 시켜 줘."
  },
  "83": {
   "jp": "1a982eefa3",
   "kr": "…"
  },
  "84": {
   "jp": "8692680cd8",
   "kr": "나도 아버지의 가르침을 끝까지 받고 싶어."
  },
  "85": {
   "jp": "a744f5fb33",
   "kr": "아이고, 어쩔 수 없는 애구나."
  },
  "86": {
   "jp": "52bd65aac8",
   "kr": "…알았다."
  },
  "87": {
   "jp": "777cd9554b",
   "kr": "나도 사실은"
  },
  "88": {
   "jp": "f7d8bec806",
   "kr": "네가 오길 기다렸는지도 몰라."
  },
  "89": {
   "jp": "01d57c4515",
   "kr": "네가 제일 바보 같은 아들이니까."
  },
  "90": {
   "jp": "7ba18164f2",
   "kr": "…카스톨을 쏙 빼닮은."
  },
  "91": {
   "jp": "67c73e067c",
   "kr": "고마워.",
   "auto": 1
  },
  "92": {
   "jp": "dae989fb1b",
   "kr": "저쪽 다리 난간을 살펴보렴."
  },
  "93": {
   "jp": "6dca2ca1d2",
   "kr": "카스톨의 편지와 열쇠가 숨겨져 있으니."
  },
  "94": {
   "jp": "85787ca448",
   "kr": "그걸 가지고 검을 찾아오렴."
  },
  "95": {
   "jp": "4abbe73eff",
   "kr": "더글라스."
  },
  "96": {
   "jp": "b3ce70eec0",
   "kr": "해냈어, 어머니!"
  },
  "97": {
   "jp": "7d209e7d5d",
   "kr": "아버지의 검이야!!"
  },
  "98": {
   "jp": "93f9b48417",
   "kr": "…어머나."
  },
  "99": {
   "jp": "bf56f9cd03",
   "kr": "보여 줘, 더글라스."
  },
  "100": {
   "jp": "f6bca41636",
   "kr": "을(를) 건넸다.",
   "auto": 1
  },
  "101": {
   "jp": "60c54ed8c3",
   "kr": "아, 이게 그 사람의 검이구나."
  },
  "102": {
   "jp": "dedf9bb58c",
   "kr": "카스톨은 이 검 속에 있는 거로구나…"
  },
  "103": {
   "jp": "cea577b9c5",
   "kr": "어머니…"
  },
  "104": {
   "jp": "54efa87b5d",
   "kr": "고마워, 더글라스."
  },
  "105": {
   "jp": "40365c59b8",
   "kr": "이걸로 나도 짐을 덜었구나."
  },
  "106": {
   "jp": "63d39ae42a",
   "kr": "을(를) 가지고 가렴."
  },
  "107": {
   "jp": "a24a306292",
   "kr": "어?"
  },
  "108": {
   "jp": "27725b19cc",
   "kr": "카스톨이 너를 위해 남긴 거란다."
  },
  "109": {
   "jp": "26bb17cfff",
   "kr": "자, 받으렴."
  },
  "110": {
   "jp": "cab8e669f7",
   "kr": "카스톨이 주는 졸업장이야."
  },
  "111": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다.",
   "auto": 1
  },
  "112": {
   "jp": "211841f1e8",
   "kr": "아, …느긋하게 살고 싶어졌네."
  },
  "113": {
   "jp": "ae6f05b544",
   "kr": "맥스는 나를 받아 줄까?"
  },
  "114": {
   "jp": "344e457dfe",
   "kr": "물론이지."
  },
  "115": {
   "jp": "1621047f2d",
   "kr": "엄청 좋아할 거야."
  },
  "116": {
   "jp": "db7fd65c99",
   "kr": "위험한 곳에서"
  },
  "117": {
   "jp": "45cb9b7c88",
   "kr": "검을 가져오라는 거야."
  }
 }
}
