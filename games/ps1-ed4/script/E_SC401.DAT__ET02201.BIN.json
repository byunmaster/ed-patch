  },
  "10": {
   "jp": "a38cb46a7c",
   "kr": "승려"
  },
  "11": {
   "jp": "0c50896447",
   "kr": "파블로"
  },
  "12": {
   "jp": "c379aae702",
   "kr": "로네"
  },
  "13": {
   "jp": "c379aae702",
   "kr": "로네"
  },
  "14": {
   "jp": "d4c7a438e3",
   "kr": "이 방을 쓰거라."
  },
  "15": {
   "jp": "f4c037946c",
   "kr": "마일과 섀넌의 고향에는 내일이라도 사람을 보내 알리마."
  },
  "16": {
   "jp": "ba33f16edb",
   "kr": "당분간 머물면서 우선 피로를 풀어라."
  },
  "17": {
   "jp": "98f45b5d1c",
   "kr": "그럼 나는 방으로 돌아가 있으마."
  },
  "18": {
   "jp": "cc3df9156a",
   "kr": "여독을 충분히 풀거라."
  },
  "19": {
   "jp": "a10c06e81d",
   "kr": "오, 어빈.",
   "auto": 1
  },
  "20": {
   "jp": "920036d795",
   "kr": "필시 심심해서 돌아다니고 있었군?"
  },
  "21": {
   "jp": "d03f7ce8d1",
   "kr": "그렇다네."
  },
  "22": {
   "jp": "e28d74def2",
   "kr": "자네들 덕분에 카베사와 쿠엘포가"
  },
  "23": {
   "jp": "cf40f58cd7",
   "kr": "정신전에 돌아온 것을 축하하네."
  },
  "24": {
   "jp": "8009788124",
   "kr": "신보 반환식을 거행하기로 했네."
  },
  "25": {
   "jp": "5036b1c17d",
   "kr": "준비가 되는 대로 부르러 보낼 걸세."
  },
  "26": {
   "jp": "d31b470e97",
   "kr": "꼭 참석해 주게."
  },
  "27": {
   "jp": "2669aad9a9",
   "kr": "목적지에 도착해서 마음이 편해져서일까."
  },
  "28": {
   "jp": "3512012a2f",
   "kr": "정말 피곤이 몰려오는 것 같아."
  },
  "29": {
   "jp": "e0763c65e4",
   "kr": "그래. 긴 여행이었으니까."
  },
  "30": {
   "jp": "d0779765cc",
   "kr": "오빠.",
   "auto": 1
  },
  "31": {
   "jp": "d7a5a8ced7",
   "kr": "나, 잠깐 쉬었다가 루티스 씨 병문안을"
  },
  "32": {
   "jp": "16cf086e42",
   "kr": "가기로 할게."
  },
  "33": {
   "jp": "83235b444e",
   "kr": "루티스 씨 상태"
  },
  "34": {
   "jp": "9547bc5da0",
   "kr": "꽤 안정된 것 같아…"
  },
  "35": {
   "jp": "5bc4302210",
   "kr": "…다행이다."
  },
  "36": {
   "jp": "e2a3e90278",
   "kr": "어빈. 건강해 보여 안심했다."
  },
  "37": {
   "jp": "154b6c8e6e",
   "kr": "이 ８년 사이에 몰라보게 사내다워졌구나."
  },
  "38": {
   "jp": "94d4ca567a",
   "kr": "역시 레뮤라스가 키운 아이답구나."
  },
  "39": {
   "jp": "b039d403f2",
   "kr": "잠시 쉬어 두어라."
  },
  "40": {
   "jp": "2c67884dac",
   "kr": "하긴 심심해서 견딜 수 없거든"
  },
  "41": {
   "jp": "d95c220350",
   "kr": "발크드를 구경해 보는 것도 좋겠지."
  },
  "42": {
   "jp": "5266a86834",
   "kr": "카테드랄과는 조금 다르지만"
  },
  "43": {
   "jp": "40cd931ddf",
   "kr": "너에게는 그리운 신전의 분위기가"
  },
  "44": {
   "jp": "ca85f5d885",
   "kr": "있을 테니 말이다."
  },
  "45": {
   "jp": "1a982eefa3",
   "kr": "……"
  },
  "46": {
   "jp": "22d46ac419",
   "kr": "…!?"
  },
  "47": {
   "jp": "1f0c6a4d87",
   "kr": "아… 어빈… 여기는?"
  },
  "48": {
   "jp": "4d05850c1d",
   "kr": "발크드다."
  },
  "49": {
   "jp": "5eb92c9fc0",
   "kr": "그래… 무사히 도착했구나."
  },
  "50": {
   "jp": "07b07b0401",
   "kr": "신보는 전했어."
  },
  "51": {
   "jp": "b0a8c13988",
   "kr": "네가 그런 말을 해 줄 줄은"
  },
  "52": {
   "jp": "1ac1a89a00",
   "kr": "생각도 못 했어."
  },
  "53": {
   "jp": "6190ce517f",
   "kr": "그렇겠지."
  },
  "54": {
   "jp": "531c2efe4a",
   "kr": "…하지만 오크툼 신도라고 해서 모두가"
  },
  "55": {
   "jp": "f2fc00e293",
   "kr": "볼게이드 같은 놈은 아니야."
  },
  "56": {
   "jp": "d29c2b380f",
   "kr": "베리어스와 볼게이드는 이상을 이용해 신도들을 조종하고,"
  },
  "57": {
   "jp": "cb3934c0e8",
   "kr": "본래의 목적을 잊게 만들고 있는 거야."
  },
  "58": {
   "jp": "b4070618f7",
   "kr": "그래, 나도 알아."
  },
  "59": {
   "jp": "b4dc11c997",
   "kr": "아무튼 저주가 풀릴 때까지 안정을 취하고 있어."
  },
  "60": {
   "jp": "ee7a2ee88f",
   "kr": "미안해."
  },
  "61": {
   "jp": "3d1277fe93",
   "kr": "루티스는 조용히 눈을 감고 있다."
  },
  "62": {
   "jp": "a02662d94d",
   "kr": "여기 있기만 해도"
  },
  "63": {
   "jp": "9158c83e12",
   "kr": "내 몸이 회복되는 게 느껴져."
  },
  "64": {
   "jp": "c128ca284d",
   "kr": "벌써 당장이라도 걸을 수 있을 것 같아."
  },
  "65": {
   "jp": "b7c7135ead",
   "kr": "어떻게든 될 것 같네요."
  },
  "66": {
   "jp": "1d5d17c918",
   "kr": "저주라고는 해도 과학적으로 규명할 수 있는 종류입니다."
  },
  "67": {
   "jp": "d3095bcaaf",
   "kr": "마법으로 뇌에 영향을 주어"
  },
  "68": {
   "jp": "a033dde19d",
   "kr": "편두통이 계속되게 하는 거죠."
  },
  "69": {
   "jp": "b2ffe33bd7",
   "kr": "시간은 좀 걸리겠지만"
  },
  "70": {
   "jp": "2f679eb76e",
   "kr": "다행히 발크드 안에는 탁기를 막는 결계가"
  },
  "71": {
   "jp": "43e5cb2a2e",
   "kr": "쳐져 있으니 여기서 요양하면 괜찮아요."
  },
  "72": {
   "jp": "1e11d9f0b6",
   "kr": "당분간 요양하면 특별한 약도 필요 없을 겁니다."
  },
  "73": {
   "jp": "721b1dfcc2",
   "kr": "안심하세요. 금방 좋아질 거예요."
  },
  "74": {
   "jp": "7f3d7db9ba",
   "kr": "젊으니 회복도 빠르지."
  },
  "75": {
   "jp": "8f886fa861",
   "kr": "젊다는 건 좋군. 팔팔하니까."
  },
  "76": {
   "jp": "43a8918596",
   "kr": "이런, 성직자답지 못한 발언을."
  },
  "77": {
   "jp": "09a5b6ce15",
   "kr": "…실례."
  },
  "78": {
   "jp": "da2a3d969c",
   "kr": "실례합니다.",
   "auto": 1
  },
  "79": {
   "jp": "3e5bd2e01e",
   "kr": "예배당에서 반환식 준비가 끝났습니다."
  },
  "80": {
   "jp": "66b742d343",
   "kr": "어빈 씨, 아이멜 씨."
  },
  "81": {
   "jp": "3b8b8533fe",
   "kr": "예배당으로 와 주십시오."
  },
  "82": {
   "jp": "b4a5126cf4",
   "kr": "여기에는 여러 서적이 갖춰져 있지만"
  },
  "83": {
   "jp": "e64175aafe",
   "kr": "정작 발두스 신과 오크툼 신에 관한 전승이"
  },
  "84": {
   "jp": "c9747c10eb",
   "kr": "빠져 있단 말이지."
  },
  "85": {
   "jp": "818e9a3070",
   "kr": "중요한 서적은 모두"
  },
  "86": {
   "jp": "7fb6660889",
   "kr": "카테드랄 쪽에 모아 두었으니까."
  },
  "87": {
   "jp": "4b126595f2",
   "kr": "카테드랄이 습격을 받아"
  },
  "88": {
   "jp": "000b6e401b",
   "kr": "오크툼 신도들 손에 넘어가 버린 게"
  },
  "89": {
   "jp": "cd10d12188",
   "kr": "정말 안타깝기 짝이 없어."
  },
  "90": {
   "jp": "40fc39d649",
   "kr": "카베사와 쿠엘포가 돌아왔다지?"
  },
  "91": {
   "jp": "2a38b7dc0e",
   "kr": "반환식을 한다니 거기서 볼 수 있겠군."
  },
  "92": {
   "jp": "763177c8c5",
   "kr": "이거 기대되는걸."
  },
  "93": {
   "jp": "00e6765ae8",
   "kr": "흐음."
  },
  "94": {
   "jp": "5f45a34260",
   "kr": "분명 카베사와 쿠엘포는 정신전이"
  },
  "95": {
   "jp": "b3d7945ec9",
   "kr": "예로부터 소유하고 있던 것…"
  },
  "96": {
   "jp": "646dd03508",
   "kr": "하지만… 나머지 신보는…?"
  },
  "97": {
   "jp": "2981a6512e",
   "kr": "모르겠군."
  },
  "98": {
   "jp": "e73e50eeb3",
   "kr": "남은 네 개의 신보는 대체 어디에 있을까?"
  },
  "99": {
   "jp": "362d4e68a6",
   "kr": "여기에는 기본적인 역사서뿐이지만"
  },
  "100": {
   "jp": "fa30531b77",
   "kr": "역사에 관심이 있으신가요?"
  },
  "101": {
   "jp": "93d576479c",
   "kr": "여기서 만난 것도 무슨 인연이지요."
  },
  "102": {
   "jp": "2b4d683671",
   "kr": "모처럼이니"
  },
  "103": {
   "jp": "767c0725de",
   "kr": "우리나라의 신화 체계를 간단히 말씀드리지요."
  },
  "104": {
   "jp": "a9ff57518a",
   "kr": "고대 엘 필딘의 전승에서는"
  },
  "105": {
   "jp": "f22b0e81f4",
   "kr": "발두스 신과 오크툼 신이 두 대신으로서 정점에 있고,"
  },
  "106": {
   "jp": "3689613600",
   "kr": "그 아래에 정령신 둘가께서 계십니다."
  },
  "107": {
   "jp": "7b2b9ee354",
   "kr": "또한 그 정령신 둘가가 거느리는"
  },
  "108": {
   "jp": "b3575b4ee5",
   "kr": "이둔, 네프티스, 잘, 스코티아의 사대 정령이"
  },
  "109": {
   "jp": "86f2372352",
   "kr": "지상의 질서를 지키고 계신다고 합니다."
  },
  "110": {
   "jp": "313ab570fe",
   "kr": "요즘 근시가 심해진 모양이군."
  },
  "111": {
   "jp": "3cd801aeba",
   "kr": "방심하면 금세 등이 굽는다니까."
  },
  "112": {
   "jp": "c0a66152ca",
   "kr": "안 되지, 안 되지."
  },
  "113": {
   "jp": "7f16fe5eb8",
   "kr": "앗, 어빈 씨."
  },
  "114": {
   "jp": "8e0592e4d5",
   "kr": "언제 손님이 오셔도 되도록"
  },
  "115": {
   "jp": "ee8b772c4a",
   "kr": "침대를 정리하고 있었어요."
  },
  "116": {
   "jp": "b19c309a7f",
   "kr": "여기 신세를 지고 있는데"
  },
  "117": {
   "jp": "d7e07f2949",
   "kr": "제가 도울 수 있는 일은"
  },
  "118": {
   "jp": "e7065d9bac",
   "kr": "이런 것밖에 없으니까요."
  },
  "119": {
   "jp": "f0ed135ffe",
   "kr": "저는요, 저 예배당 스테인드글라스 같은"
  },
  "120": {
   "jp": "f8fc3419d9",
   "kr": "멋진 스테인드글라스를 만드는 장인이"
  },
  "121": {
   "jp": "eeb7493d42",
   "kr": "되는 게 꿈이에요."
  },
  "122": {
   "jp": "2f67a36f9d",
   "kr": "열심히 공부해서"
  },
  "123": {
   "jp": "5f32137ab7",
   "kr": "언젠가 꼭 멋진 스테인드글라스를"
  },
  "124": {
   "jp": "731e46a4d2",
   "kr": "만들어 보일 거예요."
  },
  "125": {
   "jp": "722a08aae1",
   "kr": "《진실의 섬》"
  },
  "126": {
   "jp": "0efcdcfd42",
   "kr": "듀시스 지방은 도크스 북동쪽에 있고"
  },
  "127": {
   "jp": "d8508c8792",
   "kr": "그 섬은 위선의 바다에 떠 있다."
  },
  "128": {
   "jp": "4b3ccb02aa",
   "kr": "소소한 진실을 지키는 작은 섬이니라."
  },
  "129": {
   "jp": "ea22275748",
   "kr": "발두스 신에게도 오크툼 신에게도 속하지 않고"
  },
  "130": {
   "jp": "f68ec62eb1",
   "kr": "선도 악도 아니며"
  },
  "131": {
   "jp": "d87c0b5cf7",
   "kr": "태곳적부터 거짓된 세상에 진실을 비추노라."
  },
  "132": {
   "jp": "524f610512",
   "kr": "《둘가 신》"
  },
  "133": {
   "jp": "e4ad4d88cd",
   "kr": "보레아스 지구의 북단에 위치하며"
  },
  "134": {
   "jp": "797d988e43",
   "kr": "코르나 마을 북쪽에서 『얼음 신전』으로 가는 길이 있다."
  },
  "135": {
   "jp": "b5d315c4e5",
   "kr": "그 신전이야말로 정령신 둘가의 사당."
  },
  "136": {
   "jp": "fa30a54ef6",
   "kr": "엘 필딘의 사대 정령",
   "fix": 1
  },
  "137": {
   "jp": "95d6ad25d6",
   "kr": "이둔, 네프티스, 잘, 스코티아를 아우르는,"
  },
  "138": {
   "jp": "301ef4cf9e",
   "kr": "정령신의 사당이니라.",
   "fix": 1
  },
  "139": {
   "jp": "54fddd7a91",
   "kr": "마일과 섀넌의 고향 마을에는"
  },
  "140": {
   "jp": "0aff5aaa52",
   "kr": "내일이라도 사람을 보내 알리마."
  },
  "141": {
   "jp": "95384187aa",
   "kr": "베리어스나 볼게이드는"
  },
  "142": {
   "jp": "252ba2a8fa",
   "kr": "이상을 이용해 신도들을 조종하고"
  },
  "143": {
   "jp": "f3ab5df8c0",
   "kr": "저주라고 해도"
  },
  "144": {
   "jp": "2a04b79091",
   "kr": "과학적으로 규명할 수 있는 종류예요."
  },
  "145": {
   "jp": "b53d38f76f",
   "kr": "한동안 요양하면"
  },
  "146": {
   "jp": "ecd514a468",
   "kr": "특별한 약도 필요 없을 거예요."
  },
