{
 "archive": "/B/SC100.DAT",
 "member": "..\\BIN\\BT00000J.BIN",
 "segments": {
  "0": {
   "jp": "183649f1a6",
   "kr": "내가 뱃사공 엘트포다만… 무슨 일인가?"
  },
  "1": {
   "jp": "942c55905e",
   "kr": "그렇구나, 네가 엘트포였군."
  },
  "2": {
   "jp": "53d599b199",
   "kr": "뱃사공이라고 들었는데"
  },
  "3": {
   "jp": "56d558f54f",
   "kr": "배가 안 보여서 찾았어."
  },
  "4": {
   "jp": "ea6202dd2c",
   "kr": "뱃사공 일로 먹고살던 건"
  },
  "5": {
   "jp": "706c2d3f65",
   "kr": "벌써 옛날 일이네."
  },
  "6": {
   "jp": "6bdb3060c2",
   "kr": "지금은 근처에 다리가 생겨서 필요 없네."
  },
  "7": {
   "jp": "eec6829926",
   "kr": "너에게 편지를 전하러 왔어."
  },
  "8": {
   "jp": "ecc0e244b0",
   "kr": "어빈은 카르의 편지를 건넸다."
  },
  "9": {
   "jp": "edf22f39b6",
   "kr": "호오, 카르의 편지인가."
  },
  "10": {
   "jp": "0f7ecc9ce6",
   "kr": "반갑구먼."
  },
  "11": {
   "jp": "f66554ef13",
   "kr": "그 녀석은 편지를 부지런히 쓰는 놈이라…"
  },
  "12": {
   "jp": "f1641cdb91",
   "kr": "배달 수고했소."
  },
  "13": {
   "jp": "7f3efa5c1f",
   "kr": "오랜만에 뱃사공이던 시절의 나를"
  },
  "14": {
   "jp": "7d12ccbcaa",
   "kr": "떠올리게 해 주었군."
  },
  "15": {
   "jp": "da4671296e",
   "kr": "따분하구먼…"
  },
  "16": {
   "jp": "8ec6795c01",
   "kr": "누가 편지라도 보내 주지 않나."
  },
  "17": {
   "jp": "e39a6419a0",
   "kr": "카르 녀석도"
  },
  "18": {
   "jp": "76c476f385",
   "kr": "그럭저럭 건강하게 지내는 모양이라"
  },
  "19": {
   "jp": "cc4b4d3fa8",
   "kr": "다행이오."
  },
  "20": {
   "jp": "0a35ca8767",
   "kr": "허억, 자네들, 뭐 하러 왔나!"
  },
  "21": {
   "jp": "d754bc2001",
   "kr": "마감이라면 모르네."
  },
  "22": {
   "jp": "b1c5e326a4",
   "kr": "나는 그저 은거한 영감일 뿐일세."
  },
  "23": {
   "jp": "4ffe01537c",
   "kr": "『여검사 사피』 같은 소설은 모르네."
  },
  "24": {
   "jp": "9f399b76cb",
   "kr": "콜록콜록…"
  },
  "25": {
   "jp": "a22839a04a",
   "kr": "이봐 이봐. 직접 불어 버리면 어떡해."
  },
  "26": {
   "jp": "fd7a1ca9c3",
   "kr": "카라무스 선생이지?"
  },
  "27": {
   "jp": "254717248a",
   "kr": "매니저 씨가 곤란해하던데."
  },
  "28": {
   "jp": "95847e3237",
   "kr": "으으음… 알고 있네, 알고 있어."
  },
  "29": {
   "jp": "69a792f271",
   "kr": "하지만 예술이란…"
  },
  "30": {
   "jp": "e5286fa550",
   "kr": "자네들, 소설을 써 본 적이 있나?"
  },
  "31": {
   "jp": "b11e590331",
   "kr": "쓰기 시작할 때는 정말 즐겁지."
  },
  "32": {
   "jp": "67e3dfb424",
   "kr": "하지만 아이디어가 막혔을 때의 괴로움이란!"
  },
  "33": {
   "jp": "77cab4ab98",
   "kr": "그야말로 지옥!!"
  },
  "34": {
   "jp": "a3208c4511",
   "kr": "그렇다고 줄행랑칠 건 없잖아."
  },
  "35": {
   "jp": "0cf2baa268",
   "kr": "나도 실종하고 싶어서 실종한 게 아닐세."
  },
  "36": {
   "jp": "26d994e013",
   "kr": "평소 생활을 바꿔 보면"
  },
  "37": {
   "jp": "b4de7368be",
   "kr": "아이디어가 떠오르기를 기다렸던 걸세."
  },
  "38": {
   "jp": "e996127b79",
   "kr": "아이디어만 나오면 곧바로…"
  },
  "39": {
   "jp": "2f8781bfd9",
   "kr": "오, 그렇지."
  },
  "40": {
   "jp": "f322d4a365",
   "kr": "자네들, 뭐 소재 없나?"
  },
  "41": {
   "jp": "6862dab1a7",
   "kr": "재미있는 경험을 했다든가."
  },
  "42": {
   "jp": "b039077443",
   "kr": "그걸로 힌트를 얻으면"
  },
  "43": {
   "jp": "e11a4e7f60",
   "kr": "나는 당장 돌아가 마구 써 대겠네."
  },
  "44": {
   "jp": "cc6517ea48",
   "kr": "어쩔 수 없는 선생님이네…"
  },
  "45": {
   "jp": "6c43269ea6",
   "kr": "어빈은 지금까지의 모험에 대해 이야기했다."
  },
  "46": {
   "jp": "0018b403fd",
   "kr": "으으음."
  },
  "47": {
   "jp": "d66009b2af",
   "kr": "뭔가 참고가 됐어?"
  },
  "48": {
   "jp": "8eb46f7ffb",
   "kr": "자네들, 별로 대단한 경험은 못 했구먼."
  },
  "49": {
   "jp": "1b7238c878",
   "kr": "여행하면서 겨우 이 정도인가?"
  },
  "50": {
   "jp": "64497877b4",
   "kr": "미안하군, 이 정도라서."
  },
  "51": {
   "jp": "7dd2ac359d",
   "kr": "자네들, 모험가잖나?"
  },
  "52": {
   "jp": "79b9e774fe",
   "kr": "마음에 남는 모험이라든가, 잊을 수 없는 인물이라든가…"
  },
  "53": {
   "jp": "b97907cea7",
   "kr": "그런 건 없나?"
  },
  "54": {
   "jp": "d21360b491",
   "kr": "우린 취미로 여행하는 게 아니라고."
  },
  "55": {
   "jp": "399201a64b",
   "kr": "젊은 녀석이 아는 척하는 소리 말게."
  },
  "56": {
   "jp": "70741cfe64",
   "kr": "자네들은 경험이 부족하네."
  },
  "57": {
   "jp": "1e446a6303",
   "kr": "좀 더 이것저것 보고 들어야 하네."
  },
  "58": {
   "jp": "4137fa954d",
   "kr": "알선소에 가면 일이 여러 가지 있으니."
  },
  "59": {
   "jp": "dd87d483eb",
   "kr": "고생을 사서 하며 훌륭한 경험을 쌓고 오게."
  },
  "60": {
   "jp": "1f8f4db7f7",
   "kr": "그래야 내 붓에 걸맞은 이야기도 나올 테니."
  },
  "61": {
   "jp": "70741cfe64",
   "kr": "자네들은 경험이 부족해."
  },
  "62": {
   "jp": "1e446a6303",
   "kr": "좀 더 이것저것 보고 들어야 하네."
  },
  "63": {
   "jp": "4137fa954d",
   "kr": "알선소에 가면 일이 여러 가지 있으니."
  },
  "64": {
   "jp": "dd87d483eb",
   "kr": "고생을 사서 하며 훌륭한 경험을 쌓고 오게."
  },
  "65": {
   "jp": "1f8f4db7f7",
   "kr": "그래야 내 붓에 걸맞은 이야기도 나올 테니."
  },
  "66": {
   "jp": "8acbb43cbb",
   "kr": "어떤가, 뭔가 재미있는 이야기는 있나?"
  },
  "67": {
   "jp": "654bd69608",
   "kr": "어빈은 지금까지의 여행을 이야기했다."
  },
  "68": {
   "jp": "923273608a",
   "kr": "호오. 으음."
  },
  "69": {
   "jp": "d00d82cd9b",
   "kr": "과연, 과연."
  },
  "70": {
   "jp": "73ad29535f",
   "kr": "…이거 되겠는데."
  },
  "71": {
   "jp": "768197185b",
   "kr": "번뜩였다!!"
  },
  "72": {
   "jp": "d3fef54ff3",
   "kr": "으음, 창작의 불꽃이 솟아오르는구나."
  },
  "73": {
   "jp": "e5fee30b57",
   "kr": "내 마음의 문예의 샘에서 끝없이 물방울이 떨어지는…"
  },
  "74": {
   "jp": "d647078b37",
   "kr": "어찌 아니 그러하랴."
  },
  "75": {
   "jp": "cd257d347a",
   "kr": "…오오, 지금이다! 써야 해!!"
  },
  "76": {
   "jp": "ba6ebdaee3",
   "kr": "자네들,"
  },
  "77": {
   "jp": "60fd424b1d",
   "kr": "그다지 대단한 경험은 못 했구먼."
  }
 }
}
