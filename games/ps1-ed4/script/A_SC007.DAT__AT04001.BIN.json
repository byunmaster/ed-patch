  "168": {
   "jp": "8f50daf50d",
   "kr": "신들의 목적이었겠지."
  },
  "169": {
   "jp": "7b9940c87c",
   "kr": "그렇다면…"
  },
  "170": {
   "jp": "248bb01d8f",
