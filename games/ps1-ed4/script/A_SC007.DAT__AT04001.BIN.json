{
 "archive": "/A/SC007.DAT",
 "member": "..\\BIN\\AT04001.BIN",
 "segments": {
  "0": {
   "jp": "2392d74e84",
   "kr": "디너켄"
  },
  "1": {
   "jp": "5c6ab64022",
   "kr": "셴나"
  },
  "2": {
   "jp": "00cdf72cca",
   "kr": "칸"
  },
  "3": {
   "jp": "98179873bd",
   "kr": "요즘 갑자기 사교도들이 움직이기 시작했다."
  },
  "4": {
   "jp": "7764eff3ea",
   "kr": "아무래도 발두스의 신보를 찾고 있는 듯하오."
  },
  "5": {
   "jp": "b4943b4441",
   "kr": "그 둘은 나를 동굴에 가두고"
  },
  "6": {
   "jp": "bfd2e3bdac",
   "kr": "카테드랄에 모셔져 있던 신보의 행방을"
  },
  "7": {
   "jp": "90637a0836",
   "kr": "캐내려 했던 것이오."
  },
  "8": {
   "jp": "92c868f0df",
   "kr": "내가 카테드랄 탈출자,"
  },
  "9": {
   "jp": "5be640b16e",
   "kr": "즉 너희를 도와준 것까지는"
  },
  "10": {
   "jp": "4f77fc8e14",
   "kr": "알아낸 모양이구나."
  },
  "11": {
   "jp": "6f654fc098",
   "kr": "거기에 내가 와 버린 거군."
  },
  "12": {
   "jp": "96d407a238",
   "kr": "디너켄 님, 죄송합니다."
  },
  "13": {
   "jp": "df9838df15",
   "kr": "사교도의 음모를 알면서도"
  },
  "14": {
   "jp": "4bb7c4d310",
   "kr": "어쩔 도리가 없었습니다."
  },
  "15": {
   "jp": "f5ce42779c",
   "kr": "아니, 아니."
  },
  "16": {
   "jp": "ed1e66fdd8",
   "kr": "내가 오히려 사과해야 한다."
  },
  "17": {
   "jp": "ea3b5ca41b",
   "kr": "아무 관계도 없는 너를 끌어들이고 말았소."
  },
  "18": {
   "jp": "0cbec04268",
   "kr": "당신들께도 어떻게 사죄해야 할지."
  },
  "19": {
   "jp": "f2bebbf0c6",
   "kr": "디너켄 님이 인질로 잡혀 있었다면"
  },
  "20": {
   "jp": "39485b510c",
   "kr": "누구라도 시키는 대로 할 수밖에 없어요."
  },
  "21": {
   "jp": "6cee85002b",
   "kr": "그래, 모두 무사했잖아."
  },
  "22": {
   "jp": "73e4a682ee",
   "kr": "신경 쓸 것 없어."
  },
  "23": {
   "jp": "26a650784a",
   "kr": "멍!"
  },
  "24": {
   "jp": "a1694433a4",
   "kr": "오오, 제일가는 공로자를 잊고 있었군."
  },
  "25": {
   "jp": "f78775e1d5",
   "kr": "멍."
  },
  "26": {
   "jp": "5ea5ba39cd",
   "kr": "하하하하하."
  },
  "27": {
   "jp": "a41185b946",
   "kr": "계속된 긴장에 목이 말랐군."
  },
  "28": {
   "jp": "67550ded2c",
   "kr": "셴나, 미안하지만 홍차를 내어 주겠나?"
  },
  "29": {
   "jp": "7667c1d4bd",
   "kr": "네."
  },
  "30": {
   "jp": "6ab314ccc3",
   "kr": "알겠습니다."
  },
  "31": {
   "jp": "5e19280085",
   "kr": "어빈.",
   "auto": 1
  },
  "32": {
   "jp": "61b82f6470",
   "kr": "네가 여기에 왔다는 건…"
  },
  "33": {
   "jp": "3d47ded93c",
   "kr": "레뮤라스 할아버지는 돌아가셨어요."
  },
  "34": {
   "jp": "d98f6fd55b",
   "kr": "잠자듯 숨을 거뒀어요."
  },
  "35": {
   "jp": "bf92a44763",
   "kr": "그런가.",
   "auto": 1
  },
  "36": {
   "jp": "9d63e56f02",
   "kr": "파란만장한 생애였지만"
  },
  "37": {
   "jp": "a0be261a1e",
   "kr": "만년에는 네 덕분에 행복했을 게다."
  },
  "38": {
   "jp": "c5d13e7187",
   "kr": "그게 그나마 위안이구나."
  },
  "39": {
   "jp": "0f4cfbf9f9",
   "kr": "그건 그렇고 어빈."
  },
  "40": {
   "jp": "a99930f073",
   "kr": "앞으로 어떻게 할 생각이냐?"
  },
  "41": {
   "jp": "513c71c864",
   "kr": "아이멜을 만나려고 해요."
  },
  "42": {
   "jp": "3c42ddc6e5",
   "kr": "할아버지도 제 뜻에 맡기겠다고 해 주셨으니까요."
  },
  "43": {
   "jp": "e3511831f0",
   "kr": "그렇겠구나."
  },
  "44": {
   "jp": "a8a18f2e8f",
   "kr": "카베사의 행방이 사교도에게 알려진 이상"
  },
  "45": {
   "jp": "637402f037",
   "kr": "숨어 있을 필요도 없겠지."
  },
  "46": {
   "jp": "0aae1c3b80",
   "kr": "어빈, 베네키아 수도원으로 가거라."
  },
  "47": {
   "jp": "d751aef1d1",
   "kr": "거기에 오레시아와 아이멜이 있다."
  },
  "48": {
   "jp": "a73baed29a",
   "kr": "오레시아 선생님도 함께요?"
  },
  "49": {
   "jp": "be9b50434b",
   "kr": "그녀도 지금은 베네키아 수도원의 원장을 맡고 있다."
  },
  "50": {
   "jp": "ddd8408886",
   "kr": "카베사에 관해서는 오레시아의 지시를 따르거라."
  },
  "51": {
   "jp": "4a4714303c",
   "kr": "디너켄 님."
  },
  "52": {
   "jp": "805b6ca578",
   "kr": "사교도가 베네키아 수도원을"
  },
  "53": {
   "jp": "dd3d9b04a1",
   "kr": "습격할 가능성은 없을까요?"
  },
  "54": {
   "jp": "fd5a4fbdf4",
   "kr": "베네키아 수도원에는 쿠에르포가 있다."
  },
  "55": {
   "jp": "dd8c4f0093",
   "kr": "만약 그놈들이 그걸 알게 되면…"
  },
  "56": {
   "jp": "fb40ffeaf0",
   "kr": "아이멜이 가지고 있던 신보 말인가요?"
  },
  "57": {
   "jp": "d03f7ce8d1",
   "kr": "그렇다."
  },
  "58": {
   "jp": "3c3c46b44e",
   "kr": "사교도가 쿠에르포를 노릴 가능성은 충분하오."
  },
  "59": {
   "jp": "883490239e",
   "kr": "어느 쪽이든"
  },
  "60": {
   "jp": "0b1ec648a2",
   "kr": "위험이 따르는 건 변함없소."
  },
  "61": {
   "jp": "02dbb1c41e",
   "kr": "방심해서는 안 되오."
  },
  "62": {
   "jp": "9de0df283a",
   "kr": "기다리셨습니다."
  },
  "63": {
   "jp": "94cd01f921",
   "kr": "자, 뜨거운 홍차를 드세요."
  },
  "64": {
   "jp": "f41f0a4475",
   "kr": "오오, 고맙네."
  },
  "65": {
   "jp": "107d56f35a",
   "kr": "셴나가 끓여 주는 홍차는 일품이지."
  },
  "66": {
   "jp": "9464bbeec4",
   "kr": "너희도 편히 쉬거라."
  },
  "67": {
   "jp": "656f8aae29",
   "kr": "셴나의 차는"
  },
  "68": {
   "jp": "a97568a35b",
   "kr": "어빈 일행의 피로를 풀어 주었다."
  },
  "69": {
   "jp": "9ff230b8ed",
   "kr": "베네키아 수도원까지 가는 길은 멀다."
  },
  "70": {
   "jp": "b5b977a1f7",
   "kr": "서두르지 말고 여행을 계속하거라."
  },
  "71": {
   "jp": "093092880c",
   "kr": "이걸 건네 두마."
  },
  "72": {
   "jp": "79b90050da",
   "kr": "베네키아 수도원으로 가는 소개장이다."
  },
  "73": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "74": {
   "jp": "f8851237f7",
   "kr": "을(를) 받았다."
  },
  "75": {
   "jp": "f68f4e8cc5",
   "kr": "소지품이 가득 찬 모양이구나."
  },
  "76": {
   "jp": "919f1d8cb2",
   "kr": "여유가 생기면 다시 오거라."
  },
  "77": {
   "jp": "eba3222869",
   "kr": "이(가) 없으면"
  },
  "78": {
   "jp": "688ec66b18",
   "kr": "베네키아 수도원에 들어갈 수 없으니까."
  },
  "79": {
   "jp": "9ff230b8ed",
   "kr": "베네키아 수도원까지 가는 길은 멀다."
  },
  "80": {
   "jp": "b5b977a1f7",
   "kr": "서두르지 말고 여행을 계속하거라."
  },
  "81": {
   "jp": "a10c06e81d",
   "kr": "오, 어빈.",
   "auto": 1
  },
  "82": {
   "jp": "778b447e02",
   "kr": "아이멜은 만났느냐?"
  },
  "83": {
   "jp": "b48ff426f3",
   "kr": "베네키아 수도원에는 가 보았는데요"
  },
  "84": {
   "jp": "7b056ba6c3",
   "kr": "아이멜은 오레시아 선생님의 심부름으로"
  },
  "85": {
   "jp": "f139c2df1c",
   "kr": "발크드의 정신전으로 떠난 뒤였습니다."
  },
  "86": {
   "jp": "62a1b09a4c",
   "kr": "쿠에르포를 전하러 갔구나."
  },
  "87": {
   "jp": "7667c1d4bd",
   "kr": "네."
  },
  "88": {
   "jp": "cd3d1e2ad0",
   "kr": "베네키아 수도원이 사교도의 습격을 받은 것과"
  },
  "89": {
   "jp": "487db80a9a",
   "kr": "엇갈려서 떠났다고 합니다."
  },
  "90": {
   "jp": "bdd19c0ae5",
   "kr": "뭐라고!? 베네키아 수도원이 습격을 받았다고?"
  },
  "91": {
   "jp": "8aa4f657a3",
   "kr": "다행히"
  },
  "92": {
   "jp": "2a44392904",
   "kr": "피해는 부서진 건물뿐이었던 모양입니다."
  },
  "93": {
   "jp": "afa58f372b",
   "kr": "저희가 도착했을 때는"
  },
  "94": {
   "jp": "339fcad71a",
   "kr": "이미 사교도들의 모습은 없었습니다."
  },
  "95": {
   "jp": "9ece28edd2",
   "kr": "음… 그렇다면."
  },
  "96": {
   "jp": "9f2a0b9a3e",
   "kr": "아이멜을 쫓아 서둘러 합류하는 게 좋겠다."
  },
  "97": {
   "jp": "d0f1cf4781",
   "kr": "아이멜은 여행에 서투르니"
  },
  "98": {
   "jp": "8550919836",
   "kr": "아직 발크드에 도착했다고는 생각되지 않는다."
  },
  "99": {
   "jp": "31a49239ed",
   "kr": "베네키아 수도원을 습격한 자들은"
  },
  "100": {
   "jp": "8b2510ea93",
   "kr": "거기에 아이멜이 있고 쿠에르포가 있다는 정보를"
  },
  "101": {
   "jp": "05a191dcbd",
   "kr": "어디선가 입수했겠지."
  },
  "102": {
   "jp": "2cd694493d",
   "kr": "그들은 도중에 아이멜을 찾으려고"
  },
  "103": {
   "jp": "bebdb2a5fe",
   "kr": "그물을 쳐 놓았음이 틀림없다."
  },
  "104": {
   "jp": "07bc9d5d50",
   "kr": "어빈, 서둘러 아이멜을 찾아라."
  },
  "105": {
   "jp": "94afad30ba",
   "kr": "오오, "
  },
  "106": {
   "jp": "90862889a4",
   "kr": "을(를) 건네 두마."
  },
  "107": {
   "jp": "cadee701e3",
   "kr": "잃어버리지 않도록 해라."
  },
  "108": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "109": {
   "jp": "f8851237f7",
   "kr": "을(를) 받았다."
  },
  "110": {
   "jp": "a9d3d010b9",
   "kr": "소지품에 여유가 생기면"
  },
  "111": {
   "jp": "c0cec32796",
   "kr": "을(를) 가지러 오거라."
  },
  "112": {
   "jp": "eba3222869",
   "kr": "이(가) 없으면"
  },
  "113": {
   "jp": "688ec66b18",
   "kr": "베네키아 수도원에 들어갈 수 없으니까."
  },
  "114": {
   "jp": "3078b31074",
   "kr": "잘 찾아와 주었다."
  },
  "115": {
   "jp": "35f1a75e9c",
   "kr": "조금 전에 미첼도 찾아왔고"
  },
  "116": {
   "jp": "d36ca55af4",
   "kr": "가웨인한테서도 편지를 받았다."
  },
  "117": {
   "jp": "cb48f8b61d",
   "kr": "대강의 일은 알고 있다."
  },
  "118": {
   "jp": "092a0b9f01",
   "kr": "고생이 많았다."
  },
  "119": {
   "jp": "cbdbc12e6c",
   "kr": "오랜만에 뵙습니다."
  },
  "120": {
   "jp": "1cc97dc327",
   "kr": "둘가 신과 사정령에 대해"
  },
  "121": {
   "jp": "af0ca48c07",
   "kr": "아시는 게 있으면 가르쳐"
  },
  "122": {
   "jp": "02578151d6",
   "kr": "주셨으면 합니다만."
  },
  "123": {
   "jp": "77b5ae7074",
   "kr": "음. 그렇구나."
  },
  "124": {
   "jp": "8fde2b488f",
   "kr": "여러 곳에 갖가지 정보가 있겠지만"
  },
  "125": {
   "jp": "62e69ecfb8",
   "kr": "조금 정리하는 게 좋겠구나."
  },
  "126": {
   "jp": "b8fc4131b8",
   "kr": "사람들은 그 힘 있는 존재를"
  },
  "127": {
   "jp": "b914a87a43",
   "kr": "싸잡아 신이라고 부르지만"
  },
  "128": {
   "jp": "16b7d76541",
   "kr": "역할도 다르고 성격도 다르다."
  },
  "129": {
   "jp": "69cacd4a4d",
   "kr": "게다가 그것이 지상에서 인간이 퍼뜨린 가르침에 따라"
  },
  "130": {
   "jp": "33bb0b546a",
   "kr": "조금씩 달라져서 감당하기 힘든 복잡한 것이"
  },
  "131": {
   "jp": "294f60431d",
   "kr": "되어 버린 것이다."
  },
  "132": {
   "jp": "3679ea2c85",
   "kr": "어느 세계의 가르침이든 그렇지만"
  },
  "133": {
   "jp": "f4c468cf8c",
   "kr": "신들의 세계에는 정점에 군림하는 신,"
  },
  "134": {
   "jp": "c6a64f06e8",
   "kr": "즉 대신이 존재한다."
  },
  "135": {
   "jp": "9aeaaa98dc",
   "kr": "다만 이 존재는 신들의 우두머리가 아니라"
  },
  "136": {
   "jp": "556ea1b7bc",
   "kr": "우주에 흐르는 선악의 개념으로 보는 게 좋겠다."
  },
  "137": {
   "jp": "a6d777868c",
   "kr": "실체가 없으며 선도 악도 아니다."
  },
  "138": {
   "jp": "ee67f89648",
   "kr": "판단의 기본이 되는 감정을 주는 샘인 것이다."
  },
  "139": {
   "jp": "d4a76c9c28",
   "kr": "그 아래에 우리가 신이라고 부르는 존재가 있다."
  },
  "140": {
   "jp": "b96159b062",
   "kr": "발두스 신이나 오크툼 신이 그렇다."
  },
  "141": {
   "jp": "5df81c0496",
   "kr": "신은 협의 끝에 각자가 맡은 지상 세계에"
  },
  "142": {
   "jp": "5a235d9279",
   "kr": "시련과 번영을 내리는 것이다."
  },
  "143": {
   "jp": "971da81058",
   "kr": "그 일을 돕는 것이"
  },
  "144": {
   "jp": "9b97c5b1e7",
   "kr": "신들의 하인인 천계의 정령들이다."
  },
  "145": {
   "jp": "f98a3d3902",
   "kr": "우리는 그들도 신이라고 부르지만"
  },
  "146": {
   "jp": "7faa42684c",
   "kr": "이둔, 스코티아, 네프티스, 자르는"
  },
  "147": {
   "jp": "6054d95ed7",
   "kr": "정확히는 신이 아니라 천계의 정령이다."
  },
  "148": {
   "jp": "71a90c7783",
   "kr": "그리고 그들을 거느리는 것이 둘가다."
  },
  "149": {
   "jp": "e0bdacc05b",
   "kr": "정령신, 대정령… 부르는 방식은 다양하지만"
  },
  "150": {
   "jp": "73f34bafec",
   "kr": "둘가도 사정령을 거느리는 존재에 지나지 않는다."
  },
  "151": {
   "jp": "df1f88848d",
   "kr": "사정령과 둘가는 발두스 신의 하인인가요?"
  },
  "152": {
   "jp": "6cb70cb431",
   "kr": "아니면 오크툼 신의 하인인가요?"
  },
  "153": {
   "jp": "8759523cef",
   "kr": "아마 어느 쪽의 하인도 아닐 것이다."
  },
  "154": {
   "jp": "0c2d620ea0",
   "kr": "그들은 늘 중립적인 입장으로 존재한다."
  },
  "155": {
   "jp": "e579460512",
   "kr": "발두스 신, 오크툼 신과는 관계없이"
  },
  "156": {
   "jp": "de62e25c9e",
   "kr": "모든 신들의 협의를 거쳐 행동을 결정한다고"
  },
  "157": {
   "jp": "a5a312a278",
   "kr": "보는 게 좋겠다."
  },
  "158": {
   "jp": "4e0cb52b65",
   "kr": "그렇다면 발두스 신의 몸이 신들의 싸움에서"
  },
  "159": {
   "jp": "405769b2cc",
   "kr": "세계에 흩어졌을 때,"
  },
  "160": {
   "jp": "858bb2bf3a",
   "kr": "그것을 지키듯 사당에 자리한 것은?"
  },
  "161": {
   "jp": "ce9204b32f",
   "kr": "신들의 총의였다는 거지."
  },
  "162": {
   "jp": "3ff7c90298",
   "kr": "뒤집어 말하면 발두스의 신령을 지키기 위해서는"
  },
  "163": {
   "jp": "634e6a6bf2",
   "kr": "아니었다는 얘기다."
  },
  "164": {
   "jp": "3c3a1d8792",
   "kr": "즉, 신보를 발두스 신도가 손에 넣든"
  },
  "165": {
   "jp": "b97bcb0c43",
   "kr": "오크툼 신도가 손에 넣든"
  },
  "166": {
   "jp": "c9f782e7e0",
   "kr": "신들에게는 어느 쪽이든 상관없었다."
  },
  "167": {
   "jp": "43bf7b9e26",
