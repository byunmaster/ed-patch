{
 "archive": "/D/SC303.DAT",
 "member": "..\\BIN\\DT20001A.BIN",
 "segments": {
  "0": {
   "jp": "1e94a83c60",
   "kr": "헤헤헤…"
  },
  "1": {
   "jp": "683fe0142c",
   "kr": "무리해서 도망치려 하니까 호되게 당하는 거야."
  },
  "2": {
   "jp": "d4f1281642",
   "kr": "마차에 장치를 하다니, 더러운 수를…"
  },
  "3": {
   "jp": "78933dc851",
   "kr": "루티스, 너 변했구나."
  },
  "4": {
   "jp": "a16db8b801",
   "kr": "기아에서 동생 루카가 이놈들에게 도움을 받아서냐?"
  },
  "5": {
   "jp": "051110e5fd",
   "kr": "뭐, 됐어."
  },
  "6": {
   "jp": "6f801beca1",
   "kr": "신보를 받아 가자고."
  },
  "7": {
   "jp": "c8bdf28c3a",
   "kr": "정신을 잃었군."
  },
  "8": {
   "jp": "ce466141a3",
   "kr": "어이쿠… 자, 쿠에르포 접수."
  },
  "9": {
   "jp": "3812b10afb",
   "kr": "바스터는 쿠에르포를 빼앗았다."
  },
  "10": {
   "jp": "ee1fbcd2c4",
   "kr": "다음은 카베사."
  },
  "11": {
   "jp": "11efab0e41",
   "kr": "미안하군. 받아 간다."
  },
  "12": {
   "jp": "2e6fef9656",
   "kr": "바스터는 카베사를 빼앗았다."
  },
  "13": {
   "jp": "4851cf048a",
   "kr": "루티스, 부루퉁해 있지 마."
  },
  "14": {
   "jp": "45fc0cfb8d",
   "kr": "신보를 손에 넣었잖아. 만만세 아니냐."
  },
  "15": {
   "jp": "840fe2a034",
   "kr": "와하하하…!"
  },
  "16": {
   "jp": "751c1a368c",
   "kr": "내, 내가 손에 넣은 거다. 카베사도, 쿠에르포도!"
  },
  "17": {
   "jp": "868a0fec9d",
   "kr": "이제 출세 가도 직행이다!"
  },
  "18": {
   "jp": "e95d52a07a",
   "kr": "안심해, 루티스! 네가 도와준 것도"
  },
  "19": {
   "jp": "e2d41c5ce7",
   "kr": "제대로 보고해 주마."
  },
  "20": {
   "jp": "97f15c28ac",
   "kr": "나 같은 간부까진 못 되겠지만."
  },
  "21": {
   "jp": "cf72917987",
   "kr": "소대장쯤이라면 추천해 줄 수도 있다."
  },
  "22": {
   "jp": "042ef8c131",
   "kr": "바스터!"
  },
  "23": {
   "jp": "c85912e3ad",
   "kr": "자기 욕심 때문에 오크툼 신을 숭배하는 거라면"
  },
  "24": {
   "jp": "95c842ab37",
   "kr": "볼게이드와 똑같아!"
  },
  "25": {
   "jp": "c7a81dca82",
   "kr": "네가 공을 세우는 건 방해 안 하지만."
  },
  "26": {
   "jp": "e93ab4fa3a",
   "kr": "잠꼬대 같은 소리 하면 천벌이 내릴 거야!"
  },
  "27": {
   "jp": "f418b93d48",
   "kr": "루티스.",
   "auto": 1
  },
  "28": {
   "jp": "4192fd50b5",
   "kr": "너야말로 모르는군."
  },
  "29": {
   "jp": "b6066ae14a",
   "kr": "아무리 이상이 높아도 말단이면 어쩔 건데?"
  },
  "30": {
   "jp": "7fc4918a5d",
   "kr": "어떻게 이상을 실현시킬 수 있다는 거냐."
  },
  "31": {
   "jp": "ef9a3f1ae8",
   "kr": "출세하지 않으면 어쩔 도리가 없는 거야."
  },
  "32": {
   "jp": "02c8204ff7",
   "kr": "목소리",
   "auto": 1
  },
  "33": {
   "jp": "d2f7f637f3",
   "kr": "바로 그거다."
  },
  "34": {
   "jp": "5089038dcc",
   "kr": "볼게이드…?!"
  },
  "35": {
   "jp": "766fe82e65",
   "kr": "수고했다, 바스터."
  },
  "36": {
   "jp": "7486f15aee",
   "kr": "베리어스 경도, 아니… 대신관 베리어스 님도"
  },
  "37": {
   "jp": "e37be7dd7d",
   "kr": "기뻐하시겠지."
  },
  "38": {
   "jp": "3e03f6fbf1",
   "kr": "약속대로 나를 간부로 올려 주는 거겠지?"
  },
  "39": {
   "jp": "0f7a6b575c",
   "kr": "바스터. 너…"
  },
  "40": {
   "jp": "81d4547890",
   "kr": "물론이지. 자, 신보를 이쪽으로 넘겨라."
  },
  "41": {
   "jp": "2ce0e7661f",
   "kr": "그것은 우리의 이상을 위해 필요한 것이다."
  },
  "42": {
   "jp": "bf53b1f284",
   "kr": "어이쿠… 그렇게는 안 되지."
  },
  "43": {
   "jp": "03fead02bb",
   "kr": "이건 내가 대신관 베리어스 님께 전하겠어."
  },
  "44": {
   "jp": "3f87b1205b",
   "kr": "네 공으로 돌려지면 말짱 도루묵이니까."
  },
  "45": {
   "jp": "1dac7ff550",
   "kr": "훗…"
  },
  "46": {
   "jp": "f2e8aeaeb6",
   "kr": "그렇다면… 어쩔 수 없군."
  },
  "47": {
   "jp": "c8a88bb0ee",
   "kr": "으억…"
  },
  "48": {
   "jp": "521fc5131f",
   "kr": "바스터!!"
  },
  "49": {
   "jp": "abf566a37e",
   "kr": "이게 무슨 짓을…"
  },
  "50": {
   "jp": "f0f71e908b",
   "kr": "신보를 가져와라."
  },
  "51": {
   "jp": "ee0e4c69c9",
   "kr": "…루티스. 배신하는 거냐?"
  },
  "52": {
   "jp": "a9d75980d3",
   "kr": "배신한 건 당신이잖아?"
  },
  "53": {
   "jp": "e8b235ba42",
   "kr": "이놈… 정신이 들었나."
  },
  "54": {
   "jp": "eb476bb45f",
   "kr": "네놈 같은 놈이 바라는 대로 세상이 될까 보냐!"
  },
  "55": {
   "jp": "d3c31545dc",
   "kr": "동료를 아무렇지 않게 배신하는 놈이"
  },
  "56": {
   "jp": "abe740e4ab",
   "kr": "…이상을 말할 권리 같은 게 있을 리 없어!"
  },
  "57": {
   "jp": "25f9317419",
   "kr": "…으음…"
  },
  "58": {
   "jp": "422d9b8de8",
   "kr": "앗, 네놈은!"
  },
  "59": {
   "jp": "f17349a5fe",
   "kr": "볼게이드야."
  },
  "60": {
   "jp": "e2c2837c01",
   "kr": "이놈이 루카를 이용하고,"
  },
  "61": {
   "jp": "825c92cab1",
   "kr": "동료인 바스터까지 죽였어…"
  },
  "62": {
   "jp": "4800c819fd",
   "kr": "으음…"
  },
  "63": {
   "jp": "d35e654e1b",
   "kr": "네가 나에게 칼을 겨누다니."
  },
  "64": {
   "jp": "3a980cb385",
   "kr": "…정말 예상 밖이었군."
  },
  "65": {
   "jp": "6fe38156a7",
   "kr": "좋다."
  },
  "66": {
   "jp": "df64a06256",
   "kr": "나를 거스르면 어떻게 되는지 뼈저리게 가르쳐 주마."
  },
  "67": {
   "jp": "9eae4deebd",
   "kr": "루티스. 괴로워하며 죽어라."
  },
  "68": {
   "jp": "3618b3a580",
   "kr": "루티스!!"
  },
  "69": {
   "jp": "65f3527b82",
   "kr": "이건"
  },
  "70": {
   "jp": "bc51b5c379",
   "kr": "내가 대신관 베리어스 님께 직접 전해 드리겠다."
  }
 }
}
