{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02000D.BIN",
 "segments": {
  "0": {
   "jp": "0242a11944",
   "kr": "케이트를 찾는 걸"
  },
  "1": {
   "jp": "466cde28bf",
   "kr": "도와주겠다는 거니?"
  },
  "2": {
   "jp": "731a609ec8",
   "kr": "그래."
  },
  "3": {
   "jp": "e71e3008d9",
   "kr": "아무래도 길을 잃은"
  },
  "4": {
   "jp": "a9ebfbb577",
   "kr": "것 같아."
  },
  "5": {
   "jp": "7eeeacaa67",
   "kr": "다행이다."
  },
  "6": {
   "jp": "4bca1d6395",
   "kr": "엇갈리면 안 되니까"
  },
  "7": {
   "jp": "2b1c4916b2",
   "kr": "여기를 떠나"
  },
  "8": {
   "jp": "67b2748030",
   "kr": "멀리까지 찾으러 갈 수 없었어."
  },
  "9": {
   "jp": "ea71b65fa0",
   "kr": "나는 여기서 기다릴 테니"
  },
  "10": {
   "jp": "d4541715ab",
   "kr": "미안하지만 마을 안을"
  },
  "11": {
   "jp": "fc590935bd",
   "kr": "찾아봐 줄래?"
  },
  "12": {
   "jp": "c2533ccc98",
   "kr": "케이트는 빨간 옷을 입고 있어."
  },
  "13": {
   "jp": "05608d9ce2",
   "kr": "형 아이를 맡고 있는데."
  },
  "14": {
   "jp": "78a725c95f",
   "kr": "아이는 정말 기운이 넘치는구나."
  },
  "15": {
   "jp": "003dbdd121",
   "kr": "너무 걱정시키지"
  },
  "16": {
   "jp": "c419e0b362",
   "kr": "않았으면 좋겠는데～."
  },
  "17": {
   "jp": "f95e53f83d",
   "kr": "앗, 너, 너희들!"
  },
  "18": {
   "jp": "6af4b75559",
   "kr": "들어 줘, 케이트가…"
  },
  "19": {
   "jp": "f778ec08ab",
   "kr": "응."
  },
  "20": {
   "jp": "cd31bf899a",
   "kr": "알선소에서 얘기는 들었어."
  },
  "21": {
   "jp": "5cf6c8b0c7",
   "kr": "너희가 의뢰를 맡아 준 거구나."
  },
  "22": {
   "jp": "a238d33d1e",
   "kr": "든든해."
  },
  "23": {
   "jp": "e6021ed1c7",
   "kr": "한심한 얘기지만"
  },
  "24": {
   "jp": "7e536dd4ee",
   "kr": "나는 완력에 자신이 없어."
  },
  "25": {
   "jp": "47097418bf",
   "kr": "한심하지 않아요."
  },
  "26": {
   "jp": "cc72c1bb29",
   "kr": "무모하게 동굴로 뛰어드는 것보다"
  },
  "27": {
   "jp": "d23aa7cd49",
   "kr": "현명해요."
  },
  "28": {
   "jp": "51531a6972",
   "kr": "걱정 마."
  },
  "29": {
   "jp": "7608e5f1c0",
   "kr": "우리가 반드시 데리고 돌아올게."
  },
  "30": {
   "jp": "3fec455372",
   "kr": "케이트는 형님께 맡은 소중한 딸이야."
  },
  "31": {
   "jp": "0a75312fd5",
   "kr": "이대로는 형 부부 볼 낯이 없어…"
  },
  "32": {
   "jp": "ed7f053f46",
   "kr": "어쩌지. 어쩌지. 어쩌지."
  },
  "33": {
   "jp": "666742faed",
   "kr": "당황하지 마. 당황하지 마. 당황하지 마."
  },
  "34": {
   "jp": "6f0154e295",
   "kr": "진정해. 진정해. 진정하자."
  },
  "35": {
   "jp": "1a30c4552e",
   "kr": "아아… 빨리 형 부부가"
  },
  "36": {
   "jp": "0a22fb7c63",
   "kr": "케이트를 데리러 오지 않으면"
  },
  "37": {
   "jp": "4874f5e6be",
   "kr": "파산하겠어."
  },
  "38": {
   "jp": "eaa66dc257",
   "kr": "여, 어빈 씨, 저번엔 고마웠어요."
  },
  "39": {
   "jp": "3f8a5fcf04",
   "kr": "케이트는"
  },
  "40": {
   "jp": "d64db779da",
   "kr": "여전히 건방져서 곤란하다니까."
  }
 }
}
