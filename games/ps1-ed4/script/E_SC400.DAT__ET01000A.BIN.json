{
 "archive": "/E/SC400.DAT",
 "member": "..\\BIN\\ET01000A.BIN",
 "segments": {
  "0": {
   "jp": "86b2ec3765",
   "kr": "그 물건을 운반해 줬군."
  },
  "1": {
   "jp": "f1caa4cf16",
   "kr": "수고했네. 수고했어."
  },
  "2": {
   "jp": "f6391b00b6",
   "kr": "그럼 바로 짐을 받을까."
  },
  "3": {
   "jp": "b9eb58aa76",
   "kr": "다론에게서 맡은 짐을 젠에게 건넸다."
  },
  "4": {
   "jp": "30adaa3a6a",
   "kr": "자네가 운반해 온 건"
  },
  "5": {
   "jp": "a6f9ceb2c9",
   "kr": "아주 귀중한 미주였다네."
  },
  "6": {
   "jp": "0ee533dab9",
   "kr": "이 세상에 둘도 없다고 단언할 수 있는 미주라네."
  },
  "7": {
   "jp": "c35bba000b",
   "kr": "응?"
  },
  "8": {
   "jp": "d16f53f9e2",
   "kr": "내가 들은 것보다 양이"
  },
  "9": {
   "jp": "112fb3eecc",
   "kr": "적은 것 같은데…"
  },
  "10": {
   "jp": "79a14ef6a6",
   "kr": "혹시 자네들인가?"
  },
  "11": {
   "jp": "a25e688369",
   "kr": "여기까지 오는 도중에 맛이라도 봤나?"
  },
  "12": {
   "jp": "94bac5a010",
   "kr": "설마."
  },
  "13": {
   "jp": "526c5407e0",
   "kr": "왜 우리가 그런 일을 해야 하는 거야."
  },
  "14": {
   "jp": "d32f5d15b0",
   "kr": "후후후."
  },
  "15": {
   "jp": "e4910269a9",
   "kr": "아마 자네에게 일을 의뢰한"
  },
  "16": {
   "jp": "ff6b6f9eaf",
   "kr": "다론 녀석의 짓이겠지."
  },
  "17": {
   "jp": "4f315e4536",
   "kr": "무사히 운반해 온 보답으로"
  },
  "18": {
   "jp": "065cae6b3b",
   "kr": "이 미주의 비밀을 알려 주지."
  },
  "19": {
   "jp": "3ab04543b1",
   "kr": "아까 이 병 속 내용물이 귀중한 미주라고"
  },
  "20": {
   "jp": "e3481031a0",
   "kr": "했지만 사실은 어디에나 있는 싸구려 술이라네."
  },
  "21": {
   "jp": "1b1e619980",
   "kr": "정확히는 이제부터 미주가 될 술"
  },
  "22": {
   "jp": "6ddb957f9c",
   "kr": "이라고 하는 편이 맞겠군."
  },
  "23": {
   "jp": "4650298d25",
   "kr": "이 유리 세공에 비밀이 있지."
  },
  "24": {
   "jp": "8f1e42e75f",
   "kr": "이 병 속의 술은 보름달 빛을 １３번 쬐면"
  },
  "25": {
   "jp": "254f00935e",
   "kr": "궁극의 미주가 된다네."
  },
  "26": {
   "jp": "544e361ee3",
   "kr": "그런 신기한 유리 세공이지."
  },
  "27": {
   "jp": "122873edeb",
   "kr": "내용물이 아니라 그릇이 중요했던 걸세."
  },
  "28": {
   "jp": "398f196cdc",
   "kr": "다론 씨는 그 사실을 모른다네."
  },
  "29": {
   "jp": "d29e408c29",
   "kr": "그래서 다론 씨는 그냥 싸구려 술을 맛본"
  },
  "30": {
   "jp": "0794dd7561",
   "kr": "셈이지."
  },
  "31": {
   "jp": "220c564d4d",
   "kr": "내가 미주를 완성하는 날에는"
  },
  "32": {
   "jp": "5c7a5bad08",
   "kr": "다론 씨에게도 제대로 맛보게 해 주겠네."
  },
  "33": {
   "jp": "65d89f0182",
   "kr": "분명 눈이 휘둥그레져 놀랄 걸세."
  },
  "34": {
   "jp": "506c42b821",
   "kr": "후후후. 기대되는군."
  },
  "35": {
   "jp": "76711d1190",
   "kr": "짐은 어떻게 했나?"
  },
  "36": {
   "jp": "e5fbf2926c",
   "kr": "아무것도 맡아 오지 않았나?"
  },
  "37": {
   "jp": "d5e57dbd44",
   "kr": "…만물유전…"
  },
  "38": {
   "jp": "cc55476920",
   "kr": "어이, 선생."
  },
  "39": {
   "jp": "62ed119726",
   "kr": "오오, 어빈 군인가."
  },
  "40": {
   "jp": "f4c030525e",
   "kr": "오랜만이군.",
   "auto": 1
  },
  "41": {
   "jp": "dd2cfdfc8a",
   "kr": "자마네 아저씨가 찾고 있어."
  },
  "42": {
   "jp": "5b7a4c2185",
   "kr": "이런 데서 뭐 하는 거야?"
  },
  "43": {
   "jp": "75e802ecb6",
   "kr": "뭐, 그렇게 아등바등하지 말게."
  },
  "44": {
   "jp": "ab083e6684",
   "kr": "세계의 넓이에 비하면 원고 따위."
  },
  "45": {
   "jp": "aa63989458",
   "kr": "…오오, 세계는 이토록 높고 이토록 낮으니…"
  },
  "46": {
   "jp": "a86a9c7b4d",
   "kr": "현실 도피구나."
  },
  "47": {
   "jp": "39716659a9",
   "kr": "윽."
  },
  "48": {
   "jp": "0f784ef669",
   "kr": "그렇게 말해도 말이야."
  },
  "49": {
   "jp": "c3df9bc90b",
   "kr": "더 이상 아이디어가 없다네."
  },
  "50": {
   "jp": "5c89eb7b84",
   "kr": "없는 걸 어쩌겠나."
  },
  "51": {
   "jp": "2520e9df0c",
   "kr": "탈탈 털어도 먼지 하나 안 나온다네."
  },
  "52": {
   "jp": "896393894a",
   "kr": "또야?"
  },
  "53": {
   "jp": "43f2afc821",
   "kr": "작가 주제에 품위 없는 표현이네요."
  },
  "54": {
   "jp": "572b5037b7",
   "kr": "차라리 폐업하는 게 어때요?"
  },
  "55": {
   "jp": "dfeeb3f90c",
   "kr": "도와주게, 어빈 군."
  },
  "56": {
   "jp": "658641755d",
   "kr": "여느 때처럼…"
  },
  "57": {
   "jp": "cc6517ea48",
   "kr": "못 말리는 선생이라니까…"
  },
  "58": {
   "jp": "c04f953953",
   "kr": "어빈은 지금까지의 모험에 대해 이야기했다."
  },
  "59": {
   "jp": "0018b403fd",
   "kr": "으으음.",
   "auto": 1
  },
  "60": {
   "jp": "bbfac1e66f",
   "kr": "뭔가 참고가 됐어?"
  },
  "61": {
   "jp": "8eb46f7ffb",
   "kr": "자네들, 별로 대단한 경험은 하지 못한 모양이군."
  },
  "62": {
   "jp": "1b7238c878",
   "kr": "여행하면서 겨우 이 정도인가?",
   "auto": 1
  },
  "63": {
   "jp": "64497877b4",
   "kr": "미안하군, 이 정도라서.",
   "auto": 1
  },
  "64": {
   "jp": "8d4ab37679",
   "kr": "이래서는 이야기가 안 되네."
  },
  "65": {
   "jp": "166b5e5481",
   "kr": "좀 더 재미있는 이야기를 구해 오게."
  },
  "66": {
   "jp": "91400691ba",
   "kr": "쳇. 제멋대로 지껄이기는."
  },
  "67": {
   "jp": "21b385e936",
   "kr": "알선소에 가면 여러 일이 있을 걸세."
  },
  "68": {
   "jp": "8bea167458",
   "kr": "젊으니 몸 사리지 말고 일해 보게."
  },
  "69": {
   "jp": "a427cbe316",
   "kr": "분명 재미있는 경험을 할 수 있을 걸세."
  },
  "70": {
   "jp": "91929fba09",
   "kr": "그래야 내 붓에 걸맞은 이야기도 나올 법하지."
  },
  "71": {
   "jp": "e48bb66d38",
   "kr": "오오, 기다리고 있었네, 어빈 군."
  },
  "72": {
   "jp": "056469eb8d",
   "kr": "뭔가 재미있는 이야기는 있나?"
  },
  "73": {
   "jp": "6c43269ea6",
   "kr": "어빈은 지금까지의 모험에 대해 이야기했다.",
   "auto": 1
  },
  "74": {
   "jp": "923273608a",
   "kr": "호오. 으음.",
   "auto": 1
  },
  "75": {
   "jp": "d00d82cd9b",
   "kr": "과연, 과연.",
   "auto": 1
  },
  "76": {
   "jp": "73ad29535f",
   "kr": "…이건 되겠는데."
  },
  "77": {
   "jp": "768197185b",
   "kr": "번뜩였다!!",
   "auto": 1
  },
  "78": {
   "jp": "d3fef54ff3",
   "kr": "으음, 창작의 불꽃이 솟아오르는구나.",
   "auto": 1
  },
  "79": {
   "jp": "e5fee30b57",
   "kr": "내 마음속 문예의 샘에서 끝없이 물방울이 떨어지는…"
  },
  "80": {
   "jp": "d647078b37",
   "kr": "어찌 아니 그러하랴.",
   "auto": 1
  },
  "81": {
   "jp": "cd257d347a",
   "kr": "…오오, 지금이다! 써야 해!!",
   "auto": 1
  },
  "82": {
   "jp": "9808dca0c4",
   "kr": "왜 우리가 그런 짓을"
  },
  "83": {
   "jp": "1d5e2135b3",
   "kr": "해야 하는데."
  },
  "84": {
   "jp": "ba6ebdaee3",
   "kr": "자네들,",
   "auto": 1
  },
  "85": {
   "jp": "60fd424b1d",
   "kr": "그다지 대단한 경험은 못 했구먼.",
   "auto": 1
  },
  "86": {
   "jp": "54db3934a4",
   "kr": "그래야만"
  },
  "87": {
   "jp": "2fbc7bc958",
   "kr": "내 붓에 어울리는 이야기도 나올 법하지."
  }
 }
}
