{
 "archive": "/E/SC402.DAT",
 "member": "..\\BIN\\ET00010B.BIN",
 "segments": {
  "0": {
   "jp": "fe924e349e",
   "kr": "여, 어빈."
  },
  "1": {
   "jp": "7a2a9cf7fd",
   "kr": "기다리고 있었어."
  },
  "2": {
   "jp": "248232017a",
   "kr": "다들 모여서 뭐 하고 계세요?"
  },
  "3": {
   "jp": "101c6fe039",
   "kr": "모시 퇴치 계획을 세우는 중이야."
  },
  "4": {
   "jp": "8d06fb648a",
   "kr": "장로님한테는 비밀이야."
  },
  "5": {
   "jp": "acb5299d58",
   "kr": "어빈 너희도"
  },
  "6": {
   "jp": "9e64f3a99f",
   "kr": "성스러운 크리스탈을 못 찾으면 곤란하잖아?"
  },
  "7": {
   "jp": "0fccb71def",
   "kr": "전력으로 머릿수에 넣어 뒀거든."
  },
  "8": {
   "jp": "02b88c55fc",
   "kr": "그런데 정말 괜찮을까."
  },
  "9": {
   "jp": "50e4eaa950",
   "kr": "난 그 커다란 눈알을 떠올리면…"
  },
  "10": {
   "jp": "3ace809d28",
   "kr": "그냥 크기만 한 거라고 했잖아."
  },
  "11": {
   "jp": "b45695ee1e",
   "kr": "무서울 게 하나도 없다니까."
  },
  "12": {
   "jp": "1b96909944",
   "kr": "…음?"
  },
  "13": {
   "jp": "bfc47bace5",
   "kr": "뭐지, 방금 그 파도는…"
  },
  "14": {
   "jp": "f0ffe47eff",
   "kr": "꺄아아아악!!"
  },
  "15": {
   "jp": "719f5c290f",
   "kr": "셀린 씨 목소리야!"
  },
  "16": {
   "jp": "5cef662ecc",
   "kr": "지금 흔들림에 떨어진 건가?"
  },
  "17": {
   "jp": "5802d927af",
   "kr": "가 보자!"
  },
  "18": {
   "jp": "5326da7faa",
   "kr": "리타… 리타아!!"
  },
  "19": {
   "jp": "774336ffad",
   "kr": "미이, 미미이!!"
  },
  "20": {
   "jp": "ae65eb230e",
   "kr": "무슨 일이야!"
  },
  "21": {
   "jp": "67a748218a",
   "kr": "모시가… 모시가 나타나서…"
  },
  "22": {
   "jp": "71bae13565",
   "kr": "리타를 채 가서…"
  },
  "23": {
   "jp": "fce40a99ee",
   "kr": "채 갔다고?"
  },
  "24": {
   "jp": "16fd5092c0",
   "kr": "저희 앞에 갑자기 모시가 나타났어요."
  },
  "25": {
   "jp": "bfcc2acc0b",
   "kr": "그 애가"
  },
  "26": {
   "jp": "253a61a81b",
   "kr": "모시에게 이끌리듯 다가가서…"
  },
  "27": {
   "jp": "176fba0cf2",
   "kr": "모시 머리 위에 올라타서…"
  },
  "28": {
   "jp": "a8fde8788e",
   "kr": "저는 무서워서 다리가 굳어 버리고…"
  },
  "29": {
   "jp": "2c2e5e6e9d",
   "kr": "젠장… 모시 녀석."
  },
  "30": {
   "jp": "4366f4edb5",
   "kr": "그냥 동물이 아니었나?"
  },
  "31": {
   "jp": "3a8ff4517f",
   "kr": "리타!"
  },
  "32": {
   "jp": "4eab19c4b1",
   "kr": "리타아!!"
  }
 }
}
