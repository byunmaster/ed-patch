   "kr": "카라무스 선생",
   "auto": 1
  },
  "2": {
   "jp": "39f83f5631",
   "kr": "클라우드"
  },
  "3": {
   "jp": "23b0a1b8d2",
   "kr": "카르포"
  },
  "4": {
   "jp": "2a972cd78b",
   "kr": "리라"
  },
  "5": {
   "jp": "1da6bfdebf",
   "kr": "메조"
  },
  "6": {
   "jp": "84f79bd5dd",
   "kr": "리나"
  },
  "7": {
   "jp": "7d5dcd98ce",
   "kr": "북",
   "auto": 1
  },
  "8": {
   "jp": "2c3b43acc6",
   "kr": "남",
   "auto": 1
  },
  "9": {
   "jp": "7722745105",
   "kr": "…"
  },
  "10": {
   "jp": "f1af1d73be",
   "kr": "어이, 자네. 알고 있나?"
  },
  "11": {
   "jp": "0fee6576f5",
   "kr": "소문으로는 코르나 마을이 얼어붙었다던데."
  },
  "12": {
   "jp": "908572a0d5",
   "kr": "설마 정말 소문대로 신이 사라져서"
  },
  "13": {
   "jp": "375eb79dc3",
   "kr": "마을이 얼어붙은 건 아니겠지…"
  },
  "14": {
   "jp": "79c6c2357b",
   "kr": "코르나 마을에서 수호신 둘가 님이 사라지면"
  },
  "15": {
   "jp": "4a6da0fffe",
   "kr": "정말 신도 부처도 없는 마을이 되겠군…"
  },
  "16": {
   "jp": "9d17cbeb83",
   "kr": "안됐군."
  },
  "17": {
   "jp": "643a716784",
   "kr": "당신들, 브리작 쪽으로 가는 거야?"
  },
  "18": {
   "jp": "256341c8d0",
   "kr": "그만두는 게 좋아."
  },
  "19": {
   "jp": "1f02941bd0",
   "kr": "엄청나게 흉포한 마수가 득실거리니까."
  },
  "20": {
   "jp": "5e38a0758c",
   "kr": "어째서 이 마을 사람들은"
  },
  "21": {
   "jp": "c1e7f209e1",
   "kr": "오크툼 신자를 사교도라고"
  },
  "22": {
   "jp": "4ad3acb5e4",
   "kr": "하는 걸까."
  },
  "23": {
   "jp": "38f0dbbb88",
   "kr": "딱히 편드는 건 아니지만"
  },
  "24": {
   "jp": "1597221f3a",
   "kr": "저쪽에서 보면"
  },
  "25": {
   "jp": "2222f9eb64",
   "kr": "이쪽이 사교도의 마을일지도 모르지."
  },
  "26": {
   "jp": "87fcbfdef2",
   "kr": "이왕 이렇게 된 거, 성실하게 살자."
  },
  "27": {
   "jp": "15746cf674",
   "kr": "당신, 표정이 어둡네."
  },
  "28": {
   "jp": "1b36ab3cad",
   "kr": "모처럼 귀여운 얼굴인데"
  },
  "29": {
   "jp": "e3b4489a40",
   "kr": "좀 더 활짝 웃는 게 좋아."
  },
  "30": {
   "jp": "753087c335",
   "kr": "씩!"
  },
  "31": {
   "jp": "a96f3b7ab1",
   "kr": "그래그래, 그편이 좋아."
  },
  "32": {
   "jp": "6345b17e1a",
   "kr": "하지만 눈이 좀 무섭네."
  },
  "33": {
   "jp": "35a9e801aa",
   "kr": "힘들 때일수록 웃자."
  },
  "34": {
   "jp": "6b3763905d",
   "kr": "어머, 내가… 표정이 어두웠어?"
  },
  "35": {
   "jp": "6fc5a227be",
   "kr": "이러면 안 되지."
  },
  "36": {
   "jp": "744a039a21",
   "kr": "이런 세상이잖아."
  },
  "37": {
   "jp": "6400e296d5",
   "kr": "그냥 소문일 거라 생각하지만 사교도가 쳐들어온다는"
  },
  "38": {
   "jp": "36fe21a40e",
   "kr": "소문을 들었어."
  },
  "39": {
   "jp": "4c042386f6",
   "kr": "예전의 카테드랄처럼"
  },
  "40": {
   "jp": "f37bbfcc6e",
   "kr": "점령당해 버리면 어쩌지."
  },
  "41": {
   "jp": "9d4403a533",
   "kr": "난 정말 걱정돼서 못 견디겠어…"
  },
  "42": {
   "jp": "5384dfd599",
   "kr": "마을 밖에 나갈 거면 조심하는 게 좋아."
  },
  "43": {
   "jp": "94bd9a4642",
   "kr": "콘페라는 마수는 에어리얼·라브리스를 쓰거든."
  },
  "44": {
   "jp": "ea0ec34f44",
   "kr": "어중간한 모험가는 금세 당하고 말아."
  },
  "45": {
   "jp": "e6f0979fcd",
   "kr": "대성당까지 사교도에게 점령당하면 어쩌지."
  },
  "46": {
   "jp": "d471316be9",
   "kr": "내 남자친구, 브리작에 가 있거든."
  },
  "47": {
   "jp": "556690dfb6",
   "kr": "가도는 아주 위험하니까…"
  },
  "48": {
   "jp": "6c0915535f",
   "kr": "걱정돼."
  },
  "49": {
   "jp": "8df3022bef",
   "kr": "브리작에 갈 거면"
  },
  "50": {
   "jp": "a2ee5ab3bb",
   "kr": "제대로 준비하고 가는 게 좋아."
  },
  "51": {
   "jp": "4430786148",
   "kr": "가도에는 엄청 위험한 마수가 나오거든."
  },
  "52": {
   "jp": "6a46ad4662",
   "kr": "오오! 드디어 왔나."
  },
  "53": {
   "jp": "3c283a0f7a",
   "kr": "자, 자, 짐을…"
  },
  "54": {
   "jp": "b12dc89878",
   "kr": "응? 뉴보른에서 짐을"
  },
  "55": {
   "jp": "0667852421",
   "kr": "운반해 온 게 아닌가?"
  },
  "56": {
   "jp": "00345b3a93",
   "kr": "그런가, 아니로군."
  },
  "57": {
   "jp": "0df8516d02",
   "kr": "미안하네."
  },
  "58": {
   "jp": "0923cf7778",
   "kr": "사람을 잘못 봤군. 신경 쓰지 말게."
  },
  "59": {
   "jp": "33d2eccd8a",
   "kr": "이 병이 오기를 얼마나 기다렸는지."
  },
  "60": {
   "jp": "be3762dd96",
   "kr": "이야, 정말 고맙네."
  },
  "61": {
   "jp": "7ee43f71ca",
   "kr": "마신다, 마신다. 술을 마신다."
  },
  "62": {
   "jp": "1c9482fc84",
   "kr": "세계에서 제일 맛있는 술을 마신다."
  },
  "63": {
   "jp": "34e566a7cd",
   "kr": "와하하하하!"
  },
  "64": {
   "jp": "a6456a4d48",
   "kr": "여어, 여행자 제군. 잘 지내고 있나?"
  },
  "65": {
   "jp": "6e1a3b8c33",
   "kr": "싸움 같은 건 하면 못써."
  },
  "66": {
   "jp": "d5547a4d26",
   "kr": "…그리고 또 대지도 물 위에 있어…"
  },
  "67": {
   "jp": "b897f90f3a",
   "kr": "대우주의 신비에 비하면"
  },
  "68": {
   "jp": "4c60afe457",
   "kr": "원고가 뭐라고…"
  },
  "69": {
   "jp": "5059e81a3c",
   "kr": "저런 일 하면서 행복할까."
  }
 }
}
