  "14": {
   "jp": "01c65c72ab",
   "kr": "스테인드글라스 기준"
  },
  "15": {
   "jp": "fbe39c640b",
   "kr": "스테인드글라스 오른쪽 ０"
  },
  "16": {
   "jp": "a1fc664737",
   "kr": "며칠 뒤"
  },
  "17": {
   "jp": "17587bedee",
   "kr": "그대로 두기로 했다."
  },
  "18": {
   "jp": "4c538bff9e",
   "kr": "로네가 공부해서"
  },
  "19": {
   "jp": "32f19fb19c",
   "kr": "언젠가 직접 스테인드글라스를 고치고 싶다고"
  },
  "20": {
   "jp": "5ff4274289",
   "kr": "하는구나."
  },
  "21": {
   "jp": "66c9d9132f",
   "kr": "그 아이는 그 스테인드글라스를 좋아했으니까."
  },
  "22": {
   "jp": "3a8068f061",
   "kr": "루티스가 일행에 합류했다."
  },
  "23": {
   "jp": "c7eec980e6",
   "kr": "진실의 섬이라니요…"
  },
  "24": {
   "jp": "a6094c0957",
   "kr": "파도가 무시무시하게 거친 바다를 건너야 한다고 합니다."
  },
  "25": {
   "jp": "7f98ee54f2",
   "kr": "부디 무사하시길."
  },
  "26": {
   "jp": "00dd09e498",
   "kr": "어빈 씨, 루티스 씨."
  },
  "27": {
   "jp": "622cd4701e",
   "kr": "여러분께 발두스 님의 가호가 있기를."
  },
  "28": {
   "jp": "c8a74f6f26",
   "kr": "볼게이드 놈…!"
  },
  "29": {
   "jp": "677cf1c091",
   "kr": "성직자로서 해서는 안 될 말이지만,"
  },
  "30": {
   "jp": "59b16b74c6",
   "kr": "도저히 용서할 수 없습니다!"
  },
  "31": {
   "jp": "9f7f96b839",
   "kr": "전이문은 잘 활용해 주세요."
  },
  "32": {
   "jp": "334d65e92c",
   "kr": "도움이 되어 기쁩니다."
  },
  "33": {
   "jp": "6737f67bc6",
   "kr": "어빈 씨,",
   "auto": 1
  },
  "34": {
   "jp": "1ccbf54866",
   "kr": "기운을 잃으면 안 돼요."
  },
  "35": {
   "jp": "1303d85603",
   "kr": "분명 발두스 님의 가호가 있을 테니까요."
  },
  "36": {
   "jp": "bfe0a86e06",
   "kr": "아, 어빈 씨."
  },
  "37": {
   "jp": "013ca8871e",
   "kr": "신관장님이 지하로 내려가셨어요."
  },
  "38": {
   "jp": "3a52c5e880",
   "kr": "당신에게 드리고 싶은 물건이 있으시대요."
  },
  "39": {
   "jp": "48a07fb2cf",
   "kr": "전이문, 쓰고 있나요?"
  },
  "40": {
   "jp": "6070ababd6",
   "kr": "나도 한번 써 보고 싶네."
  },
  "41": {
   "jp": "82142caafa",
   "kr": "실은 발크드에서 한 번도 나가 본 적이 없거든요."
  },
  "42": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "43": {
   "jp": "cd348b1b47",
   "kr": "조용히 눈을 감으세요."
  },
  "44": {
   "jp": "4b71ccc4fb",
   "kr": "그러면 발두스 님을 만날 수 있어."
  },
  "45": {
   "jp": "776d919609",
   "kr": "어떤 슬픔도, 괴로움도…"
  },
  "46": {
   "jp": "00f53d9b77",
   "kr": "발두스 님께 매달리면 반드시 치유됩니다."
  },
  "47": {
   "jp": "a8d25d8598",
   "kr": "베리어스나 볼게이드 따위, 두려워할 것 없습니다."
  },
  "48": {
   "jp": "19b0982d61",
   "kr": "이렇게 명상하면 발두스 님이 힘을 빌려 주십니다."
  },
  "49": {
   "jp": "3ce7d5da9b",
   "kr": "발두스 님, 발두스 님, 발두스 님…"
  },
  "50": {
   "jp": "020b394f6c",
   "kr": "고뇌하는 이를 구원해 주소서…"
  },
  "51": {
   "jp": "b1cd256d4f",
   "kr": "어빈 씨, 당신의 슬픔을…"
  },
  "52": {
   "jp": "44d94e29e7",
   "kr": "발두스 님이 치유해 주시기를."
  },
  "53": {
   "jp": "67d56df63a",
   "kr": "저는 벌써 ２０년이나 여기서 기도하고 있습니다."
  },
  "54": {
   "jp": "969092396c",
   "kr": "이곳 승려들도 모두 매일 기도하고 있지요."
  },
  "55": {
   "jp": "b0c976a5a3",
   "kr": "그래서 발두스 님은 우리를 도와주시는 것입니다."
  },
  "56": {
   "jp": "0c4c07beea",
   "kr": "걱정 마세요. 발크드 신전의 경비는 빈틈없습니다."
  },
  "57": {
   "jp": "eca1a97343",
   "kr": "혹시 한 번 더 오크툼 신도가 쳐들어와도"
  },
  "58": {
   "jp": "2221a462fb",
   "kr": "걱정은 없습니다."
  },
  "59": {
   "jp": "41f8529a48",
   "kr": "이번에야말로 경비는 빈틈없습니다."
  },
  "60": {
   "jp": "38c26623ec",
   "kr": "아아, 아이멜 씨, 가엾게도…"
  },
  "61": {
   "jp": "af2c5c4d32",
   "kr": "발두스 님의 성지에서 어찌 이런 일이 허용된단 말인가."
  },
  "62": {
   "jp": "8e491528f1",
   "kr": "크로웰 님은 만나 뵈셨나요?"
  },
  "63": {
   "jp": "decc067585",
   "kr": "크로웰 님을 비롯하여"
  },
  "64": {
   "jp": "be90240b9a",
   "kr": "발크드의 모든 이가 여러분을"
  },
  "65": {
   "jp": "a1c4f26623",
   "kr": "걱정하고 있습니다."
  },
  "66": {
   "jp": "bbf071e0af",
   "kr": "부디 조심해."
  },
  "67": {
   "jp": "287b886d63",
   "kr": "전이문을 쓰시는군요."
  },
  "68": {
   "jp": "89f21cc2bc",
   "kr": "오늘은 필딘으로 가시나요?"
  },
  "69": {
   "jp": "47a1658b5c",
   "kr": "아니면 바로아?"
  },
  "70": {
   "jp": "313ded3076",
   "kr": "어쩜 이렇게 끔찍한 짓을…"
  },
  "71": {
   "jp": "af356ebfc6",
   "kr": "이 스테인드글라스,"
  },
  "72": {
   "jp": "f6eef80f4c",
   "kr": "언젠가 꼭 제가 복원해 보이겠어요."
  },
  "73": {
   "jp": "d6636926fb",
   "kr": "지켜봐 주세요."
  },
  "74": {
   "jp": "7f16fe5eb8",
   "kr": "앗, 어빈 씨."
  },
  "75": {
   "jp": "6070dc129d",
   "kr": "오랜만이에요."
  },
  "76": {
   "jp": "0f10fb6419",
   "kr": "뚫어지게 봤으니까"
  },
  "77": {
   "jp": "99bbac6b17",
   "kr": "스테인드글라스의 배색은 전부 기억해요."
  },
  "78": {
   "jp": "fbb2b440b7",
   "kr": "문제는 유리의 강도예요."
  },
  "79": {
   "jp": "1f1832ea4b",
   "kr": "좀 더 공부하지 않으면…"
  },
  "80": {
   "jp": "93d0056996",
   "kr": "너무 무리하지 마세요."
  },
  "81": {
   "jp": "cea9565f21",
   "kr": "어빈 씨 일행에게 무슨 일이라도 생기면"
  },
  "82": {
   "jp": "2ed2669a68",
   "kr": "제가 스테인드글라스를 고쳐도"
  },
  "83": {
   "jp": "6122b6dc2a",
   "kr": "보여 드릴 수 없잖아요."
  },
  "84": {
   "jp": "f653915298",
   "kr": "그런 건, 그런 건, 저는…"
  },
  "85": {
   "jp": "560722db4a",
   "kr": "여러분께"
  },
  "86": {
   "jp": "02d944bc06",
   "kr": "발두스 님의 가호가 있기를."
  },
  "87": {
   "jp": "ed4fe2cfb8",
   "kr": "이렇게 명상하면"
  },
  "88": {
   "jp": "301ca84b62",
   "kr": "발두스 님이 힘을 빌려 주십니다."
  },
  "89": {
   "jp": "930d39a718",
   "kr": "그러니 발두스 님은"
  },
  "90": {
   "jp": "ea48072b64",
   "kr": "우리를 도와주시는 겁니다."
  },
  "91": {
   "jp": "cca5a8a0cf",
   "kr": "발두스 님의 성지에서"
  },
  "92": {
   "jp": "9ffa6b78c2",
   "kr": "어찌 이런 일이 용납되는 걸까."
  }
 }
