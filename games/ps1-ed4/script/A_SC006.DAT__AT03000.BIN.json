{
 "archive": "/A/SC006.DAT",
 "member": "..\\BIN\\AT03000.BIN",
 "segments": {
  "0": {
   "jp": "fdc2a91a52",
   "kr": "레니"
  },
  "1": {
   "jp": "0c4a372a51",
   "kr": "치브리 마을 촌장"
  },
  "2": {
   "jp": "1e195f6292",
   "kr": "섀넌"
  },
  "3": {
   "jp": "cc1f641320",
   "kr": "섀넌 아빠"
  },
  "4": {
   "jp": "a9710d8b9a",
   "kr": "섀넌 엄마"
  },
  "5": {
   "jp": "23113b40e8",
   "kr": "도구점 주인",
   "auto": 1
  },
  "6": {
   "jp": "6d420024d1",
   "kr": "콜리"
  },
  "7": {
   "jp": "4eed83c390",
   "kr": "셀마"
  },
  "8": {
   "jp": "69db0317d2",
   "kr": "소녀"
  },
  "9": {
   "jp": "e5aced6279",
   "kr": "토리노 할아버지"
  },
  "10": {
   "jp": "2c3b43acc6",
   "kr": "남 "
  },
  "11": {
   "jp": "2ff57fa65e",
   "kr": "동 ",
   "auto": 1
  },
  "12": {
   "jp": "9f6565ff82",
   "kr": "치브리 마을은 좋은 곳이지요?"
  },
  "13": {
   "jp": "e931a7e3f8",
   "kr": "이 마을 변두리에"
  },
  "14": {
   "jp": "41bdf4f852",
   "kr": "디너켄 님이 계셔서"
  },
  "15": {
   "jp": "27152f7e2d",
   "kr": "여러모로 도움이 된다오."
  },
  "16": {
   "jp": "b74c070a64",
   "kr": "현자님이 와 주신 뒤로는"
  },
  "17": {
   "jp": "ac5488c63b",
   "kr": "악인도 활개 치지 못하고"
  },
  "18": {
   "jp": "a19547743c",
   "kr": "지혜도 빌릴 수 있지."
  },
  "19": {
   "jp": "3f1adc9a54",
   "kr": "고마운 일이네."
  },
  "20": {
   "jp": "4cd6d8b5ff",
   "kr": "어라, 전에 본 얼굴이로군."
  },
  "21": {
   "jp": "ba51708bfe",
   "kr": "나는 기억력에는 자신이 있다오."
  },
  "22": {
   "jp": "39a25159cc",
   "kr": "참고로 나는"
  },
  "23": {
   "jp": "0d912c7e8d",
   "kr": "２０년 전에 촌장이 된 이래… 어?"
  },
  "24": {
   "jp": "a82134f544",
   "kr": "２１년 전이었던가."
  },
  "25": {
   "jp": "c56b4ef9f3",
   "kr": "아니… ２２년 전이려나…?"
  },
  "26": {
   "jp": "eafb515585",
   "kr": "어라, 어라라라…"
  },
  "27": {
   "jp": "8d276bbb2b",
   "kr": "잊어버렸구먼."
  },
  "28": {
   "jp": "605a41b995",
   "kr": "그, 그러니까."
  },
  "29": {
   "jp": "14481636ad",
   "kr": "치브리 마을은 모든 걸 잊어버릴 만큼"
  },
  "30": {
   "jp": "873e06cd5f",
   "kr": "이렇다 할 사건도 일어나지 않는"
  },
  "31": {
   "jp": "4f6dbb2df1",
   "kr": "아주 오랫동안 평화로운 마을이었다는 말이네."
  },
  "32": {
   "jp": "718053dad1",
   "kr": "뭐, 섀넌이 여행에서 돌아오지 않았지만"
  },
  "33": {
   "jp": "63673f93e7",
   "kr": "머지않아 훌쩍 돌아오겠지."
  },
  "34": {
   "jp": "6c1758e783",
   "kr": "이 마을은 사건과는 인연이 없는 마을이니까."
  },
  "35": {
   "jp": "b77695abed",
   "kr": "여행이 순조롭도록 기도할게요."
  },
  "36": {
   "jp": "384e8aeec6",
   "kr": "정말이지, 우리 딸은…"
  },
  "37": {
   "jp": "f878e430ad",
   "kr": "심부름을 보냈더니"
  },
  "38": {
   "jp": "2fbf3ef635",
   "kr": "가고 나서 소식이 없네."
  },
  "39": {
   "jp": "3e7ef8cbc6",
   "kr": "셴나처럼"
  },
  "40": {
   "jp": "fdad0c5190",
   "kr": "디너켄 님 댁에 들어가 일하며"
  },
  "41": {
   "jp": "b63fe0568a",
   "kr": "단련을 받게 해 볼까…"
  },
  "42": {
   "jp": "84198644ac",
   "kr": "남자끼리 하는 여행도 좋은 법이지."
  },
  "43": {
   "jp": "45ba3a4122",
   "kr": "너무 무리하지 말고 가게나."
  },
  "44": {
   "jp": "bfb0ab8a73",
   "kr": "어라, 어빈 씨."
  },
  "45": {
   "jp": "45370e1693",
   "kr": "오랜만이네요."
  },
  "46": {
   "jp": "555d012d5b",
   "kr": "그런데"
  },
  "47": {
   "jp": "67ca53ba9d",
   "kr": "우리 섀넌을 여행 중에 어디서"
  },
  "48": {
   "jp": "f0ba8ebc13",
   "kr": "보지 못했나요?"
  },
  "49": {
   "jp": "b816af7dba",
   "kr": "섀넌 녀석, 왕자님을 찾겠다느니"
  },
  "50": {
   "jp": "67db5848c3",
   "kr": "또 잠꼬대 같은 소리를 하고는"
  },
  "51": {
   "jp": "ac1309946c",
   "kr": "휙 여행을 떠나 버렸답니다."
  },
  "52": {
   "jp": "cf788aa4fa",
   "kr": "그러고 보니 마일 군은요?"
  },
  "53": {
   "jp": "c88ee62be2",
   "kr": "아, 아니…"
  },
  "54": {
   "jp": "c7543f6574",
   "kr": "아아, 돌아갔군요."
  },
  "55": {
   "jp": "2a2676957b",
   "kr": "우리 섀넌도 얼른 돌아오면 좋을 텐데."
  },
  "56": {
   "jp": "aca5bc3cf7",
   "kr": "참, 부모를 걱정시키는 딸이라니까."
  },
  "57": {
   "jp": "3c83e5a254",
   "kr": "어빈 씨."
  },
  "58": {
   "jp": "03ca1d1f6c",
   "kr": "섀넌을 어디선가 보게 되거든"
  },
  "59": {
   "jp": "cb7aa9c99e",
   "kr": "얼른 집에 돌아오라고 전해 주세요."
  },
  "60": {
   "jp": "95864792de",
   "kr": "우리 딸은 딴 길로 새는 걸 좋아해서요."
  },
  "61": {
   "jp": "234ea41d95",
   "kr": "금세 샛길로 빠지거든요."
  },
  "62": {
   "jp": "2e414dc45b",
   "kr": "또 와 주세요."
  },
  "63": {
   "jp": "6b40979eb9",
   "kr": "언제든 환영이에요."
  },
  "64": {
   "jp": "992f1adbe4",
   "kr": "정말이지, 섀넌은"
  },
  "65": {
   "jp": "5d688d18a7",
   "kr": "혼자 어디로 간 걸까요."
  },
  "66": {
   "jp": "7ad7adc246",
   "kr": "혹시 어디서 사고에 휘말려…"
  },
  "67": {
   "jp": "f2e95ec596",
   "kr": "아니, 아니. 나쁜 상상은 그만두죠."
  },
  "68": {
   "jp": "fafda4a411",
   "kr": "그 아이니까"
  },
  "69": {
   "jp": "9b57b63156",
   "kr": "분명 어디선가 잘 지내고 있을 거예요."
  },
  "70": {
   "jp": "1afe93bf8b",
   "kr": "내 자랑은 외동딸 셴나가"
  },
  "71": {
   "jp": "b667320d74",
   "kr": "디너켄 님을 모시고 있다는 거지."
  },
  "72": {
   "jp": "13f2756c04",
   "kr": "보통 현자라면 까다로운 법인데"
  },
  "73": {
   "jp": "03186ab276",
   "kr": "디너켄 님은 정말 상냥한 분이라"
  },
  "74": {
   "jp": "cd73bb1e2d",
   "kr": "딸도 잘 대해 주신다고."
  },
  "75": {
   "jp": "8be9c191c2",
   "kr": "신부 수업 삼아 보낼 생각으로"
  },
  "76": {
   "jp": "671d9553e7",
   "kr": "셴나를 디너켄 님 댁에 일하러 보냈는데"
  },
  "77": {
   "jp": "e37321a12a",
   "kr": "효과가 너무 좋아서… 난감하군."
  },
  "78": {
   "jp": "942a2e572c",
   "kr": "요즘엔 집에 올 때마다"
  },
  "79": {
   "jp": "25a88665d0",
   "kr": "도리어 '정신 차리세요' 소리를 듣는다니까."
  },
  "80": {
   "jp": "3d07597716",
   "kr": "저러다 시집가면 신랑을 꽉 쥐고 살겠어."
  },
  "81": {
   "jp": "ac3904acfb",
   "kr": "뭐, 딸 셴나가"
  },
  "82": {
   "jp": "642133590e",
   "kr": "야무진 사람이 되어 주는 건"
  },
  "83": {
   "jp": "db7a43e13b",
   "kr": "나쁜 일은 아니지."
  },
  "84": {
   "jp": "930f29a65a",
   "kr": "불평도 못 하겠군."
  },
  "85": {
   "jp": "04a16379fb",
   "kr": "디너켄 님 곁에 있으면"
  },
  "86": {
   "jp": "6f9c486917",
   "kr": "셴나의 신부 수업도 되고"
  },
  "87": {
   "jp": "00dce102a1",
   "kr": "어미인 나도 안심이야."
  },
  "88": {
   "jp": "8fbeb3a9cc",
   "kr": "조금은 얌전해져"
  },
  "89": {
   "jp": "bbc65f4537",
   "kr": "주면"
  },
  "90": {
   "jp": "df354f9122",
   "kr": "좋겠는데 말이야."
  },
  "91": {
   "jp": "298e767a03",
   "kr": "어머, 너는 디너켄 님의 제자…"
  },
  "92": {
   "jp": "6b3daeca51",
   "kr": "어…!?"
  },
  "93": {
   "jp": "c88bc78816",
   "kr": "셴나한테서 벌써 시골로 돌아갔다고 들었는데"
  },
  "94": {
   "jp": "8da9ba5b4e",
   "kr": "오랜만에 디너켄 님께 인사라도 드리러"
  },
  "95": {
   "jp": "a9e762808b",
   "kr": "오신 건가요?"
  },
  "96": {
   "jp": "896d1b6dbe",
   "kr": "아… 네."
  },
  "97": {
   "jp": "e016bfea93",
   "kr": "언제까지고 제자들이 따르다니"
  },
  "98": {
   "jp": "62faad1df9",
   "kr": "디너켄 님은 정말 훌륭한 분이시네요."
  },
  "99": {
   "jp": "9832e68da9",
   "kr": "아주 위대한 현자님인데도"
  },
  "100": {
   "jp": "acc7950b1b",
   "kr": "그렇게 가까이서 사람들에게 사랑받는 분은"
  },
  "101": {
   "jp": "c89e0d0846",
   "kr": "좀처럼 안 계시답니다."
  },
  "102": {
   "jp": "5f715be317",
   "kr": "있잖아요, 예쁜 언니랑"
  },
  "103": {
   "jp": "3467ae188b",
   "kr": "커다란 아저씨가"
  },
  "104": {
   "jp": "e9e3fe81be",
   "kr": "디너켄 님한테 갔어요."
  },
  "105": {
   "jp": "538390f15e",
   "kr": "내가 데려다준다고 했는데"
  },
  "106": {
   "jp": "df251f7e88",
   "kr": "길만 묻고 가 버렸어요."
  },
  "107": {
   "jp": "e119dd0604",
   "kr": "정말 실례예요."
  },
  "108": {
   "jp": "5de2ad4ea2",
   "kr": "있잖아요, 전에 디너켄 님한테 갔던"
  },
  "109": {
   "jp": "2865beac8c",
   "kr": "언니랑 아저씨가 돌아왔어요."
  },
  "110": {
   "jp": "e085e2cf78",
   "kr": "디너켄 님을 만났냐고 물었더니"
  },
  "111": {
   "jp": "74f2477aa6",
   "kr": "무시하고 가 버렸어요."
  },
  "112": {
   "jp": "e119dd0604",
   "kr": "정말 실례예요."
  },
  "113": {
   "jp": "5a466e2ed3",
   "kr": "있잖아요."
  },
  "114": {
   "jp": "2c4e9df601",
   "kr": "이 마을에는 셴나 언니랑"
  },
  "115": {
   "jp": "9b585087fc",
   "kr": "섀넌 언니,"
  },
  "116": {
   "jp": "4fc006929d",
   "kr": "언니가 둘 있었어요."
  },
  "117": {
   "jp": "c437bfea76",
   "kr": "셴나 언니는"
  },
  "118": {
   "jp": "43e8354849",
   "kr": "디너켄 님 댁에 있지만."
  },
  "119": {
   "jp": "e54265e428",
   "kr": "섀넌 언니는 여행을 떠난 뒤로"
  },
  "120": {
   "jp": "c04c8d6050",
   "kr": "쭉 돌아오지 않아요."
  },
  "121": {
   "jp": "65bfc0372f",
   "kr": "섀넌 언니, 어디 갔을까."
  },
  "122": {
   "jp": "4931465959",
   "kr": "보고 싶다."
  },
  "123": {
   "jp": "bba10ebeb1",
   "kr": "또 같이 놀고 싶다."
  },
  "124": {
   "jp": "b006a30971",
   "kr": "와 주셨군요!"
  },
  "125": {
   "jp": "7c1370631c",
   "kr": "마일 님, 어빈 님."
  },
  "126": {
   "jp": "bb91c3a4fa",
   "kr": "자, 이쪽으로 오세요."
  },
  "127": {
   "jp": "c7737a29b2",
   "kr": "자네들이 위험에 처한 우리 딸을"
  },
  "128": {
   "jp": "82dac8eb7e",
   "kr": "구해 줬다더군."
  },
  "129": {
   "jp": "6c1116dbfe",
   "kr": "정말 감사합니다."
  },
  "130": {
   "jp": "ac39d099f5",
   "kr": "혼자는 위험하다고 주의를 줬는데"
  },
  "131": {
   "jp": "96cc0f85e0",
   "kr": "이 애는 괜찮다면서…"
  },
  "132": {
   "jp": "7c09adc1a9",
   "kr": "말하자면 왕자님이 둘 나타난 셈이로군."
  },
  "133": {
   "jp": "4ae9772df2",
   "kr": "아니, 자네들이라면 어느 쪽이든 대환영이야."
  },
  "134": {
   "jp": "437fc7fa4a",
   "kr": "네?"
  },
  "135": {
   "jp": "863ae32125",
   "kr": "섀넌, 넌 어느 쪽이 좋니?"
  },
  "136": {
   "jp": "cf4f111d85",
   "kr": "엄마도 참…"
  },
  "137": {
   "jp": "963a5459ea",
   "kr": "모, 모처럼 만든 요리가 식어 버려요."
  },
  "138": {
   "jp": "5f887208d8",
   "kr": "어서 드세요."
  },
  "139": {
   "jp": "d52e77ce1f",
   "kr": "어라? 별일이네."
  },
  "140": {
   "jp": "3e3a3a9657",
   "kr": "섀넌이 쑥스러워하고 있군."
  },
  "141": {
   "jp": "1e2a7db2bb",
   "kr": "그럼."
  },
  "142": {
   "jp": "5e57d0c714",
   "kr": "잘 먹겠습니다."
  },
  "143": {
   "jp": "302f61ff86",
   "kr": "…어때요?"
  },
  "144": {
   "jp": "f8e0eeeba2",
   "kr": "맛있다!"
  },
  "145": {
   "jp": "e9d67344a5",
   "kr": "응, 최고야."
  },
  "146": {
   "jp": "7eeeacaa67",
   "kr": "다행이다."
  },
  "147": {
   "jp": "94891af598",
   "kr": "사양 말고 많이 먹으렴."
  },
  "148": {
   "jp": "7667c1d4bd",
   "kr": "네."
  },
  "149": {
   "jp": "e14350e74f",
   "kr": "어빈 일행은 섀넌의 집에서"
  },
  "150": {
   "jp": "18b91a12aa",
   "kr": "식사를 대접받으며"
  },
  "151": {
   "jp": "88a6a7de26",
   "kr": "즐거운 한때를 보냈다."
  },
  "152": {
   "jp": "50500f1048",
   "kr": "오늘 정말 즐거웠어요."
  },
  "153": {
   "jp": "dea4992c54",
   "kr": "고마워요."
  },
  "154": {
   "jp": "0d2b5875e5",
   "kr": "나야말로."
  },
  "155": {
   "jp": "ff947c39c8",
   "kr": "그렇게나 대접을 받았는걸."
  },
  "156": {
   "jp": "24152f9885",
   "kr": "저, 마일 님은"
  },
  "157": {
   "jp": "d03946001f",
   "kr": "이제 어디로 가세요?"
  },
  "158": {
   "jp": "437fc7fa4a",
   "kr": "어?"
  },
  "159": {
   "jp": "c418c4c17b",
   "kr": "음～ 맞혀 봐."
  },
  "160": {
   "jp": "4966167af3",
   "kr": "할머니가 점쟁이셨어서"
  },
  "161": {
   "jp": "24df6fb0db",
   "kr": "저도 간단한 점이라면 칠 수 있어요."
  },
  "162": {
   "jp": "1c4776ebd0",
   "kr": "어, 그, 그래?"
  },
  "163": {
   "jp": "7d6730fee1",
   "kr": "음…"
  },
  "164": {
   "jp": "0429839f79",
   "kr": "마일 님은 이제"
  },
  "165": {
   "jp": "d524e1085f",
   "kr": "서쪽으로 향하시죠?"
  },
  "166": {
   "jp": "5e93a2cf70",
   "kr": "대단해!"
  },
  "167": {
   "jp": "527b319591",
   "kr": "베네키아 수도원은 서쪽이야."
  },
  "168": {
   "jp": "a7d940a22f",
   "kr": "어, 정말요?"
  },
  "169": {
   "jp": "973cdfcb5f",
   "kr": "처음으로 맞혔어요."
  },
  "170": {
   "jp": "40886ef7cc",
   "kr": "뭐, 뭐야."
  },
  "171": {
   "jp": "036ec5a7fa",
   "kr": "하하하하하…"
  },
  "172": {
   "jp": "e32eb98b53",
   "kr": "…저기, 마일 님?"
  },
  "173": {
   "jp": "0b8eba4cea",
   "kr": "아무것도 아니에요."
  },
  "174": {
   "jp": "7197330888",
   "kr": "조심해서 가세요."
  },
  "175": {
   "jp": "cc3fc6f414",
   "kr": "기다려 주세요!"
  },
  "176": {
   "jp": "2a9da108bb",
   "kr": "아까 보답을 못 했는데"
  },
  "177": {
   "jp": "86ed34bae8",
   "kr": "이대로 가 버리시는 건가요?"
  },
  "178": {
   "jp": "7c1370631c",
   "kr": "마일 님, 어빈 님."
  },
  "179": {
   "jp": "2605b77b6c",
   "kr": "부디 저희 집에 와 주세요."
  },
  "180": {
   "jp": "95f5a815b5",
   "kr": "어떡할래?"
  },
  "181": {
   "jp": "175a0d02f8",
   "kr": "모처럼이니 가 볼까."
  },
  "182": {
   "jp": "1c0a3ba79b",
   "kr": "마을 안이라면 사교도도 덤벼들지 않겠지."
  },
  "183": {
   "jp": "5c187877d5",
   "kr": "사교도?"
  },
  "184": {
   "jp": "192ce7634b",
   "kr": "아니, 신경 쓰지 마."
  },
  "185": {
   "jp": "596acfad87",
   "kr": "그럼 사양 않고 신세 질게."
  },
  "186": {
   "jp": "4d92095ca8",
   "kr": "기뻐요."
  },
  "187": {
   "jp": "c167b386e8",
   "kr": "자, 이쪽이에요."
  },
  "188": {
   "jp": "8936463455",
   "kr": "에고, 따분하구먼."
  },
  "189": {
   "jp": "84bc38cd8c",
   "kr": "누가 편지라도 보내 주면 좋으련만."
  },
  "190": {
   "jp": "68fbef7d4e",
   "kr": "응?"
  },
  "191": {
   "jp": "cfc9496a8b",
   "kr": "토리노 할아버지 맞죠?"
  },
  "192": {
   "jp": "3ee3736975",
   "kr": "그렇소만."
  },
  "193": {
   "jp": "2d52bd3546",
   "kr": "필딘의 로벨 할아버지한테서"
  },
  "194": {
   "jp": "8aa9389ed3",
   "kr": "편지를 맡아 왔어요."
  },
  "195": {
   "jp": "4283aa3efa",
   "kr": "오, 로벨한테서?"
  },
  "196": {
   "jp": "39864c754e",
   "kr": "이거"
  },
  "197": {
   "jp": "717ef5145b",
   "kr": "반갑구먼…"
  },
  "198": {
   "jp": "f637e04457",
   "kr": "어빈은 로벨의 편지를 건넸다."
  },
  "199": {
   "jp": "bafda778ba",
   "kr": "어디 보자, 호오…"
  },
  "200": {
   "jp": "a72d44764e",
   "kr": "흠흠흠."
  },
  "201": {
   "jp": "f0b6aa86e6",
   "kr": "토리노 할아버지는"
  },
  "202": {
   "jp": "9ec4077587",
   "kr": "곧바로 편지를 읽기 시작했다."
  },
  "203": {
   "jp": "15e077a61c",
   "kr": "…그런가."
  },
  "204": {
   "jp": "7b4fedcbfb",
   "kr": "아직도 필딘에"
  },
  "205": {
   "jp": "f7a2d1b130",
   "kr": "나를 생각해 주는"
  },
  "206": {
   "jp": "cec43800f3",
   "kr": "친구가 있었구먼…"
  },
  "207": {
   "jp": "83693cc951",
   "kr": "역시 좋은 벗을 둔 보람이 있구먼."
  },
  "208": {
   "jp": "41913ec883",
   "kr": "고마운 일이네."
  },
  "209": {
   "jp": "0137b6b27d",
   "kr": "아직도 나를"
  },
  "210": {
   "jp": "bac62335b7",
   "kr": "마음에 두는 이가 있다니."
  },
  "211": {
   "jp": "bf9bc26447",
   "kr": "늙은이에게는"
  },
  "212": {
   "jp": "e7dd330e1d",
   "kr": "그것만으로도 기쁜 법이네."
  },
  "213": {
   "jp": "86f05ac67a",
   "kr": "에휴."
  },
  "214": {
   "jp": "3abb6188a1",
   "kr": "그나저나 늙은 몸의"
  },
  "215": {
   "jp": "761cd388b3",
   "kr": "답답함이여…"
  },
  "216": {
   "jp": "318c6fd4ac",
   "kr": "젊을 때는"
  },
  "217": {
   "jp": "5463a1ecd7",
   "kr": "혼자서 곧잘 필딘까지"
  },
  "218": {
   "jp": "2d279825d1",
   "kr": "놀러 다녔건만."
  },
  "219": {
   "jp": "fff14e428b",
   "kr": "나이에는 못 당해"
  },
  "220": {
   "jp": "fad9ffde9d",
   "kr": "지금은 이 작은 마을에서 멍하니 지낼 뿐이오."
  },
  "221": {
   "jp": "fa3e5ec273",
   "kr": "아아, 따분하구먼…"
  },
  "222": {
   "jp": "68fbef7d4e",
   "kr": "응?"
  },
  "223": {
   "jp": "90fba5f587",
   "kr": "뉴보른의 오리오 씨가 보낸 편지예요."
  },
  "224": {
   "jp": "834227a054",
   "kr": "호오, 오리오한테서…"
  },
  "225": {
   "jp": "5ed27004df",
   "kr": "그 녀석, 다리를 다쳤다고 들었는데"
  },
  "226": {
   "jp": "febbb4bbea",
   "kr": "괜찮은 건가…"
  },
  "227": {
   "jp": "f8be0496a8",
   "kr": "토리노는 편지를 받았다."
  },
  "228": {
   "jp": "48feff3583",
   "kr": "오오, 이럴 수가, 건강해졌다니."
  },
  "229": {
   "jp": "0612aeb1c5",
   "kr": "음음, 이거 잘됐구먼."
  },
  "230": {
   "jp": "4531213f5b",
   "kr": "게다가 우리 집까지 놀러 온다고?"
  },
  "231": {
   "jp": "ed203713ef",
   "kr": "훌륭하군!"
  },
  "232": {
   "jp": "7e11a65159",
   "kr": "…자네들, 수고했네."
  },
  "233": {
   "jp": "1fd9f320fc",
   "kr": "이제 바빠지겠구먼."
  },
  "234": {
   "jp": "8936463455",
   "kr": "에고, 따분하구먼."
  },
  "235": {
   "jp": "84bc38cd8c",
   "kr": "누가 편지라도 보내 주면 좋으련만."
  },
  "236": {
   "jp": "ecb3578611",
   "kr": "아아, 기쁘구먼."
  },
  "237": {
   "jp": "2c07522dd3",
   "kr": "오리오가 찾아온다니."
  },
  "238": {
   "jp": "37f552e316",
   "kr": "무슨 이야기를 할까."
  },
  "239": {
   "jp": "febaccb694",
   "kr": "어머나, 약초를 가져다줬구나."
  },
  "240": {
   "jp": "392a5f4952",
   "kr": "가까이 오기만 해도 바로 알았어."
  },
  "241": {
   "jp": "3504999c48",
   "kr": "냄새가 엄청나니까."
  },
  "242": {
   "jp": "81637eaf76",
   "kr": "할아버지를 위한 약초였어."
  },
  "243": {
   "jp": "bcdc0a90b2",
   "kr": "오는 길이 힘들었지? 괜찮아?"
  },
  "244": {
   "jp": "7b36ba86ff",
   "kr": "하아, 그래도 이제 익숙해져서"
  },
  "245": {
   "jp": "6723f5b459",
   "kr": "신경 안 쓰여여."
  },
  "246": {
   "jp": "f5a65a3407",
   "kr": "…………괜찮아여."
  },
  "247": {
   "jp": "2c542628ce",
   "kr": "타크가 맡긴 약초를 전달했다."
  },
  "248": {
   "jp": "1f042d642b",
   "kr": "수고했어요."
  },
  "249": {
   "jp": "6b8c0e4465",
   "kr": "그나저나 정말 지독한 냄새네."
  },
  "250": {
   "jp": "9d914bf3c7",
   "kr": "이 냄새를 견딜 수 있다면"
  },
  "251": {
   "jp": "cc75ca77b9",
   "kr": "우리 할아버지도 아직 멀쩡하겠네."
  },
  "252": {
   "jp": "62547af4e8",
   "kr": "무슨 볼일이야?"
  },
  "253": {
   "jp": "314aa772b1",
   "kr": "수고했어요."
  },
  "254": {
   "jp": "7ab44f1fcf",
   "kr": "일이 끝나면 알선소에 가서"
  },
  "255": {
   "jp": "701b88376b",
   "kr": "돈 받는 걸 잊지 마세요."
  },
  "256": {
   "jp": "3e01b91a48",
   "kr": "다들 건강해 보이네."
  },
  "257": {
   "jp": "c9df0eb01d",
   "kr": "왠지 나도 기뻐."
  },
  "258": {
   "jp": "2fdcc7a3de",
   "kr": "여행길에서는 돈이 소중한 법이야."
  },
  "259": {
   "jp": "fe5d97b3d8",
   "kr": "필요하지 않은 건 사지 않도록"
  },
  "260": {
   "jp": "b941f42377",
   "kr": "조심하렴."
  },
  "261": {
   "jp": "87adc0da92",
   "kr": "여행을 계속하는 건 아주 힘든 일이야."
  },
  "262": {
   "jp": "611820ae2b",
   "kr": "지치면 쉬어도 괜찮아."
  },
  "263": {
   "jp": "70e371f093",
   "kr": "천천히 걷는 게 좋을 때도 있어."
  },
  "264": {
   "jp": "59675ded43",
   "kr": "그게 여행을 계속하는 요령이라고 생각해."
  },
  "265": {
   "jp": "33545e6f58",
   "kr": "여행은 말이야, 끝이 가까워졌다고"
  },
  "266": {
   "jp": "8f3c2d87fa",
   "kr": "느낄 때를 조심해야 해."
  },
  "267": {
   "jp": "20a3ff440e",
   "kr": "끝까지 긴장을 늦추면 안 돼."
  },
  "268": {
   "jp": "79ea595f72",
   "kr": "그렇다고 서둘러서도 안 돼."
  },
  "269": {
   "jp": "562b9faf6d",
   "kr": "여행이란 그런 거라고 생각해."
  },
  "270": {
   "jp": "9e7cc2825f",
   "kr": "도리어 「정신 차리세요」"
  },
  "271": {
   "jp": "ba90aadc03",
   "kr": "하고 주의를 듣는다니까."
  }
 }
}
