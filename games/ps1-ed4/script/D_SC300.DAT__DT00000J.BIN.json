{
 "archive": "/D/SC300.DAT",
 "member": "..\\BIN\\DT00000J.BIN",
 "segments": {
  "0": {
   "jp": "679b4a80d1",
   "kr": "벨우드에 마수가 눌러앉아서"
  },
  "1": {
   "jp": "01631d0219",
   "kr": "피해자가 속출하고 있어요."
  },
  "2": {
   "jp": "4e6d0b7726",
   "kr": "지금 나무꾼 아저씨가 행방불명이에요."
  },
  "3": {
   "jp": "1ee912fd76",
   "kr": "벨우드의 마수에게 붙잡힌 모양이에요."
  },
  "4": {
   "jp": "00a9f54443",
   "kr": "한시라도 빨리 구해 주세요."
  },
  "5": {
   "jp": "55330986b7",
   "kr": "편지를 전달하기만 하면 되는 일이에요."
  },
  "6": {
   "jp": "26c0268cf2",
   "kr": "이 가게에 머물고 있는 앤디 씨에게서"
  },
  "7": {
   "jp": "b786e6bd9f",
   "kr": "편지를 받아 주세요."
  },
  "8": {
   "jp": "3acf317709",
   "kr": "어느 귀족의 보석관을 도적이 훔쳐 갔습니다."
  },
  "9": {
   "jp": "079bb42072",
   "kr": "도적을 붙잡아"
  },
  "10": {
   "jp": "e159fc4ca0",
   "kr": "보석관 있는 곳을 심문했더니"
  },
  "11": {
   "jp": "dbefcd92fd",
   "kr": "쿠크일 동굴에 숨겨 두었다는 걸 알아냈습니다."
  },
  "12": {
   "jp": "340fbe8335",
   "kr": "그런데 쿠크일 동굴은"
  },
  "13": {
   "jp": "6c0a28a52d",
   "kr": "마수의 소굴이 되어 있어서"
  },
  "14": {
   "jp": "cfd282dc23",
   "kr": "섣불리 다가갈 수 없는 상태예요."
  },
  "15": {
   "jp": "ab7e877c3c",
   "kr": "어떻게든 마수의 습격을 피하면서"
  },
  "16": {
   "jp": "2a0023fef9",
   "kr": "보석관을 찾아 주세요."
  },
  "17": {
   "jp": "92d61eb704",
   "kr": "얼마 전이었던가요."
  },
  "18": {
   "jp": "b1c9c37c33",
   "kr": "촌장님이 왕도에서 격투가를 불러"
  },
  "19": {
   "jp": "59d1b34637",
   "kr": "호신술 강좌를 열었어요."
  },
  "20": {
   "jp": "307004a55a",
   "kr": "일반 시민도 제 몸 정도는 지킬 수 있게"
  },
  "21": {
   "jp": "0e13aef6ed",
   "kr": "하자는 생각에서였는데요."
  },
  "22": {
   "jp": "a55009ae66",
   "kr": "포포스와 브라코스라는"
  },
  "23": {
   "jp": "c766d74835",
   "kr": "바로아에서 유명한 덜렁이 콤비가"
  },
  "24": {
   "jp": "3d775eede1",
   "kr": "우쭐해서 마수 퇴치를 나가 버렸어요."
  },
  "25": {
   "jp": "98ac7548c8",
   "kr": "이 두 사람을 찾아서 데려와 줄 사람을 모집하고 있어요."
  },
  "26": {
   "jp": "7bcee39cba",
   "kr": "자세한 건"
  },
  "27": {
   "jp": "39647dc824",
   "kr": "촌장님께 물어보면 알려 주실 거예요."
  },
  "28": {
   "jp": "2e50eba9ea",
   "kr": "이건 좀 별난 일이네요."
  },
  "29": {
   "jp": "d960590c7a",
   "kr": "바로아의 아니타라는 아가씨가"
  },
  "30": {
   "jp": "cebe9b9fcc",
   "kr": "억지로 결혼하게 될 처지라 곤란해하고 있어요."
  },
  "31": {
   "jp": "a3d69de70d",
   "kr": "그래서 아니타 씨의 애인 행세를 하며"
  },
  "32": {
   "jp": "c8d6287959",
   "kr": "혼담을 진행하는 아버지를"
  },
  "33": {
   "jp": "952c33ed52",
   "kr": "단념시켜 달라고 하네요."
  },
  "34": {
   "jp": "af89f90d00",
   "kr": "자세한 이야기는 아니타 씨를"
  },
  "35": {
   "jp": "dd30144717",
   "kr": "직접 만나 들어 주세요."
  },
  "36": {
   "jp": "b87ecf974a",
   "kr": "바로아 주변에서 약탈을 일삼는 도적단의"
  },
  "37": {
   "jp": "326f5d14b6",
   "kr": "아지트를 알아냈어요."
  },
  "38": {
   "jp": "6c18b855f0",
   "kr": "아무래도 그 샴실단 일당인 것 같아요."
  },
  "39": {
   "jp": "62beb3f8a4",
   "kr": "장소는 바로아 북쪽에 있는 비샤나 동굴."
  },
  "40": {
   "jp": "6b619a6ecd",
   "kr": "도적들은 동굴 앞 해자에 걸린 다리를 끊고"
  },
  "41": {
   "jp": "3c24dad36e",
   "kr": "틀어박혀 있어요."
  },
  "42": {
   "jp": "35ea5ae3d1",
   "kr": "더는 샴실단 놈들을"
  },
  "43": {
   "jp": "1254562758",
   "kr": "날뛰게 둘 수 없어요."
  },
  "44": {
   "jp": "0318fc578c",
   "kr": "동굴에 잠입해서 소탕해 주세요."
  },
  "45": {
   "jp": "9234787044",
   "kr": "현재 바로아 은광산에서는 은맥을 조사 중이에요."
  },
  "46": {
   "jp": "6fd25d7774",
   "kr": "그곳은 마수가 많은 동굴이라"
  },
  "47": {
   "jp": "646d20bcfc",
   "kr": "마수의 공격을 피하며 작업을 진행하고 있어요."
  },
  "48": {
   "jp": "ba8b9de4e9",
   "kr": "그들에게 도구를 전달하는 건"
  },
  "49": {
   "jp": "ff8bf947dc",
   "kr": "실력에 자신 있는 사람이 아니면 도저히 무리예요."
  },
  "50": {
   "jp": "bfa389b911",
   "kr": "전달할 채굴 도구는 광산 입구에 있는"
  },
  "51": {
   "jp": "ba66629160",
   "kr": "부크 씨에게서 받아 가세요."
  },
  "52": {
   "jp": "694569e017",
   "kr": "벨우드에 박쥐가 떼로 나타났어요."
  },
  "53": {
   "jp": "3d3c33da20",
   "kr": "한두 마리라면 괜찮지만"
  },
  "54": {
   "jp": "4478ffc540",
   "kr": "무리를 지은 박쥐가 있어요."
  },
  "55": {
   "jp": "ebacd058f4",
   "kr": "그다지 강한 마수는 아니지만"
  },
  "56": {
   "jp": "26029eb543",
   "kr": "수가 모이면 여행자에게는 충분히 위험해요."
  },
  "57": {
   "jp": "e6f4832da7",
   "kr": "검 솜씨가 무뎌졌다면"
  },
  "58": {
   "jp": "e6850bbdde",
   "kr": "몸풀기 삼아"
  },
  "59": {
   "jp": "d3fe16c290",
   "kr": "처리해 주시면 고맙겠어요."
  },
  "60": {
   "jp": "7f99a48570",
   "kr": "마수 타고스를 아세요?"
  },
  "61": {
   "jp": "12c09434c4",
   "kr": "마수 중에서도 최강이라 불리며"
  },
  "62": {
   "jp": "a1cefe615f",
   "kr": "검을 맞댄 수많은 용사가 쓰러졌습니다."
  },
  "63": {
   "jp": "3571a10cc0",
   "kr": "그 타고스가 쿠크일 동굴에 눌러앉은 모양이에요."
  },
  "64": {
   "jp": "f0ac529988",
   "kr": "이대로는 언제 피해자가 나올지"
  },
  "65": {
   "jp": "2c8b98e37b",
   "kr": "모르는 위험한 상태입니다."
  },
  "66": {
   "jp": "8701f32a70",
   "kr": "한시라도 빨리 타고스를 퇴치해 주세요."
  },
  "67": {
   "jp": "9d641d1865",
   "kr": "이 일만큼은 상당한 실력이 없으면"
  },
  "68": {
   "jp": "5e1605df83",
   "kr": "해내기 어렵겠지요."
  },
  "69": {
   "jp": "9ac97fdf13",
   "kr": "진주보석관은 몇 년 전 왕성에서 도난당해"
  },
  "70": {
   "jp": "b603e7f3f3",
   "kr": "행방을 알 수 없게 되었어요."
  },
  "71": {
   "jp": "b1de9666f3",
   "kr": "그 진주보석관이 비샤나 동굴에"
  },
  "72": {
   "jp": "5a99f33a82",
   "kr": "숨겨져 있다는 정보가 들어왔어요."
  },
  "73": {
   "jp": "83789af1a6",
   "kr": "이 동굴은"
  },
  "74": {
   "jp": "8b3aef4bc9",
   "kr": "샴실단의 아지트였던 적도 있으니"
  },
  "75": {
   "jp": "cea39eef72",
   "kr": "못 챙긴 장물이 남아 있어도 이상하지 않죠."
  },
  "76": {
   "jp": "dcc86fbb1d",
   "kr": "여자아이가 할아버지께 보내는 편지를"
  },
  "77": {
   "jp": "dac9673244",
   "kr": "전달해 줄 사람을 찾고 있어요."
  },
  "78": {
   "jp": "457a86c8ee",
   "kr": "자세한 건 페이에게 들으세요."
  },
  "79": {
   "jp": "992a5c3af3",
   "kr": "페이는 등대 옆 술집에서 일해요."
  },
  "80": {
   "jp": "0c70166338",
   "kr": "공업 도시 기아와 바로아 사이 가도에서"
  },
  "81": {
   "jp": "32e451ae12",
   "kr": "마수가 집중적으로 나타나고 있어요."
  },
  "82": {
   "jp": "02d92f1a24",
   "kr": "여행자와 상인들이 피해를 입고 있어요."
  },
  "83": {
   "jp": "9cf5ffb24f",
   "kr": "마수를 쓰러뜨려 교통을 회복해야 해요."
  },
  "84": {
   "jp": "6878ab447d",
   "kr": "당신이라면 분명 손쉬운 일이 될 거예요."
  },
  "85": {
   "jp": "797b396479",
   "kr": "팀은 바로아에서도 유명한 개구쟁이예요."
  },
  "86": {
   "jp": "7d019cb0cd",
   "kr": "평소 어른들을 장난으로 곤란하게 했지만"
  },
  "87": {
   "jp": "3d6f359234",
   "kr": "이번만큼은 그 아이의 목숨이 걸린 일이에요."
  },
  "88": {
   "jp": "11acc2da3b",
   "kr": "팀은 놀이 친구들에게 오기를 부려"
  },
  "89": {
   "jp": "ec05d9ad47",
   "kr": "바딘 동굴을 탐험하고 오겠다고"
  },
  "90": {
   "jp": "41052a3b36",
   "kr": "하며 나간 모양이에요."
  },
  "91": {
   "jp": "2d58ec07ac",
   "kr": "바딘 동굴은 마수가 살고 있어 위험해요."
  },
  "92": {
   "jp": "3e2f2f2163",
   "kr": "그 아이가 위험한 일을 당하기 전에"
  },
  "93": {
   "jp": "81effe2965",
   "kr": "어떻게든 데려와 주세요."
  },
  "94": {
   "jp": "ed6dbd2194",
   "kr": "짐을 조금 나르기만 하면 되는 간단한 일이에요."
  },
  "95": {
   "jp": "2d68e6607b",
   "kr": "짐과 전할 곳은 디암 씨에게 물어보세요."
  },
  "96": {
   "jp": "101a3c57e9",
   "kr": "디암 씨는 이 여관을 나가"
  },
  "97": {
   "jp": "290d6732b3",
   "kr": "동쪽으로 조금 간 곳에서 기다리고 있어요."
  },
  "98": {
   "jp": "d555bdcf18",
   "kr": "짐을 나르기만 하는 간단한 일이에요.",
   "auto": 1
  },
  "99": {
   "jp": "a993db07bf",
   "kr": "짐과 전할 곳은 마사에게 물어보세요."
  },
  "100": {
   "jp": "82235e3234",
   "kr": "마사의 집은 바로아에서 가장 서쪽에 있는 집이에요."
  },
  "101": {
   "jp": "d555bdcf18",
   "kr": "짐을 나르기만 하는 간단한 일이에요.",
   "auto": 1
  },
  "102": {
   "jp": "6de9099661",
   "kr": "짐과 전할 곳은 멜에게 물어보세요."
  },
  "103": {
   "jp": "0a12be6ffc",
   "kr": "기아 근처 어딘가의 동굴에"
  },
  "104": {
   "jp": "23966787c3",
   "kr": "환상의 만병통치약이 숨겨져 있다는 정보가 들어왔어요."
  },
  "105": {
   "jp": "7f5c1270f9",
   "kr": "그 약은 두통, 발열, 치통에 복통,"
  },
  "106": {
   "jp": "a9d01a53b0",
   "kr": "온갖 병과 온갖 상처에 듣는다는 이야기예요."
  },
  "107": {
   "jp": "9e5d88675c",
   "kr": "만일 이 약을 손에 넣을 수 있다면"
  },
  "108": {
   "jp": "cacba10b41",
   "kr": "많은 괴로운 사람들이 구원받겠지요."
  },
  "109": {
   "jp": "9ed0339909",
   "kr": "의뢰인은 닥터 반들."
  },
  "110": {
   "jp": "dabef0135f",
   "kr": "구출해 달라는 의사 본인이에요."
  },
  "111": {
   "jp": "a6b1887614",
   "kr": "바딘 동굴은 마수의 소굴이 되어 있어서"
  },
  "112": {
   "jp": "2ca45025e3",
   "kr": "아주 위험한 곳이에요."
  },
  "113": {
   "jp": "d5450be9fe",
   "kr": "반들 선생님은 만일에 대비해"
  },
  "114": {
   "jp": "a17cca56ff",
   "kr": "기일까지 돌아오지 못할 경우 구조자를 보내 달라고"
  },
  "115": {
   "jp": "12fee5d47c",
   "kr": "알선소에 신청해 두셨어요."
  },
  "116": {
   "jp": "ced62c5bda",
   "kr": "소중한 상품이라서"
  },
  "117": {
   "jp": "024757d6cf",
   "kr": "꼭 되찾아 달라는 의뢰입니다."
  },
  "118": {
   "jp": "25d93f481f",
   "kr": "상품만 되찾으면 다른 조건은 없습니다."
  },
  "119": {
   "jp": "1b1caa59a6",
   "kr": "자세한 상황은 여관 술집에 머무는"
  },
  "120": {
   "jp": "5964484c23",
   "kr": "가르시아 씨 본인에게 물어보세요."
  },
  "121": {
   "jp": "567210889b",
   "kr": "반들 선생님은 샤카 동굴에서 돌아오지 않는 솔론 씨를"
  },
  "122": {
   "jp": "c30a08ca0e",
   "kr": "구하러 갔어요."
  },
  "123": {
   "jp": "6eb3d829fe",
   "kr": "요즘 그 동굴에는"
  },
  "124": {
   "jp": "0999eb6c8a",
   "kr": "맹독을 가진 마수가 눌러살게 되어"
  },
  "125": {
   "jp": "39d6622853",
   "kr": "아주 위험해요."
  },
  "126": {
   "jp": "c2aa764503",
   "kr": "아마 솔론 씨도 그 마수를 만나서"
  },
  "127": {
   "jp": "18a912ff07",
   "kr": "움직이지 못하게 된 거라고 생각해요."
  },
  "128": {
   "jp": "c267e363b5",
   "kr": "반들 선생님은"
  },
  "129": {
   "jp": "9d5204724d",
   "kr": "자기 자신도 사고를 당할지 모른다고 예상하고"
  },
  "130": {
   "jp": "df302ded2c",
   "kr": "이 의뢰를 내놓고 출발하셨어요."
  },
  "131": {
   "jp": "baa5190bba",
   "kr": "어빈 군, 서두르지 않으면 두 사람이 위험해요."
  },
  "132": {
   "jp": "5a78267633",
   "kr": "『여검사 사피』라는 소설을 아세요?"
  },
  "133": {
   "jp": "84a8b93422",
   "kr": "얼마 전에 크게 유행한 대하 로맨스예요."
  },
  "134": {
   "jp": "a21688c0f1",
   "kr": "그 작가 카람로 카라무스 선생님이"
  },
  "135": {
   "jp": "a4bc619e96",
   "kr": "어디론가 사라져 버렸대요."
  },
  "136": {
   "jp": "d321c780fd",
   "kr": "워낙 『여검사 사피』가 대걸작이었다 보니"
  },
  "137": {
   "jp": "e8ec423f72",
   "kr": "다음 작품도 주목받게 되어서"
  },
  "138": {
   "jp": "b435eb94f4",
   "kr": "엄청난 중압감에 시달렸나 봐요."
  },
  "139": {
   "jp": "804d6ab4ec",
   "kr": "자세한 이야기는 매니저 자마네 씨에게"
  },
  "140": {
   "jp": "438760d241",
   "kr": "들어 보세요."
  },
  "141": {
   "jp": "471830edec",
   "kr": "그 카라무스 선생님이 또 없어져 버렸어요."
  },
  "142": {
   "jp": "bb1127a478",
   "kr": "『질풍의 라빈』이 호평이라"
  },
  "143": {
   "jp": "edbaa5c47c",
   "kr": "속편이 기대되는데."
  },
  "144": {
   "jp": "b7c3539d98",
   "kr": "사실 저도 뒷이야기가 읽고 싶거든요…"
  },
  "145": {
   "jp": "950f45a807",
   "kr": "카라무스 선생님이 또다시 도망쳐 버렸어요."
  },
  "146": {
   "jp": "249bb164ff",
   "kr": "이유는 늘 그렇듯 소재 고갈이래요."
  },
  "147": {
   "jp": "54586ed5ba",
   "kr": "그 선생님도 참 정신을 못 차리네요."
  },
  "148": {
   "jp": "3a5bc4c909",
   "kr": "노만 씨의 의뢰예요."
  },
  "149": {
   "jp": "a5af5e66f0",
   "kr": "지극히 개인적인 용무라는 점이 의미심장하죠."
  },
  "150": {
   "jp": "deaff18ac6",
   "kr": "의뢰하러 왔을 때"
  },
  "151": {
   "jp": "a0e7d64877",
   "kr": "사랑은 지난날의 환영이 아니라느니… 하며"
  },
  "152": {
   "jp": "5dd615b33f",
   "kr": "중얼거리더라고요."
  },
  "153": {
   "jp": "fb5c6809d2",
   "kr": "일은 비샤나 동굴에 가서"
  },
  "154": {
   "jp": "18b4cc96c3",
   "kr": "노만 씨가 ５０년 전에 동굴 벽에 쓴 글자를"
  },
  "155": {
   "jp": "9f28f8132f",
   "kr": "확인해 오는 거예요."
  },
  "156": {
   "jp": "ceba7221d7",
   "kr": "자세한 건 노만 씨 본인에게 설명을 들으세요."
  },
  "157": {
   "jp": "9cd50870b6",
   "kr": "부두 옆 창고에서 일하고 있을 거예요."
  },
  "158": {
   "jp": "00487cf4d1",
   "kr": "이 두 사람을 찾아서"
  },
  "159": {
   "jp": "b8146c72e1",
   "kr": "데려와 줄 사람을 모집하고 있어요."
  },
  "160": {
   "jp": "ed17e045e1",
   "kr": "현재 바로아 은광산에서는"
  },
  "161": {
   "jp": "38fca550e7",
   "kr": "은맥 조사가 진행되고 있어요."
  },
  "162": {
   "jp": "23320fbd61",
   "kr": "온갖 병과"
  },
  "163": {
   "jp": "186ac299a0",
   "kr": "온갖 상처에 듣는다는 이야기예요."
  },
  "164": {
   "jp": "c4abf86d24",
   "kr": "괴로워하는 많은 사람들이"
  },
  "165": {
   "jp": "98c0033321",
   "kr": "구원받겠지요."
  },
  "166": {
   "jp": "c267e363b5",
   "kr": "반들 선생님은"
  },
  "167": {
   "jp": "0fd45357c0",
   "kr": "샤카 동굴에서 돌아오지 않는 솔론 씨를"
  },
  "168": {
   "jp": "7d6b706c60",
   "kr": "자기 자신도 사고를"
  },
  "169": {
   "jp": "02cdf5976b",
   "kr": "당할지 모른다고 예상하고"
  }
 }
}
