 "segments": {
  "0": {
   "jp": "1590c5239a",
   "kr": "파도가 엄청나군."
  },
  "1": {
   "jp": "38d63d37f1",
   "kr": "이래서는 도저히 진실의 섬에"
  },
  "2": {
   "jp": "112ca6da2c",
   "kr": "도저히 못 가겠어."
  },
  "3": {
   "jp": "efab1fcbc8",
   "kr": "그러게요."
  },
  "4": {
   "jp": "c9c04adc1c",
   "kr": "바다를 진정시켜 두어야겠네요."
  },
  "5": {
   "jp": "95f8432552",
   "kr": "바다를 진정시킨다고…?"
  },
  "6": {
   "jp": "7d4b3b84f6",
   "kr": "굉장해…"
  },
  "7": {
   "jp": "40dde867d2",
   "kr": "이런 마법… 처음 봐."
  },
  "8": {
   "jp": "9910bdbd2e",
   "kr": "시간이 없으니까요."
  },
  "9": {
   "jp": "aeb221a1a5",
   "kr": "이번엔 능력을 아낄 수 없겠네요."
  },
  "10": {
   "jp": "f9596ebc7c",
   "kr": "다음엔 배를 아주 빨리 달리게 할게요."
  },
  "11": {
   "jp": "bd7299d77c",
   "kr": "그, 그런 게 가능해?"
  },
  "12": {
   "jp": "9af038648a",
   "kr": "바람을 친구로 삼으면 돼요."
  },
  "13": {
   "jp": "15460305a7",
   "kr": "…바람을, 친구로?"
  },
  "14": {
   "jp": "75b5d3f153",
   "kr": "그래요."
  },
  "15": {
   "jp": "aff758d822",
   "kr": "저는 마법도 세상도 마찬가지라고 생각해요."
  },
  "16": {
   "jp": "e22462d1bf",
   "kr": "얼마나 좋은 친구가 있느냐에 따라"
  },
  "17": {
   "jp": "9f8f0edc29",
   "kr": "그 사람의 인생관도 달라지니까요."
  },
  "18": {
   "jp": "2104ab6875",
   "kr": "살기 좋은 세상이 되기도 하고"
  },
  "19": {
   "jp": "a4327953f3",
   "kr": "싫은 세상이 되기도 하죠."
  },
  "20": {
   "jp": "5a6a7cd8b0",
   "kr": "아마 그런 법이겠죠."
  },
  "21": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "22": {
   "jp": "8212b174a5",
   "kr": "실례.",
   "auto": 1
  },
  "23": {
   "jp": "e52f74caff",
   "kr": "바람이여!"
  },
  "24": {
   "jp": "6c8e071071",
   "kr": "내 작은 배를 부드러운 포옹으로 흔들어"
  },
  "25": {
   "jp": "26533bff29",
   "kr": "진실의 섬으로 이끌어라!"
  }
 }
}
