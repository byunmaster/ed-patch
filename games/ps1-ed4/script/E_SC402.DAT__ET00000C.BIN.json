{
 "archive": "/E/SC402.DAT",
 "member": "..\\BIN\\ET00000C.BIN",
 "segments": {
  "0": {
   "jp": "c5fabb2a79",
   "kr": "이거예요, 이거… 콜록, 먼지 좀 봐…"
  },
  "1": {
   "jp": "35b02e41fe",
   "kr": "몇백 년 전 일기라서요."
  },
  "2": {
   "jp": "297de495c5",
   "kr": "스코티아의 사당에 들어가는 방법이"
  },
  "3": {
   "jp": "d3a75fce22",
   "kr": "적힌 곳은 없나요?"
  },
  "4": {
   "jp": "5dd790d6dc",
   "kr": "사당에 들어가고 싶으세요?"
  },
  "5": {
   "jp": "edb8bfc7db",
   "kr": "그건 좀 어려울 것 같은데요."
  },
  "6": {
   "jp": "c779054305",
   "kr": "으음…"
  },
  "7": {
   "jp": "a386892700",
   "kr": "자, 이 페이지를 읽어 볼게요."
  },
  "8": {
   "jp": "a44c6d5201",
   "kr": "『오늘 나는 성스러운 크리스탈을 모스 호수에 돌려보냈다』"
  },
  "9": {
   "jp": "3444542801",
   "kr": "'일족의 힘의 근원을 스코티아에게 돌려주고"
  },
  "10": {
   "jp": "35754cf9ec",
   "kr": "속인으로 살아가기로 결심했다'"
  },
  "11": {
   "jp": "f52689d6d8",
   "kr": "그게 무슨 뜻이지?"
  },
  "12": {
   "jp": "0ce9029657",
   "kr": "스코티아 님의 사당에 가려면"
  },
  "13": {
   "jp": "4264e9a55b",
   "kr": "성스러운 크리스탈이라는 게 필요했어요."
  },
  "14": {
   "jp": "e2e8f8f21c",
   "kr": "사당으로 이어지는 성스러운 통로를 지나기 위한"
  },
  "15": {
   "jp": "946e0d6e3a",
   "kr": "통행증 같은 거랄까요."
  },
  "16": {
   "jp": "5d64947fca",
   "kr": "그런데 조상님이 그 크리스탈을"
  },
  "17": {
   "jp": "d960c11bc6",
   "kr": "모스 호수에 버리고 말았대요."
  },
  "18": {
   "jp": "35fe7c22c2",
   "kr": "뭐, 왜 그랬대!"
  },
  "19": {
   "jp": "a9fa28a0fd",
   "kr": "글쎄요."
  },
  "20": {
   "jp": "7a35164cb2",
   "kr": "이유는 어디에도 적혀 있지 않아요."
  },
  "21": {
   "jp": "c07193d8ed",
   "kr": "하지만 크리스탈에"
  },
  "22": {
   "jp": "144aa25df6",
   "kr": "전혀 미련이 없지는 않았던 모양이에요."
  },
  "23": {
   "jp": "2a17d68656",
   "kr": "이 일기에는 낡은 열쇠가 끼워져 있거든요."
  },
  "24": {
   "jp": "bc342de4b2",
   "kr": "열쇠?"
  },
  "25": {
   "jp": "1dca2a3ed4",
   "kr": "네.",
   "auto": 1
  },
  "26": {
   "jp": "0cca6fb359",
   "kr": "크리스탈은 보물상자에 넣어 가라앉혔대요."
  },
  "27": {
   "jp": "c853925866",
   "kr": "이건 그 보물상자의 열쇠…"
  },
  "28": {
   "jp": "77635fd749",
   "kr": "보여 주시겠어요?"
  },
  "29": {
   "jp": "06fb56d392",
   "kr": "그럼요, 그럼요."
  },
  "30": {
   "jp": "d23c71f863",
   "kr": "한동안 빌려 드릴까요?"
  },
  "31": {
   "jp": "efd90bf13e",
   "kr": "고맙습니다."
  },
  "32": {
   "jp": "9400d62364",
   "kr": "분명 뭔가 단서가 될 거예요."
  },
  "33": {
   "jp": "722e8ed3b6",
   "kr": "그러면 좋겠네요."
  },
  "34": {
   "jp": "fc4ff47aa3",
   "kr": "모처럼 와 주셨는데"
  },
  "35": {
   "jp": "37817e34c4",
   "kr": "별로 도움이 못 돼서 미안해요."
  },
  "36": {
   "jp": "3417f1da19",
   "kr": "을(를) 맡았다."
  },
  "37": {
   "jp": "ea925714c1",
   "kr": "괜찮으시면 빌려 드려도 되는데요."
  },
  "38": {
   "jp": "864a532c03",
   "kr": "짐이 꽉 찬 것 같네요."
  },
  "39": {
   "jp": "e12fbcf2cb",
   "kr": "어머, 정말이네."
  },
  "40": {
   "jp": "d12d4c3b5a",
   "kr": "어빈, 무슨 짐을 그렇게 많이 들고 있는 거야?"
  },
  "41": {
   "jp": "0a339a1e01",
   "kr": "죄송해요, 셀린 씨."
  },
  "42": {
   "jp": "f197a27038",
   "kr": "짐을 좀 줄이고 다시 올게요."
  },
  "43": {
   "jp": "c75b47f39b",
   "kr": "네, 그편이 좋겠어요."
  },
  "44": {
   "jp": "3049f99bee",
   "kr": "기다리고 있을게요."
  },
  "45": {
   "jp": "da1a2bf448",
   "kr": "오스카, 기다리고 있었어?"
  },
  "46": {
   "jp": "29d1052db9",
   "kr": "어이, 다들!"
  },
  "47": {
   "jp": "cb524d45d6",
   "kr": "어빈이 돌아왔어!!"
  },
  "48": {
   "jp": "c298666515",
   "kr": "와, 어빈 오빠다!"
  },
  "49": {
   "jp": "45f6394fb4",
   "kr": "냐옹…"
  },
  "50": {
   "jp": "e95732f191",
   "kr": "여러분…"
  },
  "51": {
   "jp": "1d2d7d1592",
   "kr": "걱정했다고."
  },
  "52": {
   "jp": "2f173aaf69",
   "kr": "스코티아 님은 만났어?"
  },
  "53": {
   "jp": "b495d773ae",
   "kr": "이런, 이런, 너희들."
  },
  "54": {
   "jp": "32c7d4bf1f",
   "kr": "그렇게 연달아 물으면"
  },
  "55": {
   "jp": "8e3d258cb3",
   "kr": "어빈 씨가 당황하지 않겠느냐."
  },
  "56": {
   "jp": "a2d08a8821",
   "kr": "자, 어빈 씨."
  },
  "57": {
   "jp": "d1ac4b9d22",
   "kr": "무사하셔서 다행입니다."
  },
  "58": {
   "jp": "343bce9ffa",
   "kr": "감사합니다.",
   "auto": 1
  },
  "59": {
   "jp": "6cf6e6167d",
   "kr": "여러분 덕분에 신보를 손에 넣을 수 있었습니다."
  },
  "60": {
   "jp": "93d2634351",
   "kr": "마을 사람들"
  },
  "61": {
   "jp": "7986f56689",
   "kr": "오오…"
  },
  "62": {
   "jp": "4b12b92567",
   "kr": "해냈구나, 어빈!"
  },
  "63": {
   "jp": "ee811bb826",
   "kr": "이제 네 목적은 이룬 셈이네."
  },
  "64": {
   "jp": "c3f8c2f40e",
   "kr": "그래."
  },
  "65": {
   "jp": "afa3529351",
   "kr": "하지만 아직 전부 끝난 건 아니야."
  },
  "66": {
   "jp": "7b2463603b",
   "kr": "모아야 할 신보가 더 남아 있어."
  },
  "67": {
   "jp": "5167b963ad",
   "kr": "…어빈 오빠, 가 버리는 거야…?"
  },
  "68": {
   "jp": "2fe733a9fa",
   "kr": "응, 가야 해."
  },
  "69": {
   "jp": "aa3bfda6a9",
   "kr": "모처럼 친구가 됐는데…"
  },
  "70": {
   "jp": "4a13d5637f",
   "kr": "리타."
  },
  "71": {
   "jp": "f631768f08",
   "kr": "어빈 씨에게는 중요한 일이 있단다."
  },
  "72": {
   "jp": "849d2261ea",
   "kr": "아마 온 세상 사람들을 위한 일일 거야."
  },
  "73": {
   "jp": "0804106460",
   "kr": "스코티아 님도 그렇게 말씀하셨어."
  },
  "74": {
   "jp": "1bb071b16f",
   "kr": "그럼 일이 끝나면 또 와 줄 거지?"
  },
  "75": {
   "jp": "428de7488a",
   "kr": "하하, 리타한테는 못 당하겠네."
  },
  "76": {
   "jp": "ab754bbdc5",
   "kr": "하지만 어빈."
  },
  "77": {
   "jp": "f5ded3b630",
   "kr": "일이 끝나면 정말 놀러 와 줘."
  },
  "78": {
   "jp": "f789e03cfc",
   "kr": "그리고 우리가 도울 일이 있다면"
  },
  "79": {
   "jp": "e527de136c",
   "kr": "언제든, 뭐든 달려가겠어."
  },
  "80": {
   "jp": "dbaacda64f",
   "kr": "사양하지 말고 말하라고."
  },
  "81": {
   "jp": "62e615247e",
   "kr": "고마워, 다들."
  },
  "82": {
   "jp": "91efb93464",
   "kr": "아니오, 고마워해야 할 쪽은 우리요."
  },
  "83": {
   "jp": "688b0ab122",
   "kr": "이번 일로 많은 걸 배웠소."
  },
  "84": {
   "jp": "b117044dff",
   "kr": "당신이 오지 않았다면"
  },
  "85": {
   "jp": "093944e92c",
   "kr": "우리는 모시를 두려워하기만 할 뿐"
  },
  "86": {
   "jp": "58ba92b464",
   "kr": "아무것도 하지 못했을 거요."
  },
  "87": {
   "jp": "5cdd98a889",
   "kr": "모시는 무섭지 않아요!"
  },
  "88": {
   "jp": "2b76a216b6",
   "kr": "친구예요!"
  },
  "89": {
   "jp": "ad7e62deff",
   "kr": "오오, 그렇고말고."
  },
  "90": {
   "jp": "eb8daffba5",
   "kr": "소중한 소중한 친구지."
  },
  "91": {
   "jp": "6737f67bc6",
   "kr": "어빈 씨,",
   "auto": 1
  },
  "92": {
   "jp": "2625162ab2",
   "kr": "혹시 곤란한 일이 생기면 찾아와 주시오."
  },
  "93": {
   "jp": "32649b6fb1",
   "kr": "키트 마을은 통째로 당신 친구요."
  },
  "94": {
   "jp": "7197330888",
   "kr": "조심해서 가세요.",
   "auto": 1
  },
  "95": {
   "jp": "38247d54d3",
   "kr": "분명 성공하실 거라 믿어요."
  },
  "96": {
   "jp": "1d23a42612",
   "kr": "또 놀러 와!"
  },
  "97": {
   "jp": "3761914f6d",
   "kr": "…………"
  },
  "98": {
   "jp": "aa3090d84f",
   "kr": "냥!"
  },
  "99": {
   "jp": "d57fc16ed2",
   "kr": "일 열심히 해요, 어빈 오빠!"
  },
  "100": {
   "jp": "f0e1f9966b",
   "kr": "여러분 덕분에"
  },
  "101": {
   "jp": "8cbf6db0ae",
   "kr": "신보를 손에 넣을 수 있었습니다."
  },
  "102": {
   "jp": "b1f5bfbff2",
   "kr": "키트 마을은"
  },
  "103": {
   "jp": "3e008f4852",
   "kr": "마을 사람 모두가 당신 친구라오."
  }
 }
}
