 "segments": {
  "0": {
   "jp": "3082c8300e",
   "kr": "트란"
  },
  "1": {
   "jp": "00df42dc93",
   "kr": "문지기"
  },
  "2": {
   "jp": "0c63894018",
   "kr": "뮬레트"
  },
  "3": {
   "jp": "3a27f6b02b",
   "kr": "필딘 성"
  },
  "4": {
   "jp": "d3b9070f67",
   "kr": "음, 누구냐."
  },
  "5": {
   "jp": "689933bb54",
   "kr": "기아 마을의 챕 씨에게 부탁받았어."
  },
  "6": {
   "jp": "556e048cc8",
   "kr": "당신한테 짐이야."
  },
  "7": {
   "jp": "72b2b58e09",
   "kr": "뭐, 챕이 보낸 물건?"
  },
  "8": {
   "jp": "ac685981b5",
   "kr": "그거 수고했군."
  },
  "9": {
   "jp": "5e4ef4a8c1",
   "kr": "그런데… 뭘 가져온 건가?"
  },
  "10": {
   "jp": "8e1097ce55",
   "kr": "분명 챕이니까"
  },
  "11": {
   "jp": "f28fa2bfd5",
   "kr": "또 여행 상인한테 이상한 걸 떠안은 걸 거야."
  },
  "12": {
   "jp": "8f3f03d325",
   "kr": "그래서 쓸모없으니 억지로 나한테"
  },
  "13": {
   "jp": "5591090666",
   "kr": "팔아넘기려는 거 아닐까."
  },
  "14": {
   "jp": "167e771fd1",
   "kr": "며칠 전에도 똑같이 짐이 왔어."
  },
  "15": {
   "jp": "e43a06602c",
   "kr": "키가 커진다는 수상한 부츠를"
  },
  "16": {
   "jp": "7c96424c49",
   "kr": "억지로 샀지."
  },
  "17": {
   "jp": "c72788c563",
   "kr": "그거 안됐군."
  },
  "18": {
   "jp": "a0ebb4a436",
   "kr": "하지만 이쪽도 일이야."
  },
  "19": {
   "jp": "399f34c1ab",
   "kr": "아무튼 받아 주지 않으면 곤란해."
  },
  "20": {
   "jp": "beb486cb73",
   "kr": "검은 램프를 트란에게 건넸다."
  },
  "21": {
   "jp": "17c3b838d1",
   "kr": "음? 검은 램프라…"
  },
  "22": {
   "jp": "44737daa61",
   "kr": "또 보기에도 수상하잖아."
  },
  "23": {
   "jp": "05f822c2c8",
   "kr": "챕 씨는 이번엔 공짜라도 좋다고"
  },
  "24": {
   "jp": "7998bd75ac",
   "kr": "했어."
  },
  "25": {
   "jp": "05b146b523",
   "kr": "뭐, 그 녀석이 공짜라고?"
  },
  "26": {
   "jp": "db37028762",
   "kr": "…무슨 속셈이지."
  },
  "27": {
   "jp": "f9c075bc93",
   "kr": "또 잠을 못 자게 될 것 같군."
  },
  "28": {
   "jp": "6ef4a19e78",
   "kr": "잠을 못…아, 그러고 보니."
  },
  "29": {
   "jp": "a52d733b50",
   "kr": "이 램프 기름에는"
  },
  "30": {
   "jp": "e0c39d9c4f",
   "kr": "숙면 효과가 있는 허브 추출물이 들어 있다고 했지."
  },
  "31": {
   "jp": "3a75d2291b",
   "kr": "뭐라고!"
  },
  "32": {
   "jp": "addf4a75d1",
   "kr": "그럼 그 녀석, 내 불면증을 걱정해서…"
  },
  "33": {
   "jp": "5848e2bf43",
   "kr": "으으윽."
  },
  "34": {
   "jp": "4716107643",
   "kr": "문지기 일을 하면"
  },
  "35": {
   "jp": "b69393796f",
   "kr": "긴장의 연속이라서 말이야."
  },
  "36": {
   "jp": "4933e3e5c2",
   "kr": "잠자리에 들어도 좀처럼 잠이 안 와."
  },
  "37": {
   "jp": "ffd98d6f4f",
   "kr": "역시 그 녀석은 내 친구였어."
  },
  "38": {
   "jp": "6d0671ce20",
   "kr": "이건 기쁘게 받겠네."
  },
  "39": {
   "jp": "3d29186130",
   "kr": "지금까지 억지로 산 머리가 좋아지는 머리띠와"
  },
  "40": {
   "jp": "4c058d5ae9",
   "kr": "악력을 기르는 장갑 일은 용서하지."
  },
  "41": {
   "jp": "34cb444963",
   "kr": "고맙다, 여행자여!!"
  },
  "42": {
   "jp": "d53fe3adf9",
   "kr": "그럼 건강하게 여행을 계속하게나."
  },
  "43": {
   "jp": "0401a35123",
   "kr": "이 주변은 너무 어슬렁"
  },
  "44": {
   "jp": "4596ae10c3",
   "kr": "돌아다니지 않는 게 좋아."
  },
  "45": {
   "jp": "4452b1b463",
   "kr": "검은 램프는 소중히 쓰겠네."
  },
  "46": {
   "jp": "469b18b959",
   "kr": "수고했어."
  },
  "47": {
   "jp": "fc52d2ed18",
   "kr": "여, 자네들!"
  },
  "48": {
   "jp": "02e314cf39",
   "kr": "그 뒤로 검은 램프 덕분에"
  },
  "49": {
   "jp": "44990f6b1b",
   "kr": "잘 자게 됐어."
  },
  "50": {
   "jp": "a2bc461473",
   "kr": "컨디션도 아주 좋아!"
  },
  "51": {
   "jp": "07a9caeba3",
   "kr": "그리고 늘 말하지만"
  },
  "52": {
   "jp": "0401a35123",
   "kr": "이 주변은 너무 어슬렁"
  },
  "53": {
   "jp": "4596ae10c3",
   "kr": "돌아다니지 않는 게 좋아."
  },
  "54": {
   "jp": "0401a35123",
   "kr": "이 주변은 너무 어슬렁"
  },
  "55": {
   "jp": "4596ae10c3",
   "kr": "돌아다니지 않는 게 좋아."
  },
  "56": {
   "jp": "db1533e295",
   "kr": "성내는 일반인의 입장을 금지하고 있습니다."
  },
  "57": {
   "jp": "1fb985a4d0",
   "kr": "돌아가 주십시오."
  },
  "58": {
   "jp": "bcaad395be",
   "kr": "아, 뮤즈 님."
  },
  "59": {
   "jp": "66ea98c4a1",
   "kr": "외출하십니까?"
  },
  "60": {
   "jp": "1dca2a3ed4",
   "kr": "네."
  },
  "61": {
   "jp": "72ded9084e",
   "kr": "아, 그리고 어빈이"
  },
  "62": {
   "jp": "090fbd91bc",
   "kr": "성을 자유롭게 다닐 수 있도록 조치해 줘요."
  },
  "63": {
   "jp": "6ab314ccc3",
   "kr": "알겠습니다."
  },
  "64": {
   "jp": "13c7fb5c7c",
   "kr": "이상 없습니다."
  },
  "65": {
   "jp": "3bd8cda02c",
   "kr": "아주 평온합니다."
  },
  "66": {
   "jp": "60d85d180a",
   "kr": "성내에서는 실례되는 일이 없도록 부탁드립니다."
  },
  "67": {
   "jp": "13c7fb5c7c",
   "kr": "이상 없습니다."
  },
  "68": {
   "jp": "3bd8cda02c",
   "kr": "아주 평온합니다."
  },
  "69": {
   "jp": "5a4285af32",
   "kr": "공주님은 오크툼 신도의 폭주에 대해"
  },
  "70": {
   "jp": "5306a49982",
   "kr": "꽤 문제로 보고 계신 듯하지만"
  },
  "71": {
   "jp": "16df577aef",
   "kr": "필딘 왕가로서는 개입을 피하고 있습니다."
  },
  "72": {
   "jp": "680cf8e523",
   "kr": "왕가로서는 싸움에 휘말리면"
  },
  "73": {
   "jp": "08611e66b6",
   "kr": "매우 번거로운 일이 될 수 있으니까요."
  },
  "74": {
   "jp": "d68f09b6d7",
   "kr": "공주님으로서는"
  },
  "75": {
   "jp": "729a9dd807",
   "kr": "그것이 답답해서 견딜 수 없으신 거지요."
  },
  "76": {
   "jp": "e58097b44a",
   "kr": "어머, 뮤즈 님."
  },
  "77": {
   "jp": "a9c82d35b0",
   "kr": "안녕하신지요."
  },
  "78": {
   "jp": "f70a7a2baf",
   "kr": "서민들과의 놀이도 적당히 하시길."
  },
  "79": {
   "jp": "92948e4db9",
   "kr": "호호호호…"
  },
  "80": {
   "jp": "aae4b1f83b",
   "kr": "(속 편하군…)"
  },
  "81": {
   "jp": "f597d58c64",
   "kr": "무슨 용무인지 모르겠으나"
  },
  "82": {
   "jp": "ef301e6ba4",
   "kr": "일반인이 성내를 어슬렁거리는 것은"
  },
  "83": {
   "jp": "b7eacc1892",
   "kr": "삼가 주셨으면 합니다."
  },
  "84": {
   "jp": "f2be89a8e8",
   "kr": "여기는 고귀한 분들이 사시는 곳입니다."
  },
  "85": {
   "jp": "e57e9034ff",
   "kr": "오호호호…"
  },
  "86": {
   "jp": "581424abf4",
   "kr": "(웃고 있어라…)"
  },
  "87": {
   "jp": "10dc15d122",
   "kr": "숙면 효과가 있는"
  },
  "88": {
   "jp": "e5813415ea",
   "kr": "허브 추출물이 들어 있다고 했지."
  }
