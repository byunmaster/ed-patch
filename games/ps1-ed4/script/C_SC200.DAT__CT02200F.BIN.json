{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02200F.BIN",
 "segments": {
  "0": {
   "jp": "31c1835a1c",
   "kr": "손님,"
  },
  "1": {
   "jp": "5aadb3055f",
   "kr": "지작이라는 남자를 아십니까요?"
  },
  "2": {
   "jp": "4f1d1cccbd",
   "kr": "아, 우리도 그 녀석을 찾고 있어."
  },
  "3": {
   "jp": "20a1be7ca2",
   "kr": "곤트 아저씨한테 얘기를 듣고 여기 온 거야."
  },
  "4": {
   "jp": "8b418baecd",
   "kr": "아이고, 이런!"
  },
  "5": {
   "jp": "ab8b529da3",
   "kr": "그럼 손님도 그 녀석한테 호되게 당하셨습니까요?"
  },
  "6": {
   "jp": "5c332d7273",
   "kr": "호되게 당한 정도가 아니야."
  },
  "7": {
   "jp": "b3299c74dd",
   "kr": "나는 그 녀석을 잡아야 해."
  },
  "8": {
   "jp": "1e2f9031d2",
   "kr": "뭔가 단서 없어?"
  },
  "9": {
   "jp": "dbe3a3dc41",
   "kr": "음…"
  },
  "10": {
   "jp": "564716d994",
   "kr": "그게, 저도 아는 게 전혀 없어요."
  },
  "11": {
   "jp": "fc37c00992",
   "kr": "그 녀석이 마지막으로 온 건 일주일 전쯤인가."
  },
  "12": {
   "jp": "79619510a5",
   "kr": "수상한 남자와 같이 왔어요."
  },
  "13": {
   "jp": "61c6acb543",
   "kr": "그 남자 이름은?"
  },
  "14": {
   "jp": "776ca02164",
   "kr": "분명 다렌…"
  },
  "15": {
   "jp": "b9e915d7ac",
   "kr": "다렌!"
  },
  "16": {
   "jp": "bceb120e99",
   "kr": "짐 받을 곳이야!"
  },
  "17": {
   "jp": "dac3f5fbdb",
   "kr": "아십니까요?"
  },
  "18": {
   "jp": "8cc1ee5912",
   "kr": "아니, 이름만 알아."
  },
  "19": {
   "jp": "3f6410d560",
   "kr": "만난 적은 없어."
  },
  "20": {
   "jp": "2dc2211dfc",
   "kr": "뭐야.",
   "auto": 1
  },
  "21": {
   "jp": "7fc0550705",
   "kr": "그럼 나랑 별 차이 없네."
  },
  "22": {
   "jp": "d8b867dda8",
   "kr": "저도 이름 정도밖에 몰랐어요."
  },
  "23": {
   "jp": "2e0c089da1",
   "kr": "곤트 아저씨한테 얘기를 듣고"
  },
  "24": {
   "jp": "5a90619e55",
   "kr": "여기 온 거야."
  }
 }
}
