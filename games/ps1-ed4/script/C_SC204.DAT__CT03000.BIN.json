{
 "archive": "/C/SC204.DAT",
 "member": "..\\BIN\\CT03000.BIN",
 "segments": {
  "0": {
   "jp": "f448b57374",
   "kr": "도리아 교수"
  },
  "1": {
   "jp": "87a5230a56",
   "kr": "루카"
  },
  "2": {
   "jp": "5091cd29e9",
   "kr": "접수원"
  },
  "3": {
   "jp": "9e431625f9",
   "kr": "솔단 선생"
  },
  "4": {
   "jp": "d8c336a1bc",
   "kr": "몰리 선생"
  },
  "5": {
   "jp": "1004bdc7ae",
   "kr": "폰 할아버지"
  },
  "6": {
   "jp": "2c61715e0b",
   "kr": "사무원"
  },
  "7": {
   "jp": "c160ef6938",
   "kr": "몬타"
  },
  "8": {
   "jp": "d467e139b2",
   "kr": "레미"
  },
  "9": {
   "jp": "1b32a7912b",
   "kr": "피트"
  },
  "10": {
   "jp": "302da0fe74",
   "kr": "란드"
  },
  "11": {
   "jp": "adb9ce6794",
   "kr": "페로"
  },
  "12": {
   "jp": "002f936101",
   "kr": "캐로"
  },
  "13": {
   "jp": "605d512c1f",
   "kr": "타이거"
  },
  "14": {
   "jp": "5993781160",
   "kr": "체리"
  },
  "15": {
   "jp": "437fc7fa4a",
   "kr": "어?"
  },
  "16": {
   "jp": "38e60be8d8",
   "kr": "알선소에서 의뢰를 받고"
  },
  "17": {
   "jp": "b5af040ea2",
   "kr": "말동무가 되어 주러 왔는가?"
  },
  "18": {
   "jp": "e056b5478b",
   "kr": "그거 미안하구먼. 수고했네, 수고했어."
  },
  "19": {
   "jp": "4f6233bd27",
   "kr": "학교라는 폐쇄된 공간에 있다 보면"
  },
  "20": {
   "jp": "953d7c6cd2",
   "kr": "어느새 시야가 좁아지고 말지."
  },
  "21": {
   "jp": "fb298ecec0",
   "kr": "연구자가 이래선 안 되겠다 싶었네!"
  },
  "22": {
   "jp": "091db89a89",
   "kr": "여러 체험을 한 사람들의 이야기를 들으며"
  },
  "23": {
   "jp": "35e43859d7",
   "kr": "유연한 발상을 길러 보려는 걸세."
  },
  "24": {
   "jp": "f6a659b401",
   "kr": "미안하지만"
  },
  "25": {
   "jp": "77e1192dd5",
   "kr": "잠시 이 늙은이의 말동무가"
  },
  "26": {
   "jp": "2e8e983cc8",
   "kr": "되어 주지 않겠나."
  },
  "27": {
   "jp": "31888157a0",
   "kr": "좋은 이야기를 들려주면"
  },
  "28": {
   "jp": "9003c726de",
   "kr": "보수 외에 보너스도 주겠네."
  },
  "29": {
   "jp": "cfae0cea37",
   "kr": "보너스는 이야기가 끝나는 대로 채점하지."
  },
  "30": {
   "jp": "737c80dd8f",
   "kr": "이런, 교수 시절 버릇이 나왔군."
  },
  "31": {
   "jp": "f638c4b318",
   "kr": "미안하네."
  },
  "32": {
   "jp": "09a43933ef",
   "kr": "자, 누가 말동무를 할래?"
  },
  "33": {
   "jp": "2626cf5979",
   "kr": "괜찮은 거야?!"
  },
  "34": {
   "jp": "4f9d9a0a0d",
   "kr": "이런, 아무도 이야기를 안 해 주는가."
  },
  "35": {
   "jp": "698207d753",
   "kr": "모처럼 기대하고 있었는데."
  },
  "36": {
   "jp": "989ae89263",
   "kr": "자네 이야기는 전에 들었지."
  },
  "37": {
   "jp": "7e71d9b632",
   "kr": "다른 사람은 없는가?"
  },
  "38": {
   "jp": "b64a1fb439",
   "kr": "연구에 전념하는 것도 나쁘지 않군."
  },
  "39": {
   "jp": "6e342a5ac3",
   "kr": "자네 같은 나그네도 찾아와 주고"
  },
  "40": {
   "jp": "194bdc3a28",
   "kr": "매일 수업에 시달릴 일도 없으니."
  },
  "41": {
   "jp": "8d9257f4a9",
   "kr": "유유자적이란 바로 이런 걸세."
  },
  "42": {
   "jp": "b0aa943b33",
   "kr": "《고등 마술 독본 １》"
  },
  "43": {
   "jp": "dfaf671751",
   "kr": "텔레포트 마법"
  },
  "44": {
   "jp": "03daf17c8e",
   "kr": "이 마법은 맑은 마음을 지닌 자에게 주어진다."
  },
  "45": {
   "jp": "32a073f9dc",
   "kr": "갓난아이처럼 순수한 마음으로"
  },
  "46": {
   "jp": "cec7c5f6bd",
   "kr": "그대의 몸이 바람이 됨을 의식하라."
  },
  "47": {
   "jp": "6cc0089f06",
   "kr": "그리하면 문을 열듯이"
  },
  "48": {
   "jp": "78c9d8da16",
   "kr": "시간을 넘고, 하늘을 넘으리라."
  },
  "49": {
   "jp": "6d631ee5e9",
   "kr": "《고등 마술 독본 ２》"
  },
  "50": {
   "jp": "7e5ad7b6e6",
   "kr": "무게를 없애는 마법"
  },
  "51": {
   "jp": "6f635e6bee",
   "kr": "초심자라면 프시코스의 날개를 쓰라."
  },
  "52": {
   "jp": "6e8b70189a",
   "kr": "귀에 날개를 달고 그 파동을 느껴라."
  },
  "53": {
   "jp": "13356b921a",
   "kr": "그리하면 그대의 머리카락이 날개가 되듯"
  },
  "54": {
   "jp": "cf463851a1",
   "kr": "대지의 속박에서 풀려나리라."
  },
  "55": {
   "jp": "f4673fddc9",
   "kr": "《고등 마술 독본 ３》"
  },
  "56": {
   "jp": "a37ac19e02",
   "kr": "죽은 자를 되살리는 마법"
  },
  "57": {
   "jp": "c81b368ae5",
   "kr": "이 마법은 아직 익힌 자가 없다."
  },
  "58": {
   "jp": "b1becdeb8c",
   "kr": "뛰어난 연구자가 나타나기를 바란다."
  },
  "59": {
   "jp": "c7c9859508",
   "kr": "《고등 마술 독본 ４》"
  },
  "60": {
   "jp": "0dccf815d9",
   "kr": "모습을 감춘 마수를 드러내는 마법"
  },
  "61": {
   "jp": "05cd830730",
   "kr": "속임에 속임을 겹쳐"
  },
  "62": {
   "jp": "4d7e687aed",
   "kr": "없는 것을 있다 하는 사술을 꿰뚫으려면,"
  },
  "63": {
   "jp": "5c12240b39",
   "kr": "아래 마법진을 마음에 그려 간파하라."
  },
  "64": {
   "jp": "bb154c98e4",
   "kr": "책장의 책이 빠져 있다."
  },
  "65": {
   "jp": "8d8e270452",
   "kr": "이거야, 이거!"
  },
  "66": {
   "jp": "ba187c3179",
   "kr": "이거라고, 형!"
  },
  "67": {
   "jp": "692b44e2d3",
   "kr": "이게 있으면 투명 마수를 쓰러뜨릴 수 있어!"
  },
  "68": {
   "jp": "15685efa0c",
   "kr": "라엘은 책을 들고 나가려 했다."
  },
  "69": {
   "jp": "b27756c8bb",
   "kr": "이봐, 괜찮은 거야? 맘대로…"
  },
  "70": {
   "jp": "b6ecbc6102",
   "kr": "괜찮아."
  },
  "71": {
   "jp": "10d629e7a5",
   "kr": "내가 여기 학생이었잖아."
  },
  "72": {
   "jp": "00dd718073",
   "kr": "게다가 이렇게 성가신 도형을"
  },
  "73": {
   "jp": "58b4d7faef",
   "kr": "기억해 낼 수 있을 리가 없잖아."
  },
  "74": {
   "jp": "6d114c30b4",
   "kr": "보면서 하지 않으면 무리, 무리."
  },
  "75": {
   "jp": "55f07255ec",
   "kr": "자, 사양 말고 가져가, 가져가."
  },
  "76": {
   "jp": "13f87e4273",
   "kr": "마법책을 손에 넣었다."
  },
  "77": {
   "jp": "281cb7fd5a",
   "kr": "소지품이 가득 차서 더는 아이템을 가질 수 없다."
  },
  "78": {
   "jp": "899e0bc3b5",
   "kr": "어려운 도형이군요."
  },
  "79": {
   "jp": "e2b6e07d93",
   "kr": "제 고향에는 비슷한 것조차 없어요."
  },
  "80": {
   "jp": "d426d15da7",
   "kr": "마법학을 경험해 본 인물의 도움이 필요하겠군요."
  },
  "81": {
   "jp": "cbc727ace4",
   "kr": "그러고 보니 라엘 군이"
  },
  "82": {
   "jp": "de53dc4a2e",
   "kr": "이 학교 출신이었죠."
  },
  "83": {
   "jp": "a50684a1a4",
   "kr": "마음에 그리라니…"
  },
  "84": {
   "jp": "009736159c",
   "kr": "이렇게 어려운 도형을 상상하기는 힘들어."
  },
  "85": {
   "jp": "609db2a3cf",
   "kr": "마법학에 익숙하지 않으면 도저히 무리야."
  },
  "86": {
   "jp": "7d37163e75",
   "kr": "이 학교 학생이라면 어떻게든 될까."
  },
  "87": {
   "jp": "4e5bef0626",
   "kr": "분명 라엘이 여기 출신이었을 텐데."
  },
  "88": {
   "jp": "d212ff6107",
   "kr": "마법책을 돌려놓았다."
  },
  "89": {
   "jp": "88f391f4c3",
   "kr": "우리 학교 교사진은 훌륭하답니다."
  },
  "90": {
   "jp": "7c8e84e202",
   "kr": "총명한 솔단 선생님,"
  },
  "91": {
   "jp": "4abf952138",
   "kr": "학생을 아끼는 몰리 선생님."
  },
  "92": {
   "jp": "2235275a45",
   "kr": "그리고 뭐니 뭐니 해도"
  },
  "93": {
   "jp": "934bab32b9",
   "kr": "도리아 교수님이 계시니까요."
  },
  "94": {
   "jp": "97d56a2895",
   "kr": "견학이시라면 자유롭게 보세요."
  },
  "95": {
   "jp": "49c8a2cdb0",
   "kr": "수업 중이에요!"
  },
  "96": {
   "jp": "73c5d267c4",
   "kr": "견학이면 조용히 하세요."
  },
  "97": {
   "jp": "f54e311bcc",
   "kr": "이제 곧 우리 반이 졸업이거든."
  },
  "98": {
   "jp": "3ccef16ff3",
   "kr": "이러고 있으면 개구쟁이들이"
  },
  "99": {
   "jp": "9aac841954",
   "kr": "입학하던 때가 생각나는군."
  },
  "100": {
   "jp": "299eb8d1ba",
   "kr": "내 자랑거리 화단은 어떤가?"
  },
  "101": {
   "jp": "d01f3288d9",
   "kr": "이만큼 멋지게 다듬은 건"
  },
  "102": {
   "jp": "adc6d1ca46",
   "kr": "필딘 천지를 뒤져도 없을걸세."
  },
  "103": {
   "jp": "87dc7aad0b",
   "kr": "음, 지렁이 가루에 순록 뿔,"
  },
  "104": {
   "jp": "23c9ebe902",
   "kr": "박쥐 날개와 흰 당근…"
  },
  "105": {
   "jp": "e253336e1b",
   "kr": "왜 마법학교 교재는"
  },
  "106": {
   "jp": "2e35e5dd88",
   "kr": "하나같이 징그러운 것뿐이야!"
  },
  "107": {
   "jp": "80d02c87a6",
   "kr": "솔단 선생님은 상냥한 얼굴인데"
  },
  "108": {
   "jp": "f31280478b",
   "kr": "한눈팔면 분필을 던진다고."
  },
  "109": {
   "jp": "59fae29a43",
   "kr": "빨간 분필은 특히 파괴력이 끝내줘."
  },
  "110": {
   "jp": "15bf73d8d0",
   "kr": "나, 회복 마법을 잔뜩 공부해서"
  },
  "111": {
   "jp": "bf5e689b31",
   "kr": "의사 선생님이 되는 게 꿈이야."
  },
  "112": {
   "jp": "fe29344dd6",
   "kr": "마수를 다치게 하는 힘보다"
  },
  "113": {
   "jp": "67a2cd564c",
   "kr": "사람을 치유하는 힘이"
  },
  "114": {
   "jp": "fbb469de06",
   "kr": "세상에는 필요하다고 생각해."
  },
  "115": {
   "jp": "9281e62d2b",
   "kr": "그렇지?"
  },
  "116": {
   "jp": "8199fb8f59",
   "kr": "분명 그렇지?"
  },
  "117": {
   "jp": "7ff369f594",
   "kr": "마법대학교라고 해서"
  },
  "118": {
   "jp": "83ac12a107",
   "kr": "학교가 하늘을 날거나 말하는 거북이가"
  },
  "119": {
   "jp": "8afac9b8d4",
   "kr": "있을 줄 알았는데 말이야."
  },
  "120": {
   "jp": "719525c18d",
   "kr": "나는 과자 가게 주인이 되고 싶어."
  },
  "121": {
   "jp": "5c8f0ec8ed",
   "kr": "맛을 낼 때 마법을 살짝 쓰면"
  },
  "122": {
   "jp": "a9a9cda8ca",
   "kr": "꿈같은 과자를 만들 수 있잖아."
  },
  "123": {
   "jp": "9141db60e0",
   "kr": "알고 있어?"
  },
  "124": {
   "jp": "b096f7ae1b",
   "kr": "우리보다 한 학년 위에"
  },
  "125": {
   "jp": "6611708701",
   "kr": "작년에 졸업했어야 할 학생 중에"
  },
  "126": {
   "jp": "b91eaa20e9",
   "kr": "엄청난 녀석이 있었대."
  },
  "127": {
   "jp": "1003fcacbf",
   "kr": "화단에서 낮잠을 자고"
  },
  "128": {
   "jp": "16d09c6ac5",
   "kr": "여자애 치마를 들추고"
  },
  "129": {
   "jp": "d5f2dab0af",
   "kr": "관리인 아저씨 도시락을 먹고."
  },
  "130": {
   "jp": "831b4ea1b9",
   "kr": "그러다가"
  },
  "131": {
   "jp": "b9f7cdd3b0",
   "kr": "학교를 뛰쳐나가는 바람에"
  },
  "132": {
   "jp": "faa28811e1",
   "kr": "졸업은 못 했다던데."
  },
  "133": {
   "jp": "86fc86dc90",
   "kr": "음, 이름이 말이야."
  },
  "134": {
   "jp": "9d3accd01c",
   "kr": "분명…"
  },
  "135": {
   "jp": "6804fcc941",
   "kr": "라엘이라고 했던가."
  },
  "136": {
   "jp": "0eb4edeec9",
   "kr": "알아?"
  },
  "137": {
   "jp": "0211450929",
   "kr": "아이참, 정말."
  },
  "138": {
   "jp": "09b38a89ed",
   "kr": "땡땡이치는 중이니까 내버려 둬!"
  },
  "139": {
   "jp": "d741d39548",
   "kr": "어머, 마중하러 와 준 건가?"
  },
  "140": {
   "jp": "6959cf5816",
   "kr": "미안해서 어쩌나."
  },
  "141": {
   "jp": "82987d7b60",
   "kr": "어머, 그래."
  },
  "142": {
   "jp": "9d12b500cb",
   "kr": "마중 와 준 거야?"
  },
  "143": {
   "jp": "126c372cdd",
   "kr": "야호, 드디어 돌아갈 수 있다!!"
  },
  "144": {
   "jp": "308ce62715",
   "kr": "뭐야～."
  },
  "145": {
   "jp": "07e4f2f527",
   "kr": "없음을 있음으로,"
  },
  "146": {
   "jp": "4727fd21a7",
   "kr": "있음을 없음으로 꾸미는 사술은"
  },
  "147": {
   "jp": "fafb399b97",
   "kr": "마법학을 배워 본 사람의"
  },
  "148": {
   "jp": "e8fa4c64ce",
   "kr": "도움이 필요하겠네요."
  }
 }
}
