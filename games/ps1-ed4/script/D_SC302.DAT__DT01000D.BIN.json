{
 "archive": "/D/SC302.DAT",
 "member": "..\\BIN\\DT01000D.BIN",
 "segments": {
  "0": {
   "jp": "2c8d715edf",
   "kr": "노카크 동굴에 나오는 마수는 얕볼 게 아니야."
  },
  "1": {
   "jp": "0be6bfcc0d",
   "kr": "자기가 쓸 레어의 부적도 남겨 둬."
  },
  "2": {
   "jp": "88c96757a5",
   "kr": "마수 퇴치는 힘으로 맞붙을 수밖에 없어."
  },
  "3": {
   "jp": "754036fb1b",
   "kr": "믿을 수 있는 동료를 데려가라고."
  },
  "4": {
   "jp": "571360147d",
   "kr": "그래, 50로제 주면 좋은 정보가 있어."
  },
  "5": {
   "jp": "3ab1200b57",
   "kr": "들어 볼래?",
   "auto": 1
  },
  "6": {
   "jp": "fd4684dda3",
   "kr": "발파 동굴에 있는 샴실단에는"
  },
  "7": {
   "jp": "45961411a5",
   "kr": "까다로운 마술사가 있어."
  },
  "8": {
   "jp": "b01b8139b0",
   "kr": "그놈 마법을 잠재울 수 있는 동료,"
  },
  "9": {
   "jp": "bd82e8441b",
   "kr": "그래, 루키어스라도 없으면"
  },
  "10": {
   "jp": "9925803b20",
   "kr": "동굴을 나아가기도 어려울걸."
  },
  "11": {
   "jp": "2f61da8b3b",
   "kr": "나라면 여기 있는데."
  },
  "12": {
   "jp": "ad6fff9db1",
   "kr": "아차, 실례했군.",
   "auto": 1
  },
  "13": {
   "jp": "02b678ed68",
   "kr": "내가 괜한 걱정을 했군."
  },
  "14": {
   "jp": "e1aecfabce",
   "kr": "이래서는 정보료를 받을 수 없겠는걸."
  },
  "15": {
   "jp": "5f8ee3bb32",
   "kr": "미안하지만 이쪽도 장사라서.",
   "auto": 1
  },
  "16": {
   "jp": "85b2ad0331",
   "kr": "공짜로 알려 줄 정보는 없어.",
   "auto": 1
  },
  "17": {
   "jp": "8d7ada494f",
   "kr": "정보를 안 듣고 헛걸음하지 않았으면 좋겠는데."
  },
  "18": {
   "jp": "c4f58ca985",
   "kr": "『승부사 구함』을 맡았나?"
  },
  "19": {
   "jp": "8638dd352d",
   "kr": "그럼 도움이 될 걸 알려 주지."
  },
  "20": {
   "jp": "6536f1076a",
   "kr": "잠자코 50로제 내놔."
  },
  "21": {
   "jp": "1aa54bf296",
   "kr": "우선 머릿속에 넣어 둘 건 하나다."
  },
  "22": {
   "jp": "1a5bf6f8fa",
   "kr": "공정한 도박 따위는 하나도 없어."
  },
  "23": {
   "jp": "ec5ae2727a",
   "kr": "도박꾼이 굶지 않는 건"
  },
  "24": {
   "jp": "7807a3fc3e",
   "kr": "결국엔 이득을 보기 때문이야."
  },
  "25": {
   "jp": "bfae79a71e",
   "kr": "속임수는 반드시 있어."
  },
  "26": {
   "jp": "29b3d71174",
   "kr": "눈 밝은 동료가 있다면…"
  },
  "27": {
   "jp": "ff57efc0f6",
   "kr": "어이쿠, 뭐야, 루키어스가 있잖아."
  },
  "28": {
   "jp": "5b8b89db07",
   "kr": "너라면 어설픈 사기 정도는 간파하는 게"
  },
  "29": {
   "jp": "ac5f3082b1",
   "kr": "일도 아니겠지?"
  },
  "30": {
   "jp": "1c64488204",
   "kr": "발도술의 명수는 심안을 쓸 수 있으니까."
  },
  "31": {
   "jp": "b69a77eb2c",
   "kr": "뭐, 그런 셈이지.",
   "auto": 1
  },
  "32": {
   "jp": "df0cf8e70e",
   "kr": "알면 정보료를 돌려줘."
  },
  "33": {
   "jp": "9e9d871c20",
   "kr": "…헤헤헤,"
  },
  "34": {
   "jp": "2a173046b0",
   "kr": "봐, 빈틈없지?"
  },
  "35": {
   "jp": "44dfe57d02",
   "kr": "50로제 돌려받았다."
  },
  "36": {
   "jp": "1ed15891e4",
   "kr": "눈 밝은 동료가 있으면 한 방이야."
  },
  "37": {
   "jp": "867dcd6bfd",
   "kr": "그래, 루키어스라든가."
  },
  "38": {
   "jp": "780aadc1f3",
   "kr": "발도술의 명수는 심안으로 사기를 간파하거든."
  },
  "39": {
   "jp": "5f8ee3bb32",
   "kr": "미안하지만 이쪽도 장사라서.",
   "auto": 1
  },
  "40": {
   "jp": "85b2ad0331",
   "kr": "공짜로 알려 줄 정보는 없어.",
   "auto": 1
  },
  "41": {
   "jp": "8d7ada494f",
   "kr": "정보를 안 듣고 헛걸음하지 않았으면 좋겠는데."
  },
  "42": {
   "jp": "53dbcf3efb",
   "kr": "짐 받을 곳을 모르게 되면",
   "auto": 1
  },
  "43": {
   "jp": "5b31d28b57",
   "kr": "구멍이 나도록 짐을 살펴봐.",
   "auto": 1
  },
  "44": {
   "jp": "2a5d6f42d6",
   "kr": "누구에게 전해야 하는지 생각날 테니까.",
   "auto": 1
  },
  "45": {
   "jp": "2d19631e7d",
   "kr": "지금은 별다른 정보가 없어.",
   "auto": 1
  },
  "46": {
   "jp": "9f13840241",
   "kr": "그쪽이야말로 뭔가 가르쳐 주지 않겠어?"
  }
 }
}
