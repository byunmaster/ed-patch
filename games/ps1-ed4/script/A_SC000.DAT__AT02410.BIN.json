 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02410.BIN",
 "segments": {
  "0": {
   "jp": "e9ac74de16",
   "kr": "로벨 할아버지"
  },
  "1": {
   "jp": "dcb6a7b9f5",
   "kr": "내가 로벨이오만."
  },
  "2": {
   "jp": "006d154f73",
   "kr": "뭐, 그런가."
  },
  "3": {
   "jp": "401ea32120",
   "kr": "편지를 전해 주겠다고?"
  },
  "4": {
   "jp": "52f21eef65",
   "kr": "그거 고맙군."
  },
  "5": {
   "jp": "09d7198750",
   "kr": "치브리 마을에 오랜 지인이 있어서 말이오."
  },
  "6": {
   "jp": "3a93aba612",
   "kr": "마을 동남쪽 끝에 있는 집에 사는"
  },
  "7": {
   "jp": "55441f3161",
   "kr": "토리노 영감에게 전해 주었으면 하오."
  },
  "8": {
   "jp": "511b6b5442",
   "kr": "어빈은 로벨의 편지를 받았다."
  },
  "9": {
   "jp": "100e7d505e",
   "kr": "자네들, 짐이 크구먼."
  },
  "10": {
   "jp": "4cfc2c57c5",
   "kr": "완력을 기르는 건가?"
  },
  "11": {
   "jp": "a46150d082",
   "kr": "토리노 영감의 집은"
  },
  "12": {
   "jp": "c65537d68b",
   "kr": "치브리 마을 동남쪽 끝에 있는 집이오."
  },
  "13": {
   "jp": "d7cc8b0c33",
   "kr": "되도록 빨리 전해 주게."
  },
  "14": {
   "jp": "77c5e98ca2",
   "kr": "토리노에게 편지를 전해 주었나?"
  },
  "15": {
   "jp": "62e6cc5b98",
   "kr": "아아, 답장이 기다려지는군."
  },
  "16": {
   "jp": "55aa30b286",
   "kr": "치브리의 토리노 영감, 건강하려나…"
  }
 }
}
