{
 "archive": "/O/SC400.DAT",
 "member": "..\\BIN\\OP00001.BIN",
 "segments": {
  "0": {
   "jp": "c7835842e0",
   "kr": "아이멜"
  },
  "1": {
   "jp": "cfe80e7d37",
   "kr": "오레시아"
  },
  "2": {
   "jp": "3bdecc58b2",
   "kr": "최고 도사 에스페리우스"
  },
  "3": {
   "jp": "c6cf8ccc3e",
   "kr": "승병"
  },
  "4": {
   "jp": "921766275e",
   "kr": "베리어스 경"
  },
  "5": {
   "jp": "22b80c5286",
   "kr": "우와아아아악!"
  },
  "6": {
   "jp": "e6fd7ce6c1",
   "kr": "둘 다 여기 있으렴."
  },
  "7": {
   "jp": "e7b00acbc0",
   "kr": "상황을 보고 올게요."
  },
  "8": {
   "jp": "a36046ff96",
   "kr": "도사님, 이 소란은 대체 무슨 일입니까?"
  },
  "9": {
   "jp": "38e8eb128b",
   "kr": "베리어스의 짓일세."
  },
  "10": {
   "jp": "24141acf93",
   "kr": "그자가 사신의 힘을 얻었네…"
  },
  "11": {
   "jp": "b83672de22",
   "kr": "자네들은 어서 이곳에서 빠져나가게."
  },
  "12": {
   "jp": "f7e976b12e",
   "kr": "오레시아 공."
  },
  "13": {
   "jp": "23d28fe665",
   "kr": "어빈과 아이멜을 데리고 곧 떠나겠네."
  },
  "14": {
   "jp": "82d888b934",
   "kr": "가웨인이 채비를 해 줄 걸세."
  },
  "15": {
   "jp": "5e19280085",
   "kr": "어빈."
  },
  "16": {
   "jp": "498a97d5fc",
   "kr": "이걸 받거라."
  },
  "17": {
   "jp": "b912103c4d",
   "kr": "에스페리우스는 어빈에게 카베사를 건넸다."
  },
  "18": {
   "jp": "7ef7c06f32",
   "kr": "아이멜."
  },
  "19": {
   "jp": "498a97d5fc",
   "kr": "이걸 받거라."
  },
  "20": {
   "jp": "65fb780c62",
   "kr": "에스페리우스는 아이멜에게 쿠엘포를 건넸다."
  },
  "21": {
   "jp": "99eb68b2af",
   "kr": "그 둘은 카테드랄에 전해 내려오는 발두스의 신보일세."
  },
  "22": {
   "jp": "a8e42e3294",
   "kr": "베리어스에게 넘겨줄 수는 없네."
  },
  "23": {
   "jp": "24dbb0d98e",
   "kr": "사태가 가라앉을 때까지"
  },
  "24": {
   "jp": "6f03bb116b",
   "kr": "미안하지만 그것을 맡아 주었으면 하네."
  },
  "25": {
   "jp": "d1b35286b3",
   "kr": "도사님!"
  },
  "26": {
   "jp": "2c5be54543",
   "kr": "베리어스의 병사들이! 사교도들이 몰려오고 있습니다!"
  },
  "27": {
   "jp": "9c83024914",
   "kr": "나는 베리어스를 설득하는 데 희망을 걸어 보겠네."
  },
  "28": {
   "jp": "207c4b9906",
   "kr": "그자 역시 한때는 같은 가르침을 배운 자이니…"
  },
  "29": {
   "jp": "95f26f0842",
   "kr": "자, 가게."
  },
  "30": {
   "jp": "d056e51e8f",
   "kr": "도사님…"
  },
  "31": {
   "jp": "6968e3cf59",
   "kr": "시간이 없다."
  },
  "32": {
   "jp": "452fa51ea8",
   "kr": "가자, 어빈, 아이멜."
  },
  "33": {
   "jp": "6e85a5c44d",
   "kr": "그럼 가겠습니다. 에스페리우스 님."
  },
  "34": {
   "jp": "469208cb3f",
   "kr": "부탁하네. 가웨인."
  },
  "35": {
   "jp": "de1f7c17e3",
   "kr": "서두르게."
  },
  "36": {
   "jp": "a8b69d7dcd",
   "kr": "오랜만입니다, 최고 도사 에스페리우스."
  },
  "37": {
   "jp": "196da55149",
   "kr": "베리어스, 무엇을 바라는가?"
  },
  "38": {
   "jp": "e60930317b",
   "kr": "오늘부터 카테드랄은"
  },
  "39": {
   "jp": "d3b7cd3a5f",
   "kr": "위대한 오크툼 신의 성전이 될 것이다."
  },
  "40": {
   "jp": "85f0e2d3fb",
   "kr": "언제까지 산산이 부서진 발두스를 칭송할 거냐?"
  },
  "41": {
   "jp": "93753eb094",
   "kr": "이미 신들의 싸움에서"
  },
  "42": {
   "jp": "41ab41cc34",
   "kr": "정신전이 숭배하던 발두스 신은 스러졌다."
  },
  "43": {
   "jp": "8b03c74b22",
   "kr": "비록 사신이라 해도"
  },
  "44": {
   "jp": "c669590db6",
   "kr": "지금도 봉인의 땅에서 힘을 비축하는 오크툼 신이야말로"
  },
  "45": {
   "jp": "2ebdcc513f",
   "kr": "우리가 찬미하기에 합당하다."
  },
  "46": {
   "jp": "7cd64d3b9a",
   "kr": "베리어스여."
  },
  "47": {
   "jp": "a499dff636",
   "kr": "마도에 빠졌구먼."
  },
  "48": {
   "jp": "6757938187",
   "kr": "언제까지고"
  },
  "49": {
   "jp": "e93e04fb6b",
   "kr": "산산이 부서진 발두스를 찬미해 어쩌겠다는 것이냐?"
  }
 }
}
