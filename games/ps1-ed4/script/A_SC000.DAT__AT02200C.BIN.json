{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02200C.BIN",
 "segments": {
  "0": {
   "jp": "fb93330323",
   "kr": "그래, ５로제만 주면 좋은 정보가 있지."
  },
  "1": {
   "jp": "3ab1200b57",
   "kr": "들어 볼래?"
  },
  "2": {
   "jp": "489d2984bc",
   "kr": "아, 저는 동물이라면"
  },
  "3": {
   "jp": "3c7f557edc",
   "kr": "무슨 생각을 하는지 알아요."
  },
  "4": {
   "jp": "43a1b460ba",
   "kr": "특히 집에서 기르는 개는 마음이 잘 전해져."
  },
  "5": {
   "jp": "ad6fff9db1",
   "kr": "아차, 실례했군."
  },
  "6": {
   "jp": "e1f48cb8b2",
   "kr": "네가 있다면 걱정할 것 없지."
  },
  "7": {
   "jp": "e1aecfabce",
   "kr": "이래서는 정보료를 받을 수 없겠어."
  },
  "8": {
   "jp": "5f8ee3bb32",
   "kr": "미안하지만 이쪽도 장사라서."
  },
  "9": {
   "jp": "3b853b94c4",
   "kr": "로제가 없는 녀석은 다음에 다시 와."
  },
  "10": {
   "jp": "39db1e239e",
   "kr": "정보료를 아끼는 건"
  },
  "11": {
   "jp": "46f360b3db",
   "kr": "미끼 없이 낚시하는 것과 같아."
  },
  "12": {
   "jp": "eea53d6e81",
   "kr": "귀여운 빅토리아를"
  },
  "13": {
   "jp": "eb7436ff0c",
   "kr": "산책시켜 주겠나?"
  },
  "14": {
   "jp": "dde4d03ef7",
   "kr": "그거 고맙군."
  },
  "15": {
   "jp": "5641fbce7d",
   "kr": "산책 코스는 빅토리아가 아니까"
  },
  "16": {
   "jp": "95dd01fbd7",
   "kr": "자네는 따라다니면서"
  },
  "17": {
   "jp": "07401b7819",
   "kr": "마을을 한 바퀴 돌고 와 주면 돼."
  },
  "18": {
   "jp": "9815db0513",
   "kr": "빅토리아, 이리 와!"
  },
  "19": {
   "jp": "c3dc50025f",
   "kr": "수고했네."
  },
  "20": {
   "jp": "683c24b139",
   "kr": "어라, 빅토리아 녀석 기분이 좋군."
  },
  "21": {
   "jp": "ce8b12a338",
   "kr": "산책을 정말 잘 시켜 준 모양이야."
  },
  "22": {
   "jp": "5d928dde70",
   "kr": "정말 착한 애네요."
  },
  "23": {
   "jp": "c3a9ff838b",
   "kr": "산책하는 동안에도"
  },
  "24": {
   "jp": "2432c74534",
   "kr": "말을 아주 잘 들어 줬어요."
  },
  "25": {
   "jp": "6a47dc9799",
   "kr": "호오, 아가씨는 개를 다루는 데 익숙하구나."
  },
  "26": {
   "jp": "d49fde49fc",
   "kr": "이건 특별 보너스야."
  },
  "27": {
   "jp": "16f913f45f",
   "kr": "받아 두게나."
  },
  "28": {
   "jp": "21298852b9",
   "kr": "어빈은 １００로제를 받았다."
  },
  "29": {
   "jp": "fdc515841f",
   "kr": "알선소에서 내 의뢰를 발견하면"
  },
  "30": {
   "jp": "4ceb9852a9",
   "kr": "꼭 다시 맡아 줬으면 좋겠군."
  },
  "31": {
   "jp": "ca5a3b499d",
   "kr": "힘들었지?"
  },
  "32": {
   "jp": "96a481e5d9",
   "kr": "빅토리아는 모르는 사람의 말은"
  },
  "33": {
   "jp": "02dfeb3387",
   "kr": "듣지 않거든."
  },
  "34": {
   "jp": "80dd335d92",
   "kr": "알선소에 보수를 보내 놨으니"
  },
  "35": {
   "jp": "ccb93f86da",
   "kr": "잊지 말고 받아 가."
  },
  "36": {
   "jp": "cc5c1d0689",
   "kr": "으악, 어디로 가는 거야!"
  },
  "37": {
   "jp": "7408352a9c",
   "kr": "빅토리아, 착하지."
  },
  "38": {
   "jp": "7d4d2d9339",
   "kr": "좋아, 달린다!"
  },
  "39": {
   "jp": "51b839a45f",
   "kr": "멍!"
  },
  "40": {
   "jp": "5a27646d5e",
   "kr": "그래, １０로제만 주면 좋은 정보가 있지."
  },
  "41": {
   "jp": "3ab1200b57",
   "kr": "들어 볼래?"
  },
  "42": {
   "jp": "b13ff7abc9",
   "kr": "왕립 도서관의 고문서 연구는"
  },
  "43": {
   "jp": "7bcce3611e",
   "kr": "아마추어에게는 좀 손이 많이 가는 일이야."
  },
  "44": {
   "jp": "cdbb0c56fe",
   "kr": "전문 지식이 있는 녀석,"
  },
  "45": {
   "jp": "4495413b90",
   "kr": "그렇지, 마티 같은 사람이 적임이지."
  },
  "46": {
   "jp": "a4d930a5a1",
   "kr": "저라면 여기 있는데요."
  },
  "47": {
   "jp": "ad6fff9db1",
   "kr": "아차, 실례했군."
  },
  "48": {
   "jp": "faeea1a4b7",
   "kr": "그럼 정보료를 받을 수는 없겠어."
  },
  "49": {
   "jp": "5f8ee3bb32",
   "kr": "미안하지만 이쪽도 장사라서."
  },
  "50": {
   "jp": "85b2ad0331",
   "kr": "공짜로 알려 줄 정보는 없어."
  },
  "51": {
   "jp": "6ff482c9bc",
   "kr": "정보 없이 갔다가 고생이나 안 하면 좋겠군."
  },
  "52": {
   "jp": "88921080b0",
   "kr": "지금으로선 눈에 띄는 정보는 없네."
  },
  "53": {
   "jp": "a05bb3e790",
   "kr": "네 쪽이야말로 재미있는 얘기 없어?"
  },
  "54": {
   "jp": "cc04422bec",
   "kr": "오울의 일을 맡았구나."
  },
  "55": {
   "jp": "d5909ad3a0",
   "kr": "먼저 오울에게 이야기를 들어 보는 건 어때?"
  },
  "56": {
   "jp": "cc04422bec",
   "kr": "오울의 일을 맡았구나."
  },
  "57": {
   "jp": "4bb21f3c7f",
   "kr": "이상한 편지가 있었다며?"
  },
  "58": {
   "jp": "c1ebe81606",
   "kr": "어디, 나한테도 보여 줘."
  },
  "59": {
   "jp": "cc3f8e39fa",
   "kr": "정보상에게 편지를 보여 주었다."
  },
  "60": {
   "jp": "0706483587",
   "kr": "도넛, 정말 맛있었어.",
   "fix": 1
  },
  "61": {
   "jp": "5a63fd7e04",
   "kr": "크림 쿠키도 정말로,",
   "fix": 1
  },
  "62": {
   "jp": "9390660b91",
   "kr": "스며드는 듯한 멋진 맛이었어.",
   "fix": 1
  },
  "63": {
   "jp": "f9831718f9",
   "kr": "남쪽 나라에서 너와 살면 좋겠어.",
   "fix": 1
  },
  "64": {
   "jp": "597e869a69",
   "kr": "쪽빛 하늘 아래 느긋이 즐겁게 지내자.",
   "fix": 1
  },
  "65": {
   "jp": "7578816a24",
   "kr": "사르르 시원한 바람이 부는,",
   "fix": 1
  },
  "66": {
   "jp": "2e4a2a20d8",
   "kr": "플라타너스 그늘 아래 과일이 열리는 섬에서.",
   "fix": 1
  },
  "67": {
   "jp": "c602be36fe",
   "kr": "에워싼 루비빛 저녁노을을 바라보자.",
   "fix": 1
  },
  "68": {
   "jp": "e3206fc423",
   "kr": "서둘러 짐은 이미 다 꾸렸어.",
   "fix": 1
  },
  "69": {
   "jp": "ac23e1a629",
   "kr": "만약 편지가 도착하면 바로 와 줘.",
   "fix": 1
  },
  "70": {
   "jp": "185a6e796a",
   "kr": "나는 여기서 기다리고 있을게.",
   "fix": 1
  },
  "71": {
   "jp": "98ceabb438",
   "kr": "자책 속에 애태우는 루게이로부터.",
   "fix": 1
  },
  "72": {
   "jp": "b86c2bc99e",
   "kr": "허어."
  },
  "73": {
   "jp": "7586f00d06",
   "kr": "이건 좀 위험할지도 몰라."
  },
  "74": {
   "jp": "a58fd4e005",
   "kr": "루게이는 샴실단의 일원이야."
  },
  "75": {
   "jp": "b7d1229b32",
   "kr": "조직의 중간급이지."
  },
  "76": {
   "jp": "975d9d6018",
   "kr": "하지만 어째서"
  },
  "77": {
   "jp": "882031cb02",
   "kr": "코레트 씨를 데려간 걸까."
  },
  "78": {
   "jp": "e36bb4956c",
   "kr": "루게이는 운반 전문이잖아?"
  },
  "79": {
   "jp": "3e0492ed48",
   "kr": "조직 녀석들과 연락만 주고받고"
  },
  "80": {
   "jp": "498b05e904",
   "kr": "유괴 같은 건 그 녀석 일이 아닐 텐데."
  },
  "81": {
   "jp": "4049b759ed",
   "kr": "설마 진짜 연애 문제는 아니겠지!"
  },
  "82": {
   "jp": "b80aa2de49",
   "kr": "하하하하…"
  },
  "83": {
   "jp": "89250d4794",
   "kr": "…농담은 그만하고"
  },
  "84": {
   "jp": "2642039a82",
   "kr": "이 편지는 사랑의 도피 권유 따위가 아니야."
  },
  "85": {
   "jp": "e9bc91d0c0",
   "kr": "정확히 말하면 샴실단의 암호 통신문이야."
  },
  "86": {
   "jp": "854c4293a0",
   "kr": "단어를 늘어놓은 방식이 어딘가 부자연스럽지?"
  },
  "87": {
   "jp": "c00bed2515",
   "kr": "자, 나는 이미 답을 알았는데"
  },
  "88": {
   "jp": "3270baa4be",
   "kr": "자네는 어때?"
  },
  "89": {
   "jp": "5c193db8ef",
   "kr": "원한다면 알려 줘도 좋은데,"
  },
  "90": {
   "jp": "d82c72acde",
   "kr": "２００로제쯤 마련할 수 있으려나?"
  },
  "91": {
   "jp": "b0fdf5c80d",
   "kr": "이건 암호문의 초보 중의 초보야."
  },
  "92": {
   "jp": "e5374b1778",
   "kr": "읽는 방향을 바꾸는 거지."
  },
  "93": {
   "jp": "2f7209de03",
   "kr": "문장의 맨 첫 글자를 세로로 읽어 봐."
  },
  "94": {
   "jp": "47c3147e3d",
   "kr": "…자, 동굴 이름이 나왔지…?"
  },
  "95": {
   "jp": "87007c56e1",
   "kr": "쳇, 쪼잔하네."
  },
  "96": {
   "jp": "d9da7148e9",
   "kr": "공짜로 알려 줄 수 있겠어?"
  },
  "97": {
   "jp": "a3f2120e55",
   "kr": "흥, 뭐 좋아."
  },
  "98": {
   "jp": "7eceb1bca5",
   "kr": "포기하면 언제든 와."
  },
  "99": {
   "jp": "7bb3d3eeea",
   "kr": "역시 포기지?"
  },
  "100": {
   "jp": "b6cf1d080d",
   "kr": "암호는 역시 정보상한테 맡겨야지."
  },
  "101": {
   "jp": "1871a49eac",
   "kr": "잠자코 ２００로제 내놔."
  },
  "102": {
   "jp": "b0fdf5c80d",
   "kr": "이건 암호문의 초보 중의 초보야."
  },
  "103": {
   "jp": "e5374b1778",
   "kr": "읽는 방향을 바꾸는 거지."
  },
  "104": {
   "jp": "2f7209de03",
