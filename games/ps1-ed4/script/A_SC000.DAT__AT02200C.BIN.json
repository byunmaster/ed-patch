  },
  "109": {
   "jp": "7eceb1bca5",
   "kr": "포기하면 언제든 와."
  },
  "110": {
   "jp": "cfa727ffb9",
   "kr": "빈센 씨네 개는 까다로워서 말이야."
  },
  "111": {
   "jp": "9792edef91",
   "kr": "상대가 마음에 안 들면"
  },
  "112": {
   "jp": "1f70c02dc5",
   "kr": "제멋대로 뛰어다녀."
  },
  "113": {
   "jp": "cdc59abccc",
   "kr": "동물의 마음을 아는 녀석이"
