  },
  "66": {
   "jp": "ee4fcbafde",
   "kr": "여기가"
  },
  "67": {
   "jp": "1e494cb7a0",
   "kr": "내가 사교도를 피해 8년 동안 살았던 집이다."
  },
  "68": {
   "jp": "a003cb1fd0",
   "kr": "………"
  },
  "69": {
   "jp": "59f9dcf56d",
   "kr": "변함없구나."
  },
  "70": {
   "jp": "3d59f76886",
   "kr": "내가 아이멜을 찾아 여행을 떠났을 때와"
  },
  "71": {
   "jp": "063e17f7e4",
   "kr": "하나도 달라진 게 없어."
  },
  "72": {
   "jp": "5e63eaba71",
   "kr": "할아버지, 아이멜은 만났어."
  },
  "73": {
   "jp": "6b9499459d",
   "kr": "하지만…"
  },
  "74": {
   "jp": "d945ed6503",
   "kr": "이미 알고 있겠지."
  },
  "75": {
   "jp": "a003cb1fd0",
   "kr": "………"
  },
  "76": {
   "jp": "e173f599e1",
   "kr": "…마일도 말이야…"
  },
  "77": {
   "jp": "e2a700ab64",
   "kr": "할아버지, 내 여행은 아직 끝나지 않았어."
  },
  "78": {
   "jp": "2c710a0659",
   "kr": "여기에 돌아오는 건 조금 더 나중이 될 것 같아."
  },
  "79": {
   "jp": "a003cb1fd0",
   "kr": "………"
  },
  "80": {
   "jp": "3755b04289",
   "kr": "자, 이야기는 이쯤 하도록 할게."
  },
  "81": {
   "jp": "ed73b65c21",
   "kr": "진실의 섬에서 본 곳을 확인해야 하거든."
  },
  "82": {
   "jp": "d8d37f4a19",
   "kr": "진실의 섬에서 당신이 본 영상이 뭐였나요?"
  },
  "83": {
   "jp": "ac07297b96",
   "kr": "죽은 할아버지가"
  },
  "84": {
   "jp": "56d02733fb",
   "kr": "밭의 허수아비에 뭔가를 숨기는 모습이었어."
  },
  "85": {
   "jp": "36d14d6578",
   "kr": "허수아비에…? 그게 다야?"
  },
  "86": {
   "jp": "05787013d3",
   "kr": "응. 그게 다야."
  },
  "87": {
   "jp": "9ca477df19",
   "kr": "어빈은 허수아비를 살폈다."
  },
  "88": {
   "jp": "b6822a510c",
   "kr": "묶어 놓은 짚단 틈새에서 "
  },
  "89": {
   "jp": "c09ca2d0fc",
   "kr": "이(가) 나왔다."
  },
  "90": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "91": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다."
  },
  "92": {
   "jp": "51dee9e583",
   "kr": "할아버지의 편지야."
  },
  "93": {
   "jp": "344850eef0",
   "kr": "읽어 봐."
  },
  "94": {
   "jp": "4382dd5afb",
   "kr": "《레뮤라스의 편지》"
  },
  "95": {
   "jp": "3b35921f64",
   "kr": "네프티스의 사당."
  },
  "96": {
   "jp": "e1012fec9d",
   "kr": "발두스의 신령, 이스브라를 지켜보는 임무도"
  },
  "97": {
   "jp": "dd41fd058a",
   "kr": "내 대에서 끝나게 될 것이다."
  },
  "98": {
   "jp": "49e0efbb17",
   "kr": "사태는 급속히 진행되고 있다."
  },
  "99": {
   "jp": "ddf493e295",
   "kr": "신령을 둘러싼 싸움은"
  },
  "100": {
   "jp": "393a651a7c",
   "kr": "인간의 미래를 결정지을 만한 선택을 강요할 것이다."
  },
  "101": {
   "jp": "1c49f60d67",
   "kr": "그러나 이로써 오랜 대립도 끝이 나리라."
  },
  "102": {
   "jp": "3f0e364af5",
   "kr": "노토스 숲에 사당 입구가 있다."
  },
  "103": {
   "jp": "8041245487",
   "kr": "사당 안에서 허수아비에 숨긴 열쇠를 써라."
  },
  "104": {
   "jp": "6bd70b7dfc",
   "kr": "알고 있었던 거야…"
  },
  "105": {
   "jp": "d1175accea",
   "kr": "할아버지는 알고 있었던 거야."
  },
  "106": {
   "jp": "90e0cc75e5",
   "kr": "레뮤라스 할아버지는"
  },
  "107": {
   "jp": "d4d11a8bc6",
   "kr": "이 산에서 네프티스의 상태를 지켜보고 있었던 거야."
  },
  "108": {
   "jp": "97a68e350e",
   "kr": "노토스 숲."
  },
  "109": {
   "jp": "c91a315200",
   "kr": "우리가 북쪽 산이라고 부르던 곳이다."
  },
  "110": {
   "jp": "482d722524",
   "kr": "이 집의 북쪽으로 빠져나갈 수 있어."
  },
  "111": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서"
  },
