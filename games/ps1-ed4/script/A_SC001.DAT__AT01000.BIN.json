 "segments": {
  "0": {
   "jp": "50b5b3aefd",
   "kr": "레뮤라스"
  },
  "1": {
   "jp": "311da87ac0",
   "kr": "소년 시절은 눈 깜짝할 새에 지나갔다."
  },
  "2": {
   "jp": "dddd29580a",
   "kr": "…어빈."
  },
  "3": {
   "jp": "5e745b91d4",
   "kr": "벌써 열일곱이 되었구나…"
  },
  "4": {
   "jp": "a0c225a6bc",
   "kr": "훌륭하게 자라 주어서"
  },
  "5": {
   "jp": "39fabf0881",
   "kr": "나도 마지막 소임을 다했다는 생각이 드는구려."
  },
  "6": {
   "jp": "4438d6a8a3",
   "kr": "여동생 아이멜 일이오만…"
  },
  "7": {
   "jp": "3494d265fa",
   "kr": "너는 말하지 않았지만,"
  },
  "8": {
   "jp": "c1705e51de",
   "kr": "늘 동생을 마음에 두고 있었다는 것을"
  },
  "9": {
   "jp": "f758e2011f",
   "kr": "잘 잘 알고 있다…"
  },
  "10": {
   "jp": "abc203ef8a",
   "kr": "두 사람이 함께 있으면"
  },
  "11": {
   "jp": "2996fb4620",
   "kr": "금세 눈에 띄고 말 테니 말이오."
  },
  "12": {
   "jp": "5880ec9d5d",
   "kr": "사교도의 눈을 돌리려고"
  },
  "13": {
   "jp": "fa9f75d3fb",
   "kr": "너희 남매를 떨어뜨려 놓았소만…"
  },
  "14": {
   "jp": "0a42974054",
   "kr": "그로부터 8년인가…"
  },
  "15": {
   "jp": "d1404e05a9",
   "kr": "네가 원한다면"
  },
  "16": {
   "jp": "b4f5c48d79",
   "kr": "이곳을 떠나 아이멜을 찾아가도 좋다."
  },
  "17": {
   "jp": "a003cb1fd0",
   "kr": "………"
  },
  "18": {
   "jp": "13fa4964a2",
   "kr": "아이멜이 있는 곳은"
  },
  "19": {
   "jp": "8929f185f9",
   "kr": "치브리 마을 변두리에 사는 디너켄이 알고 있소."
  },
  "20": {
   "jp": "8b5e3c7b30",
   "kr": "여기에 남든, 바깥세상으로 나가든…"
  },
  "21": {
   "jp": "d8e31dbe35",
   "kr": "이제는… 네 자유요…"
  },
  "22": {
   "jp": "0541461802",
   "kr": "이제부터는 네가 살고 싶은 대로 살거라."
  },
  "23": {
   "jp": "a5dfb06f5a",
   "kr": "알겠느냐?"
  },
  "24": {
   "jp": "cea382f907",
   "kr": "할아버지…"
  },
  "25": {
   "jp": "4e9a26682b",
   "kr": "어빈…"
  },
  "26": {
   "jp": "f26895dc00",
   "kr": "너를 만나서… 다행이었다…"
  },
  "27": {
   "jp": "2eabaf58e4",
   "kr": "…이만 작별이오."
  },
  "28": {
   "jp": "a003cb1fd0",
   "kr": "………"
  },
  "29": {
   "jp": "72d22ea3ae",
   "kr": "………"
  },
  "30": {
   "jp": "0d100cc4e5",
   "kr": "……"
  },
  "31": {
   "jp": "c0e72bb6a8",
   "kr": "…나, 갈게."
  },
  "32": {
   "jp": "0ab9a2260d",
   "kr": "할아버지가 말한 대로"
  },
  "33": {
   "jp": "13a427112b",
   "kr": "사교도들이 노릴지도 모르지만…"
  },
  "34": {
   "jp": "9c6fc95991",
   "kr": "그래도 역시 나는 아이멜을 만나고 싶어."
  },
  "35": {
   "jp": "88b8026a84",
   "kr": "녀석들이 내가 가진 카베사와"
  },
  "36": {
   "jp": "35683295b4",
   "kr": "아이멜의 쿠에르포를 노린다면 더더욱 그래."
  },
  "37": {
   "jp": "b2608e85c7",
   "kr": "어빈은 품속의 카베사에 손을 얹고 결의를 다졌다."
  },
  "38": {
   "jp": "4f60d6f401",
   "kr": "아이멜을 만나 카베사와 쿠에르포가 모이면"
  },
  "39": {
   "jp": "47c3421193",
   "kr": "정신전 사람에게 신보를 맡기고 여기로 돌아오겠어."
  },
  "40": {
   "jp": "217455b8c9",
   "kr": "우리가 신보를 갖고 있지 않으면"
  },
  "41": {
   "jp": "e35e02c789",
   "kr": "사교도에게 쫓길 걱정도 없으니까."
  },
  "42": {
   "jp": "9d3ec034aa",
   "kr": "기다려 줘, 할아버지."
  },
  "43": {
   "jp": "1a2609cf6b",
   "kr": "현자 레뮤라스 여기 잠들다."
  },
  "44": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "45": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다."
  },
  "46": {
   "jp": "889ceea3f2",
   "kr": "보물상자에는 "
  },
  "47": {
   "jp": "665e4d5705",
   "kr": "이(가) 들어 있다."
  },
  "48": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서"
  },
  "49": {
   "jp": "f5fc3dee34",
   "kr": "을(를) 포기했다."
  },
  "50": {
   "jp": "63c4c357c2",
   "kr": "보물상자에는 아무것도 들어 있지 않다."
  },
  "51": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "52": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다.",
