 "segments": {
  "0": {
   "jp": "1fec8caa1f",
   "kr": "카보 촌장"
  },
  "1": {
   "jp": "62cfdb0fd9",
   "kr": "클로리"
  },
  "2": {
   "jp": "ee3121ac8f",
   "kr": "밧사"
  },
  "3": {
   "jp": "874ada80aa",
   "kr": "레이트르"
  },
  "4": {
   "jp": "4d7231dcbb",
   "kr": "가든힐에 어서 오시게!"
  },
  "5": {
   "jp": "f741bd20ab",
   "kr": "나는 촌장 카보라네."
  },
  "6": {
   "jp": "f580e66da5",
   "kr": "가든힐은 『신들의 정원』!"
  },
  "7": {
   "jp": "0433ee6e19",
   "kr": "세상에서 가장 높은 곳에 있는 마을이지!"
  },
  "8": {
   "jp": "83e4852fc0",
   "kr": "햇빛의 은혜를 가장 많이 받는 마을이기도 하고!"
  },
  "9": {
   "jp": "621706a70b",
   "kr": "천국에 가장 가까운 역사의 고향이라네!"
  },
  "10": {
   "jp": "4473ee20b5",
   "kr": "자, 그건 그렇고…"
  },
  "11": {
   "jp": "70767ca121",
   "kr": "관광 안내 같은 설명은 이쯤 해 두고…"
  },
  "12": {
   "jp": "383d68a9a4",
   "kr": "자네들, 관광객은 아니로군."
  },
  "13": {
   "jp": "25001f3e17",
   "kr": "무슨 일로 왔나?"
  },
  "14": {
   "jp": "b7951b8eed",
   "kr": "무슨 일이냐니…"
  },
  "15": {
   "jp": "112586cebe",
   "kr": "딱히 저희는 수상한 사람이…"
  },
  "16": {
   "jp": "1ae234805f",
   "kr": "알고 있네."
  },
  "17": {
   "jp": "6e8cadf620",
   "kr": "하지만 무슨 일로 왔나?"
  },
  "18": {
   "jp": "a8c55b2050",
   "kr": "그냥 한번 와 봤을 뿐이야."
  },
  "19": {
   "jp": "20e7004f7a",
   "kr": "호오～"
  },
  "20": {
   "jp": "ae3fc8ba49",
   "kr": "그것뿐인가?"
  },
  "21": {
   "jp": "1f583fe355",
   "kr": "뭐, 지금은 그럴지도 모르지만…"
  },
  "22": {
   "jp": "6ced18ac16",
   "kr": "이래 봬도 우리 집안은 대대로 예언자 가문이라네."
  },
  "23": {
   "jp": "3041550284",
   "kr": "아들 레이트르도 신전지기를 하고 있지."
  },
  "24": {
   "jp": "589f26a28b",
   "kr": "나도 감은 좋은 편이라네."
  },
  "25": {
   "jp": "1de7260f42",
   "kr": "올 거야, 올 거야, 올 거야!"
  },
  "26": {
   "jp": "529d04acc5",
   "kr": "자네는 또"
  },
  "27": {
   "jp": "92753ce95a",
   "kr": "분명 가든힐에 찾아올 걸세!"
  },
  "28": {
   "jp": "db84c22e0d",
   "kr": "내 감이 그렇게 말하고 있네."
  },
  "29": {
   "jp": "ada10f9e87",
   "kr": "사양 말고 또 오시게."
  },
  "30": {
   "jp": "148263354a",
   "kr": "이… 이상한 촌장님이네…"
  },
  "31": {
   "jp": "33edaf04eb",
   "kr": "새로운 마을 살리기 운동인가…?"
  },
  "32": {
   "jp": "ea145367f9",
   "kr": "여기는 오래된 것밖에 내세울 게 없는 곳이라서 말이야."
  },
  "33": {
   "jp": "bbfe4bde55",
   "kr": "관광객이라도 우르르 와 주면"
  },
  "34": {
   "jp": "843970f11d",
   "kr": "이 마을도 조금은 윤택해질 텐데."
  },
  "35": {
   "jp": "ff78339bcf",
   "kr": "북쪽 신전터 같은 건"
  },
  "36": {
   "jp": "f40e0762e1",
   "kr": "손님을 끌기엔 딱 좋은데 말이야."
  },
  "37": {
   "jp": "04c15dc2f3",
   "kr": "저기, 그 북쪽 신전터는"
  },
  "38": {
   "jp": "fa48231a00",
   "kr": "무엇을 기원하던 신전이에요?"
  },
  "39": {
   "jp": "1e267ab62b",
   "kr": "호오, 역시 흥미가 있으신 모양이군요."
  },
  "40": {
   "jp": "bc35d9532a",
   "kr": "우리끼리 얘기네만."
  },
  "41": {
   "jp": "93d038bb52",
   "kr": "그 신전터는 아무래도 그저 배전일 뿐이고"
  },
  "42": {
   "jp": "d109883aa0",
   "kr": "어딘가에 진짜 신전으로 통하는 비밀 입구가"
  },
  "43": {
   "jp": "564d77c372",
   "kr": "있는 모양이라네."
  },
  "44": {
   "jp": "680a5a2a10",
   "kr": "듣자 하니 발두스 신의 신령 중 하나인"
  },
  "45": {
   "jp": "dc4a3f51ef",
   "kr": "데레브라를 신물로 모시고"
  },
  "46": {
   "jp": "39503a4a7d",
   "kr": "정령 이둔과 함께 기도했던 모양이야."
  },
  "47": {
   "jp": "75d228197e",
   "kr": "발두스 신의 신령이 신물…?"
  },
  "48": {
   "jp": "45e51b762c",
   "kr": "어떤가, 대단하지 않나."
  },
  "49": {
   "jp": "e9ac5cc6da",
   "kr": "하지만 솔직히 말해서"
  },
  "50": {
   "jp": "f5b9901622",
   "kr": "신전지기인 아들 레이트르조차"
  },
  "51": {
   "jp": "01fde7a820",
   "kr": "비밀 입구는 모른다네."
  },
  "52": {
   "jp": "d1262e74d7",
   "kr": "그게 발견된다면야."
  },
  "53": {
   "jp": "a4272ee6f9",
   "kr": "훌륭한 관광 명소가 될 텐데…"
  },
  "54": {
   "jp": "b8b1326797",
   "kr": "레이트르를 만나고 싶다고?"
  },
  "55": {
   "jp": "c8958a6f9d",
   "kr": "아들 레이트르라면"
  },
  "56": {
   "jp": "ad5da78abc",
   "kr": "신전터에서 명상을 하고 있을 걸세."
  },
  "57": {
   "jp": "4884579426",
   "kr": "뭐라고?"
  },
  "58": {
   "jp": "faf3eafc93",
   "kr": "에엑!"
  },
  "59": {
   "jp": "19fefc827b",
   "kr": "정말인가…?!"
  },
  "60": {
   "jp": "b07973170e",
   "kr": "비밀 입구를 찾아내서"
  },
  "61": {
   "jp": "a2b15e482f",
   "kr": "진짜 신전에 들어갔다고!"
  },
  "62": {
   "jp": "659e8b0d01",
   "kr": "흠흠… 흠흠…"
  },
  "63": {
   "jp": "b9f1ae2a0d",
   "kr": "그래서? 흠… 그래서?"
  },
  "64": {
   "jp": "c1b157dd21",
   "kr": "흠흠…"
  },
  "65": {
   "jp": "9022d0b351",
   "kr": "뭐라고?!"
  },
  "66": {
   "jp": "78c37bd66a",
   "kr": "신물도 찾아냈다고!"
  },
  "67": {
   "jp": "224dc91ba0",
   "kr": "이거야."
  },
  "68": {
   "jp": "81f4f80f73",
   "kr": "어빈은 데레브라를 보여 주었다."
  },
  "69": {
   "jp": "437fc7fa4a",
   "kr": "엇?"
  },
  "70": {
   "jp": "e839ed742f",
   "kr": "멋대로 가지고 나온 건가…?!"
  },
  "71": {
   "jp": "6b6b90d923",
   "kr": "이걸 노리는 사람들이 있어."
  },
  "72": {
   "jp": "d556f3bb9a",
   "kr": "그대로 신전에 두면"
  },
  "73": {
   "jp": "d873323bab",
   "kr": "머지않아 그 사람들이 찾아와서"
  },
  "74": {
   "jp": "d274726c78",
   "kr": "빼앗길 뿐이야."
  },
  "75": {
   "jp": "7e35932e74",
   "kr": "분명 마을 사람들에게도 희생이 나올 거야."
  },
  "76": {
   "jp": "8be7281568",
   "kr": "그자들은 잔인하니까…"
  },
  "77": {
   "jp": "d526a8c487",
   "kr": "그… 그런가…"
  },
  "78": {
   "jp": "9b70ee8af3",
   "kr": "여기에 데레브라가 없다는 걸 알면"
  },
  "79": {
   "jp": "087cbb4353",
   "kr": "마을 사람들이 해를 입을 일은 없을 거야."
  },
  "80": {
   "jp": "da435019a5",
   "kr": "그렇다 해도 귀중한 관광 자산인데 말이야."
  },
  "81": {
   "jp": "04ae0c8408",
   "kr": "어빈 씨에게 맡기죠."
  },
  "82": {
   "jp": "213ef1a665",
   "kr": "레이트르…!?"
  },
  "83": {
   "jp": "e9dfbbcb9b",
   "kr": "아버지, 어빈 씨 일행에게 맡기죠."
  },
  "84": {
   "jp": "de125f5dff",
   "kr": "명상을 하다가 이둔 님의 목소리를 들었습니다."
  },
  "85": {
   "jp": "7ec5a3a2a9",
   "kr": "어빈 씨에게 데레브라를 맡기라고."
  },
  "86": {
   "jp": "c516cb37db",
   "kr": "이 세계에는 비슷한 신령이 몇 개 있습니다."
  },
  "87": {
   "jp": "d24fb2d3a3",
   "kr": "아무래도 어빈 씨는"
  },
  "88": {
   "jp": "281eea249b",
   "kr": "그것들을 전부 모을 운명인 듯합니다."
  },
  "89": {
   "jp": "4c8a05d573",
   "kr": "…으음～"
  },
  "90": {
   "jp": "ac7524d93f",
   "kr": "레이트르가 그렇게 말한다면…"
  },
  "91": {
   "jp": "c432f09eaa",
   "kr": "뭐, 어쩔 수 없겠지…"
  },
  "92": {
   "jp": "32ab271a37",
   "kr": "데레브라는 맡기겠습니다만,"
  },
  "93": {
   "jp": "5477f62b0a",
   "kr": "필요 없어지면 돌려주시겠지요."
  },
  "94": {
   "jp": "721daec34f",
   "kr": "뭐니 뭐니 해도"
  },
  "95": {
   "jp": "db6ec64f3f",
   "kr": "귀중한 관광 자산이니 말이야."
  },
  "96": {
   "jp": "67be7b068f",
   "kr": "부탁합니다."
  },
  "97": {
   "jp": "32ab271a37",
   "kr": "데레브라는 맡기겠네만,"
  },
  "98": {
   "jp": "5477f62b0a",
   "kr": "필요 없어지면 돌려주시게나."
  },
  "99": {
   "jp": "721daec34f",
   "kr": "뭐니 뭐니 해도"
  },
  "100": {
   "jp": "db6ec64f3f",
   "kr": "귀중한 관광 자산이니 말이야."
  },
  "101": {
   "jp": "67be7b068f",
   "kr": "부탁합니다."
  },
  "102": {
   "jp": "3198fc4a3c",
   "kr": "가든힐은 특산물도 없지만"
  },
  "103": {
   "jp": "76de7051f5",
   "kr": "마을 자체가 유적이니까."
  },
  "104": {
   "jp": "ffa6e90e8d",
   "kr": "역사가 오래된 것밖에 내세울 게 없어."
  },
  "105": {
   "jp": "fdb6576b02",
   "kr": "영감도 촌장이라는 입장이 있으니"
  },
  "106": {
   "jp": "adc1217fcc",
   "kr": "마을 살릴 방법을 궁리하며"
  },
  "107": {
   "jp": "662014326a",
   "kr": "이래저래 머리를 싸매고 있단다."
  },
  "108": {
   "jp": "2480a6136a",
   "kr": "솔직히 관광객이 우르르 오면"
  },
  "109": {
   "jp": "7685439575",
   "kr": "가든힐이 풍족해질지도 모르지만,"
  },
  "110": {
   "jp": "a6316e1c0f",
   "kr": "시끄러워지는 것도 생각해 볼 일이지."
  },
  "111": {
   "jp": "a67b7b8beb",
   "kr": "나는 조용한 쪽이 좋아."
  },
  "112": {
   "jp": "dcf08e61b8",
   "kr": "아들은 명상할 때"
  },
  "113": {
   "jp": "19ac46c6f3",
   "kr": "이둔 님의 목소리를 들었다지만"
  },
  "114": {
   "jp": "bedd98c016",
   "kr": "정말일까."
  },
  "115": {
   "jp": "f68233d861",
   "kr": "나는 아들 같은 예언의 힘이 없으니"
  },
  "116": {
   "jp": "4c5411adc8",
   "kr": "그런 말을 들어도"
  },
  "117": {
   "jp": "2a54891646",
   "kr": "별로 와닿지 않네."
  },
  "118": {
   "jp": "cc07b7b9c7",
   "kr": "이 수로는"
  },
  "119": {
   "jp": "7e39dcdb31",
   "kr": "가든힐에 예로부터 전해지는 탁선에"
  },
  "120": {
   "jp": "aa2a3d00bb",
   "kr": "쓰는 거야."
  },
  "121": {
   "jp": "07bfed6d9a",
   "kr": "하지만 지금의 가든힐에서"
  },
  "122": {
   "jp": "5285052b77",
   "kr": "그 탁선을 할 수 있는 건"
  },
  "123": {
   "jp": "e0332fb590",
   "kr": "신전지기 레이트르뿐이지."
  },
  "124": {
   "jp": "3f2b51be78",
   "kr": "탁선 의식은 꽤 까다로워서"
  },
  "125": {
   "jp": "e5c7e7fcfb",
   "kr": "북쪽 신전터에서 기도하고 거기 수로에"
  },
  "126": {
   "jp": "62c0ff2330",
   "kr": "아무것도 안 쓴 종이를 흘려보낸다는군."
  },
  "127": {
   "jp": "b292ffb468",
   "kr": "그러면 흘려보낸 종이가"
  },
  "128": {
   "jp": "0b65cc07d6",
   "kr": "둥실둥실 떠내려와서"
  },
  "129": {
   "jp": "ebf52654ab",
   "kr": "이 근처 수로에 뜬다네."
  },
  "130": {
   "jp": "f26c909c7c",
   "kr": "종이를 주워서 보면"
  },
  "131": {
   "jp": "ab92ee9e76",
   "kr": "알고 싶던 내용이 탁선의 말로"
  },
  "132": {
   "jp": "b41d652571",
   "kr": "적혀 있다는 거지."
  },
  "133": {
   "jp": "843af211f1",
   "kr": "신기하지."
  },
  "134": {
   "jp": "083f2a73d3",
   "kr": "와, 놀랐네."
  },
  "135": {
   "jp": "f17e9b32bd",
   "kr": "정말로 떠내려온 탁선 종이를 본 건"
  },
  "136": {
   "jp": "b63182133b",
   "kr": "처음이야."
  },
  "137": {
   "jp": "d438e4f1cd",
   "kr": "탁선 흘리기의 비술은 관광객한테 인기 있을 것 같은데."
  },
  "138": {
   "jp": "48d46d5c3c",
   "kr": "요즘 북쪽 신전터에는 흉포한 마수가 나오니까"
  },
  "139": {
   "jp": "41dbf03caf",
   "kr": "안 가는 게 좋을 거예요."
  },
  "140": {
   "jp": "ce17144d7e",
   "kr": "정말로 이둔 님의 목소리가 들렸습니다."
  },
  "141": {
   "jp": "ec5cf54df1",
   "kr": "데레브라를 어빈 씨에게 맡기라고."
  },
  "142": {
   "jp": "29b045453e",
   "kr": "멀리서나마 당신의 활약을 빌겠습니다."
  },
  "143": {
   "jp": "939b4ca0e8",
   "kr": "여러분 덕분일까요."
  },
  "144": {
   "jp": "4def5a29af",
   "kr": "이 근처 마수들도 조용해진 모양입니다."
  },
  "145": {
   "jp": "42b308d74c",
   "kr": "작은 종이가 수로를 떠다니고 있다."
  },
  "146": {
   "jp": "7bd2347587",
   "kr": "어빈은 종이를 건져 올렸다."
  },
  "147": {
   "jp": "40017afd0d",
   "kr": "뭔가 적혀 있어."
  },
  "148": {
   "jp": "def1b137a4",
   "kr": "『명상을 깬 자는 내가 기다리던 사람이다."
  },
  "149": {
   "jp": "2b376ea1e5",
   "kr": "이 부적을 내 이마에 붙여"
  },
