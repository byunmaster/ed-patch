{
 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT01000H.BIN",
 "segments": {
  "0": {
   "jp": "8b9b69c5ca",
   "kr": "새끼 고양이 한 마리쯤은 제 발로 찾아."
  },
  "1": {
   "jp": "07c8ec1bc9",
   "kr": "집고양이는 마을 밖으로 안 나가거든."
  },
  "2": {
   "jp": "a3d308b4dd",
   "kr": "롱소드를 전하는 건 일도 아니잖아."
  },
  "3": {
   "jp": "cf01a4dadd",
   "kr": "얼른 해치워."
  },
  "4": {
   "jp": "53dbcf3efb",
   "kr": "짐 받을 곳을 모르게 되면",
   "auto": 1
  },
  "5": {
   "jp": "5b31d28b57",
   "kr": "구멍이 나도록 짐을 살펴봐.",
   "auto": 1
  },
  "6": {
   "jp": "2a5d6f42d6",
   "kr": "누구에게 전해야 하는지 생각날 테니까.",
   "auto": 1
  },
  "7": {
   "jp": "5a27646d5e",
   "kr": "그래, 10로제만 주면 좋은 정보가 있지.",
   "auto": 1
  },
  "8": {
   "jp": "fbcc966c41",
   "kr": "들을 마음 있어?"
  },
  "9": {
   "jp": "04fd9f45d0",
   "kr": "피트 동굴 입구는 절벽 건너편에 있어."
  },
  "10": {
   "jp": "cfe9fc8a9a",
   "kr": "공교롭게도 다리가 부서져서"
  },
  "11": {
   "jp": "e7ab8e0c0d",
   "kr": "걸어서 건너는 건 도저히 무리야."
  },
  "12": {
   "jp": "cadcafd983",
   "kr": "텔레포트를 쓸 수 있는 동료가 없으면"
  },
  "13": {
   "jp": "b37f3c5f81",
   "kr": "동굴 안에는 들어가지도 못할걸."
  },
  "14": {
   "jp": "63b5736271",
   "kr": "아저씨, 아저씨."
  },
  "15": {
   "jp": "178db7a034",
   "kr": "텔레포트라면 내 특기야!"
  },
  "16": {
   "jp": "539306a06a",
   "kr": "미래의 대마법사에게 불가능은 없다고!"
  },
  "17": {
   "jp": "ad6fff9db1",
   "kr": "아차, 실례했군.",
   "auto": 1
  },
  "18": {
   "jp": "faeea1a4b7",
   "kr": "그럼 정보료를 받을 수는 없겠어.",
   "auto": 1
  },
  "19": {
   "jp": "5f8ee3bb32",
   "kr": "미안하지만 이쪽도 장사라서.",
   "auto": 1
  },
  "20": {
   "jp": "3b853b94c4",
   "kr": "로제가 없는 녀석은 다음에 다시 와.",
   "auto": 1
  },
  "21": {
   "jp": "b897779e96",
   "kr": "정보료를 아끼다"
  },
  "22": {
   "jp": "199a0b47a8",
   "kr": "후회하지 않으면 좋겠군."
  },
  "23": {
   "jp": "ded1f16c2a",
   "kr": "그래, 200로제만 주면 좋은 정보가 있지."
  },
  "24": {
   "jp": "3ab1200b57",
   "kr": "들어 볼래?",
   "auto": 1
  },
  "25": {
   "jp": "b313bb4628",
   "kr": "실종된 아이 셋은 아주 친한 사이였어."
  },
  "26": {
   "jp": "a1eb3c1157",
   "kr": "시간만 나면 비밀 기지 만들기에"
  },
  "27": {
   "jp": "89897fcfb2",
   "kr": "빠져 있었던 모양이야."
  },
  "28": {
   "jp": "f6c15d9113",
   "kr": "그 비밀 기지로 고른 곳이 톨카스 동굴이야."
  },
  "29": {
   "jp": "32305294f2",
   "kr": "다만 요즘 그 동굴에 샴실단이"
  },
  "30": {
   "jp": "d6919ae142",
   "kr": "드나든다는 얘기도 들려."
  },
  "31": {
   "jp": "7322983a18",
   "kr": "샴실단은 무장 도적단이야."
  },
  "32": {
   "jp": "bbda883608",
   "kr": "싸울 각오로 가야 해."
  },
  "33": {
   "jp": "5f8ee3bb32",
   "kr": "미안하지만 이쪽도 장사라서.",
   "auto": 1
  },
  "34": {
   "jp": "3b853b94c4",
   "kr": "로제가 없는 녀석은 다음에 다시 와.",
   "auto": 1
  },
  "35": {
   "jp": "39db1e239e",
   "kr": "정보료를 아끼는 건"
  },
  "36": {
   "jp": "46f360b3db",
   "kr": "미끼 없이 낚시하는 것과 같아."
  },
  "37": {
   "jp": "d025bf209f",
   "kr": "가르시아 일을 맡았다며?"
  },
  "38": {
   "jp": "dabda20f56",
   "kr": "당신도 별난 사람이군."
  },
  "39": {
   "jp": "f1b10a7389",
   "kr": "가든힐 방면은 위험하니 조심해."
  },
  "40": {
   "jp": "9eaa69cde6",
   "kr": "하하하, 들었어, 들었다고."
  },
  "41": {
   "jp": "423d3a11c2",
   "kr": "그 전갈 공주한테 당했다며?"
  },
  "42": {
   "jp": "c8daef1a00",
   "kr": "어떻게 알았지."
  },
  "43": {
   "jp": "66b501fd09",
   "kr": "우리 정보상이 모르는 건 없어."
  },
  "44": {
   "jp": "fd3c13d1bf",
   "kr": "알고 싶지? 전갈 공주의 아지트."
  },
  "45": {
   "jp": "47f2856679",
   "kr": "특가 200로제에 알려 주지."
  },
  "46": {
   "jp": "1e8b1e9e26",
   "kr": "헤헤헤, 그래야지."
  },
  "47": {
   "jp": "a5a2d4ef29",
   "kr": "전갈 공주의 아지트는 스콜파 동굴이야."
  },
  "48": {
   "jp": "91dcb197cd",
   "kr": "덤으로 좋은 걸 알려 주지."
  },
  "49": {
   "jp": "d67a93d4e4",
   "kr": "동굴에 가기 전에 해독초를 듬뿍 준비해."
  },
  "50": {
   "jp": "fccb487a08",
   "kr": "전갈 공주는 독을 써서 전갈 공주라고 하는 거야."
  },
  "51": {
   "jp": "b2e3216b96",
   "kr": "꽤 미인이고"
  },
  "52": {
   "jp": "a5e2f15ffc",
   "kr": "두목 잔비야가 아끼는 여자지…"
  },
  "53": {
   "jp": "d7c89cda87",
   "kr": "여자라고 얕보지 마."
  },
  "54": {
   "jp": "4176023b92",
   "kr": "전갈 독은 조심해."
  },
  "55": {
   "jp": "5f8ee3bb32",
   "kr": "미안하지만 이쪽도 장사라서.",
   "auto": 1
  },
  "56": {
   "jp": "6becf90159",
   "kr": "로제 없는 녀석은 상대 안 해."
  },
  "57": {
   "jp": "05af1ded13",
   "kr": "나중에 후회하지 마."
  },
  "58": {
   "jp": "af47687e8a",
   "kr": "가든힐 근처에는 갈림길이 많아."
  },
  "59": {
   "jp": "415039df12",
   "kr": "이정표를 꼼꼼히 보는 게 좋아."
  },
  "60": {
   "jp": "ad2d71ae5b",
   "kr": "마을을 나설 때는 준비를 갖추고 가."
  },
  "61": {
   "jp": "980ddc3b81",
   "kr": "죽을 것 같다고"
  },
  "62": {
   "jp": "f5c5586b8a",
   "kr": "봐주는 마수는 없으니까."
  },
  "63": {
   "jp": "06825a06af",
   "kr": "지금으로선 쓸 만한 정보는 없군."
  },
  "64": {
   "jp": "eaae7e1c45",
   "kr": "또 들러."
  }
 }
}
