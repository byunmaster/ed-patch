 "segments": {
  "0": {
   "jp": "3d75a4ef62",
   "kr": "타오제"
  },
  "1": {
   "jp": "16a0ec4bd5",
   "kr": "눈부시네, 녹아 버릴 것 같아."
  },
  "2": {
   "jp": "649635eab0",
   "kr": "아아, 드디어 돌아갈 수 있군요."
  },
  "3": {
   "jp": "e6d865a5e9",
   "kr": "십 년인가… 길었구나."
  },
  "4": {
   "jp": "c3a10961eb",
   "kr": "저기, 물어봐도 돼?"
  },
  "5": {
   "jp": "bbe6341f7d",
   "kr": "무엇입니까?"
  },
  "6": {
   "jp": "9149bdda54",
   "kr": "신선이 되려고 십 년이나 수행했잖아."
  },
  "7": {
   "jp": "63498069b5",
   "kr": "부르러 온 우리가 말하기도 이상하지만,"
  },
  "8": {
   "jp": "701f872770",
   "kr": "마을로 돌아간다는 것도 이상하지 않아?"
  },
  "9": {
   "jp": "a4c3115074",
   "kr": "원래 신선이라 하면"
  },
  "10": {
   "jp": "beafc9743a",
   "kr": "세속의 얽매임에서 벗어나 살아가는 걸"
  },
  "11": {
   "jp": "87adbe4c57",
   "kr": "신조로 삼는 거잖아?"
  },
  "12": {
   "jp": "9b1c69046f",
   "kr": "뭐, 듣고 보니 그렇네요."
  },
  "13": {
   "jp": "6172e6abde",
   "kr": "루티스, 그만해."
  },
  "14": {
   "jp": "b2a813ac3b",
   "kr": "그런 말 했다가 안 돌아간다고 하면"
  },
  "15": {
   "jp": "f6cfbc6b09",
   "kr": "우리 일이 실패로 돌아가게 돼."
  },
  "16": {
   "jp": "ceff7120cc",
   "kr": "걱정 마세요."
  },
  "17": {
   "jp": "27ed7e7a70",
   "kr": "십 년이 지나면 돌아간다는 건"
  },
  "18": {
   "jp": "afea9c17b6",
   "kr": "첸트와의 약속이니까요."
  },
  "19": {
   "jp": "cfecda58b2",
   "kr": "지킬 겁니다."
  },
  "20": {
   "jp": "9ddc97bd8a",
   "kr": "설령 죽었더라도 말이죠."
  },
  "21": {
   "jp": "dd56a022dd",
   "kr": "어…?",
   "auto": 1
  },
  "22": {
   "jp": "375450585a",
   "kr": "그럼 죄송하지만,"
  },
  "23": {
   "jp": "8ef22b9ba7",
   "kr": "저를 세타까지 데려가 주세요."
  },
  "24": {
   "jp": "6252b7a24f",
   "kr": "잘 부탁드립니다."
  },
  "25": {
   "jp": "8ff4a6a0b1",
   "kr": "타오제의 몸이 사라지자 뼈 하나가 남았다."
  },
  "26": {
   "jp": "7ec2abeb44",
   "kr": "…?!"
  },
  "27": {
   "jp": "060ad2a315",
   "kr": "유, 유… 유령이었어?"
  },
  "28": {
   "jp": "fb196290bb",
   "kr": "대낮에, 그것도 햇볕 아래서?"
  },
  "29": {
   "jp": "b3efb99ef7",
   "kr": "…꿀꺽."
  },
  "30": {
   "jp": "6d1d22bffc",
   "kr": "역시 마수한테 습격당한 걸까."
  },
  "31": {
   "jp": "060f37961b",
   "kr": "단식을 너무 해서였는지도 몰라."
  },
  "32": {
   "jp": "4ef2235c4e",
   "kr": "물어봐 둘 걸 그랬네."
  },
  "33": {
   "jp": "c3f8c2f40e",
   "kr": "그래."
  },
  "34": {
   "jp": "7eabd93afc",
   "kr": "그것도 그렇지만, 죽었으면 죽었다고"
  },
  "35": {
   "jp": "734535e778",
   "kr": "처음부터 말해 줬으면 좋겠어."
  },
  "36": {
   "jp": "2f807bd3ae",
   "kr": "놀라게 하고 말이야."
  },
  "37": {
   "jp": "5d64f2e359",
   "kr": "아무튼,"
  },
  "38": {
   "jp": "0f0e5053df",
   "kr": "세타의 첸트한테까지 데려다주자."
  }
 }
}
