{
 "archive": "/D/SC300.DAT",
 "member": "..\\BIN\\DT00010.BIN",
 "segments": {
  "0": {
   "jp": "fa4eeeaa0d",
   "kr": "여관 안주인",
   "auto": 1
  },
  "1": {
   "jp": "991bcc2f6b",
   "kr": "가르시아",
   "auto": 1
  },
  "2": {
   "jp": "210dbbd67b",
   "kr": "제 진가는"
  },
  "3": {
   "jp": "cdfd21eb08",
   "kr": "떨어져 봐야 알게 되는 거예요."
  },
  "4": {
   "jp": "9ed1dcbc31",
   "kr": "물론 그때는 이미 늦겠지만요."
  },
  "5": {
   "jp": "5955f16d31",
   "kr": "언젠가 내가 필요한 날이 올지도 몰라.",
   "auto": 1
  },
  "6": {
   "jp": "3b38be5582",
   "kr": "그날을 위해 공부해 둘게."
  },
  "7": {
   "jp": "ca7729b5c4",
   "kr": "목숨을 건 싸움에서 앞일을 생각하지 마."
  },
  "8": {
   "jp": "ec81413e10",
   "kr": "그 자리를 살아남아야"
  },
  "9": {
   "jp": "16c75d7421",
   "kr": "앞으로 나아갈 수 있으니까."
  },
  "10": {
   "jp": "fd9ba16804",
   "kr": "항상 컨디션을 잘 유지하도록 조심하세요."
  },
  "11": {
   "jp": "4a17eaafed",
   "kr": "이별이라니 슬퍼요."
  },
  "12": {
   "jp": "97a9a6d4c6",
   "kr": "하지만 저, 열심히 할게요."
  },
  "13": {
   "jp": "6b14a0cb02",
   "kr": "전세를 잘 파악해서 효과적으로 싸우도록 해."
  },
  "14": {
   "jp": "fc495810f1",
   "kr": "싸움이 길어질수록 위험은 커지니까."
  },
  "15": {
   "jp": "60d972586b",
   "kr": "그만둬, 말려 봐야 소용없어.",
   "auto": 1
  },
  "16": {
   "jp": "e9ea822e6b",
   "kr": "따라오지 마.",
   "auto": 1
  },
  "17": {
   "jp": "10591ace30",
   "kr": "이 마을에는 등대가 있었지."
  },
  "18": {
   "jp": "507f54df62",
   "kr": "잠시 등대나 보고 있을까."
  },
  "19": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "20": {
   "jp": "a4f46c7154",
   "kr": "이별은 달콤한 슬픔.",
   "auto": 1
  },
  "21": {
   "jp": "0dbb3f0c91",
   "kr": "잠시 떨어져 지내는 것도 좋겠지요."
  },
  "22": {
   "jp": "4b59f66212",
   "kr": "내 힘이 필요할 때는",
   "auto": 1
  },
  "23": {
   "jp": "fc84a547dc",
   "kr": "찾아오너라.",
   "auto": 1
  },
  "24": {
   "jp": "3ead3740f4",
   "kr": "오오, 돌아왔구먼, 돌아왔구먼, 돌아왔구먼!"
  },
  "25": {
   "jp": "42bf3a213a",
   "kr": "내 상품이다, 내 상품이야!"
  },
  "26": {
   "jp": "a00122b913",
   "kr": "가르시아는 어빈에게서 상품을 낚아챘다."
  },
  "27": {
   "jp": "f78bfa3f65",
   "kr": "이거야, 이거야, 이거야."
  },
  "28": {
   "jp": "e5e403de7b",
   "kr": "내 상품에는 전부 상표가 붙어 있다네."
  },
  "29": {
   "jp": "c1be241de2",
   "kr": "이 『상품』 도장…"
  },
  "30": {
   "jp": "c883e8352d",
   "kr": "그건 그렇고 자네들, 이 자루를 열지 않았겠지?"
  },
  "31": {
   "jp": "a665d676d5",
   "kr": "열지 않았어."
  },
  "32": {
   "jp": "0387e51c09",
   "kr": "정말인가?"
  },
  "33": {
   "jp": "da86c402d3",
   "kr": "쬐끔이라도 들여다보진 않았나?"
  },
  "34": {
   "jp": "e0e8187717",
   "kr": "끈질긴 아저씨네."
  },
  "35": {
   "jp": "71344d161e",
   "kr": "안 열었다니까, 안 열었다고."
  },
  "36": {
   "jp": "dde77c4e52",
   "kr": "그럼 됐네."
  },
  "37": {
   "jp": "a281c9c58b",
   "kr": "아이고, 다행이다 다행이야."
  },
  "38": {
   "jp": "5aa4b140f8",
   "kr": "내 소중한 상품."
  },
  "39": {
   "jp": "83cfeeead6",
   "kr": "５４４６５로제하고도 ８로제짜리 상품. 룰루루룰."
  },
  "40": {
   "jp": "1e870bc17e",
   "kr": "자, 힘차게 장사다!"
  },
  "41": {
   "jp": "be822745f4",
   "kr": "오오, 왔다, 왔다, 왔다!"
  },
  "42": {
   "jp": "fce6ef5eaa",
   "kr": "알선소에서 일을 맡아 준 거겠지?"
  },
  "43": {
   "jp": "b2b365568c",
   "kr": "내 상품을 되찾아 주게."
  },
  "44": {
   "jp": "7750535212",
   "kr": "소중한, 소중한, 아주아주 소중한 상품이라네."
  },
  "45": {
   "jp": "bc0d4779cb",
   "kr": "그게 없으면 큰 손해일세."
  },
  "46": {
   "jp": "36931a658c",
   "kr": "５４４６５와 ８로제가 통째로 손해라니…!"
  },
  "47": {
   "jp": "cad61b48c5",
   "kr": "알았어, 알았다고, 아저씨."
  },
  "48": {
   "jp": "4e3c790f71",
   "kr": "그렇게 흥분하지 마."
  },
  "49": {
   "jp": "7c7d0eb895",
   "kr": "뭐든 좋으니까"
  },
  "50": {
   "jp": "d0a65e441b",
   "kr": "단서 같은 건 없어?"
  },
  "51": {
   "jp": "eaddb92497",
   "kr": "샴실단일세!!"
  },
  "52": {
   "jp": "72202f6d66",
   "kr": "샴실단에게 당했네!"
  },
  "53": {
   "jp": "6fbfad1653",
   "kr": "나는 짐이 도착하기를 여기서 기다리고 있었지."
  },
  "54": {
   "jp": "f15a42f55b",
   "kr": "그랬더니 운반꾼이 뻔뻔하게 도망쳐 와서는"
  },
  "55": {
   "jp": "1af2f2c8ad",
   "kr": "'샴실단에게 상품을 빼앗겼다'고 하지 뭔가…"
  },
  "56": {
   "jp": "b18dad7067",
   "kr": "자네들, 샴실단을 아나?"
  },
  "57": {
   "jp": "08fbc38d0e",
   "kr": "엘 필딘 곳곳에 퍼져 있는"
  },
  "58": {
   "jp": "46ecca63f1",
   "kr": "극악한 무리일세."
  },
  "59": {
   "jp": "d428b5f730",
   "kr": "나 같은 선량한 상인을 노린다네."
  },
  "60": {
   "jp": "04331c4080",
   "kr": "내 상품을 가져간 건"
  },
  "61": {
   "jp": "4757817c95",
   "kr": "바로아 은광산에 아지트를 튼 놈들인 모양일세."
  },
  "62": {
   "jp": "953c7c739c",
   "kr": "바로아 은광산?"
  },
  "63": {
   "jp": "3680835644",
   "kr": "폐광인 걸 틈타 눌러살고 있다네."
  },
  "64": {
   "jp": "bd8bbf837e",
   "kr": "…오오, 내 소중한 상품!"
  },
  "65": {
   "jp": "793ca8febd",
   "kr": "５４４６５와 ８로제의 상품."
  },
  "66": {
   "jp": "59893f6543",
   "kr": "조금만 흠이 나도 손해가 되네."
  },
  "67": {
   "jp": "d366db85e8",
   "kr": "자네들에게는 비싼 의뢰료를 낼 것이네."
  },
  "68": {
   "jp": "b08be2a2da",
   "kr": "내 소중한, 아주아주 소중한 상품을"
  },
  "69": {
   "jp": "f49c494420",
   "kr": "흠 내지 말고 되찾아 주게."
  },
  "70": {
   "jp": "ee06d36e59",
   "kr": "바로아 은광산은 이 마을 동쪽 산속일세."
  },
  "71": {
   "jp": "751f10c5bb",
   "kr": "어서 내 소중한 상품을 되찾아 주게."
  },
  "72": {
   "jp": "e5ff1c6202",
   "kr": "흐으음음…"
  },
  "73": {
   "jp": "f8218be101",
   "kr": "흐음음, 음으으…"
  },
  "74": {
   "jp": "ea048887a8",
   "kr": "손해일세, 이대로는 손해야, 음음음."
  },
  "75": {
   "jp": "b1dbeba066",
   "kr": "그건 그렇고 자네들,"
  },
  "76": {
   "jp": "880eb097b9",
   "kr": "이 자루를 열지 않았겠지?"
  },
  "77": {
   "jp": "7d8748c078",
   "kr": "『샴실단에게 상품을 빼앗겼다』"
  },
  "78": {
   "jp": "38df25cf59",
   "kr": "고 하지 뭔가…"
  }
 }
}
