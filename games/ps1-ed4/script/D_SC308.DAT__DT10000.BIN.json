{
 "archive": "/D/SC308.DAT",
 "member": "..\\BIN\\DT10000.BIN",
 "segments": {
  "0": {
   "jp": "4ab7037171",
   "kr": "선원 토머스"
  },
  "1": {
   "jp": "fe534985e4",
   "kr": "선원 폴"
  },
  "2": {
   "jp": "776125a118",
   "kr": "선원 한스"
  },
  "3": {
   "jp": "2ed033ba50",
   "kr": "매드람과의 싸움에 의문을 품은 미첼은"
  },
  "4": {
   "jp": "981640f7f1",
   "kr": "어빈과 매드람의 대결을 반쯤 억지로 막았다."
  },
  "5": {
   "jp": "ce62770827",
   "kr": "조류가 잔잔해졌다고 들었소."
  },
  "6": {
   "jp": "aacfb7f0f5",
   "kr": "섬까지 마중 나갈 생각이었는데, 설마"
  },
  "7": {
   "jp": "8bd93eea18",
   "kr": "그쪽에서 떠내려올 줄은 생각도 못 했소."
  },
  "8": {
   "jp": "222f1a22c4",
   "kr": "면목 없어요."
  },
  "9": {
   "jp": "73c0750ea2",
   "kr": "워낙 갑작스러운 일이라서요."
  },
  "10": {
   "jp": "6f2e4c02d8",
   "kr": "앞뒤 생각 않고 뛰어들고 말았어요."
  },
  "11": {
   "jp": "ca9470bc5c",
   "kr": "호랑가시나무 잎은?"
  },
  "12": {
   "jp": "b08e9130b9",
   "kr": "도크스에서 나눠 받아서"
  },
  "13": {
   "jp": "1f77b219c4",
   "kr": "진실의 섬에서 성스러운 물에 담갔어요."
  },
  "14": {
   "jp": "305ea1a407",
   "kr": "괜찮아요."
  },
  "15": {
   "jp": "6af99606e7",
   "kr": "다행이군."
  },
  "16": {
   "jp": "61d10887d2",
   "kr": "매드람이라는 살인청부업자에게는"
  },
  "17": {
   "jp": "81b723a401",
   "kr": "뭔가 특별한 사정이 있는 듯했어요."
  },
  "18": {
   "jp": "15acdbf425",
   "kr": "게다가…"
  },
  "19": {
   "jp": "6eb421cd4b",
   "kr": "…응?"
  },
  "20": {
   "jp": "9b9d91eeaf",
   "kr": "게다가…?"
  },
  "21": {
   "jp": "6de5b3d763",
   "kr": "매드람과 어빈은"
  },
  "22": {
   "jp": "d529b7c275",
   "kr": "조금 더 시간을 두고 만나는 편이"
  },
  "23": {
   "jp": "b2e8713277",
   "kr": "바람직하지 않을까 싶어요."
  },
  "24": {
   "jp": "6668c60038",
   "kr": "그대로 싸웠다면"
  },
  "25": {
   "jp": "0b67232f8d",
   "kr": "어느 한쪽이 죽었을 거예요."
  },
  "26": {
   "jp": "f1d07ada5e",
   "kr": "두 사람은 적대하고 있어요."
  },
  "27": {
   "jp": "ff66825f2a",
   "kr": "하지만… 공통된 슬픔을 지니고 있죠."
  },
  "28": {
   "jp": "7a031ac199",
   "kr": "조금 더 시간을 두면"
  },
  "29": {
   "jp": "fed067f93f",
   "kr": "무언가를 만들어 내는 긍정적인 관계로 변할 것"
  },
  "30": {
   "jp": "f6d56edf6e",
   "kr": "같았거든요."
  },
  "31": {
   "jp": "c012c12038",
   "kr": "음. 그럴지도 모르겠군."
  },
  "32": {
   "jp": "81ca1d4383",
   "kr": "긍정적인 관계로 변한다라…"
  },
  "33": {
   "jp": "815b993ca6",
   "kr": "어빈은 어릴 적부터"
  },
  "34": {
   "jp": "894f7b3ff4",
   "kr": "그런 희망을 품게 해 주는 아이였소."
  },
  "35": {
   "jp": "56893fa87b",
   "kr": "어빈과 아이멜이 있는 것만으로"
  },
  "36": {
   "jp": "9f94ab5df4",
   "kr": "카테드랄 사람들은 화목하게 지낼 수 있었지."
  },
  "37": {
   "jp": "5017bf4a15",
   "kr": "그렇기에 에스페리우스 님은"
  },
  "38": {
   "jp": "de769c97b6",
   "kr": "오크툼 신자들이 카테드랄을 습격했을 때"
  },
  "39": {
   "jp": "d4efc40705",
   "kr": "어빈 남매에게 신보를 맡기셨을 테지."
  },
  "40": {
   "jp": "2ecdb04dfa",
   "kr": "이제부터 정말로 길고 괴로운"
  },
  "41": {
   "jp": "73b0b792d9",
   "kr": "희망을 향한 그의 여정이 시작되는군요."
  },
  "42": {
   "jp": "44e1a0dfa4",
   "kr": "…아마도 그렇겠지."
  },
  "43": {
   "jp": "5ae375ae29",
   "kr": "정신이 들었습니까요?"
  },
  "44": {
   "jp": "68b0312637",
   "kr": "여기는?"
  },
  "45": {
   "jp": "e6ffefd072",
   "kr": "가웨인 님의 배입니다요."
  },
  "46": {
   "jp": "73d1994905",
   "kr": "발크드 근처 후미로 가는 중입죠."
  },
  "47": {
   "jp": "f5935466b2",
   "kr": "그나저나 운이 좋았습죠."
  },
  "48": {
   "jp": "c4373f0ae1",
   "kr": "보레듀스 해협에서 건져지다니"
  },
  "49": {
   "jp": "371258ad20",
   "kr": "거의 기적이라니까요."
  },
  "50": {
   "jp": "9c840ee9e2",
   "kr": "이제 의식은 또렷하시죠?"
  },
  "51": {
   "jp": "705d2979a2",
   "kr": "한동안 쉬시는 게 좋습니다요."
  },
  "52": {
   "jp": "b024117cb6",
   "kr": "오, 슬슬 후미가 보이는군."
  },
  "53": {
   "jp": "4dc4270cc5",
   "kr": "발크드에는 항구가 없으니"
  },
  "54": {
   "jp": "0c5adf0eb9",
   "kr": "최대한 가까운 해안에 배를 대도록 하지."
  },
  "55": {
   "jp": "fbc5c46b89",
   "kr": "금방 발크드로 돌아갈 수 있을 걸세."
  },
  "56": {
   "jp": "f1f7792bb4",
   "kr": "가웨인은 배를 발크드 근처 후미에 대었고"
  },
  "57": {
   "jp": "a56670177c",
   "kr": "어빈 일행은 신전으로 가는 길을 서둘렀다."
  },
  "58": {
   "jp": "8a0fa673cc",
   "kr": "돌아오는 길은 가웨인이 손써 둔 덕분에",
   "fix": 1
  },
  "59": {
   "jp": "df473aeee0",
   "kr": "별다른 문제도 일어나지 않아"
  },
  "60": {
   "jp": "6144e18e4e",
   "kr": "어빈, 미첼, 가웨인 세 사람은"
  },
  "61": {
   "jp": "235561cd0a",
   "kr": "무사히 발크드에 도착했다."
  },
  "62": {
   "jp": "efc9b26718",
   "kr": "이제 완전히 좋아진 모양이군."
  },
  "63": {
   "jp": "970f90d402",
   "kr": "수고했소."
  },
  "64": {
   "jp": "e3ce11a277",
   "kr": "이 배는 내 배일세."
  },
  "65": {
   "jp": "1284f47b0d",
   "kr": "후미에 닿을 때까지 마음 편히 쉬게나."
  },
  "66": {
   "jp": "86b949cd62",
   "kr": "가웨인 님의 배에 구조되다니요."
  },
  "67": {
   "jp": "e7197eee8d",
   "kr": "우리는 운이 좋네요."
  },
  "68": {
   "jp": "f973383890",
   "kr": "가웨인 씨한테 들었어."
  },
  "69": {
   "jp": "7fa9fb9875",
   "kr": "너, 꽤 하는 모양인데."
  },
  "70": {
   "jp": "1abe33b230",
   "kr": "나도 해낼 거야."
  },
  "71": {
   "jp": "76e6e2175e",
   "kr": "언젠가 일곱 바다를 누비는 선원이 되겠어."
  },
  "72": {
   "jp": "2614985339",
   "kr": "가가브를 넘어"
  },
  "73": {
   "jp": "db70975d60",
   "kr": "그 너머의 바다에도 노 저어 가 보이겠어."
  },
  "74": {
   "jp": "9deaa35ec2",
   "kr": "뭐, 배 위라면 맡겨 둬."
  },
  "75": {
   "jp": "da1131c1e5",
   "kr": "내가 타고 있는 한 이 배는 걱정 없어."
  },
  "76": {
   "jp": "3349f2b330",
   "kr": "바다는 좋구나."
  },
  "77": {
   "jp": "261cf59bd4",
   "kr": "바다는 좋아."
  },
  "78": {
   "jp": "b54e71675f",
   "kr": "그래서 선원이 된 거지만."
  },
  "79": {
   "jp": "338d061749",
   "kr": "역시 바다는 좋아."
  },
  "80": {
   "jp": "89160b4e08",
   "kr": "해적 소동도 가라앉은 것 같고"
  },
  "81": {
   "jp": "d69b19f673",
   "kr": "이제부터는 대항해 시대가 올 거야."
  },
  "82": {
   "jp": "02726143f9",
   "kr": "벌써 돌아다녀도 괜찮습니까요?"
  },
  "83": {
   "jp": "d8e06a6a54",
   "kr": "저는 이 장소가 배에서 제일 좋습죠."
  },
  "84": {
   "jp": "921cd8c15b",
   "kr": "진실의 섬에 다녀오셨습니까요?"
  },
  "85": {
   "jp": "48700fde97",
   "kr": "굉장하시군요."
  },
  "86": {
   "jp": "ac7448ba2a",
   "kr": "저희도 가 본 적이 없는데 말입죠."
  },
  "87": {
   "jp": "14b80bea03",
   "kr": "대단하십니다요."
  }
 }
}
