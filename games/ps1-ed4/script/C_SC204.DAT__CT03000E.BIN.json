{
 "archive": "/C/SC204.DAT",
 "member": "..\\BIN\\CT03000E.BIN",
 "segments": {
  "0": {
   "jp": "c35bba000b",
   "kr": "어이쿠?"
  },
  "1": {
   "jp": "657792e648",
   "kr": "자네들이 "
  },
  "2": {
   "jp": "6fa73ce335",
   "kr": "을(를)",
   "auto": 1
  },
  "3": {
   "jp": "82b3203165",
   "kr": "찾으러 가 주겠다는 건가."
  },
  "4": {
   "jp": "bbcd260af9",
   "kr": "네. 의뢰는 저희가 받았어요."
  },
  "5": {
   "jp": "a937cc27d5",
   "kr": "자세한 이야기를 들려주세요."
  },
  "6": {
   "jp": "a34d6da0c7",
   "kr": "정말로… 괜찮으려나?"
  },
  "7": {
   "jp": "434af5dabc",
   "kr": "이(가) 있다면"
  },
  "8": {
   "jp": "446e01e0ef",
   "kr": "마수가 있는 훨씬 안쪽이라는군."
  },
  "9": {
   "jp": "5d75043132",
   "kr": "솜씨에는 자신이 있겠지?"
  },
  "10": {
   "jp": "d49248a041",
   "kr": "의뢰를 받은 이상 마수와 한바탕 싸울 각오는 되어 있어."
  },
  "11": {
   "jp": "8461f26507",
   "kr": "호오, 믿음직하구먼."
  },
  "12": {
   "jp": "569574fbfe",
   "kr": "그럼 기대하며 기다리기로 할까."
  },
  "13": {
   "jp": "241df4e41c",
   "kr": "지금은 위험해서"
  },
  "14": {
   "jp": "7b57a23132",
   "kr": "광차가 안쪽까지 가지 않도록"
  },
  "15": {
   "jp": "1d2718257f",
   "kr": "막아 두었다고 하네만."
  },
  "16": {
   "jp": "8d6f62ac87",
   "kr": "내 의뢰라고 광차 담당 나콜에게 말하면"
  },
  "17": {
   "jp": "ee4c40bbc6",
   "kr": "특별히 광차를 쓰게 해 주도록"
  },
  "18": {
   "jp": "87c82a794f",
   "kr": "이야기는 해 놨네."
  },
  "19": {
   "jp": "ce6bc75c6f",
   "kr": "기아 광산에서 멋지게 "
  },
  "20": {
   "jp": "4cb75ad86a",
   "kr": "을(를) 가져와 주게."
  },
  "21": {
   "jp": "c216829645",
   "kr": "기대하며 기다리고 있겠네. 부탁하네."
  },
  "22": {
   "jp": "964a4a147a",
   "kr": "오오, 오오오오!"
  },
  "23": {
   "jp": "de5a62a4d0",
   "kr": "을(를) 찾아왔구먼!"
  },
  "24": {
   "jp": "f98136e344",
   "kr": "장하네, 어서 보여 주게."
  },
  "25": {
   "jp": "6557d7d0a6",
   "kr": "으음.",
   "auto": 1
  },
  "26": {
   "jp": "b4aefc1347",
   "kr": "이것이 "
  },
  "27": {
   "jp": "3caf3865f7",
   "kr": "인가."
  },
  "28": {
   "jp": "fdaf2709e5",
   "kr": "도리아 교수는 "
  },
  "29": {
   "jp": "f54081cf2f",
   "kr": "을(를) 조금 깎아 냈다."
  },
  "30": {
   "jp": "49d1614896",
   "kr": "연구 재료로는 이만큼이면 충분하네."
  },
  "31": {
   "jp": "98b9f18acf",
   "kr": "나머지는 자네들이 기념으로 가지고 있게."
  },
  "32": {
   "jp": "7a9e36af33",
   "kr": "기념으로라니…"
  },
  "33": {
   "jp": "0bff15827e",
   "kr": "괜찮을까, 어빈?"
  },
  "34": {
   "jp": "b3b029cc57",
   "kr": "괜찮지 않을까."
  },
  "35": {
   "jp": "c6068e79ae",
   "kr": "필요 없다고 하니까."
  },
  "36": {
   "jp": "47f3b9c67f",
   "kr": "그러게.",
   "auto": 1
  },
  "37": {
   "jp": "8a275052f9",
   "kr": "도리아 교수님, 알겠어요. "
  },
  "38": {
   "jp": "b9d3d73187",
   "kr": "은(는)"
  },
  "39": {
   "jp": "772352e1d2",
   "kr": "저희가 맡아 둘게요."
  },
  "40": {
   "jp": "89d398abc7",
   "kr": "필요해지면"
  },
  "41": {
   "jp": "512afa8456",
   "kr": "우리를 부르든 찾든 해 줘."
  },
  "42": {
   "jp": "26422b0286",
   "kr": "그때 가지고 있으면 돌려줄게."
  },
  "43": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "44": {
   "jp": "f8851237f7",
   "kr": "을(를) 받았다.",
   "auto": 1
  },
  "45": {
   "jp": "151336e071",
   "kr": "정말 수고했네."
  },
  "46": {
   "jp": "dabbc38e51",
   "kr": "보수를 알선소에서 받는 걸 잊지 말게나."
  },
  "47": {
   "jp": "2b224c99a9",
   "kr": "몸은 좀 어떤가?"
  },
  "48": {
   "jp": "67219d9cee",
   "kr": "기가 죽진 않았겠지?"
  },
  "49": {
   "jp": "aa2501a339",
   "kr": "이쪽에는 최고의 검이 있다네."
  },
  "50": {
   "jp": "843cbecd73",
   "kr": "자신을 갖고 힘차게 가게나."
  },
  "51": {
   "jp": "60627199aa",
   "kr": "레어메탈 소드가 완성된 모양이구먼."
  },
  "52": {
   "jp": "965f2fe649",
   "kr": "어서 받으러 가게나."
  },
  "53": {
   "jp": "d3b1bad629",
   "kr": "어떤 무기가 될지 기대되는군."
  },
  "54": {
   "jp": "63e138702d",
   "kr": "레어메탈 무기가 완성될지는"
  },
  "55": {
   "jp": "9efb05a5c4",
   "kr": "루카네의 분발에 달렸지."
  },
  "56": {
   "jp": "4078afcf24",
   "kr": "레어메탈의 경도와 내구성은 눈이 휘둥그레질 만하다."
  },
  "57": {
   "jp": "e6ae8a4c57",
   "kr": "무기나 방어구로 쓰면"
  },
  "58": {
   "jp": "54b260e3ff",
   "kr": "훌륭한 물건이 나올지도 모르겠군…"
  },
  "59": {
   "jp": "4324ca2d6b",
   "kr": "오랜만에 몸이 근질근질한 소재로구먼."
  },
  "60": {
   "jp": "6dddc7e233",
   "kr": "곧바로 분석을 시작해 보겠네."
  },
  "61": {
   "jp": "a73cdf8de3",
   "kr": "레어메탈의 경도와"
  },
  "62": {
   "jp": "d3658dd851",
   "kr": "내구성은 눈이 휘둥그레질 정도라네."
  }
 }
}
