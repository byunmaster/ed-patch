{
 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT01000E.BIN",
 "segments": {
  "0": {
   "jp": "80696711bc",
   "kr": "자자, 아가씨."
  },
  "1": {
   "jp": "3231ab94b4",
   "kr": "많이 먹으렴. 고생했지."
  },
  "2": {
   "jp": "dae31aedf9",
   "kr": "잘 먹겠습니다!"
  },
  "3": {
   "jp": "3ae7f5078a",
   "kr": "냠냠냠냠."
  },
  "4": {
   "jp": "87f5577a52",
   "kr": "맛있니?"
  },
  "5": {
   "jp": "e4ff35dd5e",
   "kr": "네!"
  },
  "6": {
   "jp": "7c660bb830",
   "kr": "냠냠, 정말…"
  },
  "7": {
   "jp": "bc739efcdf",
   "kr": "냠냠, 쩝쩝."
  },
  "8": {
   "jp": "ee01086eee",
   "kr": "…누가 그랬지?"
  },
  "9": {
   "jp": "a7c8d844b2",
   "kr": "위험할지도…라고 말한 사람."
  },
  "10": {
   "jp": "b135a35992",
   "kr": "나는 『치료하지 않으면 위험할지도』라고 했어."
  },
  "11": {
   "jp": "83ab3b6d2c",
   "kr": "배가 고팠던 것뿐이잖아."
  },
  "12": {
   "jp": "461c8ffdae",
   "kr": "그런 걸 그 자리에서 알 수 있을 리 없잖아."
  },
  "13": {
   "jp": "89855f0417",
   "kr": "섀넌은 마일을 쫓아온 거니까"
  },
  "14": {
   "jp": "f31a639a3b",
   "kr": "어떻게 좀 해 봐."
  },
  "15": {
   "jp": "a200199094",
   "kr": "그런～"
  },
  "16": {
   "jp": "4565d25e9f",
   "kr": "정말 신세 많이 졌소."
  },
  "17": {
   "jp": "0baf5b98c7",
   "kr": "마일 님이 와 주지 않았다면"
  },
  "18": {
   "jp": "80ebc2a59d",
   "kr": "섀넌은 지금쯤"
  },
  "19": {
   "jp": "a27cf9a1a8",
   "kr": "숲에서 차갑게 식어 있었을 거예요."
  },
  "20": {
   "jp": "f2b582e3ec",
   "kr": "아이고, 그런 무서운 소리 마라."
  },
  "21": {
   "jp": "e72dff3876",
   "kr": "죄송해요, 할머니."
  },
  "22": {
   "jp": "a57a2c2673",
   "kr": "하지만 괜찮아요."
  },
  "23": {
   "jp": "6b88a77c82",
   "kr": "섀넌에게는 운명의 여신님이"
  },
  "24": {
   "jp": "c52eca5149",
   "kr": "편을 들어 주고 있으니까요."
  },
  "25": {
   "jp": "acb34e0735",
   "kr": "섀넌이 위험할 때는 마일 님이 나타나요."
  },
  "26": {
   "jp": "7cfc401d3a",
   "kr": "물론 마일 님이 위험할 때는"
  },
  "27": {
   "jp": "8944e556dd",
   "kr": "이 섀넌이 달려갈게요."
  },
  "28": {
   "jp": "88cf7295b3",
   "kr": "됐다니까, 달려오지 않아도…"
  },
  "29": {
   "jp": "8fc9c636a8",
   "kr": "제 점은 잘 맞아요."
  },
  "30": {
   "jp": "dfa512a3af",
   "kr": "마일 님이 뉴보른을 지나시리란 것도"
  },
  "31": {
   "jp": "2c24fc5e26",
   "kr": "그 점으로 알았으니까요."
  },
  "32": {
   "jp": "967b748bb4",
   "kr": "이건 이제 운명이에요."
  },
  "33": {
   "jp": "ef67b42413",
   "kr": "놀랍군."
  },
  "34": {
   "jp": "16c022e674",
   "kr": "그럼 역시"
  },
  "35": {
   "jp": "82097df004",
   "kr": "섀넌이 있었던 건 우연이 아니라"
  },
  "36": {
   "jp": "7c4156e33a",
   "kr": "잠복이었던 건가."
  },
  "37": {
   "jp": "d06600e507",
   "kr": "그런… 점이라니."
  },
  "38": {
   "jp": "ae80dce834",
   "kr": "그만해, 그런 얘기."
  },
  "39": {
   "jp": "cc512cda3f",
   "kr": "애초에"
  },
  "40": {
   "jp": "18495f846c",
   "kr": "너랑은 가도에서 만난 정도의 안면밖에"
  },
  "41": {
   "jp": "5490ea1c8d",
   "kr": "없잖아."
  },
  "42": {
   "jp": "e3c0f4d371",
   "kr": "네, 한눈에 알았어요."
  },
  "43": {
   "jp": "b353f29cf5",
   "kr": "마일 님이 제게 소중한 분이라는 걸…"
  },
  "44": {
   "jp": "da3b692015",
   "kr": "정말, 말이 안 통하네…"
  },
  "45": {
   "jp": "d6002a8638",
   "kr": "여하튼"
  },
  "46": {
   "jp": "00e409f3ad",
   "kr": "아가씨가 무사해서 다행이구나."
  },
  "47": {
   "jp": "ed4e5ee8c6",
   "kr": "정말, 정말."
  },
  "48": {
   "jp": "aeeb6a4731",
   "kr": "쿨～… 쿨～…"
  },
  "49": {
   "jp": "ed43b243c8",
   "kr": "아, 잠들었네."
  },
  "50": {
   "jp": "7f5d74fa20",
   "kr": "앉은 채로 잠들어 버리다니"
  },
  "51": {
   "jp": "dcf330f546",
   "kr": "꽤 피곤했나 봐."
  },
  "52": {
   "jp": "cecfa7a16c",
   "kr": "이래서는 피로가 안 풀리겠네."
  },
  "53": {
   "jp": "ef6144ed92",
   "kr": "저기 침대에"
  },
  "54": {
   "jp": "5966ad9864",
   "kr": "데려다주시구먼."
  },
  "55": {
   "jp": "938bedc09b",
   "kr": "응, 그게 좋겠어."
  },
  "56": {
   "jp": "9b8da52667",
   "kr": "어…?"
  },
  "57": {
   "jp": "ead6ae5a47",
   "kr": "데려다줘."
  },
  "58": {
   "jp": "4b62d13d69",
   "kr": "내가?"
  },
  "59": {
   "jp": "48bc49602b",
   "kr": "둘이서 데려갈 필요는 없잖아."
  },
  "60": {
   "jp": "213fc2e646",
   "kr": "뭐, 그렇긴 한데…"
  },
  "61": {
   "jp": "010b23e85b",
   "kr": "알았어."
  }
 }
}
