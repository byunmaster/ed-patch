  },
  "3": {
   "jp": "f3dd24aebf",
   "kr": "폭주한 거야."
  },
  "4": {
   "jp": "932ec7733f",
   "kr": "둘가의 목소리"
  },
  "5": {
   "jp": "c83637a193",
   "kr": "오크툼이 그러했듯이…"
  },
  "6": {
   "jp": "1c288f7f9d",
