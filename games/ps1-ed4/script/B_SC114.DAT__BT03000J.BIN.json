 "segments": {
  "0": {
   "jp": "556d30fe2f",
   "kr": "너희, 모험가니?"
  },
  "1": {
   "jp": "169910630e",
   "kr": "내 아들은 '모험가가 되겠다'면서"
  },
  "2": {
   "jp": "271127b5ac",
   "kr": "나간 뒤로 돌아오질 않는단다."
  },
  "3": {
   "jp": "f4ac0e03aa",
   "kr": "어머, 나한테 무슨 볼일이니?"
  },
  "4": {
   "jp": "7acf0308d4",
   "kr": "안젤라 씨죠?"
  },
  "5": {
   "jp": "5218bfb1fe",
   "kr": "앤디 씨가 보낸 편지를 맡아 왔어요."
  },
  "6": {
   "jp": "7d637af0be",
   "kr": "앤디가 보냈다고?"
  },
  "7": {
   "jp": "39378f419b",
   "kr": "…싫어, 그런 편지."
  },
  "8": {
   "jp": "daebfc7e8a",
   "kr": "받을 수 없어."
  },
  "9": {
   "jp": "704ec2fced",
   "kr": "잠깐…",
   "auto": 1
  },
  "10": {
   "jp": "3ddf41c2c2",
   "kr": "그러시면 곤란해요. 저희도 일이라서요."
  },
  "11": {
   "jp": "0946a8d8fe",
   "kr": "알선소에서 맡은 거니?"
  },
  "12": {
   "jp": "385b3f6824",
   "kr": "…그럼 어쩔 수 없지."
  },
  "13": {
   "jp": "d20ef94073",
   "kr": "너희도 그 애에 대해"
  },
  "14": {
   "jp": "2619bf2f26",
   "kr": "아무것도 모르고 맡았을 테니까."
  },
  "15": {
   "jp": "df64f91118",
   "kr": "그 애는 '모험가가 되겠다'며 이 집을 나갔단다."
  },
  "16": {
   "jp": "106994ee20",
   "kr": "'세계 제일의 용사가 되겠다'니!"
  },
  "17": {
   "jp": "06250e3b35",
   "kr": "잠꼬대 같은 소리나 하고선!"
  },
  "18": {
   "jp": "027e0bcf29",
   "kr": "그런 애가 이제 와서 뭐라는 건지."
  },
  "19": {
   "jp": "8579f86421",
   "kr": "이제야 정신이 들어 밭이라도 일굴 마음이 생겼다면,"
  },
  "20": {
   "jp": "fa3fea3eac",
   "kr": "용서해 주지 못할 것도 없지만…"
  },
  "21": {
   "jp": "1641e51077",
   "kr": "어디, 그 편지를 보여 주렴."
  },
  "22": {
   "jp": "4932b9af2a",
   "kr": "어빈은 편지를 건넸다.",
   "auto": 1
  },
  "23": {
   "jp": "950388a6b6",
   "kr": "어디 보자…"
  },
  "24": {
   "jp": "ed341f97ba",
   "kr": "…",
   "auto": 1
  },
  "25": {
   "jp": "ed341f97ba",
   "kr": "…",
   "auto": 1
  },
  "26": {
   "jp": "db164180d2",
   "kr": "…아니, 이게 뭐니!!"
  },
  "27": {
   "jp": "a0036fc28a",
   "kr": "무슨 일이에요?"
  },
  "28": {
   "jp": "be643bd52c",
   "kr": "로제가 모자라서 곤란하다는구나."
  },
  "29": {
   "jp": "36c076f65f",
   "kr": "정말, 한심하구나."
  },
  "30": {
   "jp": "0cf05127b8",
   "kr": "큰소리치며 나간 주제에 말이야."
  },
  "31": {
   "jp": "2b8bca47f6",
   "kr": "칠칠치 못하기 짝이 없어."
  },
  "32": {
   "jp": "0e3780b0a1",
   "kr": "근성을 뜯어고쳐 줘야겠어!"
  },
  "33": {
   "jp": "01c473e67a",
   "kr": "잠깐 기다려 보렴…"
  },
  "34": {
   "jp": "238bd0d2e6",
   "kr": "안젤라는 편지에 뭔가 덧붙여 썼다."
  },
  "35": {
   "jp": "056dc8d1ab",
   "kr": "…좋아, 됐다."
  },
  "36": {
   "jp": "d09bedeca1",
   "kr": "이걸 그 애한테 전해 주겠지?"
  },
  "37": {
   "jp": "3033487a2a",
   "kr": "안젤라의 답장을 맡았다."
  },
  "38": {
   "jp": "b02d13052d",
   "kr": "너희한테도 폐를 끼쳐서 미안하구나."
  },
  "39": {
   "jp": "544b16ec67",
   "kr": "앤디한테는 꿀밤이라도 한 대 먹여 주렴."
  },
  "40": {
   "jp": "30c20f71b0",
   "kr": "내 전언이라고 하면서 말이야."
  },
  "41": {
   "jp": "44cda93e93",
   "kr": "그 애는 말이야,"
  },
  "42": {
   "jp": "66d2c3f07c",
   "kr": "'모험가가 되겠다'면서 이 집을 나갔단다."
  },
  "43": {
   "jp": "12f9cf1522",
   "kr": "이제야 정신이 들어서"
  },
  "44": {
   "jp": "f22b2404d3",
   "kr": "밭이라도 일굴 마음이 생겼다면,"
  },
  "45": {
   "jp": "371facefc8",
   "kr": "앤디한테는"
  },
  "46": {
   "jp": "0366891042",
   "kr": "꿀밤이라도 한 대 먹여 주렴."
  }
 }
