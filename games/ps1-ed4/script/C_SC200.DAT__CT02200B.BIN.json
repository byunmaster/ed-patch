{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02200B.BIN",
 "segments": {
  "0": {
   "jp": "91f66f6daf",
   "kr": "그럼 바로 시작해 볼까요."
  },
  "1": {
   "jp": "80f59fc433",
   "kr": "지금부터 제가 몇 가지 질문을 할게요."
  },
  "2": {
   "jp": "879d33793a",
   "kr": "『네』나 『아니요』로 대답해 주세요."
  },
  "3": {
   "jp": "082b24f715",
   "kr": "당신의 대답을 종합적으로 분석하는 거예요."
  },
  "4": {
   "jp": "a20c221e48",
   "kr": "성격 판단을 해서 운세를 봐 드릴게요."
  },
  "5": {
   "jp": "f2c4b7a51f",
   "kr": "잘 맞아요."
  },
  "6": {
   "jp": "eee084385a",
   "kr": "제１문"
  },
  "7": {
   "jp": "206020f1f3",
   "kr": "직감을 믿고 행동하는 편이다."
  },
  "8": {
   "jp": "75d039888b",
   "kr": "제２문"
  },
  "9": {
   "jp": "bb8a24f229",
   "kr": "어쩔 수 없다고 생각해도 용서할 수 없을 때가 있다."
  },
  "10": {
   "jp": "07bfda7728",
   "kr": "제３문"
  },
  "11": {
   "jp": "a70a26a806",
   "kr": "생선보다 고기가 좋다."
  },
  "12": {
   "jp": "cdc6b936fd",
   "kr": "제４문"
  },
  "13": {
   "jp": "cd91663416",
   "kr": "부탁받지도 않았는데"
  },
  "14": {
   "jp": "b73c436dfd",
   "kr": "남을 위해 애쓰는 일이 있다."
  },
  "15": {
   "jp": "5341ea2ba5",
   "kr": "제５문"
  },
  "16": {
   "jp": "2cb25de843",
   "kr": "약속 시간은 반드시 지킨다."
  },
  "17": {
   "jp": "f1d88ebdb7",
   "kr": "제６문"
  },
  "18": {
   "jp": "719a75e684",
   "kr": "노을을 보면 눈물이 난다."
  },
  "19": {
   "jp": "caba16cc87",
   "kr": "제７문"
  },
  "20": {
   "jp": "3155c0ba0d",
   "kr": "계획을 세우는 데 능하다."
  },
  "21": {
   "jp": "2ad880e73e",
   "kr": "제８문"
  },
  "22": {
   "jp": "d8d5e181eb",
   "kr": "배신당했을 때"
  },
  "23": {
   "jp": "c249fadde5",
   "kr": "분노보다 슬픔이 더 크다."
  },
  "24": {
   "jp": "07bba68b10",
   "kr": "제９문"
  },
  "25": {
   "jp": "4467f7d1d0",
   "kr": "남에게 말 못 할 비밀을 ２개 이상 가지고 있다."
  },
  "26": {
   "jp": "77a7338464",
   "kr": "마지막 문제예요."
  },
  "27": {
   "jp": "fc180c53d9",
   "kr": "나 자신을 믿을 수 있다."
  },
  "28": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "29": {
   "jp": "41f03b2cab",
   "kr": "질문은 이걸로 끝이에요."
  },
  "30": {
   "jp": "8cc57f14ef",
   "kr": "음, 성격 판단 결과는…"
  },
  "31": {
   "jp": "27238da738",
   "kr": "………팡! 팡!"
  },
  "32": {
   "jp": "fb593683af",
   "kr": "감이 좋고,"
  },
  "33": {
   "jp": "d4251fc682",
   "kr": "신중하고,"
  },
  "34": {
   "jp": "3932842800",
   "kr": "자신에게도 엄격한"
  },
  "35": {
   "jp": "df160b6a54",
   "kr": "상냥한"
  },
  "36": {
   "jp": "dc903c8c27",
   "kr": "당신은"
  },
  "37": {
   "jp": "a7f799f738",
   "kr": "성미가 급하고,"
  },
  "38": {
   "jp": "e4c59e6f4f",
   "kr": "감정을 겉으로 드러내지 않고,"
  },
  "39": {
   "jp": "be255c461f",
   "kr": "착하기만 하고,"
  },
  "40": {
   "jp": "5c737712ac",
   "kr": "계산이 빠르고,"
  },
  "41": {
   "jp": "15af26a438",
   "kr": "고지식한"
  },
  "42": {
   "jp": "5e9b1779c0",
   "kr": "느긋한"
  },
  "43": {
   "jp": "fd91e526df",
   "kr": "성격이에요."
  },
  "44": {
   "jp": "f8da1b8245",
   "kr": "감정적이 되지 않도록"
  },
  "45": {
   "jp": "6c1b5b5423",
   "kr": "감동을 소중히"
  },
  "46": {
   "jp": "2b10410e21",
   "kr": "착실하게 도전해"
  },
  "47": {
   "jp": "d279ebe287",
   "kr": "긍정적으로 도전해"
  },
  "48": {
   "jp": "45ecc3da96",
   "kr": "나가면"
  },
  "49": {
   "jp": "a262495c40",
   "kr": "분명"
  },
  "50": {
   "jp": "d1386999ab",
   "kr": "슬픈 결과로 끝나지는 않을 거예요."
  },
  "51": {
   "jp": "da3bd9ade8",
   "kr": "성의는 전해져요."
  },
  "52": {
   "jp": "10951b5c00",
   "kr": "항상 상대를 아끼고,"
  },
  "53": {
   "jp": "a264604f53",
   "kr": "언제나 정직한 마음으로,"
  },
  "54": {
   "jp": "04b0856c61",
   "kr": "일을 대하면"
  },
  "55": {
   "jp": "f07b79bf13",
   "kr": "진실이 보일 거예요."
  },
  "56": {
   "jp": "9d8a3f51cd",
   "kr": "바라는 것은 반드시 이루어질 거예요."
  },
  "57": {
   "jp": "0a07bb725c",
   "kr": "어떠세요? 이런 결과예요."
  },
  "58": {
   "jp": "f3deef9f3a",
   "kr": "어차피 성격 판단 테스트이니"
  },
  "59": {
   "jp": "09aeb16ba4",
   "kr": "너무 신경 쓰지 말고 참고 정도로 받아들여"
  },
  "60": {
   "jp": "9d9d7b5fc3",
   "kr": "주시면 됩니다."
  },
  "61": {
   "jp": "02c5ed040d",
   "kr": "감사합니다."
  }
 }
}
