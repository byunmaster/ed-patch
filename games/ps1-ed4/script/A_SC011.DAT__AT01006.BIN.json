 "segments": {
  "0": {
   "jp": "50b5b3aefd",
   "kr": "레뮤라스",
   "auto": 1
  },
  "1": {
   "jp": "6f32f7d981",
   "kr": "일은 끝난 모양이구나."
  },
  "2": {
   "jp": "ceb2f017b5",
   "kr": "마일도 도와줘서 고맙구나."
  },
  "3": {
   "jp": "d6734f1ac9",
   "kr": "그렇지,"
  },
  "4": {
   "jp": "016312cab2",
   "kr": "너희에게 마법의 기초 지식이라도 가르쳐 주마."
  },
  "5": {
   "jp": "e3a85a5a75",
   "kr": "…마법?"
  },
  "6": {
   "jp": "682b72a286",
   "kr": "지금까지 한 번도 마법을"
  },
  "7": {
   "jp": "28688246b3",
   "kr": "가르쳐 주려 하지 않았으면서"
  },
  "8": {
   "jp": "18986a7bca",
   "kr": "무슨 바람이 분 거야."
  },
  "9": {
   "jp": "d46db96bc9",
   "kr": "오늘은 몸 상태가 좋아서 말이오."
  },
  "10": {
   "jp": "369df1d538",
   "kr": "게다가 이제 너희라면"
  },
  "11": {
   "jp": "2b4786ca59",
   "kr": "마법의 힘을 알아도 힘에 빠지는 일은 없을 테니."
  },
  "12": {
   "jp": "9edd8b4e52",
   "kr": "마법을 쓸 수 있게 되나요?"
  },
  "13": {
   "jp": "21a27814a2",
   "kr": "하하하…"
  },
  "14": {
   "jp": "b7c275a393",
   "kr": "그렇게 쉽게는 안 될 거요만."
  },
  "15": {
   "jp": "f7478be8e4",
   "kr": "나는 기초만 가르칠 뿐이오."
  },
  "16": {
   "jp": "f0b249bdcb",
   "kr": "쓸 수 있느냐는 앞으로의 노력에 달렸지."
  },
  "17": {
   "jp": "bd38118fe9",
   "kr": "필딘의 삼현자라고 불리는"
  },
  "18": {
   "jp": "1c75df23f8",
   "kr": "레뮤라스 할아버지께"
  },
  "19": {
   "jp": "9653e36408",
   "kr": "마법을 배울 수 있다니…"
  },
  "20": {
   "jp": "702b53a871",
   "kr": "감격이야."
  },
  "21": {
   "jp": "e506a03ab8",
   "kr": "그럼, 곧바로 시작해 볼까."
  },
  "22": {
   "jp": "f368fa74c4",
   "kr": "어빈과 마일은 조용히 고개를 숙였다."
  },
  "23": {
   "jp": "33de81828f",
   "kr": "자,"
  },
  "24": {
   "jp": "d157771654",
   "kr": "이 세계의 마법은 크게 나누면 세 종류가 있소."
  },
  "25": {
   "jp": "0853f1727d",
   "kr": "공격계의 흑마법."
  },
  "26": {
   "jp": "de20b81f73",
   "kr": "회복계의 백마법."
  },
  "27": {
   "jp": "87b5597ec3",
   "kr": "정령을 소환하는 정령 마법."
  },
  "28": {
   "jp": "527ab43df5",
   "kr": "각각 다른 능력이 필요하기 때문에"
  },
  "29": {
   "jp": "8b139f0f9d",
   "kr": "익힐 수 있는 것은"
  },
  "30": {
   "jp": "5bdc3025ee",
   "kr": "셋 중 하나로 한정된다오."
  },
  "31": {
   "jp": "d028121d19",
   "kr": "그럼 먼저 마일."
  },
  "32": {
   "jp": "0b168aa6a7",
   "kr": "마일은 어떤 마법을 공부해 보고 싶으냐?"
  },
  "33": {
   "jp": "dd81e5226d",
   "kr": "저는… 글쎄요."
  },
  "34": {
   "jp": "1e78da47bb",
   "kr": "역시 백마법이에요."
  },
  "35": {
   "jp": "f68998d05e",
   "kr": "여차할 때 회복하지 못하면 괴로우니까요."
  },
  "36": {
   "jp": "57db1dcd4d",
   "kr": "좋다."
  },
  "37": {
   "jp": "40f2f85356",
   "kr": "어빈은 어떤 마법을 공부해 보고 싶으냐?"
  },
  "38": {
   "jp": "476d3b4db7",
   "kr": "흑마법"
  },
  "39": {
   "jp": "421b672e35",
