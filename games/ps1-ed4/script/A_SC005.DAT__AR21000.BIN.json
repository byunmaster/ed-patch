  },
  "8": {
   "jp": "e3a4e07756",
   "kr": "케이트"
  },
  "9": {
   "jp": "c5711e354f",
   "kr": "얀크"
  },
  "10": {
   "jp": "649f5aeb73",
   "kr": "고문서를 되찾으러 온 놈들이냐?"
  },
  "11": {
   "jp": "cdfdd7e5d5",
   "kr": "얌전히 통과시켜 줬다간"
  },
  "12": {
   "jp": "f43e0af3d4",
   "kr": "샴실단 이름에 먹칠하는 거다."
  },
  "13": {
   "jp": "d932f38da5",
   "kr": "해치워라!"
  },
  "14": {
   "jp": "b8378b2cc5",
   "kr": "겁도 없이 되돌아왔군."
  },
  "15": {
   "jp": "0eef721232",
   "kr": "어지간히 죽고 싶은 모양이야."
  },
  "16": {
   "jp": "d932f38da5",
   "kr": "해치워라!"
  },
  "17": {
   "jp": "eb757b6ed3",
   "kr": "여긴 너희 같은 놈들이 올 데가 아니야."
  },
  "18": {
   "jp": "3d74ed0cd6",
   "kr": "얌전히 돌아가."
  },
  "19": {
   "jp": "7b1b820d70",
   "kr": "알선소의 개들이 나타났구나."
  },
  "20": {
   "jp": "753b20c36b",
   "kr": "망보던 놈들은 뭘 한 거야!"
  },
  "21": {
   "jp": "cd0d1f83ff",
   "kr": "신참!"
  },
  "22": {
   "jp": "f3103450a7",
   "kr": "보물상자 똑바로 지켜!"
  },
  "23": {
   "jp": "ff581e7627",
   "kr": "네, 네!"
  },
  "24": {
   "jp": "bf4b3d214b",
   "kr": "얘들아, 이놈들을 살려서 돌려보내지 마라!"
  },
  "25": {
   "jp": "b9caa2a4fd",
   "kr": "끈질긴 놈들이군."
  },
  "26": {
   "jp": "bf4b3d214b",
   "kr": "얘들아, 이놈들을 살려서 돌려보내지 마라!"
  },
  "27": {
   "jp": "753ce395d1",
   "kr": "이, 이 보물상자에는 손가락 하나 못 대게 할 거야."
  },
  "28": {
   "jp": "d6718a53b7",
   "kr": "고문서는 왕성에서 도난당한 물건이다."
  },
  "29": {
   "jp": "628e5881d9",
   "kr": "나는 그것을 되찾아야 한다."
  },
  "30": {
   "jp": "44b10de82a",
   "kr": "방해하면 알선소로 연행하겠다."
  },
  "31": {
   "jp": "7fb0054a00",
   "kr": "워스!"
  },
  "32": {
   "jp": "1729c28f1c",
   "kr": "…로웨이."
  },
  "33": {
   "jp": "e200e03a3b",
   "kr": "어째서 샴실단 같은 데에…"
  },
  "34": {
   "jp": "45509450a9",
   "kr": "나한테는 상관하지 마!"
  },
  "35": {
   "jp": "8a777f19bc",
   "kr": "우리 쪽 젊은 애가 멋대로 굴어서 미안하다."
  },
  "36": {
   "jp": "75088a890a",
   "kr": "워스는 그 녀석 친구라서 말이야."
  },
  "37": {
   "jp": "af3ba1ec17",
   "kr": "그런데 도적단에 들어갔다는 얘기를 듣고"
  },
  "38": {
   "jp": "6ef20ce4b0",
   "kr": "정신없이 달려온 거지."
  },
  "39": {
   "jp": "f0fdb70052",
   "kr": "우리도 동료로서 내버려 둘 수가 없어서 말이야."
  },
  "40": {
   "jp": "19b3d78796",
   "kr": "워스를 잡지 않아도"
  },
  "41": {
   "jp": "e8b7b8231c",
   "kr": "너희 일에 지장은 없나?"
  },
  "42": {
   "jp": "c3f8c2f40e",
   "kr": "그래."
  },
  "43": {
   "jp": "d33b3d1b17",
   "kr": "고문서만 가져가면 문제없어."
  },
  "44": {
   "jp": "9853bd6cd4",
   "kr": "그렇다면 눈감아 줘."
  },
  "45": {
   "jp": "9098390938",
   "kr": "사가."
  },
  "46": {
   "jp": "ccb474488d",
   "kr": "우리도 로웨이를 쫓아가자."
  },
  "47": {
   "jp": "e3511831f0",
   "kr": "그러자."
  },
  "48": {
   "jp": "dfb9783a1c",
   "kr": "무슨 짓을 저지를지 모르니까."
  },
  "49": {
   "jp": "fcbcee33bb",
   "kr": "그럼 실례했다."
  },
  "50": {
   "jp": "27c7568dee",
   "kr": "오늘은 신세 진 걸로 해 줘."
  },
  "51": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "52": {
   "jp": "415f49326f",
   "kr": "을(를) 입수했다."
  },
  "53": {
   "jp": "a737e81164",
   "kr": "이걸 알선소에 가져가면"
  },
  "54": {
   "jp": "524d372594",
   "kr": "의뢰 완료다."
  },
  "55": {
   "jp": "889ceea3f2",
   "kr": "보물상자에는 "
  },
  "56": {
   "jp": "665e4d5705",
   "kr": "이(가) 들어 있다.",
   "auto": 1
  },
  "57": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "58": {
   "jp": "f5fc3dee34",
   "kr": "을(를) 포기했다.",
   "auto": 1
  },
  "59": {
   "jp": "f99ec25289",
   "kr": "보물상자 안에는 아무것도 없다."
  },
  "60": {
   "jp": "ad775f48e8",
   "kr": "이 자식,"
  },
  "61": {
   "jp": "e988326fe9",
   "kr": "여기가 샴실단의 아지트인 줄 알고 왔냐?"
  },
  "62": {
   "jp": "7477897dbc",
   "kr": "너희랑 싸우자는 게 아니야."
  },
  "63": {
   "jp": "e29b3f2628",
   "kr": "릭이라는 남자아이를 찾고 있어."
  },
  "64": {
   "jp": "e39a3436fc",
   "kr": "꼬맹이를 찾으러 왔다고?"
  },
  "65": {
   "jp": "8c267ca1c1",
   "kr": "알고 보니 네놈들, 알선소에서 왔구나?"
  },
  "66": {
   "jp": "a25e4459c5",
   "kr": "이대로 돌려보낼 수는 없지!!"
  },
  "67": {
   "jp": "b8378b2cc5",
   "kr": "겁도 없이 되돌아왔군."
  },
  "68": {
   "jp": "409ecd3cb4",
   "kr": "어지간히 죽고 싶은 모양이구나!"
  },
  "69": {
   "jp": "ad775f48e8",
   "kr": "이 자식,"
  },
  "70": {
   "jp": "e988326fe9",
   "kr": "여기가 샴실단의 아지트인 줄 알고 왔냐?"
  },
  "71": {
   "jp": "0200c324d3",
   "kr": "썩 꺼져!!"
  },
  "72": {
   "jp": "2432be5ff2",
   "kr": "아이 목소리"
  },
  "73": {
   "jp": "ce5e8788b9",
   "kr": "뭐 하는 거야, 놔!"
  },
  "74": {
   "jp": "f57fe47be3",
   "kr": "어?",
   "auto": 1
  },
  "75": {
   "jp": "bf9fa63940",
   "kr": "아이 목소리인가?"
  },
  "76": {
   "jp": "fd3e1900ff",
   "kr": "릭이야!"
  },
  "77": {
   "jp": "06129697e9",
   "kr": "안쪽이야, 서두르자!!"
  },
  "78": {
   "jp": "84e07eca1d",
   "kr": "이 망할 꼬맹이!"
  },
  "79": {
   "jp": "4c3e4fd54f",
   "kr": "도둑한테서 도둑질하려 들다니,"
  },
  "80": {
   "jp": "06d57eb98e",
   "kr": "뻔뻔한 놈이로군!"
  },
  "81": {
   "jp": "31bf215219",
   "kr": "멈춰라!"
  },
  "82": {
   "jp": "3023ad2f0e",
   "kr": "뭐, 뭐야, 네놈들은!"
  },
  "83": {
   "jp": "e67aa40647",
   "kr": "아야!!"
  },
  "84": {
   "jp": "6e573507de",
   "kr": "물었어!?"
  },
  "85": {
   "jp": "8fb854a41f",
   "kr": "약 오르지? 잡을 수 있으면 잡아 봐!"
  },
  "86": {
   "jp": "8e568fc96a",
   "kr": "이 망할 꼬맹이들!"
  },
  "87": {
   "jp": "3add2467e6",
   "kr": "샴실단의 무서움을 보여 주마!!"
  },
  "88": {
   "jp": "93d0fda9b4",
   "kr": "대단해, 형들!"
  },
  "89": {
   "jp": "69f7c4a331",
   "kr": "꽤 하는데."
  },
  "90": {
   "jp": "67c73e067c",
   "kr": "고마워.",
   "auto": 1
  },
  "91": {
   "jp": "424b8aaa71",
   "kr": "꼬마야말로 아주 난장판을 쳤더군."
  },
  "92": {
   "jp": "f79be09ca0",
   "kr": "엄마가 걱정하고 있다고."
  },
  "93": {
   "jp": "c7e4e282ea",
   "kr": "아, 목걸이라면 걱정할 것 없어."
  },
  "94": {
   "jp": "f54180471c",
   "kr": "이렇게 되찾아 왔으니까."
  },
  "95": {
   "jp": "74f1039819",
   "kr": "목걸이를 되찾았다고!?"
  },
  "96": {
   "jp": "004eac10a5",
   "kr": "뭐, 나한테 걸리면 이쯤은 식은 죽 먹기지."
  },
  "97": {
   "jp": "4a15c38038",
   "kr": "굼벵이 도둑들 눈을 피해 슬쩍했지."
  },
  "98": {
   "jp": "1dd08d9cb4",
   "kr": "어이없는 꼬마로군!"
  },
  "99": {
   "jp": "538849f245",
   "kr": "나보다 강한 거 아냐…?"
  },
  "100": {
   "jp": "096fc717b3",
   "kr": "무슨 소리야! 어쩌다 운이 좋았을 뿐이야!"
  },
  "101": {
   "jp": "a2b4a9b272",
   "kr": "얼른 데려가자."
  },
  "102": {
   "jp": "7f96ac5149",
   "kr": "마리카 씨가 걱정하고 계시니까!"
  },
  "103": {
   "jp": "effc29af23",
   "kr": "으앙～ 살려 줘요, 얀크 아저씨…!!"
  },
  "104": {
   "jp": "03028e48f7",
   "kr": "케이트!"
  },
  "105": {
   "jp": "f5364ab022",
   "kr": "아, 어빈 오빠!"
  },
  "106": {
   "jp": "da33cabecf",
   "kr": "케이트를 구하러 와 준 거예요?"
  },
  "107": {
   "jp": "464a5b215e",
   "kr": "움직이지 마!"
  },
  "108": {
   "jp": "d970f55aa3",
   "kr": "잠깐만 참으면 돼!!"
  },
  "109": {
   "jp": "70d30a3390",
   "kr": "앙, 어빈 오빠아…"
  },
  "110": {
   "jp": "438c994d72",
   "kr": "이제 괜찮아."
  },
  "111": {
   "jp": "205cd4edaa",
   "kr": "으앙～ 무서웠어～"
  },
  "112": {
   "jp": "b222f5eff9",
   "kr": "집에 가고 싶어～"
  },
  "113": {
   "jp": "d9183b23aa",
   "kr": "얀크 아저씨이～!!"
  },
  "114": {
   "jp": "e892e9cd38",
   "kr": "케이트!!"
  },
  "115": {
   "jp": "a40cbd6d61",
   "kr": "아저씨!?"
  },
  "116": {
   "jp": "4c70a90b82",
   "kr": "이제 괜찮다."
  },
  "117": {
   "jp": "b87c432861",
   "kr": "마수가 나와도 삼촌이 해치워 줄 테니까!"
  },
  "118": {
   "jp": "0c2b04c221",
   "kr": "…풋."
  },
  "119": {
   "jp": "b3c451e656",
   "kr": "아이참, 삼촌도."
  },
  "120": {
   "jp": "85fed2c0e7",
   "kr": "공사라도 할 생각이야?"
  },
  "121": {
   "jp": "e8839a57c8",
   "kr": "뭐 어때."
  },
  "122": {
   "jp": "b28adeeb6e",
   "kr": "이래 봬도 널 구하러 온 거라고!"
  },
  "123": {
   "jp": "a477c3442e",
   "kr": "어빈 씨네한테만"
  },
  "124": {
   "jp": "e08c5a7b60",
   "kr": "맡겨 둘 수는 없다고 생각해서…"
  },
  "125": {
   "jp": "86f05ac67a",
   "kr": "아아."
  },
  "126": {
   "jp": "036cf0d152",
   "kr": "어빈 씨와는 딴판이네."
  },
  "127": {
   "jp": "7d5d83919b",
   "kr": "꼴사나워."
  },
  "128": {
   "jp": "df60c3bc42",
   "kr": "뭐라고?"
  },
  "129": {
   "jp": "321398f1b8",
   "kr": "어빈 씨, 정말 고마워요."
  },
  "130": {
   "jp": "173fa791f6",
   "kr": "케이트, 이제 삼촌이랑 안 싸울래요."
  },
  "131": {
   "jp": "91eadd7f9a",
   "kr": "이런 꼴을 보니"
  },
  "132": {
   "jp": "3b1c6c0404",
   "kr": "화낼 기분이 없어졌어요."
  },
  "133": {
   "jp": "07e8fabdd7",
   "kr": "따분한 삼촌이지만 불쌍하니까"
  },
  "134": {
   "jp": "e5ba794797",
   "kr": "상대해 주기로 했어요."
  },
  "135": {
   "jp": "ba0791e877",
   "kr": "쳇."
  },
  "136": {
   "jp": "323e0ca709",
   "kr": "어째서 이렇게 건방진 거냐…"
  },
  "137": {
   "jp": "5a1a8a9c0d",
   "kr": "자, 삼촌, 돌아가요."
  },
  "138": {
   "jp": "ae0859fed0",
   "kr": "이 이상 어빈 씨네한테 폐 끼치면 안 돼."
  },
  "139": {
   "jp": "d82f817969",
   "kr": "폐라니…"
  },
  "140": {
   "jp": "50b3d45ffa",
   "kr": "있잖아!"
  },
  "141": {
   "jp": "59034415b5",
   "kr": "빨리!"
  },
  "142": {
   "jp": "433bc93638",
   "kr": "…마수가 나와도 지켜 줄 거지!"
  },
  "143": {
   "jp": "5eb5ba51a7",
   "kr": "케이트!"
  },
  "144": {
   "jp": "c5b67f2110",
   "kr": "정말이지 질린다니까, 저 애한테는."
  },
  "145": {
   "jp": "43e4d79631",
   "kr": "어빈 씨, 죄송해요."
  },
  "146": {
   "jp": "59897cd9b5",
   "kr": "얼른 가 보세요."
  },
  "147": {
   "jp": "5c955dc560",
   "kr": "이러니저러니 해도"
  },
  "148": {
   "jp": "07276dcaa1",
   "kr": "삼촌이 신경 써 주길 바라는 거예요."
  },
  "149": {
   "jp": "e3511831f0",
   "kr": "그렇겠지."
  },
  "150": {
   "jp": "7506912193",
   "kr": "…그 아이도 외로운 걸지도…"
  },
  "151": {
   "jp": "1c0e6dc9ef",
   "kr": "기다려, 케이트!"
  },
  "152": {
   "jp": "05f4419123",
   "kr": "또 길 잃는다!!"
  },
  "153": {
   "jp": "0f1f795d2d",
   "kr": "굼벵이 도둑들 눈을 피해"
  },
  "154": {
   "jp": "ae2abbd401",
   "kr": "슬쩍했지."
  },
  "155": {
   "jp": "c1330b21bc",
   "kr": "이 이상 어빈 씨네한테"
  },
  "156": {
   "jp": "f35cf4642b",
   "kr": "폐 끼치면 안 돼."
  }
 }
