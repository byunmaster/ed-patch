{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02000C.BIN",
 "segments": {
  "0": {
   "jp": "3c71156387",
   "kr": "역시 왕도의 여관 술집은 다르다니까."
  },
  "1": {
   "jp": "3f8e88eb59",
   "kr": "푹 자서 피로도 풀려."
  },
  "2": {
   "jp": "95f7fadb6d",
   "kr": "자, 그럼"
  },
  "3": {
   "jp": "5c1aa6559d",
   "kr": "슬슬 이 마을도"
  },
  "4": {
   "jp": "f67cd0fc23",
   "kr": "뜰 때가 됐군."
  },
  "5": {
   "jp": "d10072066a",
   "kr": "어이, 이봐, 뭐야, 너희는?"
  },
  "6": {
   "jp": "d243278b64",
   "kr": "사람이 기분 좋게 취했는데 방해하겠다는 거냐."
  },
  "7": {
   "jp": "9a32630ae8",
   "kr": "풋… 술 냄새 나는 아저씨네!"
  },
  "8": {
   "jp": "fa4f301249",
   "kr": "네가 버너 씨야?"
  },
  "9": {
   "jp": "fedb1154fc",
   "kr": "그렇고말고."
  },
  "10": {
   "jp": "c4e2bad469",
   "kr": "버너 님께 무슨 용건이냐?"
  },
  "11": {
   "jp": "281fbc5699",
   "kr": "도구점 안주인의 심부름으로 왔어."
  },
  "12": {
   "jp": "25f760d464",
   "kr": "너, 짚이는 데가 많을 텐데?"
  },
  "13": {
   "jp": "593911271a",
   "kr": "도구점 빚을 갚으라고…?"
  },
  "14": {
   "jp": "94227a9c14",
   "kr": "뭐야, 도구점 녀석,"
  },
  "15": {
   "jp": "91c6fcfdfb",
   "kr": "이런 꼬맹이를 고용했냐."
  },
  "16": {
   "jp": "b35c6b764b",
   "kr": "그거 안됐군."
  },
  "17": {
   "jp": "8957e0d78e",
   "kr": "방금"
  },
  "18": {
   "jp": "da61d260e2",
   "kr": "여기 숙박비를 내서"
  },
  "19": {
   "jp": "5035730ab8",
   "kr": "빈털터리가 됐거든."
  },
  "20": {
   "jp": "1f03486991",
   "kr": "그거 좋은 마음가짐이군."
  },
  "21": {
   "jp": "cfca39aecb",
   "kr": "그 기세로 이쪽 빚도 갚아 줘."
  },
  "22": {
   "jp": "37baf78235",
   "kr": "이봐 이봐,"
  },
  "23": {
   "jp": "c9ab949e56",
   "kr": "나도 돈은 좀 남겨 둬야지."
  },
  "24": {
   "jp": "e4ad70c971",
   "kr": "이 이상 뜯기면"
  },
  "25": {
   "jp": "022018f5ab",
   "kr": "진짜 빈털터리가 된다고."
  },
  "26": {
   "jp": "f086e11a3b",
   "kr": "뭐라고 하든"
  },
  "27": {
   "jp": "5c88d10f48",
   "kr": "빌린 건 갚는 게 도리잖아."
  },
  "28": {
   "jp": "56bb82cef8",
   "kr": "이쪽은 안주인과 약속했어."
  },
  "29": {
   "jp": "504744d51b",
   "kr": "９００로제 정확히 돌려받겠다."
  },
  "30": {
   "jp": "840fe2a034",
   "kr": "하하하하…!"
  },
  "31": {
   "jp": "ef47d6ed93",
   "kr": "귀엽지 않은 꼬맹이로군!"
  },
  "32": {
   "jp": "3b6c3bea57",
   "kr": "좋다!"
  },
  "33": {
   "jp": "c6ba56fce0",
   "kr": "받을 수 있으면 받아 봐라!"
  },
  "34": {
   "jp": "c849f0640c",
   "kr": "잘 있거라～앙!"
  },
  "35": {
   "jp": "cb26899964",
   "kr": "쳇, 이 꼬맹이들!!"
  },
  "36": {
   "jp": "5441a5090a",
   "kr": "또 왔냐!"
  },
  "37": {
   "jp": "a5efc046f5",
   "kr": "이번엔 못 도망간다!"
  },
  "38": {
   "jp": "2674ed3279",
   "kr": "얌전히 외상값 내!"
  },
  "39": {
   "jp": "6f3fd47302",
   "kr": "싫～다 이거야!!"
  },
  "40": {
   "jp": "8256669690",
   "kr": "잘 있…"
  },
  "41": {
   "jp": "ed341f97ba",
   "kr": "…"
  },
  "42": {
   "jp": "c08028236c",
   "kr": "으…"
  },
  "43": {
   "jp": "8a74c0d351",
   "kr": "왜 그래, 아저씨."
  },
  "44": {
   "jp": "57cc9db75d",
   "kr": "그 대사 한번 해 보시지."
  },
  "45": {
   "jp": "8256669690",
   "kr": "잘 있…"
  },
  "46": {
   "jp": "0676e06df1",
   "kr": "…잘 있…"
  },
  "47": {
   "jp": "f75d4f976a",
   "kr": "잘 있거라～앙은 못 하겠어!!"
  },
  "48": {
   "jp": "7263c55920",
   "kr": "어머나, 잘 와 줬네, 버너 씨."
  },
  "49": {
   "jp": "81786dffea",
   "kr": "잘도 말하네."
  },
  "50": {
   "jp": "d0c02ccdd8",
   "kr": "자기가 꼬맹이들을 보내 놓고는."
  },
  "51": {
   "jp": "13e7939bc8",
   "kr": "어머, 뭐라고 했어?"
  },
  "52": {
   "jp": "4f71dff576",
   "kr": "이봐, 아저씨."
  },
  "53": {
   "jp": "4a1a1f7101",
   "kr": "얼른 계산을 끝내는 게 어때?"
  },
  "54": {
   "jp": "010b23e85b",
   "kr": "알았다고."
  },
  "55": {
   "jp": "97e46b725f",
   "kr": "나도 사나이다, 깔끔하게 갚아 주지."
  },
  "56": {
   "jp": "fab073e20f",
   "kr": "버너는 도구점 외상값을 지불했다."
  },
  "57": {
   "jp": "5fc7892ae8",
   "kr": "고마워요."
  },
  "58": {
   "jp": "5666c1bcaf",
   "kr": "앞으로도 많이 이용해 줘요."
  },
  "59": {
   "jp": "415ae15f0d",
   "kr": "아이고…"
  },
  "60": {
   "jp": "81b72bc65e",
   "kr": "이제 진짜 빈털터리가 돼 버렸네."
  },
  "61": {
   "jp": "fa928f52ba",
   "kr": "잘 있…거라…앙…"
  },
  "62": {
   "jp": "2708b09d43",
   "kr": "네, 무슨 일이야?"
  },
  "63": {
   "jp": "f12e3f40e6",
   "kr": "어머나, 네가 알선소 소개로?"
  },
  "64": {
   "jp": "7838684780",
   "kr": "수금을 대신해"
  },
  "65": {
   "jp": "dd8f5caa67",
   "kr": "주는 거구나."
  },
  "66": {
   "jp": "b48e3d84ea",
   "kr": "정말 고마워."
  },
  "67": {
   "jp": "90cb5f589a",
   "kr": "실은 말이야, 버너라는 손님 얘긴데."
  },
  "68": {
   "jp": "54cb71f9e4",
   "kr": "이 사람이 외상을 엄청나게 쌓아 놨어."
  },
  "69": {
   "jp": "b45eb81a90",
   "kr": "쌓고 쌓아서 무려 ９００로제야."
  },
  "70": {
   "jp": "3792b8a6cc",
   "kr": "독촉해도 헛수고,"
  },
  "71": {
   "jp": "ef2ec0d63e",
   "kr": "도무지 갚을 기미가 없어."
  },
  "72": {
   "jp": "66e2b533e2",
   "kr": "너희, 좀 가서"
  },
  "73": {
   "jp": "e9f164a42f",
   "kr": "단단히 쥐어짜 줘."
  },
  "74": {
   "jp": "a5cbc1a83a",
   "kr": "지금쯤 술집에서 퍼마시고 있을 테니까."
  },
  "75": {
   "jp": "1caa583792",
   "kr": "버너 녀석은"
  },
  "76": {
   "jp": "1d7634ece8",
   "kr": "지금쯤 술집에서 퍼마시고 있을 거야."
  },
  "77": {
   "jp": "af896ecfd8",
   "kr": "쓸모없는 놈인 주제에"
  },
  "78": {
   "jp": "02b1b2523f",
   "kr": "어디에나 있을 평범한 얼굴이니까"
  },
  "79": {
   "jp": "1c31859aa1",
   "kr": "사람 착각하지 않도록 해."
  },
  "80": {
   "jp": "fce14c57cf",
   "kr": "외상값 꼭 받아 와 줘."
  },
  "81": {
   "jp": "f17720c679",
   "kr": "믿고 있을게."
  },
  "82": {
   "jp": "e75629dbe3",
   "kr": "버너는 붙잡았어?"
  },
  "83": {
   "jp": "3c86e3c34e",
   "kr": "…그 모양새를 보니 놓쳤구나."
  },
  "84": {
   "jp": "f383dfe5f1",
   "kr": "좀 더 분발해 줘."
  },
  "85": {
   "jp": "7d1c3fd984",
   "kr": "믿고 있으니까."
  },
  "86": {
   "jp": "cc6818ebf6",
   "kr": "저기, 버너는 아직도 못 잡았어?"
  },
  "87": {
   "jp": "370e0cef0f",
   "kr": "정신 차려 줘, 너희만 믿고 있으니까."
  },
  "88": {
   "jp": "437dffedfa",
   "kr": "정말 고마워, 덕분에 살았어."
  },
  "89": {
   "jp": "ad63a5fa05",
   "kr": "그 사람이 안 갚았다면"
  },
  "90": {
   "jp": "81ae0511da",
   "kr": "결혼 ２０주년 여행이 물거품이 될 뻔했어."
  },
  "91": {
   "jp": "594e68b7b6",
   "kr": "사람이 기분 좋게 취해 있는데"
  },
  "92": {
   "jp": "b3652fd4cd",
   "kr": "방해하겠다는 거냐."
  },
  "93": {
   "jp": "24af84eb05",
   "kr": "정신 차려 줘,"
  },
  "94": {
   "jp": "0c36d9e1cd",
   "kr": "너희만 믿고 있으니까."
  }
 }
}
