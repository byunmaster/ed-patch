 "segments": {
  "0": {
   "jp": "914bac2740",
   "kr": "일부러 수고했어."
  },
  "1": {
   "jp": "28c3cf29a0",
   "kr": "무기점 안주인에게 안부 전해 줘."
  },
  "2": {
   "jp": "0703c96345",
   "kr": "여어, 너희도 이 여관에 묵고 있어?"
  },
  "3": {
   "jp": "5f947818d5",
   "kr": "좋겠다, 동료끼리 여행이라니."
  },
  "4": {
   "jp": "84fd00739f",
   "kr": "난 혼자 여행이라"
  },
  "5": {
   "jp": "9550c94ffd",
   "kr": "말 상대가 없어서 심심해."
  },
  "6": {
   "jp": "1d1a586c28",
   "kr": "괜찮으면 잠깐 얘기나 할래?"
  },
  "7": {
   "jp": "70cd06e35b",
   "kr": "난 클레이라고 해."
  },
  "8": {
   "jp": "5645a9b202",
   "kr": "클레이 씨라고?"
  },
  "9": {
   "jp": "38e41358d7",
   "kr": "뭐야, 날 아는 것처럼 놀라네?"
  },
  "10": {
   "jp": "d8008d9bb6",
   "kr": "기아 무기점 안주인에게 부탁받아서"
  },
  "11": {
   "jp": "3374edc27f",
   "kr": "당신을 찾고 있었어."
  },
  "12": {
   "jp": "da8e430cf8",
   "kr": "그 가게에서 방패를 샀지?"
  },
  "13": {
   "jp": "c3f8c2f40e",
   "kr": "응."
  },
  "14": {
   "jp": "b8ff3aecb1",
   "kr": "그게 왜?"
  },
  "15": {
   "jp": "bf5cbc8c68",
   "kr": "그 방패를 이쪽 방패와 바꿔 줬으면 해."
  },
  "16": {
   "jp": "b2568676e3",
   "kr": "큰 소리로는 말 못 하지만,"
  },
  "17": {
   "jp": "d16ad3394b",
   "kr": "그건 좀 고장 났을지도 모른대."
  },
  "18": {
   "jp": "99470e3035",
   "kr": "불량품인가."
  },
  "19": {
   "jp": "6066a05f17",
   "kr": "뭐, 그렇게 대놓고 말하면"
  },
  "20": {
   "jp": "3ef7ca4689",
   "kr": "안주인이 불쌍하잖아."
  },
  "21": {
   "jp": "be569e0e84",
   "kr": "하하하, 그렇네."
  },
  "22": {
   "jp": "c3f6846144",
   "kr": "일부러 바꾸러 와 줬는데."
  },
  "23": {
   "jp": "15a9a413bb",
   "kr": "그럼, 이거."
  },
  "24": {
   "jp": "bbce6d4d55",
   "kr": "어빈은 무기점 안주인에게서 맡아 온 방패를 건넸다."
  },
  "25": {
   "jp": "4a30030cbc",
   "kr": "어빈은 불량품 방패를 받았다."
  },
  "26": {
   "jp": "16b931da79",
   "kr": "여어, 너희도 여행 중이야?"
  },
  "27": {
   "jp": "daf497692d",
   "kr": "동료가 있어서 좋겠다."
  },
  "28": {
   "jp": "910242cac5",
   "kr": "혼자 하는 여행은 쓸쓸해서 말이야."
  },
  "29": {
   "jp": "16b931da79",
   "kr": "여어, 너희도 여행 중이야?"
  },
  "30": {
   "jp": "daf497692d",
   "kr": "동료가 있어서 좋겠다."
  },
  "31": {
