{
 "archive": "/E/SC401.DAT",
 "member": "..\\BIN\\ET02200A.BIN",
 "segments": {
  "0": {
   "jp": "1d18370959",
   "kr": "이국에 사는 내 친구다."
  },
  "1": {
   "jp": "4433da0f84",
   "kr": "이 사람은 마법 수행의 일환으로"
  },
  "2": {
   "jp": "3d7ce7a273",
   "kr": "세계 곳곳을 두루 찾아다니고 있단다."
  },
  "3": {
   "jp": "db446fb079",
   "kr": "미첼이라고 합니다."
  },
  "4": {
   "jp": "6d1f8e7fe5",
   "kr": "제가 이곳에 온 목적은 마법 수련만이 아니라"
  },
  "5": {
   "jp": "73b0c76dde",
   "kr": "엘 필딘의 삼현자를 만나"
  },
  "6": {
   "jp": "1ae1e3b17f",
   "kr": "그분들의 인품을 접하는 것이었어요."
  },
  "7": {
   "jp": "8be5a98f6d",
   "kr": "아시다시피 엘 필딘의 삼현자란"
  },
  "8": {
   "jp": "f875a0fe2d",
   "kr": "이쪽의 가웨인 님, 치브리의 디너켄 님,"
  },
  "9": {
   "jp": "d458e44335",
   "kr": "그리고 돌아가신 레뮤라스 님, 세 분입니다."
  },
  "10": {
   "jp": "89b8c42ea4",
   "kr": "안타깝게도 돌아가신 레뮤라스 님과는"
  },
  "11": {
   "jp": "bf8e91c6e3",
   "kr": "살아서 만나 뵙지 못했지만"
  },
  "12": {
   "jp": "ec9ce79077",
   "kr": "디너켄 님과는 만날 수 있었어요."
  },
  "13": {
   "jp": "abe298757d",
   "kr": "미첼은 디너켄을 만나 네 이야기를 듣고"
  },
  "14": {
   "jp": "74eaf5bade",
   "kr": "협력하겠다고 나서 주었다."
  },
  "15": {
   "jp": "883c85d831",
   "kr": "지금까지의 일은 들었어요."
  },
  "16": {
   "jp": "ac94fcd55d",
   "kr": "어릴 때부터 발두스 신전과 오크툼 신전의 다툼에"
  },
  "17": {
   "jp": "734117ad9b",
   "kr": "두 분 남매가 휘말린 것도…"
  },
  "18": {
   "jp": "1a782b1dfd",
   "kr": "그리고 아이멜이 목숨을 잃은 것도…"
  },
  "19": {
   "jp": "082534f9b8",
   "kr": "미력하지만 제가 힘이 될 수 있는 일이 있어요."
  },
  "20": {
   "jp": "5bb546bcdf",
   "kr": "아니, 가능하면 제 협력을 받아 주셨으면 해요."
  },
  "21": {
   "jp": "6e3c7a72e3",
   "kr": "그러지 않으면 나도 후회를 남기게 될 테니까."
  },
  "22": {
   "jp": "782a3173d0",
   "kr": "네 짐수레가 습격당하고 있다고 알려 준 것은"
  },
  "23": {
   "jp": "5bdbe27183",
   "kr": "이 미첼이다."
  },
  "24": {
   "jp": "5ca27326eb",
   "kr": "이 사람은 여기서 디너켄에게 가는 길에"
  },
  "25": {
   "jp": "1c70604f3c",
   "kr": "그 자리에 있었고 너희가 정신을 잃은 사이에"
  },
  "26": {
   "jp": "285c3b1533",
   "kr": "볼게이드를 물리쳐 주었다."
  },
  "27": {
   "jp": "f383d3c606",
   "kr": "그때의…"
  },
  "28": {
   "jp": "dc97b8f3c1",
   "kr": "저는 이 세상에 우연은 없다고 생각해요."
  },
  "29": {
   "jp": "462927dc59",
   "kr": "이렇게 얽힌 이상"
  },
  "30": {
   "jp": "5cd0c3569b",
   "kr": "어떤 의지가 작용하고 있다고 생각해요."
  },
  "31": {
   "jp": "0674fc84a8",
   "kr": "그것이 신이라고까지는 말하지 않지만요…"
  },
  "32": {
   "jp": "d4606e1d4e",
   "kr": "미첼에게 제안이 있다고 한다."
  },
  "33": {
   "jp": "cfc8b8e3dd",
   "kr": "나도 미첼에게 이야기를 듣기 전까지"
  },
  "34": {
   "jp": "0529e69407",
   "kr": "잊고 있었다만."
  },
  "35": {
   "jp": "22002f7326",
   "kr": "이 엘 필딘에는"
  },
  "36": {
   "jp": "02e9d48ff5",
   "kr": "발두스 신과도 오크툼 신과도 다른 체계를 가진"
  },
  "37": {
   "jp": "9c7039d494",
   "kr": "신의 전승이 남아 있어요."
  },
  "38": {
   "jp": "92a19baf9b",
   "kr": "세타 북쪽의 바닷가 작은 마을,"
  },
  "39": {
   "jp": "6df9ff4aec",
   "kr": "도크스에 전해지고 있죠."
  },
  "40": {
   "jp": "ce83dd6ecf",
   "kr": "그 앞바다에 떠 있는 진실의 섬에"
  },
  "41": {
   "jp": "ca7ebcaa2c",
   "kr": "신들의 전쟁 이전에 세상을 다스리던 신이"
  },
  "42": {
   "jp": "dfecccaca6",
   "kr": "있었다고 전해지고 있어요."
  },
  "43": {
   "jp": "a45310e77c",
   "kr": "저와 함께 진실의 섬에 가요."
  },
  "44": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "45": {
   "jp": "becd86a00f",
   "kr": "여행 도중에 들은 이야기로는"
  },
  "46": {
   "jp": "47b74e9732",
   "kr": "진실의 섬에는 모든 저주를 풀어 준다는"
  },
  "47": {
   "jp": "dc3c97b91f",
   "kr": "성수가 솟고 있다고 해요."
  },
  "48": {
   "jp": "54e6985f90",
   "kr": "도크스 변두리에 신목인 호랑가시나무가 있는데"
  },
  "49": {
   "jp": "5e48635911",
   "kr": "그 잎을 진실의 섬 성수에 담그면"
  },
  "50": {
   "jp": "d1004f7ee1",
   "kr": "모든 저주를 풀어 주는 묘약이 된다고요."
  },
  "51": {
   "jp": "2b6c66b0f7",
   "kr": "누이동생을 잃고, 벗을 잃은"
  },
  "52": {
   "jp": "7d84affc42",
   "kr": "지금 당신의 슬픔은 헤아릴 수 없을 거예요."
  },
  "53": {
   "jp": "007dff73fd",
   "kr": "루티스 씨는 적이었을지도 모르지."
  },
  "54": {
   "jp": "e06644c70e",
   "kr": "하지만 루티스 씨의 저주를 풀 수"
  },
  "55": {
   "jp": "4785372918",
   "kr": "있다면"
  },
  "56": {
   "jp": "2330a12ccb",
   "kr": "어빈 씨는 진실의 섬에 가는 편이 좋아."
  },
  "57": {
   "jp": "84c0ac1c06",
   "kr": "누군가를 도울 수 있으면서"
  },
  "58": {
   "jp": "f087d26e62",
   "kr": "자신의 슬픔에 잠겨 있는 것은"
  },
  "59": {
   "jp": "f4ae44f3bb",
   "kr": "더 슬픈 일이라고 생각하지 않으세요?"
  },
  "60": {
   "jp": "6e23e12d61",
   "kr": "함께 진실의 섬에 가요."
  },
  "61": {
   "jp": "ffaf62be59",
   "kr": "그것이 새로운 희망으로 이어질지도 모르니까요."
  },
  "62": {
   "jp": "964cb7ed41",
   "kr": "새로운 희망…?"
  },
  "63": {
   "jp": "75b5d3f153",
   "kr": "그래요."
  },
  "64": {
   "jp": "9bda05d6fa",
   "kr": "아마 진실의 섬에는 잊힌 신들의"
  },
  "65": {
   "jp": "1bdcf047e3",
   "kr": "진짜 역사가 있을 거예요."
  },
  "66": {
   "jp": "78da46e7d0",
   "kr": "그 일부에라도 닿을 수 있다면."
  },
  "67": {
   "jp": "87b2cfdaa0",
   "kr": "발두스 신이나 오크툼 신뿐 아니라"
  },
  "68": {
   "jp": "207cb97628",
   "kr": "더 큰 신의 구조가 보일 거예요."
  },
  "69": {
   "jp": "2839a2417f",
   "kr": "여러분이 휘말린 싸움의 원인도"
  },
  "70": {
   "jp": "ff4bbb2485",
   "kr": "그런 데 있을지도 몰라요."
  },
  "71": {
   "jp": "29d17ba111",
   "kr": "적어도 그걸 알면 큰 희망이 돼요."
  },
  "72": {
   "jp": "34e1f61b28",
   "kr": "할 수 있느냐 없느냐는 별개로 하고"
  },
  "73": {
   "jp": "fdb350b2c0",
   "kr": "지금 인간이 무엇을 하면 좋은지 알게 될 거예요."
  },
  "74": {
   "jp": "d0f5cc7e37",
   "kr": "진실의 섬에 가자."
  },
  "75": {
   "jp": "6af99606e7",
   "kr": "다행이야."
  },
  "76": {
   "jp": "7c82920480",
   "kr": "이만큼 이야기하고 거절당하면"
  },
  "77": {
   "jp": "08a0f04168",
   "kr": "어쩌나 했어요."
  },
  "78": {
   "jp": "8ccdb0143c",
   "kr": "루티스는 적이었지만 그 애에게 죄는 없어."
  },
  "79": {
   "jp": "2b26f43edf",
   "kr": "그녀는 잘못을 깨닫고 있었어."
  },
  "80": {
   "jp": "0b2784b6e8",
   "kr": "하다못해 그녀를 구할 가능성이 있다면"
  },
  "81": {
   "jp": "fa7d8f22d2",
   "kr": "진실의 섬의 전설에 걸어 보겠어."
  },
  "82": {
   "jp": "915607e9b8",
   "kr": "그리고 끝까지 밝혀내고 말겠어."
  },
  "83": {
   "jp": "ab5e7c9708",
   "kr": "휘말리는 게 싫어서 외면해 왔지만…"
  },
  "84": {
   "jp": "1cd1da0959",
   "kr": "이제 도망 다니는 건 싫어."
  },
  "85": {
   "jp": "b4aa03e099",
   "kr": "이쪽에서 먼저 가 주지."
  },
  "86": {
   "jp": "3f83bfb60e",
   "kr": "그렇게 정했으면 서두르는 편이 좋다."
  },
  "87": {
   "jp": "998807b927",
   "kr": "루티스의 이 상태로는 남은 시간이 많지 않다."
  },
  "88": {
   "jp": "cad974ff81",
   "kr": "길어야 보름."
  },
  "89": {
   "jp": "a0d60990f3",
   "kr": "빠르면 일주일 정도일 겁니다."
  },
  "90": {
   "jp": "457d924033",
   "kr": "시간에 맞출 수 있을까?"
  },
  "91": {
   "jp": "a87e0f1130",
   "kr": "늦지 않게 해 보이겠어."
  },
  "92": {
   "jp": "fb27a1e48d",
   "kr": "그럼 서둘러요."
  },
  "93": {
   "jp": "895f579909",
   "kr": "그 자리에 있다가 너희가 정신을 잃은 사이"
  },
  "94": {
   "jp": "3c96fb33d1",
   "kr": "너희가 정신을 잃은 사이에"
  }
 }
}
