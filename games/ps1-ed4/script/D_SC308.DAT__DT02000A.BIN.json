{
 "archive": "/D/SC308.DAT",
 "member": "..\\BIN\\DT02000A.BIN",
 "segments": {
  "0": {
   "jp": "e743feea22",
   "kr": "어빈 씨, 보이네요."
  },
  "1": {
   "jp": "8743eadd9a",
   "kr": "저것이 진실의 섬이에요."
  },
  "2": {
   "jp": "a6fa15e39b",
   "kr": "루티스 씨의 저주를 푸는 것도 중요한 목적이지만"
  },
  "3": {
   "jp": "689c1416a9",
   "kr": "자, 이 섬에는 무엇이 있을까요."
  },
  "4": {
   "jp": "e3ab3d27b1",
   "kr": "왠지 두근두근하네요."
  },
  "5": {
   "jp": "9fa429df3f",
   "kr": "유적이다…"
  },
  "6": {
   "jp": "befaf51fc6",
   "kr": "그것도"
  },
  "7": {
   "jp": "2e65374bde",
   "kr": "상당히 고도의 문명을 가졌던 사람들의"
  },
  "8": {
   "jp": "832f0a9caf",
   "kr": "유적 같네요."
  },
  "9": {
   "jp": "2446ad92a4",
   "kr": "도크스 사람들의 선조일까."
  },
  "10": {
   "jp": "3371761759",
   "kr": "아마 그럴 거예요."
  },
  "11": {
   "jp": "9e7bd9e691",
   "kr": "그들의 선조는 아주 먼 옛날 이 문명을 버림으로써"
  },
  "12": {
   "jp": "cccbd1aa80",
   "kr": "새로운 깨달음을 얻었는지도 모르겠네요."
  },
  "13": {
   "jp": "d85f86b47d",
   "kr": "그랬기에 발두스 신과 오크툼 신의 싸움에"
  },
  "14": {
   "jp": "2e1c5d5b09",
   "kr": "휘말리지 않고"
  },
  "15": {
   "jp": "f0687fd1c0",
   "kr": "독자적인 삶을 일굴 수 있었겠죠."
  },
  "16": {
   "jp": "ec4fcb645c",
   "kr": "여기로 들어갈 수 있나?"
  },
  "17": {
   "jp": "a617689980",
   "kr": "섬 안쪽에 신전이 있을 것 같네요."
  },
  "18": {
   "jp": "9ab6cd3270",
   "kr": "열어 보자."
  },
  "19": {
   "jp": "0fa2742e48",
   "kr": "아뇨, 이 문은 열릴 것 같지 않아요."
  },
  "20": {
   "jp": "b6bc00dfb1",
   "kr": "강력한 봉인이 걸려 있어요."
  },
  "21": {
   "jp": "13339a0c02",
   "kr": "그럴 수가…"
  },
  "22": {
   "jp": "e90d14b88c",
   "kr": "그럼, 미첼 씨 힘으로도 안 돼?"
  },
  "23": {
   "jp": "89a25791fe",
   "kr": "유감스럽게도"
  },
  "24": {
   "jp": "2c2a1541c3",
   "kr": "제 능력을 아득히 뛰어넘는 봉인이에요."
  },
  "25": {
   "jp": "732f877fd9",
   "kr": "어쩔 수 없네요."
  },
  "26": {
   "jp": "cffc984fca",
   "kr": "다른 입구를 찾아보죠."
  },
  "27": {
   "jp": "04b649a3b9",
   "kr": "돌문은 열릴 것 같지 않다."
  },
  "28": {
   "jp": "176a649d4a",
   "kr": "어라? …여기는."
  },
  "29": {
   "jp": "58cfdd9b70",
   "kr": "돌문."
  },
  "30": {
   "jp": "7c6c471a01",
   "kr": "…열릴 것 같네요."
  },
  "31": {
   "jp": "23a681a5a1",
   "kr": "이 섬 어딘가에"
  },
  "32": {
   "jp": "bba35d52dd",
   "kr": "성스러운 물이 흐르는 곳이 있을 거야…"
  },
  "33": {
   "jp": "2ca99c9935",
   "kr": "대체… 어디에 있는 거지."
  },
  "34": {
   "jp": "90c310078c",
   "kr": "섬을 샅샅이 뒤져 보는 수밖에 없겠네요."
  },
  "35": {
   "jp": "4625606ab9",
   "kr": "시간이 없어요."
  },
  "36": {
   "jp": "bba1643c80",
   "kr": "자, 찾아보죠."
  },
  "37": {
   "jp": "3c83e5a254",
   "kr": "어빈 씨.",
   "auto": 1
  },
  "38": {
   "jp": "42ec29375a",
   "kr": "이 섬엔 아직 뭔가 숨겨진 듯한 기분이 들어요."
  },
  "39": {
   "jp": "cddd215812",
   "kr": "다시 한번 지하에 내려가 보죠."
  },
  "40": {
   "jp": "689627f3c5",
   "kr": "배가 없어졌어."
  },
  "41": {
   "jp": "b58e2cba13",
   "kr": "…대체 누가?"
  },
  "42": {
   "jp": "58cc1c0ffb",
   "kr": "윽!"
  },
  "43": {
   "jp": "3333a3e5d5",
   "kr": "엄청난 살기가 넘쳐나고 있어요."
  },
  "44": {
   "jp": "22aa13f0f5",
   "kr": "네놈들의 배는 바다에 흘려보냈다."
  },
  "45": {
   "jp": "1a64eeea6b",
   "kr": "이제 여기서는 나갈 수 없다."
  },
  "46": {
   "jp": "bba90c348b",
   "kr": "매드람!"
  },
  "47": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "48": {
   "jp": "b0887ca271",
   "kr": "네놈은 정신전 사람이로군."
  },
  "49": {
   "jp": "4396e76feb",
   "kr": "그렇다면 어쩔 건데!"
  },
  "50": {
   "jp": "d9d3a174fc",
   "kr": "아이멜의 원한."
  },
  "51": {
   "jp": "edcbadc2c6",
   "kr": "지금 여기서 갚아 주마!"
  },
  "52": {
   "jp": "2343bbbaa1",
   "kr": "침착하세요."
  },
  "53": {
   "jp": "4487ae5b03",
   "kr": "그에게서 강한 살기와 함께"
  },
  "54": {
   "jp": "1fa6afa126",
   "kr": "깊이 모를 슬픔이 느껴져요."
  },
  "55": {
   "jp": "05f9dbfbe3",
   "kr": "뭔가 사정이 있는 듯해요."
  },
  "56": {
   "jp": "a163f1b5b1",
   "kr": "슬픔이라면 나도… 지지 않아."
  },
  "57": {
   "jp": "c6e21aa1f4",
   "kr": "…그 녀석이 아이멜을."
  },
  "58": {
   "jp": "a184c2d111",
   "kr": "볼게이드에게서 널 죽이라는 의뢰가 있었다."
  },
  "59": {
   "jp": "c401d87d4e",
   "kr": "그 목숨, 받아 가겠다."
  },
  "60": {
   "jp": "21036be897",
   "kr": "순순히 당하진 않아!"
  },
  "61": {
   "jp": "43f15f42b0",
   "kr": "네놈은 그때도 아이멜에게 정신전 사람이냐고 물었지."
  },
  "62": {
   "jp": "08e1de6884",
   "kr": "그 아이는 그렇다고 대답했다."
  },
  "63": {
   "jp": "5c53867114",
   "kr": "그래서 벤 것이다."
  },
  "64": {
   "jp": "4e2aea614b",
   "kr": "다들 착각하고 있는 거야."
  },
  "65": {
   "jp": "2284490f3b",
   "kr": "우리는 어릴 때부터 정신전에서 자랐어."
  },
  "66": {
   "jp": "4966c14cf8",
   "kr": "그래서 아이멜은 자신이 정신전 사람이라고"
  },
  "67": {
   "jp": "d0eb5b408f",
   "kr": "믿어 버렸을 뿐이야."
  },
  "68": {
   "jp": "4727bc521c",
   "kr": "루티스도 마찬가지야."
  },
  "69": {
   "jp": "d75d494ac4",
   "kr": "그녀는 오크툼 신을 숭배하긴 했지만"
  },
  "70": {
   "jp": "3b56947853",
   "kr": "볼게이드의 야망이 진리에서 벗어나 있음을 깨닫고"
  },
  "71": {
   "jp": "e31e91027d",
   "kr": "참된 자신을 되찾은 거야."
  },
  "72": {
   "jp": "372352aff2",
   "kr": "나는 암살자다."
  },
  "73": {
   "jp": "7fb4268a26",
   "kr": "의뢰가 있으면 이유 따윈 필요 없다."
  },
  "74": {
   "jp": "8928969084",
   "kr": "간다."
  },
  "75": {
   "jp": "c2d9853810",
   "kr": "다들 제멋대로 억지를 부리고…"
  },
  "76": {
   "jp": "ffb1953eb1",
   "kr": "발두스도 오크툼도 나와는 상관없어!"
  },
  "77": {
   "jp": "e5f25ff5e6",
   "kr": "제법 하는 모양이다만…"
  },
  "78": {
   "jp": "c7e2109420",
   "kr": "…벌써 숨이 차나?"
  },
  "79": {
   "jp": "4652c1328c",
   "kr": "닥쳐!"
  },
  "80": {
   "jp": "de692aa283",
   "kr": "듣기 좋은 소리를 해 봐야,"
  },
  "81": {
   "jp": "659bc487cf",
   "kr": "사람에게는 정의를 버리고 슬픔을 넘어서야"
  },
  "82": {
   "jp": "5e040eb605",
   "kr": "만 하는 때가 있는 법이다."
  },
  "83": {
   "jp": "625d044afd",
   "kr": "그것이야말로 신들의 싸움이 부른 대지의 율법이다."
  },
  "84": {
   "jp": "462fa5c3fc",
   "kr": "(왜일까…)"
  },
  "85": {
   "jp": "038a41bd73",
   "kr": "(매드람의 슬픔의 상념이 마음에 걸려요.)"
  },
  "86": {
   "jp": "743bb195ab",
   "kr": "(저 남자와는 싸우지 말라고 직감이 속삭인다.)"
  },
  "87": {
   "jp": "8418f55ab7",
   "kr": "신들의 싸움에 휘말려 줄까 보냐!"
  },
  "88": {
   "jp": "73bbbbf512",
   "kr": "(안 돼…)"
  },
  "89": {
   "jp": "ad46cf7a82",
   "kr": "(어빈의 감정이 흐트러져 있어.)"
  },
  "90": {
   "jp": "c406d1f443",
   "kr": "죽어 줘야겠다."
  },
  "91": {
   "jp": "efce2b5406",
   "kr": "하앗!"
  },
  "92": {
   "jp": "695cedc5f8",
   "kr": "어빈 씨, 검을 거두세요."
  },
  "93": {
   "jp": "b8c54377b7",
   "kr": "이 마법은 오래 버티지 못해요."
  },
  "94": {
   "jp": "ec0489fd67",
   "kr": "가요."
  },
  "95": {
   "jp": "5bbf463e3b",
   "kr": "방해꾼이 끼어들었나."
  },
  "96": {
   "jp": "c412c3e021",
   "kr": "이 섬에는,"
  },
  "97": {
   "jp": "3d8c372ecf",
   "kr": "아직 뭔가 숨겨져 있는 것 같은 기분이 들어요."
  },
  "98": {
   "jp": "4d279484bf",
   "kr": "네놈은 그때도,"
  },
  "99": {
   "jp": "e1438f1124",
   "kr": "아이멜에게 정신전 사람이냐고 물었지."
  }
 }
}
