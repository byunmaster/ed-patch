{
 "archive": "/E/SC401.DAT",
 "member": "..\\BIN\\ET02200F.BIN",
 "segments": {
  "0": {
   "jp": "6215c55917",
   "kr": "나도 가만히 있을 수만은 없는 모양이다.",
   "auto": 1
  },
  "1": {
   "jp": "b6d2d5599f",
   "kr": "함께 데려가 주지 않겠느냐?",
   "auto": 1
  },
  "2": {
   "jp": "037c41a9c1",
   "kr": "다시 내 힘이 필요해졌구나.",
   "auto": 1
  },
  "3": {
   "jp": "5744abac1e",
   "kr": "이 늙은 몸이 어디까지 도움이 될지 모르지만",
   "auto": 1
  },
  "4": {
   "jp": "9db2a8b4a4",
   "kr": "네 기대에 부응하도록 노력하마.",
   "auto": 1
  },
  "5": {
   "jp": "02152f4f02",
   "kr": "드디어 때가 왔군."
  },
  "6": {
   "jp": "eb787fce98",
   "kr": "나도 함께 갈까?"
  },
  "7": {
   "jp": "4d251ec40f",
   "kr": "을(를) 일행에 넣겠습니까?",
   "auto": 1
  },
  "8": {
   "jp": "6fe38156a7",
   "kr": "좋다."
  },
  "9": {
   "jp": "77c6347763",
   "kr": "지옥 끝까지라도 함께해 주마."
  },
  "10": {
   "jp": "ed1b9cb7bf",
   "kr": "이(가) 일행에 합류했다.",
   "auto": 1
  },
  "11": {
   "jp": "622f537e4e",
   "kr": "일행은 충분한 모양이다.",
   "auto": 1
  },
  "12": {
   "jp": "d841ee6cfe",
   "kr": "후. 너답지 않구나."
  },
  "13": {
   "jp": "39cf6ab1db",
   "kr": "늙은이에게 동정을 베풀었구나."
  },
  "14": {
   "jp": "0e40b1fb39",
   "kr": "뭐, 괜찮다."
  },
  "15": {
   "jp": "fa07a22cb4",
   "kr": "마음이 바뀌면 언제든 불러라."
  }
 }
}
