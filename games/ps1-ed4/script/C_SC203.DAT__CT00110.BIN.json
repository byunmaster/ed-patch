{
 "archive": "/C/SC203.DAT",
 "member": "..\\BIN\\CT00110.BIN",
 "segments": {
  "0": {
   "jp": "2406ca2712",
   "kr": "니트 할머니"
  },
  "1": {
   "jp": "8e06878ad4",
   "kr": "리오"
  },
  "2": {
   "jp": "af11d5c2d8",
   "kr": "이거 참 못 견디게 춥구먼."
  },
  "3": {
   "jp": "6185ec8ca1",
   "kr": "나도 참례당 쪽으로 피난 가는 편이"
  },
  "4": {
   "jp": "81672ab115",
   "kr": "나을지도 모르겠네."
  },
  "5": {
   "jp": "d70e65f8d1",
   "kr": "아무리 그래도"
  },
  "6": {
   "jp": "f1b4458b4f",
   "kr": "코르나 마을이 생긴 뒤로 이렇게 추운 건 처음이야."
  },
  "7": {
   "jp": "26f32e3eb2",
   "kr": "혹시 누가"
  },
  "8": {
   "jp": "4b96c3178d",
   "kr": "둘가 님의 노여움을 살 만한 일이라도"
  },
  "9": {
   "jp": "716db5a711",
   "kr": "해 버린 걸까…"
  },
  "10": {
   "jp": "888609b716",
   "kr": "오, 무슨 일인고?"
  },
  "11": {
   "jp": "78775f1e4a",
   "kr": "기아의 헤임 씨한테 짐을 맡아 왔어."
  },
  "12": {
   "jp": "2b528e74d3",
   "kr": "글쎄, 헤임이라. 대체 누구일꼬."
  },
  "13": {
   "jp": "5c6e4a5fdb",
   "kr": "니트에게 목도리를 건넸다."
  },
  "14": {
   "jp": "cead615481",
   "kr": "이 더러운 목도리는 뭔고…"
  },
  "15": {
   "jp": "b35452c8a5",
   "kr": "오, 그러고 보니."
  },
  "16": {
   "jp": "af0cc28214",
   "kr": "이건 전에 여기 온 나그네에게 빌려준 것."
  },
  "17": {
   "jp": "f1cf8de63e",
   "kr": "추워 보이는 차림의 젊은이에게 줬었지."
  },
  "18": {
   "jp": "5b2556acb5",
   "kr": "이제 버릴까 하던 물건이라"
  },
  "19": {
   "jp": "a717f86959",
   "kr": "돌려주지 않아도 된다고 했는데…"
  },
  "20": {
   "jp": "241708e4c9",
   "kr": "참 의리 있는 분도 다 있구먼."
  },
  "21": {
   "jp": "6ba0eb9e89",
   "kr": "나는 까맣게 잊고 있었다네."
  },
  "22": {
   "jp": "ad3604c3e1",
   "kr": "모처럼 가져다주었으니"
  },
  "23": {
   "jp": "3fbea0de35",
   "kr": "다시 간직해 두기로 하지요."
  },
  "24": {
   "jp": "9af38fe1ac",
   "kr": "추워 보이는 차림의 나그네가 오면"
  },
  "25": {
   "jp": "ed195ce409",
   "kr": "빌려주기로 하지요."
  },
  "26": {
   "jp": "4daea2cfb0",
   "kr": "자네들, 먼 길 수고했구먼."
  },
  "27": {
   "jp": "953a3b61ef",
   "kr": "무슨 일인가. 어쩐 일인고?"
  },
  "28": {
   "jp": "2d8908d6a2",
   "kr": "어른들은 추위를 잘 타더라."
  },
  "29": {
   "jp": "eca1eba8d8",
   "kr": "난 아무렇지도 않은데."
  },
  "30": {
   "jp": "dc98b9a9cf",
   "kr": "재밌는걸, 뭐."
  },
  "31": {
   "jp": "e5d73238df",
   "kr": "얼어붙은 강 위에서 미끄럼 타며 놀 수 있거든."
  },
  "32": {
   "jp": "ff02beaf76",
   "kr": "들어 봐."
  },
  "33": {
   "jp": "418305ebe3",
   "kr": "하늘에서 휙 소리가 나서 올려다봤더니."
  },
  "34": {
   "jp": "e8fdd3c6c0",
   "kr": "나 봤어."
  },
  "35": {
   "jp": "9ac82d974a",
   "kr": "코르나 산 쪽에서"
  },
  "36": {
   "jp": "a6a02bfd23",
   "kr": "뭔가가 남쪽으로 날아갔어."
  },
  "37": {
   "jp": "b1f9b7d0ca",
   "kr": "뭐였을까…"
  },
  "38": {
   "jp": "5a4dc4ff65",
   "kr": "진짜야. 대단했다고."
  },
  "39": {
   "jp": "091a07f080",
   "kr": "난 추워도 괜찮아."
  },
  "40": {
   "jp": "168a1a524a",
   "kr": "애들은 추위를 안 탄다잖아."
  },
  "41": {
   "jp": "d5ce8e37f0",
   "kr": "언제나 가슴이 뜨겁게 타오르니까."
  },
  "42": {
   "jp": "b5f8722061",
   "kr": "야호!"
  },
  "43": {
   "jp": "b65eaadb88",
   "kr": "헤헤, 놀랐지?"
  },
  "44": {
   "jp": "7555f9cdc1",
   "kr": "누가 오면 놀래 주려고"
  },
  "45": {
   "jp": "87c15c454e",
   "kr": "눈사람 속에 숨어 있었어."
  },
  "46": {
   "jp": "cc52cb51a3",
   "kr": "한참 아무도 안 와서"
  },
  "47": {
   "jp": "b19f97b9b6",
   "kr": "얼어 죽을 뻔했어."
  },
  "48": {
   "jp": "d831b29e03",
   "kr": "카스톨의 열쇠와 카스톨의 편지를 손에 넣었다."
  },
  "49": {
   "jp": "dc809be10d",
   "kr": "카스톨의 열쇠와 카스톨의 편지를 발견했다."
  },
  "50": {
   "jp": "0838adef5e",
   "kr": "하지만 소지품이 가득 차서"
  },
  "51": {
   "jp": "247f360a7a",
   "kr": "더 이상 아이템을 소지할 수 없다."
  },
  "52": {
   "jp": "dc809be10d",
   "kr": "카스톨의 열쇠와 카스톨의 편지를 발견했다."
  },
  "53": {
   "jp": "0838adef5e",
   "kr": "하지만 소지품이 가득 차서"
  },
  "54": {
   "jp": "247f360a7a",
   "kr": "더 이상 아이템을 소지할 수 없다."
  },
  "55": {
   "jp": "cf675cd058",
   "kr": "이제"
  },
  "56": {
   "jp": "6a46eb523b",
   "kr": "버릴까 하던 물건이라"
  }
 }
}
