{
 "archive": "/D/SC300.DAT",
 "member": "..\\BIN\\DT00100B.BIN",
 "segments": {
  "0": {
   "jp": "1c6fa8b5f0",
   "kr": "혹시 일 때문에 오신 분이에요?"
  },
  "1": {
   "jp": "ea1ec2f4a7",
   "kr": "아버지께 들리면 곤란하니까…"
  },
  "2": {
   "jp": "4d08c00f40",
   "kr": "이쪽으로 오세요."
  },
  "3": {
   "jp": "129f9e7b24",
   "kr": "알선소에서 대강의 이야기는"
  },
  "4": {
   "jp": "d13aaeaa88",
   "kr": "들으셨겠지만."
  },
  "5": {
   "jp": "196b5d4c51",
   "kr": "억지로 결혼하게 될 처지라고 했지."
  },
  "6": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "7": {
   "jp": "685143e12a",
   "kr": "상대는 귀족 집 아드님이고"
  },
  "8": {
   "jp": "3a3a94737d",
   "kr": "아주 좋은 혼담이라고 해요."
  },
  "9": {
   "jp": "ccba082e10",
   "kr": "하지만 저는 결혼 상대를"
  },
  "10": {
   "jp": "99811ba05d",
   "kr": "직접 찾고 싶어요."
  },
  "11": {
   "jp": "f86747fb45",
   "kr": "그래서 가짜 애인을 세우려고"
  },
  "12": {
   "jp": "6bd8ee21cf",
   "kr": "생각한 거구나."
  },
  "13": {
   "jp": "1dca2a3ed4",
   "kr": "네.",
   "auto": 1
  },
  "14": {
   "jp": "174927b763",
   "kr": "아버지는 귀족이라는 지위에"
  },
  "15": {
   "jp": "8ca879995c",
   "kr": "집착하세요."
  },
  "16": {
   "jp": "6a16b84c0f",
   "kr": "당신처럼 번듯한 차림의 분이라면"
  },
  "17": {
   "jp": "5c8d7bef6a",
   "kr": "아버지도 납득하실 것 같아요."
  },
  "18": {
   "jp": "e6d8dddfc1",
   "kr": "저, 저 말입니까!?"
  },
  "19": {
   "jp": "2e3fa86eab",
   "kr": "저는 일단 귀족이긴 합니다만…"
  },
  "20": {
   "jp": "66bf7f98c9",
   "kr": "그렇다면 꼭 부탁드려요!"
  },
  "21": {
   "jp": "a5c8169c20",
   "kr": "같이 가 주세요."
  },
  "22": {
   "jp": "85d33e60db",
   "kr": "그러니까… 실례지만"
  },
  "23": {
   "jp": "35f9d707d8",
   "kr": "당신들로는 아버지를 납득시킬 수"
  },
  "24": {
   "jp": "e683db94d5",
   "kr": "없을 것 같아요."
  },
  "25": {
   "jp": "9e67f19770",
   "kr": "나는 산골 출신이니까."
  },
  "26": {
   "jp": "9c2939c4d9",
   "kr": "누구 딱 맞는 사람이 있으면"
  },
  "27": {
   "jp": "a9bbe62a69",
   "kr": "좋을 텐데."
  },
  "28": {
   "jp": "1192d13e37",
   "kr": "혹시 짚이는 분이 있으면 부탁드려요."
  },
  "29": {
   "jp": "eac22867c1",
   "kr": "그럼 실례할게요."
  },
  "30": {
   "jp": "1aae33391d",
   "kr": "그라면 어떨까."
  },
  "31": {
   "jp": "6d38f72328",
   "kr": "어머!"
  },
  "32": {
   "jp": "b1ecc703fc",
   "kr": "좋아요, 딱이에요."
  },
  "33": {
   "jp": "9a34c2b0e1",
   "kr": "어디로 보나 귀족이에요."
  },
  "34": {
   "jp": "5225a6b25c",
   "kr": "그럼 같이 아버지께 가요."
  },
  "35": {
   "jp": "e69d5f498a",
   "kr": "아버지."
  },
  "36": {
   "jp": "6e59897d4c",
   "kr": "그 혼담 말인데요."
  },
  "37": {
   "jp": "9ac4d3fbb2",
   "kr": "저한테는 어엿한 애인이 있어요."
  },
  "38": {
   "jp": "78c3c1fedc",
   "kr": "처, 처음 뵙겠습니다."
  },
  "39": {
   "jp": "12aebb8738",
   "kr": "콘로드 남작이라고 합니다."
  },
  "40": {
   "jp": "b8af902f11",
   "kr": "호오, 남작이라."
  },
  "41": {
   "jp": "eb59e016fe",
   "kr": "훌륭한 직함이지만 소중한 딸을 주는 이상"
  },
  "42": {
   "jp": "d309bdcf5e",
   "kr": "그대 개인의 힘도 알아 두고 싶소."
  },
  "43": {
   "jp": "d33702fde6",
   "kr": "지금 혼담을 진행 중인 뒤카 공작은"
  },
  "44": {
   "jp": "409a3b05f4",
   "kr": "유명한 창의 명수라던데…"
  },
  "45": {
   "jp": "0be48264ed",
   "kr": "그대는 어떻소?"
  },
  "46": {
   "jp": "a981b34758",
   "kr": "이 사람도 지지 않을 만큼 강해요!"
  },
  "47": {
   "jp": "0b7f5fe45a",
   "kr": "어, 아, 아니…"
  },
  "48": {
   "jp": "7cd3e653d1",
   "kr": "그렇소?"
  },
  "49": {
   "jp": "02e34032ce",
   "kr": "그럼 티아 다리 근처에 나타나는 마수를"
  },
  "50": {
   "jp": "94f6365d23",
   "kr": "쓰러뜨리는 것도 손쉬울 테지요."
  },
  "51": {
   "jp": "a237167bdd",
   "kr": "당연하죠!"
  },
  "52": {
   "jp": "bfe63d9d85",
   "kr": "에에엣!?"
  },
  "53": {
   "jp": "d8748f6903",
   "kr": "알겠소."
  },
  "54": {
   "jp": "9295f6812d",
   "kr": "훌륭히 마수를 해치운다면"
  },
  "55": {
   "jp": "a651321704",
   "kr": "딸과의 교제를 인정하겠소."
  },
  "56": {
   "jp": "9da5d5ee98",
   "kr": "힘내세요!"
  },
  "57": {
   "jp": "8d44d9f98c",
   "kr": "콘로드 님."
  },
  "58": {
   "jp": "23b8eb17a0",
   "kr": "일이 엄청나게 커져 버렸습니다."
  },
  "59": {
   "jp": "746057cd9e",
   "kr": "이미 시작한 일이야."
  },
  "60": {
   "jp": "a7c41c5b20",
   "kr": "티아 다리로 가 보자."
  },
  "61": {
   "jp": "457837f4dc",
   "kr": "결국 헛수고였던 건가."
  },
  "62": {
   "jp": "65719448d4",
   "kr": "아뇨, 그녀의 행복한 얼굴을 보십시오."
  },
  "63": {
   "jp": "c7add9cdf8",
   "kr": "잘된 일 아닙니까?"
  },
  "64": {
   "jp": "e3511831f0",
   "kr": "그러게."
  },
  "65": {
   "jp": "c2fb6a4f72",
   "kr": "좋아, 의뢰 완료다.",
   "auto": 1
  },
  "66": {
   "jp": "e69d5f498a",
   "kr": "아버지."
  },
  "67": {
   "jp": "6e579d49a6",
   "kr": "이제 불만 없으시죠?"
  },
  "68": {
   "jp": "5873c9bcb8",
   "kr": "물론이지."
  },
  "69": {
   "jp": "33123e5758",
   "kr": "콘로드 님,"
  },
  "70": {
   "jp": "d5b90df6bb",
   "kr": "딸을 잘 부탁하오."
  },
  "71": {
   "jp": "da2a3d969c",
   "kr": "실례합니다.",
   "auto": 1
  },
  "72": {
   "jp": "21b48e21a4",
   "kr": "여기가 아니타 씨의 댁입니까?"
  },
  "73": {
   "jp": "50acabd036",
   "kr": "네?"
  },
  "74": {
   "jp": "466a1214ff",
   "kr": "맞는데요."
  },
  "75": {
   "jp": "52c5fdb4d5",
   "kr": "아니, 뒤카 공작님!"
  },
  "76": {
   "jp": "2f596e9a72",
   "kr": "어쩐 일로 이런 곳까지 오셨습니까."
  },
  "77": {
   "jp": "ec455e8ce3",
   "kr": "아니, 개인적인 용무로 근처에 왔다가"
  },
  "78": {
   "jp": "ccfbe98d70",
   "kr": "미래의 신부 얼굴을 한번 보고 싶어서요."
  },
  "79": {
   "jp": "6aab8afb92",
   "kr": "…이분이 뒤카 공작?"
  },
  "80": {
   "jp": "f101a701c3",
   "kr": "어쩜 이렇게 멋진 분이…"
  },
  "81": {
   "jp": "12bf5e36f0",
   "kr": "그게 공작님, 안타깝게도"
  },
  "82": {
   "jp": "18e847c126",
   "kr": "딸에게는 어엿한 애인이…"
  },
  "83": {
   "jp": "59ba042428",
   "kr": "아니에요!"
  },
  "84": {
   "jp": "901328868e",
   "kr": "콘로드 님은, 저기…"
  },
  "85": {
   "jp": "59b64ca510",
   "kr": "일전에 처음 만난 분이에요."
  },
  "86": {
   "jp": "db7cac8a26",
   "kr": "뒤카 공작님이 어떤 분인지도"
  },
  "87": {
   "jp": "240e544380",
   "kr": "모르고 그저 거절하기 위해"
  },
  "88": {
   "jp": "c876384523",
   "kr": "알선소에 부탁한 거예요."
  },
  "89": {
   "jp": "8649b47aea",
   "kr": "그래서 저는 당신의 눈에"
  },
  "90": {
   "jp": "89ecab4577",
   "kr": "들었습니까?"
  },
  "91": {
   "jp": "085cf23bab",
   "kr": "물론이에요!"
  },
  "92": {
   "jp": "9eaf6052ea",
   "kr": "잘됐군요, 아니타 씨."
  },
  "93": {
   "jp": "8d44d9f98c",
   "kr": "콘로드 님."
  },
  "94": {
   "jp": "7a916f3b5c",
   "kr": "저, 뭐라고 말씀드려야 할지."
  },
  "95": {
   "jp": "47f1f68a51",
   "kr": "괜찮습니다."
  },
  "96": {
   "jp": "9eaf6052ea",
   "kr": "잘됐군요, 아니타 씨."
  },
  "97": {
   "jp": "b4480da735",
   "kr": "부디 행복하십시오."
  },
  "98": {
   "jp": "ccd014c0db",
   "kr": "오, 와 주었구려."
  },
  "99": {
   "jp": "00ad4f247b",
   "kr": "내가 알선소에 일을 의뢰한 노만이오."
  },
  "100": {
   "jp": "707bf6c136",
   "kr": "실은…"
  },
  "101": {
   "jp": "a3f1975b43",
   "kr": "조금 부끄러운 노인의 옛이야기네만"
  },
  "102": {
   "jp": "043cbc07fa",
   "kr": "부디 웃지 말고 들어 주시오."
  },
  "103": {
   "jp": "4c4406f084",
   "kr": "젊은 시절 나는 에밀리라는 처녀와"
  },
  "104": {
   "jp": "bc268107a6",
   "kr": "사랑을 했다네."
  },
  "105": {
   "jp": "69e0fd6055",
   "kr": "벌써 50년이나 지난 옛이야기일세."
  },
  "106": {
   "jp": "6f4f34ba6f",
   "kr": "그때는 마수도 별로 나오지 않아서"
  },
  "107": {
   "jp": "bea486ad80",
   "kr": "우리는 곧잘 비샤나 동굴에서 밀회를 했지."
  },
  "108": {
   "jp": "32709b8b5c",
   "kr": "물론 플라토닉한 사이였다네."
  },
  "109": {
   "jp": "94d751ff53",
   "kr": "서로 좋아한다는 말도 못 하고"
  },
  "110": {
   "jp": "1fe38ce894",
   "kr": "얼굴만 마주 봐도 행복해져서"
  },
  "111": {
   "jp": "b39da3bfd8",
   "kr": "늘 히죽거렸지."
  },
  "112": {
   "jp": "e6d154f376",
   "kr": "어느 날 나는 용기를 짜내어"
  },
  "113": {
   "jp": "2d255feb04",
   "kr": "에밀리가 돌아간 뒤"
  },
  "114": {
   "jp": "976a95e1b3",
   "kr": "동굴 벽에 청혼의 말을 새겼다네."
  },
  "115": {
   "jp": "8eb5ad0f7f",
   "kr": "입으로 말할 만한 용기는 없었거든."
  },
  "116": {
   "jp": "e277ebf7ee",
   "kr": "다음에 그녀가 왔을 때"
  },
  "117": {
   "jp": "0202df28d3",
   "kr": "그걸 보여 주려고 했지."
  },
  "118": {
   "jp": "ff2eb8e1d5",
   "kr": "그런데…"
  },
  "119": {
   "jp": "67dffc324d",
   "kr": "에밀리는 어딘가로 갑자기 이사해서"
  },
  "120": {
   "jp": "f36e1ca1e3",
   "kr": "그날 이후 행방을 알 수 없게 되고 말았네."
  },
  "121": {
   "jp": "036bedc4a9",
   "kr": "혹시 편지가 올지도 모른다거나"
  },
  "122": {
   "jp": "11d0fc342b",
   "kr": "어쩌면 나처럼 동굴 벽에"
  },
  "123": {
   "jp": "9d7f647183",
   "kr": "메시지를 남겼을지도 모른다거나…"
  },
  "124": {
   "jp": "cda1a25253",
   "kr": "처음에는 기대하고"
  },
  "125": {
   "jp": "f4eeed68cc",
   "kr": "이것저것 찾아다니기도 했지만"
  },
  "126": {
   "jp": "379f8b4b8e",
   "kr": "그럴싸한 것은 없었다네."
  },
  "127": {
   "jp": "9cd0fdbcb3",
   "kr": "젊은 날의 나에게는 충격이 커서 말이오."
  },
  "128": {
   "jp": "e74997471e",
   "kr": "그 뒤로 두 번 다시 비샤나 동굴에 가지 않았고"
  },
  "129": {
   "jp": "c4bb999bf4",
   "kr": "끝내 결혼도 하지 않았다네."
  },
  "130": {
   "jp": "83c0a54b98",
   "kr": "요즘 들어 부쩍"
  },
  "131": {
   "jp": "e375048558",
   "kr": "그 시절의 꿈을 자주 꾸게 되었네."
  },
  "132": {
   "jp": "243dae98ea",
   "kr": "다만 나이를 먹으면"
  },
  "133": {
   "jp": "941447eaa3",
   "kr": "기억에 자신이 없어지기도 해서 말이오."
  },
  "134": {
   "jp": "f2fafbfb18",
   "kr": "이것저것 생각하는 사이 그녀와 둘이서 보낸 나날이"
  },
  "135": {
   "jp": "d909b5765c",
   "kr": "내 머리가 지어낸 망상이고"
  },
  "136": {
   "jp": "0b4c32507a",
   "kr": "현실이 아니었던 게 아닌가 싶어졌소."
  },
  "137": {
   "jp": "4f2eeec8a3",
   "kr": "벽에 새긴 글자가 비샤나 동굴 안쪽에 있다면"
  },
  "138": {
   "jp": "1ef040a2d7",
   "kr": "그것이 현실이었음이 분명해지지."
  },
  "139": {
   "jp": "3d31a37bbb",
   "kr": "현실인가 망상인가?"
  },
  "140": {
   "jp": "0ef85f4c9f",
   "kr": "지금의 나는 그것만 알면 만족일세."
  },
  "141": {
   "jp": "5e44186cbf",
   "kr": "다만 예전과 달리"
  },
  "142": {
   "jp": "2f28e71c29",
   "kr": "비샤나 동굴에는 마수가 출몰하게 되었네."
  },
  "143": {
   "jp": "9b951e83bc",
   "kr": "그래서 알선소에 의뢰한 것이오."
  },
  "144": {
   "jp": "fa1f69ac48",
   "kr": "알았어.",
   "auto": 1
  },
  "145": {
   "jp": "4edcc84905",
   "kr": "할아버지가 50년 전에 새긴 글자가"
  },
  "146": {
   "jp": "6894940f04",
   "kr": "비샤나 동굴 안쪽 벽에 남아 있는지"
  },
  "147": {
   "jp": "f52d5abdf3",
   "kr": "확인하고 오면 되는 거지?"
  },
  "148": {
   "jp": "2bd7acc10f",
   "kr": "비샤나 동굴 안쪽에"
  },
  "149": {
   "jp": "7c4137cf62",
   "kr": "내가 새긴 글자가 있으면 현실이었음을 알 수 있지."
  },
  "150": {
   "jp": "f554778961",
   "kr": "미안하네."
  },
  "151": {
   "jp": "ba41b36c51",
   "kr": "늙은이의 추억에 어울려 주게."
  },
  "152": {
   "jp": "c2ddc51676",
   "kr": "사랑은 지난날의 환영이 아니라고 믿고 싶다네."
  },
  "153": {
   "jp": "1baac8ab90",
   "kr": "오, 어떻게 되었나."
  },
  "154": {
   "jp": "0d2be7268a",
   "kr": "각오는 되어 있소."
  },
  "155": {
   "jp": "9d6a040b76",
   "kr": "벽에 내가 새긴 글자가 있었는지 없었는지."
  },
  "156": {
   "jp": "01f942f485",
   "kr": "그것만 알려 주시오."
  },
  "157": {
   "jp": "50e43bf357",
   "kr": "영감님이 새긴 글자는 없었어."
