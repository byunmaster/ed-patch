 "segments": {
  "0": {
   "jp": "ad25c7ed75",
   "kr": "흥,"
  },
  "1": {
   "jp": "d042a3ff65",
   "kr": "제법 성가시게 구는군…"
  },
  "2": {
   "jp": "7e0cce8ee8",
   "kr": "(…오빠… 카베사와 쿠에르포를…)"
  },
  "3": {
   "jp": "0bdbd7920e",
   "kr": "(그래, 볼게이드는 나와 마일이 끌어들이겠다…)"
  },
  "4": {
   "jp": "5319423c28",
   "kr": "네 마음대로는 안 둬!!"
  },
  "5": {
   "jp": "60be21bfe2",
   "kr": "이놈, 계집애가!"
  },
  "6": {
   "jp": "50865e607f",
   "kr": "무슨 짓이야!"
  },
  "7": {
   "jp": "2a5ed30772",
   "kr": "아이멜!!"
  },
  "8": {
   "jp": "894aa4513b",
   "kr": "으… 윽…"
  },
  "9": {
   "jp": "740645341d",
   "kr": "마일…!!"
  },
  "10": {
   "jp": "6ed08ec0d0",
   "kr": "마, 마일 씨…"
  },
  "11": {
   "jp": "f2888e973b",
   "kr": "마일…"
  },
  "12": {
   "jp": "2dbfa882b4",
   "kr": "…잘도…"
  },
  "13": {
   "jp": "f55e2026f5",
   "kr": "…잘도 마일을…"
  },
  "14": {
   "jp": "8d3b9fa903",
   "kr": "흥…"
  },
  "15": {
   "jp": "2ccffd01d7",
   "kr": "일일이 감상에 젖는 장면 따위 보고 싶지 않다."
  },
  "16": {
   "jp": "491fac0b35",
   "kr": "귀찮군. 단숨에 저승으로 보내 주마."
  },
  "17": {
   "jp": "afa65aad24",
   "kr": "꺄아악!!"
  },
  "18": {
   "jp": "52e138aa04",
   "kr": "으으…"
  },
  "19": {
   "jp": "53f3d7c6dc",
   "kr": "음, 누구냐?!"
  },
  "20": {
   "jp": "9a4ab167c9",
   "kr": "내 마탄을 가로막다니…!"
  },
  "21": {
   "jp": "13ff6d568b",
   "kr": "뭐냐… 누구의 힘이지?"
  },
  "22": {
   "jp": "02c8204ff7",
   "kr": "목소리",
   "auto": 1
  },
  "23": {
   "jp": "f9af938c61",
   "kr": "아무래도 당신은 나쁜 사람인 듯하군요."
  },
  "24": {
   "jp": "09b8f882a9",
   "kr": "저는 신보의 가치를 모르지만,"
  },
  "25": {
   "jp": "bc3bdb99bc",
   "kr": "당신 뜻대로 하게 두지 않는 편이 좋겠군요."
  },
  "26": {
   "jp": "9b76c67258",
   "kr": "네놈, 누구냐…?"
  },
  "27": {
   "jp": "9490e02382",
   "kr": "지나가는 나그네예요."
  },
  "28": {
   "jp": "4b046d6bf8",
   "kr": "뭐, 뭐냐?!"
  },
  "29": {
   "jp": "f5ce49c36b",
   "kr": "목숨은 빼앗지 않아요."
  },
  "30": {
   "jp": "024ec15a09",
   "kr": "사정을 잘 모르니까요."
  },
  "31": {
   "jp": "6a8791f63b",
   "kr": "하지만 사악한 기운을 느껴서"
  },
  "32": {
   "jp": "d3a796ef7a",
   "kr": "잠시 이 자리에서 물러나 주셨어요."
  },
  "33": {
   "jp": "8212b174a5",
   "kr": "실례.",
   "auto": 1
  },
  "34": {
   "jp": "79ae7ca017",
   "kr": "전원을 구하지는 못했군요."
  },
  "35": {
   "jp": "5b46aa5f0c",
   "kr": "음? 저주받은 사람도 있나…"
  },
  "36": {
   "jp": "7da0ffbf27",
   "kr": "안타깝지만 이 저주는 제 힘으로는 어쩔 수 없겠군요."
  },
  "37": {
   "jp": "0d909bfd0b",
   "kr": "으… 으윽…"
  },
  "38": {
   "jp": "d2b8dbe6ee",
   "kr": "어라? 정신이 든 모양이군요."
  },
  "39": {
   "jp": "127b50438a",
   "kr": "슬슬 물러나야겠네요…"
  },
  "40": {
   "jp": "679cd89851",
   "kr": "제게도 제 목적이 있고,"
  },
  "41": {
   "jp": "6683ba724d",
   "kr": "너무 개입하지 않는 편이 좋을 듯하니까요."
  },
  "42": {
   "jp": "b7f4f7cf2f",
   "kr": "만약을 위해…"
  },
  "43": {
   "jp": "1cf15c4f73",
   "kr": "현자 가웨인에게는 이 일을 알려 두도록 하죠."
  },
  "44": {
   "jp": "6a9e06eee3",
   "kr": "(…오빠…"
  },
  "45": {
   "jp": "4481232b82",
   "kr": "카베사와 쿠에르포를…)"
  },
  "46": {
   "jp": "40963acfb6",
   "kr": "(응, 볼게이드는 나랑"
  },
  "47": {
   "jp": "78ed365507",
   "kr": "마일이 붙잡아 둘게…)"
  }
 }
