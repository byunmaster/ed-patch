 "segments": {
  "0": {
   "jp": "5cc955205b",
   "kr": "곤란한 일이라도 있으신가요?"
  },
  "1": {
   "jp": "9c75898dcd",
   "kr": "제 지식이 도움이 될 일이라면"
  },
  "2": {
   "jp": "b4bc9a15c6",
   "kr": "힘이 되어 드릴게요."
  },
  "3": {
   "jp": "2f16805c7d",
   "kr": "게다가 이래 봬도"
  },
  "4": {
   "jp": "24b81e5402",
   "kr": "흑마법 쪽도"
  },
  "5": {
   "jp": "e9d5d1c301",
   "kr": "꽤 쓸 만해요."
  },
  "6": {
   "jp": "2689d38ed5",
   "kr": "제 힘이 필요할 때는"
  },
  "7": {
   "jp": "93be253945",
   "kr": "사양 말고 말씀하세요."
  },
  "8": {
   "jp": "5e43a6f88f",
   "kr": "다만 갖추고 싶은 서적이 있어서"
  },
  "9": {
   "jp": "77a9d872a6",
   "kr": "500로제 정도의 계약금을 주시면"
  },
  "10": {
   "jp": "3116bcaee5",
   "kr": "감사하겠습니다만…"
  },
  "11": {
   "jp": "3977c569ae",
   "kr": "또 찾아와 주다니 영광인걸."
  },
  "12": {
   "jp": "9c75898dcd",
   "kr": "제 지식이 도움이 될 일이라면"
  },
  "13": {
   "jp": "b4bc9a15c6",
   "kr": "힘이 되어 드릴게요."
  },
  "14": {
   "jp": "4d251ec40f",
   "kr": "을(를) 일행에 넣겠습니까?"
  },
  "15": {
   "jp": "96d71611d4",
   "kr": "정말이야?"
  },
  "16": {
   "jp": "f2fd86c61b",
   "kr": "정말 고마워."
  },
  "17": {
   "jp": "856075335d",
   "kr": "뭐니 뭐니 해도"
  },
  "18": {
   "jp": "91bf34ada1",
   "kr": "계속 지식을 찾아 여행하고 있잖아."
  },
  "19": {
   "jp": "99349c8c04",
   "kr": "만년 고학생 같은 거야."
  },
  "20": {
   "jp": "ee5e859a0d",
   "kr": "아, 다행이다."
  },
  "21": {
   "jp": "c45a17bd65",
   "kr": "정말 큰 도움이 돼."
  },
  "22": {
   "jp": "08e61e71af",
   "kr": "아쉽지만 주머니 사정이 쓸쓸한 모양이네."
  },
  "23": {
   "jp": "5cc154b391",
   "kr": "새로운 여행에서 어떤 발견이 있을지 기대돼요."
  },
  "24": {
   "jp": "1ff7f83512",
   "kr": "어라…?"
  },
  "25": {
   "jp": "a212a6f783",
   "kr": "하지만 너희 일행은"
  },
  "26": {
   "jp": "07e488e192",
   "kr": "인원이 충분한 것 같네."
  },
  "27": {
   "jp": "8d92b195e2",
   "kr": "나를 넣어 주려면"
  },
  "28": {
   "jp": "372dc57618",
   "kr": "누군가와 헤어진 뒤에 불러 줘."
  },
  "29": {
   "jp": "5f0825e716",
   "kr": "지금은"
  },
  "30": {
   "jp": "697a4422a5",
   "kr": "도움이 필요 없는 모양이네."
  },
  "31": {
   "jp": "2fb075426b",
   "kr": "당분간 여기 머물며"
  },
  "32": {
   "jp": "24517bb8c3",
   "kr": "공부할 생각이니까"
  },
  "33": {
   "jp": "df669a1a19",
   "kr": "언제든 불러 주세요."
  },
  "34": {
   "jp": "ed1b9cb7bf",
   "kr": "이(가) 일행에 합류했다."
  }
 }
