  "0": {
   "jp": "1e195f6292",
   "kr": "섀넌",
   "auto": 1
  },
  "1": {
   "jp": "93f41dc8e2",
   "kr": "어빈, 봐! 사람이 쓰러져 있어."
  },
  "2": {
   "jp": "298978dced",
   "kr": "니레 씨가 말하던 아이 아닐까?"
  },
  "3": {
   "jp": "108df5108b",
   "kr": "마수에게 당한 건가?"
  },
  "4": {
   "jp": "b7643bdb30",
   "kr": "아, 아아…!?"
  },
  "5": {
   "jp": "2a4bd7fd48",
   "kr": "샤, 섀넌이잖아…"
  },
  "6": {
   "jp": "7e4f337ee9",
   "kr": "…이건 꿈?"
  },
  "7": {
   "jp": "1b69e69d43",
   "kr": "마… 마일 님이…"
  },
  "8": {
   "jp": "5d9d48adbe",
   "kr": "아니면 마일 님을 닮은 천사님?"
  },
  "9": {
   "jp": "406ae890a3",
   "kr": "설마…"
  },
  "10": {
   "jp": "6847ee0c80",
   "kr": "산포도를 따러 갔다 안 돌아온다는"
  },
  "11": {
   "jp": "fd95e178e0",
   "kr": "섀넌을 말하는 건가?"
  },
  "12": {
   "jp": "d489b7227e",
   "kr": "그렇다면"
  },
  "13": {
   "jp": "d97c15a80b",
   "kr": "애인을 찾고 있다는 것도… 이 아이?"
  },
  "14": {
   "jp": "a1e38e3107",
   "kr": "애인이라니, 누구?"
  },
  "15": {
   "jp": "d69bab4741",
   "kr": "어…?"
  },
  "16": {
   "jp": "a939828666",
   "kr": "역시 제 점이 맞았네요."
  },
  "17": {
   "jp": "c2ddd44b32",
   "kr": "제가 위험할 때는"
  },
  "18": {
   "jp": "1e184a7c10",
   "kr": "꼭 마일 님이 와 주시죠."
  },
  "19": {
   "jp": "18cee35beb",
   "kr": "믿고 있었어요, 마일 님."
  },
  "20": {
   "jp": "fc54ae88ee",
   "kr": "그렇게 마음대로 믿으면 곤란한데…"
  },
  "21": {
   "jp": "27cf567dc1",
   "kr": "마수에게 습격당했어?"
  },
  "22": {
   "jp": "837b79d697",
   "kr": "아니요."
  },
  "23": {
   "jp": "82af479070",
   "kr": "어디 다친 곳이 있니?"
  },
  "24": {
   "jp": "837b79d697",
   "kr": "아니요."
  },
  "25": {
   "jp": "582abdd8e6",
   "kr": "마일 님, 저를 걱정해 주시다니"
  },
  "26": {
   "jp": "73741fa115",
   "kr": "상냥하세요."
  },
  "27": {
   "jp": "555e14427c",
   "kr": "아픈 건 마음뿐이에요."
  },
  "28": {
   "jp": "763bf37c43",
   "kr": "그럼 다친 데는 없는 거구나."
  },
  "29": {
   "jp": "9bd8c4b98e",
   "kr": "마일 님을 만난 것만으로"
  },
  "30": {
   "jp": "f0f5be3db6",
   "kr": "섀넌은 만족해요…"
  },
  "31": {
   "jp": "30da6e35f9",
   "kr": "저, 마일 님을 찾아서…"
  },
  "32": {
   "jp": "025dcaca29",
   "kr": "…아아…"
  },
  "33": {
   "jp": "f546b2e8be",
   "kr": "아… 섀넌?"
  },
  "34": {
   "jp": "3b2ed67302",
   "kr": "큰일이야, 마일."
  },
  "35": {
   "jp": "9c22576251",
   "kr": "서둘러 치료하지 않으면 위험할지도…"
  },
  "36": {
   "jp": "10fcac1745",
   "kr": "일단 니레 씨 댁으로 데려가자."
  },
  "37": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "38": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다.",
   "auto": 1
  },
  "39": {
   "jp": "889ceea3f2",
   "kr": "보물상자에는 "
  },
  "40": {
   "jp": "665e4d5705",
   "kr": "이(가) 들어 있다.",
   "auto": 1
  },
  "41": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "42": {
   "jp": "f5fc3dee34",
   "kr": "을(를) 포기했다.",
   "auto": 1
  },
  "43": {
   "jp": "63c4c357c2",
   "kr": "보물상자에는 아무것도 들어 있지 않다."
  }
 }
