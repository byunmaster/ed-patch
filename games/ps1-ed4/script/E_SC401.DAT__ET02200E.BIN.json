{
 "archive": "/E/SC401.DAT",
 "member": "..\\BIN\\ET02200E.BIN",
 "segments": {
  "0": {
   "jp": "3be219cdc2",
   "kr": "오오, 어빈. 잘 돌아왔소."
  },
  "1": {
   "jp": "e15ae6e6f1",
   "kr": "정령 자르를 만나 네 개의 신보가 모두 모였어요."
  },
  "2": {
   "jp": "8dbc0c306c",
   "kr": "이로써 카베사와 쿠에르포를 합쳐 여섯 개."
  },
  "3": {
   "jp": "2435e657f2",
   "kr": "발두스 신의 신보가 마침내 모두 모였는가…"
  },
  "4": {
   "jp": "17bf489d71",
   "kr": "전승에 따르면 신들의 다툼 때"
  },
  "5": {
   "jp": "01e2619e19",
   "kr": "발두스 신이 그 몸을 부수고 영원한 결계를 쳐서"
  },
  "6": {
   "jp": "3ccfcc64bb",
   "kr": "봉인의 땅에 오크툼 신을 가뒀다고 하는데…."
  },
  "7": {
   "jp": "68b6d95604",
   "kr": "정령들을 만나고 알게 됐어요."
  },
  "8": {
   "jp": "cbee7573fc",
   "kr": "사교도는 오크툼 신을 되살리려고"
  },
  "9": {
   "jp": "3c8625ec32",
   "kr": "오크툼 신을 봉인한 여섯 개의 신보를 확보함으로써"
  },
  "10": {
   "jp": "375df337b7",
   "kr": "봉인의 힘을 무력화하려던 거야."
  },
  "11": {
   "jp": "aba884663c",
   "kr": "하지만 놈들은 사정령의 사당은 찾아냈어도"
  },
  "12": {
   "jp": "cc108d581a",
   "kr": "사정령을 쓰러뜨리지는 못했어."
  },
  "13": {
   "jp": "62001658b3",
   "kr": "그래서 신보를 모으지 못하고"
  },
  "14": {
   "jp": "9cd8041709",
   "kr": "대신 사정령에게 저주를 걸어 부림으로써"
  },
  "15": {
   "jp": "e806dbe81f",
   "kr": "방해되는 우리를 죽일 셈이었던 거야."
  },
  "16": {
   "jp": "952a79ce23",
   "kr": "하지만 그것만이 아니야."
  },
  "17": {
   "jp": "6d76d0b792",
   "kr": "신보가 우리 손에 넘어가는 걸 두려워한 데는"
  },
  "18": {
   "jp": "339c75a0c9",
   "kr": "또 다른 이유가 있었어."
  },
  "19": {
   "jp": "917af69e51",
   "kr": "지금까지 말하지 않았지만"
  },
  "20": {
   "jp": "adacf87e29",
   "kr": "정신전의 문외불출 문헌에는 이렇게 적혀 있다."
  },
  "21": {
   "jp": "7d21ef6e51",
   "kr": "다시 대지에 사신 오크툼이 눈뜰 때"
  },
  "22": {
   "jp": "e5c5a1787b",
   "kr": "혼을 검으로 삼아 휘두르는 자는 대지의 사람이니라."
  },
  "23": {
   "jp": "192043355b",
   "kr": "그 검의 이름은 엘리시온."
  },
  "24": {
   "jp": "2a86a5f2e8",
   "kr": "발두스 신의 힘이 깃든 봉인의 검이니라."
  },
  "25": {
   "jp": "96a98ecdbc",
   "kr": "신이 사람에게 이르길,"
  },
  "26": {
   "jp": "49bbfb6460",
   "kr": "그날로써 사람이 둥지를 떠나는 시작으로 삼으리라."
  },
  "27": {
   "jp": "6f32725931",
   "kr": "엘리시온…."
  },
  "28": {
   "jp": "76931e54e4",
   "kr": "여섯 신보는 모였소."
  },
  "29": {
   "jp": "e4f7795861",
   "kr": "카테드랄의 제단에서 기도를 올리면"
  },
  "30": {
   "jp": "d4c55c85a5",
   "kr": "발두스의 혼은 엘리시온이 될 것이오."
  },
  "31": {
   "jp": "dd22976218",
   "kr": "자, 어쩌겠는가, 어빈?"
  },
  "32": {
   "jp": "90231f2f78",
   "kr": "정해져 있어."
  },
  "33": {
   "jp": "16c6d6165b",
   "kr": "놈들이 포기한 신보의 힘을 써서"
  },
  "34": {
   "jp": "d18cb35f2f",
   "kr": "오크툼 신을 완전히 소멸시켜 버리겠어."
  },
  "35": {
   "jp": "c4d00a99dd",
   "kr": "신보를 내게 넘긴 걸 후회하게 해 주겠어…."
  },
  "36": {
   "jp": "f36b0e1f6b",
   "kr": "놈들이 카테드랄에 있다면"
  },
  "37": {
   "jp": "fc1c67393b",
   "kr": "이번에는 이쪽에서 쳐들어가 주마!"
  },
  "38": {
   "jp": "0fc378d40f",
   "kr": "어빈. 마음이 험해졌구려."
  },
  "39": {
   "jp": "bf563269c2",
   "kr": "그런 마음으로는 정령들의 가호를 얻지 못하오."
  },
  "40": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "41": {
   "jp": "a3a5d531ee",
   "kr": "아마 사정령의 가호는 신보 자체의 힘과는"
  },
  "42": {
   "jp": "ca7d643717",
   "kr": "다른 것이리라."
  },
  "43": {
   "jp": "748735cca4",
   "kr": "지금 그대에게 정말 필요한 것은"
  },
  "44": {
   "jp": "c1894a1260",
   "kr": "오히려 그쪽이 아닐까 나는 느끼고 있었소."
  },
  "45": {
   "jp": "bbb4b55c23",
   "kr": "그래서 엘리시온에 대해 입을 다물고 있었던 것이다."
  },
  "46": {
   "jp": "54cf3f3bb7",
   "kr": "하지만… 마음에 사무친 원한은…"
  },
  "47": {
   "jp": "2fbe78788c",
   "kr": "…나로서도… 어쩔 수 없어…."
  },
  "48": {
   "jp": "dddd29580a",
   "kr": "…어빈.",
   "auto": 1
  },
  "49": {
   "jp": "8f16a76cc7",
   "kr": "아이멜의 원한… 마일의 원한…"
  },
  "50": {
   "jp": "a7cccb63ef",
   "kr": "사교도에게 죽은 이름도 모를 사람들의 원한도…"
  },
  "51": {
   "jp": "be245e2ef3",
   "kr": "이제 내 마음에서 몰아낼 수 없어."
  },
  "52": {
   "jp": "60b6a4dc81",
   "kr": "나는 이제 내 방식대로 결판을 낼 수밖에 없어."
  },
  "53": {
   "jp": "f329b37d1c",
   "kr": "최고 도사 크로웰은 조용히 이야기하기 시작했다."
  },
  "54": {
   "jp": "38aac587e0",
   "kr": "사정령의 별칭은 저마다의 역할에 따라 이렇게 불린다."
  },
  "55": {
   "jp": "941dc56bbf",
   "kr": "회춘의 이둔. 검은 죽음의 스코티아."
  },
  "56": {
   "jp": "183138ceb9",
   "kr": "명계의 네프티스."
  },
  "57": {
   "jp": "cff432dc9b",
   "kr": "그리고 명부의 파수꾼 자르."
  },
  "58": {
   "jp": "e894ce3710",
   "kr": "즉 모든 의미에서 인간의 죽음을 관장하는 존재요."
  },
  "59": {
   "jp": "df455d58ab",
   "kr": "인간의 죽음을… 관장하는 존재…."
  },
  "60": {
   "jp": "3421e488f8",
   "kr": "이것은 나의 상상일 뿐이지만"
  },
  "61": {
   "jp": "85a2b43b40",
   "kr": "신보를 받아 사정령에게 인정받았다는 것은"
  },
  "62": {
   "jp": "e6e891b9df",
   "kr": "사정령을 벗으로 삼았다는 뜻이오."
  },
  "63": {
   "jp": "6c56b32b33",
   "kr": "남은 건 사정령을 아우르는 정령신 둘가에게 인정받으면"
  },
  "64": {
   "jp": "bd83cb8a67",
   "kr": "정령들의 힘을 빌릴 수 있을지도 모르오."
  },
  "65": {
   "jp": "7e7dbdbe23",
   "kr": "그 힘이란 아마도… 죽음을 초월하는 힘이오."
  },
  "66": {
   "jp": "44eb515820",
   "kr": "예를 들면…"
  },
  "67": {
   "jp": "a80f8d7d17",
   "kr": "죽은 사람을 되살리는 것 같은…?"
  },
  "68": {
   "jp": "88ee713f01",
   "kr": "거기까지는 알 수 없소."
  },
  "69": {
   "jp": "979d7008c9",
   "kr": "어쩌면 인간이 가져서는 안 될, 공포에 떨게 할"
  },
  "70": {
   "jp": "cb3e797113",
   "kr": "무서운 힘일지도 모르오."
  },
  "71": {
   "jp": "101e8144b1",
   "kr": "만약 내게 그 힘이 주어진다면"
  },
  "72": {
   "jp": "1344da8715",
   "kr": "나는… 마일이나… 아이멜을…."
  },
  "73": {
   "jp": "445f0e41e2",
   "kr": "하지만 정령신 둘가에게 인정받는 일은"
  },
  "74": {
   "jp": "78fae34673",
   "kr": "여간해서는 이룰 수 없을 것이오."
  },
  "75": {
   "jp": "64f26b11a6",
   "kr": "적어도 사사로운 원한에 시달리는 마음으로는"
  },
  "76": {
   "jp": "7458fcad92",
   "kr": "가호를 얻지 못하오."
  },
  "77": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "78": {
   "jp": "ce508a1495",
   "kr": "그렇다고는 해도… 발두스 신의 신보가 모인 것은"
  },
  "79": {
   "jp": "fc2a92c8c4",
   "kr": "그대의 노력 덕분이오."
  },
  "80": {
   "jp": "ba917d23cc",
   "kr": "여섯 신보의 사용법은 그대에게 맡기겠소."
  },
  "81": {
   "jp": "7f94a48291",
   "kr": "카베사와 쿠에르포도"
  },
  "82": {
   "jp": "b0d3c5d665",
   "kr": "그대가 가지고 있는 편이 좋겠소."
  },
  "83": {
   "jp": "e9d8d3aaf2",
   "kr": "나도 그대에게 이 대지의 미래를 맡기겠소."
  },
  "84": {
   "jp": "0405f14e38",
   "kr": "오크툼 신을 봉인하고 있는"
  },
  "85": {
   "jp": "61c254af45",
   "kr": "여섯 개의 신보를 확보함으로써"
  },
  "86": {
   "jp": "828e373a42",
   "kr": "정신전에 전해지는 문외불출의"
  },
  "87": {
   "jp": "3c29f1898b",
   "kr": "문헌에는 이렇게 적혀 있소."
  },
  "88": {
   "jp": "2d8d5012d6",
   "kr": "그래서 나는"
  },
  "89": {
   "jp": "06a6ab2451",
   "kr": "엘리시온에 대해 말하지 않았던 것이오."
  },
  "90": {
   "jp": "812a598c5c",
   "kr": "사정령의 별칭은"
  },
  "91": {
   "jp": "2c06af1f53",
   "kr": "저마다의 역할에서 이렇게 불리고 있소."
  },
  "92": {
   "jp": "dbf6c96211",
   "kr": "이제 사정령을 거느리는"
  },
  "93": {
   "jp": "44265a5d0d",
   "kr": "정령신 둘가에게 인정받는다면"
  }
 }
}
