 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT01000J.BIN",
 "segments": {
  "0": {
   "jp": "3a53ff7606",
   "kr": "오, 자네가 짐을 운반해 주는"
  },
  "1": {
   "jp": "88fb1d144b",
   "kr": "사람인가."
  },
  "2": {
   "jp": "68485a9d92",
   "kr": "짐은 이 수정구일세."
  },
  "3": {
   "jp": "e1433ad5ef",
   "kr": "보른까지 가져다주게."
  },
  "4": {
   "jp": "2d923f4270",
   "kr": "마법 길드에 베키라는 아가씨가 있네."
  },
  "5": {
   "jp": "0d6201eabf",
   "kr": "그 아가씨에게 전해 주었으면 하네."
  },
  "6": {
   "jp": "cd34025e16",
   "kr": "랑에게서 작은 수정구를 맡았다."
  },
  "7": {
   "jp": "880f3ebd19",
   "kr": "영감에게서 온 기념품이라고 전해 주게."
  },
  "8": {
   "jp": "d8cce1bc53",
   "kr": "잘 부탁하네."
  },
  "9": {
   "jp": "ede1b56cab",
   "kr": "짐이 가득한 모양이군."
  },
  "10": {
   "jp": "c206f4dbb0",
   "kr": "짐을 정리하고 나서",
   "auto": 1
  },
  "11": {
   "jp": "ff10313b71",
   "kr": "다시 와 주지 않겠나."
  },
  "12": {
   "jp": "463ad48c13",
   "kr": "전할 곳은 보른의 베키."
  },
  "13": {
   "jp": "7bb4d5ee89",
   "kr": "마법 길드에 있을 걸세."
  },
  "14": {
   "jp": "d8cce1bc53",
   "kr": "잘 부탁하네."
  },
  "15": {
   "jp": "3e4ff8298e",
   "kr": "오! 왔군."
  },
  "16": {
   "jp": "65ef1705c0",
   "kr": "여, 다론 씨 맞죠?"
  },
  "17": {
   "jp": "8f870f9f06",
   "kr": "쉿!"
  },
  "18": {
   "jp": "40c17408cb",
   "kr": "안 돼. 그렇게 큰 소리를 내면."
  },
  "19": {
   "jp": "864322aea1",
   "kr": "자네인가. 짐을 운반해 주는 사람이."
  },
  "20": {
   "jp": "da7e5a2eba",
   "kr": "꽤 젊군… 뭐, 좋아."
  },
  "21": {
   "jp": "e8e88aef61",
   "kr": "운반해 줬으면 하는 건 이거야."
  },
  "22": {
   "jp": "a2a6ee9cda",
   "kr": "다론의 짐을 받았다."
  },
  "23": {
   "jp": "ad40a72557",
   "kr": "안에서 찰랑찰랑 소리가 난다."
  },
  "24": {
   "jp": "838d3de89c",
   "kr": "이런, 조심해 줘."
  },
  "25": {
   "jp": "4b31656499",
   "kr": "그 물건은 이제 여기 있는 것밖에"
  },
  "26": {
   "jp": "6aa253ddc0",
   "kr": "남아 있지 않으니까."
  },
  "27": {
   "jp": "8679cbc025",
   "kr": "발크드의 젠이라는 남자에게 전해 줘."
  },
  "28": {
   "jp": "4c98bf7279",
   "kr": "알겠지. 절대 남에게 말하면 안 돼."
  },
  "29": {
   "jp": "825a692e60",
   "kr": "이 짐은 남에게는 비밀이야."
  },
  "30": {
   "jp": "288b1eed84",
   "kr": "알았지."
  },
  "31": {
   "jp": "5b010a8b0e",
   "kr": "그만큼 귀중한 물건이니까."
  },
  "32": {
   "jp": "463937e08f",
   "kr": "잘 부탁해."
  },
  "33": {
   "jp": "d85dc953b7",
   "kr": "짐이 가득한 모양이군."
  },
  "34": {
   "jp": "c206f4dbb0",
   "kr": "짐을 정리하고 나서",
   "auto": 1
  },
  "35": {
   "jp": "69a0515e4a",
   "kr": "다시 와 주겠나?",
   "auto": 1
  },
  "36": {
   "jp": "77fc95002d",
   "kr": "전할 곳은 발크드의 젠."
  },
  "37": {
   "jp": "463937e08f",
   "kr": "잘 부탁해."
  },
  "38": {
   "jp": "2a2321c557",
   "kr": "콜록콜록."
  },
  "39": {
   "jp": "077524bb1d",
   "kr": "알선소에서 와 준 거로군."
  },
  "40": {
   "jp": "531c528555",
   "kr": "이 검을 전해 줬으면 하네."
  },
  "41": {
   "jp": "b32e35da8c",
   "kr": "이건 우리 가문에 대대로 전해 내려온"
  },
  "42": {
   "jp": "64bef89dff",
   "kr": "검이라네… 콜록콜록."
  },
  "43": {
   "jp": "765262a841",
   "kr": "에리트의 짐을 맡았다."
  },
  "44": {
   "jp": "f5af343b8a",
   "kr": "사정이 있어 한 번은 손에서 놓았지만"
  },
  "45": {
   "jp": "0c6a594ca0",
   "kr": "나는 이 가보를 되찾으려고"
  },
  "46": {
   "jp": "1f01cbf165",
   "kr": "십 년 남짓을 들여 쫓아왔다네."
  },
  "47": {
   "jp": "eaaa869d58",
   "kr": "겨우 되사 올 수 있었으니"
  },
  "48": {
   "jp": "c83249a824",
   "kr": "이걸 바로아에서 술집을 하는"
  },
  "49": {
   "jp": "004efb9fe0",
   "kr": "형님께 전해 주게."
  },
  "50": {
   "jp": "250b6e3f09",
   "kr": "콜록콜록."
  },
  "51": {
   "jp": "e92ccd379c",
   "kr": "자네 같은 믿음직한 젊은이라면 괜찮을 걸세."
  },
  "52": {
   "jp": "30f4eeecac",
   "kr": "잘 부탁하네. 콜록콜록."
  },
  "53": {
   "jp": "4dafc2461e",
   "kr": "짐이 가득한 것 같군.",
   "auto": 1
  },
  "54": {
   "jp": "c206f4dbb0",
   "kr": "짐을 정리하고 나서",
   "auto": 1
  },
  "55": {
   "jp": "69a0515e4a",
   "kr": "다시 와 주겠나?",
   "auto": 1
  },
  "56": {
   "jp": "a83cd2aba7",
   "kr": "전할 곳은 바로아 술집 주인일세."
  },
  "57": {
   "jp": "b596c9c07b",
   "kr": "잘 부탁하네. 콜록콜록."
  },
  "58": {
   "jp": "0a327bcd66",
   "kr": "짐을 운반해 줄 사람이구나.",
   "auto": 1
  },
  "59": {
   "jp": "90e7dddcaf",
   "kr": "필딘 마을에"
  },
  "60": {
   "jp": "7c754e7272",
   "kr": "아주 오래 못 만난 친구가 있어."
  },
  "61": {
   "jp": "aea8517f49",
   "kr": "정말 사소한 일로 싸우게 돼서"
  },
  "62": {
   "jp": "4b12fe7fa8",
   "kr": "그 뒤로 내가 이 뉴보른으로"
  },
  "63": {
   "jp": "5108ab8092",
   "kr": "이사 온 뒤로 쭉 못 만났어."
  },
  "64": {
   "jp": "90383c7e85",
   "kr": "화해하고 싶다고 생각했지만"
  },
  "65": {
   "jp": "a9aa17005b",
   "kr": "좀처럼 기회가 없었거든…"
  },
  "66": {
   "jp": "5c149ff2ea",
   "kr": "그 친구 생일에 선물을 보내려고"
  },
  "67": {
   "jp": "58b7a5a44e",
   "kr": "생각했어."
  },
  "68": {
   "jp": "05af02017d",
   "kr": "전해 줬으면 하는 물건은 이거야."
  },
  "69": {
   "jp": "fcca79c321",
   "kr": "지나에게서 작은 손거울을 맡았다."
  },
  "70": {
   "jp": "0d1a3a5fbb",
   "kr": "전할 곳은 필딘의 휴이라는 여자애야."
  },
  "71": {
   "jp": "07adc2631f",
   "kr": "집은 무기점을 하고 있어. 부탁해."
  },
  "72": {
   "jp": "b7dbee924e",
   "kr": "네가 짐을 운반해 주는 거야?"
  },
  "73": {
   "jp": "48ec4eb238",
   "kr": "하지만 짐이 가득한 것 같네."
  },
  "74": {
   "jp": "ba1671c5dd",
   "kr": "짐을 정리하고 나서 다시 와 줄래?"
  },
  "75": {
   "jp": "d11da0cc46",
   "kr": "전할 곳은 필딘의 휴이야."
  },
  "76": {
   "jp": "07d01fa5e8",
   "kr": "무기점에 있으니 금방 알 거야."
  },
  "77": {
   "jp": "f6145ab689",
   "kr": "부탁해."
  },
  "78": {
   "jp": "aee80b0b77",
   "kr": "전할 곳은 필딘의"
  },
  "79": {
   "jp": "82588fd141",
   "kr": "휴이라는 여자애야."
  }
 }
