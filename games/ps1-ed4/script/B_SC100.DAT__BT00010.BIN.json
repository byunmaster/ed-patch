{
 "archive": "/B/SC100.DAT",
 "member": "..\\BIN\\BT00010.BIN",
 "segments": {
  "0": {
   "jp": "433a8d0477",
   "kr": "베키"
  },
  "1": {
   "jp": "fa4eeeaa0d",
   "kr": "여관 안주인"
  },
  "2": {
   "jp": "81f395be89",
   "kr": "마법 길드원",
   "auto": 1
  },
  "3": {
   "jp": "d26d7daaf7",
   "kr": "용건이 있으시면"
  },
  "4": {
   "jp": "2cfd820007",
   "kr": "카운터로 와 주세요."
  },
  "5": {
   "jp": "534df92110",
   "kr": "마음이 바뀌면 데리러 오세요."
  },
  "6": {
   "jp": "91489c557b",
   "kr": "당분간은 이 마을에 있을 생각이니까요."
  },
  "7": {
   "jp": "aabe961671",
   "kr": "가까운 장래에 내 지식이 필요해질지도 몰라."
  },
  "8": {
   "jp": "afd7f8ca38",
   "kr": "그날을 위해 지식을 쌓아 둘게."
  },
  "9": {
   "jp": "b7989658c8",
   "kr": "싸움은 항상 냉정한 쪽이 승자가 돼."
  },
  "10": {
   "jp": "557595a1a4",
   "kr": "상대의 움직임을 간파하는 거야."
  },
  "11": {
   "jp": "b023123bee",
   "kr": "적당한 휴식을 잊지 마세요."
  },
  "12": {
   "jp": "895dfd4134",
   "kr": "지금까지 고마웠어요."
  },
  "13": {
   "jp": "8ec9a22422",
   "kr": "또 함께 여행할 수 있다면 기쁘겠어요."
  },
  "14": {
   "jp": "c2ce0e669d",
   "kr": "싸움은 힘으로만 밀어붙이면 안 돼."
  },
  "15": {
   "jp": "9137dd886c",
   "kr": "마법이나 도구를 잘 다뤄야 일류야."
  },
  "16": {
   "jp": "6ff38080b4",
   "kr": "그럼 잘 있어!"
  },
  "17": {
   "jp": "60d972586b",
   "kr": "그만둬, 말려 봐야 소용없어.",
   "auto": 1
  },
  "18": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "19": {
   "jp": "3bb2152adb",
   "kr": "이 마을에 도구점이 있었지."
  },
  "20": {
   "jp": "e7b25487c5",
   "kr": "한동안 도구점 근처를 어슬렁거려 볼까."
  },
  "21": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "22": {
   "jp": "27d53c6a12",
   "kr": "이별은 새로운 만남의 서곡."
  },
  "23": {
   "jp": "b11535ec70",
   "kr": "다음 멜로디를 기다리기로 하죠."
  },
  "24": {
   "jp": "4b59f66212",
   "kr": "내 힘이 필요할 때는",
   "auto": 1
  },
  "25": {
   "jp": "fc84a547dc",
   "kr": "찾아오너라.",
   "auto": 1
  },
  "26": {
   "jp": "44ad7348b4",
   "kr": "저기, 남을 위한 친절이"
  },
  "27": {
   "jp": "daa18a9edc",
   "kr": "정말은 어떤 걸지 생각해 본 적 있어?"
  },
  "28": {
   "jp": "625ad13219",
   "kr": "나, 요즘 그런 게"
  },
  "29": {
   "jp": "65cc09e638",
   "kr": "무척 신경 쓰여. 좀 이상하려나."
  },
  "30": {
   "jp": "38164a76a5",
   "kr": "여행자인 너에게 이런 얘기를 하다니"
  },
  "31": {
   "jp": "dbb5179f34",
   "kr": "역시 이상하지. 신경 쓰지 마."
  },
  "32": {
   "jp": "40b1053f90",
   "kr": "저기, 여행하는 동안"
  },
  "33": {
   "jp": "fdbad0a2f0",
   "kr": "대체 몇 명쯤 만나게 될까."
  },
  "34": {
   "jp": "097b3f0617",
   "kr": "남을 걱정시키지 않는 것도"
  },
  "35": {
   "jp": "2c192b4dbc",
   "kr": "타인에 대한 친절 중 하나라고 생각하지?"
  },
  "36": {
   "jp": "e04f2b8a25",
   "kr": "너도 그렇게 생각하지?"
  },
  "37": {
   "jp": "92372d689f",
   "kr": "노인은 말이야, 노인 취급하면"
  },
  "38": {
   "jp": "c9c164fa66",
   "kr": "점점 더 늙어 버린다고."
  },
  "39": {
   "jp": "f76938dc51",
   "kr": "무슨 일이야? 용건 있어?"
  },
  "40": {
   "jp": "8c09bc3b6f",
   "kr": "베키 씨 맞죠?"
  },
  "41": {
   "jp": "d04ab8cb28",
   "kr": "뉴보른의 랑 할아버지한테서"
  },
  "42": {
   "jp": "041382abf1",
   "kr": "짐을 맡아 왔어요."
  },
  "43": {
   "jp": "7d8dfdf902",
   "kr": "어머."
  },
  "44": {
   "jp": "8b34581779",
   "kr": "랑 할아버지라면 알지만"
  },
  "45": {
   "jp": "203de04f41",
   "kr": "내 앞으로 짐? 대체 뭘까."
  },
  "46": {
   "jp": "ff223beb3f",
   "kr": "랑에게서 받은 수정구를 건넸다."
  },
  "47": {
   "jp": "ee03dac6e7",
   "kr": "어머. 이걸 나에게…?"
  },
  "48": {
   "jp": "f2fd86c61b",
   "kr": "정말 고마워."
  },
  "49": {
   "jp": "b9125dacf8",
   "kr": "할아버지가 기념품이라고 하셨어요."
  },
  "50": {
   "jp": "4dc74ed0a4",
   "kr": "어머, 그런 말을 했어?"
  },
  "51": {
   "jp": "8dab4f2327",
   "kr": "정말 못 말려."
  },
  "52": {
   "jp": "a7a203ff6a",
   "kr": "…………?"
  },
  "53": {
   "jp": "bfd509fb57",
   "kr": "그분은 내 스승이야."
  },
  "54": {
   "jp": "fce0d7a032",
   "kr": "나는 랑 할아버지께"
  },
  "55": {
   "jp": "afe430bf8b",
   "kr": "여러 가지를 배웠어."
  },
  "56": {
   "jp": "664aed71c2",
   "kr": "이 수정구는 내가 스승님 곁에서"
  },
  "57": {
   "jp": "4d9401d04c",
   "kr": "배우던 때에 「내가 저세상에 갈"
  },
  "58": {
   "jp": "23ada2744d",
   "kr": "때가 되면 너에게 물려주마.」"
  },
  "59": {
   "jp": "37f208a7c2",
   "kr": "라고 말씀하시던 물건이야."
  },
  "60": {
   "jp": "f3bdf78b86",
   "kr": "지금은 제자가 아무도 없는 모양이니"
  },
  "61": {
   "jp": "78eb197dbb",
   "kr": "분명 쓸쓸한 것뿐이야."
  },
  "62": {
   "jp": "9a0b8e3761",
   "kr": "랑 할아버지는 겉보기보다"
  },
  "63": {
   "jp": "2b55544e20",
   "kr": "엄청 튼튼하다니까."
  },
  "64": {
   "jp": "2d619cfa08",
   "kr": "맞다. 언젠가 시간이 나면"
  },
  "65": {
   "jp": "53d34ba124",
   "kr": "뉴보른까지 가서"
  },
  "66": {
   "jp": "bc66f080cc",
   "kr": "랑 할아버지를 격려해 줘야지."
  },
  "67": {
   "jp": "d625d0f1cd",
   "kr": "아직"
  },
  "68": {
   "jp": "0f8867b5a8",
   "kr": "그럴 나이 아니잖아요! 하고."
  },
  "69": {
   "jp": "cad6d4fc40",
   "kr": "무슨 일이야?"
  },
  "70": {
   "jp": "0ddc76ec7a",
   "kr": "나한테 묻고 싶은 거라도 있어?"
  }
 }
}
