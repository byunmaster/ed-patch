{
 "archive": "/D/SC307.DAT",
 "member": "..\\BIN\\DT02101.BIN",
 "segments": {
  "0": {
   "jp": "fb0260365e",
   "kr": "보였나요?"
  },
  "1": {
   "jp": "c3f8c2f40e",
   "kr": "응."
  },
  "2": {
   "jp": "2ae63fcfc0",
   "kr": "이것저것 중얼거렸는데요."
  },
  "3": {
   "jp": "5ab8117042",
   "kr": "꽤 많은 걸 본 모양이죠?"
  },
  "4": {
   "jp": "f0a272c60a",
   "kr": "여러 장소가 보였어."
  },
  "5": {
   "jp": "c42429d9b2",
   "kr": "신전 같은 곳에서 명상하는 사람."
  },
  "6": {
   "jp": "650f6297aa",
   "kr": "내가 자란 집도 보였어."
  },
  "7": {
   "jp": "46bb0049cc",
   "kr": "할아버지가 살아 계시던 때의 광경이야."
  },
  "8": {
   "jp": "c6cdc44c9c",
   "kr": "그리고 어딘가의 호수…"
  },
  "9": {
   "jp": "d816e33c87",
   "kr": "쓸쓸해 보이는 묘지도."
  },
  "10": {
   "jp": "ec123d7df8",
   "kr": "장소로 치면 네 곳…"
  },
  "11": {
   "jp": "9d02c3f101",
   "kr": "무엇을 알리려는 건지"
  },
  "12": {
   "jp": "91ba59de41",
   "kr": "그것만으로는 판단이 안 서네요."
  },
  "13": {
   "jp": "7ec3435f27",
   "kr": "뭐, 서둘러 전부 알려고 하지 않는 게 좋아요."
  },
  "14": {
   "jp": "017a745885",
   "kr": "주의해서 마음에 두고 있으면"
  },
  "15": {
   "jp": "553d52a42c",
   "kr": "분명 짚이는 때가 올 거예요."
  },
  "16": {
   "jp": "3858c2741a",
   "kr": "지금 본 광경은 머지않은 미래에"
  },
  "17": {
   "jp": "ac6309d9e9",
   "kr": "당신의 운명에 관련될 거예요."
  },
  "18": {
   "jp": "1db82835b6",
   "kr": "모처럼 얻은 실마리를 잊지 마세요."
  },
  "19": {
   "jp": "9a3ae049cd",
   "kr": "자, 발크드로 돌아가죠."
  },
  "20": {
   "jp": "d24afa8c17",
   "kr": "루티스 씨가 걱정이에요."
  },
  "21": {
   "jp": "6cc31e952c",
   "kr": "발두스든 오크툼이든 나랑은 상관없어."
  },
  "22": {
   "jp": "22cc94c1f4",
   "kr": "너희가 싸우니까"
  },
  "23": {
   "jp": "37bc70b8a6",
   "kr": "인간 세계까지 어지러워지는 거야."
  }
 }
}
