{
 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT01000F.BIN",
 "segments": {
  "0": {
   "jp": "e9ae5c176d",
   "kr": "기절했다 잠들었다"
  },
  "1": {
   "jp": "e1a31ef4b3",
   "kr": "정말 바쁜 애네…"
  },
  "2": {
   "jp": "2cee2617ca",
   "kr": "그야 좋게 봐 주는 건"
  },
  "3": {
   "jp": "f53b6cdaff",
   "kr": "나쁜 기분은 아니지만,"
  },
  "4": {
   "jp": "00446bb2e4",
   "kr": "위험이 가득한 여행이니까."
  },
  "5": {
   "jp": "e00a0d22dc",
   "kr": "그럼 어빈, 갈까."
  },
  "6": {
   "jp": "437fc7fa4a",
   "kr": "어?"
  },
  "7": {
   "jp": "d1440c36c9",
   "kr": "섀넌은 어쩌고?"
  },
  "8": {
   "jp": "41baf4d82f",
   "kr": "어쩌냐고 물어도…"
  },
  "9": {
   "jp": "c9074c2853",
   "kr": "원래 섀넌은 우리와"
  },
  "10": {
   "jp": "8eb5a5069e",
   "kr": "아무 관계도 없고,"
  },
  "11": {
   "jp": "3dc40a31d4",
   "kr": "서둘러야 하는 여행이니까."
  },
  "12": {
   "jp": "fba31e1a34",
   "kr": "그야 그렇지만."
  },
  "13": {
   "jp": "b1d3e391a0",
   "kr": "곤란해 보이는구먼."
  },
  "14": {
   "jp": "c8c84d1aa9",
   "kr": "인기 많은 남자는 괴롭겠어."
  },
  "15": {
   "jp": "7a0335d9ff",
   "kr": "영감님, 그렇게 놀리면 딱하잖아요."
  },
  "16": {
   "jp": "b56b59cc01",
   "kr": "허허."
  },
  "17": {
   "jp": "a141c1cfa8",
   "kr": "이거 참, 미안하구려."
  },
  "18": {
   "jp": "2d79c661bb",
   "kr": "아가씨라면"
  },
  "19": {
   "jp": "dda01f8908",
   "kr": "우리에게 맡겨요."
  },
  "20": {
   "jp": "48a587753c",
   "kr": "걱정 말고요."
  },
  "21": {
   "jp": "feed364461",
   "kr": "일어나면 잘 타일러"
  },
  "22": {
   "jp": "f1db5ae45a",
   "kr": "놓을 테니까요."
  },
  "23": {
   "jp": "b3b296304e",
   "kr": "뭘, 그 애는 착한 아이요."
  },
  "24": {
   "jp": "a07bd6bae0",
   "kr": "말해서 못 알아듣는 아이가 아니오."
  },
  "25": {
   "jp": "0100c40d51",
   "kr": "우리에게 맡기고"
  },
  "26": {
   "jp": "85ce861250",
   "kr": "안심하고 여행을 계속하시오."
  },
  "27": {
   "jp": "7b738f3d65",
   "kr": "깜빡했군."
  },
  "28": {
   "jp": "010d794fca",
   "kr": "사례를 치러야지."
  },
  "29": {
   "jp": "d1b5385459",
   "kr": "어, 사례라니…"
  },
  "30": {
   "jp": "77b2246588",
   "kr": "알선소 일만큼은 못 주지만"
  },
  "31": {
   "jp": "c51ba1683e",
   "kr": "우리 마음이라오."
  },
  "32": {
   "jp": "05cede42c2",
   "kr": "사양 말고 받아 주시게."
  },
  "33": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "34": {
   "jp": "f8851237f7",
   "kr": "을(를) 받았다.",
   "auto": 1
  },
  "35": {
   "jp": "71cc62a1e1",
   "kr": "왠지 미안하네."
  },
  "36": {
   "jp": "eb9b536e69",
   "kr": "괜찮은 건가요?"
  },
  "37": {
   "jp": "7b29014eff",
   "kr": "억지로 부탁한 건"
  },
  "38": {
   "jp": "cec8d7843f",
   "kr": "우리 쪽이니까."
  },
  "39": {
   "jp": "d73259880c",
   "kr": "그래요. 자, 사양 말고요."
  },
  "40": {
   "jp": "97f3624dd9",
   "kr": "죄송해요. 감사히 받겠습니다."
  },
  "41": {
   "jp": "c7f17f4133",
   "kr": "이것저것 정말 고맙습니다."
  },
  "42": {
   "jp": "19cdc49ba7",
   "kr": "섀넌 일,"
  },
  "43": {
   "jp": "82eddaa483",
   "kr": "부디 잘 부탁드려요."
  },
  "44": {
   "jp": "b62ddac30f",
   "kr": "자, 그렇다면"
  },
  "45": {
   "jp": "f4c85efd63",
   "kr": "아가씨가 눈을 뜨기 전에"
  },
  "46": {
   "jp": "ac237f9587",
   "kr": "가는 편이 좋겠지."
  },
  "47": {
   "jp": "ccc4be0f45",
   "kr": "가는 길 조심하게."
  },
  "48": {
   "jp": "b5224d703b",
   "kr": "조심해서 가."
  },
  "49": {
   "jp": "84481b49cf",
   "kr": "할아버지도 할머니도 건강하세요."
  },
  "50": {
   "jp": "55d42d3887",
   "kr": "그럼 이만."
  }
 }
}
