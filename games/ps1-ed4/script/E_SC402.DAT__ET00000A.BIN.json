{
 "archive": "/E/SC402.DAT",
 "member": "..\\BIN\\ET00000A.BIN",
 "segments": {
  "0": {
   "jp": "8f3e1d058c",
   "kr": "…으음."
  },
  "1": {
   "jp": "0c88dd8266",
   "kr": "그래서 간신히 도망쳤다는 말이군."
  },
  "2": {
   "jp": "2f9c8b3b38",
   "kr": "다친 사람은 없었나?"
  },
  "3": {
   "jp": "305ea1a407",
   "kr": "괜찮습니다."
  },
  "4": {
   "jp": "d4daff3450",
   "kr": "스코티아호도 무사합니다."
  },
  "5": {
   "jp": "5734fc3ee8",
   "kr": "그거 다행이군."
  },
  "6": {
   "jp": "c059d34f28",
   "kr": "그나저나 모시가 정말 있었다니."
  },
  "7": {
   "jp": "34dcf98d7d",
   "kr": "호수에 나가는 건 위험하겠구먼…"
  },
  "8": {
   "jp": "40167b2c96",
   "kr": "앞으로는 다른 생계를 생각해야겠네."
  },
  "9": {
   "jp": "4db41db99f",
   "kr": "다른 생계요?"
  },
  "10": {
   "jp": "c04b558fc3",
   "kr": "이제 호수에 나가는 건 그만둬야 하네."
  },
  "11": {
   "jp": "52bdc00ecf",
   "kr": "잠깐만요."
  },
  "12": {
   "jp": "7dd4047984",
   "kr": "그럼 어떻게 먹고살라는 겁니까?"
  },
  "13": {
   "jp": "9271a30eb5",
   "kr": "사금으로 사는 건 포기하게."
  },
  "14": {
   "jp": "a50f5da911",
   "kr": "밭이라도 일궈서…"
  },
  "15": {
   "jp": "b072b2d9b4",
   "kr": "말도 안 돼요!"
  },
  "16": {
   "jp": "9b0a6f6419",
   "kr": "왜 우리가 호수를 버려야 하는데요."
  },
  "17": {
   "jp": "4c87c88c3a",
   "kr": "모시 따윈 제가 해치워 버리겠어요!"
  },
  "18": {
   "jp": "c4559803a0",
   "kr": "무리라네."
  },
  "19": {
   "jp": "d590af5dad",
   "kr": "무리일 리 없어요."
  },
  "20": {
   "jp": "d9110d4e55",
   "kr": "모시 따윈 덩치만 클 뿐이고"
  },
  "21": {
   "jp": "6e9bea3204",
   "kr": "어차피 머리는 텅 비었어요."
  },
  "22": {
   "jp": "7ba2899935",
   "kr": "머리 쓰는 만큼 이쪽이 단연 유리해요!"
  },
  "23": {
   "jp": "6101afd759",
   "kr": "…안 되네."
  },
  "24": {
   "jp": "16151ddf94",
   "kr": "설령 모시를 쓰러뜨릴 수 있다 해도"
  },
  "25": {
   "jp": "150f3484c4",
   "kr": "싸우면 부상자가… 아니, 죽는 이가 나올지도 모르오."
  },
  "26": {
   "jp": "2221ffc11b",
   "kr": "잡초를 먹어서라도 살아갈 수는 있네."
  },
  "27": {
   "jp": "f465b0a6a8",
   "kr": "장로님!"
  },
  "28": {
   "jp": "358125fc29",
   "kr": "안 된다면 안 되는 거네!"
  },
  "29": {
   "jp": "889b302f7e",
   "kr": "오스카!!"
  },
  "30": {
   "jp": "564fc05988",
   "kr": "어빈 씨도 단념해 주시게."
  },
  "31": {
   "jp": "bcb729df9f",
   "kr": "나는 자네들을 위해서도 이렇게 말하는 걸세."
  },
  "32": {
   "jp": "ac606c9f02",
   "kr": "…흠."
  },
  "33": {
   "jp": "7d6eec5516",
   "kr": "그래, 그 보물상자가 이것이라고?"
  },
  "34": {
   "jp": "75b5d3f153",
   "kr": "그렇습니다."
  },
  "35": {
   "jp": "a26faceb13",
   "kr": "스코티아호가 모시에게 실려서"
  },
  "36": {
   "jp": "25b31d7567",
   "kr": "이 상자 근처에 닿았을 때"
  },
  "37": {
   "jp": "8d6326941f",
   "kr": "제 앞에 스코티아 님이 나타나셨어요."
  },
  "38": {
   "jp": "dc75fd0ff2",
   "kr": "눈앞에 아름다운 금빛 광채가 내려와"
  },
  "39": {
   "jp": "0867508a47",
   "kr": "스코티아 님의 목소리가 들렸어요."
  },
  "40": {
   "jp": "f3f8aab441",
   "kr": "신기한 일이로군."
  },
  "41": {
   "jp": "63ee5b124c",
   "kr": "크리스탈에 가까이 가서"
  },
  "42": {
   "jp": "3f41664793",
   "kr": "무녀의 힘이 되살아난 모양이구먼."
  },
  "43": {
   "jp": "5191c923b1",
   "kr": "그럴지도 몰라요."
  },
  "44": {
   "jp": "2ec4a238a6",
   "kr": "한순간에 제 머릿속으로"
  },
  "45": {
   "jp": "1efbe2d985",
   "kr": "여러 가지가 흘러들어 왔어요."
  },
  "46": {
   "jp": "a02dc654d0",
   "kr": "선조들이 무녀로서의 특별한 힘을 버리고"
  },
  "47": {
   "jp": "05972c3846",
   "kr": "평범한 생활을 하려고 크리스탈을 가라앉힌 일이라든가."
  },
  "48": {
   "jp": "c3034fca82",
   "kr": "모시가 사실은 모스트로스라는 용이고"
  },
  "49": {
   "jp": "51d4322320",
   "kr": "스코티아 님의 사자라는 것도요."
  },
  "50": {
   "jp": "d5b2fc14e6",
   "kr": "하지만 지금은 지난 일을"
  },
  "51": {
   "jp": "ed1b1adb5d",
   "kr": "느긋하게 얘기할 때가 아니에요."
  },
  "52": {
   "jp": "ec86af6887",
   "kr": "스코티아 님께 큰일이 났어요."
  },
  "53": {
   "jp": "b511ea8449",
   "kr": "스코티아 님께 큰일이라니?"
  },
  "54": {
   "jp": "5307e0f11d",
   "kr": "스코티아 님은 지금"
  },
  "55": {
   "jp": "457c456003",
   "kr": "무서운 것에게 습격당하고 있어요."
  },
  "56": {
   "jp": "507aa83b91",
   "kr": "정체는 모르겠지만… 새까만 그림자가…"
  },
  "57": {
   "jp": "16a4001a81",
   "kr": "스코티아 님을 덮치는 게 보였어요."
  },
  "58": {
   "jp": "d52fc17245",
   "kr": "그 그림자는 발두스의 혼을 부수려 하고 있어요."
  },
  "59": {
   "jp": "4ef29373a2",
   "kr": "스코티아 님은 그 위기를 알리려고"
  },
  "60": {
   "jp": "5428e3d9c1",
   "kr": "저희에게 도움을 청하셨어요."
  },
  "61": {
   "jp": "bdf6e2143d",
   "kr": "모시가 나타난 건 그 때문이에요."
  },
  "62": {
   "jp": "05104679fb",
   "kr": "모시는 스코티아 님을 도와주길 바랐던 거야."
  },
  "63": {
   "jp": "f580f77011",
   "kr": "그런데도 몹쓸 짓을 해 버렸어…"
  },
  "64": {
   "jp": "16a3047c92",
   "kr": "아니에요, 오스카."
  },
  "65": {
   "jp": "37f0f7e380",
   "kr": "당신 잘못이 아니에요."
  },
  "66": {
   "jp": "8ace86a62a",
   "kr": "크리스탈 근처에 가기 전까지는 저도"
  },
  "67": {
   "jp": "7516a28afa",
   "kr": "스코티아 님에 대해서도 모시에 대해서도 알지 못했어."
  },
  "68": {
   "jp": "a494467e20",
   "kr": "다들 그저 '모시가 무섭다'고만 생각했던 거야."
  },
  "69": {
   "jp": "be13da1c56",
   "kr": "무서워하지 않은 건 리타뿐인가."
  },
  "70": {
   "jp": "7faafabaf6",
   "kr": "모시는 리타에게 도움을 청한 거로군."
  },
  "71": {
   "jp": "1dca2a3ed4",
   "kr": "네.",
   "auto": 1
  },
  "72": {
   "jp": "b815dd59a2",
   "kr": "하지만 크리스탈이 없으면"
  },
  "73": {
   "jp": "f9b216acd0",
   "kr": "아무도 사당에 들어갈 수 없어요."
  },
  "74": {
   "jp": "290384031d",
   "kr": "리타는 사당 입구에서"
  },
  "75": {
   "jp": "7839f68bff",
   "kr": "어쩌지 못하고 있을 거예요."
  },
  "76": {
   "jp": "5ec0132036",
   "kr": "좋아!"
  },
  "77": {
   "jp": "d63209be20",
   "kr": "우리도 스코티아 님을 구하러 가자!"
  },
  "78": {
   "jp": "8b21860c4b",
   "kr": "남자들"
  },
  "79": {
   "jp": "eeeec9e3be",
   "kr": "오!!"
  },
  "80": {
   "jp": "e4bb5ee6aa",
   "kr": "어빈 씨, 드린 열쇠로"
  },
  "81": {
   "jp": "3bc10ea336",
   "kr": "보물상자를 열어 주세요."
  },
  "82": {
   "jp": "52167fa073",
   "kr": "스코티아 님은"
  },
  "83": {
   "jp": "f2a14bdb7a",
   "kr": "크리스탈을 당신께 맡기라고 하셨어요."
  },
  "84": {
   "jp": "09043b6366",
   "kr": "싸우면 부상자가…"
  },
  "85": {
   "jp": "73411b3eb6",
   "kr": "아니, 사망자가 나올지도 모르네."
  },
  "86": {
   "jp": "436c84b036",
   "kr": "평범한 생활을 하기 위해"
  },
  "87": {
   "jp": "c00bc98be7",
   "kr": "크리스탈을 가라앉힌 일 같은 거요."
  },
  "88": {
   "jp": "e3a2c8e131",
   "kr": "모시는"
  },
  "89": {
   "jp": "33705b6b1c",
   "kr": "스코티아 님을 도와 달라고 하고 싶었던 거구나."
  },
  "90": {
   "jp": "c7b0642e41",
   "kr": "스코티아 님에 대해서도"
  },
  "91": {
   "jp": "d40a393ea9",
   "kr": "모시에 대해서도 몰랐어요."
  },
  "92": {
   "jp": "6793f0b8c8",
   "kr": "다들"
  },
  "93": {
   "jp": "8bdec83995",
   "kr": "그저 『모시가 무섭다』고만 생각했으니까요."
  },
  "94": {
   "jp": "5e1ce785fd",
   "kr": "크리스탈을 당신에게 맡기라고"
  },
  "95": {
   "jp": "676c2f0e58",
   "kr": "말씀하셨어요."
  }
 }
}
