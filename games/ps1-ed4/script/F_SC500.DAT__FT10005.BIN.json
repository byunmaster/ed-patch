  },
  "7": {
   "jp": "449b19cd60",
   "kr": "프라네토스호, 발진!"
  },
  "8": {
   "jp": "10678035e9",
   "kr": "좋아, 바람을 탔어."
  },
  "9": {
   "jp": "1443407b05",
   "kr": "오케이, 나머지는 한스에게 맡기자."
  },
  "10": {
   "jp": "cb644b7b6a",
   "kr": "우린 상륙 계획을 짜자고."
  },
  "11": {
   "jp": "54e376c10c",
   "kr": "부탁한다, 한스."
  },
  "12": {
   "jp": "304a675dc7",
   "kr": "그래, 이 몸한테 맡기슈."
  },
  "13": {
   "jp": "c312b72a2a",
   "kr": "자, 이 지도를 봐 줘."
  },
  "14": {
   "jp": "f5f507feba",
   "kr": "우리가 조사한 바로는 해안 절벽이 꽤 험해서"
  },
  "15": {
   "jp": "d1bee6e483",
   "kr": "올라갈 수 있는 곳은 카테드랄 바로 아래쯤이야."
  },
  "16": {
   "jp": "512d592097",
   "kr": "이 아래에 닿는 것도"
  },
  "17": {
   "jp": "3829601a9a",
   "kr": "프라네토스호 같은 대형선으론 무리야."
  },
  "18": {
   "jp": "9446285d0a",
   "kr": "보트로 갈아타는 수밖에 없어."
  },
  "19": {
   "jp": "437106df81",
   "kr": "해안까지 가면"
  },
  "20": {
   "jp": "d5ce782fd8",
   "kr": "절벽 속 동굴에 정신전 신도들이 쓰던"
  },
  "21": {
   "jp": "ad14ebefb8",
   "kr": "낡은 계단이 있다더군."
  },
  "22": {
   "jp": "1175dee8ca",
   "kr": "올라갈 곳이 거기뿐이라면."
  },
  "23": {
   "jp": "1a9dd7c0d1",
   "kr": "저쪽도 매복하고 있을 가능성이 높아."
  },
  "24": {
   "jp": "c70c796a3e",
   "kr": "어차피 카테드랄의 제단을 쓰려면"
  },
  "25": {
   "jp": "f1dd3a06be",
   "kr": "놈들과 부딪치는 건 피할 수 없어."
  },
  "26": {
   "jp": "b47f4c7865",
   "kr": "매복을 알면서도 뛰어들 뿐이야."
  },
  "27": {
   "jp": "f778ec08ab",
   "kr": "응.",
   "auto": 1
  },
  "28": {
   "jp": "b1ddf3b820",
   "kr": "당신들 각오, 굉장하네."
  },
  "29": {
   "jp": "78b90af9ac",
   "kr": "나도 돕겠어. 내가 보트를 저을게."
  },
  "30": {
   "jp": "ed00c55d22",
   "kr": "아니, 폴에겐 미안하지만 내가 가겠어."
  },
  "31": {
   "jp": "089f11150b",
   "kr": "왜?"
  },
  "32": {
   "jp": "96929c16e1",
   "kr": "체중 초과야."
  },
  "33": {
   "jp": "f17abede91",
   "kr": "아하."
  },
  "34": {
   "jp": "56f81fb71c",
   "kr": "그 보트로는"
  },
  "35": {
   "jp": "b543034d43",
   "kr": "네가 타면 다른 사람이 못 타게"
  },
  "36": {
   "jp": "564dd734b8",
   "kr": "되니까 말이야."
  },
  "37": {
   "jp": "06c2226d98",
   "kr": "하긴… 으헉."
  },
  "38": {
   "jp": "fa49f5013e",
   "kr": "좋아, 상륙 순서는 알겠지?"
  },
  "39": {
   "jp": "35d4f79ebf",
   "kr": "갈아타는 지점까지 대기다."
  },
  "40": {
   "jp": "8ff590c2ae",
   "kr": "(카테드랄인가…)"
  },
  "41": {
   "jp": "264945726b",
   "kr": "(……)"
  },
  "42": {
   "jp": "0d550e7c79",
   "kr": "(마일…)"
  },
  "43": {
   "jp": "ce33f50d01",
   "kr": "(나는… 뭘 하고 있는 걸까…)"
  },
  "44": {
   "jp": "6dc3e82d4a",
   "kr": "(강한 척은 하지만…)"
  },
  "45": {
   "jp": "4a0313cd4a",
   "kr": "(결국은…)"
  },
  "46": {
   "jp": "536a20ce0d",
   "kr": "(신들에게 휘둘리고 있을 뿐인 게 아닐까"
  },
  "47": {
   "jp": "2c67472c92",
   "kr": "…하고 생각할 때가 있다.)"
  },
  "48": {
   "jp": "179c4624a3",
   "kr": "(어떻게 생각해, 마일…?)"
  },
  "49": {
   "jp": "ce815cef09",
   "kr": "(그런 거냐…?)"
  },
  "50": {
   "jp": "5d61d8227f",
   "kr": "곧 도착이야."
  },
  "51": {
   "jp": "2dcfafe93a",
   "kr": "작은 배로 옮겨 탈 준비를 해 줘."
  },
  "52": {
   "jp": "33de81828f",
   "kr": "자,"
  },
  "53": {
   "jp": "da749f6d45",
   "kr": "이 바다가 삼도천이 되지 않아야 할 텐데."
  },
  "54": {
   "jp": "ffe0a133df",
   "kr": "그럼 간다."
  }
