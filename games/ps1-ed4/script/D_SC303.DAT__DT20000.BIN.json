  },
  "50": {
   "jp": "ccc5f72beb",
   "kr": "우와, 이것 좀 봐, 어빈!"
  },
  "51": {
   "jp": "79935f0824",
   "kr": "방치돼 있다기에"
  },
  "52": {
   "jp": "a413164507",
   "kr": "얼마나 낡은 수레일까 싶었어."
  },
  "53": {
   "jp": "3dd3dc0aa9",
   "kr": "그런데 꽤 멋진 수레잖아."
  },
  "54": {
   "jp": "c3f8c2f40e",
   "kr": "응."
  },
  "55": {
   "jp": "2010e3184d",
   "kr": "잘됐다."
  },
  "56": {
   "jp": "236bb93c05",
   "kr": "생각보다 편하게 발크드까지 갈 수 있겠어."
  },
  "57": {
   "jp": "02896aa11f",
   "kr": "…이것도 정신전 신의 뜻일까."
  },
  "58": {
   "jp": "2aded6656e",
   "kr": "어라라. 어빈답지 않은 소리인데."
  },
  "59": {
   "jp": "b912bdb236",
   "kr": "괜찮아."
  },
  "60": {
   "jp": "004c4ce9d6",
   "kr": "나를 해치지 않는 거라면"
  },
  "61": {
   "jp": "2ad5bb9086",
   "kr": "딱히 믿지도 않지만 특별히 싫어하지도 않아."
  },
  "62": {
   "jp": "7510a951db",
   "kr": "사교도에 비하면"
  },
  "63": {
   "jp": "f392ecfa71",
   "kr": "무해한 만큼 호감도 가."
  },
  "64": {
   "jp": "3a456d6509",
   "kr": "그렇구나."
  },
  "65": {
   "jp": "14f43c1025",
   "kr": "하긴, 그렇게 생각할 수도 있겠네."
  },
  "66": {
   "jp": "bd371d0a69",
   "kr": "얼른 아이멜과 섀넌을 데려오자."
  },
  "67": {
   "jp": "2f3de7fa0d",
   "kr": "셰이커와 글릭은"
  },
  "68": {
   "jp": "fba569e008",
   "kr": "계획대로 잘하고 있겠지?"
  },
  "69": {
   "jp": "bbff02cbbe",
   "kr": "그놈들이라면 걱정 없다."
  },
  "70": {
   "jp": "7e2e68defd",
   "kr": "어빈 일행은 반드시 우리가 준비한 수레에"
  },
  "71": {
   "jp": "ff600d7ce9",
   "kr": "올라탈 거다."
  },
  "72": {
   "jp": "448cdf38f6",
   "kr": "바스터."
  },
  "73": {
   "jp": "f5608bf7d3",
   "kr": "넌 파트너니까 너한테만은 말해 둘게."
  },
  "74": {
   "jp": "dfa03ae12b",
   "kr": "뭐야, 새삼스럽게."
  },
  "75": {
   "jp": "f2f0914f82",
   "kr": "내가 적에게 수레를 선물한 건"
  },
  "76": {
   "jp": "5deaff435d",
   "kr": "그놈들이 발크드에 도착하기 전에"
  },
  "77": {
   "jp": "5d46966f77",
   "kr": "카베사와 쿠엘포를 손에 넣고 싶어서야."
  },
  "78": {
   "jp": "0558d93bbd",
   "kr": "그놈들이 꾸물거리면"
  },
  "79": {
   "jp": "7ef0525236",
   "kr": "볼게이드 패거리가 발크드 앞에서"
  },
  "80": {
   "jp": "ef0a2189ad",
   "kr": "그물을 칠 테니까."
  },
  "81": {
   "jp": "99d78f00cb",
   "kr": "그렇게 되면"
  },
  "82": {
   "jp": "88040d4e16",
   "kr": "우리가 손쓸 기회도 사라져."
  },
  "83": {
   "jp": "4e77869187",
   "kr": "사냥감을 뺏기긴 싫으니까."
  },
  "84": {
   "jp": "eae76efb24",
   "kr": "게다가 말이야."
  },
  "85": {
   "jp": "4262b44b4f",
   "kr": "아무래도 볼게이드의 수법이 마음에 안 들어."
  },
  "86": {
   "jp": "fc5a5d7603",
   "kr": "목적을 위해서라지만"
  },
  "87": {
   "jp": "5dd5a691cc",
   "kr": "동료의 목숨이 위험해져도 아랑곳하지 않아."
  },
  "88": {
   "jp": "328c52c9c6",
   "kr": "볼게이드는"
  },
  "89": {
   "jp": "8888317456",
   "kr": "내 동생까지 이용하려 했어…"
  },
  "90": {
   "jp": "d643ac61d6",
   "kr": "…앗!"
  },
  "91": {
   "jp": "eda00e4410",
   "kr": "놈들이 왔다!"
  },
  "92": {
   "jp": "40b4ec872c",
   "kr": "수다 떨 때가 아니었네."
  },
  "93": {
   "jp": "b49ab8a9c0",
   "kr": "이번엔 끝장을 내자."
  },
  "94": {
   "jp": "2a397acb0d",
   "kr": "…어때, 아이멜?"
  },
  "95": {
   "jp": "0e8d855178",
   "kr": "피곤하지 않아?"
  },
  "96": {
   "jp": "c7835842e0",
   "kr": "아이멜",
   "auto": 1
  },
  "97": {
   "jp": "a50605b9d8",
   "kr": "괜찮아요."
  },
  "98": {
   "jp": "7eeeacaa67",
   "kr": "다행이다.",
   "auto": 1
  },
  "99": {
   "jp": "05750fec15",
   "kr": "속이 안 좋아지면 사양 말고 말해."
  },
  "100": {
   "jp": "c7835842e0",
   "kr": "아이멜",
   "auto": 1
  },
  "101": {
   "jp": "343bce9ffa",
   "kr": "감사합니다.",
   "auto": 1
  },
  "102": {
   "jp": "1e195f6292",
   "kr": "섀넌",
   "auto": 1
  },
  "103": {
   "jp": "5272110cf7",
   "kr": "…저기… 마일 님?"
  },
  "104": {
   "jp": "4884579426",
   "kr": "왜?"
  },
  "105": {
   "jp": "1a34ed5ef6",
   "kr": "배고파?"
  },
  "106": {
   "jp": "1e195f6292",
   "kr": "섀넌",
   "auto": 1
  },
  "107": {
   "jp": "5acade713f",
   "kr": "그게 아니고."
  },
  "108": {
   "jp": "36f69c90a6",
   "kr": "섀넌한테는 아무것도 물어봐 주시지 않아?"
  },
  "109": {
   "jp": "a2fce1eb77",
   "kr": "저녁 먹기 전에는 발크드에 도착할 거야."
  },
  "110": {
   "jp": "bf7f16f2ee",
   "kr": "그때까지 기절하지 마."
  },
  "111": {
   "jp": "1e195f6292",
   "kr": "섀넌",
   "auto": 1
  },
  "112": {
   "jp": "e3c66a5c79",
   "kr": "정말…!"
  },
  "113": {
   "jp": "73511df053",
   "kr": "마일 님도 참, 너무하세요!"
  },
  "114": {
   "jp": "5dd9fd1f24",
   "kr": "…어라?"
  },
  "115": {
   "jp": "7cfe4ce3fa",
   "kr": "왜 그래?"
  },
  "116": {
   "jp": "1894c2b4b1",
   "kr": "뭔가 온다…"
  },
  "117": {
   "jp": "d1da60b160",
   "kr": "아니, 쫓아오고 있어!!"
  },
  "118": {
   "jp": "4acee5a428",
   "kr": "하하하!"
  },
  "119": {
   "jp": "3a2b17d96e",
   "kr": "놈들이 우리를 눈치챘다!!"
  },
  "120": {
   "jp": "1275ade741",
   "kr": "서둘러 잡아!"
  },
  "121": {
   "jp": "4e1d32002d",
   "kr": "걱정 마라."
  },
  "122": {
   "jp": "0719674e83",
   "kr": "저 수레엔 장치를 해 뒀다!"
  },
  "123": {
   "jp": "2e0b019714",
   "kr": "살짝 충격만 주면 산산조각이다!!"
  },
  "124": {
   "jp": "0c4753ba51",
   "kr": "어!? 그런 장치를!?"
  },
  "125": {
   "jp": "8be45bce81",
   "kr": "뭘, 놓치지 않으려는 보험이다."
  },
  "126": {
   "jp": "08e14235c3",
   "kr": "이럇!! 이럇!!"
  },
  "127": {
   "jp": "c0f4606d07",
   "kr": "어빈!",
   "auto": 1
  },
  "128": {
   "jp": "2275d6b0f4",
   "kr": "더 빨리!"
  },
  "129": {
   "jp": "5cd55fc12b",
   "kr": "알고 있어!"
  },
  "130": {
   "jp": "1e195f6292",
   "kr": "섀넌",
   "auto": 1
  },
  "131": {
   "jp": "b42f32f3ad",
   "kr": "꺄악!!"
  },
  "132": {
   "jp": "edaa471a85",
   "kr": "우왓! 위, 위험해!"
  },
  "133": {
   "jp": "5fc5fce4b3",
   "kr": "바스터! 그만둬!"
  },
  "134": {
   "jp": "a88a68bb75",
   "kr": "그 말은 못 듣겠습니다요."
  },
  "135": {
   "jp": "716a8a3a9c",
   "kr": "그런 물러 터진 지시 따위는."
  },
  "136": {
   "jp": "a21460e015",
   "kr": "바스터…!?"
  },
  "137": {
   "jp": "7dd770fbe1",
   "kr": "와하하하, 도망쳐 봐야 소용없다!!"
  }
