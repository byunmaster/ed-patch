{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02000M.BIN",
 "segments": {
  "0": {
   "jp": "53dbcf3efb",
   "kr": "짐을 어디로 전할지 잊어버리면"
  },
  "1": {
   "jp": "5b31d28b57",
   "kr": "구멍이 나도록 짐을 살펴봐.",
   "auto": 1
  },
  "2": {
   "jp": "2a5d6f42d6",
   "kr": "누구에게 전해야 하는지 생각날 테니까.",
   "auto": 1
  },
  "3": {
   "jp": "e30a489759",
   "kr": "들었어, 큰일 당했다며."
  },
  "4": {
   "jp": "5dc029b77e",
   "kr": "지작 그놈한테 속았다면서?"
  },
  "5": {
   "jp": "005b62533b",
   "kr": "그 자식, 아무래도 구린 놈이라 생각했지."
  },
  "6": {
   "jp": "38919e5c7a",
   "kr": "역시 샴실단이었군."
  },
  "7": {
   "jp": "c723264df9",
   "kr": "뭐, 이 몸도 모르는 잔챙이 악당이야."
  },
  "8": {
   "jp": "a427e6784e",
   "kr": "어차피 이 마을을 못 벗어나."
  },
  "9": {
   "jp": "775b9d62be",
   "kr": "지금은 엄중 경계 중이거든."
  },
  "10": {
   "jp": "7eff1acd0a",
   "kr": "범죄 수사의 기본은 먼저 현장을 다니는 거야."
  },
  "11": {
   "jp": "a2988d3f5b",
   "kr": "놈의 하숙집에 가 봐."
  },
  "12": {
   "jp": "331fc812c4",
   "kr": "단서는 분명 있어."
  },
  "13": {
   "jp": "7818608c7d",
   "kr": "투명 마수 퇴치 일을 맡았다며?"
  },
  "14": {
   "jp": "c3c2c409a4",
   "kr": "좋은 걸 가르쳐 줄까."
  },
  "15": {
   "jp": "1f05c4e71e",
   "kr": "200로제, 내지 않을래?"
  },
  "16": {
   "jp": "7898a5fb6a",
   "kr": "좋아, 현명한 판단이야."
  },
  "17": {
   "jp": "bce69c60ca",
   "kr": "마수가 왜 투명해졌을까."
  },
  "18": {
   "jp": "e80f4c5be0",
   "kr": "포인트는 바로 거기 있지."
  },
  "19": {
   "jp": "1e5448fd00",
   "kr": "아무리 마수라도"
  },
  "20": {
   "jp": "5186728de8",
   "kr": "어느 날 갑자기 투명해질 리는 없어."
  },
  "21": {
   "jp": "e00c02afae",
   "kr": "누군가 마법으로 투명하게 만든 거야."
  },
  "22": {
   "jp": "c9a6fb603b",
   "kr": "이럴 땐 전문가한테 맡기는 법이지."
  },
  "23": {
   "jp": "ce8708c098",
   "kr": "마법대학교에서 알아봐."
  },
  "24": {
   "jp": "8fa3c4c3e9",
   "kr": "거기 장서는 누구나 열람할 수 있거든."
  },
  "25": {
   "jp": "e7fe6693d0",
   "kr": "비샤나 동굴은 코르나 서쪽이야."
  },
  "26": {
   "jp": "2d19631e7d",
   "kr": "지금은 별다른 정보가 없어.",
   "auto": 1
  },
  "27": {
   "jp": "9f13840241",
   "kr": "너야말로 뭔가 알려 주지 않겠어?"
  },
  "28": {
   "jp": "048f70bfe5",
   "kr": "왜 그래, 심각한 얼굴을 하고."
  },
  "29": {
   "jp": "c851f0f1d7",
   "kr": "뭔가 고민이라도 있어?"
  },
  "30": {
   "jp": "40ee794e03",
   "kr": "어, 그 종이쪽지!"
  },
  "31": {
   "jp": "33bb1fb999",
   "kr": "재미있는 게 쓰여 있잖아."
  },
  "32": {
   "jp": "175cc83fb1",
   "kr": "어디 보여 줘 봐."
  },
  "33": {
   "jp": "149e481798",
   "kr": "정보상은"
  },
  "34": {
   "jp": "8860ab3ccf",
   "kr": "을(를) 들여다보았다."
  },
  "35": {
   "jp": "8196ea232a",
   "kr": "하하, 이거 대단한 암호군."
  },
  "36": {
   "jp": "9a11780097",
   "kr": "풀어 줄까?"
  },
  "37": {
   "jp": "de7396245b",
   "kr": "200로제 내면 어떻게든 해 주지."
  },
  "38": {
   "jp": "a78202b86a",
   "kr": "이건 글자를 숫자로 바꿔 놓은 거야."
  },
  "39": {
   "jp": "6db795c399",
   "kr": "61352374"
  },
  "40": {
   "jp": "2821c18cf4",
   "kr": "비단의 나무의 라샤"
  },
  "41": {
   "jp": "96c8d49791",
   "kr": "두 번 나오는 '의' 위에 '3'이 있지?"
  },
  "42": {
   "jp": "9623b0301f",
   "kr": "그러니까 '3'은 '의'라고 읽는 거야."
  },
  "43": {
   "jp": "eb28964260",
   "kr": "나중에 나온 '6' '4' '5'에는"
  },
  "44": {
   "jp": "7a8cffae5f",
   "kr": "각각 '비' '샤' '나'"
  },
  "45": {
   "jp": "5051985b29",
   "kr": "가 대응되어 있어."
  },
  "46": {
   "jp": "e65712e64e",
   "kr": "이제 알겠지?"
  },
  "47": {
   "jp": "5cea5e1907",
   "kr": "보물은 비샤나 동굴에 있어."
  },
  "48": {
   "jp": "e7fe6693d0",
   "kr": "비샤나 동굴은 코르나 서쪽이야."
  },
  "49": {
   "jp": "8f7d9e77fa",
   "kr": "로제가 모자란 모양이군."
  },
  "50": {
   "jp": "32b2b43584",
   "kr": "미안하지만 다시 와 줘."
  },
  "51": {
   "jp": "c83bf7d915",
   "kr": "그래, 그럼 고생해서 해독해 봐."
  },
  "52": {
   "jp": "b2302eb065",
   "kr": "맥스 녀석의 의뢰를 맡았다며?"
  },
  "53": {
   "jp": "a38e826c83",
   "kr": "그럼 재미있는 이야기가 있어."
  },
  "54": {
   "jp": "615e750176",
   "kr": "30로제면 알려 주지."
  },
  "55": {
   "jp": "04accc855a",
   "kr": "코르나에 있는 어머니라는 사람은"
  },
  "56": {
   "jp": "9c0720be38",
   "kr": "맥스의 진짜 어머니가 아니야."
  },
  "57": {
   "jp": "63f19845f3",
   "kr": "그 녀석이 검술 수행을 하던 때의 스승,"
  },
  "58": {
   "jp": "558fb3503c",
   "kr": "카스톨의 부인이지."
  },
  "59": {
   "jp": "3ff9204fa9",
   "kr": "그 할머니를 설득하려면"
  },
  "60": {
   "jp": "c1706d3c95",
   "kr": "옛날이야기를 하는 게 좋을 거야."
  },
  "61": {
   "jp": "c541fbd2b5",
   "kr": "더글라스를 데려가면 좋겠군."
  },
  "62": {
   "jp": "0b6234acd4",
   "kr": "그 녀석도 카스톨의 제자니까."
  },
  "63": {
   "jp": "b2302eb065",
   "kr": "맥스 녀석의 의뢰를 맡았다며?"
  },
  "64": {
   "jp": "a38e826c83",
   "kr": "그럼 재미있는 이야기가 있어."
  },
  "65": {
   "jp": "615e750176",
   "kr": "30로제면 알려 주지."
  },
  "66": {
   "jp": "04accc855a",
   "kr": "코르나에 있는 어머니라는 사람은"
  },
  "67": {
   "jp": "9c0720be38",
   "kr": "맥스의 진짜 어머니가 아니야."
  },
  "68": {
   "jp": "63f19845f3",
   "kr": "그 녀석이 검술 수행을 하던 때의 스승,"
  },
  "69": {
   "jp": "558fb3503c",
   "kr": "카스톨의 부인이지."
  },
  "70": {
   "jp": "238861dc0f",
   "kr": "카스톨?"
  },
  "71": {
   "jp": "763d0d3f10",
   "kr": "그럼 맥스라는 건"
  },
  "72": {
   "jp": "6047319923",
   "kr": "베이비페이스 맥스를 말하는 건가?"
  },
  "73": {
   "jp": "1736b84b1f",
   "kr": "알아?"
  },
  "74": {
   "jp": "1252abab05",
   "kr": "알다마다, 내 스승이 바로 카스톨이야."
  },
  "75": {
   "jp": "d9d916a11f",
   "kr": "맥스는 내 의형제지."
  },
  "76": {
   "jp": "9970962149",
   "kr": "거기까지 알면 나머지는 쉽잖아?"
  },
  "77": {
   "jp": "5f3b444f86",
   "kr": "더글라스, 네가 가면 되는 거야."
  },
  "78": {
   "jp": "09a2b08e05",
   "kr": "옛날이야기라도 하면서 설득해 봐."
  },
  "79": {
   "jp": "a257cdab56",
   "kr": "아, 그거라면"
  },
  "80": {
   "jp": "674325c4b0",
   "kr": "이 일을 맡았을 때부터 알고 있어."
  },
  "81": {
   "jp": "f57fe47be3",
   "kr": "어?",
   "auto": 1
  },
  "82": {
   "jp": "5131394970",
   "kr": "뭐야, 알고 있었나."
  },
  "83": {
   "jp": "c20159a6d0",
   "kr": "그럼 내가 알려 줄 게 아무것도 없군."
  },
  "84": {
   "jp": "6ac0ecba2b",
   "kr": "카스톨의 가르침을 같이 받은 더글라스가"
  },
  "85": {
   "jp": "ecb14b2d05",
   "kr": "옛날이야기로 설득하라고 말할 생각이었어."
  },
  "86": {
   "jp": "ffba7a7937",
   "kr": "이거 미안하게 됐군."
  },
  "87": {
   "jp": "2413405869",
   "kr": "정보료를 돌려받았다."
  },
  "88": {
   "jp": "973135d845",
   "kr": "어이, 기다리고 있었어."
  },
  "89": {
   "jp": "041edb978d",
   "kr": "루크레프 관련 최신 정보가 들어왔어."
  },
  "90": {
   "jp": "4473e40328",
   "kr": "잠자코 100로제 내."
  },
  "91": {
   "jp": "8eae93841c",
   "kr": "아직 확인 안 된 소문인데 말이야."
  },
  "92": {
   "jp": "0555beee75",
   "kr": "바로아 은광산으로 향하는 루크레프를"
  },
  "93": {
   "jp": "9a47401e0d",
   "kr": "봤다는 녀석이 있어."
  },
  "94": {
   "jp": "a96bf67346",
   "kr": "은광산이라지만 좋은 은이 안 나와서"
  },
  "95": {
   "jp": "4ba5633f0e",
   "kr": "내버려져 있거든."
  },
  "96": {
   "jp": "85f5c476a8",
   "kr": "샴실단의 아지트가 됐다는 얘기도 있어."
  },
  "97": {
   "jp": "a7ae909dd2",
   "kr": "아무튼 서두르는 게 좋아."
  },
  "98": {
   "jp": "c7d51af27b",
   "kr": "루크레프 사건을 맡았나."
  },
  "99": {
   "jp": "57dba6ce1b",
   "kr": "그건 어려운 사건이지."
  },
  "100": {
   "jp": "3fd410ec1a",
   "kr": "나도 좀"
  },
  "101": {
   "jp": "af9cd1ba06",
   "kr": "정보라 할 만한 게 없는 건 아닌데."
  },
  "102": {
   "jp": "ffabf5b934",
   "kr": "아직 확실하지 않아."
  },
  "103": {
   "jp": "537d4a7682",
   "kr": "잠시 뒤에 다시 와 줘."
  },
  "104": {
   "jp": "74564a0c08",
   "kr": "괜찮은 정보를 구해 놓을 테니까."
  },
  "105": {
   "jp": "81feeab612",
   "kr": "루크레프를 찾았다고?"
  },
  "106": {
   "jp": "6740da66bf",
   "kr": "큰 공을 세웠군."
  },
  "107": {
   "jp": "3702af4071",
   "kr": "샴실단과 얽혀 있나."
  },
  "108": {
   "jp": "b9678b6d73",
   "kr": "진짜인지 거짓인지 모르지만"
  },
  "109": {
   "jp": "bbc47e462e",
   "kr": "놈들은 마수를 조종하는 연구를 하는 모양이야."
  },
  "110": {
   "jp": "571360147d",
   "kr": "그래, 50로제만 주면 좋은 정보를 주지."
  },
  "111": {
   "jp": "3ab1200b57",
   "kr": "들어 볼래?",
   "auto": 1
  },
  "112": {
   "jp": "16fb9007f6",
   "kr": "골다 동굴의 마수들은 좀 이상해."
  },
  "113": {
   "jp": "21310cd313",
   "kr": "마치 누군가에게 조종당하는 것처럼"
  },
  "114": {
   "jp": "d89a5320b7",
   "kr": "정해진 장소에만 나타나."
  },
  "115": {
   "jp": "30257402bb",
   "kr": "게다가 한 번 동굴에서 나가면"
  },
  "116": {
   "jp": "d6be8eb350",
   "kr": "새 마수가 자리를 잡아 버려."
  },
  "117": {
   "jp": "80565f165a",
   "kr": "골다 동굴에는 최근 샴실단이"
  },
  "118": {
   "jp": "309adcb9c9",
   "kr": "드나든다는 소문도 있으니"
  },
  "119": {
   "jp": "cfc6288b89",
   "kr": "정신 바짝 차리고 일해."
  },
  "120": {
   "jp": "5aed1206e6",
   "kr": "'더글라스 씨 호출'을 맡았다며?"
  },
  "121": {
   "jp": "3ecb7ed375",
   "kr": "조심하는 게 좋을 거야."
  },
  "122": {
   "jp": "f52689d6d8",
   "kr": "그게 무슨 뜻이야?"
  },
  "123": {
   "jp": "d2d8a7fde0",
   "kr": "헤헤헤, 네 가슴에 손을 얹고 물어봐."
  },
  "124": {
   "jp": "bf4fa9df82",
   "kr": "왜 그래, 뭘 찾고 있나?"
  },
  "125": {
   "jp": "a32b49e0f5",
   "kr": "사람을 찾고 있어."
  },
  "126": {
   "jp": "7cf8f3472c",
   "kr": "닥터 반들을 몰라?"
  },
  "127": {
   "jp": "8f834fcca9",
   "kr": "닥터 반들인가."
  },
  "128": {
   "jp": "c92c2af9bb",
   "kr": "알지."
  },
  "129": {
   "jp": "781151a82f",
   "kr": "200로제 내면 가르쳐 주지 못할 것도 없지."
  },
  "130": {
   "jp": "87a1ba6baa",
   "kr": "헤헤헤, 고맙군."
  },
  "131": {
   "jp": "c6380b27f7",
   "kr": "반들 선생은 발크드에 있어."
  },
  "132": {
   "jp": "2d19631e7d",
   "kr": "지금은 별다른 정보가 없어.",
   "auto": 1
  },
  "133": {
   "jp": "9f13840241",
   "kr": "너야말로 뭔가 알려 주지 않겠어?"
  },
  "134": {
   "jp": "5f8ee3bb32",
   "kr": "미안하지만 이쪽도 장사라서.",
   "auto": 1
  },
  "135": {
   "jp": "ba6efa0186",
   "kr": "공짜로 알려 줄 만한 정보는 없어."
  },
  "136": {
   "jp": "3f3ca237b6",
   "kr": "그래.",
   "auto": 1
  },
  "137": {
   "jp": "068673e058",
   "kr": "마음이 바뀌면 또 와."
  },
  "138": {
   "jp": "fd532bbe89",
   "kr": "옛날이야기라도 하면서 설득해 보라고"
  },
  "139": {
   "jp": "a87bd34f92",
   "kr": "말해 줄 참이었지."
  }
 }
}
