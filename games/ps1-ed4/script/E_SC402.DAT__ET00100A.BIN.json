{
 "archive": "/E/SC402.DAT",
 "member": "..\\BIN\\ET00100A.BIN",
 "segments": {
  "0": {
   "jp": "b5c0ef4bd0",
   "kr": "모시가 재채기를 했어."
  },
  "1": {
   "jp": "78ce34c7c8",
   "kr": "뭐야, 벌써 시작된 거야?"
  },
  "2": {
   "jp": "c855f77e63",
   "kr": "두 번 연속이야."
  },
  "3": {
   "jp": "cb84ee1d82",
   "kr": "빨리 돌아가지 않으면 큰 소용돌이가 생기겠어."
  },
  "4": {
   "jp": "a310693b02",
   "kr": "어쩔 수 없군… 돌아가자."
  },
  "5": {
   "jp": "c45aed443f",
   "kr": "키를 왼쪽으로 끝까지!"
  },
  "6": {
   "jp": "fc90ace34e",
   "kr": "자, 잠깐 쉬자고."
  },
  "7": {
   "jp": "a84ee95733",
   "kr": "뭐 재미있는 얘기라도 들려줘 봐."
  },
  "8": {
   "jp": "a074144738",
   "kr": "여기저기 여행하고 있잖아?"
  },
  "9": {
   "jp": "cedebb601f",
   "kr": "왜 스코티아 님의 사당에"
  },
  "10": {
   "jp": "fdc897ca74",
   "kr": "들어가고 싶은 거야?"
  },
  "11": {
   "jp": "e62e3e14f9",
   "kr": "그건…"
  },
  "12": {
   "jp": "0de5114c12",
   "kr": "좀 복잡한 사정이 있어서 말이야."
  },
  "13": {
   "jp": "77ea747489",
   "kr": "뭐야, 뜸 들이지 말고."
  },
  "14": {
   "jp": "a762736367",
   "kr": "이봐, 얘기해 보라고…"
  },
  "15": {
   "jp": "2ef9f09c29",
   "kr": "뭐, 뭐야!?"
  },
  "16": {
   "jp": "80fa7a1b61",
   "kr": "젠장, 키가…"
  },
  "17": {
   "jp": "539fe2dbaf",
   "kr": "오스카?"
  },
  "18": {
   "jp": "f36c11041c",
   "kr": "키가 말을 안 들어!!"
  },
  "19": {
   "jp": "d7a0233800",
   "kr": "누구 좀 도와줘!!"
  },
  "20": {
   "jp": "c4ed88ecb7",
   "kr": "괜찮아, 오스카!"
  },
  "21": {
   "jp": "22e34791c1",
   "kr": "어쩔 수가 없어."
  },
  "22": {
   "jp": "0d25cff09b",
   "kr": "땅 위에서 키를 돌리는 것 같아."
  },
  "23": {
   "jp": "85a3d9cb85",
   "kr": "헛돌기만 하고 배가 움직이지 않아…"
  },
  "24": {
   "jp": "52deac9a74",
   "kr": "어, 저걸 봐!!"
  },
  "25": {
   "jp": "0fbe903827",
   "kr": "뭐… 뭐야, 저건?"
  },
  "26": {
   "jp": "4e036c4b51",
   "kr": "괴물 꼬리 같아."
  },
  "27": {
   "jp": "07983f3d4f",
   "kr": "괴물이라니, 설마"
  },
  "28": {
   "jp": "6ee501ee87",
   "kr": "모시…"
  },
  "29": {
   "jp": "51e60f8b33",
   "kr": "진짜로 있었다는 거야!?"
  },
  "30": {
   "jp": "bd1a632b66",
   "kr": "으악, 오스카!!"
  },
  "31": {
   "jp": "e01c994e31",
   "kr": "제라르!"
  },
  "32": {
   "jp": "fdc14d9fe4",
   "kr": "사, 살려 줘"
  },
  "33": {
   "jp": "4a4ede8420",
   "kr": "눈, 눈, 눈알이…!!"
  },
  "34": {
   "jp": "33e7102bde",
   "kr": "뭐야, 이 눈은!!"
  },
  "35": {
   "jp": "c29875d724",
   "kr": "어, 어, 어떡하지, 오스카…"
  },
  "36": {
   "jp": "579d24826d",
   "kr": "에잇, 이런 괴물한테 얕보일 수는 없지!"
  },
  "37": {
   "jp": "3f66299c45",
   "kr": "키트 사나이의 근성을 보여 주마!!"
  },
  "38": {
   "jp": "94053a5033",
   "kr": "먹어라, 모시!!"
  },
  "39": {
   "jp": "d2da9d1da8",
   "kr": "해냈다!!"
  },
  "40": {
   "jp": "6fcc8f7dc6",
   "kr": "봤냐, 모시 녀석!!"
  },
  "41": {
   "jp": "f67083fe8e",
   "kr": "오스카, 좋아할 때가 아니야."
  },
  "42": {
   "jp": "bf8732747b",
   "kr": "이 틈에 돌아가자!"
  },
  "43": {
   "jp": "d1c9a190e2",
   "kr": "나왔다, 모시다!"
  },
  "44": {
   "jp": "08d9c29a4f",
   "kr": "왔구나!"
  },
  "45": {
   "jp": "6aedf966c3",
   "kr": "야옹아, 여기서 얌전히 있어."
  }
 }
}
