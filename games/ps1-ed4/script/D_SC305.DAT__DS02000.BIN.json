  "0": {
   "jp": "69db0317d2",
   "kr": "소녀",
   "auto": 1
  },
  "1": {
   "jp": "991bcc2f6b",
   "kr": "가르시아",
   "auto": 1
  },
  "2": {
   "jp": "b0c29a43b0",
   "kr": "조심해서 돌아가렴."
  },
  "3": {
   "jp": "00434eb51d",
   "kr": "반반이 있으니까 괜찮아."
  },
  "4": {
   "jp": "4318a8445f",
   "kr": "고마워, 오빠."
  },
  "5": {
   "jp": "8bf8227fd1",
   "kr": "안녕～!"
  },
  "6": {
   "jp": "524d372594",
   "kr": "의뢰 완료다.",
   "auto": 1
  },
  "7": {
   "jp": "1e50b1893b",
   "kr": "이놈, 어빈!!"
  },
  "8": {
   "jp": "b87e07eccd",
   "kr": "이 동굴에는 다가가면 안 되네."
  },
  "9": {
   "jp": "1e50b1893b",
   "kr": "이놈, 어빈!!"
  },
  "10": {
   "jp": "b87e07eccd",
   "kr": "이 동굴에는 다가가면 안 되네."
  },
  "11": {
   "jp": "46c028cb33",
   "kr": "그럴 수는 없어."
  },
  "12": {
   "jp": "7b250ea943",
   "kr": "이 안에 구해야 할 사람이 있단 말이야."
  },
  "13": {
   "jp": "0184633545",
   "kr": "뭐라고?"
  },
  "14": {
   "jp": "064cffe1b4",
   "kr": "솔론 씨라는 사람과"
  },
  "15": {
   "jp": "3316b7b892",
   "kr": "닥터 반들이라는 의사 선생님이"
  },
  "16": {
   "jp": "7cc13ef2db",
   "kr": "이 동굴에서 돌아오지 않아요."
  },
  "17": {
   "jp": "45491b2f3f",
   "kr": "…흥."
  },
  "18": {
   "jp": "72369ce1af",
   "kr": "그 일이라면 자네들과는 상관없네."
  },
  "19": {
   "jp": "77e48e863c",
   "kr": "상관없지 않아요!"
  },
  "20": {
   "jp": "83adb6bf3a",
   "kr": "알선소의 정식 의뢰라고요."
  },
  "21": {
   "jp": "5899a51fd9",
   "kr": "알선소라고?"
  },
  "22": {
   "jp": "383fe5fc4a",
   "kr": "…그렇군, 그 여선생이 쓸데없는 짓을…"
  },
  "23": {
   "jp": "1507184182",
   "kr": "이봐."
  },
  "24": {
   "jp": "54cbfa1df0",
   "kr": "쓸데없는 짓이라니 무슨 소리야?"
  },
  "25": {
   "jp": "bcadef3592",
   "kr": "영감, 여기서 뭘 하고 있어?"
  },
  "26": {
   "jp": "1b7e68e492",
   "kr": "시끄럽네."
  },
  "27": {
   "jp": "8b162bd0ba",
   "kr": "말해 두겠는데,"
  },
  "28": {
   "jp": "f41e2645c3",
   "kr": "솔론 녀석은 제 발로 여기 들어간 걸세."
  },
  "29": {
   "jp": "49223dbd89",
   "kr": "잠깐만요."
  },
  "30": {
   "jp": "e232cc5c59",
   "kr": "맹독을 가진 마수가 있는 걸 알고 들어갔어요?"
  },
  "31": {
   "jp": "fe43f95a43",
   "kr": "물론일세."
  },
  "32": {
   "jp": "c2a93236f7",
   "kr": "뭐 하려고?"
  },
  "33": {
   "jp": "511383c525",
   "kr": "아, 시끄럽군."
  },
  "34": {
   "jp": "4e272bc30b",
   "kr": "『구옥의 잔』이라는 보물을 가지러 간 걸세."
  },
  "35": {
   "jp": "d932509f2c",
   "kr": "바로 나를 위해서 말일세."
  },
  "36": {
   "jp": "8a12c0d559",
   "kr": "영감을 위해서라고!"
  },
  "37": {
   "jp": "5f4125f86d",
   "kr": "나쁜 사람이네!!"
  },
  "38": {
   "jp": "297fe8e4c2",
   "kr": "어째서 그런 짓을 시켜요!!"
  },
  "39": {
   "jp": "fb3fd148bb",
   "kr": "빚이 있으니 어쩔 수 없지 않나!!"
  },
  "40": {
   "jp": "c3da9b986d",
   "kr": "피해 보는 건 나란 말일세!"
  },
  "41": {
   "jp": "f343dded1b",
   "kr": "솔론 그 멍청이가 돌아오지 않으면"
  },
  "42": {
   "jp": "b6c08f7485",
   "kr": "빌려준 돈은 못 받고, 대신할 보물도 못 얻고…"
  },
  "43": {
   "jp": "bc7c8e9243",
   "kr": "이 자식!"
  },
  "44": {
   "jp": "0342afd3ff",
   "kr": "더는 못 참아!!"
  },
  "45": {
   "jp": "1e50b1893b",
   "kr": "이놈, 어빈!!"
  },
  "46": {
   "jp": "b87e07eccd",
   "kr": "이 동굴에는 다가가면 안 되네."
  },
  "47": {
   "jp": "089f11150b",
   "kr": "왜 안 되는데?"
  },
  "48": {
   "jp": "40e8855b32",
   "kr": "영감이야말로 이런 데서 뭐 하는 거야?"
  },
  "49": {
   "jp": "2dfdcbeee1",
   "kr": "시끄럽다!"
  },
  "50": {
   "jp": "43acc9af99",
   "kr": "들어가면 안 된다면 안 되는 걸세!!"
  },
  "51": {
   "jp": "543d09c576",
   "kr": "어빈!!"
  },
  "52": {
   "jp": "735b3d412a",
   "kr": "감히 날 쳤겠다."
  },
  "53": {
   "jp": "0fbc9801ac",
   "kr": "방금 건 위자료를 청구하겠네."
  },
  "54": {
   "jp": "3c9857c496",
   "kr": "할 수 있으면 해 봐!!"
  },
  "55": {
   "jp": "986ea61a04",
   "kr": "그만해, 어빈!"
  },
  "56": {
   "jp": "85658f52a2",
   "kr": "이런 사람 상대해 봐야 소용없어."
  },
  "57": {
   "jp": "1690a5077a",
   "kr": "시간 낭비야."
  },
  "58": {
   "jp": "e33819e793",
   "kr": "얼른 반들 선생님과 솔론 씨를 구해야 해."
  },
  "59": {
   "jp": "151cf69412",
   "kr": "아, 그래, 맞아."
  },
  "60": {
   "jp": "ad9178cd82",
   "kr": "…하는 김에 『구옥의 잔』인지 뭔지도"
  },
  "61": {
   "jp": "71d148b8e2",
   "kr": "때려 부숴 주겠어!!"
  }
 }
