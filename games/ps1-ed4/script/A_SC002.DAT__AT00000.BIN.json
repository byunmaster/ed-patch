  "168": {
   "jp": "e17161021e",
   "kr": "마수를 쓰러뜨리면"
  },
  "169": {
   "jp": "02a9987b7e",
   "kr": "알마타이트라는 광석을"
  },
  "170": {
   "jp": "0e905dd5fc",
   "kr": "얻을 수 있어."
  },
  "171": {
   "jp": "4de205e398",
   "kr": "그 광석은"
  },
  "172": {
   "jp": "84457e77d6",
   "kr": "가게에서 로제로 바꿔 준다더군."
  },
  "173": {
   "jp": "a7fd935942",
   "kr": "팔심이 세다면 "
  },
  "174": {
   "jp": "ef8e55d7ca",
   "kr": "그걸로 먹고살 수 있을 텐데…"
  },
  "175": {
   "jp": "5c20c7a71f",
   "kr": "여행인가, 좋겠네."
  },
  "176": {
   "jp": "b1bb033c6d",
   "kr": "하지만 작물을 키우는 것도 좋아."
  },
  "177": {
   "jp": "a014b3d805",
   "kr": "봄에는 새싹이 숨 쉬고"
  },
  "178": {
   "jp": "bb57d2564a",
   "kr": "가을에는 결실의 꽃이 핀다."
  },
  "179": {
   "jp": "6ee14d1f8c",
   "kr": "여행하며 사는 것도 좋지만"
  },
  "180": {
   "jp": "4a0493d930",
   "kr": "나처럼 대지와 함께 사는 것도"
  },
  "181": {
   "jp": "0f4ac904ba",
   "kr": "꽤 괜찮다고."
  },
  "182": {
   "jp": "c2b8965506",
   "kr": "그 마일이 말이지…"
  },
  "183": {
   "jp": "37690f4c06",
   "kr": "그 녀석을 생각해 주는 건"
  },
  "184": {
   "jp": "cd98df9168",
   "kr": "소중한 일이지만"
  },
  "185": {
   "jp": "9c06f90be4",
   "kr": "너무 풀 죽지는 마라."
  },
  "186": {
   "jp": "4f22dac617",
   "kr": "그 녀석도"
  },
  "187": {
   "jp": "d877465df0",
   "kr": "분명 그런 네 모습을"
  },
  "188": {
   "jp": "d3154a18bd",
   "kr": "바라지 않을 거다."
  },
  "189": {
   "jp": "91e3832524",
   "kr": "가을에 쌓이는 낙엽은"
  },
  "190": {
   "jp": "49651ed7a5",
   "kr": "다음 봄에 싹트는 새 작물의"
  },
  "191": {
   "jp": "62f93b54b5",
   "kr": "거름이 되거든."
  },
  "192": {
   "jp": "408ca5e7a9",
   "kr": "대지의 은혜도"
  },
  "193": {
   "jp": "502d19f554",
   "kr": "세상살이도"
  },
  "194": {
   "jp": "2efa52fba3",
   "kr": "헛된 건 하나도 없어."
  },
  "195": {
   "jp": "434f88b9f3",
   "kr": "중요한 건 받아들이는 쪽의 마음이다."
  },
  "196": {
   "jp": "ea52072ece",
   "kr": "쑥스럽네."
  },
  "197": {
   "jp": "6d560a0659",
   "kr": "어빈이 내 일을 맡아 줬구나."
  },
  "198": {
   "jp": "3d6aff1e3d",
   "kr": "아무도 눈치채지 못하게"
  },
  "199": {
   "jp": "da83d88a2c",
   "kr": "먼 곳의 알선소에 부탁했는데 말이야."
  },
  "200": {
   "jp": "734394804b",
   "kr": "아니, 예전부터 모험가를 동경했거든."
  },
  "201": {
   "jp": "3f9a4498db",
   "kr": "하다못해 검 한 자루라도 갖고 싶었어."
  },
  "202": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "203": {
   "jp": "f6bca41636",
   "kr": "을(를) 건넸다."
  },
  "204": {
   "jp": "67c73e067c",
   "kr": "고마워."
  },
  "205": {
   "jp": "feec12a398",
   "kr": "이 검은 소중히 간직할게."
  },
  "206": {
   "jp": "4d1d9de265",
   "kr": "보수를 알선소에서 받는 걸"
  },
  "207": {
   "jp": "809be30165",
   "kr": "잊지 말아 줘."
  },
  "208": {
   "jp": "80ed241742",
   "kr": "당장 필요한 건 아니니까"
  },
  "209": {
   "jp": "eddcc8b395",
   "kr": "어빈 편할 때 가져다줘도 괜찮아."
  },
  "210": {
   "jp": "a0b7485ee4",
   "kr": "어머, 어빈."
  },
  "211": {
   "jp": "464a325e89",
   "kr": "참, 그렇지."
  },
  "212": {
   "jp": "c091279bb0",
   "kr": "어빈도 마법을 조금은 쓸 수 있었지."
  },
  "213": {
   "jp": "b9da1841ec",
   "kr": "들은 이야기인데"
  },
  "214": {
   "jp": "0dc13bf247",
   "kr": "큰 마을 같은 데에는 마법 길드라고 불리는"
  },
  "215": {
   "jp": "0a2473127d",
   "kr": "건물이 있대."
  },
  "216": {
   "jp": "b58a2c40e1",
   "kr": "거기서 능력을 봐 달라고 하면"
  },
  "217": {
   "jp": "415d0f4bd9",
   "kr": "역량에 맞는"
  },
  "218": {
   "jp": "e9edc90eaf",
   "kr": "새 마법을 쓸 수 있게 된대."
  },
  "219": {
   "jp": "3213b9909b",
   "kr": "어머, 오랜만이야."
  },
  "220": {
   "jp": "536f05a056",
   "kr": "어디 갔다 왔어?"
  },
  "221": {
   "jp": "c1636a4ced",
   "kr": "여행이야."
  },
  "222": {
   "jp": "1d502305f8",
   "kr": "어빈의 여동생을 찾으려고"
  },
  "223": {
   "jp": "a52e3d4e6e",
   "kr": "여행하고 있어."
  },
  "224": {
   "jp": "1bf6b133e7",
   "kr": "그래, 빨리 찾았으면 좋겠네."
  },
  "225": {
   "jp": "771e215b5d",
   "kr": "마일은 성실한 점이"
  },
  "226": {
   "jp": "58ffbf8b52",
   "kr": "매력이니까"
  },
  "227": {
   "jp": "28cabe69b9",
   "kr": "여행지에서 나쁜 걸 배우면 안 돼."
  },
  "228": {
   "jp": "8cb11648a4",
   "kr": "알겠지?"
  },
  "229": {
   "jp": "0d100cc4e5",
   "kr": "……",
   "auto": 1
  },
  "230": {
   "jp": "06a9736bdf",
   "kr": "마일이… 그럴 수가…"
  },
  "231": {
   "jp": "0d100cc4e5",
   "kr": "……",
   "auto": 1
  },
  "232": {
   "jp": "1aef0725e1",
   "kr": "어릴 적에"
  },
  "233": {
   "jp": "45762434c2",
   "kr": "자주 함께 놀았는데."
  },
  "234": {
   "jp": "fbde33885d",
   "kr": "돌아오는 걸… 기대하고 있었는데."
  },
  "235": {
   "jp": "0d100cc4e5",
   "kr": "……",
   "auto": 1
  },
  "236": {
   "jp": "ae936341df",
   "kr": "…미안해."
  },
  "237": {
   "jp": "8b0cab1483",
   "kr": "어빈 탓이 아닌데 말이야."
  },
  "238": {
   "jp": "a57a673f95",
   "kr": "괴로운 보고였지만"
  },
  "239": {
   "jp": "781acd3d65",
   "kr": "어빈에게는 마일에 대해"
  },
  "240": {
   "jp": "b75ecfdbc6",
   "kr": "마일의 부모님께 알릴 의무가 있었다."
  },
  "241": {
   "jp": "48fe48451e",
   "kr": "마일…"
  },
  "242": {
   "jp": "1980a1823d",
   "kr": "울트 마을이야."
  },
  "243": {
   "jp": "39d72913aa",
   "kr": "…돌아왔구나."
  },
  "244": {
   "jp": "8f90f55f61",
   "kr": "내 친구 마일 여기 잠들다."
  }
 }
