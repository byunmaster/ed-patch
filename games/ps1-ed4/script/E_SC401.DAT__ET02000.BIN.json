  },
  "18": {
   "jp": "722cfde4b3",
   "kr": "짐칸 오른쪽"
  },
  "19": {
   "jp": "cf1b24212c",
   "kr": "헉, 헉…"
  },
  "20": {
   "jp": "623c415871",
   "kr": "몇 번이고 달리게 하지 마세요, 너무하세요."
  },
  "21": {
   "jp": "39b326399b",
   "kr": "편히 쉬십시오."
  },
  "22": {
   "jp": "9891839cf5",
   "kr": "방에서 기다려 달라고 하십니다."
  },
  "23": {
   "jp": "0ad46afd4f",
   "kr": "반환식 준비가 되는 대로 부르러 오겠습니다."
  },
  "24": {
   "jp": "c2f238feb0",
   "kr": "달라진 점은 없습니다."
  },
  "25": {
   "jp": "3c83e5a254",
   "kr": "어빈 씨.",
   "auto": 1
  },
  "26": {
   "jp": "138a81c550",
   "kr": "그만 좀 하세요!"
  },
  "27": {
   "jp": "6407b2b833",
   "kr": "저는 이제 달리는 건 싫다고요."
  },
  "28": {
   "jp": "bb2ec210cb",
   "kr": "가웨인 님께 혼내 달라고 할 거예요!!"
  },
  "29": {
   "jp": "484a18415f",
   "kr": "곧 신보 반환식을 거행하니"
  },
  "30": {
   "jp": "f4a15dd5d3",
   "kr": "방에서 기다려 달라고 하십니다."
  },
  "31": {
   "jp": "cf1b24212c",
   "kr": "헉, 헉…"
  },
  "32": {
   "jp": "df7fb22161",
   "kr": "알았으면 이제 그만 달리게 하세요."
  },
  "33": {
   "jp": "3ecfd52767",
   "kr": "미첼 씨. 여러모로 고마워요."
  },
  "34": {
   "jp": "f4d2f11425",
   "kr": "함께 가 주셔서 도움이 됐어요."
  },
  "35": {
   "jp": "e23e1e655f",
   "kr": "루티스 씨의 저주가 풀려서 정말 다행이에요."
  },
  "36": {
   "jp": "42e5a00a91",
   "kr": "진실의 섬까지 간 보람이 있었어요."
  },
  "37": {
   "jp": "dbdee2d283",
   "kr": "일부러 와 주셨는데"
  },
  "38": {
   "jp": "9dffc187fa",
   "kr": "대접도 못 하고 오히려 일을 시킨 듯하여"
  },
  "39": {
   "jp": "e55058113e",
   "kr": "미안했소."
  },
  "40": {
   "jp": "4aebefe3f7",
   "kr": "이에 질리지 말고"
  },
  "41": {
   "jp": "fd9aee69a6",
   "kr": "부디 또 들러 주시오."
  },
  "42": {
   "jp": "283fb80f5b",
   "kr": "네. 꼭이요."
  },
  "43": {
   "jp": "9ba74ac7ee",
   "kr": "정말 도움이 되었소. 다시 만날 날을 기대하고 있겠소."
  },
  "44": {
   "jp": "1ca72f9b84",
   "kr": "배 위에서 말씀드린 일, 잘 부탁드려요."
  },
  "45": {
   "jp": "65fb585b27",
   "kr": "무언가를 함께 만들어 가는 발전적인 관계로 바꾼다."
  },
  "46": {
   "jp": "4e0c4bd76c",
   "kr": "…그 일 말이구려."
  },
  "47": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "48": {
   "jp": "2ddf0c5563",
   "kr": "알겠소."
  },
  "49": {
   "jp": "07cefa9b65",
   "kr": "그럼, 실례하겠습니다."
  },
  "50": {
   "jp": "3a99e1bcad",
   "kr": "이(가) 일행에서 떠났다."
  }
