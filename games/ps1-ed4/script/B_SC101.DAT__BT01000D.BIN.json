{
 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT01000D.BIN",
 "segments": {
  "0": {
   "jp": "8b25545999",
   "kr": "있잖아, 알아?"
  },
  "1": {
   "jp": "bd7edbff8c",
   "kr": "니레 씨 댁에 있던 여자애가"
  },
  "2": {
   "jp": "24f8d84522",
   "kr": "산포도를 따러 간다고 나가서는"
  },
  "3": {
   "jp": "69171b2b9a",
   "kr": "돌아오지 않는대."
  },
  "4": {
   "jp": "fab4a1cf06",
   "kr": "니레 씨라면,"
  },
  "5": {
   "jp": "5eb55c3fad",
   "kr": "그 아주 친절한 노부부 말이야?"
  },
  "6": {
   "jp": "f797166b68",
   "kr": "응, 맞아."
  },
  "7": {
   "jp": "62d516237f",
   "kr": "여행 도중에 쓰러질 뻔한"
  },
  "8": {
   "jp": "5ae332435e",
   "kr": "여자애를 구해 줘서 돌봐 주고 있었던"
  },
  "9": {
   "jp": "0cb8b699fd",
   "kr": "모양인데…"
  },
  "10": {
   "jp": "3a02eaf9ee",
   "kr": "그 여자애가 돌아오지 않는다나 봐."
  },
  "11": {
   "jp": "146944e93d",
   "kr": "어머, 걱정되네."
  },
  "12": {
   "jp": "ebade0fd92",
   "kr": "앗, 모험가다!"
  },
  "13": {
   "jp": "968a88c92e",
   "kr": "모험가한테 부탁하자!"
  },
  "14": {
   "jp": "9b8da52667",
   "kr": "어…?"
  },
  "15": {
   "jp": "e29614fb2b",
   "kr": "왜 갑자기."
  },
  "16": {
   "jp": "37f3ac967d",
   "kr": "모험가다. 모험가다. 와～!"
  },
  "17": {
   "jp": "4306600651",
   "kr": "와～, 와～!"
  },
  "18": {
   "jp": "3dff1beaf5",
   "kr": "저 애…"
  },
  "19": {
   "jp": "167d065c01",
   "kr": "분명 우리를"
  },
  "20": {
   "jp": "76fec2b731",
   "kr": "해결사 같은 거로 생각하고 있어."
  },
  "21": {
   "jp": "b107d463ea",
   "kr": "저기, 여러분."
  },
  "22": {
   "jp": "71314044f0",
   "kr": "잠깐 얘기 좀 하고 싶은데."
  },
  "23": {
   "jp": "5f6e99688b",
   "kr": "하아…"
  },
  "24": {
   "jp": "2da9ca82d2",
   "kr": "마일은 사람이 너무 좋아…"
  },
  "25": {
   "jp": "a2bd2b14d1",
   "kr": "그런 건 아니지만."
  },
  "26": {
   "jp": "ec15dead3c",
   "kr": "둘러싸이면… 거절 못 해."
  },
  "27": {
   "jp": "cc00a5a626",
   "kr": "그런 걸 사람이 좋다고 하는 거야."
  },
  "28": {
   "jp": "5e8cd03fad",
   "kr": "정말 잘 와 주셨구먼."
  },
  "29": {
   "jp": "ff202fbdce",
   "kr": "부디 아가씨를 찾아 주시게."
  },
  "30": {
   "jp": "3917a6df46",
   "kr": "산포도를 따러 나가서 돌아오지 않는다오."
  },
  "31": {
   "jp": "68304db7fa",
   "kr": "그렇답니다."
  },
  "32": {
   "jp": "12937d0836",
   "kr": "…어쩔 수 없네."
  },
  "33": {
   "jp": "068909d952",
   "kr": "그럼 일단 묻겠는데요, 여자애의 특징은?"
  },
  "34": {
   "jp": "164f5ee0db",
   "kr": "이렇게 짧은 밤색 머리에"
  },
  "35": {
   "jp": "65b62860e2",
   "kr": "눈이 크고 하늘색 옷을 입고 있었네."
  },
  "36": {
   "jp": "bdea7cf60d",
   "kr": "나이는, 그래, １７세라고 했던가."
  },
  "37": {
   "jp": "4698261877",
   "kr": "이름은… 어어."
  },
  "38": {
   "jp": "f4bed9a5e7",
   "kr": "아차, 아직 못 물어봤군."
  },
  "39": {
   "jp": "6475142d18",
   "kr": "그야말로 귀여운 아이였다오."
  },
  "40": {
   "jp": "47b24760ff",
   "kr": "듣자 하니 애인을 찾고 있다며"
  },
  "41": {
   "jp": "269ec6ab3c",
   "kr": "여행을 하고 있었던 모양이네."
  },
  "42": {
   "jp": "d40688dda3",
   "kr": "나와 할멈이 산포도를 따고 돌아오는 길에"
  },
  "43": {
   "jp": "6125e9bb6f",
   "kr": "우연히 지나가게 되었지."
  },
  "44": {
   "jp": "bb20b0d25f",
   "kr": "도중에 먹을 것이 떨어져"
  },
  "45": {
   "jp": "21d8b5ae76",
   "kr": "쓰러지기 직전이었다오."
  },
  "46": {
   "jp": "8400a9184b",
   "kr": "가지고 있던 산포도를 먹였더니"
  },
  "47": {
   "jp": "038fe582d9",
   "kr": "어찌나 황송해하던지."
  },
  "48": {
   "jp": "f984d28407",
   "kr": "무슨 인연이니 안정될 때까지"
  },
  "49": {
   "jp": "25225744c7",
   "kr": "아가씨를 돌봐 주기로"
  },
  "50": {
   "jp": "0c8bedf82c",
   "kr": "했는데…"
  },
  "51": {
   "jp": "02d0086c96",
   "kr": "젊어서 금세 좋아져서"
  },
  "52": {
   "jp": "1d471ab234",
   "kr": "우리에게 산포도를 따 오겠다며"
  },
  "53": {
   "jp": "eae9889af2",
   "kr": "숲으로 나갔다오."
  },
  "54": {
   "jp": "2e48e3fd83",
   "kr": "그런데 숲에 나간 채"
  },
  "55": {
   "jp": "c5424f7b13",
   "kr": "돌아오지 않아요."
  },
  "56": {
   "jp": "247e91433e",
   "kr": "산포도 숲은"
  },
  "57": {
   "jp": "3cb66627cc",
   "kr": "안쪽으로 가면 마수도 나온다오."
  },
  "58": {
   "jp": "ec88bdef9f",
   "kr": "걱정이지만 이 늙은이로서는"
  },
  "59": {
   "jp": "3ed94ac5e8",
   "kr": "찾으러 갈 수도 없네."
  },
  "60": {
   "jp": "0c2055c55a",
   "kr": "부디 아가씨를 찾아와"
  },
  "61": {
   "jp": "4c84f2890a",
   "kr": "주지 않겠나?"
  }
 }
}
