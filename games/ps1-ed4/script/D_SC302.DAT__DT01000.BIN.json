  },
  "12": {
   "jp": "1e195f6292",
   "kr": "섀넌",
   "auto": 1
  },
  "13": {
   "jp": "f4035a45c1",
   "kr": "그리그"
  },
  "14": {
   "jp": "e8aacff804",
   "kr": "셰이커"
  },
  "15": {
   "jp": "221046dd0b",
   "kr": "아료"
  },
  "16": {
   "jp": "e25d4f4b4f",
   "kr": "그러니까, 왜 그렇게 되는 건데!"
  },
  "17": {
   "jp": "1018e960d1",
   "kr": "그런 소리 해 봐야"
  },
  "18": {
   "jp": "83afb71f54",
   "kr": "어쩔 수 없잖아!"
  },
  "19": {
   "jp": "a43f4851a5",
   "kr": "누군가는 해야지."
  },
  "20": {
   "jp": "c62f837f22",
   "kr": "그, 러, 니, 까,"
  },
  "21": {
   "jp": "ccfdbabd4e",
   "kr": "그런데 왜 내가 해야 하는데?"
  },
  "22": {
   "jp": "f6396f662a",
   "kr": "말 많은 애송이네!"
  },
  "23": {
   "jp": "7ecdbbdaa0",
   "kr": "세상과 남을 위하겠다는 마음은 없냐!"
  },
  "24": {
   "jp": "0fcefa496c",
   "kr": "…때렸겠다!"
  },
  "25": {
   "jp": "b3768a210f",
   "kr": "때렸으면 어쩔 건데?"
  },
  "26": {
   "jp": "b83e16c2a5",
   "kr": "더는 못 참아!"
  },
  "27": {
   "jp": "486a0d194b",
   "kr": "으으, 건방진 놈!!"
  },
  "28": {
   "jp": "a3397484d5",
   "kr": "잠깐만요!"
  },
  "29": {
   "jp": "04cdf8fe29",
   "kr": "두 분 다!"
  },
  "30": {
   "jp": "36908f129a",
   "kr": "뭔데?"
  },
  "31": {
   "jp": "49bd1bc55c",
   "kr": "무슨 이유인지는 모르지만"
  },
  "32": {
   "jp": "bc51c3cd3e",
   "kr": "싸움은 안 좋아요!"
  },
  "33": {
   "jp": "1018e960d1",
   "kr": "그런 소리 해 봐야,"
  },
  "34": {
   "jp": "968e9dbea6",
   "kr": "이 아저씨가!"
  },
  "35": {
   "jp": "fbcc70e2a3",
   "kr": "누가 아저씨냐!?"
  },
  "36": {
   "jp": "4bd6116129",
   "kr": "그게 윗사람한테 할 소리…"
  },
  "37": {
   "jp": "0b1abd5c9b",
   "kr": "그만하라고 말씀드렸는데요!"
  },
  "38": {
   "jp": "8e55c031a0",
   "kr": "대체 뭐가 원인이야?"
  },
  "39": {
   "jp": "f1824242a0",
   "kr": "이 앞 가도 한복판에"
  },
  "40": {
   "jp": "90e4e7c2f9",
   "kr": "수레가 버려져 있어."
  },
  "41": {
   "jp": "7c8b6a383d",
   "kr": "아무튼 방해돼서 못 살겠어."
  },
  "42": {
   "jp": "ecfaa6d2a1",
   "kr": "어디 매너 모르는 놈이"
  },
  "43": {
   "jp": "9901f6c2e2",
   "kr": "버리고 간 거지."
  },
  "44": {
   "jp": "f6bd2d5f5d",
   "kr": "아마 배 손님이겠지만."
  },
  "45": {
   "jp": "7eb1823a9a",
   "kr": "맞아!"
  },
  "46": {
   "jp": "9f1c05050a",
   "kr": "배 손님이 한 짓이잖아."
  },
  "47": {
   "jp": "d62da9f0ce",
   "kr": "그런데 왜 내가 치워야 하는데."
  },
  "48": {
   "jp": "7064c56653",
   "kr": "너는 젊잖아!"
  },
  "49": {
   "jp": "1d47b87171",
   "kr": "젊은 놈이 게으른 소리 하지 마!"
  },
  "50": {
   "jp": "91e4b1986f",
   "kr": "말도 안 돼!"
  },
  "51": {
   "jp": "e078abe164",
   "kr": "…있잖아, 어빈."
  },
  "52": {
   "jp": "7cecc66834",
   "kr": "주인 없는 수레래…"
  },
  "53": {
   "jp": "f80e27c5db",
   "kr": "…발크드까지는 아직 꽤 머니까"
  },
  "54": {
   "jp": "f19b1d8112",
   "kr": "아이멜이랑 섀넌도 있고."
  },
  "55": {
   "jp": "fc8972a7f9",
   "kr": "수레가 있으면 고맙지."
  },
  "56": {
   "jp": "967cf4eceb",
   "kr": "…우리가 받자."
  },
  "57": {
   "jp": "f5fde0e9a1",
   "kr": "이 사람들도 더는 안 싸워도 되고…"
  },
  "58": {
   "jp": "437fc7fa4a",
   "kr": "어?"
  },
  "59": {
   "jp": "4de3ca5ed0",
   "kr": "받아 주는 거야?"
  },
  "60": {
   "jp": "c51949741f",
   "kr": "그 수레를?"
  },
  "61": {
   "jp": "003ab1474f",
   "kr": "어, 그, 그게…"
  },
  "62": {
   "jp": "f382966ebf",
   "kr": "아, 그거 고맙네!"
  },
  "63": {
   "jp": "c0a21dc845",
   "kr": "봐라, 그리그."
  },
  "64": {
   "jp": "e4f9298f70",
   "kr": "이분들 훌륭하지 않으냐."
  },
  "65": {
   "jp": "9122f05f50",
   "kr": "어디 몰상식한 놈이 남긴 뒷정리를"
  },
  "66": {
   "jp": "86e43a87d7",
   "kr": "해 주겠다지 않느냐."
  },
  "67": {
   "jp": "9b1f33737f",
   "kr": "정말이네."
  },
  "68": {
   "jp": "34d45027cf",
   "kr": "나도 본받아야겠다."
  },
  "69": {
   "jp": "7e126705f6",
   "kr": "그럼 잘 부탁해."
  },
  "70": {
   "jp": "deaf99cf77",
   "kr": "수레는 마음대로 처분해도 괜찮으니까."
  },
  "71": {
   "jp": "9d0afb01a6",
   "kr": "…크크크."
  },
  "72": {
   "jp": "5cdc59a061",
   "kr": "…헷헷헷."
  },
  "73": {
   "jp": "37d4ad8bcf",
   "kr": "갔나!"
  },
  "74": {
   "jp": "6b487f476b",
   "kr": "갔네."
  },
  "75": {
   "jp": "2617af79f5",
   "kr": "어수룩한 놈들이야."
  },
  "76": {
   "jp": "8b0d6f23b2",
   "kr": "정말이지."
  },
  "77": {
   "jp": "e0fcacb5ae",
   "kr": "서 ",
   "auto": 1
  },
  "78": {
   "jp": "2c3b43acc6",
   "kr": "남 ",
   "auto": 1
  },
  "79": {
   "jp": "337839dec9",
   "kr": "어서 오세요!"
  },
  "80": {
   "jp": "cec4637e87",
   "kr": "피곤하시면 ２층으로 가세요."
  },
  "81": {
   "jp": "99bab1be8a",
   "kr": "곤란해요, 이런 데까지 들어오시면."
  },
  "82": {
   "jp": "a40b94316c",
   "kr": "일 알선이라면 카운터에서 부탁드립니다."
  },
  "83": {
   "jp": "e6befbf396",
   "kr": "가도에 수레가 버려져 있어서"
  },
  "84": {
   "jp": "1d1f5e2c1d",
   "kr": "마을 사람들이 몹시 곤란해한다고 들었어요."
  },
  "85": {
   "jp": "3a1f491103",
   "kr": "도와드릴 수 없을까요?"
  },
  "86": {
   "jp": "42f8cf6410",
   "kr": "마일 님. 수레 여행이라니 근사하겠죠."
  },
  "87": {
   "jp": "5f5dd14615",
   "kr": "이쪽 가도로 가면 도크스 마을이다."
  },
  "88": {
   "jp": "2431d4efd6",
   "kr": "아무것도 없는 작은 마을이지."
  },
  "89": {
   "jp": "de895518a4",
   "kr": "발크드 정신전 쪽은 남쪽 출구로 가야 해."
  },
  "90": {
   "jp": "db50a50e39",
   "kr": "헷갈리지 마."
  },
  "91": {
   "jp": "7e1c931991",
   "kr": "도크스로 가는 거냐?"
  },
  "92": {
   "jp": "40b1bd06d6",
   "kr": "그런 아무것도 없는 궁상맞은 작은 마을에?"
  },
  "93": {
   "jp": "a66ffbbc1b",
   "kr": "궁상맞은 작은 마을…?"
  },
  "94": {
   "jp": "762096ca15",
   "kr": "그건 너무하세요."
  },
  "95": {
   "jp": "5c23655d15",
   "kr": "모르실지도 모르지만"
  },
  "96": {
   "jp": "c797f93c94",
   "kr": "도크스는 역사적으로 의의 있는 귀한 마을이에요."
  },
  "97": {
   "jp": "0179cb51b9",
   "kr": "그런 말 하면 벌 받아요."
  },
  "98": {
   "jp": "b5b9c31ca4",
   "kr": "어, 그런 거야…"
  },
  "99": {
   "jp": "2b5b262b48",
   "kr": "도, 도크스는 이쪽 가도입니다."
  },
  "100": {
   "jp": "d45d85f498",
   "kr": "수고 많으십니다."
  },
  "101": {
   "jp": "3386f8f3c3",
   "kr": "어, 그 사람 없나요?"
  },
  "102": {
   "jp": "e102f72341",
   "kr": "그 사람, 도크스에 애착이라도 있나?"
  },
  "103": {
   "jp": "725d5520a1",
   "kr": "이 가도를 북쪽으로 가면 있는 도크스 마을은"
  },
  "104": {
   "jp": "7aaf717811",
   "kr": "작지만 아주 유서 깊은 마을이에요."
  },
  "105": {
   "jp": "6a31e3a19c",
   "kr": "도크스의 선조는"
  },
  "106": {
   "jp": "92b6aa1074",
   "kr": "먼 옛날 진실의 섬에 살던 사람들의 후예이고"
  },
  "107": {
   "jp": "37686be8a1",
   "kr": "마을 변두리에는 신목도 있어요."
  },
  "108": {
   "jp": "dafa71b349",
   "kr": "공부했어요."
  },
  "109": {
   "jp": "71bc947b89",
   "kr": "나한테 묻고 싶은 게 있어?"
  },
  "110": {
   "jp": "8304bf9a89",
   "kr": "모험가 정보",
   "auto": 1
  },
  "111": {
   "jp": "a29585b603",
   "kr": "비밀 정보",
   "auto": 1
  },
  "112": {
   "jp": "6ff9e4dcff",
   "kr": "잘 가라.",
   "auto": 1
  },
  "113": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "114": {
   "jp": "7a45185c3e",
   "kr": "무기 일이라면 카운터의"
  },
  "115": {
   "jp": "5cecf803ab",
   "kr": "주인한테 말해 줘요."
  },
  "116": {
   "jp": "cbf3a4f77b",
   "kr": "아아… 어쩌지."
  },
  "117": {
   "jp": "bf2d524ed6",
   "kr": "나는 어떻게 하면 좋지."
  },
  "118": {
   "jp": "cebbfe43de",
   "kr": "인생은 주사위 눈 나름이야."
  },
  "119": {
   "jp": "05cd104016",
   "kr": "알겠냐, 꼬마?"
  },
  "120": {
   "jp": "491a2b9496",
   "kr": "와, 고마워요!!"
  },
  "121": {
   "jp": "f14cc903a3",
   "kr": "기다렸어요, 『질풍의 라빈』."
  },
  "122": {
   "jp": "c9abbfacd1",
   "kr": "리리카에게 책을 건넸다."
  },
  "123": {
   "jp": "5c360c8927",
   "kr": "정말 기뻐요."
  },
  "124": {
   "jp": "18a57527ce",
   "kr": "수고하셨어요."
  },
  "125": {
   "jp": "008763259f",
   "kr": "와, 일을 맡아 주신 분이군요."
  },
  "126": {
   "jp": "625436e1e5",
   "kr": "기다렸어요."
  },
  "127": {
   "jp": "68cf33ae13",
   "kr": "필딘 도서관까지 가 주었으면 해요."
  },
  "128": {
   "jp": "7e11745e13",
   "kr": "지금 『질풍의 라빈』이라는 책이"
  },
  "129": {
   "jp": "3a029a935e",
   "kr": "엄청 유행이라면서요?"
  },
  "130": {
   "jp": "7eff0fc23c",
   "kr": "그런데 저는"
  },
  "131": {
   "jp": "2a02cceb00",
   "kr": "가게 일을 도와야 해서"
  },
  "132": {
   "jp": "60a930ea7e",
   "kr": "밖에 못 나가거든요."
  },
  "133": {
   "jp": "2bb3551cdc",
   "kr": "필딘 도서관에서"
  },
  "134": {
   "jp": "62035a2eb5",
   "kr": "『질풍의 라빈』을 빌려다 줘요."
  },
  "135": {
   "jp": "e7bc3d276b",
   "kr": "지금 왕도에서는"
  },
  "136": {
   "jp": "9df784a810",
   "kr": "엄청 재미있는 소설이 유행이래요."
  },
  "137": {
   "jp": "96553544f2",
   "kr": "저도 읽고 싶어요."
  },
  "138": {
   "jp": "d6fa8fe933",
   "kr": "그러고 보니 당신,"
  },
  "139": {
   "jp": "8caf60d5a5",
   "kr": "라빈이랑 닮은 것 같아요."
  },
  "140": {
   "jp": "47e4964a15",
   "kr": "제 이미지에 딱 맞아요."
  },
  "141": {
   "jp": "8ad5382172",
   "kr": "이 세타는"
  },
  "142": {
   "jp": "bfa259e66e",
   "kr": "말린 생선이 명물이야."
  },
  "143": {
   "jp": "fbc155128d",
   "kr": "키트의 율 할머니께"
  },
  "144": {
   "jp": "78209f3ccc",
   "kr": "드리고 싶어서 말이야."
  },
  "145": {
   "jp": "810be370e0",
   "kr": "내가 말하기 뭣하지만"
  },
  "146": {
   "jp": "090056d58c",
   "kr": "배려심이 있지?"
  },
  "147": {
   "jp": "1d37306ed0",
   "kr": "키트는 꽤 멀지만 잘 부탁해."
  },
  "148": {
   "jp": "e2e09e47e8",
   "kr": "숀의 짐을 맡았다."
  },
  "149": {
   "jp": "4106badfed",
   "kr": "아, 네가 알선소에서…"
  },
  "150": {
   "jp": "7223355f8f",
   "kr": "…잠깐만."
  },
  "151": {
   "jp": "efd0e84f34",
   "kr": "짐이 굉장하네."
  },
  "152": {
   "jp": "e7c2b6e32d",
   "kr": "이래서는 아무것도 못 부탁하겠어."
  },
  "153": {
   "jp": "f9b9b8169e",
   "kr": "배달처는 키트의 율 할머니야."
  },
  "154": {
   "jp": "1bf7b72634",
   "kr": "되도록 빨리 전해 줘."
  },
  "155": {
   "jp": "d975838959",
   "kr": "세타는 좋은 곳이야."
  },
  "156": {
   "jp": "7bc34da6c8",
   "kr": "활기가 있을 뿐 아니라, 독특한 정취가 있어."
  },
  "157": {
   "jp": "8de00f6c46",
   "kr": "잠깐 기다려, 어빈."
  },
  "158": {
   "jp": "e0d661a4d5",
   "kr": "보여 줄 돈도 조금은 있는 게 좋아."
  },
  "159": {
   "jp": "d1c313e31d",
   "kr": "자금을 좀 만들어 올게."
  },
  "160": {
   "jp": "2e8ef4af0c",
   "kr": "저기, 루키어스."
  },
  "161": {
   "jp": "59c01abc44",
   "kr": "도박을 그만둔 이유는?"
  },
