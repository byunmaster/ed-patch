  "7": {
   "jp": "26dfd6b027",
   "kr": "무서운 아저씨들한테 끌려갔어!"
  },
  "8": {
   "jp": "5aa72c8d4c",
   "kr": "어떤 녀석들이야?"
  },
  "9": {
   "jp": "b6ebbe7025",
   "kr": "아무튼 인상이 안 좋은 녀석들이야.     "
  },
  "10": {
   "jp": "e539b7b9d5",
   "kr": "샴 고양이단이라고 했어."
  },
  "11": {
   "jp": "8814f0d722",
