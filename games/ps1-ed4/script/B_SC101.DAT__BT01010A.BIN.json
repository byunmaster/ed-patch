{
 "archive": "/B/SC101.DAT",
 "member": "..\\BIN\\BT01010A.BIN",
 "segments": {
  "0": {
   "jp": "1873e9180d",
   "kr": "어머나, 어빈 군 아니니!"
  },
  "1": {
   "jp": "06af70f9e3",
   "kr": "알선소에서 얘기를 듣고 와 줬니?"
  },
  "2": {
   "jp": "64e881e9b5",
   "kr": "앤디 씨가 납치됐다면서요?"
  },
  "3": {
   "jp": "93d548861a",
   "kr": "그래, 샴실단 녀석들한테 말이야!"
  },
  "4": {
   "jp": "4494def6f7",
   "kr": "협박장이 왔어."
  },
  "5": {
   "jp": "8edb317eb7",
   "kr": "１００００로제를 마련하지 않으면 그 애를 죽인대."
  },
  "6": {
   "jp": "39dd2c6517",
   "kr": "터무니없는 돈을 불렀네!"
  },
  "7": {
   "jp": "da5a95183a",
   "kr": "어빈 군, 앤디는 그런 애지만"
  },
  "8": {
   "jp": "7bb8604a52",
   "kr": "나한테는 하나뿐인 아들이야."
  },
  "9": {
   "jp": "05e81a421f",
   "kr": "그런데 나한테는"
  },
  "10": {
   "jp": "7931599456",
   "kr": "몸값을 낼 만큼 로제가 없단다…"
  },
  "11": {
   "jp": "ecc833f859",
   "kr": "아이참, 아주머니답지 않게 왜 그래."
  },
  "12": {
   "jp": "6f0a2f125b",
   "kr": "더 기운 내."
  },
  "13": {
   "jp": "cbebfbb9d5",
   "kr": "악당한테는 １로제도 줄 필요 없어."
  },
  "14": {
   "jp": "4c48733c42",
   "kr": "우리한테 맡겨."
  },
  "15": {
   "jp": "79758cafcf",
   "kr": "고마워."
  },
  "16": {
   "jp": "7059c90057",
   "kr": "네가 그렇게 말해 주니 용기가 나는구나."
  },
  "17": {
   "jp": "bb9006dbd9",
   "kr": "앤디 씨는 어디에 잡혀 있나요?"
  },
  "18": {
   "jp": "d468bf96ce",
   "kr": "가라일 동굴이야."
  },
  "19": {
   "jp": "fb5fd9e5c1",
   "kr": "베네키아 수도원으로 가는 길에서 벗어나"
  },
  "20": {
   "jp": "b1505693b7",
   "kr": "산길로 들어간 곳에 있어."
  },
  "21": {
   "jp": "f2c6602fe9",
   "kr": "가라일 동굴이군."
  },
  "22": {
   "jp": "0ae93554c4",
   "kr": "좋아, 알았어."
  },
  "23": {
   "jp": "b64340a05e",
   "kr": "곧 돌아올게."
  },
  "24": {
   "jp": "58d1367ae8",
   "kr": "부탁해, 어빈 군."
  },
  "25": {
   "jp": "7a4dd7c8d6",
   "kr": "앤디를 구해 주렴."
  },
  "26": {
   "jp": "415adb396e",
   "kr": "어빈 군!"
  },
  "27": {
   "jp": "2ea0246eea",
   "kr": "앤디는 아직 잡혀 있니?"
  },
  "28": {
   "jp": "975c651d85",
   "kr": "아니, 이제 걱정 안 해도 돼…"
  },
  "29": {
   "jp": "11d565f93d",
   "kr": "어빈은 가라일 동굴에서 있었던 일을 이야기했다."
  },
  "30": {
   "jp": "ec3ed6083a",
   "kr": "뭐라고?"
  },
  "31": {
   "jp": "a4854279d8",
   "kr": "내 생활비 소포를 가지러 갔다가 이런 일이 생겼다고?"
  },
  "32": {
   "jp": "c149bde434",
   "kr": "…음…"
  },
  "33": {
   "jp": "ce80e85afc",
   "kr": "저희도"
  },
  "34": {
   "jp": "159d6e5dee",
   "kr": "안젤라 씨께 얼굴을 보여 드리라고"
  },
  "35": {
   "jp": "cd5965e126",
   "kr": "말했는데요."
  },
  "36": {
   "jp": "e930d4bdf4",
   "kr": "앤디 씨는 바로 가 버렸어요."
  },
  "37": {
   "jp": "cb01dd97be",
   "kr": "아니, 괜찮아."
  },
  "38": {
   "jp": "5521c1c034",
   "kr": "그 애 얼굴은 이미 질리도록 봤으니까."
  },
  "39": {
   "jp": "a27ad6e136",
   "kr": "무사하면 됐지."
  },
  "40": {
   "jp": "291d77757c",
   "kr": "그런 것보다 자네들에게 폐를 끼쳐서…"
  },
  "41": {
   "jp": "a61cce3fad",
   "kr": "우린 괜찮아."
  },
  "42": {
   "jp": "8522cac89b",
   "kr": "일이니까."
  },
  "43": {
   "jp": "4dfa99bf5c",
   "kr": "아아… 그렇게 말해 주니 조금은 마음이 편하네만"
  },
  "44": {
   "jp": "9d6be8369d",
   "kr": "…정말 창피하구나!"
  },
  "45": {
   "jp": "f97eb78110",
   "kr": "앤디도 앤디지만 나도 나야."
  },
  "46": {
   "jp": "db8b3e52d7",
   "kr": "정말 고마워, 어빈 군."
  },
  "47": {
   "jp": "4749ff2b59",
   "kr": "언젠가 그 애가 포기하고 돌아올 때까지"
  },
  "48": {
   "jp": "1495b2ae8a",
   "kr": "나는 느긋하게 기다리련다."
  },
  "49": {
   "jp": "167e350767",
   "kr": "내 생활비 소포를 가지러 갔다가"
  },
  "50": {
   "jp": "35e5adf7dc",
   "kr": "이런 일이 생겼다고?"
  },
  "51": {
   "jp": "114123194e",
   "kr": "그보다도"
  },
  "52": {
   "jp": "d027db29f0",
   "kr": "너희에게 폐를 끼치고 말았구나…"
  },
  "53": {
   "jp": "c19f41742e",
   "kr": "아아…"
  },
  "54": {
   "jp": "f986c19ba0",
   "kr": "그렇게 말해 주니 조금은 마음이 편하지만."
  }
 }
}
