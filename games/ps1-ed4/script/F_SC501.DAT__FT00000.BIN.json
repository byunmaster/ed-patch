{
 "archive": "/F/SC501.DAT",
 "member": "..\\BIN\\FT00000.BIN",
 "segments": {
  "0": {
   "jp": "a0ee75e023",
   "kr": "에스페리우스의 영혼"
  },
  "1": {
   "jp": "d6ddab97a3",
   "kr": "사신관 볼게이드"
  },
  "2": {
   "jp": "88cf69f92f",
   "kr": "이 제단은…"
  },
  "3": {
   "jp": "8ce236977c",
   "kr": "후후후…"
  },
  "4": {
   "jp": "5089038dcc",
   "kr": "볼게이드…!?"
  },
  "5": {
   "jp": "ef09c03b52",
   "kr": "호오…"
  },
  "6": {
   "jp": "c6e99b5de3",
   "kr": "너희가 먼저 찾아와 줄 줄은"
  },
  "7": {
   "jp": "1ac1a89a00",
   "kr": "생각도 못 했다."
  },
  "8": {
   "jp": "2a5ab165cd",
   "kr": "힘의 차이를 느끼고 떨고만 있는 줄 알았건만."
  },
  "9": {
   "jp": "2e9565049c",
   "kr": "여기서 공격으로 나서다니."
  },
  "10": {
   "jp": "fa401b55bd",
   "kr": "…정말이지."
  },
  "11": {
   "jp": "6a7fafb9d4",
   "kr": "분수를 모르는 것도 정도가 있지."
  },
  "12": {
   "jp": "05a3067295",
   "kr": "너만은 용서 못 해."
  },
  "13": {
   "jp": "de74d266b4",
   "kr": "여전히 철딱서니 없는 놈이로군."
  },
  "14": {
   "jp": "595aa43b93",
   "kr": "아직도 개인적인 감상에 휘둘리고 있다니."
  },
  "15": {
   "jp": "05ce8eeb11",
   "kr": "너희는 스스로가"
  },
  "16": {
   "jp": "53dc42dae8",
   "kr": "이 세계의 주인공이라도 되는 줄 아느냐?"
  },
  "17": {
   "jp": "e490082afa",
   "kr": "휩쓸릴 뿐인 존재라는 걸"
  },
  "18": {
   "jp": "170351ec70",
   "kr": "어째서 모르느냐…?"
  },
  "19": {
   "jp": "7a81458601",
   "kr": "이 세계는 너희 따위는 무시한 채"
  },
  "20": {
   "jp": "a8469fa358",
   "kr": "아득한 태곳적부터 방향이 정해져 있다."
  },
  "21": {
   "jp": "6e0222ef29",
   "kr": "이제 와서 힘없는 자들이 무엇을 한들"
  },
  "22": {
   "jp": "5d725f7930",
   "kr": "바뀔 것은 이 세상에 아무것도 없다."
  },
  "23": {
   "jp": "07b5dcbf2a",
   "kr": "이미 베리어스 경은 봉인의 땅으로 향하셨다."
  },
  "24": {
   "jp": "6525ead2d4",
   "kr": "명계신 둘가의 힘으로"
  },
  "25": {
   "jp": "5630473670",
   "kr": "오크툼 신을 부활시키기 위해서지."
  },
  "26": {
   "jp": "4a7b5fd40b",
   "kr": "둘가의 힘이라고…?"
  },
  "27": {
   "jp": "1a490d40de",
   "kr": "후후…"
  },
  "28": {
   "jp": "b36271c7a5",
   "kr": "그러니 너희가 어리석다는 거다."
  },
  "29": {
   "jp": "22bc11b60b",
   "kr": "아무것도 알지 못하는군."
  },
  "30": {
   "jp": "61cec12bd3",
   "kr": "명계신 둘가를 우리가 부릴 수 있게 만든 것은"
  },
  "31": {
   "jp": "f3284b457c",
   "kr": "어빈, 너다."
  },
  "32": {
   "jp": "6081a98ec3",
   "kr": "뭐라고!?"
  },
  "33": {
   "jp": "71fcaa308e",
   "kr": "우리의 힘으로도"
  },
  "34": {
   "jp": "19b1477ec4",
   "kr": "네 정령을 쓰러뜨리고 신보를 빼앗지는 못했다."
  },
  "35": {
   "jp": "1172a73d33",
   "kr": "그래서 오크툼의 주법을 써서"
  },
  "36": {
   "jp": "c912fdbdae",
   "kr": "네 정령에게 저주를 걸었다."
  },
  "37": {
   "jp": "8de3c5c421",
   "kr": "너희가 눈치채고 네 정령에게 쓰러져도 좋다."
  },
  "38": {
   "jp": "c059311b62",
   "kr": "또 그들을 거느린 둘가가"
  },
  "39": {
   "jp": "ad2d9ffc12",
   "kr": "네 정령의 저주를 흡수해 우리 손에 떨어져도 좋다."
  },
  "40": {
   "jp": "979b811d49",
   "kr": "얼음 신전은 영굴로 이어져 있다."
  },
  "41": {
   "jp": "5c8cf665fe",
   "kr": "그곳에 명계신 둘가가 있는 한"
  },
  "42": {
   "jp": "0202118c2c",
   "kr": "우리는 손댈 수 없었다."
  },
  "43": {
   "jp": "90adeaf2e7",
   "kr": "그렇다… 여섯 신보에 집착한 것이"
  },
  "44": {
   "jp": "a3128abee2",
   "kr": "너희의 얕은 생각이다."
  },
  "45": {
   "jp": "404eb4dc3b",
   "kr": "명계신 둘가를 동료로 삼는 것이"
  },
  "46": {
   "jp": "5bb64bb04b",
   "kr": "우리의 목적이었던 것이다."
  },
  "47": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "48": {
   "jp": "890b996775",
   "kr": "이대로는… 이대로는 가만 안 두겠어."
  },
  "49": {
   "jp": "f418b93d48",
   "kr": "루티스.",
   "auto": 1
  },
  "50": {
   "jp": "81c4c8c6b3",
   "kr": "여기까지 온 상으로 이 손으로 죽여 주마."
  },
  "51": {
   "jp": "c7bd6de819",
   "kr": "죽어라."
  },
  "52": {
   "jp": "faeb8a5c8a",
   "kr": "오오…?!"
  },
  "53": {
   "jp": "b7d2bbfb30",
   "kr": "카테드랄에 내 혼이 있는 한"
  },
  "54": {
   "jp": "507965eda5",
   "kr": "여기서는 네 사악한 저주가 듣지 않는다."
  },
  "55": {
   "jp": "396d09ff7f",
   "kr": "에스페리우스 님!"
  },
  "56": {
   "jp": "d9547eeadf",
   "kr": "저주는 봉했다."
  },
  "57": {
   "jp": "076e6c1b11",
   "kr": "다툼은 좋아하지 않는다."
  },
  "58": {
   "jp": "fc84dfccbe",
   "kr": "물러가라, 볼게이드라는 자여."
  },
  "59": {
   "jp": "15d352c575",
   "kr": "무슨…"
  },
  "60": {
   "jp": "2a54d0a033",
   "kr": "저승에도 못 가는 혼에게 지시받을 이유는 없다."
  },
  "61": {
   "jp": "ab2375167a",
   "kr": "저주의 힘 없이도"
  },
  "62": {
   "jp": "0cc4d0319d",
   "kr": "네놈들 따위를 죽이기엔 충분하다."
  },
  "63": {
   "jp": "d10a9f1b63",
   "kr": "으, 으윽… 이놈…"
  },
  "64": {
   "jp": "e6eeb88b1d",
   "kr": "에스페리우스의 영혼 따위에…"
  },
  "65": {
   "jp": "2079ecdb21",
   "kr": "발목을 잡히다니… 분하다…"
  },
  "66": {
   "jp": "25a185ed6a",
   "kr": "하지만… 우리에게도 쓸 패는 있다…"
  },
  "67": {
   "jp": "024af09535",
   "kr": "너희를… 더는 움직이지 못하게 할 수 있는…"
  },
  "68": {
   "jp": "36ea7c7ecf",
   "kr": "…말이지…"
  },
  "69": {
   "jp": "c8c4d8b63c",
   "kr": "베리어스 경이 오크툼 신을 부활시키면…"
  },
  "70": {
   "jp": "9e6614a8bc",
   "kr": "그걸로 모든 것이… 결정된다…"
  },
  "71": {
   "jp": "453d00e649",
   "kr": "윽…"
  },
  "72": {
   "jp": "d1a1ac575f",
   "kr": "에스페리우스 님…"
  },
  "73": {
   "jp": "176a9dc3ff",
   "kr": "어빈, 잘 돌아왔다."
  },
  "74": {
   "jp": "24780fede2",
   "kr": "기다리고 있었다."
  },
  "75": {
   "jp": "6968e3cf59",
   "kr": "시간이 없다."
  },
  "76": {
   "jp": "2f07fc86a9",
   "kr": "어서 발두스 신의 여섯 신보를 융합시켜"
  },
  "77": {
   "jp": "66cadc7318",
   "kr": "성검을 완성하는 것이다."
  },
  "78": {
   "jp": "610d625068",
   "kr": "성검 에류시온은 발두스 교전에 기록된"
  },
  "79": {
   "jp": "cd157f141c",
   "kr": "유일하게 인간이 휘둘러 신을 파괴할 수 있는 검이다."
  },
  "80": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "81": {
   "jp": "a8872623dd",
   "kr": "여섯 신보를 다음 순서로 늘어놓아라."
  },
  "82": {
   "jp": "6bc4db0c94",
   "kr": "카베사, 쿠엘포, 데레브라, 이스브라,"
  },
  "83": {
   "jp": "c5c098e4a6",
   "kr": "그리고 데레피에, 이스피에 순이다."
  },
  "84": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "85": {
   "jp": "e0b8010496",
   "kr": "준비됐습니다."
  },
  "86": {
   "jp": "539eb5e9d8",
   "kr": "좋다."
  },
  "87": {
   "jp": "cd2683c519",
   "kr": "그럼 시작하겠다."
  },
  "88": {
   "jp": "c74eeb3c09",
   "kr": "일찍이 오크툼을 봉인하기 위해"
  },
  "89": {
   "jp": "7ec35db1ff",
   "kr": "하늘에 흩어진 발두스의 혼이여."
  },
  "90": {
   "jp": "bfca2f93dc",
   "kr": "용맹한 신의 오른팔, 데레브라."
  },
  "91": {
   "jp": "23781ddfa0",
   "kr": "대지를 일구고 사람을 기른 신의 왼팔, 이스브라."
  },
  "92": {
   "jp": "0729b0e753",
   "kr": "날랜 신의 오른발, 데레피에."
  },
  "93": {
   "jp": "cd60a59701",
   "kr": "소리 없는 신의 왼발, 이스피에."
  },
  "94": {
   "jp": "777f710723",
   "kr": "무한한 예지를 품은 신의 머리, 카베사."
  },
  "95": {
   "jp": "05abc4307b",
   "kr": "늠름한 신의 몸통, 쿠엘포."
  },
  "96": {
   "jp": "e4d57b344e",
   "kr": "이제 여기에 여섯 갈래 혼이 모이노라."
  },
  "97": {
   "jp": "a64aeb2ed3",
   "kr": "위대한 발두스의 혼이여."
  },
  "98": {
   "jp": "9a1a21153b",
   "kr": "우리에게 오크툼을 쳐부술 힘을"
  },
  "99": {
   "jp": "d83d0cc98b",
   "kr": "내려 주소서…"
  },
  "100": {
   "jp": "da12b91a79",
   "kr": "신의 힘이 깃든 성검이기에"
  },
  "101": {
   "jp": "0e6b94e9ea",
   "kr": "신을 벨 수도 있는 것이다."
  },
  "102": {
   "jp": "eb7ce8b1ce",
   "kr": "허나 그 힘을 지닌 자는 생각해야 하리라."
  },
  "103": {
   "jp": "52a923e4a8",
   "kr": "인간이 신을 벤다는 것이"
  },
  "104": {
   "jp": "550dd58bd5",
   "kr": "어떤 의미를 지니는 일인지…"
  },
  "105": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "106": {
   "jp": "5e19280085",
   "kr": "어빈.",
   "auto": 1
  },
  "107": {
   "jp": "48e37ce12b",
   "kr": "에류시온을 받거라."
  },
  "108": {
   "jp": "7339cd795f",
   "kr": "성검 에류시온…"
  },
  "109": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "110": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다.",
   "auto": 1
  },
  "111": {
   "jp": "8bfa6e12c9",
   "kr": "갖출 수단은 갖추었다."
  },
  "112": {
   "jp": "89ee72fd41",
   "kr": "나머지는 하늘만이 알 것이다."
  },
  "113": {
   "jp": "7e154bb699",
   "kr": "어빈…"
  },
  "114": {
   "jp": "06d27c9f43",
   "kr": "큰일을 맡기고 말았구나…"
  },
  "115": {
   "jp": "396d09ff7f",
   "kr": "에스페리우스 님!"
  },
  "116": {
   "jp": "2a1c8f8ad6",
   "kr": "가자. 봉인의 땅으로!"
  },
  "117": {
   "jp": "d38651436d",
   "kr": "힘의 차이를 느끼고"
  },
  "118": {
   "jp": "573e7d72e3",
   "kr": "떨고만 있는 줄 알았건만."
  }
 }
}
