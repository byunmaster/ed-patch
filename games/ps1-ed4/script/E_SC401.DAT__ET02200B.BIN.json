{
 "archive": "/E/SC401.DAT",
 "member": "..\\BIN\\ET02200B.BIN",
 "segments": {
  "0": {
   "jp": "66bb1110dc",
   "kr": "무사히 돌아와 주어 무엇보다 다행이오."
  },
  "1": {
   "jp": "25caddde6f",
   "kr": "인사는 됐소."
  },
  "2": {
   "jp": "df3d0b169d",
   "kr": "어서 루티스의 저주를 풀어 주시오."
  },
  "3": {
   "jp": "2eae98a848",
   "kr": "처방은 내가 하마."
  },
  "4": {
   "jp": "c0bc1b74f4",
   "kr": "을(를) 가웨인에게 건넸다."
  },
  "5": {
   "jp": "7f16fe5eb8",
   "kr": "앗, 어빈 씨.",
   "auto": 1
  },
  "6": {
   "jp": "7c2b7f13c1",
   "kr": "호랑가시나무 잎을 손에 넣으셨군요."
  },
  "7": {
   "jp": "e85885a9ab",
   "kr": "그래. 어빈의 공이오."
  },
  "8": {
   "jp": "beea5a8182",
   "kr": "가웨인은 품에서 작은 병을 꺼냈다."
  },
  "9": {
   "jp": "04e5201fb8",
   "kr": "처방은 이미 끝냈다."
  },
  "10": {
   "jp": "5e44b64ab8",
   "kr": "이 붉은빛 도는 액체를 마시면 볼게이드가 건"
  },
  "11": {
   "jp": "86e0994972",
   "kr": "루티스의 저주는 풀릴 거다."
  },
  "12": {
   "jp": "75f4a71d25",
   "kr": "윽… 으…"
  },
  "13": {
   "jp": "ced42c3746",
   "kr": "어째서…?"
  },
  "14": {
   "jp": "0727c2b831",
   "kr": "너희들은… 윽…"
  },
  "15": {
   "jp": "0799e8a895",
   "kr": "어째서… 나 같은 걸…"
  },
  "16": {
   "jp": "6c1a73eb6b",
   "kr": "구하려… 하는 거야…?"
  },
  "17": {
   "jp": "3c87efda5f",
   "kr": "잠자코 약을 마셔."
  },
  "18": {
   "jp": "72fda3336a",
   "kr": "쓸데없이 체력을 쓰지 마."
  },
  "19": {
   "jp": "6024c1b862",
   "kr": "괴로워하는 사람을 구하는 데 이유 따윈 필요 없어."
  },
  "20": {
   "jp": "d6989b582b",
   "kr": "안 그래?"
  },
  "21": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "22": {
   "jp": "3b0b33cd26",
   "kr": "자, 이것밖에 없으니"
  },
  "23": {
   "jp": "f20d21db70",
   "kr": "떠들다가 흘리지 마시오."
  },
  "24": {
   "jp": "a0e4e39fa8",
   "kr": "가웨인은 조심스럽게 호랑가시나무 잎으로 만든 약을"
  },
  "25": {
   "jp": "00bac5a63a",
   "kr": "루티스의 입에 떨어뜨렸다."
  },
  "26": {
   "jp": "805f3c8c09",
   "kr": "붉은빛 도는 액체 방울이"
  },
  "27": {
   "jp": "cd0257fc89",
   "kr": "한 방울, 두 방울 루티스의 입속으로 떨어졌다."
  },
  "28": {
   "jp": "09922c5ed1",
   "kr": "이제 괜찮아요."
  },
  "29": {
   "jp": "942bc5f95b",
   "kr": "루티스 씨도 곧 좋아질 거예요."
  },
  "30": {
   "jp": "0bff60c8f2",
   "kr": "어떻소, 루티스?"
  },
  "31": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "32": {
   "jp": "2b2f17b8cc",
   "kr": "…… 앗."
  },
  "33": {
   "jp": "6a91e4d6cc",
   "kr": "점점… 머리 아픈 게 가라앉아…"
  },
  "34": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "35": {
   "jp": "7861061f04",
   "kr": "괴롭지 않아."
  },
  "36": {
   "jp": "4b511fb0da",
   "kr": "저주가… 풀렸나 봐."
  },
  "37": {
   "jp": "baca6c83a9",
   "kr": "나, 나았다."
  },
  "38": {
   "jp": "6707cf583a",
   "kr": "효과가 있었군."
  },
  "39": {
   "jp": "6af99606e7",
   "kr": "다행이오."
  },
  "40": {
   "jp": "7d238fa898",
   "kr": "해냈다!"
  },
  "41": {
   "jp": "f3e4d3ad63",
   "kr": "휴, 이제야"
  },
  "42": {
   "jp": "c18b8ce424",
   "kr": "저도 이제 한시름 놓았네요."
  },
  "43": {
   "jp": "6af07833e0",
   "kr": "저주는 풀렸지만"
  },
  "44": {
   "jp": "5a87f18eb3",
   "kr": "아직 몸이 약해져 있으니까."
  },
  "45": {
   "jp": "87eb696095",
   "kr": "체력이 돌아올 때까지는"
  },
  "46": {
   "jp": "e294744133",
   "kr": "한동안 누워 있어야 해."
  },
  "47": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "48": {
   "jp": "8d33268275",
   "kr": "대답은?"
  },
  "49": {
   "jp": "95bfb545ff",
   "kr": "…응."
  },
  "50": {
   "jp": "dda10d43d0",
   "kr": "그걸로 됐어."
  },
  "51": {
   "jp": "a1a4266fa4",
   "kr": "그럼 저는 이만."
  },
  "52": {
   "jp": "dd56a022dd",
   "kr": "어…?",
   "auto": 1
  },
  "53": {
   "jp": "470f1d9e64",
   "kr": "돌아가는 건가."
  },
  "54": {
   "jp": "c496d5dc83",
   "kr": "네. 제 세계로 돌아가려고요."
  },
  "55": {
   "jp": "265e6dd919",
   "kr": "원래"
  },
  "56": {
   "jp": "f9674e5868",
   "kr": "엘 필딘의 삼현자 분들을 만나 뵙고 나면"
  },
  "57": {
   "jp": "f1ad47b57e",
   "kr": "일단 고국에 돌아갈 생각이었는데요."
  },
  "58": {
   "jp": "e36fc7632a",
   "kr": "아무래도"
  },
  "59": {
   "jp": "4e1a56a2e7",
   "kr": "어빈 씨와 루티스 씨가 마음에 걸려서"
  },
  "60": {
   "jp": "01a0e8aff1",
   "kr": "그만 돌아갈 때를 놓쳐 버렸네요."
  },
  "61": {
   "jp": "0008387e22",
   "kr": "미첼 씨…"
  },
  "62": {
   "jp": "1b1313df81",
   "kr": "또 만날 수 있겠소?"
  },
  "63": {
   "jp": "42418ec081",
   "kr": "네. 언젠가 또 올게요."
  },
  "64": {
   "jp": "fc32f2f536",
   "kr": "사실은 대현자님 배의 선원과 약속을"
  },
  "65": {
   "jp": "27836b5b99",
   "kr": "했거든요."
  },
  "66": {
   "jp": "8493e411a9",
   "kr": "선원?"
  },
  "67": {
   "jp": "f6b92cd481",
   "kr": "아마 토마스 씨라고 했던가요."
  },
  "68": {
   "jp": "005477a29e",
   "kr": "오오, 그 녀석인가."
  },
  "69": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "70": {
   "jp": "e50b0b138c",
   "kr": "그분, 꽤 재미있는 생각을 하더군요."
  },
  "71": {
   "jp": "b8277aa952",
   "kr": "제가 진실의 섬에 건너가려고 파도를 잠재웠다는 걸 알고는"
  },
  "72": {
   "jp": "796eb8bb7f",
   "kr": "가가브의 폭풍도 잠재울 수 없느냐고 물었어요."
  },
  "73": {
   "jp": "c3f0974d77",
   "kr": "가가브의 결계를 배로 횡단하려면"
  },
  "74": {
   "jp": "4c9b8f52d7",
   "kr": "솜씨 좋은 선원을 모으기보다 믿을 만한 마법사를"
  },
  "75": {
   "jp": "5603b66c25",
   "kr": "동료로 삼는 게 지름길이라고요."
  },
  "76": {
   "jp": "25b5201414",
   "kr": "과연. 확실히 그렇군."
  },
  "77": {
   "jp": "6527d59f08",
   "kr": "그분 준비가 끝날 즈음"
  },
  "78": {
   "jp": "e223ede101",
   "kr": "도우러 다시 오겠다고 약속했거든요."
  },
  "79": {
   "jp": "7b26c3156b",
   "kr": "그때는 반드시 인사드리러 가겠습니다."
  },
  "80": {
   "jp": "cdfc596f2e",
   "kr": "그렇구려. 그거 기대되는군."
  },
  "81": {
   "jp": "ec306a468e",
   "kr": "그럼 밖까지 배웅하겠소."
  },
  "82": {
   "jp": "343bce9ffa",
   "kr": "감사합니다.",
   "auto": 1
  },
  "83": {
   "jp": "e8fa921a70",
   "kr": "미첼 씨."
  },
  "84": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "85": {
   "jp": "0fa35c5ec3",
   "kr": "신세 졌어요."
  },
  "86": {
   "jp": "d661315635",
   "kr": "천만에요."
  },
  "87": {
   "jp": "09bfe49c9b",
   "kr": "저는 어빈 씨를 따라갔을 뿐이에요."
  },
  "88": {
   "jp": "85d1ae7ecf",
   "kr": "푹 요양하고 어서 기운 차리세요."
  },
  "89": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "90": {
   "jp": "189d477a26",
   "kr": "솜씨 좋은 선원을 모으는 것보다"
  },
  "91": {
   "jp": "d28fc0ebaf",
   "kr": "믿을 만한 마법사를"
  }
 }
}
