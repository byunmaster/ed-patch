   "kr": "볼게이드"
  },
  "31": {
   "jp": "9300c9ef28",
   "kr": "볼게이드 오른쪽"
  },
  "32": {
   "jp": "12df3777b1",
   "kr": "지금부터 발두스의 신보"
  },
  "33": {
   "jp": "c3a14be7a7",
   "kr": "카베사와 쿠에르포의 반환식을 거행하겠소."
  },
  "34": {
   "jp": "651c874fcd",
   "kr": "오크툼 신자의 카테드랄 습격으로부터"
  },
  "35": {
   "jp": "90c45709b4",
   "kr": "8년이라는 긴 세월 동안 우리 손을 떠나 있던"
  },
  "36": {
   "jp": "9feeeae3d8",
   "kr": "두 신보가 지금 이곳에 돌아왔소."
  },
  "37": {
   "jp": "137178ef72",
   "kr": "모두에게 그 공로자를 소개하겠소."
  },
  "38": {
   "jp": "68cd11fa18",
   "kr": "어빈과 아이멜이오."
  },
  "39": {
   "jp": "7ec1e17318",
   "kr": "어빈, 아이멜. 앞으로 나와 주게."
  },
  "40": {
   "jp": "911556873c",
   "kr": "8년 전 이 둘은 카테드랄에서 습격을 받았지만"
  },
  "41": {
   "jp": "7e4a979efa",
   "kr": "에스페리우스 님을 지키고 각자 신보를 몰래 지닌 채"
  },
  "42": {
   "jp": "6f253c6ff0",
   "kr": "오크툼의 추격자에게서 달아나 주었소."
  },
  "43": {
   "jp": "ddc3840965",
   "kr": "신보를 지키기 위해서라고는 해도"
  },
  "44": {
   "jp": "670e9365a9",
   "kr": "어린 남매를 떼어 놓는 상황을 만든 것은"
  },
  "45": {
   "jp": "4adde9e7fd",
   "kr": "정신전의 사람으로서 우리가 사과해야 하오."
  },
  "46": {
   "jp": "ba35c771e3",
   "kr": "어빈, 아이멜. 정말 미안했소."
  },
  "47": {
   "jp": "f3a3a3e122",
   "kr": "그리고 수고했소."
  },
  "48": {
   "jp": "24ef8ef694",
   "kr": "그대들 덕분에 카베사와 쿠에르포는"
  },
  "49": {
   "jp": "2e5818a75f",
   "kr": "오크툼 교도의 손에 넘어가지 않고"
  },
  "50": {
   "jp": "574ea24d85",
   "kr": "무사히 발크드 신전에 도착할 수 있었소."
  },
  "51": {
   "jp": "2f9b00c5fa",
   "kr": "…그리고,"
  },
  "52": {
   "jp": "1b96909944",
   "kr": "…음?",
   "auto": 1
  },
  "53": {
   "jp": "f17da8fc10",
   "kr": "후후후후후…"
  },
  "54": {
   "jp": "0f5567df0d",
   "kr": "누구냐…!?"
  },
  "55": {
   "jp": "bfa03274a9",
   "kr": "볼게이드!!"
  },
  "56": {
   "jp": "e1f5d6c80f",
   "kr": "이런,"
  },
  "57": {
   "jp": "b87dbaa0a5",
   "kr": "이 발크드의 결계를 어떻게 깨고…"
  },
  "58": {
   "jp": "b82ba6ddac",
   "kr": "8년 전,"
  },
  "59": {
   "jp": "a253b73996",
   "kr": "이 두 사람은 카테드랄에 있다가 습격을 받았으나"
  },
  "60": {
   "jp": "c91d231e57",
   "kr": "에스페리우스 님의 목숨을 지키고,"
  },
  "61": {
   "jp": "af59502ae8",
   "kr": "각자 신보를 몰래 지닌 채"
  },
  "62": {
   "jp": "c91d231e57",
   "kr": "에스페리우스 님의 목숨을 지키고"
  },
  "63": {
   "jp": "af59502ae8",
   "kr": "각자 신보를 은밀히 지닌 채"
  }
