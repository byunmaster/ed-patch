   "kr": "스코티아"
  },
  "1": {
   "jp": "1c4b885425",
   "kr": "리타"
  },
  "2": {
   "jp": "430ff21a35",
   "kr": "셀린"
  },
  "3": {
   "jp": "debb571654",
   "kr": "오스카"
  },
  "4": {
   "jp": "f61ae2b6ac",
   "kr": "제라르"
  },
  "5": {
   "jp": "87b9db2c05",
   "kr": "로베르"
  },
  "6": {
   "jp": "f32b75a18d",
   "kr": "르네"
  },
  "7": {
   "jp": "87e000aad8",
   "kr": "앙리"
  },
  "8": {
   "jp": "eb578425d9",
   "kr": "새끼 고양이",
   "auto": 1
  },
  "9": {
   "jp": "0da6e2ba8d",
   "kr": "나는… 신보를 지키는 스코티아."
  },
  "10": {
   "jp": "c5d8db9b50",
   "kr": "이곳을 찾아오는 자를 기다리고 있었노라.",
   "auto": 1
  },
  "11": {
   "jp": "277f85f85e",
   "kr": "내 혼은 사악한 자의 술수로 탁한 기운에 더럽혀졌도다.",
   "auto": 1
  },
  "12": {
   "jp": "9d78b7db83",
   "kr": "이 저주를 깨뜨리는 자는",
   "auto": 1
  },
  "13": {
   "jp": "c6e529cfc5",
   "kr": "내 힘을 꺾은 강한 혼뿐…",
   "auto": 1
  },
  "14": {
   "jp": "c88a33c941",
   "kr": "평온한 정령으로… 나를 되돌려 다오.",
   "auto": 1
  },
  "15": {
   "jp": "52a9d4337d",
   "kr": "그리하면 인정하리라.",
   "auto": 1
  },
  "16": {
   "jp": "f67dac469e",
   "kr": "네가 신보를 맡길 만한 혼임을…",
   "auto": 1
  },
  "17": {
   "jp": "110e9e1f77",
   "kr": "가자."
  },
  "18": {
   "jp": "19d331699e",
   "kr": "봐, 어빈!"
  },
  "19": {
   "jp": "f9461c9162",
   "kr": "리타!"
  },
  "20": {
   "jp": "adffd81257",
   "kr": "오빠, 언니…"
  },
  "21": {
   "jp": "11292ff2ce",
   "kr": "괜찮니?"
  },
  "22": {
   "jp": "d11c5da92b",
   "kr": "다친 데는 없어?"
  },
  "23": {
   "jp": "be4633c69b",
   "kr": "괜찮아."
  },
  "24": {
   "jp": "10d7c5511f",
   "kr": "모시가 여기까지 데려와 줬어."
  },
  "25": {
   "jp": "72a1f6c1f5",
   "kr": "저기 물 있는 데가 호수로 이어져 있어."
  },
  "26": {
   "jp": "780f016dee",
   "kr": "나, 모시 친구를 도우러 왔어…"
  },
  "27": {
   "jp": "9771a9e46e",
   "kr": "모시의 친구…?"
  },
  "28": {
   "jp": "ec5133ebbf",
   "kr": "이 문 너머야."
  },
  "29": {
   "jp": "d5f8cd6fc0",
   "kr": "들리지?"
  },
  "30": {
   "jp": "0c135ad9cb",
   "kr": "『도와줘』라고 하고 있어…"
  },
  "31": {
   "jp": "18a96b0d40",
   "kr": "그런데 문이 안 열려."
  },
  "32": {
   "jp": "89d212b656",
   "kr": "어이, 어빈!!"
  },
  "33": {
   "jp": "d07e191284",
   "kr": "오스카 일행이다."
  },
  "34": {
   "jp": "febd0c009e",
   "kr": "…리타!!"
  },
  "35": {
   "jp": "e85e5f0e70",
   "kr": "냐아～옹."
  },
  "36": {
   "jp": "3a8ff4517f",
   "kr": "리타!"
  },
  "37": {
   "jp": "0a84f7d943",
   "kr": "다행이야, 무사했구나."
  },
  "38": {
   "jp": "1c18fbbfc2",
   "kr": "언니, 큰일이야."
  },
  "39": {
   "jp": "234e44950a",
   "kr": "이 문 너머에"
  },
  "40": {
   "jp": "3a13c21b8b",
   "kr": "모시 친구가 갇혀 있어."
  },
  "41": {
   "jp": "5290b0d4ec",
   "kr": "그래, 알고 있어."
  },
  "42": {
   "jp": "6758274260",
   "kr": "스코티아 님이야."
  },
  "43": {
   "jp": "3c83e5a254",
   "kr": "어빈 씨.",
   "auto": 1
  },
  "44": {
   "jp": "7b5eadc360",
   "kr": "문의 장식틀에"
  },
  "45": {
   "jp": "bd0790afda",
   "kr": "성스러운 크리스탈을 끼워 주세요."
  },
  "46": {
   "jp": "fa1f69ac48",
   "kr": "알았어.",
   "auto": 1
  },
  "47": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "48": {
   "jp": "117bbb5933",
   "kr": "을(를) 사용했다.",
   "auto": 1
  },
  "49": {
   "jp": "0b01ca8f7b",
   "kr": "해냈다, 열렸어!!"
  },
  "50": {
   "jp": "943641f04e",
   "kr": "다들, 스코티아 님을 도우러 가자!!"
  },
  "51": {
   "jp": "8b21860c4b",
   "kr": "남자들"
  },
  "52": {
   "jp": "f8705f782b",
   "kr": "오!!"
  },
  "53": {
   "jp": "8aae1c28d1",
   "kr": "잠깐 기다려!"
  },
  "54": {
   "jp": "f57fe47be3",
   "kr": "어?",
   "auto": 1
  },
  "55": {
   "jp": "40b8132ae8",
   "kr": "…여러분은 여기까지만 해 주세요."
  },
  "56": {
   "jp": "52434ddbb4",
   "kr": "어이어이."
  },
  "57": {
   "jp": "9ec58bea27",
   "kr": "그게 무슨 소리야?"
  },
  "58": {
   "jp": "6d1b2a502e",
   "kr": "우리는 스코티아 님의 마을에 사는 사람이라고."
  },
  "59": {
   "jp": "a0d2a66e02",
   "kr": "함께 싸울 의무가 있어."
  },
  "60": {
   "jp": "779d66405d",
   "kr": "아니, 우리는 가서는 안 돼."
  },
  "61": {
   "jp": "403944adee",
   "kr": "셀린 씨?"
  },
  "62": {
   "jp": "f622a48a99",
   "kr": "우리가 할 수 있는 건 여기까지예요."
  },
  "63": {
   "jp": "545262a18b",
   "kr": "스코티아 님은 어빈 씨를 부르고 있어."
  },
  "64": {
   "jp": "13175560fc",
   "kr": "어빈 씨만 할 수 있는"
  },
  "65": {
   "jp": "869f8f48e1",
   "kr": "중요한 임무가"
  },
  "66": {
   "jp": "16ea0aef62",
   "kr": "이 너머에서 기다리고 있어."
  },
  "67": {
   "jp": "e36c314a47",
   "kr": "고마워요, 셀린 씨."
  },
  "68": {
   "jp": "fa1f69ac48",
   "kr": "알았어.",
   "auto": 1
  },
  "69": {
   "jp": "a47a7e9f57",
   "kr": "어빈, 조심해서 다녀와."
  },
  "70": {
   "jp": "252e49e49d",
   "kr": "우리는 셀린 씨와 리타를 마을에 데려다 줄게."
  },
  "71": {
   "jp": "e581355129",
   "kr": "자, 다들."
  },
  "72": {
   "jp": "cc1d258a8d",
   "kr": "돌아가자!"
  }
 }
}
