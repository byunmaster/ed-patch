   "kr": "이런, 이런, 요즘 보기 드문 열혈한이군요."
  },
  "163": {
   "jp": "1a30abce95",
   "kr": "좀 더 불쌍하게 울어 주지 않으면 곤란한데요."
  },
  "164": {
   "jp": "03285aee3a",
   "kr": "으악!"
  },
  "165": {
   "jp": "978c14be72",
   "kr": "이러고 싶지 않습니다."
  },
  "166": {
   "jp": "74e56d043e",
   "kr": "저기, 어빈 군."
