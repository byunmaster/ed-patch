  "160": {
   "jp": "3c4b1663cc",
   "kr": "이봐, 어빈이라는 양반!"
  },
  "161": {
   "jp": "df65b8c94e",
   "kr": "이런 천한 놈의 꼬임에 넘어가지 마!"
  },
  "162": {
