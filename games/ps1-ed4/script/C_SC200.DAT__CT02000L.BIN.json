{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02000L.BIN",
 "segments": {
  "0": {
   "jp": "d185e7823e",
   "kr": "여, 어빈 군."
  },
  "1": {
   "jp": "acf3639d51",
   "kr": "지난번엔 정말 미안했네."
  },
  "2": {
   "jp": "d016669108",
   "kr": "무례를 저질러 정말 미안하네."
  },
  "3": {
   "jp": "6cd86992df",
   "kr": "위로금으로 지작의 의뢰료와 같은 금액을"
  },
  "4": {
   "jp": "c6a22a7e21",
   "kr": "알선소에 보내겠네."
  },
  "5": {
   "jp": "733b95d0b2",
   "kr": "그걸로 부디 용서해 주게."
  },
  "6": {
   "jp": "3b46ffe7d1",
   "kr": "우리는 지작의 얼굴을 모르거든."
  },
  "7": {
   "jp": "7eca23696e",
   "kr": "믿고 있겠네."
  },
  "8": {
   "jp": "840be5f862",
   "kr": "어빈이잖아!"
  },
  "9": {
   "jp": "7e945b0f8f",
   "kr": "놀러 왔어?"
  },
  "10": {
   "jp": "df2770ac4b",
   "kr": "이 기아에 샴실단 사람이 잠복해 있다는"
  },
  "11": {
   "jp": "58ef8bb3cf",
   "kr": "정보가 있어서 지금 엄중 경계 중이야."
  },
  "12": {
   "jp": "71c12a7593",
   "kr": "마을을 나가려는 사람은 일단 다 조사하겠소."
  },
  "13": {
   "jp": "8a22552844",
   "kr": "용의자라고 해서 미안했어."
  },
  "14": {
   "jp": "3ff8130618",
   "kr": "이것도 일이거든. 이해해 줘."
  },
  "15": {
   "jp": "b260b226a4",
   "kr": "우리도 수사할 거야."
  },
  "16": {
   "jp": "59cd9e1ef8",
   "kr": "같이 힘내자."
  },
  "17": {
   "jp": "8dadef337e",
   "kr": "공장에 무슨 일 있었어?"
  },
  "18": {
   "jp": "52b07e72fd",
   "kr": "루카는 괜찮을까…"
  },
  "19": {
   "jp": "8ab2c64b42",
   "kr": "공장은 벌써 봤어?"
  },
  "20": {
   "jp": "39e33b0cd6",
   "kr": "내 친구가 일하고 있거든."
  },
  "21": {
   "jp": "8e5acf4723",
   "kr": "루카라는 녀석인데"
  },
  "22": {
   "jp": "b43695a99b",
   "kr": "엄청 성실해."
  },
  "23": {
   "jp": "dbe0bc9f9f",
   "kr": "나도 루카처럼 공장에서 일할까."
  },
  "24": {
   "jp": "8334658eb9",
   "kr": "애들 같은 놀이엔 질렸어."
  },
  "25": {
   "jp": "82e2334e62",
   "kr": "소문으로는 이 마을 광산에서"
  },
  "26": {
   "jp": "4ebe4e0a74",
   "kr": "레어메탈이 나온대."
  },
  "27": {
   "jp": "c41d82bf24",
   "kr": "…레어메탈이 뭘까?"
  },
  "28": {
   "jp": "aa1c4fbb8d",
   "kr": "공장 분위기가 수상하다던데!"
  },
  "29": {
   "jp": "b4d6f691f7",
   "kr": "일자리를 구하러 왔는데"
  },
  "30": {
   "jp": "88eeea0e7c",
   "kr": "어쩌면 좋지."
  },
  "31": {
   "jp": "9097191ea8",
   "kr": "기아에 오면 일자리가 있을 줄 알고"
  },
  "32": {
   "jp": "b483359a54",
   "kr": "멀리서 찾아왔어."
  },
  "33": {
   "jp": "30cd721479",
   "kr": "역시 공업 도시 기아야."
  },
  "34": {
   "jp": "82aa4c8c8f",
   "kr": "활기가 넘치고 좋은 마을이네."
  },
  "35": {
   "jp": "7205b49437",
   "kr": "지금은 일손이 남아돈대."
  },
  "36": {
   "jp": "41491fb629",
   "kr": "모처럼 공장에서 일할 수 있나 했는데"
  },
  "37": {
   "jp": "1797b4bfa5",
   "kr": "너무하네…"
  },
  "38": {
   "jp": "649c23b50c",
   "kr": "야간 근무 자리를 얻었어."
  },
  "39": {
   "jp": "cd27ee0cc8",
   "kr": "용광로도 원래대로 고쳐진 모양이고"
  },
  "40": {
   "jp": "35fd0297bf",
   "kr": "자, 열심히 일해 볼까."
  },
  "41": {
   "jp": "e15f184375",
   "kr": "공장 쪽에 사교도가 있다던데."
  },
  "42": {
   "jp": "4baca10b09",
   "kr": "뒤숭숭해졌네."
  },
  "43": {
   "jp": "be04956c03",
   "kr": "여긴 몇 층일까?"
  },
  "44": {
   "jp": "98379730df",
   "kr": "돌아다니다 보니"
  },
  "45": {
   "jp": "893484577a",
   "kr": "머릿속이 뒤죽박죽이야."
  },
  "46": {
   "jp": "c09d539688",
   "kr": "방을 하나 얻으려고 말이야."
  },
  "47": {
   "jp": "6dec1e9ab1",
   "kr": "이 근처에"
  },
  "48": {
   "jp": "e74f495fdb",
   "kr": "가구 딸린 빈집이 있다고"
  },
  "49": {
   "jp": "4d0ccba5c3",
   "kr": "들었는데…"
  },
  "50": {
   "jp": "598634f72b",
   "kr": "곤트 씨 집은 뭐라나 하는 의사의 병원이 된대."
  },
  "51": {
   "jp": "853dbbbbe0",
   "kr": "난 여기서 기다리고 있어."
  },
  "52": {
   "jp": "5edf85aa77",
   "kr": "고질적인 어깨 결림을 고치려고."
  },
  "53": {
   "jp": "6dec1e9ab1",
   "kr": "이 근처에"
  },
  "54": {
   "jp": "e74f495fdb",
   "kr": "가구 딸린 빈집이 있다고"
  },
  "55": {
   "jp": "4d0ccba5c3",
   "kr": "들었는데…"
  },
  "56": {
   "jp": "ba7a2f94ac",
   "kr": "빈집 같은 건 없는데…"
  },
  "57": {
   "jp": "444f6ce45a",
   "kr": "어떻게 된 거지?"
  },
  "58": {
   "jp": "bf616e1e51",
   "kr": "한가하게 쇼핑할 때가 아니네요."
  },
  "59": {
   "jp": "91724ce664",
   "kr": "당신도 공장에는 가까이 가지 않는 게 좋아요."
  },
  "60": {
   "jp": "7412b6fa5f",
   "kr": "쇼핑할 때는"
  },
  "61": {
   "jp": "e1b2e68829",
   "kr": "여기를 지나서 가게까지 가요."
  },
  "62": {
   "jp": "07c71f27fa",
   "kr": "우리 집에서 오면 조금 지름길이거든요."
  },
  "63": {
   "jp": "bc9271e66d",
   "kr": "기아는 가게가 한 곳에 모여 있어서"
  },
  "64": {
   "jp": "635501285e",
   "kr": "아주 편리해요."
  },
  "65": {
   "jp": "10c8acbf97",
   "kr": "오늘 저녁은 뭘로 할까…"
  },
  "66": {
   "jp": "75437c92dd",
   "kr": "메뉴 고민은 정말 어렵다니까요."
  },
  "67": {
   "jp": "2915d086ce",
   "kr": "집에 가서 뒹굴려고 했는데"
  },
  "68": {
   "jp": "33b175db01",
   "kr": "공장이 큰일이라며?"
  },
  "69": {
   "jp": "1e48d23e2e",
   "kr": "걱정되지만 가기는 무섭고."
  },
  "70": {
   "jp": "eb338ece65",
   "kr": "…어떻게 하지."
  },
  "71": {
   "jp": "8d4643b6ca",
   "kr": "자～, 오늘 일도 끝났다."
  },
  "72": {
   "jp": "1cd7649daa",
   "kr": "교대제는 일이 끝나면"
  },
  "73": {
   "jp": "13f98946ac",
   "kr": "눈치 안 보고 쉴 수 있어서 좋아."
  },
  "74": {
   "jp": "e6ec6ae414",
   "kr": "자～, 집에 가서 밥 먹고"
  },
  "75": {
   "jp": "cb4913a92d",
   "kr": "뒹굴뒹굴하면서"
  },
  "76": {
   "jp": "1c4be0b4ee",
   "kr": "엉덩이나 벅벅 긁어야지."
  },
  "77": {
   "jp": "93807af926",
   "kr": "광산 일은 굴속이라서"
  },
  "78": {
   "jp": "44afda272f",
   "kr": "낮이든 밤이든"
  },
  "79": {
   "jp": "96a2ddf54a",
   "kr": "별 상관이 없어."
  },
  "80": {
   "jp": "e6ec6ae414",
   "kr": "자～, 집에 가서 밥 먹고"
  },
  "81": {
   "jp": "cb4913a92d",
   "kr": "뒹굴뒹굴하면서"
  },
  "82": {
   "jp": "1c4be0b4ee",
   "kr": "엉덩이나 벅벅 긁어야지."
  },
  "83": {
   "jp": "bac7c868d7",
   "kr": "좀처럼 발견되는 일은 없지만"
  },
  "84": {
   "jp": "710db4ee4f",
   "kr": "레어메탈이 나오면 대박인데."
  },
  "85": {
   "jp": "9bdf9d7970",
   "kr": "역시 그렇게 쉽게는 안 나와."
  },
  "86": {
   "jp": "e6ec6ae414",
   "kr": "자～, 집에 가서 밥 먹고"
  },
  "87": {
   "jp": "cb4913a92d",
   "kr": "뒹굴뒹굴하면서"
  },
  "88": {
   "jp": "1c4be0b4ee",
   "kr": "엉덩이나 벅벅 긁어야지."
  },
  "89": {
   "jp": "5e059003fe",
   "kr": "이 기아에"
  },
  "90": {
   "jp": "42f9c9d924",
   "kr": "샴실단 사람이 잠복하고 있다는"
  },
  "91": {
   "jp": "1b5d9bb959",
   "kr": "마을을 나가려는 사람은"
  },
  "92": {
   "jp": "85f6b1c065",
   "kr": "일단 모두 조사하게 될 거야."
  },
  "93": {
   "jp": "c40a2fa82b",
   "kr": "곤트 씨 집은"
  },
  "94": {
   "jp": "ddb25447aa",
   "kr": "무슨무슨 의사의 병원이 된대."
  }
 }
}
