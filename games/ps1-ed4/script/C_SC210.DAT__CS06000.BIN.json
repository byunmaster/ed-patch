  "0": {
   "jp": "eacd021045",
   "kr": "북 "
  },
  "1": {
   "jp": "0e1912cf74",
   "kr": "역시 어려운가?"
  },
  "2": {
   "jp": "6e41a2d9bd",
   "kr": "무리하지 않아도 돼…"
  },
  "3": {
   "jp": "c3dc50025f",
   "kr": "수고했네.",
   "auto": 1
  },
  "4": {
   "jp": "4777865bce",
   "kr": "자네, 젊은데 대단하구먼."
  },
  "5": {
   "jp": "c5e53104fb",
   "kr": "자네가 안쪽까지 채굴 도구를 전해 주겠나?"
  },
  "6": {
   "jp": "2756f86a47",
   "kr": "고맙네."
  },
  "7": {
   "jp": "40f0c0245a",
   "kr": "한번 들어가면 나오기가 번거로워서 말이야."
  },
  "8": {
   "jp": "9d31df8010",
   "kr": "이게 도구일세."
  },
  "9": {
   "jp": "505d7983d5",
   "kr": "동굴 안쪽의 조사원에게 전해 주게."
  },
  "10": {
   "jp": "c092635aa2",
   "kr": "어빈은 채굴 도구를 받았다."
  },
  "11": {
   "jp": "43efe876b3",
   "kr": "자네인가?"
  },
  "12": {
   "jp": "497d46f948",
   "kr": "채굴 도구를 전해 주러 가 준다는 사람이."
  },
  "13": {
   "jp": "8a686a2b88",
   "kr": "이런, 더는 못 들겠잖나."
  },
  "14": {
   "jp": "bb4c481c8c",
   "kr": "짐을 정리하고 다시 오게."
  },
  "15": {
   "jp": "e9308b2062",
   "kr": "고맙네. 이제 작업이 잘 되겠어."
  },
  "16": {
   "jp": "e8f7b19dd3",
   "kr": "이 동굴은 은광맥 조사 중이네."
  },
  "17": {
   "jp": "41fad5b311",
   "kr": "관계자 외에는 들어갈 수 없다네."
  },
  "18": {
