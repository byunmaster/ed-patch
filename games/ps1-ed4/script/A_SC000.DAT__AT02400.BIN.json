{
 "archive": "/A/SC000.DAT",
 "member": "..\\BIN\\AT02400.BIN",
 "segments": {
  "0": {
   "jp": "80e109208e",
   "kr": "나중에 울며불며 해도 몰라요."
  },
  "1": {
   "jp": "5955f16d31",
   "kr": "언젠가 내가 필요한 날이 올지도 몰라."
  },
  "2": {
   "jp": "35cbab9116",
   "kr": "그날을 믿고 도서관에서 공부해 둘게."
  },
  "3": {
   "jp": "f0913f0da1",
   "kr": "싸움은 신중하게."
  },
  "4": {
   "jp": "814ce9c1f0",
   "kr": "적이 잡졸이라도 방심하지 마."
  },
  "5": {
   "jp": "58b69ba808",
   "kr": "몸조심하세요."
  },
  "6": {
   "jp": "e68bf18f33",
   "kr": "다시 함께하게 해 주세요."
  },
  "7": {
   "jp": "ff6b6f66b7",
   "kr": "내가 없다고 무리하지 마."
  },
  "8": {
   "jp": "de84d4ed15",
   "kr": "위험하면 망설이지 말고 도망쳐."
  },
  "9": {
   "jp": "60d972586b",
   "kr": "그만둬, 말려 봐야 소용없어."
  },
  "10": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬."
  },
  "11": {
   "jp": "e50d655f01",
   "kr": "이 마을에 분수가 있었지."
  },
  "12": {
   "jp": "29f947d096",
   "kr": "한동안 분수나 보고 있을까."
  },
  "13": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬."
  },
  "14": {
   "jp": "a4f46c7154",
   "kr": "이별은 달콤한 슬픔."
  },
  "15": {
   "jp": "f77320295e",
   "kr": "재회를 꿈꾸며 떠나도록 하지요."
  },
  "16": {
   "jp": "4b59f66212",
   "kr": "내 힘이 필요할 때는"
  },
  "17": {
   "jp": "fc84a547dc",
   "kr": "찾아오너라."
  }
 }
}
