{
 "archive": "/E/SC400.DAT",
 "member": "..\\BIN\\ET01100B.BIN",
 "segments": {
  "0": {
   "jp": "49fbb5ed56",
   "kr": "무슨 일인가. 내게 감정을 의뢰하러 왔나?"
  },
  "1": {
   "jp": "f13fee1a63",
   "kr": "필딘의 노이 씨한테서"
  },
  "2": {
   "jp": "ede68b2b48",
   "kr": "은수저를 맡아 왔어."
  },
  "3": {
   "jp": "c8332a7edc",
   "kr": "아아, 노이 씨군요."
  },
  "4": {
   "jp": "c2ab4007b3",
   "kr": "어디, 바로 살펴보지요."
  },
  "5": {
   "jp": "29d03b82a1",
   "kr": "노이에게서 맡은 은수저를 건넸다."
  },
  "6": {
   "jp": "20ebe8600e",
   "kr": "흠, 이건가요."
  },
  "7": {
   "jp": "5d39970456",
   "kr": "…으음."
  },
  "8": {
   "jp": "0ffa1ff302",
   "kr": "…흠."
  },
  "9": {
   "jp": "75834f6b6f",
   "kr": "…흠흠."
  },
  "10": {
   "jp": "6d30209095",
   "kr": "…과연."
  },
  "11": {
   "jp": "3832119dca",
   "kr": "…꿀꺽."
  },
  "12": {
   "jp": "830c636fb7",
   "kr": "유감이지만, 이건 가짜로군요."
  },
  "13": {
   "jp": "0ac7203715",
   "kr": "진품은 손잡이 뒷면에 작은 각인이 있거든요."
  },
  "14": {
   "jp": "6eff0e053a",
   "kr": "이건 그게 없어요."
  },
  "15": {
   "jp": "45c8728537",
   "kr": "뭐, 가짜라도 아주 품질 좋은 물건이니"
  },
  "16": {
   "jp": "90a69c1a1b",
   "kr": "소중히 쓰시면 좋겠군요."
  },
  "17": {
   "jp": "8e987c2154",
   "kr": "이건 의뢰하신 분께 돌려주세요."
  },
  "18": {
   "jp": "af6cbeb45b",
   "kr": "어, 필딘까지 도로 가져가라고?"
  },
  "19": {
   "jp": "8369a103a0",
   "kr": "네, 그래요."
  },
  "20": {
   "jp": "73a072e6f3",
   "kr": "의뢰인 노이 씨에게 돌려주세요."
  },
  "21": {
   "jp": "daf7db570e",
   "kr": "품질이 좋아도 가짜는 가짜니까요."
  },
  "22": {
   "jp": "58446acfae",
   "kr": "저는 진품만 사거든요."
  },
  "23": {
   "jp": "60d5fe60e9",
   "kr": "유감스러운 결과가 됐지만 노이 씨에게"
  },
  "24": {
   "jp": "0a1358e3d6",
   "kr": "흔히 있는 일이니 낙담하지 마시라고"
  },
  "25": {
   "jp": "e295f6bc74",
   "kr": "전해 주세요."
  },
  "26": {
   "jp": "3dfd4418b2",
   "kr": "무슨 일인가?"
  },
  "27": {
   "jp": "3863c38472",
   "kr": "볼일이 있으면 짧게 부탁하네."
  },
  "28": {
   "jp": "a0ccc473ca",
   "kr": "자네가 짐을 날라 주는 게로군."
  },
  "29": {
   "jp": "194047bcb0",
   "kr": "부탁하고 싶은 짐은 이거라네."
  },
  "30": {
   "jp": "4bf8639db7",
   "kr": "오테로 씨의 짐을 맡았다."
  },
  "31": {
   "jp": "cad32076ce",
   "kr": "고운 천이 아닌가?"
  },
  "32": {
   "jp": "8a87e21156",
   "kr": "내 손녀 오필리아가 시집을 가거든."
  },
  "33": {
   "jp": "bf828c0a6e",
   "kr": "이걸로 혼례복이라도 지어 입으라고 보내는 걸세."
  },
  "34": {
   "jp": "c2b1736abf",
   "kr": "지금까지 차곡차곡 모은 비상금을"
  },
  "35": {
   "jp": "236c2e2ab5",
   "kr": "탈탈 털어서 샀지."
  },
  "36": {
   "jp": "adaf555b04",
   "kr": "먼 땅에서 애쓰는 손녀에게"
  },
  "37": {
   "jp": "5703824370",
   "kr": "내가 해 줄 수 있는 건 이 정도뿐이라네."
  },
  "38": {
   "jp": "d555ae8a17",
   "kr": "짐은 세타의 술집에 있는 오필리아에게"
  },
  "39": {
   "jp": "8bc9e7953b",
   "kr": "전해 주게. 잘 부탁하네."
  },
  "40": {
   "jp": "ede1b56cab",
   "kr": "짐이 가득한 모양이구먼."
  },
  "41": {
   "jp": "72b5d420a7",
   "kr": "그래서는 짐을 못 들겠네."
  },
  "42": {
   "jp": "892ac6b390",
   "kr": "짐을 정리하고 나서 다시 와 주겠나?"
  },
  "43": {
   "jp": "fef3e32754",
   "kr": "전할 곳은 세타의 오필리아."
  },
  "44": {
   "jp": "a4977282ca",
   "kr": "등대 옆 술집에 있다네."
  },
  "45": {
   "jp": "0ac8f779ab",
   "kr": "한눈팔면 안 되네."
  },
  "46": {
   "jp": "87ca054823",
   "kr": "자네가 편지를 날라 주는 거로군."
  },
  "47": {
   "jp": "c525a20b27",
   "kr": "맥래인 씨의 편지를 맡았다."
  },
  "48": {
   "jp": "a87f295d89",
   "kr": "이 편지를 세타에 있는 무기점 안주인에게"
  },
  "49": {
   "jp": "884ccf1722",
   "kr": "전해 주게."
  },
  "50": {
   "jp": "031d3a3418",
   "kr": "소풍 기분으로 세타까지 가는 건"
  },
  "51": {
   "jp": "b491088fa2",
   "kr": "어떨까 싶지만, 뭐, 편하게 가 주게."
  },
  "52": {
   "jp": "efd0e84f34",
   "kr": "꽤 짐이 많군."
  },
  "53": {
   "jp": "5c95320ff0",
   "kr": "그렇게 짐을 들고 있으면 편지를"
  },
  "54": {
   "jp": "9cca755cd7",
   "kr": "맡길 수 없겠는걸."
  },
  "55": {
   "jp": "7eb1b2260e",
   "kr": "짐을 정리하고 와 주지 않겠나?"
  },
  "56": {
   "jp": "5703a77e46",
   "kr": "전할 곳은 세타 무기점 안주인이야."
  },
  "57": {
   "jp": "463937e08f",
   "kr": "잘 부탁하네.",
   "auto": 1
  },
  "58": {
   "jp": "61b0a0fd54",
   "kr": "그 숟가락은 의뢰인 노이 씨에게 돌려주세요."
  },
  "59": {
   "jp": "daf7db570e",
   "kr": "품질이 좋아도 가짜는 가짜니까요."
  },
  "60": {
   "jp": "58446acfae",
   "kr": "저는 진품만 사요."
  },
  "61": {
   "jp": "60d5fe60e9",
   "kr": "유감스러운 결과가 됐지만 노이 씨에게"
  },
  "62": {
   "jp": "0a1358e3d6",
   "kr": "흔히 있는 일이니 낙담하지 마시라고"
  },
  "63": {
   "jp": "e295f6bc74",
   "kr": "전해 주세요."
  },
  "64": {
   "jp": "688315bec1",
   "kr": "내가 해 줄 수 있는 건"
  },
  "65": {
   "jp": "b38c129151",
   "kr": "이 정도뿐이라서 말이지."
  },
  "66": {
   "jp": "a0bc2ee4be",
   "kr": "그 수저는"
  },
  "67": {
   "jp": "73a072e6f3",
   "kr": "의뢰인 노이 씨에게 돌려주세요."
  }
 }
}
