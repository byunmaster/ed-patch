  "3": {
   "jp": "b8784eece9",
   "kr": "코레"
  },
  "4": {
   "jp": "8d2a527a4f",
   "kr": "하루"
  },
  "5": {
   "jp": "56c8785eb9",
   "kr": "프리트"
  },
  "6": {
   "jp": "ecbcbb2e1c",
   "kr": "큰일 났군!"
  },
  "7": {
   "jp": "e2e8a87f03",
   "kr": "사교도 놈들, 진짜로 저질렀어."
  },
  "8": {
   "jp": "5b7611db1d",
   "kr": "제５용광로 압력이 너무 올라가고 있어."
  },
  "9": {
   "jp": "d78699ace4",
   "kr": "이대로는 폭발한다고!"
  },
  "10": {
   "jp": "44fb0d3846",
   "kr": "인질은 어떻게 됐지!?"
  },
  "11": {
   "jp": "c0c1b39053",
   "kr": "어빈, 서두르자!"
  },
  "12": {
   "jp": "7fe504613d",
   "kr": "어, 어이!"
  },
  "13": {
   "jp": "62a7c9c1e0",
   "kr": "루티스가 도와준 덕분에"
  },
  "14": {
   "jp": "5092026085",
   "kr": "어빈 일행은 루카를 구출하여"
  },
  "15": {
   "jp": "a86aa8db51",
   "kr": "무사히 안전한 곳까지 피할 수 있었다."
  },
  "16": {
   "jp": "13d7a7704e",
   "kr": "정말 살았어, 고마워."
  },
  "17": {
   "jp": "9fce4703f5",
   "kr": "루카도 머리를 부딪친 충격으로"
  },
  "18": {
   "jp": "87d2cf01bd",
   "kr": "기절했을 뿐이야."
  },
  "19": {
   "jp": "5ec8d2091e",
   "kr": "머리 상처도 긁힌 정도 같고."
  },
  "20": {
   "jp": "ed6f3ea987",
   "kr": "정말 다행이다."
  },
  "21": {
   "jp": "189f55ad54",
   "kr": "이젠 끝인 줄 알았어."
  },
  "22": {
   "jp": "647b18e86c",
   "kr": "너희는 생명의 은인이야."
  },
  "23": {
   "jp": "692ddf1979",
   "kr": "자, 제５용광로를 고치러 가자."
  },
  "24": {
   "jp": "2445e82291",
   "kr": "ＨＦ형이 망가져서"
  },
  "25": {
   "jp": "9f0d6a1b53",
   "kr": "제일 슬퍼할 건 루카니까."
  },
  "26": {
   "jp": "2898fb6456",
   "kr": "루카를 부탁해."
  },
  "27": {
   "jp": "1c50e5aa69",
   "kr": "맡겨 두라고."
  },
  "28": {
   "jp": "b6efbff5c0",
   "kr": "볼게이드 녀석…"
  },
  "29": {
   "jp": "123b13f497",
   "kr": "레어메탈을 탐내서 루카를 인질로 삼았구나."
  },
  "30": {
   "jp": "9b168294c1",
   "kr": "같은 신앙을 가진"
  },
  "31": {
   "jp": "c634c2e508",
   "kr": "…내 동생인 줄 알면서."
  },
  "32": {
   "jp": "75cd50713e",
   "kr": "너희가 늘 쓰는 수법이잖아."
  },
  "33": {
   "jp": "a746a1a81e",
   "kr": "어떻게 그렇게 심한 짓을…"
  },
  "34": {
   "jp": "cc8aefd4a1",
   "kr": "……",
   "auto": 1
  },
  "35": {
   "jp": "b2179fbfe3",
   "kr": "루카를 구해 준 건 고마워."
  },
  "36": {
   "jp": "11a5fcd7e5",
   "kr": "하지만 볼게이드의 행동은 그 녀석이 멋대로 한 일이야."
  },
  "37": {
   "jp": "0f9dae86ea",
   "kr": "교단에 대한 중상은 용납 못 해."
  },
  "38": {
   "jp": "688caa4bca",
   "kr": "신세 졌어."
  },
  "39": {
   "jp": "e2060f473e",
   "kr": "어디 가는 거야."
  },
  "40": {
   "jp": "a5aafafa18",
   "kr": "루카가 나을 때까지 지켜봐 주지 않을 거야?"
  },
  "41": {
   "jp": "9609afef17",
   "kr": "그 정도 상처면 괜찮아."
  },
  "42": {
   "jp": "dba87412f5",
   "kr": "오늘은 동생을 구해 준 걸 봐서"
  },
  "43": {
   "jp": "4134747377",
   "kr": "네 카베사는 눈감아 줄게."
  },
  "44": {
   "jp": "69d5be3c1e",
   "kr": "그럼."
  }
 }
