 "segments": {
  "0": {
   "jp": "915db4426a",
   "kr": "관리",
   "auto": 1
  },
  "1": {
   "jp": "d20d5ff6a0",
   "kr": "이런, 이런."
  },
  "2": {
   "jp": "b4c60a3184",
   "kr": "여긴 들어가믄 안 되여."
  },
  "3": {
   "jp": "139e0bad8c",
   "kr": "이 노카크 동굴은 알선소가 봉인했단 말이여."
  },
  "4": {
   "jp": "723f851ebf",
   "kr": "알선소 의뢰를 받고 왔어.",
   "auto": 1
  },
  "5": {
   "jp": "2b53c8d403",
   "kr": "알선소요?",
   "auto": 1
  },
  "6": {
   "jp": "a204693317",
   "kr": "그렇담 기록을 확인해 보자고."
  },
  "7": {
   "jp": "916143f2f4",
   "kr": "성함은?",
   "auto": 1
  },
  "8": {
   "jp": "5e19280085",
   "kr": "어빈.",
   "auto": 1
  },
  "9": {
   "jp": "3dcc33e76b",
   "kr": "어번?"
  },
  "10": {
   "jp": "400c58ce45",
   "kr": "어·빈."
  },
  "11": {
   "jp": "86f1559f5c",
   "kr": "어·번이라 이거지."
  },
  "12": {
   "jp": "c193671b3c",
   "kr": "그럼 잠깐 기다려."
  },
  "13": {
   "jp": "e38abbdbbf",
   "kr": "관리는 수첩을 넘겼다.",
   "auto": 1
  },
  "14": {
   "jp": "a6c5039855",
   "kr": "어번, 어번…"
  },
  "15": {
   "jp": "4e78049118",
   "kr": "…아드르, 아리스, 아리우스, 아스…라고."
  },
  "16": {
   "jp": "dc043a853c",
   "kr": "오, 찾았다, 찾았어."
  },
  "17": {
   "jp": "fcea0d8eea",
   "kr": "어번 씨구먼."
  },
  "18": {
   "jp": "547183415d",
   "kr": "어서 지나가시구려."
  },
  "19": {
   "jp": "c473acd20d",
   "kr": "어번 씨, 수고하셨구먼."
  },
  "20": {
   "jp": "6e72109561",
   "kr": "아이고, 그게 『은잔』이여?"
  },
  "21": {
   "jp": "cea56f7255",
   "kr": "참말로 번쩍번쩍 빛나는 게 곱기도 하네."
  },
  "22": {
   "jp": "f4b9ffd79a",
   "kr": "나도 이제 집에 갈 수 있겠구먼."
  },
  "23": {
   "jp": "2b9f6eb5c5",
   "kr": "허허, 아이한테 좋은 얘깃거리가 생겼어."
  },
  "24": {
   "jp": "2e0a341927",
   "kr": "그럼 어번 씨, 건강하게."
  },
  "25": {
   "jp": "5b7cf54b56",
   "kr": "힘내시구려."
  },
  "26": {
   "jp": "7197330888",
   "kr": "조심해서 가세요.",
   "auto": 1
  },
  "27": {
   "jp": "ee18c19ee6",
   "kr": "어이쿠, 뭐 잊은 거라도 있는감?"
  }
 }
}
