{
 "archive": "/D/SC300.DAT",
 "member": "..\\BIN\\DT00000E.BIN",
 "segments": {
  "0": {
   "jp": "2a9c4b33e7",
   "kr": "어라, 무슨 일이야?"
  },
  "1": {
   "jp": "8c3ad7c74e",
   "kr": "기아의 마르세 씨한테서"
  },
  "2": {
   "jp": "b909bcd800",
   "kr": "편지를 맡아 왔어요."
  },
  "3": {
   "jp": "eab9b31948",
   "kr": "게이니에게 편지를 건넸다."
  },
  "4": {
   "jp": "bdc59a374c",
   "kr": "고마워."
  },
  "5": {
   "jp": "e2f62a2179",
   "kr": "응?"
  },
  "6": {
   "jp": "6ebb5084d9",
   "kr": "왜 그래? 나머지는 알선소에서 보수를 받으면"
  },
  "7": {
   "jp": "b6ecbc6102",
   "kr": "되는데."
  },
  "8": {
   "jp": "bfae263df7",
   "kr": "아니면 뭐야… 아하, 혹시"
  },
  "9": {
   "jp": "96557c165b",
   "kr": "이 편지에 뭐라고 적혀 있는지 궁금한 거지."
  },
  "10": {
   "jp": "de240d77ed",
   "kr": "실은 나도 두근두근해."
  },
  "11": {
   "jp": "7c48b5e690",
   "kr": "나이 먹은 남자의 연애편지 답장이니 말이야."
  },
  "12": {
   "jp": "b6c96c993f",
   "kr": "어라… 넌 기아에서 온 거 아냐?"
  },
  "13": {
   "jp": "5f5dc83b7c",
   "kr": "혹시 편지 같은 거"
  },
  "14": {
   "jp": "1477766aa4",
   "kr": "맡아 온 거 없어?"
  },
  "15": {
   "jp": "1172cb382a",
   "kr": "아, 왔다 왔다."
  },
  "16": {
   "jp": "133bd5ef56",
   "kr": "네가 짐을 날라 주는 거구나."
  },
  "17": {
   "jp": "d8e9e99f4f",
   "kr": "이게 그 짐인데."
  },
  "18": {
   "jp": "05293718a5",
   "kr": "괜찮을까 모르겠네."
  },
  "19": {
   "jp": "e8bc783730",
   "kr": "큼직한 바구니를 맡았다."
  },
  "20": {
   "jp": "5c7ef03a3c",
   "kr": "바구니 속에서 바스락바스락 소리가 났다."
  },
  "21": {
   "jp": "a7960a3840",
   "kr": "뭐, 뭔가 움직이고 있어…?"
  },
  "22": {
   "jp": "d3175719a5",
   "kr": "그렇게 놀랄 것 없어. 그냥 새끼 고양이니까."
  },
  "23": {
   "jp": "9712250369",
   "kr": "귀여운 소리"
  },
  "24": {
   "jp": "c2db1f96e9",
   "kr": "야옹야옹."
  },
  "25": {
   "jp": "584bc1974c",
   "kr": "봐, 평범한 새끼 고양이지?"
  },
  "26": {
   "jp": "10150e874e",
   "kr": "배달할 곳은"
  },
  "27": {
   "jp": "088568519e",
   "kr": "가든힐 마을에 사는 준이라는 여자아이야."
  },
  "28": {
   "jp": "b1c6761e3f",
   "kr": "준은 여행 도중에 알게 된 아이야."
  },
  "29": {
   "jp": "2cb32ec776",
   "kr": "가든힐 마을에는 아무것도 없어서"
  },
  "30": {
   "jp": "6a192e5bf2",
   "kr": "늘 심심하다고 투덜댔거든."
  },
  "31": {
   "jp": "d67de56147",
   "kr": "준이 심심하지 않도록"
  },
  "32": {
   "jp": "b73c1f8a1e",
   "kr": "내가 주는 선물이야."
  },
  "33": {
   "jp": "17454f00c2",
   "kr": "어쩌면 무슨 이유를 대고 안 받으려 할지도"
  },
  "34": {
   "jp": "ba98325470",
   "kr": "모르지만, 꼭 두고 와야 해."
  },
  "35": {
   "jp": "dd96781235",
   "kr": "그럼 잘 부탁해."
  },
  "36": {
   "jp": "4dafc2461e",
   "kr": "짐이 꽉 찬 것 같네."
  },
  "37": {
   "jp": "c206f4dbb0",
   "kr": "짐을 정리하고 나서"
  },
  "38": {
   "jp": "69a0515e4a",
   "kr": "다시 와 줄래?"
  },
  "39": {
   "jp": "f95f32e4e9",
   "kr": "맡긴 짐을 가져다줄 곳은 가든힐 마을에 사는"
  },
  "40": {
   "jp": "43495a76f4",
   "kr": "여자아이 준이야. 잘 부탁해."
  },
  "41": {
   "jp": "493e526513",
   "kr": "뭐, 내게 온 짐이라고?"
  },
  "42": {
   "jp": "81436fc5e9",
   "kr": "에리트 씨한테 맡아 왔어."
  },
  "43": {
   "jp": "55a0186fbc",
   "kr": "술집 주인에게 짐을 건넸다."
  },
  "44": {
   "jp": "35c2c5c543",
   "kr": "그랬군! 뉴보른에서 동생을 만났구나!"
  },
  "45": {
   "jp": "b8fa4affe8",
   "kr": "동생은 잘 지내던가?"
  },
  "46": {
   "jp": "c98ce180df",
   "kr": "아니…"
  },
  "47": {
   "jp": "41cc1c44e5",
   "kr": "몸이 꽤 안 좋아 보였어."
  },
  "48": {
   "jp": "06156f3a74",
   "kr": "그래서 이 짐을 나르는 것도 알선소에"
  },
  "49": {
   "jp": "77a8ed092f",
   "kr": "부탁한 거야."
  },
  "50": {
   "jp": "e35aab0ea3",
   "kr": "……………"
  },
  "51": {
   "jp": "1f63e37c7f",
   "kr": "그 녀석, 결국 해냈구나."
  },
  "52": {
   "jp": "0ed3afd00e",
   "kr": "이 검은 우리 집 가보였던 검일세."
  },
  "53": {
   "jp": "b0e3423381",
   "kr": "사정이 있어 한번은 손에서 놓았네만"
  },
  "54": {
   "jp": "8686b0f988",
   "kr": "동생은 그 일을 몹시 마음에 두고 있었지."
  },
  "55": {
   "jp": "bebb1887fa",
   "kr": "그러면서 이 검을 되찾겠다며"
  },
  "56": {
   "jp": "7d97c7d062",
   "kr": "나가더니 아무 소식도 없이"
  },
  "57": {
   "jp": "d52d2b73f6",
   "kr": "몇 년…"
  },
  "58": {
   "jp": "98e1e1a3c9",
   "kr": "그런데 드디어… 아아, 동생이 보고 싶구나!"
  },
  "59": {
   "jp": "32ababd56e",
   "kr": "왜 그래?"
  },
  "60": {
   "jp": "81f2e065ba",
   "kr": "멍하니 서 있으면 일하는 데 방해야."
  },
  "61": {
   "jp": "9209ea346f",
   "kr": "그렇게 놀랄 것 없어."
  },
  "62": {
   "jp": "12b1fa17d6",
   "kr": "그냥 새끼 고양이니까."
  }
 }
}
