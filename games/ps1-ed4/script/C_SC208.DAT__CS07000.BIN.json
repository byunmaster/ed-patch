  "38": {
   "jp": "a7d1f148f5",
   "kr": "미안, 형."
  },
  "39": {
   "jp": "9107dc1d98",
   "kr": "나 지금 좀 지쳐서 말이야."
  },
  "40": {
   "jp": "d71c71a328",
   "kr": "회복할 때까지 기다려 줘."
  },
  "41": {
   "jp": "bf0d575554",
   "kr": "…됐다."
  },
  "42": {
   "jp": "ed027344a1",
   "kr": "자, 이 정도야."
  },
  "43": {
   "jp": "053f896239",
   "kr": "내가 하면 식은 죽 먹기지."
  },
  "44": {
   "jp": "2a88af03ef",
   "kr": "뭐니 뭐니 해도 미래의 대마법사니까."
  },
  "45": {
   "jp": "641449362a",
   "kr": "이봐요, 일반인은 물러나십시오."
  },
  "46": {
   "jp": "ce80e85afc",
   "kr": "저희는"
  },
  "47": {
   "jp": "c937c3d26e",
   "kr": "알선소에서 정식으로 의뢰를 받아 왔어요."
  },
  "48": {
   "jp": "9d68e00559",
   "kr": "아, 이거 실례했습니다."
  },
  "49": {
   "jp": "af5c768828",
   "kr": "그럼 이름을 확인하겠습니다."
  },
  "50": {
   "jp": "5e19280085",
   "kr": "어빈.",
   "auto": 1
  },
  "51": {
   "jp": "b5010dfc4b",
   "kr": "어빈 씨군요."
  },
  "52": {
   "jp": "af5764b84d",
   "kr": "어디 보자…"
  },
  "53": {
   "jp": "e38abbdbbf",
   "kr": "관리는 수첩을 넘겼다.",
   "auto": 1
  },
  "54": {
   "jp": "822dc1a2ea",
   "kr": "아… 『아』는 많네요…"
  },
  "55": {
   "jp": "4862ea3eb4",
   "kr": "아돌, 아레스, 아리오스, 애시, 아틀라스, 어디 보자."
  },
  "56": {
   "jp": "6790947746",
   "kr": "아, 있다, 어빈.",
   "auto": 1
  },
  "57": {
   "jp": "c90a436bb5",
   "kr": "네네, 확인됐습니다."
  },
  "58": {
   "jp": "ab7b6fbede",
   "kr": "어서 지나가십시오."
  },
  "59": {
   "jp": "687a707243",
   "kr": "이 동굴은 샴실단의 아지트였어요."
  },
  "60": {
   "jp": "996e01b393",
   "kr": "알선소에서 조사할 게 있으니까요."
  },
  "61": {
   "jp": "789be01948",
   "kr": "아, 어빈 씨, 수고하셨습니다."
  },
  "62": {
   "jp": "2f6de9c791",
   "kr": "오오, 그게 『진주보석관』이군요."
  },
  "63": {
   "jp": "0aa8f7463e",
   "kr": "과연, 왕가의 비보 같은 느낌이 나네요."
  },
  "64": {
   "jp": "18a57527ce",
   "kr": "수고하셨습니다.",
   "auto": 1
  },
  "65": {
   "jp": "83e4523207",
   "kr": "덕분에 저도 임무 끝입니다."
  },
  "66": {
   "jp": "aed70e1c2e",
   "kr": "그럼, 언젠가 또."
  },
  "67": {
   "jp": "748a441398",
   "kr": "어빈 씨시죠?"
  },
  "68": {
   "jp": "e4ad207204",
   "kr": "자, 가세요.",
   "auto": 1
  },
  "69": {
   "jp": "bcbd07f71a",
