   "auto": 1
  },
  "7": {
   "jp": "9af4319872",
   "kr": "입구 병사는 뭘 하고 있었던 걸까."
  },
  "8": {
   "jp": "da7bd0b94f",
   "kr": "이 동굴은 위험해."
  },
  "9": {
   "jp": "7cbd77a089",
   "kr": "어째서 이런 곳에 있는 거야?"
  },
  "10": {
   "jp": "9423bc97b4",
   "kr": "일하러 왔지, 뭐겠어?"
  },
  "11": {
   "jp": "cb0777e4d9",
   "kr": "설마 너희가"
  },
  "12": {
   "jp": "fa62e549c5",
   "kr": "기술자 체포하러 온 모험가?"
  },
  "13": {
   "jp": "0037b13a65",
   "kr": "그래."
  },
  "14": {
   "jp": "3f07018520",
   "kr": "왜 이상하게 여기는 거야?"
  },
  "15": {
   "jp": "5028dc540c",
   "kr": "아직 어린애잖아."
  },
  "16": {
   "jp": "21521cf07b",
   "kr": "실례네!"
  },
  "17": {
   "jp": "4b6ea4a0ba",
   "kr": "그쪽에도 어린애가 있잖아."
  },
  "18": {
   "jp": "af4db9d7a2",
   "kr": "난 어린애가 아니야!"
  },
  "19": {
   "jp": "91c54747ac",
   "kr": "흑마법을 쓰게 하면"
  },
  "20": {
   "jp": "9c44d29aef",
   "kr": "존경의 대상이라고!"
  },
  "21": {
   "jp": "19bf1283e0",
   "kr": "우리도 그래."
  },
  "22": {
   "jp": "246fa4bae7",
   "kr": "나는 흑마법사야."
  },
  "23": {
   "jp": "5a770de909",
   "kr": "니플은 백마법사."
  },
  "24": {
   "jp": "cf8ae75ce9",
   "kr": "둘이 모이면 무서울 게 없어!"
  },
  "25": {
   "jp": "e7aa336181",
   "kr": "네페레라, 이분들과는"
  },
  "26": {
   "jp": "bf82677a8a",
   "kr": "앞으로 같이 일할 거야."
  },
  "27": {
   "jp": "be70c01556",
   "kr": "그러니 너무 화내면 안 돼."
  },
  "28": {
   "jp": "62aaf0a37b",
   "kr": "알았어."
  },
  "29": {
   "jp": "3847dd127c",
   "kr": "그럼 우리와 당신들이"
  },
  "30": {
   "jp": "b4b5d9b430",
   "kr": "나눠서 기술자를 찾자."
  },
  "31": {
   "jp": "d093072db7",
   "kr": "기술자 이름은 돌크이고"
  },
  "32": {
   "jp": "28a6f16ad4",
   "kr": "샴실단과 관계가 있는 모양이에요."
  },
  "33": {
   "jp": "387ca0439e",
   "kr": "질 나쁜 도적 집단이죠."
  },
  "34": {
   "jp": "90120b2854",
   "kr": "그렇다면 싸움도 있을 수 있겠군."
  },
  "35": {
   "jp": "77e823b761",
   "kr": "정말 너희만으로 괜찮겠어?"
  },
  "36": {
   "jp": "74e5e7ed79",
   "kr": "그～러～니～까, 애 취급하지 마!"
  },
  "37": {
   "jp": "b6f74cb660",
   "kr": "우린 갈게."
  },
  "38": {
   "jp": "0fd5515402",
   "kr": "돌크를 확실히 찾아내라고!"
  },
  "39": {
   "jp": "1342d53f92",
   "kr": "세상은 넓네."
  },
  "40": {
   "jp": "f0198c44af",
   "kr": "저런 여자애들이 모험가라니."
  },
  "41": {
   "jp": "9ffcce6741",
   "kr": "놀랐어."
  },
  "42": {
   "jp": "bab40e6fc9",
   "kr": "여자애 둘이서 일을 맡았다니."
  },
  "43": {
   "jp": "5e72fc24ba",
   "kr": "이야, 신선한 감동이네요."
  },
  "44": {
   "jp": "970428575f",
   "kr": "앳된 소녀들이"
  },
  "45": {
   "jp": "41cc0096f2",
   "kr": "모험가였다니."
  },
  "46": {
   "jp": "47788a903c",
   "kr": "우리도 꾸물거릴 수 없어."
  },
  "47": {
   "jp": "c1f2eb16e0",
   "kr": "앞으로 가자."
  },
  "48": {
   "jp": "a30e5795a8",
   "kr": "아무래도 나를 잡으러 왔나 보군."
  },
  "49": {
   "jp": "a1b499002a",
   "kr": "아, 섣불리 덤비지 마."
  },
  "50": {
   "jp": "029184f1af",
   "kr": "샴실단의 공격을"
  },
  "51": {
   "jp": "2af180e406",
   "kr": "피해 온 너희를 상대로"
  },
  "52": {
   "jp": "ee80a6def0",
   "kr": "싸울 마음은 털끝만큼도 없어."
  },
  "53": {
   "jp": "63fe1b48f1",
   "kr": "그런데 이런 데서 뭘 하고 있었지?"
  },
  "54": {
   "jp": "b5c1555636",
   "kr": "대체 무슨 속셈으로 이 동굴에 왔어?"
  },
  "55": {
   "jp": "03195d934c",
   "kr": "당신은 이런 동굴에서"
  },
  "56": {
   "jp": "ccbefc6daa",
   "kr": "뭘 하고 있었나요?"
  },
  "57": {
   "jp": "24ca9afc50",
   "kr": "붙잡힌 이상 솔직히 말해 주지."
  },
  "58": {
   "jp": "f874e72cf4",
   "kr": "내 고용주 샴실단은"
  },
  "59": {
   "jp": "e69dda2d9c",
   "kr": "마수를 자유자재로 부리는 방법이 적힌"
  },
  "60": {
   "jp": "b19376c043",
   "kr": "고문서를 입수했어."
  },
  "61": {
   "jp": "1bb13e9ffb",
   "kr": "나는 거기에 필요한 재료를 모으고 있었지."
  },
  "62": {
   "jp": "31d1e30d3c",
   "kr": "마수를 마음대로 부리면 큰일이야!"
  },
  "63": {
   "jp": "27d720bc57",
   "kr": "어디서 그런 고문서를 찾았을까?"
  },
  "64": {
   "jp": "a54017f6bf",
   "kr": "마수를 뜻대로 부릴 수 있다면"
  },
  "65": {
   "jp": "79ff444560",
   "kr": "병사보다 강력한 전력이 되겠어."
  },
  "66": {
   "jp": "963d0a5b5f",
   "kr": "대체 어디서 그런 고문서를…"
  },
  "67": {
   "jp": "b08ed90223",
   "kr": "정말 무서운 기술이에요, 이건."
  },
  "68": {
   "jp": "f205b68b04",
   "kr": "어디에 그런 고문서가…"
  },
  "69": {
   "jp": "76ab28123f",
   "kr": "분명 왕성에서 훔쳐 냈다고 했지."
  },
  "70": {
   "jp": "5fbb8edf39",
   "kr": "말도 안 돼!"
  },
  "71": {
   "jp": "5f6df5301c",
   "kr": "왕성에서 훔친 고문서라고?"
  },
  "72": {
   "jp": "b812cac8ea",
   "kr": "그거라면 내가 되찾았을 텐데."
  },
  "73": {
   "jp": "fa665b074e",
   "kr": "답은 간단해."
  },
  "74": {
   "jp": "70cecd0cf6",
