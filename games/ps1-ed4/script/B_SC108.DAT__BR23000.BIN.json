  },
  "155": {
   "jp": "889ceea3f2",
   "kr": "보물상자에는 "
  },
  "156": {
   "jp": "665e4d5705",
   "kr": "이(가) 들어 있다.",
   "auto": 1
  },
  "157": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "158": {
   "jp": "f5fc3dee34",
   "kr": "을(를) 포기했다.",
   "auto": 1
  },
  "159": {
   "jp": "b0a0daf29b",
   "kr": "수고했네, 모험가 군."
  },
  "160": {
   "jp": "9707bc0d3b",
   "kr": "우리 샴실단도 룬 크리스탈을"
  },
  "161": {
   "jp": "bde50d8198",
   "kr": "노리고 있었지."
  },
  "162": {
   "jp": "50ce956cb4",
   "kr": "다만 마수가 방해였기에"
  },
  "163": {
   "jp": "a9b826244f",
   "kr": "자네 같은 모험가가 오기를 기다렸던 거지."
  },
  "164": {
   "jp": "b86a8bd3f1",
   "kr": "마수를 쓰러뜨려 피곤한 참에 미안하지만"
  },
  "165": {
   "jp": "486ea63858",
   "kr": "사양 않고 룬 크리스탈은 빼앗겠네."
  },
  "166": {
   "jp": "08ea54de55",
   "kr": "응? 왕도로 돌아오라고?"
  },
  "167": {
   "jp": "3dff605fbc",
   "kr": "대체 무슨 일이지."
  },
  "168": {
   "jp": "d271c278e7",
   "kr": "전해 줘서 고맙네."
  },
  "169": {
   "jp": "3f1db93716",
   "kr": "바로 돌아가겠네."
  },
  "170": {
   "jp": "184469cf52",
   "kr": "지금 이 동굴의 마수를 토벌 중이야."
  },
  "171": {
   "jp": "561cdf4c5a",
   "kr": "위험하지 않게 조심해."
  },
  "172": {
   "jp": "20b1334a5d",
   "kr": "필딘으로 돌아오라고?"
  },
  "173": {
   "jp": "f13021e2df",
   "kr": "고마워라!"
  },
  "174": {
   "jp": "d9f7238eab",
   "kr": "눅눅한 동굴과도 이별이다."
  },
  "175": {
   "jp": "1be2e7dc47",
   "kr": "알려 줘서 살았다!"
  },
  "176": {
   "jp": "05e19add26",
   "kr": "정말 지긋지긋했어."
  },
  "177": {
   "jp": "b5616fdf93",
   "kr": "눅눅한 동굴에서"
  },
  "178": {
   "jp": "1d601f79a3",
   "kr": "마수 퇴치라니 질색이야."
  },
  "179": {
   "jp": "62fc541695",
   "kr": "당장 필딘으로 돌아오라고?"
  },
  "180": {
   "jp": "ad04aa1a5f",
   "kr": "음, 마수 퇴치 임무 도중이지만"
  },
  "181": {
   "jp": "bebfd6fe3a",
   "kr": "명령이라면 어쩔 수 없지."
  },
  "182": {
   "jp": "7b83f468ac",
   "kr": "전언 수고했네."
  },
  "183": {
   "jp": "b978e7839b",
   "kr": "자네도 조심해서 돌아가게."
  },
  "184": {
   "jp": "f92197ab5f",
   "kr": "마수 퇴치는 병사의 임무야."
  },
  "185": {
   "jp": "2259c5c271",
   "kr": "언제나 모험가에게만 맡길 수는 없지."
  },
  "186": {
   "jp": "772e058081",
   "kr": "이걸로 전원에게 전했군."
  },
  "187": {
   "jp": "524d372594",
   "kr": "의뢰 완료다.",
   "auto": 1
  }
 }
}
