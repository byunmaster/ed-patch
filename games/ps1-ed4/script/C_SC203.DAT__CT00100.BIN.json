  },
  "19": {
   "jp": "693da67d5b",
   "kr": "엄청난 기세였어…"
  },
  "20": {
   "jp": "eb565d324a",
   "kr": "부들부들부들…"
  },
  "21": {
   "jp": "9153bdf331",
   "kr": "언제까지고 여기는 춥다니까."
  },
  "22": {
   "jp": "be37457b6a",
   "kr": "슬슬 따뜻해져 주지 않으면 못 견디겠어."
  },
  "23": {
   "jp": "eb565d324a",
   "kr": "부들부들부들…"
  },
  "24": {
   "jp": "7f28d50459",
   "kr": "오, 별일이로군. 우리 집에 나그네가 오다니."
  },
  "25": {
   "jp": "65b7225281",
   "kr": "수고가 많군."
  },
  "26": {
   "jp": "36ed34da9f",
   "kr": "너무 추워서"
  },
  "27": {
   "jp": "c08da56342",
   "kr": "역시 나도 이쪽으로 피난 왔어."
  },
  "28": {
   "jp": "e899345b84",
   "kr": "여기라면 아는 얼굴도 많고"
  },
  "29": {
   "jp": "b53b28a69d",
   "kr": "다들 친절하게 대해 주니까."
  },
  "30": {
   "jp": "900d1c63e3",
   "kr": "안심이야."
  },
  "31": {
   "jp": "447fe8f306",
   "kr": "얘기 들었어."
  },
  "32": {
   "jp": "a63c57fabe",
   "kr": "둘가 님이 얼음 신전에서 나가셨다면서."
  },
  "33": {
   "jp": "2f7baa5cb4",
   "kr": "그래서 추위가 심해진 걸까."
  },
  "34": {
   "jp": "d02ab5e15b",
   "kr": "둘가 님이 탄식하실 만한 일이"
  },
  "35": {
   "jp": "2153088920",
   "kr": "이 세상에서 일어나고 있는 걸까…"
  },
  "36": {
   "jp": "888609b716",
   "kr": "오, 무슨 일인고?"
  },
  "37": {
   "jp": "78775f1e4a",
   "kr": "기아의 헤임 씨한테 짐을 맡아 왔어."
  },
  "38": {
   "jp": "2b528e74d3",
   "kr": "글쎄, 헤임이라. 대체 누구일꼬."
  },
  "39": {
   "jp": "5c6e4a5fdb",
   "kr": "니트에게 목도리를 건넸다."
  },
  "40": {
   "jp": "cead615481",
   "kr": "이 더러운 목도리는 뭔고…"
  },
  "41": {
   "jp": "b35452c8a5",
   "kr": "오, 그러고 보니."
  },
  "42": {
   "jp": "af0cc28214",
   "kr": "이건 전에 여기 온 나그네에게 빌려준 것."
  },
  "43": {
   "jp": "f1cf8de63e",
   "kr": "추워 보이는 차림의 젊은이에게 줬었지."
  },
  "44": {
   "jp": "5b2556acb5",
   "kr": "이제 버릴까 하던 물건이라"
  },
  "45": {
   "jp": "a717f86959",
   "kr": "돌려주지 않아도 된다고 했는데…"
  },
  "46": {
   "jp": "241708e4c9",
   "kr": "참 의리 있는 분도 다 있구먼."
  },
  "47": {
   "jp": "6ba0eb9e89",
   "kr": "나는 까맣게 잊고 있었다네."
  },
  "48": {
   "jp": "ad3604c3e1",
   "kr": "모처럼 가져다주었으니"
  },
  "49": {
   "jp": "3fbea0de35",
   "kr": "다시 간직해 두기로 하지요."
  },
  "50": {
   "jp": "9af38fe1ac",
   "kr": "추워 보이는 차림의 나그네가 오면"
  },
  "51": {
   "jp": "ed195ce409",
   "kr": "빌려주기로 하지요."
  },
  "52": {
   "jp": "4daea2cfb0",
   "kr": "자네들, 먼 길 수고했구먼."
  },
  "53": {
   "jp": "953a3b61ef",
   "kr": "무슨 일인가. 어쩐 일인고?"
  },
  "54": {
   "jp": "7e4d805bae",
   "kr": "오, 나그네로구먼. 편히 쉬다 가시게."
  },
  "55": {
   "jp": "d2d1018314",
   "kr": "마을이 꽁꽁 얼어붙어 버렸구먼."
  },
  "56": {
   "jp": "ae2917ed15",
   "kr": "이거 어쩌면…"
  },
  "57": {
   "jp": "2d7538329b",
   "kr": "얼음 신전에 무슨 일이 있는 건지도 모르겠군…"
  },
  "58": {
   "jp": "b2b4e760d9",
