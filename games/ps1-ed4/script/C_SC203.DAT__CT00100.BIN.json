  },
  "111": {
   "jp": "4658fa5076",
   "kr": "어떻게든 해 주실 거야."
  },
  "112": {
   "jp": "6bf8ef23d2",
   "kr": "니트 할머니는 괜찮으실까."
  },
  "113": {
   "jp": "d93f2a5df6",
   "kr": "어르신 돌보는 건 젊은 사람이 해야지."
  },
  "114": {
   "jp": "a15849688c",
   "kr": "언제쯤 따뜻해질까."
  },
  "115": {
   "jp": "3461d7b3f5",
   "kr": "추위에 약한 편은 아니지만"
  },
  "116": {
   "jp": "5596513516",
   "kr": "가끔은 쨍쨍한 햇빛을"
  },
  "117": {
   "jp": "4bc7b909a9",
   "kr": "쬐어 보고 싶어."
  },
  "118": {
   "jp": "eaca7acfd3",
   "kr": "아, 추워, 추워, 추워."
  },
  "119": {
   "jp": "3b8dd1d394",
   "kr": "추워, 추워."
  },
  "120": {
   "jp": "50a144f4db",
   "kr": "추워."
  },
  "121": {
   "jp": "fb4a3e164e",
   "kr": "여기 있으면 따뜻하지만,"
  },
  "122": {
   "jp": "c1caf4fb3d",
