  },
  "16": {
   "jp": "eb565d324a",
   "kr": "부들부들부들…"
  },
  "17": {
   "jp": "bc3b159ea8",
   "kr": "코르나 산 쪽에서 뭔가 날아간 것 같은데"
  },
  "18": {
   "jp": "f2e0af9baa",
