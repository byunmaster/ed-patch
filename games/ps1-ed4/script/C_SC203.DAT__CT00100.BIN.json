  },
  "59": {
   "jp": "359fa4448f",
   "kr": "아, 나그네 양반은 모르겠구먼."
  },
  "60": {
   "jp": "320a46d13e",
   "kr": "이곳은 말이야, 기도를 올리기 쉽도록"
  },
  "61": {
   "jp": "65a88182ec",
   "kr": "조상님들이 만든 참배용 사당이라네."
  },
  "62": {
   "jp": "1c2ed25374",
   "kr": "본래 둘가 님의 사당은"
  },
  "63": {
   "jp": "dffa843d5f",
   "kr": "코르나 산의 동굴에 있거든."
  },
  "64": {
   "jp": "5d8e9642cb",
   "kr": "춥고 멀어서 가기만 해도 큰일이지."
  },
  "65": {
   "jp": "67396836e6",
