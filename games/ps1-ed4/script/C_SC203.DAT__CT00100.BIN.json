  },
  "126": {
   "jp": "8abc927046",
   "kr": "이 마을은 나한테 소중한 곳이야."
  },
  "127": {
   "jp": "4262c10d7c",
   "kr": "죽은 남편과의 추억이 가득 담겨 있거든."
  },
  "128": {
   "jp": "829545825c",
   "kr": "더글라스와 사이좋게 지내 줘."
