  "69": {
   "jp": "4884579426",
   "kr": "뭐라고?",
   "auto": 1
  },
  "70": {
   "jp": "127653594e",
   "kr": "둘가 님이 날아가셨다고?"
  },
  "71": {
   "jp": "4ff22a8943",
   "kr": "이거, 추운 것도 큰일이지만."
  },
  "72": {
   "jp": "c6c882d3c8",
   "kr": "마을이 생긴 뒤로 가장 큰일일지도 모르겠군."
  },
  "73": {
   "jp": "7930d32120",
   "kr": "허둥지둥… 허둥지둥…"
  },
  "74": {
   "jp": "cd59ae9ff9",
   "kr": "오, 나그네로구먼. 오랜만이군."
  },
  "75": {
   "jp": "8b5b8e4860",
   "kr": "내 생각에는 말이야."
  },
  "76": {
   "jp": "56410f8f72",
