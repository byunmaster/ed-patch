 "segments": {
  "0": {
   "jp": "24605d5709",
   "kr": "지작"
  },
  "1": {
   "jp": "43abd69034",
   "kr": "다렌"
  },
  "2": {
   "jp": "f392a686f3",
   "kr": "잠깐, 어빈.",
   "auto": 1
  },
  "3": {
   "jp": "d114eca73c",
   "kr": "목소리가 들려…"
  },
  "4": {
   "jp": "6139d2afaf",
   "kr": "어빈 씨, 잠깐만요."
  },
  "5": {
   "jp": "5ba74331d2",
   "kr": "뭔가 들리지 않나요?"
  },
  "6": {
   "jp": "ca29048780",
   "kr": "말소리 같은 게…"
  },
  "7": {
   "jp": "b66367d417",
   "kr": "목소리?"
  },
  "8": {
   "jp": "d8469b55fd",
   "kr": "누가 있는 거야?"
  },
  "9": {
   "jp": "75221a5e14",
   "kr": "큰 실수를 저질러 놓고는."
  },
  "10": {
   "jp": "73c942a76d",
   "kr": "그 물건이 얼마나 값나가는지 알기나 하냐."
  },
  "11": {
   "jp": "a833658c3f",
   "kr": "사람 좋아 보이는 놈한테 나르게 하면"
  },
  "12": {
   "jp": "b66085ae73",
   "kr": "안전할 줄 알았는데 말이지."
  },
  "13": {
   "jp": "c89f1aa59a",
   "kr": "설마 마을 출구에서 걸릴 줄이야…"
  },
  "14": {
   "jp": "b5f1d5069e",
   "kr": "관리들도 멍청이는 아니라는 거지."
  },
  "15": {
   "jp": "eefa841f1d",
   "kr": "감탄할 때냐."
  },
  "16": {
   "jp": "1fc78f8525",
   "kr": "어쨌든 여기도 슬슬 위험하다."
  },
  "17": {
   "jp": "4ce5d09a96",
   "kr": "걱정 마."
  },
  "18": {
   "jp": "fc5f792098",
   "kr": "지하실 안쪽에 은신처가 있다는 건"
  },
  "19": {
   "jp": "467f18525b",
   "kr": "집주인도 몰라."
  },
  "20": {
   "jp": "3add87ec59",
   "kr": "소동이 가라앉을 때까지"
  },
  "21": {
   "jp": "31a740f94e",
   "kr": "여기서 보물에 둘러싸여 지내자고."
  },
  "22": {
   "jp": "55fa10ff24",
   "kr": "누구냐, 네놈은!"
  },
  "23": {
   "jp": "36ef67cd21",
   "kr": "…이놈!"
  },
  "24": {
   "jp": "c1890f1f6d",
   "kr": "감옥에 들어간 거 아니었냐!"
  },
  "25": {
   "jp": "c2f211c71a",
   "kr": "덕분에 말이지!"
  },
  "26": {
   "jp": "333e36d33e",
   "kr": "톡톡히 갚아 줄 테니 각오해라!"
  }
 }
}
