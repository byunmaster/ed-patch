  "9": {
   "jp": "65581b64b0",
   "kr": "어새신"
  },
  "10": {
   "jp": "944c0763f9",
   "kr": "오크툼 신도들이 와요!"
  },
  "11": {
   "jp": "1a29f5cb00",
   "kr": "조심하세요."
  },
  "12": {
   "jp": "1e75a65327",
   "kr": "음. 잘 알려 주었네."
  },
  "13": {
   "jp": "70ebd4dad7",
   "kr": "섬사람들과 우리 사이에 결속이 있는 한,"
  },
  "14": {
   "jp": "eace7db1d2",
   "kr": "이 섬은 괜찮네."
  },
  "15": {
   "jp": "c9640dd9ed",
   "kr": "여기서 반드시 막아 내겠네."
  },
  "16": {
   "jp": "a2b8fc7558",
   "kr": "어서 안전한 곳으로 가게."
  },
  "17": {
   "jp": "cc58d4cefa",
   "kr": "안타깝군요."
  },
  "18": {
   "jp": "46d016149a",
   "kr": "안전한 곳으로 도망칠 틈 따위는 없습니다."
  },
  "19": {
   "jp": "91b7d45cca",
   "kr": "네놈이 볼게이드인가."
  },
  "20": {
   "jp": "5222b75b69",
   "kr": "제 이름을 알고 계시다니, 영광이군요."
  },
  "21": {
   "jp": "edf79c80f5",
   "kr": "흡!"
  },
  "22": {
   "jp": "0d9e3dc018",
   "kr": "앗…!?"
  },
  "23": {
   "jp": "8a2ea10ae5",
   "kr": "저는 말이죠. 적에게는 자비가 없습니다."
  },
  "24": {
   "jp": "95538abaef",
   "kr": "동료의 결속이라. 흥미롭군요."
  },
  "25": {
   "jp": "4ac666506a",
   "kr": "그래… 잠깐 실험을 해 봅시다."
  },
  "26": {
   "jp": "b29d7cc866",
   "kr": "여러분의 결속이라는 것이,"
  },
  "27": {
   "jp": "7b41f94954",
   "kr": "대체 어느 정도인지."
  },
  "28": {
   "jp": "fa75de024c",
   "kr": "그만두어라."
  },
  "29": {
   "jp": "8ce236977c",
   "kr": "후후후…"
  },
  "30": {
   "jp": "a5de7cd717",
   "kr": "네놈…!?"
  },
  "31": {
   "jp": "78eeb43adc",
   "kr": "이 여자는 죽었다."
  },
  "32": {
   "jp": "8f9b3982ff",
   "kr": "거기 있는 남자."
  },
  "33": {
   "jp": "25e7b0ac27",
   "kr": "이 여자에게 반한 모양이군."
  },
  "34": {
   "jp": "0a63f259bd",
   "kr": "여자를 구하고 싶지 않나?"
  },
  "35": {
   "jp": "aa94d2c114",
   "kr": "이 여자는 주법으로 혼을 빼앗겼다."
  },
  "36": {
   "jp": "a3772a818b",
   "kr": "즉 주법을 풀면 되살아난다는 말이지."
  },
  "37": {
   "jp": "6da8075d56",
   "kr": "나를 따라온다면,"
  },
  "38": {
   "jp": "e8441e2ff2",
   "kr": "주법을 푸는 방법을 가르쳐 줄 수도 있다."
  },
  "39": {
   "jp": "e9af107a05",
   "kr": "어떤가, 동료가 되겠나?"
  },
  "40": {
   "jp": "1503fdf5ff",
   "kr": "가지 마라!"
  },
  "41": {
   "jp": "0b088503e3",
   "kr": "…가서는 안 된다!"
  },
  "42": {
   "jp": "56317c4d90",
   "kr": "여자를 구하고 싶지 않은가?"
  },
  "43": {
   "jp": "76a24a2300",
   "kr": "어떠냐. 사람의 결속 따위는 이 정도다."
  },
  "44": {
   "jp": "d85b8b2d32",
   "kr": "약자의 동료 의식 따위,"
  },
  "45": {
   "jp": "8c239bffc1",
   "kr": "아무 쓸모도 없다."
  }
