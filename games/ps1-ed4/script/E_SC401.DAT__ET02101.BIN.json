  "179": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "180": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "181": {
   "jp": "bbe6341f7d",
   "kr": "무슨 일이시죠?"
  },
  "182": {
   "jp": "b4ed5c3700",
   "kr": "볼일이 없으시면 이만."
  },
  "183": {
   "jp": "6eb83144cb",
   "kr": "명상 중이라서요."
  },
  "184": {
   "jp": "9e077f7722",
   "kr": "아이고… 다리가 저려…"
  },
  "185": {
   "jp": "1c5b3fa843",
   "kr": "볼일이 없으시면 실례하겠습니다."
