  "151": {
   "jp": "d2a6bdcc95",
   "kr": "마음이 구원받는 듯했다."
  },
  "152": {
   "jp": "65a05135e4",
   "kr": "아아, 오길 잘했다."
  },
  "153": {
   "jp": "a304ed9103",
   "kr": "할아범도 할멈도 기뻐하고 있어."
  },
  "154": {
   "jp": "4b14cbb953",
   "kr": "염원하던 발크드 참배니까."
  },
  "155": {
   "jp": "9d695ad563",
   "kr": "훌륭한 건물이네."
  },
  "156": {
   "jp": "103428aa7b",
   "kr": "길을 잃지 않게 조심해야지."
  },
  "157": {
   "jp": "4d16010575",
   "kr": "나는 기쁘구먼."
  },
  "158": {
   "jp": "8ff2b9bcdb",
   "kr": "나도 기쁘다우."
  },
  "159": {
   "jp": "6ebc189608",
   "kr": "배고프네…"
  },
  "160": {
   "jp": "53efd01134",
   "kr": "식당 같은 건 없겠지…"
  },
  "161": {
   "jp": "8127c53945",
   "kr": "나중에 예배당을 구경하고"
  },
  "162": {
   "jp": "9e6c47227d",
