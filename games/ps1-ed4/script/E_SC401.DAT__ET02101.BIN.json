  },
  "196": {
   "jp": "7e65409b42",
   "kr": "사교도들이 쳐들어와도 괜찮아요."
  },
  "197": {
   "jp": "2a5fe46ed1",
   "kr": "이 지하에는 하수도가 지나고 있습니다."
  },
  "198": {
   "jp": "2d9e880448",
   "kr": "이 앞은 출입 금지입니다."
  },
  "199": {
   "jp": "2de302e0c8",
   "kr": "이 방에서 지하로 내려갈 수 있습니다."
  },
  "200": {
   "jp": "5e947269db",
   "kr": "하지만 평소에는 출입 금지랍니다."
  },
  "201": {
   "jp": "0f9a3caa90",
   "kr": "마일의 아버지와 어머니께…"
  },
  "202": {
   "jp": "e17d51c442",
   "kr": "어떻게 말해야 하지."
  },
  "203": {
   "jp": "95aa56792c",
   "kr": "빼앗긴 카테드랄을 대신하여"
