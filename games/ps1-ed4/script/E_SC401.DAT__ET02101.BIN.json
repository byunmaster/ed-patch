  },
  "27": {
   "jp": "5a17446d31",
   "kr": "사라졌다는"
  },
  "28": {
   "jp": "b59720d9ca",
   "kr": "마일과 섀넌의 소식에 대해서는"
  },
  "29": {
   "jp": "4a15e20a37",
   "kr": "짚이는 곳을 알아보겠소."
  },
  "30": {
   "jp": "b74a9c6656",
   "kr": "믿고 싶지 않지만,"
  },
  "31": {
   "jp": "4699a698ba",
   "kr": "그 상황에서 마일이 살아 있다고는 생각할 수 없어."
  },
  "32": {
   "jp": "77d2e9346e",
   "kr": "마일의 아버지와 어머니께… 어떻게 말씀드려야 하지."
  },
  "33": {
   "jp": "589e142bd4",
   "kr": "섀넌의 일도…"
  },
  "34": {
   "jp": "fa2ffa0967",
   "kr": "사자를 보내"
  },
  "35": {
   "jp": "71b825df67",
   "kr": "자네들에게 들은 대로 전하게 하겠소."
  },
  "36": {
   "jp": "b134754b26",
   "kr": "내가 직접 전하러 갈게."
  },
  "37": {
   "jp": "5ab4f3354a",
   "kr": "본래는 그게 좋겠지만."
  },
  "38": {
   "jp": "7253834df3",
   "kr": "너도 곧장 되돌아올 수는 없지 않겠소."
  },
  "39": {
   "jp": "79007b7672",
   "kr": "루티스의 일도 있고 말이오."
  },
  "40": {
   "jp": "9db4b8e367",
   "kr": "그 아이는 치료가 필요하오."
  },
  "41": {
   "jp": "30ce4048ac",
   "kr": "자칫하면 생명의 위험도 따르오."
  },
  "42": {
   "jp": "4e972ddffc",
   "kr": "네. 이대로 둘 수는 없어요."
  },
  "43": {
   "jp": "f4d00fe6a5",
   "kr": "오빠, 기억하고 있어?"
  },
  "44": {
   "jp": "b3e077a14b",
   "kr": "가웨인 님은 ８년 전,"
  },
  "45": {
   "jp": "11606d2742",
   "kr": "우리를 카테드랄에서 도망치게 해 주시고 나서"
  },
  "46": {
   "jp": "e7c78816f3",
   "kr": "디너켄 님 곁으로 데려가 주셨어."
  },
  "47": {
   "jp": "b1c6e25fc1",
   "kr": "그 뒤로 나와 오레시아 선생님을 베네키아 수도원에,"
  },
  "48": {
   "jp": "06b050801a",
   "kr": "오빠를 레뮤라스 님 댁에서 살 수 있도록"
  },
  "49": {
   "jp": "aedeb7b47b",
   "kr": "손을 써 주셨어."
  },
  "50": {
   "jp": "31cc55b9ae",
   "kr": "가끔 수도원에 상황을 보러 와 주셨고."
  },
  "51": {
   "jp": "7ae8fde6a6",
   "kr": "오레시아가 있으니 괜찮으리라 생각했지만"
  },
  "52": {
   "jp": "c00c27d4e6",
   "kr": "수도원은 남자 일손이 없어서 걱정이었소."
  },
  "53": {
   "jp": "e2c651f8b6",
   "kr": "어빈에게는 레뮤라스가 있었으니"
  },
  "54": {
   "jp": "2459fed785",
   "kr": "걱정할 필요가 없었지."
  },
  "55": {
   "jp": "0d100cc4e5",
   "kr": "……",
   "auto": 1
  },
  "56": {
   "jp": "3cf31a5e3e",
   "kr": "가웨인."
  },
  "57": {
   "jp": "3001304408",
   "kr": "레뮤라스는… 돌아가셨어."
  },
  "58": {
   "jp": "bf4f288568",
   "kr": "그래. 네가 여기 있다는 것이"
  },
  "59": {
   "jp": "abf345deba",
   "kr": "무엇보다 그 증거로군."
  },
  "60": {
   "jp": "f2d7e4a6a7",
   "kr": "레뮤라스는 자신의 목숨이 다할 때까지"
  },
  "61": {
   "jp": "4a1badb942",
   "kr": "너를 지켜볼 각오로 맡아 주었던 것이다."
  },
  "62": {
   "jp": "fa2246cb13",
   "kr": "그 뒤는 신과 어빈의 뜻에 맡긴다고."
  },
  "63": {
   "jp": "12e3a777f2",
   "kr": "그 녀석은 그렇게 말했지."
  },
  "64": {
   "jp": "79df43f47c",
   "kr": "할아버지가… 그런 말을."
  },
  "65": {
   "jp": "0d100cc4e5",
   "kr": "……",
   "auto": 1
  },
  "66": {
   "jp": "3cf31a5e3e",
   "kr": "가웨인."
  },
  "67": {
   "jp": "89846d4f9f",
   "kr": "아무튼 신보를 받아 주세요."
  },
  "68": {
   "jp": "e646dfe1d0",
   "kr": "제 카베사와 아이멜의 쿠엘포."
  },
  "69": {
   "jp": "110a922f4b",
   "kr": "큰 희생을 치르고 간신히 가져온 것입니다."
  },
  "70": {
   "jp": "50ef1f3707",
   "kr": "이로써 정신전에 돌려드립니다."
  },
  "71": {
   "jp": "957d7dc97b",
   "kr": "음."
  },
  "72": {
   "jp": "9c3331c7ce",
   "kr": "받도록 하겠소."
  },
  "73": {
   "jp": "09a248c928",
   "kr": "카테드랄 습격 때 돌아가신"
  },
  "74": {
   "jp": "06e69af148",
   "kr": "최고 도사 에스페리우스를 대신하여"
  },
  "75": {
   "jp": "8393a78b14",
   "kr": "크로웰이 최고 도사를 맡고 있소."
  },
  "76": {
   "jp": "665eb067be",
   "kr": "예배당에 있을 것이오. 자네들이 직접 건네도록 하시오."
  },
  "77": {
   "jp": "7667c1d4bd",
   "kr": "네.",
   "auto": 1
  },
  "78": {
   "jp": "da2a3d969c",
   "kr": "실례합니다.",
   "auto": 1
  },
  "79": {
   "jp": "c24edf42b0",
   "kr": "오오."
  },
  "80": {
   "jp": "08b5750139",
   "kr": "너희가 가웨인이 말하던"
  },
  "81": {
   "jp": "95075dc3a4",
   "kr": "어빈과 아이멜이로구려."
  },
  "82": {
   "jp": "8596327e91",
   "kr": "먼 길 수고했소."
  },
  "83": {
   "jp": "918be3f860",
   "kr": "카테드랄을 탈출할 때 맡았던"
  },
  "84": {
   "jp": "ddb5a68958",
   "kr": "카베사와 쿠엘포를 가져왔습니다."
  },
  "85": {
   "jp": "7bed094e5d",
   "kr": "어빈은 카베사와 쿠엘포를 건넸다."
  },
  "86": {
   "jp": "540c8a7d93",
   "kr": "퍽 슬프고 위험한 일을"
  },
  "87": {
   "jp": "3789d446a5",
   "kr": "겪게 한 것 같구려."
  },
  "88": {
   "jp": "0ee913ab69",
   "kr": "정신전을 대표하는 자로서 사과해야 하겠소."
  },
  "89": {
   "jp": "2792137c17",
   "kr": "정말 미안했소."
  },
  "90": {
   "jp": "a003cb1fd0",
   "kr": "………",
   "auto": 1
  },
  "91": {
   "jp": "cc4e4543a3",
   "kr": "원래 정신전의 제２ 성도였던 발크드가"
  },
  "92": {
   "jp": "73020bc87a",
   "kr": "빼앗긴 카테드랄을 대신해 성도가 되었는데,"
  },
  "93": {
   "jp": "e74f051044",
   "kr": "지난 ８년, 혼란도 많았소."
  },
  "94": {
   "jp": "e5918b8f7d",
   "kr": "솔직히 각지에 흩어진 이들에게 타진하고"
  },
  "95": {
   "jp": "91852a7b57",
   "kr": "연락을 주고받을 여유도 없었소."
  },
  "96": {
   "jp": "1ea8270e24",
   "kr": "나 또한 제２ 성도의 성직자 중 한 사람에 불과했으니 말이오."
  },
  "97": {
   "jp": "b75ec2a765",
   "kr": "정신전의 모든 것을 파악하고 있었던 것은 아니오."
  },
  "98": {
   "jp": "14fad9c8c3",
   "kr": "가웨인의 도움이 있었기에"
  },
  "99": {
   "jp": "9ca74df041",
   "kr": "그나마 어떻게든 버텨 올 수 있었소."
  },
  "100": {
   "jp": "9577f366b8",
   "kr": "크로웰 님."
  },
  "101": {
   "jp": "f4f16b6819",
   "kr": "신보에 대해 들려주세요."
  },
  "102": {
   "jp": "f2ffc6daf6",
   "kr": "오크툼 신을 숭배하는 자들이 신보를 노리는 것은"
  },
  "103": {
   "jp": "9e30f072bc",
   "kr": "어째서입니까?"
  },
  "104": {
   "jp": "0689ee5522",
   "kr": "신보의 힘을 두려워하는 것이오."
  },
  "105": {
   "jp": "288b405b4c",
   "kr": "이 세계에는 카베사와 쿠엘포 외에도"
  },
  "106": {
   "jp": "e938e42c26",
   "kr": "아직 네 개의 신보가 있다고 하오."
  },
  "107": {
   "jp": "f082e7cd5a",
   "kr": "신보는 우리 정신전이 숭배하는 발두스 신이"
  },
  "108": {
   "jp": "8b1a80c60c",
   "kr": "신들의 전쟁 끝에 오크툼 신을 봉인하기 위해"
  },
  "109": {
   "jp": "34df82e4b4",
   "kr": "세계로 흩어진 몸이오."
  },
  "110": {
   "jp": "2c46af5388",
   "kr": "그들은 우리 손에 신보가 있으면"
  },
  "111": {
   "jp": "bf667cf2a3",
   "kr": "오크툼 신을 위협하게 될 수 있다고"
  },
  "112": {
   "jp": "9e9f7d66dc",
   "kr": "생각하는 것이겠지."
  },
  "113": {
   "jp": "2b80d2acca",
   "kr": "아니, 그뿐 아니라."
  },
  "114": {
   "jp": "023bc622bc",
   "kr": "봉인의 힘을 유지하는 신보를 자신들이 관리함으로써"
  },
  "115": {
   "jp": "74c1cf5876",
   "kr": "오크툼 신을 봉인에서 풀어 주는 것을"
  },
  "116": {
   "jp": "b18b9f5cbb",
   "kr": "그들은 최종 목적으로 삼고 있는지도 모르오."
  },
  "117": {
   "jp": "aea2ca4f06",
   "kr": "그렇다면… 남은 신보는요?"
  },
  "118": {
   "jp": "dc9f92e2e1",
   "kr": "나머지 네 개의 신보도"
  },
  "119": {
   "jp": "13ff941aa6",
   "kr": "그놈들이 노리고 있는 게 아닙니까?"
  },
  "120": {
   "jp": "cb0ed0151d",
   "kr": "아마 그럴 것이오."
  },
  "121": {
   "jp": "05302b8ac2",
   "kr": "그러나 남은 신보가 있는 곳은"
  },
  "122": {
   "jp": "15e9b81b54",
   "kr": "유감스럽게도 우리도 알지 못하오."
  },
  "123": {
   "jp": "4ad88596ff",
   "kr": "쿠엘포와 카베사는"
  },
  "124": {
   "jp": "19d4da6210",
   "kr": "고대부터 정신전이 회수하여 보관해 온 물건이라"
  },
  "125": {
   "jp": "8d7d98892e",
   "kr": "우리 손에 있었지만…"
  },
  "126": {
   "jp": "01e8e3f7ba",
   "kr": "다른 신보는 전해 내려오는 이야기뿐이라"
  },
  "127": {
   "jp": "9e43a4ee42",
   "kr": "정말 있는 걸까, 있다면 어디에 있을까…?"
  },
  "128": {
   "jp": "b5a1b2d00d",
   "kr": "전혀 알려져 있지 않소."
  },
  "129": {
   "jp": "8129f9d9b8",
   "kr": "선대 최고 도사 에스페리우스라면"
  },
  "130": {
   "jp": "a24cb02fc3",
   "kr": "신보에 대해 더 알고 있었을지도 모르지만…"
  },
  "131": {
   "jp": "f576cc43c7",
   "kr": "무엇보다 수천 년 전의 신화이니 말이오."
  },
  "132": {
   "jp": "7cd3e653d1",
   "kr": "그렇군요."
  },
  "133": {
   "jp": "ae3d0f1855",
   "kr": "정말 수고했소."
  },
  "134": {
   "jp": "95eb72e4f9",
   "kr": "카베사와 쿠엘포는 확실히 받았소."
  },
  "135": {
   "jp": "485ba579b2",
   "kr": "여기라면 오크툼 신도들도 손을 대지 못할 것이오."
  },
  "136": {
   "jp": "a28a091ad8",
   "kr": "천천히 쉬다 가시오."
  },
  "137": {
   "jp": "343bce9ffa",
   "kr": "감사합니다.",
   "auto": 1
  },
  "138": {
   "jp": "65050ac8d3",
   "kr": "아, 안녕하세요."
  },
  "139": {
   "jp": "f9b7b81a46",
   "kr": "저는 이 신전에서 신세 지고 있는 로네라고 해요."
  },
  "140": {
   "jp": "1481a6ea57",
   "kr": "어빈 씨죠?"
  },
  "141": {
   "jp": "115130cb1d",
   "kr": "저, 이 스테인드글라스를 정말 좋아해요."
  },
  "142": {
   "jp": "928b901b48",
   "kr": "사람이란 대단하죠."
  },
  "143": {
   "jp": "ce20742b6c",
   "kr": "이렇게 훌륭한 물건을 만들 수도 있으니까요."
  },
  "144": {
   "jp": "ad2d2d66e7",
   "kr": "그럼, 실례할게요."
  },
  "145": {
   "jp": "58187d618c",
   "kr": "아름다운 스테인드글라스다."
  },
  "146": {
   "jp": "a3ef8662c2",
   "kr": "인간은 슬픔과 증오를 낳고"
  },
  "147": {
   "jp": "468e299c52",
   "kr": "싸우기만 하는 존재가 아니다."
  },
  "148": {
   "jp": "344d6b2a14",
   "kr": "훌륭한 것도 많이 남기고 있다."
  },
  "149": {
   "jp": "ff04e49f3a",
   "kr": "아름다운 스테인드글라스를 보고 있자니"
  },
  "150": {
   "jp": "40ad147e79",
   "kr": "어빈은 조금"
