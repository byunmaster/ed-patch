  },
  "24": {
   "jp": "fafc11bc95",
   "kr": "어서 오세요."
  },
  "25": {
   "jp": "5f2162e46c",
   "kr": "고맙네, 자네들."
  },
  "26": {
   "jp": "a2ddaa58ee",
   "kr": "동생 에리트 몫까지 사례하겠네."
  },
  "27": {
   "jp": "6a691996c7",
   "kr": "자, 편히 쉬다 가게."
  },
  "28": {
   "jp": "cfdcab2c4e",
   "kr": "여기서 긴 여행의 피로를 풀고 가요."
  },
  "29": {
   "jp": "c53d5d3086",
   "kr": "혹시 내 동생 에리트를 다시 만나면"
  },
  "30": {
   "jp": "9d7fdf8764",
   "kr": "나는 언제까지나 여기서 기다린다고"
  },
  "31": {
   "jp": "6747fc7971",
   "kr": "전해 주게."
  },
  "32": {
   "jp": "85aef77a2a",
   "kr": "아주 소중한 걸 무사히 전해 줘서"
  },
  "33": {
   "jp": "dea4992c54",
   "kr": "고맙네."
  },
  "34": {
   "jp": "6a691996c7",
   "kr": "자, 편히 쉬다 가게."
  },
  "35": {
   "jp": "cfdcab2c4e",
   "kr": "여기서 긴 여행의 피로를 풀고 가요."
  },
  "36": {
   "jp": "de57b1b5b1",
   "kr": "바로아에서 배를 타기 전에"
  },
  "37": {
   "jp": "4b9bd0ab45",
   "kr": "아이멜을 따라잡았으면 했는데"
  },
  "38": {
   "jp": "fe3e6d91fb",
   "kr": "꽤 한눈을 팔았네."
  },
  "39": {
   "jp": "0d1613888e",
   "kr": "벌써 아이멜은 세타로 건너갔을까."
  },
  "40": {
   "jp": "010f3b54a4",
   "kr": "갈 곳은 알아."
  },
  "41": {
   "jp": "b02b7fa361",
   "kr": "여기까지 왔잖아. 서두를 건 없어."
  },
  "42": {
   "jp": "8842a5bbd9",
   "kr": "꽤 활기찬 항구 마을이지?"
  },
  "43": {
   "jp": "89692be1a9",
   "kr": "이 바로아에서는"
  },
  "44": {
   "jp": "7d2dc0bd45",
   "kr": "듀시스 지방의 세타 항구로 가는 배가"
  },
  "45": {
   "jp": "6523333fa7",
   "kr": "정기적으로 다니고 있어."
  },
  "46": {
   "jp": "3432f7fadb",
   "kr": "항구 마을 바로아는 중요한 교통 거점이야."
  },
  "47": {
   "jp": "f7ab30795d",
   "kr": "알고 있어?"
  },
  "48": {
   "jp": "c788601610",
   "kr": "지금은 바로아가 항구 마을로 번성했지만"
  },
  "49": {
   "jp": "47ef692d52",
   "kr": "아주 옛날엔 항구 같은 건 없었대."
  },
  "50": {
   "jp": "f13920766a",
   "kr": "그런데도 저 등대는 옛날부터 있었던 모양이야."
  },
  "51": {
   "jp": "98551bfe91",
   "kr": "항구가 없는데 등대가 있었다니"
  },
  "52": {
   "jp": "775d679282",
   "kr": "…좀 이상하지?"
  },
  "53": {
   "jp": "508aca2c3b",
   "kr": "이것도 엘 필딘의 7대 불가사의야."
  },
  "54": {
   "jp": "9c4c6f775f",
   "kr": "어라, 무슨 일이야?"
  },
  "55": {
   "jp": "244f8d8805",
   "kr": "왠지 심각한 얼굴이네."
  },
  "56": {
   "jp": "fcf8690ea2",
   "kr": "너무 깊이 고민하지 않는 게 좋아."
  },
  "57": {
   "jp": "490ea2e96c",
   "kr": "바로아와 세타를 오가는 정기편이"
  },
  "58": {
   "jp": "b91a02cd62",
   "kr": "가끔 해적한테 습격당한대."
  },
  "59": {
   "jp": "6f3d542e9a",
   "kr": "세상이 흉흉해졌어."
  },
  "60": {
   "jp": "8c0003f96d",
   "kr": "아까 나한테 배에 대해 물어본 여자애."
  },
  "61": {
   "jp": "ba494d309e",
   "kr": "배는 잘 탔을까…"
  },
  "62": {
   "jp": "51940493bb",
   "kr": "귀여웠는데…"
  },
  "63": {
   "jp": "4d0db31e8f",
   "kr": "헤헤…"
  },
  "64": {
   "jp": "2c6866e677",
   "kr": "듀시스행 배를 물어보기에"
  },
  "65": {
   "jp": "df62deec3f",
   "kr": "친절하게 알려 줬지."
  },
  "66": {
   "jp": "2a1f8b9b09",
   "kr": "…귀여웠으니까."
  },
  "67": {
   "jp": "473f58e38d",
   "kr": "마을을 걷다 보면 즐거운 건"
  },
  "68": {
   "jp": "bfddd368ee",
   "kr": "가끔이지만,"
  },
  "69": {
   "jp": "a644833992",
   "kr": "아름다운 여성이 말을 걸어 주는 일이다."
  },
  "70": {
   "jp": "d104920cc4",
   "kr": "길을 묻는 것뿐이어도 좋다."
  },
  "71": {
   "jp": "66d30e0272",
   "kr": "왠지 엄청 득 본 기분이다."
  },
  "72": {
   "jp": "af9317f7f9",
   "kr": "그런 기쁨을 느끼지 못하게 되면"
  },
  "73": {
   "jp": "eab4c4ede3",
   "kr": "인생은 슬픈 법이다."
  },
  "74": {
   "jp": "7d6a86f4d9",
   "kr": "여어, 잘 지내?"
  },
  "75": {
   "jp": "7e31eeb4d3",
   "kr": "매일 두근두근하고 있어?"
  },
  "76": {
   "jp": "860935b674",
   "kr": "어려운 건 아무래도 좋아."
  },
  "77": {
   "jp": "4541d88bc1",
   "kr": "소소한 기쁨을 느끼는 생활."
  },
  "78": {
   "jp": "142d0f8cd4",
   "kr": "그것만 있으면 난 행복해."
  },
  "79": {
   "jp": "ca6624748f",
   "kr": "바로아·세타 간 배편은 하루에 몇 번이나 있으니까"
  },
  "80": {
   "jp": "34b5785dac",
   "kr": "혹시 놓쳐도 걱정 없어."
  },
  "81": {
   "jp": "47df6a7aad",
   "kr": "편리한 시대가 됐네."
  },
  "82": {
   "jp": "adb3cec7cb",
   "kr": "바로아와 세타 사이에"
  },
  "83": {
   "jp": "7a96d609a0",
   "kr": "긴 다리를 놓자는 이야기도 있는 모양인데"
  },
  "84": {
   "jp": "7c7d2f8aa6",
   "kr": "난 배가 더 운치 있어서 좋아."
  },
  "85": {
   "jp": "805ad4b886",
   "kr": "다리를 건너가는 건 밋밋하잖아."
  },
  "86": {
   "jp": "73d2fc3bc7",
   "kr": "그렇게 생각하지 않아?"
  },
  "87": {
   "jp": "ea6091dea5",
   "kr": "어머? 전에도 만났던가?"
  },
  "88": {
   "jp": "cbfb116240",
   "kr": "다들 아주 바빠 보이네요."
  },
  "89": {
   "jp": "8b02a082c2",
   "kr": "배 여행은 우아해서 좋다지만"
  },
  "90": {
   "jp": "2a90373d28",
   "kr": "난 안 탄다오."
  },
  "91": {
   "jp": "83debf3be7",
   "kr": "듣자니 가끔 해적이 나온다지 않나."
  },
  "92": {
   "jp": "42c82b4a73",
   "kr": "무섭구먼…"
  },
  "93": {
   "jp": "df614c2546",
   "kr": "요즘은 항로에 해적도 안 나와서"
  },
  "94": {
   "jp": "a542fbdccb",
   "kr": "배 여행도 아주 안전해졌다더군."
  },
  "95": {
   "jp": "685675b38b",
   "kr": "나도 여행이나 나서 볼까."
  },
  "96": {
   "jp": "adb02fe39b",
   "kr": "얼마 전에 배로 세타까지 다녀왔다오."
  },
  "97": {
   "jp": "0427233b2c",
   "kr": "아주 즐거웠지."
  },
  "98": {
   "jp": "9a2c2b429c",
   "kr": "오랜만의 배 여행이었으니까."
  },
  "99": {
   "jp": "cc5fe0d7da",
   "kr": "떠들썩한 술집 안에서도 고독이 밀려온다."
  },
  "100": {
   "jp": "aa89f9a82c",
   "kr": "모험가의 마음에 평안은 없다."
  },
  "101": {
   "jp": "3da7ad23fa",
   "kr": "후…"
  },
  "102": {
   "jp": "371fdcc65e",
   "kr": "여, 여, 여!",
   "auto": 1
  },
  "103": {
   "jp": "a2a89837e7",
   "kr": "지난번 그 청소년 아닌가."
  },
  "104": {
   "jp": "c63682a4d6",
   "kr": "잘 지내고 있나?"
  },
  "105": {
   "jp": "371fdcc65e",
   "kr": "여, 여, 여!",
   "auto": 1
  },
  "106": {
   "jp": "a2a89837e7",
   "kr": "지난번의 그 청소년이잖나."
  },
  "107": {
   "jp": "c63682a4d6",
   "kr": "잘 지내고 있나?"
  },
  "108": {
   "jp": "ed341f97ba",
   "kr": "…",
   "auto": 1
  },
  "109": {
   "jp": "05a9210a8a",
   "kr": "포포스는 말이 없지만,"
  },
  "110": {
   "jp": "29ea427e5f",
   "kr": "사실은 도움이 됐다고 생각하는 거야."
  },
  "111": {
   "jp": "3f759d2c3b",
   "kr": "포포스 몫은 내가 고맙다고 말하는 거야."
  },
  "112": {
   "jp": "beac9ff323",
   "kr": "여, 너희 어디서 왔냐?"
  },
  "113": {
   "jp": "53dde56c38",
   "kr": "여행하면"
  },
  "114": {
   "jp": "abadcb581f",
   "kr": "이런저런 좋은 일이 있겠지."
  },
  "115": {
   "jp": "7c4986d86e",
   "kr": "젠장, 부럽군."
  },
  "116": {
   "jp": "76e0a0e070",
   "kr": "오오, 너희냐."
  },
  "117": {
   "jp": "b6004641dd",
   "kr": "동료랑 여행하면 이런저런 다툼도"
  },
  "118": {
   "jp": "32c50c37cc",
   "kr": "있겠지."
  },
  "119": {
   "jp": "b4be49ed6d",
   "kr": "너희는 어때?"
  },
  "120": {
   "jp": "9041f3f5eb",
   "kr": "사이좋게 지내냐?"
  },
  "121": {
   "jp": "c43647bbc0",
   "kr": "뭐야, 또 너희냐."
  },
  "122": {
   "jp": "5fb51a10bf",
   "kr": "또 뭐라도 가져와."
  },
  "123": {
   "jp": "62f05a9802",
   "kr": "뭐, 힘내서 여행을 계속하라고."
  },
  "124": {
   "jp": "08c1c1a7aa",
   "kr": "수고했어. 새끼 고양이는 잘 전해 줬어?"
  },
  "125": {
   "jp": "e6b4fe3bd6",
   "kr": "가든힐에서 만난 여자애 준은"
  },
  "126": {
   "jp": "2ed8f45b6b",
   "kr": "눈빛이 아주 좋은 소녀야."
  },
  "127": {
   "jp": "fd7ddbf85b",
   "kr": "또 만났네."
  },
  "128": {
   "jp": "ab99dd031a",
   "kr": "지금껏 나는 이곳저곳 떠도는 삶을 살아왔다."
  },
  "129": {
   "jp": "ffb1a5d655",
   "kr": "당분간은 이 마을에 살려고 한다."
  },
  "130": {
   "jp": "dc8849b7d1",
   "kr": "여어, 너희!"
  },
  "131": {
   "jp": "f2ff90fcce",
   "kr": "이 마을은 좋은 마을이다. 이유 없이 좋은 마을이다."
  },
  "132": {
   "jp": "24987ded1f",
   "kr": "살아 보니 그렇게 느꼈으니까 좋은 마을이다."
  },
  "133": {
   "jp": "205477a8d4",
   "kr": "어쨌든 빨리 선생님을 찾아 줘."
  },
  "134": {
   "jp": "8b6370a375",
   "kr": "마감은 벌써 지났단 말이야."
  },
  "135": {
   "jp": "1b497738d2",
   "kr": "아이참, 바쁘니까 말 걸지 마."
  },
  "136": {
   "jp": "9183887683",
   "kr": "…선생님도 참, 어디 가신 걸까."
  },
  "137": {
   "jp": "e20cc9810a",
   "kr": "어머나, 너희들!"
  },
  "138": {
   "jp": "39a1539db2",
   "kr": "정말 잘해 줬구나."
  },
  "139": {
   "jp": "d71fbd524f",
   "kr": "선생님이 돌아오자마자"
  },
  "140": {
   "jp": "9e3e773f75",
   "kr": "창작 의욕이 펄펄해."
  },
  "141": {
   "jp": "9c104c3264",
   "kr": "너희들, 마법이라도 썼니?"
  },
  "142": {
   "jp": "0ff00023d3",
   "kr": "비밀인데, 신작 제목도 정해졌어."
  },
  "143": {
   "jp": "25c53dbbf9",
   "kr": "『질풍의 라빈』이라고 해."
  },
  "144": {
   "jp": "6ada18f030",
   "kr": "실은 네 이름을 빌렸단다."
  },
  "145": {
   "jp": "117b9bd5f4",
   "kr": "정말, 분명 밀리언셀러 틀림없어!!"
  },
  "146": {
   "jp": "5981fb7ef9",
   "kr": "『질풍의 라빈』, 읽어 줘."
  },
  "147": {
   "jp": "7f76775569",
   "kr": "어머, 어빈이잖아!"
  },
  "148": {
   "jp": "ca051f3ddd",
   "kr": "있잖아, 우리 선생님 못 봤어?"
  },
  "149": {
   "jp": "6c9d8d52f1",
   "kr": "정말, 어빈 짱도 참, 어빈 짱도 참!"
  },
  "150": {
   "jp": "e99a9865ee",
   "kr": "진짜 멋진 남자라니까."
  },
  "151": {
   "jp": "f4725a20ed",
   "kr": "우리 선생님, 돌아오자마자 펄펄해."
  },
  "152": {
   "jp": "082faefbcf",
   "kr": "이 기세면 『질풍의 라빈』은"
  },
  "153": {
   "jp": "565ce047ba",
   "kr": "밀리언셀러 틀림없어."
  },
  "154": {
   "jp": "d6f787405a",
