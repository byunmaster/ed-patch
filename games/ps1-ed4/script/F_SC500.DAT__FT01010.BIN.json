{
 "archive": "/F/SC500.DAT",
 "member": "..\\BIN\\FT01010.BIN",
 "segments": {
  "0": {
   "jp": "fa4eeeaa0d",
   "kr": "여관 안주인",
   "auto": 1
  },
  "1": {
   "jp": "e5d7e4ae02",
   "kr": "이것만은 분명히 말해 두겠어요."
  },
  "2": {
   "jp": "42692b27e7",
   "kr": "저보다 믿음직한 동료는 없을 거예요."
  },
  "3": {
   "jp": "7801646081",
   "kr": "마음 편한 곳에서 읽던 책을 읽기로 하겠어요."
  },
  "4": {
   "jp": "49ded9ee0e",
   "kr": "제가 필요해지면 불러 주세요."
  },
  "5": {
   "jp": "5e94c2f2a0",
   "kr": "검을 뽑았으면 망설임이 곧 죽음이야."
  },
  "6": {
   "jp": "c68533b00e",
   "kr": "자기들 안전을 최우선으로 하라고."
  },
  "7": {
   "jp": "25d0aea25b",
   "kr": "한 발짝만 나가도 싸움이 기다리고 있어요."
  },
  "8": {
   "jp": "57d0ec0903",
   "kr": "적어도 마을에 있는 동안은 푹 쉬어 두세요."
  },
  "9": {
   "jp": "3fa9bee9ef",
   "kr": "짧은 시간이었지만 함께 여행해서 좋았어요."
  },
  "10": {
   "jp": "2343f9c3b5",
   "kr": "너도 신념을 끝까지 관철해."
  },
  "11": {
   "jp": "f171d83ab3",
   "kr": "서로 살아 있으면 또 만나자!"
  },
  "12": {
   "jp": "60d972586b",
   "kr": "그만둬, 말려 봐야 소용없어.",
   "auto": 1
  },
  "13": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "14": {
   "jp": "b68200aaaf",
   "kr": "이 마을에 마법 길드가 있었지."
  },
  "15": {
   "jp": "2f29bfb1d6",
   "kr": "슬쩍 인사나 해 둘까."
  },
  "16": {
   "jp": "e9ea822e6b",
   "kr": "뒤를 쫓아오는 건 그만둬.",
   "auto": 1
  },
  "17": {
   "jp": "87498f6c42",
   "kr": "아닙니다, 이별에 눈물은 어울리지 않습니다."
  },
  "18": {
   "jp": "6342256065",
   "kr": "밝게 웃으며 배웅해 주십시오."
  },
  "19": {
   "jp": "4b59f66212",
   "kr": "내 힘이 필요할 때는",
   "auto": 1
  },
  "20": {
   "jp": "fc84a547dc",
   "kr": "찾아오너라."
  },
  "21": {
   "jp": "627c5d23a1",
   "kr": "마음 편한 곳에서"
  },
  "22": {
   "jp": "09fdb3002b",
   "kr": "읽던 책을 읽으려고 해요."
  }
 }
}
