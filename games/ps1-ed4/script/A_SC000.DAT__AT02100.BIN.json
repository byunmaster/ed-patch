  },
  "222": {
   "jp": "f92afcb579",
   "kr": "오울은 편지를 찢었다."
  },
  "223": {
   "jp": "6737f67bc6",
   "kr": "어빈 씨,"
  },
  "224": {
   "jp": "004a8662ef",
   "kr": "훌륭한 분입니다!"
  },
  "225": {
   "jp": "3af9492a29",
   "kr": "용기와 힘뿐 아니라"
  },
  "226": {
   "jp": "f73a020fc1",
   "kr": "뛰어난 지혜도 가지고 계십니다!"
  },
  "227": {
   "jp": "13b6c7309a",
   "kr": "정말 감사했습니다."
  },
  "228": {
   "jp": "304649d6df",
   "kr": "확실히"
  },
  "229": {
   "jp": "210a16f398",
   "kr": "이런 아버지라면 도망치고 싶어질지도…"
  },
  "230": {
   "jp": "e965c08e3e",
   "kr": "딸이 누군가와 사귀고 있었다는 것조차"
