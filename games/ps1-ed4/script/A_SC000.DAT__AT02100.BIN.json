   "kr": "타크"
  },
  "2": {
   "jp": "5f71683fb8",
   "kr": "오울"
  },
  "3": {
   "jp": "3c42d6c051",
   "kr": "코레트"
  },
  "4": {
   "jp": "81f395be89",
   "kr": "마법 길드원"
  },
  "5": {
   "jp": "25a3238789",
   "kr": "소드 길드원"
  },
  "6": {
   "jp": "726be04855",
   "kr": "데이지"
  },
  "7": {
   "jp": "e3a4e07756",
   "kr": "케이트"
  },
  "8": {
   "jp": "c5711e354f",
   "kr": "얀크"
  },
  "9": {
   "jp": "2ff57fa65e",
   "kr": "동 ",
   "auto": 1
  },
  "10": {
   "jp": "958833304b",
   "kr": "하아, 큰일이네."
  },
  "11": {
   "jp": "d8112fb064",
   "kr": "어쩌면 좋지."
  },
  "12": {
   "jp": "852aea304a",
   "kr": "의뢰를 맡아 주신 거군요."
  },
  "13": {
   "jp": "27a7712b9d",
   "kr": "실은 좀 부탁하기 어려운 일인데요."
  },
  "14": {
   "jp": "1bfe87bb48",
   "kr": "왕립 도서관 책을 벌써 반년이나 빌린 채예요."
  },
  "15": {
   "jp": "9754f959fd",
   "kr": "돌려줘야 한다, 돌려줘야 한다고 생각하면서도"
  },
  "16": {
   "jp": "52ffd82bfa",
   "kr": "돌려주러 가지 못하고 말았어요…"
  },
  "17": {
   "jp": "5a16ce2d4c",
   "kr": "죄송하지만 대신 부탁드려도 될까요?"
  },
  "18": {
   "jp": "c56bfc9f1d",
   "kr": "데이지는 어빈에게 "
  },
  "19": {
   "jp": "f6bca41636",
   "kr": "을(를) 건넸다.",
   "auto": 1
  },
  "20": {
   "jp": "a648fce4ee",
   "kr": "어머, 짐이 꽤 많네요."
  },
  "21": {
   "jp": "bfda46522c",
   "kr": "부탁하고 싶은 게 있으니 좀 줄이고 와 주세요."
  },
  "22": {
   "jp": "ab9dc88c33",
   "kr": "싫은 부탁을 해서 미안해요."
  },
  "23": {
   "jp": "1b2c71b8c8",
   "kr": "이번엔 꼭 대출 기한을 지킬게요."
  },
  "24": {
   "jp": "74054f6de5",
   "kr": "왕립 도서관 책은 평생 걸려도 다 못 읽어요."
  },
  "25": {
   "jp": "352e7fe0d5",
   "kr": "이번엔 꼭 책을 돌려줄게요."
  },
  "26": {
   "jp": "bc91e81c76",
   "kr": "날씨가 좋네요."
  },
  "27": {
   "jp": "8848e184cb",
   "kr": "이런 날은 책을 실컷 읽고 싶어요."
  },
  "28": {
   "jp": "29e26938b5",
   "kr": "와～ 분수, 분수."
  },
  "29": {
   "jp": "4229f6e63b",
   "kr": "꺄하하, 재밌다～."
  },
  "30": {
   "jp": "7a8997d776",
   "kr": "어이, 케이트 맞지?"
  },
  "31": {
   "jp": "ad5cd33bf9",
   "kr": "아저씨가 걱정하고 있어."
  },
  "32": {
   "jp": "437fc7fa4a",
   "kr": "어?"
  },
  "33": {
   "jp": "021b83de26",
   "kr": "아저씨도 참, 정말 걱정이 많다니까."
  },
  "34": {
   "jp": "5555e9120e",
   "kr": "조금만 더"
  },
  "35": {
   "jp": "7768882f3c",
   "kr": "놀려고 했는데."
  },
  "36": {
   "jp": "88afe69fa2",
   "kr": "알았어."
  },
  "37": {
   "jp": "e32a6efb96",
   "kr": "어빈은 얀크를 발견했다."
  },
  "38": {
   "jp": "9f59f6ebdc",
   "kr": "어라? 너는 분명…"
  },
  "39": {
   "jp": "ae336d5c17",
   "kr": "저번에 케이트를 찾아 준 사람이잖아."
  },
  "40": {
   "jp": "467358260f",
   "kr": "그 애가 또 없어졌어."
  },
  "41": {
   "jp": "46dc2d604e",
   "kr": "분수를 좋아해서"
  },
  "42": {
   "jp": "6a9bcbb213",
   "kr": "이 근처에 있을 줄 알았는데…"
  },
  "43": {
   "jp": "73146a75b7",
   "kr": "케이트라면 집에 있어."
  },
  "44": {
   "jp": "1abb6f35c1",
   "kr": "아저씨가 길을 잃었으니 찾아 달래."
  },
  "45": {
   "jp": "8813ca045d",
   "kr": "저희는 알선소에서 의뢰를 받았어요."
  },
  "46": {
   "jp": "a64ea1379e",
   "kr": "에엑?!"
  },
  "47": {
   "jp": "2dc2211dfc",
   "kr": "뭐야."
  },
  "48": {
   "jp": "c5f31093d4",
   "kr": "또 엇갈렸잖아."
  },
  "49": {
   "jp": "eef47812e4",
   "kr": "게다가 알선소에 부탁했다니…"
  },
  "50": {
   "jp": "9de59e8934",
   "kr": "누가 의뢰비를 낸다는 거야."
  },
  "51": {
   "jp": "72fb36d43a",
   "kr": "설마 케이트가 돈을 낼 리도 없고."
  },
  "52": {
   "jp": "ec1da2168e",
   "kr": "…이런."
  },
  "53": {
   "jp": "ba16d23a23",
   "kr": "안됐네."
  },
  "54": {
   "jp": "6a2ed7c25e",
   "kr": "내가 케이트를 찾아서"
  },
  "55": {
   "jp": "18d418f8fb",
   "kr": "돌아다니고 있었을 텐데…"
  },
  "56": {
   "jp": "65fbfc2bff",
   "kr": "뭐, 너희도"
  },
  "57": {
   "jp": "b63f6e15a1",
   "kr": "찾아다녀 줬으니 어쩔 수 없나."
  },
  "58": {
   "jp": "4a89549845",
   "kr": "그럼 돌아갈까."
  },
  "59": {
   "jp": "9f59f6ebdc",
   "kr": "어라? 너는 분명…"
  },
  "60": {
   "jp": "ae336d5c17",
   "kr": "저번에 케이트를 찾아 준 사람이잖아."
  },
  "61": {
   "jp": "467358260f",
   "kr": "그 애가 또 없어졌어."
  },
  "62": {
   "jp": "1b22f64ffb",
   "kr": "분수를 좋아한다니까"
  },
  "63": {
   "jp": "6a9bcbb213",
   "kr": "이 근처에 있을 줄 알았는데…"
  },
  "64": {
   "jp": "84f28c6a76",
   "kr": "우리 딸은 공부를 좋아해서."
  },
  "65": {
   "jp": "037246094c",
   "kr": "기아에 유학 중이야."
  },
  "66": {
   "jp": "cab49a9291",
   "kr": "여자아이를 멀리 보내려니 용기가 필요했지만"
  },
  "67": {
   "jp": "0ebd6d968f",
   "kr": "레어의 부적을 잔뜩 들려 보냈으니 안심이야."
  },
  "68": {
   "jp": "908bc19e7f",
   "kr": "키트 마을이라는 곳에는"
  },
  "69": {
   "jp": "afad4cef89",
   "kr": "신기한 성수가 산다더군."
  },
  "70": {
   "jp": "fab5af2989",
   "kr": "우리 딸의 졸업 논문이야."
  },
  "71": {
   "jp": "4827bc6afe",
   "kr": "나는 희귀한 물건만 취급하는"
  },
  "72": {
   "jp": "3eade9d54d",
   "kr": "조금 별난 상인이야."
  },
  "73": {
   "jp": "8c047c9acd",
   "kr": "그러는 나야말로 희귀한 상인이지."
  },
  "74": {
   "jp": "9a0d8de7cf",
   "kr": "요컨대 희귀한 물건이 좋은 거야."
  },
  "75": {
   "jp": "c2fe8995d9",
   "kr": "오오, 약초를 가져다줬군."
  },
  "76": {
   "jp": "70ee41316f",
   "kr": "킁킁…"
  },
  "77": {
   "jp": "5045183603",
   "kr": "아직도 냄새가 나는 것 같은데."
  },
  "78": {
   "jp": "daf73abbcf",
   "kr": "뭐, 이삼 일만 지나면"
  },
  "79": {
   "jp": "8c4459e757",
   "kr": "신경 쓰이지 않게 될 거야."
  },
  "80": {
   "jp": "01cfbe384d",
   "kr": "그런데… 자네들,"
  },
  "81": {
   "jp": "a0c22336f3",
   "kr": "여행 도중에 뭔가 희귀한 물건을"
  },
  "82": {
   "jp": "51c25cf396",
   "kr": "손에 넣지 않았나?"
  },
  "83": {
   "jp": "acea60ac47",
   "kr": "희귀한 물건을 찾으면 꼭 나에게 알려"
  },
  "84": {
   "jp": "2a41341004",
   "kr": "주게나."
  },
  "85": {
   "jp": "7bf65bbabe",
   "kr": "아, 자네들이군."
  },
  "86": {
   "jp": "bd146be034",
   "kr": "어떤가, 뭔가 희귀한 물건을"
  },
  "87": {
   "jp": "84088ce34f",
   "kr": "손에 넣지 않았나?"
  },
  "88": {
   "jp": "684c5126e5",
   "kr": "나는 오랜 세월 희귀한 물건만 전문으로"
  },
  "89": {
   "jp": "44368d4a46",
   "kr": "장사를 계속하고 있네."
  },
  "90": {
   "jp": "c6eeeb9d4b",
   "kr": "그런데 세상에는 아직 내가 모르는"
  },
  "91": {
   "jp": "5af26075fb",
   "kr": "희귀한 물건이 잔뜩 있지."
  },
  "92": {
   "jp": "020ec6fb70",
   "kr": "그걸 생각하면 밤에 잠도 못 잘 만큼"
  },
  "93": {
   "jp": "b0416089d6",
   "kr": "두근두근하단 말이야."
  },
  "94": {
   "jp": "f28091f200",
   "kr": "드디어 와 줬군. 기다렸어."
  },
  "95": {
   "jp": "e18adca4d0",
   "kr": "자네가 운반해 줬으면 하는 건 이거야."
  },
  "96": {
   "jp": "525c478ca5",
   "kr": "타크의 짐을 맡았다."
  },
  "97": {
   "jp": "74b0320f14",
   "kr": "작고 가벼운 꾸러미지만 약초의 강렬한 냄새가 난다."
  },
  "98": {
   "jp": "238b1162d0",
   "kr": "냄새는 나도 잘 듣지. 잘 듣지만 냄새가 나는 약초야."
  },
  "99": {
   "jp": "49aba44b4d",
   "kr": "너무 냄새가 지독해서"
  },
  "100": {
   "jp": "58d02e8477",
   "kr": "여행 상인도 취급하지 않는 귀한 약초지."
  },
  "101": {
   "jp": "4124b508d4",
   "kr": "이걸 치브리 마을에서 기다리는"
  },
  "102": {
   "jp": "c734be1068",
   "kr": "레니 부인에게 전해 줘."
  },
  "103": {
   "jp": "22553e77b9",
   "kr": "특별히 조심할 일은 없어."
  },
  "104": {
   "jp": "cae200d980",
   "kr": "얼른 가져가."
  },
  "105": {
   "jp": "db82bfcf9a",
   "kr": "아무튼 전하면 되는 거지?"
  },
  "106": {
   "jp": "274701c89d",
   "kr": "윽, 코가 비뚤어지겠어."
  },
  "107": {
   "jp": "f73ccdfba9",
   "kr": "그나저나 지독한 냄새네."
  },
  "108": {
   "jp": "525da7305f",
   "kr": "빨리 전하지 않으면 몸에 냄새가"
  },
  "109": {
   "jp": "bb4c8f6abe",
   "kr": "배겠어."
  },
  "110": {
   "jp": "4dafc2461e",
   "kr": "짐이 가득한 것 같군."
  },
  "111": {
   "jp": "c206f4dbb0",
   "kr": "짐을 정리하고 나서"
  },
  "112": {
   "jp": "69a0515e4a",
   "kr": "다시 와 주겠나?"
  },
  "113": {
   "jp": "a357a43f5b",
   "kr": "웁웁. 약초 냄새가 난다 싶더니"
  },
  "114": {
   "jp": "2309bd793d",
   "kr": "아직 있었나."
  },
  "115": {
   "jp": "ca5874388f",
   "kr": "전할 곳은 치브리의 레니 씨야."
  },
  "116": {
   "jp": "08046b7938",
   "kr": "아무튼 빨리 가."
  },
  "117": {
   "jp": "860ad1d5fc",
   "kr": "동굴 쪽으로는 가지 않는 게 좋아요."
  },
  "118": {
   "jp": "50b9e0fc42",
   "kr": "산속으로 조금만 들어가도"
  },
  "119": {
   "jp": "728f373495",
   "kr": "흉포한 마수가 나와요."
  },
  "120": {
   "jp": "994340281c",
   "kr": "우리 딸, 미인이죠?"
  },
  "121": {
   "jp": "a906ec683a",
   "kr": "…그래서 정말 걱정돼요…"
  },
  "122": {
   "jp": "6e865d47c2",
   "kr": "아아… 코레트, 코레트…"
  },
  "123": {
   "jp": "90448ad9d0",
   "kr": "어째서 돌아오지 않는 거냐."
  },
  "124": {
   "jp": "45e7a0481a",
   "kr": "아빠가 싫어진 걸까…"
  },
  "125": {
   "jp": "5af0764999",
   "kr": "어빈 씨입니까!"
  },
  "126": {
   "jp": "3d0294fb06",
   "kr": "알선소에서 와 주신…"
  },
  "127": {
   "jp": "aa264aa8ef",
   "kr": "기다리고 있었습니다."
  },
  "128": {
   "jp": "7633c24e17",
   "kr": "딸이, 제 사랑하는 코레트가,"
  },
  "129": {
   "jp": "cbcf13406a",
   "kr": "돌아오지 않아요…!"
  },
  "130": {
   "jp": "9688ced4cb",
   "kr": "아아, 아빠의 어디가 마음에 안 들어서…"
  },
  "131": {
   "jp": "a02deab609",
   "kr": "진정해, 아저씨."
  },
  "132": {
   "jp": "265df59600",
   "kr": "이게 진정이 됩니까!"
  },
  "133": {
   "jp": "d213df5ad8",
   "kr": "딸이 갑자기 사라졌단 말입니다!"
  },
  "134": {
   "jp": "1001636fb3",
   "kr": "게다가 쓰레기통에서 이런 편지가…"
  },
  "135": {
   "jp": "08452f05a6",
   "kr": "오울은 편지를 펼쳤다."
  },
  "136": {
   "jp": "0706483587",
   "kr": "도넛, 정말 맛있었어.",
   "fix": 1
  },
  "137": {
   "jp": "e2ff1e5c4a",
   "kr": "크림 쿠키도 정말로,",
   "fix": 1
  },
  "138": {
   "jp": "9390660b91",
   "kr": "스며드는 듯한 멋진 맛이었어.",
   "fix": 1
  },
  "139": {
   "jp": "0b8b2a5aa6",
   "kr": "남쪽 나라에서 너와 살면 좋겠어.",
   "fix": 1
  },
  "140": {
   "jp": "597e869a69",
   "kr": "쪽빛 하늘 아래 느긋이 즐겁게 지내자.",
   "fix": 1
  },
  "141": {
   "jp": "7578816a24",
   "kr": "사르르 시원한 바람이 부는,",
   "fix": 1
  },
  "142": {
   "jp": "2e4a2a20d8",
   "kr": "플라타너스 그늘 아래 과일이 열리는 섬에서.",
   "fix": 1
  },
  "143": {
   "jp": "c602be36fe",
   "kr": "에워싼 루비빛 저녁노을을 바라보자.",
   "fix": 1
  },
  "144": {
   "jp": "e3206fc423",
   "kr": "서둘러 짐은 이미 다 꾸렸어.",
   "fix": 1
  },
  "145": {
   "jp": "ac23e1a629",
   "kr": "만약 편지가 도착하면 바로 와 줘.",
   "fix": 1
  },
  "146": {
   "jp": "185a6e796a",
   "kr": "나는 여기서 기다리고 있을게.",
   "fix": 1
  },
  "147": {
   "jp": "98ceabb438",
   "kr": "자책 속에 애태우는 루게이로부터.",
   "fix": 1
  },
  "148": {
   "jp": "4ca6094fb3",
   "kr": "마…"
  },
  "149": {
   "jp": "23851e53e8",
   "kr": "마치 사랑의 도피 권유 같아."
  },
  "150": {
   "jp": "adebfbdee0",
   "kr": "아아, 코레트!"
  },
  "151": {
   "jp": "0a0d83ed13",
   "kr": "애지중지 키웠는데!!"
  },
  "152": {
   "jp": "2d50eff7f7",
   "kr": "…으음."
  },
  "153": {
   "jp": "b7df76e6b7",
   "kr": "확실히 이런 아버지라면 도망치고 싶어질지도…"
  },
  "154": {
   "jp": "0638c8231b",
   "kr": "뭐라고요!"
  },
  "155": {
   "jp": "614c72d419",
   "kr": "저, 저기 어빈."
  },
  "156": {
   "jp": "a3eb47265b",
   "kr": "그런 경솔한 말 하면 안 돼."
  },
  "157": {
   "jp": "ab9e66561d",
   "kr": "어쨌든 부모에게 말도 없이 가출하는 건 좋지 않아."
  },
  "158": {
   "jp": "c08b5f6073",
   "kr": "제대로 도리를 지키는 편이"
  },
  "159": {
   "jp": "d7ba8845a6",
   "kr": "나중에 본인들도 곤란하지 않을 거야."
  },
  "160": {
   "jp": "7d0b3428d1",
   "kr": "그렇고말고요!"
  },
  "161": {
   "jp": "3adf808118",
   "kr": "저도 무작정 반대할 생각은 없습니다."
  },
  "162": {
   "jp": "4bc129ca2b",
   "kr": "본인들의 마음을 존중해 줄 생각입니다."
  },
  "163": {
   "jp": "881af65e62",
   "kr": "그렇다면"
  },
  "164": {
   "jp": "39a8961d4b",
   "kr": "기꺼이 도와 드리죠."
  },
  "165": {
   "jp": "068d338851",
   "kr": "이 루게이라는 사람에게 짚이는 데가 있나요?"
  },
  "166": {
   "jp": "93b3f8dcc0",
   "kr": "그게, 전혀."
  },
  "167": {
   "jp": "3eccecaf26",
   "kr": "딸이 누군가와 사귀고 있었다는 것조차 몰랐습니다."
  },
  "168": {
   "jp": "54e950c1ed",
   "kr": "단서라고는 이 편지뿐입니다."
  },
  "169": {
   "jp": "fc70557d5c",
   "kr": "어머."
  },
  "170": {
   "jp": "e7eb924c58",
   "kr": "괜찮으시다면 이 편지를 맡기겠습니다."
  },
  "171": {
   "jp": "5274e8cbfb",
   "kr": "짐에 여유가 생기면"
  },
  "172": {
   "jp": "f7427aac19",
   "kr": "다시 와 주세요."
  },
  "173": {
   "jp": "bb4fb37505",
   "kr": "이 편지는 여러분께 맡기겠습니다."
  },
  "174": {
   "jp": "754b17d672",
   "kr": "부디 루게이라는 남자를 찾아 주세요!"
  },
  "175": {
   "jp": "f6d3d2ace9",
   "kr": "그리고 딸을… 코레트를 데려와 주세요!"
  },
  "176": {
   "jp": "8455e48ace",
   "kr": "편지를 맡았다."
  },
  "177": {
   "jp": "e7eb924c58",
   "kr": "괜찮으시다면 이 편지를 맡기겠습니다."
  },
  "178": {
   "jp": "5274e8cbfb",
   "kr": "짐에 여유가 생기면"
  },
  "179": {
   "jp": "f7427aac19",
   "kr": "다시 와 주세요."
  },
  "180": {
   "jp": "d925d2ed0b",
   "kr": "자, 이게 단서가 되는 편지입니다."
  },
  "181": {
   "jp": "8455e48ace",
   "kr": "편지를 맡았다."
  },
  "182": {
   "jp": "754b17d672",
   "kr": "부디 루게이라는 남자를 찾아 주세요!"
  },
  "183": {
   "jp": "f6d3d2ace9",
   "kr": "그리고 딸을… 코레트를 데려와 주세요!"
  },
  "184": {
   "jp": "754b17d672",
   "kr": "부디 루게이라는 남자를 찾아 주세요!"
  },
  "185": {
   "jp": "f6d3d2ace9",
   "kr": "그리고 딸을… 코레트를 데려와 주세요!"
  },
  "186": {
   "jp": "014aaedb94",
   "kr": "어빈 씨는 훌륭한 분이에요."
  },
  "187": {
   "jp": "d419dcd342",
   "kr": "용기와 힘뿐 아니라 뛰어난 지혜도 가지고 계시군요."
