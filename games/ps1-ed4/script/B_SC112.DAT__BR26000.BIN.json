  "0": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "1": {
   "jp": "5b71fef1a8",
   "kr": "을(를) 손에 넣었다.",
   "auto": 1
  },
  "2": {
   "jp": "9ba9bf3d2b",
   "kr": "어라…?"
  },
  "3": {
   "jp": "005558ad67",
   "kr": "이거, 세이지잖아."
  },
  "4": {
   "jp": "e023d40be5",
   "kr": "알아?"
  },
  "5": {
   "jp": "f321ee900d",
   "kr": "잠깐, 형,"
  },
  "6": {
   "jp": "dc3b597594",
   "kr": "누구한테 하는 소리야."
  },
  "7": {
   "jp": "5c63ce1b98",
   "kr": "미래의 대마법사라고, 나는."
  },
  "8": {
   "jp": "2fa6517281",
   "kr": "환상이니 전설이니 하는 것들도"
  },
  "9": {
   "jp": "08df359b9b",
   "kr": "웬만한 건 다 알아."
  },
  "10": {
   "jp": "0001066386",
   "kr": "세이지는 장수의 약이야."
  },
  "11": {
   "jp": "296e9a34f1",
   "kr": "머리는 맑게, 몸은 개운하게 하는 거지."
  },
  "12": {
   "jp": "58481b2853",
   "kr": "흐음."
  },
  "13": {
   "jp": "80b7ef14a7",
   "kr": "자, 누나가 기다려."
  },
  "14": {
   "jp": "c3b6af427e",
   "kr": "서둘러 가야지!"
  },
  "15": {
   "jp": "889ceea3f2",
   "kr": "보물상자에는 "
  },
  "16": {
   "jp": "665e4d5705",
   "kr": "이(가) 들어 있다.",
   "auto": 1
  },
  "17": {
   "jp": "851d88dca4",
   "kr": "어빈은 소지품이 가득 차서",
   "auto": 1
  },
  "18": {
   "jp": "f5fc3dee34",
   "kr": "을(를) 포기했다.",
   "auto": 1
  },
  "19": {
   "jp": "63c4c357c2",
   "kr": "보물상자에는 아무것도 들어 있지 않다."
  },
  "20": {
   "jp": "c0f4606d07",
   "kr": "어빈!",
   "auto": 1
  },
  "21": {
   "jp": "d2c94d3eb8",
   "kr": "조심해!"
  },
  "22": {
   "jp": "1514929075",
   "kr": "이 마수, 다른 것들과 어딘가 달라."
  },
  "23": {
   "jp": "61ca4259f4",
   "kr": "강렬한 사악한 기운이…!"
  },
  "24": {
   "jp": "d553fc5048",
   "kr": "과연, 이 녀석이 알선소에서 말한 타고스라는 거군."
  },
  "25": {
   "jp": "4d33f263ca",
   "kr": "상대로 부족함이 없다!"
  },
  "26": {
   "jp": "04a29dfdce",
   "kr": "어빈은 "
  },
  "27": {
