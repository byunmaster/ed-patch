  "0": {
   "jp": "fb1fbfb05a",
   "kr": "둘가"
  },
  "1": {
   "jp": "3acc9e2642",
   "kr": "잘"
  },
  "2": {
   "jp": "0224567e7f",
   "kr": "네프티스",
   "auto": 1
  },
  "3": {
   "jp": "c92df98ec4",
   "kr": "이둔",
   "auto": 1
  },
  "4": {
   "jp": "3f21f22a86",
   "kr": "스코티아"
  },
  "5": {
   "jp": "e4a7dc0e45",
   "kr": "…날아가 버렸네."
  },
  "6": {
   "jp": "d8a01a85fa",
   "kr": "자, 우리도 가 볼까."
  },
  "7": {
   "jp": "1f50c5a78c",
   "kr": "정말 추운 곳이네."
  },
  "8": {
   "jp": "45097ffbaa",
   "kr": "둘가 신이 여기를 떠나기 전엔"
  },
  "9": {
   "jp": "aaf3dab1e7",
   "kr": "이 정도는 아니었는데."
  },
  "10": {
   "jp": "ad0f84cfb6",
   "kr": "네 정령이 제정신으로 돌아왔으니"
  },
  "11": {
   "jp": "80e03246a5",
   "kr": "둘가 신도 얼음 신전에 돌아와 있는 거 아닐까?"
  },
  "12": {
   "jp": "0a428d18da",
   "kr": "글쎄. 그렇다면 이 추위가 조금은 가라앉아도"
  },
  "13": {
   "jp": "5050efb269",
   "kr": "좋을 텐데."
  },
  "14": {
   "jp": "385a7114e3",
   "kr": "그것도 그렇네."
  },
  "15": {
   "jp": "95ae68b200",
   "kr": "둘가는 돌아오지 않은 모양이군."
  },
  "16": {
   "jp": "9724798bef",
   "kr": "전에 왔을 때 여기서 둘가 신을 만났다."
  },
  "17": {
   "jp": "5533a122e1",
   "kr": "네 정령의 상태를 보러 간다고 하고"
  },
  "18": {
   "jp": "57f6a2937b",
   "kr": "둘가 신은 여기서 뛰쳐나갔다."
  },
  "19": {
   "jp": "0d9e3dc018",
   "kr": "앗…!?"
  },
  "20": {
   "jp": "d99650166a",
   "kr": "네 정령…?"
  },
  "21": {
   "jp": "aa5365f7f9",
   "kr": "둘가는 없다…"
  },
  "22": {
   "jp": "04e3d25afe",
   "kr": "우리가 이곳에 왔을 때부터 없었다…"
  },
  "23": {
   "jp": "2958eb02bb",
   "kr": "너에게 신보를 맡겼다…"
  },
  "24": {
   "jp": "eff8e966ab",
   "kr": "들여다보아라…"
  },
  "25": {
   "jp": "1fc3af20f6",
   "kr": "명계를 관장하는 우리 정령의 힘으로…"
  }
 }
}
