{
 "archive": "/C/SC200.DAT",
 "member": "..\\BIN\\CT02200C.BIN",
 "segments": {
  "0": {
   "jp": "bd66d02258",
   "kr": "루크레프는 아직 25세지만"
  },
  "1": {
   "jp": "856a4a0240",
   "kr": "기아에서도 첫째 둘째를 다투는 솜씨 좋은 열쇠 장인이야."
  },
  "2": {
   "jp": "8b738383fe",
   "kr": "성격도 성실하고 신혼 초라"
  },
  "3": {
   "jp": "5160048440",
   "kr": "그야말로 행복의 절정이었는데…"
  },
  "4": {
   "jp": "c4c051da6a",
   "kr": "어째서인지 갑자기 모습을 감춰 버렸어."
  },
  "5": {
   "jp": "c8e185551c",
   "kr": "새댁 메리안은 날마다 울며 지내고 있어."
  },
  "6": {
   "jp": "604e6711ad",
   "kr": "메리안을 위해서라도 이 일은 꼭 맡아 줬으면 해."
  },
  "7": {
   "jp": "32dddc4128",
   "kr": "무기점 안주인의 의뢰야."
  },
  "8": {
   "jp": "fca0be8429",
   "kr": "간단한 일 같으니 한가하면 해 보면 어때?"
  },
  "9": {
   "jp": "04367e7342",
   "kr": "자세한 건 안주인에게 직접 물어봐."
  },
  "10": {
   "jp": "5e76c9c339",
   "kr": "별것 아닌 짐 나르는 일이야."
  },
  "11": {
   "jp": "a98b29df90",
   "kr": "자세한 건 지작 씨에게 가 봐."
  },
  "12": {
   "jp": "e866f6df4d",
   "kr": "지작 씨는 이 여관 옆"
  },
  "13": {
   "jp": "a97b3974e5",
   "kr": "곤트 씨 댁에 하숙하고 있어."
  },
  "14": {
   "jp": "4f6afc4261",
   "kr": "뉴보른까지 편지를 전하는 일이야."
  },
  "15": {
   "jp": "32ff9b1417",
   "kr": "자세한 건 크레라에게 물어봐."
  },
  "16": {
   "jp": "6e95143a6a",
   "kr": "크레라는 마을 입구 근처 집에 있어요."
  },
  "17": {
   "jp": "817bd941ab",
   "kr": "바로아까지 편지를 전해 주세요."
  },
  "18": {
   "jp": "c1eee93d9e",
   "kr": "편지를 나르기만 하면 돼요."
  },
  "19": {
   "jp": "7aacf56aa9",
   "kr": "초원의 몬스터만 조심하면"
  },
  "20": {
   "jp": "a0087aa216",
   "kr": "위험 없는 일이죠."
  },
  "21": {
   "jp": "982103c690",
   "kr": "자세한 건 마르세 씨에게 물어보세요."
  },
  "22": {
   "jp": "d0429faff8",
   "kr": "지금쯤 아마"
  },
  "23": {
   "jp": "df73e43987",
   "kr": "주택가 근처를 산책하고 있지 않을까."
  },
  "24": {
   "jp": "ba27c37c5c",
   "kr": "작은 짐을 나르기만 하는 간단한 일이야."
  },
  "25": {
   "jp": "67194b460e",
   "kr": "짐에 대해서는 챕 씨에게 물어보세요."
  },
  "26": {
   "jp": "a81434d773",
   "kr": "챕 씨는 마을 제일 동쪽 집에 살고 있어."
  },
  "27": {
   "jp": "69705d517c",
   "kr": "짐을 나르기만 하는 간단한 일이에요."
  },
  "28": {
   "jp": "f25a932178",
   "kr": "짐에 대해서는 헤임 씨에게 물어보세요."
  },
  "29": {
   "jp": "0ee69a871c",
   "kr": "헤임 씨는 일기 쓰는 게 취미인"
  },
  "30": {
   "jp": "ad40da8d7a",
   "kr": "성실한 사람이야."
  },
  "31": {
   "jp": "f21c6eac9e",
   "kr": "주택가 한가운데쯤 있는 집에 살고 있어."
  },
  "32": {
   "jp": "96ee655fa5",
   "kr": "샴실단과 연줄이 있는 기술자가"
  },
  "33": {
   "jp": "ffd90784ca",
   "kr": "루마 동굴에서 뭔가 연구를 하는 모양이야."
  },
  "34": {
   "jp": "9e3dbd56cd",
   "kr": "샴실단의 음모를 알아내기 위해서도"
  },
  "35": {
   "jp": "525db4af17",
   "kr": "기술자를 체포해 주셨으면 해요."
  },
  "36": {
   "jp": "0deddfa811",
   "kr": "이미 니플과 네페레라는 두 모험가가"
  },
  "37": {
   "jp": "cf973fbd8f",
   "kr": "루마 동굴로 향했어요."
  },
  "38": {
   "jp": "f1e5c07ecd",
   "kr": "이 두 사람과 협력해서 일해 주세요."
  },
  "39": {
   "jp": "f5490da789",
   "kr": "마타 광산의 관리관에게서"
  },
  "40": {
   "jp": "f7c6636833",
   "kr": "샴실단 같은 무리가"
  },
  "41": {
   "jp": "2e87982f92",
   "kr": "광산에 들어갔다는 연락이 왔어요."
  },
  "42": {
   "jp": "c6022ab048",
   "kr": "최근 샴실단의 활동이 눈에 띄어요."
  },
  "43": {
   "jp": "0390560693",
   "kr": "그들이 광산에서 무엇을 하려는지"
  },
  "44": {
   "jp": "21f5ed5e5f",
   "kr": "조사해 주셨으면 해요."
  },
  "45": {
   "jp": "ba1fe29364",
   "kr": "일의 내용은 간단명료해요."
  },
  "46": {
   "jp": "fef0188cd2",
   "kr": "골다 동굴의 마수를 모두 퇴치해 줬으면 해."
  },
  "47": {
   "jp": "ac71d12f38",
   "kr": "실력에 자신이 있다면"
  },
  "48": {
   "jp": "24a6419bb8",
   "kr": "꼭 도전해 줬으면 하네."
  },
  "49": {
   "jp": "a71d17581c",
   "kr": "어떻게 설명하면 좋을까."
  },
  "50": {
   "jp": "e17eb31d27",
   "kr": "여기 적힌 대로 더글라스라는 사람을 찾고 있어."
  },
  "51": {
   "jp": "5ad8b04890",
   "kr": "아주 개인적인 용건이라"
  },
  "52": {
   "jp": "6eb5bf44b1",
   "kr": "알선소 게시도 되도록 줄여 달라고 하셨어요."
  },
  "53": {
   "jp": "fa08ea2a32",
   "kr": "그래서 의뢰인의 이름도 밝힐 수 없어."
  },
  "54": {
   "jp": "676b25ef03",
   "kr": "더글라스 씨를"
  },
  "55": {
   "jp": "ec35d7c452",
   "kr": "기아 서쪽에 있는 사냥꾼 오두막으로 데려와 달라는"
  },
  "56": {
   "jp": "4394d57906",
   "kr": "것뿐이에요."
  },
  "57": {
   "jp": "ab33183273",
   "kr": "도리아 씨는 마법대학교에서"
  },
  "58": {
   "jp": "8966705738",
   "kr": "교편을 잡았는데, 교수를 은퇴하고"
  },
  "59": {
   "jp": "a59c50d603",
   "kr": "연구직에 들어가셨어요."
  },
  "60": {
   "jp": "4f664594ce",
   "kr": "그래서 폭넓은 지식을 얻기 위해"
  },
  "61": {
   "jp": "03327fe2dc",
   "kr": "여러 체험을 해 온 사람들에게"
  },
  "62": {
   "jp": "df19d5e2e7",
   "kr": "이야기를 듣고 싶다고 해요."
  },
  "63": {
   "jp": "ead3ff9824",
   "kr": "이야기가 재미있으면 규정 보수 외에"
  },
  "64": {
   "jp": "8b6e58885e",
   "kr": "보너스도 받을 수 있대."
  },
  "65": {
   "jp": "ff4df511fd",
   "kr": "말솜씨 좋은 사람에게 추천하는 일이에요."
  },
  "66": {
   "jp": "f5e56164a3",
   "kr": "바딘 동굴에"
  },
  "67": {
   "jp": "266dc7cc66",
   "kr": "무시무시한 마수가 자리 잡고 있어요."
  },
  "68": {
   "jp": "9ea33a13f4",
   "kr": "글쎄, 모습이 보이지 않는 마수야."
  },
  "69": {
   "jp": "11aeeb1376",
   "kr": "내버려 두면 번식해서"
  },
  "70": {
   "jp": "2cdbaae1bd",
   "kr": "돌이킬 수 없는 일이 될 거야."
  },
  "71": {
   "jp": "9603ac9a98",
   "kr": "바딘 동굴에 틀어박혀 있는 동안에"
  },
  "72": {
   "jp": "a53ac75685",
   "kr": "어떻게든 하고 싶어."
  },
  "73": {
   "jp": "59aa92622d",
   "kr": "마타 광산 관리관이 조수를 모집하고 있어."
  },
  "74": {
   "jp": "1e6b6d44d0",
   "kr": "마수가 조금 나오지만"
  },
  "75": {
   "jp": "0baace2c53",
   "kr": "그리 위험한 곳은 아니니"
  },
  "76": {
   "jp": "e2569eb59a",
   "kr": "가볍게 맡아 보면 어때?"
  },
  "77": {
   "jp": "a7a4fabb6f",
   "kr": "규정 의뢰는 레어메탈을 발견해서"
  },
  "78": {
   "jp": "150a148fde",
   "kr": "의뢰인인 도리아 교수에게 건네는 거예요."
  },
  "79": {
   "jp": "29762ca61f",
   "kr": "레어메탈은 좀처럼 발견되지 않는 금속이지만"
  },
  "80": {
   "jp": "2b98a87aa9",
   "kr": "결코 없는 건 아니에요."
  },
  "81": {
   "jp": "201e77b73e",
   "kr": "마수가 나오는 기아 광산 안쪽까지 가면"
  },
  "82": {
   "jp": "d0504a5d91",
   "kr": "분명 찾을 수 있을 거예요."
  },
  "83": {
   "jp": "7d256658b6",
   "kr": "마법대학교의 도리아 교수에게 가면"
  },
  "84": {
   "jp": "6d666d9731",
   "kr": "자세한 이야기를 들을 수 있어요."
  },
  "85": {
   "jp": "d08139cf7b",
   "kr": "노라 씨는 이미 꽤 연세가 많지만"
  },
  "86": {
   "jp": "d2ea34d2d1",
   "kr": "아주 꿋꿋한 분이야."
  },
  "87": {
   "jp": "8150bb7cbc",
   "kr": "남편 카스톨 씨를 여의고"
  },
  "88": {
   "jp": "25e65dcbd9",
   "kr": "코르나 마을에서 쭉 혼자 살아 왔어요."
  },
  "89": {
   "jp": "d8e59cff35",
   "kr": "그런데 최근 코르나 마을에 큰 한파가 덮쳤잖아요?"
  },
  "90": {
   "jp": "78f59e3b60",
   "kr": "눈에 갇힌 산골 마을은 노인에게 너무 힘들어."
  },
  "91": {
   "jp": "d5ad932d62",
   "kr": "아들 맥스 씨는 어머니를 기아로 불러"
  },
  "92": {
   "jp": "52195fd46f",
   "kr": "함께 살자고 권했어."
  },
  "93": {
   "jp": "719af53f6c",
   "kr": "그런데 노라 씨는"
  },
  "94": {
   "jp": "7b1e881d82",
   "kr": "카스톨 씨와 살던 코르나를 떠나기 싫다며"
  },
  "95": {
   "jp": "98f4ef2d0d",
   "kr": "완고하게 고집하고 있어요."
  },
  "96": {
   "jp": "6d2f61453b",
   "kr": "맥스 씨는"
  },
  "97": {
   "jp": "ef774a10ea",
   "kr": "어떻게든 설득해 줄 사람을 찾고 있어요."
  },
  "98": {
   "jp": "8e89badd7a",
   "kr": "의뢰인은 와곤 아저씨예요."
  },
  "99": {
   "jp": "66ef739c2d",
   "kr": "뉴보른 방면에서 오는 입구에서 가장 가까운 집에"
  },
  "100": {
   "jp": "a5ca533d1f",
   "kr": "살고 있어."
  },
  "101": {
   "jp": "b17b37dd20",
   "kr": "오랫동안 만나지 못한 조카들이 찾아오는데"
  },
  "102": {
   "jp": "1eba368f45",
   "kr": "헤매지 않도록 집까지 데려와 줬으면 한대요."
  },
  "103": {
   "jp": "f939ca1515",
   "kr": "와곤 아저씨에게 물어보면"
  },
  "104": {
   "jp": "97baf51d52",
   "kr": "자세한 걸 말해 준대요."
  },
  "105": {
   "jp": "7fb695becb",
   "kr": "사냥꾼 렌드 씨는 사냥에 빠지면"
  },
  "106": {
   "jp": "196aac1f10",
   "kr": "며칠이고 돌아오지 않는대요."
  },
  "107": {
   "jp": "d516ec2772",
   "kr": "지금도 벨우드에 들어간 채"
  },
  "108": {
   "jp": "c4542be59f",
   "kr": "돌아오지 않는 바람에 부인이 펄펄 뛰어서"
  },
  "109": {
   "jp": "7841a313f5",
   "kr": "빨리 돌아오라고 전해 달라는군요."
  },
  "110": {
   "jp": "0fa4b4a196",
   "kr": "벨우드는 코르나로 가는 도중의"
  },
  "111": {
   "jp": "f76320dacd",
   "kr": "갈림길에서 갈 수 있어."
  },
  "112": {
   "jp": "ba53488d0c",
   "kr": "가든힐 남쪽의 스콜파 동굴에"
  },
  "113": {
   "jp": "3cc938264c",
   "kr": "상당한 수의 마수가 자리 잡고 있어요."
  },
  "114": {
   "jp": "3c2a1372bd",
   "kr": "더 이상 수가 늘기 전에"
  },
  "115": {
   "jp": "f7f1c8db7f",
   "kr": "어떻게든 해 두고 싶어."
  },
  "116": {
   "jp": "cf2c9bebd1",
   "kr": "마타 광산에서 사건이 있었나 봐."
  },
  "117": {
   "jp": "13831cc521",
   "kr": "사건에 관해 자세한 건"
  },
  "118": {
   "jp": "9466c23cb9",
   "kr": "전혀 알려지지 않았어요."
  },
  "119": {
   "jp": "868f677077",
   "kr": "광산 입구에 관리관이 있어요."
  },
  "120": {
   "jp": "0f22d4bb3a",
   "kr": "관리관의 지시에 따라 사건을 해결해 주세요."
  },
  "121": {
   "jp": "16f59460f5",
   "kr": "사냥꾼 라구 씨는 숲속에 들어가"
  },
  "122": {
   "jp": "bdd0b7713b",
   "kr": "들새를 잡고 있는데"
  },
  "123": {
   "jp": "87cd0420e6",
   "kr": "애용하던 도끼가 망가졌나 봐."
  },
  "124": {
   "jp": "82b7bbf27d",
   "kr": "그래서 "
  },
  "125": {
   "jp": "012751c72c",
   "kr": "을(를) 한 자루"
  },
  "126": {
   "jp": "c6a40129cf",
   "kr": "사냥꾼 오두막까지 가져다줬으면 한대요."
  },
  "127": {
   "jp": "07f620a699",
   "kr": "은(는) 쓸 수만 있다면"
  },
  "128": {
   "jp": "154ad46c01",
   "kr": "중고라도 상관없대."
  },
  "129": {
   "jp": "0f25a17155",
   "kr": "바딘 동굴로 이어지는 바딘 산길에"
  },
  "130": {
   "jp": "ae084eb08f",
   "kr": "산적이 출몰하는 모양이야."
  },
  "131": {
   "jp": "c9b5ff3197",
   "kr": "그래서 약초를 캐러 온 사람이나"
  },
  "132": {
   "jp": "1f5c6687d9",
   "kr": "나그네에게 통행료라며"
  },
  "133": {
   "jp": "3857d10fb9",
   "kr": "금품을 빼앗고 있나 봐."
  },
  "134": {
   "jp": "0d3c35622f",
   "kr": "그런 불법 행위는"
  },
  "135": {
   "jp": "79deadd555",
   "kr": "한시라도 빨리 그만두게 해야 해."
  }
 }
}
