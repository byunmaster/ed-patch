{
 "0": "테그라 탄광",
 "1": "광부 시라프",
 "2": "광부 보리",
 "3": "광부 아일",
 "4": "광부 테드",
 "5": "광부 자일",
 "6": "광부 로브",
 "7": "소리",
 "8": "광부 모크",
 "9": "이런...?\f애가 이런 안쪽까지 들어오면\n위험하다.\n방해되니까, 저쪽으로 가라.",
 "10": "엇?\n케빈 영감이 부탁했다고.\f영감도 애한테 무리한 걸 시키는군.\f로디가 있으면\n이런 걸 시키지 않을 텐데.",
 "11": "로디?",
 "12": "케빈 할아버지의 손자야.\f아까 말했잖아.",
 "13": "승강기는 옆 갱도다.\n조심해서 가거라.",
 "14": "아까 지진이 있었는데,\n너희 괜찮았니?",
 "15": "토사 붕괴로 출구가 막혔는데,\n광부분들이 도와줬어요.",
 "16": "그랬구나,\n무사해서 다행이다.\f이제, 볼일은 끝났니?",
 "17": "응.",
 "18": "그럼, 조심해서 돌아가렴.",
 "19": "조심해서 돌아가렴.",
 "20": "이 탄광에서 나는 건 거의 이탄이지만 조금은 석탄도 있단다.\f자연의 은혜란 고마운 거야.",
 "21": "이탄 늪은\n여기서 서쪽으로 간 곳이다.",
 "22": "딴 데 들르지 마라, 헤맨다.",
 "23": "뭐야, 돌아간 게 아니었나?",
 "24": "그게...저기...",
 "25": "말하기 어려운데.",
 "26": "뭐야,\n사양 말고 말해 봐라.",
 "27": "우리, 다들 생매장이\n돼 버렸어요.",
 "28": "폭발 충격으로\n다른 데가 묻혀 버렸어요.",
 "29": "에엣!?\n뭐라, 고오!",
 "30": "어〜이!\n테드, 아일, 큰일이다!",
 "31": "뭐야, 얼굴이 새파래져서.",
 "32": "무슨 일 있었나?",
 "33": "출구가 묻혀 버렸다.",
 "34": "뭐라고오!?",
 "35": "정말이냐?!",
 "36": "어쨌든, 현장에 가 보자.",
 "37": "분명 새 샛길이\n나올 거다.",
 "38": "길 따라 북쪽으로 가서,\n광차가 보이면\f왼쪽으로 꺾어라.\n오른쪽으로 가면,\n또 이탄 늪으로 돌아간다.",
 "39": "다치지 않아 다행이구나.",
 "40": "꼼꼼히,\n벽을 살펴 갈 수밖에 없군.",
 "41": "여기에 승강기를 만들면\n편해지겠군.\f정말, 좋은 자리를 찾았어.\n이걸로 작업도 잘 풀리겠지.",
 "42": "조심해서 돌아가라.",
 "43": "어떻게든 될 거야.\f그래도, 하나쯤 더\n커다란 진홍의 불꽃이\n있었으면 좋았을 텐데.\f그러고 보니, 요전까지\n너무 커진 진홍의 불꽃이\n두 개 있었는데,\f하나는 어디로 갔을까.",
 "44": "안 된다니까요, 그런 작전.\f그런 짓 하면,\n또 다른 데가 묻혀요.",
 "45": "응, 그랬지.",
 "46": "조심해서 돌아가라.",
 "47": "어라?　너희들,\f아까, 로브 녀석한테\n놀랐지.\f비명이 여기까지 들렸다.\f손님이 오면,\n놀래는 게 취미거든.\f나쁘게 생각 말아라.",
 "48": "아래로 갈 거면,\n서쪽 승강기를 쓰거라.",
 "49": "아까 지진은 컸구나.",
 "50": "뭐?\n그러냐, 그거 재난이었구나.\f그래도, 나중엔 웃음거리가 될 거다.",
 "51": "앗!!",
 "52": "이럴 수가...",
 "53": "분명,\f우리가 폭발시킨 충격으로\n새로 무너진 거야...",
 "54": "돌아가서 광부분들께 알리자.",
 "55": "으갸아아아아아아!!",
 "56": "꺄앗!?",
 "57": "으와와와...!?",
 "58": "이봐 이봐, 농담이다, 농담.\n너무 놀라잖아.\f난 여기 광부인 로브다.",
 "59": "엇?",
 "60": "깜짝 놀랐네...",
 "61": "이야, 미안 미안.\f너무 무서워하는 것 같아서,\n서비스할 셈이었다.",
 "62": "그, 그렇군요..",
 "63": "정말!\n놀래지 마세요.",
 "64": "하하하하하...\n미안, 미안.\f그런데 탄광에 무슨 볼일이니?",
 "65": "케빈 영감님 부탁으로,\n이탄 늪에 보석을 가지러 왔어요.",
 "66": "허어,\n그랬구나.\f수고가 많다.\f케빈 영감의 보석은\n최고니까.\f뭐, 조심해서 가라.\f그럼.",
 "67": "조심해서 가라, 라니.",
 "68": "아직, 저런 사람이 있으려나.",
 "69": "어〜이!\n거기 있는 거냐아!",
 "70": "해냈다, 도우러 와 줬어.\f",
 "71": "응, 여기 있어요!",
 "72": "다치진 않았나?",
 "73": "괜찮으냐!",
 "74": "안 다쳤어요. 괜찮아요.\f",
 "75": "그래도, 통로가 무너져서\n못 나가요.\f다른 출구는 없나요?",
 "76": "다른 출구라...",
 "77": "응, 다른 출구를 알려 줘요.",
 "78": "으음, 다른 출구는 ",
 "79": ".......\f",
 "80": "없다!",
 "81": "에엣?!",
 "82": "그렇게 딱 잘라 말하지\n않아도 되잖아...",
 "83": "미안, 미안.\n뭐, 일을 그리 비관적으로 보지\n마라.\f탈출 방법은 아직 있으니까.",
 "84": "어떻게 하면 돼요?",
 "85": "응, 잠깐 기다려라.\n지금, 이쪽에서 의논해 볼 테니.",
 "86": "뭐야...\n아직, 생각도 안 했잖아.\f정말 괜찮은 걸까.",
 "87": "이렇게 요란하게 무너졌으면,\n아무리 우리가\f셋이 달려들어 파도,\n며칠은 걸린다.",
 "88": "으음, 그렇군.\f위에서 지원을 불러도\f여럿이 한꺼번에\n작업할 넓이도 없고.",
 "89": "좀 위험하지만,\n그 수로 해 버릴까?",
 "90": "그 수인가...\f그래도, 그 방법은 뭐가 일어날지\n모르니까 말이야.",
 "91": "그래도 뭐, 손쉽게 끝난다면, 그 수지.",
 "92": "좋아, 그 수로 가 볼까.",
 "93": "그럴까.",
 "94": "응, 정해졌다.",
 "95": "어〜이, 지금부터 방법을 말한다!\n잘 들어 다오.",
 "96": "아까부터 계속 듣고 있는데요.\f아저씨들, 혹시\n꽤 위험한 일을\n시키려는 거 아니에요?",
 "97": "어?　듣고 있었나.\f괜찮다니까.\f이탄 늪은, 꽤 넓으니까,\n피할 곳은 많다.\f걱정 없어.\f이탄 늪 안에,\f너무 커져 버린\n진홍의 불꽃이 있었지.\f그게 폭탄 대신 쓸 수 있다.",
 "98": "그런 거 아닐까 했어요.",
 "99": "그걸로, 날려 버리는 거네.",
 "100": "그렇지.\n감이 좋구나 꼬마.",
 "101": "거기까지 들으면,\n누구라도 알아요.",
 "102": "그러니까,\n커다란 진홍의 불꽃을 찾아 와서,\f이 토사에 부딪히면 된다.\f그래, 간단하지.",
 "103": "옮길 땐 조심해라.\n부디 떨어뜨리지 않도록.\f떨어뜨리면,\n그 자리에서 콰앙! 이다.",
 "104": "그런..",
 "105": "그치만, 부딪히는 건 되는데,\n바로 폭발하는 거죠?\f우리도 폭발하잖아요.",
 "106": "멀리서 던지면 되잖아.",
 "107": "그렇게 커다란 거,\n그리 멀리 안 날아가.",
 "108": "굴리면 되는 거다.\f",
 "109": "그 정도 충격이면 폭발 안 한다.\f데굴데굴, 콰앙!\n하는 느낌이지.",
 "110": "쉽게 말씀하시는데,\f정말 그리 잘될까요.",
 "111": "알았지.\n자, 진홍의 불꽃을 가져와라.\f알겠나,\n굴리기 전에는 한마디 해라.\f우리도\n피해야 하니까.\f알겠지.",
 "112": "응, 알았어.",
 "113": "앗, 늪이다.",
 "114": "여기가 진흙 늪이네.\n엄청 넓네.",
 "115": "어라, 너희들은?\f애들끼리 들어오다니 드물군.\n무슨 볼일이니.",
 "116": "용케, 여기까지 왔구나.",
 "117": "저희 케빈 할아버지 부탁으로, 늪에 가라앉힌 보석을 가지러 왔어요.\f여기가 이탄 늪 맞죠?",
 "118": "아아, 그렇단다.\f알겠다,\n로디 대신을\n부탁받았구나.\f진홍의 불꽃을 가지러 왔나.\f",
 "119": "그래도, 보다시피 넓으니까,\n이 안에서 보석을 찾긴 힘들다.",
 "120": "그래도, 약속했는걸요.\n찾아야 해요.",
 "121": "너무 커져 버린 보석에는\n손대지 않는 게 좋다.\f폭발할지도 모르니까.\f그럼, 난 돌아갈까.\n조심해서 찾아라.",
 "122": "자, 쥬리오. 찾아보자.",
 "123": "응.",
 "124": "어둡네.",
 "125": "응.",
 "126": "쥬리오,\n무서운 거지?",
 "127": "그런 거 아니야.",
 "128": "뻥.",
 "129": "정말이라니까.",
 "130": "이거, 뭘까.",
 "131": "승강기야. 분명.",
 "132": "이게 승강기려나.",
 "133": "타 보자.",
 "134": "크리스, 봐!\f천장에서 모래가 흐르고 있어.\n재밌네.",
 "135": "동굴 천장에서, 먼지처럼\n고운 모래가 흘러내리고 있다.",
 "136": "무슨 소리야.\n큰일이잖아!\f여기도 분명 무너져.",
 "137": "일단,\n아저씨들한테\f알리는 게 좋겠어.",
 "138": "봐, 쥬리오.\n저기 천장에서 모래가 흘러.",
 "139": "동굴 천장에서, 먼지처럼\n고운 모래가 흘러내리고 있다.",
 "140": "위험해.\f여기도 무너지는 거\n아닐까.",
 "141": "일단,\n아저씨들한테\f알리는 게 좋겠어.",
 "142": "커다란 진홍의 불꽃이 있다!",
 "143": "쥬리오 일행은\n손대지 않게 조심했다.",
 "144": "이거네, 폭발하는 거.",
 "145": "폭발하면 큰일이야.\n얼른 떨어지는 게 좋아...",
 "146": "그러네.\n살〜짝 떨어지자.",
 "147": "커다란 진홍의 불꽃이 있다!",
 "148": "쥬리오는 이탄 속에서\n천천히 진홍의 불꽃을 집어 들었다.",
 "149": "쥬리오, 떨어뜨리지 마...",
 "150": "응, 알고 있어.",
 "151": "쥬리오는 진홍의 불꽃을 얻었다.",
 "152": "아, 이건가?",
 "153": "우와...\n이게 진홍의 불꽃이구나.\f무척 예쁘다.",
 "154": "쥬리오는 진홍의 불꽃을 얻었다.",
 "155": "보석은 전부 세 개 가라앉혔다고\n케빈 할아버지가 말했지.\f앞으로 두 개 있을 거야.",
 "156": "이걸로 전부네.",
 "157": "응, 테그라 마을로 돌아가자.",
 "158": "쥬리오는 진홍의 불꽃을 얻었다.",
 "159": "쥬리오는 진홍의 불꽃을 얻었다.",
 "160": "무너진 돌과 바위로 통로는\n빽빽이 막혀 버렸다!\f토사 때문에\n출구가 막혀 버려,\n더는 나아갈 수 없다.",
 "161": "쥬리오 일행의 힘으로는\n어찌할 수 없을 듯하다.",
 "162": "저기, 아저씨들!\n진홍의 불꽃을 가져왔어요.\f뒤로 물러나 있어요!",
 "163": "오, 가져왔냐!\n지금 물러난다.\f잠깐 기다려라.",
 "164": "준비 됐다!",
 "165": "길을 벗어나지 마라!",
 "166": "응, 굴릴게요.",
 "167": "좋아, 굴려라아!",
 "168": "간다 크리스.",
 "169": "좋아.",
 "170": "해냈다!\n잘된 모양이야.",
 "171": "어〜이, 괜찮으냐!",
 "172": "고마워요, 살았어요.",
 "173": "잘돼서 다행이구나.",
 "174": "굉장한 폭발이었군.\n괜찮으냐?",
 "175": "응.",
 "176": "자, 이제 너희 볼일은\n끝났지?\f아무래도 가루가 탓에\f지반이 느슨해져\n버린 모양이니까.\f또, 무너지면 큰일이다.\f우리는 좀 이 근방을\n둘러보고 돌아갈 테니\f너희는, 먼저 여기서\n나가는 게 좋다.",
 "177": "무슨 일이야?",
 "178": "어, 아아, 기분 탓이려나.\f누가 있는 것 같은데.",
 "179": "또, 로브 같은 사람이려나.",
 "180": "큰 쥐야.",
 "181": "후우, 깜짝 놀랐다.\f안쪽에 뭔가 있어.",
 "182": "가 보자.",
 "183": "갈림길이네.",
 "184": "어디로 갈래? 쥬리오.",
 "185": "마수 없는 쪽이 좋겠어.",
 "186": "그런 건 가 보지 않으면\n모르잖아!",
 "187": "어느 쪽이든 같은 모양...",
 "188": "안은 위험한 데도 있으니,\n조심해서 가거라.",
 "189": "뭐?\f그러냐,\n살펴볼까.",
 "190": "정말이다.\n모래가 흘러.",
 "191": "아저씨,\n이 천장도 무너지는 거 아녜요?\f너무 가까이 가면 위험해요.",
 "192": "아니, 괜찮을 거다.\f이 모래 흐르는 모양은\n무너질 조짐이 아냐.",
 "193": "자연히 구멍이 생겨\n가는 때의 것이지.",
 "194": "앗, 그런가!\n이건 살았을지도 모르겠구나.",
 "195": "정말요?",
 "196": "잠깐 천장을 만져 보면\n금방 안다.\f내 감이지만, 이 자리 위는, 분명 내가 파던 언저리라고\n생각한다.",
 "197": "과연.\f네 굴이 이어져 있다면, 여기를 오르면 위층으로 갈 수 있다.",
 "198": "꼬마, 나무 잘 타냐?",
 "199": "엇?\n나무 타기라면 크리스가 더 잘해요.",
 "200": "좋아. 그럼, 아가씨.\f우리가 목말을 태울 테니,\n올라가서 천장을 좀 살펴봐 다오.",
 "201": "엇?　제가...",
 "202": "오를 놈은 가볍지 않으면\n못 받치니까.",
 "203": "어쩔 수 없네요, 정말.",
 "204": "자, 목말을 짤 테다.\n꼬마가 맨 위다.\f목말, 시작!",
 "205": "좋아, 됐다.\n아가씨, 올라와 다오.",
 "206": "응.",
 "207": "앗, 보인다.",
 "208": "엇?",
 "209": "아니, 아무것도 아냐.",
 "210": ".....\n엿보면 안 돼.",
 "211": "됐으니까, 얼른 천장을 살펴봐.\n무겁단 말이다...",
 "212": "엿보면 안 되니까.",
 "213": "으응... 알고 있어.",
 "214": "아가씨, 됐나.\n천장을 가볍게 두드려 봐 다오.",
 "215": "크리스는 동굴 천장을\n가볍게 두드렸다.",
 "216": "크리스가 동굴 천장을 가볍게 두드리자, 쏟아지듯 모래가\f스르르 흘러,\n천장에 뻥 하고 구멍이 뚫렸다.",
 "217": "구멍, 구멍이 뚫렸어!",
 "218": "모래투성이야.",
 "219": "역시 그렇군.\n아가씨 올라갈 수 있겠나?",
 "220": "응, 해 볼게요.\n영차.",
 "221": "아저씨들, 들려요!\n위로 올라왔어요.\f지금, 밧줄을 내릴게요오!",
 "222": "오, 들린다아.\n부탁한다아!",
 "223": "살았다.",
 "224": "이걸로 빠져나간다.",
 "225": "자, 얼른 오르자.",
 "226": "이거 심하군.",
 "227": "정말로 전원 생매장이다.",
 "228": "이래선,\n도저히 손댈 수 없다.\f...그렇지!　\f폭발 충격으로 무너졌다면,\f새 샛구멍도\n생겼을지 모른다.\f나눠서 찾아볼까.\f멍하니 있는 것보단 낫다.",
 "229": "그렇군, 그럴까.",
 "230": "이야, 어떻게든 살았구나.",
 "231": "뭐야, 역시 여기는\n내가 파던 곳이다.",
 "232": "탄광이란 건 너무 파면,\n어디가 어떻게 이어지는지\f알 수 없으니까.\f그래도 우리는 운이 좋았어.",
 "233": "아저씨들이 있어 줘서,\n정말 살았어요.",
 "234": "뭘, 서로 마찬가지다.\f우리도\n아가씨들이 없었으면\n못 살아났다.\f그럼, 조심해서 돌아가라.\f이제 이 층이면 괜찮을 거라 보지만 조심하는 게 좋으니까.",
 "235": "크리스〜,\n이제 녹초야.",
 "236": "약한 소리 하면 안 돼.",
 "237": "크리스〜,\n이제 못 하겠어...",
 "238": "힘 좀 내.\n「울보 쥬리오」라고\n불려도 괜찮아?",
 "239": "그런〜.",
 "240": "어라?\n크리스?",
 "241": "헉헉,\n좀 지쳤어.",
 "242": "이제, 못 하겠어...",
 "243": "알고 있다니까.\n잠깐 기다려.",
 "244": "크리스〜\n힐 좀 걸어 줘.",
 "245": "크리스, 고마워〜.",
 "246": "크리스〜, 왜\n힐 안 걸어 주는 거야.",
 "247": "그런 소리 해도\n마력이 얼마 안 남았어.",
 "248": "에〜, 그런〜.",
 "249": "끝까지 포기하지 말고\n힘내는 거야!",
 "250": "그런 소리 해도\n나도 녹초라고.",
 "251": "다음 차례엔\n걸어 줄게.",
