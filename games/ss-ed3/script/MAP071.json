{
 "0": "천의실",
 "1": "브리트 대장",
 "2": "폴티아 병사",
 "3": "루돌프 왕",
 "4": "시녀",
 "5": "그레리",
 "6": "와일드캣단",
 "7": "알프레드",
 "8": "두건 남자",
 "9": "산적들",
 "10": "아페고",
 "11": "그네스",
 "12": "누라",
 "13": "콘타",
 "14": "레바스소리",
 "15": "허크소리",
 "16": "구스소리",
 "17": "듀르젤 씨.",
 "18": "이 일이 잘 끝나면\n부탁이 있어.\f들어주겠어?",
 "19": "아아\n네가 살아 있으면 들어주지.",
 "20": "그럼, 살아 있지.",
 "21": "자, 왕비를 찾아내서\n어서 결판을 내자고.",
 "22": "그 왕비를 먼저 찾아야 하네.",
 "23": "일각의 유예도 없습니다.",
 "24": "난 정했어.",
 "25": "나중에 루돌프 왕에게\n포상금을 청구해야지.",
 "26": "3000만 피아쯤은 받지 않으면\n수지가 안 맞는다고.",
 "27": "정말이지\n너희랑 같이 있으면\n재난뿐이라니까.",
 "28": "왕비는 어디선가\n라우알의 파도를 부르는 술을\n계속하고 있겠지.",
 "29": "어쨌든\n그걸 멈추게 하지 않고서는...",
 "30": "하늘 색이\n꽤 수상하게 변해 가는군.",
 "31": "이대로는, 위험하겠는데.",
 "32": "왜 그래, 무섭나?",
 "33": "후후후후후...",
 "34": "봐라, 이 천구의를.",
 "35": "어떤가.",
 "36": "이, 확실한 고동...",
 "37": "무수한 상념을 흡수한 천구의는\n이제 물체이면서 생명을 얻어,\f최고조까지 성장했다.",
 "38": "늦었군.\f이제 와서, 내가 손댈 필요도 없다.\n의식은 모두 끝났다.",
 "39": "이제 라우알의 파도가\n이 세계에 나타나길 기다릴 뿐이다.",
 "40": "그런...",
 "41": "어째서, 이런 짓을...",
 "42": "영문도 모른 채,\f멸망해 가는 세계와 함께\n사라지는 것도 흥이겠지...",
 "43": "여기까지 온 노력에 경의를 표해\n알려 주지.",
 "44": ".........",
 "45": "너희가 이계라 부르는\n우리 세계를 구하기 위해서다.",
 "46": "마녀의 바다에 뜬 마녀의 섬.\f너희는 그리 여기지만, 현실은 조금\n다르다.",
 "47": "거기에 섬은 없고\n있는 건 공간의 『뒤틀림』이다.",
 "48": "그곳에서 두 세계는 이어져,\f이 세계와 이계의 왕래를\n유일하게 가능케 하고 있는 것이다.",
 "49": "이계에도\n이 세계와 똑같이 인간이 살고,\f사람들의 삶이 있다.",
 "50": "그 사람들의 삶이,\f라우알의 파도로 인해\n무너지려 하고 있는 것이다.",
 "51": "그걸 깨달은 건\n지금으로부터 30년쯤 전의 일이다.",
 "52": "우리 세계의 인간은\n태어날 때부터 마법을 다뤘다.\f허나, 그것이 화근이 됐다.",
 "53": "마법을 다룰 때\n다 삭이지 못한\f부정한 상념이\n오랜 세월 공간에 쌓여,\f손쓸 수 없는 괴물이 된 것이다.",
 "54": "그게 라우알의 파도다.",
 "55": "자기 세계를 구하려고,\f다른 세계를\n멸망시켜도 좋다는 말이냐?",
 "56": "우리 세계에서도 의견은 갈렸다.",
 "57": "일부는 이 세계에 와서\n그것이 과연 용납될 행위인지\f제 발로 걸으며\n이 세계를 도는 자도 있었다.",
 "58": "그게, 마녀의 순례...",
 "59": "그렇다.",
 "60": "그중에는, 하얀마녀라\n불린 게르드처럼,\f이 세계 사람들이\n탄식의 상념을 낳지 않도록\f조언을 남기고 여행한 자도 있다.",
 "61": "하지만\n우리의 결론은 이미 나왔다.",
 "62": "라우알의 파도를\n이 세계로 몰아내고,\f우리 세계만을\n구한다는 길로...",
 "63": "천구의에 탄식의 상념을\n가둔 건,\f라우알의 파도가\n태어난 때와 같은 상황을 만들어,\f이 세계로 유도하기 위해서였군요.",
 "64": "그런 말이다.",
 "65": "라우알의 파도는\f자신을 키운\n탄식의 상념 파장을 즐긴다.",
 "66": "이 세계가 우리 세계보다\n탄식의 상념을 많이 지니면,\f틀림없이\n파도는 이 세계로 밀려온다.",
 "67": "그러기 위해서도\n우리는 비정해져야만 했다.",
 "68": "우리 세계 사람이\n마음속 탄식의 상념을 버리지 않는\n한,\f이 작전은 성립하지 못했다.",
 "69": "이걸로 알아들었겠지.",
 "70": ".........",
 "71": "..두 개의...",
 "72": "두 세계를\n둘 다 구할 방법은 없었던 거야?",
 "73": "없었다.",
 "74": "아니,\f적어도 내가 조사한 바로는\n다른 방법은 없었다.",
 "75": "그럼, 있을지도 모른다는 거네?",
 "76": "가능성이란 어디에나 있다.",
 "77": "허나, 시간이 없었다.",
 "78": "안됐지만\n아직 천구의를 파괴당하면\n계획이 물거품이 되니 말이다.",
 "79": "너희는 여기서 죽어 줘야겠다.",
 "80": "간다!",
 "81": "커헉.....?!",
 "82": "후, 후후후...",
 "83": "잘도, 나를 이겼군...",
 "84": "하지만, 이 승리도...\n너희의 마지막 발버둥...",
 "85": "이미 부른 라우알의 파도를\n어떻게 막을 테냐?",
 "86": "훗, 후..후하하하...",
 "87": "핫하하하하하...",
 "88": "좋아, 천구의를 부순다.",
 "89": "응.",
 "90": "먼저 천구의를 감싼\n저 징그러운 걸 벗겨 내지 않으면\n안 되겠어.",
 "91": "제가 폭탄으로 해 보죠.",
 "92": "그런...",
 "93": "폭탄이 안 통하다니...",
 "94": "이봐, 왜 그래?",
 "95": "하늘 구름이 심상치 않아졌어.",
 "96": "로디.",
 "97": "아, 알프...",
 "98": "모리슨 씨도.",
 "99": "모리슨도 나도\f서로 몰래 자네들을 뒤쫓아\n오고 있었다니...",
 "100": "여기 오는 길에 만났다네.",
 "101": "정말이지, 깜짝 놀랐네.",
 "102": "그보다,\f천구의를 부숴야 하는데, 폭탄도 안\n통해.",
 "103": "저런..폭탄도 소용없단 말인가?",
 "104": "아마도\n성장한 천구의 주위는\f정신적인 힘으로\n비호받고 있는 것이겠지요.",
 "105": "물리적인 힘만으로는\n효과가 없는지도 모릅니다.",
 "106": "무슨 방법이 없나?",
 "107": "물리적으로도 정신적으로도\n그 양쪽에\n영향을 주는 것이 있다면.",
 "108": "가령, 진홍의 불꽃처럼?",
 "109": "네, 그렇습니다.",
 "110": "진홍의 불꽃 폭발은\n정신적으로도\n정화 작용이 있다 합니다.\f진홍의 불꽃이라면, 필시...",
 "111": "진홍의 불꽃이라면\n케빈 할아버지한테\n받은 게 있어.",
 "112": "정말?",
 "113": "보여 봐라.",
 "114": "자, 이거야.",
 "115": "분명 진홍의 불꽃...",
 "116": "하지만, 이건, 너무 작아.",
 "117": "적어도 내가\n가루가에게 썼을 때만큼\n크기가 있으면...",
 "118": "아니, 포기하기엔 이릅니다.",
 "119": "마법의 힘으로 키우면 됩니다.",
 "120": "저 혼자서는 무리일지 모르나\n크리스 님과 힘을 합치면\n이 진홍의 불꽃을 크게 만들 수\n있겠지요.",
 "121": "저도 조금이라면 마법을 씁니다.\n돕겠습니다.",
 "122": "네, 해 봐요.",
 "123": "굉장해...",
 "124": "네.",
 "125": "이제 됐겠지요.",
 "126": "자, 이걸.",
 "127": "스텔라는 진홍의 불꽃을 받았다.",
 "128": "던집니다.",
 "129": "위험하니 물러나 계십시오.",
 "130": "잠깐!",
 "131": "나한테 맡겨.",
 "132": "1발밖에 없잖아.",
 "133": "난 백발백중이다.\n내 솜씨를 믿어.",
 "134": ".........",
 "135": "스텔라는 끄덕여\n진홍의 불꽃을 구스에게 줬다.",
 "136": "역시 긴장되는군.",
 "137": ".........",
 "138": "받아라!",
 "139": "해냈다!",
 "140": "좋아, 다음은 쥬리오 차례.",
 "141": "은단검으로 천구의를 노려라.",
 "142": "응.",
 "143": "빗나가지 마.",
 "144": "으, 응...",
 "145": "얍!",
 "146": "천구의는 완전히 부서졌다.",
 "147": "탄식의 상념이 안 느껴진다.",
 "148": "그래, 그대로 이리로 오는 게 좋다.",
 "149": "방금 건 뭐야?",
 "150": "천구의에 갇혀 있던 혼입니다.",
 "151": "탄식의 상념과 함께 풀려난 겁니다.",
 "152": "그럼, 이제 루돌프 왕이랑\n국경으로 간 표정 없는 병사들도\n원래대로 돌아오겠네.",
 "153": "우선은\n사람들을 제정신으로 돌리는 데는\n성공한 듯합니다.",
 "154": "안 돼!",
 "155": "이런...늦었나!",
 "156": "엇?!",
 "157": "삼촌!",
 "158": "바다트.",
 "159": "실례.",
 "160": "벌써, 이 안은 비었구나.",
 "161": "으, 응.",
 "162": "우리\n삼촌이 전한 대로 했어.",
 "163": "표면에 붙어 있던 걸 떼어 내고서\n은단검을 찔러 넣었어.",
 "164": "아아, 그건 괜찮은데...",
 "165": "기드나의 유적에서\n라우알의 파도에 대해\f새로운 사실을 알아냈어.",
 "166": "새로운 사실이란?",
 "167": "천구의가 남아 있었다면\n다른 방법도 있었는데...",
 "168": "아니, 그건 나중에 하자.",
 "169": "그보다, 서둘러.\n라우알의 파도를 부르는 힘은 아직\n이어지고 있어.",
 "170": "왕비다.",
 "171": "이자벨 왕비가\n아직, 어딘가에 있을 거다.",
 "172": "의식의 성격상\n이 장소에서\n그리 멀지 않을 겁니다.",
 "173": "천구의에서 너무\n멀리 떨어지면\n염파가 닿지 않으니까요.",
 "174": "찾아봅시다.",
 "175": "응.",
 "176": "쥬리오 일행은 파티를 짰다.",
 "177": "나눠서 왕비를 찾아라.",
 "178": "어떻게든\n이 세계에 라우알의 파도가\n오는 것을 막아야만 한다.",
