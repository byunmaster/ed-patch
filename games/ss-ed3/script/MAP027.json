{
 "1": "쥬리오＆크리스",
 "14": "네?",
 "21": "응.",
 "32": "크리스〜,\n이제 녹초야.",
 "33": "약한 소리 하면 안 돼.",
 "34": "크리스〜,\n이제 못 하겠어・・・.",
 "35": "힘 좀 내.\n「울보 쥬리오」라고\n불려도 괜찮아?",
 "36": "그런〜.",
 "37": "어라?\n크리스?",
 "38": "헉헉,\n좀 지쳤어.",
 "39": "이제, 못 하겠어・・・.",
 "40": "알고 있다니까.\n잠깐 기다려.",
 "41": "크리스〜\n힐 좀 걸어 줘.",
 "42": "크리스, 고마워〜.",
 "43": "크리스〜, 왜\n힐 안 걸어 주는 거야.",
 "44": "그런 소리 해도\n마력이 얼마 안 남았어.",
 "45": "에〜, 그런〜.",
 "46": "끝까지 포기하지 말고\n힘내는 거야!",
 "47": "그런 소리 해도\n나도 녹초라고.",
 "48": "다음 차례엔\n걸어 줄게.",
