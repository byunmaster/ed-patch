 },
 "0": "루이즈 관문",
 "1": "퓨엔테 병사",
 "2": "안내 다니이",
 "3": "아드레이",
 "4": "앞으로의 세상은\n나라끼리 돕는 게 필요하다고\f생각해.\n나도 이 국경을 지킬 수 있어서\n자랑스럽게 여기고 있어.",
 "5": "제대로 수속을 밟고 나서\n퓨엔테국에 들어가 줘.",
 "6": "수속은 끝난 모양이네.\f자, 지나가도 좋아.",
 "7": "옛날엔, 여기에 감옥이 있었어.\f하지만 지금은,\n이 근처에서 나쁜 짓 하는 사람이\n별로 없어서, 없어졌지.\f북퓨엔테 쪽에는\n지금 산적이 나온다는 얘기지만,\f이쪽은 아주 평화로워.",
 "8": "북퓨엔테 쪽에는\n지금 산적이 나온다는 얘기지만,\f이쪽은 아주 평화로워.",
 "9": "네, 수고하셨어요.\f옆 카운터에서\n입국 수속을 해 주세요.",
 "10": "네, 그러세요.\f１번 수속을 마치면\n프리패스예요.",
 "11": "입국 수속이시라면,\n카운터 앞에서 부탁드립니다.",
 "12": "네, 이쪽으로.",
 "13": "올도스국에서 돌아왔어요.",
 "14": "쥬리오는 은단검을 내보였다.",
 "15": "호오, 순례에서 돌아오셨군요.\n그거 고생 많으셨습니다.\f네, 됐습니다.\f３분이시군요.\n지나가십시오.",
 "16": "어린데 대견하군요.\f훌륭한 어른이 되세요.",
 "17": "어린데 대견하군요.\f훌륭한 어른이 되세요.",
 "18": "얘들아.\f아직, 입국 수속이\n안 끝난 모양이네.\f제대로,\n끝내고 나서 지나가 줘.",
 "19": "네, 순례에서 돌아온 분이시군요.\n얼굴을 보면 압니다.\f저도 프로니까요.",
 "20": "쥬리오는 은단검을 내보였다.",
 "21": "오, 은단검이군요.\n후우・・・.\f・・・맞혀서 다행입니다.",
 "22": "뭐야・・・자신 없었던 거야.",
 "23": "자, 지나가십시오.\f조심하세요.",
 "24": "자, 지나가십시오.\f조심하세요.",
 "25": "여어, 안녕.",
 "26": "안녕하세요.",
 "27": "좋겠다,\n여자애 ２명이랑 여행이라니.\f부렵네.",
 "28": "저기, 그거 말하려면\n부럽네, 잖아.",
 "29": "좋겠다,\n여자애 ２명이랑 여행이라니.\f부렵네.",
 "30": "저기, 그거 말하려면\n부럽네, 잖아.",
 "31": "얘들아.\n",
 "32": "아직, 입국 수속이\n안 끝난 모양이네.\f제대로,\n끝내고 나서 지나가 줘.",
 "33": "네, 순례에서 돌아온 분이시군요.\n얼굴을 보면 압니다.\f저도 프로니까요.",
 "34": "쥬리오는 은단검을 내보였다.",
 "35": "오, 은단검이군요.\n후우・・・.\f・・・맞혀서 다행입니다.",
 "36": "뭐야・・・자신 없었던 거야.",
 "37": "자, 지나가십시오.\f조심하세요.",
 "38": "어라, 얘들아.\n",
 "39": "분명 순례 여행자였지.\f설마\n올도스국으로 돌아갈 셈이야?\f폴티아국으로 갈 거라면\n남퓨엔테를 넘어서,\n기드나국을 북상하는 게 １번 빨라.",
 "40": "어라, 얘들아.\n",
 "41": "분명 순례 여행자였지.\f국경을 넘고 싶은 거야?\f미안하지만, 남북 문제가\n불거져 버려서 말이야.\f지금, 이곳 국경은\n봉쇄돼 있어.",
 "42": "어라, 얘들아.\n",
 "43": "분명 순례 여행자였지.\f설마\n올도스국으로 돌아갈 셈이야?\f폴티아국으로 갈 거라면\n남퓨엔테를 넘어서,\n기드나국을 북상하는 게 １번 빨라.",
 "44": "야, 수고했어.\f남퓨엔테 국경 관문에 도착이야.",
 "45": "어라?\f아저씨\n퓨엔테국 병사예요?",
 "46": "맞아요.",
 "47": "그치만,\n여기는 앰비쉬국 쪽이잖아요.\f원래대로라면 앰비쉬국 사람이\n지켜야 하는 거 아니에요?",
 "48": "원래는 그렇긴 한데 말이야.\n앰비쉬국에서 오면 멀잖아.\f앰비쉬국에서 사람을 보내면\n삼도교나 우돌국을 지나서\n크게 돌아와야 하거든.",
 "49": "꽤나 힘들겠네.",
 "50": "응, 그래.\f그래서 의논을 해서\n이 관문은 남퓨엔테가\n맡기로 된 거야.",
 "51": "그렇고말고. 이웃 나라니까.",
 "52": "앞으로의 세상은\f나라끼리 돕는 게\n필요하다고 생각해.\f나도 이 국경을 지킬 수 있어서\n자랑스럽게 여기고 있어.",
 "53": "앰비쉬국−퓨엔테국　루이즈 관문",
 "54": "루이즈 관문",
 "55": "북서　트리프 관문　　　９０８미로남　　루이즈 관문　　　１０８미로",
 "56": "북서　트리프 관문　　　５５２미로남　　루이즈 관문　　　４６４미로",
 "57": "잠깐,\n늑대가 있어.",
 "58": "에〜・・・.\n또〜・・・.",
 "59": "이 근처에는,\n늑대가 정말 많이\n있는가 보네요.",
 "60": "게다가, 끼어 버렸네요.",
 "61": "또〜오〜・・・.",
 "62": "그렇게 몇 번이나\n늑대한테 습격당한 거네.",
 "63": "징그러운 뱀이 있네요.",
 "64": "보통 뱀치고는,\n모습이 이상해.",
 "65": "크리스〜,\n이제 녹초야.",
 "66": "약한 소리 하면 안 돼.",
 "67": "크리스〜,\n이제 못 하겠어・・・.",
 "68": "힘 좀 내.\n「울보 쥬리오」라고\n불려도 괜찮아?",
 "69": "그런〜.",
 "70": "어라?\n크리스?",
 "71": "헉헉,\n좀 지쳤어.",
 "72": "이제, 못 하겠어・・・.",
 "73": "알고 있다니까.\n잠깐 기다려.",
 "74": "잠깐,\n그렇게 한꺼번에 여럿을\n회복 못 해.",
 "75": "저, 이제 못 일어나요.",
 "76": "아아, 저,\n이제 안 되겠어요・・・.",
 "77": "해 볼게요.",
 "78": "여러분을 회복시키는 건\n힘들지만・・・.\f할 수 있는 만큼은\n해 볼게요.",
 "79": "방바〜앙・・・.",
 "80": "바〜앙바〜앙・・・.",
 "81": "크리스〜\n힐 좀 걸어 줘.",
 "82": "크리스,\n힐 좀 걸어 줘.",
 "83": "쥬리오 씨,\n체력 회복은\n저도 할 수 있어요.",
 "84": "역시, 휘리네.\n그럼, 부탁해〜.",
 "85": "방바〜앙・・・.",
 "86": "무슨 일이에요, 방방.\n어머, 상처 치료군요.",
 "87": "방, 바앙.",
 "88": "크리스, 고마워〜.",
 "89": "크리스〜, 왜\n힐 안 걸어 주는 거야.",
 "90": "그런 소리 해도\n마력이 얼마 안 남았어.",
 "91": "에〜, 그런〜.",
 "92": "끝까지 포기하지 말고\n힘내는 거야!",
 "93": "그런 소리 해도\n나도 녹초라고.",
 "94": "다음 차례엔\n걸어 줄게.",
 "95": "휘리, 고마워〜.",
 "96": "어라, 휘리・・・.",
 "97": "미안해.\n이제 조합은 별로 못 써.",
 "98": "알았어.\n응, 어쩔 수 없지.",
 "99": "죄송해요.\n저도 비틀거렸거든요.",
 "100": "응, 그럼\n어쩔 수 없지.",
 "101": "죄송해요.\n다음 차례에는,\n꼭 쓸게요.",
 "102": "휘리, 고마워.",
 "103": "크리스 씨,\n고맙습니다.",
 "104": "방바앙!",
 "105": "방바앙!",
 "106": "방바〜앙・・・.",
 "107": "미안.\n이제 조합은 별로 못 써.",
 "108": "바〜앙바〜앙・・・.",
 "109": "미안해요.\n저도 비틀거렸거든요.",
 "110": "바앙방.",
 "111": "미안해요.\n다음 차례에는,\n꼭 쓸게요.",
 "112": "바앙방."
}
