{
 "0": "북히츠 가도",
 "1": "립,어둠의 속박,큐",
 "2": "리즈",
 "3": "우돌 병사",
 "4": "우르바",
 "5": "칸드의 에포르",
 "6": "챠펠의 라포르",
 "7": "홀크 병사",
 "8": "하이젠 병사",
