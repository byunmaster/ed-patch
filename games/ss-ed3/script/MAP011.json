{
 "0": "타랏타호",
 "1": "어부토바이",
 "2": "인타",
 "3": "에메나",
 "4": "림",
 "5": "비아노",
 "6": "쥬리오＆크리스",
 "7": "뭐라도 먹여 주겄어.",
 "8": "『캡틴 토마스』는\n최고여.\f나도 어부가 아니었으면\n일곱 바다를 누비며\n대모험을 했을 텐디.",
 "9": "저도 『캡틴 토마스』\n정말 좋아해요.",
 "10": "해적왕 라몬과의\n마지막 승부 장면 같은 건\n몇 번을 읽어도 두근거려요.",
 "11": "그래. 그렇지, 그렇지.\n역시 좋제.\f여자애는 모를 것이여.",
 "12": "근데 크리스는 달라요.",
 "13": "무슨 뜻이야?",
 "14": "걱정 안 해도\n느긋하게 있으면\f타랏타호가 안전하게\n네갈섬 항구까지 데려다줄 것이여.",
 "15": "됐으니까 얼른 가서\n볼일을 마치고 오더라고.",
 "16": "오, 볼일은 끝났냐?",
 "17": "그게요, 토바이 씨.",
 "18": "미안해요.\n조금 더 걸릴 것 같아요.",
 "19": "그려. 아직 괜찮여.\n서두르지 않아도 되야.\f나는 여기서 기다릴 텡께.\n아직 이삼 일은\n유빙으로 바다가 메워질 일도\f없을 것이여.",
 "20": "기다려 줄 텡께\n안심혀.",
 "21": "오, 이제 됐냐?\n언제든 출항할 수 있어야.",
 "22": "저기, 토바이 씨.\f실은 또 태워 달라는 사람이\n있는데, 괜찮을까요?",
 "23": "나는 상관없어야.\f가는 김에 태워 주제.\n데려오더라고.",
 "24": "고마워요.",
 "25": "인타 녀석, 너무 기운이 넘쳐.\f줄곧 혼자서\n해적 놀이를 하고 있어야.",
 "26": "배 진로라면 걱정 없어야.\f참, 치타 가는 길 무너진 벼랑은\n아직 안 치웠을 텡께\n벼랑 너머까지\f배로 데려다주겄어.",
 "27": "고마워요, 살았어요.",
 "28": "고마워요.\f",
 "29": "돌아갈 땐 바람이 반대라 말이여.\f붙어서 안 보고 있으면\n배가 말을 안 듣는당께.",
 "30": "돌아갈 땐 바람이 반대라 말이여.\f붙어서 안 보고 있으면\n배가 말을 안 듣는당께.",
 "31": "와〜아, 와〜아!",
 "32": "저기, 나는\n캡틴 토마스야.",
 "33": "나쁜 해적 라몬은\n저 돛대 아래에 잡아 뒀어.",
 "34": "왜 내가 라몬인 거여...",
 "35": "엄마.\n나, 해적 라몬을 잡았어.",
 "36": "어머 어머...\n토바이 씨\n죄송해요.",
 "37": "헤엥!\n괜찮다니께.\f어차피 나는 라몬 역이제.",
 "38": "와하하하하...!\n라몬은 달아났다아!",
 "39": "앗, 서라아!",
 "40": "토바이 덕분에 메나트 대륙으로 가는\n항해는 즐겁게 이어졌다.\f쥬리오 일행은 새삼스레\n여행지에서 만나는 사람들의\n따스함을 느꼈다.",
 "41": "이윽고 대륙이 가까워졌다.",
 "42": "눈앞에 메나트 대륙의 절벽이\n다가왔다.\f토바이는 쥬리오 일행이\n치타로 갈 수 있도록\n알데 항에 배를 대는 게 아니라\f벼랑 무너진 곳을 넘은 자리에\n배를 대 주기로 했다.",
 "43": "에메나 모자는\n한동안 알데에서 지내다,\f자리를 잡고 나서\n닐리로 가기로 했다.\f상냥한 닐리 사람들이라면\n인타를 따뜻이 맞아 주리라고\n쥬리오는 생각했다.",
 "44": "좋았어, 쥬리오, 크리스.",
 "45": "저 절벽 아래에 댈 거여!\n준비는 됐냐?",
 "46": "준비됐어요!",
 "47": "근데 저 험한 절벽을\n오를 수 있어요?",
 "48": "저 절벽은 보기엔 험해도\n의외로 쉽게 오를 수 있어야.\f너희라면 괜찮을 것이여.",
 "49": "고향인 네갈섬을 떠나\n대륙으로 건너가도,\f앞으로 고생할 건\n각오하고 있어요.\f그래도 인타를 위해서라도\n힘내야죠.",
 "50": "나는 림.\n인타의 형님뻘이야!",
 "51": "나는 비아노.\n창고지기야.",
 "52": "나는 임시 로디.\f설 자리를 정하려고\n고용됐어.",
 "53": "이 돛대\n못 오르려나?",
 "54": "그만둬, 크리스.\f정말 말괄량이라니까...",
 "55": "알고 있다니까\n안 오를 테니 안심해.",
 "56": "그래도 내가 배에서 제일 좋아하는\n곳은 돛대 위야.\f기억해 둬.",
 "57": "기억하는 거야 좋지만\n그런 걸 기억해서 뭐 하게.",
 "58": "내가 배에서 제일 좋아하는 곳은\n돛대 위야.\f기억해 둬.",
 "59": "기억하는 거야 좋지만\n그런 걸 기억해서 뭐 하게.",
 "60": "역시 배는\n이 자리가 제일 좋네.",
 "61": "매발톱호의 질바 선장님도\n이 경치가 마음에 들어\n선장이 되려고 했다더라.",
 "62": "캡틴 토마스도\n이렇게 여기에\n서 있었겠지...",
 "63": "역시 배는\n이 자리가 제일 좋네.",
 "64": "저기, 쥬리오.\f통만 보면 왠지 허크 삼촌이\n튀어나올 것 같아.",
 "65": "그래도 난 또 만나고 싶어.",
 "66": "어머, 나도 그래.\f허크 삼촌은\n좀 별나지만\n난 정말 좋아.",
 "67": "응, 나도 좋아해.",
 "68": "앗?\n저...저건 뭐지!",
 "69": "우와아\n뭐지, 굉장해.",
 "70": "어〜이, 왜 그러냐?",
 "71": "토, 토, 토바이 씨!\n저거...뭐죠?",
 "72": "토바이 씨!\n저건 뭐예요?",
 "73": "저, 저건...설마.\f그런...말도 안 돼...",
 "74": "네갈섬 앞바다를\n거대한 혹 같은 것이\n남쪽을 향해 이동하고 있었다.",
 "75": "...마치\n산이 바다를 건너는 것 같아...",
 "76": "틀림없어!　가루가여...",
 "77": "에엣?!",
 "78": "가루가.....?!",
 "79": "가루가라고?!",
 "80": "　　　　　작은 순례자 쥬리오와 크리스는\n 두 번째 샤리네가 있는 네갈섬으로 가는 배 위에서\n　　　　 해수 가루가를 목격한 것이었다.\n",
 "81": "　　　　　　 서장　작은 순례자　끝\n",
 "82": "책장에 책이 있다.\f『캡틴 토마스』 책이다.",
 "83": "표지에는\n《캡틴 토마스의 대항해》\n라고 적혀 있다.\f쥬리오가 아주 좋아하는 이야기다.",
 "84": "조금 길지만, 읽어 보시겠어요?",
 "85": "쥬리오는\n손에 들고 책을 펼쳐 보았다.",
 "86": "쥬리오는 토바이도\n『캡틴 토마스』 팬이라는 걸 알고\f조금 기분이 좋아졌다.",
 "87": "디버그용 이벤트입니다.\n",
 "88": "방 안에서 인타가\n누워 있는 모양이다.",
 "89": "무슨 일이에요, 토바이 씨?\n인타가 어디 아파요?",
 "90": "뱃멀미인 것 같여.",
 "91": "타랏타호는\n여객선이 아니라 약도 없고,",
 "92": "항구에 닿을 때까지\n참을 수밖에 없구먼.",
 "93": "그렇지, 쥬리오.\f질바 선장께 받은\n멀미약 있었잖아!",
 "94": "맞다\n약이라면 있어.",
 "95": "쥬리오는 짐 속에서\n멀미약을 꺼냈다.",
 "96": "뭐여, 멀미약을\n가지고 있었냐.\f잘됐구먼. 자, 먹여 주더라고.\n뱃멀미쯤 금방 나을 것이여.\f그럼.",
 "97": "나는 배 진로를\n봐야 하니께.\n갑판에 올라가 있겄어.",
 "98": "어쩐지 나, 속이 안 좋아...",
 "99": "인타도 참, 배를 탈 수 있다고\n그렇게나 기뻐했는데...\f괜찮을까.",
 "100": "어머?　약이 있나요?",
 "101": "네, 멀미약이에요.\f이걸 인타에게 먹여 주세요.\n금방 좋아질 거예요.",
 "102": "크리스는 멀미약을\n에메나에게 건넸다.",
 "103": "이렇게까지 해 주시고\n정말 감사합니다.\f당장 먹여 볼게요.\f",
 "104": "에메나는 멀미약을\n인타에게 먹였다.",
 "105": "부르르〜웅!\n아히이.",
 "106": "이 약, 엄청 잘 듣나 봐.\n나, 속 안 좋은 거\n나아 버렸어!",
 "107": "와아.\f나아 버렸다.\n나아 버렸다.\f고마워.\n형아, 누나!\f엄마\n나 놀다 올게에!",
 "108": "어머, 저 애도 참...\f정말 감사합니다.",
 "109": "참.",
 "110": "이걸 받아 주세요.",
 "111": "에메나는 보리가 든 자루를\n꺼냈다.",
 "112": "한 번 끓였다가 말린 보리예요.\f여행길 식량으로는\n아주 좋답니다.\n비상식 삼아 가져가 주세요.",
 "113": "와.\f받아도\n되나요?",
 "114": "고마워요, 에메나 씨.",
 "115": "쥬리오 일행은\n말린 보리를 받았습니다.",
 "116": "고향인 네갈섬을 떠나\n대륙으로 건너가도,\f앞으로 고생할 건\n각오하고 있어요.\f그래도 인타를 위해서라도\n힘내야죠.",
 "117": "쥬리오, 그쪽은 바다야!\f정말, 못 말리는 길치라니까.",
 "118": "......",
 "119": "됐으니까 얼른 가서\n볼일을 마치고 오더라고.",
 "120": "아직 괜찮여.\n서두르지 않아도 되야.\f나는 여기서 기다릴 텡께.\n아직 이삼 일은\n유빙으로 바다가 메워질 일도\f없을 것이여.",
 "121": "기다려 줄 텡께\n안심혀.",
 "122": "오, 이제 됐냐?\n언제든 출항할 수 있어야.",
 "123": "저기, 토바이 씨.\f실은 또 태워 달라는 사람이\n있는데, 괜찮을까요?",
 "124": "나는 상관없어야.\f가는 김에 태워 주제.\n데려오더라고.",
 "125": "고마워요.",
 "126": "이제 괜찮여.",
 "127": "바다에 나가 부리면\n내 세상이제.\f이 바다는 내 마당 같은 것이여.",
 "128": "(꼬르륵...꼬르르륵...!)",
 "129": "쥬리오의 배가 울렸다.",
 "130": "바다표범도\n배가 고팠던 걸까.",
 "131": "쥬리오\n너, 배고픈 거냐?",
 "132": "네, 배고파요.",
 "133": "그러고 보니\n닐리 항에 닿고부터,\f식사다운 식사를\n못 했었지.",
 "134": "어쩐지 나도\n배가 고파졌어.",
 "135": "그럼 좀 이르지만\n밥이나 먹을까.",
 "136": "엇?!\n식사 준비가 돼 있어요?",
 "137": "당연하제.\f어부는 말이여\n한 번 고기잡이 나가면\n며칠 걸릴지 몰러.\f그러니께, 식량만은\n늘 넉넉히 배에 실어 두는 것이여.",
 "138": "하기야, 보리뿐이지만서도.\f",
 "139": "자, 따라오더라고.",
 "140": "준비는 되셨죠?",
 "141": "네, 잘 부탁드립니다.",
 "142": "비아노 씨\n신세 많이 졌습니다.",
 "143": "신세는 이쪽이 졌지.\n조심해서 가라고.\f걱정 안 해도\n모두한테는 잘 말해 둘 테니.",
 "144": "잘 들어.\n이 네갈섬은 네 섬이야.\f괴로운 일이 있거든\n언제든 돌아오렴.",
 "145": "고마워요, 비아노 씨.",
 "146": "자리 잡거든 편지를 다오.",
 "147": "네.",
 "148": "저기,",
 "149": "얼른 배에 타자.",
 "150": "그럼, 갈까요?",
 "151": "네.",
 "152": "어〜이, 인타아!",
 "153": "앗?!\n림 형아 목소리다!",
 "154": "역시 있었네.\f마을에 없으니까\n혹시 항구에 있나 싶어서\n와 봤어.\f인타.\n너, 이런 데서\n뭐 하는 거야?",
 "155": "배에 타는 거야.",
 "156": "배...?",
 "157": "너, 어디 가는 거야?\f가 버리는 거야?",
 "158": "엇?\n나 아무 데도 안 가.\f배에 탈 뿐인걸.",
 "159": "인타...\n미안해.",
 "160": "배만 타는 게 아니란다.",
 "161": "우리는 대륙에서 살 거야.",
 "162": "대륙...",
 "163": "그런 건...싫어.",
 "164": "림 형아랑\n못 놀게 되잖아.",
 "165": "그럼 나, 배 안 탈래.",
 "166": "아줌마, 정말이에요?",
 "167": "미안해, 림.",
 "168": "그런 게 어딨어요.\n왜 말해 주지 않았어요?",
 "169": "림, 그만하렴.",
 "170": "그치만요...",
 "171": ".........",
 "172": "모두에게 말없이 섬을 떠나는 것도\n괴로운 일이란다.\f림, 이해해 줄 수 있지?",
 "173": ".........",
 "174": "........\n림 형아.",
 "175": "나...\n배 타고 대륙에 갈래.",
 "176": "인타...",
 "177": "알았어, 잘 지내라.",
 "178": "편지 보내라\n나도 보낼 테니까.",
 "179": "응...",
 "180": "자, 기운 내라, 둘 다.\n출항이잖니.\f옛날부터 출항은 웃으며 보내고\n웃으며 떠나는 게\n길하다고 했단다.\f언제까지고\n훌쩍대고 있으면 못 써.",
 "181": "응.\n그럼 잘 있어, 인타.\f편지 기다릴게.",
 "182": "응.\n림 형아도 잘 있어.\f편지 쓸게.",
 "183": "자, 어서 가거라.\n해가 저물겠다.",
 "184": "그럼, 이번엔\n정말로 배에 타는 거예요.\f괜찮죠?",
 "185": "네, 부탁드려요.",
 "186": "응.",
 "187": "빠이, 빠〜이!",
 "188": "잘 지내라!",
 "189": "조심해서 가.",
 "190": "그렇게 됐어요\n토바이 씨.",
 "191": "아무 말 말어.\n다 알겄당께.\f자 타더라고.",
 "192": "밖은 추운께 판자 뗄 때까지\n안에서 기다리더라고.",
 "193": "토바이 씨, 정말 고마워요.",
 "194": "괜찮다니께.",
 "195": "고마워요, 토바이 씨.",
 "196": "근디 너희들.\f섬에서 돌아올 땐\n어쩔 셈이여?\f이 섬이 가루가한테\n습격당할 일이 없었으면\n그대로 두고 갈 참이었는디,\f이런 판이면 돌아갈 배를\n구하기도 힘들 것이여.",
 "197": "그러고 보니, 그렇네요.\n어쩌지...",
 "198": "할 수 없제.",
 "199": "이왕 시작한 일이여.\n여기서 기다려 주겄어.\f어차피 이틀쯤이면\n볼일은 끝나겄제.",
 "200": "네, 테그라 샤리네에\n갈 뿐이니까\f그쯤이면 돌아올 수 있어요.",
 "201": "좋아, 정해졌구먼.\n그럼, 다녀오더라고.\f조심하고.",
 "202": "네, 토바이 씨.\n고마워요.",
 "203": "그럼 또 봐요, 토바이 씨.",
 "204": "림 형아!\n잘 있어어!!\f안녀엉!!",
 "205": "인타!\n꼭 편지 보내라아!",
 "206": "안녕히 계세요, 비아노 씨〜!",
 "207": "순례 여행자들!\n인타네를 부탁한다!",
 "208": "비아노 씨도 잘 지내세요!",
 "209": "안녕히 계세요!",
 "210": "출발, 진행!!",
 "211": "뭐 하고 있었냐?\n엄청 늦었구먼.",
 "212": "토바이 씨가 큰 소리를 내니까\n바다표범이 깼잖아요.",
 "213": "맞아요.",
 "214": "어?　미안혀.\n아이고, 잘못했구먼...",
 "215": "토바이는 조금 머뭇거리며\n사과했다.",
 "216": "아버지한테 혼나 부렀당께.",
 "217": "어부는 바다에 안 나가면\n사내가 아니라고 말이여.",
 "218": "타랏타호 준비는 됐어야.",
 "219": "타랏타호요?",
 "220": "...이상한 이름.",
 "221": "쥬리오, 너!",
 "222": "태워 달라면서\n그런 소리 하면 안 되지.",
 "223": "딱히 이상한 이름 아녀.",
 "224": "이 고장 말로\n바다호라는 뜻이여.",
 "225": "토바이 씨, 신경 쓰지 마세요.\f그럼, 죄송하지만\n네갈섬까지 잘 부탁드려요.",
 "226": "좋〜아\n타랏타호 출항이여어!!",
 "227": "갑판은 춥잖여.",
 "228": "이 철 바닷바람은 몸에 사무쳐야.",
 "229": "안에 들어가는 게 좋여.",
 "230": "자, 이쪽이여.",
 "231": "쥬리오\n네갈섬에도 여러 사람이 있었네.",
 "232": "응.\n그래도 다들 좋은 사람뿐이었어.",
 "233": "그러네.",
 "234": "저기, 크리스.\f20년 전에 우리처럼\n여행한 마녀는\n어떤 사람이었을까.",
 "235": "지금 메나트에 일어나는 나쁜 일이\n마녀의 저주라는 사람도 있고,\f이탄으로 살아갈 수 있게 된 건\n마녀 덕분이라며\n고마워하는 사람도 있어.\f하얀마녀는 좋은 사람이었을까.",
 "236": "아니면 옛날이야기 속 마녀처럼\n무섭고 두려운 사람이었을까.",
 "237": "역시 마녀라고 하면\n",
 "238": "무서운 할머니를\n떠올리게 되네.",
 "239": "근데 하얀마녀는\n그렇지 않은 모양이야.",
 "240": "허크 삼촌한테\n조금 더 이야기를 들어 뒀으면\n좋았을 텐데.",
 "241": "타랏타호 명물\n보리밥 해산물카레 필라프여.\f맛있당께.",
 "242": "우와아, 맛있겠다!",
 "243": "잘 먹겠습니다아!\f냠냠냠냠...\n냠냠냠냠...\f...냠냠냠냠\n...냠냠냠냠\n냠냠냠...냠\f냠냠냠...",
 "244": "후우...",
 "245": "아〜, 맛있었다.",
 "246": "잘 먹었습니다!",
 "247": "그치, 맛있었제.",
 "248": "네, 엄청 맛있었어요.",
 "249": "나는 갑판으로 돌아가겄어.",
 "250": "　　　　　　 제１장　테그라의 보석\n",
 "251": "저...정말로...\n가루가가...나왔어...",
 "252": "네...네갈섬이...\n테그라가 습격당한 거여...?",
 "253": "가루가는...\f사람을 습격하진\n않는다고 하지 않았나요?",
 "254": "저놈, 어디로 헤엄쳐 갈\n셈일까요?",
 "255": "저쪽은 메나트의 수도\n넬바 방향이여.",
 "256": "이거, 큰일이구먼.\n저런 놈이 습격해 오면,\f사람이 만든 성 따위\n한 방에 날아가 부러.\f상륙하려나...",
 "257": "어라?\n",
 "258": "크리스, 토바이 씨.",
 "259": "봐요, 저기!",
 "260": "엇?　뭔데.",
 "261": "봐요, 사람이 타고 있어요.\n불러 볼까요?",
 "262": "어〜이, 어〜이!",
 "263": "어〜이!",
 "264": "칫\n가 버렸어.",
 "265": "가 버렸네.",
 "266": "그건 그렇고\n저 작은 배에 타고 있던 사람.\f무척 심각한 얼굴이었어요.",
 "267": "분명, 가루가한테 엉망이 된\n테그라 마을 사람이여.",
 "268": "심각한 얼굴도 되겄제.",
 "269": "네. 그렇겠네요.",
 "270": "그보다\n슬슬 네갈섬에 닿겄어.\f내릴 준비를 하더라고.",
 "271": "네!",
 "272": "얼마 뒤\n쥬리오 일행을 태운 타랏타호는\f무사히 네갈섬 선착장에\n도착할 수 있었다.\f가루가의 피해가 걱정이었지만\n보아하니 선착장에\n피해는 없는 듯했다.",
 "273": "테그라 샤리네는 이제 가깝다.\n여기까지 온 이상\f샤리네가 가루가에게\n부서지지 않았기를\n빌 뿐이다.\f쥬리오와 크리스는 조급한 마음을\n누르고 타랏타호를 뒤로했다.",
