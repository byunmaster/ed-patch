{
 "0": "매발톱호",
 "1": "톤쟈",
 "2": "가톤",
 "3": "조리장",
 "4": "보스레이",
 "5": "브루트",
 "6": "로저",
 "7": "테스",
 "8": "헤스톤",
 "9": "질바 선장",
 "10": "쥬리오＆크리스",
 "11": "수부 짐",
 "12": "소리",
 "13": "이 자리의 모두",
 "14": "쥬리오＆샤라",
 "15": "아직 자는걸.",
 "16": "다들 잠들어 버리다니\n분명히 이상해!",
 "17": "조사해 보자!",
 "18": "냠냠... 새근새근...\n드르르르...드르렁...\f...푸우...냠냠.",
 "19": "쿨쿨...",
 "20": "역시 잠들어 있는 거네.\f...잠깐만!\f그, 말은...\n배 조종은 누가 하고 있는 거야?",
 "21": "누가라니...\n다들 자고 있는걸.",
 "22": "어떻게든 해야 해!\n배가 항로를 벗어나 버려.",
 "23": "하지만, 크리스.\n범인을 잡는 게 먼저야.\f지금이라면 도둑맞은 걸\n되찾을 수 있을지도 몰라.",
 "24": "그런 말 해 놓고\n쥬리오는 범인이\f누군지 알고 있는 거야?",
 "25": "응, 어쩐지.",
 "26": "정말이야?\n조금 정리해 보자.",
 "27": "깰 것 같지 않네.",
 "28": "야, 쥬리오.\n범인이 누군지 생각해 볼래?",
 "29": "그럼, 간다.",
 "30": "뭐야, 모르겠어?\f조금 있다가,\n여기 와서 생각해 보자.",
 "31": "이 배를 빼앗기",
 "32": "손님 물건 훔치기",
 "33": "범인의 목적은, 뭐라고 봐?",
 "34": "엇?　그만두는 거야.",
 "35": "배를 빼앗을 셈이라면\n다들\f잠재울 리가 없잖아!",
 "36": "코트와 시계",
 "37": "금 브로치",
 "38": "조리장 생선",
 "39": "범인은 뭘 훔쳤더라?",
 "40": "앞 질문이 신경 쓰여?",
 "41": "뭔가 이상해.\n한 번 더 생각해 보자.",
 "42": "생선은\n큰 쥐 탓이었잖아.\f쥬리오,\n아는 척하면 안 되지.",
 "43": "럼주를 먹였다",
 "44": "잠의 마법을 썼다",
 "45": "수면약을 먹였다",
 "46": "어떻게, 다들 잠재운 거야?",
 "47": "좋아.\n하나 앞 질문이지?",
 "48": "자는 사람한테서\n술 냄새는 안 났어.",
 "49": "모습을 안 보이는 둘",
 "50": "밀항자 허크 아저씨",
 "51": "부자 헤스톤 씨",
 "52": "신혼 로저＆테스",
 "53": "쥬리오, 그래서 범인은 누구?",
 "54": "헷갈리는 거야?",
 "55": "그럴까.\f하지만 저 2인조는 한 번도\n선실에서 안 나왔어.\f아무리 수상해도\n그건 무리 아니야?",
 "56": "저런 아저씨라도,\n내 아저씨야!\f계속 방에,\n갇혀 있었잖아!\f허크 아저씨는 아니야.",
 "57": "로저 씨네가 범인이라면\n스스로 수면약을\f마실 리가 없잖아.",
 "58": "쥬리오, 대단해!\f그럼 저 헤스톤 씨가\n수배서에 있던 A-14호!\f그러고 보니...\n분명 수면약을 쓴다고\n적혀 있었지.",
 "59": "응. 실은 말이야.\f톤쟈 씨가\n계속 자고 있던 게\n마음에 걸렸거든.\f톤쟈 씨가 깨어 있었다면\n로저 씨네 방에\n못 들어가잖아.\f그래서 수면약으로 잠재운 거야.",
 "60": "그럼, 금 브로치가\n없어진 건?",
 "61": "분명 거짓말이야.\f자기 브로치가 없어지면\n의심받지 않게 되니까.",
 "62": "그래서, 은단검을\n방에 두는 걸 반대한 거네.",
 "63": "홍차를 안 마신 것도\n수면약이 들었을지도 모른다고\f생각해서였구나!",
 "64": "...그건 말이야\f홍차를 그다지\n좋아하지 않거든.",
 "65": "그래도, 대단하잖아!",
 "66": "이걸로 헤스톤 씨가 범인이란 게\n확실해졌네!\f역시나, 쥬리오!",
 "67": "그 정도는...에헤헤.",
 "68": "앗!?",
 "69": "무슨 일이야?",
 "70": "아래에서 소리가 났어.",
 "71": "다들 자고 있었지...\n그, 말은.",
 "72": "헤스톤 씨!",
 "73": "가 보자!",
 "74": "으〜음.\f뭔가 좀 다른 것\n같아....\f다시 한번, 생각을 정리하고서\n여기로 오자.",
 "75": "...응.",
 "76": "쿨쿨...",
 "77": "조리장님까지 잠들어 있어.",
 "78": "어째서 다들 잠들어 버린 거야?",
 "79": "zzz...\n좋은..느낌으로...\f됐...음냐.",
 "80": "쿠〜쿠〜.\n어머니...",
 "81": "보스레이 씨!",
 "82": "무슨 일일까?\n푹 잠들어 버렸어.",
 "83": "음냐음냐...",
 "84": "음냐음냐...",
 "85": "헤스톤 씨가\n이런 짓을 하다니.",
 "86": "으〜음...음냐...\n좋은 술이야...",
 "87": "브루트 씨까지...",
 "88": "드르렁...끄응.",
 "89": "이제 못 마셔...",
 "90": "기분 좋게 잠들어 버렸어.",
 "91": "새근새근...새근새근...\n후후..로저도 참..",
 "92": "기다려 주세요, 테스 씨.\n코트를 되찾아 보일게요.",
 "93": "스〜스〜.",
 "94": "로저 씨한테\n이런 짓을 하다니...",
 "95": "드르렁...\n..좌〜현〜타〜.",
 "96": "질바 선장님까지 푹 잠들었어.",
 "97": "어쩐지, 나쁜 예감이 드는데.",
 "98": "드르렁...",
 "99": "드르〜..드렁.",
 "100": "기다려 주세요, 질바 선장님.\n헤스톤 씨를 잡을 테니까요.",
 "101": "드렁!",
 "102": "어라?　안 열리네.",
 "103": "실례합니다, 안 계세요?\n방 청소하러 왔어요.",
 "104": "（젠장.）\f（어째서 저 꼬맹이가）\n（청소하러 도는 거야.）",
 "105": "（내가 알 리 없잖아.）\f（그보다,）\n（창밖에서 들여다보면 큰일이야!）",
 "106": "안 계신가요?",
 "107": "（어쩔 수 없네.）\n（뭐라도 대답해.）",
 "108": "（내가?）",
 "109": "（너 말고 누가 있어.）",
 "110": "（칫, 어쩔 수 없군.）",
 "111": "미, 미안하지만\n낮잠 자는 중이라 청소는 됐어.\f나중에 알아서 할게.\f맡겨 둬.",
 "112": "그런가요.\n그럼, 부탁드릴게요.",
 "113": "후우...\n한숨밖에 안 나오네.",
 "114": "안 들여보내 주니\n어떤 사람인지 궁금해지는걸.",
 "115": "이웃이니까\n인사 정도는 해 둬야지.",
 "116": "안녕하세요.",
 "117": "（또 왔잖아!）\n（혼쭐을 내 줄까?）",
 "118": "（바보!）\f（닐리에 닿을 때까지）\n（배에서 도망칠 수 없어.）\f（어떻게든 얼버무려.）",
 "119": "드르렁!\n드르렁, 그르렁.",
 "120": "벌써 자 버렸구나.\n근데, 굉장한 코골이네.",
 "121": "저렇게 굉장한 코골이면\n같이 있으면 잠 못 자겠어.",
 "122": "실례합니다.\n여기에 질바 선장님 안 계세요?",
 "123": ".....!?\n그런 험상궂은 아저씨...\f아니, 선장이라면 안 왔어.",
 "124": "정말 고마워요.\n（선장님은 어디 가셨을까?）\f（여기 사람은 한 번도 안 나오고.）（배 안에도 여러）\n（신기한 일이 있네.）",
 "125": "여기엔 선장님 없겠지.",
 "126": "여기 사람도 신기해.\n한 번도 안 나오고...\f아, 선장실에 가야지.",
 "127": "여기 사람들과는\n한 번도 못 만났네.",
 "128": "어떤 사람인지 확인할\n기회잖아.\f",
 "129": "실례합니다〜.",
 "130": "또, 그 애들이야.",
 "131": "좀 봐 줘.\f이런 좁은 데\n갇혀 있는 것만으로도\n못 참겠는데.",
 "132": "저, 실례합니다.",
 "133": "정말!\n삑삑 시끄럽네.",
 "134": "얘들아, 미안하구나.\f일행이 뱃멀미라,\n도저히 남들 앞에 나설 수가 없단다.",
 "135": "어머!　괜찮아요?",
 "136": "약을 가져올까요?",
 "137": "걱정 안 해도 돼.\n튼튼한 게 유일한 장점인 남자니까.",
 "138": "그런가요.\n그럼, 몸조리 잘하시길.",
 "139": "용케 그런 거짓말이 떠오르는군.\n말투까지 바꿔 버리고.",
 "140": "너랑은, 자란 게 다르거든.",
 "141": "한 번도 방에서 안 나왔으니\n여기 사람들은 상관없겠지.",
 "142": "여기 사람들은 괜찮으려나?",
 "143": "저, 실례합니다.\n무사해요?",
 "144": "무사라니 무슨 소리야?\n일행이 뱃멀미라고 했잖아!",
 "145": "무사한가 봐.",
 "146": "그러니까 무사하지 않다고!",
 "147": "（뭔가 이상해.）",
 "148": "（어떻게 된 거야?）",
 "149": "다들, 왜 그러는 걸까?",
 "150": "위험해!\n저 꼬맹이가 엿보고 있어!",
 "151": "숨는 거야!",
 "152": "어라?\f이 방 손님은\n어디 있는 걸까?",
 "153": "엄청\n부끄럼쟁이인 걸까?",
 "154": "칫!\n저 꼬맹이가 엿보고 있잖아.",
 "155": "숨는 거야!",
 "156": "뭐 하는 거야...",
 "157": "여기 있으면, 엿볼 수 없잖아.",
 "158": "너, 계속 그러고 있을 셈이야?",
 "159": "털썩.",
 "160": "그 꼬마가 왔어!",
 "161": "정말!\n좋은 다이어트네!",
 "162": "잠깐!\n그렇게 달라붙지 마!!",
 "163": "어쩔 수 없잖아!",
 "164": "제대로 일어났으려나?",
 "165": "뭐가, 어떻게 된 거야?",
 "166": "헤스톤 씨를 쫓아야 해!",
 "167": "쥬리오는\n티라스일 항해도를 봤습니다.",
 "168": "이런 거 볼 때가 아니지.",
 "169": "이런 거 볼 때가 아니지.",
 "170": "오늘 것은, 아직 안 적었네.",
 "171": "헤스톤 씨가 도망쳐 버려!",
 "172": "어라?　열쇠가 잠겼어.",
 "173": "크리스.\n이 상자에 말린 고기라고 써 있어.",
 "174": "배가 고픈 거지?",
 "175": "그야, 점심밥 걸렀잖아.\f라그픽 마을의\n호두파이가 먹고 싶어.",
 "176": "쥬리오, 봐!",
 "177": "우와.\n포동포동한 쥐 모자네.",
 "178": "이런, 간지럽잖아.",
 "179": "배가 고픈 거야.",
 "180": "자자, 비스킷이야.",
 "181": "크리스!\n비스킷 갖고 있어?",
 "182": "응.\n방금 걸로 끝이야.",
 "183": "실망이야.",
 "184": "허크 아저씨!!",
 "185": "아저씨!\n허크 아저씨, 괜찮아?",
 "186": "이야, 크리스.\n무슨 일 있니?",
 "187": "아저씨는 무사한가 봐.",
 "188": "저기, 아저씨.\n무슨 소리 못 들었어?",
 "189": "엇...?\n무슨 일 있었니.",
 "190": "뱃사람이 잠들어 버렸어!",
 "191": "으〜음...그러고 보니\f누군가 남자 목소리가 들린 듯도\n안 들린 듯도...",
 "192": "목소리?",
 "193": "생각에 잠겨 있어서\n확실하다고는 못 하겠구나.",
 "194": "앗!",
 "195": "헤스톤 씨!",
 "196": "찾았어!",
 "197": "쥬리오!\f헤스톤 씨가\n배 뒤쪽으로 갔어!",
 "198": "저기다!",
 "199": "헤스톤 씨!",
 "200": "멈춰요!!",
 "201": "기다리라고 해서 기다려 주는 도둑은 없단다, 아가씨.",
 "202": "훗훗훗...\f내 정체를 간파한 것이\n너희 같은 소년 소녀였다는 건\n놀랄 만한 일이다.\f허나, 조금 늦은 모양이군.\n은단검은 손에 넣지 못했다만\n그런대로 벌이는 됐다.\f다시 만날 일도 없겠지!",
 "203": "아디오스, 아미〜고!!",
 "204": "네?",
 "205": "운이 나빴군.\n절도범 A-14호 씨야.",
 "206": "정말, 안됐네.",
 "207": "도둑질 기초에서 수면약은 초보 중 초보. 네 수법쯤은 훤히 보여.",
 "208": "너, 너희는 누구냐!?",
 "209": "어...?\n그, 그건...\f",
 "210": "비・밀.",
 "211": "남한테 건드려지기 싫은\n과거란 게 있는 법이야!\f어쩔 테냐,\n신사로 둔갑한 좀도둑 씨.",
 "212": "큭...!\n이 빚은 맡겨 두지.",
 "213": "뛰어들어 버렸어!?",
 "214": "뭐, 그놈이니까.\n근처까지 동료 배가 와 있을 거다.",
 "215": "정말 감사했습니다.\n덕분에...",
 "216": "아〜!\n이 사람들, 은단검을 훔치려던 그때 그 도둑이야!",
 "217": "정말이다!\f음유시인 누나로 둔갑한\n도둑 누나!",
 "218": "난 말이야,\n그렇게 긴 이름 아니거든!",
 "219": "그 가방도\n가로챌 셈이지!?\f용서 못 해!",
 "220": "그래서 방에서 나가기 싫었던 거다.",
 "221": "테스 씨 코트는 못 준다니까!",
 "222": "이쪽도 말이야,\n그만큼 요란하게 움직여 놓고\f「고맙다」 한마디로\n끝날 성싶으냐!",
 "223": "그렇다고, 도둑질은 안 돼!",
 "224": "도둑은 도둑답게!\n그게 내 신조다!",
 "225": "샤라!",
 "226": "쥬리오!\n쫓아가!!",
 "227": "쥬리오!",
 "228": "또, 아래에서 소리가 났어.",
 "229": "그래, 대체 무슨 일이니?",
 "230": "헤스톤 씨 주변에서\n뭔가, 없어진 물건은 없나요?",
 "231": "없어진 것...\f아아!\n그러고 보니 1개 없어진 게 있다.\n금 브로치가 안 보이는구나.\f어딘가에 두고 온 것 같다만.\n뭐, 신경 안 쓰지만.",
 "232": "엇!?\n금 브로치가 없어졌어요!",
 "233": "헤스톤 씨가 그리 말해 옷깃을 보니 확실히 금 브로치는\n달려 있지 않았다.",
 "234": "하하하, 아가씨.\f그렇게 요란하게\n놀랄 정도는 아니란다.\f그런 싸구려 얼마 하지도 않으니까.",
 "235": "그, 그치만.",
 "236": "그것보다, 그 은단검 말인데.\f늘 몸에서 떼지 않고\n가지고 다니니?\f그건, 위험하구나.\n그야말로, 떨어뜨리면 큰일이지.\f바다에 빠뜨리면 그걸로 끝이고,\n선실에 엄중히 보관해 두는 편이\n안전하다고 생각한다.",
 "237": "그렇게 듣고 보면,\n확실히 그렇네.",
 "238": "그럼, 금 브로치를 찾으면\n바로 알려 드릴게요.",
 "239": "미안하구나.\f나는 이미 포기했으니,\n너무 신경 쓰지 말아 다오.",
 "240": "음, 얘기는 알겠다.\f그런가.\f크리스 군의 삼촌이라니.",
 "241": "죄송해요, 질바 선장님.",
 "242": "아무래도, 시간적 여유가 없던 데다\f경제 사정도\n절박했던 터라...\f허나, 이것도 하얀마녀의...",
 "243": "아저씨!",
 "244": "...죄송합니다.",
 "245": "뭐, 죄는 밀항뿐인 듯하고\n신원도 알고 있으니\f크게 소란 피울 것도 없겠지.",
 "246": "그래도, 죄가 되는 거죠?",
 "247": "그렇지.\n밀항자 처분은 선장에게 맡겨져 있다.\f따라서, 목적지인 닐리 항에 닿을 때까지 방에서 나가는 것은\n금지하겠다.\f닐리에 닿을 때까지 문제가 없으면 죄는 묻지 않아도 되겠지.",
 "248": "고마워요, 질바 선장님.",
 "249": "괜찮으시겠지요?\n허크 씨.",
 "250": "어쩔 수 없지요.",
 "251": "아저씨!",
 "252": "...관대한 처분, 감사합니다.",
 "253": "보스레이.\n",
 "254": "허크 씨를\n2층 창고로 안내해라.\f그 뒤엔 선창 작업으로 돌아가고.\n열쇠는 네가 갖고 있도록.",
 "255": "예스 서!",
 "256": "질바 선장님, 정말 고마워요.",
 "257": "감사합니다.",
 "258": "아니, 사례할 것 없다.\f너희 식구에\n나쁜 놈이 있을 리 없지.\f둘을 보고 있으면 잘 안다.\f그보다 쥬리오 군.\f예의 로저 씨 건은 어땠나? 뭔가 알아냈나.",
 "259": "응, 그것 말인데요.\f물건이 없어진 건, 로저 씨\n만이 아니었어요.\f헤스톤 씨도 금 브로치를\n잃어버렸대요.",
 "260": "헤스톤 씨까지?\f생각하고 싶진 않지만...\f항로를 터는 길손 도둑이\n이 배에 숨어들어\n있는지도 모른다.",
 "261": "길손 도둑이, 뭐예요?",
 "262": "아아, 여행자인 척하고\n금품을 훔치는 도둑이다.",
 "263": "흐〜음.",
 "264": "분명, 폴티아국과\n메나트국 왕도에서\f보내온 수배서가 있었지.",
 "265": "쥬리오 군.\f저기 책장에 있을 거다.\n좀 읽어 주지 않겠나?",
 "266": "실례, 선장 질바다만.\f계시는가.",
 "267": "이번엔 선장이냐?",
 "268": "실례, 질바다만.",
 "269": "네, 네〜.",
 "270": "무슨...?",
 "271": "별로 방에서 안 나오시는 듯한데. 어디 편찮으신가?",
 "272": "엇, 예에.\n일행이 뱃멀미라...",
 "273": "그것참 곤란하시겠군요.\f멀미약이 있으니\n가져오게 하지요.\f잘 듣는 약이니,\n곧 나아질 겁니다.",
 "274": "그, 그거야 고맙지만...\f",
 "275": "（농담이 아니라고.）\n（아직 아무것도 안 훔쳤는데）\n（잡힐 순 없다고.）",
 "276": "그럼, 얘들아.\f미안하지만 선장실에 가서 멀미약을 가져와 주지 않겠니.\f선반 왼쪽에 있을 테니까.",
 "277": "예스 서!",
 "278": "앗!",
 "279": "아〜정말!\n너무 끈질기면 여자한테 미움받아!",
 "280": "엇!?",
 "281": "쥬리오!\n허둥댈 때가 아니잖아!!",
 "282": "이쪽이다!",
 "283": "...난 도망치지 않아도\n되잖아.",
 "284": "발을 걸다니\n제법인데.\f난 여자에겐 상냥하지만\n공교롭게도, 18세 미만은 대상 외다!",
 "285": "메롱〜.\n가방은 받았어.",
 "286": "빠직!",
 "287": "이번엔 너냐!",
 "288": "우리를 여기까지 뛰게 하다니\n대단한 놈들이야.",
 "289": "자, 너희들.\n그 가방을 내놔.",
 "290": "애초에,\n그놈한테서 가방을 되찾은 건\n우리들이라고.",
 "291": "부탁한 적 없거든!",
 "292": "...귀여운 소리 해 주는구나. 난 여자한테는 봐주지 않아.",
 "293": "잠깐 기다려!\n어째서 수부가 저기서 자는 거야?\f...설마, 그 좀도둑이\n전원 잠재워 버린 거냐!?",
 "294": "맞아.",
 "295": "맞아라니...\f이 배는,\n그냥 떠내려가고 있는 거잖아!",
 "296": "그렇구나!\f가루가 둥지에\n들어가 버리면 큰일이야!",
 "297": "이제 와서 놀라서 뭐 하냐.\n배를 몰 줄 아는 놈은?",
 "298": "맞다!\n허크 아저씨라면.",
 "299": "누구야, 그게?\n뱃사람이야?",
 "300": "우리 아저씨야.\f좀 별나긴 하지만\n여러 가지 알고 있으니까\n도와줄지도 몰라.",
 "301": "좋아, 일시 정전이다.\f그 허크 아저씨라는 사람한테\n걸어 보자고.\f",
 "302": "...뭐야,\n그 의심하는 눈초리는.\f안심해, 약속은 지킨다.\n그게 내 신조다.",
 "303": "정말이지?\n나, 허크 아저씨를 데려올게.",
 "304": "응. 보스레이 씨가\n방 열쇠를 갖고 있을 거야.",
 "305": "다녀올게.",
 "306": "그 허크 씨라는 사람은\n믿을 만하냐?",
 "307": "...대단한 사람이란 느낌은 들어.",
 "308": "그 말을 믿어 보기로 하지.",
 "309": "아, 돌아왔어.",
 "310": "얘기는 크리스한테 들었다.\f일손이 될 수 있는 건,\n이 다섯뿐이구나.\f내가 말한 대로,\n다들 나눠서 하면\f아마, 무사히 닐리에 닿을 거다.",
 "311": "아마...라니.\n절대 자신은 없다...는 거냐?",
 "312": "아아, 그 말대로다.\f이 세상에 절대라는 것은\n절대로 없다!\f고고학도 마법학도\n모름지기, 아마인 것이다.\f게다가 나는 항해술이란 것을\n전혀 모른다.",
 "313": "이봐 이봐, 당당하게도 말하는군.",
 "314": "허나,\n큰 배를 탔다 여기게.",
 "315": "큰 배엔, 이미 타고 있잖아!\n이제부터 어쩔 셈이야?",
 "316": "그게 부탁하는 자의 태도인가?\f내 지식을 경청하겠다는\n자세가 전혀 느껴지지 않는군.",
 "317": "허크 아저씨!!\n적당히 좀 해!\f그런 말 하는 사이에도\n배는 제멋대로 나아가고 있단 말이야!",
 "318": "미안했다.\n이런 아저씨를\n버리지 말아 다오.",
 "319": "좋아!\n당장 착수해 볼까.\f쥬리오 군과 크리스는\n좌현 밧줄 있는 데로!\f그쪽 자네들은\n우현 밧줄을 부탁하네.",
 "320": "아저씨〜!\n준비 오케이야.",
 "321": "이쪽도 됐어!",
 "322": "그럼 시작해 볼까.\f이 계절, 찬바람은\n메나트국의 산바람.\f그, 그렇다면...\f해류, 편서풍의 영향을 생각해\n돛은 왼쪽 45도 언저리를 유지.\f흠흠. 항로를 벗어난 지\n대략 세 시간이라 치면...\f아마, 이 정도 수정이면 되겠지.",
 "323": "좋아, 쥬리오 군!\n그쪽 밧줄을 늦춰 다오!\f",
 "324": "자, 우현 사람들!\n그쪽은 힘껏 잡아당겨!",
 "325": "젠장...\n나한테 막일을 시키다니!",
 "326": "돛이 느슨하다!\n더, 세게 잡아당겨!",
 "327": "하고 있어!",
 "328": "이제, 손 아파.",
 "329": "쥬리오, 우는소리 하면\n겁쟁이가 돼 버려.",
 "330": "하나도 안 아파.",
 "331": "좋아, 크리스, 쥬리오 군!\n그 상태다.",
 "332": "　　　　온 하늘에 별이 빛나기 시작했지만,\n　　　　　다섯 사람은 잘 수도 없었다.\n\n　　　　　　　　　잠들어 있는\n　　　　질바 선장들은 아직 안 깨어난다.\n\n　　　　허크의 지시는 밤새 이어졌다.",
 "333": "좋아!\f저기 희미하게 보이는 건\n틀림없이,\n메나트국 해안선!!\f이제, 이걸로 안심이다.",
 "334": "어떤가!　내 지시의 정확함은!\f...어라?\n뭐야...다들 자고 있는 건가.",
 "335": "완전히 잠들고 말았다.\n아니, 면목 없구나.",
 "336": "질바 선장님, 항로는 괜찮습니다.\f쥬리오 군네가\n힘써 주었으니까요.\f도둑맞은 물건도 크리스가 되찾아\n방에 보관해 두었습니다.",
 "337": "배의 침로를 지키려고,\n다들, 밤새 일해 주었구나.",
 "338": "우리가 살아난 건\f쥬리오 군과,\n크리스 덕분이야.\f잠시 푹\n자게 해 주자.",
 "339": "정말이야.\f근데, 이런 큰일을\n해냈다고는 믿기지 않는\n앳된 잠든 얼굴이야.",
 "340": "여기는, 바람이 차니까\n감기라도 걸리면 큰일입니다.\f나눠서 선실로 옮깁시다.\f곧 보스레이 일행도\n올라올 테니\f입항 준비는\n우리에게 맡겨 주십시오.\f허크 씨도,\n정말 수고 많으셨습니다.",
 "341": "하, 하하하하!\n이것도 운명의 장난이지요!",
 "342": "하아〜.\n잘 잤다.",
 "343": "어라?\f우리,\n제대로 방에 돌아와서 잤던가?",
 "344": "나는 잠결에도\n침대까지 오는 자신은 있어.",
 "345": "...쥬리오답네.",
 "346": "종소리...?",
 "347": "분명 닐리에 닿은 거야!",
 "348": "해냈다!",
 "349": "갑판으로 올라가자.",
 "350": "응!",
