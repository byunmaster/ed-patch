{
 "0": "매발톱호",
 "1": "톤쟈",
 "2": "가톤",
 "3": "조리장",
 "4": "보스레이",
 "5": "브루트",
 "6": "로저",
 "7": "테스",
 "8": "헤스톤",
 "9": "질바 선장",
 "10": "쥬리오＆크리스",
 "11": "수부 짐",
 "12": "소리",
 "13": "이 자리의 모두",
 "18": "냠냠・・・. 새근새근・・・\n드르르르・・・드르렁・・・\f・・・푸우・・・냠냠.",
 "69": "무슨 일이야?",
 "95": "드르렁・・・.\n・・좌〜현〜타〜.",
 "96": "질바 선장님까지 푹 잠들었어.",
 "97": "어쩐지, 나쁜 예감이 드는데.",
 "98": "드르렁・・.",
 "102": "어라?　안 열리네.",
 "103": "실례합니다, 안 계세요?\n방 청소하러 왔어요.",
 "104": "（젠장.）\f（어째서 저 꼬맹이가）\n（청소하러 도는 거야.）",
 "105": "（내가 알 리 없잖아.）\f（그보다,）\n（창밖에서 들여다보면 큰일이야!）",
 "106": "안 계신가요?",
 "107": "（어쩔 수 없네.）\n（뭐라도 대답해.）",
 "108": "（내가?）",
 "109": "（너 말고 누가 있어.）",
 "110": "（칫, 어쩔 수 없군.）",
 "111": "미, 미안하지만\n낮잠 자는 중이라 청소는 됐어.\f나중에 알아서 할게.\f맡겨 둬.",
 "112": "그런가요.\n그럼, 부탁드릴게요.",
 "113": "후우・・・.\n한숨밖에 안 나오네.",
 "114": "안 들여보내 주니\n어떤 사람인지 궁금해지는걸.",
 "115": "이웃이니까\n인사 정도는 해 둬야지.",
 "116": "안녕하세요.",
 "117": "（또 왔잖아!）\n（혼쭐을 내 줄까?）",
 "118": "（바보!）\f（닐리에 닿을 때까지）\n（배에서 도망칠 수 없어.）\f（어떻게든 얼버무려.）",
 "119": "드르렁!\n드르렁, 그르렁.",
 "120": "벌써 자 버렸구나.\n근데, 굉장한 코골이네.",
 "121": "저렇게 굉장한 코골이면\n같이 있으면 잠 못 자겠어.",
 "122": "실례합니다.\n여기에 질바 선장님 안 계세요?",
 "123": "・・・・・!?\n그런 험상궂은 아저씨・・・\f아니, 선장이라면 안 왔어.",
 "124": "정말 고마워요.\n（선장님은 어디 가셨을까?）\f（여기 사람은 １번도 안 나오고.）（배 안에도 여러）\n（신기한 일이 있네.）",
 "125": "여기엔 선장님 없겠지.",
 "126": "여기 사람도 신기해.\n１번도 안 나오고・・・.\f아, 선장실에 가야지.",
 "127": "여기 사람들과는\n１번도 못 만났네.",
 "128": "어떤 사람인지 확인할\n기회잖아.\f",
 "129": "실례합니다〜.",
 "130": "또, 그 애들이야.",
 "131": "좀 봐 줘.\f이런 좁은 데\n갇혀 있는 것만으로도\n못 참겠는데.",
 "132": "저, 실례합니다.",
 "133": "정말!\n삑삑 시끄럽네.",
 "135": "어머!　괜찮아요?",
 "136": "약을 가져올까요?",
 "137": "걱정 안 해도 돼.\n튼튼한 게 유일한 장점인 남자니까.",
 "138": "그런가요.\n그럼, 몸조리 잘하시길.",
 "139": "용케 그런 거짓말이 떠오르는군.\n말투까지 바꿔 버리고.",
 "140": "너랑은, 자란 게 다르거든.",
 "141": "１번도 방에서 안 나왔으니\n여기 사람들은 상관없겠지.",
 "142": "여기 사람들은 괜찮으려나?",
 "143": "저, 실례합니다.\n무사해요?",
 "144": "무사라니 무슨 소리야?\n일행이 뱃멀미라고 했잖아!",
 "145": "무사한가 봐.",
 "146": "그러니까 무사하지 않다고!",
 "147": "（뭔가 이상해.）",
 "148": "（어떻게 된 거야?）",
 "149": "다들, 왜 그러는 걸까?",
 "150": "위험해!\n저 꼬맹이가 엿보고 있어!",
 "151": "숨는 거야!",
 "152": "어라?\f이 방 손님은\n어디 있는 걸까?",
 "153": "엄청\n부끄럼쟁이인 걸까?",
 "154": "칫!\n저 꼬맹이가 엿보고 있잖아.",
 "155": "숨는 거야!",
 "156": "뭐 하는 거야・・・.",
 "158": "너, 계속 그러고 있을 셈이야?",
 "159": "털썩.",
 "161": "정말!\n좋은 다이어트네!",
 "162": "잠깐!\n그렇게 달라붙지 마!!",
 "163": "어쩔 수 없잖아!",
 "164": "제대로 일어났으려나?",
 "165": "뭐가, 어떻게 된 거야?",
 "166": "헤스톤 씨를 쫓아야 해!",
 "167": "쥬리오는\n티라스일 항해도를 봤습니다.",
 "168": "이런 거 볼 때가 아니지.",
 "169": "이런 거 볼 때가 아니지.",
 "170": "오늘 것은, 아직 안 적었네.",
 "171": "헤스톤 씨가 도망쳐 버려!",
 "173": "크리스.\n이 상자에 말린 고기라고 써 있어.",
 "174": "배가 고픈 거지?",
 "175": "그야, 점심밥 걸렀잖아.\f라그픽 마을의\n호두파이가 먹고 싶어.",
 "176": "쥬리오, 봐!",
 "177": "우와.\n포동포동한 쥐 모자네.",
 "178": "이런, 간지럽잖아.",
 "179": "배가 고픈 거야.",
 "180": "자자, 비스킷이야.",
 "181": "크리스!\n비스킷 갖고 있어?",
 "182": "응.\n방금 걸로 끝이야.",
 "183": "실망이야.",
 "184": "허크 아저씨!!",
 "185": "아저씨!\n허크 아저씨, 괜찮아?",
 "186": "이야, 크리스.\n무슨 일 있니?",
 "187": "아저씨는 무사한가 봐.",
 "188": "저기, 아저씨.\n무슨 소리 못 들었어?",
 "189": "엇・・・?\n무슨 일 있었니.",
 "190": "뱃사람이 잠들어 버렸어!",
 "192": "목소리?",
 "193": "생각에 잠겨 있어서\n확실하다고는 못 하겠구나.",
 "194": "앗!",
 "204": "네?",
 "227": "쥬리오!",
 "229": "그래, 대체 무슨 일이니?",
 "230": "헤스톤 씨 주변에서\n뭔가, 없어진 물건은 없나요?",
 "231": "없어진 것・・・.\f아아!\n그러고 보니 １개 없어진 게 있다.\n금 브로치가 안 보이는구나.\f어딘가에 두고 온 것 같다만.\n뭐, 신경 안 쓰지만.",
 "232": "엇!?\n금 브로치가 없어졌어요!",
 "233": "헤스톤 씨가 그리 말해 옷깃을 보니 확실히 금 브로치는\n달려 있지 않았다.",
 "234": "하하하, 아가씨.\f그렇게 요란하게\n놀랄 정도는 아니란다.\f그런 싸구려 얼마 하지도 않으니까.",
 "235": "그, 그치만.",
 "237": "그렇게 듣고 보면,\n확실히 그렇네.",
 "238": "그럼, 금 브로치를 찾으면\n바로 알려 드릴게요.",
 "239": "미안하구나.\f나는 이미 포기했으니,\n너무 신경 쓰지 말아 다오.",
 "240": "음, 얘기는 알겠다.\f그런가.\f크리스 군의 삼촌이라니.",
 "241": "죄송해요, 질바 선장님.",
 "242": "아무래도, 시간적 여유가 없던 데다\f경제 사정도\n절박했던 터라・・・.\f허나, 이것도 하얀마녀의・・・.",
 "243": "아저씨!",
 "244": "・・・죄송합니다.",
 "245": "뭐, 죄는 밀항뿐인 듯하고\n신원도 알고 있으니\f크게 소란 피울 것도 없겠지.",
 "246": "그래도, 죄가 되는 거죠?",
 "247": "그렇지.\n밀항자 처분은 선장에게 맡겨져 있다.\f따라서, 목적지인 닐리 항에 닿을 때까지 방에서 나가는 것은\n금지하겠다.\f닐리에 닿을 때까지 문제가 없으면 죄는 묻지 않아도 되겠지.",
 "248": "고마워요, 질바 선장님.",
 "249": "괜찮으시겠지요?\n허크 씨.",
 "250": "어쩔 수 없지요.",
 "251": "아저씨!",
 "252": "・・・관대한 처분, 감사합니다.",
 "254": "허크 씨를\n２층 창고로 안내해라.\f그 뒤엔 선창 작업으로 돌아가고.\n열쇠는 네가 갖고 있도록.",
 "255": "예스 서!",
 "256": "질바 선장님, 정말 고마워요.",
 "257": "감사합니다.",
 "258": "아니, 사례할 것 없다.\f너희 식구에\n나쁜 놈이 있을 리 없지.\f둘을 보고 있으면 잘 안다.\f그보다 쥬리오 군.\f예의 로저 씨 건은 어땠나? 뭔가 알아냈나.",
 "259": "응, 그것 말인데요.\f물건이 없어진 건, 로저 씨\n만이 아니었어요.\f헤스톤 씨도 금 브로치를\n잃어버렸대요.",
 "260": "헤스톤 씨까지?\f생각하고 싶진 않지만・・・.\f항로를 터는 길손 도둑이\n이 배에 숨어들어\n있는지도 모른다.",
 "261": "길손 도둑이, 뭐예요?",
 "262": "아아, 여행자인 척하고\n금품을 훔치는 도둑이다.",
 "263": "흐〜음.",
 "264": "분명, 폴티아국과\n메나트국 왕도에서\f보내온 수배서가 있었지.",
 "265": "쥬리오 군.\f저기 책장에 있을 거다.\n좀 읽어 주지 않겠나?",
 "266": "실례, 선장 질바다만.\f계시는가.",
 "267": "이번엔 선장이냐?",
 "268": "실례, 질바다만.",
 "269": "네, 네〜.",
 "270": "무슨・・・?",
 "271": "별로 방에서 안 나오시는 듯한데. 어디 편찮으신가?",
 "272": "엇, 예에.\n일행이 뱃멀미라・・・.",
 "273": "그것참 곤란하시겠군요.\f멀미약이 있으니\n가져오게 하지요.\f잘 듣는 약이니,\n곧 나아질 겁니다.",
 "274": "그, 그거야 고맙지만・・・.\f",
 "275": "（농담이 아니라고.）\n（아직 아무것도 안 훔쳤는데）\n（잡힐 순 없다고.）",
 "276": "그럼, 얘들아.\f미안하지만 선장실에 가서 멀미약을 가져와 주지 않겠니.\f선반 왼쪽에 있을 테니까.",
 "277": "예스 서!",
 "280": "엇!?",
 "350": "응!",
