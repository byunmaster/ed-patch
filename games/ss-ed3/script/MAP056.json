{
 "0": "홀크요새",
 "1": "홀크 병사",
 "2": "쥬리오&크리스",
 "3": "남자 목소리",
 "4": "홀크 병사 목소리",
 "5": "산적들",
 "6": "칼리 왕비",
 "7": "베라트",
 "8": "산적 아페고",
 "9": "산적 그네스",
 "10": "산적 누라",
 "11": "산적 콘타",
 "12": "여긴 베라트 님의 방이다.\f저쪽으로 가라.",
 "13": "여긴 일반인이 들어오면\n안 되는 곳이다.\f진정되면 곧바로 나가라.",
 "14": "위험하니 들어오면 안 된다.\f어라?\n민간인이 섞여 들어온 건가.\n뭐 어때, 애들이니까.\f얼쩡거리지 마라.",
 "15": "얼쩡거리지 마라.",
 "16": "이놈, 이 안은 출입 금지다.\f애초에 이 요새가 출입 금지다.\f민간인이 이런 데를\n얼쩡거리는 게 아니다.",
 "17": "시끄러운 건 싫어요.",
 "18": "묶여 있어.\f기절한 모양이야.",
 "19": "명치를 얻어맞은 거야.\f죽은 건 아니야.",
 "20": "분명 흉포한 산적이야.\f",
 "21": "산적도 걱정이지만\n왕비님을 얼른 찾아야 해.",
 "22": "분명 흉포한 산적이야.\f",
 "23": "산적도 걱정이지만\n왕비님을 얼른 찾아야 해.",
 "24": "앗, 이 사람 의식이 있어.",
 "25": "사, 산적이..\n갑자기 덮쳐 왔다.\f밧줄을 풀어 다오...",
 "26": "어떡하지, 크리스.",
 "27": "안됐지만\n왕비님을 찾을 때까지\f이대로 계시게 하자.\f베라트 편을 들면\n우리가 곤란해지는걸...\f미안해요, 병사 아저씨.",
 "28": ".........",
 "29": "다들 묶여 있어.",
 "30": "베라트 모습은 없네.\f분명 베라트는 왕비님을 데리고\n어딘가 숨어 있는 거야.",
 "31": "얼른 왕비님을 찾자.",
 "32": ".........",
 "33": "홀크 병사는 꽁꽁 묶여서\n둘둘 감겨 있다.",
 "34": "저기, 쥬리오.\f여길 덮친 산적은\n의외로 마음이 착한지도 몰라.",
 "35": "어째서?",
 "36": "그야, 극악무도한 놈이면\n묶어 두지도 않아.\f단칼에 끝이지.",
 "37": "크리스도 참... 무서운 소리 하네.",
 "38": "불이 좀 난 모양이군.\n어디서 불이 난 걸까.",
 "39": "불씨 같은 건 없었는데.\f아아. 이래선 나무 무기는\n이제 쓸모가 없겠군.\f활도 창도 이제 글렀군.",
 "40": "얼른 왕비님을 구해 내서\n왕들에게\f신호를 보내야만 해.",
 "41": "얼른 베라트를 찾자.",
 "42": "자물쇠가 잠겼다.",
 "43": "안 돼, 쥬리오!\n그쪽으로 가면.\f모처럼 지나왔는데.",
 "44": "안 돼, 쥬리오!\n그쪽으로 가면.\f모처럼 지나왔는데.",
 "45": "쥬리오.\f봐, 요새야.\n요새로 돌입이야!",
 "46": "응.\n산적 작전이네.",
 "47": "꺄아앗!\n살려 줘어!",
 "48": "산적이 나왔다아!\n살려 줘어!",
 "49": "뭐, 산적이라고?!",
 "50": "저쪽이에요.",
 "51": "좋아.",
 "52": "퓨엔테　홀크요새",
 "53": "얼른 왕비님을 구해 내서\n왕들에게\f신호를 보내야만 해.",
 "54": "베라트니까\n요새 밖으로는 안 나갔을 거야.\f분명\n요새 안 어딘가에 숨어 있어.",
 "55": "응, 그런 느낌이 들어.",
 "56": "너희들 뭐냐?\f여긴 못 들어올 텐데.",
 "57": "아, 안녕하세요.\f저기요, 산적이 나왔어요.\f그래서 쫓겨서\n여기까지 도망쳐 왔어요.",
 "58": "엇, 산적?\f그런가. 그렇다면 어쩔 수 없지만\n너무 얼쩡거리면 안 된다.",
 "59": "여긴 일반인이 들어오면\n안 되는 곳이다.\f진정되면 곧바로 나가라.",
 "60": "어라, 너희들.",
 "61": "꽤 앞까지 보고 왔는데\n산적 따윈 없었다.",
 "62": "그, 그래요?\f도망친 걸까요...",
 "63": "이, 이상하다아.",
 "64": "구린데.",
 "65": "엇.....\f.....두근.",
 "66": "응?",
 "67": "탄내가 난다.\n뭔가 타고 있다, 이거.",
 "68": "앗, 무기고에서 연기가 난다!\f어어이, 큰일이다!\f다들 모여라아!\f무기고가 불탄다아!",
 "69": "이거 기회야.",
 "70": "그러네.\f지금이야, 왕비님 방으로\n서두르자.",
 "71": "이놈, 그쪽으로 가면 안 된다.\f나가라.",
 "72": "이 방이네.",
 "73": "문이 잠겨 있어.",
 "74": "어딘가에 열쇠가 있을 거야.",
 "75": "응.\n소중한 인질이니까.\f분명 베라트 방 안이야.",
 "76": "얼른 열쇠를 찾자.",
 "77": "열쇠는, 어디...",
 "78": "열렸어.",
 "79": "여긴 베라트 님의 방이다.\f저쪽으로 가라.",
 "80": "방화인가?\f",
 "81": "그런 수상한 자는\n이 요새엔 없을 텐데요...\f",
 "82": "누군가 숨어들었을지도 모르지.\f",
 "83": "수상한 자가 없는지\n요새 안을 철저히\f둘러보는 편이 좋겠군.",
 "84": "수상한 자가 없는지\n요새 안을 철저히\f둘러보는 편이 좋겠군.",
 "85": "선반에 베라트의 열쇠가 있다.",
 "86": "찾았어.\f이거야.",
 "87": "쥬리오 일행은 <01><37>을(를) 얻었다.",
 "88": "앗, 저런 데에 열쇠가 있어.",
 "89": "저 병사 아저씨, 덜렁대네.\n열쇠를 떨어뜨렸어.",
 "90": "자, 왕비님을 모시고\n여기서 나가자.",
 "91": "얼른 왕비님을 구해 내서\n왕들에게\f신호를 보내야만 해.",
 "92": "베라트니까\n요새 밖으로는 안 나갔을 거야.\f분명\n요새 안 어딘가에 숨어 있어.",
 "93": "응, 그런 느낌이 들어.",
 "94": "방화인가?\f",
 "95": "그런 수상한 자는\n이 요새엔 없을 텐데요...\f",
 "96": "누군가 숨어들었을지도 모르지.\f",
 "97": "수상한 자가 없는지\n요새 안을 철저히\f둘러보는 편이 좋겠군.",
 "98": "수상한 자가 없는지\n요새 안을 철저히\f둘러보는 편이 좋겠군.",
 "99": "쥬리오!\n여긴 베라트가 없어.",
 "100": "얼른 왕비님을 구하자.",
 "101": "방화인가?\f",
 "102": "그런 수상한 자는\n이 요새엔 없을 텐데요...\f",
 "103": "누군가 숨어들었을지도 모르지.\f",
 "104": "수상한 자가 없는지\n요새 안을 철저히\f둘러보는 편이 좋겠군.",
 "105": "어머, 누구시죠?",
 "106": "칼리 왕비님이시죠?",
 "107": "저흰 캐라크 왕의 부탁으로\n왕비님을 구하러 왔어요.",
 "108": "저를...?\n구한다니, 어째서요?\f저는 딱히\n붙잡힌 건 아닌 것 같은데요.",
 "109": "어라라...?",
 "110": "저, 왕비님은\n여기에 갇혀서\f계셨던 거죠?",
 "111": "그래요, 베라트도 참\n너무해요.\f루피나스 호수의 새 별장에서\n느긋하게 쉬시라고\n그렇게 권해 놓고선\f저를 이 방에서 내보내\n주질 않는 거예요.",
 "112": "칼리 왕비에게는\n자신이 인질이 되었다는 자각이 전혀\n없는 모양이다.",
 "113": "쥬리오 일행은 베라트의 계략을\n칼리 왕비에게 설명했다.",
 "114": "어머, 그랬던 거군요.\f어쩐지 베라트가\n저를 여기서 내보내 주지 않는\n거였네요.",
 "115": "아무튼\n베라트한테 들키지 않게,\f여기서 얼른 나가는 게 좋아요.",
 "116": "하이젠 쪽에도 이미 설명해\n뒀어요.\f저희가 왕비님의 안전을 알리면\n캐라크 왕과 에네톤 왕이\n와 주시기로 되어 있어요.",
 "117": "어머, 그러셨군요.\f알겠어요.\n그럼, 당장 가 보죠.",
 "118": "어디로 갈 셈이지?\n무기를 태운 건 너희들이렷다?\f누구냐?",
 "119": "당신이 베라트구나.\n그쪽이야말로 누구야?",
 "120": "퓨엔테를\n어쩔 셈이야?",
 "121": "쓸데없는 데까지 머리가 도는군.\f그렇다면, 이대로 돌려보낼 수도\n없겠군. 어쨌든, 너희들의\n계획은 여기까지다.",
 "122": "이놈들을 모두 가둬 둬라.",
 "123": "왕비님도요?",
 "124": "물론이다.\f수상한 자들과\n함께 있지 않았느냐.\f아무리 왕비라 해도, 예외는 없다.\f참, 그리고 열쇠는\n돌려받겠다.",
 "125": "쥬리오 일행은 <01><37>을(를)\n빼앗겼다.",
 "126": "붙잡혔어.",
 "127": "어떡하지...",
 "128": "왕들은\n지금쯤 벌써 요새 밖에서\f목이 빠지게 기다릴지도 몰라.",
 "129": "자자\n서두르지 않아도 괜찮아요.\f어떻게든 되겠지요.",
 "130": "그 아이들은 뭐 하는 자들이지...\f내 계획을 눈치챈\n모양이지만...\f뭐, 됐다.\f어느 쪽이든\n지금 소동을 일으키면 좋지 않다.\f이쪽 준비가 갖춰질 때까지는\n왕비와 함께\n인질로 살려 두는 수밖에...",
 "131": "됐어, 샤라.",
 "132": "좋아, 와.",
 "133": "알겠습죠, 누님.",
 "134": "앗... 이놈들.\n누가 한꺼번에 다 오랬어.",
 "135": "미안하우, 누님.",
 "136": "미안혀.",
 "137": "헤헤헷.",
 "138": "뭐 하는 거야... 저놈들.\f어이, 얼른 이쪽으로 와.",
 "139": "으윽!\n",
 "140": "이놈들...\n한꺼번에 오지 말랬잖아.",
 "141": "또 저질렀네.",
 "142": "미안하우, 누님.",
 "143": "미안혀.",
 "144": "헤헤헷.",
 "145": "알겠냐, 실수하지 마라.\f우리 첫 일거리다.\n헛발질하지 말라고.",
 "146": "이런 데에 요새를 세우다니,\f어차피 나쁜 꿍꿍이라도\n꾸미고 있겠지.\f사양 말고 값나가는 걸 가져가자.",
 "147": "알겠습죠.",
 "148": "요새라면 꽝은 없지.\f보물은 없어도\n무기라면 잔뜩 있을 거다.\f아무것도 없으면\n무기를 챙겨서\n팔아 치우면 되니까.",
 "149": "역시 형님이여.\n머리 좋구먼.",
 "150": "그렇지.\f나답지 않게 조사는\n해 뒀거든.\f창고는 북동쪽 방이다.\n예습은 완벽하다고.\f간다.",
 "151": "(앗...?!)",
 "152": "(젠장...)",
 "153": "아야야야... 아파.\n",
 "154": "뭐냐?",
 "155": "이놈, 누구냐?",
 "156": "우아아아아앗!",
 "157": "앗, 서라. 이놈!\n붙잡아라아!",
 "158": "저놈, 괜찮은 거냐...",
 "159": "걱정 없습죠.\n저놈, 발 하나는 빠릅죠.",
 "160": "쥬리오 같은 놈이네...",
 "161": "그럼, 괜찮겠군.\f좋은 미끼가 되지.\n일을 계속하자고.",
 "162": "우오오오오...!\n",
 "163": "어이, 거기 서라!\n",
 "164": "밖이 시끄러워.",
 "165": "뭘까?",
 "166": "무슨 일이 생긴 거 아닐까.",
 "167": "시끄럽네요.",
 "168": "저기요, 위병.",
 "169": "예, 예?",
 "170": "저기, 당신.\n가서 보고 오세요.",
 "171": "옛, 저는 보초라서...",
 "172": "보초지만 병사잖아요?\f",
 "173": "저는 왕비잖아요.\n말을 못 듣겠다는 건가요?",
 "174": "아뇨, 그럴 리가...",
 "175": "그럼, 가서 보고 오세요.",
 "176": "옛, 예.\n당장 보고 오겠습니다.",
 "177": "이게 뭐야아?",
 "178": "타 버렸어요.",
 "179": "이럴 수가...",
 "180": "창도 활도 글렀어.\n깨끗이 잿더미가 됐구먼.",
 "181": "어째서 여기가 불타는 거야.\f어째서야, 어째서야\n어째서냐고.\f불 지른 놈을 찾아내면\n가만두지 않겠어...\f",
 "182": "........\n좋았어. 될 대로 되라지.\f요새 안을 이 잡듯 뒤져서\n무슨 일이 있어도..으〜음.\n보물을 손에 넣겠다!",
 "183": "알겠습죠오!",
 "184": "거치적대는 병사는 봐주지 말고\n꽁꽁 묶어 버려!",
 "185": "오오!",
 "186": "산적이다아!\n",
 "187": "산적이라고?",
 "188": "엇, 정말 나온 거야?",
 "189": "기회야, 쥬리오.\f왕비님을 모시고 탈출하자.",
 "190": "응, 근데 어떻게\n탈출하는데?",
 "191": "억지로 열면 되잖아.",
 "192": "근데 튼튼해 보였어.",
 "193": "아무튼 문을 살펴보자.",
 "194": "이놈, 게 서라.\n",
 "195": "앗, 저 산적 알아.",
 "196": "어머, 친구인가요?",
 "197": "아니에요.\f전에 습격당했어요.",
 "198": "서두르자.",
 "199": "네네.",
 "200": "앗?!",
 "201": "왕비님...",
 "202": "산적 소동을 틈타 달아나려 하다니\n그렇게는 안 되죠.",
