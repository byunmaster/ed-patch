{
 "0": "홀크요새",
 "1": "홀크 병사",
 "2": "쥬리오＆크리스",
 "3": "소리",
 "4": "홀크 병사 목소리",
 "5": "산적들",
 "6": "카리 왕비",
 "7": "베라트",
 "8": "산적아페고",
 "9": "산적그네스",
 "10": "산적누라",
 "11": "산적콘타",
 "12": "여긴 베라트 님의 방이다.\f저쪽으로 가라.",
 "13": "여긴 일반인이 들어오면\n안 되는 곳이다.\f진정되면 곧바로 나가라.",
 "14": "위험하니 들어오면 안 된다.\f어라?\n민간인이 섞여 들어온 건가.\n뭐 됐나, 애들이니까.\f얼쩡거리지 않도록 해라.",
 "15": "얼쩡거리지 않도록 해라.",
 "16": "이놈, 이 안은 출입 금지다.\f애초에 이 요새가 출입 금지다.\f민간인이 이런 데를\n얼쩡거리는 게 아니다.",
 "17": "시끄러운 건 싫어요.",
 "18": "묶여 있어.\f기절한 모양이야.",
 "19": "명치를 얻어맞은 거야.\f죽은 건 아니야.",
 "20": "산적도 걱정이지만,\n왕비님을 얼른 찾아야 해.",
 "21": "산적도 걱정이지만,\n왕비님을 얼른 찾아야 해.",
 "22": "앗, 이 사람, 의식이 있어.",
 "23": "사, 산적이・・\n갑자기 덮쳐 왔다.\f밧줄을 풀어 다오・・・.",
 "24": "어떡하지, 크리스.",
 "25": "안됐지만,\n왕비님을 찾을 때까지\f이대로 계시게 하자.\f베라트 편을 들면,\n우리가 곤란해지는걸・・・.\f미안, 병사 아저씨.",
 "26": "다들 묶여 있어.",
 "27": "베라트 모습은 없네.\f분명, 베라트는 왕비님을 데리고 어딘가 숨어 있는 거야.",
 "28": "얼른, 왕비님을 찾자.",
 "29": "홀크 병사는, 꽁꽁 묶여서\n둘둘 감겨 있다.",
 "30": "저기, 쥬리오.\f여길 덮친 산적은,\n의외로 마음이 착한지도 몰라.",
 "31": "어째서?",
 "32": "왜냐면, 극악무도하면\n묶어 두거나 하지 않아.\f대뜸 싹둑이지.",
 "33": "크리스는・・・무서운 소리 하네.",
 "34": "작은 불인 모양이군.\n어디서 불이 난 걸까.",
 "35": "불씨 같은 건 없었는데.\f아아. 이래선, 나무 무기는\n이제, 쓸모가 없겠군.\f활도 창도, 이제 글렀군.",
 "36": "얼른 왕비님을 구해 내서,\n왕들에게\f신호를 보내야만 해.",
 "37": "얼른, 베라트를 찾자.",
 "38": "열쇠가 걸려 있다.",
 "39": "안 돼, 쥬리오!\n그쪽으로 가면.\f모처럼 지나왔는데.",
 "40": "안 돼, 쥬리오!\n그쪽으로 가면.\f모처럼 지나왔는데.",
 "41": "쥬리오.\f봐, 요새야.\n요새로 돌입이야!",
 "42": "응.\n산적 작전이네.",
 "43": "꺄아앗!\n살려 줘어!",
 "44": "산적이 나왔다아!\n살려 줘어!",
 "45": "뭐, 산적이라고?!",
 "46": "저쪽이야.",
 "47": "좋아.",
 "48": "퓨엔테국　홀크요새",
 "49": "얼른 왕비님을 구해 내서,\n왕들에게\f신호를 보내야만 해.",
 "50": "베라트니까\n요새 밖으로는 안 나갔을 거야.\f분명,\n요새 안 어딘가에 숨어 있어.",
 "51": "응, 그런 느낌이 들어.",
 "52": "너희들 뭐냐?\f여긴 못 들어올 텐데.",
 "53": "아, 안녕하세요.\f저기요, 산적이 나왔어요.\f그래서 쫓겨서,\n여기까지 도망쳐 왔어요.",
 "54": "엇, 산적?\f그런가. 그렇다면 어쩔 수 없지만,\n너무 얼쩡거리면 안 된다.",
 "55": "여긴 일반인이 들어오면\n안 되는 곳이다.\f진정되면 곧바로 나가라.",
 "56": "어라, 너희들.",
 "57": "꽤 앞까지 보고 왔는데\n산적 따윈 없었다.",
 "58": "그, 그래.\f도망친 걸까・・・.",
 "59": "이, 이상하다아.",
 "60": "냄새나.",
 "61": "엇・・・・・.\f・・・・・두근.",
 "62": "응?",
 "63": "탄내가 난다.\n뭔가 타고 있다, 이거.",
 "64": "앗, 무기고에서 연기가 난다!\f어어이, 큰일이다!\f다들 모여라아!\f무기고가 불탄다아!",
 "65": "이거 기회야.",
 "66": "그러네.\f지금이야, 왕비님 방으로\n서두르자.",
 "67": "이놈, 그쪽으로 가면 안 된다.\f나가라.",
 "68": "이 방이네.",
 "69": "열쇠가 잠겨 있어.",
 "70": "어딘가에 열쇠가 있을 거야.",
 "71": "응.\n소중한 인질이니까.\f분명, 베라트 방 안이야.",
 "72": "얼른 열쇠를 찾자.",
 "73": "열쇠는, 하고・・・.",
 "74": "열렸어.",
 "75": "여긴 베라트 님의 방이다.\f저쪽으로 가라.",
 "76": "수상한 자가 없는지,\n요새 안을 철저히\f둘러보는 편이 좋겠군.",
 "77": "수상한 자가 없는지,\n요새 안을 철저히\f둘러보는 편이 좋겠군.",
 "78": "선반에 베라트의 열쇠가 있다.",
 "79": "있었어.\f이거야.",
 "80": ", 손에 넣었다.",
 "81": "저, 저런 데에 열쇠가 있어.",
 "82": "저 병사 아저씨, 어설프네.\n열쇠를 떨어뜨렸어.",
 "83": "자, 왕비님을 모시고\n여기서 나가자.",
 "84": "얼른 왕비님을 구해 내서,\n왕들에게\f신호를 보내야만 해.",
 "85": "베라트니까\n요새 밖으로는 안 나갔을 거야.\f분명,\n요새 안 어딘가에 숨어 있어.",
 "86": "응, 그런 느낌이 들어.",
 "87": "수상한 자가 없는지,\n요새 안을 철저히\f둘러보는 편이 좋겠군.",
 "88": "수상한 자가 없는지,\n요새 안을 철저히\f둘러보는 편이 좋겠군.",
 "89": "쥬리오!\n여긴, 베라트는 없어.",
 "90": "얼른 왕비님을 구하자.",
 "91": "수상한 자가 없는지,\n요새 안을 철저히\f둘러보는 편이 좋겠군.",
 "92": "어머, 당신들은?",
 "93": "카리 왕비님이시죠.",
 "94": "저흰 캐라크 왕의 심부름으로\n왕비님을 구하러 왔어요.",
 "95": "저를・・・?\n구한다니, 어째서요?\f저는 딱히\n붙잡힌 건 아닌 것 같은데요.",
 "96": "어라라・・・?",
 "97": "저, 왕비님은,\n여기에 갇혀서\f계셨던 거죠?",
 "98": "그래요, 베라트도 참\n너무해요.\f루피나스 호수의 새 별장에서\n느긋하게 쉬는 게 어떠냐,\n그런 식으로 권해 놓고선\f저를 이 방에서 내보내\n주질 않는 거예요.",
 "99": "카리 왕비에게는\n자신이 인질이 되었다는 자각이 전혀 없는 모양이다.",
 "100": "쥬리오 일행은 베라트의 계략을 카리 왕비에게 설명했다.",
 "101": "어머, 그랬던 거군요.\f어쩐지 베라트가\n저를 여기서 내보내 주지 않는\n거였네요.",
 "102": "아무튼,\n베라트한테 들키지 않게,\f여기서 얼른 나가는 게 좋아요.",
 "103": "하이젠 쪽에도, 이미 설명해\n뒀어요.\f저희가 왕비님의 안전을 알리면, 캐라크 왕과 에네톤 왕이\n와 주시기로 되어 있어요.",
 "104": "어머, 그러셨군요.\f알겠어요.\n그럼, 당장 가 보죠.",
 "105": "어디로 갈 셈이지.\n무기를 태운 건 너희들이렷다?\f누구냐?",
 "106": "당신이 베라트로군.\n그쪽이야말로 누구야?",
 "107": "퓨엔테국을\n어쩔 셈이야.",
 "108": "쓸데없는 데까지 머리가 도는군.\f그렇다면, 이대로 돌려보낼 수도\n없겠군. 어쨌든, 너희들의\n계획은 여기까지다.",
 "109": "이놈들을 전원 가둬 둬라.",
 "110": "왕비님도요?",
 "111": "물론이다.\f수상한 자들과\n행동을 함께하고 있었다.\f아무리 왕비라 해도, 예외는 없다.\f참, 그리고, 열쇠는\n돌려받겠다.",
 "112": ",\n빼앗겼다.",
 "113": "잡혀 버렸어.",
 "114": "어떡하지・・・.",
 "115": "왕들도,\n분명, 벌써 요새 밖에서\f목이 빠지게 기다릴지도 몰라.",
 "116": "자자,\n서두르지 않아도 괜찮아요.\f될 대로 될 뿐이에요.",
 "117": "그 아이들은 뭐하는 자들이지・・・.\f내 계획을 눈치챈\n모양이지만・・・.\f뭐, 됐다.\f어느 쪽이든,\n지금 소동을 일으키는 건 좋지 않다.\f이쪽 준비가 갖춰질 때까지는,\n왕비와 함께,\n인질로 살려 두는 수밖에・・・.",
 "118": "좋다고, 샤라.",
 "119": "좋아, 와.",
 "120": "알겠습죠, 누님.",
 "121": "앗・・・이놈들.\n누가 한꺼번에 다 오랬어.",
 "122": "미안하우, 누님.",
 "123": "미안혀.",
 "124": "헤헤헷.",
 "125": "뭐 하는 거야・・・저놈들.\f야, 얼른 이쪽으로 와.",
 "126": "으윽!\n",
 "127": "이놈들・・・.\n한꺼번에 오지 말랬잖아.",
 "128": "또, 해 버렸네.",
 "129": "미안하우, 누님.",
 "130": "미안혀.",
 "131": "헤헤헷.",
 "132": "알겠냐, 실수하지 마라.\f우리 첫 일거리다.\n헛발질하지 말라고.",
 "133": "이런 데에 요새를 세우다니,\f어차피 나쁜 꿍꿍이라도\n꾸미고 있는 거야.\f사양 말고 값나가는 걸 가져가자.",
 "134": "알겠습죠.",
 "135": "요새라면 꽝은 없지.\f보물은 없어도\n무기라면 잔뜩 있을 거다.\f아무것도 없으면,\n무기를 챙겨서\n팔아 치우면 되니까.",
 "136": "역시 형님이여.\n머리가, 좋아.",
 "137": "그렇지.\f나답지 않게, 조사는\n해 뒀거든.\f창고는 북동쪽 방이다.\n예습은 완벽하다고.\f간다.",
 "138": "（앗・・・?!）",
 "139": "（젠장・・・.）",
 "140": "아야야야・・・아파.\n",
 "141": "뭐냐?",
 "142": "이놈, 누구냐?",
 "143": "우아아아아앗!",
 "144": "앗, 서라. 이놈!\n붙잡아라아!",
 "145": "저놈, 괜찮은 거냐・・・.",
 "146": "걱정 없습죠.\n저놈, 발만은 빠르니까요.",
 "147": "쥬리오 같은 놈이네・・・.",
 "148": "그럼, 괜찮겠군.\f좋은 미끼가 되지.\n일을 계속하자고.",
 "149": "우오오오오・・・!\n",
 "150": "야, 기다려라!\n",
 "151": "밖이 시끄러워.",
 "152": "뭘까?",
 "153": "무슨 일이 생긴 거 아닐까.",
 "154": "시끄럽네요.",
 "155": "잠깐, 위병.",
 "156": "예, 예?",
 "157": "잠깐, 그대.\n가서 보고 오세요.",
 "158": "옛, 저는 보초라서・・・.",
 "159": "보초지만 병사잖아요?\f",
 "160": "저는 왕비잖아요.\n말을 못 듣겠다는 건가요.",
 "161": "아뇨, 그런 일은・・・.",
 "162": "그럼, 가서 보고 오세요.",
 "163": "옛, 예.\n당장, 보고 오겠습니다.",
 "164": "이게 뭐야아?",
 "165": "타 버렸어요.",
 "166": "허어엉・・・.",
 "167": "창도 활도 글렀구먼.\n깨끗이 잿더미가 됐구먼.",
 "168": "어째서 여기가 불타는 거야.\f어째서야, 어째서야,\n어째서냐고.\f불 지른 놈을 찾아내면,\n가만두지 않겠어・・・.\f",
 "169": "・・・・・・・・.\n좋았어. 될 대로 되라지.\f요새 안을 이 잡듯 뒤져서,\n무슨 일이 있어도・・으〜음.\n보물을 손에 넣겠다!",
 "170": "알겠습죠오!",
 "171": "거치적대는 병사들은 상관없으니까\n꽁꽁 묶어 버려!",
 "172": "오오!",
 "173": "산적이다아!\n",
 "174": "산적이라고요?",
 "175": "엇, 정말 나온 거야.",
 "176": "기회야, 쥬리오.\f왕비님을 모시고 탈출하자.",
 "177": "응, 근데 어떻게\n탈출하는데?",
 "178": "비집어 열면 되잖아.",
 "179": "근데 튼튼해 보였어.",
 "180": "아무튼 문을 살펴보자.",
 "181": "이놈, 게 서라.\n",
 "182": "앗, 저 산적 알아.",
 "183": "어머, 친구인가요?",
 "184": "아니에요.\f전에 습격당했어요.",
 "185": "서두르자.",
 "186": "네네.",
 "187": "앗?!",
 "188": "왕비님・・・.",
 "189": "산적 소동을 틈타 달아나려 하다니, 그렇게는 안 되죠.",
