{
 "0": "타라타호",
 "1": "어부 토바이",
 "2": "인타",
 "3": "에메나",
 "4": "림",
 "5": "비아노",
 "6": "쥬리오＆크리스",
 "7": "뭐라도 먹여 주겄어.",
 "8": "『캡틴 토마스』는\n최고여.\f나도 어부가 아니었으면\n일곱 바다를 누비며\n대모험을 했을 텐디.",
 "9": "저도 『캡틴 토마스』\n정말 좋아해요.",
 "10": "해적왕 라몬과의\n마지막 승부 장면 같은 건\n몇 번을 읽어도 두근거려요.",
 "11": "그래. 그렇지, 그렇지.\n역시 좋제.\f여자애는 모를 것이여.",
 "12": "근데 크리스는 달라요.",
 "13": "무슨 뜻이야?",
 "14": "걱정 안 해도\n느긋하게 있으면\f타라타호가 안전하게\n네갈섬 항구까지 데려다줄 것이여.",
 "15": "됐으니까 얼른 가서\n볼일을 마치고 오더라고.",
 "16": "오, 볼일은 끝났냐?",
 "17": "그게요, 토바이 씨.",
 "18": "미안해요.\n조금 더 걸릴 것 같아요.",
 "19": "그려. 아직 괜찮여.\n서두르지 않아도 되야.\f나는 여기서 기다릴 텡께.\n아직 이삼 일은\n유빙으로 바다가 메워질 일도\f없을 것이여.",
 "20": "기다려 줄 텡께\n안심혀.",
 "21": "오, 이제 됐냐?\n언제든 출항할 수 있어야.",
 "22": "저기, 토바이 씨.\f실은 또 태워 달라는 사람이\n있는데, 괜찮을까요?",
 "23": "나는 상관없어야.\f가는 김에 태워 주제.\n데려오더라고.",
 "24": "고마워요.",
 "25": "인타 녀석, 너무 기운이 넘쳐.\f줄곧 혼자서\n해적 놀이를 하고 있어야.",
 "26": "배 항로라면 걱정 없어야.\f맞다. 치타 가는 길 무너진 데는\n아직 안 고쳐졌을 텡께\n무너진 데 너머까지,\f배로 데려다주겄어.",
 "27": "고마워요, 살았어요.",
 "28": "고마워요.\f",
 "29": "돌아갈 땐 바람이 반대라 말이여.\f붙어서 안 보고 있으면\n배가 말을 안 듣는당께.",
 "30": "돌아갈 땐 바람이 반대라 말이여.\f붙어서 안 보고 있으면\n배가 말을 안 듣는당께.",
 "31": "와〜아, 와〜아!",
 "32": "저기, 나는\n캡틴 토마스야.",
 "33": "나쁜 해적 라몬은\n저 돛대 아래에 잡아 뒀어.",
 "34": "왜 내가 라몬인 거여...",
 "35": "엄마.\n나, 해적 라몬을 잡았어.",
 "36": "어머 어머...\n토바이 씨\n죄송해요.",
 "37": "헤엥!\n괜찮다니께.\f어차피 나는 라몬 역이제.",
 "38": "와하하하하...!\n라몬은 달아났다아!",
 "39": "앗, 서라아!",
 "40": "토바이 덕분에 메나트 대륙으로 가는\n항해는 즐겁게 이어졌다.\f쥬리오 일행은 새삼스레\n여행지에서 만나는 사람들의\n따스함을 느꼈다.",
 "41": "이윽고 대륙이 가까워졌다.",
 "42": "눈앞에 메나트 대륙의 절벽이\n다가왔다.\f토바이는 쥬리오 일행이\n치타로 갈 수 있도록\n알데 항에 배를 대는 게 아니라\f벼랑 무너진 곳을 넘은 자리에\n배를 대 주기로 했다.",
 "43": "에메나 모자는\n한동안 알데에서 지내다,\f자리를 잡고 나서\n닐리로 가기로 했다.\f상냥한 닐리 사람들이라면\n인타를 따뜻이 맞아 주리라고\n쥬리오는 생각했다.",
 "44": "좋았어, 쥬리오, 크리스.",
 "45": "저 절벽 아래에 댈 거여!\n준비는 됐냐?",
 "46": "준비됐어요!",
 "47": "근데 저 험한 절벽을\n오를 수 있어요?",
 "48": "그려, 의외로 쉽게\n오를 방법이 있당께.",
 "49": "뭔데요?",
 "50": "타라타호 돛대를 타고\n올라가면 되야.",
 "51": "뭐, 너희들이라면\n그 정도는 괜찮을 것이여.",
 "52": "해냈다!",
 "53": ".......",
 "54": "고향인 네갈섬을 떠나\n대륙으로 건너가도,\f앞으로 고생할 건\n각오하고 있어요.\f그래도 인타를 위해서라도\n힘내야죠.",
 "55": "나는 림.\n인타의 형님뻘이야!",
 "56": "나는 비아노.\n창고지기야.",
 "57": "나는 임시 로디.\f설 자리를 정하려고\n고용됐어.",
 "58": "나는, 정지 림.",
 "59": "나는, 정지 비아노.",
 "60": "자는 인타다아!",
 "61": "이 돛대\n못 오르려나?",
 "62": "그만둬, 크리스.\f정말 말괄량이라니까...",
 "63": "알고 있다니까\n안 오를 테니 안심해.",
 "64": "그래도 내가 배에서 제일 좋아하는\n곳은 돛대 위야.\f기억해 둬.",
 "65": "기억하는 거야 좋지만\n그런 걸 기억해서 뭐 하게.",
 "66": "내가 배에서 제일 좋아하는 곳은\n돛대 위야.\f기억해 둬.",
 "67": "기억하는 거야 좋지만\n그런 걸 기억해서 뭐 하게.",
 "68": "역시 배는\n이 자리가 제일 좋네.",
 "69": "매발톱호의 질버 선장님도\n이 경치가 마음에 들어\n선장이 되려고 했다더라.",
 "70": "캡틴 토마스도\n이렇게 여기에\n서 있었겠지...",
 "71": "역시 배는\n이 자리가 제일 좋네.",
 "72": "타라타호 명물\n보리밥 해산물카레 필라프여.\f맛있당께.",
 "73": "우와아, 맛있겠다!",
 "74": "잘 먹겠습니다아!\f냠냠냠냠...\n냠냠냠냠...\f...냠냠냠냠\n...냠냠냠냠\n냠냠냠...냠\f냠냠냠...",
 "75": "후우...",
 "76": "아〜, 맛있었다.",
 "77": "잘 먹었습니다!",
 "78": "그치, 맛있었제.",
 "79": "네, 엄청 맛있었어요.",
 "80": "저기, 쥬리오.\f통만 보면 왠지 허크 삼촌이\n튀어나올 것 같아.",
 "81": "그래도 난 또 만나고 싶어.",
 "82": "어머, 나도 그래.\f허크 삼촌은\n좀 별나지만\n난 정말 좋아.",
 "83": "응, 나도 좋아해.",
 "84": "앗?\n저...저건 뭐지!",
 "85": "우와아.\n뭐지, 굉장해.",
 "86": "어〜이, 왜 그러냐?",
 "87": "토, 토, 토바이 씨!\n저거...뭐죠?",
 "88": "토바이 씨!\n저건 뭐예요?",
 "89": "저, 저건...설마.\f그런...말도 안 돼...",
 "90": "네갈섬 앞바다를\n거대한 혹 같은 것이\n남쪽을 향해 이동하고 있었다.",
 "91": "...마치\n산이 바다를 건너는 것 같아...",
 "92": "틀림없어!　가루가여...",
 "93": "에엣?!",
 "94": "가루가.....?!",
 "95": "가루가라고?!",
 "96": "작은 순례자 쥬리오와 크리스는\n제2의 샤리네가 있는\n네갈섬으로 가는 배 위에서\f해수 가루가를 목격한 것이었다.\n　　　　　서장　작은 순례자　끝",
 "97": "저...정말로...\n가루가가...나왔어...",
 "98": "네...네갈섬이...\n테그라가 습격당한 거여...",
 "99": "가루가라니...\f사람은 습격하지\n않는다고 했잖아.",
 "100": "저놈, 어디로 헤엄쳐 갈\n셈일까?",
 "101": "저쪽은 메나트의 수도\n넬바 방향이여.",
 "102": "이거, 큰일이구먼.\n저런 놈이 습격해 오면,\f사람이 만든 성 따위\n한 방에 날아가 부러.\f상륙하려나...",
 "103": "어라?\n",
 "104": "크리스, 토바이 씨.",
 "105": "봐요, 저기!",
 "106": "엇?　뭔데.",
 "107": "봐, 사람이 타고 있어.\n불러 볼까?",
 "108": "어〜이, 어〜이!",
 "109": "어〜이!",
 "110": "칫\n가 버렸어.",
 "111": "가 버렸네.",
 "112": "그건 그렇고\n저 작은 배에 타고 있던 사람.\f무척 심각한 얼굴이었어.",
 "113": "분명, 가루가한테 엉망이 된\n테그라 마을 사람이여.",
 "114": "심각한 얼굴도 되겄제.",
 "115": "네. 그렇겠네요.",
 "116": "그보다\n슬슬 네갈섬에 닿겄어.\f내릴 준비를 하더라고.",
 "117": "네!",
 "118": "얼마 뒤\n쥬리오 일행을 태운 타라타호는\f무사히 네갈섬 선착장에\n도착할 수 있었다.\f가루가의 피해가 걱정이었지만\n보아하니 선착장에\n피해는 없는 듯했다.",
 "119": "테그라 샤리네는 이제 가깝다.\n여기까지 온 이상\f샤리네가 가루가에게\n부서지지 않았기를\n빌 뿐이다.\f쥬리오와 크리스는 조급한 마음을\n누르고 타라타호를 뒤로했다.",
 "120": "책장에 책이 있다.\f『캡틴 토마스』 책이다.",
 "121": "표지에는\n《캡틴 토마스의 대항해》\n라고 적혀 있다.\f쥬리오가 아주 좋아하는 이야기다.",
 "122": "조금 길지만, 읽어 보시겠어요?",
 "123": "쥬리오는\n손에 들고 책을 펼쳐 보았다.",
 "124": "쥬리오는 토바이도\n『캡틴 토마스』 팬이라는 걸 알고\f조금 기분이 좋아졌다.",
 "125": "디버그용 이벤트에 들어갑니다.",
 "126": "방 안에서 인타가\n누워 있는 모양이다.",
 "127": "무슨 일이에요, 토바이 씨?\n인타가 어디 아파요?",
 "128": "뱃멀미인 것 같여.",
 "129": "타라타호는\n여객선이 아니라 약도 없고,",
 "130": "항구에 닿을 때까지\n참을 수밖에 없구먼.",
 "131": "그렇지, 쥬리오.\f질버 선장께 받은\n멀미약 있었잖아!",
 "132": "맞다\n약이라면 있어.",
 "133": "쥬리오는 짐 속에서\n멀미약을 꺼내\n크리스에게 건넸다.",
 "134": "뭐여, 멀미약을\n",
 "135": "갖고 있었구먼.\f잘됐구먼. 자, 얼른 먹여 주랑께.\n뱃멀미쯤, 금방 나을 것이여.\f그럼.",
 "136": "나는 배 항로를\n지켜봐야 하니께.\n갑판에 올라가 있겄어.",
 "137": "어쩐지 나, 속이 안 좋아...",
 "138": "인타도 참, 배를 탈 수 있다고\n그렇게나 기뻐했는데...\f괜찮을까.",
 "139": "어머?　약이 있나요?",
 "140": "네, 멀미약이에요.\f이걸 인타에게 먹여 주세요.\n금방 좋아질 거예요.",
 "141": "크리스는 <01><1E>\n에메나에게 줬다.",
 "142": "이렇게까지 해 주시고\n정말 감사합니다.\f당장 먹여 볼게요.\f",
 "143": "에메나는 멀미약을\n인타에게 먹였다.",
 "144": "부르르〜웅!\n아히이.",
 "145": "이 약, 엄청 잘 듣나 봐.\f나, 속 안 좋던 게\n싹 나았어!",
 "146": "와아.\f나아 버렸다.\n나아 버렸다.\f고마워.\n형아, 누나!\f엄마\n나 놀다 올게에!",
 "147": "어머, 저 애도 참...\f정말 감사합니다.",
 "148": "참.",
 "149": "이걸 받아 주세요.",
 "150": "에메나는 보리가 든 자루를\n꺼냈다.",
 "151": "한 번 끓였다가 말린 보리예요.\f여행길 식량으로는\n아주 좋답니다.\n비상식 삼아 가져가 주세요.",
 "152": "와.\f받아도\n되나요?",
 "153": "고마워요, 에메나 씨.",
 "154": "쥬리오 일행은\n<01><21> 받았다.",
 "155": "고향인 네갈섬을 떠나\n대륙으로 건너가도,\f앞으로 고생할 건\n각오하고 있어요.\f그래도 인타를 위해서라도\n힘내야죠.",
 "156": "쥬리오, 그쪽은 바다야!\f정말, 못 말리는 길치라니까.",
 "157": "......",
 "158": "됐으니까 얼른 가서\n볼일을 마치고 오더라고.",
 "159": "아직 괜찮여.\n서두르지 않아도 되야.\f나는 여기서 기다릴 텡께.\n아직 이삼 일은\n유빙으로 바다가 메워질 일도\f없을 것이여.",
 "160": "기다려 줄 텡께\n안심혀.",
 "161": "오, 이제 됐냐?\n언제든 출항할 수 있어야.",
 "162": "저기, 토바이 씨.\f실은 또 태워 달라는 사람이\n있는데, 괜찮을까요?",
 "163": "나는 상관없어야.\f가는 김에 태워 주제.\n데려오더라고.",
 "164": "고마워요.",
 "165": "이제 괜찮여.",
 "166": "바다에 나가 부리면\n내 세상이제.\f이 바다는 내 마당 같은 것이여.",
 "167": "(꼬르륵...꼬르르륵...!)",
 "168": "쥬리오의 배가 울렸다.",
 "169": "바다표범도\n배가 고팠던 걸까.",
 "170": "쥬리오\n너, 배고픈 거냐?",
 "171": "네, 배고파요.",
 "172": "그러고 보니\n닐리 항에 닿고부터,\f식사다운 식사를\n못 했었지.",
 "173": "어쩐지 나도\n배가 고파졌어.",
 "174": "그럼 좀 이르지만\n밥이나 먹을까?",
 "175": "엇?!\n식사 준비가 돼 있어요?",
 "176": "당연하제.\f어부는 말이여\n한 번 고기잡이 나가면\n며칠 걸릴지 몰러.\f그러니께, 식량만은\n늘 넉넉히 배에 실어 두는 것이여.",
 "177": "하기야, 보리뿐이지만서도.\f",
 "178": "자, 따라오더라고.",
 "179": "준비는 되셨죠?",
 "180": "네, 잘 부탁드립니다.",
 "181": "비아노 씨\n신세 많이 졌습니다.",
 "182": "신세는 이쪽이 졌지.\n조심해서 가라고.\f걱정 안 해도\n모두한테는 잘 말해 둘 테니.",
 "183": "잘 들어.\n이 네갈섬은 네 섬이야.\f괴로운 일이 있거든\n언제든 돌아오렴.",
 "184": "고마워요, 비아노 씨.",
 "185": "자리 잡거든 편지를 다오.",
 "186": "네.",
 "187": "저기,",
 "188": "얼른 배에 타자.",
 "189": "그럼, 갈까요?",
 "190": "네.",
 "191": "어〜이, 인타아!",
 "192": "앗?!\n림 형아 목소리다!",
 "193": "역시 있었네.\f마을에 없으니까\n혹시 항구에 있나 싶어서\n와 봤어.\f인타.\n너, 이런 데서\n뭐 하는 거야?",
 "194": "배에 타는 거야.",
 "195": "배...?",
 "196": "너, 어디 가는 거야?\f가 버리는 거야?",
 "197": "엇?\n나 아무 데도 안 가.\f배에 탈 뿐인걸.",
 "198": "인타...\n미안해.",
 "199": "배만 타는 게 아니란다.",
 "200": "우리는 대륙에서 살 거야.",
 "201": "대륙...",
 "202": "그런 건...싫어.",
 "203": "림 형아랑\n못 놀게 되잖아.",
 "204": "그럼 나, 배 안 탈래.",
 "205": "아줌마, 정말이에요?",
 "206": "미안해, 림.",
 "207": "그런 게 어딨어요.\n왜 말해 주지 않았어요?",
 "208": "림, 그만하렴.",
 "209": "그치만요...",
 "210": ".........",
 "211": "모두에게 말없이 섬을 떠나는 것도\n괴로운 일이란다.\f림, 이해해 줄 수 있지?",
 "212": ".........",
 "213": "........\n림 형아.",
 "214": "나...\n배 타고 대륙에 갈게.\n　",
 "215": "인타...",
 "216": "알았어, 잘 지내라.",
 "217": "편지 보내라\n나도 보낼 테니까.",
 "218": "응...",
 "219": "자, 기운 내라, 둘 다.\n출항이잖니.\f옛날부터 출항은 웃으며 보내고\n웃으며 떠나는 게\n길하다고 했단다.\f언제까지고\n훌쩍대고 있으면 못 써.",
 "220": "응.\n그럼 잘 있어, 인타.\f편지 기다릴게.",
 "221": "응.\n림 형아도 잘 있어.\f편지 쓸게.",
 "222": "자, 어서 가거라.\n해가 저물겠다.",
 "223": "그럼, 이번엔\n정말로 배에 타는 거야.\f알겠지.",
 "224": "네, 부탁드려요.",
 "225": "응.",
 "226": "빠이, 빠〜이!",
 "227": "잘 지내라!",
 "228": "조심해서 가.",
 "229": "그렇게 됐어요\n토바이 씨.",
 "230": "아무 말 말어.\n다 알겄당께.\f자 타더라고.",
 "231": "밖은 추운께 판자 뗄 때까지\n안에서 기다리더라고.",
 "232": "토바이 씨, 정말 고마워요.",
 "233": "괜찮다니께.",
 "234": "고마워요, 토바이 씨.",
 "235": "근디 너희들.\f섬에서 돌아올 땐\n어쩔 셈이여?\f이 섬이 가루가한테\n습격당할 일이 없었으면\n그대로 두고 갈 참이었는디,\f이런 판이면 돌아갈 배를\n구하기도 힘들 것이여.",
 "236": "그러고 보니, 그렇네요.\n어쩌지...",
 "237": "할 수 없제.",
 "238": "이왕 시작한 일이여.\n여기서 기다려 주겄어.\f어차피 이틀쯤이면\n볼일은 끝나겄제.",
 "239": "네.\n테그라 샤리네에 갈 뿐이니까\n그쯤이면 돌아올 수 있어요.",
 "240": "좋아, 정해졌구먼.\n그럼, 다녀오더라고.\f조심하고.",
 "241": "네, 토바이 씨.\n고마워요.",
 "242": "그럼 또 봐요, 토바이 씨.",
 "243": "림 형아!\n잘 있어어!!\f안녀엉!!",
 "244": "인타!\n꼭 편지 보내라아!",
 "245": "안녕히 계세요, 비아노 씨〜!",
 "246": "순례 여행자들!\n인타네를 부탁한다!",
 "247": "비아노 씨도 잘 지내세요!",
 "248": "안녕히 계세요!",
 "249": "출발, 진행!!",
 "250": "뭐 하고 있었냐?\n엄청 늦었구먼.",
 "251": "토바이 씨가 큰 소리를 내니까\n바다표범이 깼잖아요.",
 "252": "맞아요.",
 "253": "어?　미안혀.\n아이고, 잘못했구먼...",
 "254": "토바이는 조금 머뭇거리며\n사과했다.",
 "255": "아버지한테 혼나 부렀당께.",
 "256": "어부는 바다에 안 나가면\n사내가 아니라고 말이여.",
 "257": "타라타호 준비는 됐어야.",
 "258": "타라타호?",
 "259": "...이상한 이름.",
 "260": "쥬리오, 너!",
 "261": "태워 달라면서\n그런 소리 하면 안 되지.",
 "262": "딱히 이상한 이름 아녀.",
 "263": "이 고장 말로\n바다호라는 뜻이여.",
 "264": "토바이 씨, 신경 쓰지 마세요.\f그럼, 죄송하지만\n네갈섬까지 잘 부탁드려요.",
 "265": "좋〜아\n타라타호 출항이여어!!",
 "266": "갑판은 춥잖여.",
 "267": "이 철 바닷바람은 몸에 사무쳐야.",
 "268": "안에 들어가는 게 좋여.",
 "269": "자, 이쪽이여.",
 "270": "쥬리오\n네갈섬에도 여러 사람이 있었네.",
 "271": "응.\n그래도 다들 좋은 사람뿐이었어.",
 "272": "그러네.",
 "273": "있잖아, 크리스.\f20년 전에 우리처럼\n여행한 마녀는\n어떤 사람이었을까.",
 "274": "지금 메나트에서\n벌어지는 나쁜 일이\n마녀의 저주라는 사람도 있고,\f이탄으로 살아갈 수 있게 된 건\n마녀 덕분이라며\n고마워하는 사람도 있어.\f하얀마녀는 좋은 사람이었을까.",
 "275": "아니면 옛날이야기 속 마녀처럼\n무섭고 두려운 사람이었을까.",
 "276": "역시 마녀라고 하면\n",
 "277": "무서운 할머니를\n떠올리게 되네.",
 "278": "근데 하얀마녀는\n그렇지 않은 모양이야.",
 "279": "허크 삼촌한테\n조금 더 이야기를 들어 뒀으면\n좋았을 텐데.",
