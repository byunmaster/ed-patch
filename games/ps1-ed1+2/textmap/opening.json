  },
  {
   "k": "0x0B1C",
   "ours": "환호했지만",
   "sha": "4c310fbf"
  },
  {
   "k": "0x0AFC",
   "ours": "그것도 곧 가라앉고 말았다.",
   "sha": "e7a29cc1"
  },
  {
   "k": "0x0AE8",
   "ours": "국왕 아스엘의 죽음…",
   "sha": "d5197706"
  },
  {
   "k": "0x0AD8",
   "ours": "그것은 마치",
   "sha": "3cf2bf7f"
  },
  {
