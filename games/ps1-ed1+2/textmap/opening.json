{
 "class": "opening",
 "entries": [
  {
   "k": "0x0ECC",
   "ours": "먼 옛날, 아니",
   "sha": "f1b818a3"
  },
  {
   "k": "0x0EA8",
   "ours": "먼 미래일지도 모른다.",
   "sha": "a53f801e"
  },
  {
   "k": "0x0E90",
   "ours": "다만 말할 수 있는 건,",
   "sha": "79193e80"
  },
  {
   "k": "0x0E78",
   "ours": "이셀하사라 불리는",
   "sha": "a3955648"
  },
  {
   "k": "0x0E58",
   "ours": "풍요로운 자연의 세계가",
   "sha": "74294c95"
  },
  {
   "k": "0x0E38",
   "ours": "있어, 사람들은 자연의 은혜를",
   "sha": "434a5874"
  },
  {
   "k": "0x0E20",
   "ours": "받으며 그 땅에 살고 있었다는 것.",
   "sha": "bc3fac7e"
  },
  {
   "k": "0x0E04",
   "ours": "크고 작은 섬들과 대륙,",
   "sha": "ba841b56"
  },
  {
   "k": "0x0DE4",
   "ours": "그것들을 감싼 푸르고 아름다운",
   "sha": "e3919a16"
  },
  {
   "k": "0x0DC4",
   "ours": "바다로 이루어진 세계에는",
   "sha": "e83e789c"
  },
  {
   "k": "0x0DA4",
   "ours": "파렌, 온리크,",
   "sha": "75c7cabd"
  },
  {
   "k": "0x0D8C",
   "ours": "라누라, 솔디스,",
   "sha": "5b927d40"
  },
  {
   "k": "0x0D6C",
   "ours": "모레스톤의 다섯 나라가 있었다.",
   "sha": "69e52753"
  },
  {
   "k": "0x0D48",
   "ours": "이셀하사 중앙에 자리한",
   "sha": "8e898c77"
  },
  {
   "k": "0x0D24",
   "ours": "론윌섬과 사스아이섬으로",
   "sha": "d39a2a87"
  },
  {
   "k": "0x0D0C",
   "ours": "이루어진 파렌 왕국은",
   "sha": "ac182255"
  },
  {
   "k": "0x0CF4",
   "ours": "국토가 좁은 탓도 있어",
   "sha": "8c19e763"
  },
  {
   "k": "0x0CDC",
   "ours": "이렇다 할 특산물도",
   "sha": "1f25dbbb"
  },
  {
   "k": "0x0CCC",
   "ours": "없는 나라였다.",
   "sha": "8566a7c0"
  },
  {
   "k": "0x0CB0",
   "ours": "그러나 그곳 사람들은",
   "sha": "ff094d5e"
  },
  {
   "k": "0x0C94",
   "ours": "가난한 살림에도 굴하지 않고",
   "sha": "1736441b"
  },
  {
   "k": "0x0C70",
   "ours": "인자한 아스엘 왕의 통치 아래",
   "sha": "93bcf7e5"
  },
  {
   "k": "0x0C54",
   "ours": "평화로이 살아가고 있었다.",
   "sha": "b0df17f9"
  },
  {
   "k": "0x0C30",
   "ours": "어느 날 밤, 이변이",
   "sha": "f59b471c"
  },
  {
   "k": "0x0C18",
   "ours": "예고도 없이 수도 루디아를 덮쳤다.",
   "sha": "725a1e4a"
  },
  {
   "k": "0x0BFC",
   "ours": "몬스터들이 대거 성으로",
   "sha": "9275a7d5"
  },
  {
   "k": "0x0BE8",
   "ours": "쳐들어온 것이다.",
   "sha": "42a4e2f7"
  },
  {
   "k": "0x0BC8",
   "ours": "지금껏 본 적 없는 몬스터의",
   "sha": "9043a0da"
  },
  {
   "k": "0x0BAC",
   "ours": "습격에 병사들은 당황했고",
   "sha": "eefe8f29"
  },
  {
   "k": "0x0B90",
   "ours": "한동안 혼전이 이어졌다.",
   "sha": "29967b8e"
  },
  {
   "k": "0x0B74",
   "ours": "그러나 아침이 밝아올 때쯤",
   "sha": "fc4b1151"
  },
  {
   "k": "0x0B5C",
   "ours": "몬스터의 기세는 꺾이고",
   "sha": "ef578d8b"
  },
  {
   "k": "0x0B44",
   "ours": "마침내 퇴각하기 시작했다.",
   "sha": "c514f5b6"
  },
  {
   "k": "0x0B28",
   "ours": "병사들은 큰 위기를 벗어나",
   "sha": "90cc3847"
  },
  {
   "k": "0x0B1C",
   "ours": "환호했지만",
   "sha": "4c310fbf"
  },
  {
   "k": "0x0AFC",
   "ours": "그것도 곧 가라앉고 말았다.",
   "sha": "e7a29cc1"
  },
  {
   "k": "0x0AE8",
   "ours": "국왕 아스엘의 죽음...",
   "sha": "3beacce3"
  },
  {
   "k": "0x0AD8",
   "ours": "그것은 마치",
   "sha": "3cf2bf7f"
  },
  {
   "k": "0x0ABC",
   "ours": "파렌 국민에게",
   "sha": "dc5cfce9"
  },
  {
   "k": "0x0A98",
   "ours": "태양이 지는 듯한 사건이었다.",
   "sha": "2c1f9138"
  },
  {
   "k": "0x0A74",
   "ours": "이때, 세자인 세리오스 왕자는",
   "sha": "3ca02a91"
  },
  {
   "k": "0x0A64",
   "ours": "고작 6살.",
   "sha": "5b04455f"
  },
  {
   "k": "0x0A48",
   "ours": "홀로 아스엘 왕의 임종을",
   "sha": "0c49fbdc"
  },
  {
   "k": "0x0A28",
   "ours": "지켰다는 재상 아크담은",
   "sha": "fcd00ff1"
  },
  {
   "k": "0x0A08",
   "ours": "왕자가 왕위를 계승할 때까지",
   "sha": "feb6a655"
  },
  {
   "k": "0x09F4",
   "ours": "정무를 보겠다고 선언하고",
   "sha": "f6314c3a"
  },
  {
   "k": "0x09D0",
   "ours": "세리오스 왕자는",
   "sha": "d3125a59"
  },
  {
   "k": "0x09B0",
   "ours": "사스아이섬 엘아스타 마을에서",
   "sha": "3d49110a"
  },
  {
   "k": "0x0998",
   "ours": "자라게 되었다.",
   "sha": "7365b024"
  },
  {
   "k": "0x0974",
   "ours": "그로부터 약 10년이 흘렀다...",
   "sha": "6b45dd2e"
  }
 ]
}