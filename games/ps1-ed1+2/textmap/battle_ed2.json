{
 "class": "battle_ed2",
 "_doc": "ED2 전투 문안 — 우리 번역. JP 원문은 해시 키로만 남는다(저작권 규칙).",
 "entries": [
  {
   "k": "eb93bcf9ee",
   "sha": "c5fd207a",
   "ours": " Gold를 손에 넣었다.\n"
  },
  {
   "k": "439ccc3598",
   "sha": "501cedda",
   "ours": "에게는 맞지 않았다.\n"
  },
  {
   "k": "9b4aa75cb3",
   "sha": "fce07329",
   "ours": "%c%s%c이(가) 모습을 드러냈다.\n"
  },
  {
   "k": "14680934b6",
   "sha": "24b1b8d5",
   "ours": "은(는) 혼란에 빠졌다!\n"
  },
  {
   "k": "ca5c31f54e",
   "sha": "39aaec7e",
   "ours": "은(는) 더 깊이 잠들었다!\n"
  },
  {
   "k": "e98b117ead",
   "sha": "9bef4420",
   "ours": "은(는) 잠들어 버렸다!\n"
  },
  {
   "k": "0b44c53ab2",
   "sha": "bd722c73",
   "ours": "의 MP가 회복됐다."
  },
  {
   "k": "e107bbb9aa",
   "sha": "0e349977",
   "ours": "의 온몸에 독이 퍼졌다!\n"
  },
  {
   "k": "a209e4da9e",
   "sha": "7e1a34ca",
   "ours": "은(는) 혼란한 상태다!\n"
  },
  {
   "k": "ee6e6110e1",
   "sha": "7c104c70",
   "ours": "은(는) 독에 걸렸다!\n"
  },
  {
   "k": "6478874415",
   "sha": "0a86d1a2",
   "ours": "의 HP는 회복되지 않았다."
  },
  {
   "k": "2c83ba6fba",
   "sha": "c1659524",
   "ours": "프람의 효과가 있다.\n"
  },
  {
   "k": "2606a03153",
   "sha": "21e3d4fb",
   "ours": "오비스의 효과가 있다.\n"
  },
  {
   "k": "960f64fe2a",
   "sha": "ceddbcd5",
   "ours": "이그나의 효과가 있다.\n"
  },
  {
   "k": "eed99b3004",
   "sha": "e25c5624",
   "ours": "호의 효과가 있다.\n"
  },
  {
   "k": "68c03eebda",
   "sha": "582298d7",
   "ours": "휼의 효과가 있다.\n"
  },
  {
   "k": "ba2915372f",
   "sha": "d3a6132b",
   "ours": "이나 피해를 입히다니..."
  },
  {
   "k": "0851564601",
   "sha": "a0cfa18d",
   "ours": "피해를 못 입히다니..."
  },
  {
   "k": "96cadc2b20",
   "sha": "48e68498",
   "ours": "%c레이시아%c이(가) 나타났다."
  },
  {
   "k": "471c98d018",
   "sha": "685943fe",
   "ours": "공격력이"
  },
  {
   "k": "bc49600bde",
   "sha": "0bd6a3d3",
   "ours": "의 공격\n"
  },
  {
   "k": "42d14dc182",
   "sha": "c90cb9ce",
   "ours": "의 HP가"
  },
  {
   "k": "9467b7bde6",
   "sha": "0a1b4ad6",
   "ours": "의 MP가"
  },
  {
   "k": "c13687e1a0",
   "sha": "079b7890",
   "ours": "누가 주문을 익힐까요?"
  },
  {
   "k": "64eba77a71",
   "sha": "72b3153f",
   "ours": "어디에 익힐까요?"
  },
  {
   "k": "e0ac19ff13",
   "sha": "8dc8483b",
   "ours": "%c%s%c은(는) %s 주문을 익혔습니다."
  },
  {
   "k": "0a451f4fd5",
   "sha": "61b78292",
   "ours": "을(를) 가졌다.\n"
  },
  {
   "k": "89e283959d",
   "sha": "99f49fe8",
   "ours": " 포인트 획득.\n"
  },
  {
   "k": "a6405ac9d2",
   "sha": "45d0250b",
   "ours": "의 주문능력이 %c%d%c 떨어졌다."
  },
  {
   "k": "30ca527401",
   "sha": "340d8a5b",
   "ours": "의 주문능력이 %c%d%c 올랐다."
  },
  {
   "k": "1c451b86b3",
   "sha": "493b9e75",
   "ours": "은(는) 깨어났다.\n"
  },
  {
   "k": "440cdbe334",
   "sha": "6e84632a",
   "ours": "%c%s%c에게 합계"
  },
  {
   "k": "56c5ef650c",
   "sha": "45d0250b",
   "ours": "의 주문능력이 %c%d%c 떨어졌다."
  },
  {
   "k": "c1c3d68029",
   "sha": "340d8a5b",
   "ours": "의 주문능력이 %c%d%c 올랐다."
  },
  {
   "k": "5a35a4033f",
   "sha": "6c3c5caf",
   "ours": "은(는) 마비됐다!!"
  },
  {
   "k": "5c66ed0d8b",
   "sha": "585cdf1e",
   "ours": "제길 내가 못 움직일 때"
  },
  {
   "k": "f2dd9f5d6d",
   "sha": "6c7f8b70",
   "ours": "배로 갚아 주마 !!"
  },
  {
   "k": "9044b860c8",
   "sha": "7956d1d9",
   "ours": "멍청한 것 내가 못 움직인다는데"
  },
  {
   "k": "2e448408b1",
   "sha": "f947e287",
   "ours": "얼른 해치워 주마 !!"
  },
  {
   "k": "b2bea1ae3f",
   "sha": "efc8ed1a",
   "ours": "흐흐흐\n"
  },
  {
   "k": "6f953858ad",
   "sha": "5d989d21",
   "ours": "이 몸의 진정한 무서움을"
  },
  {
   "k": "e63d36a5ce",
   "sha": "17f38e33",
   "ours": "알게 해 주지."
  },
  {
   "k": "2990c6a6e2",
   "sha": "7ced8915",
   "ours": "크큭 뭐 건방진 것이..."
  },
  {
   "k": "81d9181b3a",
   "sha": "8ae279ca",
   "ours": "너희 따위 이 힘이면 충분하다.\n"
  },
  {
   "k": "4ae687ad14",
   "sha": "a5641883",
   "ours": "각오해라!!"
  },
  {
   "k": "9c8ac23f0b",
   "sha": "f685f7cb",
   "ours": "%c%s%c 마지막힘으로"
  },
  {
   "k": "b181737891",
   "sha": "f342524e",
   "ours": "%c%s%c에 레스를 외웠다."
  },
  {
   "k": "2a77b7358a",
   "sha": "5fe63e68",
   "ours": "%c%s%c, 저주의 말을 남겼다."
  },
  {
   "k": "755d246431",
   "sha": "7127264d",
   "ours": "제법 손맛이 있는 놈이군.\n슬슬 진심을 내 볼까."
  },
  {
   "k": "ce586e94ce",
   "sha": "72745869",
   "ours": "%c%s%c을(를) 내밀었다."
  },
  {
   "k": "f0283e95dd",
   "sha": "2e6bda57",
   "ours": "이런 때 농담은 그만하고 제대로 받아 줘.\n"
  },
  {
   "k": "322ab77a1f",
   "sha": "6e48c83d",
   "ours": "자, 함께 싸우자.\n"
  },
  {
   "k": "26bb65816a",
   "sha": "e37f6f79",
   "ours": "%c%s%c이(가) 죽을힘을 다해 부딪쳤다!!"
  },
  {
   "k": "8e2960bbbc",
   "sha": "533cfc41",
   "ours": "주문능력이"
  }
 ]
}
