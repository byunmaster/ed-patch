{
 "class": "ending_ed2",
 "entries": [
  {
   "k": "0x2164",
   "sha": "5f9b02b9",
   "ours": "다툼은 언제나"
  },
  {
   "k": "0x2144",
   "sha": "3b238a1e",
   "ours": "사소한 어긋남에서 비롯된다…"
  },
  {
   "k": "0x2120",
   "ours": "그런 예감이 들게 한 일이었다.",
   "sha": "971ae9bb"
  },
  {
   "k": "0x2104",
   "ours": "성으로 돌아온 나는 머지않아",
   "sha": "c18da7f1"
  },
  {
   "k": "0x20E4",
   "ours": "성인식을 치렀다…",
   "sha": "cc35946e"
  },
  {
   "k": "0x20C4",
   "ours": "지저의 사람들, 레이시아, 그리고",
   "sha": "f9adba85"
  },
  {
   "k": "0x20A0",
   "ours": "함께 여행한 란도, 플로라",
   "sha": "3c07706f"
  },
  {
   "k": "0x2084",
   "ours": "모두가 훌륭한 왕이 될 거라고",
   "sha": "7be4e699"
  },
  {
   "k": "0x2074",
   "ours": "말해 주었지만",
   "sha": "0437232b"
  },
  {
   "k": "0x2058",
   "ours": "나에게 그런 자신은 없다.",
   "sha": "57912f0e"
  },
  {
   "k": "0x2038",
   "ours": "다만, 언제까지나 지저와 지상,",
   "sha": "c2b05e59"
  },
  {
   "k": "0x201C",
   "ours": "그리고 생명을 지닌 모든",
   "sha": "c4adbfb9"
  },
  {
   "k": "0x2004",
   "ours": "이들이 평화롭게 지낼 수 있는",
   "sha": "e103477a"
  },
  {
   "k": "0x1FF0",
   "ours": "세계를 이루고 싶다.",
   "sha": "5e6cfe20"
  },
  {
   "k": "0x1FD0",
   "ours": "모두, 언제까지나 나의 힘이",
   "sha": "aabe875c"
  },
  {
   "k": "0x1FC0",
   "ours": "되어 주었으면 해…",
   "sha": "1be87b40"
  },
  {
   "k": "0x1F9C",
   "ours": "평화가 언제까지나 이어지기를.",
   "sha": "5473bc36"
  },
  {
   "k": "0x1F80",
   "ours": "여신 프레이아여, 언제까지나",
   "sha": "6bd882d1"
  },
  {
   "k": "0x1F60",
   "sha": "ad4e7053",
   "ours": "저희를 지켜봐 주십시오…"
  },
  {
   "k": "0x1F40",
   "sha": "6f4cc395",
   "ours": "~나는 프레이아. 희망의 여신."
  },
  {
   "k": "0x1F1C",
   "sha": "cfba82f4",
   "ours": "언제나, 그대 곁에 있습니다."
  },
  {
   "k": "0x1F00",
   "sha": "eba73a08",
   "ours": "기도를 담아,"
  },
  {
   "k": "0x1EF4",
   "sha": "ae980fc3",
   "ours": "대지에 씨앗을 뿌릴 때,"
  },
  {
   "k": "0x1ED8",
   "sha": "0bd4f9b6",
   "ours": "미지를 두려워 않고,"
  },
  {
   "k": "0x1EC8",
   "sha": "e5e8aa62",
   "ours": "큰 바다로 배를 저어 나갈 때,"
  },
  {
   "k": "0x1EAC",
   "sha": "9e6413c8",
   "ours": "사랑하는 이와,"
  },
  {
   "k": "0x1EA0",
   "sha": "9ddc9942",
   "ours": "너른 하늘에 꿈을 그릴 때,"
  },
  {
   "k": "0x1E7C",
   "sha": "76da7046",
   "ours": "언제나 그대와 함께 있습니다."
  },
  {
   "k": "0x1B5C",
   "ours": "그리고 소년은 영웅이 된다…",
   "sha": "da11712d"
  }
 ]
}
