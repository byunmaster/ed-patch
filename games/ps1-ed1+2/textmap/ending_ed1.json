{
 "class": "ending_ed1",
 "entries": [
  {
   "k": "0x1AAC",
   "ours": "인간들은 다른 생명을 죽이고,",
   "sha": "c65f045d"
  },
  {
   "k": "0x1A88",
   "ours": "제 것인 양 세계를 지배하고 있다.",
   "sha": "94d24740"
  },
  {
   "k": "0x1A6C",
   "ours": "인간이야말로, 세계에 어둠을 부르는",
   "sha": "8731dc34"
  },
  {
   "k": "0x1A54",
   "ours": "진정한 파괴자인 것이다.",
   "sha": "ce9057de"
  },
  {
   "k": "0x1A38",
   "ours": "파괴자로부터 세계를 지키는 것이",
   "sha": "8974d302"
  },
  {
   "k": "0x1A2C",
   "ours": "나의 임무...",
   "sha": "92510518"
  },
  {
   "k": "0x1A18",
   "ours": "그런 나를 쓰러뜨리다니...",
   "sha": "f56de4b3"
  },
  {
   "k": "0x19F8",
   "ours": "아직 이 세계에도 희망이 있다는",
   "sha": "f8bce371"
  },
  {
   "k": "0x19E8",
   "ours": "뜻인가...",
   "sha": "8a62d325"
  },
  {
   "k": "0x19CC",
   "ours": "젊은이들이여, 들으라.",
   "sha": "448acbac"
  },
  {
   "k": "0x19B0",
   "ours": "한 번 더, 인간에게 기회를",
   "sha": "43307cb9"
  },
  {
   "k": "0x19A4",
   "ours": "주겠노라.",
   "sha": "0d72052b"
  },
  {
   "k": "0x1980",
   "ours": "잘못을 두 번 다시 되풀이하는 일이",
   "sha": "7a76250d"
  },
  {
   "k": "0x1974",
   "ours": "없도록.",
   "sha": "c191d894"
  },
  {
   "k": "0x1950",
   "ours": "그리고, 다시는 나를 필요로 하는",
   "sha": "d38a93be"
  },
  {
   "k": "0x1940",
   "ours": "일이 없도록...",
   "sha": "1d5b2c7d"
  },
  {
   "k": "0x1928",
   "ours": "~인간이 진정한 파괴자...",
   "sha": "9ed241c6"
  },
  {
   "k": "0x191C",
   "ours": "정말로...",
   "sha": "b48519bd"
  },
  {
   "k": "0x18FC",
   "parts": [
    {
     "ours": "~"
    },
    {
     "ours": "정말로 아그니쟈를 물리친 것이"
    }
   ],
   "sha": "09688dd7"
  },
  {
   "k": "0x18E4",
   "ours": "옳은 일이었을까...",
   "sha": "eefda2c3"
  },
  {
   "k": "0x18C0",
   "ours": "만약 우리가 파괴자라면,",
   "sha": "e4991b6c"
  },
  {
   "k": "0x18A4",
   "ours": "내가 해 온 일은...",
   "sha": "a927657e"
  },
  {
   "k": "0x1890",
   "ours": "!＿＿＿*류난",
   "sha": "b6905bae"
  },
  {
   "k": "0x1874",
   "parts": [
    {
     "ours": "!「"
    },
    {
     "ours": "왕자님, 아그니쟈는"
    }
   ],
   "sha": "cca60a4b"
  },
  {
   "k": "0x185C",
   "ours": "!＿우리에게 세계의 미래를",
   "sha": "c1cc88f6"
  },
  {
   "k": "0x1844",
   "ours": "!＿맡긴다고도",
   "sha": "0dcf1020"
  },
  {
   "k": "0x1834",
   "ours": "!＿말했습니다.",
   "sha": "191571e3"
  },
  {
   "k": "0x181C",
   "ours": "!＿앞으로 우리들의,",
   "sha": "9fbcfbac"
  },
  {
   "k": "0x1800",
   "ours": "!＿아니, 모든 사람들의",
   "sha": "2606f7d6"
  },
  {
   "k": "0x17E8",
   "ours": "!＿행동이 이 세계를",
   "sha": "36e4565b"
  },
  {
   "k": "0x17D0",
   "ours": "!＿구할 수 있느냐에",
   "sha": "57d4df75"
  },
  {
   "k": "0x17B4",
   "ours": "!＿달려 있는 것입니다.」",
   "sha": "ef7b6caf"
  },
  {
   "k": "0x179C",
   "ours": "!＿＿＿＿＿＿＿*소니아",
   "sha": "b7007f6a"
  },
  {
   "k": "0x177C",
   "ours": "!＿＿＿＿＿「아그니쟈는",
   "sha": "0caf921a"
  },
  {
   "k": "0x1758",
   "ours": "!＿＿＿＿＿＿우리 인간에게 경고를",
   "sha": "625fc957"
  },
  {
   "k": "0x173C",
   "ours": "!＿＿＿＿＿＿주기 위해서",
   "sha": "693a1993"
  },
  {
   "k": "0x1718",
   "ours": "!＿＿＿＿＿＿나타나 준 것인지도",
   "sha": "9df766e0"
  },
  {
   "k": "0x16F8",
   "ours": "!＿＿＿＿＿＿모르겠네요.」",
   "sha": "06f65740"
  },
  {
   "k": "0x16E8",
   "ours": "!＿＿*게일",
   "sha": "af0f0906"
  },
  {
   "k": "0x16D4",
   "ours": "!「끙끙거리며,",
   "sha": "fb2c5016"
  },
  {
   "k": "0x16C0",
   "ours": "!＿생각해 봤자,",
   "sha": "a3e8bf9e"
  },
  {
   "k": "0x16A4",
   "ours": "!＿아무것도 시작 안 된다고.」",
   "sha": "7f9b99f8"
  },
  {
   "k": "0x1694",
   "ours": "!＿＿*류난",
   "sha": "71d834c9"
  },
  {
   "k": "0x1674",
   "ours": "!「게일 말이 옳습니다.",
   "sha": "aafdaf0c"
  },
  {
   "k": "0x1660",
   "ours": "!＿우리의 여행은,",
   "sha": "38afceff"
  },
  {
   "k": "0x1648",
   "ours": "!＿이제 막 시작되었을",
   "sha": "94fa32dd"
  },
  {
   "k": "0x1634",
   "ours": "!＿뿐입니다.」",
   "sha": "fd1e56fd"
  },
  {
   "k": "0x161C",
   "ours": "그래, 우리들의 여행은",
   "sha": "b83bc5c5"
  },
  {
   "k": "0x1604",
   "ours": "이제 막 시작된 거야.",
   "sha": "a9facbc5"
  },
  {
   "k": "0x15E8",
   "ours": "지금까지 힘이 되어 준 사람들,",
   "sha": "b15611d9"
  },
  {
   "k": "0x15CC",
   "ours": "그리고 이 세계의 모든",
   "sha": "0f213070"
  },
  {
   "k": "0x15AC",
   "ours": "생명과 함께 살아가기 위해서.",
   "sha": "588e2b8b"
  },
  {
   "k": "0x15A0",
   "ours": "그리고...",
   "sha": "0d266474"
  },
  {
   "k": "0x1584",
   "ours": "아그니쟈 같은 악마를",
   "sha": "0eb5f541"
  },
  {
   "k": "0x1570",
   "ours": "두 번 다시 불러내는",
   "sha": "bc2f96e9"
  },
  {
   "k": "0x1560",
   "ours": "일이 없도록...",
   "sha": "1d5b2c7d"
  },
  {
   "k": "0x1548",
   "ours": "이제, 우리들의 진정한",
   "sha": "e6ed2922"
  },
  {
   "k": "0x1538",
   "ours": "여행이 시작된다.",
   "sha": "3aaba760"
  },
  {
   "k": "0x1518",
   "ours": "인생이라는, 기나긴 여행이...",
   "sha": "32526927"
  }
 ]
}