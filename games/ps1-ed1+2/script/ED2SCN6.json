{
 "1": {
  "t": "이야~ 좀 지나치게 밟았군. 하마터면 부딪칠 뻔했다.",
  "s": "보아드"
 },
 "2": {
  "t": "자 왕자님, 여기가 루드라 항구다."
 },
 "3": {
  "t": "고맙습니다. 요금은요?",
  "s": "아트라스"
 },
 "4": {
  "t": "그런 건 필요 없다. 굳이 주겠다면 진귀한 술이나 보석이라도 다오.",
  "s": "보아드"
 },
 "5": {
  "t": "그보다 그 아가씨와 잘해 보거라. 아버지들에게는 잠자코 있어 주마."
 },
 "6": {
  "t": "네? 무슨 말씀이세요?",
  "s": "아트라스"
 },
 "7": {
  "t": "시치미 떼지 마라, 다 안다.",
  "s": "보아드"
 },
 "8": {
  "t": "그럼 또 놀러 오너라. 술이라도 들고 말이다. 핫핫핫."
 },
 "9": {
  "t": "이 배는 모레스톤 공화국의 리셸행이다. 탈 거면 어서 타게.",
  "s": "선장"
 },
 "10": {
  "t": "손님, 표는 갖고 있나?",
  "s": "선장"
 },
 "11": {
  "t": "배에 타시겠습니까?",
  "s": "남자"
 },
 "12": {
  "t": "표를 건넸습니다."
 },
 "13": {
  "t": "뭐야, 탈 생각이 없으면 이쪽으로 오지 마. 방해되니까."
 },
 "14": {
  "t": "표는 저기서 팔고 있어."
 },
 "15": {
  "t": "이봐 당신들, 발밑을 조심해 주게.",
  "s": "남자"
 },
 "16": {
  "t": "여기가 유명한 발명가 하리의 집이야. 하리는 내 친구인데 성 연구실에만 틀어박혀 있지."
 },
 "17": {
  "t": "그래서 내가 여기 관리인이 되어 주고 있는 거야."
 },
 "18": {
  "t": "여기 정기선은 시간에 아주 엄격해서 놓치는 사람이 꽤 있어요.",
  "s": "여자"
 },
 "19": {
  "t": "발명가 하리 씨는 옛날부터 여러 가지를 만들고 계세요.",
  "s": "여자"
 },
 "20": {
  "t": "지금은 성에 연구실을 얻어서 거기서 연구하니까 여기엔 좀처럼 안 돌아오세요."
 },
 "21": {
  "t": "에메의 오아시스 옆에 용의 알이 생겼다고 기뻐했더니 거기서 몬스터가 나왔지 뭔가.",
  "s": "노인"
 },
 "22": {
  "t": "용의 알이란 대체 무엇인고?"
 },
 "23": {
  "t": "네 어서 오세요. 여기는 표 파는 곳이에요. 하나에 100 Gold예요.",
  "s": "남자"
 },
 "24": {
  "t": "표를 사시겠습니까?",
  "s": "여자"
 },
