 "d481218960": "브람나퀸을 감싸며\n%c%s%c이(가) 뛰쳐나왔다.\n",
 "d54856c596": "%c%s%c의 가슴이\n빛났다!!\n",
 "d6e3bad795": "%c%s%c은(는) 기로\n%c%s%c의\n가슴을 조였다.\n",
 "d6ebd7db74": "뉴트가 나타났다.",
 "d83b752d0e": "%c%s%c은(는) 검을\n내리쳤다.",
 "d9269c9639": "바파와 와이바가 나타났다.\n",
 "dd73596196": "%c%s%c은(는) 공격을\n피했다.",
 "de1032b72e": "%c%s%c은(는) 기뻐서 신이\n났다.\n",
 "dfb4a3fac4": "%c%s%c은(는) 머리가\n마비되었다.",
 "e0065633e4": "%c%s%c의 방어력이 19\n떨어졌다.\n",
 "e188ef517d": "%c%s%c은(는) 조종의 피리를\n불었다.\n",
 "e325416901": "%c%s%c의 산주머니가\n흩어졌다!!\n",
 "e462ce723b": "%c%s%c은(는) 지팡이를\n움켜쥐었다.\n",
 "e4db38bec5": "%c%s%c의 갓이\n사라졌다.",
 "e57e4d2e81": "%c%s%c의 민첩성이 5\n떨어졌다.\n",
 "e7d045257c": "%c%s%c이(가) 물을 뿜자\n신비한 갓이 생겼다.",
 "e8069795aa": "%c%s%c이(가) 도우러 왔다.\n",
 "e880195e74": "%c%s%c은(는) ",
 "e95adc01d1": "%c%s%c은(는) 도망쳤다.\n",
 "e9f3e3446f": "%c%s%c은(는) 모래에\n숨었다.\n",
 "ea10cb02ea": "슬래쉬병사가 나타났다.\n",
 "ea93cc98fe": "%c%s%c의 심장 고동을\n들었다\n",
 "ec07f0f276": "%c%s%c은(는) 주위를\n뛰어다니고 있다.",
 "ee29477138": "을(를) 칭찬하며 박수를 치고 있다.\n",
 "ee839039fa": "%c%s%c은(는) 공격 태세에\n들어갔다.\n",
 "ef1da01a24": "%c%s%c은(는) 갓을 펼쳤다.\n",
 "f22f306680": "%c%s%c은(는)\n드러스트고스트를 불러들였다.\n",
 "f2399c2ee1": "누캇치와 갑속충이 나타났다.\n",
 "f382db57ce": "%c%s%c은(는) 점액을\n뱉었다.\n",
 "f3834f9574": "%d 떨어졌다\n",
 "f4889b3b89": "%c%s%c에게 새 기척이\n생겼다.\n",
 "f68043b229": "%c%s%c에게 ",
 "f7ee66e6a9": "%d 떨어졌다.\n",
 "fa8286e0e7": "의 피해.\n",
 "fc0d9c590e": "블랙나이츠가 나타났다.\n",
 "fc75198955": "의 HP가 %c%d%c 회복되었다.\n",
