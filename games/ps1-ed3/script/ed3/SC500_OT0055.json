{
 "archive": "/SCE5/SC500.DAT",
 "member": "..\\DATA\\OT0055.BIN",
 "lines": {
  "0": {
   "jp": "2a8d61a9",
   "kr": "마을 구역"
  },
  "1": {
   "jp": "83ca85b3",
   "kr": "도구상 라키스"
  },
  "2": {
   "jp": "ed54eb31",
   "kr": "케일 할머니"
  },
  "3": {
   "jp": "ccb95ba0",
   "kr": "파르마"
  },
  "4": {
   "jp": "b7c4671b",
   "kr": "포트"
  },
  "5": {
   "jp": "2ddc226e",
   "kr": "올도스는 성스러운 도시라서"
  },
  "6": {
   "jp": "5054afe5",
   "kr": "마을 안에서는 무기 판매는 못 해."
  },
  "7": {
   "jp": "f0fa9cf9",
   "kr": "혹시 무기가 필요하다면"
  },
  "8": {
   "jp": "b98a650c",
   "kr": "관문 밖에 노점이 있으니 가 보라고."
  },
  "9": {
   "jp": "19dd68c0",
   "kr": "여어, 어서 와."
  },
  "10": {
   "jp": "4eb7dec1",
   "kr": "우리 가게엔 자랑거리 물건이 가득하다고."
  },
  "11": {
   "jp": "2a11119e",
   "kr": "뭐, 좀 보고 가라고."
  },
  "12": {
   "jp": "d14b58e9",
   "kr": "무엇을 찾으시나요?"
  },
  "13": {
   "jp": "dc7c84a6",
   "kr": "호오,"
  },
  "14": {
   "jp": "5172e78c",
   "kr": "이라니 보는 눈이 높으시네요."
  },
  "15": {
   "jp": "621fdfba",
   "kr": "비밀입니다만"
  },
  "16": {
   "jp": "cc04ff43",
   "kr": "저희 물건에는 올도스의 마법을 구사해서"
  },
  "17": {
   "jp": "b132e9ea",
   "kr": "여러 효과를 담아 뒀어요."
  },
  "18": {
   "jp": "2ebd2b9d",
   "kr": "값은"
  },
  "19": {
   "jp": "d69283b9",
   "kr": "입니다만"
  },
  "20": {
   "jp": "4287a36c",
   "kr": "꼭 도움이 될 거예요."
  },
  "21": {
   "jp": "7dba4922",
   "kr": "무엇을 파시겠습니까?"
  },
  "22": {
   "jp": "941f0265",
   "kr": "인가요?"
  },
  "23": {
   "jp": "67afcad1",
   "kr": "에 사들이겠습니다."
  },
  "24": {
   "jp": "89dc036a",
   "kr": "환전율은 1 Goa당 15 Pia입니다."
  },
  "25": {
   "jp": "74b4488e",
   "kr": "괜찮습니까?"
  },
  "26": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "27": {
   "jp": "ee93304e",
   "kr": "입니다."
  },
  "28": {
   "jp": "f90ebd6f",
   "kr": "라피카가 없으시네요."
  },
  "29": {
   "jp": "2445d3bb",
   "kr": "모이면 언제든지 오세요."
  },
  "30": {
   "jp": "a7c5ef2c",
   "kr": "그 밖에 볼일은 없으신가요?"
  },
  "31": {
   "jp": "2d56d0fa",
   "kr": "또 갖고 싶어지면"
  },
  "32": {
   "jp": "bf1e7633",
   "kr": "언제든 들러 줘."
  },
  "33": {
   "jp": "6e325b82",
   "kr": "어머, 귀여운 순례자로구나."
  },
  "34": {
   "jp": "e4dba546",
   "kr": "떠나보낸 부모님은"
  },
  "35": {
   "jp": "851f287c",
   "kr": "무척 걱정하셨겠구나."
  },
  "36": {
   "jp": "73a60aca",
   "kr": "대성당 참배가 끝나거든"
  },
  "37": {
   "jp": "eaae98d8",
   "kr": "딴 데 들르지 말고"
  },
  "38": {
   "jp": "5f2759af",
   "kr": "곧장 돌아가렴."
  },
  "39": {
   "jp": "85a861a8",
   "kr": "올도스 대성당에 계시는"
  },
  "40": {
   "jp": "df04411c",
   "kr": "신관님들의 말씀은"
  },
  "41": {
   "jp": "c5becaa6",
   "kr": "정말 귀하답니다."
  },
  "42": {
   "jp": "24a64eeb",
   "kr": "분명 앞으로"
  },
  "43": {
   "jp": "3a152945",
   "kr": "인생의 지침이 될 거예요."
  },
  "44": {
   "jp": "0d20a088",
   "kr": "어라, 전에 필로 선생님을"
  },
  "45": {
   "jp": "6a37efc3",
   "kr": "찾던 형아네."
  },
  "46": {
   "jp": "973682c4",
   "kr": "그 친구가 아팠던 거지?"
  },
  "47": {
   "jp": "406f53aa",
   "kr": "역시 명의야, 필로 선생님."
  },
  "48": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "49": {
   "jp": "514ceffe",
   "kr": "뭐야."
  },
  "50": {
   "jp": "031a39ac",
   "kr": "필로 선생님이 고친 게 아니야?"
  },
  "51": {
   "jp": "296c751d",
   "kr": "그래도 기운 차려서 다행이다."
  }
 }
}