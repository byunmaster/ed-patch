  "0": {
   "jp": "ff7be70f",
   "kr": "다이스"
  },
  "1": {
   "jp": "aa985407",
   "kr": "지배인 리바레"
  },
  "2": {
   "jp": "50e6b00a",
   "kr": "마이아"
  },
  "3": {
   "jp": "d9c98b3d",
   "kr": "그란츠"
  },
  "4": {
   "jp": "b3f0d14b",
   "kr": "경호원"
  },
  "5": {
   "jp": "27c9164e",
   "kr": "루레 씨."
  },
  "6": {
   "jp": "94e8a1e6",
   "kr": "그건 그거, 이건 이거죠."
  },
  "7": {
   "jp": "38c39601",
   "kr": "먹고 튀시는 건 치사해요."
  },
  "8": {
   "jp": "e7e3eb32",
   "kr": "하지만, 이제"
  },
  "9": {
   "jp": "7e75f25b",
   "kr": "루레 씨와의 승부는 사양하고"
  },
  "10": {
   "jp": "d5aeb45c",
   "kr": "싶은 심정이네요."
  },
  "11": {
   "jp": "22625e1f",
   "kr": "도무지 이길 수가 없으니"
  },
  "12": {
   "jp": "c9f47787",
   "kr": "이쪽이 파산해"
  },
  "13": {
   "jp": "24cf9d43",
   "kr": "버리겠어요."
  },
  "14": {
   "jp": "30907862",
   "kr": "앗, 안녕하세요."
  },
  "15": {
   "jp": "e9755544",
   "kr": "여러분이군요."
  },
  "16": {
   "jp": "81e3ad92",
   "kr": "지금, 룰렛의"
  },
  "17": {
   "jp": "7c2cf779",
   "kr": "새 룰을 검토 중이에요."
  },
  "18": {
   "jp": "6f0a4d79",
   "kr": "아까는 대단히 실례했습니다."
  },
  "19": {
   "jp": "0d4de243",
   "kr": "부디 좋게좋게"
  },
  "20": {
   "jp": "e1ef2f1b",
   "kr": "넘어가 주십시오."
  },
  "21": {
   "jp": "c4c13b8b",
   "kr": "지난번엔 미안했어요."
  },
  "22": {
   "jp": "17e0f40c",
   "kr": "부디, 좋게 좀 부탁해요."
  },
  "23": {
   "jp": "6c6468f6",
   "kr": "네? 네? 네? 네? 네?"
  },
  "24": {
   "jp": "8c240b84",
   "kr": "루레 씨, 안녕하십니까."
  },
  "25": {
   "jp": "cdf797c7",
   "kr": "역시 0이 나오면 몇만 배라는 건"
  },
  "26": {
   "jp": "515a2057",
   "kr": "아무리 그래도 힘드니까요."
  },
  "27": {
   "jp": "990800e1",
   "kr": "나쁜 짓은 안 합니다. 정말입니다."
  },
  "28": {
   "jp": "71cca83f",
   "kr": "뭔가 곤란한 일이 있으면"
  },
  "29": {
   "jp": "6089070b",
   "kr": "무엇이든 말씀해 주십시오."
  },
  "30": {
   "jp": "be59ac79",
   "kr": "바론 씨께 안부 전해 주십시오."
  },
  "31": {
   "jp": "d67cf8c1",
   "kr": "밝은 유흥장을 목표로"
  },
  "32": {
   "jp": "b38ec0a9",
   "kr": "밤낮으로 노력 중입니다."
  }
 }
}