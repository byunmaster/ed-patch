 "lines": {
  "0": {
   "jp": "2a8d61a9",
   "kr": "마을 구역"
  },
  "1": {
   "jp": "48ae559f",
   "kr": "데프"
  },
  "2": {
   "jp": "40ed58f7",
   "kr": "챠펠의 슈라"
  },
  "3": {
   "jp": "cb2878b7",
   "kr": "올도스 신관"
  },
  "4": {
   "jp": "0da16b86",
   "kr": "이 마을에 사는 이들은"
  },
  "5": {
   "jp": "650dbf85",
   "kr": "모두 신관 자손이나 현자의"
  },
  "6": {
   "jp": "192df94f",
   "kr": "혈연인 사람이야."
  },
  "7": {
   "jp": "f689e07e",
   "kr": "나야 수행 같은 건 하나도 안 했지만"
  },
  "8": {
   "jp": "64b58e4f",
   "kr": "신관의 먼 친척이란 것만으로"
  },
  "9": {
   "jp": "c3e4f13e",
   "kr": "여기서 지내게 해 준 덕분에 살고 있지."
  },
  "10": {
   "jp": "a076f09c",
   "kr": "고마운 일이지."
  },
  "11": {
   "jp": "8d638ecb",
   "kr": "『마법에 기대는 자는 잘못을 저지른다.』"
  },
  "12": {
   "jp": "d13c3fce",
   "kr": "선선대 대신관님의 말씀이십니다."
  },
  "13": {
   "jp": "33ab0220",
   "kr": "『마법을 쓰는 자는 마음을 맑게 하라.』"
  },
  "14": {
   "jp": "23e4380f",
   "kr": "선대 대신관님의 말씀이십니다."
  },
  "15": {
   "jp": "5859f5be",
   "kr": "올도스 챠펠에 어서 오세요."
  },
  "16": {
   "jp": "95d51df4",
   "kr": "어느 분께 가르쳐 드릴까요?"
  },
  "17": {
   "jp": "7a6ff74c",
   "kr": "어떤"
  },
  "18": {
   "jp": "c63fc7a2",
   "kr": "챠펠 마법을 내려 드릴까요?"
  },
  "19": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "20": {
   "jp": "86524ebe",
   "kr": "마음가짐도 잊지 마세요."
  },
  "21": {
   "jp": "a96fece5",
   "kr": "자유로이 지나가십시오."
  },
  "22": {
   "jp": "8460b2f8",
   "kr": "여기서부터는 신관이 사는 신관 구역입니다."
  },
  "23": {
   "jp": "f31a7135",
   "kr": "올도스 대성당 참배객이 아니시면"
  },
  "24": {
   "jp": "a824de8f",
   "kr": "죄송합니다만 지나가실 수 없습니다."
  },
  "25": {
   "jp": "899a33f9",
   "kr": "올도스 대성당에 가는 건"
  },
  "26": {
   "jp": "fd48f6d9",
   "kr": "크리스 몸이 나은 뒤에 하자고"
  },
  "27": {
   "jp": "55fc01c2",
   "kr": "쥬리오는 생각했다."
  },
  "28": {
   "jp": "8460b2f8",
   "kr": "여기서부터는 신관이 사는 신관 구역입니다."
  },
  "29": {
   "jp": "dcfebdc7",
   "kr": "올도스 대성당 참배하러 오신 분인가요?"
  },
  "30": {
   "jp": "781ae3a5",
   "kr": "네 저희는 순례 여행을 왔습니다."
  },
  "31": {
   "jp": "61c673d1",
   "kr": "라그픽 마을의 쥬리오와 크리스입니다."
  },
  "32": {
   "jp": "f0f2d5cb",
   "kr": "그렇습니까, 알겠습니다."
  },
  "33": {
   "jp": "7e6e79d6",
   "kr": "여기서부터 앞은"
  },
  "34": {
   "jp": "8d8a001c",
   "kr": "네 샤리네를 돌고 온 분만"
  },
  "35": {
   "jp": "b4b9b5b1",
   "kr": "지나실 수 있습니다."
  },
  "36": {
   "jp": "93e04860",
   "kr": "실례입니다만 시험을 치르겠습니다."
  },
  "37": {
   "jp": "d11215fe",
   "kr": "지금부터 간단히 문답하겠습니다."
  },
  "38": {
   "jp": "c0ab9095",
   "kr": "모두 답하시면 통과시켜 드리지요."
  },
  "39": {
   "jp": "3037adbe",
   "kr": "물음은 다섯입니다. 괜찮으신가요?"
  },
  "40": {
   "jp": "ea43c9f0",
   "kr": "두 분이 함께 생각하셔도 됩니다."
  },
  "41": {
   "jp": "c4cac1f2",
   "kr": "순례 여행에서 얻은 지식이 있다면"
  },
  "42": {
   "jp": "440bef5d",
   "kr": "반드시 쉽게 답을 아실 겁니다."
  },
  "43": {
   "jp": "65c12917",
   "kr": "첫째 물음."
  },
  "44": {
   "jp": "aa2bd257",
   "kr": "샤리네는 물, 땅, 불, 바람, 하늘 담당."
  },
  "45": {
   "jp": "d822b5de",
   "kr": "디네 샤리네는 무엇을 맡고 있나요?"
  },
  "46": {
   "jp": "e2e1d315",
   "kr": "둘째 물음."
  },
  "47": {
   "jp": "c98714a3",
   "kr": "그럼, 테그라 샤리네는 무엇을 맡고 있나요?"
  },
  "48": {
   "jp": "063166b0",
   "kr": "셋째 물음."
  },
  "49": {
   "jp": "c27f8c18",
   "kr": "그럼, 이그니스 샤리네는 무엇을 맡나요?"
  },
  "50": {
   "jp": "c6808385",
   "kr": "넷째 물음."
  },
  "51": {
   "jp": "134b2320",
   "kr": "그럼, 시플 샤리네는 무엇을 맡고 있나요?"
  },
  "52": {
   "jp": "cd6dc76c",
   "kr": "다섯째 물음."
  },
  "53": {
   "jp": "05f0c470",
   "kr": "마법의 거울은 진실만 비춘다."
  },
  "54": {
   "jp": "c92b4cda",
   "kr": "예"
  },
  "55": {
   "jp": "f9015853",
   "kr": "아니오"
  },
  "56": {
   "jp": "4587b48a",
   "kr": "그렇습니다."
  },
  "57": {
   "jp": "88acdf0c",
   "kr": "마법의 거울은 반드시 진실만을"
  },
  "58": {
   "jp": "62ec5468",
   "kr": "비추는 것은 아닙니다."
  },
  "59": {
   "jp": "ae07c4ec",
   "kr": "예언은 경고이며"
  },
  "60": {
   "jp": "d3420729",
   "kr": "노력으로 피할 수도"
  },
  "61": {
   "jp": "4d93aad5",
   "kr": "있는 것입니다."
  },
  "62": {
   "jp": "9d23f648",
   "kr": "그것을 아시는 분이라면"
  },
  "63": {
   "jp": "8df81338",
   "kr": "올도스 대성당의 하늘의 샤리네를"
  },
  "64": {
   "jp": "5069d869",
   "kr": "보시고 얻는 것도 있겠지요."
  },
  "65": {
   "jp": "02152bf6",
   "kr": "자, 어서 지나가십시오."
  },
  "66": {
   "jp": "8ffbf192",
   "kr": "물"
  },
  "67": {
   "jp": "ede5b1e6",
   "kr": "땅"
  },
  "68": {
   "jp": "efb26208",
   "kr": "불"
  },
  "69": {
   "jp": "0b703039",
   "kr": "바람"
  },
  "70": {
   "jp": "82ca4a6b",
   "kr": "하늘"
  },
  "71": {
   "jp": "50047612",
   "kr": "이런이런, 긴장을 푸시고"
  },
  "72": {
   "jp": "d4b758a8",
   "kr": "느긋하게 생각해 보세요."
  },
  "73": {
   "jp": "ca40dca4",
   "kr": "저기, 쥬리오."
  },
  "74": {
   "jp": "4b702e7a",
   "kr": "로그도 알아냈는데"
  },
  "75": {
   "jp": "5ecd7628",
   "kr": "우리가 모를 리 없어."
  },
  "76": {
   "jp": "7e86b616",
   "kr": "로그, 머리 좋았구나."
  },
  "77": {
   "jp": "c6159a4b",
   "kr": "감탄할 때가 아니잖아."
  },
  "78": {
   "jp": "7fc16678",
   "kr": "서두르지 말고 생각하면 반드시 압니다."
  },
  "79": {
   "jp": "0d3124b9",
   "kr": "차분히 생각하시고"
  },
  "80": {
   "jp": "108ba96b",
   "kr": "다시 한번 도전해 보세요."
  },
  "81": {
   "jp": "751d775a",
   "kr": "이런, 그건 어떨까요."
  },
  "82": {
   "jp": "27fd4a1d",
   "kr": "서두르지 마시고 다시 한번 처음부터"
  },
  "83": {
   "jp": "9a2c2e7d",
   "kr": "해 보세요."
  },
  "84": {
   "jp": "7fc16678",
   "kr": "서두르지 말고 생각하면 반드시 압니다."
  },
  "85": {
   "jp": "0d3124b9",
   "kr": "차분히 생각하시고"
  },
  "86": {
   "jp": "108ba96b",
   "kr": "다시 한번 도전해 보세요."
  },
  "87": {
   "jp": "b80c8fb6",
   "kr": "여관에 돌아가면"
  },
  "88": {
   "jp": "10d0af16",
   "kr": "바로 출발하자."
  },
  "89": {
   "jp": "73811865",
   "kr": "느긋하게 있을 시간은 없어."
  },
  "90": {
   "jp": "b70ff07c",
   "kr": "저기, 크리스."
  },
  "91": {
   "jp": "9d705ec1",
   "kr": "뭔데?"
  },
  "92": {
   "jp": "412e9a9f",
   "kr": "있잖아, 내 생각인데."
  },
  "93": {
   "jp": "6cb4044d",
   "kr": "모리슨 씨에게는 비밀로 해 두는 편이"
  },
  "94": {
