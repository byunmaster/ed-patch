{
 "archive": "/SCE2/SC200.DAT",
 "member": "..\\DATA\\CR0000.BIN",
 "lines": {
  "0": {
   "jp": "c0e6c7cc",
   "kr": "트루츠 가도"
  },
  "1": {
   "jp": "54904258",
   "kr": "이봐 이봐, 쥬리오."
  },
  "2": {
   "jp": "8a22e1ef",
   "kr": "이런 데서 꾸물댈 시간은 없다."
  },
  "3": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "4": {
   "jp": "4ad99485",
   "kr": "그쪽은 관문이야."
  },
  "5": {
   "jp": "f6f3cfd5",
   "kr": "쥬리오의 길치가"
  },
  "6": {
   "jp": "9e9c62c5",
   "kr": "옮았나?"
  },
  "7": {
   "jp": "bed1ef1a",
   "kr": "욱!"
  },
  "8": {
   "jp": "b582abe9",
   "kr": "자, 미인 아가씨."
  },
  "9": {
   "jp": "7ec1b859",
   "kr": "다이스로 레츠고다."
  },
  "10": {
   "jp": "e1d9c2a3",
   "kr": "아차. 방향이 반대다."
  },
  "11": {
   "jp": "eafe907a",
   "kr": "내가 이럴 줄이야"
  },
  "12": {
   "jp": "47b7bd6c",
   "kr": "관문으로 돌아가려 했구먼."
  },
  "13": {
   "jp": "0d8725b7",
   "kr": "영감님."
  },
  "14": {
   "jp": "d176e0df",
   "kr": "노인네인데도"
  },
  "15": {
   "jp": "a38b668a",
   "kr": "제법 하잖아."
  },
  "16": {
   "jp": "6083f874",
   "kr": "뭘, 나는"
  },
  "17": {
   "jp": "a9bb1430",
   "kr": "거의 매일 여길 지나다니니까."
  },
  "18": {
   "jp": "bd03fd58",
   "kr": "이 근방은 앞마당 같은 거지."
  },
  "19": {
   "jp": "e9f5dcc2",
   "kr": "이 정도 마수의 습격쯤이야"
  },
  "20": {
   "jp": "ee1cd5e3",
   "kr": "내겐"
  },
  "21": {
   "jp": "415f55ff",
   "kr": "그놈들과 인사하는 것 같은 거지."
  },
  "22": {
   "jp": "381c98ca",
   "kr": "호호호…"
  },
  "23": {
   "jp": "22b26120",
   "kr": "쥬리오도 크리스도"
  },
  "24": {
   "jp": "2b7dbf13",
   "kr": "싸우는 법이 꽤 늘었구나."
  },
  "25": {
   "jp": "cb5462a6",
   "kr": "에헤."
  },
  "26": {
   "jp": "424cf408",
   "kr": "로디 씨의 조언 덕분이야."
  },
  "27": {
   "jp": "7855f946",
   "kr": "그렇지. 그 '로디 씨'라는 거"
  },
  "28": {
   "jp": "925be580",
   "kr": "'씨'를 붙여"
  },
  "29": {
   "jp": "037fb978",
   "kr": "부르는 건 그만둬."
  },
  "30": {
   "jp": "d848113f",
   "kr": "그래도 검 스승님을"
  },
  "31": {
   "jp": "c7f7a45f",
   "kr": "함부로 이름만 부를 수는 없어."
  },
  "32": {
   "jp": "c4f2e270",
   "kr": "이봐, 그만하라니까."
  },
  "33": {
   "jp": "a79da7d8",
   "kr": "스승이라고 부를 만한 사람은"
  },
  "34": {
   "jp": "fc86d776",
   "kr": "세상에 그리 없어."
  },
  "35": {
   "jp": "ac6b235f",
   "kr": "이 넓은 세상에서 내가 그리 부를 사람은"
  },
  "36": {
   "jp": "d8eb7098",
   "kr": "폴티아의 지도역,"
  },
  "37": {
   "jp": "33ae27ec",
   "kr": "듀르젤 공 정도다."
  },
  "38": {
   "jp": "7a7e0e18",
   "kr": "나 같은 건"
  },
  "39": {
   "jp": "3b138f58",
   "kr": "로디면 충분해."
  },
  "40": {
   "jp": "79935afc",
   "kr": "좀 더 편하게 가자고."
  }
 }
}