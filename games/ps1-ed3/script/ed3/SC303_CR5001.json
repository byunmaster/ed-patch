 "lines": {
  "0": {
   "jp": "ec4ac565",
   "kr": "삼도교"
  },
  "1": {
   "jp": "9c962a2a",
   "kr": "브리오"
  },
  "2": {
   "jp": "251fdcb9",
   "kr": "바리오"
  },
  "3": {
   "jp": "29ce7f06",
   "kr": "여어, 지나가십니까?"
  },
  "4": {
   "jp": "1b278b9b",
   "kr": "자, 어서 어서"
  },
  "5": {
   "jp": "620a9431",
   "kr": "이 다리는 언제나 공짜니까요."
  },
  "6": {
   "jp": "6fa45c00",
   "kr": "마음껏 지나가십시오."
  },
  "7": {
   "jp": "0f63ea64",
   "kr": "그나저나 이상하네."
  },
  "8": {
   "jp": "ca62f8bb",
   "kr": "오늘은 다리를 건너는 사람이"
  },
  "9": {
   "jp": "c43b9fcd",
   "kr": "어쩐지 적구나…"
  },
  "10": {
   "jp": "8811e401",
   "kr": "볼트 쪽 가루가 소동도"
  },
  "11": {
   "jp": "cfc84358",
   "kr": "가라앉은 모양이네요."
  },
  "12": {
   "jp": "889ff4a7",
   "kr": "가루가가 얌전히 바다로 돌아가"
  },
  "13": {
   "jp": "3a6298df",
   "kr": "아무튼 다행이야, 다행이야."
  },
  "14": {
   "jp": "2f61ca3e",
   "kr": "저기, 정말 지나다니는 사람이 없네."
  },
  "15": {
   "jp": "bc1376d3",
   "kr": "어쩐지 으스스해."
  },
  "16": {
   "jp": "38da5344",
   "kr": "올 때는 그렇게 사람이 많았는데 말이야."
  },
  "17": {
   "jp": "79c491d9",
   "kr": "크리스 님, 뭔가 느끼십니까?"
  },
  "18": {
   "jp": "624668b2",
   "kr": "엇, 뭘 말이에요?"
  },
  "19": {
   "jp": "a6309493",
   "kr": "챠펠 마법을 쓰시는 분이라면"
  },
  "20": {
   "jp": "ae1de952",
   "kr": "저보다 평소와 다른 기척을"
  },
  "21": {
   "jp": "ba900ea4",
   "kr": "아시지 않을까 했습니다만."
  },
  "22": {
   "jp": "8c8bbc2c",
   "kr": "으〜음."
  },
  "23": {
   "jp": "cd253c7e",
   "kr": "잘 모르겠지만"
  },
  "24": {
   "jp": "96a96bd7",
   "kr": "왠지 으스스한 분위기는 느껴져요."
  },
  "25": {
   "jp": "fa415033",
   "kr": "으스스한 느낌이십니까."
  },
  "26": {
   "jp": "e5d1bf3a",
   "kr": "그건 어쩌면"
  },
  "27": {
   "jp": "1c7ecff1",
   "kr": "무언가의 경계 신호 같은 것일지도"
  },
  "28": {
   "jp": "3220ba45",
   "kr": "모르겠군요."
  },
  "29": {
   "jp": "43288c4f",
   "kr": "조심해서 나쁠 것은 없겠지요."
  }
 }
}