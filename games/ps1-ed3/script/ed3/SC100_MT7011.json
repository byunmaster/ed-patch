{
 "archive": "/SCE1/SC100.DAT",
 "member": "..\\DATA\\MT7011.BIN",
 "lines": {
  "0": {
   "jp": "ea7ef945",
   "kr": "타라타호"
  },
  "1": {
   "jp": "628fbc82",
   "kr": "선내"
  },
  "2": {
   "jp": "5cc70478",
   "kr": "어부 토바이"
  },
  "3": {
   "jp": "ce0fbc7a",
   "kr": "에메나"
  },
  "4": {
   "jp": "0adf5788",
   "kr": "인타"
  },
  "5": {
   "jp": "84923463",
   "kr": "방 안에서 인타가 누워 있는 모양이다."
  },
  "6": {
   "jp": "dddba73e",
   "kr": "무슨 일이에요, 토바이 씨?"
  },
  "7": {
   "jp": "43074c30",
   "kr": "인타가 어디 아파요?"
  },
  "8": {
   "jp": "4a8e7673",
   "kr": "뱃멀미인 것 같여."
  },
  "9": {
   "jp": "e3b31ef8",
   "kr": "타라타호는 여객선이 아니라 약도 없고,"
  },
  "10": {
   "jp": "3a5b391a",
   "kr": "항구에 닿을 때까지 참을 수밖에 없구먼."
  },
  "11": {
   "jp": "08a680ec",
   "kr": "그렇지, 쥬리오."
  },
  "12": {
   "jp": "db933355",
   "kr": "질버 선장께 받은"
  },
  "13": {
   "jp": "a1428165",
   "kr": "이(가)"
  },
  "14": {
   "jp": "9cdf9621",
   "kr": "있었잖아!"
  },
  "15": {
   "jp": "1edfd515",
   "kr": "맞다"
  },
  "16": {
   "jp": "e88cba99",
   "kr": "약이라면 있어."
  },
  "17": {
   "jp": "6f934286",
   "kr": "쥬리오는 짐 속에서"
  },
  "18": {
   "jp": "4c3ce4f6",
   "kr": "을(를) 꺼냈다."
  },
  "19": {
   "jp": "91e7e341",
   "kr": "뭐냐,"
  },
  "20": {
   "jp": "e50a0399",
   "kr": "을(를) 가지고 있었냐."
  },
  "21": {
   "jp": "b9248b1d",
   "kr": "잘됐구먼. 자, 얼른 먹여 주랑께."
  },
  "22": {
   "jp": "10c88a61",
   "kr": "뱃멀미쯤, 금방 나을 것이여."
  },
  "23": {
   "jp": "359953ee",
   "kr": "자아."
  },
  "24": {
   "jp": "65e18425",
   "kr": "나는 배 진로를 봐야 하니께."
  },
  "25": {
   "jp": "7268eb2e",
   "kr": "갑판에 올라가 있겄어"
  },
  "26": {
   "jp": "c9f86620",
   "kr": "어쩐지 나, 속이 안 좋아…"
  },
  "27": {
   "jp": "376b642a",
   "kr": "인타도 참, 배를 탈 수 있다고"
  },
  "28": {
   "jp": "bdbb9b7d",
   "kr": "그렇게나 기뻐했는데…"
  },
  "29": {
   "jp": "645c6bf4",
   "kr": "괜찮을까."
  },
  "30": {
   "jp": "bb8de6da",
   "kr": "어머? 약이 있나요?"
  },
  "31": {
   "jp": "28c0f1c3",
   "kr": "네,"
  },
  "32": {
   "jp": "52147155",
   "kr": "이에요."
  },
  "33": {
   "jp": "cde35062",
   "kr": "이걸 인타에게 먹여 주세요."
  },
  "34": {
   "jp": "28164ff5",
   "kr": "금방 좋아질 거예요."
  },
  "35": {
   "jp": "3e0cc9ad",
   "kr": "크리스는"
  },
  "36": {
   "jp": "145b2e47",
   "kr": "을(를) 에메나에게 건넸다."
  },
  "37": {
   "jp": "854dc75d",
   "kr": "이렇게까지 해 주시고"
  },
  "38": {
   "jp": "fd601f19",
   "kr": "정말 감사합니다."
  },
  "39": {
   "jp": "9d0c6420",
   "kr": "당장 먹여 볼게요."
  },
  "40": {
   "jp": "af08e99d",
   "kr": "에메나는"
  },
  "41": {
   "jp": "e9f20158",
   "kr": "을(를) 인타에게 먹였다."
  },
  "42": {
   "jp": "e32d7e66",
   "kr": "부르르〜웅!"
  },
  "43": {
   "jp": "6fd96ff8",
   "kr": "아히이."
  },
  "44": {
   "jp": "bbf1ade5",
   "kr": "이 약, 엄청 잘 듣나 봐."
  },
  "45": {
   "jp": "9b2b0b6f",
   "kr": "나, 속 안 좋던 게 싹 나았어!"
  },
  "46": {
   "jp": "6b609510",
   "kr": "와아."
  },
  "47": {
   "jp": "cb98f048",
   "kr": "나아 버렸다."
  },
  "48": {
   "jp": "cb98f048",
   "kr": "나아 버렸다."
  },
  "49": {
   "jp": "d678b6da",
   "kr": "고마워."
  },
  "50": {
   "jp": "609f1c58",
   "kr": "형아, 누나!"
  },
  "51": {
   "jp": "c7a01d97",
   "kr": "엄마 나 놀다 올게에!"
  },
  "52": {
   "jp": "72ef01f9",
   "kr": "어머, 저 애도 참…"
  },
  "53": {
   "jp": "8ca8fa1c",
   "kr": "정말 감사합니다."
  },
  "54": {
   "jp": "4ce9a6d5",
   "kr": "참."
  },
  "55": {
   "jp": "68e0533c",
   "kr": "이걸 받아 주세요."
  },
  "56": {
   "jp": "612bb9cd",
   "kr": "에메나는 보리가 든 자루를 꺼냈다."
  },
  "57": {
   "jp": "0723a3f1",
   "kr": "한 번 끓였다가 말린 보리예요."
  },
  "58": {
   "jp": "d0edd59c",
   "kr": "여행길 식량으로는 아주 좋답니다."
  },
  "59": {
   "jp": "8a24cb7f",
   "kr": "비상식 삼아 가져가 주세요."
  },
  "60": {
   "jp": "bc01df56",
   "kr": "와."
  },
  "61": {
   "jp": "c32fa00a",
   "kr": "받아도"
  },
  "62": {
   "jp": "1f188b8a",
   "kr": "되나요?"
  },
  "63": {
   "jp": "13962dc1",
   "kr": "고마워요, 에메나 씨."
  },
  "64": {
   "jp": "ff273e30",
   "kr": "쥬리오 일행은 말린 보리를 받았다."
  },
  "65": {
   "jp": "f6b79041",
   "kr": "고향인 네갈섬을 떠나 대륙으로 건너가도,"
  },
  "66": {
   "jp": "9d5e3688",
   "kr": "앞으로 고생할 건 각오하고 있어요."
  },
  "67": {
   "jp": "7af7bbfa",
   "kr": "그래도 인타를 위해서라도 힘내야죠."
  },
  "68": {
   "jp": "f6b79041",
   "kr": "고향인 네갈섬을 떠나 대륙으로 건너가도,"
  },
  "69": {
   "jp": "9d5e3688",
   "kr": "앞으로 고생할 건 각오하고 있어요."
  },
  "70": {
   "jp": "7af7bbfa",
   "kr": "그래도 인타를 위해서라도 힘내야죠."
  },
  "71": {
   "jp": "8fbcff1f",
   "kr": "책장에 책이 있습니다."
  },
  "72": {
   "jp": "36dc0076",
   "kr": "『캡틴 토마스』의 책입니다."
  },
  "73": {
   "jp": "e5e0339b",
   "kr": "표지에는 『캡틴 토마스의 대항해』라고"
  },
  "74": {
   "jp": "9f45ca92",
   "kr": "적혀 있다. 쥬리오가 제일 좋아하는 얘기다."
  },
  "75": {
   "jp": "91638776",
   "kr": "조금 길지만, 읽어 보시겠어요?"
  },
  "76": {
   "jp": "b5a6092b",
   "kr": "《캡틴 토마스의 대항해》"
  },
  "77": {
   "jp": "0184bd96",
   "kr": "아침 햇살에 바다가 반짝반짝 빛났다."
  },
  "78": {
   "jp": "884b3873",
   "kr": "에메랄드해. 일곱 바다에서 가장 고운 바다."
  },
  "79": {
   "jp": "32cbd6e6",
   "kr": "갈매기는 날고 돌고래는 무리 지어 간다."
  },
  "80": {
   "jp": "2a6705f5",
   "kr": "흰 돛을 활짝 펴고 물살을 가르는 배가"
  },
  "81": {
   "jp": "a37509d7",
   "kr": "있었다. 캡틴 토마스가 이끄는 「하얀"
  },
  "82": {
   "jp": "3040f4f7",
   "kr": "철새」 프라네토스호다."
  },
  "83": {
   "jp": "b4b294b0",
   "kr": "프라네토스호는 오늘도 자유로이 간다."
  },
  "84": {
   "jp": "3b369e6f",
   "kr": "캡틴 토마스는 마침내 해적왕 라몬의 소굴"
  },
  "85": {
   "jp": "085d837c",
   "kr": "을 찾아냈다. 바다의 무법자, 해적왕 라몬."
  },
  "86": {
   "jp": "f4301af4",
   "kr": "이 아름다운 에메랄드해에 본거지가 있을 줄"
  },
  "87": {
   "jp": "6b4d5582",
   "kr": "누가 상상했으랴…"
  },
  "88": {
   "jp": "bc5178d4",
   "kr": "「이번엔 놓치지 않는다!」 아침 갑판에 선"
  },
  "89": {
   "jp": "f70cac55",
   "kr": "캡틴 토마스는 구릿빛 굵은 팔에"
  },
  "90": {
   "jp": "a7ed4411",
   "kr": "힘을 주며 중얼거렸다. 승부는 저녁, 해적섬"
  },
  "91": {
   "jp": "ca40022d",
   "kr": "남서쪽 1200미로 해역이다."
  },
  "92": {
   "jp": "555b3799",
   "kr": "프라네토스호는 순조로이 나아가 한낮이 지나"
  },
  "93": {
   "jp": "6c6ee67b",
   "kr": "예정 해역에 닿았다. 라몬과는 여러 번"
  },
  "94": {
   "jp": "03e4d511",
   "kr": "싸웠지만 놈의 앞마당은 처음이다. 어떤"
  },
  "95": {
   "jp": "5dffcfe1",
   "kr": "함정이 있을지 모른다. 토마스는 닻을 내리고"
  },
  "96": {
   "jp": "e8c76cec",
   "kr": "망꾼을 세웠다. 해가 기울 무렵 라몬이"
  },
  "97": {
   "jp": "4bac74c5",
   "kr": "이끄는 선단이 보였다. 그 수는 여섯 척."
  },
  "98": {
   "jp": "cf2d7574",
   "kr": "하나같이 특대 대포를 단 전함. 이쪽도 대포"
  },
  "99": {
   "jp": "5a4f3135",
   "kr": "는 있지만 프라네토스호 한 척뿐이다."
  },
  "100": {
   "jp": "1d161891",
   "kr": "하지만 여기서 적에게 등을 보일 수는 없다."
  },
  "101": {
   "jp": "508115c6",
   "kr": "「오늘이야말로 자웅을 겨룰 때다…」"
  },
  "102": {
   "jp": "25814845",
   "kr": "저녁놀에 물든 에메랄드해에서 캡틴 토마스"
  },
  "103": {
   "jp": "be817d64",
   "kr": "와 해적왕 라몬의 마지막 싸움이 시작됐다"
  },
  "104": {
   "jp": "50c42819",
   "kr": "라몬의 포격이 시작됐다. 소리만 요란한"
  },
  "105": {
   "jp": "a3cf3fe5",
   "kr": "뿐 닿지 않는다. 캡틴 토마스는 바람을"
  },
  "106": {
   "jp": "00fb1a1a",
   "kr": "탔다. 「이놈! 바람을 빼앗겼구나!」 라몬은"
  },
  "107": {
   "jp": "9f1cca65",
   "kr": "분하게 외쳤다. 이래서는 포탄이 안 맞는다."
  },
  "108": {
   "jp": "c3c28ed1",
   "kr": "하지만 이제부터가 진짜 캡틴 토마스"
  },
  "109": {
   "jp": "a9648629",
   "kr": "의 작전이었다. 「돛을 활짝 펼쳐라!!」"
  },
  "110": {
   "jp": "34045376",
   "kr": "그 소리에 돛대마다 일제히 흰 꽃이 폈다."
  },
  "111": {
   "jp": "3ee854c0",
   "kr": "프라네토스호는 포탄처럼 튀어나갔다."
  },
  "112": {
   "jp": "1f3996a1",
   "kr": "바람 탄 프라네토스호를 아무도 못 막는다."
  },
  "113": {
   "jp": "dee03b16",
   "kr": "「라몬의 배에 들이받는다! 백병전이다!」"
  },
  "114": {
   "jp": "95e1401c",
   "kr": "타륜이 도르래처럼 돌고 프라네토스호는 라몬의"
  },
  "115": {
   "jp": "8a0fad5f",
   "kr": "배를 향해 곧장 진로를 잡았다."
  },
  "116": {
   "jp": "3820d926",
   "kr": "방해하는 배에는 포탄으로 답례다."
  },
  "117": {
   "jp": "0d47cfe0",
   "kr": "프라네토스호는 목표에 닿기 전 이미 세 척을"
  },
  "118": {
   "jp": "43d0bdf7",
   "kr": "가라앉혔다. 「캡틴 토마스, 건방진 놈!」"
  },
  "119": {
   "jp": "b694b843",
   "kr": "라몬은 분해서 발을 굴렀다."
  },
  "120": {
   "jp": "aa7d6d09",
   "kr": "라몬의 배 옆구리에 프라네토스호가 박혔다."
  },
  "121": {
   "jp": "c7c44d59",
   "kr": "「올라타라! 뛰어 건너라!」 맞붙은 두 배의"
  },
  "122": {
   "jp": "f3944d12",
   "kr": "선원이 뒤엉켜 백병전이 시작됐다."
  },
  "123": {
   "jp": "4f126d9e",
   "kr": "토마스는 라몬을 찾아 가라앉는 배를 달린다."
  },
  "124": {
   "jp": "95102644",
   "kr": "「라몬! 어디 있느냐! 이 캡틴 토마스가"
  },
  "125": {
   "jp": "0b89ddcd",
   "kr": "상대다!!」 라몬이 뒤에서 느닷없이"
  },
  "126": {
   "jp": "8e2c5606",
   "kr": "덮쳤다. 「이얍!」 토마스는 슬쩍 피한다."
  },
  "127": {
   "jp": "c1c7ee0f",
   "kr": "「비겁한 놈!」 부딪는 검에서 불꽃이 튄다."
  },
  "128": {
   "jp": "d82fafd3",
   "kr": "물이 찬 선체가 크게 기울기 시작했다."
  },
  "129": {
   "jp": "5ea9ef06",
   "kr": "「라몬! 오늘이야말로 네놈의 최후다!」"
  },
  "130": {
   "jp": "9d7b8b7e",
   "kr": "「그건…글쎄다. 너도 끝장이다!」"
  },
  "131": {
   "jp": "5711c7de",
   "kr": "다급한 라몬은 화약에 불을 붙였다."
  },
  "132": {
   "jp": "931736a4",
   "kr": "「모두들, 바다로 뛰어들어라!!」"
  },
  "133": {
   "jp": "4753a405",
   "kr": "캡틴 토마스는 외치며 바다로 뛰어들었다."
  },
  "134": {
   "jp": "be2a8f6c",
   "kr": "두 배는 맞붙은 채 굉음과 함께 날아갔다."
  },
  "135": {
   "jp": "6317fec9",
   "kr": "캡틴의 마지막 항해는 이렇게 막을 내렸다."
  },
  "136": {
   "jp": "85e4be16",
   "kr": "이 해전 뒤 해적 소동은 사라졌다."
  },
  "137": {
   "jp": "f4920d1b",
   "kr": "그러나 그 뒤로 캡틴 토마스의 늠름한 모습을"
  },
  "138": {
   "jp": "ba3f84c7",
   "kr": "본 이도 없다. 우리는 철새를 볼 때마다"
  },
  "139": {
   "jp": "e1c273ee",
   "kr": "떠올리리라. 프라네토스호를 몰고 일곱 바다를"
  },
  "140": {
   "jp": "4ab17b13",
   "kr": "건넌 사나이. 캡틴 토마스가 있었음을…"
  },
  "141": {
   "jp": "634cfe9f",
   "kr": "ＥＮＤ"
  },
  "142": {
   "jp": "98cc51a9",
   "kr": "쥬리오는 토바이도 『캡틴 토마스』"
  },
  "143": {
   "jp": "ad7c4a15",
   "kr": "팬이라는 걸 알고 조금 기분이 좋아졌다."
  }
 }
}