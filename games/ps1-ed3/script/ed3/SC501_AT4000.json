{
 "archive": "/SCE5/SC501.DAT",
 "member": "..\\DATA\\AT4000.BIN",
 "lines": {
  "0": {
   "jp": "e2a3d685",
   "kr": "루이즈 관문"
  },
  "1": {
   "jp": "af4cc4df",
   "kr": "퓨엔테 병사"
  },
  "2": {
   "jp": "bf0605fc",
   "kr": "안내 다니이"
  },
  "3": {
   "jp": "38108db3",
   "kr": "입국 관리원"
  },
  "4": {
   "jp": "a215d597",
   "kr": "아드레이"
  },
  "5": {
   "jp": "e2a3d685",
   "kr": "루이즈 관문"
  },
  "6": {
   "jp": "1e7c32a9",
   "kr": "여어, 수고했어."
  },
  "7": {
   "jp": "85cfba49",
   "kr": "남퓨엔테 국경 관문에 도착이야."
  },
  "8": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "9": {
   "jp": "3d93d451",
   "kr": "아저씨, 퓨엔테 병사예요?"
  },
  "10": {
   "jp": "587ca49d",
   "kr": "맞아."
  },
  "11": {
   "jp": "77a954d0",
   "kr": "하지만 여긴 앰비쉬 쪽이잖아요."
  },
  "12": {
   "jp": "7d943a6e",
   "kr": "원래라면 앰비쉬 사람이"
  },
  "13": {
   "jp": "7b4e8c00",
   "kr": "지켜야 하는 거 아니에요?"
  },
  "14": {
   "jp": "2c7d3a62",
   "kr": "원래는 그렇긴 한데 말이야."
  },
  "15": {
   "jp": "64a64c82",
   "kr": "앰비쉬에서는 멀지 않니."
  },
  "16": {
   "jp": "3bc0f69d",
   "kr": "앰비쉬에서 사람을 보내면"
  },
  "17": {
   "jp": "47e5e8a6",
   "kr": "삼도교나 우돌을 지나서"
  },
  "18": {
   "jp": "9a816a66",
   "kr": "크게 돌아와야 하거든."
  },
  "19": {
   "jp": "76903705",
   "kr": "꽤나 힘드시겠네요."
  },
  "20": {
   "jp": "4145e582",
   "kr": "응, 그래. 그래서 의논을 해서"
  },
  "21": {
   "jp": "30314352",
   "kr": "이 관문은 남퓨엔테가"
  },
  "22": {
   "jp": "adb983e6",
   "kr": "맡기로 된 거야."
  },
  "23": {
   "jp": "aa04453d",
   "kr": "흐응, 그래요."
  },
  "24": {
   "jp": "4fd323b9",
   "kr": "퓨엔테와 앰비쉬는"
  },
  "25": {
   "jp": "907a4279",
   "kr": "사이가 좋네요."
  },
  "26": {
   "jp": "d1db2aa9",
   "kr": "그렇고말고. 이웃 나라니까."
  },
  "27": {
   "jp": "740d2469",
   "kr": "얘들아."
  },
  "28": {
   "jp": "227bb249",
   "kr": "아직 입국 수속이 안 끝난 모양이네."
  },
  "29": {
   "jp": "334a7b6e",
   "kr": "제대로 끝내고 나서 지나가 줘."
  },
  "30": {
   "jp": "7bb0bbe3",
   "kr": "어라, 얘들아."
  },
  "31": {
   "jp": "88456ecd",
   "kr": "분명 순례 여행자였지."
  },
  "32": {
   "jp": "ef6410ad",
   "kr": "설마 올도스로 돌아갈 셈이니?"
  },
  "33": {
   "jp": "497d2fc5",
   "kr": "폴티아로 가려면"
  },
  "34": {
   "jp": "084cfdb8",
   "kr": "남퓨엔테를 넘어서"
  },
  "35": {
   "jp": "89cffbbc",
   "kr": "기드나를 북쪽으로 올라가는 게 제일 빨라."
  },
  "36": {
   "jp": "7bb0bbe3",
   "kr": "어라, 얘들아."
  },
  "37": {
   "jp": "88456ecd",
   "kr": "분명 순례 여행자였지."
  },
  "38": {
   "jp": "65a4feac",
   "kr": "국경을 넘고 싶은 거야?"
  },
  "39": {
   "jp": "f944bfc7",
   "kr": "미안하지만, 남북 문제가"
  },
  "40": {
   "jp": "7ad76514",
   "kr": "불거져서 말이야."
  },
  "41": {
   "jp": "69d919bf",
   "kr": "지금 이곳 국경은 봉쇄돼 있어."
  },
  "42": {
   "jp": "12d8172e",
   "kr": "앞으로의 세상은"
  },
  "43": {
   "jp": "f973afc6",
   "kr": "나라끼리 서로 도와야 한다고 생각해."
  },
  "44": {
   "jp": "8b3261b2",
   "kr": "나도 이 국경을 지킬 수 있어서"
  },
  "45": {
   "jp": "3e2f276d",
   "kr": "자랑스럽게 여기고 있어."
  },
  "46": {
   "jp": "1a4f22cb",
   "kr": "여긴 감옥이야."
  },
  "47": {
   "jp": "1f39ffbf",
   "kr": "하지만 지금은 아무도 안 들어 있어."
  },
  "48": {
   "jp": "8d7e3d24",
   "kr": "이 근처에서 나쁜 짓을 하는 사람은"
  },
  "49": {
   "jp": "dacd252d",
   "kr": "별로 없으니까."
  },
  "50": {
   "jp": "de91014d",
   "kr": "북퓨엔테 쪽에는"
  },
  "51": {
   "jp": "9a3acd26",
   "kr": "지금 산적이 나온다는 얘기지만,"
  },
  "52": {
   "jp": "59f0c4db",
   "kr": "이쪽은 아주 평화로워."
  },
  "53": {
   "jp": "6e9cd088",
   "kr": "제대로 수속을 밟고 나서"
  },
  "54": {
   "jp": "c34d584b",
   "kr": "퓨엔테에 들어와 줘."
  },
  "55": {
   "jp": "96856906",
   "kr": "수속은 끝난 모양이네."
  },
  "56": {
   "jp": "7df89949",
   "kr": "자, 지나가도 좋아."
  },
  "57": {
   "jp": "2df542af",
   "kr": "네, 수고하셨어요."
  },
  "58": {
   "jp": "bf7439aa",
   "kr": "옆방에서 입국 수속을"
  },
  "59": {
   "jp": "f566cc0c",
   "kr": "해 주세요."
  },
  "60": {
   "jp": "4a4226cf",
   "kr": "네, 그러세요."
  },
  "61": {
   "jp": "c1781585",
   "kr": "한 번 수속을 마치면"
  },
  "62": {
   "jp": "162af269",
   "kr": "프리패스예요."
  },
  "63": {
   "jp": "44a77ad2",
   "kr": "네, 그러시죠."
  },
  "64": {
   "jp": "86a12a52",
   "kr": "올도스에서 돌아오는 길이에요."
  },
  "65": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "66": {
   "jp": "3e43135e",
   "kr": "호오, 순례에서 돌아오셨군요."
  },
  "67": {
   "jp": "fb111537",
   "kr": "정말 고생 많으셨습니다."
  },
  "68": {
   "jp": "a3e3b60c",
   "kr": "네, 됐습니다."
  },
  "69": {
   "jp": "eb38db72",
   "kr": "세 분이시군요."
  },
  "70": {
   "jp": "db5ca205",
   "kr": "지나가십시오."
  },
  "71": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "72": {
   "jp": "b1b8c30a",
   "kr": "젊은데도 믿음직하구먼."
  },
  "73": {
   "jp": "d65afbdf",
   "kr": "훌륭한 어른이 되어 주게나."
  },
  "74": {
   "jp": "cd929466",
   "kr": "네, 순례에서 돌아온 분이시군요."
  },
  "75": {
   "jp": "2eee210f",
   "kr": "얼굴을 보면 압니다."
  },
  "76": {
   "jp": "a0aa90fa",
   "kr": "저도 프로니까요."
  },
  "77": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "78": {
   "jp": "34706559",
   "kr": "오, 은단검이군요."
  },
  "79": {
   "jp": "de989548",
   "kr": "후우…"
  },
  "80": {
   "jp": "8f9368cc",
   "kr": "… 맞혀서 다행입니다."
  },
  "81": {
   "jp": "2356c035",
   "kr": "에이… 자신 없으셨던 거예요?"
  },
  "82": {
   "jp": "80b33a22",
   "kr": "자, 지나가십시오."
  },
  "83": {
   "jp": "e09e75e4",
   "kr": "조심하세요."
  },
  "84": {
   "jp": "3311e827",
   "kr": "여어, 안녕."
  },
  "85": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "86": {
   "jp": "a6168230",
   "kr": "좋겠다"
  },
  "87": {
   "jp": "b599e020",
   "kr": "여자애 둘과 여행이니?"
  },
  "88": {
   "jp": "1e1e3674",
   "kr": "부렵네."
  },
  "89": {
   "jp": "876ff3c0",
   "kr": "저기요, 그건"
  },
  "90": {
   "jp": "856707b2",
   "kr": "「부럽네」라고 해야죠."
  }
 }
}