  "2": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "3": {
   "jp": "4a635944",
   "kr": "여기서는 칸드 마법을 전수합니다."
  },
  "4": {
   "jp": "3d3144ba",
   "kr": "볼트에는 칸드가 없어서"
  },
  "5": {
   "jp": "505df971",
   "kr": "안데라성에서 출장 와 있는 겁니다."
  },
  "6": {
   "jp": "54cbd554",
   "kr": "어느 분이 배우시겠어요?"
  },
  "7": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "8": {
   "jp": "941f0265",
