  },
  "10": {
   "jp": "47a45d20",
   "kr": "병사들이 있는 동안은 여기 있을 테니"
  },
  "11": {
   "jp": "6dac9ffb",
   "kr": "볼일이 있으시거든"
  },
  "12": {
