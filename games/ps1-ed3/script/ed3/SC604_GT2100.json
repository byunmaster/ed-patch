{
 "archive": "/SCE6/SC604.DAT",
 "member": "..\\DATA\\GT2100.BIN",
 "lines": {
  "0": {
   "jp": "dc464821",
   "kr": "기드넬"
  },
  "1": {
   "jp": "4300e71e",
   "kr": "우르기드 저택"
  },
  "2": {
   "jp": "05f74132",
   "kr": "에르가"
  },
  "3": {
   "jp": "2f0e5a1c",
   "kr": "란바"
  },
  "4": {
   "jp": "cde94c98",
   "kr": "탄돌"
  },
  "5": {
   "jp": "c7f773b6",
   "kr": "칸다타가 있을지도 모르니까,"
  },
  "6": {
   "jp": "765ed9a1",
   "kr": "얼굴을 가려 두는 편이 좋겠네."
  },
  "7": {
   "jp": "758905bb",
   "kr": "그러세."
  },
  "8": {
   "jp": "45a120c4",
   "kr": "마을에는 칸다타가 없을 테니까"
  },
  "9": {
   "jp": "a6becf86",
   "kr": "얼굴 가릴 필요 없네."
  },
  "10": {
   "jp": "380307a5",
   "kr": "벗자."
  },
  "11": {
   "jp": "b23cad8c",
   "kr": "우르기드 님이 아무리 심하다고 해도,"
  },
  "12": {
   "jp": "7e166c59",
   "kr": "예전엔 지금만큼 나쁘진 않았어요."
  },
  "13": {
   "jp": "b1ca69b7",
   "kr": "기드나가 이렇게 되어 버린 건,"
  },
  "14": {
   "jp": "675b9682",
   "kr": "반년쯤 전부터예요."
  },
  "15": {
   "jp": "9308c8fe",
   "kr": "대체"
  },
  "16": {
   "jp": "939d6066",
   "kr": "어째서 이렇게 되어 버린 걸까."
  },
  "17": {
   "jp": "813ee673",
   "kr": "우르기드 님 욕은 못 하지만,"
  },
  "18": {
   "jp": "cceae73e",
   "kr": "듣자니 바라카의 칸다타가 데려온 아가씨를"
  },
  "19": {
   "jp": "23572e99",
   "kr": "북서쪽 방에 감금해 뒀다더군."
  },
  "20": {
   "jp": "8b1f2153",
   "kr": "좋지 않아."
  },
  "21": {
   "jp": "2a1d3a10",
   "kr": "분명 재주를 가르쳐서 무희로 만들 셈이야."
  },
  "22": {
   "jp": "4966be42",
   "kr": "북서쪽 방은 튼튼하다고."
  },
  "23": {
   "jp": "1f0d6d7c",
   "kr": "안쪽 벽은 전부 돌로 지었으니까."
  },
  "24": {
   "jp": "edbf3388",
   "kr": "유행인 사막의 흑표범 폭탄으로도"
  },
  "25": {
   "jp": "6aa15988",
   "kr": "날려 버리진 못해."
  },
  "26": {
   "jp": "671b2459",
   "kr": "바라카 마을의 칸다타가,"
  },
  "27": {
   "jp": "9a17e8ad",
   "kr": "우르기드 님의 저택에"
  },
  "28": {
   "jp": "fff12e30",
   "kr": "계속 눌러앉아 있다더군."
  },
  "29": {
   "jp": "5ad82e02",
   "kr": "어차피 또"
  },
  "30": {
   "jp": "75d073ed",
   "kr": "나쁜 짓이라도 꾸미고"
  },
  "31": {
   "jp": "fae5a639",
   "kr": "있겠지."
  },
  "32": {
   "jp": "59623f24",
   "kr": "자기가 상인들 우두머리라고"
  },
  "33": {
   "jp": "8097aac2",
   "kr": "틈만 나면 상인이 돈 벌 새 세금을"
  },
  "34": {
   "jp": "d87ab92e",
   "kr": "궁리하고 있어."
  },
  "35": {
   "jp": "226b50fd",
   "kr": "적당히 좀 했으면 좋겠군."
  }
 }
}