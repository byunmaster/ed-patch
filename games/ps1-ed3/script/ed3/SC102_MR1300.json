 "lines": {
  "0": {
   "jp": "41e91668",
   "kr": "전나무 들판"
  },
  "1": {
   "jp": "81bc17fa",
   "kr": "에그"
  },
  "2": {
   "jp": "5d1bc91c",
   "kr": "유우미"
  },
  "3": {
   "jp": "85f50ece",
   "kr": "징가"
  },
  "4": {
   "jp": "ecc25ab7",
   "kr": "그레드"
  },
  "5": {
   "jp": "906cc3b4",
   "kr": "타로스"
  },
  "6": {
   "jp": "f4066e55",
   "kr": "마타리"
  },
  "7": {
   "jp": "23ebd8f5",
   "kr": "앗, 저기."
  },
  "8": {
   "jp": "9d36a58d",
   "kr": "분명 치타 입구야."
  },
  "9": {
   "jp": "f696b2fc",
   "kr": "도착했어요."
  },
  "10": {
   "jp": "3959db81",
   "kr": "여러분, 수고하셨어요."
  },
  "11": {
   "jp": "4efe46bc",
   "kr": "치타 마을입니다."
  },
  "12": {
   "jp": "740f4bac",
   "kr": "다리가 뻣뻣해졌어."
  },
  "13": {
   "jp": "7ad5d1dc",
   "kr": "겨우 도착했나."
  },
  "14": {
   "jp": "e1ef82e0",
   "kr": "늙은이한테는"
  },
  "15": {
   "jp": "01628a33",
   "kr": "힘에 부치는구먼."
  },
  "16": {
   "jp": "f4d2e80c",
   "kr": "여긴 역참 마을이니까"
  },
  "17": {
   "jp": "0e301ee0",
   "kr": "뭔가 먹을 게 있겠지."
  },
  "18": {
   "jp": "80c51b1d",
   "kr": "괜찮아, 그레드."
  },
  "19": {
   "jp": "4aad7803",
   "kr": "돈이라면 있으니까 누나가"
  },
  "20": {
   "jp": "f50dc2e0",
   "kr": "뭐라도 사 줄게."
  },
  "21": {
   "jp": "0547b8da",
   "kr": "와아."
  },
  "22": {
   "jp": "52502f16",
   "kr": "이보게!"
  },
  "23": {
   "jp": "e529698c",
   "kr": "나를 두고 가지 말게."
  },
  "24": {
   "jp": "41562798",
   "kr": "무례하네, 그대들."
  },
  "25": {
   "jp": "a2f94576",
   "kr": "이보게…이보게나."
  },
  "26": {
   "jp": "bb9d1c16",
   "kr": "저 사람들"
  },
  "27": {
   "jp": "c9678388",
   "kr": "무슨 일일까?"
  },
  "28": {
   "jp": "0a391daf",
   "kr": "우리 같은 여행자와도"
  },
  "29": {
   "jp": "506884f4",
   "kr": "다른 것 같았고 말이야."
  },
  "30": {
   "jp": "56a9600f",
   "kr": "게다가 맨 마지막 사람 어쩐지 이상했어."
  },
  "31": {
   "jp": "c716289e",
   "kr": "말투도 좀 이상했고,"
  },
  "32": {
   "jp": "8f558f13",
   "kr": "다른 사람들이랑 박자도 한참 어긋났어."
  },
  "33": {
   "jp": "f554625e",
   "kr": "있긴 있지."
  },
  "34": {
   "jp": "14c8f8c8",
   "kr": "그런 사람도."
  },
  "35": {
   "jp": "3701673e",
   "kr": "쥬리오 같잖아."
  },
  "36": {
   "jp": "3adae119",
   "kr": "………"
  },
  "37": {
   "jp": "4e303815",
   "kr": "어째서?"
  },
  "38": {
   "jp": "9b87a30a",
   "kr": "괜찮아, 괜찮아."
  },
  "39": {
   "jp": "1c85e455",
   "kr": "자, 우리도 어서 치타로 들어가자."
  },
  "40": {
   "jp": "4838576f",
   "kr": "얘들아, 이 길로 가면 넬바 쪽이야."
  },
  "41": {
   "jp": "51f776e4",
   "kr": "넬바로 갈 생각이니?"
  },
  "42": {
   "jp": "aba37ad5",
   "kr": "저쪽은 아직"
  },
  "43": {
   "jp": "e26d9aef",
   "kr": "위험할지도 몰라."
  },
  "44": {
   "jp": "5d2e41de",
   "kr": "치타에서 좀 더 지켜보는 게 좋아."
  },
  "45": {
   "jp": "23ffe5e8",
   "kr": "설마 여기까진 안 올 것 같지만,"
  },
  "46": {
   "jp": "dcc773eb",
   "kr": "가루가가 어슬렁대고 있으니까."
  },
  "47": {
   "jp": "a111b3af",
   "kr": "넬바에는"
  },
  "48": {
   "jp": "3d34ab2a",
   "kr": "아직 안 가는 게 좋아."
  },
  "49": {
   "jp": "87236e9a",
   "kr": "조금만 더 기다렸다가,"
  },
  "50": {
   "jp": "b7b3f3a1",
   "kr": "가루가 위험이 없다는 걸"
  },
  "51": {
   "jp": "77ae0f7b",
   "kr": "확인하고 나서 가."
  },
  "52": {
   "jp": "794e9c06",
   "kr": "그치만 가루가는 이제 넬바엔 없다면서요."
  },
  "53": {
   "jp": "394d2276",
   "kr": "저흰 순례 여행을 이어 가야 해서"
  },
  "54": {
   "jp": "d6bf1ccf",
   "kr": "넬바를 지나야만 해요."
  },
  "55": {
   "jp": "84a19afe",
   "kr": "그래도 말이야, 아가씨."
  },
  "56": {
   "jp": "136789dc",
   "kr": "아무리 그렇게 말해도 가루가가 아직"
  },
  "57": {
   "jp": "44ed8ddd",
   "kr": "어디 있는지 알 수가 없거든."
  },
  "58": {
   "jp": "68074433",
   "kr": "저기, 지나가면 안 될까요?"
  },
  "59": {
   "jp": "d418de79",
   "kr": "안 돼 안 돼!"
  },
  "60": {
   "jp": "df7abedd",
   "kr": "혹시 가루가가 돌아오면"
  },
  "61": {
   "jp": "dba86c8e",
   "kr": "어쩌려고 그래."
  },
  "62": {
   "jp": "b48c7517",
   "kr": "한 번 지나간 곳엔"
  },
  "63": {
   "jp": "fd2c3ce6",
   "kr": "다시 안 온다고요."
  },
  "64": {
   "jp": "d418de79",
   "kr": "안 돼 안 돼!"
  },
  "65": {
   "jp": "9c0b9749",
   "kr": "자, 치타 마을로"
  },
  "66": {
   "jp": "9ab287e8",
   "kr": "돌아가, 돌아가."
  },
  "67": {
   "jp": "944b3f0f",
   "kr": "쥬리오, 쥬리오…"
  },
  "68": {
   "jp": "ec9ff894",
   "kr": "응, 왜?"
  },
  "69": {
   "jp": "70e5386b",
   "kr": "쥬리오, 나에게 맡겨 두게."
  },
  "70": {
   "jp": "fa0c8c5f",
   "kr": "맡기라니…"
  },
  "71": {
   "jp": "0d659ae6",
   "kr": "어쩌려고?"
  },
  "72": {
   "jp": "9b87a30a",
   "kr": "괜찮아, 괜찮아."
  },
  "73": {
   "jp": "04227a04",
   "kr": "저, 여보게."
  },
  "74": {
   "jp": "91c93d17",
   "kr": "네, 뭡니까?"
  },
  "75": {
   "jp": "39a5f126",
   "kr": "나는 이곳을 지나길 원하네."
  },
  "76": {
   "jp": "d58cf654",
   "kr": "뭔 소리야, 이 사람…"
  },
  "77": {
   "jp": "655166b2",
   "kr": "쥬리오 일행에겐 보이지 않았지만"
  },
  "78": {
   "jp": "0ac89ec7",
   "kr": "알프는 보초 둘에게, 무언가를 슬그머니"
  },
  "79": {
   "jp": "5bfb7201",
   "kr": "보여 주고 있는 듯했다."
  },
  "80": {
   "jp": "59a75d1a",
   "kr": "어라…?"
  },
  "81": {
   "jp": "9dccae9d",
   "kr": "그건, 분명…"
  },
  "82": {
   "jp": "8538fac9",
   "kr": "음, 음."
  },
  "83": {
   "jp": "19b61c28",
   "kr": "정말인가…"
  },
  "84": {
   "jp": "adb9b4d2",
   "kr": "느으〜음, 으으으으으읏!!"
  },
  "85": {
   "jp": "f4066e55",
   "kr": "마타리"
  },
  "86": {
   "jp": "25ce3d52",
   "kr": "으〜음, 으으으으읏!"
  },
  "87": {
   "jp": "22302196",
   "kr": "마타리는 날카로운 눈으로 알프를 살폈다."
  },
  "88": {
   "jp": "952e6ca8",
   "kr": "알프도 지지 않고 마타리를 마주 보았다."
  },
  "89": {
   "jp": "28a378a2",
   "kr": "쥬리오와 크리스에게는 노려보는 둘 사이에"
  },
  "90": {
   "jp": "00c2c656",
   "kr": "불꽃이 튀는 것처럼 보였다."
  },
  "91": {
   "jp": "b7037ad4",
   "kr": "찌릿〜!!"
  },
  "92": {
   "jp": "8b3f6d3f",
   "kr": "몰라뵈었습니다."
  },
  "93": {
   "jp": "6967f6e7",
   "kr": "얘기는 끝났네."
  },
  "94": {
   "jp": "701d84c3",
   "kr": "저기, 도대체"
  },
  "95": {
   "jp": "d3c2d9de",
   "kr": "무슨 수를 쓴 거야?"
  },
  "96": {
   "jp": "e7ccbfdd",
   "kr": "아니 아니, 눈싸움에서"
  },
  "97": {
   "jp": "77b54115",
   "kr": "이겼을 뿐일세."
  },
  "98": {
   "jp": "caf96c70",
   "kr": "핫핫핫…!"
  },
  "99": {
   "jp": "5af79308",
   "kr": "어쩐지 수상해."
  },
  "100": {
   "jp": "4714a4b1",
   "kr": "뭐 어떤가."
  },
  "101": {
   "jp": "b457e234",
   "kr": "아무튼 넬바로 서두르세."
  },
  "102": {
   "jp": "02e64793",
   "kr": "핫핫핫핫…"
  },
  "103": {
   "jp": "79898bb8",
   "kr": "너희처럼 넬바 쪽으로"
  },
  "104": {
   "jp": "a08db4fa",
   "kr": "가려는 사람이 있으니까"
  },
  "105": {
   "jp": "70e04110",
   "kr": "우리가 여기 있는 거야."
  },
  "106": {
   "jp": "90c6e2ce",
   "kr": "아직도 넬바에서"
  },
  "107": {
   "jp": "43e4543e",
   "kr": "피난 오는 사람들이 잔뜩 몰려오겠지."
  },
  "108": {
   "jp": "1054d57c",
   "kr": "어찌 될는지…"
  },
  "109": {
   "jp": "5d2e41de",
   "kr": "치타에서 좀 더 지켜보는 게 좋아."
  },
  "110": {
   "jp": "23ffe5e8",
   "kr": "설마 여기까진 안 올 것 같지만,"
  },
  "111": {
   "jp": "dcc773eb",
   "kr": "가루가가 어슬렁대고 있으니까."
  },
  "112": {
   "jp": "58e6ea26",
   "kr": "여어, 아까 그 여행자로군."
  },
  "113": {
   "jp": "159afe19",
   "kr": "넬바는 아직 위험할 테니까"
  },
  "114": {
   "jp": "2d539109",
   "kr": "조심하라고."
  },
  "115": {
   "jp": "5c4bf8e7",
   "kr": "은방울꽃 마을 치타에 어서 오세요!"
  },
  "116": {
   "jp": "ff9c5f38",
   "kr": "동 넬바 665미로"
  },
  "117": {
   "jp": "6e264844",
   "kr": "서 알데 1108미로"
  }
 }
