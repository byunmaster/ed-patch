  "9": {
   "jp": "eaba0c7d",
   "kr": "레이크 노인"
  },
  "10": {
   "jp": "3488f543",
   "kr": "체리"
  },
  "11": {
   "jp": "d55da5fe",
   "kr": "라크"
  },
  "12": {
   "jp": "576f95c5",
   "kr": "엘마 할머니"
  },
  "13": {
   "jp": "a0ed6390",
   "kr": "여기네."
  },
  "14": {
   "jp": "35164d2f",
   "kr": "성 아랫마을을 지나면 바로 성이네."
  },
  "15": {
   "jp": "0cb76f74",
   "kr": "병사가 있어."
  },
  "16": {
   "jp": "69d11caf",
   "kr": "괜찮다."
  },
  "17": {
   "jp": "b0fca67a",
   "kr": "저놈들은 내 얼굴을 모른다."
  },
  "18": {
   "jp": "2ebd1b05",
   "kr": "여기는 우선"
  },
  "19": {
   "jp": "cb7da4a4",
   "kr": "마을에서 정보를 모으죠."
  },
  "20": {
   "jp": "eac32805",
   "kr": "성의 상황을"
  },
  "21": {
   "jp": "1451e8a4",
   "kr": "알 수 있을지도 몰라요."
  },
  "22": {
   "jp": "93dda7a8",
   "kr": "관광객이냐?"
  },
  "23": {
   "jp": "aa5f6941",
   "kr": "아니면 지원병이냐?"
  },
  "24": {
   "jp": "5b8d7982",
   "kr": "엣?"
  },
  "25": {
   "jp": "0ec6b047",
   "kr": "과, 관광이에요."
  },
  "26": {
   "jp": "0df94204",
   "kr": "지금 루드성은 분주하다."
  },
  "27": {
   "jp": "47c57c22",
   "kr": "병사들에게 방해가 되지 않도록 해라."
  },
  "28": {
   "jp": "74c79ac3",
   "kr": "낯선 얼굴이군."
  },
  "29": {
   "jp": "b539918a",
   "kr": "입대 지원이라면 환영이다만"
  },
  "30": {
   "jp": "d26d266d",
   "kr": "노인에 여자, 애들이라니."
  },
  "31": {
   "jp": "289e64d7",
   "kr": "방해되지 않게 길가로나 걸어라."
  },
  "32": {
   "jp": "f946d492",
   "kr": ""
  },
  "33": {
   "jp": "92319ca9",
   "kr": "이 마을을 떠나간"
  },
  "34": {
   "jp": "e89b074f",
   "kr": "병사들 얼굴을 봤나?"
  },
  "35": {
   "jp": "7661c209",
   "kr": "마치 혼을 빼앗긴 자들처럼"
  },
  "36": {
   "jp": "1f48ff6a",
   "kr": "창백하고 표정이 없었어."
  },
  "37": {
   "jp": "cf00d468",
   "kr": "어쩐지 무섭구먼."
  },
  "38": {
   "jp": "8b5cb7d5",
   "kr": "무서워라, 무서워라."
  },
  "39": {
   "jp": "d117b4b2",
   "kr": "그 병사들은 예사롭지 않아."
  },
  "40": {
   "jp": "8e29d76e",
   "kr": "분명 좋지 않은 일이 일어날 거야."
  },
  "41": {
   "jp": "0f340766",
   "kr": "난 그렇게 생각한다우."
  },
  "42": {
   "jp": "37817777",
   "kr": "젊은이들은 모두"
  },
  "43": {
   "jp": "ec8f1fbf",
   "kr": "병사로 지원해 성에 들어간 채다."
  },
  "44": {
   "jp": "639090ec",
   "kr": "몇몇은 국경 경비 쪽으로 나갔다지만"
  },
  "45": {
   "jp": "54c0ee49",
   "kr": "대부분은 성에서 나오질 않네."
  },
  "46": {
   "jp": "9308c8fe",
   "kr": "대체"
  },
  "47": {
   "jp": "aa033ffd",
   "kr": "어떻게 된 걸까…"
  },
  "48": {
   "jp": "0628aef8",
   "kr": "병사는 폴티아 전국에서"
  },
  "49": {
   "jp": "da74fbb2",
   "kr": "모으고 있다더군…"
  },
  "50": {
   "jp": "ee683280",
   "kr": "성 안은 병사투성이라는 얘기로군."
  },
  "51": {
   "jp": "35fc59eb",
   "kr": "손님…"
  },
  "52": {
   "jp": "d5ce3b72",
   "kr": "카운터 안쪽은"
  },
  "53": {
   "jp": "fbd188cb",
   "kr": "제 전용 통로입니다."
  },
  "54": {
   "jp": "acc9a574",
   "kr": "어서 오십쇼."
  },
  "55": {
   "jp": "1b48dfb9",
   "kr": "우리 무기는"
  },
  "56": {
   "jp": "209835f3",
   "kr": "어느 것이나 손질이 잘돼 있죠."
  },
  "57": {
   "jp": "2e17e99a",
   "kr": "뭘 드릴까요?"
  },
  "58": {
   "jp": "6e502b26",
   "kr": "인가요."
  },
  "59": {
   "jp": "0d79ea00",
   "kr": "그러시다면"
  },
  "60": {
   "jp": "961bfc61",
   "kr": "에 팔겠습니다."
  },
  "61": {
   "jp": "c80c0189",
   "kr": "뭘 파시겠습니까?"
  },
  "62": {
   "jp": "941f0265",
   "kr": "인가요."
  },
  "63": {
   "jp": "241abf97",
   "kr": "그렇다면"
  },
  "64": {
   "jp": "67afcad1",
   "kr": "에 사들이겠습니다."
  },
  "65": {
   "jp": "49b537f5",
   "kr": "환전율은 1 Goa당 16 Pia입니다요."
  },
  "66": {
   "jp": "cfecd58d",
   "kr": "요즘은 재료가 아무리 있어도 부족해서요."
  },
  "67": {
   "jp": "35d9a055",
   "kr": "환전하시겠소?"
  },
  "68": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "69": {
   "jp": "ee93304e",
   "kr": "입니다."
  },
  "70": {
   "jp": "199e5a76",
   "kr": "라피카가 모자랍니다."
  },
  "71": {
   "jp": "34cb41dc",
   "kr": "모이면 언제든 오십쇼."
  },
  "72": {
   "jp": "bc85e763",
   "kr": "다른 볼일은 없습니까?"
  },
  "73": {
   "jp": "b330b3ee",
   "kr": "필요하실 땐 저희를 잊지 마십쇼!"
  },
  "74": {
   "jp": "cca55cd7",
   "kr": "젊은이가 없는 마을이라니 삭막하잖아요."
  },
  "75": {
   "jp": "68241c07",
   "kr": "처음엔 급료가 좋다느니 나라를 위해서라느니"
  },
  "76": {
   "jp": "2c119146",
   "kr": "어느 집 아들이든"
  },
  "77": {
   "jp": "290df24c",
   "kr": "앞다투어 병사에 지원했는데 말이죠."
  },
  "78": {
   "jp": "6a9622db",
   "kr": "이제는 이 루드 마을도"
  },
  "79": {
   "jp": "7dafc181",
   "kr": "젊은이가 한 명도 없어져서"
  },
  "80": {
   "jp": "35809980",
   "kr": "왠지 쓸쓸한 마을이 되어 버렸어."
  },
  "81": {
   "jp": "acc9a574",
   "kr": "어서 와."
  },
  "82": {
   "jp": "4f064e2e",
   "kr": "미안하지만 방은 비어 있질 않아."
  },
  "83": {
   "jp": "a4ce46dd",
   "kr": "안됐지만 다른 데를 알아봐 줘."
  },
  "84": {
   "jp": "2b3d221e",
   "kr": "브리트에게 노병이 찾아왔다고 전해라."
  },
  "85": {
   "jp": "f3958e8a",
   "kr": "당장이다."
  },
  "86": {
   "jp": "5d88d6da",
   "kr": "노병?"
  },
  "87": {
   "jp": "571e27ec",
   "kr": "『잔물결은 끝났다.』"
  },
  "88": {
   "jp": "e8042697",
   "kr": "그리 전하면 알 것이다."
  },
  "89": {
   "jp": "48c340d2",
   "kr": "당신은…?"
  },
  "90": {
   "jp": "96020ed2",
   "kr": "그런가… 알았어."
  },
  "91": {
   "jp": "b7114968",
   "kr": "브리트한테 얘기는 들었어."
  },
  "92": {
   "jp": "a9b9e2f3",
   "kr": "올라가서 오른쪽 방이 비어 있어."
  },
  "93": {
   "jp": "e7989e69",
   "kr": "거기서 쉬면서 기다려 줘."
  },
  "94": {
   "jp": "384ebf4d",
   "kr": "바로 사람을 보내지."
  },
  "95": {
   "jp": "2af0c987",
   "kr": "으음."
  },
  "96": {
   "jp": "298e2f3c",
   "kr": "잠시 2층 방에서 쉬고 있어 줘."
  },
  "97": {
   "jp": "ded9747e",
   "kr": "올라가서 오른쪽 방이 비어 있으니까."
  },
  "98": {
   "jp": "74fe60ac",
   "kr": "모스코스의 집은"
  },
  "99": {
   "jp": "e91c3e82",
   "kr": "성 입구의"
  },
  "100": {
   "jp": "97add87f",
   "kr": "바로 동쪽에 있는 집이야."
  },
  "101": {
   "jp": "bd92baaa",
   "kr": "브리트가"
  },
  "102": {
   "jp": "b60eca7d",
   "kr": "그 2층에서 만나자고 하더군."
  },
  "103": {
   "jp": "2af0c987",
   "kr": "으음."
  },
  "104": {
   "jp": "a2974480",
   "kr": "참, 그리고 말이야."
  },
  "105": {
   "jp": "6ccf6830",
   "kr": "이 여관이라면 안전해."
  },
  "106": {
   "jp": "323f3a53",
   "kr": "2층 방은"
  },
  "107": {
   "jp": "66bf2df6",
   "kr": "당신들을 위해 비워 두지."
  },
  "108": {
   "jp": "314b2029",
   "kr": "언제든 써 줘."
  },
  "109": {
   "jp": "01afc3a4",
   "kr": "나라 곳곳에서 모여든 젊은이가"
  },
  "110": {
   "jp": "de14c8a0",
   "kr": "이 여관 앞 거리를 지나"
  },
  "111": {
   "jp": "1b82b1c2",
