  },
  "113": {
   "jp": "5446e5f8",
   "kr": "이제 몇천 명이나 될 거예요."
  },
  "114": {
   "jp": "4dcd35ce",
   "kr": "이렇게 병사를 모아서"
  },
  "115": {
   "jp": "0a7e8100",
   "kr": "어쩌려는 걸까요."
  },
  "116": {
   "jp": "96e7b305",
   "kr": "젊은것들은"
  },
  "117": {
   "jp": "2ef9bc48",
   "kr": "죄다 병사가 되어 버렸다네."
  },
  "118": {
   "jp": "16016f74",
   "kr": "덕분에 여기는"
  },
  "119": {
   "jp": "e6a887cd",
   "kr": "노인네 마을이 되어 버렸지."
  },
  "120": {
   "jp": "00245241",
   "kr": "옆 성에는"
  },
  "121": {
   "jp": "1555775f",
   "kr": "젊은이가 많이 있을 텐데 말이야…"
  },
  "122": {
   "jp": "ba56d9db",
   "kr": "얼굴도 안 비치는군."
  },
  "123": {
   "jp": "e72905a3",
   "kr": "젊은이가 없으니"
  },
  "124": {
   "jp": "750f9d49",
   "kr": "잔소리할 상대가 없어"
  },
  "125": {
   "jp": "3a7cabf4",
   "kr": "재미가 없구먼."
  },
  "126": {
   "jp": "55c7f138",
   "kr": "요즘 성에서 무기 주문이"
  },
  "127": {
   "jp": "300a0b85",
   "kr": "끊이지 않고 들어와서"
  },
  "128": {
   "jp": "395ad8a9",
   "kr": "남편도 저도 싱글벙글이에요."
  },
  "129": {
   "jp": "2eecc87a",
   "kr": "그런데 어째서 이렇게 무기가 필요한 걸까."
  },
  "130": {
   "jp": "716125a1",
   "kr": "조금 걱정스럽기도 하네요."
  },
  "131": {
   "jp": "702b97d4",
   "kr": "나보다 나이 많은 형들은"
  },
  "132": {
   "jp": "96cee5e6",
   "kr": "다들 병사가 된다면서"
  },
  "133": {
   "jp": "21c9603f",
   "kr": "루드성에 들어가 버렸어."
  },
  "134": {
   "jp": "f841be82",
   "kr": "그래서 이 마을은"
  },
  "135": {
   "jp": "49aa8fa4",
   "kr": "노인들만 눈에 띈다구."
  },
  "136": {
   "jp": "51b9c1cd",
   "kr": "정말 재미없단 말이야."
  },
  "137": {
   "jp": "0ec6426a",
   "kr": "오오, 혹시 듀르젤 공이 아니십니까?"
  },
  "138": {
   "jp": "4a5846f0",
   "kr": "무사하셨군요…"
  },
  "139": {
   "jp": "2a8aad6f",
   "kr": "몸을 걱정하고 있었습니다."
  },
  "140": {
   "jp": "0fe67b72",
   "kr": "요즘"
  },
  "141": {
   "jp": "12f91eab",
   "kr": "성의 낌새가 이상하옵니다."
  },
  "142": {
   "jp": "d1b38882",
   "kr": "부디 살펴봐 주십시오."
  }
 }
