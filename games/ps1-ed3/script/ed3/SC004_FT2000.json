{
 "archive": "/SCE0/SC004.DAT",
 "member": "..\\DATA\\FT2000.BIN",
 "lines": {
  "0": {
   "jp": "1f7ed7e9",
   "kr": "라그나"
  },
  "1": {
   "jp": "f38ce153",
   "kr": "여관 주점 잘테"
  },
  "2": {
   "jp": "3832414a",
   "kr": "테토"
  },
  "3": {
   "jp": "ee8c58f3",
   "kr": "가보트"
  },
  "4": {
   "jp": "e8c8f502",
   "kr": "고메리"
  },
  "5": {
   "jp": "9e5f55ce",
   "kr": "레겐"
  },
  "6": {
   "jp": "cde20e65",
   "kr": "칸드의 눌루"
  },
  "7": {
   "jp": "95410ec2",
   "kr": "약방 리나"
  },
  "8": {
   "jp": "2156a869",
   "kr": "콜바 노인"
  },
  "9": {
   "jp": "87c571ec",
   "kr": "쥬프"
  },
  "10": {
   "jp": "5209efbe",
   "kr": "크룸"
  },
  "11": {
   "jp": "27ab0f1b",
   "kr": "로저"
  },
  "12": {
   "jp": "94c78bc6",
   "kr": "테스"
  },
  "13": {
   "jp": "28b450ac",
   "kr": "안내원 그리제"
  },
  "14": {
   "jp": "97100c24",
   "kr": "보롤 대장"
  },
  "15": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "16": {
   "jp": "8eb6d99d",
   "kr": "셰릴"
  },
  "17": {
   "jp": "2f38c254",
   "kr": "야호!"
  },
  "18": {
   "jp": "a95e28dd",
   "kr": "여기가 라그나야."
  },
  "19": {
   "jp": "a74a1d98",
   "kr": "쥬리오…"
  },
  "20": {
   "jp": "a42dcdac",
   "kr": "디네에 가지 않고 라그나에 오면"
  },
  "21": {
   "jp": "4dd823e6",
   "kr": "순례 여행이 안 되잖아."
  },
  "22": {
   "jp": "5fdff569",
   "kr": "야호! 여기가 라그나야."
  },
  "23": {
   "jp": "45401d2c",
   "kr": "우리가 탈 배는 아직 안 왔으려나?"
  },
  "24": {
   "jp": "5831c241",
   "kr": "항구에 가 볼까?"
  },
  "25": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "26": {
   "jp": "e4160956",
   "kr": "마을도 돌아다녀 보고 싶고."
  },
  "27": {
   "jp": "7ea8549a",
   "kr": "쥬리오!"
  },
  "28": {
   "jp": "5590ff80",
   "kr": "네?"
  },
  "29": {
   "jp": "66301b50",
   "kr": "쥬리오 맞지?"
  },
  "30": {
   "jp": "dec42dc6",
   "kr": "잊어버렸을지도 모르겠네."
  },
  "31": {
   "jp": "8b472931",
   "kr": "어릴 적 마을 외곽에서 길을 잃고 울었잖아?"
  },
  "32": {
   "jp": "04df3919",
   "kr": "앗! 그때 그 누나."
  },
  "33": {
   "jp": "74908c74",
   "kr": "기억났구나?"
  },
  "34": {
   "jp": "69e3c1d1",
   "kr": "쥬리오는 옛날과 전혀 달라지지 않았는걸."
  },
  "35": {
   "jp": "262ea00e",
   "kr": "금방 알아봤어."
  },
  "36": {
   "jp": "fe4ea1d8",
   "kr": "혹시 순례 여행이니?"
  },
  "37": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "38": {
   "jp": "d2102f90",
   "kr": "그땐 정말 고마웠어요."
  },
  "39": {
   "jp": "de154a07",
   "kr": "괜찮아, 그런 건."
  },
  "40": {
   "jp": "0a7b2b66",
   "kr": "참, 시간 있으면 놀러 오렴."
  },
  "41": {
   "jp": "d00e0450",
   "kr": "집은 서쪽 끝이니까 금방 알 거야."
  },
  "42": {
   "jp": "82a4087a",
   "kr": "그럼, 나중에 봐."
  },
  "43": {
   "jp": "260870a5",
   "kr": "쥬리오 길치는 유명하구나."
  },
  "44": {
   "jp": "92d9c191",
   "kr": "칫."
  },
  "45": {
   "jp": "3aa00c6b",
   "kr": "어릴 적 일인데 다들 기억하고 있다니까."
  },
  "46": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "47": {
   "jp": "7f1945fa",
   "kr": "미안하지만 미성년에겐 술을 못 낸단다."
  },
  "48": {
   "jp": "7f14e157",
   "kr": "대신 닭뼈 수프라도 어떠니?"
  },
  "49": {
   "jp": "9cfd9863",
   "kr": "순례 여행자가 찾아온 건"
  },
  "50": {
   "jp": "0ffde180",
   "kr": "어느덧 다섯 해 만이려나."
  },
  "51": {
   "jp": "39faab39",
   "kr": "무사히 여기까지 와서 다행이구나."
  },
  "52": {
   "jp": "0311699d",
   "kr": "어머, 이거 귀한 손님이네."
  },
  "53": {
   "jp": "8a8755c9",
   "kr": "순례 여행자구나."
  },
  "54": {
   "jp": "30fca2cf",
   "kr": "느긋하게 쉬다 가렴."
  },
  "55": {
   "jp": "52be8a46",
   "kr": "지쳤으면 쉬다 가렴."
  },
  "56": {
   "jp": "7c27a1f7",
   "kr": "사양할 것 없단다."
  },
  "57": {
   "jp": "7ae5319c",
   "kr": "이제 곧 배로 오빠 부부가 돌아와."
  },
  "58": {
   "jp": "92c1a73e",
   "kr": "유빙이 뜨면 항해를 못 하니까"
  },
  "59": {
   "jp": "16ae10a6",
   "kr": "간신히 맞춘 셈이지."
  },
  "60": {
   "jp": "b170f665",
   "kr": "왕도에선 서둘러 병사를 모으는 모양이더군."
  },
  "61": {
   "jp": "1fdbe438",
   "kr": "이 마을에서도 젊은이들이 꽤 끌려갔단다."
  },
  "62": {
   "jp": "17fd9206",
   "kr": "뒤숭숭해서 싫구나."
  },
  "63": {
   "jp": "1cc5b5cd",
   "kr": "하얀마녀가 목숨을 잃은 지도"
  },
  "64": {
   "jp": "16b22e91",
   "kr": "이제 20년쯤 되었으려나."
  },
  "65": {
   "jp": "9947521a",
   "kr": "빠르기도 하지."
  },
  "66": {
   "jp": "c29aa8ba",
   "kr": "하얀마녀?"
  },
  "67": {
   "jp": "876236ab",
   "kr": "아니, 별거 아니다."
  },
  "68": {
   "jp": "a3f6076a",
   "kr": "옛날이야기다."
  },
  "69": {
   "jp": "b41685e2",
   "kr": "너희가 태어나기 전의."
  },
  "70": {
   "jp": "f03361cd",
   "kr": "어서 오십시오. 말이 빚는 힘의 세계로."
  },
  "71": {
   "jp": "89255841",
   "kr": "어느 분께 전수할까요?"
  },
  "72": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "73": {
   "jp": "9511d337",
   "kr": "이시군요?"
  },
  "74": {
   "jp": "9030f7b5",
   "kr": "양심에 부끄럽지 않게 쓰십시오."
  },
  "75": {
   "jp": "aa928204",
   "kr": "또 들러 주십시오."
  },
  "76": {
   "jp": "e61b4d7d",
   "kr": "아가씨라면 틀림없으리라 봅니다만"
  },
  "77": {
   "jp": "f716a394",
   "kr": "부디 마법은 악용하지 마십시오."
  },
  "78": {
   "jp": "e5d92065",
   "kr": "사악한 생각은 제 몸에 되돌아오는 법입니다."
  },
  "79": {
   "jp": "aef4994e",
   "kr": "어서 오세요. 여기는 약방입니다."
  },
  "80": {
   "jp": "156c3c34",
   "kr": "어떤 약이 필요하신가요?"
  },
  "81": {
   "jp": "35f946e9",
   "kr": "엇, 전 건강하니까 약 같은 건"
  },
  "82": {
   "jp": "2e33dd9c",
   "kr": "필요 없어요."
  },
  "83": {
   "jp": "7f28c185",
   "kr": "이 안에 들어오면 안 돼."
  },
  "84": {
   "jp": "ae7a0521",
   "kr": "조합 중에는 잘못되면 큰일이니까"
  },
  "85": {
   "jp": "3c9d0ddb",
   "kr": "들어오지 말아 주렴."
  },
  "86": {
   "jp": "25927c30",
   "kr": "국왕께선 무리하게 병사를 늘리실"
  },
  "87": {
   "jp": "2ee68742",
   "kr": "분이 아니었는데…"
  },
  "88": {
   "jp": "9ebbba19",
   "kr": "마수를 쫓는 데는"
  },
  "89": {
   "jp": "f1133328",
   "kr": "예전 군대로도 충분할 텐데."
  },
  "90": {
   "jp": "df769be9",
   "kr": "소문에는 루데라 관문에서도"
  },
  "91": {
   "jp": "dc32af9b",
   "kr": "꽤 많은 젊은이가 징병에 응하고 있다더군."
  },
  "92": {
   "jp": "0d308cb8",
   "kr": "대체 왕도에서 무슨 일이 벌어지는 건지."
  },
  "93": {
   "jp": "a14c793c",
   "kr": "허크 씨를 찾아왔니?"
  },
  "94": {
   "jp": "c3c2040f",
   "kr": "그 사람은 영문 모를 소리를 하고는"
  },
  "95": {
   "jp": "5b77a1cf",
   "kr": "곧잘 집을 비우는 모양이던데."
  },
  "96": {
   "jp": "938c15c1",
   "kr": "허크 씨 집이라면 다리 건너편이야."
  },
  "97": {
   "jp": "81a24f04",
   "kr": "괴짜라고 온 마을이 다 아니까"
  },
  "98": {
   "jp": "5e9eee8d",
   "kr": "조심하는 게 좋아."
  },
  "99": {
   "jp": "a11cdd79",
   "kr": "너희도 매발톱호를 타니?"
  },
  "100": {
   "jp": "ef85b5bd",
   "kr": "선장 질버와는 옛날부터 아는 사이지만"
  },
  "101": {
   "jp": "d38f3a9c",
   "kr": "그 사람만큼 미더운 뱃사람은 둘도 없지."
  },
  "102": {
   "jp": "e8d447e6",
   "kr": "뭐, 닐리까지 가는 뱃길은"
  },
  "103": {
   "jp": "18c9d462",
   "kr": "안심하고 즐거운 뱃길임을 내가 보증하마."
  },
  "104": {
   "jp": "1c87aa70",
   "kr": "배는 돌아오고 나서도 이래저래 준비가 있어서"
  },
  "105": {
   "jp": "652c9e1e",
   "kr": "바로 출항 못 한단다."
  },
  "106": {
   "jp": "21f20654",
   "kr": "마을 구경을 하려거든 지금이 좋아."
  },
  "107": {
   "jp": "dd83d6a8",
   "kr": "헤에, 아직 순례 같은 관습이 남아 있구나."
  },
  "108": {
   "jp": "7b2fb966",
   "kr": "그럼, 닐리까지 함께네."
  },
  "109": {
   "jp": "272101ee",
   "kr": "잠깐이겠지만 잘 부탁해."
  },
  "110": {
   "jp": "de66accb",
   "kr": "나랑 로저는 지난주 왕도에서 식을 올리고"
  },
  "111": {
   "jp": "c25f09ed",
   "kr": "티라스일 곳곳을 신혼여행으로 돌고 있어."
  },
  "112": {
   "jp": "cbb4005b",
   "kr": "좀 미덥지 못한 데도 있지만"
  },
  "113": {
   "jp": "4b1b5687",
   "kr": "로저는 내게 가장 소중한 사람이야."
  },
  "114": {
   "jp": "d9ff84b5",
   "kr": "네, 어서 오세요."
  },
  "115": {
   "jp": "126c635e",
   "kr": "매발톱호를 이용하시나요?"
  },
  "116": {
   "jp": "1b7cabbe",
   "kr": "라그나와 닐리 사이를 잇는 쾌속정입니다."
  },
  "117": {
   "jp": "78b39ae4",
   "kr": "여객선으로는 폴티아에서도 최대일 겁니다."
  },
  "118": {
   "jp": "1124c6c5",
   "kr": "질버 선장을 비롯해 승무원은 일류 솜씨."
  },
  "119": {
   "jp": "d75a77cc",
   "kr": "분명 쾌적한 뱃길을 약속드릴 수 있어요."
  },
  "120": {
   "jp": "86653a17",
   "kr": "매발톱호는"
  },
  "121": {
   "jp": "2ffb4a5d",
   "kr": "이미 라그나 항에 입항했습니다."
  },
  "122": {
   "jp": "45876fb7",
   "kr": "곧 선창에 접안할 겁니다."
  },
  "123": {
   "jp": "4c655d0a",
   "kr": "출항까지는 조금 더 시간이 걸릴 듯합니다."
  },
  "124": {
   "jp": "a9d47564",
   "kr": "다시 와 주세요."
  },
  "125": {
   "jp": "ea066033",
   "kr": "다행이다."
  },
  "126": {
   "jp": "8b0cd755",
   "kr": "쥬리오, 배 오기 전에 디네로 서둘러야 해."
  },
  "127": {
   "jp": "5a8df31a",
   "kr": "안내 일은"
  },
  "128": {
   "jp": "f2311ca7",
   "kr": "여러 나라 사람과 얘기할 수 있어서"
  },
  "129": {
   "jp": "fff3f4e7",
   "kr": "무척 즐겁답니다."
  },
  "130": {
   "jp": "bcf10944",
   "kr": "푸른 책등의 책이 있습니다."
  },
  "131": {
   "jp": "c6c5b1eb",
   "kr": "읽어 보시겠습니까?"
  },
  "132": {
   "jp": "ddc9def3",
   "kr": "《여검사 사피 제1권 두 검사》"
  },
  "133": {
   "jp": "b994edba",
   "kr": "그녀가 왜 사피라 불리는지"
  },
  "134": {
   "jp": "717b98ea",
   "kr": "아는 사람은 드물다."
  },
  "135": {
   "jp": "bf989540",
   "kr": "눈동자가 사파이어처럼 푸르러서라고"
  },
  "136": {
   "jp": "c52bf7e2",
   "kr": "말하는 이도 있고"
  },
  "137": {
   "jp": "c922a848",
   "kr": "마음이 보석처럼 차갑다 수군대는 이도 있다."
  },
  "138": {
   "jp": "36ffc3a0",
   "kr": "그녀의 레이피어는 바람보다 붙잡기 어렵고"
  },
  "139": {
   "jp": "38b1cb59",
   "kr": "태양의 존재보다 확실했다."
  },
  "140": {
   "jp": "96771e3d",
   "kr": "남자 검사 사이에 섞여도"
  },
  "141": {
   "jp": "9d7bb90a",
   "kr": "그녀의 기술은 뒤처지기는커녕"
  },
  "142": {
   "jp": "a228421b",
   "kr": "오히려 더욱 빛나는 듯했다."
  },
  "143": {
   "jp": "fa666703",
   "kr": "그런 여검사 사피가"
  },
  "144": {
   "jp": "51e6150f",
   "kr": "유일한 호적수로 인정한 인물이 있었다."
  },
  "145": {
   "jp": "226badb7",
   "kr": "발하라의 검사 블러드."
  },
  "146": {
   "jp": "d9e8dc40",
   "kr": "이 두 검사의 명성은 왕족에게까지 닿았고"
  },
  "147": {
   "jp": "0d783b9d",
   "kr": "그들의 검은 두려움을 몰랐다."
  },
  "148": {
   "jp": "8f869d61",
   "kr": "서로 만나기 전까지는…"
  },
  "149": {
   "jp": "aa275a73",
   "kr": "재미있었어?"
  },
  "150": {
   "jp": "23659733",
   "kr": "그 책은 전부 아홉 권인데"
  },
  "151": {
   "jp": "2c7fab7b",
   "kr": "좀처럼 구할 수가 없어."
  },
  "152": {
   "jp": "7846c167",
   "kr": "또 읽고 싶어지면"
  },
  "153": {
   "jp": "5162594a",
   "kr": "언제든 읽어도 좋아."
  },
  "154": {
   "jp": "91037475",
   "kr": "지금은 됐어."
  },
  "155": {
   "jp": "41e23df8",
   "kr": "연안 경비 같은 건 지루하기 짝이 없다."
  },
  "156": {
