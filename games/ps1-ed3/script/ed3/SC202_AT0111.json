  "85": {
   "jp": "9629ccd5",
   "kr": "부디 들러 주세요."
  },
  "86": {
   "jp": "696b893d",
   "kr": "아, 임금님과 아는 분이시죠."
  },
  "87": {
   "jp": "ef61b7e1",
   "kr": "볼트에서 나가시는 건가요?"
  },
  "88": {
   "jp": "0330ee78",
   "kr": "아뇨, 그게 아니라"
  },
  "89": {
   "jp": "66c10515",
   "kr": "잠깐 산책하고 있었을 뿐이야."
  },
  "90": {
   "jp": "7083782a",
   "kr": "미안해요."
  },
  "91": {
   "jp": "ebf634e0",
   "kr": "일하시는 데 방해해서."
