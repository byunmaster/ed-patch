  },
  "79": {
   "jp": "54cbd554",
   "kr": "어느 분이 배우시겠어요?"
  },
  "80": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "81": {
   "jp": "941f0265",
   "kr": "말이군요."
  },
  "82": {
   "jp": "a6b82bc0",
   "kr": "전수하겠습니다."
  },
  "83": {
   "jp": "47a45d20",
   "kr": "병사들이 있는 동안은 여기 있을 테니"
  },
  "84": {
   "jp": "6dac9ffb",
   "kr": "볼일이 있으시거든"
