  "58": {
   "jp": "6b6b4c5e",
   "kr": "좋네."
  },
  "59": {
   "jp": "5f9a8a4c",
   "kr": "허나 한마디 해 두지."
  },
  "60": {
   "jp": "af707b57",
   "kr": "목숨을 함부로 하는 게 아닐세."
  },
  "61": {
   "jp": "735ea300",
   "kr": "두 사람은 여기서 기다리게."
  },
  "62": {
   "jp": "d32b4035",
   "kr": "알겠지?"
  },
  "63": {
   "jp": "43f1ac49",
   "kr": "이런 데서"
  },
  "64": {
   "jp": "6923ddd8",
   "kr": "기다리고 있을까 보냐."
  },
  "65": {
   "jp": "033c0fb9",
   "kr": "하지만…"
  },
  "66": {
   "jp": "1cdefca2",
   "kr": "하지만은 무슨."
  },
  "67": {
   "jp": "74316431",
   "kr": "가는 거야!"
  },
  "68": {
   "jp": "a7dcacc1",
   "kr": "이제 알프레드 왕의 말씀이 있어."
  },
  "69": {
   "jp": "297de990",
   "kr": "드디어 결전이군."
  },
  "70": {
   "jp": "afb50f89",
   "kr": "앰비쉬뿐 아니라"
  },
  "71": {
   "jp": "1b4fe63a",
   "kr": "세계의 운명이 이 싸움에 달렸어."
  },
  "72": {
   "jp": "4f884bd3",
