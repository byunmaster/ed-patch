  },
  "96": {
   "jp": "923cb523",
   "kr": "보초를 서고 있는 겁니다."
  },
  "97": {
   "jp": "fb4f20f9",
   "kr": "수고 많으셨어요."
  },
  "98": {
   "jp": "230110f9",
   "kr": "되도록 이 근처에 계세요."
  },
  "99": {
   "jp": "d4943635",
   "kr": "여러분이 없어지면"
  },
  "100": {
   "jp": "1a7c7622",
