  "73": {
   "jp": "9c096685",
   "kr": "이 볼트에서 끝난다."
  },
  "74": {
   "jp": "1b86c113",
   "kr": "무섭지 않냐고?"
  },
  "75": {
   "jp": "e8155efa",
   "kr": "나고 자란 이 나라를 목숨껏 지킬 뿐이야."
  },
  "76": {
   "jp": "4a635944",
   "kr": "여기서는 칸드 마법을 전수하고 있습니다."
  },
  "77": {
   "jp": "3d3144ba",
