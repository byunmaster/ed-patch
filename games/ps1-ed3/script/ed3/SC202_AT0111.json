  },
  "3": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "4": {
   "jp": "a2501ae9",
   "kr": "이제 알프레드 왕께서 작전을 말씀하십니다."
  },
  "5": {
   "jp": "dc6595c6",
   "kr": "들어야지."
  },
  "6": {
   "jp": "5991bb20",
   "kr": "우리도 줄을 서자."
  },
  "7": {
   "jp": "a2501ae9",
   "kr": "이제 알프레드 왕께서 작전을 말씀하십니다."
  },
  "8": {
   "jp": "dc6595c6",
   "kr": "들어야지."
  },
  "9": {
   "jp": "40a5b566",
   "kr": "우리도 줄 서자."
  },
  "10": {
   "jp": "c2d1f7d5",
   "kr": "이봐, 우리도 이야기 들어 보자."
  },
  "11": {
   "jp": "238e29ae",
   "kr": "모두들, 잘 들어라!"
  },
  "12": {
   "jp": "79a2a6a4",
   "kr": "지금부터"
  },
  "13": {
   "jp": "8cd4c7ae",
   "kr": "가루가 요격 작전을 설명한다."
  },
  "14": {
   "jp": "971e3a6e",
   "kr": "이 작전은 앰비쉬 건국 이래"
  },
  "15": {
   "jp": "0f148b3f",
   "kr": "대규모이면서 위험한 일이 될 것이다."
  },
  "16": {
   "jp": "98eb6ec0",
   "kr": "허나 제군이라면 반드시 해내리라 확신한다."
  },
  "17": {
   "jp": "31112563",
   "kr": "새겨들어 주길 바란다."
  },
  "18": {
   "jp": "f5bcb0c4",
   "kr": "대 가루가 요격 작전"
  },
  "19": {
   "jp": "a20d5949",
   "kr": "하나!"
  },
  "20": {
   "jp": "8db46250",
   "kr": "가루가가 볼트에 다가오면"
  },
  "21": {
   "jp": "b8e334e8",
   "kr": "화톳불을 피워"
  },
  "22": {
   "jp": "2e55d715",
   "kr": "그것으로 가루가의 진로를 유도한다."
  },
  "23": {
   "jp": "e0c7380a",
   "kr": "게르드의 예언에 불빛의 길을 만들어"
  },
  "24": {
   "jp": "990d7de0",
   "kr": "길을 가리키라 했다. 이 해석이 맞으면"
  },
  "25": {
   "jp": "36f95a61",
   "kr": "볼트의 직접 피해는 막을 수 있다."
  },
  "26": {
   "jp": "a52d6322",
   "kr": "작전 둘!"
  },
  "27": {
   "jp": "e3bfe0a0",
   "kr": "동쪽 골짜기로 유도한 가루가에게"
  },
  "28": {
   "jp": "ddd88501",
   "kr": "칸드 마스터 마기사의 힘을 빌려"
  },
  "29": {
   "jp": "af6caa5c",
   "kr": "퇴로를 차단한다."
  },
  "30": {
   "jp": "8ef42c11",
   "kr": "작전 셋!"
  },
  "31": {
   "jp": "d6899dae",
   "kr": "골짜기에 가둔 가루가를"
  },
  "32": {
   "jp": "f7b760cc",
   "kr": "다시 그물로 움직임을 봉하고"
  },
  "33": {
   "jp": "6dcbccd6",
   "kr": "일제 공격을 가한다."
  },
  "34": {
   "jp": "b46f16c6",
   "kr": "이상이다!"
  },
  "35": {
   "jp": "409ab40d",
   "kr": "가루가는 반드시 온다."
  },
  "36": {
   "jp": "5df554b3",
   "kr": "제군들의 건투를 빈다!"
  },
  "37": {
   "jp": "db0d1122",
   "kr": "작전 개시!!"
  },
  "38": {
   "jp": "46c38981",
   "kr": "앰비쉬 병사들"
  },
  "39": {
   "jp": "7a178bcf",
   "kr": "오오!!"
  },
  "40": {
   "jp": "52502f16",
   "kr": "이놈!"
  },
  "41": {
   "jp": "31923d09",
   "kr": "쥬리오와 크리스는 여기 남아 있게나."
  },
  "42": {
   "jp": "5d71449f",
   "kr": "폐하!"
  },
  "43": {
   "jp": "d89ed557",
   "kr": "가루가가 움직였습니다!!"
  },
  "44": {
   "jp": "f841f960",
   "kr": "기어이 왔군…!"
  },
  "45": {
   "jp": "6a7eee88",
   "kr": "수고했다, 위치로 돌아가라."
  },
  "46": {
   "jp": "4abd11a6",
   "kr": "옛!"
  },
  "47": {
   "jp": "1b84918a",
   "kr": "모리슨, 마기사."
  },
  "48": {
   "jp": "84aa2825",
   "kr": "준비에 들어가 주게."
  },
  "49": {
   "jp": "916e88ee",
   "kr": "알겠습니다."
  },
  "50": {
   "jp": "800af348",
   "kr": "최선을 다할게요."
  },
  "51": {
   "jp": "823a9855",
   "kr": "난 싸울 수 있다."
  },
  "52": {
   "jp": "4a53d9ed",
   "kr": "같이 싸우지."
  },
  "53": {
   "jp": "3d574956",
   "kr": "말려도 들을 것 같지 않군."
  },
  "54": {
   "jp": "32915b1a",
   "kr": "아무리 임금님 부탁이라도"
  },
  "55": {
   "jp": "7f777ae4",
   "kr": "가루가만은"
  },
  "56": {
   "jp": "5462bb95",
   "kr": "내가 확실히 결판을 낸다."
  },
  "57": {
   "jp": "3adae119",
   "kr": "………"
