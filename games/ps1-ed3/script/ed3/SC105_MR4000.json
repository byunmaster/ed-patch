 "archive": "/SCE1/SC105.DAT",
 "member": "..\\DATA\\MR4000.BIN",
 "lines": {
  "0": {
   "jp": "7b08c1b1",
   "kr": "쌍룡곡"
  },
  "1": {
   "jp": "516c18b3",
   "kr": "동 튜엘"
  },
  "2": {
   "jp": "ded433c1",
   "kr": "서 쌍룡곡 관문 934미로"
  },
  "3": {
   "jp": "48c34ff5",
   "kr": "좋아, 단숨에 밀고 가자."
  },
  "4": {
   "jp": "ef643fbf",
   "kr": "관문을 지나면 챠놈이다."
  },
  "5": {
   "jp": "702a935e",
   "kr": "챠놈 너머가 앰비쉬."
  },
  "6": {
   "jp": "c65f486e",
   "kr": "알프 아저씨와"
  },
  "7": {
   "jp": "8cc3626a",
   "kr": "어느 쪽이 빠른지 경주로군."
  },
  "8": {
   "jp": "e67f3b8d",
   "kr": "가루가와도 경주네!"
  },
  "9": {
   "jp": "ee50dcea",
   "kr": "그렇고말고."
  },
  "10": {
   "jp": "05ba46bb",
   "kr": "자, 가자!"
  },
  "11": {
   "jp": "409c04e4",
   "kr": "미안, 쥬리오."
  },
  "12": {
   "jp": "29b4ae32",
   "kr": "잠깐 기다려 줘"
  },
  "13": {
   "jp": "900415ed",
   "kr": "크리스, 스톱이다."
  },
  "14": {
   "jp": "868784c2",
   "kr": "잠깐 기다려…"
  },
  "15": {
   "jp": "e0ae0641",
   "kr": "아저씨, 잠깐 멈춰 봐."
  },
  "16": {
   "jp": "2ab47906",
   "kr": "이대로 챠놈에 들어가는 건"
  },
  "17": {
   "jp": "77058139",
   "kr": "마뜩잖군."
  },
  "18": {
   "jp": "43855a68",
   "kr": "뭔가 실마리가 필요해."
  },
  "19": {
   "jp": "f7944c1e",
   "kr": "챠놈은 가루가 피해를 안 입은 나라다."
  },
  "20": {
   "jp": "bf92caf0",
   "kr": "튜엘보다 정보가 모일 것 같진 않아."
  },
  "21": {
   "jp": "70fbd5e4",
   "kr": "나도 동감일세."
  },
  "22": {
   "jp": "c97fd930",
   "kr": "급하긴 하지만"
  },
  "23": {
   "jp": "a7fb236c",
   "kr": "놓친 게 있으면 목숨이 위태롭네."
  },
  "24": {
   "jp": "a97d066e",
   "kr": "이봐 이봐 여기까지 온 건 아저씨잖아?"
  },
  "25": {
   "jp": "bfb4e942",
   "kr": "으음."
  },
  "26": {
   "jp": "368c56ab",
   "kr": "튜엘에서 그리 멀리 안 왔으니"
  },
  "27": {
   "jp": "8b103633",
   "kr": "돌아가 보자."
  },
  "28": {
   "jp": "ff9ba434",
   "kr": "그러네."
  },
  "29": {
   "jp": "8dc23e38",
   "kr": "튜엘로 가자."
  },
  "30": {
   "jp": "ecc21d07",
   "kr": "아차, 튜엘은 저쪽이지."
  },
  "31": {
   "jp": "62eeecff",
   "kr": "이봐 이봐."
  },
  "32": {
   "jp": "c6f5d3ae",
   "kr": "그쪽은 챠놈이야."
  }
 }
}