{
 "archive": "/SCE2/SC200.DAT",
 "member": "..\\DATA\\CR0200.BIN",
 "lines": {
  "0": {
   "jp": "c0e6c7cc",
   "kr": "트루츠 가도"
  },
  "1": {
   "jp": "bdd9a814",
   "kr": "양치기 무톤"
  },
  "2": {
   "jp": "62f4fe51",
   "kr": "양"
  },
  "3": {
   "jp": "aed514cf",
   "kr": "메에메에메에."
  },
  "4": {
   "jp": "0b49ee6c",
   "kr": "메에엣!"
  },
  "5": {
   "jp": "291956e8",
   "kr": "메에이, 메에이, 메엣!"
  },
  "6": {
   "jp": "a7bcd354",
   "kr": "메메엣. 메메엣!"
  },
  "7": {
   "jp": "635ac702",
   "kr": "이상하네?"
  },
  "8": {
   "jp": "fdb7b2f9",
   "kr": "양이 한 마리 모자라."
  },
  "9": {
   "jp": "019ebb26",
   "kr": "양 하나."
  },
  "10": {
   "jp": "1066fe40",
   "kr": "양 둘."
  },
  "11": {
   "jp": "4b666edc",
   "kr": "양 셋."
  },
  "12": {
   "jp": "ca3d1c6c",
   "kr": "어라…"
  },
  "13": {
   "jp": "3fae863d",
   "kr": "어쩐지 졸음이 오기 시작했어."
  },
  "14": {
   "jp": "512e4d2f",
   "kr": "안 돼. 안 돼."
  },
  "15": {
   "jp": "3ca26710",
   "kr": "양이 네 마리지."
  },
  "16": {
   "jp": "830a9937",
   "kr": "으〜음"
  },
  "17": {
   "jp": "fabf4cbe",
   "kr": "역시 한 마리 모자라네."
  },
  "18": {
   "jp": "6cc1138b",
   "kr": "도중에 놓쳤나."
  },
  "19": {
   "jp": "9a4b12ea",
   "kr": "없는 건 사치인가…"
  },
  "20": {
   "jp": "29fad714",
   "kr": "난처하네…"
  },
  "21": {
   "jp": "96bb4c60",
   "kr": "양을 잃어버렸다고 하면"
  },
  "22": {
   "jp": "192331ef",
   "kr": "주인님한테 호되게 혼날 거야."
  },
  "23": {
   "jp": "35be73a5",
   "kr": "아, 저게 분명 사치야."
  },
  "24": {
   "jp": "c225fb4d",
   "kr": "아, 양이 있어."
  },
  "25": {
   "jp": "47a55996",
   "kr": "사치, 이런 데 있었구나."
  },
  "26": {
   "jp": "e728daa2",
   "kr": "아이고, 살았어요."
  },
  "27": {
   "jp": "20de9491",
   "kr": "마수에게 습격당한 건 아닐까"
  },
  "28": {
   "jp": "36ff9be9",
   "kr": "걱정하던 참이었어요."
  },
  "29": {
   "jp": "f773365d",
   "kr": "마수도 나오니"
  },
  "30": {
   "jp": "96815b3f",
   "kr": "양치기 힘들겠네요."
  },
  "31": {
   "jp": "baa18e35",
   "kr": "조심하세요."
  },
  "32": {
   "jp": "7737fba5",
   "kr": "정말 살았어요."
  },
  "33": {
   "jp": "46e94f5d",
   "kr": "이 녀석, 사치라고 해요."
  },
  "34": {
   "jp": "e9227228",
   "kr": "굼떠서, 금방 뒤처져요."
  },
  "35": {
   "jp": "fbf47c88",
   "kr": "이놈, 사치."
  },
  "36": {
   "jp": "821efd66",
   "kr": "이제 떨어지면 안 돼."
  },
  "37": {
   "jp": "d94469b1",
   "kr": "메에에엣…"
  },
  "38": {
   "jp": "346ef4c3",
   "kr": "양은 참 귀엽네요."
  },
  "39": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "40": {
   "jp": "5f17b3e2",
   "kr": "그럼, 나는,"
  },
  "41": {
   "jp": "c0d86a62",
   "kr": "다른 양들이 걱정되니까 돌아갈게."
  },
  "42": {
   "jp": "7aa5cd4f",
   "kr": "사치, 자 가자."
  },
  "43": {
   "jp": "599b6f04",
   "kr": "그럼, 안녕히!"
  },
  "44": {
   "jp": "a9ad33f6",
   "kr": "안녕."
  },
  "45": {
   "jp": "bea3dff3",
   "kr": "또 봐요!"
  }
 }
}