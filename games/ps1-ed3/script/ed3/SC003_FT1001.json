{
 "archive": "/SCE0/SC003.DAT",
 "member": "..\\DATA\\FT1001.BIN",
 "lines": {
  "0": {
   "jp": "4585cee4",
   "kr": "디네"
  },
  "1": {
   "jp": "a82af9b4",
   "kr": "샤리네"
  },
  "2": {
   "jp": "cb7a2160",
   "kr": "디네의 현자"
  },
  "3": {
   "jp": "2a47bd9b",
   "kr": "이 문 안쪽이 디네의 거울 방입니다."
  },
  "4": {
   "jp": "8159ddff",
   "kr": "안에 들어가 은단검을 받침대에 놓으십시오."
  },
  "5": {
   "jp": "eb5c9456",
   "kr": "그러면 마법의 거울이 응답할 것입니다."
  },
  "6": {
   "jp": "20f50a60",
   "kr": "여기부터는 순례자만 들어갈 성역입니다."
  },
  "7": {
   "jp": "dd261bf4",
   "kr": "일생에 한 번뿐인 마법의 거울."
  },
  "8": {
   "jp": "516bc4fb",
   "kr": "마음에 새기십시오."
  },
  "9": {
   "jp": "dbbae5fe",
   "kr": "어떠셨습니까?"
  },
  "10": {
   "jp": "524b12ce",
   "kr": "네? 그런 일이…"
  },
  "11": {
   "jp": "0adfee85",
   "kr": "조금 더 자세히 들려주시겠습니까?"
  },
  "12": {
   "jp": "0a7426f7",
   "kr": "제 방으로 가시지요."
  },
  "13": {
   "jp": "a427bd95",
   "kr": "크리스! 봐!"
  },
  "14": {
   "jp": "effeba23",
   "kr": "이렇게 물이 맑다니."
  },
  "15": {
   "jp": "5c206e54",
   "kr": "우물물도 여기만큼 깨끗하진 않아."
  },
  "16": {
   "jp": "a74a1d98",
   "kr": "쥬리오…"
  },
  "17": {
   "jp": "1412554d",
   "kr": "현자님이 단검을 놓으라고 한 곳에"
  },
  "18": {
   "jp": "e7f9725d",
   "kr": "올라서 있어도 돼?"
  },
  "19": {
   "jp": "b3c0bbb5",
   "kr": "아차."
  },
  "20": {
   "jp": "ad563d4d",
   "kr": "어서 은단검을 놓자."
  },
  "21": {
   "jp": "c6dec0f4",
   "kr": "왠지 두근두근하네."
  },
  "22": {
   "jp": "8374176a",
   "kr": "난 조마조마해."
  },
  "23": {
   "jp": "7b1b4d99",
   "kr": "뭐, 뭐였을까…"
  },
  "24": {
   "jp": "e7f530de",
   "kr": "방금 그 소용돌이는."
  },
  "25": {
   "jp": "53c0ebd2",
   "kr": "어쩐지 불길한 느낌이었어."
  },
  "26": {
   "jp": "fe0a4465",
   "kr": "마을 사람들은"
  },
  "27": {
   "jp": "b0f59dc0",
   "kr": "무척 예쁘다고 했었는데."
  },
  "28": {
   "jp": "89a7343a",
   "kr": "현자님께 여쭤 보자."
  },
  "29": {
   "jp": "327fcd89",
   "kr": "크리스?"
  },
  "30": {
   "jp": "94b00320",
   "kr": "… 지금 갈게."
  }
 }
}