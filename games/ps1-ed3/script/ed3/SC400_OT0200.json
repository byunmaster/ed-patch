   "kr": "신관 구역"
  },
  "1": {
   "jp": "3dbca51b",
   "kr": "룽그"
  },
  "2": {
   "jp": "3199b7d2",
   "kr": "그릭"
  },
  "3": {
   "jp": "961f968c",
   "kr": "죠와"
  },
  "4": {
   "jp": "085b08ea",
   "kr": "벨치"
  },
  "5": {
   "jp": "57e1d577",
   "kr": "프로이"
  },
  "6": {
   "jp": "7225b9c9",
   "kr": "승병"
  },
  "7": {
   "jp": "cbb7b8bd",
   "kr": "마법의 거울의 영상은"
  },
  "8": {
   "jp": "22733207",
   "kr": "사람마다 주어지는 메시지입니다."
  },
  "9": {
   "jp": "eaf6493d",
   "kr": "하지만 그 메시지도"
  },
  "10": {
   "jp": "1c360494",
   "kr": "받은 이의 됨됨이에 따라"
  },
  "11": {
   "jp": "38c69d8f",
   "kr": "헛되이 끝나는 일도 있습니다."
  },
  "12": {
   "jp": "80ba2efd",
   "kr": "중요한 것은 마법의 거울에서"
  },
  "13": {
   "jp": "3efbdde7",
   "kr": "메시지를 느끼는 것이 아닙니다."
  },
  "14": {
   "jp": "036af503",
   "kr": "메시지를 받은 다음에"
  },
  "15": {
   "jp": "746bde06",
   "kr": "그 사람이 어떤 행동을 하는가가"
  },
  "16": {
   "jp": "10c6dbdb",
   "kr": "가장 소중한 것입니다."
  },
  "17": {
   "jp": "279cb02b",
   "kr": "이런, 순례자치고는 젊으시군요."
  },
  "18": {
   "jp": "c31057e6",
   "kr": "아니, 실례했습니다."
  },
  "19": {
   "jp": "7fad1364",
   "kr": "순례에 나이 따위 상관없었지요."
  },
  "20": {
   "jp": "4526e6d4",
   "kr": "부디 이 여행을 살려서"
  },
  "21": {
   "jp": "850d8ee9",
   "kr": "세계를 짊어질 큰 마음을 지닌 어른이"
  },
  "22": {
   "jp": "63ca2915",
   "kr": "되어 주십시오."
  },
  "23": {
   "jp": "51d18c40",
   "kr": "호오, 큰 메시지를 받은 모양이군."
  },
  "24": {
   "jp": "4f1e64d2",
   "kr": "나로선 자네들이 본 것은 알 수 없네만"
  },
  "25": {
   "jp": "dd49e3cf",
   "kr": "그 중대함은 이해가 되네."
  },
  "26": {
   "jp": "27d078b5",
   "kr": "알겠는가?"
  },
  "27": {
   "jp": "6571e9db",
   "kr": "메시지를 받고 그저 놀랄 게 아니라."
  },
  "28": {
   "jp": "1e4b9646",
   "kr": "스스로 할 바를 생각하고"
  },
  "29": {
   "jp": "79d14075",
   "kr": "그리고 그것을 실행해야 하네."
  },
  "30": {
   "jp": "86ac1bcb",
   "kr": "대성당의 마법의 거울은 벌써 보았는가?"
  },
  "31": {
   "jp": "f43c947d",
   "kr": "아뇨, 아직이에요."
  },
  "32": {
   "jp": "f7fc6e93",
   "kr": "여기까지 여행해 왔으니"
  },
  "33": {
   "jp": "b84efc64",
   "kr": "마법의 거울이 그저 아름다운 영상만을"
  },
  "34": {
   "jp": "8e45e1cc",
   "kr": "거울이 아님은 이미 알고 있을 테지."
  },
  "35": {
   "jp": "bb3d5af3",
   "kr": "이 올도스에 있는 마법의 거울은"
  },
  "36": {
   "jp": "d2c8d54e",
   "kr": "다섯 샤리네에 있는 어느 마법의 거울보다도"
  },
  "37": {
   "jp": "4e67d590",
   "kr": "가장 뚜렷이 메시지를 전하는 것이라네."
  },
  "38": {
   "jp": "ee302fc5",
   "kr": "다만 무엇을 보아도 놀라선 안 되네."
  },
  "39": {
   "jp": "c8c4fe9f",
   "kr": "영상을 보고 그저 놀랄 게 아니라"
  },
  "40": {
   "jp": "1e4b9646",
   "kr": "스스로 할 바를 생각하고"
  },
  "41": {
   "jp": "79d14075",
   "kr": "그리고 그것을 실행해야 하네."
  },
  "42": {
   "jp": "0f6f604c",
   "kr": "어머, 얼굴이 좀 굳어 있네요."
  },
  "43": {
   "jp": "a722c7ed",
   "kr": "너무 고민하지 않으시길 권해 드려요."
  },
  "44": {
   "jp": "a96158de",
   "kr": "아무리 큰 문제라도"
  },
  "45": {
   "jp": "366083ad",
   "kr": "분명 청소와 같답니다."
  },
  "46": {
   "jp": "10db2f1e",
   "kr": "하나하나"
  },
  "47": {
   "jp": "ea5048b1",
   "kr": "서두르지 않고 치워 가면"
  },
  "48": {
   "jp": "4eef28be",
   "kr": "반드시 언젠가 깨끗해지는 법이죠."
  },
  "49": {
   "jp": "e1ee9b73",
   "kr": "힘내세요."
  },
  "50": {
   "jp": "8b9631a0",
   "kr": "다들 대성당에 들어가시면"
  },
  "51": {
   "jp": "edffe1a7",
   "kr": "며칠이나 집을 비우시니까"
  },
  "52": {
   "jp": "87682439",
   "kr": "그동안에 빨래 같은 걸 하고 있답니다."
  },
  "53": {
   "jp": "68fc55e8",
   "kr": "신관님들도 힘드시겠지요."
  },
  "54": {
   "jp": "da87ede3",
   "kr": "이야 자네들 이제부터 참배인가?"
  },
  "55": {
   "jp": "dc9cccee",
   "kr": "나는 방금 마법의 거울을"
  },
  "56": {
   "jp": "aed0dfe5",
   "kr": "보고 온 참이라네."
  },
  "57": {
   "jp": "af65f7d6",
   "kr": "다섯 샤리네의 거울을 보고 왔네만"
  },
  "58": {
   "jp": "ee140910",
   "kr": "마법의 거울은 참으로 신기하구먼."
  },
  "59": {
   "jp": "c6bcf3da",
   "kr": "늙은 몸인 저에게도"
  },
  "60": {
   "jp": "0c9158e8",
   "kr": "샤리네의 마법의 거울 영상은"
  },
  "61": {
   "jp": "6a62372a",
   "kr": "또렷하게 보이니 말일세."
  },
  "62": {
   "jp": "844462fa",
   "kr": "저는 본가의 칸드를 잇기 위해"
  },
  "63": {
   "jp": "25916e00",
   "kr": "수행하러 왔습니다만"
  },
  "64": {
   "jp": "1fa68e3a",
   "kr": "역시 올도스는 대단한 곳이네요."
  },
  "65": {
   "jp": "4a8fa921",
   "kr": "여기 오면 칸드도 챠펠도"
  },
  "66": {
   "jp": "4880524e",
   "kr": "본디 하나의 마법이었다고 실감합니다."
  },
  "67": {
   "jp": "d6ca4a5e",
   "kr": "옛날엔 분명"
  },
  "68": {
   "jp": "bc75d2d0",
   "kr": "대마법사나 대마도사가"
  },
  "69": {
   "jp": "134b0b81",
   "kr": "꽤 있었겠지요."
  },
  "70": {
   "jp": "d3be3063",
   "kr": "순례 여행은 고향에 돌아가기까지 이어집니다."
  },
  "71": {
   "jp": "12818054",
   "kr": "돌아가는 길에도 더욱 정진에 힘쓰십시오."
  },
  "72": {
   "jp": "6c7f6e88",
   "kr": "올도스 대성당에 어서 오십시오."
  },
  "73": {
   "jp": "77f5f615",
   "kr": "부디 들어오십시오."
  },
  "74": {
   "jp": "f594afe6",
   "kr": "대성당 참배는 단 한 번뿐입니다."
  },
  "75": {
   "jp": "a7cab183",
   "kr": "마음의 눈을 뜨시고"
  },
  "76": {
   "jp": "bf9fd48e",
   "kr": "놓치지 않도록 보십시오."
  },
  "77": {
   "jp": "ca35b267",
   "kr": "고생 많으셨습니다."
  },
  "78": {
   "jp": "dd845cb6",
   "kr": "조심해서 돌아가십시오."
  },
  "79": {
   "jp": "1f496d16",
   "kr": "순례 여행 고생 많으시옵니다."
  },
  "80": {
   "jp": "72c95785",
   "kr": "하늘의 샤리네는 대성당 안에 있사옵니다."
  },
  "81": {
   "jp": "e5c8139c",
   "kr": "이곳이 생긴 때부터의 규정으로"
  },
  "82": {
   "jp": "1887e31c",
   "kr": "대성당 참배는 단 한 번뿐입니다."
  },
  "83": {
   "jp": "bf9fd48e",
   "kr": "놓치지 않도록 보십시오."
  },
  "84": {
   "jp": "f594afe6",
   "kr": "대성당 참배는 단 한 번뿐입니다."
  },
  "85": {
   "jp": "6bf5b57c",
   "kr": "이제는 여러분 자신이 마음에 받은 메시지를"
  },
  "86": {
   "jp": "b6212c2e",
   "kr": "어떻게 받아들이느냐 하는 문제겠지요."
  }
 }
