  "4": {
   "jp": "cde94c98",
   "kr": "탄돌"
  },
  "5": {
   "jp": "1a60322f",
   "kr": "당장은 좋아지지 않을지도 모르지만"
  },
  "6": {
   "jp": "a09a81ab",
   "kr": "이걸로 이 기드나도"
  },
  "7": {
   "jp": "61dc6201",
   "kr": "분명 살기 좋아지겠죠."
  },
  "8": {
   "jp": "ba1eda9f",
   "kr": "우르기드 님이 마음을 고쳐먹은 모양이야."
  },
  "9": {
   "jp": "3af3c132",
   "kr": "장사 욕심도 지나치면"
  },
  "10": {
   "jp": "d108c240",
   "kr": "위험하단 걸 잘 알았어."
  },
  "11": {
   "jp": "c02e671c",
   "kr": "앞으로는"
  },
  "12": {
   "jp": "a3685f2a",
   "kr": "손님 생각하는 착실한 장사를"
  },
  "13": {
   "jp": "dfc2fb71",
   "kr": "해 주면 좋겠군."
  },
  "14": {
   "jp": "d78571c3",
   "kr": "그게 말이야."
  },
  "15": {
   "jp": "cd6eb000",
   "kr": "우르기드 님도 칸다타도"
  },
  "16": {
   "jp": "7a3b3f71",
   "kr": "완전히 마음을 고쳐먹은 모양이야."
  },
  "17": {
   "jp": "16fc2f84",
   "kr": "무슨 바람이 분 건지는 모르지만"
  },
  "18": {
   "jp": "fb70d04a",
   "kr": "기드나에 사는 우리한텐 좋은 일이지."
  },
  "19": {
   "jp": "ddb195b1",
   "kr": "꿈이라면 깨지 않았으면 좋겠어."
