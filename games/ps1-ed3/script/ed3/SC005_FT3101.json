{
 "archive": "/SCE0/SC005.DAT",
 "member": "..\\DATA\\FT3101.BIN",
 "lines": {
  "0": {
   "jp": "c9fab11d",
   "kr": "매발톱호"
  },
  "1": {
   "jp": "d12e283a",
   "kr": "우리 방도 청소해야지."
  },
  "2": {
   "jp": "c53bc5a4",
   "kr": "…어라?"
  },
  "3": {
   "jp": "29fbde8a",
   "kr": "어쩐지 아까랑 달라진 것 같은…"
  },
  "4": {
   "jp": "aaebc55e",
   "kr": "기분 탓이겠지, 분명."
  },
  "5": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "6": {
   "jp": "593667f1",
   "kr": "깨끗, 깨끗."
  },
  "7": {
   "jp": "9a6a3225",
   "kr": "여기는 빈방인가."
  },
  "8": {
   "jp": "6adbd6db",
   "kr": "좋아! 힘내서 깨끗이 하자."
  },
  "9": {
   "jp": "16c794c4",
   "kr": "좋아!"
  },
  "10": {
   "jp": "ac92a76d",
   "kr": "이 방은 이걸로 끝."
  },
  "11": {
   "jp": "93dd5961",
   "kr": "어라? 안 열리네."
  },
  "12": {
   "jp": "70354164",
   "kr": "……"
  },
  "13": {
   "jp": "96536ad7",
   "kr": "실례합니다, 안 계세요?"
  },
  "14": {
   "jp": "931e2354",
   "kr": "방 청소하러 왔어요."
  },
  "15": {
   "jp": "8876b227",
   "kr": "(젠장.)"
  },
  "16": {
   "jp": "76a39a87",
   "kr": "(왜 저 꼬마가 청소하러 오는 거야.)"
  },
  "17": {
   "jp": "5a0b961e",
   "kr": "(내가 알 리 없잖아.)"
  },
  "18": {
   "jp": "dde70e49",
   "kr": "(그보다 창문으로 들여다보면 큰일이야!)"
  },
  "19": {
   "jp": "82a1ef2f",
   "kr": "안 계신가요?"
  },
  "20": {
   "jp": "f0d272ca",
   "kr": "(어쩔 수 없네.)"
  },
  "21": {
   "jp": "50d282a0",
   "kr": "(뭐라도 대답해.)"
  },
  "22": {
   "jp": "25fdd3f4",
   "kr": "(내가?)"
  },
  "23": {
   "jp": "e14d915c",
   "kr": "(너 말고 누가 있어.)"
  },
  "24": {
   "jp": "c780a03d",
   "kr": "(칫, 어쩔 수 없군.)"
  },
  "25": {
   "jp": "35fef691",
   "kr": "미, 미안하지만"
  },
  "26": {
   "jp": "4008a123",
   "kr": "낮잠 자는 중이라 청소는 됐어."
  },
  "27": {
   "jp": "a03a3a36",
   "kr": "나중에 알아서 할게."
  },
  "28": {
   "jp": "2a557a0d",
   "kr": "맡겨 둬."
  },
  "29": {
   "jp": "a83577aa",
   "kr": "그런가요."
  },
  "30": {
   "jp": "0e1b78f9",
   "kr": "그럼, 부탁드릴게요."
  },
  "31": {
   "jp": "de989548",
   "kr": "후우…"
  },
  "32": {
   "jp": "1eed8da5",
   "kr": "한숨밖에 안 나오네."
  },
  "33": {
   "jp": "c8cf5df0",
   "kr": "이웃이니까"
  },
  "34": {
   "jp": "891f45c4",
   "kr": "인사 정도는 해 둬야지."
  },
  "35": {
   "jp": "b63e6d37",
   "kr": "안녕하세요."
  },
  "36": {
   "jp": "32ab0b30",
   "kr": "(또 왔잖아!)"
  },
  "37": {
   "jp": "09eb6744",
   "kr": "(혼쭐을 내 줄까?)"
  },
  "38": {
   "jp": "ad220c03",
   "kr": "(바보!)"
  },
  "39": {
   "jp": "a6ed6c53",
   "kr": "(닐리에 닿을 때까지 도망칠 곳도 없어.)"
  },
  "40": {
   "jp": "e843841e",
   "kr": "(어떻게든 얼버무려.)"
  },
  "41": {
   "jp": "12440026",
   "kr": "드르렁!"
  },
  "42": {
   "jp": "c60a39d0",
   "kr": "드르렁, 그르렁."
  },
  "43": {
   "jp": "553b2103",
   "kr": "벌써 자 버렸구나."
  },
  "44": {
   "jp": "914db0d6",
   "kr": "근데 굉장한 코골이네."
  },
  "45": {
   "jp": "29039df7",
   "kr": "안 들여보내 주니"
  },
  "46": {
   "jp": "c579357b",
   "kr": "어떤 사람인지 궁금해지는걸."
  },
  "47": {
   "jp": "0c0036b9",
   "kr": "저렇게 코를 골면"
  },
  "48": {
   "jp": "d42f54ed",
   "kr": "같이 있는 사람은 잠 못 자겠어."
  },
  "49": {
   "jp": "0c8eb4ff",
   "kr": "위험해!"
  },
  "50": {
   "jp": "a6a9e151",
   "kr": "저 꼬맹이가 엿보고 있어!"
  },
  "51": {
   "jp": "7c72c99d",
   "kr": "숨는 거야!"
  },
  "52": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "53": {
   "jp": "23bae268",
   "kr": "이 방 손님은"
  },
  "54": {
   "jp": "ed456ebe",
   "kr": "어디 있는 걸까?"
  },
  "55": {
   "jp": "35f1612a",
   "kr": "엄청"
  },
  "56": {
   "jp": "05d8d347",
   "kr": "부끄럼쟁이인 걸까?"
  },
  "57": {
   "jp": "db7a822d",
   "kr": "크리스도 참 늦네…"
  },
  "58": {
   "jp": "3f7fa6ea",
   "kr": "책이라도 읽으며 기다려야지."
  },
  "59": {
   "jp": "1650d802",
   "kr": "앗! 캡틴 토마스가 있다."
  },
  "60": {
   "jp": "8dac430f",
   "kr": "오랜만에 찬찬히 읽어 볼까."
  },
  "61": {
   "jp": "4b12a626",
   "kr": "어라? 뭐지, 이 책."
  },
  "62": {
   "jp": "55d87f67",
   "kr": "…우와. 좀 야한 책이야."
  },
  "63": {
   "jp": "4785fd28",
   "kr": "괘, 괜찮으려나?"
  },
  "64": {
   "jp": "a88463f7",
   "kr": "아무도 없겠지."
  },
  "65": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "66": {
   "jp": "082ed7ff",
   "kr": "뭐 읽고 있어?"
  },
  "67": {
   "jp": "5cdd9964",
   "kr": "아, 아무것도 아니야!"
  },
  "68": {
   "jp": "8414645c",
   "kr": "정말로 아무것도 아니야!"
  },
  "69": {
   "jp": "2e493f9a",
   "kr": "수상해."
  },
  "70": {
   "jp": "9a6475ca",
   "kr": "수상하긴 뭐가!"
  },
  "71": {
   "jp": "52964a79",
   "kr": "그보다 크리스도 피곤하지?"
  },
  "72": {
   "jp": "d3984066",
   "kr": "이제 자자."
  },
  "73": {
   "jp": "e3424497",
   "kr": "흐〜음."
  },
  "74": {
   "jp": "423a8334",
   "kr": "뭐, 됐어."
  },
  "75": {
   "jp": "9ba29d4c",
   "kr": "내일도 일찍이니까 자자."
  },
  "76": {
   "jp": "eaf5d5a5",
   "kr": "(휴우…)"
  },
  "77": {
   "jp": "30713747",
   "kr": "하루 종일 배 안을 여기저기"
  },
  "78": {
   "jp": "7831de37",
   "kr": "돌아다닌 덕분에 뱃멀미도 안 했어."
  },
  "79": {
   "jp": "94eeb86f",
   "kr": "배 주위가 전부 바다라니"
  },
  "80": {
   "jp": "56ed9530",
   "kr": "굉장해."
  },
  "81": {
   "jp": "f14b1ea0",
   "kr": "라그픽 마을 주위는"
  },
  "82": {
   "jp": "839ef088",
   "kr": "온통 산인걸."
  },
  "83": {
   "jp": "c0712140",
   "kr": "좋〜아."
  },
  "84": {
   "jp": "d407c00b",
   "kr": "내일도 힘내야지."
  },
  "85": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "86": {
   "jp": "f4f4df02",
   "kr": "힘내자."
  },
  "87": {
   "jp": "67e36aba",
   "kr": "이렇게 매발톱호의 첫날은"
  },
  "88": {
   "jp": "26a93235",
   "kr": "눈 깜짝할 새 지나갔다."
  }
 }
}