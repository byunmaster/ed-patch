   "jp": "0f879f86",
   "kr": "보스레이"
  },
  "2": {
   "jp": "87ed524e",
   "kr": "가톤"
  },
  "3": {
   "jp": "c1b14629",
   "kr": "브루트"
  },
  "4": {
   "jp": "73e57527",
   "kr": "질버 선장"
  },
  "5": {
   "jp": "898074d7",
   "kr": "조리장"
  },
  "6": {
   "jp": "27ab0f1b",
   "kr": "로저"
  },
  "7": {
   "jp": "94c78bc6",
   "kr": "테스"
  },
  "8": {
   "jp": "bdf98545",
   "kr": "로저&테스"
  },
  "9": {
   "jp": "97d49601",
   "kr": "질버 선장님!"
  },
  "10": {
   "jp": "59a75d1a",
   "kr": "어라…?"
  },
  "11": {
   "jp": "5990ac5e",
   "kr": "어디 갔을까."
  },
  "12": {
   "jp": "c9144d30",
   "kr": "《항해일지 1일째》"
  },
  "13": {
   "jp": "194ad047",
   "kr": "드디어 올해 항해도 이것으로 끝이다."
  },
  "14": {
   "jp": "f7aadf94",
   "kr": "유빙의 계절이 다가오고 있다."
  },
  "15": {
   "jp": "ffbaf2a4",
   "kr": "닐리에서 돌아 라그나로 가면 겨울 휴가다."
  },
  "16": {
   "jp": "4d59ffce",
   "kr": "올해 마지막 항해에 어울리는 손님이 탔다."
  },
  "17": {
   "jp": "0fb6f98d",
   "kr": "순례 여행자 쥬리오 군과 크리스 양이다."
  },
  "18": {
   "jp": "aa865a89",
   "kr": "이번 항해도 멋지게 해내겠다."
  },
  "19": {
   "jp": "8ade2c1b",
   "kr": "《항해일지 2일째》"
  },
  "20": {
   "jp": "8ac56f6f",
   "kr": "오늘도 날씨는 나무랄 데 없다."
  },
  "21": {
   "jp": "345ccaff",
   "kr": "순례 여행자 쥬리오 군도 크리스 양도,"
  },
  "22": {
   "jp": "cdc67e16",
   "kr": "일 잘하는 착한 아이들이다."
  },
  "23": {
   "jp": "796d4169",
   "kr": "이 속도라면 예정대로 사흘째"
  },
  "24": {
   "jp": "16fb50d9",
   "kr": "새벽엔 닐리에 닿겠지."
  },
  "25": {
   "jp": "e90836db",
   "kr": "순례 여행자에게 축복 있으라!"
  },
  "26": {
   "jp": "966f030c",
   "kr": "그건 그렇고, 이등 선실의 두 사람은"
  },
  "27": {
   "jp": "c9d2172f",
   "kr": "한 번도 선실에서 모습을 보이지 않는다."
  },
  "28": {
   "jp": "8dab2755",
   "kr": "부끄럼쟁이인 걸까…"
  },
  "29": {
   "jp": "a593457f",
   "kr": "오늘 것은 아직 안 적었네."
  },
  "30": {
   "jp": "b7d928b5",
   "kr": "쥬리오는 티라스일 항해도를 봤습니다."
  },
  "31": {
   "jp": "168847ec",
   "kr": "티라스일 지방은"
  },
  "32": {
   "jp": "359c914c",
   "kr": "넓구나…"
  },
  "33": {
   "jp": "bf9995f8",
   "kr": "촌장님 말씀대로 정말 석 달쯤"
  },
  "34": {
   "jp": "281cad98",
   "kr": "걸릴지도 모르겠네."
  },
  "35": {
   "jp": "b4b1d75b",
   "kr": "이렇게 큰 지도를 봐도"
  },
  "36": {
   "jp": "25f33d52",
   "kr": "선장님이 어디 있는지 알 리 없지."
  },
  "37": {
   "jp": "97d49601",
   "kr": "질버 선장님!"
  },
  "38": {
   "jp": "972da254",
   "kr": "쥬리오 군."
  },
  "39": {
   "jp": "fa3e48d8",
   "kr": "무슨 일이 있었나?"
  },
  "40": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "41": {
   "jp": "0289d667",
   "kr": "갑판 닦기가 끝나서"
  },
  "42": {
   "jp": "8d080c52",
   "kr": "다음 일을 받으려고요."
  },
  "43": {
   "jp": "78826b48",
   "kr": "흠. 믿음직하군."
  },
  "44": {
   "jp": "fa84a64d",
   "kr": "가톤!"
  },
  "45": {
   "jp": "f09818df",
   "kr": "잠깐 와 주게."
  },
  "46": {
   "jp": "9be6fed3",
   "kr": "네, 선장님."
  },
  "47": {
   "jp": "9ad23937",
   "kr": "현 침로를 보고해 다오."
  },
  "48": {
   "jp": "c74df93e",
   "kr": "파난 해류 탓에"
  },
  "49": {
   "jp": "f1691ea5",
   "kr": "다소 남동으로 밀립니다만"
  },
  "50": {
   "jp": "a20710c3",
   "kr": "이후의 바람을 타면 진로는 돌아올 겁니다."
  },
  "51": {
   "jp": "5f1c1017",
   "kr": "수고했네."
  },
  "52": {
   "jp": "956d31d3",
   "kr": "그럼 쥬리오 군이 교대해도"
  },
  "53": {
   "jp": "3b15686b",
   "kr": "지장은 없겠지?"
  },
  "54": {
   "jp": "88149875",
   "kr": "네."
  },
  "55": {
   "jp": "cb973a29",
   "kr": "그레이데스 암초 해역은"
  },
  "56": {
   "jp": "a7c56ab1",
   "kr": "진작에 빠져나왔으니까요."
  },
  "57": {
   "jp": "7e28d744",
   "kr": "그럼 쥬리오 군."
  },
  "58": {
   "jp": "9022c0de",
   "kr": "당장 뱃머리 망보기를 맡아 다오."
  },
  "59": {
   "jp": "087e3615",
   "kr": "여기서부터는 침로보다"
  },
  "60": {
   "jp": "4a0e10f6",
   "kr": "다른 항행선에 신경 쓰길 바란다."
  },
  "61": {
   "jp": "0c0462c7",
   "kr": "가톤 너는 2번 마스트 아래를 맡아라."
  },
  "62": {
   "jp": "7966a4db",
   "kr": "예스 서!"
  },
  "63": {
   "jp": "9378affd",
   "kr": "쥬리오 군, 부탁한다."
  },
  "64": {
   "jp": "a4f5c9d5",
   "kr": "예스 서!!"
  },
  "65": {
   "jp": "acded879",
   "kr": "후후..좋아."
  },
  "66": {
   "jp": "359953ee",
   "kr": "자아."
  },
  "67": {
   "jp": "2238d43d",
   "kr": "크리스!"
  },
  "68": {
   "jp": "e8750b93",
   "kr": "설마…"
  },
  "69": {
   "jp": "48136b07",
   "kr": "보스레이 씨처럼"
  },
  "70": {
   "jp": "51fe1832",
   "kr": "멋지게 빨래를 걷어 볼게."
  },
  "71": {
   "jp": "9f5f9615",
   "kr": "쥬리오, 잘 봐."
  },
  "72": {
   "jp": "6ac980ea",
   "kr": "크리스! 위험해!!"
  },
  "73": {
   "jp": "1f0d3dbc",
   "kr": "괜찮아."
  },
  "74": {
   "jp": "77af133a",
   "kr": "내가 나무 잘 타는 거 알잖아?"
  },
  "75": {
   "jp": "1e725f73",
   "kr": "좀 위험하긴 했지만"
  },
  "76": {
   "jp": "8e805010",
   "kr": "완벽하지!"
  },
  "77": {
   "jp": "7d3f219a",
   "kr": "완벽하긴!"
  },
  "78": {
   "jp": "32491ce7",
   "kr": "혹시 다치기라도 하면 어쩌려고?"
  },
  "79": {
   "jp": "b0ea7a09",
   "kr": "… 쥬리오, 다정하네."
  },
  "80": {
   "jp": "197e093c",
   "kr": "크리스가 다치면"
  },
  "81": {
   "jp": "6ed3d1aa",
   "kr": "내가 올도스까지 업고 가야"
  },
  "82": {
   "jp": "8a1a4b98",
   "kr": "하잖아."
  },
  "83": {
   "jp": "ddb73033",
   "kr": "… 그런 거였구나."
  },
  "84": {
   "jp": "c78bf108",
   "kr": "화났어?"
  },
  "85": {
   "jp": "7a1beb24",
   "kr": "조금은."
  },
  "86": {
   "jp": "c8aa3368",
   "kr": "난 요리하러 돌아갈 테니까"
  },
  "87": {
   "jp": "daf2a5c7",
   "kr": "게으름 피우면 안 돼!"
  },
  "88": {
   "jp": "b2e8b6bf",
   "kr": "… 망보러 돌아가야지."
  },
  "89": {
   "jp": "7ea8549a",
   "kr": "쥬리오!"
  },
  "90": {
   "jp": "6b13f9bd",
   "kr": "무슨 일이야?"
  },
  "91": {
   "jp": "02eec859",
   "kr": "잠깐, 선장님께 할 말이 있는데…"
  },
  "92": {
   "jp": "73de068a",
   "kr": "쥬리오 군이 전해 줬으면 좋겠구나."
  },
  "93": {
   "jp": "b047fa1f",
   "kr": "네, 알았어요."
  },
  "94": {
   "jp": "296332cf",
   "kr": "바로 가 봐요."
  },
  "95": {
   "jp": "972da254",
   "kr": "쥬리오 군."
  },
  "96": {
   "jp": "0d549a6d",
   "kr": "항로 망보기도 뱃사람의 중요한 일이다."
  },
  "97": {
   "jp": "bbf4f110",
   "kr": "뱃머리에서 떨어지지 말아 다오."
  },
  "98": {
   "jp": "d9dd59c1",
   "kr": "언제나〜 놓쳐 왔던〜 나의 꾸〜움〜"
  },
  "99": {
   "jp": "d3e52fe1",
   "kr": "밤바다를 바라봤지〜"
  },
  "100": {
   "jp": "b8ca4205",
   "kr": "일렁일렁 흔들리며〜 옛 상처를 씻어 내자〜"
  },
  "101": {
   "jp": "ae5b00dd",
   "kr": "노래 좋네요."
  },
  "102": {
   "jp": "cebd2867",
   "kr": "고향에 두고 온 그 사람이 좋아했거든."
  },
  "103": {
   "jp": "d81dfa83",
   "kr": "질버 선장 말이냐?"
  },
  "104": {
   "jp": "1643661e",
   "kr": "선장은 책임감이 강하니까."
  },
  "105": {
   "jp": "da4879d1",
   "kr": "손님이 편히 지내도록"
  },
  "106": {
   "jp": "58128685",
   "kr": "선내를 순찰하고 있을 거야."
  },
  "107": {
   "jp": "37bb1702",
   "kr": "오, 쥬리오."
  },
  "108": {
   "jp": "33f245c1",
   "kr": "네가 찾는다고"
  },
  "109": {
   "jp": "72f39b7e",
   "kr": "선장님이 기다리고 계신다."
  },
  "110": {
   "jp": "108b3c86",
   "kr": "자자."
  },
  "111": {
   "jp": "ebc129a9",
   "kr": "땡땡이치면 크리스에게 혼난다."
  },
  "112": {
   "jp": "dafad5b8",
   "kr": "맡은 뱃머리로 돌아가, 돌아가."
  },
  "113": {
   "jp": "e9d14101",
   "kr": "바다를 보고 있으면 신기한 기분이 들어."
  },
  "114": {
   "jp": "f338d044",
   "kr": "바다 밑에서는 이 배가"
  },
  "115": {
   "jp": "d04e097e",
   "kr": "어떻게 보일까?"
  },
  "116": {
   "jp": "e08cbdd9",
   "kr": "질버 선장이라면 선창 쪽으로 내려갔어."
  },
  "117": {
   "jp": "55a270d9",
   "kr": "조급해 말고, 느긋하게 찾아라."
  },
  "118": {
   "jp": "37bb1702",
   "kr": "오, 쥬리오."
  },
  "119": {
   "jp": "1c56d84a",
   "kr": "선장이라면 뱃머리 쪽으로 갔어."
  },
  "120": {
   "jp": "37bb1702",
   "kr": "오, 쥬리오."
  },
  "121": {
   "jp": "01653f73",
   "kr": "이번엔 뱃머리에서 망보기라며."
  },
  "122": {
   "jp": "fd84f79a",
   "kr": "망보기는 수수한 일로 보일지 모르지만"
  },
  "123": {
   "jp": "263473e9",
   "kr": "안전한 항행에 빠뜨릴 수 없는 일이란다."
  },
  "124": {
   "jp": "f0358601",
   "kr": "힘내라."
  },
  "125": {
   "jp": "7bc43e28",
   "kr": "질버 선장은 수부에서 시작해"
  },
  "126": {
   "jp": "a0dbe4c0",
   "kr": "선장까지 된 사내다."
  },
  "127": {
   "jp": "a612a6b0",
   "kr": "그래서 진심으로 이 배와"
  },
  "128": {
   "jp": "e15797ec",
   "kr": "승무원을 아껴 준다."
  },
  "129": {
   "jp": "78a2aeff",
   "kr": "분명 선내를 순찰하고 있을 거야."
  },
  "130": {
   "jp": "4b0bd609",
   "kr": "오늘은 잘될 것 같구먼."
  },
  "131": {
   "jp": "a2385266",
   "kr": "여기 있는 접시는"
  },
  "132": {
   "jp": "17bea796",
   "kr": "닐리에서 내가 맞춘 거란다."
  },
  "133": {
   "jp": "e74fdd10",
   "kr": "예쁜 무늬지?"
  },
  "134": {
   "jp": "bd3dec39",
   "kr": "자, 쥬리오 군."
  },
  "135": {
   "jp": "9f86aaa6",
   "kr": "좀 지나가겠네."
  },
  "136": {
   "jp": "99f918d5",
   "kr": "음!"
  },
  "137": {
   "jp": "91d62f62",
   "kr": "나머지는 애정이다."
  },
  "138": {
   "jp": "7e8f52d7",
   "kr": "오늘도 힘차게 가 볼까!"
  },
  "139": {
   "jp": "d9d766fd",
   "kr": "배 안에서 먹는 요리도"
  },
  "140": {
   "jp": "85dd0df0",
   "kr": "추억의 한 조각이 되니까 말이다."
  },
  "141": {
   "jp": "09a05105",
   "kr": "뱃사람의 첫 조건은 멀리 내다보는 눈이다."
  },
  "142": {
   "jp": "e419797f",
   "kr": "다행히 쥬리오 군은 눈은 좋은 편이지?"
  },
  "143": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "144": {
   "jp": "13ddfd9f",
   "kr": "라그픽 마을에서 로그 다음으로 좋았어요."
  },
  "145": {
   "jp": "7361cfc5",
   "kr": "진정해, 진정해."
  },
  "146": {
   "jp": "039985d8",
   "kr": "천천히 하면 제대로 할 수 있으니까."
  },
  "147": {
   "jp": "4ee53ec9",
   "kr": "응! 좋은 냄새가 나기 시작했어."
  },
  "148": {
   "jp": "54136f14",
   "kr": "얼른 비켜!"
  },
  "149": {
   "jp": "d5f60b2d",
   "kr": "방금 생각났단 말이야!"
  },
  "150": {
   "jp": "bcc5121a",
   "kr": "쥬리오, 맛 좀 봐 주지 않을래?"
  },
  "151": {
   "jp": "b8eb9a27",
   "kr": "으음. 좀 매운 것 같아."
  },
  "152": {
   "jp": "5cc5c0b0",
   "kr": "쥬리오도 참, 또 농땡이야!"
  },
  "153": {
   "jp": "c0ffc356",
   "kr": "이번엔 선장님도 놀랄 만큼"
  },
  "154": {
   "jp": "8e062856",
   "kr": "맛있는 걸 만들 거야!"
  }
 }
}