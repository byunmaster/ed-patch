{
 "archive": "/SCE3/SC304.DAT",
 "member": "..\\DATA\\AT2001.BIN",
 "lines": {
  "0": {
   "jp": "6e08114e",
   "kr": "안데라"
  },
  "1": {
   "jp": "f3b21c53",
   "kr": "성 아랫마을"
  },
  "2": {
   "jp": "422ac187",
   "kr": "말테"
  },
  "3": {
   "jp": "c30d2b6d",
   "kr": "고다"
  },
  "4": {
   "jp": "e5f26da7",
   "kr": "챠펠의 포라"
  },
  "5": {
   "jp": "b7f92a25",
   "kr": "피에르"
  },
  "6": {
   "jp": "24b5b26f",
   "kr": "이벨"
  },
  "7": {
   "jp": "0eb99b08",
   "kr": "벨느"
  },
  "8": {
   "jp": "2f88b752",
   "kr": "안느"
  },
  "9": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "10": {
   "jp": "64011b13",
   "kr": "쥬디"
  },
  "11": {
   "jp": "e1181b40",
   "kr": "녹스"
  },
  "12": {
   "jp": "df53b5b6",
   "kr": "트리나 할머니"
  },
  "13": {
   "jp": "bc8598c0",
   "kr": "르네"
  },
  "14": {
   "jp": "5e767095",
   "kr": "리오"
  },
  "15": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "16": {
   "jp": "2ca2db4c",
   "kr": "두 분은 임금님과 아는 분들이시죠."
  },
  "17": {
   "jp": "2e72e9b0",
   "kr": "볼트에서는 신세를 졌습니다."
  },
  "18": {
   "jp": "971209ca",
   "kr": "이제"
  },
  "19": {
   "jp": "652dbb26",
   "kr": "마을을 떠나시다니"
  },
  "20": {
   "jp": "b1830d60",
   "kr": "섭섭합니다."
  },
  "21": {
   "jp": "a496b05f",
   "kr": "못 보내 드립니다."
  },
  "22": {
   "jp": "db4510d0",
   "kr": "좀 더 이 마을에서 느긋하게"
  },
  "23": {
   "jp": "719226ea",
   "kr": "계세요."
  },
  "24": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "25": {
   "jp": "cadb0695",
   "kr": "네〜에."
  },
  "26": {
   "jp": "e05d131b",
   "kr": "저기, 이상한 부탁인데."
  },
  "27": {
   "jp": "9f1dbc64",
   "kr": "요리 재료가 될 만한 게 있으면"
  },
  "28": {
   "jp": "124012ad",
   "kr": "좀 나눠 줄 수 없을까?"
  },
  "29": {
   "jp": "3c06d554",
   "kr": "요리 재료?"
  },
  "30": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "31": {
   "jp": "bd59c528",
   "kr": "볼트에서 막 도착한 생선이라면 있어."
  },
  "32": {
   "jp": "a268547d",
   "kr": "어차피 다 먹지도 못하니까"
  },
  "33": {
   "jp": "e475a175",
   "kr": "이웃에 나눠 주려고 생각하던 참이야."
  },
  "34": {
   "jp": "45e970f9",
   "kr": "조개도 있다."
  },
  "35": {
   "jp": "9fd69cdb",
   "kr": "자, 생선과 조개를 가져가라."
  },
  "36": {
   "jp": "ac09d7fd",
   "kr": "따지고 보면 너희가 볼트를 지켜 줘서"
  },
  "37": {
   "jp": "f2898341",
   "kr": "지금도 생선이 오는 거다."
  },
  "38": {
   "jp": "60a9e7cc",
   "kr": "사양 말고 써라."
  },
  "39": {
   "jp": "27329de3",
   "kr": "쥬리오는 어패류를 손에 넣었다."
  },
  "40": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "41": {
   "jp": "141e5b0c",
   "kr": "신선하니까"
  },
  "42": {
   "jp": "cf3ef1cb",
   "kr": "분명 맛있는 요리가 될 거다."
  },
  "43": {
   "jp": "6805814b",
   "kr": "생선과 조개가 있으면 사프란을 쓰면"
  },
  "44": {
   "jp": "3405bbf2",
   "kr": "부야베스를 만들 수 있어."
  },
  "45": {
   "jp": "98478f1b",
   "kr": "손이 많이 가는 요리다만 카레 스파이스가"
  },
  "46": {
   "jp": "57091bdb",
   "kr": "있으면 요구르트와 코코넛 밀크를 더해서"
  },
  "47": {
   "jp": "386100f2",
   "kr": "해산물카레를 만들 수 있지."
  },
  "48": {
   "jp": "774bf487",
   "kr": "호오, 요리 재료를 찾고 있는 거니?"
  },
  "49": {
   "jp": "e63fa7b6",
   "kr": "그렇다면 마침 잘됐다."
  },
  "50": {
   "jp": "984ce6e3",
   "kr": "오늘 아침 밭에서 막 캐낸"
  },
  "51": {
   "jp": "7a447526",
   "kr": "비트를 주마."
  },
  "52": {
   "jp": "712adfe6",
   "kr": "이게 있으면 요리는 완벽하지."
  },
  "53": {
   "jp": "dd5f826c",
   "kr": "쥬리오는 비트를 손에 넣었다."
  },
  "54": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "55": {
   "jp": "6fedf593",
   "kr": "비트를 써서"
  },
  "56": {
   "jp": "9ade9985",
   "kr": "건강한 요리를 만들어 다오."
  },
  "57": {
   "jp": "ab9d172c",
   "kr": "어쩌지."
  },
  "58": {
   "jp": "a88dc75b",
   "kr": "사워크림을 너무 많이 만들어서 남아 버렸어."
  },
  "59": {
   "jp": "de23a823",
   "kr": "저기, 괜찮으시면"
  },
  "60": {
   "jp": "14e2fe2b",
   "kr": "저한테 좀"
  },
  "61": {
   "jp": "9a6d6d99",
   "kr": "나눠 주실 수 없나요…"
  },
  "62": {
   "jp": "e6b9b1ec",
   "kr": "어머, 크림을 달라니 어린애구나."
  },
  "63": {
   "jp": "70354164",
   "kr": "……"
  },
  "64": {
   "jp": "32817171",
   "kr": "아이스크림처럼 달지는 않아."
  },
  "65": {
   "jp": "8633255b",
   "kr": "그래도 괜찮다면 줄게."
  },
  "66": {
   "jp": "f9ac85d4",
   "kr": "네, 받을게요."
  },
  "67": {
   "jp": "788d4a22",
   "kr": "쥬리오는 사워크림을 손에 넣었다."
  },
  "68": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "69": {
   "jp": "2a9477de",
   "kr": "사워크림을 요리에 쓸 거면"
  },
  "70": {
   "jp": "ff61e7ab",
   "kr": "고기류, 비트, 양배추와 넣고 끓여서"
  },
  "71": {
   "jp": "6a6c56ce",
   "kr": "보르시치를 만들 수 있어."
  },
  "72": {
   "jp": "68017ce3",
   "kr": "지금쯤 요리 콘테스트에 나가는 사람들은"
  },
  "73": {
   "jp": "5c28e266",
   "kr": "열심히 요리를 만들고 있겠지."
  },
  "74": {
   "jp": "70346766",
   "kr": "후우. 더는 못 먹겠구나."
  },
  "75": {
   "jp": "c0fac88d",
   "kr": "아무리 내가 소고기를 좋아한대도"
  },
  "76": {
   "jp": "cca54070",
   "kr": "아침부터 배불리 소고기는 힘들구나."
  },
  "77": {
   "jp": "f4a30119",
   "kr": "실은 어머니가 같이 먹어 주겠거니"
  },
  "78": {
   "jp": "06434154",
   "kr": "싶어 넉넉히 만들었다만"
  },
  "79": {
   "jp": "b4232415",
   "kr": "오늘 아침은 고다네서 식사를 마쳤다더구나."
  },
  "80": {
   "jp": "a68448e7",
   "kr": "어떠냐, 너도 좀 먹고 가지 않겠니?"
  },
  "81": {
   "jp": "1e9ce8ea",
   "kr": "싸 가도 될까요?"
  },
  "82": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "83": {
   "jp": "8eb273e0",
   "kr": "……고생이 많구나."
  },
  "84": {
   "jp": "49e1304d",
   "kr": "그래, 그래."
  },
  "85": {
   "jp": "c5ef1761",
   "kr": "원하는 만큼 가져가려무나."
  },
  "86": {
   "jp": "e9985530",
   "kr": "쥬리오는 소고기를 얻었다."
  },
  "87": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "88": {
   "jp": "4bf81401",
   "kr": "됐으니까"
  },
  "89": {
   "jp": "cc37bc39",
   "kr": "얼른 그걸 가져다주려무나."
  },
  "90": {
   "jp": "8d2d97a8",
   "kr": "소고기는 맛있었니?"
  },
  "91": {
   "jp": "cd1ac3ba",
   "kr": "요리 재료?"
  },
  "92": {
   "jp": "d6a0b0e3",
   "kr": "글쎄다, 벨느는 소고기를 좋아하고"
  },
  "93": {
   "jp": "6d3366e7",
   "kr": "고다는 생선을 좋아한단다. 두 아들 집에서"
  },
  "94": {
   "jp": "0ac98d29",
   "kr": "소고기와 생선은 아마 구할 수 있을 게다."
  },
  "95": {
   "jp": "eabebfdd",
   "kr": "참고로"
  },
  "96": {
   "jp": "cb400d64",
   "kr": "벨느와 고다는 내 아들이란다."
  },
  "97": {
   "jp": "f452b1b8",
   "kr": "르네는 벨느의 딸인데 생선을 좋아하지."
  },
  "98": {
   "jp": "382784f9",
   "kr": "그래서 르네는 고다네 집에서 식사를 한단다."
  },
  "99": {
   "jp": "50efdf04",
   "kr": "게다가 나는 고기도 생선도 좋아하니"
  },
  "100": {
   "jp": "05a52267",
   "kr": "그날 기분에 따라"
  },
  "101": {
   "jp": "b17b9058",
   "kr": "어느 집에서 식사를 할지 정한단다."
  },
  "102": {
   "jp": "6a9d4eb8",
   "kr": "복잡하고 별나지?"
  },
  "103": {
   "jp": "2a0ad809",
   "kr": "앗, 뭐야?"
  },
  "104": {
   "jp": "f9d6b19f",
   "kr": "안녕."
  },
  "105": {
   "jp": "ed2b037a",
   "kr": "지금 할머니는"
  },
  "106": {
   "jp": "ac511034",
   "kr": "요리 콘테스트에 출품할"
  },
  "107": {
   "jp": "6ee03fe2",
   "kr": "요리를 만드느라 바빠."
  },
  "108": {
   "jp": "c2305602",
   "kr": "볼일 있으면 나중에 와."
  },
  "109": {
   "jp": "ae472ce9",
   "kr": "묘한 냄새가 났다."
  },
  "110": {
   "jp": "67c534fe",
   "kr": "뭔가 냄새나."
  },
  "111": {
   "jp": "d13bd174",
   "kr": "마늘이야. 힘이 난다고."
  },
  "112": {
   "jp": "16ce5525",
   "kr": "리오!"
  },
  "113": {
   "jp": "369b3e4f",
   "kr": "기분이 가라앉잖아."
  },
  "114": {
   "jp": "42912c4b",
   "kr": "언제까지 떠들고 있는 게냐!"
  },
  "115": {
   "jp": "a2703f3d",
   "kr": "무섭네… 네 할머니."
  },
  "116": {
   "jp": "c727771e",
   "kr": "자, 마늘이 신기하면 줄게."
  },
  "117": {
   "jp": "2e30180e",
   "kr": "쥬리오는 마늘을 손에 넣었다."
  },
  "118": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "119": {
   "jp": "6b73ba28",
   "kr": "안 된다니까!"
  },
  "120": {
   "jp": "11ee0bd5",
   "kr": "할머니가 기분이 안 좋아지니까"
  },
  "121": {
   "jp": "8a505fce",
   "kr": "이제 저리 좀 가."
  },
  "122": {
   "jp": "50887e09",
   "kr": "고마워, 너희 덕분이야."
  },
  "123": {
   "jp": "8b3d880b",
   "kr": "역시 안느 씨는 멋져."
  },
  "124": {
   "jp": "26a38fef",
   "kr": "안느 씨와 함께"
  },
  "125": {
   "jp": "13cfdc4b",
   "kr": "차를 마시다니 행복해."
  },
  "126": {
   "jp": "9d1547ba",
   "kr": "어머, 너희구나. 어서 와."
  },
  "127": {
   "jp": "14c2ed4a",
   "kr": "녹스 씨 이야기는 정말 즐거워."
  },
  "128": {
   "jp": "327f578d",
   "kr": "아무리 얘기해도 질리지 않아."
  },
  "129": {
   "jp": "2e15d9a4",
   "kr": "다음에 녹스 씨한테"
  },
  "130": {
   "jp": "cc3bbe08",
   "kr": "쿠키라도 구워 줄까."
  },
  "131": {
   "jp": "f6053e63",
   "kr": "아, 미안해."
  },
  "132": {
   "jp": "637f6221",
   "kr": "수다에 정신이 팔려서."
  },
  "133": {
   "jp": "47265c6a",
   "kr": "뭐 살 거니?"
  },
  "134": {
   "jp": "a6129c1e",
   "kr": "그럼, 이쪽으로 와."
  },
  "135": {
   "jp": "2d9c026a",
   "kr": "필요한 게 있으면 불러 줘."
  },
  "136": {
   "jp": "86d247f9",
   "kr": "어머나, 손님."
  },
  "137": {
   "jp": "917e529c",
   "kr": "테이블 건너편에서 말을 걸어"
  },
  "138": {
   "jp": "f7a39c69",
   "kr": "주셨으면 좋았을 텐데."
  },
  "139": {
   "jp": "113847d2",
   "kr": "어서 오세요. 무엇을 드릴까요."
  },
  "140": {
   "jp": "f0b4ed76",
   "kr": "요리에 쓰는 향신료 같은 거 파나요?"
  },
  "141": {
   "jp": "fc56453f",
   "kr": "어머, 요리를 만드시는군요."
  },
  "142": {
   "jp": "45c4d64a",
   "kr": "그렇다면"
  },
  "143": {
   "jp": "7e4a19d4",
   "kr": "남는 게 잔뜩 있으니"
  },
  "144": {
   "jp": "6c0b7274",
   "kr": "나눠 드릴게요."
  },
  "145": {
   "jp": "08b724c3",
   "kr": "엇, 정말요?"
  },
  "146": {
   "jp": "63405cae",
   "kr": "네. 향신료, 사프란"
  },
  "147": {
   "jp": "b30489a1",
   "kr": "데미글라스 소스, 요구르트."
  },
  "148": {
   "jp": "6298e5ac",
   "kr": "전부 가져가도 돼요."
  },
  "149": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "150": {
   "jp": "38389633",
   "kr": "쥬리오는 향신료, 사프란"
  },
  "151": {
   "jp": "0c6c7004",
   "kr": "데미글라스 소스, 요구르트를 손에 넣었다"
  },
  "152": {
   "jp": "949307df",
   "kr": "뭐가 필요하세요?"
  },
  "153": {
   "jp": "4f045262",
   "kr": "어서 오세요."
  },
  "154": {
   "jp": "5e863d33",
   "kr": "저희 가게에는 여러 물건이 갖춰져 있답니다."
  },
  "155": {
   "jp": "431ee0e8",
   "kr": "얼핏 도움이 안 될 듯한 물건도 있습니다만"
  },
  "156": {
   "jp": "e13736ef",
   "kr": "지녀서 손해 볼 물건은 하나도 없습니다."
  },
  "157": {
   "jp": "558525ef",
   "kr": "부디 물건을 살펴봐 주세요."
  },
  "158": {
   "jp": "a61225b0",
   "kr": "무엇을 찾으십니까?"
  },
  "159": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "160": {
   "jp": "1b053bfc",
   "kr": "그러시다면"
  },
  "161": {
   "jp": "ee93304e",
   "kr": "입니다."
  },
  "162": {
   "jp": "01232777",
   "kr": "무엇을 사들일까요?"
  },
  "163": {
   "jp": "4b42c90a",
   "kr": "라면"
  },
  "164": {
   "jp": "71b4529e",
   "kr": "에 사들이겠습니다."
