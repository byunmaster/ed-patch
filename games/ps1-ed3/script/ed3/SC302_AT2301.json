{
 "archive": "/SCE3/SC302.DAT",
 "member": "..\\DATA\\AT2301.BIN",
 "lines": {
  "0": {
   "jp": "84e70172",
   "kr": "안데라성"
  },
  "1": {
   "jp": "24b7384e",
   "kr": "2층"
  },
  "2": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "3": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "4": {
   "jp": "1addc969",
   "kr": "죠리나 왕비"
  },
  "5": {
   "jp": "b97d5055",
   "kr": "마기사"
  },
  "6": {
   "jp": "943c8543",
   "kr": "스라브 노인"
  },
  "7": {
   "jp": "c258804a",
   "kr": "가루가 소동도 가라앉고,"
  },
  "8": {
   "jp": "1d5e0fef",
   "kr": "모두들 한시름"
  },
  "9": {
   "jp": "8a022ad1",
   "kr": "놓고 있답니다."
  },
  "10": {
   "jp": "0702de21",
   "kr": "이곳은 폐하의 침실입니다."
  },
  "11": {
   "jp": "3140554f",
   "kr": "구경하고 싶으시면, 얼마든지요."
  },
  "12": {
   "jp": "ea614d48",
   "kr": "따로 관람료를 받지 않으니 안심하십시오."
  },
  "13": {
   "jp": "872e5a6e",
   "kr": "아니, 실례했습니다."
  },
  "14": {
   "jp": "4bdbbc78",
   "kr": "제 농담, 어떠셨습니까?"
  },
  "15": {
   "jp": "0ff2c3d4",
   "kr": "엇, 어디가 농담이었어요?"
  },
  "16": {
   "jp": "51af482b",
   "kr": "이거 한 방 먹었군요."
  },
  "17": {
   "jp": "cde7369d",
   "kr": "좀 더 수행을 쌓아 둘게요."
  },
  "18": {
   "jp": "974aeedd",
   "kr": "부디 편히 머물러 주십시오."
  },
  "19": {
   "jp": "8f67152b",
   "kr": "앰비쉬는 좋은 곳입니다."
  },
  "20": {
   "jp": "ff2ed3a1",
   "kr": "부디 푹 쉬시면서"
  },
  "21": {
   "jp": "c6be2a43",
   "kr": "여행의 피로를 푸십시오."
  },
  "22": {
   "jp": "7370652f",
   "kr": "로디 님은"
  },
  "23": {
   "jp": "8c926224",
   "kr": "조금 더 요양이 필요한"
  },
  "24": {
   "jp": "b95396a2",
   "kr": "듯합니다."
  },
  "25": {
   "jp": "35356466",
   "kr": "안심하십시오."
  },
  "26": {
   "jp": "68591c9b",
   "kr": "시녀들 사이에서 인기가 대단해서"
  },
  "27": {
   "jp": "a63e6125",
   "kr": "본인도 기뻐하는 것 같으니까요."
  },
  "28": {
   "jp": "faedadca",
   "kr": "인기가 대단하대."
  },
  "29": {
   "jp": "c24e2f1e",
   "kr": "역시, 반바지가 인기 비결인가 봐."
  },
  "30": {
   "jp": "6f2a1c22",
   "kr": "볼트에서 앰비쉬를 지키려고"
  },
  "31": {
   "jp": "ed36dace",
   "kr": "힘을 보태 주신 로디 님이라는 분이"
  },
  "32": {
   "jp": "7deba8cf",
   "kr": "이 성에서 요양하고 계세요."
  },
  "33": {
   "jp": "1a72d38e",
   "kr": "정말 멋진 분이시랍니다."
  },
  "34": {
   "jp": "3adae119",
   "kr": "………"
  },
  "35": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "36": {
   "jp": "3adae119",
   "kr": "………"
  },
  "37": {
   "jp": "fa20fe97",
   "kr": "이 누나"
  },
  "38": {
   "jp": "25e807c8",
   "kr": "부끄럼쟁이인가 봐."
  },
  "39": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "40": {
   "jp": "34a29b20",
   "kr": "안됐으니까 말 거는 건"
  },
  "41": {
   "jp": "8651f4d1",
   "kr": "그만두자."
  },
  "42": {
   "jp": "88367ba6",
   "kr": "가 버렸어."
  },
  "43": {
   "jp": "7e7b6db7",
   "kr": "마기사는 새근새근 잠들어 있다."
  },
  "44": {
   "jp": "e6c8598f",
   "kr": "어머, 두 분은"
  },
  "45": {
   "jp": "be766569",
   "kr": "쥬리오 군과 크리스 양이군요."
  },
  "46": {
   "jp": "3c39203c",
   "kr": "처음 뵙겠습니다."
  },
  "47": {
   "jp": "a5df8999",
   "kr": "알프가 신세를 졌습니다."
  },
  "48": {
   "jp": "1f305f08",
   "kr": "저는 왕비 죠리나입니다."
  },
  "49": {
   "jp": "6ecb27c5",
   "kr": "헉!"
  },
  "50": {
   "jp": "23751e1f",
   "kr": "왕, 왕, 왕비님…"
  },
  "51": {
   "jp": "9b6ace4d",
   "kr": "처음 뵙겠습니다, 왕비님."
  },
  "52": {
   "jp": "144d8c25",
   "kr": "크리스라고 합니다."
  },
  "53": {
   "jp": "e1ef2f1b",
   "kr": "잘 부탁드립니다."
  },
  "54": {
   "jp": "3dd38eed",
   "kr": "어머, 그렇게 정중한"
  },
  "55": {
   "jp": "c0478b1c",
   "kr": "인사를 해 주시다니."
  },
  "56": {
   "jp": "e39ae757",
   "kr": "혹시 괜찮다면"
  },
  "57": {
   "jp": "c9400ae0",
   "kr": "저와도 알프처럼"
  },
  "58": {
   "jp": "b05864ed",
   "kr": "친구가 되어 주세요."
  },
  "59": {
   "jp": "29162a7b",
   "kr": "감사합니다."
  },
  "60": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "61": {
   "jp": "4fba8319",
   "kr": "얘, 쥬리오도 참!"
  },
  "62": {
   "jp": "e1ae031e",
   "kr": "쥬리오!"
  },
  "63": {
   "jp": "5c784394",
   "kr": "제대로 왕비님께"
  },
  "64": {
   "jp": "bc42cf6a",
   "kr": "인사드려야지."
  },
  "65": {
   "jp": "01cf9869",
   "kr": "왕, 왕, 왕비님이다. 왕비님이야."
  },
  "66": {
   "jp": "f9cb0543",
   "kr": "죄송해요, 왕비님."
  },
  "67": {
   "jp": "58f6ca26",
   "kr": "쥬리오가 그만"
  },
  "68": {
   "jp": "83cbd27e",
   "kr": "긴장해 버렸거든요."
  },
  "69": {
   "jp": "c6096d8b",
   "kr": "어머."
  },
  "70": {
   "jp": "f7fd5d41",
   "kr": "안, 안녕하세요."
  },
  "71": {
   "jp": "0d6e3ff0",
   "kr": "쥬리오예요."
  },
  "72": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "73": {
   "jp": "2a187bed",
   "kr": "어때요, 쥬리오 군."
  },
  "74": {
   "jp": "0990dd9a",
   "kr": "여기서 보는 경치는?"
  },
  "75": {
   "jp": "8959e5b1",
   "kr": "굉장해요, 예쁘네요."
  },
  "76": {
   "jp": "57d396b4",
   "kr": "쥬리오는 뭐든 일단"
  },
  "77": {
   "jp": "f8d567f5",
   "kr": "굉장하다고만 하니까."
  },
  "78": {
   "jp": "4fa4b0f9",
   "kr": "좀 더 근사한 말은 못 해?"
  },
  "79": {
   "jp": "fc6d4657",
   "kr": "그치만, 굉장한걸."
  },
  "80": {
   "jp": "668e59d8",
   "kr": "이 성은 말이죠."
  },
  "81": {
   "jp": "6a6973c9",
   "kr": "절반이 호수 위에"
  },
  "82": {
   "jp": "61a26739",
   "kr": "지어져 있답니다."
  },
  "83": {
   "jp": "9aedb6f3",
   "kr": "정말요?"
  },
  "84": {
   "jp": "45a68332",
   "kr": "멋져요."
  },
  "85": {
   "jp": "0c979c2b",
   "kr": "앗, 크리스도 방금"
  },
  "86": {
   "jp": "b9585505",
   "kr": "굉장하다고 했잖아."
  },
  "87": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "88": {
   "jp": "13ef13ee",
   "kr": "아차."
  },
  "89": {
   "jp": "ccc2d227",
   "kr": "핫핫핫핫핫…"
  },
  "90": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "91": {
   "jp": "ccc2d227",
   "kr": "핫핫핫핫핫…"
  },
  "92": {
   "jp": "b39e6630",
   "kr": "어머, 정말 즐거운 분들이에요."
  },
  "93": {
   "jp": "c262b084",
   "kr": "알프가 말한 그대로예요."
  },
  "94": {
   "jp": "e25d42bf",
   "kr": "내일 요리 콘테스트가 기대되는군요."
  },
  "95": {
   "jp": "abe75131",
   "kr": "나는 좀 더,"
  },
  "96": {
   "jp": "68fc99c5",
   "kr": "여기서 바람을 쐬고 있을게."
  },
  "97": {
   "jp": "77dcd382",
   "kr": "성안은 처음이시죠?"
  },
  "98": {
   "jp": "ea133446",
   "kr": "부디 성안을 마음껏"
  },
  "99": {
   "jp": "85fbc186",
   "kr": "둘러보세요."
  },
  "100": {
   "jp": "c88ad9f8",
   "kr": "여기는 안데라성 도서실입니다."
  },
  "101": {
   "jp": "091c15b6",
   "kr": "앰비쉬의 역사와 티라스일 각지에서"
  },
  "102": {
   "jp": "1a0bde85",
   "kr": "모은 책들이 소장되어 있습니다."
  },
  "103": {
   "jp": "b03d6b8c",
   "kr": "부디, 마음껏 열람하십시오."
  },
  "104": {
   "jp": "eddd666e",
   "kr": "책등에 『안데라 호수』라고 적힌 책이 있다."
  },
  "105": {
   "jp": "db11b8e0",
   "kr": "쥬리오는 그 책을 집어 들어 펼쳐 보았다."
  },
  "106": {
   "jp": "9e00a194",
   "kr": "안데라 호수는 이 땅의 창세 전승에 따르면,"
  },
  "107": {
   "jp": "88d3ba39",
   "kr": "산맥만 한 큰뱀과 싸운 거인의 발자국이라"
  },
  "108": {
   "jp": "16b69357",
   "kr": "한다. 큰뱀을 이긴 거인은 그 큰뱀을"
  },
  "109": {
   "jp": "74d0103b",
   "kr": "한 번 어깨에 메고 승리의 함성을 올렸다."
  },
  "110": {
   "jp": "12b1ef18",
   "kr": "호수는 그때의 무게 때문에 생겨났다고"
  },
  "111": {
   "jp": "5f305f6b",
   "kr": "한다. 거인은 앰비쉬 남쪽 국경을"
  },
  "112": {
   "jp": "423e02e4",
   "kr": "따라 큰뱀을 눕혔다. 그것이 앰비쉬의"
  },
  "113": {
   "jp": "67e5e39e",
   "kr": "대산맥이 되었다."
  },
  "114": {
   "jp": "b27cfc81",
   "kr": "거인의 발자국에는 물이 고여, 푸르게 맑은"
  },
  "115": {
   "jp": "47286f9d",
   "kr": "아름다운 호수가 되었다."
  },
  "116": {
   "jp": "1998305e",
   "kr": "책등에 『하얀마녀의 말』이란 책이 있다."
  },
  "117": {
   "jp": "db11b8e0",
   "kr": "쥬리오는 그 책을 집어 들어 펼쳐 보았다."
  },
  "118": {
   "jp": "ac47da45",
   "kr": "그녀의 이름은 게르드. 티라스일을 걸으며"
  },
  "119": {
   "jp": "65bd5bc7",
   "kr": "불길한 말을 남기고 사라졌다. 아직 스무"
  },
  "120": {
   "jp": "8931dcc2",
   "kr": "살도 안 된 처녀는 백은빛 머리 탓에 어느새"
  },
  "121": {
   "jp": "46bf2c75",
   "kr": "사람들 사이에서 하얀마녀로 불리게 되었다."
  },
  "122": {
   "jp": "1a4a2a94",
   "kr": "『재앙의 산이 바다에서 나와 도읍을 부순다』"
  },
  "123": {
   "jp": "b05daa72",
   "kr": "메나트 동해안에서 앰비쉬 전역에 남은"
  },
  "124": {
   "jp": "69a0f202",
   "kr": "게르드의 말이다. 학자들은 바다에서 나타나는"
  },
  "125": {
   "jp": "2bfdd81b",
   "kr": "산을 지진으로 생긴 새 섬이라 해석한다."
  },
  "126": {
   "jp": "6bdbda59",
   "kr": "『대지가 결실을 잊을 때 산은 바다를 넘어"
  },
  "127": {
   "jp": "28c5b0b7",
   "kr": "사람들의 탄식이 메아리친다.』 거의 메나트"
  },
  "128": {
   "jp": "c18b3ba2",
   "kr": "전역에 남은 말. 여기서도 산이 화근이나"
  },
  "129": {
   "jp": "2b706c53",
   "kr": "앞의 산과 달리 해석이 불가능하다."
  },
  "130": {
   "jp": "48ae4fc5",
   "kr": "한편 신비학자 중에는 이 말들을 다른"
  },
  "131": {
   "jp": "ddbb3870",
   "kr": "관점에서 해석하는 이도 있다. 두 말의"
  },
  "132": {
   "jp": "93a45a94",
   "kr": "산은 같고, 거대 생물의 습격이라 본다."
  },
  "133": {
   "jp": "f6361ccd",
   "kr": "책등에 《요술사 겟페우스의 보물》이라고"
  },
  "134": {
   "jp": "0b5c632c",
   "kr": "적힌 책이 있다."
  },
  "135": {
   "jp": "2b32dbf8",
   "kr": "쥬리오는 손에 들고 책을 펼쳐 보았다."
  },
  "136": {
   "jp": "d6cb9b73",
   "kr": "《요술사 겟페우스의 보물》"
  },
  "137": {
   "jp": "16253682",
   "kr": "일찍이 대마도사 올테가와의 대결에서 진"
  },
  "138": {
   "jp": "f17ea3e9",
   "kr": "요술사 겟페우스. 그는 북쪽 빙산에 틀어박혀"
  },
  "139": {
   "jp": "2d0ae55f",
   "kr": "다시 올테가에게 도전하려고 수행을 쌓았다."
  },
  "140": {
   "jp": "17babc64",
   "kr": "겟페우스의 요술은 결코 사악하지 않았으나,"
  },
  "141": {
   "jp": "bac7cf0d",
   "kr": "올테가를 이기는 것만이 목적인 기술은"
  },
  "142": {
   "jp": "78356749",
   "kr": "뜻이 없고 공명심만 앞서, 아무리 수행해도"
  },
  "143": {
   "jp": "819c55d7",
   "kr": "다듬어지지 못했다."
  },
  "144": {
   "jp": "9565c1ef",
   "kr": "어느 날 겟페우스에게 악마가 속삭였다."
  },
  "145": {
   "jp": "06e0b3c7",
   "kr": "악마는 힘을 주는 대신 올테가를 쓰러뜨리라"
  },
  "146": {
   "jp": "55b55a6c",
   "kr": "겟페우스에게 명했다. 겟페우스는 그때에"
  },
  "147": {
   "jp": "2312eae2",
   "kr": "이르러서야 제 어리석음을 깨달았다."
  },
  "148": {
   "jp": "253c689c",
   "kr": "요술사 겟페우스와 대마도사 올테가는"
  },
  "149": {
   "jp": "6c23e908",
   "kr": "힘을 합쳐 악마를 물리쳤다. 둘 다 힘의"
  },
  "150": {
   "jp": "5d4c37aa",
   "kr": "거의 전부를 썼지만 우정은 남았다. 그러나"
  },
  "151": {
   "jp": "d31d1e26",
   "kr": "그것은 무엇과도 바꿀 수 없는 보물이었다."
  },
  "152": {
   "jp": "9c145bc8",
   "kr": "요술사 겟페우스는"
  },
  "153": {
   "jp": "4e31b906",
   "kr": "나쁜 녀석이 아니었구나."
  },
  "154": {
   "jp": "81e49327",
