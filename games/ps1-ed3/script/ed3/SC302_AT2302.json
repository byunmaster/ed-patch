{
 "archive": "/SCE3/SC302.DAT",
 "member": "..\\DATA\\AT2302.BIN",
 "lines": {
  "0": {
   "jp": "84e70172",
   "kr": "안데라성"
  },
  "1": {
   "jp": "24b7384e",
   "kr": "2층"
  },
  "2": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "3": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "4": {
   "jp": "1addc969",
   "kr": "죠리나 왕비"
  },
  "5": {
   "jp": "b97d5055",
   "kr": "마기사"
  },
  "6": {
   "jp": "943c8543",
   "kr": "스라브 노인"
  },
  "7": {
   "jp": "c258804a",
   "kr": "가루가 소동도 가라앉고,"
  },
  "8": {
   "jp": "1d5e0fef",
   "kr": "모두들 한시름"
  },
  "9": {
   "jp": "8a022ad1",
   "kr": "놓고 있답니다."
  },
  "10": {
   "jp": "0702de21",
   "kr": "이곳은 폐하의 침실이죠."
  },
  "11": {
   "jp": "3140554f",
   "kr": "구경하고 싶으시면, 얼마든지요."
  },
  "12": {
   "jp": "3d9e5737",
   "kr": "따로 안내료는 받지 않으니 안심하십시오."
  },
  "13": {
   "jp": "4102c26a",
   "kr": "아니, 실례했습니다."
  },
  "14": {
   "jp": "4bdbbc78",
   "kr": "제 농담, 어떠셨습니까?"
  },
  "15": {
   "jp": "c73d2771",
   "kr": "재미없어요."
  },
  "16": {
   "jp": "44fe4ccb",
   "kr": "실례했습니다."
  },
  "17": {
   "jp": "974aeedd",
   "kr": "부디 편히 머물러 주십시오."
  },
  "18": {
   "jp": "8f67152b",
   "kr": "앰비쉬는 좋은 곳입니다."
  },
  "19": {
   "jp": "ff2ed3a1",
   "kr": "부디 푹 쉬시면서"
  },
  "20": {
   "jp": "c6be2a43",
   "kr": "여행의 피로를 푸십시오."
  },
  "21": {
   "jp": "7370652f",
   "kr": "로디 님은"
  },
  "22": {
   "jp": "8c926224",
   "kr": "조금 더 요양이 필요한"
  },
  "23": {
   "jp": "b95396a2",
   "kr": "듯합니다."
  },
  "24": {
   "jp": "35356466",
   "kr": "안심하십시오."
  },
  "25": {
   "jp": "68591c9b",
   "kr": "시녀들 사이에서 인기가 대단해서"
  },
  "26": {
   "jp": "a63e6125",
   "kr": "본인도 기뻐하는 것 같으니까요."
  },
  "27": {
   "jp": "faedadca",
   "kr": "인기가 대단하대."
  },
  "28": {
   "jp": "c24e2f1e",
   "kr": "역시, 반바지가 인기 비결인가 봐."
  },
  "29": {
   "jp": "6f2a1c22",
   "kr": "볼트에서 앰비쉬를 지키려고"
  },
  "30": {
   "jp": "ed36dace",
   "kr": "힘을 보태 주신 로디 님이라는 분이"
  },
  "31": {
   "jp": "7deba8cf",
   "kr": "이 성에서 요양하고 계세요."
  },
  "32": {
   "jp": "1a72d38e",
   "kr": "정말 멋진 분이시랍니다."
  },
  "33": {
   "jp": "7e7b6db7",
   "kr": "마기사는 새근새근 잠들어 있다."
  },
  "34": {
   "jp": "e25d42bf",
   "kr": "내일 요리 콘테스트가 기대되는군요."
  },
  "35": {
   "jp": "abe75131",
   "kr": "나는 좀 더,"
  },
  "36": {
   "jp": "68fc99c5",
   "kr": "여기서 바람을 쐬고 있을게."
  },
  "37": {
   "jp": "77dcd382",
   "kr": "성안은 처음이시죠?"
  },
  "38": {
   "jp": "ea133446",
   "kr": "부디 성안을 마음껏"
  },
  "39": {
   "jp": "85fbc186",
   "kr": "둘러보세요."
  },
  "40": {
   "jp": "c88ad9f8",
   "kr": "여기는 안데라성 도서실입니다."
  },
  "41": {
   "jp": "091c15b6",
   "kr": "앰비쉬의 역사와 티라스일 각지에서"
  },
  "42": {
   "jp": "1a0bde85",
   "kr": "모은 책들이 소장되어 있습니다."
  },
  "43": {
   "jp": "b03d6b8c",
   "kr": "부디, 마음껏 열람하십시오."
  },
  "44": {
   "jp": "eddd666e",
   "kr": "책등에 『안데라 호수』라고 적힌 책이 있다."
  },
  "45": {
   "jp": "db11b8e0",
   "kr": "쥬리오는 그 책을 집어 들어 펼쳐 보았다."
  },
  "46": {
   "jp": "9e00a194",
   "kr": "안데라 호수는 이 땅의 창세 전승에 따르면,"
  },
  "47": {
   "jp": "88d3ba39",
   "kr": "산맥만 한 큰뱀과 싸운 거인의 발자국이라"
  },
  "48": {
   "jp": "16b69357",
   "kr": "한다. 큰뱀을 이긴 거인은 그 큰뱀을"
  },
  "49": {
   "jp": "74d0103b",
   "kr": "한 번 어깨에 메고 승리의 함성을 올렸다."
  },
  "50": {
   "jp": "12b1ef18",
   "kr": "호수는 그때의 무게 때문에 생겨났다고"
  },
  "51": {
   "jp": "5f305f6b",
   "kr": "한다. 거인은 앰비쉬 남쪽 국경을"
  },
  "52": {
   "jp": "423e02e4",
   "kr": "따라 큰뱀을 눕혔다. 그것이 앰비쉬의"
  },
  "53": {
   "jp": "67e5e39e",
   "kr": "대산맥이 되었다."
  },
  "54": {
   "jp": "b27cfc81",
   "kr": "거인의 발자국에는 물이 고여, 푸르게 맑은"
  },
  "55": {
   "jp": "47286f9d",
   "kr": "아름다운 호수가 되었다."
  },
  "56": {
   "jp": "1998305e",
   "kr": "책등에 『하얀마녀의 말』이란 책이 있다."
  },
  "57": {
   "jp": "db11b8e0",
   "kr": "쥬리오는 그 책을 집어 들어 펼쳐 보았다."
  },
  "58": {
   "jp": "ac47da45",
   "kr": "그녀의 이름은 게르드. 티라스일을 걸으며"
  },
  "59": {
   "jp": "65bd5bc7",
   "kr": "불길한 말을 남기고 사라졌다. 아직 스무"
  },
  "60": {
   "jp": "8931dcc2",
   "kr": "살도 안 된 처녀는 백은빛 머리 탓에 어느새"
  },
  "61": {
   "jp": "46bf2c75",
   "kr": "사람들 사이에서 하얀마녀로 불리게 되었다."
  },
  "62": {
   "jp": "1a4a2a94",
   "kr": "『재앙의 산이 바다에서 나와 도읍을 부순다』"
  },
  "63": {
   "jp": "b05daa72",
   "kr": "메나트 동해안에서 앰비쉬 전역에 남은"
  },
  "64": {
   "jp": "69a0f202",
   "kr": "게르드의 말이다. 학자들은 바다에서 나타나는"
  },
  "65": {
   "jp": "2bfdd81b",
   "kr": "산을 지진으로 생긴 새 섬이라 해석한다."
  },
  "66": {
   "jp": "6bdbda59",
   "kr": "『대지가 결실을 잊을 때 산은 바다를 넘어"
  },
  "67": {
   "jp": "28c5b0b7",
   "kr": "사람들의 탄식이 메아리친다.』 거의 메나트"
  },
  "68": {
   "jp": "c18b3ba2",
   "kr": "전역에 남은 말. 여기서도 산이 화근이나"
  },
  "69": {
   "jp": "2b706c53",
   "kr": "앞의 산과 달리 해석이 불가능하다."
  },
  "70": {
   "jp": "48ae4fc5",
   "kr": "한편 신비학자 중에는 이 말들을 다른"
  },
  "71": {
   "jp": "ddbb3870",
   "kr": "관점에서 해석하는 이도 있다. 두 말의"
  },
  "72": {
   "jp": "93a45a94",
   "kr": "산은 같고, 거대 생물의 습격이라 본다."
  },
  "73": {
   "jp": "f6361ccd",
   "kr": "책등에 《요술사 겟페우스의 보물》이라고"
  },
  "74": {
   "jp": "0b5c632c",
   "kr": "적힌 책이 있다."
  },
  "75": {
   "jp": "2b32dbf8",
   "kr": "쥬리오는 손에 들고 책을 펼쳐 보았다."
  },
  "76": {
   "jp": "d6cb9b73",
   "kr": "《요술사 겟페우스의 보물》"
  },
  "77": {
   "jp": "16253682",
   "kr": "일찍이 대마도사 올테가와의 대결에서 진"
  },
  "78": {
   "jp": "f17ea3e9",
   "kr": "요술사 겟페우스. 그는 북쪽 빙산에 틀어박혀"
  },
  "79": {
   "jp": "2d0ae55f",
   "kr": "다시 올테가에게 도전하려고 수행을 쌓았다."
  },
  "80": {
   "jp": "17babc64",
   "kr": "겟페우스의 요술은 결코 사악하지 않았으나,"
  },
  "81": {
   "jp": "bac7cf0d",
   "kr": "올테가를 이기는 것만이 목적인 기술은"
  },
  "82": {
   "jp": "78356749",
   "kr": "뜻이 없고 공명심만 앞서, 아무리 수행해도"
  },
  "83": {
   "jp": "819c55d7",
   "kr": "다듬어지지 못했다."
  },
  "84": {
   "jp": "9565c1ef",
   "kr": "어느 날 겟페우스에게 악마가 속삭였다."
  },
  "85": {
   "jp": "06e0b3c7",
   "kr": "악마는 힘을 주는 대신 올테가를 쓰러뜨리라"
  },
  "86": {
   "jp": "55b55a6c",
   "kr": "겟페우스에게 명했다. 겟페우스는 그때에"
  },
  "87": {
   "jp": "2312eae2",
   "kr": "이르러서야 제 어리석음을 깨달았다."
  },
  "88": {
   "jp": "253c689c",
   "kr": "요술사 겟페우스와 대마도사 올테가는"
  },
  "89": {
   "jp": "6c23e908",
   "kr": "힘을 합쳐 악마를 물리쳤다. 둘 다 힘의"
  },
  "90": {
   "jp": "5d4c37aa",
   "kr": "거의 전부를 썼지만 우정은 남았다. 그러나"
  },
  "91": {
   "jp": "d31d1e26",
   "kr": "그것은 무엇과도 바꿀 수 없는 보물이었다."
  },
  "92": {
   "jp": "9c145bc8",
   "kr": "요술사 겟페우스는"
  },
  "93": {
   "jp": "4e31b906",
   "kr": "나쁜 녀석이 아니었구나."
  },
  "94": {
   "jp": "ec9ff894",
   "kr": "응, 왜?"
  },
  "95": {
   "jp": "9ebf40ad",
   "kr": "방이 너무 화려해서"
  },
  "96": {
   "jp": "cb1265c6",
   "kr": "좀처럼 잠이 오지 않는다."
  },
  "97": {
   "jp": "66420829",
   "kr": "미안해."
  },
  "98": {
   "jp": "35c0ad01",
   "kr": "모처럼 마련해 줬는데."
  },
  "99": {
   "jp": "2d237926",
   "kr": "우리 이렇게 화려한 곳에"
  },
  "100": {
   "jp": "be3682fa",
   "kr": "묵어 본 적이 없어서"
  },
  "101": {
   "jp": "6aba3438",
   "kr": "왠지 긴장돼서 잠이 안 와."
  },
  "102": {
   "jp": "e1303ccd",
   "kr": "흐〜음, 그런 건가."
  },
  "103": {
   "jp": "b555add7",
   "kr": "이런, 미안하네."
  },
  "104": {
   "jp": "fcc12de5",
   "kr": "내가 좀 더 신경을 썼어야 했군."
  },
  "105": {
   "jp": "e6492088",
   "kr": "그럼 여관 술집 도밍고네 가게에"
  },
  "106": {
   "jp": "31ba8ff3",
   "kr": "침대를 부탁해 두겠네."
  },
  "107": {
   "jp": "9a7d6e16",
   "kr": "도밍고네 가게는 알겠지?"
  },
  "108": {
   "jp": "88149875",
   "kr": "네."
  },
  "109": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "110": {
   "jp": "3c6341c2",
   "kr": "자고 싶어지면"
  },
  "111": {
   "jp": "3a68c341",
   "kr": "도밍고 여관 술집으로 가게."
  },
  "112": {
   "jp": "23ce7977",
   "kr": "늦잠을 자도 괜찮도록"
  },
  "113": {
   "jp": "5f132778",
   "kr": "내일 아침엔 누굴 시켜 부르러 보내겠네."
  },
  "114": {
   "jp": "3d866aaa",
   "kr": "내일은 요리 콘테스트입니다."
  },
  "115": {
   "jp": "05e5dcc3",
   "kr": "진수성찬 꿈을 너무 꾸어"
  },
  "116": {
   "jp": "b5cc18bc",
   "kr": "배부르지 않도록 조심하십시오."
  }
 }
}