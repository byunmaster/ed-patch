 "lines": {
  "0": {
   "jp": "16b2a2e8",
   "kr": "루드성"
  },
  "1": {
   "jp": "46a9e4f2",
   "kr": "알현실"
  },
  "2": {
   "jp": "bc2e9549",
   "kr": "루돌프 왕"
  },
  "3": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "4": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "5": {
   "jp": "32499e3b",
   "kr": "브리트 대장"
  },
  "6": {
   "jp": "a707424e",
   "kr": "듀르젤."
  },
  "7": {
   "jp": "e1b9038d",
   "kr": "오오, 알프레드 왕."
  },
  "8": {
   "jp": "31b149c2",
   "kr": "정말로 전부 그대들 덕분이네."
  },
  "9": {
   "jp": "99bdfee0",
   "kr": "폴티아를 잘 구해 주었다."
  },
  "10": {
   "jp": "de7e72cc",
   "kr": "루돌프 왕,"
  },
  "11": {
   "jp": "be31bf2f",
   "kr": "이런 좋은 결말을 맞은 것도"
  },
  "12": {
   "jp": "624e0f0d",
   "kr": "이 두 사람 덕분이오."
  },
  "13": {
   "jp": "bbf3debc",
   "kr": "순례 여행자 쥬리오와 크리스요."
  },
  "14": {
   "jp": "3ce25c98",
   "kr": "쥬리오 군, 정말 고맙네."
  },
  "15": {
   "jp": "080d67a1",
   "kr": "우리를 살려 주었네."
  },
  "16": {
   "jp": "9bd772e0",
   "kr": "크리스 양, 고맙네."
  },
  "17": {
   "jp": "7605ae48",
   "kr": "진심으로 감사하네."
  },
  "18": {
   "jp": "3ab19a2f",
   "kr": "정말 여러분께는"
  },
  "19": {
   "jp": "a62571db",
   "kr": "감사의 말로 다 못 할 만큼"
  },
  "20": {
   "jp": "e9df0ab4",
   "kr": "신세를 지고 말았네."
  },
  "21": {
   "jp": "bc981f46",
   "kr": "이자벨과 레바스의 음모를 잘도"
  },
  "22": {
   "jp": "0aee089c",
   "kr": "잘 막아 주었네."
  },
  "23": {
   "jp": "eba0cf8e",
   "kr": "루돌프 왕, 그 마음 알겠소."
  },
  "24": {
   "jp": "6690efa0",
   "kr": "설령 이계에서 온 침입자라 해도"
  },
  "25": {
   "jp": "d61c5c79",
   "kr": "그대가 사랑한 사람이오."
  },
  "26": {
   "jp": "787d9ca6",
   "kr": "그녀의 참뜻은 우리에게는"
  },
  "27": {
   "jp": "cd4cf90a",
   "kr": "막아야 할 것이었지만"
  },
  "28": {
   "jp": "a99e6b2f",
   "kr": "이계 사람들도 멈출 수 없는 사정이 있었소."
  },
  "29": {
   "jp": "6f22d936",
   "kr": "고맙소, 알프레드 왕."
  },
  "30": {
   "jp": "cfc02a51",
   "kr": "그리 말해 주니"
  },
  "31": {
   "jp": "285f5f5b",
   "kr": "조금은 마음이 편해지는 듯하오."
  },
  "32": {
   "jp": "68006bce",
   "kr": "내겐"
  },
  "33": {
   "jp": "1903ce28",
   "kr": "지금도 아름답고 상냥한 이자벨밖에"
  },
  "34": {
   "jp": "578a563d",
   "kr": "떠오르지 않소…"
  },
  "35": {
   "jp": "e37e2bf1",
   "kr": "아무도 예상할 수 없었소."
  },
  "36": {
   "jp": "ec5e1413",
   "kr": "유일하게 모든 걸 알고"
  },
  "37": {
   "jp": "15b26e18",
   "kr": "처음부터 움직인 것은"
  },
  "38": {
   "jp": "6066f129",
   "kr": "하얀마녀뿐이었으니 말이오…"
  },
  "39": {
   "jp": "4103e35f",
   "kr": "게르드가 없었다면"
  },
  "40": {
   "jp": "2bdd043d",
   "kr": "우리는 진실을 하나도 모른 채"
  },
  "41": {
   "jp": "033559b1",
   "kr": "멸망했을 것이오."
  },
  "42": {
   "jp": "f569da0a",
   "kr": "그런 셈이지."
  },
  "43": {
   "jp": "a588db6f",
   "kr": "하얀마녀가"
  },
  "44": {
   "jp": "a7b69414",
   "kr": "희망의 길을 남겨 주었기에"
  },
  "45": {
   "jp": "0a01cb8b",
   "kr": "우리는 구원받은 것이오."
  },
  "46": {
   "jp": "04e11afc",
   "kr": "이걸로 게르드 님도"
  },
  "47": {
   "jp": "2b914141",
   "kr": "편히 잠들 수 있게 되었네요."
  },
  "48": {
   "jp": "cb30160e",
   "kr": "그래, 그렇고말고."
  },
  "49": {
   "jp": "2dd47224",
   "kr": "그래야지…"
  },
  "50": {
   "jp": "4019dcbe",
   "kr": "그렇지 않으면 너무 슬프잖아."
  },
  "51": {
   "jp": "f9d21452",
   "kr": "…훌쩍."
  },
  "52": {
   "jp": "9a9a5025",
   "kr": "어…"
  },
  "53": {
   "jp": "aa398f96",
   "kr": "삼촌… 울고 있어."
  },
  "54": {
   "jp": "cafc9aa9",
   "kr": "구스네 모습이 안 보이네?"
  },
  "55": {
   "jp": "bee1378b",
   "kr": "아."
  },
  "56": {
   "jp": "39bd91cd",
   "kr": "그분들이라면 아까 슬쩍"
  },
  "57": {
   "jp": "ef7ef4ec",
   "kr": "나가셨습니다."
  },
  "58": {
   "jp": "0b6571df",
   "kr": "딱딱한 자리는 싫다고."
  },
  "59": {
   "jp": "e25c7ea2",
   "kr": "상을 받는다느니 하더니만."
  },
  "60": {
   "jp": "1258e9ac",
   "kr": "막상 닥치니 쑥스러웠던 걸까."
  },
  "61": {
   "jp": "f8471948",
   "kr": "앗…"
  },
  "62": {
   "jp": "f40fb659",
   "kr": "엇, 왜 그래?"
  },
  "63": {
   "jp": "afcf8e4e",
   "kr": "훌쩍…"
  },
  "64": {
   "jp": "e8750b93",
   "kr": "설마…"
  },
  "65": {
   "jp": "59b49860",
   "kr": "다들 여기 있는 사이에"
  },
  "66": {
   "jp": "c556b599",
   "kr": "이 성의 보물을"
  },
  "67": {
   "jp": "97e690e7",
   "kr": "훔칠 셈은 아니겠지."
  },
  "68": {
   "jp": "3891dd5d",
   "kr": "그럴 리가…"
  },
  "69": {
   "jp": "2ef8f0dd",
   "kr": "그래도 혹시 그렇다 해도"
  },
  "70": {
   "jp": "1913f680",
   "kr": "괜찮을 거야."
  },
  "71": {
   "jp": "fc838fc1",
   "kr": "구스네는"
  },
  "72": {
   "jp": "e8023430",
   "kr": "도둑질에 성공한 적이 없으니까."
  },
  "73": {
   "jp": "e86a8216",
   "kr": "분명 나쁜 짓은 못 하는 운명인 거야."
  },
  "74": {
   "jp": "02d92bcd",
   "kr": "어머, 쥬리오도 참…"
  },
  "75": {
   "jp": "94577da8",
   "kr": "허크 삼촌 말버릇 같아."
  },
  "76": {
   "jp": "80dfe663",
   "kr": "훌쩍… 응?"
  },
  "77": {
   "jp": "52607dc1",
   "kr": "하하하…"
  },
  "78": {
   "jp": "1457c9f6",
   "kr": "그럼, 훌륭한 어른이 되겠구나."
  },
  "79": {
   "jp": "3adae119",
   "kr": "………"
  },
  "80": {
   "jp": "8d1daf73",
   "kr": "그러고 보니 로디도 없어."
  },
  "81": {
   "jp": "2b62edff",
   "kr": "어디 간 걸까…"
  },
  "82": {
   "jp": "f48bd0b0",
   "kr": "어라, 진짜네."
  },
  "83": {
   "jp": "87fadafd",
   "kr": "반바지 형씨라면"
  },
  "84": {
   "jp": "72c25a5a",
   "kr": "지하에서 길 잃은 병사를"
  },
  "85": {
   "jp": "b7a9676b",
   "kr": "구하러 갔어."
  },
  "86": {
   "jp": "dbda8249",
   "kr": "앗, 맞다."
  },
  "87": {
   "jp": "1ab5eccc",
   "kr": "깜빡했어."
  },
  "88": {
   "jp": "a2727e7c",
   "kr": "살았습니다."
  },
  "89": {
   "jp": "43f53f1a",
   "kr": "정말 고맙습니다."
  },
  "90": {
   "jp": "9953e297",
   "kr": "자기 성에서 헤매지 말라고."
  },
  "91": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "92": {
   "jp": "8e7dc6df",
   "kr": "주의하겠습니다."
  },
  "93": {
   "jp": "cf584f7b",
   "kr": "아, 폐하…"
  },
  "94": {
   "jp": "59745b0b",
   "kr": "이런, 미안했네."
  },
  "95": {
   "jp": "b51fdca3",
   "kr": "무사히 끝나서 다행입니다."
  },
  "96": {
   "jp": "5170fc77",
   "kr": "그대들 덕분이네."
  },
  "97": {
   "jp": "42b1e8b6",
   "kr": "(살아 있잖아?)"
  },
  "98": {
   "jp": "7ef57167",
   "kr": "(당연하지.)"
  },
  "99": {
   "jp": "375818dd",
   "kr": "(약속 기억하지?)"
  },
  "100": {
   "jp": "2713bbe7",
   "kr": "(얕보지 마라.)"
  },
  "101": {
   "jp": "3d071ef1",
   "kr": "(아직 노망 나긴 이르다.)"
  },
  "102": {
   "jp": "2c033d9a",
   "kr": "여러분〜, 기뻐하십시오."
  },
  "103": {
   "jp": "f9886407",
   "kr": "방금 기드나 국경에서 연락이 왔습니다."
  },
  "104": {
   "jp": "b4d7ae5e",
   "kr": "병사들이 의식을 되찾고"
  },
  "105": {
   "jp": "b3c894ba",
   "kr": "제정신으로 돌아왔답니다."
  },
  "106": {
   "jp": "972e42fb",
   "kr": "이제 전쟁이 시작될 위험도 없습니다."
  },
  "107": {
   "jp": "9a0cc98e",
   "kr": "신난다."
  },
  "108": {
   "jp": "1636a632",
   "kr": "후우…"
  },
  "109": {
   "jp": "a61c1d0f",
   "kr": "정말 다행이네."
  },
  "110": {
   "jp": "3782417d",
   "kr": "모두 하얀마녀와 그대들 덕분이네."
  },
  "111": {
   "jp": "98b41bc0",
   "kr": "정말 고맙네."
  },
  "112": {
   "jp": "35a28447",
   "kr": "쥬리오 일행의 활약으로"
  },
  "113": {
   "jp": "0cf5d319",
   "kr": "라우알의 파도 출현을 막을 수 있었다."
  },
  "114": {
   "jp": "51c30d64",
   "kr": "쥬리오와 크리스는"
  },
  "115": {
   "jp": "ef81b323",
   "kr": "하얀마녀가 남긴 희망의 길을 걸어왔다."
  },
  "116": {
   "jp": "a972440f",
   "kr": "하지만 그것은"
  },
  "117": {
   "jp": "c8067d6f",
   "kr": "무엇 하나 빠져도 이룰 수 없는"
  },
  "118": {
   "jp": "e39d7320",
   "kr": "혹독하고 험난한 길이었다."
  },
  "119": {
   "jp": "d5ae3b27",
   "kr": "많은 만남이 열매를 맺어"
  },
  "120": {
   "jp": "07b349f1",
   "kr": "세계를 파멸로 이끌 만한 힘을 지닌"
  },
  "121": {
   "jp": "ebabee9c",
   "kr": "라우알의 파도에도 이길 희망의 힘이"
  },
  "122": {
   "jp": "2b19de55",
   "kr": "된 것이다."
  },
  "123": {
   "jp": "ac89b495",
   "kr": "루돌프 왕의 수고했다는 말을 들으면서"
  },
  "124": {
   "jp": "65d24825",
   "kr": "쥬리오도 크리스도"
  },
  "125": {
   "jp": "1c879d5f",
   "kr": "하얀마녀를 생각하고 있었다."
  },
  "126": {
   "jp": "f658c824",
   "kr": "여러분."
  },
  "127": {
   "jp": "54e00af4",
   "kr": "부디 당분간"
  },
  "128": {
   "jp": "4220b919",
   "kr": "이 성에서 편히 쉬어 가시게."
  },
  "129": {
   "jp": "17a6a934",
   "kr": "해 줄 수 있는 것은 없네만"
  },
  "130": {
   "jp": "90f9dcee",
   "kr": "적어도 푹 피로를 풀고"
  },
  "131": {
   "jp": "1136ae7c",
   "kr": "편히 지내게."
  },
  "132": {
   "jp": "e1bdeeb2",
   "kr": "고맙소, 루돌프 왕."
  },
  "133": {
   "jp": "aa59d939",
   "kr": "마음은 고맙지만"
  },
  "134": {
   "jp": "c8b03774",
   "kr": "그러고 있을 수는 없소."
  },
  "135": {
   "jp": "dd8b63c0",
   "kr": "아무래도"
  },
  "136": {
   "jp": "f2e1b14e",
   "kr": "모리슨까지 여기 있는지라"
  },
  "137": {
   "jp": "ea86d7f5",
   "kr": "앰비쉬가 텅 비어 있소."
  },
  "138": {
   "jp": "2119361e",
   "kr": "나 또한"
  },
  "139": {
   "jp": "01bcde9f",
   "kr": "알프레드 왕이 이곳에 와 있을 줄은"
  },
  "140": {
   "jp": "adc34815",
   "kr": "생각지도 못했소."
  },
  "141": {
   "jp": "cdeee75f",
   "kr": "뭐, 걱정은 없겠지만"
  },
  "142": {
   "jp": "bcd43fbe",
   "kr": "어서 돌아가 백성들을 안심시켜"
  },
  "143": {
   "jp": "345a5390",
   "kr": "주고 싶구려."
  },
  "144": {
   "jp": "9eb7ff7f",
   "kr": "우리도 순례 여행 도중이고"
  },
  "145": {
   "jp": "5e1c460f",
   "kr": "예정보다 너무 늦어지면"
  },
  "146": {
   "jp": "328d94dd",
   "kr": "분명 엄마들이 걱정하실 거예요."
  },
  "147": {
   "jp": "a825c538",
   "kr": "적어도"
  },
  "148": {
   "jp": "700cc759",
   "kr": "눈이 오기 전까지는"
  },
  "149": {
   "jp": "7336035a",
   "kr": "마을에 돌아가야지."
  },
  "150": {
   "jp": "48aa2003",
   "kr": "응, 그렇지."
  },
  "151": {
   "jp": "357f2bcd",
   "kr": "제대로 라그픽 마을에 닿을 때까지"
  },
  "152": {
   "jp": "74df7eb3",
   "kr": "우리 여행은"
  },
  "153": {
   "jp": "078ea9ea",
   "kr": "끝난 게 아니야."
  },
  "154": {
   "jp": "c1a69ece",
   "kr": "그럼 적어도"
  },
  "155": {
   "jp": "53bdb6f8",
   "kr": "쥬리오 군과 크리스 양에겐"
  },
  "156": {
   "jp": "0c095ffe",
   "kr": "마차를 마련해 주겠네."
  },
  "157": {
   "jp": "cc7be1c0",
   "kr": "중간까지 데려다주지."
  },
  "158": {
   "jp": "baed853d",
   "kr": "와, 진짜요?!"
  },
  "159": {
   "jp": "101ca186",
   "kr": "신난다〜"
  },
  "160": {
   "jp": "4ec2c81a",
   "kr": "나 한 번이라도 좋으니"
  },
  "161": {
   "jp": "7d14e269",
   "kr": "마차에 타 보고 싶었거든요."
  },
  "162": {
   "jp": "be81ecb3",
   "kr": "신난다. 잘됐다."
  },
  "163": {
   "jp": "96d72dc9",
   "kr": "쥬리오, 너무 들떴어."
  },
  "164": {
   "jp": "f192ad29",
   "kr": "하하하하하하…"
  },
  "165": {
   "jp": "02e64793",
   "kr": "하하하하…"
  },
  "166": {
   "jp": "ccc2d227",
   "kr": "핫핫핫핫핫…"
  },
  "167": {
   "jp": "f192ad29",
   "kr": "하하하하하하…"
  },
  "168": {
   "jp": "cdd9ae74",
   "kr": "알현실에 웃음소리가 감돌았다."
  },
  "169": {
   "jp": "01336ce7",
   "kr": "루드성에서는 20년 만의"
  },
  "170": {
   "jp": "654e6c98",
   "kr": "밝고 즐거운 웃음소리였다."
  },
  "171": {
   "jp": "48fd68ff",
   "kr": "듀르젤 씨."
  },
  "172": {
   "jp": "69bf96b2",
   "kr": "이거, 돌려드려요."
  },
  "173": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는 "
  },
  "174": {
   "jp": "f13cf43d",
   "kr": "을(를) 내밀었다."
  },
  "175": {
   "jp": "27f1dfdf",
   "kr": "이건 듀르젤 씨의 검이에요."
  },
  "176": {
   "jp": "8d3ffc69",
   "kr": "역시"
  },
  "177": {
   "jp": "8181f5e0",
   "kr": "듀르젤 씨가 가지고 계셔야"
  },
  "178": {
   "jp": "c12e1fed",
   "kr": "할 것 같아요."
  },
  "179": {
   "jp": "3616dd0e",
   "kr": "나에겐 자격이 없다고 했잖니."
  },
  "180": {
   "jp": "783c23a5",
   "kr": "루드성을… 세계를 지켰잖아요."
  },
  "181": {
   "jp": "4b00489c",
   "kr": "저는 듀르젤 씨 말고는"
  },
  "182": {
   "jp": "73b7b444",
   "kr": "이 검을 지니기에 어울리는 검사는"
  },
  "183": {
   "jp": "42383202",
   "kr": "없다고 생각해요."
  },
  "184": {
   "jp": "05ae22e5",
   "kr": "듀르젤은"
  },
  "185": {
   "jp": "bf9abd11",
   "kr": "한동안 쥬리오의 눈동자를 바라보고 있었다."
  },
  "186": {
   "jp": "7992cb08",
   "kr": "쥬리오… 고맙다."
  },
  "187": {
   "jp": "4f2e2c83",
   "kr": "이 검은 받아 두마."
  },
  "188": {
   "jp": "05ae22e5",
   "kr": "듀르젤은 "
  },
  "189": {
   "jp": "6c9a91dc",
   "kr": "을(를) 받았다."
  },
  "190": {
   "jp": "2a82121f",
   "kr": "일행은 입을 모아 기쁨과"
  },
  "191": {
   "jp": "4e3d2b79",
   "kr": "서로의 건투를 기리며"
  },
  "192": {
   "jp": "2ba21623",
   "kr": "마음속 깊이 하얀마녀에게 감사했다."
  },
  "193": {
   "jp": "b67a575d",
   "kr": "두 사람을 보낼 마차가 준비될 때까지"
  },
  "194": {
   "jp": "922d079e",
   "kr": "쥬리오 일행은 저마다"
  },
  "195": {
   "jp": "a152bd99",
   "kr": "편히 쉬며 기다리게 되었다."
  }
 }
}