  "0": {
   "jp": "8ae5459a",
   "kr": "왕도 가도"
  },
  "1": {
   "jp": "fed5dfcb",
   "kr": "루데라 관문"
  },
  "2": {
   "jp": "3017c0a6",
   "kr": "모간 대장"
  },
  "3": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "4": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "5": {
   "jp": "f0236d71",
   "kr": "상크"
  },
  "6": {
   "jp": "cbb88b9a",
   "kr": "알토"
  },
  "7": {
   "jp": "241eb19e",
   "kr": "팜"
  },
  "8": {
   "jp": "96aea44a",
   "kr": "블루"
  },
  "9": {
   "jp": "311bbdf6",
   "kr": "들어라! 젊은이여."
  },
  "10": {
   "jp": "d0534e52",
   "kr": "루돌프 국왕은 너그러운 분이시다!"
  },
  "11": {
   "jp": "dc06ba39",
   "kr": "이번에 특별히 폴티아군 병사를 모집한다!"
  },
  "12": {
   "jp": "67936cca",
   "kr": "본디라면 평민은 오를 수 없는 자리다."
  },
  "13": {
   "jp": "ad9398f3",
   "kr": "루돌프 국왕께 충성하고 나라를 위해 일하여"
  },
  "14": {
   "jp": "5946983d",
   "kr": "명성과 재산을 거머쥐어라!"
  },
  "15": {
   "jp": "dbb19d61",
   "kr": "지원자는 이대로 루드로 향하라."
  },
  "16": {
   "jp": "b02f7bc3",
   "kr": "왕도에서 루돌프 왕의 고문이신 레바스 님이"
  },
  "17": {
   "jp": "21bd0ca7",
   "kr": "직접 면접해 주신다."
  },
  "18": {
   "jp": "7e2a4e8f",
   "kr": "난 할 거여."
  },
  "19": {
   "jp": "254e0626",
   "kr": "그쪽은 어쩔 거여?"
  },
  "20": {
   "jp": "0c6cd6e2",
   "kr": "난 메나트에서 바다를 건너왔어."
  },
  "21": {
   "jp": "207dab8e",
   "kr": "메나트는 흉작이 이어져 끼니도 걱정이지."
  },
  "22": {
   "jp": "046cb10b",
   "kr": "설령 다른 나라 병사가 되더라도 돈을 벌어야"
  },
  "23": {
   "jp": "a8c6b8a2",
   "kr": "살 수 있어."
  },
  "24": {
   "jp": "62b6456e",
   "kr": "…나도 가겠어."
  },
  "25": {
   "jp": "8e7ce799",
   "kr": "당신은 병사에 지원하지 않나요?"
  },
  "26": {
   "jp": "69c06030",
   "kr": "아무래도 이 시기에 징병한다는 게"
  },
  "27": {
   "jp": "cdf0bb72",
   "kr": "마음에 걸려."
  },
  "28": {
   "jp": "dff580b2",
   "kr": "대체 무엇을 위해서인지…"
  },
  "29": {
   "jp": "f95a158f",
   "kr": "전 갈 겁니다."
  },
  "30": {
   "jp": "49ef30b6",
   "kr": "병사가 되는 건 어릴 적부터 꿈이었거든요."
  },
  "31": {
   "jp": "8144ba85",
   "kr": "……"
  },
  "32": {
   "jp": "4477c6f8",
   "kr": "적당히 좀 해라!"
  },
  "33": {
   "jp": "b462348a",
   "kr": "몇 번을 말해야 알아듣겠어!?"
  },
  "34": {
   "jp": "4f7131e6",
   "kr": "뭐야, 으스대기는."
  },
  "35": {
   "jp": "9f4e24cd",
   "kr": "무, 뭐라고!"
  },
  "36": {
   "jp": "a1b0120a",
   "kr": "이 계집애가."
  },
  "37": {
   "jp": "2d4fdd1f",
   "kr": "너희를 상대할 만큼 한가하지 않다."
  },
  "38": {
   "jp": "c60368ca",
   "kr": "냉큼 돌아가라."
  },
  "39": {
   "jp": "8a35f3fa",
   "kr": "방해다, 방해!"
  },
  "40": {
   "jp": "7fe7046b",
   "kr": "꼬맹이한테 볼일 없어."
  },
  "41": {
   "jp": "d26dce07",
   "kr": "얼쩡거리면 감옥에 처넣는다!"
  },
  "42": {
   "jp": "b16b62f8",
   "kr": "이봐 이봐, 아이는 고용할 수 없어."
  },
  "43": {
   "jp": "bfada9e4",
   "kr": "애초에 너희들 검술도 모르잖느냐?"
  },
  "44": {
   "jp": "3afb9e7a",
   "kr": "저리 가거라!"
  },
  "45": {
   "jp": "ebda3fe8",
   "kr": "어른을 너무 놀리면 안 돼."
  },
  "46": {
   "jp": "c433b0a4",
   "kr": "속내를 알 수 없는 징병이지만…"
  },
  "47": {
   "jp": "a7ad9245",
   "kr": "병사가 되어 내 힘을 시험해 보고도 싶다."
  },
  "48": {
   "jp": "ce8d3258",
   "kr": "으〜음. 어떻게 할까."
  },
  "49": {
   "jp": "b8a2cfc7",
   "kr": "깜짝 놀랐다니까."
  },
  "50": {
   "jp": "2cdd3fdb",
   "kr": "진짜로 화냈잖아."
  },
  "51": {
   "jp": "35a45f45",
   "kr": "크리스가 쓸데없는 소릴 하니까 그렇지."
  },
  "52": {
   "jp": "785fd3d8",
   "kr": "그치만 으스대잖아."
  }
 }
}