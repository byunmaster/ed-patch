   "kr": "꿈결 가도"
  },
  "1": {
   "jp": "25835072",
   "kr": "서쪽 우돌 국경 45미로"
  },
  "2": {
   "jp": "f781c1b4",
   "kr": "남쪽 삼도교 470미로"
  },
  "3": {
   "jp": "988f3d96",
   "kr": "북쪽 다이스 323미로"
  },
  "4": {
   "jp": "c85fd00a",
   "kr": "서쪽 관문을 넘어"
  },
  "5": {
   "jp": "8f2ca5c0",
   "kr": "우돌에 들어가"
  },
  "6": {
   "jp": "93093fbe",
   "kr": "올도스로 가는 길이구나."
  },
  "7": {
   "jp": "d6fb0867",
   "kr": "그래, 올도스로 가려면"
  },
  "8": {
   "jp": "6b63c041",
   "kr": "우돌 쪽에서밖에 입구가 없으니까."
  },
  "9": {
   "jp": "37d6236d",
   "kr": "남쪽으로 가면 삼도교, 그 앞은"
  },
  "10": {
   "jp": "078e3a27",
   "kr": "드디어 앰비쉬다."
  },
  "11": {
   "jp": "b63ca84a",
   "kr": "서둘러야 해!"
  },
  "12": {
   "jp": "54904258",
   "kr": "이봐 이봐, 쥬리오."
  },
  "13": {
   "jp": "75e817e1",
   "kr": "그쪽은 우돌로 빠지는 관문이야."
  },
  "14": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "15": {
   "jp": "7582d889",
   "kr": "얼른 볼트로 가자고."
  },
  "16": {
   "jp": "20d69653",
   "kr": "이런, 내가 길을 잘못 들면"
  },
  "17": {
   "jp": "7d2c540d",
   "kr": "안 되지."
  }
 }
