 "lines": {
  "0": {
   "jp": "84e70172",
   "kr": "안데라성"
  },
  "1": {
   "jp": "24b7384e",
   "kr": "2층"
  },
  "2": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "3": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "4": {
   "jp": "1addc969",
   "kr": "죠리나 왕비"
  },
  "5": {
   "jp": "b97d5055",
   "kr": "마기사"
  },
  "6": {
   "jp": "943c8543",
   "kr": "스라브 노인"
  },
  "7": {
   "jp": "4a5f592d",
   "kr": "오늘은 요리 콘테스트로군요."
  },
  "8": {
   "jp": "072f5539",
   "kr": "쥬리오 님과 크리스 님도"
  },
  "9": {
   "jp": "8748c529",
   "kr": "참가하시는 겁니까?"
  },
  "10": {
   "jp": "e8a27a17",
   "kr": "네, 크리스가 나가요."
  },
  "11": {
   "jp": "d44137d4",
   "kr": "크리스 님이라면"
  },
  "12": {
   "jp": "12819855",
   "kr": "분명 맛있는 요리를"
  },
  "13": {
   "jp": "20c8f594",
   "kr": "만들어 내시겠지요."
  },
  "14": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "15": {
   "jp": "8dc18e33",
   "kr": "오늘은 혼자세요…"
  },
  "16": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "17": {
   "jp": "05ecf843",
   "kr": "혼자든 둘이든"
  },
  "18": {
   "jp": "9ec32d92",
   "kr": "제 대사는 달라지지 않을 거라고"
  },
  "19": {
   "jp": "7afd1493",
   "kr": "생각하셨지요?"
  },
  "20": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "21": {
   "jp": "f6549f53",
   "kr": "핫핫핫."
  },
  "22": {
   "jp": "5de74618",
   "kr": "실은 역시 똑같단"
  },
  "23": {
   "jp": "05070ba1",
   "kr": "말이지요…"
  },
  "24": {
   "jp": "ad725924",
   "kr": "그럼, 시작하겠습니다."
  },
  "25": {
   "jp": "0702de21",
   "kr": "이곳은 폐하의 침실입니다."
  },
  "26": {
   "jp": "3140554f",
   "kr": "구경하고 싶으시면 얼마든지요."
  },
  "27": {
   "jp": "3d9e5737",
   "kr": "따로 안내료는 받지 않으니 안심하십시오."
  },
  "28": {
   "jp": "4102c26a",
   "kr": "아니, 실례했습니다."
  },
  "29": {
   "jp": "4bdbbc78",
   "kr": "제 농담 어떠셨습니까?"
  },
  "30": {
   "jp": "c73d2771",
   "kr": "재미없어요."
  },
  "31": {
   "jp": "44fe4ccb",
   "kr": "실례했습니다."
  },
  "32": {
   "jp": "f805ea98",
   "kr": "요리 대회는 쥬리오 님과"
  },
  "33": {
   "jp": "c234fe79",
   "kr": "크리스 님을 위해 열린 것."
  },
  "34": {
   "jp": "4e89def8",
   "kr": "거기에 참가까지 하시다니"
  },
  "35": {
   "jp": "1f7433ef",
   "kr": "활달한 분들이시군요!"
  },
  "36": {
   "jp": "245cff9d",
   "kr": "오늘은 요리 대회군요."
  },
  "37": {
   "jp": "425067e8",
   "kr": "어떤 요리가 나올지 기대돼요."
  },
  "38": {
   "jp": "68a5c098",
   "kr": "볼트에서 활약하신 뒤에는"
  },
  "39": {
   "jp": "ba5440db",
   "kr": "요리 대회입니까?"
  },
  "40": {
   "jp": "0f0bbf1c",
   "kr": "부디 상위에 입상해 주십시오."
  },
  "41": {
   "jp": "ed362f5c",
   "kr": "병사들 중에는 두 분의"
  },
  "42": {
   "jp": "483cc617",
   "kr": "팬이 꽤 있답니다."
  },
  "43": {
   "jp": "92c8885d",
   "kr": "오늘 축제의 열기가 전해지면"
  },
  "44": {
   "jp": "fcf14b84",
   "kr": "로디 님도 분명 기운을 차리실 겁니다!"
  },
  "45": {
   "jp": "d5d5a6a6",
   "kr": "왕비님께서 맡기신 향신료 말씀이시죠."
  },
  "46": {
   "jp": "52550325",
   "kr": "네, 이걸 받으세요."
  },
  "47": {
   "jp": "520d2bbc",
   "kr": "쥬리오는 카레 스파이스를 손에 넣었다."
  },
  "48": {
   "jp": "d85ba455",
   "kr": "저기요, 로디 님은"
  },
  "49": {
   "jp": "c1ad4237",
   "kr": "좋아하는 사람 있을까요?"
  },
  "50": {
   "jp": "145fad16",
   "kr": "저, 팬인데 말이죠."
  },
  "51": {
   "jp": "86b8d981",
   "kr": "그 반바지 정말 멋지죠."
  },
  "52": {
   "jp": "1eb2d218",
   "kr": "반할 것 같아요."
  },
  "53": {
   "jp": "3adae119",
   "kr": "………"
  },
  "54": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "55": {
   "jp": "3adae119",
   "kr": "………"
  },
  "56": {
   "jp": "5fba0c04",
   "kr": "어머, 쥬리오 군."
  },
  "57": {
   "jp": "fb86eec3",
   "kr": "크리스 양은 같이 안 왔나요?"
  },
  "58": {
   "jp": "aee7db6c",
   "kr": "요리 콘테스트에 나간다고"
  },
  "59": {
   "jp": "ab99df00",
   "kr": "주방에서 애쓰고 있어요."
  },
  "60": {
   "jp": "77907e2e",
   "kr": "어머, 그래요."
  },
  "61": {
   "jp": "b08373fe",
   "kr": "마침 좋은 게 있어요."
  },
  "62": {
   "jp": "f0bdfa4c",
   "kr": "병문안으로 코코넛 밀크를 받았거든요."
  },
  "63": {
   "jp": "dce2e2f8",
   "kr": "크리스 양의 요리에 써 주세요."
  },
  "64": {
   "jp": "2868def1",
   "kr": "쥬리오는 코코넛 밀크를 손에 넣었다."
  },
  "65": {
   "jp": "92f586a4",
   "kr": "고마워요, 마기사 씨."
  },
  "66": {
   "jp": "ceb81dd9",
   "kr": "크리스 양이라면"
  },
  "67": {
   "jp": "84fdec9f",
   "kr": "분명 맛있는 요리를"
  },
  "68": {
   "jp": "3bfd00dd",
   "kr": "만들어 주시겠지요."
  },
  "69": {
   "jp": "7e7b6db7",
   "kr": "마기사는 새근새근 잠들어 있다."
  },
  "70": {
   "jp": "5fba0c04",
   "kr": "어머, 쥬리오 군."
  },
  "71": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "72": {
   "jp": "67cec8bc",
   "kr": "왕, 왕, 왕비님."
  },
  "73": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "74": {
   "jp": "d3152ba3",
   "kr": "오늘은 크리스 양과 같이 안 왔나요?"
  },
  "75": {
   "jp": "354c3c16",
   "kr": "아, 네, 그게요."
  },
  "76": {
   "jp": "fd3d9a29",
   "kr": "크리스는 요리 콘테스트에"
  },
  "77": {
   "jp": "aba9d4b9",
   "kr": "나가게 됐어요."
  },
  "78": {
   "jp": "3c042ef5",
   "kr": "어머, 그거 기대되네요."
  },
  "79": {
   "jp": "a64bc188",
   "kr": "그렇다면 좋은 게 있어요."
  },
  "80": {
   "jp": "5590ff80",
   "kr": "네?"
  },
  "81": {
   "jp": "4865fb92",
   "kr": "오늘 아침 마침 메나트에서"
  },
  "82": {
   "jp": "565ec73c",
   "kr": "진귀한 향신료가 도착했어요."
  },
  "83": {
   "jp": "39b74a27",
   "kr": "괜찮다면 그것도 써 주세요."
  },
  "84": {
   "jp": "e8982430",
   "kr": "알현실 맞은편에 있는 방에 계세요"
  },
  "85": {
   "jp": "6b76a84c",
   "kr": "시녀에게 맡겨 두었으니"
  },
  "86": {
   "jp": "c154bde2",
   "kr": "마음껏 쓰세요."
  },
  "87": {
   "jp": "d8009201",
   "kr": "고마워요, 왕비님."
  },
  "88": {
   "jp": "4e7ba4f1",
   "kr": "어떤 요리가 나올지 기대되네요."
  },
  "89": {
   "jp": "bba63aae",
   "kr": "뭘 찾으십니까?"
  },
  "90": {
   "jp": "b2185526",
   "kr": "요리책은 없나요?"
  },
  "91": {
   "jp": "4313fa89",
   "kr": "아, 그거라면"
  },
  "92": {
   "jp": "2df0b350",
   "kr": "여기 한 권 있습니다."
  },
  "93": {
   "jp": "c88ad9f8",
   "kr": "여기는 안데라성 도서실입니다."
  },
  "94": {
   "jp": "091c15b6",
   "kr": "앰비쉬의 역사와 티라스일 각지에서"
  },
  "95": {
   "jp": "1a0bde85",
   "kr": "모은 책들이 소장되어 있습니다."
  },
  "96": {
   "jp": "b03d6b8c",
   "kr": "부디 마음껏 열람하십시오."
  },
  "97": {
   "jp": "7481150e",
   "kr": "음, 분명 이 근처에"
  },
  "98": {
   "jp": "ef427561",
   "kr": "있었던 것 같은데…"
  },
  "99": {
   "jp": "a8666bbf",
   "kr": "오, 여기 있군요."
  },
  "100": {
   "jp": "3df5397a",
   "kr": "네, 이겁니다."
  },
  "101": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "102": {
   "jp": "b56c0efc",
   "kr": "다시 한 번 읽겠습니까?"
  },
  "103": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "104": {
   "jp": "ece75050",
   "kr": "책은 여기 두겠사오니"
  },
  "105": {
   "jp": "dd0ce337",
   "kr": "마음껏 열람하십시오."
  },
  "106": {
   "jp": "2d266f00",
   "kr": "책등에는 『즐거운 요리』라고 적혀 있다."
  },
  "107": {
   "jp": "5de18d79",
   "kr": "쥬리오는 페이지를 펼쳤다."
  },
  "108": {
   "jp": "95b9a5d3",
   "kr": "기본 재료 10가지"
  },
  "109": {
   "jp": "f43c8089",
   "kr": "토마토 퓌레. 양파. 당근. 셀러리."
  },
  "110": {
   "jp": "f8269bdf",
   "kr": "감자. 적포도주. 마늘. 올리브유."
  },
  "111": {
   "jp": "f61b3a94",
   "kr": "향신료. 암염."
  },
  "112": {
   "jp": "530b504d",
   "kr": "이 재료만으로도 토마토스튜가 됩니다."
  },
  "113": {
   "jp": "8f67f03a",
   "kr": "하지만 요리를 더 즐기고 싶은 분은 이"
  },
  "114": {
   "jp": "e5445272",
   "kr": "기본 재료에 몇 가지 재료를 더해서 한 단계"
  },
  "115": {
   "jp": "cf46be83",
   "kr": "위의 요리에 도전해 보세요."
  },
  "116": {
   "jp": "5af1528c",
   "kr": "기본 재료＋쇠고기로 『비프 토마토스튜』나"
  },
  "117": {
   "jp": "bd5b7584",
   "kr": "『쇠고기 적포도주 조림』이 됩니다."
  },
  "118": {
   "jp": "97801ba1",
   "kr": "기본 재료＋비트(붉은 순무)＋양배추＋사워"
  },
  "119": {
   "jp": "aa3462eb",
   "kr": "크림으로 『보르시치』가 됩니다."
  },
  "120": {
   "jp": "32ab4719",
   "kr": "기본 재료＋쇠고기＋데미글라스 소스＋적포도주로"
  },
  "121": {
   "jp": "0464f54e",
   "kr": "『비프스튜』가 됩니다."
  },
  "122": {
   "jp": "1d96a7b6",
   "kr": "기본 재료＋사프란＋생선과 조개로 『부야베스』"
  },
  "123": {
   "jp": "c2ab4054",
   "kr": "가 됩니다."
  },
  "124": {
   "jp": "ef8eb51f",
   "kr": "기본 재료＋쇠고기＋카레 스파이스＋코코넛 밀크"
  },
  "125": {
   "jp": "87a2fc03",
   "kr": "＋요구르트로 『비프 카레』가 됩니다."
  },
  "126": {
   "jp": "8b031196",
   "kr": "쇠고기 대신 해산물을 쓰시면 아주"
  },
  "127": {
   "jp": "4ab62eab",
   "kr": "맛있는 『시푸드 카레』도 됩니다."
  },
  "128": {
   "jp": "600414d2",
   "kr": "이제 당신도 요리 명인."
  },
  "129": {
   "jp": "441fdab4",
   "kr": "훌륭한 맛의 하모니를"
  },
  "130": {
   "jp": "2c6bf784",
   "kr": "부디 맛보십시오."
  },
  "131": {
   "jp": "ab94597a",
   "kr": "앰비쉬성 조리고문 죠르노 그루메"
  },
  "132": {
   "jp": "eddd666e",
   "kr": "책등에 『안데라 호수』라고 적힌 책이 있다."
  },
  "133": {
   "jp": "db11b8e0",
   "kr": "쥬리오는 그 책을 집어 들어 펼쳐 보았다."
  },
  "134": {
   "jp": "9e00a194",
   "kr": "안데라 호수는 이 땅의 창세 전승에 따르면"
  },
  "135": {
   "jp": "88d3ba39",
   "kr": "산맥만 한 큰 뱀과 싸운 거인의 발자국이라"
  },
  "136": {
   "jp": "16b69357",
   "kr": "한다. 큰 뱀을 이긴 거인은 그 큰 뱀을"
  },
  "137": {
   "jp": "74d0103b",
   "kr": "한 번 어깨에 메고 승리의 함성을 올렸다."
  },
  "138": {
   "jp": "12b1ef18",
   "kr": "호수는 그때의 무게 때문에 생겨났다고"
  },
  "139": {
   "jp": "5f305f6b",
   "kr": "한다. 거인은 앰비쉬 남쪽 국경을"
  },
  "140": {
   "jp": "423e02e4",
   "kr": "따라 큰 뱀을 눕혔다. 그것이 앰비쉬의"
  },
  "141": {
   "jp": "67e5e39e",
   "kr": "대산맥이 되었다."
  },
  "142": {
   "jp": "b27cfc81",
   "kr": "거인의 발자국에는 물이 고여 푸르게 맑은"
  },
  "143": {
   "jp": "47286f9d",
   "kr": "아름다운 호수가 되었다."
  },
  "144": {
   "jp": "1998305e",
   "kr": "책등에 『하얀마녀의 말』이라고\n적힌 책이 있다."
  },
  "145": {
   "jp": "db11b8e0",
   "kr": "쥬리오는 그 책을 집어 들어 펼쳐 보았다."
  },
  "146": {
   "jp": "ac47da45",
   "kr": "그녀의 이름은 게르드. 티라스일을 걸으며"
  },
  "147": {
   "jp": "65bd5bc7",
   "kr": "불길한 말을 남기고 사라졌다. 아직 스무"
  },
  "148": {
   "jp": "8931dcc2",
   "kr": "살도 안 된 처녀는 백은빛 머리 탓에 어느새"
  },
  "149": {
   "jp": "46bf2c75",
   "kr": "사람들 사이에서 하얀마녀로 불리게 되었다."
  },
  "150": {
   "jp": "1a4a2a94",
   "kr": "『재앙의 산이 바다에서 나와 도읍을 부순다』"
  },
  "151": {
   "jp": "b05daa72",
   "kr": "메나트 동해안에서 앰비쉬 전역에 남은"
  },
  "152": {
   "jp": "69a0f202",
   "kr": "게르드의 말이다. 학자들은 바다에서 나타나는"
  },
  "153": {
   "jp": "2bfdd81b",
   "kr": "산을 지진으로 생긴 새 섬이라 해석한다."
  },
  "154": {
   "jp": "6bdbda59",
   "kr": "『대지가 결실을 잊을 때 산은 바다를 넘어"
  },
  "155": {
   "jp": "28c5b0b7",
   "kr": "사람들의 탄식이 메아리친다.』 거의 메나트"
  },
  "156": {
   "jp": "c18b3ba2",
   "kr": "전역에 남은 말. 여기서도 산이 화근이나"
  },
  "157": {
   "jp": "2b706c53",
   "kr": "앞의 산과 달리 해석이 불가능하다."
  },
  "158": {
   "jp": "48ae4fc5",
   "kr": "한편 신비학자 중에는 이 말들을 다른"
  },
  "159": {
   "jp": "ddbb3870",
   "kr": "관점에서 해석하는 이도 있다. 두 말의"
  },
  "160": {
   "jp": "93a45a94",
   "kr": "산은 같고 거대 생물의 습격이라 본다."
  },
  "161": {
   "jp": "f6361ccd",
   "kr": "책등에 《요술사 겟페우스의 보물》이라고"
  },
  "162": {
   "jp": "0b5c632c",
   "kr": "적힌 책이 있다."
  },
  "163": {
   "jp": "2b32dbf8",
   "kr": "쥬리오는 손에 들고 책을 펼쳐 보았다."
  },
  "164": {
   "jp": "d6cb9b73",
   "kr": "《요술사 겟페우스의 보물》"
  },
  "165": {
   "jp": "16253682",
   "kr": "일찍이 대마도사 올테가와의 대결에서 진"
  },
  "166": {
   "jp": "f17ea3e9",
   "kr": "요술사 겟페우스. 그는 북쪽 빙산에 틀어박혀"
  },
  "167": {
   "jp": "2d0ae55f",
   "kr": "다시 올테가에게 도전하려고 수행을 쌓았다."
  },
  "168": {
   "jp": "17babc64",
   "kr": "겟페우스의 요술은 결코 사악하지 않았으나"
  },
  "169": {
   "jp": "bac7cf0d",
   "kr": "올테가를 이기는 것만이 목적인 기술은"
  },
  "170": {
   "jp": "78356749",
   "kr": "뜻이 없고 공명심만 앞서 아무리 수행해도"
  },
  "171": {
   "jp": "819c55d7",
   "kr": "다듬어지지 못했다."
  },
  "172": {
   "jp": "9565c1ef",
   "kr": "어느 날 겟페우스에게 악마가 속삭였다."
  },
  "173": {
   "jp": "06e0b3c7",
   "kr": "악마는 힘을 주는 대신 올테가를 쓰러뜨리라"
  },
  "174": {
   "jp": "55b55a6c",
   "kr": "겟페우스에게 명했다. 겟페우스는 그때에"
  },
  "175": {
   "jp": "2312eae2",
   "kr": "이르러서야 제 어리석음을 깨달았다."
  },
  "176": {
   "jp": "253c689c",
   "kr": "요술사 겟페우스와 대마도사 올테가는"
  },
  "177": {
   "jp": "6c23e908",
   "kr": "힘을 합쳐 악마를 물리쳤다. 둘 다 힘의"
  },
  "178": {
   "jp": "5d4c37aa",
   "kr": "거의 전부를 썼지만 우정은 남았다. 그러나"
  },
  "179": {
   "jp": "d31d1e26",
   "kr": "무엇과도 바꿀 수 없는 영원한 보물이 됐다."
  },
  "180": {
   "jp": "9c145bc8",
   "kr": "요술사 겟페우스는"
  },
  "181": {
   "jp": "4e31b906",
   "kr": "나쁜 녀석이 아니었구나."
  },
  "182": {
   "jp": "5b8d7982",
   "kr": "응?"
  },
  "183": {
   "jp": "90534653",
   "kr": "뭐라고?"
  },
  "184": {
   "jp": "a7506161",
   "kr": "크리스가 요리 콘테스트에?"
  },
  "185": {
   "jp": "e44dd3a4",
   "kr": "응, 그렇거든."
  },
  "186": {
   "jp": "b1d5fefe",
   "kr": "크리스는 요리를 할 줄 아나?"
  },
  "187": {
   "jp": "70354164",
   "kr": "……"
  },
  "188": {
   "jp": "70354164",
   "kr": "……"
  },
  "189": {
   "jp": "b456caea",
   "kr": "…그렇군."
  },
  "190": {
   "jp": "168f7341",
   "kr": "크리스 님이 요리 콘테스트에"
  },
  "191": {
   "jp": "2d7ed65e",
   "kr": "출전하시는 겁니까?"
  },
  "192": {
   "jp": "3d79cd97",
   "kr": "그것참, 기대되는군요."
  },
  "193": {
   "jp": "d860c852",
   "kr": "어휴, 무시무시하군."
  }
 }
}
