 "lines": {
  "0": {
   "jp": "b2086cc7",
   "kr": "테그라 탄광"
  },
  "1": {
   "jp": "b519a5d7",
   "kr": "지하 3층"
  },
  "2": {
   "jp": "fc3838e7",
   "kr": "광부 보리"
  },
  "3": {
   "jp": "7d38049f",
   "kr": "광부 테드"
  },
  "4": {
   "jp": "d564ff61",
   "kr": "광부 아일"
  },
  "5": {
   "jp": "749b58ec",
   "kr": "저기, 아저씨들!"
  },
  "6": {
   "jp": "ea47b87e",
   "kr": "진홍의 불꽃을 가져왔어요."
  },
  "7": {
   "jp": "23fac40a",
   "kr": "뒤로 물러나 있어요!"
  },
  "8": {
   "jp": "7e45862c",
   "kr": "오, 가져왔냐!"
  },
  "9": {
   "jp": "7effedf7",
   "kr": "지금 물러난다."
  },
  "10": {
   "jp": "af503c7f",
   "kr": "잠깐 기다려라."
  },
  "11": {
   "jp": "c7daaf9e",
   "kr": "준비됐다!"
  },
  "12": {
   "jp": "fc6da12c",
   "kr": "길을 벗어나지 마라!"
  },
  "13": {
   "jp": "ae8d081c",
   "kr": "네, 굴릴게요."
  },
  "14": {
   "jp": "98e30deb",
   "kr": "좋아, 굴려라아!"
  },
  "15": {
   "jp": "6d74307d",
   "kr": "간다, 크리스."
  },
  "16": {
   "jp": "7b7aa4dd",
   "kr": "좋아."
  },
  "17": {
   "jp": "f3b780af",
   "kr": "해냈다!"
  },
  "18": {
   "jp": "2b725a2e",
   "kr": "잘된 모양이야."
  },
  "19": {
   "jp": "f12be58d",
   "kr": "어〜이, 괜찮으냐!"
  },
  "20": {
   "jp": "a8ca277a",
   "kr": "고마워요, 살았어요."
  },
  "21": {
   "jp": "fc1c88f6",
   "kr": "잘돼서 다행이구나."
  },
  "22": {
   "jp": "35ce7958",
   "kr": "굉장한 폭발이었군."
  },
  "23": {
   "jp": "b4181b7f",
   "kr": "괜찮으냐?"
  },
  "24": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "25": {
   "jp": "0b5dc091",
   "kr": "자, 이제 너희 볼일은 끝났지?"
  },
  "26": {
   "jp": "e6146d13",
   "kr": "아무래도 가루가 탓에 지반이 느슨해져"
  },
  "27": {
   "jp": "8d0a1757",
   "kr": "버린 모양이니까."
  },
  "28": {
   "jp": "42ca303c",
   "kr": "또 무너지면 큰일이다."
  },
  "29": {
   "jp": "58cf24eb",
   "kr": "우리는 좀 이 근방을 둘러보고 돌아갈 테니"
  },
  "30": {
   "jp": "6860300a",
   "kr": "너희는 먼저 여기서 나가는 게 좋다."
  },
  "31": {
   "jp": "1aceea1f",
   "kr": "조심해서 돌아가라."
  },
  "32": {
   "jp": "6fa9cd39",
   "kr": "뭐야, 돌아간 게 아니었나?"
  },
  "33": {
   "jp": "02260ffe",
   "kr": "그게… 저기…"
  },
  "34": {
   "jp": "47812c7c",
   "kr": "말하기 어려운데요."
  },
  "35": {
   "jp": "e4e68d38",
   "kr": "뭐야 망설이지 말고 말해 봐라."
  },
  "36": {
   "jp": "ea540052",
   "kr": "저희 다 같이 생매장이 돼 버렸어요."
  },
  "37": {
   "jp": "98c9d979",
   "kr": "폭발 충격으로 다른 데가 묻혀 버렸어요."
  },
  "38": {
   "jp": "12ba87aa",
   "kr": "에엣!?"
  },
  "39": {
   "jp": "277e90fd",
   "kr": "뭐, 뭐라고오!"
  },
  "40": {
   "jp": "0d9c1f2a",
   "kr": "딴 데 새지 마라, 길 잃어."
  },
  "41": {
   "jp": "1aceea1f",
   "kr": "조심해서 돌아가라."
  },
  "42": {
   "jp": "172ee199",
   "kr": "다치지 않아 다행이구나."
  },
  "43": {
   "jp": "a173e1b1",
   "kr": "이럴 수가…"
  },
  "44": {
   "jp": "f8d34c13",
   "kr": "분명 우리가 폭발시킨 충격으로"
  },
  "45": {
   "jp": "b9e5ac19",
   "kr": "새로 무너진 거야…"
  },
  "46": {
   "jp": "edee87e0",
   "kr": "돌아가서 광부 아저씨들께 알리자."
  },
  "47": {
   "jp": "59403012",
   "kr": "광부 아저씨들까지"
  },
  "48": {
   "jp": "dd196ecc",
   "kr": "휘말린 모양이네."
  },
  "49": {
   "jp": "4c97c9ea",
   "kr": "무너진 돌과 바위로 통로가 막혀 있다!"
  },
  "50": {
   "jp": "113b92d8",
   "kr": "어〜이!"
  },
  "51": {
   "jp": "07c64aad",
   "kr": "테드, 아일, 큰일이다!"
  },
  "52": {
   "jp": "505ef813",
   "kr": "뭐야, 얼굴이 새파래져서."
  },
  "53": {
   "jp": "31ec677b",
   "kr": "무슨 일 있었나?"
  },
  "54": {
   "jp": "f1062e22",
   "kr": "출구가 묻혀 버렸다."
  },
  "55": {
   "jp": "63b65c36",
   "kr": "뭐라고오!?"
  },
  "56": {
   "jp": "6a451ad2",
   "kr": "광부 아일"
  },
  "57": {
   "jp": "055a9d84",
   "kr": "정말이냐?!"
  },
  "58": {
   "jp": "edca9801",
   "kr": "어쨌든 현장에 가 보자."
  },
  "59": {
   "jp": "6414aa75",
   "kr": "이거 심하군."
  },
  "60": {
   "jp": "04bbdeec",
   "kr": "정말로 전원 생매장이다."
  },
  "61": {
   "jp": "789c228b",
   "kr": "이래선 도저히 손댈 수 없다."
  },
  "62": {
   "jp": "d171de72",
   "kr": "그렇지! 폭발 충격으로 무너졌다면"
  },
  "63": {
   "jp": "655a7f1a",
   "kr": "새 샛구멍도 생겼을지 모른다."
  },
  "64": {
   "jp": "b924b2f5",
   "kr": "나눠서 찾아볼까."
  },
  "65": {
   "jp": "bd65d3ca",
   "kr": "멍하니 있는 것보단 낫다."
  },
  "66": {
   "jp": "3ca5c11c",
   "kr": "그렇군, 그럴까."
  }
 }
}