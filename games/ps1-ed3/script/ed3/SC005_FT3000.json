{
 "archive": "/SCE0/SC005.DAT",
 "member": "..\\DATA\\FT3000.BIN",
 "lines": {
  "0": {
   "jp": "c9fab11d",
   "kr": "매발톱호"
  },
  "1": {
   "jp": "a5ab341f",
   "kr": "톤쟈"
  },
  "2": {
   "jp": "87ed524e",
   "kr": "가톤"
  },
  "3": {
   "jp": "0f879f86",
   "kr": "보스레이"
  },
  "4": {
   "jp": "898074d7",
   "kr": "조리장"
  },
  "5": {
   "jp": "73e57527",
   "kr": "질버 선장"
  },
  "6": {
   "jp": "904150e9",
   "kr": "어이!"
  },
  "7": {
   "jp": "d3e5b83c",
   "kr": "선내는 여러 준비로 정신이 없단다."
  },
  "8": {
   "jp": "017a914c",
   "kr": "착한 애들이니 윗갑판에서만 좀 참아 다오."
  },
  "9": {
   "jp": "396ab5aa",
   "kr": "앗, 저 문을 열면 유령이 나온다!"
  },
  "10": {
   "jp": "138e7cb3",
   "kr": "…거짓말이죠?"
  },
  "11": {
   "jp": "c296aac7",
   "kr": "거짓말일 리가 있냐."
  },
  "12": {
   "jp": "3df0a0b8",
   "kr": "지금 그 유령을 퇴치하는 중이야."
  },
  "13": {
   "jp": "73399872",
   "kr": "안에 들어가는 건 좀 더 기다리는 게 좋아."
  },
  "14": {
   "jp": "49692eb7",
   "kr": "닐리에서 라그나까지의 항해도"
  },
  "15": {
   "jp": "bf76e082",
   "kr": "무사히 끝낼 수 있었다…"
  },
  "16": {
   "jp": "8aba3beb",
   "kr": "이번 승객은… 여섯 명이었나."
  },
  "17": {
   "jp": "f7233875",
   "kr": "짐은 이탄이 20통에, 말린 생선이…"
  },
  "18": {
   "jp": "da0f281a",
   "kr": "굉장히 바쁜가 봐."
  },
  "19": {
   "jp": "1adb35a3",
   "kr": "방해하면 안 되겠다."
  },
  "20": {
   "jp": "5845752b",
   "kr": "그래, 가자."
  },
  "21": {
   "jp": "6cb50b3c",
   "kr": "호오〜 순례 여행으로?"
  },
  "22": {
   "jp": "24d776d8",
   "kr": "닐리에 닿을 때까지는 내 자랑거리 요리를"
  },
  "23": {
   "jp": "6ac2aa7d",
   "kr": "실컷 먹여 주마."
  },
  "24": {
   "jp": "389f04de",
   "kr": "배에 흔들리며 먹는 식사는"
  },
  "25": {
   "jp": "5de687bf",
   "kr": "또 각별하단다."
  },
  "26": {
   "jp": "5cbf43c0",
   "kr": "돛대를 마음대로 다루게 되면"
  },
  "27": {
   "jp": "f34d22f6",
   "kr": "한몫하는 뱃사람이라 할 수 있겠지."
  },
  "28": {
   "jp": "b03fa336",
   "kr": "저기, 이 배 메나트에 가죠?"
  },
  "29": {
   "jp": "d47d53a0",
   "kr": "그래, 그렇고말고."
  },
  "30": {
   "jp": "33808942",
   "kr": "닐리까지 직항편이다."
  },
  "31": {
   "jp": "d8ffd08b",
   "kr": "다행이다. 시간 맞춰서."
  },
  "32": {
   "jp": "068bb58e",
   "kr": "저희는 순례 중이거든요."
  },
  "33": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "34": {
   "jp": "24da5597",
   "kr": "오! 은단검 아닌가."
  },
  "35": {
   "jp": "35a6d328",
   "kr": "오랜만에 보는군."
  },
  "36": {
   "jp": "4fc78b7c",
   "kr": "그게 있으면 뱃삯은 공짜였을 텐데?"
  },
  "37": {
   "jp": "ab7efb1b",
   "kr": "다만"
  },
  "38": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "39": {
   "jp": "9a5d2bd3",
   "kr": "다만…?"
  },
  "40": {
   "jp": "c336a467",
   "kr": "남자는 선내 청소, 여자는 요리와 빨래."
  },
  "41": {
   "jp": "ce321b58",
   "kr": "땡땡이치면 상어 밥이다."
  },
  "42": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "43": {
   "jp": "e03c34cf",
   "kr": "에〜!"
  },
  "44": {
   "jp": "42a8c76c",
   "kr": "하하하. 농담, 농담."
  },
  "45": {
   "jp": "7d6037ad",
   "kr": "선장님께 소개할 테니 와라."
  },
  "46": {
   "jp": "108b3c86",
   "kr": "자자."
  },
  "47": {
   "jp": "87b018ef",
   "kr": "구경이라면 나중에 실컷 해라."
  },
  "48": {
   "jp": "ad1b3064",
   "kr": "나도 한가한 게 아니라고."
  },
  "49": {
   "jp": "e4441cc0",
   "kr": "질버 선장님, 잠깐 괜찮습니까?"
  },
  "50": {
   "jp": "3cb5ba6f",
   "kr": "귀한 손님입니다."
  },
  "51": {
   "jp": "7c72b222",
   "kr": "순례 여행자예요."
  },
  "52": {
   "jp": "ea5e69df",
   "kr": "뭐? 순례 여행자라고?"
  },
  "53": {
   "jp": "30ea3901",
   "kr": "그것 참 상서롭군."
  },
  "54": {
   "jp": "89e1bd0e",
   "kr": "어서 들여보내라."
  },
  "55": {
   "jp": "ff272b19",
   "kr": "그러니까"
  },
  "56": {
   "jp": "452ee933",
   "kr": "나중에 실컷 구경시켜 줄 테니까"
  },
  "57": {
   "jp": "d7560fb4",
   "kr": "따라오라고."
  },
  "58": {
   "jp": "c2619106",
   "kr": "(무, 무서운 얼굴…)"
  },
  "59": {
   "jp": "3a843b24",
   "kr": "처음 뵈어요, 질버 선장님."
  },
  "60": {
   "jp": "04511b09",
   "kr": "라그픽 마을의 크리스예요."
  },
  "61": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "62": {
   "jp": "0d6e3ff0",
   "kr": "쥬리오입니다."
  },
  "63": {
   "jp": "f9107c51",
   "kr": "매발톱호에 잘 왔다."
  },
  "64": {
   "jp": "fc9aeb43",
   "kr": "내가 선장 질버다."
  },
  "65": {
   "jp": "81b2c6c1",
   "kr": "순례 여행을 도울 수 있어"
  },
  "66": {
   "jp": "dd1c9474",
   "kr": "나도 기쁘구나."
  },
  "67": {
   "jp": "7bd35798",
   "kr": "자"
  },
  "68": {
   "jp": "fd1139fb",
   "kr": "선장님께 은단검을 보여 드려라."
  },
  "69": {
   "jp": "3b6cda79",
   "kr": "아, 네."
  },
  "70": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "71": {
   "jp": "c33954b1",
   "kr": "오오, 틀림없는 은단검이다."
  },
  "72": {
   "jp": "653c15a2",
   "kr": "순례 여행자를 태우다니"
  },
  "73": {
   "jp": "21de3fe3",
   "kr": "몇 년 만인지 모르겠군."
  },
  "74": {
   "jp": "5f0e3963",
   "kr": "이번 항해는 조짐이 좋구나."
  },
  "75": {
   "jp": "3b7594f2",
   "kr": "그런데 매발톱호의 좌우명을"
  },
  "76": {
   "jp": "1f10526b",
   "kr": "아느냐?"
  },
  "77": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "78": {
   "jp": "6df962ab",
   "kr": "…?"
  },
  "79": {
   "jp": "ebc0c882",
   "kr": "일하지 않는 자 먹지도 말라."
  },
  "80": {
   "jp": "d74d6654",
   "kr": "안됐지만 너희 둘은 본선의 손님이 아니다."
  },
  "81": {
   "jp": "9ecd84a2",
   "kr": "순례 여행자다."
  },
  "82": {
   "jp": "3ae99495",
   "kr": "쥬리오 군은 청소"
  },
  "83": {
   "jp": "8b8ed895",
   "kr": "크리스 양은 요리와 빨래를 맡아 주게."
  },
  "84": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "85": {
   "jp": "6271b5c2",
   "kr": "에〜엣!?"
  },
  "86": {
   "jp": "ea0db37f",
   "kr": "농담이 아니었어요?"
  },
  "87": {
   "jp": "660b3b9b",
   "kr": "하하하…"
  },
  "88": {
   "jp": "bab66318",
   "kr": "상어 밥이 된다는 건 농담이야."
  },
  "89": {
   "jp": "ad38b8d0",
   "kr": "아무튼 선실로 안내하마."
  },
  "90": {
   "jp": "c9f1538b",
   "kr": "자, 따라와."
  },
  "91": {
   "jp": "07efc017",
   "kr": "아아, 쥬리오 군, 크리스 양."
  },
  "92": {
   "jp": "d0709da6",
   "kr": "너희는 닐리에 닿을 때까지는 선원 대우니까"
  },
  "93": {
   "jp": "e75240b3",
   "kr": "어디든 들어가도 상관없다."
  },
  "94": {
   "jp": "611f5a68",
   "kr": "뱃사람 기분을 만끽하려무나."
  }
 }
}
