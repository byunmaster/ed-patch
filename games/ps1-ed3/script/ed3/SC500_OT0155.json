{
 "archive": "/SCE5/SC500.DAT",
 "member": "..\\DATA\\OT0155.BIN",
 "lines": {
  "0": {
   "jp": "2a8d61a9",
   "kr": "마을 구역"
  },
  "1": {
   "jp": "48ae559f",
   "kr": "데프"
  },
  "2": {
   "jp": "40ed58f7",
   "kr": "챠펠의 슈라"
  },
  "3": {
   "jp": "cb2878b7",
   "kr": "올도스 신관"
  },
  "4": {
   "jp": "0da16b86",
   "kr": "이 마을에 사는 이들은"
  },
  "5": {
   "jp": "650dbf85",
   "kr": "모두 신관 자손이나 현자의"
  },
  "6": {
   "jp": "192df94f",
   "kr": "혈연인 사람이야."
  },
  "7": {
   "jp": "f689e07e",
   "kr": "나야 수행 같은 건 하나도 안 했지만"
  },
  "8": {
   "jp": "64b58e4f",
   "kr": "신관의 먼 친척이란 것만으로"
  },
  "9": {
   "jp": "c3e4f13e",
   "kr": "여기서 살게 해 주고 있다니까."
  },
  "10": {
   "jp": "a076f09c",
   "kr": "고마운 일이지."
  },
  "11": {
   "jp": "8d638ecb",
   "kr": "『마법에 기대는 자는 잘못을 저지른다.』"
  },
  "12": {
   "jp": "d13c3fce",
   "kr": "선선대 대신관님의 말씀이십니다."
  },
  "13": {
   "jp": "33ab0220",
   "kr": "『마법을 쓰는 자는 마음을 맑게 하라.』"
  },
  "14": {
   "jp": "23e4380f",
   "kr": "선대 대신관님의 말씀이십니다."
  },
  "15": {
   "jp": "5859f5be",
   "kr": "올도스 챠펠에 어서 오세요."
  },
  "16": {
   "jp": "dd09fa95",
   "kr": "어느 분이 원하시나요?"
  },
  "17": {
   "jp": "7a6ff74c",
   "kr": "어떤"
  },
  "18": {
   "jp": "c63fc7a2",
   "kr": "챠펠 마법을 내려 드릴까요?"
  },
  "19": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "20": {
   "jp": "86524ebe",
   "kr": "마음가짐도 잊지 마세요."
  },
  "21": {
   "jp": "bfd4ecc6",
   "kr": "오오, 여러분이시군요."
  },
  "22": {
   "jp": "feb0e78e",
   "kr": "여러분 참배는 끝났을 텐데요."
  },
  "23": {
   "jp": "cf37a9f2",
   "kr": "자, 새로운 목적을 향해"
  },
  "24": {
   "jp": "22e0f89f",
   "kr": "길을 떠나십시오."
  }
 }
}