  },
  "134": {
   "jp": "2d7f9b1e",
   "kr": "그럼 잘 있어, 인타."
  },
  "135": {
   "jp": "34732fee",
   "kr": "편지 기다릴게."
  },
  "136": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "137": {
   "jp": "70c682eb",
   "kr": "림 형아도 잘 있어."
