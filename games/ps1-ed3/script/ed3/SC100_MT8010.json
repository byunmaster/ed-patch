  },
  "2": {
   "jp": "5cc70478",
   "kr": "어부 토바이"
  },
  "3": {
   "jp": "b906c0a9",
   "kr": "닉"
  },
  "4": {
   "jp": "ce0fbc7a",
   "kr": "에메나"
  },
  "5": {
   "jp": "0adf5788",
   "kr": "인타"
  },
  "6": {
   "jp": "29df4152",
   "kr": "창고 비아노"
  },
  "7": {
   "jp": "220d46f1",
   "kr": "림"
  },
  "8": {
   "jp": "39e4191e",
   "kr": "토바이 씨, 정말 고마워요."
  },
  "9": {
   "jp": "01e190f3",
   "kr": "괜찮다니께."
  },
  "10": {
   "jp": "9ff657d6",
   "kr": "고마워요, 토바이 씨."
  },
  "11": {
   "jp": "5eb21f70",
   "kr": "근디 너희들."
  },
  "12": {
   "jp": "1cf792c1",
   "kr": "섬에서 돌아올 땐"
  },
  "13": {
   "jp": "e00bf6c2",
   "kr": "어쩔 셈이여?"
  },
  "14": {
   "jp": "f5411557",
   "kr": "이 섬이 가루가한테 습격당할 일이"
  },
  "15": {
   "jp": "e7e67264",
   "kr": "없었으면 그대로 두고 갈 참이었는디,"
  },
  "16": {
   "jp": "d6aaf8b0",
   "kr": "이런 판엔 돌아갈 배 구하기도 힘들 것이여."
  },
  "17": {
   "jp": "0a8354bc",
   "kr": "그러고 보니, 그렇네요."
  },
  "18": {
   "jp": "c1d1d655",
   "kr": "어쩌지…"
  },
  "19": {
   "jp": "91b9e460",
   "kr": "할 수 없제."
  },
  "20": {
   "jp": "bf3c11e9",
   "kr": "이왕 시작한 일이여."
  },
  "21": {
   "jp": "213336ad",
   "kr": "여기서 기다려 주겄어."
  },
  "22": {
   "jp": "e16aa29b",
   "kr": "어차피 이틀쯤이면 볼일은 끝나겄제."
  },
  "23": {
   "jp": "a2054728",
   "kr": "네, 테그라 샤리네에 갈 뿐이니까"
  },
  "24": {
   "jp": "16512df4",
   "kr": "그쯤이면 돌아올 수 있어요."
  },
  "25": {
   "jp": "596c4b12",
   "kr": "좋아, 정해졌구먼."
  },
  "26": {
   "jp": "2b8f5748",
   "kr": "그럼, 다녀오더라고."
  },
  "27": {
   "jp": "5681b02e",
   "kr": "조심하고."
  },
  "28": {
   "jp": "eb995225",
   "kr": "네, 토바이 씨."
  },
  "29": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "30": {
   "jp": "9b4ed81b",
   "kr": "그럼 또 봐요, 토바이 씨."
  },
  "31": {
   "jp": "42359a62",
   "kr": "오, 이제 됐냐?"
  },
  "32": {
   "jp": "64e369ee",
   "kr": "언제든 출항할 수 있어야."
  },
  "33": {
   "jp": "bc40152c",
   "kr": "저기, 토바이 씨."
  },
  "34": {
   "jp": "18fdd509",
   "kr": "실은 또 태워 달라는 사람이 있는데,"
  },
  "35": {
   "jp": "c576b0aa",
   "kr": "괜찮을까요?"
  },
  "36": {
   "jp": "fd4e4dac",
   "kr": "아, 인타네겠구먼."
  },
  "37": {
   "jp": "81798b7f",
   "kr": "나는 상관없어야."
  },
  "38": {
   "jp": "847cd25d",
   "kr": "가는 김에 태워 주제."
  },
  "39": {
   "jp": "3f0bd5fd",
   "kr": "데려오더라고."
  },
  "40": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "41": {
   "jp": "56ee86a4",
   "kr": "됐으니까 얼른 가서"
  },
  "42": {
   "jp": "1c2c3fad",
   "kr": "볼일을 마치고 오더라고."
  },
  "43": {
   "jp": "a277d899",
   "kr": "오, 볼일은 끝났냐?"
  },
  "44": {
   "jp": "009bb004",
   "kr": "그게요, 토바이 씨."
  },
  "45": {
   "jp": "7083782a",
   "kr": "미안해요."
  },
  "46": {
   "jp": "dcb3e664",
   "kr": "조금 더 걸릴 것 같아요."
  },
  "47": {
   "jp": "450210bc",
   "kr": "그려. 아직 괜찮여."
  },
  "48": {
   "jp": "1e9cfb71",
   "kr": "서두르지 않아도 되야."
  },
  "49": {
   "jp": "f02cad43",
   "kr": "나는 여기서 기다릴 텡께."
  },
  "50": {
   "jp": "9b4f7232",
   "kr": "아직 이삼 일은"
  },
  "51": {
   "jp": "76cc0810",
   "kr": "유빙으로 바다가 메워질 일도"
  },
  "52": {
   "jp": "aacad5c9",
   "kr": "없을 것이여."
  },
  "53": {
   "jp": "7dc49a2f",
   "kr": "기다려 줄 텡께"
  },
  "54": {
   "jp": "09cd91a8",
   "kr": "안심혀."
  },
  "55": {
   "jp": "4b42b812",
   "kr": "테그라 남자가 서쪽 바다를 바라보며,"
  },
  "56": {
   "jp": "fbe8b8e0",
   "kr": "뭔가 중얼중얼 혼잣말을 하고 있다."
  },
  "57": {
   "jp": "30cf7d03",
   "kr": "로디 녀석 얼굴색이 확 변해서 뛰쳐나갔어."
  },
  "58": {
   "jp": "5e912f96",
   "kr": "혼자서 가루가를 쓰러뜨리겠다니 무모해."
  },
  "59": {
   "jp": "7177a826",
   "kr": "게다가 그런 작은 배로 노 저어 나가다니…"
  },
  "60": {
   "jp": "895a94b7",
   "kr": "로디 녀석…"
  },
  "61": {
   "jp": "05de58f4",
   "kr": "혼자서 어쩌려는 거야…"
  },
  "62": {
   "jp": "b35f380c",
   "kr": "저기, 저 선창 쪽 배에"
  },
  "63": {
   "jp": "c664d495",
   "kr": "태워 주는 거야?"
  },
  "64": {
   "jp": "e794c58d",
   "kr": "나, 빨리 타고 싶어."
  },
  "65": {
   "jp": "98ccfa44",
   "kr": "림 형아도 데려왔으면"
  },
  "66": {
   "jp": "a8fd6aee",
   "kr": "좋았을 텐데…"
  },
  "67": {
   "jp": "bddceb2a",
   "kr": "준비는 되셨죠?"
  },
  "68": {
   "jp": "c50c9975",
   "kr": "네, 잘 부탁드립니다."
  },
  "69": {
   "jp": "97b98a45",
   "kr": "비아노 씨"
  },
  "70": {
   "jp": "9b70dedd",
   "kr": "신세 많이 졌습니다."
  },
  "71": {
   "jp": "34f84163",
   "kr": "신세는 이쪽이 졌지."
  },
  "72": {
   "jp": "3caaa357",
   "kr": "조심해서 가라고."
  },
  "73": {
   "jp": "eff3474b",
   "kr": "걱정 안 해도 모두한테는 잘 말해 둘 테니."
  },
  "74": {
   "jp": "1f1726dd",
   "kr": "잘 들어. 이 네갈섬은 네 섬이야."
  },
  "75": {
   "jp": "52e0e499",
   "kr": "괴로운 일이 있거든 언제든 돌아오렴."
  },
  "76": {
   "jp": "39f776e8",
   "kr": "고마워요, 비아노 씨."
  },
  "77": {
   "jp": "d12d2730",
   "kr": "자리 잡거든 편지를 다오."
  },
  "78": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "79": {
   "jp": "e670945a",
   "kr": "저기, 얼른 배 타자."
  },
  "80": {
   "jp": "f4fcc04e",
   "kr": "그럼, 갈까요?"
  },
  "81": {
   "jp": "88149875",
   "kr": "네."
  },
  "82": {
   "jp": "541c48d7",
   "kr": "어〜이, 인타아!"
