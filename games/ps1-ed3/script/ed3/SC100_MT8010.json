  "88": {
   "jp": "3e68e1ac",
   "kr": "인타."
  },
  "89": {
   "jp": "5987ea29",
   "kr": "너, 이런 데서"
  },
  "90": {
   "jp": "dca5821c",
   "kr": "뭐 하는 거야?"
  },
  "91": {
   "jp": "891f1078",
