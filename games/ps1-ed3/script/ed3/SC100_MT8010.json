  "83": {
   "jp": "35386b9e",
   "kr": "앗?!"
  },
  "84": {
   "jp": "59affa0f",
   "kr": "림 형아 목소리다!"
  },
  "85": {
   "jp": "2328572f",
   "kr": "역시 있었네. 마을에 없어서,"
  },
  "86": {
   "jp": "5706e99b",
   "kr": "혹시 항구에 있나 싶어서"
  },
  "87": {
   "jp": "9b755494",
   "kr": "와 봤어."
