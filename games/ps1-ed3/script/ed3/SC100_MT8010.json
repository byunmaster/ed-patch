  },
  "147": {
   "jp": "64fe6b28",
   "kr": "빠이, 빠〜이!"
  },
  "148": {
   "jp": "89701234",
   "kr": "잘 지내라!"
  },
  "149": {
   "jp": "5681b02e",
   "kr": "조심해서 가."
