  "0": {
   "jp": "990eaece",
   "kr": "수정호"
  },
  "1": {
   "jp": "c3b33230",
   "kr": "구름다리"
  },
  "2": {
   "jp": "12746fb3",
   "kr": "이린"
  },
  "3": {
   "jp": "1f8cb41a",
   "kr": "아까까진 다리가 무너졌었는데"
  },
  "4": {
   "jp": "5c4c2509",
   "kr": "이제 지나갈 수 있어."
  },
  "5": {
   "jp": "c02e8180",
   "kr": "정말요?"
  },
  "6": {
   "jp": "18808c36",
   "kr": "전혀 몰랐어요."
  },
  "7": {
   "jp": "391d7d83",
   "kr": "보아하니, 순례하는 여행자구나?"
  },
  "8": {
   "jp": "b2bf1bad",
   "kr": "네. 라그픽 마을에서 왔어요."
  },
  "9": {
   "jp": "e98f9092",
   "kr": "아직 갈 길이 멀어."
  },
  "10": {
   "jp": "7ebf9fd9",
   "kr": "천천히 착실하게 나아가렴."
  },
  "11": {
   "jp": "f03aff64",
   "kr": "병사분들 덕분에"
  },
  "12": {
   "jp": "4a66ac7c",
   "kr": "다리가 원래대로 돌아왔단다."
  },
  "13": {
   "jp": "ba76fe68",
   "kr": "안심하고 지나가렴."
  },
  "14": {
   "jp": "2861d4b8",
   "kr": "슬슬 난 샤리네로 돌아갈게."
  },
  "15": {
   "jp": "fe9225e6",
   "kr": "너희도 건강하게 여행 잘하렴."
  }
 }
}