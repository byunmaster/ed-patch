  },
  "10": {
   "jp": "50f48696",
   "kr": "무기상 아트레이"
  },
  "11": {
   "jp": "c85577b2",
   "kr": "사리바 부인"
  },
  "12": {
   "jp": "1a6d1c0e",
   "kr": "고다르"
  },
  "13": {
   "jp": "e1350854",
   "kr": "여주인 쥬리아"
  },
  "14": {
   "jp": "3043c501",
   "kr": "챠펠의 린트"
  },
  "15": {
   "jp": "62bce60f",
   "kr": "모니트"
  },
  "16": {
   "jp": "76bc778a",
   "kr": "칼로"
  },
  "17": {
   "jp": "17afc102",
   "kr": "메이비"
  },
  "18": {
   "jp": "a29817e0",
   "kr": "테일"
  },
  "19": {
   "jp": "d1028327",
   "kr": "노바 할머니"
  },
  "20": {
   "jp": "67cdf700",
   "kr": "네이플"
  },
  "21": {
   "jp": "cb2c1ab8",
   "kr": "카피"
  },
  "22": {
   "jp": "0ef2f15f",
   "kr": "어라, 여행자시군요."
  },
  "23": {
   "jp": "63f6c8d4",
   "kr": "정말 큰일이"
  },
  "24": {
   "jp": "24b8fa57",
   "kr": "나 버렸습니다."
  },
  "25": {
   "jp": "cabbb134",
   "kr": "가루가 녀석도 하필이면"
  },
  "26": {
   "jp": "1733f83d",
   "kr": "메나트의 수도를 박살 내고"
  },
  "27": {
   "jp": "86d09000",
   "kr": "갈 것까진 없었을 텐데…"
  },
  "28": {
   "jp": "e5857898",
   "kr": "이런…"
  },
  "29": {
   "jp": "bd55588a",
   "kr": "안됐지만 이 집은 이제"
  },
  "30": {
   "jp": "a613c96f",
   "kr": "새로 짓는 편이 빠르겠어."
  },
  "31": {
   "jp": "8e80776b",
   "kr": "아무래도 반데 씨는"
  },
  "32": {
   "jp": "bf0cb4f2",
   "kr": "충격이 컸던 모양이야."
  },
  "33": {
   "jp": "720cbfb1",
   "kr": "집이 무너지고 나서 줄곧"
  },
  "34": {
   "jp": "fb5b3246",
   "kr": "저러고 서 있기만 해."
  },
  "35": {
   "jp": "1d9040c0",
   "kr": "넬바 집들 태반이 이 꼴이야."
  },
  "36": {
   "jp": "7fec78ee",
   "kr": "이 가게 무기는 넬바성에서도 쓰는"
  },
  "37": {
   "jp": "49f15e30",
   "kr": "뛰어난 물건뿐이야."
  },
  "38": {
   "jp": "29f448cb",
   "kr": "하지만 상대가 나빴지."
  },
  "39": {
   "jp": "4bc5f0fe",
   "kr": "우리 병사가 떼로 덤벼도"
  },
  "40": {
   "jp": "745d59a9",
   "kr": "가루가한텐 아무것도 못 했어."
  },
  "41": {
   "jp": "fe4c0d79",
   "kr": "아무리 넬바 병사라도"
  },
  "42": {
   "jp": "aeff9d1d",
   "kr": "괴수 퇴치 훈련은 안 받았거든."
  },
  "43": {
   "jp": "580e4dbf",
   "kr": "어쩔 도리가 없었어."
  },
  "44": {
   "jp": "6dc3e9a1",
   "kr": "실은 약초를 사러 왔어."
  },
  "45": {
   "jp": "388be9c0",
   "kr": "우리 넬바 병사들도 가루가의 습격 때문에"
  },
  "46": {
   "jp": "51ce6a4a",
   "kr": "다친 사람이 많아서 말이야."
  },
  "47": {
   "jp": "6f5932eb",
   "kr": "쥬리아 가게에 약초가"
  },
  "48": {
   "jp": "31c005d4",
   "kr": "많이 있어서 살았어."
  },
  "49": {
   "jp": "baa54f45",
   "kr": "그럼."
  },
  "50": {
   "jp": "65af0477",
   "kr": "심하지?"
  },
  "51": {
   "jp": "ca06678d",
   "kr": "바닷물이 들어와서 물바다야."
  },
  "52": {
   "jp": "b7b38f7a",
   "kr": "차라리 항구 마을로 다시 짓는 편이"
  },
  "53": {
   "jp": "0c4e645b",
   "kr": "나을지도 모르겠어."
  },
  "54": {
   "jp": "e8733f21",
   "kr": "자, 어디서부터 손을 대야 하나."
  },
  "55": {
   "jp": "29466e4c",
   "kr": "이 피해를 보고 있으면"
  },
  "56": {
   "jp": "9919a60f",
   "kr": "솔직히 말해 넋이 나가 버려."
  },
  "57": {
   "jp": "06f6c5e8",
   "kr": "병사 아저씨들도 힘들겠네."
  },
  "58": {
   "jp": "ffc491e0",
   "kr": "으〜음."
  },
  "59": {
   "jp": "1221f8d1",
   "kr": "그렇네."
  },
  "60": {
   "jp": "1d93c495",
   "kr": "아무리 나라를 지키기 위해서라도"
  },
  "61": {
   "jp": "28d268e7",
   "kr": "가루가 같은 게 상대면 안됐어."
  },
  "62": {
   "jp": "c48f5402",
   "kr": "이길 수 있을 리 없잖아."
  },
  "63": {
   "jp": "afc9f076",
   "kr": "참, 네갈섬 케빈 할아버지"
  },
  "64": {
   "jp": "2478f169",
   "kr": "댁의 로디 씨는"
  },
  "65": {
   "jp": "c845bb24",
   "kr": "가루가를 만났을까?"
  },
  "66": {
   "jp": "0ece65b3",
   "kr": "이 상황이면"
  },
  "67": {
   "jp": "3d7b81b5",
   "kr": "넬바에선 못 만난 모양이네."
  },
  "68": {
   "jp": "cec2d64a",
   "kr": "거리 소문에도 안 나오니까."
  },
  "69": {
   "jp": "88907eaf",
   "kr": "그 로디 씨라는 분은"
  },
  "70": {
   "jp": "8e4aaf2f",
   "kr": "어떤 분이신가?"
  },
  "71": {
   "jp": "24d615d5",
   "kr": "옛날에 가루가 때문에"
  },
  "72": {
   "jp": "585d3287",
   "kr": "부모님을"
  },
  "73": {
   "jp": "1066b385",
   "kr": "바다에서 잃었대."
  },
  "74": {
   "jp": "9dc4fae6",
   "kr": "그 뒤로 가루가를 쓰러뜨리겠다며"
  },
  "75": {
   "jp": "fb27c839",
   "kr": "검술을 닦으면서 가루가를 쫓아"
  },
  "76": {
   "jp": "f35816c4",
   "kr": "여행하고 있대."
  },
  "77": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "78": {
   "jp": "82201324",
   "kr": "그런 분도 있구먼."
  },
  "79": {
   "jp": "453e8205",
   "kr": "그 복수가 성공하면 좋겠다만…"
  },
  "80": {
   "jp": "7ab180d2",
   "kr": "과연 인간이 가루가를"
  },
  "81": {
   "jp": "b6409eb1",
   "kr": "이길 수 있을는지…"
  },
  "82": {
   "jp": "34fd1477",
   "kr": "무슨 일이야, 알프 씨."
  },
  "83": {
   "jp": "ac9841ff",
   "kr": "묘하게 생각에 잠겨서?"
  },
  "84": {
   "jp": "9b34b71e",
   "kr": "아니, 이 피해를 새삼"
  },
  "85": {
   "jp": "9f6ffec5",
   "kr": "눈앞에서 보니"
  },
  "86": {
   "jp": "e41a56b2",
   "kr": "어떻게든 해야겠다 싶었을 뿐일세."
  },
  "87": {
   "jp": "f80f3d0a",
   "kr": "끔찍하기도 하지."
  },
  "88": {
   "jp": "e779b464",
   "kr": "어쩜 그리도 요란하게"
  },
  "89": {
   "jp": "bd3a33c2",
   "kr": "부수고 갔는지."
  },
  "90": {
   "jp": "ba97217e",
   "kr": "덕분에 이 마을도"
  },
  "91": {
   "jp": "b8c37af9",
   "kr": "태반이 바다에 잠겨 버렸어."
  },
  "92": {
   "jp": "a57f6d59",
   "kr": "대체 어떻게 되려나."
  },
  "93": {
   "jp": "b6ca28bd",
   "kr": "정말이지, 가루가는 밉살스러워!"
  },
  "94": {
   "jp": "0fa72ec9",
   "kr": "엄청 굉장했어."
  },
  "95": {
   "jp": "e2af8fef",
   "kr": "있잖아, 믿어져?"
  },
  "96": {
   "jp": "eec6a08c",
   "kr": "이〜만큼 커다란 괴수였다니까!"
  },
  "97": {
   "jp": "a1ff992a",
   "kr": "넬바성 같은 건"
  },
  "98": {
   "jp": "b08e26d7",
   "kr": "순식간에 부서져 버렸어."
  },
  "99": {
   "jp": "4a3f39dc",
   "kr": "정말 굉장했다니까."
  },
  "100": {
   "jp": "119b9301",
   "kr": "그러고 보니…"
  },
  "101": {
   "jp": "f4297ef7",
   "kr": "노르딕 왕은 어디로 간 걸까?"
  },
  "102": {
   "jp": "59e40bbb",
   "kr": "설마… 당해 버린 건 아니겠지."
  },
  "103": {
   "jp": "12aed191",
   "kr": "아아아…"
  },
  "104": {
   "jp": "45360704",
   "kr": "내 집이…"
  },
  "105": {
   "jp": "0fe46a15",
   "kr": "아아… 이럴 수가…"
  },
  "106": {
   "jp": "189ee770",
   "kr": "해수 가루가가 지나간 것만으로"
  },
  "107": {
   "jp": "06310699",
   "kr": "성은 흔적도 없이 사라졌다."
  },
  "108": {
   "jp": "9fa2b5f1",
   "kr": "무서운 일이다."
  },
  "109": {
   "jp": "215eba43",
   "kr": "이렇게 마을이 당한 중에"
  },
  "110": {
   "jp": "290c1633",
   "kr": "우리 집이 무사한 건"
  },
  "111": {
   "jp": "e25e1a62",
   "kr": "정말 기적적인 일이라고 생각해요."
  },
  "112": {
   "jp": "e0f7379c",
   "kr": "피해를 입은 메나트 사람들을 위해"
  },
  "113": {
   "jp": "db5e7f42",
   "kr": "우리 집을 개방하려고 해요."
  },
  "114": {
   "jp": "d8d0afe9",
   "kr": "어때요, 좋은 생각이죠?"
  },
  "115": {
   "jp": "1d0be0db",
   "kr": "병사님들은"
  },
  "116": {
   "jp": "e09044f9",
   "kr": "여관에 임시 사령부를 설치하고"
  },
  "117": {
   "jp": "40952d9c",
   "kr": "복구 작업을 시작했어요."
  },
  "118": {
   "jp": "826b37e0",
   "kr": "성은 가루가한테 당해 버렸지만"
  },
  "119": {
   "jp": "7d79a00b",
   "kr": "넬바의 여관은 메나트에서 가장 커서"
  },
  "120": {
   "jp": "5e65a459",
   "kr": "사령부로는 안성맞춤이에요."
  },
  "121": {
   "jp": "e17f9ab8",
   "kr": "그건 그렇고 가루가가 뭍에 올라"
  },
  "122": {
   "jp": "5b3a1be2",
   "kr": "오다니… 더 나쁜 일이 일어날 전조"
  },
  "123": {
   "jp": "bd2e8511",
   "kr": "가 아니면 좋겠는데…"
  },
  "124": {
   "jp": "22ac29b2",
   "kr": "20년쯤 전이었지."
  },
  "125": {
   "jp": "f903531a",
   "kr": "이런 일이 일어날 거라고"
  },
  "126": {
   "jp": "28dd12ca",
   "kr": "누군가 말했던 것 같구먼."
  },
  "127": {
   "jp": "e7c88589",
   "kr": "그래… 아직 나이 어린 처자였지."
  },
  "128": {
   "jp": "11dd8a24",
   "kr": "자네들 같은, 여행하는 처자였네."
  },
  "129": {
   "jp": "8b992b1a",
   "kr": "그 처자는 분명히 말했었지…"
  },
  "130": {
   "jp": "48342b93",
   "kr": "그때 마을에선 금세 소문이 났고"
  },
  "131": {
   "jp": "99e17a2f",
   "kr": "노르딕 왕의 귀에도 들어갔을 게야."
  },
  "132": {
   "jp": "a5b0fe57",
   "kr": "…역시 소문은 소문으로 그칠 뿐인가."
  },
  "133": {
   "jp": "666588c8",
   "kr": "허나 허망한 일이지."
  },
  "134": {
   "jp": "03afb490",
   "kr": "그 처자가 모처럼 한 예언을"
  },
  "135": {
   "jp": "8ad4bea9",
   "kr": "헛되이 하다니 말이야."
  },
  "136": {
   "jp": "07168109",
   "kr": "그 처자를 생각하면 가슴이 아프구먼."
  },
  "137": {
   "jp": "75a9e130",
   "kr": "나 가루가 같은 거"
  },
  "138": {
   "jp": "2847af3d",
   "kr": "하나도 안 무서웠어."
  },
  "139": {
   "jp": "5add8e89",
   "kr": "왜냐면 주문을 알고 있는걸."
  },
  "140": {
   "jp": "5f489190",
   "kr": "내 주문"
  },
  "141": {
   "jp": "75289ac2",
   "kr": "가르쳐 줄까?"
  },
  "142": {
   "jp": "1ceee477",
   "kr": "에헤헤. 그럼 알려 줄게."
  },
  "143": {
   "jp": "429eb230",
   "kr": "내 주문은 말이야, 이렇게 세 번 외워."
  },
  "144": {
   "jp": "2986cdb8",
   "kr": "정령이여, 나그네 지키는 정령이여."
  },
  "145": {
   "jp": "92b5637b",
   "kr": "이 땅의 뜻있는 자들이여."
  },
  "146": {
   "jp": "4be92f8b",
   "kr": "함께 모여 지키소서."
  },
  "147": {
   "jp": "282e8e24",
   "kr": "할머니가 가르쳐 주셨어."
  },
  "148": {
   "jp": "7a14c66d",
   "kr": "이 마을에 순례로 들렀던"
  },
  "149": {
   "jp": "29f9f987",
   "kr": "마녀가 말했었대."
  },
  "150": {
   "jp": "b12a5ff4",
   "kr": "그래? 내 주문은"
  },
  "151": {
   "jp": "a172beb0",
   "kr": "아주 잘 듣는데."
  },
  "152": {
   "jp": "b2e68ec1",
   "kr": "그 주문 잊으면 안 돼."
  },
  "153": {
   "jp": "01ba182d",
   "kr": "그 가루가에 맞서려면"
  },
  "154": {
   "jp": "eceacf40",
   "kr": "지금까지 없던 무기가 필요해요."
  },
  "155": {
   "jp": "6d7e2c43",
   "kr": "마을은 심하게 부서져 버렸지만"
  },
  "156": {
   "jp": "3be93843",
   "kr": "돌아가신 분이 없었던 건"
  },
  "157": {
   "jp": "c56956f4",
   "kr": "불행 중 다행이었어요."
  },
  "158": {
   "jp": "983d9368",
   "kr": "사람만 무사하면"
  },
  "159": {
   "jp": "5bace92b",
   "kr": "마을은 금세 원래대로 돌아와요."
  },
  "160": {
   "jp": "f3ce90c1",
   "kr": "여어, 이 가게에서 무기를 사서"
  },
  "161": {
   "jp": "9318b4ec",
   "kr": "땅 고르는 데나 쓸까 해서 말이야."
  },
  "162": {
   "jp": "17c0d286",
   "kr": "마을이 부서진 충격은 크지만"
  },
  "163": {
   "jp": "ce31691c",
   "kr": "언제까지고 슬퍼하고만 있을 순 없으니까."
  },
  "164": {
   "jp": "1cfe1199",
   "kr": "챠펠은 이런 꼴입니다만"
  },
  "165": {
   "jp": "db3adaa4",
   "kr": "편히 쉬다 가십시오."
  },
  "166": {
   "jp": "805743d7",
   "kr": "이렇게 무서운 일을 겪은 건"
  },
  "167": {
   "jp": "d8ec7e81",
   "kr": "태어나서 처음이야."
  },
  "168": {
   "jp": "60ac330a",
   "kr": "세상엔 저런 짐승도 있구나."
  },
  "169": {
   "jp": "7173088a",
   "kr": "생각만 해도 떨려."
  },
  "170": {
   "jp": "f39e8075",
   "kr": "우리 집"
  },
  "171": {
   "jp": "1d776f51",
   "kr": "없어져 버렸어."
  },
  "172": {
   "jp": "d1b25631",
   "kr": "하지만 괜찮아."
  },
  "173": {
   "jp": "df248fb1",
   "kr": "여기서 묵게 해 준대."
  },
  "174": {
   "jp": "c0e96d14",
   "kr": "우리 집도 가루가한테 당해 버렸어."
  },
  "175": {
   "jp": "c8c468d6",
   "kr": "오늘은 여기서 묵게 해 줬어."
  },
  "176": {
   "jp": "95ebc3ba",
   "kr": "내일은 도구점 쥬리아 씨네에서"
  },
  "177": {
   "jp": "68feb21b",
   "kr": "묵게 해 달라고 해야지."
  },
  "178": {
   "jp": "8d22c1ff",
   "kr": "이런 참, 험한 꼴을 당했어."
  },
  "179": {
   "jp": "05e049fc",
   "kr": "저런 놈이 나오다니."
  },
  "180": {
   "jp": "ea514683",
   "kr": "집이 부서진 드리트 영감네는"
  },
  "181": {
   "jp": "2eefe3d9",
   "kr": "일단 치타로 달아난 모양이다만…"
  },
  "182": {
   "jp": "2136e04f",
   "kr": "그 나이에 괜찮으려나…"
  },
  "183": {
   "jp": "426380ac",
   "kr": "뭐, 이 넬바에서 달아난다면"
  },
  "184": {
   "jp": "e2cfe9ef",
   "kr": "치타나 튜엘이겠지만"
  },
  "185": {
   "jp": "13949e30",
   "kr": "나도 시골인 치타 쪽이 좋더구먼."
  },
  "186": {
   "jp": "5471805c",
   "kr": "이 소동이 가라앉으면"
  },
  "187": {
   "jp": "aac327bc",
   "kr": "나도 치타에 한번 가 볼까 싶구먼."
  },
  "188": {
   "jp": "6476ef15",
   "kr": "역시 말벗은 있어야지."
  },
  "189": {
   "jp": "9d7c7a17",
   "kr": "넬바는 메나트에서"
  },
  "190": {
   "jp": "26e39a5d",
   "kr": "제일 아름다운 마을이었는데 가루가의 습격으로"
  },
  "191": {
   "jp": "00123add",
   "kr": "엉망진창이 돼 버렸어."
  },
  "192": {
   "jp": "0313f488",
   "kr": "재난이란 정말 언제 찾아올지"
  },
  "193": {
   "jp": "e4f7829a",
   "kr": "알 수 없는 거네."
  },
  "194": {
   "jp": "6814cbe1",
   "kr": "젠장, 가루가 녀석…"
  },
  "195": {
   "jp": "06c49cd4",
   "kr": "우리 집도 당해 버렸어."
  },
  "196": {
   "jp": "1361d5ba",
   "kr": "근데 어째서"
  },
  "197": {
   "jp": "f037d661",
   "kr": "저런 놈이 갑자기 나온 걸까."
  },
  "198": {
   "jp": "bdd8a903",
   "kr": "이상하단 말이야…"
  },
  "199": {
   "jp": "eb9e4513",
   "kr": "이야, 어서 오세요. 여행자시군요."
  },
  "200": {
   "jp": "d88e9bbd",
   "kr": "아무리 우리 무기라도 가루가한텐"
  },
  "201": {
   "jp": "2cb21907",
   "kr": "당해 낼 수 없었지만 여행엔 도움이 됩니다."
  },
  "202": {
   "jp": "b7b50464",
   "kr": "뭐, 한번 보고 가세요."
  },
  "203": {
   "jp": "ba814f6a",
   "kr": "손님께 딱 맞는 게 있죠."
  },
  "204": {
   "jp": "da722eff",
   "kr": "입니다."
  },
  "205": {
   "jp": "0fe5b1e4",
   "kr": "네, 여기 있습니다."
  },
  "206": {
   "jp": "511c7bd7",
   "kr": "안 쓰는 건 기꺼이 사들이죠."
  },
  "207": {
   "jp": "7613dd8d",
   "kr": "뭐, 물자가 부족해서요."
  },
  "208": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "209": {
   "jp": "67afcad1",
   "kr": "에 사들이겠습니다."
  },
  "210": {
   "jp": "a53a5c21",
   "kr": "환율은 1 Goa가 14 Pia야."
  },
  "211": {
   "jp": "5896ee3a",
   "kr": "환율이 나쁘지만 양해해 줘."
  },
  "212": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "213": {
   "jp": "2094011a",
   "kr": "야."
  },
  "214": {
   "jp": "f90ebd6f",
   "kr": "라피카가 없으시네요."
  },
  "215": {
   "jp": "fd84f16a",
   "kr": "생기면 꼭 우리 가게로."
  },
  "216": {
   "jp": "bd08bfed",
   "kr": "그 밖에 무슨 볼일이신지요?"
  },
  "217": {
   "jp": "d85805c2",
   "kr": "언제든 들러 주세요."
  },
  "218": {
   "jp": "4f045262",
   "kr": "어서 오세요."
  },
  "219": {
   "jp": "45a70d36",
   "kr": "어떤 볼일이신가요?"
  },
  "220": {
   "jp": "c06b4a42",
   "kr": "물건이 그리 많지는 않습니다만…"
  },
  "221": {
   "jp": "ee93304e",
   "kr": "입니다."
  },
  "222": {
   "jp": "29162a7b",
   "kr": "감사합니다."
  },
  "223": {
   "jp": "d85c8bc8",
   "kr": "안 쓰시는 물건이 있으면"
  },
  "224": {
   "jp": "a75744e0",
   "kr": "사양 말고 주세요."
  },
  "225": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "226": {
   "jp": "e01da5f3",
   "kr": "에 사들입니다."
  },
  "227": {
   "jp": "7337e28c",
   "kr": "환율은 1 Goa가 14 Pia입니다."
  },
  "228": {
   "jp": "2798d283",
   "kr": "전부 "
  },
  "229": {
   "jp": "0f41ed9b",
   "kr": "을 치르겠습니다."
  },
  "230": {
   "jp": "e32b0c00",
   "kr": "라피카가 모이면"
  },
  "231": {
   "jp": "e536d2df",
   "kr": "또 들러 주세요."
  },
  "232": {
   "jp": "97ff1273",
   "kr": "다른 볼일은 없으시옵니까?"
  },
  "233": {
   "jp": "715e64e7",
   "kr": "좋은 바람이 여행을 돕기를."
  },
  "234": {
   "jp": "dd141c9b",
   "kr": "넬바 챠펠에 잘 오셨습니다."
  },
  "235": {
   "jp": "85557687",
   "kr": "어느 분께 전수할까요?"
  },
  "236": {
   "jp": "633b97c0",
   "kr": "어느 마법을 원하시는지요."
  },
  "237": {
   "jp": "941f0265",
   "kr": "말이군요."
  },
  "238": {
   "jp": "01aa32e3",
   "kr": "전수하겠습니다."
  },
  "239": {
   "jp": "6fe928f7",
   "kr": "마법이 파괴만이 아니라"
  },
  "240": {
   "jp": "4af9f10f",
   "kr": "희망의 양식이 되기를."
  }
 }
}