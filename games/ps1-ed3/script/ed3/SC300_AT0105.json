  "0": {
   "jp": "bf50e946",
   "kr": "볼트"
  },
  "1": {
   "jp": "29d91607",
   "kr": "어부 로아"
  },
  "2": {
   "jp": "944b7429",
   "kr": "도구상 에레가레"
  },
  "3": {
   "jp": "7c216bed",
   "kr": "어부 모루사"
  },
  "4": {
   "jp": "9f4ea532",
   "kr": "프리제 부인"
  },
  "5": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "6": {
   "jp": "7a4640a4",
   "kr": "앰비쉬 군대는 대단하다니까."
  },
  "7": {
   "jp": "656d7a31",
   "kr": "가루가를 쫓아 보내 버렸으니 말이야."
  },
  "8": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "9": {
   "jp": "a1b479d4",
   "kr": "무슨 볼일로?"
  },
  "10": {
   "jp": "0ca70118",
   "kr": "마음에 드는 게 있나요?"
  },
  "11": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "12": {
   "jp": "af2f0029",
   "kr": "예요."
  },
  "13": {
   "jp": "349c2301",
   "kr": "필요 없는 물건은 기꺼이 사들입니다."
  },
  "14": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "15": {
   "jp": "67afcad1",
   "kr": "에 사들이겠습니다."
  },
  "16": {
   "jp": "8e93c275",
   "kr": "환전율은 1 라피카가 15 Pia예요."
  },
  "17": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "18": {
   "jp": "7da61f0d",
   "kr": "야."
  },
  "19": {
   "jp": "f2181726",
   "kr": "라피카가 없네요."
  },
  "20": {
   "jp": "f300cc06",
   "kr": "벌어 오시면 또 오세요."
  },
  "21": {
   "jp": "05ecc145",
   "kr": "언제든지 사들이니까요."
  },
  "22": {
   "jp": "a517b0da",
   "kr": "다른 볼일은?"
  },
  "23": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "24": {
   "jp": "e536d2df",
   "kr": "또 오세요."
  },
  "25": {
   "jp": "a447b1b9",
   "kr": "다시 평화로운 볼트로 돌아왔다."
  },
  "26": {
   "jp": "70759d4f",
   "kr": "다행이야, 다행이야."
  },
  "27": {
   "jp": "9beb033e",
   "kr": "뭐라고?"
  },
  "28": {
   "jp": "33dc0ba2",
   "kr": "가루가 소동이 끝났다고!"
  },
  "29": {
   "jp": "4f9ec304",
   "kr": "고맙다!"
  },
  "30": {
   "jp": "7e005c1b",
   "kr": "고맙다, 아가씨들."
  },
  "31": {
   "jp": "1e5a9e73",
   "kr": "이러고 있을 때가 아니지."
  },
  "32": {
   "jp": "e1501274",
   "kr": "고기잡이 준비다!"
  },
  "33": {
   "jp": "6564aa7c",
   "kr": "자, 물고기를 잔뜩 잡아야지."
  },
  "34": {
   "jp": "b808f5b1",
   "kr": "고맙다"
  },
  "35": {
   "jp": "c0edbe35",
   "kr": "알려 줘서."
  },
  "36": {
   "jp": "5b8d7982",
   "kr": "엣?"
  },
  "37": {
   "jp": "a7fa7a06",
   "kr": "가루가를 쫓아 보냈다고?"
  },
  "38": {
   "jp": "f269a147",
   "kr": "용케 성공했네."
  },
  "39": {
   "jp": "66345a6c",
   "kr": "너희들도 도와준 거구나."
  },
  "40": {
   "jp": "512fbc81",
   "kr": "정말로 수고 많았어."
  },
  "41": {
   "jp": "64f666f3",
   "kr": "정말 고마워."
  },
  "42": {
   "jp": "e9ce2310",
   "kr": "가루가는 바다로 돌아갔습니다."
  },
  "43": {
   "jp": "58a268e0",
   "kr": "갑자기 움직여서 놀랐습니다만"
  },
  "44": {
   "jp": "62c9908a",
   "kr": "마기사 님이 가루가는 제정신이라 괜찮다고"
  },
  "45": {
   "jp": "73523a86",
   "kr": "하셔서 그대로 보냈습니다."
  },
  "46": {
   "jp": "606317df",
   "kr": "그 모습이라면"
  },
  "47": {
   "jp": "c1e7bf39",
   "kr": "이제 마을을 덮치는 일은 없겠지요."
  }
 }
}
