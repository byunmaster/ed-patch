  "2": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "3": {
   "jp": "11cd763b",
   "kr": "죠르노"
  },
  "4": {
   "jp": "b18253b8",
   "kr": "크리스 님도"
  },
  "5": {
   "jp": "434d3167",
   "kr": "요리 콘테스트에"
  },
  "6": {
   "jp": "265e035b",
   "kr": "출전하신다더군요."
  },
  "7": {
   "jp": "ccc3e0d6",
   "kr": "어떤 요리가 나올지 기대됩니다."
  },
  "8": {
   "jp": "685bb299",
   "kr": "마을에 요리 재료를 찾으러 가시나요?"
  },
  "9": {
   "jp": "23d203a9",
   "kr": "조미료라면 안느의 가게에 있지만"
  },
  "10": {
   "jp": "1eb8f62a",
   "kr": "채소나 과일은 마을 사람에게"
  },
  "11": {
   "jp": "47c5168d",
   "kr": "나눠 받는 수밖에 없겠지요."
  },
  "12": {
   "jp": "5f8df0b8",
   "kr": "요리 맛은 재료에 따라서도"
  },
  "13": {
   "jp": "13f118c8",
   "kr": "크게 달라진다 하니 재료 모으기도"
  },
  "14": {
   "jp": "4f74af14",
   "kr": "중요합니다. 힘내십시오."
  },
  "15": {
   "jp": "87e5b768",
   "kr": "죠르노 님."
  },
  "16": {
   "jp": "240bcbaa",
   "kr": "저도 요리 콘테스트에"
  },
  "17": {
   "jp": "7e49b8c6",
   "kr": "출전해도 될까요?"
  },
  "18": {
   "jp": "7cb81f9d",
   "kr": "크리스 님이요?"
  },
  "19": {
   "jp": "17d16ff4",
   "kr": "당일 참가도 되죠?"
  },
  "20": {
   "jp": "eaf8c2a4",
   "kr": "그야 물론입니다."
  },
  "21": {
   "jp": "d06aa519",
   "kr": "특별한 규정은 없으니"
  },
  "22": {
   "jp": "1886efb0",
   "kr": "원하신다면 그리 되도록"
  },
  "23": {
   "jp": "a0c20961",
   "kr": "조처하겠습니다만."
  },
  "24": {
   "jp": "4b23554d",
   "kr": "점심까지 연회장으로"
  },
  "25": {
   "jp": "d872ce40",
   "kr": "자기가 만든 요리를 옮기면 되는 거죠."
  },
  "26": {
   "jp": "cbc09c2e",
   "kr": "규칙은 그것뿐인가요?"
  },
  "27": {
   "jp": "d27e5b59",
   "kr": "그리고 요리 재료는 앰비쉬 마을이나"
  },
  "28": {
   "jp": "0ccab1fe",
   "kr": "성 안에서 구할 수 있는 것으로만"
  },
  "29": {
   "jp": "3db8691b",
   "kr": "만든다는 규칙으로 정해져 있습니다."
  },
  "30": {
   "jp": "5bce6d2a",
   "kr": "마을과 성 안에서 구할 수 있으면 되는군요."
  },
  "31": {
   "jp": "7b77d837",
   "kr": "알겠어요."
  },
  "32": {
   "jp": "e41eaa80",
   "kr": "그럼, 크리스 님은 이곳 주방을 쓰십시오."
  },
  "33": {
   "jp": "4189fce2",
   "kr": "여기 있는 도구와 조미료는 자유로이 쓰셔도"
  },
  "34": {
   "jp": "37bff9ee",
   "kr": "좋습니다. 모자란 건 마을에서 마음껏"
  },
  "35": {
   "jp": "04eb5e7e",
   "kr": "마련하십시오."
  },
  "36": {
   "jp": "bb90cd33",
   "kr": "네, 알겠어요."
  },
  "37": {
   "jp": "f4e9d6a3",
   "kr": "솜씨 좀 부려 볼까."
  },
  "38": {
   "jp": "29e8a6bb",
   "kr": "그럼, 저는 크리스 님께 방해 안 되게"
  },
  "39": {
   "jp": "9c5d8b45",
   "kr": "맞은편 방에 있겠으니"
  },
  "40": {
   "jp": "51f6f79a",
   "kr": "요리가 완성되면 불러 주십시오."
  },
  "41": {
   "jp": "831fd627",
   "kr": "자, 여기 있는 건"
  },
  "42": {
   "jp": "e97a66af",
   "kr": "밥이랑 양배추랑 암염."
  },
  "43": {
   "jp": "5b629d91",
   "kr": "그리고 올리브유뿐…"
  },
  "44": {
   "jp": "a2251172",
   "kr": "보아하니"
  },
  "45": {
   "jp": "dcb05af8",
   "kr": "요리 재료가 될 만한 건"
  },
  "46": {
   "jp": "4727f2cb",
   "kr": "아무것도 없네."
  },
  "47": {
   "jp": "0d659ae6",
   "kr": "어쩌려고?"
  },
  "48": {
   "jp": "ded810de",
   "kr": "뻔하잖아."
  },
  "49": {
   "jp": "3eae07ee",
   "kr": "내가 여기서 밑준비를 하는 동안"
  },
  "50": {
   "jp": "a84f13ea",
   "kr": "재료를 찾아오는 거야."
  },
  "51": {
   "jp": "cbc8a340",
   "kr": "누가?"
  },
  "52": {
   "jp": "b63eb691",
   "kr": "쥬리오 말고 누가 있어."
  },
  "53": {
   "jp": "0d75caf4",
   "kr": "당근, 셀러리, 감자"
  },
  "54": {
   "jp": "e8a90862",
   "kr": "바나나, 뭐든 좋아."
  },
  "55": {
   "jp": "680855bd",
   "kr": "재료가 될 만한 걸 모아 와."
  },
  "56": {
   "jp": "e504e28c",
   "kr": "그치만 밑준비라니…"
