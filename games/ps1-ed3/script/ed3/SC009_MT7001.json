{
 "archive": "/SCE0/SC009.DAT",
 "member": "..\\DATA\\MT7001.BIN",
 "lines": {
  "0": {
   "jp": "ea7ef945",
   "kr": "타라타호"
  },
  "1": {
   "jp": "fcb6f9f2",
   "kr": "갑판"
  },
  "2": {
   "jp": "5cc70478",
   "kr": "어부 토바이"
  },
  "3": {
   "jp": "3b4ab5fd",
   "kr": "이제 괜찮여."
  },
  "4": {
   "jp": "376c7851",
   "kr": "바다에 나가 부리면 내 세상이제."
  },
  "5": {
   "jp": "d688301f",
   "kr": "이 바다는 내 마당 같은 것이여."
  },
  "6": {
   "jp": "e070fdc6",
   "kr": "(꼬르륵… 꼬르르륵…!)"
  },
  "7": {
   "jp": "c1d176bc",
   "kr": "쥬리오의 배가 울렸다."
  },
  "8": {
   "jp": "186eea91",
   "kr": "바다표범도"
  },
  "9": {
   "jp": "c34eaa4d",
   "kr": "배가 고팠던 걸까."
  },
  "10": {
   "jp": "3908100d",
   "kr": "쥬리오"
  },
  "11": {
   "jp": "e08d12e3",
   "kr": "너, 배고픈 거냐?"
  },
  "12": {
   "jp": "1f8d718f",
   "kr": "네. 배고파 죽겠어요."
  },
  "13": {
   "jp": "927d5abd",
   "kr": "그러고 보니 닐리 항에 닿고 나서"
  },
  "14": {
   "jp": "19769d58",
   "kr": "식사다운 식사를 못 했었지."
  },
  "15": {
   "jp": "11cfc5d7",
   "kr": "어쩐지 나도 배가 고파졌어."
  },
  "16": {
   "jp": "c6b6bae2",
   "kr": "그럼 좀 이르지만"
  },
  "17": {
   "jp": "a2869d49",
   "kr": "보리밥으로 하자."
  },
  "18": {
   "jp": "9e3702db",
   "kr": "엇?!"
  },
  "19": {
   "jp": "9366ce88",
   "kr": "식사 준비가 돼 있어요?"
  },
  "20": {
   "jp": "9098e51d",
   "kr": "당연하제."
  },
  "21": {
   "jp": "520436e2",
   "kr": "어부는 말이여, 한 번 고기잡이 나가면"
  },
  "22": {
   "jp": "618fe7ba",
   "kr": "며칠 걸릴지 몰러."
  },
  "23": {
   "jp": "671e43ce",
   "kr": "그러니께 식량만은"
  },
  "24": {
   "jp": "2a9763ef",
   "kr": "늘 넉넉히 배에 실어 두는 것이여."
  },
  "25": {
   "jp": "c314dfc2",
   "kr": "하기야 보리뿐이지만서도."
  },
  "26": {
   "jp": "05c63e87",
   "kr": "자, 따라오더라고."
  },
  "27": {
   "jp": "a4a00701",
   "kr": "뭐라도 먹여 주겄어."
  },
  "28": {
   "jp": "4ce583dd",
   "kr": "역시 배는 이 자리가 제일 좋네."
  },
  "29": {
   "jp": "ae808d82",
   "kr": "매발톱호 질버 선장님도 이 경치가 좋아서"
  },
  "30": {
   "jp": "a261016d",
   "kr": "선장이 되려고 했다더라."
  },
  "31": {
   "jp": "f5732258",
   "kr": "캡틴 토마스도"
  },
  "32": {
   "jp": "8554fcdb",
   "kr": "이렇게 여기에"
  },
  "33": {
   "jp": "5b5641f7",
   "kr": "서 있었겠지…"
  },
  "34": {
   "jp": "cbcd0a72",
   "kr": "역시 배는"
  },
  "35": {
   "jp": "946a5df2",
   "kr": "이 자리가 제일 좋네."
  },
  "36": {
   "jp": "0c1c7253",
   "kr": "이 돛대"
  },
  "37": {
   "jp": "76e83d29",
   "kr": "못 오르려나?"
  },
  "38": {
   "jp": "e1636d14",
   "kr": "그만둬, 크리스."
  },
  "39": {
   "jp": "03b581a3",
   "kr": "정말 말괄량이라니까…"
  },
  "40": {
   "jp": "54fc7eec",
   "kr": "알고 있다니까 안 오를 테니 안심해."
  },
  "41": {
   "jp": "c1a550b9",
   "kr": "그래도"
  },
  "42": {
   "jp": "d3f31cd9",
   "kr": "내가 배에서 제일 좋아하는 곳은 돛대 위야."
  },
  "43": {
   "jp": "0f62636f",
   "kr": "기억해 둬."
  },
  "44": {
   "jp": "8b81dc2b",
   "kr": "기억하는 거야 좋지만"
  },
  "45": {
   "jp": "7df2c60f",
   "kr": "그런 걸 기억해서 뭐 하게."
  },
  "46": {
   "jp": "beedafe5",
   "kr": "앗?"
  },
  "47": {
   "jp": "93cd29d1",
   "kr": "저… 저건 뭐지!"
  },
  "48": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "49": {
   "jp": "86de6b4e",
   "kr": "저건 뭐지?"
  },
  "50": {
   "jp": "a8a165f7",
   "kr": "우와, 굉장하다."
  },
  "51": {
   "jp": "660157cf",
   "kr": "뭐지, 굉장해."
  },
  "52": {
   "jp": "6dd61139",
   "kr": "어〜이, 왜 그러냐?"
  },
  "53": {
   "jp": "6d014c69",
   "kr": "토, 토, 토바이 씨!"
  },
  "54": {
   "jp": "bfd77b06",
   "kr": "저거… 뭐죠?"
  },
  "55": {
   "jp": "3924f03a",
   "kr": "토바이 씨!"
  },
  "56": {
   "jp": "a1a2f2ff",
   "kr": "저건 뭐예요?"
  },
  "57": {
   "jp": "d6edf3fb",
   "kr": "저, 저건… 설마."
  },
  "58": {
   "jp": "532bd5d9",
   "kr": "그런… 말도 안 돼…"
  },
  "59": {
   "jp": "63524751",
   "kr": "네갈섬 앞바다를 거대한 혹 같은 것이"
  },
  "60": {
   "jp": "f12eaf94",
   "kr": "남쪽을 향해 이동하고 있었다."
  },
  "61": {
   "jp": "60a9235c",
   "kr": "…마치"
  },
  "62": {
   "jp": "50aeb3c4",
   "kr": "산이 바다를 건너는 것 같아…"
  },
  "63": {
   "jp": "0de62227",
   "kr": "틀림없어! 가루가여…"
  },
  "64": {
   "jp": "e3dfc619",
   "kr": "에엣?!"
  },
  "65": {
   "jp": "a2ce969a",
   "kr": "가루가……?!"
  },
  "66": {
   "jp": "6d3f34e4",
   "kr": "가루가라고?!"
  },
  "67": {
   "jp": "db983f1e",
   "kr": "작은 순례자 쥬리오와 크리스는"
  },
  "68": {
   "jp": "a5c12854",
   "kr": "두 번째 샤리네가 있는 네갈섬행 배 위에서"
  },
  "69": {
   "jp": "6e58b4cd",
   "kr": "해수 가루가를 목격한 것이었다."
  },
  "70": {
   "jp": "3b0dec7b",
   "kr": "제1장 작은 순례자 끝"
  }
 }
}