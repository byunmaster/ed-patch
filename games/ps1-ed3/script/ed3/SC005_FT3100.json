   "kr": "매발톱호"
  },
  "1": {
   "jp": "0f879f86",
   "kr": "보스레이"
  },
  "2": {
   "jp": "a5ab341f",
   "kr": "톤쟈"
  },
  "3": {
   "jp": "f0bf552a",
   "kr": "샤라"
  },
  "4": {
   "jp": "71933bc7",
   "kr": "구스"
  },
  "5": {
   "jp": "d2173f9b",
   "kr": "우와〜!"
  },
  "6": {
   "jp": "608d355a",
   "kr": "엄청 예쁜 방이네."
  },
  "7": {
   "jp": "cbf3c0a2",
   "kr": "정말!"
  },
  "8": {
   "jp": "afc20370",
   "kr": "멋진 방이야."
  },
  "9": {
   "jp": "d0f933f8",
   "kr": "탄성이 절로 나와."
  },
  "10": {
   "jp": "9386112c",
   "kr": "마음에 들었니?"
  },
  "11": {
   "jp": "1753d72d",
   "kr": "이등 선실치곤 꽤 좋은 방이지?"
  },
  "12": {
   "jp": "02ce2482",
   "kr": "저기, 쥬리오."
  },
  "13": {
   "jp": "acb0f27c",
   "kr": "침대도 탁자도 있고"
  },
  "14": {
   "jp": "e8aa7f5b",
   "kr": "신혼여행 같네."
  },
  "15": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "16": {
   "jp": "02ce2482",
   "kr": "저기, 쥬리오."
  },
  "17": {
   "jp": "21f6fcbb",
   "kr": "신혼여행 같지."
  },
  "18": {
   "jp": "23f71d2b",
   "kr": "저기, 저기. 저기라니까!"
  },
  "19": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "20": {
   "jp": "e6be50ed",
   "kr": "대답 좀 해."
  },
  "21": {
   "jp": "d4289501",
   "kr": "…(화끈!)"
  },
  "22": {
   "jp": "6ff58c32",
   "kr": "어이, 크리스."
  },
  "23": {
   "jp": "721e4037",
   "kr": "쥬리오 녀석"
  },
  "24": {
   "jp": "eff88fb5",
   "kr": "귀 뒤까지 빨개졌어."
  },
  "25": {
   "jp": "b47b2ea9",
   "kr": "너무 괴롭히지 마라."
  },
  "26": {
   "jp": "ec43cf02",
   "kr": "그럼 나중에 다시 부르러 올 테니까"
  },
  "27": {
   "jp": "ec7d6854",
   "kr": "잠시 쉬고 있어."
  },
  "28": {
   "jp": "4a8fa9f4",
   "kr": "저기."
  },
  "29": {
   "jp": "8fa6d6e5",
   "kr": "질버 선장님은 꽤 무서운 얼굴인데"
  },
  "30": {
   "jp": "789fe6ea",
   "kr": "화내면 역시 무서워요?"
  },
  "31": {
   "jp": "60c9de76",
   "kr": "선장님은 험상궂은 얼굴이지만"
  },
  "32": {
   "jp": "17810ef4",
   "kr": "신기하게 아이들에겐 다정해."
  },
  "33": {
   "jp": "d582a290",
   "kr": "무서워할 것 없어."
  },
  "34": {
   "jp": "d4a27aa0",
   "kr": "그럼, 갈아입고 일할 준비를"
  },
  "35": {
   "jp": "92badb21",
   "kr": "해 둬라."
  },
  "36": {
   "jp": "b5c389b9",
   "kr": "아 그리고 선실은 늘 깨끗이 해라."
  },
  "37": {
   "jp": "11549da1",
   "kr": "질버 선장님의 방침이야."
  },
  "38": {
   "jp": "9c03c608",
   "kr": "다행이네, 쥬리오."
  },
  "39": {
   "jp": "454622ff",
   "kr": "배 사람들 다 좋은 사람인가 봐."
  },
  "40": {
   "jp": "bb619834",
   "kr": "즐거운 뱃길이 되겠어."
  },
  "41": {
   "jp": "3a779c07",
   "kr": "메나트의 닐리에는 며칠쯤 걸려"
  },
  "42": {
   "jp": "7aa27d16",
   "kr": "닿으려나."
  },
  "43": {
   "jp": "4009e0e3",
   "kr": "순조로우면 사나흘쯤 걸릴 거야."
  },
  "44": {
   "jp": "59a75d1a",
   "kr": "어라…?"
  },
  "45": {
   "jp": "942fc8ef",
   "kr": "쥬리오, 혹시 배가 무서워?"
  },
  "46": {
   "jp": "9f1721cc",
   "kr": "그, 그런 거 아니야."
  },
  "47": {
   "jp": "3a5a10c5",
   "kr": "난…헤엄칠 수 있으니까 괜찮아."
  },
  "48": {
   "jp": "e3424497",
   "kr": "흐〜음."
  },
  "49": {
   "jp": "567a9252",
   "kr": "센 척하기는."
  },
  "50": {
   "jp": "4a6e9fd3",
   "kr": "그, 그런 거 아니야."
  },
  "51": {
   "jp": "a9628f01",
   "kr": "이제부터 긴 순례 여행을 해야 하잖아."
  },
  "52": {
   "jp": "c32ebd7f",
   "kr": "배쯤이야, 아무렇지 않아."
  },
  "53": {
   "jp": "01ebbb0d",
   "kr": "응, 그래야지."
  },
  "54": {
   "jp": "b343f867",
   "kr": "우린 티라스일 전역을 여행하는"
  },
  "55": {
   "jp": "4f4866e9",
   "kr": "순례 여행자니까."
  },
  "56": {
   "jp": "3a1c2f15",
   "kr": "들었냐?"
  },
  "57": {
   "jp": "531a862c",
   "kr": "물론."
  },
  "58": {
   "jp": "33a9a2d9",
   "kr": "어이, 쥬리오, 크리스."
  },
  "59": {
   "jp": "31507612",
   "kr": "슬슬 일을 시작해 주겠냐?"
  },
  "60": {
   "jp": "7a737acd",
   "kr": "쥬리오는 선내 청소."
  },
  "61": {
   "jp": "295a61f8",
   "kr": "크리스는 주방 돕기다."
  },
  "62": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "63": {
   "jp": "983f1bd7",
   "kr": "맡겨 주세요!"
  },
  "64": {
   "jp": "11d593be",
   "kr": "실력 보일게요."
  },
  "65": {
   "jp": "9ca6a84f",
   "kr": "방은 그럭저럭이네."
  },
  "66": {
   "jp": "6056f967",
   "kr": "뭐야, 저 무시무시한 선장은."
  },
  "67": {
   "jp": "4453bf9f",
   "kr": "항구를 떠나면 해적으로 둔갑하는 거"
  },
  "68": {
   "jp": "c7016085",
   "kr": "아니겠지?"
  },
  "69": {
   "jp": "f51a51c0",
   "kr": "안내 수고했어."
  },
  "70": {
   "jp": "564f8291",
   "kr": "미안하지만, 팁은 없어."
  },
  "71": {
   "jp": "5e6db4be",
   "kr": "순례 여행자라는군."
  },
  "72": {
   "jp": "45050011",
   "kr": "저 꼬맹이들이야."
  },
  "73": {
   "jp": "a743bbcd",
   "kr": "같은 배에 타게 될 줄이야."
  },
  "74": {
   "jp": "fcfd93e3",
   "kr": "이번에야말로 은단검을 훔쳐 내 주마."
  },
  "75": {
   "jp": "6c4d3784",
   "kr": "근데 저 애들, 우리 얼굴을"
  },
  "76": {
   "jp": "3f2a3ff0",
   "kr": "알고 있지 않았어?"
  },
  "77": {
   "jp": "87be0c6e",
   "kr": "들키면 곤란한데."
  },
  "78": {
   "jp": "c17daff2",
   "kr": "숨을 거야 훔칠 거야, 어느 쪽이야?"
  },
  "79": {
   "jp": "943488ce",
   "kr": "잠깐!"
  },
  "80": {
   "jp": "d0e6d1df",
   "kr": "저쪽 소리가 들린다는 건…"
  },
  "81": {
   "jp": "b0e46c7d",
   "kr": "옆방은 꽤 시끌벅적하네."
  },
  "82": {
   "jp": "2935fa96",
   "kr": "나중에 놀러 가 보자."
  },
  "83": {
   "jp": "e70aa9a4",
   "kr": "찬〜스!"
  },
  "84": {
   "jp": "647ce3e8",
   "kr": "그놈들 방을 나갔어."
  },
  "85": {
   "jp": "01d04e1c",
   "kr": "자, 지금 몰래 들어가서"
  },
  "86": {
   "jp": "a2331d9f",
   "kr": "은단검을 슬쩍 가져가자."
  },
  "87": {
   "jp": "835ab42c",
   "kr": "음〜, 은단검…"
  },
  "88": {
   "jp": "dd119f50",
   "kr": "은단검… 하고."
  },
  "89": {
   "jp": "4f6e6cc1",
   "kr": "정말, 어디에 둔 걸까."
  },
  "90": {
   "jp": "0f4d2a9e",
   "kr": "나한테 안 들키게 숨기다니"
  },
  "91": {
   "jp": "4c3a0605",
   "kr": "얕볼 수 없는 꼬맹이군."
  },
  "92": {
   "jp": "b33dc7f5",
   "kr": "쥬리오라는 꼬마가"
  },
  "93": {
   "jp": "28516d44",
   "kr": "몸에 지니고 다니는 거 아냐?"
  },
  "94": {
   "jp": "1e00f498",
   "kr": "역시 그런가."
  },
  "95": {
   "jp": "7aacc995",
   "kr": "아무튼 여기 있으면 위험하겠어."
  },
  "96": {
   "jp": "e6018a4f",
   "kr": "방에 돌아가는 게 좋겠어."
  },
  "97": {
   "jp": "b7232181",
   "kr": "뭐야, 결국 숨는 거잖아."
  },
  "98": {
   "jp": "b47d3fe3",
   "kr": "흥."
  },
  "99": {
   "jp": "6da684fe",
   "kr": "프로는 서두르지 않는 법."
  },
  "100": {
   "jp": "86a9577e",
   "kr": "여기서 나갈 수 없잖아."
  },
  "101": {
   "jp": "de989548",
   "kr": "후우…"
  },
  "102": {
   "jp": "89986734",
   "kr": "한숨밖에 안 나오네."
  }
 }
