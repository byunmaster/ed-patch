{
 "archive": "/SCE0/SC000.DAT",
 "member": "..\\DATA\\FT0002.BIN",
 "lines": {
  "0": {
   "jp": "bb708123",
   "kr": "라그픽 마을"
  },
  "1": {
   "jp": "ea39b3fe",
   "kr": "여행자"
  },
  "2": {
   "jp": "a417cb4e",
   "kr": "음유시인"
  },
  "3": {
   "jp": "1c3909b6",
   "kr": "쥬리오 아빠"
  },
  "4": {
   "jp": "ad0e2a6b",
   "kr": "쥬리오 엄마"
  },
  "5": {
   "jp": "8ef96780",
   "kr": "톨타 촌장"
  },
  "6": {
   "jp": "d0b6da59",
   "kr": "도구점 테르노"
  },
  "7": {
   "jp": "3cfb8627",
   "kr": "픽"
  },
  "8": {
   "jp": "1b89384a",
   "kr": "스콜"
  },
  "9": {
   "jp": "0b8d576a",
   "kr": "로그"
  },
  "10": {
   "jp": "b9f92fd3",
   "kr": "치아나"
  },
  "11": {
   "jp": "a5d6417f",
   "kr": "쥬리오〜"
  },
  "12": {
   "jp": "b05fdb2a",
   "kr": "…쥬리오, 정말!"
  },
  "13": {
   "jp": "a9fc3a87",
   "kr": "미안, 크리스."
  },
  "14": {
   "jp": "f008360d",
   "kr": "모처럼 데리러 와 줬는데."
  },
  "15": {
   "jp": "9ceecb63",
   "kr": "방금 막 일어났거든."
  },
  "16": {
   "jp": "90e38ee9",
   "kr": "역시!"
  },
  "17": {
   "jp": "a4e296a4",
   "kr": "어머!"
  },
  "18": {
   "jp": "918a9fb4",
   "kr": "멋진 순례복이네."
  },
  "19": {
   "jp": "fd355157",
   "kr": "아주 잘 어울려."
  },
  "20": {
   "jp": "27f091e6",
   "kr": "에헤헤."
  },
  "21": {
   "jp": "5312264a",
   "kr": "엄마가 만들어 주셨어요."
  },
  "22": {
   "jp": "202d3afc",
   "kr": "이렇게 중요한 날까지 늦잠을 자다니."
  },
  "23": {
   "jp": "c426848d",
   "kr": "배포가 큰 건지, 그냥 덜떨어진 건지"
  },
  "24": {
   "jp": "10e78909",
   "kr": "둘 중 하나겠지."
  },
  "25": {
   "jp": "022fff74",
   "kr": "하아암."
  },
  "26": {
   "jp": "60a084c8",
   "kr": "안녕〜, 크리스."
  },
  "27": {
   "jp": "565c6d55",
   "kr": "안녕〜은 무슨."
  },
  "28": {
   "jp": "9292c03f",
   "kr": "여행 가서도 이러면"
  },
  "29": {
   "jp": "a41241ec",
   "kr": "두고 가 버릴 거야."
  },
  "30": {
   "jp": "be20d524",
   "kr": "자, 똑바로 해."
  },
  "31": {
   "jp": "7087222f",
   "kr": "부디 촌장님께"
  },
  "32": {
   "jp": "83df259c",
   "kr": "실례되는 일은 없도록 하렴."
  },
  "33": {
   "jp": "047e5710",
   "kr": "나중에 엄마들도 갈 테니까."
  },
  "34": {
   "jp": "4c449dee",
   "kr": "아까"
  },
  "35": {
   "jp": "388271d3",
   "kr": "음유시인을 봤어."
  },
  "36": {
   "jp": "fba1a9ce",
   "kr": "마을에 음유시인이 오다니 드문 일이네."
  },
  "37": {
   "jp": "3c203d12",
   "kr": "음유시인?"
  },
  "38": {
   "jp": "05db3025",
   "kr": "엄청 예쁜 언니였어."
  },
  "39": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "40": {
   "jp": "f4881df9",
   "kr": "하고 있네, 하고 있어."
  },
  "41": {
   "jp": "99437975",
   "kr": "어? 로그도 있었네."
  },
  "42": {
   "jp": "62f6d688",
   "kr": "당연하지."
  },
  "43": {
   "jp": "984a20a4",
   "kr": "내가 이런 구경거리를 놓칠 리 있겠냐."
  },
  "44": {
   "jp": "95e59f49",
   "kr": "봐라, 촌장님도 와 계시다."
  },
  "45": {
   "jp": "77501f1f",
   "kr": "촌장님도?"
  },
  "46": {
   "jp": "f92c9fc7",
   "kr": "뭐, 딱딱한 소리 말라고."
  },
  "47": {
   "jp": "db107eaf",
   "kr": "다 듣고 나면"
  },
  "48": {
   "jp": "5b2222b9",
   "kr": "은단검 수여식도 제대로 치를 테니까."
  },
  "49": {
   "jp": "b2e465a7",
   "kr": "그것보다 봐라."
  },
  "50": {
   "jp": "04ca4245",
   "kr": "예쁜 누님이다."
  },
  "51": {
   "jp": "44d76fa3",
   "kr": "화장이 좀 진하긴 하지만."
  },
  "52": {
   "jp": "ce3c26cb",
   "kr": "크흠!"
  },
  "53": {
   "jp": "18ad0235",
   "kr": "오래 기다리셨죠."
  },
  "54": {
   "jp": "b7430eea",
   "kr": "자, 그럼 제가 가장 좋아하는"
  },
  "55": {
   "jp": "9a4a4114",
   "kr": "발라드를 들려 드리겠습니다."
  },
  "56": {
   "jp": "34d47641",
   "kr": "기다렸어요!"
  },
  "57": {
   "jp": "dccadbee",
   "kr": "자, 들어 주세요."
  },
  "58": {
   "jp": "88bffa8e",
   "kr": "그대도… 잊었다."
  },
  "59": {
   "jp": "2d7815aa",
   "kr": "오래된 기억이…"
  },
  "60": {
   "jp": "553c6cd5",
   "kr": "그 소녀의 말로 되살아난다…"
  },
  "61": {
   "jp": "1424313c",
   "kr": "부디 전해 줘…"
  },
  "62": {
   "jp": "8949ad65",
   "kr": "지워지지 않는 상처."
  },
  "63": {
   "jp": "74b619bc",
   "kr": "대지에 남은 우리의 죄를…"
  },
  "64": {
   "jp": "fd22a479",
   "kr": "사람은 모든 걸 잊어도"
  },
  "65": {
   "jp": "72bfd89b",
   "kr": "마음속에 살아 있다…"
  },
  "66": {
   "jp": "4635a556",
   "kr": "샤라!"
  },
  "67": {
   "jp": "bd6dd516",
   "kr": "봐라, 봐라. 감쪽같이 성공했다."
  },
  "68": {
   "jp": "e50acaf5",
   "kr": "은단검은 손에 넣었다!"
  },
  "69": {
   "jp": "b9b1d111",
   "kr": "아차…"
  },
  "70": {
   "jp": "97a7a681",
   "kr": "은단검이라고?!"
  },
  "71": {
   "jp": "c6d31efb",
   "kr": "이 멍청이!"
  },
  "72": {
   "jp": "b7269e08",
   "kr": "뭘 위해서"
  },
  "73": {
   "jp": "dd59195e",
   "kr": "내가 마을 사람들을"
  },
  "74": {
   "jp": "8af6339b",
   "kr": "붙잡아 뒀다고 생각하는 거야!"
  },
  "75": {
   "jp": "11b8ba8d",
   "kr": "은단검이라면…"
  },
  "76": {
   "jp": "bc8b5119",
   "kr": "우리가 받아 가야 할 그거?"
  },
  "77": {
   "jp": "04a3d84c",
   "kr": "에〜!"
  },
  "78": {
   "jp": "7f5af7a0",
   "kr": "그럼, 저 사람들은…!?"
  },
  "79": {
   "jp": "f89ff784",
   "kr": "도, 도둑이다!"
  },
  "80": {
   "jp": "6eb10842",
   "kr": "구스!"
  },
  "81": {
   "jp": "381ceb8b",
   "kr": "얼빠진 얼굴 하지 말고"
  },
  "82": {
   "jp": "ec89b8cc",
   "kr": "자, 도망치는 거야!"
  },
  "83": {
   "jp": "7f7bb594",
   "kr": "쫓아가야 해!"
  },
  "84": {
   "jp": "5e5aab85",
   "kr": "으, 응."
  },
  "85": {
   "jp": "69cc8f52",
   "kr": "촌장님!"
  },
  "86": {
   "jp": "e3c15d4b",
   "kr": "대, 대사건이다!"
  }
 }
}
