{
 "archive": "/SCE1/SC106.DAT",
 "member": "..\\DATA\\MR3300.BIN",
 "lines": {
  "0": {
   "jp": "b2b851f8",
   "kr": "토파즈 해안"
  },
  "1": {
   "jp": "58f9bc40",
   "kr": "코딕"
  },
  "2": {
   "jp": "b70ff07c",
   "kr": "저기, 크리스."
  },
  "3": {
   "jp": "e7d538f9",
   "kr": "이 배, 네갈섬 앞에서 스쳐 지난"
  },
  "4": {
   "jp": "837de701",
   "kr": "배 아닐까?"
  },
  "5": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "6": {
   "jp": "0a672e75",
   "kr": "으〜음. 닮았지만…"
  },
  "7": {
   "jp": "fe975615",
   "kr": "그럼, 케빈 할아버지네"
  },
  "8": {
   "jp": "7c22e856",
   "kr": "로디 씨가 여기에?"
  },
  "9": {
   "jp": "e61754f4",
   "kr": "가루가를 노린다는"
  },
  "10": {
   "jp": "6d2e5e96",
   "kr": "젊은이 말인가?"
  },
  "11": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "12": {
   "jp": "f54bef3a",
   "kr": "그래도, 비슷한 배야"
  },
  "13": {
   "jp": "d1fb8dcb",
   "kr": "얼마든지 있잖아."
  },
  "14": {
   "jp": "3fb608cf",
   "kr": "설마, 로디 씨 배는 아닐 거야."
  },
  "15": {
   "jp": "2fbaec27",
   "kr": "로디 배 아닐까…?"
  },
  "16": {
   "jp": "6308452a",
   "kr": "이 배도"
  },
  "17": {
   "jp": "4bd45ed6",
   "kr": "용케 버텨 줬구나."
  },
  "18": {
   "jp": "4bec6353",
   "kr": "이렇게 작은 배로"
  },
  "19": {
   "jp": "d3c23b6d",
   "kr": "네갈섬에서 오다니 굉장하네."
  },
  "20": {
   "jp": "c9b9944a",
   "kr": "로디 씨의 근성이 배에도 전해진 거네."
  },
  "21": {
   "jp": "be76f744",
   "kr": "이 배, 도둑맞지 않을까?"
  },
  "22": {
   "jp": "64f11ec9",
   "kr": "괜찮아요."
  },
  "23": {
   "jp": "a76e3d33",
   "kr": "이렇게 너덜너덜한걸요."
  },
  "24": {
   "jp": "a2472477",
   "kr": "…시원시원해서 좋은 성격이군."
  },
  "25": {
   "jp": "8c1df6a0",
   "kr": "사나이의 기합"
  },
  "26": {
   "jp": "2bdf65a5",
   "kr": "우오오랴아아앗!!"
  },
  "27": {
   "jp": "5590ff80",
   "kr": "네?"
  },
  "28": {
   "jp": "93342f88",
   "kr": "아야야… 제길."
  },
  "29": {
   "jp": "4049d18d",
   "kr": "허리를 찧었네."
  },
  "30": {
   "jp": "f6bc975a",
   "kr": "얌전히 내 짐을 돌려놔!"
  },
  "31": {
   "jp": "56354c3d",
   "kr": "앗, 로디 씨!?"
  },
  "32": {
   "jp": "6d46a0b2",
   "kr": "로디다, 로디다!"
  },
  "33": {
   "jp": "bc8a3d63",
   "kr": "궁지에 몰아넣었다."
  },
  "34": {
   "jp": "fe9b27fa",
   "kr": "그르르르…"
  },
  "35": {
   "jp": "992ed08b",
   "kr": "로디라는 사람."
  },
  "36": {
   "jp": "01d2bfce",
   "kr": "도와줄까?"
  },
  "37": {
   "jp": "d76d49d7",
   "kr": "거들 필요 없다!"
  },
  "38": {
   "jp": "0a08906e",
   "kr": "…어떻게 내 이름을?"
  },
  "39": {
   "jp": "b7a8a2ff",
   "kr": "아야!"
  },
  "40": {
   "jp": "6ac92f29",
   "kr": "역시 나도…"
  },
  "41": {
   "jp": "9c4a88e9",
   "kr": "필요 없어!"
  },
  "42": {
   "jp": "60d0a2d2",
   "kr": "남의 물건에 손대니까 이 꼴이지."
  },
  "43": {
   "jp": "fc002ddd",
   "kr": "물가에 올라오자마자"
  },
  "44": {
   "jp": "4baff221",
   "kr": "짐을 노리고 나오다니"
  },
  "45": {
   "jp": "f5bbb945",
   "kr": "간사한 마수로군."
  },
  "46": {
   "jp": "424d9ba5",
   "kr": "엄청 멋있다!"
  },
  "47": {
   "jp": "e376719a",
   "kr": "이야, 훌륭하군."
  },
  "48": {
   "jp": "e7e6df84",
   "kr": "로디 씨, 강하네."
  },
  "49": {
   "jp": "e94bbdc6",
   "kr": "역시 가루가를 쫓는"
  },
  "50": {
   "jp": "17f8cdf0",
   "kr": "사람답네."
  },
  "51": {
   "jp": "c7781ddd",
   "kr": "어, 이봐…"
  },
  "52": {
   "jp": "b62fdeb0",
   "kr": "너희들… 뭐 하는 자들이냐?"
  },
  "53": {
   "jp": "f39ded82",
   "kr": "어떻게 그런 것까지 아는 거냐!?"
  },
  "54": {
   "jp": "b001d711",
   "kr": "앗, 미안해요."
  },
  "55": {
   "jp": "52e8c579",
   "kr": "인사가 늦었네요."
  },
  "56": {
   "jp": "fbf8688f",
   "kr": "저는 크리스, 잘 부탁해요."
  },
  "57": {
   "jp": "c8b427d1",
   "kr": "나는 쥬리오야."
  },
  "58": {
   "jp": "f751fd52",
   "kr": "순례 여행을 하고 있어."
  },
  "59": {
   "jp": "7591fd2b",
   "kr": "네갈섬 항구 근처에서"
  },
  "60": {
   "jp": "438e0ad0",
   "kr": "배로 스쳐 지났잖아."
  },
  "61": {
   "jp": "72ab624e",
   "kr": "기억 안 나?"
  },
  "62": {
   "jp": "702a816f",
   "kr": "역시 기억 못 하겠지."
  },
  "63": {
   "jp": "020ccc01",
   "kr": "그때, 로디 씨는"
  },
  "64": {
   "jp": "531e6e79",
   "kr": "무척 심각한 얼굴이었으니까."
  },
  "65": {
   "jp": "97e12d15",
   "kr": "쥬리오가 아무리 갑판 위에서"
  },
  "66": {
   "jp": "270f70fa",
   "kr": "불러도 귀에 들어오지도"
  },
  "67": {
   "jp": "544bf1da",
   "kr": "멈추지 않았던 거예요."
  },
  "68": {
   "jp": "3453fdff",
   "kr": "그런가."
  },
  "69": {
   "jp": "c78d9f84",
   "kr": "그래. 모처럼 가루가와 마주쳤는데"
  },
  "70": {
   "jp": "b99308e3",
   "kr": "기회를 놓쳐 버린 거야."
  },
  "71": {
   "jp": "d0c4c765",
   "kr": "테그라 마을까지 당해 버렸고…"
  },
  "72": {
   "jp": "5e1096d8",
   "kr": "충격이 크겠지."
  },
  "73": {
   "jp": "226addd4",
   "kr": "응, 그렇겠네."
  },
  "74": {
   "jp": "4a851b47",
   "kr": "그 마음 아플 만큼 잘 아네."
  },
  "75": {
   "jp": "4f930881",
   "kr": "아, 나는 알프일세."
  },
  "76": {
   "jp": "0cee791f",
   "kr": "이봐!"
  },
  "77": {
   "jp": "87676450",
   "kr": "멋대로 납득해도…"
  },
  "78": {
   "jp": "04e8a7f6",
   "kr": "그러니까, 왜 나를"
  },
  "79": {
   "jp": "f808b85a",
   "kr": "그렇게 잘 아는 거냐?"
  },
  "80": {
   "jp": "4447a1fe",
   "kr": "우리"
  },
  "81": {
   "jp": "f48bfe1e",
   "kr": "네갈섬에서 케빈 할아버지를"
  },
  "82": {
   "jp": "85159731",
   "kr": "만났거든."
  },
  "83": {
   "jp": "241e8bcc",
   "kr": "할아범이 수다를 떨었군…"
  },
  "84": {
   "jp": "70fc9da7",
   "kr": "참고로, 나는 치타 마을에서"
  },
  "85": {
   "jp": "c8355346",
   "kr": "이 아이들과 만났으니"
  },
  "86": {
   "jp": "ad080fe0",
   "kr": "자네 할아버지는 만나지 않았네."
  },
  "87": {
   "jp": "1956d0dc",
   "kr": "아아, 그러셔."
  },
  "88": {
   "jp": "d202baa8",
   "kr": "그건 그렇고 로디 군."
  },
  "89": {
   "jp": "a2a0ea88",
   "kr": "자네는 이제부터"
  },
  "90": {
   "jp": "05d24078",
   "kr": "어쩔 셈인가?"
  },
  "91": {
   "jp": "5b9372e9",
   "kr": "그저 무턱대고 가루가를 쫓는"
  },
  "92": {
   "jp": "1f3e39ac",
   "kr": "것도 아닐 테고?"
  },
  "93": {
   "jp": "03db6b6b",
   "kr": "그래, 나는 앰비쉬 볼트에서"
  },
  "94": {
   "jp": "7e68b12d",
   "kr": "가루가를 맞받아칠 생각이다."
  },
  "95": {
   "jp": "045a150d",
   "kr": "놈은 반드시 앰비쉬에 상륙한다."
  },
  "96": {
   "jp": "f20f8f88",
   "kr": "어째서 그리 단언하나."
  },
  "97": {
   "jp": "546aecd3",
   "kr": "마녀의 예언이다."
  },
  "98": {
   "jp": "d90e1e91",
   "kr": "테그라는 마녀의 예언대로"
  },
  "99": {
   "jp": "0919ad00",
   "kr": "가루가의 습격을 받았다."
  },
  "100": {
   "jp": "2c0168ce",
   "kr": "나는 전에 검 수행으로 앰비쉬를"
  },
  "101": {
   "jp": "0538d94b",
   "kr": "찾았을 때, 거기에도 같은 예언이"
  },
  "102": {
   "jp": "b1a11af9",
   "kr": "남아 있다는 걸 알았다."
  },
  "103": {
   "jp": "46bc56bf",
   "kr": "테그라에선 이렇다."
  },
  "104": {
   "jp": "8ea8fa18",
   "kr": "대지가 결실을 잊을 때 산은 바다를 넘어"
  },
  "105": {
   "jp": "19939e5f",
   "kr": "사람들의 탄식이 울린다."
  },
  "106": {
   "jp": "4544e372",
   "kr": "그리고 넬바와 앰비쉬 지방에는"
  },
  "107": {
   "jp": "a0dbbeb4",
   "kr": "이렇게 전해졌다."
  },
  "108": {
   "jp": "ecb7cbe2",
   "kr": "재앙의 산은 바다에서 나와"
  },
  "109": {
   "jp": "de0a4754",
   "kr": "도읍을 잔해로 만든다."
  },
  "110": {
   "jp": "896a2bff",
   "kr": "틀림없다."
  },
  "111": {
   "jp": "a72ceaa2",
   "kr": "앰비쉬에 상륙한다면 볼트 연안이다."
  },
  "112": {
   "jp": "bbb46d2e",
   "kr": "거기서 나는 가루가를 친다."
  },
  "113": {
   "jp": "13c902c6",
   "kr": "그래도, 그렇게 큰데"
  },
  "114": {
   "jp": "49ecda29",
   "kr": "어떻게 쓰러뜨릴 셈이야?"
  },
  "115": {
   "jp": "850d785e",
   "kr": "아무리 팔에 자신 있어도"
  },
  "116": {
   "jp": "830673ae",
   "kr": "검으로 쓰러뜨릴 적이 아닐세."
  },
  "117": {
   "jp": "d7a70cb1",
   "kr": "수는 있다."
  },
  "118": {
   "jp": "f0a69f91",
   "kr": "나도 무모한 싸움을"
  },
  "119": {
   "jp": "563db64b",
   "kr": "걸겠다는 게 아니야."
  },
  "120": {
   "jp": "c3f25f84",
   "kr": "자, 쓸데없는 얘기를 했군."
  },
  "121": {
   "jp": "eb0259e2",
   "kr": "나는 간다."
  },
  "122": {
   "jp": "f1320b54",
   "kr": "튜엘에서 알아볼 게 있거든."
  },
  "123": {
   "jp": "5e8f4e45",
   "kr": "저기, 반바지 오빠."
  },
  "124": {
   "jp": "42d2b12d",
   "kr": "잠깐 기다려."
  },
  "125": {
   "jp": "56a71ac4",
   "kr": "윽…"
  },
  "126": {
   "jp": "c464cfbf",
   "kr": "뭐야"
  },
  "127": {
   "jp": "f5fb407c",
   "kr": "반바지가 어때서."
  },
  "128": {
   "jp": "9f0b88b5",
   "kr": "아니. 무척 멋져."
  },
  "129": {
   "jp": "4ff3e5e0",
   "kr": "우리도 앰비쉬로 가는 길이야."
  },
  "130": {
   "jp": "296782d7",
   "kr": "여행은 동료가 많은 편이 좋아."
  },
  "131": {
   "jp": "1a8be65f",
   "kr": "저기, 같이 가자."
  },
  "132": {
   "jp": "a56baac5",
   "kr": "미안하지만"
  },
  "133": {
   "jp": "ff5cb9f7",
   "kr": "너희가 함께면"
  },
  "134": {
   "jp": "39055d83",
   "kr": "짐이 된다."
  },
  "135": {
   "jp": "43fe94d3",
   "kr": "나는 혼자에 익숙하고"
  },
  "136": {
   "jp": "9f758f9b",
   "kr": "그 편이 낫다."
  },
  "137": {
   "jp": "78ac7a78",
   "kr": "그럼."
  },
  "138": {
   "jp": "63fccc72",
   "kr": "로디, 같이 가자니까."
  },
  "139": {
   "jp": "fe0e78ff",
   "kr": "어차피 같은 방향이잖아."
  },
  "140": {
   "jp": "3dc00e8f",
   "kr": "나, 검도 배우고 싶은데."
  },
  "141": {
   "jp": "fe0b0e96",
   "kr": "싫다."
  },
  "142": {
   "jp": "1fbd6f54",
   "kr": "저기, 그러지 말고"
  },
  "143": {
   "jp": "b3547190",
   "kr": "같이 가자."
  },
  "144": {
   "jp": "745dd11b",
   "kr": "싫다니까."
  },
  "145": {
   "jp": "86657e50",
   "kr": "후후. 자네도 눈에 들었구먼."
  },
  "146": {
   "jp": "59eb6b92",
   "kr": "여기선 얌전히 우리와"
  },
  "147": {
   "jp": "3a170e87",
   "kr": "함께 가시게."
  },
  "148": {
   "jp": "23148c9b",
   "kr": "아저씨까지!"
  },
  "149": {
   "jp": "fa81af8b",
   "kr": "당신들, 꽤나 끈질기군."
  },
  "150": {
   "jp": "16ad6208",
   "kr": "응, 실은 그래."
  },
  "151": {
   "jp": "54a83350",
   "kr": "어쩐지 나"
  },
  "152": {
   "jp": "54c91d7a",
   "kr": "그 반바지가 마음에 쏙 들었어."
  },
  "153": {
   "jp": "5258eab0",
   "kr": "계속 따라가면"
  },
  "154": {
   "jp": "42caa85a",
   "kr": "결국 같이 여행하는 게"
  },
  "155": {
   "jp": "07d6fbc2",
   "kr": "되는 거지."
  },
  "156": {
   "jp": "8b3d7617",
   "kr": "그래 그래."
  },
  "157": {
   "jp": "36ea4fc6",
   "kr": "크윽, 졌다…"
  },
  "158": {
   "jp": "c768780c",
   "kr": "알았다, 알았어."
  },
  "159": {
   "jp": "889ef650",
   "kr": "정말, 어쩔 수 없군."
  },
  "160": {
   "jp": "f22d0532",
   "kr": "같이 가면 되잖아!"
  },
  "161": {
   "jp": "ab358e7b",
   "kr": "그 대신"
  },
  "162": {
   "jp": "b7d677b1",
   "kr": "짐이 될 것 같으면"
  },
  "163": {
   "jp": "06950f51",
   "kr": "상관 않고 두고 갈 테니까."
  },
  "164": {
   "jp": "598f5314",
   "kr": "야호!"
  },
  "165": {
   "jp": "ebbf3ec8",
   "kr": "그럼, 같이 가"
  },
  "166": {
   "jp": "3d8ad377",
   "kr": "주는 거지?"
  },
  "167": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "168": {
   "jp": "c078c96d",
   "kr": "로디가 일행에 합류했다."
  }
 }
}