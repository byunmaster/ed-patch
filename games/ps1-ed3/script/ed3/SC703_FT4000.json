  "8": {
   "jp": "a5a3ae00",
   "kr": "갑자기 병사가 집에 와서"
  },
  "9": {
   "jp": "763ebbd2",
   "kr": "할아버님을 데려가 버렸어요."
  },
  "10": {
   "jp": "e9365e3e",
   "kr": "듀르젤 씨한테"
  },
  "11": {
   "jp": "36437c93",
   "kr": "직접 물어보면 알 거야."
  },
  "12": {
   "jp": "576633e3",
   "kr": "서두르자."
  },
  "13": {
   "jp": "f72a8976",
   "kr": "응. 그러네."
  },
  "14": {
   "jp": "1913f680",
   "kr": "괜찮을 거예요."
  },
  "15": {
   "jp": "feda4cf2",
   "kr": "아래 병사는 눈치채지 못했어."
