  "16": {
   "jp": "85e206e9",
   "kr": "어쨌든"
  },
  "17": {
   "jp": "790fcc5d",
   "kr": "추격자가 오는 건 시간문제다."
  },
  "18": {
   "jp": "4b73aa7a",
   "kr": "너희를 데려가고 싶은 곳이 있다."
  },
  "19": {
   "jp": "f399675e",
   "kr": "서둘러라."
  },
  "20": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "21": {
   "jp": "39676d9b",
   "kr": "상대를 쓰러뜨리지 않고 막는 건 한계라고."
  },
  "22": {
   "jp": "ea9c61fe",
   "kr": "여긴 튀는 게 상책이야."
  },
  "23": {
   "jp": "758905bb",
   "kr": "그렇군."
  },
  "24": {
   "jp": "3c263d1d",
   "kr": "허나 이 인원으로 움직이면 눈에 띈다."
  },
  "25": {
   "jp": "ba15f433",
   "kr": "두 패로 나뉘어"
  },
  "26": {
   "jp": "0df1376d",
   "kr": "나중에 만나기로 하지."
  },
  "27": {
   "jp": "59e5cd2b",
   "kr": "죠안나."
  },
  "28": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "29": {
   "jp": "7633bc0a",
   "kr": "너는 그 두 분과 먼저 가거라."
  },
  "30": {
   "jp": "731afb2a",
   "kr": "알겠습니다."
  },
  "31": {
   "jp": "9faae048",
   "kr": "저기, 어디 가세요?"
  },
  "32": {
   "jp": "6954d162",
   "kr": "쥬리오의 물음에"
  },
  "33": {
   "jp": "d0321c4a",
   "kr": "듀르젤의 표정이 살짝 흐려졌다."
