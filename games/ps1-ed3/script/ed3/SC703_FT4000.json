  "34": {
   "jp": "3adae119",
   "kr": "………"
  },
  "35": {
   "jp": "7e5b5b4e",
   "kr": "가 보면 알 일이다."
  },
  "36": {
   "jp": "59e5cd2b",
   "kr": "죠안나."
  },
  "37": {
   "jp": "7a240cb3",
   "kr": "먼저 가거라."
  },
  "38": {
   "jp": "5a41a9ed",
   "kr": "네. 할아버님."
