  "46": {
   "jp": "3fb0a36f",
   "kr": "수문교의 배수구군요."
  },
  "47": {
   "jp": "56d0887f",
   "kr": "물살이 너무 세서"
  },
  "48": {
   "jp": "e15b8575",
   "kr": "여기서는 올라갈 수 없을 것 같네."
  },
  "49": {
   "jp": "c90c44bc",
   "kr": "여기서는 오를 수 없을 것 같네."
  },
  "50": {
   "jp": "d0f53b88",
   "kr": "이 물은 돌페스의 탑 쪽에서"
