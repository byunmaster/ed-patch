  "39": {
   "jp": "84a6e6f2",
   "kr": "이봐"
  },
  "40": {
   "jp": "23cc7d3b",
   "kr": "탑으로 돌아갈 틈은 없다."
  },
  "41": {
   "jp": "e5145e68",
   "kr": "마을을 빠져나가"
  },
  "42": {
   "jp": "607b4d48",
   "kr": "일단 루드성 쪽으로 간다."
  },
  "43": {
   "jp": "83d5c144",
   "kr": "마을로 돌아갈 시간은 없어."
  },
  "44": {
   "jp": "ae73717b",
   "kr": "또 병사한테"
  },
  "45": {
   "jp": "906a0871",
   "kr": "가로막힐 거야."
