  "5": {
   "jp": "cbe5928d",
   "kr": "그게…"
  },
  "6": {
   "jp": "0eaf486d",
   "kr": "성 쪽은 아무 설명도 없어요."
  },
  "7": {
   "jp": "663be923",
   "kr": "다만 반년쯤 전에"
