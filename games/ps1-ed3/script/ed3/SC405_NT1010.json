{
 "archive": "/SCE4/SC405.DAT",
 "member": "..\\DATA\\NT1010.BIN",
 "lines": {
  "0": {
   "jp": "4822a33b",
   "kr": "리즈의 집"
  },
  "1": {
   "jp": "dba7b35a",
   "kr": "리즈"
  },
  "2": {
   "jp": "631357d7",
   "kr": "방방"
  },
  "3": {
   "jp": "daf9fd67",
   "kr": "봐, 도착했어."
  },
  "4": {
   "jp": "4383f05c",
   "kr": "리즈 씨, 있으려나…"
  },
  "5": {
   "jp": "3bbb38d9",
   "kr": "여기까지 와서"
  },
  "6": {
   "jp": "fb0b42b9",
   "kr": "무슨 약한 소릴 하는 거야."
  },
  "7": {
   "jp": "5a3ffb8f",
   "kr": "네, 어서 오세요."
  },
  "8": {
   "jp": "a374a022",
   "kr": "약 조합인가요?"
  },
  "9": {
   "jp": "3dd67f7b",
   "kr": "어떤 약을 준비해 드릴까요?"
  },
  "10": {
   "jp": "4cc23db1",
   "kr": "당신이 리즈 씨?"
  },
  "11": {
   "jp": "4f0e3ddf",
   "kr": "안 돼, 샤라…"
  },
  "12": {
   "jp": "1b328d5c",
   "kr": "그렇게 거칠게 말하면."
  },
  "13": {
   "jp": "31a42ffd",
   "kr": "우리는 부탁하러 온 거니까."
  },
  "14": {
   "jp": "60f7a05f",
   "kr": "괜찮아요."
  },
  "15": {
   "jp": "f5dbaf1f",
   "kr": "일부러 이런 외딴집까지"
  },
  "16": {
   "jp": "e5157445",
   "kr": "오실 정도니까"
  },
  "17": {
   "jp": "e9250042",
   "kr": "어지간히 급한 일이겠지요."
  },
  "18": {
   "jp": "6089070b",
   "kr": "무엇이든 말씀해 주세요."
  },
  "19": {
   "jp": "21073ba4",
   "kr": "죄송해요, 고마워요."
  },
  "20": {
   "jp": "a9def558",
   "kr": "우리 일행이"
  },
  "21": {
   "jp": "738de67f",
   "kr": "환술사한테 저주에 걸려서"
  },
  "22": {
   "jp": "34644f1e",
   "kr": "뻗어 버렸어."
  },
  "23": {
   "jp": "f7f972c7",
   "kr": "어머… 큰일이네요."
  },
  "24": {
   "jp": "3f667504",
   "kr": "굉장히 지독한 저주라서요."
  },
  "25": {
   "jp": "228b14ff",
   "kr": "올도스 선생님도 못 고쳤어요."
  },
  "26": {
   "jp": "20e784cb",
   "kr": "그래서 기록을 찾아봤더니"
  },
  "27": {
   "jp": "ba62a1ee",
   "kr": "지금 그 증상 비약을 만들 수 있는 건"
  },
  "28": {
   "jp": "e4bb164f",
   "kr": "리즈 씨밖에 없다는 걸 알았어요."
  },
  "29": {
   "jp": "6b21e591",
   "kr": "챠펠 마법으로 고치려 해도"
  },
  "30": {
   "jp": "6e2e4268",
   "kr": "마법이 튕겨 나가요."
  },
  "31": {
   "jp": "231adc4a",
   "kr": "저주 풀이도 전혀 안 들어요…"
  },
  "32": {
   "jp": "d530571d",
   "kr": "그건 천년 저주의 일종이네요."
  },
  "33": {
   "jp": "c7b46e29",
   "kr": "한번 저주하면 천 년은 저주가 안 풀린다는"
  },
  "34": {
   "jp": "36356156",
   "kr": "악질적인 저주지요."
  },
  "35": {
   "jp": "523e9d4a",
   "kr": "곤란하네요…"
  },
  "36": {
   "jp": "5b8d7982",
   "kr": "네?"
  },
  "37": {
   "jp": "58e448fb",
   "kr": "곤란하다니…"
  },
  "38": {
   "jp": "b4b267dc",
   "kr": "비약을 만들 수 있는 거 아니에요?"
  },
  "39": {
   "jp": "88149875",
   "kr": "네."
  },
  "40": {
   "jp": "d64fc9fc",
   "kr": "조합 방법은 알고 있지만"
  },
  "41": {
   "jp": "6fa0589f",
   "kr": "문제는 그 재료를"
  },
  "42": {
   "jp": "aafcd4c8",
   "kr": "구할 수 있느냐예요."
  },
  "43": {
   "jp": "e5af78f7",
   "kr": "값이 비싼 거야?"
  },
  "44": {
   "jp": "a0eb83f1",
   "kr": "뭣하면 훔쳐 오면 되지."
  },
  "45": {
   "jp": "f7b97c8a",
   "kr": "그런 거라면 걱정 없어."
  },
  "46": {
   "jp": "e1ce86b7",
   "kr": "아뇨, 그게 아니에요."
  },
  "47": {
   "jp": "212948e7",
   "kr": "마을에서 파는 물건이나"
  },
  "48": {
   "jp": "7b13e479",
   "kr": "숲에 자라는 풀이라면 몰라도."
  },
  "49": {
   "jp": "dbb409a9",
   "kr": "저주를 푸는 비약을 만들려면"
  },
  "50": {
   "jp": "70352ac8",
   "kr": "특별한 것이 필요해요."
  },
  "51": {
   "jp": "fec193e7",
   "kr": "뜸 들이지 말고"
  },
  "52": {
   "jp": "c6eb85eb",
   "kr": "어서 말해!"
  },
  "53": {
   "jp": "f7c9edb5",
   "kr": "뭐든 구해다 줄 테니까."
  },
  "54": {
   "jp": "b3077577",
   "kr": "리즈는 침울한 목소리로 말했다."
  },
  "55": {
   "jp": "6804abb8",
   "kr": "알그레스의 뿔이에요."
  },
  "56": {
   "jp": "959d5ef0",
   "kr": "알그레스?"
  },
  "57": {
   "jp": "ccd21305",
   "kr": "알그레스라니… 그럴 수가."
  },
  "58": {
   "jp": "a2b9405f",
   "kr": "분명 20년 전에"
  },
  "59": {
   "jp": "783dfae0",
   "kr": "멸종했다고 들었어…"
  },
  "60": {
   "jp": "e81eb9be",
   "kr": "알그레스 뿔이 없으면"
  },
  "61": {
   "jp": "7e88ddde",
   "kr": "저주 푸는 비약은 못 만들어요."
  },
  "62": {
   "jp": "293ca641",
   "kr": "그런…"
  },
  "63": {
   "jp": "65ec7c2c",
   "kr": "저기"
  },
  "64": {
   "jp": "b56e98ce",
   "kr": "멸종했다고 해도"
  },
  "65": {
   "jp": "11f2e2d6",
   "kr": "세상은 넓잖아요."
  },
  "66": {
   "jp": "44a9aefe",
   "kr": "어딘가 숨어서 살아 있는 놈도"
  },
  "67": {
   "jp": "bd153b35",
   "kr": "있지 않을까요?"
  },
  "68": {
   "jp": "aa616d72",
   "kr": "바보 같긴…"
  },
  "69": {
   "jp": "b166843c",
   "kr": "숨어 있으면"
  },
  "70": {
   "jp": "1238b493",
   "kr": "못 찾잖아!"
  },
  "71": {
   "jp": "cdc59e79",
   "kr": "찾아내는 수밖에 없잖아!"
  },
  "72": {
   "jp": "4ce9a6d5",
   "kr": "참."
  },
  "73": {
   "jp": "745191b4",
   "kr": "퓨엔테의 알그레스는 멸종했지만"
  },
  "74": {
   "jp": "26223b5d",
   "kr": "깊은 숲이 남아 있는 우돌이라면"
  },
  "75": {
   "jp": "7078c229",
   "kr": "아직 알그레스가 있을지도 몰라요."
  },
  "76": {
   "jp": "7db12cab",
   "kr": "우돌에?"
  },
  "77": {
   "jp": "c1aa2f0b",
   "kr": "이거야 원… 멀기도 하네."
  },
  "78": {
   "jp": "508268b2",
   "kr": "소문이지만"
  },
  "79": {
   "jp": "f305cb38",
   "kr": "우돌에는 미혹의 숲이 있다고"
  },
  "80": {
   "jp": "b148efd7",
   "kr": "들은 적이 있어요."
  },
  "81": {
   "jp": "925d7141",
   "kr": "알그레스가"
  },
  "82": {
   "jp": "99eb0c40",
   "kr": "혹시 지금도 있다면"
  },
  "83": {
   "jp": "f598823f",
   "kr": "그 숲이겠지요."
  },
  "84": {
   "jp": "8951c3bf",
   "kr": "미혹의 숲. 그런 게 있어요?"
  },
  "85": {
   "jp": "6b193931",
   "kr": "그러니까 소문이라고 하잖아."
  },
  "86": {
   "jp": "85ba2830",
   "kr": "소문이라도 좋아."
  },
  "87": {
   "jp": "e4983352",
   "kr": "난 갈래."
  },
  "88": {
   "jp": "1a9bb5a3",
   "kr": "왜냐면"
  },
  "89": {
   "jp": "82891702",
   "kr": "알그레스를 못 찾으면"
  },
  "90": {
   "jp": "7948e654",
   "kr": "크리스도 구스도 못 나으니까!"
  },
  "91": {
   "jp": "523c91ae",
   "kr": "그런 건 나도"
  },
  "92": {
   "jp": "e66c00d9",
   "kr": "알고 있어!"
  },
  "93": {
   "jp": "45677309",
   "kr": "자자, 두 분 다"
  },
  "94": {
   "jp": "4b9e20ac",
   "kr": "싸우지 마세요. 앞으로 어떻게 할지를"
  },
  "95": {
   "jp": "6674a506",
   "kr": "정하는 게 먼저겠지요."
  },
  "96": {
   "jp": "e1bcfe11",
   "kr": "네, 정했어요."
  },
  "97": {
   "jp": "94593ef0",
   "kr": "꼭 미혹의 숲을 찾아서"
  },
  "98": {
   "jp": "7e85dfea",
   "kr": "알그레스를 찾을래요."
  },
  "99": {
   "jp": "e82e99eb",
   "kr": "기막힐 만큼 빠른 결단이랑"
  },
  "100": {
   "jp": "ce37b5bb",
   "kr": "낙천적인 판단이네…"
  },
  "101": {
   "jp": "d8ead86c",
   "kr": "하지만 마음에 들었어."
  },
  "102": {
   "jp": "d8d1b23e",
   "kr": "미혹의 숲으로 가자고."
  },
  "103": {
   "jp": "54994d69",
   "kr": "그럼, 이렇게 하죠."
  },
  "104": {
   "jp": "8d56642f",
   "kr": "슬슬 제 외동딸 휘리가"
  },
  "105": {
   "jp": "a0ed014d",
   "kr": "약초 캐기에서 돌아올 거예요."
  },
  "106": {
   "jp": "c769a3e4",
   "kr": "휘리는 어리지만"
  },
  "107": {
   "jp": "e97e4103",
   "kr": "조제 지식을 확실히 익혔으니"
  },
  "108": {
   "jp": "7c7dee92",
   "kr": "휘리를 데리고 가세요."
  },
  "109": {
   "jp": "85079bec",
   "kr": "물론 알그레스의 뿔을 어떻게 하면"
  },
  "110": {
   "jp": "2f929926",
   "kr": "되는지도 아니까 찾기만 하면"
  },
  "111": {
   "jp": "78533f5d",
   "kr": "그대로 올도스에서 조제할 수 있어요."
  },
  "112": {
   "jp": "33d167c8",
   "kr": "조심해서 가야 해요."
  },
  "113": {
   "jp": "201ac744",
   "kr": "혹시 미혹의 숲에서"
  },
  "114": {
   "jp": "c93065a2",
   "kr": "길을 잃더라도"
  },
  "115": {
   "jp": "03e01641",
   "kr": "당황하면 안 돼요."
  },
  "116": {
   "jp": "c5c60402",
   "kr": "숲의 정령을 화나게 하지 않으면"
  },
  "117": {
   "jp": "e2fe889f",
   "kr": "반드시 길은 열려요."
  },
  "118": {
   "jp": "c85c97b3",
   "kr": "숲은 말이죠, 마음 있는 이에게"
  },
  "119": {
   "jp": "af4808f1",
   "kr": "해를 끼치는 일은"
  },
  "120": {
   "jp": "77906b7a",
   "kr": "결코 없어요."
  },
  "121": {
   "jp": "2e1d99f0",
   "kr": "안심하고 길을 찾으세요."
  },
  "122": {
   "jp": "269b584a",
   "kr": "우와 귀여운 개다!"
  },
  "123": {
   "jp": "94608ace",
   "kr": "이봐, 이건 곰이야. 곰."
  },
  "124": {
   "jp": "dd42965b",
   "kr": "곰, 곰."
  },
  "125": {
   "jp": "30e2a4dc",
   "kr": "귀엽네."
  },
  "126": {
   "jp": "27da6f18",
   "kr": "방방, 얌전히 집 보고 있어."
  },
  "127": {
   "jp": "5ee4a8e1",
   "kr": "꿀을 따겠다고"
  },
  "128": {
   "jp": "234b20e4",
   "kr": "나무에 올라가면 안 돼."
  },
  "129": {
   "jp": "e99d59f3",
   "kr": "또 벌에 쏘여서 울 거면서."
  },
  "130": {
   "jp": "3fb16747",
   "kr": "어머, 방방."
  },
  "131": {
   "jp": "f3ca51ad",
   "kr": "그 애가 돌아왔구나."
  },
  "132": {
   "jp": "2fa68892",
   "kr": "자, 마중 나가렴."
  },
  "133": {
   "jp": "38c99242",
   "kr": "방방은 돌아온 걸 알아요?"
  },
  "134": {
   "jp": "c558b710",
   "kr": "남매처럼 자랐으니까요."
  },
  "135": {
   "jp": "4ce9a6d5",
   "kr": "맞다."
  },
  "136": {
   "jp": "81b2a5e4",
   "kr": "괜찮으시면 거기까지 마중 나가 주세요."
  },
  "137": {
   "jp": "805a9407",
   "kr": "손님 오시는 걸 아주 좋아하는 아이거든요."
  },
  "138": {
   "jp": "1062bc00",
   "kr": "후후."
  },
  "139": {
   "jp": "5260c9ab",
   "kr": "방방, 간지러워."
  },
  "140": {
   "jp": "6f94fe3d",
   "kr": "와아."
  },
  "141": {
   "jp": "8c6c727f",
   "kr": "손님이시군요."
  },
  "142": {
   "jp": "6a7d9469",
   "kr": "어서 오세요."
  },
  "143": {
   "jp": "3c39203c",
   "kr": "안녕하세요."
  },
  "144": {
   "jp": "bf298e9c",
   "kr": "저, 휘리예요."
  },
  "145": {
   "jp": "18543390",
   "kr": "(우와, 엄청 귀여운 여자애야.)"
  },
  "146": {
   "jp": "850ec5b4",
   "kr": "아, 아, 안, 안녕하세요."
  },
  "147": {
   "jp": "4e90ef6b",
   "kr": "저, 저는 쥬리오예요."
  },
  "148": {
   "jp": "a5176f13",
   "kr": "뭘 그렇게 얼어 있어?"
  },
  "149": {
   "jp": "bf7ed353",
   "kr": "미인이라면 이제 익숙하잖아."
  },
  "150": {
   "jp": "378d7de5",
   "kr": "엇, 어디? 어디?"
  },
  "151": {
   "jp": "7fcc99d8",
   "kr": "흥, 구스랑 똑같은 소리 하네."
  },
  "152": {
   "jp": "b8899d4e",
   "kr": "어머, 재미있는 분들이네요."
  },
  "153": {
   "jp": "3bdec7fd",
   "kr": "자, 어서"
  },
  "154": {
   "jp": "cd4e1bbe",
   "kr": "집 쪽으로 오세요."
  },
  "155": {
   "jp": "3e5425f7",
   "kr": "리즈는 휘리에게"
  },
  "156": {
   "jp": "fe304191",
   "kr": "대강의 설명을 했다."
  },
  "157": {
   "jp": "73f8a9e1",
   "kr": "네. 알겠어요."
  },
  "158": {
   "jp": "9676cad6",
   "kr": "어머니. 저, 쥬리오 씨 일행과 함께"
  },
  "159": {
   "jp": "bd6d9c11",
   "kr": "알그레스를 찾으러 가겠어요."
  },
  "160": {
   "jp": "e9acfa25",
   "kr": "곤란해하는 분들을"
  },
  "161": {
   "jp": "52d58d34",
   "kr": "모른 척할 수는 없는걸요."
  },
  "162": {
   "jp": "f18678e1",
   "kr": "그래, 그렇게 해 주려무나."
  },
  "163": {
   "jp": "19f8c8bf",
   "kr": "죄송하지만"
  },
  "164": {
   "jp": "2e791ecf",
   "kr": "하이젠에 들러 주시겠어요?"
  },
  "165": {
   "jp": "66cfe91d",
   "kr": "약을 부탁하신 할머니가"
  },
  "166": {
   "jp": "27bb76e3",
   "kr": "하이젠 마을에"
  },
  "167": {
   "jp": "078c80ff",
