 "lines": {
  "0": {
   "jp": "9d8a27d7",
   "kr": "마녀 해안선"
  },
  "1": {
   "jp": "93899fea",
   "kr": "죠안나 씨가 있는 아로자는 북쪽이네."
  },
  "2": {
   "jp": "612f6299",
   "kr": "응?"
  },
  "3": {
   "jp": "3e05da27",
   "kr": "저건…"
  },
  "4": {
   "jp": "9436e3d8",
   "kr": "숨어요!"
  },
  "5": {
   "jp": "37975538",
   "kr": "제2군단의 병단이네."
  },
  "6": {
   "jp": "3272faf6",
   "kr": "또 표정 없는 병사들이야…"
  },
  "7": {
   "jp": "e64de137",
   "kr": "저렇게 해서"
  },
  "8": {
   "jp": "dd6f5aa7",
   "kr": "자꾸자꾸 국경에 병사를 보낼"
  },
  "9": {
   "jp": "cae39a55",
   "kr": "작정인 거야."
  },
  "10": {
   "jp": "07938b1f",
   "kr": "예언에 있던"
  },
  "11": {
   "jp": "746c34cf",
   "kr": "표정 없는 병사들 얘기가"
  },
  "12": {
   "jp": "a36bccf0",
   "kr": "마음에 걸리는데…"
  },
  "13": {
   "jp": "2c965e04",
   "kr": "안됐지만"
  },
  "14": {
   "jp": "da6b2922",
   "kr": "지금 돌아가 봐야"
  },
  "15": {
   "jp": "afdaaba8",
   "kr": "손쓸 방법이 없어요."
  },
  "16": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "17": {
   "jp": "fca3e70d",
   "kr": "아마 병사들을 어떻게 해도"
  },
  "18": {
   "jp": "ee76c7b4",
   "kr": "루드성을 어떻게든 하지 않으면"
  },
  "19": {
   "jp": "fdd369b6",
   "kr": "분명 해결이 안 될 거예요."
  },
  "20": {
   "jp": "37fc7fdd",
   "kr": "관문에 돌아가도 아무것도 못 해."
  },
  "21": {
   "jp": "018391e8",
   "kr": "관문으로 돌아갈 틈은 없다."
  },
  "22": {
   "jp": "e2c32c20",
   "kr": "루드 쪽으로 서두르자."
  },
  "23": {
   "jp": "02aa8468",
   "kr": "이쪽은 돌페스네요."
  },
  "24": {
   "jp": "b5d54953",
   "kr": "아로자의 죠안나 씨를 만나야 해!"
  },
  "25": {
   "jp": "b63056bd",
   "kr": "동쪽 돌페스 840미로"
  },
  "26": {
   "jp": "20a0a944",
   "kr": "남쪽 딜트 관문 31미로"
  },
  "27": {
   "jp": "10e3be97",
   "kr": "북쪽 아로자 85미로"
  },
  "28": {
