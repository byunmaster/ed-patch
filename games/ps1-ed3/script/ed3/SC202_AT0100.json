 "lines": {
  "0": {
   "jp": "bf50e946",
   "kr": "볼트"
  },
  "1": {
   "jp": "29d91607",
   "kr": "어부 로아"
  },
  "2": {
   "jp": "944b7429",
   "kr": "도구상 에레가레"
  },
  "3": {
   "jp": "7c216bed",
   "kr": "어부 모루사"
  },
  "4": {
   "jp": "9f4ea532",
   "kr": "프리제 부인"
  },
  "5": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "6": {
   "jp": "148908ab",
   "kr": "임금님도 참."
  },
  "7": {
   "jp": "63069e2a",
   "kr": "예언을 곧이곧대로 믿고 이렇게 병사를"
  },
  "8": {
   "jp": "5c2a007c",
   "kr": "끌고 올 것까진 없을 텐데."
  },
  "9": {
   "jp": "e0ed18ca",
   "kr": "나는 예언 따윈 안 믿어."
  },
  "10": {
   "jp": "df505d18",
   "kr": "고기잡이 나갈 땐 나간다."
  },
  "11": {
   "jp": "13c04472",
   "kr": "쉴 때는 쉰다."
  },
  "12": {
   "jp": "059f4a9f",
   "kr": "지금 안 나가는 건 쉴 때니까 그렇다."
  },
  "13": {
   "jp": "d0f39f92",
   "kr": "딱히 가루가가 무서워서"
  },
  "14": {
   "jp": "257d2301",
   "kr": "안 나가는 게 아니다."
  },
  "15": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "16": {
   "jp": "e138f665",
   "kr": "요즘은 병사들도 들러 줘서"
  },
  "17": {
   "jp": "c4255e57",
   "kr": "우리 가게는 대성황이에요."
  },
  "18": {
   "jp": "881a1e14",
   "kr": "역시 가루가는 걱정이지만"
  },
  "19": {
   "jp": "d8e7525c",
   "kr": "물건이 팔리는 건 기쁘네요."
  },
  "20": {
   "jp": "7d83705d",
   "kr": "필요한 건 얼마든지 사 가세요."
  },
  "21": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "22": {
   "jp": "a1b479d4",
   "kr": "무슨 볼일로?"
  },
  "23": {
   "jp": "0ca70118",
   "kr": "마음에 드는 게 있나요?"
  },
  "24": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "25": {
   "jp": "af2f0029",
   "kr": "예요."
  },
  "26": {
   "jp": "349c2301",
   "kr": "필요 없는 물건은 기꺼이 사들입니다."
  },
  "27": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "28": {
   "jp": "67afcad1",
   "kr": "에 사들이겠습니다."
  },
  "29": {
   "jp": "8e93c275",
   "kr": "환율은 1라피카가 15 Pia예요."
  },
  "30": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "31": {
   "jp": "7da61f0d",
   "kr": "야."
  },
  "32": {
   "jp": "f2181726",
   "kr": "라피카가 없네요."
  },
  "33": {
   "jp": "f300cc06",
   "kr": "벌어 오시면, 또 오세요."
  },
  "34": {
   "jp": "05ecc145",
   "kr": "언제든지 사들이니까요."
  },
  "35": {
   "jp": "a517b0da",
   "kr": "다른 볼일은?"
  },
  "36": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "37": {
   "jp": "e536d2df",
   "kr": "또 오세요."
  },
  "38": {
   "jp": "6df99ba5",
   "kr": "난 말이야, 비가 와도 바람 불어도"
  },
  "39": {
   "jp": "124e1dbc",
   "kr": "하루도 고기잡이 안 나간 날이 없어."
  },
  "40": {
   "jp": "05b06a72",
   "kr": "허나, 임금님 명령이니…"
  },
  "41": {
   "jp": "edf1e50d",
   "kr": "제길, 바다에 나가고 싶다."
  },
  "42": {
   "jp": "55e275e2",
   "kr": "바다는 좋다고."
  },
  "43": {
   "jp": "869c74ad",
   "kr": "물고기가 팔딱팔딱 뛴다."
  },
  "44": {
   "jp": "a671fe1c",
   "kr": "제길"
  },
  "45": {
   "jp": "bb7346e9",
   "kr": "바다에 나가고파…"
  },
  "46": {
   "jp": "78cc2f69",
   "kr": "고기잡이 가고파."
  },
  "47": {
   "jp": "3cec17dd",
   "kr": "임금님이 바다에 나가지 말라고 말씀하셨거든."
  },
  "48": {
   "jp": "a9f85358",
   "kr": "우리 집 양반은 고기잡이를 못 나가니"
  },
  "49": {
   "jp": "baf26b8a",
   "kr": "안쪽에서 시무룩해 있어."
  },
  "50": {
   "jp": "3c1e490e",
   "kr": "우리 집 양반 마음도 알겠지만."
  },
  "51": {
   "jp": "dcfe9e0f",
   "kr": "집 안에서 삐쳐 있다니"
  },
  "52": {
   "jp": "775f2ac7",
   "kr": "바다 사나이란 의외로 애 같다니까."
  },
  "53": {
   "jp": "5911e0c4",
   "kr": "어부들이 바다에 나가지 않게"
  },
  "54": {
   "jp": "930da1a7",
   "kr": "지켜보고 있는 거야."
  },
  "55": {
   "jp": "49d59757",
   "kr": "언제 가루가가 올지 모르니까,"
  },
  "56": {
   "jp": "1fab08e8",
   "kr": "지금 앞바다에 나가면"
  },
  "57": {
   "jp": "750cd659",
   "kr": "아주 위험하거든."
  },
  "58": {
   "jp": "62c559db",
   "kr": "어부들도"
  },
  "59": {
   "jp": "4b456d82",
   "kr": "납득해 주고 있는 모양이지만."
  },
  "60": {
   "jp": "a28c3460",
   "kr": "만에 하나 무슨 일이 있으면 안 되니까."
  }
 }
}