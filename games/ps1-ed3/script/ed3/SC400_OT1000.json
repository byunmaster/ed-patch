  },
  "93": {
   "jp": "16266899",
   "kr": "늘 여기서 보고 있었으니까"
  },
  "94": {
   "jp": "867f3221",
   "kr": "나도 마음이 쓰였다고."
  },
  "95": {
   "jp": "d4600213",
   "kr": "아래쪽 류넬도,"
  },
  "96": {
   "jp": "993cb7a2",
   "kr": "네가 약을 구하러 올도스를 떠난 뒤로"
  },
  "97": {
   "jp": "2df73466",
