  "49": {
   "jp": "183abae4",
   "kr": "앗, 맞다 맞다."
  },
  "50": {
   "jp": "e7f628d6",
   "kr": "이 환율은 지난달까지 거였어."
  },
  "51": {
   "jp": "688b77d4",
   "kr": "지금은 15 Pia로 하고 있어."
  },
  "52": {
   "jp": "dd92323c",
   "kr": "그래도 괜찮겠냐?"
  },
  "53": {
   "jp": "ead9e71f",
   "kr": "아니, 잘못 알려 줘서 미안하군."
  },
  "54": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "55": {
   "jp": "67981c16",
   "kr": "다니까."
  },
  "56": {
   "jp": "2b3438e2",
   "kr": "이런이런, 라피카가 없나 보군."
  },
  "57": {
   "jp": "ff297950",
   "kr": "얼른 모아 오라고."
