  "167": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "168": {
   "jp": "2bba2234",
   "kr": "쥬리오 군, 힘내렴."
  },
  "169": {
   "jp": "39254f12",
   "kr": "여관 사람들에겐"
  },
  "170": {
   "jp": "a523fa20",
   "kr": "내가 전해 두마."
  },
  "171": {
   "jp": "f7f9fc7d",
   "kr": "친구 병은 나은 모양이구나?"
  },
  "172": {
   "jp": "c31f6943",
   "kr": "대성당에는 아직 안 갔구나."
  },
  "173": {
   "jp": "018d4161",
   "kr": "얼른 가 보렴."
  },
  "174": {
   "jp": "21415159",
   "kr": "그게 너희 목적이잖니?"
  },
  "175": {
   "jp": "9fbb50f6",
   "kr": "친구 상태는 좀 어때?"
  },
  "176": {
   "jp": "db5a78de",
   "kr": "그게, 퓨엔테에 가야"
  },
  "177": {
   "jp": "9f2b9a57",
   "kr": "하게 됐어요."
  },
  "178": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "179": {
   "jp": "07c82c55",
   "kr": "퓨엔테에!"
  },
  "180": {
   "jp": "5062a923",
   "kr": "달랑 혼자서?"
  },
  "181": {
   "jp": "1d203e20",
   "kr": "퓨엔테엔 저주를 푸는 비약을 만들 줄 아는"
  },
  "182": {
   "jp": "076b290b",
   "kr": "리즈란 분이 있대요."
  },
  "183": {
   "jp": "f1c76d65",
   "kr": "그래, 조심해서 가야 한다."
  },
  "184": {
   "jp": "e39fef46",
   "kr": "퓨엔테에 가려면"
  },
  "185": {
   "jp": "a0baa89e",
   "kr": "이 앞 갈림길에서 남쪽으로 내려가는 거야."
  },
  "186": {
   "jp": "2d80bfd1",
   "kr": "알겠지, 남쪽이다."
  },
  "187": {
   "jp": "aace8142",
   "kr": "응, 알았어."
  },
  "188": {
   "jp": "6769dca5",
   "kr": "필로 선생님은 만났는데"
  },
  "189": {
   "jp": "31341372",
   "kr": "파렌 씨가 갖고 있는 책을 보지 않으면"
  },
  "190": {
   "jp": "eed7eaab",
   "kr": "모르신대요."
  },
  "191": {
   "jp": "d6c79de5",
   "kr": "네. 지금 필로 선생님을"
  },
  "192": {
   "jp": "a771b8c6",
   "kr": "찾고 있는 참이에요."
  },
  "193": {
   "jp": "381e7315",
   "kr": "그래, 큰일이구나."
  },
  "194": {
   "jp": "13ce7140",
   "kr": "얼른 나으면 좋을 텐데."
  },
  "195": {
   "jp": "cf7a04f0",
   "kr": "쥬리오 씨!"
  },
  "196": {
   "jp": "84dc338f",
   "kr": "걱정했어요."
  },
  "197": {
   "jp": "e36cde72",
   "kr": "이런, 그분들은…?"
  },
  "198": {
   "jp": "0d3d3fdc",
   "kr": "이분은"
  },
  "199": {
   "jp": "443d5f0c",
   "kr": "퓨엔테의 조약사 리즈의 딸 휘리."
  },
  "200": {
   "jp": "9a6c859e",
   "kr": "리즈 대신 와 주셨어요."
  },
  "201": {
   "jp": "30ca1e1a",
   "kr": "그리고, 구스의 친구인 샤라예요."
  },
  "202": {
   "jp": "a83577aa",
   "kr": "그렇습니까."
  },
  "203": {
   "jp": "38cad368",
   "kr": "그럼 두 분 입국 수속도 바로 하죠."
  },
  "204": {
   "jp": "1965772b",
   "kr": "그래서, 약은요?"
  },
  "205": {
   "jp": "8fb4b85f",
   "kr": "재료는 손에 넣었어요."
  },
  "206": {
   "jp": "fba4aaeb",
   "kr": "이제 휘리가"
  },
  "207": {
   "jp": "a0fb70aa",
   "kr": "비약을 만들어 주기만 하면 돼요."
  },
  "208": {
   "jp": "5cee38f5",
   "kr": "다행이에요. 이걸로 저주가 풀리겠네요."
  },
  "209": {
   "jp": "731afb2a",
   "kr": "알겠습니다."
  },
  "210": {
   "jp": "34fb99c7",
   "kr": "두 분 수속은 제가 해 둘 테니,"
  },
  "211": {
   "jp": "d665f8a7",
   "kr": "얼른 여관으로 가 주세요."
  },
  "212": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "213": {
   "jp": "42dfb8fa",
   "kr": "그럼, 여기서 저는 이만."
  },
  "214": {
   "jp": "b0b62de3",
   "kr": "왠지 그립네."
  },
  "215": {
   "jp": "722f1be1",
   "kr": "여러 일이 있었습니다만,"
  },
  "216": {
   "jp": "f9244d2f",
   "kr": "즐거운 여행이었습니다."
  },
  "217": {
   "jp": "fb9e70aa",
   "kr": "부디, 앞으로도 몸조심하시고"
  },
  "218": {
   "jp": "991a2ecf",
   "kr": "무사히 고향까지 돌아가시기 바랍니다."
  },
  "219": {
   "jp": "09262b4e",
   "kr": "네, 고마워요."
  },
  "220": {
   "jp": "a048db1a",
   "kr": "그럼, 안녕히."
  },
  "221": {
   "jp": "8b26e446",
   "kr": "모리슨 씨도 잘 지내세요."
  },
  "222": {
   "jp": "e8e5c9a5",
   "kr": "마기사 씨께도 안부 전해요!"
  },
  "223": {
   "jp": "1131d658",
   "kr": "알겠습니다!"
  },
  "224": {
   "jp": "5eb1f1fb",
   "kr": "안녕히 가세요, 모리슨 씨!"
  },
  "225": {
   "jp": "5456a53d",
   "kr": "성에 아직 로디가 있으면"
  },
  "226": {
   "jp": "1186b3b9",
   "kr": "쫓아내도 괜찮으니까요!"
  },
  "227": {
   "jp": "ad4df66d",
   "kr": "명심하겠습니다!"
  },
  "228": {
   "jp": "cf3b98eb",
   "kr": "잘 가요!"
  },
  "229": {
   "jp": "c4e2525b",
   "kr": "안녕히 계세요!"
  },
  "230": {
   "jp": "ba337272",
   "kr": "가 버렸네."
  },
  "231": {
   "jp": "88149875",
   "kr": "네."
  },
  "232": {
   "jp": "4bc8ce02",
   "kr": "왠지 몹쓸 짓을 한 것 같아."
  },
  "233": {
   "jp": "010d2ed8",
   "kr": "그렇지 않아."
  },
  "234": {
   "jp": "09f43c29",
   "kr": "분명…"
  },
  "235": {
   "jp": "e3b2d406",
   "kr": "자, 가시지요."
  },
  "236": {
   "jp": "c239d160",
   "kr": "이별은 언제나 괴로운 법이에요."
  },
  "237": {
   "jp": "b49254bc",
   "kr": "저는 쥬리오 씨와 헤어질 때"
  },
  "238": {
   "jp": "7f869e0a",
   "kr": "울어 버릴지도 몰라요."
  },
  "239": {
   "jp": "23c76720",
   "kr": "……?"
  },
  "240": {
   "jp": "50a76a04",
   "kr": "휘리가 파티에 합류했다."
  },
  "241": {
   "jp": "ec3375ac",
   "kr": "자, 가시지요!"
  },
  "242": {
   "jp": "3b3448c5",
   "kr": "카지무의 저주도 풀려 쥬리오와 크리스는"
  },
  "243": {
   "jp": "dc59782f",
   "kr": "마침내 마지막 샤리네, 올도스 대성당의"
  },
  "244": {
   "jp": "9a4bb017",
   "kr": "마법의 거울을 봤다. 하지만…쥬리오들이"
  },
  "245": {
   "jp": "98aa7a24",
   "kr": "거울에서 받은 메시지는 너무 무거웠다."
  },
  "246": {
   "jp": "f9851d2f",
   "kr": "라우알의 파도가 나타난다."
  },
  "247": {
   "jp": "d7fedfe0",
   "kr": "하나의 문명이 멸망할 때, 대지의 모든 것을"
  },
  "248": {
   "jp": "174c5ff4",
   "kr": "뒤덮는다는 파멸의 파도. 쥬리오와 크리스는"
  },
  "249": {
   "jp": "8339b83f",
   "kr": "하얀마녀가 남긴 작은 단서를 의지해 곧장"
  },
  "250": {
   "jp": "961d0897",
   "kr": "폴티아의 루드성으로 향하는 것이었다."
  },
  "251": {
   "jp": "2b001fc4",
   "kr": "제４장　성수가 사는 숲　끝"
  }
 }
}