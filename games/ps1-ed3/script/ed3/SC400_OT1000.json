  "58": {
   "jp": "f52e7ba9",
   "kr": "그런가…"
  },
  "59": {
   "jp": "d3d3aa7e",
   "kr": "미안하게 됐어. 괜히 기대하게 해서."
  },
  "60": {
   "jp": "567d08de",
   "kr": "달리 해 줄 일은 있나?"
  },
  "61": {
   "jp": "690ccc71",
   "kr": "또 들러 달라고."
  },
  "62": {
   "jp": "a82aa7d7",
   "kr": "올도스는 성자의 마을이니까요."
  },
  "63": {
   "jp": "6b94bf74",
   "kr": "싸움을 위한 무기를 파는 무기점은"
  },
  "64": {
   "jp": "2c4a392f",
   "kr": "마을 안에 들어올 수 없답니다."
  },
  "65": {
   "jp": "2ddc226e",
   "kr": "올도스는 성스러운 도시라서"
  },
  "66": {
   "jp": "d6984330",
   "kr": "마을 안에서는 무기 판매는 못 해요."
  },
  "67": {
   "jp": "bfef6725",
   "kr": "하지만 나그네가 마수에게서 몸을 지키려면"
  },
  "68": {
   "jp": "cbb0c94d",
   "kr": "무기도 필요하잖아요. 그래서 관문 밖에서의"
  },
  "69": {
   "jp": "13398226",
   "kr": "판매는 허락돼 있어요."
  },
  "70": {
   "jp": "83fc7721",
   "kr": "무기점만은 마을 밖이지만"
  },
  "71": {
   "jp": "aec8687d",
   "kr": "나머지 가게는 마을 안에 있으니"
  },
  "72": {
   "jp": "3023d4e3",
   "kr": "거기서 쇼핑할 수 있어요."
  },
  "73": {
   "jp": "eae0899a",
   "kr": "잘됐어요."
  },
  "74": {
   "jp": "05d7af8c",
   "kr": "모처럼 올도스까지 왔는데"
  },
  "75": {
   "jp": "74615830",
