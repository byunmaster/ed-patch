  },
  "43": {
   "jp": "c55ccc9e",
   "kr": "낼 테니, 꼭 팔아 다오."
  },
  "44": {
   "jp": "8b1104c4",
   "kr": "우리 환전율은 높아."
  },
  "45": {
   "jp": "191187c3",
   "kr": "큰 소리로는 말 못 하지만"
  },
  "46": {
   "jp": "90103862",
   "kr": "1 Goa가 20 Pia야."
  },
  "47": {
   "jp": "3c75b61a",
   "kr": "환전하겠냐?"
