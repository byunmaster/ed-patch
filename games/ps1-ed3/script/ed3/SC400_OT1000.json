  },
  "161": {
   "jp": "cab72c70",
   "kr": "그래도, 조금만 더예요."
  },
  "162": {
   "jp": "da551cf8",
   "kr": "꼭 찾아서"
  },
  "163": {
   "jp": "f5d5cd87",
   "kr": "금방 돌아올게요."
  },
  "164": {
   "jp": "587a18b6",
   "kr": "알았어."
  },
  "165": {
   "jp": "39254f12",
   "kr": "여관 사람들에겐"
  },
  "166": {
   "jp": "a523fa20",
   "kr": "내가 전해 두마."
