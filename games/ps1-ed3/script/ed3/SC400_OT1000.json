  "137": {
   "jp": "6bf26b79",
   "kr": "리스베"
  },
  "138": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "139": {
   "jp": "26919cf8",
   "kr": "그랬던 거야… 몰랐다고."
  },
  "140": {
   "jp": "1691aee8",
   "kr": "섣불리 넘겨짚고"
  },
  "141": {
   "jp": "1c5f03e2",
   "kr": "마을로 안 돌아가서 다행이다."
  },
  "142": {
   "jp": "d164926c",
   "kr": "이제부터, 느긋하게"
  },
  "143": {
   "jp": "51f51acd",
   "kr": "올도스를 구경하기로 할까."
  },
  "144": {
   "jp": "9b899214",
   "kr": "대성당을 보러 왔는데"
  },
  "145": {
   "jp": "0e9d38b2",
