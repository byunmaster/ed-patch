  },
  "33": {
   "jp": "0ae72bd6",
   "kr": "자, 좀 보고 가라고."
  },
  "34": {
   "jp": "785f6ecf",
   "kr": "어느 무기든 괜찮다고."
  },
  "35": {
   "jp": "33c20efb",
   "kr": "얼른 골라 달라고."
  },
  "36": {
   "jp": "c1654371",
   "kr": "인가…"
  },
  "37": {
   "jp": "dba027db",
   "kr": "좋아, 큰맘 먹고"
  },
  "38": {
   "jp": "b346a5a3",
   "kr": "면 되겠어."
  },
  "39": {
   "jp": "9bee4746",
   "kr": "뭘 팔아 줄 건가?"
  },
  "40": {
   "jp": "079016ce",
   "kr": "쓸모 있는 게 좋은데…"
  },
  "41": {
   "jp": "6beef6d9",
   "kr": "그, 그건 환상의"
  },
  "42": {
   "jp": "3fd7d156",
