  },
  "78": {
   "jp": "cd546790",
   "kr": "얘, 너 방향 감각은 좋은 편이니?"
  },
  "79": {
   "jp": "e646911e",
   "kr": "응, 완벽해"
  },
  "80": {
   "jp": "921ab635",
   "kr": "안 돼요"
  },
  "81": {
   "jp": "a406f727",
   "kr": "그럼, 걱정 없겠구나."
  },
  "82": {
   "jp": "b964098a",
   "kr": "남쪽으로 내려가면 앰비쉬 쪽과"
  },
  "83": {
   "jp": "2d910eae",
   "kr": "퓨엔테 쪽으로 빠지는 갈림 관문이 있으니"
  },
  "84": {
   "jp": "eed61ed0",
   "kr": "꼭 퓨엔테 쪽으로 빠져나가야 한다."
  },
  "85": {
   "jp": "5ab5164c",
   "kr": "이런이런, 잘 들으렴."
  },
  "86": {
   "jp": "b964098a",
   "kr": "남쪽으로 내려가면 앰비쉬 쪽과"
  },
  "87": {
   "jp": "2d910eae",
   "kr": "퓨엔테 쪽으로 빠지는 갈림 관문이 있으니"
  },
  "88": {
   "jp": "8945f8b6",
   "kr": "꼭 퓨엔테 쪽으로 빠져나가는 거다."
