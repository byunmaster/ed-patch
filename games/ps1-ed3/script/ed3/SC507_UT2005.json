 "member": "..\\DATA\\UT2005.BIN",
 "lines": {
  "0": {
   "jp": "dcfb75fa",
   "kr": "트리프 관문"
  },
  "1": {
   "jp": "c182c53c",
   "kr": "우돌 병사"
  },
  "2": {
   "jp": "f0a625a0",
   "kr": "챠펠의 라포르"
  },
  "3": {
   "jp": "d740f65a",
   "kr": "우르바"
  },
  "4": {
   "jp": "dcfb75fa",
   "kr": "트리프 관문"
  },
  "5": {
   "jp": "95bcc126",
   "kr": "여어, 수고가 많네."
  },
  "6": {
   "jp": "bcca9870",
   "kr": "여기서부터는 시플이나 올도스"
  },
  "7": {
   "jp": "f1cb5af2",
   "kr": "게다가 퓨엔테 쪽으로 갈 수 있어."
  },
  "8": {
   "jp": "c735845b",
   "kr": "출구를 착각하지 말게나."
  },
  "9": {
   "jp": "96524838",
   "kr": "우돌 쪽으로 빠지는 건 그대로 가세요."
  },
  "10": {
   "jp": "381e8bd8",
   "kr": "하이젠, 홀크로 향할 때는"
  },
  "11": {
   "jp": "5cdc136f",
   "kr": "각 담당자에게 통행증을 보이게나."
  },
  "12": {
   "jp": "5acd1ad4",
   "kr": "하이젠 쪽은 서쪽 방으로,"
  },
  "13": {
   "jp": "59f8c7b9",
   "kr": "홀크 쪽은 동쪽 방으로 가세요."
  },
  "14": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "15": {
   "jp": "24489435",
   "kr": "은단검이군요."
  },
  "16": {
   "jp": "3bbcb4da",
   "kr": "지나셔도 괜찮습니다만"
  },
  "17": {
   "jp": "784b9618",
   "kr": "이쪽은 하이젠으로 가는 길이에요."
  },
  "18": {
   "jp": "035ddc4f",
   "kr": "괜찮으시겠습니까?"
  },
  "19": {
   "jp": "fd7d460c",
   "kr": "앗, 잘못 왔어요."
  },
  "20": {
   "jp": "714aaac1",
   "kr": "미안해요."
  },
  "21": {
   "jp": "354ce955",
   "kr": "이쪽이 아니었어요."
  },
  "22": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "23": {
   "jp": "34706559",
   "kr": "오, 은단검이군요."
  },
  "24": {
   "jp": "050b4eac",
   "kr": "이쪽은 홀크로 가는 길이에요."
  },
  "25": {
   "jp": "035ddc4f",
   "kr": "괜찮으시겠습니까?"
  },
  "26": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "27": {
   "jp": "a2f8e49b",
   "kr": "홀크 쪽으로 가는 거야."
  },
  "28": {
   "jp": "80b33a22",
   "kr": "자, 지나가세요."
  },
  "29": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "30": {
   "jp": "0fc60cbb",
   "kr": "저는 챠펠의 라포르입니다."
  },
  "31": {
   "jp": "a89fb4eb",
   "kr": "챠펠 마법을 다루는 분이 계시다면"
  },
  "32": {
   "jp": "b89b05c4",
   "kr": "마법을 전수해 드리지요."
  },
  "33": {
   "jp": "89255841",
   "kr": "어느 분께 전수할까요?"
  },
  "34": {
   "jp": "a8605649",
   "kr": "어느 마법을 원하시나요?"
  },
  "35": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "36": {
   "jp": "ee1ddb7d",
   "kr": "마음이 내키면 저를 찾아와 주세요."
  },
  "37": {
   "jp": "511560e8",
   "kr": "이 관문을 넘으면"
  },
  "38": {
   "jp": "79ca9aa3",
   "kr": "퓨엔테구나."
  },
  "39": {
   "jp": "eba8c67e",
   "kr": "지금까지 고마웠어."
  },
  "40": {
   "jp": "533ee5ca",
   "kr": "휘리 씨와는 여기서 작별이네."
  },
  "41": {
   "jp": "30dcd03c",
   "kr": "저기…"
  },
  "42": {
   "jp": "c137f3ff",
   "kr": "저, 도중까지 안내할게요."
  },
  "43": {
   "jp": "178d5064",
   "kr": "어, 왜?"
  },
  "44": {
   "jp": "780d4c48",
   "kr": "넌 하이젠 쪽 사람이잖아?"
  },
  "45": {
   "jp": "48ada722",
   "kr": "홀크까지는 아주 험한 길이에요."
  },
  "46": {
   "jp": "391ba02e",
   "kr": "두 분만으로는 걱정돼요."
  },
  "47": {
   "jp": "b5b2fe87",
   "kr": "그치만"
  },
  "48": {
   "jp": "9fa3af51",
   "kr": "홀크에서 휘리 씨는"
  },
  "49": {
   "jp": "07469ab2",
   "kr": "어떻게 돌아갈 셈이에요?"
  },
  "50": {
   "jp": "75d13014",
   "kr": "전 괜찮아요."
  },
  "51": {
   "jp": "ad2c6eef",
   "kr": "안내해 드릴 만한 길은 아니지만,"
  },
  "52": {
   "jp": "87e3474f",
   "kr": "홀크에서 우리 집으로 가는 지름길이 있어요."
  },
  "53": {
   "jp": "651dfd6d",
   "kr": "늘 약초를 모으는 짐승 길이에요."
  },
  "54": {
   "jp": "b49f0c6d",
   "kr": "저 혼자서도 돌아갈 수 있어요."
  },
  "55": {
   "jp": "546006c1",
   "kr": "그러니 홀크까지 함께 갈게요."
  },
  "56": {
   "jp": "cb2499ff",
   "kr": "쥬리오 씨가 괜찮으시다면."
  },
  "57": {
   "jp": "23c76720",
   "kr": "……?"
  },
  "58": {
   "jp": "a45f2dc7",
   "kr": "난…딱히 상관없는데."
  },
  "59": {
   "jp": "18899447",
   "kr": "크리스는?"
  },
  "60": {
   "jp": "14b49fb2",
   "kr": "괜찮지 않을까~."
  },
  "61": {
   "jp": "c3a099f7",
   "kr": "왜, 왜 갑자기 큰 소리를 내는 거야."
  },
  "62": {
   "jp": "72dd6b91",
   "kr": "아무것도…"
  },
  "63": {
   "jp": "7b7aa4dd",
   "kr": "좋아요."
  },
  "64": {
   "jp": "d9cd47c3",
   "kr": "동료가 많은 쪽이 든든하니까."
  },
  "65": {
   "jp": "82bddc11",
   "kr": "그럼, 결정이네요."
  },
  "66": {
   "jp": "38d5a266",
   "kr": "저도 가겠어요."
  }
 }
}