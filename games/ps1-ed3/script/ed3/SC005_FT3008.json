  "9": {
   "jp": "5572e922",
   "kr": "제법인데."
  },
  "10": {
   "jp": "6fbd2b01",
   "kr": "난 여자에겐 상냥하지만"
  },
  "11": {
   "jp": "392c2228",
   "kr": "공교롭게도 18세 미만은 대상 밖이다!"
  },
  "12": {
   "jp": "a5a25b0f",
   "kr": "메롱〜"
  },
  "13": {
   "jp": "23762943",
   "kr": "빠직!"
  },
  "14": {
   "jp": "b705113b",
   "kr": "이번엔 너냐!"
  },
  "15": {
   "jp": "8a3d69a6",
   "kr": "우리를 여기까지 뛰게 하다니"
  },
  "16": {
   "jp": "865a1623",
   "kr": "대단한 놈들이야."
  },
  "17": {
   "jp": "ddfb78f0",
   "kr": "자, 너희들."
  },
  "18": {
   "jp": "b71b33a6",
   "kr": "그 가방을 내놔."
  },
  "19": {
   "jp": "beb91543",
   "kr": "애초에 그놈한테서 가방을 되찾은 건"
  },
  "20": {
   "jp": "c87421b4",
   "kr": "우리들이라고."
  },
  "21": {
   "jp": "0c189919",
   "kr": "부탁한 적 없거든!"
  },
  "22": {
   "jp": "5ee4eaff",
   "kr": "…말버릇 한번 귀엽구나."
  },
  "23": {
   "jp": "f23c7af9",
   "kr": "난 여자한테는 봐주지 않아."
  },
  "24": {
   "jp": "8ff882ae",
   "kr": "잠깐 기다려!"
  },
  "25": {
   "jp": "dfef9f83",
   "kr": "어째서 수부가 저기서 자는 거야?"
  },
  "26": {
   "jp": "d5a419bc",
   "kr": "…설마, 그 좀도둑이"
  },
  "27": {
   "jp": "ffbb7891",
   "kr": "모조리 재워 버린 거냐!?"
  },
  "28": {
   "jp": "f172a96d",
   "kr": "맞아."
  },
  "29": {
   "jp": "1b28c034",
   "kr": "맞아라니…"
  },
  "30": {
   "jp": "d7936bac",
   "kr": "이 배는 그냥 떠내려가고 있는 거잖아!"
  },
  "31": {
   "jp": "c1f366cf",
   "kr": "그렇구나!"
  },
  "32": {
   "jp": "b289e1f7",
   "kr": "가루가 둥지에"
  },
  "33": {
   "jp": "0e9bf1b1",
   "kr": "들어가 버리면 큰일이야!"
  },
  "34": {
   "jp": "c096febd",
   "kr": "이제 와서 놀라서 뭐 하냐."
  },
  "35": {
   "jp": "689d15ca",
   "kr": "배를 몰 줄 아는 놈은?"
  },
  "36": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "37": {
   "jp": "59b4d973",
   "kr": "맞다!"
  },
  "38": {
   "jp": "840579f6",
   "kr": "허크 삼촌이라면."
  },
  "39": {
   "jp": "5807554f",
   "kr": "누구야, 그게?"
  },
  "40": {
   "jp": "6cecec29",
   "kr": "뱃사람이야?"
  },
  "41": {
   "jp": "e0556c7d",
   "kr": "우리 삼촌이야."
  },
  "42": {
   "jp": "eeb18530",
   "kr": "좀 별나긴 하지만"
  },
  "43": {
   "jp": "53e95290",
   "kr": "여러 가지 알고 있으니까"
  },
  "44": {
   "jp": "32027e9f",
   "kr": "도와줄지도 몰라."
  },
  "45": {
   "jp": "8a07b228",
   "kr": "좋아, 일단 휴전이다."
  },
  "46": {
   "jp": "2832136c",
   "kr": "그 허크 삼촌이라는 사람한테"
  },
  "47": {
   "jp": "1b3572a5",
   "kr": "걸어 보자고."
  },
  "48": {
   "jp": "5c43e224",
   "kr": "…뭐야, 그 의심 가득한 눈초리는."
  },
  "49": {
   "jp": "66daf50d",
   "kr": "안심해, 약속은 지킨다."
  },
  "50": {
   "jp": "11e15882",
   "kr": "그게 내 신조다."
  },
  "51": {
   "jp": "ee6c3f14",
   "kr": "정말이지?"
  },
  "52": {
   "jp": "7b756742",
   "kr": "나, 허크 삼촌을 데려올게."
  },
  "53": {
   "jp": "00151cac",
   "kr": "응. 보스레이 씨가"
  },
  "54": {
   "jp": "d254ea43",
   "kr": "방 열쇠를 갖고 있을 거야."
  },
  "55": {
   "jp": "7b4e50bd",
   "kr": "다녀올게."
  },
  "56": {
   "jp": "a39e3308",
   "kr": "그 허크 씨라는 사람은"
  },
  "57": {
   "jp": "152aca52",
   "kr": "믿을 만하냐?"
  },
  "58": {
   "jp": "20fade12",
   "kr": "…대단한 사람이란 느낌은 들어."
  },
  "59": {
   "jp": "289aa812",
   "kr": "그 말을 믿어 보기로 하지."
  },
  "60": {
   "jp": "a272172b",
   "kr": "아, 돌아왔어."
  },
  "61": {
   "jp": "06b7234d",
   "kr": "얘기는 크리스한테 들었다."
  },
  "62": {
   "jp": "25ed525e",
   "kr": "일손이 될 수 있는 건 이 다섯뿐이구나."
  },
  "63": {
   "jp": "8d0f53d0",
   "kr": "내가 말한 대로 다들 나눠서 하면"
  },
  "64": {
   "jp": "244bbf0f",
   "kr": "아마 무사히 닐리에 닿을 거다."
  },
  "65": {
   "jp": "49703cff",
   "kr": "아마… 라니."
  },
  "66": {
   "jp": "bb225da4",
   "kr": "절대 자신은 없다… 는 거냐?"
  },
  "67": {
   "jp": "f725295a",
   "kr": "그래, 그 말대로다."
  },
  "68": {
   "jp": "e61d23fe",
   "kr": "이 세상에 절대라는 것은"
  },
  "69": {
   "jp": "227cb8f7",
   "kr": "절대로 없다!"
  },
  "70": {
   "jp": "5f5f0215",
   "kr": "고고학도 마법학도"
  },
  "71": {
   "jp": "6adeb572",
   "kr": "모름지기 아마인 것이다."
  },
  "72": {
   "jp": "36dad1cb",
   "kr": "게다가 나는 항해술이라는 걸 모른다."
  },
  "73": {
   "jp": "a2fafa49",
   "kr": "이봐 이봐, 당당하게도 말하는군."
  },
  "74": {
   "jp": "84c81c32",
   "kr": "허나 큰 배를 탔다 여기게."
  },
  "75": {
   "jp": "6d676c19",
   "kr": "큰 배엔 이미 타고 있잖아!"
  },
  "76": {
   "jp": "e6ee8512",
   "kr": "이제부터 어쩔 셈이야?"
  },
  "77": {
   "jp": "5999adcf",
   "kr": "그게 부탁하는 자의 태도인가?"
  },
  "78": {
   "jp": "6391c0c0",
   "kr": "내 지식을 경청하겠다는"
  },
  "79": {
   "jp": "6fef1f43",
   "kr": "자세가 전혀 느껴지지 않는군."
  },
  "80": {
   "jp": "40a6ad6e",
   "kr": "허크 삼촌!!"
  },
  "81": {
   "jp": "ea1304e9",
   "kr": "적당히 좀 해!"
  },
  "82": {
   "jp": "ced0ccac",
   "kr": "그런 말 하는 사이에도"
  },
  "83": {
   "jp": "6ed9d103",
   "kr": "배는 제멋대로 나아가고 있단 말이야!"
  },
  "84": {
   "jp": "15589f57",
   "kr": "미안했다."
  },
  "85": {
   "jp": "e59f2115",
   "kr": "이런 삼촌을 버리지 말아 다오."
  },
  "86": {
   "jp": "151afb3f",
   "kr": "좋아! 당장 착수해 볼까."
  },
  "87": {
   "jp": "1769ee26",
   "kr": "쥬리오 군과 크리스는 좌현 밧줄 쪽으로!"
  },
  "88": {
   "jp": "566d9b3c",
   "kr": "그쪽 자네들은 우현 밧줄을 부탁한다."
  },
  "89": {
   "jp": "9f3de146",
   "kr": "삼촌〜!"
  },
  "90": {
   "jp": "522326f5",
   "kr": "준비 오케이야."
  },
  "91": {
   "jp": "2894af5a",
   "kr": "이쪽도 됐어!"
  },
  "92": {
   "jp": "004810c6",
   "kr": "그럼 시작해 볼까."
  },
  "93": {
   "jp": "e67da05f",
   "kr": "이 계절, 차가운 바람은 메나트의 산바람."
  },
  "94": {
   "jp": "e93d8d7b",
   "kr": "그렇다면… 해류와 편서풍의 영향을 생각해"
  },
  "95": {
   "jp": "fc08197a",
   "kr": "돛은 좌 45도 부근을 유지."
  },
  "96": {
   "jp": "00f53d80",
   "kr": "흠흠. 항로를 벗어난 지"
  },
  "97": {
   "jp": "436a4d86",
   "kr": "대략 세 시간이라 치면…"
  },
  "98": {
   "jp": "a1c72c3e",
   "kr": "아마, 이 정도 수정이면 되겠지."
  },
  "99": {
   "jp": "8977ea3d",
   "kr": "좋아, 쥬리오 군!"
  },
  "100": {
   "jp": "ccd2baa5",
   "kr": "그쪽 밧줄을 늦춰 다오!"
  },
  "101": {
   "jp": "9a847aa5",
   "kr": "자, 우현 사람들!"
  },
  "102": {
   "jp": "4993da10",
   "kr": "그쪽은 힘껏 잡아당겨!"
  },
  "103": {
   "jp": "5e3ab656",
   "kr": "젠장…"
  },
  "104": {
   "jp": "57f76bb9",
   "kr": "나한테 막일을 시키다니!"
  },
  "105": {
   "jp": "d61babb4",
   "kr": "돛이 느슨하다!"
  },
  "106": {
   "jp": "0129c723",
   "kr": "더 세게 잡아당겨!"
  },
  "107": {
   "jp": "f24e9360",
   "kr": "하고 있어!"
  },
  "108": {
   "jp": "2f227d54",
   "kr": "이제 손 아파."
  },
  "109": {
   "jp": "cc64fa5f",
   "kr": "쥬리오, 우는소리 하면"
  },
  "110": {
   "jp": "f539eea8",
   "kr": "겁쟁이가 돼 버려."
  },
  "111": {
   "jp": "a4234bda",
   "kr": "하나도 안 아파."
  },
  "112": {
   "jp": "0811a7fd",
   "kr": "좋아, 크리스, 쥬리오 군!"
  },
  "113": {
   "jp": "acdffea8",
   "kr": "그 기세다."
  },
  "114": {
   "jp": "31119fc1",
   "kr": "온 하늘에 별이 떴지만 다섯 사람은"
  },
  "115": {
   "jp": "b37a2af1",
   "kr": "잘 수도 없었다. 잠든 질버 선장 일행은"
  },
  "116": {
   "jp": "d9ad3061",
   "kr": "안 깬다. 허크의 지시는 밤새 이어졌다."
  },
  "117": {
   "jp": "3103fead",
   "kr": "좋아! 저기 희미하게 보이는 건"
  },
  "118": {
   "jp": "a87cd9d9",
   "kr": "틀림없이 메나트의 해안선이다!!"
  },
  "119": {
   "jp": "29831330",
   "kr": "이제 이걸로 안심이다."
  },
  "120": {
   "jp": "4abd6fc8",
   "kr": "어때! 내 지시의 정확함은!"
  },
  "121": {
   "jp": "c53bc5a4",
   "kr": "…어라?"
  },
  "122": {
   "jp": "a0d9d43d",
   "kr": "뭐야… 다들 자고 있는 건가?"
  },
  "123": {
   "jp": "93bb476a",
   "kr": "완전히 잠들고 말았다."
  },
  "124": {
   "jp": "1609b435",
   "kr": "이거 참, 면목 없군."
  },
  "125": {
   "jp": "330a3270",
   "kr": "질버 선장님, 항로는 괜찮습니다."
  },
  "126": {
   "jp": "ff7f303f",
   "kr": "쥬리오 군네가"
  },
  "127": {
   "jp": "6658c491",
   "kr": "힘써 주었으니까요."
  },
  "128": {
   "jp": "cff6578f",
   "kr": "도둑맞은 물건도 크리스가 되찾아"
  },
  "129": {
   "jp": "43416ceb",
   "kr": "방에 보관해 두었습니다."
  },
  "130": {
   "jp": "086bd234",
   "kr": "배의 침로를 지키려고"
  },
  "131": {
   "jp": "500ecc64",
   "kr": "다들 밤새 일해 주었구나."
  },
  "132": {
   "jp": "8a5a4c81",
   "kr": "우리가 살아난 건"
  },
  "133": {
   "jp": "8301a917",
   "kr": "쥬리오 군과 크리스 양 덕분이야."
  },
  "134": {
   "jp": "0bffa8a7",
   "kr": "잠시 푹 자게 해 주자."
  },
  "135": {
   "jp": "14e03513",
   "kr": "정말이야."
  },
  "136": {
   "jp": "cd4606fe",
   "kr": "근데 이런 큰일을 해냈다곤 안 믿길 만큼"
  },
  "137": {
   "jp": "faf8d961",
   "kr": "잠든 얼굴이 앳되네."
  },
  "138": {
   "jp": "f7fc8140",
   "kr": "여기는 바람이 차니까"
  },
  "139": {
   "jp": "08f79df9",
   "kr": "감기라도 걸리면 큰일입니다."
  },
  "140": {
   "jp": "91a95ef3",
   "kr": "나눠서 선실로 옮깁시다."
  },
  "141": {
   "jp": "cea4056e",
   "kr": "곧 보스레이 일행도 올라올 테니"
  },
  "142": {
   "jp": "003693d8",
   "kr": "입항 준비는 우리에게 맡겨 주십시오."
  },
  "143": {
   "jp": "27148f76",
   "kr": "허크 씨도 정말 수고 많으셨습니다."
  },
  "144": {
   "jp": "9b1b5f3d",
   "kr": "하, 하하하하!"
  },
  "145": {
   "jp": "d9b9aa45",
   "kr": "이것도 운명의 장난이지요!"
  }
 }
