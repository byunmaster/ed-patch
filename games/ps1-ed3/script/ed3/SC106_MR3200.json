 "lines": {
  "0": {
   "jp": "ba581fe4",
   "kr": "히스이 가도"
  },
  "1": {
   "jp": "daca3452",
   "kr": "행상인 폴카"
  },
  "2": {
   "jp": "e79fd6cb",
   "kr": "여어, 안녕."
  },
  "3": {
   "jp": "20a365ce",
   "kr": "튜엘에 가는 거니?"
  },
  "4": {
   "jp": "6053282d",
   "kr": "나는 장사로 이문을 좇는 폴카."
  },
  "5": {
   "jp": "eb60ee8c",
   "kr": "넬바 도구점에 물건을 넣으러"
  },
  "6": {
   "jp": "84954f6e",
   "kr": "가는 참이란다."
  },
  "7": {
   "jp": "a589752f",
   "kr": "넬바에 해수 가루가가 상륙해서"
  },
  "8": {
   "jp": "1fc8d3f9",
   "kr": "큰일이었다면서?"
  },
  "9": {
   "jp": "5e43247c",
   "kr": "마을 사람들은 괜찮은 거니?"
  },
  "10": {
   "jp": "605c9a5d",
   "kr": "네, 그래요."
  },
  "11": {
   "jp": "f2345419",
   "kr": "건물 같은 건 엉망으로"
  },
  "12": {
   "jp": "23633f53",
   "kr": "돼 버렸어요…"
  },
  "13": {
   "jp": "a59ba172",
   "kr": "그래도 다들 마을을 되살리려고"
  },
  "14": {
   "jp": "389a37ff",
   "kr": "무척 애쓰고 있어요."
  },
  "15": {
   "jp": "d1e5a082",
   "kr": "그렇구나, 큰일이었겠구나."
  },
  "16": {
   "jp": "ee7e4e4d",
   "kr": "내가 나르는 상품이"
  },
  "17": {
   "jp": "8db7797c",
   "kr": "조금이라도 도움이 되면 좋겠는데."
  },
  "18": {
   "jp": "2c27a944",
   "kr": "참, 너희도 뭔가 필요하거든"
  },
  "19": {
   "jp": "f6001412",
   "kr": "사 가렴."
  },
  "20": {
   "jp": "eabbacbe",
   "kr": "이 근방엔 질 나쁜 마수가 있으니까."
  },
  "21": {
   "jp": "ccc6ec69",
   "kr": "자, 어떤 볼일이 있으려나."
  },
  "22": {
   "jp": "ce9da924",
   "kr": "유비무환이라고들 하지."
  },
  "23": {
   "jp": "f165ab64",
   "kr": "고맙다!"
  },
  "24": {
   "jp": "2094011a",
   "kr": "야."
  },
  "25": {
   "jp": "15054edb",
   "kr": "받을게."
  },
  "26": {
   "jp": "33a1ff9c",
   "kr": "여행은 가벼운 게 최고야."
  },
  "27": {
   "jp": "9bee4746",
   "kr": "무엇을 팔아 주려나?"
  },
  "28": {
   "jp": "d57fc884",
   "kr": "말이지?"
  },
  "29": {
   "jp": "35358975",
   "kr": "그럼,"
  },
  "30": {
   "jp": "a1449844",
   "kr": "에 사들이겠어."
  },
  "31": {
   "jp": "2f2350c5",
   "kr": "여기서 만난 것도 인연!"
  },
  "32": {
   "jp": "717af017",
   "kr": "좋아! 1 Goa당 16 Pia로 쳐 주마."
  },
  "33": {
   "jp": "f165ab64",
   "kr": "고맙다!"
  },
  "34": {
   "jp": "c0d6b1b0",
   "kr": "건네줄게. 떨어뜨리지 말렴."
  },
  "35": {
   "jp": "ad7f10bb",
   "kr": "놀리지 말아 주렴."
  },
  "36": {
   "jp": "c94416e4",
   "kr": "라피카가 없지 않니."
  },
  "37": {
   "jp": "dc584181",
   "kr": "다른 볼일은 없니?"
  },
  "38": {
   "jp": "a7bb082c",
   "kr": "고마워."
  },
  "39": {
   "jp": "eb079682",
   "kr": "나도 좀 쉬었다가 출발할게."
  },
  "40": {
   "jp": "98d8e3b4",
   "kr": "가는 길 조심해!"
  },
  "41": {
   "jp": "b6b40f17",
   "kr": "동 넬바 1065미로"
  },
  "42": {
   "jp": "bf9dee08",
   "kr": "서 튜엘 985미로"
  },
  "43": {
   "jp": "40366cc8",
   "kr": "음… 어디 보자."
  },
  "44": {
   "jp": "087d48aa",
   "kr": "이제 반쯤 왔네."
  },
  "45": {
   "jp": "71748511",
   "kr": "숲속은 길 잃을 것 같아서 싫어."
  },
  "46": {
   "jp": "ba713540",
   "kr": "그런가요?"
  },
  "47": {
   "jp": "54290f77",
   "kr": "나는 나무 냄새 좋아해."
  },
  "48": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "49": {
   "jp": "64d295f0",
   "kr": "나무 냄새 말고는 아무것도 못 느끼니?"
  },
  "50": {
   "jp": "82fced17",
   "kr": "킁킁…"
  },
  "51": {
   "jp": "fa8e2527",
   "kr": "바다 냄새!"
  },
  "52": {
   "jp": "100cd53c",
   "kr": "그래, 바로 앞이 바다란다."
  },
  "53": {
   "jp": "604789fa",
   "kr": "쥬리오, 강아지 같아."
  },
  "54": {
   "jp": "41c55829",
   "kr": "…됐어, 이제."
  },
  "55": {
   "jp": "3f487ef6",
   "kr": "벌써 반이나 왔구나."
  },
  "56": {
   "jp": "4153b8a3",
   "kr": "역시 셋이 있으니 즐겁네."
  },
  "57": {
   "jp": "9c9979fc",
   "kr": "조금만 더 가면 풍경이 바뀔 거다."
  },
  "58": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "59": {
   "jp": "f6cfaba1",
   "kr": "?"
  },
  "60": {
   "jp": "f4bf46e8",
   "kr": "토파즈 바다가 보일 거란다."
  },
  "61": {
   "jp": "94f7b248",
   "kr": "야호!"
  },
  "62": {
   "jp": "a9a8f95a",
   "kr": "순조롭게 나아가고 있는 듯하군."
  },
  "63": {
   "jp": "ad71a932",
   "kr": "앞으로 985미로."
  },
  "64": {
   "jp": "3ede2c2a",
   "kr": "휴… 좀 피곤하네."
  },
  "65": {
   "jp": "12893b72",
   "kr": "업어 달라는 건 안 돼."
  },
  "66": {
   "jp": "40b6fb1f",
   "kr": "그런 말 안 해!"
  },
  "67": {
   "jp": "110e3e0b",
   "kr": "언제까지 애 취급하지 마!"
  },
  "68": {
   "jp": "293710e1",
   "kr": "애가 아냐."
  },
  "69": {
   "jp": "1956c56a",
   "kr": "크리스도 마찬가지잖아!"
  },
  "70": {
   "jp": "fa4aa6f7",
   "kr": "…이것 참."
  }
 }
}