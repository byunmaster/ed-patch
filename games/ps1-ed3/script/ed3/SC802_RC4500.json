{
 "archive": "/SCE8/SC802.DAT",
 "member": "..\\DATA\\RC4500.BIN",
 "lines": {
  "0": {
   "jp": "16b2a2e8",
   "kr": "루드성"
  },
  "1": {
   "jp": "173ca740",
   "kr": "지하 통로"
  },
  "2": {
   "jp": "e19d2b59",
   "kr": "매복이었나…"
  },
  "3": {
   "jp": "568ebcd3",
   "kr": "발밑이 나쁘니 성가시군."
  },
  "4": {
   "jp": "fea45857",
   "kr": "어떡하지…"
  },
  "5": {
   "jp": "1e3ab353",
   "kr": "아…"
  },
  "6": {
   "jp": "44653a2e",
   "kr": "마수보다 성가신 적이 나타난 모양이야."
  },
  "7": {
   "jp": "e2582e80",
   "kr": "후우…"
  },
  "8": {
   "jp": "60911828",
   "kr": "이 정도면 됐나."
  },
  "9": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "10": {
   "jp": "34e80b77",
   "kr": "알프?!"
  },
  "11": {
   "jp": "13447b71",
   "kr": "어, 어째서 이런 데에"
  },
  "12": {
   "jp": "129c14d0",
   "kr": "알프가 있는 거야…"
  },
  "13": {
   "jp": "bf4a33d9",
   "kr": "알프!"
  },
  "14": {
   "jp": "9f1729e4",
   "kr": "역시 자네들을 앞질렀던 모양이군."
  },
  "15": {
   "jp": "d35e08b4",
   "kr": "그럴 거라고 생각했네."
  },
  "16": {
   "jp": "b9ad7f67",
   "kr": "어째서 알프가 여기에?"
  },
  "17": {
   "jp": "d7bc768a",
   "kr": "혼자서 왔어?"
  },
  "18": {
   "jp": "7dca49df",
   "kr": "왜 가면 같은 걸 쓰고 있었어?"
  },
  "19": {
   "jp": "a6794dcf",
   "kr": "내 얼굴은 폴티아에서도 알려졌으니 말이야."
  },
  "20": {
   "jp": "91569873",
   "kr": "그보다 치사하지 않은가."
  },
  "21": {
   "jp": "1d26e244",
   "kr": "모리슨이 앰비쉬로 돌아간 뒤로"
  },
  "22": {
   "jp": "7c325d9c",
   "kr": "아무래도 자네들이 마음에 걸려서 말일세."
  },
  "23": {
   "jp": "f9af943a",
   "kr": "올도스의 대신관님께"
  },
  "24": {
   "jp": "3838179c",
   "kr": "자네들 소식을 물으러 갔던 걸세."
  },
  "25": {
   "jp": "4dc0f4b4",
   "kr": "라우알의 파도 얘기는 들었네."
  },
  "26": {
   "jp": "b9346946",
   "kr": "그래서 이것저것 챙길 겨를도 없이"
  },
  "27": {
   "jp": "c101c1f9",
   "kr": "부랴부랴 달려온 걸세."
  },
  "28": {
   "jp": "f9dd1985",
   "kr": "참, 모리슨에게는 비밀일세."
  },
  "29": {
   "jp": "d6063bd9",
   "kr": "그 친구는 걱정이 많아서"
  },
  "30": {
   "jp": "d73d4211",
   "kr": "알려지면 성을 못 나오게 될 걸세."
  },
  "31": {
   "jp": "cf35871d",
   "kr": "알프레드 왕. 오랜만이군."
  },
  "32": {
   "jp": "cc761492",
   "kr": "여어, 듀르젤."
  },
  "33": {
   "jp": "9c3dc68e",
   "kr": "옛날처럼 알프면 되네."
  },
  "34": {
   "jp": "f8fb2055",
   "kr": "자네한테 왕이라 불리면"
  },
  "35": {
   "jp": "b278e1b0",
   "kr": "어쩐지 영 어색해진다네."
  },
  "36": {
   "jp": "56439d90",
   "kr": "엣…?"
  },
  "37": {
   "jp": "cdfc4540",
   "kr": "듀르젤과 알프는 아는 사이야?"
  },
  "38": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "39": {
   "jp": "abee1133",
   "kr": "옛날에 아주 잠깐이었지만"
  },
  "40": {
   "jp": "15de9ea3",
   "kr": "우리는 함께 여행한 적이 있다네."
  },
  "41": {
   "jp": "274245cb",
   "kr": "자 그럼"
  },
  "42": {
   "jp": "8fedcfe0",
   "kr": "옛이야기를 나누고 있을 틈은 없을 듯하군."
  },
  "43": {
   "jp": "3b55fc01",
   "kr": "이곳 수비는 내가 맡았네."
  },
  "44": {
   "jp": "d80e415c",
   "kr": "여기로 들어오려는 적은 내가 막아 내겠네."
  },
  "45": {
   "jp": "bcea6c95",
   "kr": "자, 먼저 가게."
  },
  "46": {
   "jp": "afe041bf",
   "kr": "벌써 나왔군."
  },
  "47": {
   "jp": "cead500c",
   "kr": "등 뒤는 걱정 마라."
  },
  "48": {
   "jp": "aaaee635",
   "kr": "내가 여기서 막겠다!"
  },
  "49": {
   "jp": "ea4c5aae",
   "kr": "어서 앞으로 가게."
  },
  "50": {
   "jp": "39581d67",
   "kr": "뒤는 걱정 말게."
  }
 }
}