  "56": {
   "jp": "ba465b9d",
   "kr": "에 팔겠네."
  },
  "57": {
   "jp": "d7df4249",
   "kr": "이 다츠에선 재료 모으기가 힘들어서."
  },
  "58": {
   "jp": "27317148",
   "kr": "필요 없는 건 고맙게 사들이지."
  },
  "59": {
   "jp": "29d159fe",
   "kr": "를 팔아 주시겠나?"
  },
  "60": {
   "jp": "abb8567e",
   "kr": "그렇다면"
  },
  "61": {
   "jp": "a1449844",
   "kr": "에 사들이겠어."
  },
  "62": {
   "jp": "6ae7fa54",
   "kr": "라피카는 무기 만들기에 꼭 필요한 재료."
  },
  "63": {
   "jp": "78f7aaa8",
   "kr": "1 Goa당 17 Pia 주겠네만 어떤가?"
