  },
  "34": {
   "jp": "e94a49f7",
   "kr": "도중에 끝나 버려서 실망이야."
  },
  "35": {
   "jp": "0cafb823",
   "kr": "1년에 한 번 있는 즐거움이었는데."
  },
  "36": {
   "jp": "63e9e744",
   "kr": "다이스는 매일이 축제 같은데."
  },
  "37": {
   "jp": "8f0234d5",
   "kr": "치사해!"
