  },
  "25": {
   "jp": "cf0e6b78",
   "kr": "딱히 트로바 씨 탓이 아니에요."
  },
  "26": {
   "jp": "ab0cca16",
   "kr": "그분은 우리에게는 과분할 정도예요."
  },
  "27": {
   "jp": "d6526c0b",
   "kr": "전부 우리가 잘못한 거예요."
  },
  "28": {
   "jp": "e18e5c64",
   "kr": "하지만요 그리 알면서도"
  },
  "29": {
   "jp": "a21c8796",
   "kr": "어쩔 도리가 없어요."
  },
  "30": {
   "jp": "7791f6dd",
   "kr": "이 생활은 좀처럼"
  },
  "31": {
   "jp": "fc9e653f",
   "kr": "바꿀 수가 없어요."
  },
  "32": {
   "jp": "a21c8796",
   "kr": "어쩔 도리가 없어요."
  },
  "33": {
