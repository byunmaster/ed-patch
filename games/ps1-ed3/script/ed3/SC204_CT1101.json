  "43": {
   "jp": "97e6477a",
   "kr": "보낼 수 있는 사람들뿐일세."
  },
  "44": {
   "jp": "b36247dc",
   "kr": "이 다츠를 찾아올 정도이니."
  },
  "45": {
   "jp": "ff0527f0",
   "kr": "자네들도 사리사욕으로 움직일 이는 아니겠지."
