{
 "archive": "/SCE1/SC102.DAT",
 "member": "..\\DATA\\MR2100.BIN",
 "lines": {
  "0": {
   "jp": "e60de4cd",
   "kr": "주얼 가도"
  },
  "1": {
   "jp": "95b09cdf",
   "kr": "드리트 노인"
  },
  "2": {
   "jp": "fe867ef9",
   "kr": "나무르"
  },
  "3": {
   "jp": "982270a0",
   "kr": "할아버지, 안녕하세요."
  },
  "4": {
   "jp": "9dc72911",
   "kr": "오오, 반갑구먼."
  },
  "5": {
   "jp": "54333465",
   "kr": "무슨 일이신가?"
  },
  "6": {
   "jp": "96ab37a6",
   "kr": "아끼던 지팡이를 부러뜨렸다네."
  },
  "7": {
   "jp": "95167bd8",
   "kr": "지금 일행이 맞는 가지를 찾아 주고 있다네."
  },
  "8": {
   "jp": "6238e5ea",
   "kr": "어디 가시려던 거예요?"
  },
  "9": {
   "jp": "766e346a",
   "kr": "먼저 치타로 떠난"
  },
  "10": {
   "jp": "716340f0",
   "kr": "가족한테 가는 길이네."
  },
  "11": {
   "jp": "22405ce5",
   "kr": "저희도 조금 전까지 치타에 있었어요."
  },
  "12": {
   "jp": "befa8f52",
   "kr": "오오!"
  },
  "13": {
   "jp": "c3ca7057",
   "kr": "그럼, 우리 유우미와 그레드를 못 만났나?"
  },
  "14": {
   "jp": "18d62209",
   "kr": "장난꾸러기 둘이라네."
  },
  "15": {
   "jp": "77a7c02a",
   "kr": "분명 그 애들이야!"
  },
  "16": {
   "jp": "a12c79d7",
   "kr": "그 둘이라면 신나게 계란말이를 먹던데요."
  },
  "17": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "18": {
   "jp": "70a93f11",
   "kr": "아주 사이좋았으니까 걱정 안 하셔도 돼요."
  },
  "19": {
   "jp": "a04ba0f2",
   "kr": "그런가, 그런가."
  },
  "20": {
   "jp": "d59b02a9",
   "kr": "아니, 잘됐구먼."
  },
  "21": {
   "jp": "e913c878",
   "kr": "들으니 안심이 되는구먼."
  },
  "22": {
   "jp": "90021316",
   "kr": "으〜음…"
  },
  "23": {
   "jp": "328c2f36",
   "kr": "크리스, 만난 적 있어?"
  },
  "24": {
   "jp": "c1e3f102",
   "kr": "할아버지, 죄송해요."
  },
  "25": {
   "jp": "947025e7",
   "kr": "못 만난 것 같아요."
  },
  "26": {
   "jp": "7649b6e6",
   "kr": "…그런가."
  },
  "27": {
   "jp": "f71c4a49",
   "kr": "마음에 걸리는군."
  },
  "28": {
   "jp": "f6e9e409",
   "kr": "자네들도 조심해서 가시게."
  },
  "29": {
   "jp": "bc0726d7",
   "kr": "노인 이야기를 들어 줘서 고맙소."
  },
  "30": {
   "jp": "ce86e788",
   "kr": "아니, 나야말로 유익한 정보를 들었소."
  },
  "31": {
   "jp": "485a6185",
   "kr": "고맙다고 해야겠군."
  },
  "32": {
   "jp": "3aafd686",
   "kr": "해님은 느리지만"
  },
  "33": {
   "jp": "d86f9f36",
   "kr": "매일 어김없이 하늘에 오르시지."
  },
  "34": {
   "jp": "7f70e448",
   "kr": "어김없이 걸어가시게."
  },
  "35": {
   "jp": "6f68a76e",
   "kr": "할배!"
  },
  "36": {
   "jp": "505a7c17",
   "kr": "찾아왔다고."
  },
  "37": {
   "jp": "1a2f0a44",
   "kr": "할배, 이 사람들은?"
  },
  "38": {
   "jp": "6b1871d5",
   "kr": "네가 하도 늦으니 말일세."
  },
  "39": {
   "jp": "5e8d54b1",
   "kr": "말동무를 해 주셨다네."
  },
  "40": {
   "jp": "7f4190d5",
   "kr": "그거 참 미안하게 됐네."
  },
  "41": {
   "jp": "ed8ae921",
   "kr": "그런데 댁들은 넬바로 가는 거야?"
  },
  "42": {
   "jp": "308e373a",
   "kr": "그럴 셈이네만."
  },
  "43": {
   "jp": "3fcbcde6",
   "kr": "안 좋은 때에 왔구먼."
  },
  "44": {
   "jp": "1b2812ff",
   "kr": "올해는 흉작인 데다"
  },
  "45": {
   "jp": "5d09be46",
   "kr": "가루가가 엉망진창으로 만들어 놨으니까."
  },
  "46": {
   "jp": "07948240",
   "kr": "그 가루가 말인데, 넬바를 나와"
  },
  "47": {
   "jp": "5eef1f91",
   "kr": "어느 쪽으로…?"
  },
  "48": {
   "jp": "5b9d5822",
   "kr": "역시 남쪽으로 내려가는 겐가."
  },
  "49": {
   "jp": "69a4e628",
   "kr": "그렇다네."
  },
  "50": {
   "jp": "860a65eb",
   "kr": "그대로 가면 로프섬일세."
  },
  "51": {
   "jp": "d61f5d8f",
   "kr": "잘못하면 앰비쉬까지…"
  },
  "52": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "53": {
   "jp": "e2a23deb",
   "kr": "이제 그 얘기는 그만하세."
  },
  "54": {
   "jp": "30dbfd50",
   "kr": "나도 좀 쉬게 해 줘."
  },
  "55": {
   "jp": "678f079b",
   "kr": "숲속을 뛰어다녔더니 지쳤어."
  },
  "56": {
   "jp": "9a0369e9",
   "kr": "우리도 좀 쉬었다가"
  },
  "57": {
   "jp": "80ad6dc7",
   "kr": "치타로 가 볼 참일세."
  },
  "58": {
   "jp": "5eca386f",
   "kr": "넬바는 이제 금방이야."
  },
  "59": {
   "jp": "62cab438",
   "kr": "사는 사람들이 서글서글하니"
  },
  "60": {
   "jp": "5b51aae1",
   "kr": "마음 편히 가면 돼."
  },
  "61": {
   "jp": "71e82b4a",
   "kr": "동 넬바 330미로"
  },
  "62": {
   "jp": "8a9f7bf1",
   "kr": "서 치타 335미로"
  },
  "63": {
   "jp": "877848e7",
   "kr": "왠지…"
  },
  "64": {
   "jp": "d4f4838a",
   "kr": "또 가루가에게 부서진 마을을 보는 건"
  },
  "65": {
   "jp": "b342aafd",
   "kr": "괴롭네."
  },
  "66": {
   "jp": "7032e38f",
   "kr": "응…"
  },
  "67": {
   "jp": "719ba0f8",
   "kr": "라그픽 마을이 저렇게 되면 하고"
  },
  "68": {
   "jp": "7a0a5028",
   "kr": "생각하면 무서워져."
  },
  "69": {
   "jp": "9899e22d",
   "kr": "분명 다음 샤리네는"
  },
  "70": {
   "jp": "53ab05d3",
   "kr": "앰비쉬의 이그니스지?"
  },
  "71": {
   "jp": "d82378e1",
   "kr": "그렇다면 넬바를 지날 수밖에 없겠군."
  },
  "72": {
   "jp": "cdabca67",
   "kr": "튜엘에 도착하기만 하면"
  },
  "73": {
   "jp": "f5f0dcba",
   "kr": "챠놈을 거쳐 육로로 갈지"
  },
  "74": {
   "jp": "b56b3d6d",
   "kr": "배로 볼트에 건널지 고를 수는 있다만."
  },
  "75": {
   "jp": "0b59f79e",
   "kr": "어, 알프 씨."
  },
  "76": {
   "jp": "5ad27090",
   "kr": "잘 아시네."
  },
  "77": {
   "jp": "3da3a27b",
   "kr": "깜짝 놀랐어."
  },
  "78": {
   "jp": "9bce689f",
   "kr": "아니, 그 정도는…"
  },
  "79": {
   "jp": "c60017e6",
   "kr": "메나트의 왕도 넬바"
  },
  "80": {
   "jp": "02dfac52",
   "kr": "서 치타 665미로"
  }
 }
}