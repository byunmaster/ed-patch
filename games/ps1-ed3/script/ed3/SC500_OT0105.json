 "member": "..\\DATA\\OT0105.BIN",
 "lines": {
  "0": {
   "jp": "2a8d61a9",
   "kr": "마을 구역"
  },
  "1": {
   "jp": "6f88e233",
   "kr": "여관 크라프"
  },
  "2": {
   "jp": "0f466786",
   "kr": "페기"
  },
  "3": {
   "jp": "fad55c11",
   "kr": "아우다"
  },
  "4": {
   "jp": "9ba54334",
   "kr": "스필"
  },
  "5": {
   "jp": "5b65362b",
   "kr": "스토바"
  },
  "6": {
   "jp": "ae5668d5",
   "kr": "판차"
  },
  "7": {
   "jp": "3c78bf16",
   "kr": "올도스 마을은 대성당을 중심으로"
  },
  "8": {
   "jp": "3716b905",
   "kr": "펼쳐져 있답니다."
  },
  "9": {
   "jp": "5975b17c",
   "kr": "아주 넓은 마을이니 길 잃지 마."
  },
  "10": {
   "jp": "543d25b7",
   "kr": "미아…"
  },
  "11": {
   "jp": "da4001f0",
   "kr": "이 마을은 성자의 마을이라서"
  },
  "12": {
   "jp": "c41ad7d8",
   "kr": "술집 같은 건 없다고."
  },
  "13": {
   "jp": "59c6b3b7",
   "kr": "좀 아쉽지."
  },
  "14": {
   "jp": "f1a1fdd7",
   "kr": "잘됐구나."
  },
  "15": {
   "jp": "847d9388",
   "kr": "친구 저주"
  },
  "16": {
   "jp": "bbf0432b",
   "kr": "풀렸다면서."
  },
  "17": {
   "jp": "08b9298d",
   "kr": "올도스에선 옛날부터"
  },
  "18": {
   "jp": "05ee9174",
   "kr": "고난은 신의 축복이라고들 하지."
  },
  "19": {
   "jp": "8710e80e",
   "kr": "올도스에서 이런 일을 겪다니"
  },
  "20": {
   "jp": "250b66f6",
   "kr": "너는 어지간히 신의"
  },
  "21": {
   "jp": "c39a0971",
   "kr": "눈에 들었는지도 모르겠다."
  },
  "22": {
   "jp": "177ac378",
   "kr": "20년쯤 전까지는"
  },
  "23": {
   "jp": "6e424d5e",
   "kr": "올도스엔 대성당밖에 없었는데 말이지."
  },
  "24": {
   "jp": "746bfa01",
   "kr": "어느새인가"
  },
  "25": {
   "jp": "46ea317c",
   "kr": "번듯한 마을이 되어 버렸구먼."
  },
  "26": {
   "jp": "6c2f1e71",
   "kr": "알고 있나?"
  },
  "27": {
   "jp": "2d5ce421",
   "kr": "여기서 수행한 사람이"
  },
  "28": {
   "jp": "de3f762e",
   "kr": "각지의 신관이나 현자가 되어"
  },
  "29": {
   "jp": "7427a122",
   "kr": "온 세상에서 일하고 있다고."
  },
  "30": {
   "jp": "0cf87174",
   "kr": "칸드나 챠펠에"
  },
  "31": {
   "jp": "5d64b788",
   "kr": "몸담은 사람 중에도"
  },
  "32": {
   "jp": "44997766",
   "kr": "여기서 수행한 사람이 많이 있단다."
  },
  "33": {
   "jp": "b83b76b2",
   "kr": "잘 견뎌 냈구먼."
  },
  "34": {
   "jp": "11b40c70",
   "kr": "이번 체험이"
  },
  "35": {
   "jp": "4673388d",
   "kr": "자네를 크게 성장시켰을 게야."
  }
 }
}