 "lines": {
  "0": {
   "jp": "16b2a2e8",
   "kr": "루드성"
  },
  "1": {
   "jp": "173ca740",
   "kr": "지하 통로"
  },
  "2": {
   "jp": "429dc63a",
   "kr": "꺅, 뒤에 나타났어."
  },
  "3": {
   "jp": "7b60be72",
   "kr": "앞에서도 왔어요!"
  },
  "4": {
   "jp": "beedafe5",
   "kr": "앗?"
  },
  "5": {
   "jp": "06750cec",
   "kr": "두건 남자"
  },
  "6": {
   "jp": "1c790e30",
   "kr": "늦지 않았군요."
  },
  "7": {
   "jp": "51ae0194",
   "kr": "쥬리오 님, 크리스 님."
  },
  "8": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "9": {
   "jp": "cd18640b",
   "kr": "그 목소리…"
  },
  "10": {
   "jp": "06750cec",
   "kr": "두건 남자"
  },
  "11": {
   "jp": "7b7bf7fc",
   "kr": "마기사를 대신해"
  },
  "12": {
   "jp": "d9802724",
   "kr": "도와드리겠습니다."
  },
  "13": {
   "jp": "a0ad9869",
   "kr": "모리슨 씨."
  },
  "14": {
   "jp": "7cb088e0",
   "kr": "두 분치고는 올도스에서 헤어질 때의"
  },
  "15": {
   "jp": "c1e86905",
   "kr": "모습이 유난히 의뭉스러워서"
  },
  "16": {
   "jp": "01a81d0e",
   "kr": "폐하께 보고한 뒤 이쪽으로 왔습니다."
  },
  "17": {
   "jp": "58251dbe",
   "kr": "알프 왕께는 무단으로 와 버렸습니다."
  },
  "18": {
   "jp": "59496013",
   "kr": "부디 비밀로 해 주십시오."
  },
  "19": {
   "jp": "98d8b205",
   "kr": "엇, 아, 그러셨군요…"
  },
  "20": {
   "jp": "8713cde2",
   "kr": "고, 고마워요…"
  },
  "21": {
   "jp": "32cdf7e6",
   "kr": "아무래도 이번엔"
  },
  "22": {
   "jp": "bea557a1",
   "kr": "가루가보다 거대한 적에 맞서고 계신 듯"
  },
  "23": {
   "jp": "a219341f",
   "kr": "하옵니다."
  },
  "24": {
   "jp": "7271b858",
   "kr": "자, 이 길은 제가 사수하겠습니다."
  },
  "25": {
   "jp": "fb7308d1",
   "kr": "쥬리오 님 일행은"
  },
  "26": {
   "jp": "8be77e2a",
   "kr": "앞으로 서둘러 가시옵소서."
  },
  "27": {
   "jp": "4edcfd8f",
   "kr": "모리슨 공이라 하였나."
  },
  "28": {
   "jp": "f4268b7f",
   "kr": "고맙네. 은혜는 잊지 않겠네."
  },
  "29": {
   "jp": "3bdec7fd",
   "kr": "자, 어서"
  },
  "30": {
   "jp": "d32d1d6f",
   "kr": "안심하고 앞으로 가십시오."
  },
  "31": {
   "jp": "967e3c2d",
   "kr": "여기는 제가"
  },
  "32": {
   "jp": "b713a587",
   "kr": "맡겠습니다."
  },
  "33": {
   "jp": "4fdd0bb5",
   "kr": "여기다."
  },
  "34": {
   "jp": "896a2bff",
   "kr": "틀림없다."
  },
  "35": {
   "jp": "12a116b5",
   "kr": "이 문이 이자벨의 탑 입구다."
  }
 }
