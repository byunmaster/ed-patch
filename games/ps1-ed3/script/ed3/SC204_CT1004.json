  },
  "4": {
   "jp": "9ed7437c",
   "kr": "냅 촌장"
  },
  "5": {
   "jp": "b684746d",
   "kr": "리그레"
  },
  "6": {
   "jp": "b338fe8d",
   "kr": "바스레"
  },
  "7": {
   "jp": "0a5e1957",
   "kr": "포리쉬"
  },
  "8": {
   "jp": "9c3b5f51",
   "kr": "안지"
  },
  "9": {
   "jp": "b4505917",
   "kr": "시켓트"
  },
  "10": {
   "jp": "00cdd041",
   "kr": "젠느"
  },
  "11": {
   "jp": "a76cf681",
   "kr": "치젤"
  },
  "12": {
   "jp": "a2dbf087",
   "kr": "토니카"
  },
  "13": {
   "jp": "9c3b5f51",
   "kr": "안지"
  },
  "14": {
   "jp": "a2dbf087",
   "kr": "토니카"
  },
  "15": {
   "jp": "a76cf681",
   "kr": "치젤"
  },
  "16": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "17": {
   "jp": "80a5c1b8",
   "kr": "이제 다츠는 다시 태어날 겁니다."
  },
  "18": {
   "jp": "b5742b6a",
   "kr": "아뇨."
  },
  "19": {
   "jp": "354880cd",
   "kr": "저는 그저 모두의 마음을"
  },
  "20": {
   "jp": "f6bde435",
   "kr": "연주했을 뿐입니다."
  },
  "21": {
   "jp": "98e533d4",
   "kr": "내년에도 와 주시겠습니까?"
  },
  "22": {
   "jp": "3b2ec867",
   "kr": "물론입니다."
  },
  "23": {
   "jp": "6d615b4e",
   "kr": "싫다고 하셔도 찾아오고 말 겁니다."
  },
  "24": {
   "jp": "d678b6da",
   "kr": "고맙습니다."
  },
  "25": {
   "jp": "744de8d7",
   "kr": "기다리고 있겠습니다."
  },
  "26": {
   "jp": "436e6d7f",
   "kr": "트로바아!"
  },
  "27": {
   "jp": "82ea8936",
   "kr": "벌써 가 버리는 거야?"
  },
  "28": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "29": {
   "jp": "61417cbc",
   "kr": "그게 내 일이거든."
  },
  "30": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "31": {
   "jp": "9654c7b8",
   "kr": "안지, 금방 만날 수 있어."
  },
  "32": {
   "jp": "ca45ca00",
   "kr": "새로 태어난 이 마을에서."
  },
  "33": {
   "jp": "9b20da62",
   "kr": "네!"
  },
  "34": {
   "jp": "9d56bab2",
   "kr": "로디 씨."
  },
  "35": {
   "jp": "85c0f237",
   "kr": "그 말씀 덕분에 꺾여 있던 마음을"
  },
  "36": {
   "jp": "7b50e95a",
   "kr": "다시 일으켜 세울 수 있었습니다."
  },
  "37": {
   "jp": "52d6c76b",
   "kr": "그리고 너희들."
  },
  "38": {
   "jp": "69190775",
   "kr": "이런 나를 위해 현을 가져다줘서"
  },
  "39": {
   "jp": "7bd05f14",
   "kr": "정말 고마워."
  },
  "40": {
   "jp": "7957317e",
   "kr": "정말 신나는 곡이었어요!"
  },
  "41": {
   "jp": "9b20da62",
   "kr": "네!"
  },
  "42": {
   "jp": "795bf6e0",
   "kr": "정말 멋졌어요."
  },
  "43": {
   "jp": "b68a3704",
   "kr": "여행이 잘 풀리면 좋겠네."
  },
  "44": {
   "jp": "f658c824",
   "kr": "여러분."
  },
  "45": {
   "jp": "575f3eb5",
   "kr": "잘 지내세요!!"
  },
  "46": {
   "jp": "0701681a",
   "kr": "자, 다들."
  },
  "47": {
   "jp": "663dc890",
   "kr": "저마다 할 수 있는 일을"
  },
  "48": {
   "jp": "008b3e73",
   "kr": "해 나가 보세."
  },
  "49": {
   "jp": "d99ed35f",
   "kr": "맡겨만 주십쇼, 촌장님!"
  },
  "50": {
   "jp": "1c309749",
   "kr": "이제 어제까지의 우리가 아닙니다!"
  },
  "51": {
   "jp": "d6b600d8",
   "kr": "자, 가자!"
  },
  "52": {
   "jp": "ed75113f",
   "kr": "자네들 덕분일세."
  },
  "53": {
   "jp": "f77e2110",
   "kr": "이번에야말로 이 마을도 일어서겠지."
  },
  "54": {
   "jp": "dbc57e01",
   "kr": "다 같이 열심히 일하는 게야."
  },
  "55": {
   "jp": "727440dc",
   "kr": "다이스에 지지 마세요."
  },
  "56": {
   "jp": "2ee9aed9",
   "kr": "오오 다이스에 지지 말라고?"
  },
  "57": {
   "jp": "0cc759fd",
   "kr": "암!"
  },
  "58": {
   "jp": "a724d0b7",
   "kr": "다이스보다 훌륭한 마을로 만들고 말겠네."
  },
  "59": {
   "jp": "f4a19da4",
   "kr": "기대돼요."
  },
  "60": {
   "jp": "a85d8b8a",
   "kr": "그럼, 신세 많이 졌구먼."
  },
  "61": {
   "jp": "8b2f2b23",
   "kr": "가는 길 조심해서 가시게."
  },
  "62": {
   "jp": "d0085700",
   "kr": "그럼, 크리스."
  },
  "63": {
   "jp": "02f76e27",
   "kr": "우리도"
  },
  "64": {
   "jp": "9056c5a5",
   "kr": "슬슬 가 볼까?"
  },
  "65": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "66": {
   "jp": "c13883d9",
   "kr": "아이고… 루레 씨."
  },
  "67": {
   "jp": "809a1bdd",
   "kr": "잘 와 주었네."
  },
  "68": {
   "jp": "b9b08776",
   "kr": "약소하네만"
  },
  "69": {
   "jp": "08f58e02",
   "kr": "렌즈콩을 가져왔네."
  },
  "70": {
   "jp": "a8d98a32",
   "kr": "늘 미안하네."
  },
  "71": {
   "jp": "3ab3ce1a",
   "kr": "고맙게"
  },
  "72": {
   "jp": "f9f4c063",
   "kr": "받아 두겠네."
  },
  "73": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "74": {
   "jp": "45c96480",
   "kr": "냅 촌장에게 렌즈콩을 건넸다."
  },
  "75": {
   "jp": "aade79f3",
   "kr": "마을 사람들도 의욕이 생겼네."
  },
  "76": {
   "jp": "59646f02",
   "kr": "이 렌즈콩은 소중히 쓰도록 하겠네."
  },
  "77": {
   "jp": "52faa079",
   "kr": "가까운 장래에 독 늪은 렌즈콩 밭으로"
  },
  "78": {
   "jp": "47d2e71c",
   "kr": "다시 태어나겠지."
  },
  "79": {
   "jp": "589c58b1",
   "kr": "콩 가져다준 거야〜?"
  },
  "80": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "81": {
   "jp": "4d636dde",
   "kr": "촌장님께 건네 뒀다."
  },
  "82": {
   "jp": "1757385a",
   "kr": "신난다〜"
  },
  "83": {
   "jp": "8cc7fd29",
   "kr": "우리들 있잖아, 다음에 루레가 오면"
  },
  "84": {
   "jp": "1cf7d4d9",
   "kr": "춤을 보여 주려고"
  },
  "85": {
   "jp": "d209cb15",
   "kr": "연습하고 있었어."
  },
  "86": {
   "jp": "49b19262",
   "kr": "봐 줄래?"
  },
  "87": {
   "jp": "da9760af",
   "kr": "오오, 그거 기대되는구나."
  },
  "88": {
   "jp": "cbbef1ae",
   "kr": "보여 주겠니?"
  },
  "89": {
   "jp": "9def55ab",
   "kr": "아이들"
  },
  "90": {
   "jp": "9b20da62",
   "kr": "네!"
  },
  "91": {
   "jp": "7378a02c",
   "kr": "브라보〜!!"
  },
  "92": {
   "jp": "dbf673b1",
   "kr": "왕궁 무용단보다도 훌륭한 춤이로다!"
  },
  "93": {
   "jp": "c875c6d0",
   "kr": "나는 천재를 봤다!"
  },
  "94": {
   "jp": "9def55ab",
   "kr": "아이들"
  },
  "95": {
   "jp": "cecb2fd9",
   "kr": "신난다〜!"
  },
  "96": {
   "jp": "2e3aef20",
   "kr": "루레 영감이"
  },
  "97": {
   "jp": "a72b57fe",
   "kr": "다음에 올 때는"
  },
  "98": {
   "jp": "be05cb7b",
   "kr": "더 잘하게 돼 있을 거야!"
  },
  "99": {
   "jp": "fcbb69b3",
   "kr": "춤은 1급이다만"
  },
  "100": {
   "jp": "f7d0b89e",
   "kr": "그 영감 소리는 관두렴."
  },
  "101": {
   "jp": "ec6abed1",
   "kr": "… 전혀 안 듣는구나."
  },
  "102": {
   "jp": "d620a04a",
   "kr": "나도"
  },
  "103": {
   "jp": "5b931217",
   "kr": "아직 더 일할 수 있다."
  },
  "104": {
   "jp": "1227449a",
   "kr": "나는 밭을 만들 거야."
  },
  "105": {
   "jp": "1b403410",
   "kr": "씨 뿌려 작물을 키울 거다."
  },
  "106": {
   "jp": "1b31dec3",
   "kr": "자네들이라면 대환영일세."
  },
  "107": {
   "jp": "cc8d81c5",
   "kr": "언제든 오게나."
  },
  "108": {
   "jp": "a13a933d",
   "kr": "마을에 활기가 있다는 건"
  },
  "109": {
   "jp": "668d9d72",
   "kr": "좋은 거로구나."
  },
  "110": {
   "jp": "136cacf9",
   "kr": "독 늪 따위 전부 메워서"
  },
  "111": {
   "jp": "8ca3664a",
   "kr": "이 마을에서 없애 버릴 테다."
  }
 }
}