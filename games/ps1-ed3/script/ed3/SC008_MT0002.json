  },
  "17": {
   "jp": "60916eb5",
   "kr": "스미라"
  },
  "18": {
   "jp": "dd8d3a5a",
   "kr": "키르마"
  },
  "19": {
   "jp": "5b16cfee",
   "kr": "카이"
  },
  "20": {
   "jp": "168e8955",
   "kr": "어부"
  },
  "21": {
   "jp": "df394f68",
   "kr": "루나"
  },
  "22": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "23": {
   "jp": "0efbb7b5",
   "kr": "뭔가 어려운 일이 있으면"
  },
  "24": {
   "jp": "19ded300",
   "kr": "언제든지 오세요."
  },
  "25": {
   "jp": "00e746a0",
   "kr": "상담해 드릴게요."
  },
  "26": {
   "jp": "f3fe5d6f",
   "kr": "뭔가 어려운 일이 있나요?"
  },
  "27": {
   "jp": "52127cc2",
   "kr": "언제든 힘이 될게요."
  },
  "28": {
   "jp": "eb5a6798",
   "kr": "이렇게 심한 흉작이 되다니…"
  },
  "29": {
   "jp": "0f4792ca",
   "kr": "우리가 대체 뭘 잘못했다고…"
  },
  "30": {
   "jp": "6810f3ff",
   "kr": "이런, 아직 떠나지 않았는가?"
  },
  "31": {
   "jp": "08916e82",
   "kr": "이미 알데에 다녀왔어요."
  },
  "32": {
   "jp": "86c52781",
   "kr": "알데 촌장님께 편지를"
  },
  "33": {
   "jp": "580c9b53",
   "kr": "제대로 전해 드렸어요."
  },
  "34": {
   "jp": "521e7e1f",
   "kr": "닐리에 상인이 들르도록"
  },
  "35": {
   "jp": "dd0111a2",
   "kr": "손을 써 주신대요."
  },
  "36": {
   "jp": "1a190da3",
   "kr": "그것참, 고맙구먼."
  },
  "37": {
   "jp": "7de44aa3",
   "kr": "정말 수고했네."
  },
  "38": {
   "jp": "9e998b95",
   "kr": "요전에는"
  },
  "39": {
   "jp": "be0c03c0",
   "kr": "미안했네."
  },
  "40": {
   "jp": "59c67ff4",
   "kr": "알데 촌장에게 보내는 편지 일"
  },
  "41": {
   "jp": "a46382ca",
   "kr": "부디 잘 부탁하네."
  },
  "42": {
   "jp": "5f0935be",
   "kr": "자네들은 순례 여행자겠지."
  },
  "43": {
   "jp": "cd57b18a",
   "kr": "미안하지만 이것을 알데 촌장에게"
  },
  "44": {
   "jp": "b83f91d6",
   "kr": "전해 주지 않겠나?"
  },
  "45": {
   "jp": "616fbfa3",
   "kr": "이웃 알데도 가난한 마을이긴 마찬가지지만,"
  },
  "46": {
   "jp": "1e0db8e0",
   "kr": "네갈섬이나 남쪽 치타와도 왕래가 있다네."
  },
  "47": {
   "jp": "ec71220f",
   "kr": "그 마을이라면 상인의 출입도 많을 걸세."
  },
  "48": {
   "jp": "7f8d06f9",
   "kr": "알데 촌장에게 상인이 더 닐리에도"
  },
  "49": {
   "jp": "669cd299",
   "kr": "오도록 부탁해 주었으면 하네."
  },
  "50": {
   "jp": "bf78e544",
   "kr": "편지를 가져가 주겠나?"
  },
  "51": {
   "jp": "836238da",
   "kr": "이런, 짐이 가득한 모양이구먼."
  },
  "52": {
   "jp": "06bafce5",
   "kr": "짐을 줄이고 다시 와 주겠나."
  },
  "53": {
   "jp": "957e8cba",
   "kr": "어려울 때는 서로 돕는 거죠."
  },
  "54": {
   "jp": "1e509e83",
   "kr": "저희한테 맡겨 주세요."
  },
  "55": {
   "jp": "9a9a4666",
   "kr": "알데 촌장님께 드리면 되죠?"
  },
  "56": {
   "jp": "319e9b10",
   "kr": "마을을 떠나기 전 자네들 마음이 바뀌면,"
  },
  "57": {
   "jp": "7e0f7ddf",
   "kr": "다시 들러 주게나."
  },
  "58": {
   "jp": "5cf561d9",
   "kr": "역시 들러 주었구먼."
  },
  "59": {
   "jp": "8d3c8ade",
   "kr": "그럼 편지를 알데 촌장에게"
  },
  "60": {
   "jp": "c45a95a7",
   "kr": "잘 부탁하겠네."
  },
  "61": {
   "jp": "836238da",
   "kr": "이런, 짐이 가득한 모양이구먼."
  },
  "62": {
   "jp": "06bafce5",
   "kr": "짐을 줄이고 다시 와 주겠나."
  },
  "63": {
   "jp": "813882ab",
   "kr": ", 맡았다."
  },
  "64": {
   "jp": "8691b870",
   "kr": "미안하네."
  },
  "65": {
   "jp": "5314a5b2",
   "kr": "사례로 줄 만한 것도"
  },
  "66": {
   "jp": "b183f96f",
   "kr": "아무것도 없어서…"
  },
  "67": {
   "jp": "373b722d",
   "kr": "허나, 착한 일을 하는 자에게는"
  },
  "68": {
   "jp": "6f358807",
   "kr": "반드시 좋은 일이 있는 법일세."
  },
  "69": {
   "jp": "5d9c56eb",
   "kr": "원래 그런 것이라네."
  },
  "70": {
   "jp": "863171b5",
   "kr": "이웃 마을 알데까지도 꽤 거리가 있거든."
  },
  "71": {
   "jp": "f15c926b",
   "kr": "육로로 식량을 옮겨 오기도"
  },
  "72": {
   "jp": "cfcce417",
   "kr": "뜻대로 되질 않아요."
  },
  "73": {
   "jp": "800335e2",
   "kr": "지금은 오로지 정기선이 가져오는 식량과"
  },
  "74": {
   "jp": "c12f09ab",
   "kr": "바다에서 잡히는 생선만이 믿을 구석이야."
  },
  "75": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "76": {
   "jp": "3f019315",
   "kr": "여긴 애들이 올 데가 아니야."
  },
  "77": {
   "jp": "38a20b4e",
   "kr": "술밖에 없으니까 말이지."
  },
  "78": {
   "jp": "e3902966",
   "kr": "그러네."
  },
  "79": {
   "jp": "f4479637",
   "kr": "쥬리오, 왜 여기 온 거야?"
  },
  "80": {
   "jp": "d25b6c5d",
   "kr": "왜냐면…"
  },
  "81": {
   "jp": "d0a08157",
   "kr": "저, 궁금한 게 있는데요."
  },
  "82": {
   "jp": "9aed8a58",
   "kr": "흉작으로 힘드시다면서"
  },
  "83": {
   "jp": "6f685d0c",
   "kr": "술만은 넉넉히 있나요?"
  },
  "84": {
   "jp": "22d79dd6",
   "kr": "술도 말이야 아까까진 없었어."
  },
  "85": {
   "jp": "f262c729",
   "kr": "방금 매발톱호가 도착했잖아."
  },
  "86": {
   "jp": "1923fbae",
   "kr": "그래서 럼주가 들어온 거지."
  },
  "87": {
   "jp": "1b814341",
   "kr": "질버 선장도 고생이야."
  },
  "88": {
   "jp": "b1914bcf",
   "kr": "평소면 한잔하고 갈 텐데."
  },
  "89": {
   "jp": "80497916",
   "kr": "유빙이 밀려오니 곧장 되돌아간다더군."
  },
  "90": {
   "jp": "f341bbff",
   "kr": "여긴 어른들 주점이지만"
  },
  "91": {
   "jp": "4045b04e",
   "kr": "곤란한 일이 있으면 언제든 찾아오라고."
  },
  "92": {
   "jp": "7dc470c8",
   "kr": "상담해 줄 테니."
  },
  "93": {
   "jp": "90e9fb67",
   "kr": "어서 오세요!"
  },
  "94": {
   "jp": "04cae254",
   "kr": "오, 도와주려는 거야?"
  },
  "95": {
   "jp": "a25f661b",
   "kr": "메나트에 흉작이 이어지는 건,"
  },
  "96": {
   "jp": "9aab81b9",
   "kr": "하얀마녀의 저주라는"
  },
  "97": {
   "jp": "c5ec0b9b",
   "kr": "소문이 자자해."
  },
  "98": {
   "jp": "90e9fb67",
   "kr": "어서 오세요!"
  },
  "99": {
   "jp": "f6effbc7",
   "kr": "예로부터 현명한 나그네는 무기도 잘 쓴다고"
  },
  "100": {
   "jp": "731258ed",
   "kr": "합니다."
  },
  "101": {
   "jp": "4ee46c9a",
   "kr": "아껴 가며 여행하는 마음가짐도 필요하지만,"
  },
  "102": {
   "jp": "a3f34434",
   "kr": "여유를 두고 무기를 갖추는 것도 현명하죠."
  },
  "103": {
   "jp": "ec5a878a",
   "kr": "무엇을 드릴까요?"
  },
  "104": {
   "jp": "d14b58e9",
   "kr": "무엇을 찾으시나요?"
  },
  "105": {
   "jp": "a81e7a27",
   "kr": "받겠습니다."
  },
  "106": {
   "jp": "8fd0ffe1",
   "kr": "무엇을 사들일까요?"
  },
  "107": {
   "jp": "4b42c90a",
   "kr": "라면"
  },
  "108": {
   "jp": "98210662",
   "kr": "에 사들이겠습니다."
  },
  "109": {
   "jp": "65d811e9",
   "kr": "환전이시죠?"
  },
  "110": {
   "jp": "7fa10058",
   "kr": "1 Goa당 15 Pia인데, 괜찮으신가요?"
  },
  "111": {
   "jp": "068d27e4",
   "kr": "을 치르겠습니다."
  },
  "112": {
   "jp": "e81adb75",
   "kr": "라피카가 쌓이면 또 오십시오."
  },
  "113": {
   "jp": "60bf4e0d",
   "kr": "언제든지 사들이겠습니다."
  },
  "114": {
   "jp": "ce85ee3c",
   "kr": "그 밖에 무슨 볼일이신가요?"
  },
  "115": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "116": {
   "jp": "c1b62c53",
   "kr": "또, 필요한 물건이 있으면 들러 주십시오."
  },
  "117": {
   "jp": "caf6f85d",
   "kr": "또 들러 주십시오."
  },
  "118": {
   "jp": "fc5785ce",
   "kr": "손님도 줄고 영 마음이 가라앉기만 하는군…"
  },
  "119": {
   "jp": "d289c393",
   "kr": "엇? 아아… 어서 오게."
  },
  "120": {
   "jp": "76c31ab7",
   "kr": "방이라면 비어 있네만 식사는 생선 요리뿐"
  },
  "121": {
   "jp": "cbfaf6ec",
   "kr": "이네. 그리고 미리 말해 두네만"
  },
  "122": {
   "jp": "80fdc1fe",
   "kr": "쌀이나 보리도 많이는 못 내놓네."
  },
  "123": {
   "jp": "30dcd03c",
   "kr": "저기…"
  },
  "124": {
   "jp": "ad6e2132",
   "kr": "저희,"
  },
  "125": {
   "jp": "09c2b943",
   "kr": "이걸로 부탁드리고 싶은데요…"
  },
  "126": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "127": {
   "jp": "e5e796ee",
   "kr": "오? 설마 그건… 은단검!?"
  },
  "128": {
   "jp": "b8b618f7",
   "kr": "이거 길조로군."
  },
  "129": {
   "jp": "419add77",
   "kr": "순례 여행자가 묵어 준다니!"
  },
  "130": {
   "jp": "e1eeb511",
   "kr": "어두운 시절에 좋은 일일세."
  },
  "131": {
   "jp": "99765755",
   "kr": "그렇다면,"
  },
  "132": {
   "jp": "7d18e469",
   "kr": "나도 기꺼이 큰맘 먹어야지."
  },
  "133": {
   "jp": "45b451f0",
   "kr": "좋아, 정했네!"
  },
  "134": {
   "jp": "6c4f2d03",
   "kr": "안쪽 침대를 마음대로 쓰게나."
  },
  "135": {
   "jp": "830c8483",
   "kr": "미안하네만 계산대 건너편에서"
  },
  "136": {
   "jp": "b5e5bf9a",
   "kr": "말을 걸어 주게."
  },
  "137": {
   "jp": "710181c1",
   "kr": "방은 사양 말고 편히 써도 되네."
  },
  "138": {
   "jp": "8dbbd510",
   "kr": "너희가 찾아와 준 덕분에"
  },
  "139": {
   "jp": "e4814bd6",
   "kr": "아버지가 밝은 모습을 되찾은 것 같아."
  },
  "140": {
   "jp": "09955a48",
   "kr": "예부터 나그네들 사이엔"
  },
  "141": {
   "jp": "15144b4d",
   "kr": "지친 다리는 그림자에 잡힌다는 말이 있어."
  },
  "142": {
   "jp": "4524aef7",
   "kr": "무리해서 서둘러 봤자"
  },
  "143": {
   "jp": "2e40ad68",
   "kr": "발걸음만 둔해진다는 거지."
  },
  "144": {
   "jp": "e519453f",
   "kr": "느긋하게 쉬었다 가라고."
  },
  "145": {
   "jp": "304757ea",
   "kr": "혹시 순례 여행자예요?"
  },
  "146": {
   "jp": "f0c8baaa",
   "kr": "그럼, 테그라 샤리네로 향하는 거죠?"
  },
  "147": {
   "jp": "4517f89b",
   "kr": "테그라라면 알데 어선을 얻어 타면"
  },
  "148": {
   "jp": "c208c9a4",
   "kr": "반나절이면 닿을 거예요."
  },
  "149": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "150": {
   "jp": "8b0066a5",
   "kr": "그런데, 알데의 어부들은 성미가 거치니까"
  },
  "151": {
   "jp": "70349293",
   "kr": "조심하는 게 좋아요."
  },
  "152": {
   "jp": "f7c1cb50",
   "kr": "여러분이 무사히 올도스에 도착하기를"
  },
  "153": {
   "jp": "28dc4900",
   "kr": "빌게요."
  },
  "154": {
   "jp": "9a5c0ff9",
   "kr": "미안해요, 1인 1개예요."
  },
  "155": {
   "jp": "fbc09a42",
   "kr": "예. 손님도 말린 고기를 사시려고요?"
  },
  "156": {
   "jp": "6b6b67c0",
   "kr": "4 Pia인데, 괜찮으시죠?"
  },
  "157": {
   "jp": "68f34c14",
   "kr": "고맙습니다!"
  },
  "158": {
   "jp": "0c7293c0",
   "kr": "영양 듬뿍 멧돼지 말린 고기예요!"
  },
  "159": {
   "jp": "27580c2d",
   "kr": "맛있어요!"
  },
  "160": {
   "jp": "27134982",
   "kr": "쥬리오 일행은 말린 고기를 샀다."
  },
  "161": {
   "jp": "fa448be9",
   "kr": "아빠가 잡은 멧돼지 고기일지도 몰라."
  },
  "162": {
   "jp": "d184eb06",
   "kr": "크리스도 먹어 봐. 맛있어."
  },
  "163": {
   "jp": "172f8f76",
   "kr": "벌써 먹어 버렸어."
  },
  "164": {
   "jp": "45b4698f",
   "kr": "이런, Pia가 모자라시네요."
  },
  "165": {
   "jp": "5999de2c",
   "kr": "맛있다니까요."
  },
  "166": {
   "jp": "63b37c50",
   "kr": "나중에 후회 마세요."
  },
  "167": {
   "jp": "7a921744",
   "kr": "20년쯤 전에 하얀마녀가 이곳을 찾아와"
  },
  "168": {
   "jp": "d7aaa338",
   "kr": "장차 메나트에 흉작이 일어난다는 예언을"
  },
  "169": {
   "jp": "8048ac75",
   "kr": "남겼다는데…"
  },
  "170": {
   "jp": "b441f5ad",
   "kr": "그게 설마"
  },
  "171": {
   "jp": "64ace9b9",
   "kr": "정말로 일어날 줄이야."
  },
  "172": {
   "jp": "6d3caf63",
   "kr": "생선만 먹으면 질리니까 말이야."
  },
  "173": {
   "jp": "8604191a",
   "kr": "가끔은 실컷 고기를 먹고 싶어."
  },
  "174": {
   "jp": "2816bd70",
   "kr": "이 나라에도 멧돼지가 있으면 좋을 텐데."
  },
  "175": {
   "jp": "449a007c",
   "kr": "쥬리오는 은단검을 건네받았다."
  },
  "176": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "177": {
   "jp": "9cbbef1f",
   "kr": "여러분, 정말"
  },
  "178": {
   "jp": "88239568",
   "kr": "고맙습니다."
  },
  "179": {
   "jp": "e11e469d",
   "kr": "다 같이 힘 모으면 순식간이죠."
  },
  "180": {
   "jp": "de91dd95",
   "kr": "또, 어려운 일이 있으면"
  },
  "181": {
   "jp": "1b031bfa",
   "kr": "사양 말고 말해 주세요."
  },
  "182": {
   "jp": "5f8284c7",
   "kr": "형, 누나."
  },
  "183": {
   "jp": "83d18db3",
   "kr": "떠나기 전에 우리 집에 들러."
  },
  "184": {
   "jp": "131e824d",
   "kr": "주고 싶은 게 있으니까."
  },
  "185": {
   "jp": "34ca8755",
   "kr": "순례하는 꼬마들도 고생 많았어."
  },
  "186": {
   "jp": "fffd7be0",
   "kr": "어려울 땐"
  },
  "187": {
   "jp": "ab7e20bd",
   "kr": "서로 돕는 거지."
  },
  "188": {
   "jp": "c02785c9",
   "kr": "자, 주점으로 돌아가서"
  },
  "189": {
   "jp": "5681e0d6",
   "kr": "한 잔 더 걸치고 가야지!"
  },
  "190": {
   "jp": "d3545a27",
   "kr": "말린 고기 더 먹고 싶어."
  },
  "191": {
   "jp": "53790106",
   "kr": "이야! 오랜만."
  },
  "192": {
   "jp": "b1ce3c83",
   "kr": "같이 한잔 안 할래?"
  },
  "193": {
   "jp": "4b590aa5",
   "kr": "아〜, 남을 도운 뒤엔"
  },
  "194": {
   "jp": "7257fecf",
   "kr": "기분이 좋구나."
  },
  "195": {
   "jp": "de91dd95",
   "kr": "또, 곤란한 일이 있으면"
  },
  "196": {
   "jp": "96feb90f",
   "kr": "스스럼없이 말해 주세요."
  },
  "197": {
   "jp": "6708987c",
   "kr": "마녀란 거, 무섭구먼."
  },
  "198": {
   "jp": "3653074f",
   "kr": "끅."
  },
  "199": {
   "jp": "739cab40",
   "kr": "곤란한 일이 있으면,"
  },
  "200": {
   "jp": "a0628cd1",
   "kr": "언제든 찾아오라고. 상담해 줄 테니."
  },
  "201": {
   "jp": "ecd10f40",
   "kr": "으읏."
  },
  "202": {
   "jp": "d058be14",
   "kr": "너도 같이 마실래?"
  },
  "203": {
   "jp": "5f8284c7",
   "kr": "형, 누나."
  },
  "204": {
   "jp": "5e1972c3",
   "kr": "자, 이거!"
  },
  "205": {
   "jp": "b34967b9",
   "kr": "카이는 쥬리오에게 하얀 돌을 내밀었다."
  },
  "206": {
   "jp": "5a736718",
   "kr": "짐이 가득하니까,"
  },
  "207": {
   "jp": "b5daa3cb",
   "kr": "또 올게."
  },
  "208": {
   "jp": "530b33ed",
   "kr": "이건?"
  },
  "209": {
   "jp": "05c91e2a",
   "kr": "화이트스톤이라는 거야."
  },
  "210": {
   "jp": "77d093b8",
   "kr": "형한테 이걸 줄게."
  },
  "211": {
   "jp": "e2c1755a",
   "kr": "여행에 분명 도움이 될 거야."
  },
  "212": {
   "jp": "5269a06c",
   "kr": "이 돌에는 신기한 힘이 있대."
  },
  "213": {
   "jp": "1ad43f4b",
   "kr": "정말? 받아도 되는 거야?"
  },
  "214": {
   "jp": "06710152",
   "kr": "괜찮으니, 받아 주세요."
  },
  "215": {
   "jp": "307179a3",
   "kr": "고마워. 소중히 간직할게."
  },
  "216": {
   "jp": "ac1bbbc6",
   "kr": "쥬리오는 화이트스톤을 받았다."
  },
  "217": {
   "jp": "56511d75",
   "kr": "이거면 무서운 마수가 와도"
  },
  "218": {
   "jp": "e3511782",
   "kr": "끄떡없을 거야."
  },
  "219": {
   "jp": "de91dd95",
   "kr": "또 어려운 일이 있으면"
  },
  "220": {
   "jp": "0f582199",
   "kr": "나한테 말해 줘."
  },
  "221": {
   "jp": "2b2dfed3",
   "kr": "어머, 카이도 참"
  },
  "222": {
   "jp": "a3c10107",
   "kr": "건방진 소리를 하네요."
  },
  "223": {
   "jp": "ed306d71",
   "kr": "뭐여?"
  },
  "224": {
   "jp": "07622745",
   "kr": "가까이 오지 말어."
  },
  "225": {
   "jp": "373afbe8",
   "kr": "고기가 도망간당께."
  },
  "226": {
   "jp": "579b79e9",
   "kr": "아하. 보아하니,"
  },
  "227": {
   "jp": "d751d544",
   "kr": "방파제서 낚는 어부가 신기한 게지?"
  },
  "228": {
   "jp": "2d84c11d",
   "kr": "아무리 애를 써도 풍어까진 안 되지만,"
  },
  "229": {
   "jp": "98bc64cb",
   "kr": "이렇게 방파제서 낚기만 하면"
  },
  "230": {
   "jp": "c91da8b8",
   "kr": "뱃멀미도 안 한당께."
  },
  "231": {
   "jp": "864d7bb4",
   "kr": "찾던 물건을 찾아서 다행이에요."
  },
  "232": {
   "jp": "b43a3d9b",
   "kr": "조심해서 여행 계속하세요."
  }
 }
}