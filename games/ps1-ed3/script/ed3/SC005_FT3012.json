   "kr": "매발톱호"
  },
  "1": {
   "jp": "27ab0f1b",
   "kr": "로저"
  },
  "2": {
   "jp": "94c78bc6",
   "kr": "테스"
  },
  "3": {
   "jp": "a5ab341f",
   "kr": "톤쟈"
  },
  "4": {
   "jp": "6333e2dc",
   "kr": "헤스톤"
  },
  "5": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "6": {
   "jp": "6bd790bf",
   "kr": "잠겨 있어…"
  },
  "7": {
   "jp": "b9dab334",
   "kr": "방해하면 안 되겠지."
  },
  "8": {
   "jp": "46b45bc0",
   "kr": "잠겨 있어."
  },
  "9": {
   "jp": "9896e124",
   "kr": "헤스톤 씨한테도"
  },
  "10": {
   "jp": "a16f114c",
   "kr": "이야기를 들어 보자."
  },
  "11": {
   "jp": "1b421427",
   "kr": "실례합니다〜"
  },
  "12": {
   "jp": "11d31d53",
   "kr": "헤스톤 씨?"
  },
  "13": {
   "jp": "e333026e",
   "kr": "이야, 수부 군과 요리 아가씨로군."
  },
  "14": {
   "jp": "5825f245",
   "kr": "무슨 일인가?"
  },
  "15": {
   "jp": "6c2a39fe",
   "kr": "헤스톤 씨."
  },
  "16": {
   "jp": "268958cc",
   "kr": "뭔가 달라진 건"
  },
  "17": {
   "jp": "b5e519af",
   "kr": "없었나요?"
  },
  "18": {
   "jp": "facc1c9b",
   "kr": "달라진 거라니?"
  },
  "19": {
   "jp": "0911d7a7",
   "kr": "아니, 딱히 아무것도 없다만."
  },
  "20": {
   "jp": "1075700a",
   "kr": "무슨 일인가?"
  },
  "21": {
   "jp": "0f8dcf65",
   "kr": "아아, 미안하구나."
  },
  "22": {
   "jp": "7747b2ca",
   "kr": "서서 얘기하기도 그러니 안으로 들어오렴."
  },
  "23": {
   "jp": "1d0a81fc",
   "kr": "사양할 것 없다. 자."
  },
  "24": {
   "jp": "01c967c5",
   "kr": "그래, 대체 무슨 일이니?"
  },
  "25": {
   "jp": "a13994a1",
   "kr": "헤스톤 씨 주변에서"
  },
  "26": {
   "jp": "71de0e72",
   "kr": "뭔가 없어진 물건은 없나요?"
  },
  "27": {
   "jp": "fb9a41ba",
   "kr": "없어진 것…"
  },
  "28": {
   "jp": "6bfa3903",
   "kr": "아아!"
  },
  "29": {
   "jp": "95479c78",
   "kr": "그러고 보니 하나 없어진 게 있다."
  },
  "30": {
   "jp": "8fdc56f9",
   "kr": "금 브로치가 안 보이는구나."
  },
  "31": {
   "jp": "86a65c53",
   "kr": "어딘가에 두고 온 것 같다만."
  },
  "32": {
   "jp": "9f295c94",
   "kr": "뭐, 신경 안 쓰지만."
  },
  "33": {
   "jp": "d0266993",
   "kr": "엇!?"
  },
  "34": {
   "jp": "d968587e",
   "kr": "금 브로치가 없어졌다고요!"
  },
  "35": {
   "jp": "2507ed45",
   "kr": "헤스톤 씨가 그리 말해 옷깃을 보니"
  },
  "36": {
   "jp": "7fe3f201",
   "kr": "확실히 금 브로치는 달려 있지 않았다."
  },
  "37": {
   "jp": "59283a34",
   "kr": "하하하, 아가씨."
  },
  "38": {
   "jp": "dcbc3019",
   "kr": "그렇게 요란하게 놀랄 정도는 아니란다."
  },
  "39": {
   "jp": "471e71b8",
   "kr": "그런 싸구려 얼마 하지도 않으니까."
  },
  "40": {
   "jp": "570051e3",
   "kr": "그, 그래도…"
  },
  "41": {
   "jp": "de78c8b8",
   "kr": "그보다, 그 은단검 말인데."
  },
  "42": {
   "jp": "22c19d65",
   "kr": "늘 몸에서 떼지 않고 지니고 다니니?"
  },
  "43": {
   "jp": "f7f75c48",
   "kr": "그건 위험하구나."
  },
  "44": {
   "jp": "2be0039e",
   "kr": "그야말로 떨어뜨리면 큰일이다."
  },
  "45": {
   "jp": "72d4237e",
   "kr": "바다에 빠뜨리면 그걸로 끝이고 선실에 엄중히"
  },
  "46": {
   "jp": "03d51272",
   "kr": "보관해 두는 편이 안전할 거란다."
  },
  "47": {
   "jp": "d0e2f1d3",
   "kr": "그렇게 듣고 보면"
  },
  "48": {
   "jp": "a6e8b7ca",
   "kr": "확실히 그렇네요."
  },
  "49": {
   "jp": "de411b30",
   "kr": "그럼, 금 브로치를 찾으면"
  },
  "50": {
   "jp": "791a9a8b",
   "kr": "바로 알려 드릴게요."
  },
  "51": {
   "jp": "a8d9f9ff",
   "kr": "미안하구나."
  },
  "52": {
   "jp": "34da3cd6",
   "kr": "나는 이미 포기했으니"
  },
  "53": {
   "jp": "6ecc66a5",
   "kr": "너무 신경 쓰지 말게."
  },
  "54": {
   "jp": "d2793484",
   "kr": "얘야, 얘야."
  },
  "55": {
   "jp": "99003a47",
   "kr": "그 가방은 누구에게도 못 만지게 하는"
  },
  "56": {
   "jp": "4f136d68",
   "kr": "소중한 물건이거든."
  },
  "57": {
   "jp": "d747eee2",
   "kr": "이해해 주겠지?"
  },
  "58": {
   "jp": "21b7dc33",
   "kr": "이야, 쥬리오 군."
  },
  "59": {
   "jp": "1802459f",
   "kr": "역시 안 보이는구나."
  },
  "60": {
   "jp": "dd1834c1",
   "kr": "난처하군."
  },
  "61": {
   "jp": "d9132d16",
   "kr": "정말 미안하구나."
  },
  "62": {
   "jp": "bf77b0fd",
   "kr": "그 회중시계는 무척 소중한 물건이거든."
  },
  "63": {
   "jp": "8fca5072",
   "kr": "역시 이 방에는 없나 보구나."
  },
  "64": {
   "jp": "b65d6ac4",
   "kr": "크리스까지 와 준 거니?"
  },
  "65": {
   "jp": "331ba73b",
   "kr": "폐를 끼쳐 미안하구나."
  },
  "66": {
   "jp": "3afbebff",
   "kr": "아뇨."
  },
  "67": {
   "jp": "bdeff526",
   "kr": "좋아하는 사람한테 받은 선물은"
  },
  "68": {
   "jp": "cfc67fe8",
   "kr": "정말 소중한걸요."
  },
  "69": {
   "jp": "a36cda34",
   "kr": "냠냠… 새근새근…"
  },
  "70": {
   "jp": "776e4c11",
   "kr": "드르르르… 드르렁…"
  },
  "71": {
   "jp": "f3b62fcc",
   "kr": "…푸우… 냠냠."
  },
  "72": {
   "jp": "237086e3",
   "kr": "푹 자네."
  },
  "73": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "74": {
   "jp": "6c8275af",
   "kr": "아까부터 계속 자고 있어."
  },
  "75": {
   "jp": "9a01f490",
   "kr": "뭔가 이상한데…"
  },
  "76": {
   "jp": "b469b591",
   "kr": "없어진 브로치는"
  },
  "77": {
   "jp": "143a3c56",
   "kr": "그저 싸구려니까"
  },
  "78": {
   "jp": "2dc49d9e",
   "kr": "신경 쓰지 말게."
  },
  "79": {
   "jp": "ce6327b9",
   "kr": "슬슬 차를 마실까 해서 말이야."
  },
  "80": {
   "jp": "b2736f2d",
   "kr": "홍차를 우리던 참이란다."
  },
  "81": {
   "jp": "359e8dcd",
   "kr": "좋은 향기."
  },
  "82": {
   "jp": "54b85953",
   "kr": "미안해요, 헤스톤 씨."
  },
  "83": {
   "jp": "75f6cefe",
   "kr": "아직 금 브로치는 못 찾았어요."
  },
  "84": {
   "jp": "53e471a4",
   "kr": "그건 신경 쓰지 말게."
  },
  "85": {
   "jp": "1eaddbf3",
   "kr": "참 그렇지."
  },
  "86": {
   "jp": "34f98daa",
   "kr": "너희도 마시고 가지 않겠니?"
  },
  "87": {
   "jp": "d7f10cbc",
   "kr": "금방 준비할 수 있으니."
  },
  "88": {
   "jp": "690e4b2b",
   "kr": "질버 선장님께 일을 부탁받은"
  },
  "89": {
   "jp": "9255de41",
   "kr": "중이라서요…"
  },
  "90": {
   "jp": "dce684e0",
   "kr": "그런가."
  },
  "91": {
   "jp": "494b3cce",
   "kr": "그럼 또, 다음 기회에."
  },
  "92": {
   "jp": "c5aea5d4",
   "kr": "늘 신세를 지고 있는 수부 군들에게도"
  },
  "93": {
   "jp": "ae383c82",
   "kr": "홍차를 우려 줘야지."
  }
 }
