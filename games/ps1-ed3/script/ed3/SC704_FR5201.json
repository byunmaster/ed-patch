  "0": {
   "jp": "118f0213",
   "kr": "게르드 언덕"
  },
  "1": {
   "jp": "e9b19f1b",
   "kr": "나는 한 걸음도 움직일 수 없었다."
  },
  "2": {
   "jp": "f9acd70a",
   "kr": "그것이 레바스의 힘이었나…"
  },
  "3": {
   "jp": "e7387cac",
   "kr": "아니…"
  },
  "4": {
   "jp": "c427adac",
   "kr": "지금 와서 생각하면,"
  },
  "5": {
   "jp": "cd357f4a",
   "kr": "게르드의 힘이었는지도 모른다."
  },
  "6": {
   "jp": "937457d8",
   "kr": "그때 움직일 수 있었다면,"
