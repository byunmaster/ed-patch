  "170": {
   "jp": "0ffb06e3",
   "kr": "사악한 힘을 억누르는 작용이 있습니다."
  },
  "171": {
   "jp": "0ec2ea76",
   "kr": "보통 장소에서"
  },
  "172": {
   "jp": "f2ab1870",
   "kr": "이만한 공격을 받았다면"
  },
  "173": {
   "jp": "fe7bf4f2",
   "kr": "이 정도로는 안 끝났을 겁니다."
  },
  "174": {
   "jp": "1c8ced36",
   "kr": "이봐, 괜찮냐? 무슨 일이 있었어?"
  },
  "175": {
   "jp": "941a37cd",
   "kr": "시플의 현자가"
  },
  "176": {
   "jp": "bca491b8",
   "kr": "가짜였어."
  },
  "177": {
   "jp": "f0657356",
   "kr": "진짜 이름은"
  },
  "178": {
   "jp": "bdde0e93",
   "kr": "환술사 카지무라고 했어."
  },
  "179": {
   "jp": "5bc5de6e",
   "kr": "카지무라고요…?!"
  },
  "180": {
   "jp": "7363f268",
   "kr": "알고 있나."
  },
  "181": {
   "jp": "8b9236cd",
   "kr": "예."
  },
  "182": {
   "jp": "30f23879",
   "kr": "안타깝게도 마법을 쓰는 자가"
  },
  "183": {
   "jp": "db791519",
   "kr": "모두 좋은 뜻을 품은 것은 아니옵니다."
  },
  "184": {
   "jp": "a0d2cd3e",
   "kr": "환술사 카지무는 마법 솜씨를 인정받아"
  },
  "185": {
   "jp": "3f64d832",
   "kr": "악한 자들의 앞잡이 노릇을"
  },
  "186": {
   "jp": "164fdac4",
   "kr": "생업으로 삼는 자입니다."
  },
  "187": {
   "jp": "9941fd57",
   "kr": "마법 쓰는 용병 같은 거란 말이냐?"
  },
  "188": {
   "jp": "9d2f60ff",
   "kr": "근데 대체 왜"
  },
  "189": {
   "jp": "f32ccc2c",
   "kr": "그런 놈이 쥬리오 일행을 습격한 거지."
  },
  "190": {
   "jp": "5bb288ee",
   "kr": "가루가 계획을 방해했기 때문이라고 했어."
  },
  "191": {
   "jp": "6aaeb9e3",
   "kr": "흐음, 그렇군."
  },
  "192": {
   "jp": "269afee6",
   "kr": "그러고 보니 마기사가 말했었지요."
  },
  "193": {
   "jp": "7ff5f3ec",
   "kr": "온순한 가루가에 마수를 기생시켜"
  },
  "194": {
   "jp": "9ca5dc7d",
   "kr": "날뛰게 한 자가 있을 거라고…"
  },
  "195": {
   "jp": "6f6a1669",
   "kr": "그게 카지무 일당이야."
  },
  "196": {
   "jp": "fa7de15d",
   "kr": "분명 그런 거야!"
  },
  "197": {
   "jp": "bdc054c7",
   "kr": "맞아! 이러고 있을 순 없어."
  },
  "198": {
   "jp": "1ae2442e",
   "kr": "진짜 시플의 현자님이"
  },
  "199": {
   "jp": "86c3ebb9",
   "kr": "어딘가에 잡혀 있을 거야."
  },
  "200": {
   "jp": "4ffabd63",
   "kr": "그래, 찾아야 해."
  },
  "201": {
   "jp": "3846b27f",
   "kr": "진짜 현자님은 어디 계실까."
  },
  "202": {
   "jp": "d1a49c3b",
   "kr": "어서 찾아야 해."
  }
 }
