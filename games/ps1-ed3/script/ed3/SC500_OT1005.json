  "2": {
   "jp": "9e6bdc61",
   "kr": "무기상 오레이"
  },
  "3": {
   "jp": "023253ea",
   "kr": "나리스"
  },
  "4": {
   "jp": "6360b1e8",
   "kr": "류넬"
  },
  "5": {
   "jp": "652bcdbe",
   "kr": "파수꾼"
  },
  "6": {
   "jp": "d94c6e8c",
   "kr": "입국 담당"
  },
  "7": {
   "jp": "8ae08220",
   "kr": "모치카"
  },
  "8": {
   "jp": "bb5ca48f",
   "kr": "만톤"
  },
  "9": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "10": {
   "jp": "42e4b96c",
   "kr": "기운 넘치는 노천 장사다."
  },
  "11": {
   "jp": "446b11d7",
   "kr": "방어구 종류엔 자신 있다고."
  },
  "12": {
   "jp": "791b86e6",
   "kr": "뭘 원하냐?"
  },
  "13": {
   "jp": "43d57116",
   "kr": "아아"
  },
  "14": {
   "jp": "1fa0519c",
   "kr": "은(는)"
  },
  "15": {
   "jp": "7350618f",
   "kr": "에"
  },
  "16": {
   "jp": "3943bc3c",
   "kr": "합의 보자고."
  },
  "17": {
   "jp": "2dfe9fa5",
   "kr": "뭘 사 주면 되냐?"
  },
  "18": {
   "jp": "f6cfaba1",
   "kr": "?"
  },
  "19": {
   "jp": "bcc69dca",
   "kr": "그런 걸 사들여도 곤란하다고."
  },
  "20": {
   "jp": "9412f360",
   "kr": "뭐"
  },
  "21": {
   "jp": "6035f86a",
   "kr": ", 그게 고작이라고."
  },
  "22": {
   "jp": "1c461735",
   "kr": "1 Goa에 15 Pia다."
  },
  "23": {
   "jp": "102345c1",
   "kr": "환전하는 거냐?"
  },
  "24": {
   "jp": "9129b839",
   "kr": "좋아, 그러면"
  },
  "25": {
   "jp": "c8e34810",
   "kr": "야."
  },
  "26": {
   "jp": "af9c2b06",
   "kr": "환전이란 건 라피카가 없으면"
  },
  "27": {
   "jp": "9acd9dc6",
   "kr": "못 하는 거라고."
  },
  "28": {
   "jp": "efd27109",
   "kr": "그런 것도 몰랐던 거냐?"
  },
  "29": {
   "jp": "70b69130",
   "kr": "딴 볼일은?"
  },
  "30": {
   "jp": "982414f7",
   "kr": "늘 고맙수다!"
  },
  "31": {
   "jp": "dc639ad0",
   "kr": "예, 어서 옵쇼."
  },
  "32": {
   "jp": "745b3b7a",
   "kr": "우리 가게는 무기 구색이 삼국 제일이다."
  },
  "33": {
   "jp": "0ae72bd6",
   "kr": "자, 좀 보고 가라고."
  },
  "34": {
   "jp": "785f6ecf",
   "kr": "어느 무기든 괜찮다고."
  },
  "35": {
   "jp": "33c20efb",
   "kr": "얼른 골라 달라고."
  },
  "36": {
   "jp": "c1654371",
   "kr": "인가…"
  },
  "37": {
   "jp": "dba027db",
   "kr": "좋아, 큰맘 먹고"
  },
  "38": {
   "jp": "b346a5a3",
   "kr": "면 되겠어."
  },
  "39": {
   "jp": "9bee4746",
   "kr": "뭘 팔아 줄 건가?"
  },
  "40": {
   "jp": "079016ce",
   "kr": "쓸모 있는 게 좋은데…"
  },
  "41": {
   "jp": "6beef6d9",
   "kr": "그, 그건 환상의"
  },
  "42": {
   "jp": "3fd7d156",
   "kr": "아닌가."
  },
  "43": {
   "jp": "c55ccc9e",
   "kr": "낼 테니, 꼭 팔아 다오."
  },
  "44": {
   "jp": "8b1104c4",
   "kr": "우리 환전율은 높아."
  },
  "45": {
   "jp": "191187c3",
   "kr": "큰 소리로는 말 못 하지만"
  },
  "46": {
   "jp": "90103862",
   "kr": "1 Goa가 20 Pia야."
  },
  "47": {
   "jp": "3c75b61a",
   "kr": "환전하겠냐?"
  },
  "48": {
   "jp": "48f941c8",
   "kr": "어라?"
  },
  "49": {
   "jp": "183abae4",
   "kr": "앗, 맞다 맞다."
  },
  "50": {
   "jp": "e7f628d6",
   "kr": "이 환율은 지난달까지 거였어."
  },
  "51": {
   "jp": "688b77d4",
   "kr": "지금은 15 Pia로 하고 있어."
  },
  "52": {
   "jp": "dd92323c",
   "kr": "그래도 괜찮겠냐?"
  },
  "53": {
   "jp": "ead9e71f",
   "kr": "아니, 잘못 알려 줘서 미안하군."
  },
  "54": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "55": {
   "jp": "67981c16",
   "kr": "다니까."
  },
  "56": {
   "jp": "2b3438e2",
   "kr": "이런이런, 라피카가 없나 보군."
  },
  "57": {
   "jp": "ff297950",
   "kr": "얼른 모아 오라고."
  },
  "58": {
   "jp": "f52e7ba9",
   "kr": "그런가…"
  },
  "59": {
   "jp": "d3d3aa7e",
   "kr": "미안하게 됐어. 괜히 기대하게 해서."
  },
  "60": {
   "jp": "567d08de",
   "kr": "달리 해 줄 일은 있나?"
  },
  "61": {
   "jp": "690ccc71",
   "kr": "또 들러 달라고."
  },
  "62": {
   "jp": "a82aa7d7",
   "kr": "올도스는 성자의 마을이니까요."
  },
  "63": {
   "jp": "6b94bf74",
   "kr": "싸움을 위한 무기를 파는 무기점은"
  },
  "64": {
   "jp": "2c4a392f",
   "kr": "마을 안에 들어올 수 없답니다."
  },
  "65": {
   "jp": "eae0899a",
   "kr": "잘됐어요."
  },
  "66": {
   "jp": "05d7af8c",
   "kr": "모처럼 올도스까지 왔는데"
  },
  "67": {
   "jp": "74615830",
   "kr": "계속 저주받은 채로는"
  },
  "68": {
   "jp": "a1e07527",
   "kr": "너무 슬프잖아요."
  },
  "69": {
   "jp": "5ca5ea42",
   "kr": "여어, 고생 많았지."
  },
  "70": {
   "jp": "16266899",
   "kr": "늘 여기서 보고 있었으니까"
  },
  "71": {
   "jp": "867f3221",
   "kr": "나도 마음이 쓰였다고."
  },
  "72": {
   "jp": "d4600213",
   "kr": "아래쪽 류넬도,"
  },
  "73": {
   "jp": "993cb7a2",
   "kr": "네가 약을 구하러 올도스를 떠난 뒤로"
  },
  "74": {
   "jp": "2df73466",
   "kr": "줄곧 걱정스레 문에 서 있었다니까."
  },
  "75": {
   "jp": "96495ee2",
   "kr": "저 녀석도 괜찮은 데가 있다니까."
  },
  "76": {
   "jp": "608fc2be",
   "kr": "일행 상태가 나은 모양이군."
  },
  "77": {
   "jp": "9bcca38f",
   "kr": "잘됐어."
  },
  "78": {
   "jp": "1939c20e",
   "kr": "여러분의 입국 수속은"
  },
  "79": {
   "jp": "9e882c04",
   "kr": "마쳐 두었습니다."
  },
  "80": {
   "jp": "44580bb4",
   "kr": "문제없습니다."
  },
  "81": {
   "jp": "10f228cf",
   "kr": "친구분은 말끔히 나으신 모양이군요."
  },
  "82": {
   "jp": "4e1aa915",
   "kr": "정말 다행입니다."
  },
  "83": {
   "jp": "5a1a954a",
   "kr": "늘 여행을 하겠지만,"
  },
  "84": {
   "jp": "18a65faa",
   "kr": "여행지에서 아픈 게 제일 서럽죠."
  },
  "85": {
   "jp": "5ee8e3d1",
   "kr": "몸조리 잘하세요."
  }
 }
