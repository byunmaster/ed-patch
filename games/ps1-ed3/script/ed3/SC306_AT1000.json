  },
  "1": {
   "jp": "a82af9b4",
   "kr": "샤리네"
  },
  "2": {
   "jp": "eb1caade",
   "kr": "라구"
  },
  "3": {
   "jp": "b8cccb7a",
   "kr": "페르나"
  },
  "4": {
   "jp": "84feee07",
   "kr": "유굼"
  },
  "5": {
   "jp": "bbfb1428",
   "kr": "행상인 카톨"
  },
  "6": {
   "jp": "f46a91ba",
   "kr": "토리아"
  },
  "7": {
   "jp": "2de1fd5a",
   "kr": "이그니스 현자"
  },
  "8": {
   "jp": "ec7d35d2",
   "kr": "봉고"
  },
  "9": {
   "jp": "cfb323f7",
   "kr": "미키"
  },
  "10": {
   "jp": "2bed45d0",
   "kr": "가루가가 습격해 온다는"
  },
  "11": {
   "jp": "4e97e7b4",
   "kr": "소문이 돌았는데"
  },
  "12": {
   "jp": "bad64efd",
   "kr": "어찌 됐으려나…"
  },
  "13": {
   "jp": "58d76244",
   "kr": "가루가라면"
  },
  "14": {
   "jp": "a0651b48",
   "kr": "이제 괜찮아요."
  },
  "15": {
   "jp": "c9499be5",
   "kr": "볼트에서 바다로 되돌아갔어요."
  },
  "16": {
   "jp": "843c6b93",
   "kr": "그래"
  },
  "17": {
   "jp": "b32ffce9",
   "kr": "그거 잘됐구나."
  },
  "18": {
   "jp": "df1b426d",
   "kr": "이제 할멈과 함께"
  },
  "19": {
   "jp": "c42e9a71",
   "kr": "볼트까지"
  },
  "20": {
   "jp": "385ce43e",
   "kr": "바다를 보러 갈까 하네."
  },
  "21": {
   "jp": "0b6eb649",
   "kr": "잘됐다. 잘됐어."
  },
  "22": {
   "jp": "0477b753",
   "kr": "할아버지와 결혼 40주년 기념 여행이랍니다."
  },
  "23": {
   "jp": "1cf4b429",
   "kr": "덕분에 건강해서"
  },
  "24": {
   "jp": "e1042b3d",
   "kr": "둘이서 이렇게"
  },
  "25": {
   "jp": "9fcb25b4",
   "kr": "여행을 할 수 있네요."
  },
  "26": {
   "jp": "ff8fb6aa",
   "kr": "두 사람도 무리하지 말고"
  },
  "27": {
   "jp": "16633389",
   "kr": "건강만큼은"
  },
  "28": {
   "jp": "4d554ce5",
   "kr": "부디 조심하세요."
  },
  "29": {
   "jp": "0480dac3",
   "kr": "호오, 아직 어린데"
  },
  "30": {
   "jp": "0e2e59c9",
   "kr": "둘이서 순례 여행이니?"
  },
  "31": {
   "jp": "55f59b0e",
   "kr": "네, 마을 관습이거든요."
  },
  "32": {
   "jp": "9f14041f",
   "kr": "마을 관습?"
  },
  "33": {
   "jp": "d145d67d",
   "kr": "혹시 너희"
  },
  "34": {
   "jp": "88b399d4",
   "kr": "라그픽 마을 사람이니?"
  },
  "35": {
   "jp": "d7801f4a",
   "kr": "어머, 잘 아시네요 아저씨."
  },
  "36": {
   "jp": "7dd9290c",
   "kr": "벌써 몇 해 전 일이 되려나…"
  },
  "37": {
   "jp": "10ba2536",
   "kr": "전에 라그픽 마을에서 순례를 떠났다는"
  },
  "38": {
   "jp": "e26f51f4",
   "kr": "사내아이를 집에 재워 준 적이 있지."
  },
  "39": {
   "jp": "32d25a73",
   "kr": "어머, 누굴까?"
  },
  "40": {
   "jp": "a0e59579",
   "kr": "누굴까."
  },
  "41": {
   "jp": "2b2c3d0d",
   "kr": "우리 앞이라면"
  },
  "42": {
   "jp": "38217eb2",
   "kr": "꽤 오래전 일이겠네."
  },
  "43": {
   "jp": "1eab6814",
   "kr": "그게…"
  },
  "44": {
   "jp": "8c8bbc2c",
   "kr": "으〜음."
  },
  "45": {
   "jp": "b297d55b",
   "kr": "보브… 아니 로브…"
  },
  "46": {
   "jp": "894bd95a",
   "kr": "아니구먼…"
  },
  "47": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "48": {
   "jp": "a6899a4d",
   "kr": "로그다!"
  },
  "49": {
   "jp": "2db459b5",
   "kr": "그래 그래, 로그다."
  },
  "50": {
   "jp": "a1b8c515",
   "kr": "그 이름이야."
  },
  "51": {
   "jp": "bd9e7967",
   "kr": "잘 지내려나."
  },
  "52": {
   "jp": "a25ecf33",
   "kr": "로그라면"
  },
  "53": {
   "jp": "b64703d1",
   "kr": "아주 잘 지내고 있어요."
  },
  "54": {
   "jp": "b631ee23",
   "kr": "네. 목수 일을 잘해요."
  },
  "55": {
   "jp": "9678b85a",
   "kr": "저랑 자주 놀아 줬어요."
  },
  "56": {
   "jp": "cf2860c8",
   "kr": "그러냐, 그거 잘됐구나."
  },
  "57": {
   "jp": "069e5e0d",
   "kr": "그건 그렇고 여행지에서 라그픽 사람을"
  },
  "58": {
   "jp": "da8a9004",
   "kr": "또 만나다니 묘한 인연이구나."
  },
  "59": {
   "jp": "bdf301f2",
   "kr": "나도 기회가 있으면"
  },
  "60": {
   "jp": "b9a06a11",
   "kr": "라그픽 마을에"
  },
  "61": {
   "jp": "07efdadf",
   "kr": "가 보고 싶구나."
  },
  "62": {
   "jp": "e79fd6cb",
   "kr": "여어, 안녕."
  },
  "63": {
   "jp": "fd760a7e",
   "kr": "샤리네의 도서실은"
  },
  "64": {
   "jp": "67014519",
   "kr": "여행의 즐거움 중 하나지."
  },
  "65": {
   "jp": "a16a7c7f",
   "kr": "여행자가 두고 간 책이나"
  },
  "66": {
   "jp": "9af9c7b2",
   "kr": "찾아온 이의 기념 노트."
  },
  "67": {
   "jp": "efb19159",
   "kr": "도움이 되는 책도 잔뜩 있으니까."
  },
  "68": {
   "jp": "dd03c76a",
   "kr": "난 샤리네에 오면"
  },
  "69": {
   "jp": "a321e60a",
   "kr": "늘 도서실에서 하루를 보내"
  },
  "70": {
   "jp": "9323a5ae",
   "kr": "버리곤 한단다."
  },
  "71": {
   "jp": "d0dce0f3",
   "kr": "이야, 올테가의 용 퇴치 책은"
  },
  "72": {
   "jp": "dabac917",
   "kr": "몇 번을 읽어도 재밌어."
  },
  "73": {
   "jp": "a9f6eba2",
   "kr": "나도 아까 읽었어."
  },
  "74": {
   "jp": "fd17690d",
   "kr": "용으로 변신할 수 있다니"
  },
  "75": {
   "jp": "140f29ee",
   "kr": "굉장한 마력이네."
  },
  "76": {
   "jp": "6ffc6c32",
   "kr": "맞아, 바로 거기야."
  },
  "77": {
   "jp": "7edacd88",
   "kr": "짜릿하지."
  },
  "78": {
   "jp": "edfedb9d",
   "kr": "잘 오셨습니다."
  },
  "79": {
   "jp": "fb2160c5",
   "kr": "그 나이에 샤리네 순례라니"
  },
  "80": {
   "jp": "f8929715",
   "kr": "기특하군요."
  },
  "81": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "82": {
   "jp": "c655f7bd",
   "kr": "저희 폴티아의 라그픽 마을에서"
  },
  "83": {
   "jp": "649be7c7",
   "kr": "순례를 왔어요."
  },
  "84": {
   "jp": "7fa4bf71",
   "kr": "안녕하세요, 쥬리오예요."
  },
  "85": {
   "jp": "b9db24de",
   "kr": "저는 크리스예요."
  },
  "86": {
   "jp": "a83577aa",
   "kr": "그러세요."
  },
  "87": {
   "jp": "4d23442c",
   "kr": "먼 길 오시느라"
  },
  "88": {
   "jp": "ca35b267",
   "kr": "수고하셨습니다."
  },
  "89": {
   "jp": "4f9cd2e8",
   "kr": "그러면 이 샤리네가 세 번째군요."
  },
  "90": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "91": {
   "jp": "e4c6bc75",
   "kr": "디네와 테그라는 봤어요."
  },
  "92": {
   "jp": "af109392",
   "kr": "이그니스가 세 번째예요."
  },
  "93": {
   "jp": "a83577aa",
   "kr": "그렇습니까."
  },
  "94": {
   "jp": "6bf5a479",
   "kr": "올도스는 마지막으로 정해져 있으니"
  },
  "95": {
   "jp": "8313ca3c",
   "kr": "다음은 시플의 바람의 샤리네군요."
  },
  "96": {
   "jp": "218ffd7c",
   "kr": "시플은 분명"
  },
  "97": {
   "jp": "4d1cfb7e",
   "kr": "우돌 나라에 있는 거지?"
  },
  "98": {
   "jp": "80306efa",
   "kr": "오는 도중에 이정표가 있었지."
  },
  "99": {
   "jp": "0e59d341",
   "kr": "챠놈의 다이스에서 서쪽으로 가는 쪽이야."
  },
  "100": {
   "jp": "b334bbae",
   "kr": "네, 그렇습니다."
  },
  "101": {
   "jp": "7733c91c",
   "kr": "자, 그럼 가시지요."
  },
  "102": {
   "jp": "6b8a6bef",
   "kr": "어떠셨습니까?"
  },
  "103": {
   "jp": "d8a39b55",
   "kr": "거듭 말씀드립니다만"
  },
  "104": {
   "jp": "1ca9697a",
   "kr": "마법의 거울에서 본 건 마음으로 받아들이고"
  },
  "105": {
   "jp": "f6ccc619",
   "kr": "스스로 생각하는 것이 중요합니다."
  },
  "106": {
   "jp": "e19b900d",
   "kr": "그것을 잊지 마시고"
  },
  "107": {
   "jp": "ee786b10",
   "kr": "부디 여행을 이어 가십시오."
  },
  "108": {
   "jp": "4096b43a",
   "kr": "기념 노트가 있다."
  },
  "109": {
   "jp": "9b992d14",
   "kr": "안을 보니 유난히 눈에 띄는"
  },
  "110": {
   "jp": "2c216c49",
   "kr": "서툰 글씨가 있었다."
  },
  "111": {
   "jp": "34be82f3",
   "kr": "쥬리오는 애써 읽어 보았다."
  },
  "112": {
   "jp": "25e62492",
   "kr": "나는 오늘 불의 샤리네 마법의 거울을 봤다."
  },
  "113": {
   "jp": "b679c578",
   "kr": "마법의 거울은 아이만 보인다니까"
  },
  "114": {
   "jp": "d7fafc91",
   "kr": "어른은 불쌍하다. 그래서 여기 쓴다."
  },
  "115": {
   "jp": "49527756",
   "kr": "불꽃이 확 오르더니 화르륵 했다."
  },
  "116": {
   "jp": "3b397da4",
   "kr": "그래서 활활 탔다."
  },
  "117": {
   "jp": "d0fc5619",
   "kr": "그러다 어두워지고 예쁜 별이 보였다."
  },
  "118": {
   "jp": "25a85a62",
   "kr": "반짝반짝했다."
  },
  "119": {
   "jp": "43307c4f",
   "kr": "뭔가 화르륵이라든가 반짝반짝이라든가"
  },
  "120": {
   "jp": "cc0f45cd",
   "kr": "알쏭달쏭한 문장이네…"
  },
  "121": {
   "jp": "b3015ce4",
   "kr": "누가 썼을까."
  },
  "122": {
   "jp": "2df2fa88",
   "kr": "쥬리오는 서명을 찾았다."
  },
  "123": {
   "jp": "5838fc82",
   "kr": "맨 마지막에"
  },
  "124": {
   "jp": "d6a6203d",
   "kr": "라그픽 마을 로그 참상!"
  },
  "125": {
   "jp": "d75a3885",
   "kr": "이라고 적혀 있는 걸 발견했다."
  },
  "126": {
   "jp": "3aa69678",
   "kr": "로그다."
  },
  "127": {
   "jp": "c8d3f124",
   "kr": "정말이네."
  },
  "128": {
   "jp": "ac041153",
   "kr": "로그답네."
  },
  "129": {
   "jp": "a0042b05",
   "kr": "몇 번 읽어도 로그다운 문장이라고"
  },
  "130": {
   "jp": "55fc01c2",
   "kr": "쥬리오는 생각했다."
  },
  "131": {
   "jp": "343b6da1",
   "kr": "책등에"
  },
  "132": {
   "jp": "1a80c468",
   "kr": "이그니스 샤리네〜그 유래"
  },
  "133": {
   "jp": "abb4ba0d",
   "kr": "라고 적혀 있다."
  },
  "134": {
   "jp": "851a3f8f",
   "kr": "쥬리오는 책을 손에 들고 읽어 보았다."
  },
  "135": {
   "jp": "0cf3cfe2",
   "kr": "이그니스 샤리네는 디네, 테그라,"
  },
  "136": {
   "jp": "f4de8609",
   "kr": "시플, 올도스 샤리네와 나란히"
  },
  "137": {
   "jp": "57d246da",
   "kr": "티라스일 5대 샤리네의 하나로"
  },
  "138": {
   "jp": "eb890186",
   "kr": "발달한 불을 다스리는 샤리네다."
  },
  "139": {
   "jp": "f7f75975",
   "kr": "마법의 거울은 다른 샤리네처럼 순례자들의"
  },
  "140": {
   "jp": "392f079d",
   "kr": "예배 대상이지만 예전에는 마녀나 승려"
  },
  "141": {
   "jp": "cc74e8ac",
   "kr": "등이 자신의 마음을 거울에 비춰 수행하는"
  },
  "142": {
   "jp": "2e89925b",
   "kr": "데 쓰였다고도 한다."
  },
  "143": {
   "jp": "87911445",
   "kr": "전설에 따르면 아득한 옛날 나라를 넘나드는"
  },
  "144": {
   "jp": "293556e2",
   "kr": "거인과 큰 뱀의 싸움이 있었고 진 큰 뱀은"
  },
  "145": {
   "jp": "8de224df",
   "kr": "앰비쉬 남쪽을 막는 대산맥 『큰 뱀의 등뼈』"
  },
  "146": {
   "jp": "dda7f080",
   "kr": "가 되었다고 전해진다."
  },
  "147": {
   "jp": "66a6cac4",
   "kr": "이그니스의 마법의 거울은 불꽃을 비추기에"
  },
  "148": {
   "jp": "559e9ea8",
   "kr": "『큰 뱀의 혀』라고도 불린다."
  },
  "149": {
   "jp": "19b9876a",
   "kr": "책등에 《대마도사 올테가의 용 퇴치》라고"
  },
  "150": {
   "jp": "738306f4",
   "kr": "적힌 책이 있다."
  },
  "151": {
   "jp": "2b32dbf8",
   "kr": "쥬리오는 손에 들고 책을 펼쳐 보았다."
  },
  "152": {
   "jp": "ed6962f7",
   "kr": "대마도사 올테가의 책이다."
  },
  "153": {
   "jp": "1c12d544",
   "kr": "나 전에 읽은 적 있어."
  },
  "154": {
   "jp": "5a134120",
   "kr": "《대마도사 올테가의 용 퇴치》"
  },
  "155": {
   "jp": "2ee4b8be",
   "kr": "대마도사 올테가는 놀라지도 않고 지팡이를"
  },
  "156": {
   "jp": "138354bd",
   "kr": "자신도 하늘을 나는 날개 달린 거대한 용으로"
  },
  "157": {
   "jp": "2c7980a2",
   "kr": "변신했다. 올테가의 용은 높이높이 솟았다."
  },
  "158": {
   "jp": "8d135634",
   "kr": "이윽고 어느 용보다 높이 오른 올테가는"
  },
  "159": {
   "jp": "114843e0",
   "kr": "급강하하며 용들에게 불을 뿜었다. 용들은"
  },
  "160": {
   "jp": "d50f0f90",
   "kr": "차례로 바다에 떨어져 모습을 감췄다."
  },
  "161": {
