 "lines": {
  "0": {
   "jp": "84e70172",
   "kr": "안데라성"
  },
  "1": {
   "jp": "cbfe7661",
   "kr": "지하 1층"
  },
  "2": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "3": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "4": {
   "jp": "cca8c26c",
   "kr": "일은 잘돼 가?"
  },
  "5": {
   "jp": "cdfab081",
   "kr": "잘난 척 마라."
  },
  "6": {
   "jp": "39b02fa1",
   "kr": "그건 그렇고"
  },
  "7": {
   "jp": "50bf3ad6",
   "kr": "설마, 그 녀석들이"
  },
  "8": {
   "jp": "460690a4",
   "kr": "이 성에 올 줄이야."
  },
  "9": {
   "jp": "f564ab3c",
   "kr": "쥬리오랑 크리스 말이지."
  },
  "10": {
   "jp": "7d8e4c12",
   "kr": "나도 놀랐다고."
  },
  "11": {
   "jp": "c6a08d0d",
   "kr": "정말이지, 왜 그 녀석들이"
  },
  "12": {
   "jp": "d9cde070",
   "kr": "여기 있는 거냐고."
  },
  "13": {
   "jp": "dfaf2d03",
   "kr": "볼트에서 임금님 가루가 퇴치를"
  },
  "14": {
   "jp": "17d80dd2",
   "kr": "도와줬다는 얘기야."
  },
  "15": {
   "jp": "a2dc9cad",
   "kr": "저런 꼬맹이가?"
  },
  "16": {
   "jp": "8c4d0228",
   "kr": "진짜냐."
  },
  "17": {
   "jp": "3beecf50",
   "kr": "젠장, 모처럼 가루가 소동을 틈타"
  },
  "18": {
   "jp": "4067bfd4",
   "kr": "안데라성에 숨어들어서"
  },
  "19": {
   "jp": "6fa88659",
   "kr": "성의 재물이라도 챙길까 했는데 말이야."
  },
  "20": {
   "jp": "8a0a7a99",
   "kr": "그 애들한테는 얼굴이 알려졌으니까."
  },
  "21": {
   "jp": "396220f0",
   "kr": "이거, 얼른 보물을 챙겨서"
  },
  "22": {
   "jp": "53f5c7fa",
   "kr": "뜨는 게 좋을 것 같네. 지금 챙겨서"
  },
  "23": {
   "jp": "62404bda",
   "kr": "도망칠까?"
  },
  "24": {
   "jp": "32ab5955",
   "kr": "아니. 지금 우리 모습이 사라지면"
  },
  "25": {
   "jp": "0f96c566",
   "kr": "제일 먼저 의심받는다. 내일 요리 콘테스트"
  },
  "26": {
   "jp": "691886ae",
   "kr": "한창일 때 챙겨서 튀자고."
  },
  "27": {
   "jp": "3e345ed7",
   "kr": "그럼 구스, 내일 봐."
  },
  "28": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "29": {
   "jp": "bac108cd",
   "kr": "샤라."
  },
  "30": {
   "jp": "e3d28cd1",
   "kr": "아자, 파이팅."
  },
  "31": {
   "jp": "3adae119",
   "kr": "………"
  },
  "32": {
   "jp": "fe35dafd",
   "kr": "됐으니까 제대로 망이나 봐."
  },
  "33": {
   "jp": "2dcf370e",
   "kr": "우리 보물을 도둑맞지 않게."
  },
  "34": {
   "jp": "0c0fac7d",
   "kr": "흥이다."
  }
 }
}