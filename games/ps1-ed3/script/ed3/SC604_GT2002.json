{
 "archive": "/SCE6/SC604.DAT",
 "member": "..\\DATA\\GT2002.BIN",
 "lines": {
  "0": {
   "jp": "dc464821",
   "kr": "기드넬"
  },
  "1": {
   "jp": "92f4a88d",
   "kr": "라치카"
  },
  "2": {
   "jp": "1eceebc2",
   "kr": "도구상 이스리"
  },
  "3": {
   "jp": "e1afb7ee",
   "kr": "나제"
  },
  "4": {
   "jp": "db83f74f",
   "kr": "후우."
  },
  "5": {
   "jp": "dc3660c2",
   "kr": "물맛 좋다아."
  },
  "6": {
   "jp": "264381f5",
   "kr": "하지만 물 같은 거 마실 때가 아니야."
  },
  "7": {
   "jp": "23164e11",
   "kr": "빨리 무화과를 찾아서"
  },
  "8": {
   "jp": "19eac22c",
   "kr": "우르기드 저택에 들어가 크리스를"
  },
  "9": {
   "jp": "8bcd0430",
   "kr": "구하러 가야 해."
  },
  "10": {
   "jp": "c83411a2",
   "kr": "그치만 말이야"
  },
  "11": {
   "jp": "fd0c0e7c",
   "kr": "무화과 같은 건 아무리 찾아도"
  },
  "12": {
   "jp": "d8c1715a",
   "kr": "없을지도 모른다고."
  },
  "13": {
   "jp": "951476b6",
   "kr": "다른 뭔가 진귀한 물건을 찾는 편이"
  },
  "14": {
   "jp": "5f445ee1",
   "kr": "낫지 않겠냐?"
  },
  "15": {
   "jp": "03db7e82",
   "kr": "그야"
  },
  "16": {
   "jp": "8859ed03",
   "kr": "달리 뭔가 진귀한 게 있으면"
  },
  "17": {
   "jp": "0a065e7a",
   "kr": "그것도 좋지만…"
  },
  "18": {
   "jp": "7be8df5a",
   "kr": "여자 목소리"
  },
  "19": {
   "jp": "b6dd5526",
   "kr": "쥬리오 군."
  },
  "20": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "21": {
   "jp": "38eabdd9",
   "kr": "하고 엉겁결에 집어 버렸는데…?"
  },
  "22": {
   "jp": "3d137404",
   "kr": "혹시…?"
  },
  "23": {
   "jp": "1d93e404",
   "kr": "또, 또… 포, 폭탄?!"
  },
  "24": {
   "jp": "3d8fc20e",
   "kr": "어떡하지, 어떡하지…"
  },
  "25": {
   "jp": "d2ed214d",
   "kr": "우물에 던져 버려."
  },
  "26": {
   "jp": "7440fe30",
   "kr": "그러네."
  },
  "27": {
   "jp": "7be8df5a",
   "kr": "여자 목소리"
  },
  "28": {
   "jp": "b8cc740f",
   "kr": "잠깐만요."
  },
  "29": {
   "jp": "f5af17de",
   "kr": "그건 폭탄이 아니에요."
  },
  "30": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "31": {
   "jp": "63f94425",
   "kr": "나제 씨."
  },
  "32": {
   "jp": "e6b22032",
   "kr": "나제 씨가 왜 낮에 있제?"
  },
  "33": {
   "jp": "9ab03722",
   "kr": "농담이야, 그거?"
  },
  "34": {
   "jp": "4f48b6d9",
   "kr": "생각하는 건 같군요."
  },
  "35": {
   "jp": "c7c61ee7",
   "kr": "그걸 잘 보세요."
  },
  "36": {
   "jp": "a69067f2",
   "kr": "폭탄인 줄 알았던 것은 무화과열매였다."
  },
  "37": {
   "jp": "f136e1c9",
   "kr": "해냈다. 무화과다."
  },
  "38": {
   "jp": "a105074b",
   "kr": "안 버려서… 다행이야."
  },
  "39": {
   "jp": "479579db",
   "kr": "어째서"
  },
  "40": {
   "jp": "e7bfacb8",
   "kr": "당신이 여기에?"
  },
  "41": {
   "jp": "df52f6a4",
   "kr": "여기는 남의 눈이 있어요."
  },
  "42": {
   "jp": "32adbc37",
   "kr": "어디 자리를 옮기죠."
  },
  "43": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "44": {
   "jp": "12ce270d",
   "kr": "그럼, 숙소 방으로 가요."
  }
 }
}