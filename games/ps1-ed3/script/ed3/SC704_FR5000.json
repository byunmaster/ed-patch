{
 "archive": "/SCE7/SC704.DAT",
 "member": "..\\DATA\\FR5000.BIN",
 "lines": {
  "0": {
   "jp": "118f0213",
   "kr": "게르드 언덕"
  },
  "1": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "2": {
   "jp": "b72695a3",
   "kr": "듀르젤 씨와 떨어지면 곤란해요."
  },
  "3": {
   "jp": "b25af28d",
   "kr": "들려주세요."
  },
  "4": {
   "jp": "73ca7404",
   "kr": "하얀마녀가 어째서 죽었는지…"
  },
  "5": {
   "jp": "3b48d6d7",
   "kr": "게르드가 남긴 희망의 빛이란…?"
  },
  "6": {
   "jp": "d8e3d30a",
   "kr": "여기가 게르드 언덕이다."
  },
  "7": {
   "jp": "2f9089bd",
   "kr": "각국을 떠돈 하얀마녀 게르드는"
  },
  "8": {
   "jp": "4823911b",
   "kr": "20년 전 이 땅에서 잠들었다."
  },
  "9": {
   "jp": "a8873fa3",
   "kr": "하얀마녀는…"
  },
  "10": {
   "jp": "c876887c",
   "kr": "역시… 죽어 버린 거예요…"
  },
  "11": {
   "jp": "3afb21c4",
   "kr": "정말 죽어 버린 거예요…?"
  },
  "12": {
   "jp": "d1a51799",
   "kr": "그… 그럼"
  },
  "13": {
   "jp": "b82c4950",
   "kr": "저흰 라우알에 대해"
  },
  "14": {
   "jp": "e1758bea",
   "kr": "물어볼 수 없잖아요…"
  },
  "15": {
   "jp": "b71ab5d7",
   "kr": "벌써 그때로부터 20년이 지난 것인가…"
  },
  "16": {
   "jp": "beb47bd7",
   "kr": "나에게는 마치"
  },
  "17": {
   "jp": "edf3ea20",
   "kr": "어제 일처럼만 느껴진다."
  },
  "18": {
   "jp": "83dc3678",
   "kr": "기가 막히는군…"
  },
  "19": {
   "jp": "6e3ffff6",
   "kr": "죽어 버렸으니"
  },
  "20": {
   "jp": "81607626",
   "kr": "그게 마지막 예언이었단 건가."
  },
  "21": {
   "jp": "f1cb8f59",
   "kr": "이러니 여기서"
  },
  "22": {
   "jp": "615be3ba",
   "kr": "발자취가 끊긴 거로군."
  },
  "23": {
   "jp": "1b0b2bae",
   "kr": "나는 말이지…"
  },
  "24": {
   "jp": "2c6aa4d1",
   "kr": "지금 아주 복잡한 심경이야."
  },
  "25": {
   "jp": "c160ced0",
   "kr": "분명히"
  },
  "26": {
   "jp": "016fe350",
   "kr": "이런 사실에 다다를 가능성은"
  },
  "27": {
   "jp": "baed6f66",
   "kr": "나도 생각하고 있었어…"
  },
  "28": {
   "jp": "1271ead2",
   "kr": "하지만 말이야."
  },
  "29": {
   "jp": "6c7a5e5b",
   "kr": "지금은 그저 슬퍼."
  },
  "30": {
   "jp": "5785510d",
   "kr": "가슴에 뚫린 빈자리를"
  },
  "31": {
   "jp": "d37c9e40",
   "kr": "차가운 바람이 스쳐 가는 듯해."
  },
  "32": {
   "jp": "3adae119",
   "kr": "………"
  },
  "33": {
   "jp": "006860e7",
   "kr": "무사하셨군요."
  },
  "34": {
   "jp": "025a4605",
   "kr": "기다리고 있었습니다."
  },
  "35": {
   "jp": "aa2d05ae",
   "kr": "허크 씨 일행께는"
  },
  "36": {
   "jp": "79c8b2bd",
   "kr": "대략적인 것을 설명해 두었습니다."
  },
  "37": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "38": {
   "jp": "e1a6f8b0",
   "kr": "할아버지께 들어서 알고는 있었지만"
  },
  "39": {
   "jp": "5ec626a1",
   "kr": "저도 처음 여기에 왔습니다."
  },
  "40": {
   "jp": "52ad3515",
   "kr": "무척 쓸쓸한 곳이네요…"
  },
  "41": {
   "jp": "6c2384e8",
   "kr": "검이다…"
  },
  "42": {
   "jp": "056b8089",
   "kr": "뭘까?"
  },
  "43": {
   "jp": "d99a451e",
   "kr": "검이 꽂혀 있어."
  },
  "44": {
   "jp": "2f8d7557",
   "kr": "계속 밤이슬을 맞아 온 거네."
  },
  "45": {
   "jp": "ae929d20",
   "kr": "녹슬었어."
  },
  "46": {
   "jp": "5039c070",
   "kr": "그건 내 검이다."
  },
  "47": {
   "jp": "62e53848",
   "kr": "나는 그 아이를 지키지 못했다."
  },
  "48": {
   "jp": "1cb9e922",
   "kr": "그래서"
  },
  "49": {
   "jp": "cc4103b6",
   "kr": "그날 이후 궁정 검사의 상징인 검을"
  },
  "50": {
   "jp": "a321c77a",
   "kr": "그 아이 곁에 묻은 것이다."
  },
  "51": {
   "jp": "905b160c",
   "kr": "내게는 이제"
  },
  "52": {
   "jp": "fa12003f",
   "kr": "그 검을 지닐 자격이 없다."
  },
  "53": {
   "jp": "3adae119",
   "kr": "………"
  },
  "54": {
   "jp": "87ff2da5",
   "kr": "비석에 글자가 새겨져 있어."
  },
  "55": {
   "jp": "361f9afe",
   "kr": "가가브력 972년"
  },
  "56": {
   "jp": "8b80df2f",
   "kr": "하얀마녀라 불린 여신"
  },
  "57": {
   "jp": "e8e135b5",
   "kr": "여기 잠들다."
  },
  "58": {
   "jp": "c30125a4",
   "kr": "비석엔 그렇게 새겨져 있다."
  },
  "59": {
   "jp": "cf3d08f2",
   "kr": "본 그대로다."
  },
  "60": {
   "jp": "45cb7c4b",
   "kr": "게르드는 이제 이 세상에 없다."
  },
  "61": {
   "jp": "772c57a6",
   "kr": "하지만 너희가 여기 온 덕에"
  },
  "62": {
   "jp": "4b32a6fc",
   "kr": "게르드의 힘을 빌릴 수 있을 것이다."
  },
  "63": {
   "jp": "0f8275e3",
   "kr": "죽어 버렸는데도요?"
  },
  "64": {
   "jp": "1eaddbf3",
   "kr": "그렇다."
  },
  "65": {
   "jp": "a684216a",
   "kr": "비록 육체는 스러져도 혼은 살아간다."
  },
  "66": {
   "jp": "a8b373fa",
   "kr": "그것이 게르드가 남긴 희망의 빛이다."
  },
  "67": {
   "jp": "fe688300",
   "kr": "모든 것은 돌페스의 해변에서 시작되었다."
  },
  "68": {
   "jp": "599ca18d",
   "kr": "돌페스의 해변?"
  },
  "69": {
   "jp": "1eaddbf3",
   "kr": "그렇다."
  },
  "70": {
   "jp": "83d35843",
   "kr": "게르드가 티라스일에 나타나기 2년쯤 전이다."
  },
  "71": {
   "jp": "81a34854",
   "kr": "아름다운 여자가 돌페스 해변에 닿았다."
  },
  "72": {
   "jp": "ddacdf58",
   "kr": "우연인가, 아니면 계산된 책략인가…"
  },
  "73": {
   "jp": "87522346",
   "kr": "떠밀려 온 여자를 발견한 것은"
  },
  "74": {
   "jp": "4ad41467",
   "kr": "돌페스의 탑에 요양하러 와 있던"
  },
  "75": {
   "jp": "ff3dd195",
   "kr": "루돌프 왕, 그 본인이었다."
  },
  "76": {
   "jp": "e1af539d",
   "kr": "마녀의 바다에서 떠밀려 온 여자다."
  },
  "77": {
   "jp": "0e382ae1",
   "kr": "근위 병단을 지휘하던 나는 만일을 생각하여"
  },
  "78": {
   "jp": "5f5ff8aa",
   "kr": "경계를 촉구했다…"
  },
  "79": {
   "jp": "9cb4bf43",
   "kr": "하지만 루돌프 왕은…"
  },
  "80": {
   "jp": "4753ae0d",
   "kr": "그 우려대로"
  },
  "81": {
   "jp": "00eca05f",
   "kr": "여자의 아름다움에 사로잡혀 버렸다."
  },
  "82": {
   "jp": "b5579870",
   "kr": "두 사람은 곧 사랑에 빠졌다."
  },
  "83": {
   "jp": "78daa3bd",
   "kr": "여자의 이름은 이자벨."
  },
  "84": {
   "jp": "337e8b35",
   "kr": "지금의 폴티아 왕비다."
  },
  "85": {
   "jp": "d76d8b6b",
   "kr": "이자벨 왕비…"
  },
  "86": {
   "jp": "9a09ac84",
   "kr": "내력도 알 수 없는 여자다."
  },
  "87": {
   "jp": "d5e3537c",
   "kr": "마녀일지도 모른다."
  },
  "88": {
   "jp": "ee31539e",
   "kr": "한번 솟은 의심은 부풀어 오를 뿐이다."
  },
  "89": {
   "jp": "548820f9",
   "kr": "물론 아무 일도 없다면 그걸로 좋다."
  },
  "90": {
   "jp": "8321a558",
   "kr": "하지만 나는 아무리 시간이 지나도"
  },
  "91": {
   "jp": "22165e7a",
   "kr": "가슴 술렁임을 지울 수 없었다."
  },
  "92": {
   "jp": "1620b06a",
   "kr": "이자벨 왕비가 루드성에 들어오고"
  },
  "93": {
   "jp": "161e017e",
   "kr": "반년이 지났을 때다."
  },
  "94": {
   "jp": "9a0b1164",
   "kr": "왕비의 요망으로 성에 천의실을 짓게 됐다."
  },
  "95": {
   "jp": "b3e4f579",
   "kr": "천측은 인간의 과학."
  },
  "96": {
   "jp": "0fa9b86c",
   "kr": "수상한 점술과는 다르다며 왕은 찬동했고"
  },
  "97": {
   "jp": "9993735a",
   "kr": "곧바로 건설이 시작되었다."
  },
  "98": {
   "jp": "064e907c",
   "kr": "의심은 있지만"
  },
  "99": {
   "jp": "fcf40e80",
   "kr": "루돌프 왕이 그것을 받아들이는 이상"
  },
  "100": {
   "jp": "d162f19e",
   "kr": "내게는 이의를 제기할 여지가 없었다."
  },
  "101": {
   "jp": "78cb2bb6",
   "kr": "이윽고 천의실이 완성되자"
  },
  "102": {
   "jp": "aa620535",
   "kr": "천문학자로서 점성술사가 초빙되었다."
  },
  "103": {
   "jp": "f7a50a5a",
   "kr": "그것이 레바스다."
  },
  "104": {
   "jp": "7994f1f2",
   "kr": "레바스…"
  },
  "105": {
   "jp": "62ab3d94",
   "kr": "기드나에도 나타나 우르기드와 칸다타를"
  },
  "106": {
   "jp": "f6ad8fc4",
   "kr": "꼬드긴 놈이지."
  },
  "107": {
   "jp": "2cc6507a",
   "kr": "분명 베라트도"
  },
  "108": {
   "jp": "eb25a596",
   "kr": "레바스 님이 어쩌고 했어."
  },
  "109": {
   "jp": "055fa896",
   "kr": "왕비처럼 그놈도 내력 모를 남자였다."
  },
  "110": {
   "jp": "6bf1f0aa",
   "kr": "모든 것은 짜인 함정이었던 것이다."
  },
  "111": {
   "jp": "6ad6b6fc",
   "kr": "지금에 와서는 놀랄 일도 아니다."
  },
  "112": {
   "jp": "3de04e6f",
   "kr": "내가 처음 느꼈던 가슴 술렁임을"
  },
  "113": {
   "jp": "915bf033",
   "kr": "잘 루돌프 왕에게"
  },
  "114": {
   "jp": "bbb333ec",
   "kr": "전할 수만 있었다면…"
  },
  "115": {
   "jp": "65227b3e",
   "kr": "그렇다. 바로 그 무렵이다."
  },
  "116": {
   "jp": "b507773b",
   "kr": "여러 나라를 순례하며 예언을 설한다는"
  },
  "117": {
   "jp": "bf7e7f17",
   "kr": "하얀마녀의 소문을 들은 것은."
  },
  "118": {
   "jp": "d55a76eb",
   "kr": "나는 루돌프 왕에게 불려 가"
  },
  "119": {
   "jp": "3f1e02ca",
   "kr": "밀명을 받았다."
  },
  "120": {
   "jp": "eb0a64d3",
   "kr": "세상을 어지럽히는 하얀마녀를 붙잡으라고."
  },
  "121": {
   "jp": "12e32b0f",
   "kr": "하얀마녀에 대해선 나쁜 소문도 돌았지만"
  },
  "122": {
   "jp": "aa2c8cbd",
   "kr": "그것은 마녀를 두려워한 나머지의"
  },
  "123": {
   "jp": "b952cac7",
   "kr": "편견 같은 것이 대부분이었다."
  },
  "124": {
   "jp": "f960903e",
   "kr": "내게는 하얀마녀를"
  },
  "125": {
   "jp": "e035b0d6",
   "kr": "붙잡을 만한 일은 아닌"
  },
  "126": {
   "jp": "0eb719a3",
   "kr": "것처럼 여겨졌다."
  },
  "127": {
   "jp": "ca86c3b7",
   "kr": "그건 그렇고"
  },
  "128": {
   "jp": "7bf5ad97",
   "kr": "이런 명령은 지금까지 없었다."
  },
  "129": {
   "jp": "d538e5d4",
   "kr": "루돌프 왕은 현명한 분이셨다."
  },
  "130": {
   "jp": "c873ddef",
   "kr": "아무리 상대가 마녀라 해도"
  },
  "131": {
   "jp": "5eeb3089",
   "kr": "사실 규명을 명하는 거라면 몰라도"
  },
  "132": {
   "jp": "26ea234d",
   "kr": "다짜고짜 붙잡으라니…"
  },
  "133": {
   "jp": "77ab2d5c",
   "kr": "한번 솟은 의심은 부풀어 오를 뿐이다."
  }
 }
}