{
 "archive": "/SCE0/SC008.DAT",
 "member": "..\\DATA\\FT7010.BIN",
 "lines": {
  "0": {
   "jp": "e69f08bd",
   "kr": "닐리"
  },
  "1": {
   "jp": "aa151e61",
   "kr": "선착장"
  },
  "2": {
   "jp": "0f879f86",
   "kr": "보스레이"
  },
  "3": {
   "jp": "27ab0f1b",
   "kr": "로저"
  },
  "4": {
   "jp": "94c78bc6",
   "kr": "테스"
  },
  "5": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "6": {
   "jp": "3a47d6ef",
   "kr": "성실한 병사"
  },
  "7": {
   "jp": "42ba0cb2",
   "kr": "들뜬 병사"
  },
  "8": {
   "jp": "73e57527",
   "kr": "질버 선장"
  },
  "9": {
   "jp": "898074d7",
   "kr": "조리장"
  },
  "10": {
   "jp": "89447601",
   "kr": "이제 와 말하지만"
  },
  "11": {
   "jp": "bb8f814e",
   "kr": "선장님은 순례자가 올 때마다 일을 시켜서"
  },
  "12": {
   "jp": "b4feff9a",
   "kr": "세상의 혹독함을 가르치시는 거다."
  },
  "13": {
   "jp": "197d4140",
   "kr": "근데 사실은, 돈만 주는 게"
  },
  "14": {
   "jp": "2eeb67f1",
   "kr": "쑥스러워서겠지."
  },
  "15": {
   "jp": "1b3121d8",
   "kr": "그나저나 이번 항해는 사건의 연속이었지만"
  },
  "16": {
   "jp": "b5e76d46",
   "kr": "쥬리오와 크리스 덕분에"
  },
  "17": {
   "jp": "3755a6b9",
   "kr": "즐거웠다고."
  },
  "18": {
   "jp": "f240452c",
   "kr": "순례가 끝나면 밤새 한잔하고 싶군!"
  },
  "19": {
   "jp": "b021b4cf",
   "kr": "우리도 너희 덕에"
  },
  "20": {
   "jp": "e1df32bb",
   "kr": "시계와 코트를 되찾았지."
  },
  "21": {
   "jp": "7ee4f8f5",
   "kr": "정말 큰 도움이 됐단다."
  },
  "22": {
   "jp": "f30a966e",
   "kr": "그래도, 아직 헤스톤 씨가"
  },
  "23": {
   "jp": "0c417942",
   "kr": "범인이었다니, 믿기지 않아."
  },
  "24": {
   "jp": "b0c36f57",
   "kr": "좋은 공부가 됐잖아."
  },
  "25": {
   "jp": "19601e92",
   "kr": "무엇보다 쥬리오 군네와 알게 된 것이"
  },
  "26": {
   "jp": "9762f595",
   "kr": "이번 여행의 수확이야."
  },
  "27": {
   "jp": "802fe1e8",
   "kr": "그럼, 쥬리오 군 크리스 양."
  },
  "28": {
   "jp": "7ac34988",
   "kr": "우리는 이만 가마."
  },
  "29": {
   "jp": "54364084",
   "kr": "잘 사세요."
  },
  "30": {
   "jp": "9b5538f4",
   "kr": "잘 있어요."
  },
  "31": {
   "jp": "d678b6da",
   "kr": "고맙구나."
  },
  "32": {
   "jp": "ae01f52c",
   "kr": "둘의 여행이 잘되길 빈단다."
  },
  "33": {
   "jp": "c48c4f8d",
   "kr": "기분은 어떤가?"
  },
  "34": {
   "jp": "df1c1925",
   "kr": "무사히 입항할 수 있어 다행이었다."
  },
  "35": {
   "jp": "c4273b06",
   "kr": "제법 뜻깊은 여행이었지."
  },
  "36": {
   "jp": "4e9206d3",
   "kr": "허크 삼촌이"
  },
  "37": {
   "jp": "bb889126",
   "kr": "그렇게 미더울 줄은 생각도 못 했어."
  },
  "38": {
   "jp": "ba1b41ff",
   "kr": "뭐, 내 지식을 응용하면"
  },
  "39": {
   "jp": "69e6faad",
   "kr": "그쯤은 식은 죽 먹기다."
  },
  "40": {
   "jp": "55e34b64",
   "kr": "아저씨는, 앞으로 어쩔 거예요?"
  },
  "41": {
   "jp": "f9909949",
   "kr": "오오, 잘 물어 주었다."
  },
  "42": {
   "jp": "17c2acb8",
   "kr": "내 연구의 영원한 주제 하얀마녀는"
  },
  "43": {
   "jp": "a59d74a1",
   "kr": "이 메나트에도 수많은 예언을 남겼다!"
  },
  "44": {
   "jp": "afee7505",
   "kr": "그 말들에서 그녀가 무엇을 말하려 했고"
  },
  "45": {
   "jp": "3d3fe593",
   "kr": "무엇을 이끌려 했던 것인가…"
  },
  "46": {
   "jp": "e89fd1d0",
   "kr": "그게 아니에요."
  },
  "47": {
   "jp": "163cf216",
   "kr": "빌린 돈 얘기예요."
  },
  "48": {
   "jp": "8751dd1e",
   "kr": "아아, 그 일 말인가."
  },
  "49": {
   "jp": "b303e93c",
   "kr": "다행히 선장에게서 목돈을 받았으니"
  },
  "50": {
   "jp": "25f39822",
   "kr": "이걸로 당분간은 연구 자금은 걱정 없다."
  },
  "51": {
   "jp": "b0b9ae40",
   "kr": "삼촌!"
  },
  "52": {
   "jp": "e4f601b5",
   "kr": "제대로 갚아야 한다고!"
  },
  "53": {
   "jp": "56782a64",
   "kr": "옷!"
  },
  "54": {
   "jp": "63e78f25",
   "kr": "신비와 지식이 나를 부른다!"
  },
  "55": {
   "jp": "aaeb5ead",
   "kr": "또 만날 일도 있겠지."
  },
  "56": {
   "jp": "77e37a9e",
   "kr": "잘 있거라!"
  },
  "57": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "58": {
   "jp": "9aeb86b6",
   "kr": "… 가 버렸어."
  },
  "59": {
   "jp": "df2db2da",
   "kr": "자, 너희도 어서 가라."
  },
  "60": {
   "jp": "a568734e",
   "kr": "이별이 괴로워진다."
  },
  "61": {
   "jp": "435f623c",
   "kr": "메나트는 추운 곳이지만"
  },
  "62": {
   "jp": "6889dc54",
   "kr": "그만큼 마음이 따뜻한 사람들뿐이다."
  },
  "63": {
   "jp": "83efbd64",
   "kr": "무사히 순례를 마치면 좋겠구나."
  },
  "64": {
   "jp": "17d279ea",
   "kr": "네, 여러모로 고마웠어요."
  },
  "65": {
   "jp": "ee854257",
   "kr": "다음에 만날 땐"
  },
  "66": {
   "jp": "f65a30bc",
   "kr": "요리 더 잘하게 돼 있을게요."
  },
  "67": {
   "jp": "1631c920",
   "kr": "하핫! 기대하고 있으마."
  },
  "68": {
   "jp": "67924c12",
   "kr": "가자, 크리스."
  },
  "69": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "70": {
   "jp": "5a9018b8",
   "kr": "미안하군."
  },
  "71": {
   "jp": "13dde127",
   "kr": "여기 관리국 허가가 없으면"
  },
  "72": {
   "jp": "3afda73b",
   "kr": "아무도 배에 못 타."
  },
  "73": {
   "jp": "560baefe",
   "kr": "다들 만나고 싶은 건 알지만"
  },
  "74": {
   "jp": "f70af104",
   "kr": "규칙을 어기면 나중에 여러모로 곤란해."
  },
  "75": {
   "jp": "765010aa",
   "kr": "좀 참아 줘."
  },
  "76": {
   "jp": "512a4bd1",
   "kr": "잠깐, 너희들."
  },
  "77": {
   "jp": "8b92701c",
   "kr": "관리국 조사가 시작되면"
  },
  "78": {
   "jp": "dc6adc8b",
   "kr": "여기서부터는 못 들어간다."
  },
  "79": {
   "jp": "0275c3e9",
   "kr": "알아 둬라."
  },
  "80": {
   "jp": "9c012cf9",
   "kr": "이미 매발톱호의 입국 검사가 시작됐다."
  },
  "81": {
   "jp": "824a07fb",
   "kr": "여기서부터는 관계자 외 출입 금지다."
  },
  "82": {
   "jp": "8a6ff827",
   "kr": "관리국 검사가 끝나면"
  },
  "83": {
   "jp": "c12fe42d",
   "kr": "다음 항해를 기다릴 뿐이지."
  },
  "84": {
   "jp": "63facd8a",
   "kr": "이번엔 어떤 손님이 올지 기대되는걸."
  },
  "85": {
   "jp": "6835ad8d",
   "kr": "또 쥬리크리 같은 손님이"
  },
  "86": {
   "jp": "def0e56d",
   "kr": "오면 좋겠는데 말이야."
  },
  "87": {
   "jp": "07ce3c2d",
   "kr": "쥬리크리가 뭐예요?"
  },
  "88": {
   "jp": "fcf26274",
   "kr": "내가 붙인 너희 둘의 별명이야."
  },
  "89": {
   "jp": "cb6582df",
   "kr": "꽤 센스 있지 않냐?"
  },
  "90": {
   "jp": "ba713540",
   "kr": "그런가요?"
  },
  "91": {
   "jp": "1ca2b4a1",
   "kr": "갈 길이 아직 멀구나."
  },
  "92": {
   "jp": "d390f17e",
   "kr": "외로워지면"
  },
  "93": {
   "jp": "b728f2df",
   "kr": "이 보스레이를 떠올려 줘."
  },
  "94": {
   "jp": "4e44323e",
   "kr": "나라와 나라를 잇는 배에는"
  },
  "95": {
   "jp": "e4fcba6f",
   "kr": "선장의 뜻과 무관하게"
  },
  "96": {
   "jp": "19b1c8f9",
   "kr": "밀항자나 밀수품이 숨어 있을 위험이 있다."
  },
  "97": {
   "jp": "17f52496",
   "kr": "그래서 매발톱호는 검사가 필요한 거다."
  },
  "98": {
   "jp": "bce94d72",
   "kr": "알겠지?"
  },
  "99": {
   "jp": "c08620a2",
   "kr": "엄청 잘 알 것 같아요."
  },
  "100": {
   "jp": "8c6a067d",
   "kr": "정말이지, 늘 나만"
  },
  "101": {
   "jp": "ebecd4a3",
   "kr": "성실하게 일하고, 짝꿍은 빈둥거리기만 해."
  },
  "102": {
   "jp": "9a4b5e30",
   "kr": "속은 좋은 녀석인데 말이야."
  },
  "103": {
   "jp": "7eee68fb",
   "kr": "지금 매발톱호는 본관리국이 검사하고 있다."
  },
  "104": {
   "jp": "57e53f34",
   "kr": "밀항자, 밀수품이 없는지 말이야."
  },
  "105": {
   "jp": "db261de4",
   "kr": "그러니 이 앞으로는 못 보낸다."
  },
  "106": {
   "jp": "46250f66",
   "kr": "뭐, 매발톱호 선장은 믿을 만하니"
  },
  "107": {
   "jp": "51e8e81a",
   "kr": "그런 걱정은 없겠지만."
  },
  "108": {
   "jp": "b735cea5",
   "kr": "여기 주점의 부야베스는 최고라고."
  },
  "109": {
   "jp": "614f80ef",
   "kr": "얼어붙은 몸을 속부터 데워 준단 말이야."
  },
  "110": {
   "jp": "969afd9f",
   "kr": "접수 아가씨 마샤는 귀엽지."
  },
  "111": {
   "jp": "2b10efb4",
   "kr": "색시로 삼을 거라면"
  },
  "112": {
   "jp": "50dda33f",
   "kr": "저런 사람이 좋지."
  },
  "113": {
   "jp": "cbb21329",
   "kr": "나는 어릴 때 뱃사람이 되고 싶었어."
  },
  "114": {
   "jp": "c175d2ae",
   "kr": "그런데 수영을 못 해서."
  },
  "115": {
   "jp": "e5f98fe2",
   "kr": "뭐, 위병도 나쁘진 않아."
  },
  "116": {
   "jp": "ca44b8f5",
   "kr": "순례 여행이라…"
  },
  "117": {
   "jp": "3e059383",
   "kr": "나쁜 해에 왔구나."
  },
  "118": {
   "jp": "f5a5db9c",
   "kr": "올해는 메나트 전체가 흉작이라"
  },
  "119": {
   "jp": "ef908b18",
   "kr": "식량이 그리 넉넉하지 않아."
  },
  "120": {
   "jp": "feb54361",
   "kr": "마을 동쪽에 사는 카이는"
  },
  "121": {
   "jp": "daea768b",
   "kr": "덜렁이로 유명해."
  },
  "122": {
   "jp": "211f2ac2",
   "kr": "뭐, 나보단 낫지만."
  },
  "123": {
   "jp": "0a0e6071",
   "kr": "내가 할 말은 아니지만"
  },
  "124": {
   "jp": "7ab3de94",
   "kr": "이 마을 사람들은 다들 친절해."
  },
  "125": {
   "jp": "224a4801",
   "kr": "곤란한 사람이 있으면"
  },
  "126": {
   "jp": "7c0079a2",
   "kr": "성가실 만큼 모여서 도우려 하거든."
  },
  "127": {
   "jp": "5296cb48",
   "kr": "매발톱호가 온 덕분에"
  },
  "128": {
   "jp": "274f3283",
   "kr": "식량이 조금은 돌겠지."
  },
  "129": {
   "jp": "35d48e15",
   "kr": "폴티아의 말린 고기는 최고지."
  },
  "130": {
   "jp": "65da710a",
   "kr": "우리 아빠는 사냥꾼이에요."
  },
  "131": {
   "jp": "2eaa0d32",
   "kr": "호오〜"
  },
  "132": {
   "jp": "3eb8fd2f",
   "kr": "그럼, 네 아버지가 잡은"
  },
  "133": {
   "jp": "ec375c8c",
   "kr": "고기도 있을지 모르겠군."
  },
  "134": {
   "jp": "85381899",
   "kr": "날씨 좋구나."
  },
  "135": {
   "jp": "de31518e",
   "kr": "이런 날은 파도 길에서"
  },
  "136": {
   "jp": "7630ff71",
   "kr": "하이킹이라도 하고 싶어."
  },
  "137": {
   "jp": "7083e831",
   "kr": "오오, 쥬리오 군과 크리스 군인가."
  },
  "138": {
   "jp": "47b1da14",
   "kr": "닐리는 어때?"
  },
  "139": {
   "jp": "62fb6c3b",
   "kr": "제법 괜찮은 마을이지."
  },
  "140": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "141": {
   "jp": "d588341e",
   "kr": "좀 춥긴 하지만요."
  },
  "142": {
   "jp": "6b13f9bd",
   "kr": "무슨 일 있으세요?"
  },
  "143": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "144": {
   "jp": "bb3c4051",
   "kr": "이렇게 정박한 배를 등지고"
  },
  "145": {
   "jp": "9e4c7faf",
   "kr": "수면을 바라보면 마음이 놓여."
  },
  "146": {
   "jp": "a9d66661",
   "kr": "이렇게 한 항해를 마치고"
  },
  "147": {
   "jp": "98984c6f",
   "kr": "아무 생각 없이 쉴 때가 최고의 시간이다."
  },
  "148": {
   "jp": "c6be25a6",
   "kr": "올해도 라그나로 돌아가면"
  },
  "149": {
   "jp": "5bf97d0b",
   "kr": "유빙이 사라질 때까지 휴업이다."
  },
  "150": {
   "jp": "5b46734f",
   "kr": "조금 쓸쓸하기도 하지만."
  },
  "151": {
   "jp": "2a115a74",
   "kr": "선장과 단둘이 이야기하는 것도"
  },
  "152": {
   "jp": "47bd78dd",
   "kr": "참으로 오랜만이구먼."
  },
  "153": {
   "jp": "50974f8a",
   "kr": "그렇지, 좋은 걸 주마."
  },
  "154": {
   "jp": "0fb1874b",
   "kr": "매발톱호 선원이 지닌 "
  },
  "155": {
   "jp": "c8ef3ff5",
   "kr": "을(를) 말이다."
  },
  "156": {
   "jp": "d8f916f6",
   "kr": "조리장에게서 "
  },
  "157": {
   "jp": "0032fe0e",
   "kr": "을(를) 받았습니다."
  },
  "158": {
   "jp": "2423b918",
   "kr": "소중히 쓰게나."
  },
  "159": {
   "jp": "f3f3ed75",
   "kr": "나도 오랫동안 배를 탔다만"
  },
  "160": {
