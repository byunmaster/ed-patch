 "archive": "/SCE8/SC810.DAT",
 "member": "..\\DATA\\RC7100.BIN",
 "lines": {
  "0": {
   "jp": "4651181e",
   "kr": "이자벨의 탑"
  },
  "1": {
   "jp": "a2090e26",
   "kr": "옥상"
  },
  "2": {
   "jp": "d2a622f3",
   "kr": "이자벨 왕비"
  },
  "3": {
   "jp": "103e4bc2",
   "kr": "앗…하늘이…"
  },
  "4": {
   "jp": "664617cb",
   "kr": "이, 이게…"
  },
  "5": {
   "jp": "bd60b96d",
   "kr": "라우알의 파도…"
  },
  "6": {
   "jp": "45c469a2",
   "kr": "이자벨 왕비!"
  },
  "7": {
   "jp": "d40f9b04",
   "kr": "보시지요."
  },
  "8": {
   "jp": "dd9f7e89",
   "kr": "자, 이미 저기까지 와 있습니다."
  },
  "9": {
   "jp": "05fcf2cc",
   "kr": "이제 아무도 막을 수 없습니다."
  },
  "10": {
   "jp": "9671e97d",
   "kr": "우리 세계를 대신해,"
  },
  "11": {
   "jp": "3d0a3d1c",
   "kr": "이 세계가 종말의 때를 맞는 것입니다."
  },
  "12": {
   "jp": "4c1b6817",
   "kr": "어째서 이런 계획을 실행했느냐."
  },
  "13": {
   "jp": "8b4158d1",
   "kr": "죄 없는 세계를 희생시키면서까지,"
  },
  "14": {
   "jp": "dd5f0508",
   "kr": "자신들의 세계를 지키고 싶으냐!"
  },
  "15": {
   "jp": "e07d9e3b",
   "kr": "죄 없는 세계…"
  },
  "16": {
   "jp": "8bf4a8fe",
   "kr": "그건…"
  },
  "17": {
   "jp": "7f9ca915",
   "kr": "당신들이 모르는 것뿐일지도"
  },
  "18": {
   "jp": "3220ba45",
   "kr": "모르지요."
  },
  "19": {
   "jp": "4c7019db",
   "kr": "에…?"
  },
  "20": {
   "jp": "ad757bb4",
   "kr": "죄가 뭔데?"
  },
  "21": {
   "jp": "7e847797",
   "kr": "자기들 세계에서 만들어 버린"
  },
  "22": {
   "jp": "53f648cb",
   "kr": "라우알의 파도를 끌고 와서,"
  },
  "23": {
   "jp": "36bc6bfa",
   "kr": "꽤나 제멋대로잖아."
  },
  "24": {
   "jp": "473dbb01",
   "kr": "당신들에게도,"
  },
  "25": {
   "jp": "b99f6576",
   "kr": "아니, 이 세계에도 죄는 있습니다."
  },
  "26": {
   "jp": "8e158206",
   "kr": "결코 지울 수 없는, 깊은 죄가…"
  },
  "27": {
   "jp": "479c46e0",
   "kr": "그럼, 들려주세요."
  },
  "28": {
   "jp": "bfd99584",
   "kr": "우리의 죄를."
  },
  "29": {
   "jp": "825d83bd",
   "kr": "그것이 이 세계를 멸망시킬 만한 것이라면,"
  },
  "30": {
   "jp": "4a2ea379",
   "kr": "우리도 납득하고"
  },
  "31": {
   "jp": "d0543c5b",
   "kr": "그 운명을 받아들일 수도 있겠지요."
  },
  "32": {
   "jp": "810e70a0",
   "kr": "이제 와서,"
  },
  "33": {
   "jp": "888de109",
   "kr": "당신들에게 원망을 늘어놔 봐야"
  },
  "34": {
   "jp": "8f968c72",
   "kr": "소용없겠지요."
  },
  "35": {
   "jp": "8fa40df1",
   "kr": "그 대신,"
  },
  "36": {
   "jp": "4f8e54e5",
   "kr": "이 멸망이 불본의하지 않도록,"
  },
  "37": {
   "jp": "e471e934",
   "kr": "당신들에게 희망을 드리겠습니다."
  },
  "38": {
   "jp": "979dbfc2",
   "kr": "지금, 라우알의 파도는"
  },
  "39": {
   "jp": "4a995968",
   "kr": "저의 술법으로 끌려오고 있습니다."
  },
  "40": {
   "jp": "a0fa76bd",
   "kr": "이대로라면"
  },
  "41": {
   "jp": "faaafc16",
   "kr": "확실히 이 세계에 출현할 것입니다."
  },
  "42": {
   "jp": "e0caf721",
   "kr": "하지만, 당신들이 저를 쓰러뜨린다면,"
  },
  "43": {
   "jp": "4d99cda9",
   "kr": "술법은 그 순간 풀리고"
  },
  "44": {
   "jp": "568d2874",
   "kr": "끌어당기는 힘도 사라집니다."
  },
  "45": {
   "jp": "a7c2961c",
   "kr": "정정당당하게 승부하겠다는 거냐."
  },
  "46": {
   "jp": "f227374c",
   "kr": "우리가 이기면,"
  },
  "47": {
   "jp": "b71c44c3",
   "kr": "라우알의 파도는 여기엔 오지 않는 거야?"
  },
  "48": {
   "jp": "eba35ac7",
   "kr": "끌어당기는 힘은 작용하지 않게 되겠지요."
  },
  "49": {
   "jp": "7c9ffa74",
   "kr": "하지만, 그렇다고 해서,"
  },
  "50": {
   "jp": "f540e908",
   "kr": "재앙에서 벗어날 수 있을지는"
  },
  "51": {
   "jp": "c712cf27",
   "kr": "저도 잘 모릅니다."
  },
  "52": {
   "jp": "aea53bed",
   "kr": "라우알의 파도가 멈출 가능성이 있다는"
  },
  "53": {
   "jp": "f3bdacc2",
   "kr": "것뿐입니다."
  },
  "54": {
   "jp": "f21738a8",
   "kr": "그 가능성에 걸어 보시겠습니까?"
  },
  "55": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "56": {
   "jp": "3adae119",
   "kr": "………"
  },
  "57": {
   "jp": "ccdb79a1",
   "kr": "스텔라&듀르젤"
  },
  "58": {
   "jp": "3adae119",
   "kr": "………"
  },
  "59": {
   "jp": "0759d494",
   "kr": "나는…그 가능성에 걸어 볼게."
  },
  "60": {
   "jp": "b791c16b",
   "kr": "나도."
  },
  "61": {
   "jp": "de31f0b8",
   "kr": "해 보자."
  },
  "62": {
   "jp": "7c2186b2",
   "kr": "가능성에 거는 건 늘 하던 일이다."
  },
  "63": {
   "jp": "0767d750",
   "kr": "저에게도,"
  },
  "64": {
   "jp": "d4f1bd86",
   "kr": "자란 세계의 운명이 걸려 있습니다."
  },
  "65": {
   "jp": "c9fc120f",
   "kr": "지금까지 같은 싸움으론 끝나지 않습니다."
  },
  "66": {
   "jp": "f25eaf3a",
   "kr": "아직 싸우시겠습니까?"
  },
  "67": {
   "jp": "3adae119",
   "kr": "………"
  },
  "68": {
   "jp": "eaa781f3",
   "kr": "좋습니다."
  },
  "69": {
   "jp": "1b5acb6c",
   "kr": "그래도, 이것만은 명심하십시오."
  },
  "70": {
   "jp": "245bbb5c",
   "kr": "시간이 걸리면 걸릴수록,"
  },
  "71": {
   "jp": "6fc15e19",
   "kr": "라우알의 파도를 막을 가능성이"
  },
  "72": {
   "jp": "2de612a6",
   "kr": "줄어드는 것입니다."
  },
  "73": {
   "jp": "085feb3e",
   "kr": "싸움이 길어지면 길어질수록,"
  },
  "74": {
   "jp": "c595823d",
   "kr": "이 세계에게는 불리해지는 것입니다."
  },
  "75": {
   "jp": "a9819e91",
   "kr": "자, 갑니다!"
  }
 }
}