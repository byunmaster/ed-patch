{
 "archive": "/SCE8/SC800.DAT",
 "member": "..\\DATA\\RC1000.BIN",
 "lines": {
  "0": {
   "jp": "f80fe789",
   "kr": "루드"
  },
  "1": {
   "jp": "f3b21c53",
   "kr": "성 아랫마을"
  },
  "2": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "3": {
   "jp": "e4f66033",
   "kr": "도리나"
  },
  "4": {
   "jp": "913c0343",
   "kr": "챠펠의 페리오"
  },
  "5": {
   "jp": "30e44efa",
   "kr": "라르 노인"
  },
  "6": {
   "jp": "ec236453",
   "kr": "모스코스"
  },
  "7": {
   "jp": "f5ba2352",
   "kr": "도구상 레리아"
  },
  "8": {
   "jp": "9513125f",
   "kr": "보란"
  },
  "9": {
   "jp": "a672481f",
   "kr": "술집 시가로"
  },
  "10": {
   "jp": "0be8b0d4",
   "kr": "후마르"
  },
  "11": {
   "jp": "32499e3b",
   "kr": "브리트 대장"
  },
  "12": {
   "jp": "4ed44e10",
   "kr": "성 안은 지금, 분주하다."
  },
  "13": {
   "jp": "9bfed7c4",
   "kr": "출입 금지다."
  },
  "14": {
   "jp": "2b94b551",
   "kr": "너무 어슬렁거리지 마라."
  },
  "15": {
   "jp": "95a12a9a",
   "kr": "여긴 못 지나간다."
  },
  "16": {
   "jp": "154e0374",
   "kr": "몇 번 와도 소용없다."
  },
  "17": {
   "jp": "2a2f4b1a",
   "kr": "브리트 대장이라 다행이다."
  },
  "18": {
   "jp": "bfa4e714",
   "kr": "보통이면 감옥행이다."
  },
  "19": {
   "jp": "c0f43f81",
   "kr": "이제, 수상한 짓 하지 마라."
  },
  "20": {
   "jp": "a2fcf428",
   "kr": "거슬리는 놈들이군."
  },
  "21": {
   "jp": "c5a36116",
   "kr": "붙잡아서, 감옥에 처넣어 버리겠다!"
  },
  "22": {
   "jp": "4e8aba06",
   "kr": "무슨 일이냐!"
  },
  "23": {
   "jp": "096f3db7",
   "kr": "웬 소란이냐."
  },
  "24": {
   "jp": "bf5a8bc8",
   "kr": "이 사람들이 수상한 행동을 하기에…"
  },
  "25": {
   "jp": "ff0221ba",
   "kr": "여기는 폴티아의 왕도다!"
  },
  "26": {
   "jp": "bb12e7a2",
   "kr": "성문 앞에서 소란을 일으키다니"
  },
  "27": {
   "jp": "b53cff72",
   "kr": "수상한 놈들이군."
  },
  "28": {
   "jp": "45b46330",
   "kr": "안에서 조사하겠다. 따라와라!"
  },
  "29": {
   "jp": "7e81b9fc",
   "kr": "우리 아들도 병사가 된다며"
  },
  "30": {
   "jp": "5594c6da",
   "kr": "성에 들어갔는데,"
  },
  "31": {
   "jp": "7158ddd7",
   "kr": "그 뒤로, 감감무소식이에요."
  },
  "32": {
   "jp": "c65718c3",
   "kr": "연락이라도 하면 좋으련만."
  },
  "33": {
   "jp": "c1dc5a04",
   "kr": "걱정이에요."
  },
  "34": {
   "jp": "b80eda1a",
   "kr": "칸드 마법이 마을에서"
  },
  "35": {
   "jp": "89a852bd",
   "kr": "추방되고 말았습니다."
  },
  "36": {
   "jp": "986d600c",
   "kr": "본디 하나였던 것인데"
  },
  "37": {
   "jp": "c750306f",
   "kr": "이상한 얘기지요."
  },
  "38": {
   "jp": "5735c724",
   "kr": "이곳에서는 챠펠 마법을"
  },
  "39": {
   "jp": "859e5c32",
   "kr": "전수해 드리고 있습니다."
  },
  "40": {
   "jp": "3bd6e7ff",
   "kr": "챠펠 마법을 다루실 수 있는 분이 계시면"
  },
  "41": {
   "jp": "edac0270",
   "kr": "전수해 드리겠습니다."
  },
  "42": {
   "jp": "dd2cda4f",
   "kr": "어느 분이 원하십니까?"
  },
  "43": {
   "jp": "b0d4a0ec",
   "kr": "어느 마법을 전수할까요?"
  },
  "44": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "45": {
   "jp": "a9d3af4a",
   "kr": "챠펠의 힘이 필요할 때는"
  },
  "46": {
   "jp": "7dfc109e",
   "kr": "언제든 들러 주십시오."
  },
  "47": {
   "jp": "2b91f054",
   "kr": "이게 얼마 만입니까 듀르젤 공."
  },
  "48": {
   "jp": "39d020e0",
   "kr": "드디어 몸을 일으키셨군요."
  },
  "49": {
   "jp": "c99c3070",
   "kr": "언제 돌페스에서 나오시려나 하고,"
  },
  "50": {
   "jp": "1b068457",
   "kr": "애타게 기다리고 있었습니다."
  },
  "51": {
   "jp": "fb545f01",
   "kr": "듀르젤 공이 돌아오셨으니 안심입니다."
  },
  "52": {
   "jp": "bbbbed00",
   "kr": "요즘의, 성의 수상한 움직임"
  },
  "53": {
   "jp": "101f5f75",
   "kr": "똑똑히 확인하시어"
  },
  "54": {
   "jp": "bb2b348a",
   "kr": "관리들에게 따끔하게 말해 주시오."
  },
  "55": {
   "jp": "052257eb",
   "kr": "어찌 된 영문인지"
  },
  "56": {
   "jp": "cd4e5010",
   "kr": "예전만큼 마을과 성의 교류가 없어져서요."
  },
  "57": {
   "jp": "b7792b3a",
   "kr": "병사는 이 마을 출신도 많은데,"
  },
  "58": {
   "jp": "d4b44a22",
   "kr": "왠지 요즘,"
  },
  "59": {
   "jp": "15ddd9a2",
   "kr": "묘하게 서먹한 분위기입니다."
  },
  "60": {
   "jp": "060325d6",
   "kr": "아, 2층으로 올라가시죠."
  },
  "61": {
   "jp": "4c1ddc11",
   "kr": "여관 산페한테서 이야기는 들었습니다."
  },
  "62": {
   "jp": "aaf8c865",
   "kr": "브리트 씨는"
  },
  "63": {
   "jp": "f5006c7d",
   "kr": "아직, 오시지 않았습니다만"
  },
  "64": {
   "jp": "b39ed842",
   "kr": "이제 곧 오실 때입니다."
  },
  "65": {
   "jp": "86bb1daa",
   "kr": "이 마을 사람은 모두 듀르젤 공의 편입니다."
  },
  "66": {
   "jp": "49fa19b7",
   "kr": "부디 성의 내정을 확인하여"
  },
  "67": {
   "jp": "8a1a97c5",
   "kr": "우리의 불안을 없애 주십시오."
  },
  "68": {
   "jp": "e1ef2f1b",
   "kr": "잘 부탁드립니다."
  },
  "69": {
   "jp": "c7646dc2",
   "kr": "저희도, 남동생이 병사가 됐어요."
  },
  "70": {
   "jp": "0524a883",
   "kr": "성에서 일하는데도 계속 돌아오지 않아요."
  },
  "71": {
   "jp": "663efac8",
   "kr": "조금쯤은"
  },
  "72": {
   "jp": "706a2724",
   "kr": "얼굴을 보여 주면 좋으련만."
  },
  "73": {
   "jp": "4f045262",
   "kr": "어서 오세요."
  },
  "74": {
   "jp": "5e5c4295",
   "kr": "필요한 건 뭐든 말씀하세요!"
  },
  "75": {
   "jp": "ffaf881e",
   "kr": "네! 무엇을 찾으세요?"
  },
  "76": {
   "jp": "941f0265",
   "kr": "인가요."
  },
  "77": {
   "jp": "35358975",
   "kr": "그렇다면"
  },
  "78": {
   "jp": "0b9cf8d2",
   "kr": "에 팔겠습니다."
  },
  "79": {
   "jp": "0fea90dd",
   "kr": "무엇을 사들일까요?"
  },
  "80": {
   "jp": "941f0265",
   "kr": "인가요."
  },
  "81": {
   "jp": "abb8567e",
   "kr": "그렇다면,"
  },
  "82": {
   "jp": "c2c6920a",
   "kr": "에 사들이겠습니다."
  },
  "83": {
   "jp": "59136b4c",
   "kr": "환전율은 1 Goa당 16 Pia입니다."
  },
  "84": {
   "jp": "3bc292cd",
   "kr": "16 Pia라면 손해는 없을 거예요."
  },
  "85": {
   "jp": "74b4488e",
   "kr": "괜찮습니까?"
  },
  "86": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "87": {
   "jp": "0f41ed9b",
   "kr": "을 치르겠습니다."
  },
  "88": {
   "jp": "c94416e4",
   "kr": "라피카가 없지 않니."
  },
  "89": {
   "jp": "e0e5cf11",
   "kr": "모이면 또 오세요."
  },
  "90": {
   "jp": "eaaf89ae",
   "kr": "다른 볼일은 없으세요?"
  },
  "91": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "92": {
   "jp": "e017cd10",
   "kr": "언제든지 부담 없이 들러 주세요!"
  },
  "93": {
   "jp": "a63fe68d",
   "kr": "어쩐지, 으스스하네요."
  },
  "94": {
   "jp": "db3210f6",
   "kr": "뭐가 그러냐고 물으면 곤란하지만"
  },
  "95": {
   "jp": "957b5f2e",
   "kr": "젊은이가 없어져서 묘하게 조용해서요…"
  },
  "96": {
   "jp": "80eae592",
   "kr": "어라, 이거 듀르젤 씨."
  },
  "97": {
   "jp": "915ad3bd",
   "kr": "당당히 이 마을을 걷다니,"
  },
  "98": {
   "jp": "d691dd0b",
   "kr": "역시 대단하군."
  },
  "99": {
   "jp": "449e47d1",
   "kr": "어쨌든, 자네가 무사해서 다행이야."
  },
  "100": {
   "jp": "c3ff2f60",
   "kr": "요즘 웬일인지 성의 명령으로"
  },
  "101": {
   "jp": "667b2784",
   "kr": "마법 단속이 심해져서요."
  },
  "102": {
   "jp": "7b95d931",
   "kr": "챠펠은 그렇다 쳐도"
  },
  "103": {
   "jp": "d9815ee5",
   "kr": "칸드는 쫓겨나 버렸답니다."
  },
  "104": {
   "jp": "bab1f721",
   "kr": "그래도 뭐, 그건 겉치레고."
  },
  "105": {
   "jp": "affdf5f7",
   "kr": "우리 집 2층에 숨겨 두고 있으니,"
  },
  "106": {
   "jp": "dac1e861",
   "kr": "필요하면 올라가 보시구려."
  },
  "107": {
   "jp": "6b765528",
   "kr": "2층에 칸드가 있다는 건"
  },
  "108": {
   "jp": "be1feb65",
   "kr": "부디"
  },
  "109": {
   "jp": "e042b084",
   "kr": "비밀로 부탁합니다."
  },
  "110": {
   "jp": "0ec6ead7",
   "kr": "듀르젤 씨 일도,"
  },
  "111": {
   "jp": "7c997484",
   "kr": "비밀로 해 둘 테니 말이오."
  },
  "112": {
   "jp": "b8d294b7",
   "kr": "뭐, 느긋하게 쉬다 가시구려."
  },
  "113": {
   "jp": "839ef884",
   "kr": "알고 있나?"
  },
  "114": {
   "jp": "43e2a8d8",
   "kr": "성의 명령으로"
  },
  "115": {
   "jp": "e6da093a",
   "kr": "칸드가 이 마을에서 쫓겨나"
  },
  "116": {
   "jp": "efce13cd",
   "kr": "버렸다는군."
  },
  "117": {
   "jp": "75477db4",
   "kr": "챠펠은 평온을 주니까 괜찮지만"
  },
  "118": {
   "jp": "77516461",
   "kr": "칸드는 위험하니까 안 된다는 거야."
  },
  "119": {
   "jp": "583cc65c",
   "kr": "어쩐지 불공평한 얘기지."
  },
  "120": {
   "jp": "8bebad09",
   "kr": "난 칸드 마법보다"
  },
  "121": {
   "jp": "fbc93ec8",
   "kr": "군대 쪽이 훨씬 더 험악하다고 생각하는데."
  },
  "122": {
   "jp": "1017d4a2",
   "kr": "정말이지,"
  },
  "123": {
   "jp": "544088d4",
   "kr": "루돌프 왕은 무슨 생각을 하고 계신 걸까."
  }
 }
}