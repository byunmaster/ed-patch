  },
  "8": {
   "jp": "57e0e525",
   "kr": "칸드의 오스텐"
  },
  "9": {
   "jp": "9315016e",
   "kr": "샨스"
  },
  "10": {
   "jp": "5af539bb",
   "kr": "오누르"
  },
  "11": {
   "jp": "0b8bd595",
   "kr": "챠펠의 그레이스"
  },
  "12": {
   "jp": "e9941e78",
   "kr": "레미오"
  },
  "13": {
   "jp": "821e5339",
   "kr": "크라탕"
  },
  "14": {
   "jp": "733cd340",
   "kr": "여관 포라레"
  },
  "15": {
   "jp": "6c5d9e8d",
   "kr": "그레마"
  },
  "16": {
   "jp": "bd16cd62",
   "kr": "딜러 키디"
  },
  "17": {
   "jp": "6fb93845",
   "kr": "환전 마니"
  },
  "18": {
   "jp": "141d5f77",
   "kr": "보이"
  },
  "19": {
   "jp": "746a2177",
   "kr": "그라크"
  },
  "20": {
   "jp": "e15756d2",
   "kr": "부르메"
  },
  "21": {
   "jp": "6b6c9d25",
   "kr": "잠깐, 나그네."
  },
  "22": {
   "jp": "f88253bf",
   "kr": "쥬리오, 혹시 루레 영감님"
  },
  "23": {
   "jp": "d34b0e9d",
   "kr": "아직 카지노 2층에서 룰렛을"
  },
  "24": {
   "jp": "bd8a2758",
   "kr": "하고 있는 거 아닐까?"
  },
  "25": {
   "jp": "345c5560",
   "kr": "레드 씨한테도 부탁받았고"
  },
  "26": {
   "jp": "77b8d088",
   "kr": "좀 보러 가 볼까?"
  },
  "27": {
   "jp": "3e0826cb",
   "kr": "이 앞에는 다 허물어진 마을과"
  },
  "28": {
   "jp": "ffa7f64c",
   "kr": "하얀마녀를 만난 적이 있다는"
  },
  "29": {
   "jp": "ffb42c35",
   "kr": "별난 할멈네 집밖에 없어."
  },
  "30": {
   "jp": "7192d355",
   "kr": "별난 할머니?"
  },
  "31": {
   "jp": "c1decb08",
   "kr": "그래. 듣기론 20년 전에"
  },
  "32": {
   "jp": "38f1eefa",
   "kr": "마녀를 만났다나, 안 만났다나."
  },
  "33": {
   "jp": "f09cc80c",
   "kr": "뭐, 믿을 건 못 되지만."
  },
  "34": {
   "jp": "19b644f1",
   "kr": "게다가 빈민가는 나그네가"
  },
  "35": {
   "jp": "8879b111",
   "kr": "들를 만한 곳은 없어."
  },
  "36": {
   "jp": "2f9dd91c",
   "kr": "빈민가엔 원래 다츠라는"
  },
  "37": {
   "jp": "5880528d",
   "kr": "이름이 있지만 아무도 그렇게 안 불러."
  },
  "38": {
   "jp": "b7b234c1",
   "kr": "빈민가면 충분하니까."
  },
  "39": {
   "jp": "2171b865",
   "kr": "빈민가 사람들도 조금만 더"
  },
  "40": {
   "jp": "28b51860",
   "kr": "의욕을 내 주면 좋겠는데 말이야."
  },
  "41": {
   "jp": "9b340151",
   "kr": "안됐네요. 코인이 없어요."
  },
  "42": {
   "jp": "ca110dd7",
   "kr": "또 와 주세요."
  },
  "43": {
   "jp": "eb061341",
   "kr": "손님. 코인을 일단"
  },
  "44": {
   "jp": "553920da",
   "kr": "팔고 오시는 게 어떨까요?"
  },
  "45": {
   "jp": "ec147d26",
   "kr": "손님, 저랑 승부하실래요?"
  },
  "46": {
   "jp": "a310c83c",
   "kr": "그래야죠."
  },
  "47": {
   "jp": "7c81cc0a",
   "kr": "그래요?"
  },
  "48": {
   "jp": "52638842",
   "kr": "마음 내키면 오세요."
  },
  "49": {
   "jp": "867a25b3",
   "kr": "카드의 허실을 보여 드릴게요."
  },
  "50": {
   "jp": "442d4d29",
   "kr": "이런!"
  },
  "51": {
   "jp": "969b9941",
   "kr": "아직 렌즈콩을 안 들었네."
  },
  "52": {
   "jp": "6aea4fce",
   "kr": "어떤가?"
  },
  "53": {
   "jp": "573a3a8c",
   "kr": "도박은 해 봤어?"
  },
  "54": {
   "jp": "d1b13bea",
   "kr": "중독될 것 같지?"
  },
  "55": {
   "jp": "de532774",
   "kr": "다이스 시민으로선 손님이 느는 건"
  },
  "56": {
   "jp": "4ce896d9",
   "kr": "고마운 일이지만."
  },
  "57": {
   "jp": "0d783937",
   "kr": "너무 중독되지 않는 편이 좋아."
  },
  "58": {
   "jp": "cdf5a9a8",
   "kr": "카지노는 정말 즐거워."
  },
  "59": {
   "jp": "2dd2f771",
   "kr": "하지만 초보자는 너무 빠져들지"
  },
  "60": {
   "jp": "77eb0145",
   "kr": "않는 게 좋아."
  },
  "61": {
   "jp": "42a26e81",
   "kr": "뭐니 뭐니 해도"
  },
  "62": {
   "jp": "5c8623d1",
   "kr": "생활에 여유가 있어야 할 수 있는"
  },
  "63": {
   "jp": "49a2f9a2",
   "kr": "귀족의 오락이니까."
  },
  "64": {
   "jp": "5a2d12ba",
   "kr": "여기 지배인은 진짜 도박꾼과"
  },
  "65": {
   "jp": "ca79050e",
   "kr": "승부하는 걸 좋아해."
  },
  "66": {
   "jp": "fe2d1641",
   "kr": "도저히 나 같은 사람은 마련 못 할"
  },
  "67": {
   "jp": "e073b25e",
   "kr": "금액을 걸 수 있어."
  },
  "68": {
   "jp": "ca401b6c",
   "kr": "한 번만이라도"
  },
  "69": {
   "jp": "861831df",
   "kr": "큰 승부를 해 보고 싶네요."
  },
  "70": {
   "jp": "4db9f5a8",
   "kr": "룰렛을 좋아하는 놈은 문외한이야."
  },
  "71": {
   "jp": "fdfea515",
   "kr": "너희도 그렇게 생각하지?"
  },
  "72": {
   "jp": "2cb7ffe2",
   "kr": "카드야말로 도박의 왕이다."
  },
  "73": {
   "jp": "2b36dddf",
   "kr": "룰렛이 빙글빙글 도는 걸 보고 있으면"
  },
  "74": {
   "jp": "29f9ca2e",
   "kr": "이쪽까지 눈이 돌아 버린다고."
  },
  "75": {
   "jp": "a3ec5764",
   "kr": "그럼, 한밑천 더 벌어 볼까."
  },
  "76": {
   "jp": "423ccd6d",
   "kr": "나는 카드보다 룰렛 쪽이"
  },
  "77": {
   "jp": "c4cc5b63",
   "kr": "성미에 맞는 것 같아."
  },
  "78": {
   "jp": "fcf68948",
   "kr": "카드는 상대와 수 싸움이 있어서"
  },
  "79": {
   "jp": "89923c53",
   "kr": "성가셔서 못 해 먹겠어."
  },
  "80": {
   "jp": "f797d4cc",
   "kr": "룰렛은 100% 그때그때의"
  },
  "81": {
   "jp": "e81323a9",
   "kr": "운에 달렸으니까."
  },
  "82": {
   "jp": "c3afeb63",
   "kr": "깨끗이 단념할 수 있어 좋아."
  },
  "83": {
   "jp": "64150134",
   "kr": "상쾌하네."
  },
  "84": {
   "jp": "62e6eb6a",
   "kr": "오호호호호…"
  },
  "85": {
   "jp": "d521b759",
   "kr": "상쾌, 상쾌"
  },
  "86": {
   "jp": "baf69de2",
   "kr": "웃음이 멈추질 않아."
  },
  "87": {
   "jp": "62e6eb6a",
   "kr": "오호호호호…"
  },
  "88": {
   "jp": "c4790852",
   "kr": "아〜… 너무 웃어서"
  },
  "89": {
   "jp": "06c33f28",
   "kr": "볼이 아파."
  },
  "90": {
   "jp": "5b66888e",
   "kr": "테이블이 비었어."
  },
  "91": {
   "jp": "db41706d",
   "kr": "괜찮으면 거기서 카드라도"
  },
  "92": {
   "jp": "d9f5c3ac",
   "kr": "하고 가라고."
  },
  "93": {
   "jp": "5d21989f",
   "kr": "모처럼 다이스에 왔잖아."
  },
  "94": {
   "jp": "128a6f8a",
   "kr": "여기까지 와서 아무것도 안 하고"
  },
  "95": {
   "jp": "9c7dabff",
   "kr": "돌아가는 법이 어딨어."
  },
  "96": {
   "jp": "c3e0ae1a",
   "kr": "승부는 운에 달린 거야."
  },
  "97": {
   "jp": "695684f0",
   "kr": "져도"
  },
  "98": {
   "jp": "176fe35a",
   "kr": "원망하기 없기야."
  },
  "99": {
   "jp": "597210ac",
   "kr": "금화의 광채에 마음을 빼앗긴 채"
  },
  "100": {
   "jp": "9b557ee2",
   "kr": "마법을 써서는 안 됩니다."
  },
  "101": {
   "jp": "5b38044d",
   "kr": "칸드에 어서 오세요."
  },
  "102": {
   "jp": "98347b01",
   "kr": "어느 분이 마법 습득을 원하십니까?"
  },
  "103": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "104": {
   "jp": "dd014f81",
   "kr": "군요."
  },
  "105": {
   "jp": "7fc3d4a6",
   "kr": "도움이 되기를 바랍니다."
  },
  "106": {
   "jp": "cca19cda",
   "kr": "칸드의 힘이 필요하면"
  },
  "107": {
   "jp": "77b60f36",
   "kr": "언제든지 찾아 주십시오."
  },
  "108": {
   "jp": "a0d2ee5a",
   "kr": "이 마을 카지노는 여자든 아이든"
  },
  "109": {
   "jp": "7e153063",
   "kr": "돈만 갖고 있으면"
  },
  "110": {
   "jp": "3f0615a7",
   "kr": "누구든 걸 수 있어."
  },
  "111": {
   "jp": "bd771995",
   "kr": "누구에게나 억만장자가 될 기회가"
  },
  "112": {
   "jp": "38865997",
   "kr": "있다는 거야."
  },
  "113": {
   "jp": "2e40d5ca",
   "kr": "정말 다이스는 멋진 마을이야."
  },
  "114": {
   "jp": "0e87f6ac",
   "kr": "이 마을은 분명 부유한 이들의 것입니다."
  },
  "115": {
   "jp": "e304ea13",
   "kr": "허나 챠펠의 마법은"
  },
  "116": {
   "jp": "d9b4c9b4",
   "kr": "빈부의 차에 얽매이는 것이 아닙니다."
  },
  "117": {
   "jp": "3f6d63e4",
   "kr": "부디 잊지 마시기를."
  },
  "118": {
   "jp": "6711218c",
   "kr": "여기는 다이스의 챠펠입니다."
  },
  "119": {
   "jp": "f8a02da0",
   "kr": "어느 분께 내려 드릴까요?"
  },
  "120": {
   "jp": "958f8260",
   "kr": "어느 챠펠 마법을 원하시는지요?"
  },
  "121": {
   "jp": "dd014f81",
   "kr": "군요."
  },
  "122": {
   "jp": "8a5d470b",
   "kr": "신념을 저버리지 마세요."
  },
  "123": {
   "jp": "e933f6f4",
   "kr": "치유의 빛이 그대와 함께 있기를 빕니다."
  },
  "124": {
   "jp": "df38ea6f",
   "kr": "너희도 챠펠 마법을 받으러 온 거야?"
  },
  "125": {
   "jp": "541feb18",
   "kr": "하지만 카지노에서 도박에 졌을 때의 충격은"
  },
  "126": {
   "jp": "212665d7",
   "kr": "아무리 챠펠 마법으로도 회복 안 되니까"
  },
  "127": {
   "jp": "aba9349f",
   "kr": "너무 빠져들지 않는 게 좋아."
  },
  "128": {
   "jp": "953b9079",
   "kr": "종종 나그네가 이 거리에 와서"
  },
  "129": {
   "jp": "08f6fb8d",
   "kr": "빈털터리가 되고 만다고."
  },
  "130": {
   "jp": "2c6714ac",
   "kr": "조심하라고. 내 충고야."
  },
  "131": {
   "jp": "fc52bcb2",
   "kr": "저는 머나먼 서쪽 나라에서 카지노에서 놀려고"
  },
  "132": {
   "jp": "32071699",
   "kr": "다이스까지 왔어요. 남들은 저를"
  },
  "133": {
   "jp": "828f686c",
   "kr": "떠돌이 도박꾼이라고 부르죠."
  },
  "134": {
   "jp": "179509ff",
   "kr": "멋있죠?"
  },
  "135": {
   "jp": "877f3f67",
   "kr": "실은 말이죠, 몽땅 잃어버려서"
  },
  "136": {
   "jp": "253413b5",
   "kr": "돌아갈 여비도 없어요."
  },
  "137": {
   "jp": "aad3f01a",
   "kr": "여기 숙박비는 어쩌죠 … 으흐흑."
  },
  "138": {
   "jp": "7b57fca6",
   "kr": "네네, 어서 오세요."
  },
  "139": {
   "jp": "9649b81f",
   "kr": "여기는 여관이에요."
  },
  "140": {
   "jp": "b3b81215",
   "kr": "방은 비어 있답니다."
  },
  "141": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "142": {
   "jp": "f697c3e5",
   "kr": "저희는 순례 여행 중인데요"
  },
  "143": {
   "jp": "7abd78f8",
   "kr": "묵어도 될까요?"
  },
  "144": {
   "jp": "5e766445",
   "kr": "어머, 순례자시군요."
  },
  "145": {
   "jp": "73aec126",
   "kr": "서두르는 여행이라서"
  },
  "146": {
   "jp": "7b42c82d",
   "kr": "묵게 될지 어떨지"
  },
  "147": {
   "jp": "835dd5e9",
   "kr": "아직 잘 모르겠어요."
  },
  "148": {
   "jp": "39a68404",
   "kr": "이건 순례자의 증표인"
  },
  "149": {
   "jp": "13c61395",
   "kr": "은단검이에요."
  },
  "150": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "151": {
   "jp": "6a7832a8",
   "kr": "어머, 일일이 보여 주지 않으셔도 되는데요."
  },
  "152": {
   "jp": "0ec949ea",
   "kr": "상관없어요. 마음껏 묵고 가세요."
  },
  "153": {
   "jp": "557b7aee",
   "kr": "순례 여행자라면 언제든 대환영이랍니다."
  },
  "154": {
   "jp": "2a52459f",
   "kr": "제집이라 생각하고 편히 쉬세요."
  },
  "155": {
   "jp": "26a72b57",
   "kr": "이 앞은 바론 씨의 관저야."
  },
  "156": {
   "jp": "c8c1a920",
   "kr": "요즘 저택 주위를 빈민가 아이들이"
  },
  "157": {
   "jp": "b553c266",
   "kr": "어슬렁거린다는 얘기다."
  },
  "158": {
   "jp": "e7d8f3ff",
   "kr": "도둑질하러 들지도 모르니까"
  },
  "159": {
   "jp": "a8fa9042",
   "kr": "경비를 강화한다고"
  },
  "160": {
   "jp": "2c7e74b8",
   "kr": "저택 사람들이 말하더라고."
  },
  "161": {
   "jp": "719980ad",
   "kr": "재산이 있는 것도 문제로군."
  },
  "162": {
   "jp": "ffcb5822",
