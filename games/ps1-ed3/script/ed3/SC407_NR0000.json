 "lines": {
  "0": {
   "jp": "0bb74e02",
   "kr": "북히츠 가도"
  },
  "1": {
   "jp": "f23bd255",
   "kr": "산적 아페고"
  },
  "2": {
   "jp": "6d0d3c7e",
   "kr": "산적 그네스"
  },
  "3": {
   "jp": "82bf0c0f",
   "kr": "산적 누라"
  },
  "4": {
   "jp": "138252df",
   "kr": "산적 콘타"
  },
  "5": {
   "jp": "f45023c6",
   "kr": "우돌경"
  },
  "6": {
   "jp": "198bd84b",
   "kr": "남쪽 하이젠 1460미로"
  },
  "7": {
   "jp": "284f326d",
   "kr": "서쪽 하이젠 1240미로"
  },
  "8": {
   "jp": "976d3611",
   "kr": "남남북 가도 648미로"
  },
  "9": {
   "jp": "992e8058",
   "kr": "북쪽 우돌 국경 220미로"
  },
  "10": {
   "jp": "092801cb",
   "kr": "앗!"
  },
  "11": {
   "jp": "317f240b",
   "kr": "샤라다…"
  },
  "12": {
   "jp": "06957268",
   "kr": "샤라!!"
  },
  "13": {
   "jp": "5590ff80",
   "kr": "네?"
  },
  "14": {
   "jp": "b1b90c36",
   "kr": "(아무도 없잖아…)"
  },
  "15": {
   "jp": "203966a2",
   "kr": "(짜증이 나서)"
  },
  "16": {
   "jp": "e301e629",
   "kr": "(그 녀석을 두고 와 버렸는데)"
  },
  "17": {
   "jp": "6479649d",
   "kr": "(헛것이 들리다니…)"
  },
  "18": {
   "jp": "e5a8e8f8",
   "kr": "(이제 와서 늦었을지 몰라도)"
  },
  "19": {
   "jp": "995767df",
   "kr": "(역시, 그 녀석이 신경 쓰이는 거구나.)"
  },
  "20": {
   "jp": "f39d4c9f",
   "kr": "샤라라니까!!"
  },
  "21": {
   "jp": "3deea50f",
   "kr": "또 들렸어!"
  },
  "22": {
   "jp": "4635a556",
   "kr": "샤라!"
  },
  "23": {
   "jp": "4871c101",
   "kr": "…누군가 했더니"
  },
  "24": {
   "jp": "ad5ce0d4",
   "kr": "사사건건 우리를 방해해 준"
  },
  "25": {
   "jp": "fd359e32",
   "kr": "순례 꼬마 아니냐."
  },
  "26": {
   "jp": "d266a923",
   "kr": "다행히 혼잔가 보네."
  },
  "27": {
   "jp": "77a6ef46",
   "kr": "난 꽤 뒤끝이 있는 타입이야."
  },
  "28": {
   "jp": "deff3270",
   "kr": "각오는 됐지?"
  },
  "29": {
   "jp": "ae24fefb",
   "kr": "자, 잠깐, 기다려 봐!"
  },
  "30": {
   "jp": "8ab73a32",
   "kr": "그럴 때가 아니야."
  },
  "31": {
   "jp": "a6ab2970",
   "kr": "구스가 큰일 났다고!"
  },
  "32": {
   "jp": "7976a162",
   "kr": "흥, 그런 녀석…"
  },
  "33": {
   "jp": "86719884",
   "kr": "시플 샤리네에서 카지무한테"
  },
  "34": {
   "jp": "104358ba",
   "kr": "저주에 걸려 버렸다고!"
  },
  "35": {
   "jp": "24742049",
   "kr": "카지무?"
  },
  "36": {
   "jp": "60788dd6",
   "kr": "그게 누구야, 대체."
  },
  "37": {
   "jp": "81182686",
   "kr": "엄청 무시무시한 환술사야!"
  },
  "38": {
   "jp": "ef4041b9",
   "kr": "그래서, 구스는 지금 어디 있어?"
  },
  "39": {
   "jp": "1f85f06d",
   "kr": "크리스랑 같이 올도스에 있어."
  },
  "40": {
   "jp": "6597e7f7",
   "kr": "거기서 의사 선생님께 보였는데"
  },
  "41": {
   "jp": "bca79c8e",
   "kr": "저주를 풀려면"
  },
  "42": {
   "jp": "5d325db0",
   "kr": "특별한 약이 필요하대."
  },
  "43": {
   "jp": "e55a1eb9",
   "kr": "그렇게 지독한"
  },
  "44": {
   "jp": "5d0a247d",
   "kr": "저주인 거야?"
  },
  "45": {
   "jp": "dd39ca02",
   "kr": "구스는 저런 성격이라"
  },
  "46": {
   "jp": "c816631d",
   "kr": "괜찮은 척하고 있지만"
  },
  "47": {
   "jp": "969c5fdd",
   "kr": "크리스를 보면 잘 알 수 있어."
  },
  "48": {
   "jp": "c6d7857f",
   "kr": "그 말괄량이 크리스마저"
  },
  "49": {
   "jp": "68d385a1",
   "kr": "무척 괴로워 보이는걸."
  },
  "50": {
   "jp": "3adae119",
   "kr": "………"
  },
  "51": {
   "jp": "b441cacc",
   "kr": "퓨엔테의 리즈란 사람이"
  },
  "52": {
   "jp": "c390c65a",
   "kr": "비약 조합법을"
  },
  "53": {
   "jp": "8f2e0530",
   "kr": "알고 있대."
  },
  "54": {
   "jp": "e2887c0e",
   "kr": "리즈?"
  },
  "55": {
   "jp": "797a44f6",
   "kr": "아, 외딴집에 사는 조제사 말이지."
  },
  "56": {
   "jp": "cda5040e",
   "kr": "아는 거야?"
  },
  "57": {
   "jp": "a5094dcc",
   "kr": "뭐, 그런 사람이 있다는 정도는 알지."
  },
  "58": {
   "jp": "6e730615",
   "kr": "어쩔 수 없네…"
  },
  "59": {
   "jp": "19c6b623",
   "kr": "퓨엔테라면"
  },
  "60": {
   "jp": "dc6a2743",
   "kr": "내 앞마당이나 마찬가지야."
  },
  "61": {
   "jp": "8c8916cc",
   "kr": "자, 가자."
  },
  "62": {
   "jp": "2a00636c",
   "kr": "가다니?"
  },
  "63": {
   "jp": "8ada097a",
   "kr": "뻔하잖아."
  },
  "64": {
   "jp": "b537df32",
   "kr": "비약 조합을 부탁하러"
  },
  "65": {
   "jp": "e6d70177",
   "kr": "가는 거야."
  },
  "66": {
   "jp": "b8c4dda2",
   "kr": "같이 가 주는 거야?"
  },
  "67": {
   "jp": "4a8bfeff",
   "kr": "짝꿍 없는 처지끼리."
  },
  "68": {
   "jp": "33f0c31c",
   "kr": "당분간은 서로 협력하는 것도"
  },
  "69": {
   "jp": "f8703c0d",
   "kr": "괜찮잖아?"
  },
  "70": {
   "jp": "efe1e00b",
   "kr": "샤라가 파티에 합류했다."
  },
  "71": {
   "jp": "6e88c682",
   "kr": "자, 리즈의 집에 가려면 아래 삼거리를"
  },
  "72": {
   "jp": "2db8b2ae",
   "kr": "서쪽 하이젠으로 돌아가는 길과"
  },
  "73": {
   "jp": "1f02e219",
   "kr": "남쪽에서 곧장 가는 길이 있어."
  },
  "74": {
   "jp": "c86bd8e3",
   "kr": "거리로는 남쪽 길이 더 가깝지만."
  },
  "75": {
   "jp": "1c568f08",
   "kr": "역시, 샤라야!"
  },
  "76": {
   "jp": "faf407c6",
   "kr": "남자 목소리"
  },
  "77": {
   "jp": "0c7b4e0e",
   "kr": "후후후후후…"
  },
  "78": {
   "jp": "47c303c2",
   "kr": "거기 서라."
  },
  "79": {
   "jp": "f4beb71e",
   "kr": "가진 돈 전부 두고 가 줘야겠어."
  },
  "80": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "81": {
   "jp": "192714bc",
   "kr": "어디, 어디… 누구, 누구?"
  },
  "82": {
   "jp": "6c94044c",
   "kr": "으아아아…"
  },
  "83": {
   "jp": "3bb49e73",
   "kr": "누구시죠?"
  },
  "84": {
   "jp": "d3a7143e",
   "kr": "흐응, 이놈들이 산적이라고?"
  },
  "85": {
   "jp": "442144fd",
   "kr": "죄다 얼빠진 낯짝이네."
  },
  "86": {
   "jp": "446d1d74",
   "kr": "뭐라고!?"
  },
  "87": {
   "jp": "cebe90c5",
   "kr": "우릴 얕잡아 보면 다친다."
  },
  "88": {
   "jp": "53470d39",
   "kr": "여자라고 봐주지 않는다."
  },
  "89": {
   "jp": "90b79c20",
   "kr": "자, 값나가는 걸 내놔."
  },
  "90": {
   "jp": "8b0db5ed",
   "kr": "너희들,"
  },
  "91": {
   "jp": "8c652639",
   "kr": "누구한테 시비 거는 건지"
  },
  "92": {
   "jp": "83bee39b",
   "kr": "알기나 하냐."
  },
  "93": {
   "jp": "14df221a",
   "kr": "뭐, 뭐야…"
  },
  "94": {
   "jp": "f754d504",
   "kr": "모르면 가르쳐 주지."
  },
  "95": {
   "jp": "d1fb780f",
   "kr": "어엇…!?"
  },
  "96": {
   "jp": "a1f0e006",
   "kr": "내 이름은 샤라."
  },
  "97": {
   "jp": "28fb82ef",
   "kr": "국경 없는 여도적 샤라가"
  },
  "98": {
   "jp": "2d02e697",
   "kr": "바로 나다!"
  },
  "99": {
   "jp": "60ee1227",
   "kr": "똑똑히 기억해 두라고!"
  },
  "100": {
   "jp": "031b7a20",
   "kr": "아야야… 제길."
  },
  "101": {
   "jp": "19681b03",
   "kr": "너야말로… 기억해 둬라."
  },
  "102": {
   "jp": "2cd25bc2",
   "kr": "누가 기억한다고…"
  },
  "103": {
   "jp": "b1021855",
   "kr": "추녀."
  },
  "104": {
   "jp": "096ae7ea",
   "kr": "뭐라고오옷!"
  },
  "105": {
   "jp": "cbc4dfc3",
   "kr": "이상한 산적."
  },
  "106": {
   "jp": "da7ce950",
   "kr": "샤라 씨, 정말 강하시네요."
  },
  "107": {
   "jp": "0939ded0",
   "kr": "저 정도로는"
  },
  "108": {
   "jp": "06e69f91",
   "kr": "상대하기도 우스울 지경이야."
  },
  "109": {
   "jp": "525c58ff",
   "kr": "자, 가자."
  },
  "110": {
   "jp": "6237684f",
   "kr": "시간이 아까우니까."
  }
 }
}