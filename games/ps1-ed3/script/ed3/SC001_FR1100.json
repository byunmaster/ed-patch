{
 "archive": "/SCE0/SC001.DAT",
 "member": "..\\DATA\\FR1100.BIN",
 "lines": {
  "0": {
   "jp": "990eaece",
   "kr": "수정호"
  },
  "1": {
   "jp": "fa63e804",
   "kr": "우와…"
  },
  "2": {
   "jp": "17a7b712",
   "kr": "반짝반짝해!"
  },
  "3": {
   "jp": "25ae69d4",
   "kr": "정말 예쁘다."
  },
  "4": {
   "jp": "686c6b43",
   "kr": "이렇게 멋진 곳이었다니."
  },
  "5": {
   "jp": "acc136fe",
   "kr": "…잠깐 들렀다 갈까?"
  },
  "6": {
   "jp": "4b477a34",
   "kr": "조금쯤은 괜찮겠지."
  },
  "7": {
   "jp": "63849c5d",
   "kr": "…저기, 알아?"
  },
  "8": {
   "jp": "e83dcb80",
   "kr": "여기선 예쁜 돌을 찾을 수 있대."
  },
  "9": {
   "jp": "e3424497",
   "kr": "흐〜응."
  },
  "10": {
   "jp": "5a72656d",
   "kr": "근데 그냥 돌이잖아."
  },
  "11": {
   "jp": "82518060",
   "kr": "엄청 예쁜 돌이라니까!"
  },
  "12": {
   "jp": "2eaa0d32",
   "kr": "헤에〜"
  },
  "13": {
   "jp": "d3f70ee0",
   "kr": "정말! 둔하다니까."
  },
  "14": {
   "jp": "0cb0f632",
   "kr": "내 거 찾아 달라니까!"
  },
  "15": {
   "jp": "a6398a80",
   "kr": "처음부터 그렇게 말하면 되잖아."
  },
  "16": {
   "jp": "9fa2647f",
   "kr": "잠깐 기다려."
  },
  "17": {
   "jp": "ce219b03",
   "kr": "금방 찾아 줄게."
  },
  "18": {
   "jp": "612f6299",
   "kr": "응?"
  },
  "19": {
   "jp": "9817bbbe",
   "kr": "야호! 찾았다!!"
  },
  "20": {
   "jp": "1d6e7d76",
   "kr": "짐이 가득해서 더는 못 들겠네."
  },
  "21": {
   "jp": "ba284e32",
   "kr": "뭔가 줄여야겠다…"
  },
  "22": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는"
  },
  "23": {
   "jp": "404f4d26",
   "kr": ", 찾았습니다."
  },
  "24": {
   "jp": "b1c92806",
   "kr": "크리스으!"
  },
  "25": {
   "jp": "8b1b7407",
   "kr": "찾았어〜!"
  },
  "26": {
   "jp": "53389891",
   "kr": "봐! 봐 봐, 크리스."
  },
  "27": {
   "jp": "fa63e804",
   "kr": "우와…"
  },
  "28": {
   "jp": "bbcc059f",
   "kr": "정말 멋져."
  },
  "29": {
   "jp": "68661629",
   "kr": "엄청 잘 어울려!"
  },
  "30": {
   "jp": "d678b6da",
   "kr": "고마워."
  },
  "31": {
   "jp": "0063b435",
   "kr": "쥬리오, 소중히 간직할게."
  },
  "32": {
   "jp": "35cc09d4",
   "kr": "쑥스럽네."
  },
  "33": {
   "jp": "a0110395",
   "kr": "그럼, 슬슬 갈까?"
  },
  "34": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "35": {
   "jp": "457aa455",
   "kr": "있다!"
  },
  "36": {
   "jp": "0759a5d5",
   "kr": "…병 조각이 둥글게 닳은 거잖아."
  },
  "37": {
   "jp": "925960a3",
   "kr": "아얏!"
  },
  "38": {
   "jp": "1f5be737",
   "kr": "이 가재 녀석!!"
  },
  "39": {
   "jp": "f1b6c35f",
   "kr": "앗! 찾…았는데"
  },
  "40": {
   "jp": "10fb2460",
   "kr": "금이 가 버렸어."
  },
  "41": {
   "jp": "1cd0c4a9",
   "kr": "생각보다 힘드네."
  },
  "42": {
   "jp": "6ab39ad1",
   "kr": "야호!!"
  },
  "43": {
   "jp": "2d0ef713",
   "kr": "금화 찾았다."
  },
  "44": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는"
  },
  "45": {
   "jp": "77b7f7fb",
   "kr": "을(를) 손에 넣었습니다."
  },
  "46": {
   "jp": "cb9725e3",
   "kr": "쥬리오!?"
  },
  "47": {
   "jp": "30774087",
   "kr": "어디 가는 거야?"
  },
  "48": {
   "jp": "8a20fb42",
   "kr": "예쁜 돌 찾아 준다고 했잖아!"
  },
  "49": {
   "jp": "fccb1f03",
   "kr": "쥬리오, 정말!!"
  },
  "50": {
   "jp": "6a98e101",
   "kr": "정말! 제대로 좀 찾아 줘."
  },
  "51": {
   "jp": "ba517cac",
   "kr": "힘내, 남자잖아!"
  },
  "52": {
   "jp": "1226998e",
   "kr": "찾았어?"
  }
 }
}