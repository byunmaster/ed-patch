{
 "archive": "/SCE8/SC800.DAT",
 "member": "..\\DATA\\RC0010.BIN",
 "lines": {
  "0": {
   "jp": "f80fe789",
   "kr": "루드"
  },
  "1": {
   "jp": "f3b21c53",
   "kr": "성 아랫마을"
  },
  "2": {
   "jp": "0bb2b9d7",
   "kr": "빈치 노인"
  },
  "3": {
   "jp": "bc0a9f5b",
   "kr": "여관 산페"
  },
  "4": {
   "jp": "5d459b20",
   "kr": "브리트가 누구죠?"
  },
  "5": {
   "jp": "266e8dcd",
   "kr": "내가 성에 있을 때 눈여겨보던 사내다."
  },
  "6": {
   "jp": "051f8a23",
   "kr": "믿어도 되나요?"
  },
  "7": {
   "jp": "ecad6f64",
   "kr": "이런 날을 위해"
  },
  "8": {
   "jp": "7faeaf0f",
   "kr": "미리 예비 지식은 전해 두었다."
  },
  "9": {
   "jp": "54000c6c",
   "kr": "적의 손에 넘어갔을 리는 없을 것이다."
  },
  "10": {
   "jp": "f6113f1c",
   "kr": "연락이 닿았어."
  },
  "11": {
   "jp": "000a05aa",
   "kr": "모스코스의 집 2층에서 만나자고 하더군."
  },
  "12": {
   "jp": "4ab898bb",
   "kr": "모스코스의 집?"
  },
  "13": {
   "jp": "e91c3e82",
   "kr": "성 입구"
  },
  "14": {
   "jp": "97add87f",
   "kr": "바로 동쪽에 있는 집이야."
  },
  "15": {
   "jp": "ec096c35",
   "kr": "그런가, 수고했다."
  },
  "16": {
   "jp": "e9fd0255",
   "kr": "그럼, 난 가게로 돌아가지."
  },
  "17": {
   "jp": "df2d5d5a",
   "kr": "의심받으면"
  },
  "18": {
   "jp": "839e383b",
   "kr": "안 되니까."
  },
  "19": {
   "jp": "759ac49c",
   "kr": "가 볼까."
  },
  "20": {
   "jp": "78386500",
   "kr": "호오, 자네 얼굴은 낯이 익구먼."
  },
  "21": {
   "jp": "8bc9fe79",
   "kr": "듀르젤 공이지?"
  },
  "22": {
   "jp": "6485fadc",
   "kr": "안심하게."
  },
  "23": {
   "jp": "3da942f1",
   "kr": "이제 이 마을에서 자네를 기억하는 건"
  },
  "24": {
   "jp": "1a8c122d",
   "kr": "우리 같은 노인네뿐이라네."
  },
  "25": {
   "jp": "1b9fde73",
   "kr": "게다가 노인들은 모두"
  },
  "26": {
   "jp": "8ece59a5",
   "kr": "자네가 무고하다는 것을 알고 있네."
  },
  "27": {
   "jp": "094e1dfc",
   "kr": "아무래도 루드성 안이 수상해."
  },
  "28": {
   "jp": "664abb3f",
   "kr": "자네, 조사하러 왔지."
  },
  "29": {
   "jp": "7fe249cb",
   "kr": "슬슬"
  },
  "30": {
   "jp": "42c90e65",
   "kr": "자네 같은 사람이 나타날 때라고"
  },
  "31": {
   "jp": "430ee4bf",
   "kr": "생각하고 있었네."
  }
 }
}