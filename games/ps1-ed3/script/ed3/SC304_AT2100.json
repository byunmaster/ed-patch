  },
  "61": {
   "jp": "9cb58ede",
   "kr": "밥에 감자그라탱을 얹고"
  },
  "62": {
   "jp": "552d2fcd",
   "kr": "크림스튜를 끼얹어 볼까."
  },
  "63": {
   "jp": "55e43cbd",
   "kr": "괜찮겠네."
  },
  "64": {
   "jp": "77b4619e",
   "kr": "고마워, 좋은 생각이야."
  },
  "65": {
   "jp": "00179002",
