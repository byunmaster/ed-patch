  },
  "47": {
   "jp": "71a055cf",
   "kr": "내일 요리 콘테스트에"
  },
  "48": {
   "jp": "98ec2757",
   "kr": "나가려고 생각 중인데."
  },
  "49": {
   "jp": "4253e3d5",
