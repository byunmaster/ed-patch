  },
  "19": {
   "jp": "20402879",
   "kr": "고향처럼 편히 쉬세요."
  },
  "20": {
   "jp": "0f05d2d3",
   "kr": "내일은 연중 한 번뿐인 앰비쉬 요리 대회."
  },
  "21": {
   "jp": "b049f830",
   "kr": "쉬실 겸 부디 구경하러 오십시오."
  },
  "22": {
   "jp": "1d8b709b",
   "kr": "적어도 폐하는 만나 뵙고 가세요."
  },
  "23": {
   "jp": "fefeaff3",
   "kr": "두 분이 찾아오시기를"
  },
  "24": {
   "jp": "a7271718",
   "kr": "정말로 기다리고 계셨으니까요."
  },
  "25": {
   "jp": "3df5a0c3",
   "kr": "부디 긴 여행의 피로를"
  },
  "26": {
   "jp": "789b1ce1",
   "kr": "이 앰비쉬에서 느긋하게"
  },
  "27": {
   "jp": "039ab404",
   "kr": "푸세요."
  },
  "28": {
   "jp": "e7e1da60",
   "kr": "어서 오세요, 기다리고 있었습니다."
  },
  "29": {
   "jp": "7a4d5cda",
   "kr": "이그니스 샤리네는 어떠셨습니까?"
  },
  "30": {
   "jp": "69b07cb0",
   "kr": "마을도 성도 자유로이 드나들어"
  },
  "31": {
   "jp": "a6c637e2",
   "kr": "주시라는 말씀입니다."
  },
  "32": {
   "jp": "2e72e9b0",
   "kr": "볼트에서는 신세를 졌습니다."
  },
  "33": {
   "jp": "44d4679a",
   "kr": "자, 안으로 드세요."
  },
  "34": {
   "jp": "f4e1fefb",
   "kr": "슬슬 도착하실 때라고 생각해서"
  },
  "35": {
   "jp": "3c5fb716",
   "kr": "알프레드 왕께서"
  },
  "36": {
   "jp": "8f8314f8",
   "kr": "기다리고 있었답니다."
  },
  "37": {
   "jp": "2df5f5b1",
   "kr": "막다른 곳에서 오른쪽으로 돌아"
  },
  "38": {
   "jp": "a4d9d9d2",
   "kr": "2층으로 올라가 주십시오."
  },
  "39": {
   "jp": "3251324f",
   "kr": "어머, 여행자시군요."
  },
  "40": {
   "jp": "f3e8b001",
   "kr": "어서 오세요"
  },
  "41": {
   "jp": "ece5f4f5",
   "kr": "앰비쉬에 오신 걸 환영합니다!"
  },
  "42": {
   "jp": "24f7818a",
   "kr": "가루가 소동도 가라앉아서"
  },
  "43": {
   "jp": "d43b0664",
   "kr": "다들 크게 기뻐하고 있어요."
  },
  "44": {
   "jp": "ee0d9d74",
   "kr": "내일 알프레드 왕 주최로"
  },
  "45": {
   "jp": "1127a499",
   "kr": "요리 콘테스트가 있답니다."
