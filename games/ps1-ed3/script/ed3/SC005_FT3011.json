 "lines": {
  "0": {
   "jp": "c9fab11d",
   "kr": "매발톱호"
  },
  "1": {
   "jp": "27ab0f1b",
   "kr": "로저"
  },
  "2": {
   "jp": "94c78bc6",
   "kr": "테스"
  },
  "3": {
   "jp": "a5ab341f",
   "kr": "톤쟈"
  },
  "4": {
   "jp": "6333e2dc",
   "kr": "헤스톤"
  },
  "5": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "6": {
   "jp": "c476d00a",
   "kr": "잠겨 있어."
  },
  "7": {
   "jp": "ff36aef6",
   "kr": "쥬리오 군, 안녕."
  },
  "8": {
   "jp": "dd818154",
   "kr": "이 로비는 꽤 편안하단다."
  },
  "9": {
   "jp": "9853c157",
   "kr": "너도 느긋하게 있다 가지 그러니?"
  },
  "10": {
   "jp": "ccaed7ec",
   "kr": "응, 나도 그러고 싶지만"
  },
  "11": {
   "jp": "2cd0b428",
   "kr": "아직 갑판 청소 도중이거든요."
  },
  "12": {
   "jp": "ace16787",
   "kr": "나중에 또 올게요."
  },
  "13": {
   "jp": "21b7dc33",
   "kr": "이야, 쥬리오 군."
  },
  "14": {
   "jp": "8c0ab34c",
   "kr": "일을 또 하나 끝냈나 보구나."
  },
  "15": {
   "jp": "9620f551",
   "kr": "정말 너희에겐 감탄하게 된단다."
  },
  "16": {
   "jp": "f534e8f9",
   "kr": "스스로 일하면서 순례 여행을"
  },
  "17": {
   "jp": "f162db8f",
   "kr": "이어 가고 있으니 말이야."
  },
  "18": {
   "jp": "2e9c717c",
   "kr": "그건 그렇고, 성인 의식으로"
  },
  "19": {
   "jp": "1088b8d7",
   "kr": "순례 여행을 하는 풍습이 있다니"
  },
  "20": {
   "jp": "e8de0cc0",
   "kr": "참 멋진 마을이구나."
  },
  "21": {
   "jp": "7da43dcd",
   "kr": "얘깃거리 삼아 괜찮다면"
  },
  "22": {
   "jp": "e96c8387",
   "kr": "어떤 건지 들려주지 않겠니?"
  },
  "23": {
   "jp": "4e5c31b3",
   "kr": "저도 잘은 모르지만"
  },
  "24": {
   "jp": "9127f6f0",
   "kr": "마을에선 14살이 되면 티라스일에 있는"
  },
  "25": {
   "jp": "ddbaa514",
   "kr": "다섯 샤리네를 순례하는 규칙이래요."
  },
  "26": {
   "jp": "e9b1c83d",
   "kr": "아주 오래된 풍습인가 봐요."
  },
  "27": {
   "jp": "cb42f2bb",
   "kr": "옛날엔 다른 마을에도 순례 의식이 있었다는"
  },
  "28": {
   "jp": "ce85605d",
   "kr": "얘기를 들은 적 있지만, 잘 모르겠어요."
  },
  "29": {
   "jp": "6f737c88",
   "kr": "샤리네에는 마법의 거울이 있어서"
  },
  "30": {
   "jp": "dbe6f5dc",
   "kr": "그걸 제 눈으로 보면서"
  },
  "31": {
   "jp": "091af185",
   "kr": "올도스까지 가는 게 여행의 목적이에요."
  },
  "32": {
   "jp": "f46329cc",
   "kr": "올도스라니."
  },
  "33": {
   "jp": "d795e768",
   "kr": "꽤나 먼 곳까지 가는구나."
  },
  "34": {
   "jp": "8e27e8a8",
   "kr": "마법의 거울이란 게 어떤 거니?"
  },
  "35": {
   "jp": "81d76d86",
   "kr": "네. 순례 여행자가 거울을 보면"
  },
  "36": {
   "jp": "2485f1f7",
   "kr": "점쟁이 수정구슬처럼"
  },
  "37": {
   "jp": "cc5f5c91",
   "kr": "풍경이 나타나요."
  },
  "38": {
   "jp": "a82c67f5",
   "kr": "신기한 거울이구나."
  },
  "39": {
   "jp": "9186479f",
   "kr": "네. 디네에서 처음 봤는데"
  },
  "40": {
   "jp": "0040acb4",
   "kr": "정말 신기했어요."
  },
  "41": {
   "jp": "7feac5b1",
   "kr": "어떤 풍경이 보였니?"
  },
  "42": {
   "jp": "6ddb3d59",
   "kr": "으..음…"
  },
  "43": {
   "jp": "e4260127",
   "kr": "잘 모르겠어요."
  },
  "44": {
   "jp": "4bd4e85a",
   "kr": "초원 같긴 했는데…"
  },
  "45": {
   "jp": "bb1c6464",
   "kr": "샤리네의 현자님은 순례를 계속하다 보면"
  },
  "46": {
   "jp": "a6a509f3",
   "kr": "아름다운 풍경이 보인다고 하셨어요…"
  },
  "47": {
   "jp": "29eee269",
   "kr": "흐음. 그런 거군."
  },
  "48": {
   "jp": "1ec22ee0",
   "kr": "아마 순례 여행을 계속하는 것이"
  },
  "49": {
   "jp": "9ce998a1",
   "kr": "성인이 되기 위한 수행이기도 하겠구나."
  },
  "50": {
   "jp": "7def011f",
   "kr": "고맙구나 좋은 얘기 잘 들었다."
  },
  "51": {
   "jp": "761b76a3",
   "kr": "태어나기 전부터 있던 마을 풍습이라"
  },
  "52": {
   "jp": "1ef72a7a",
   "kr": "저도 잘 모르겠어요."
  },
  "53": {
   "jp": "4ac9c02f",
   "kr": "아쉽구나. 그래도 성인을 맞는 이에게"
  },
  "54": {
   "jp": "0651dcfa",
   "kr": "순례를 시키다니"
  },
  "55": {
   "jp": "17035af3",
   "kr": "정말 훌륭한 풍습이라 생각한단다."
  },
  "56": {
   "jp": "bc6b0819",
   "kr": "짝꿍 아가씨는 잘 있니?"
  },
  "57": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "58": {
   "jp": "bbdd2c4a",
   "kr": "조리장님이랑 열심히 일해요."
  },
  "59": {
   "jp": "2c4a009e",
   "kr": "어라, 쥬리오 군. 무슨 일이니?"
  },
  "60": {
   "jp": "68dc26e5",
   "kr": "질버 선장님, 이쪽에 안 오셨어요?"
  },
  "61": {
   "jp": "1aa526db",
   "kr": "아아, 선장이라면 아까"
  },
  "62": {
   "jp": "95d950af",
   "kr": "저 문으로 나갔단다."
  },
  "63": {
   "jp": "1aa526db",
   "kr": "아아, 선장이라면 아까"
  },
  "64": {
   "jp": "68b44388",
   "kr": "이쪽 계단을 내려갔단다."
  },
  "65": {
   "jp": "9e6a977f",
   "kr": "선장은 만났니?"
  },
  "66": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "67": {
   "jp": "bef99417",
   "kr": "이번엔 망보기를 부탁받았어요."
  },
  "68": {
   "jp": "65f87881",
   "kr": "오늘도 일이구나."
  },
  "69": {
   "jp": "284329c1",
   "kr": "힘내렴, 꼬마 수부님."
  },
  "70": {
   "jp": "e3a3f49d",
   "kr": "갑판 청소는 끝났니?"
  },
  "71": {
   "jp": "c7503461",
   "kr": "오늘은 이제 좀 쉬겠구나."
  },
  "72": {
   "jp": "3afbebff",
   "kr": "아뇨."
  },
  "73": {
   "jp": "743898d9",
   "kr": "더 일하고 싶어요."
  },
  "74": {
   "jp": "68aeb1be",
   "kr": "질버 선장님께 일을 받아야 해요."
  },
  "75": {
   "jp": "4f0b1539",
   "kr": "훌륭하구나."
  },
  "76": {
   "jp": "5e50799d",
   "kr": "우리도 장래에 너 같은"
  },
  "77": {
   "jp": "0bb1de95",
   "kr": "아이를 얻으면 좋겠어."
  },
  "78": {
   "jp": "5c97134b",
   "kr": "어머?"
  },
  "79": {
   "jp": "556c136c",
   "kr": "질버 선장이라면 갑판에 갔단다."
  },
  "80": {
   "jp": "6b13f9bd",
   "kr": "왜 그러세요?"
  },
  "81": {
   "jp": "a920e801",
   "kr": "질버 선장님께 일을 받으려고요."
  },
  "82": {
   "jp": "9ea89cb8",
   "kr": "어머, 엇갈렸구나."
  },
  "83": {
   "jp": "19db8ba3",
   "kr": "선장이라면 선창으로 내려갔단다."
  },
  "84": {
   "jp": "70e5793e",
   "kr": "이제부터 망보기 일이니?"
  },
  "85": {
   "jp": "0eccd5bf",
   "kr": "질버 선장은 너를 높이 사는구나."
  },
  "86": {
   "jp": "f452b0de",
   "kr": "이런 데 있을 때가 아니야!"
  },
  "87": {
   "jp": "f172a96d",
   "kr": "그래."
  },
  "88": {
   "jp": "284329c1",
   "kr": "힘내렴, 꼬마 수부님."
  },
  "89": {
   "jp": "8be930db",
   "kr": "막 깨면 머리가 멍해서 어쩔 도리가 없구먼."
  },
  "90": {
   "jp": "be08a7e1",
   "kr": "잠깐만 기다려 줘."
  },
  "91": {
   "jp": "d231ac1c",
   "kr": "금방 정신 차릴 테니까."
  },
  "92": {
   "jp": "f6eb02d6",
   "kr": "헤스톤 씨가 물을 가져다준 덕분에"
  },
  "93": {
   "jp": "f0ccfcbc",
   "kr": "잠이 좀 깬 것 같아."
  },
  "94": {
   "jp": "c36c2a88",
   "kr": "헤스톤 씨가 물을 줬는데도"
  },
  "95": {
   "jp": "e743d1fc",
   "kr": "아직 눈이 안 떠지네…"
  },
  "96": {
   "jp": "5d36ab1f",
   "kr": "선장? 아마 선내 순찰이 아닐까?"
  },
  "97": {
   "jp": "a36cda34",
   "kr": "냠냠… 새근새근…"
  },
  "98": {
   "jp": "776e4c11",
   "kr": "드르르르…드르렁…"
  },
  "99": {
   "jp": "f3b62fcc",
   "kr": "…푸우…냠냠."
  },
  "100": {
   "jp": "60296e2b",
   "kr": "기분 좋게 자고 있어."
  },
  "101": {
   "jp": "1754935e",
   "kr": "많이 피곤한가 봐."
  },
  "102": {
   "jp": "45f561b8",
   "kr": "쿠우쿠우…"
  },
  "103": {
   "jp": "2738f156",
   "kr": "저기, 톤쟈 씨!"
  },
  "104": {
   "jp": "eee71555",
   "kr": "아직 자도 되는 거예요?"
  },
  "105": {
   "jp": "9d94ef74",
   "kr": "컥!"
  },
  "106": {
   "jp": "c69530eb",
   "kr": "…자면서 화내네."
  },
  "107": {
   "jp": "e66f68b8",
   "kr": "어제 그 수부구나."
  },
  "108": {
   "jp": "5ac9cff5",
   "kr": "너희가 애써 준 덕분에"
  },
  "109": {
   "jp": "20f8d0ab",
   "kr": "내 여행도 아주 쾌적하단다."
  },
  "110": {
   "jp": "35a9265e",
   "kr": "이 수부 군이 잠이 안 깬다고 해서 말이야."
  },
  "111": {
   "jp": "58aeb0a4",
   "kr": "물을 떠다 준 참이란다."
  },
  "112": {
   "jp": "0cad7c1c",
   "kr": "이 수부 군도 분명 피로가 쌓였을 게다."
  },
  "113": {
   "jp": "171489fd",
   "kr": "배를 모는 건, 듣자 하니"
  },
  "114": {
   "jp": "c4aaacb4",
   "kr": "꽤나 힘든 일이라더구나."
  },
  "115": {
   "jp": "55c6e128",
   "kr": "헤스톤 씨 질버 선장님 못 봤어요?"
  },
  "116": {
   "jp": "332a038f",
   "kr": "질버 선장 말이냐?"
  },
  "117": {
   "jp": "5ec1c355",
   "kr": "글쎄? 여기엔 안 온 것 같구나."
  },
  "118": {
   "jp": "7da61de3",
   "kr": "여어, 수부 군."
  },
  "119": {
   "jp": "3449c8ee",
   "kr": "로저 군한테 들었다."
  },
  "120": {
   "jp": "67e0230e",
   "kr": "너희는 순례 여행자라면서."
  },
  "121": {
   "jp": "478e8e08",
   "kr": "그렇다면 은단검을 가지고 있겠지."
  },
  "122": {
   "jp": "163c66ee",
   "kr": "괜찮다면 내게 보여 주지 않겠니?"
  },
  "123": {
   "jp": "bd124338",
   "kr": "이게 은단검이에요."
  },
  "124": {
   "jp": "f49e6747",
   "kr": "호오. 이거 훌륭하군."
  },
  "125": {
   "jp": "a9b6fe38",
   "kr": "이게 말로만 듣던 은단검인가…"
  },
  "126": {
   "jp": "77f09702",
   "kr": "아니, 좋은 걸 봤구나."
  },
  "127": {
   "jp": "58ccde7a",
   "kr": "이야말로 전통과 격식을 오늘에 전하는 성구."
  },
  "128": {
   "jp": "da32276d",
   "kr": "부디 길에서 도둑 따위에게"
  },
  "129": {
   "jp": "9ad5f998",
   "kr": "빼앗기지 않도록 조심해야 한단다."
  },
  "130": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "131": {
   "jp": "4dca7f26",
   "kr": "으…음."
  },
  "132": {
   "jp": "b47697c9",
   "kr": "마을의 보물이라 보여 주기 싫어요."
  },
  "133": {
   "jp": "66420829",
   "kr": "죄송해요."
  },
  "134": {
   "jp": "3afce956",
   "kr": "그토록 소중한 거라면 어쩔 수 없지."
  },
  "135": {
   "jp": "ae92b848",
   "kr": "나야말로 무례한 말을 해서 미안했구나."
  },
  "136": {
   "jp": "2983cc25",
   "kr": "수부 군의 마을에는 은단검 같은"
  },
  "137": {
   "jp": "d6301f35",
   "kr": "보물이 또 있는가?"
  },
  "138": {
   "jp": "3afbebff",
   "kr": "아뇨."
  },
  "139": {
   "jp": "ba657ab0",
   "kr": "그렇게 부자인 마을은 아니에요."
  },
  "140": {
   "jp": "be558b07",
   "kr": "하지만 사는 사람들은 좋은 사람뿐이에요."
  }
 }
