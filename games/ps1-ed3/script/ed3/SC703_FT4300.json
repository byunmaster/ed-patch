{
 "archive": "/SCE7/SC703.DAT",
 "member": "..\\DATA\\FT4300.BIN",
 "lines": {
  "0": {
   "jp": "07150912",
   "kr": "돌페스"
  },
  "1": {
   "jp": "e8cf911a",
   "kr": "탑"
  },
  "2": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "3": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "4": {
   "jp": "59a75d1a",
   "kr": "어라…?"
  },
  "5": {
   "jp": "e1ae031e",
   "kr": "쥬리오!"
  },
  "6": {
   "jp": "25ba0b94",
   "kr": "바다트!"
  },
  "7": {
   "jp": "f39b7838",
   "kr": "허크 삼촌."
  },
  "8": {
   "jp": "aa8ba6e1",
   "kr": "이야, 늦었구나."
  },
  "9": {
   "jp": "290eecc1",
   "kr": "슬슬, 올 때가 됐겠다고 생각하고 있었지."
  },
  "10": {
   "jp": "ce004cfe",
   "kr": "국경 수로에서 떠내려갔더니,"
  },
  "11": {
   "jp": "80f69053",
   "kr": "용케도"
  },
  "12": {
   "jp": "739e5280",
   "kr": "이 근처에 닿았다고."
  },
  "13": {
   "jp": "4edee8a1",
   "kr": "뭘, 간단한 계산이지."
  },
  "14": {
   "jp": "66405c5e",
   "kr": "조류의 흐름을 생각하면 당연한 결과다."
  },
  "15": {
   "jp": "cf012eb7",
   "kr": "허크 씨."
  },
  "16": {
   "jp": "29162a7b",
   "kr": "감사합니다."
  },
  "17": {
   "jp": "1b0b6780",
   "kr": "덕분에"
  },
  "18": {
   "jp": "133a6c6f",
   "kr": "할아버님의 소원이 이루어질 것 같습니다."
  },
  "19": {
   "jp": "f11f4d24",
   "kr": "아니아니, 쥬리오 군과 크리스가"
  },
  "20": {
   "jp": "392b0099",
   "kr": "순례 여행을 해 준 덕분이다."
  },
  "21": {
   "jp": "28bb6e77",
   "kr": "게다가, 아무래도 이건…"
  },
  "22": {
   "jp": "3b0ba9d1",
   "kr": "듀르젤 공 혼자만의 바람이 아니라,"
  },
  "23": {
   "jp": "3289d878",
   "kr": "더 중요하고 깊은 의미를 지닌 일처럼"
  },
  "24": {
   "jp": "dddf9967",
   "kr": "여겨진다네."
  },
  "25": {
   "jp": "2e006ad2",
   "kr": "자네 할아버님은 많은 걸 말하지 않지만,"
  },
  "26": {
   "jp": "ff0639e5",
   "kr": "분명 무언가를 기다리고 계신 거야."
  },
  "27": {
   "jp": "2c191b7e",
   "kr": "자, 내가 말하면 길어지니"
  },
  "28": {
   "jp": "9f47374d",
   "kr": "이번엔 이쯤 하고,"
  },
  "29": {
   "jp": "6d22f51a",
   "kr": "당장 듀르젤 공께 서두르자."
  },
  "30": {
   "jp": "85c4e249",
   "kr": "열쇠는 경비 병사에게서 빼앗아 뒀단다."
  },
  "31": {
   "jp": "197f2b8c",
   "kr": "바다트 군이 으르니 순순히 내놓더군."
  },
  "32": {
   "jp": "02dacc6b",
   "kr": "사실은, 아재가 겁을 준 거라고."
  },
  "33": {
   "jp": "4bfaf58b",
   "kr": "하하. 뭐, 어떠냐."
  },
  "34": {
   "jp": "37d3f027",
   "kr": "자, 서두르기로 하자."
  },
  "35": {
   "jp": "a137e215",
   "kr": "따라오게."
  },
  "36": {
   "jp": "53eb1a53",
   "kr": "좋아, 열렸다."
  },
  "37": {
   "jp": "325555dd",
   "kr": "어서 가게."
  },
  "38": {
   "jp": "c231a5e1",
   "kr": "서라앗!"
  },
  "39": {
   "jp": "ff0ab084",
   "kr": "침입자 놈!"
  },
  "40": {
   "jp": "232f00f0",
   "kr": "옷, 왔다. 왔다."
  },
  "41": {
   "jp": "06872c04",
   "kr": "우와아아…"
  },
  "42": {
   "jp": "20dd0910",
   "kr": "허크는 최상층 열쇠를 썼다."
  },
  "43": {
   "jp": "52ed1ab6",
   "kr": "문이 열렸다."
  },
  "44": {
   "jp": "6e3942b5",
   "kr": "자물쇠가 잠겨 있다."
  },
  "45": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "46": {
   "jp": "7b2cecb3",
   "kr": "소란스럽군."
  },
  "47": {
   "jp": "132e9899",
   "kr": "나에게 무슨 용건이라도 있나?"
  },
  "48": {
   "jp": "59e8260a",
   "kr": "할아버님."
  },
  "49": {
   "jp": "1c85ff23",
   "kr": "죠안나…"
  },
  "50": {
   "jp": "13915da7",
   "kr": "할아버님이 기다리시던 분들을"
  },
  "51": {
   "jp": "ceb3997a",
   "kr": "모시고 왔습니다."
  },
  "52": {
   "jp": "90534653",
   "kr": "왜요?"
  },
  "53": {
   "jp": "6f80d644",
   "kr": "은단검을 들고 순례 여행을 해 오신"
  },
  "54": {
   "jp": "df9de395",
   "kr": "쥬리오 씨와 크리스 씨입니다."
  },
  "55": {
   "jp": "3c39203c",
   "kr": "안녕하세요."
  },
  "56": {
   "jp": "4a3cd819",
   "kr": "저, 쥬리오라고 해요."
  },
  "57": {
   "jp": "607f0e63",
   "kr": "크리스입니다."
  },
  "58": {
   "jp": "808b3558",
   "kr": "우리, 라그픽 마을의 관습으로"
  },
  "59": {
   "jp": "93ae2201",
   "kr": "순례 여행을 하고 온 참이에요."
  },
  "60": {
   "jp": "5bd70e11",
   "kr": "호오, 라그픽 마을이라…"
  },
  "61": {
   "jp": "661e8ad4",
   "kr": "아직 성인 의식은 이어지고 있었군."
  },
  "62": {
   "jp": "756e5c99",
   "kr": "몇 년 전에 끊겼다고 들었는데…"
  },
  "63": {
   "jp": "8cced94d",
   "kr": "의식을 치를 나이의 아이가 없었던 거야."
  },
  "64": {
   "jp": "c09571ba",
   "kr": "우리 앞은 5년쯤 전이긴 하지만."
  },
  "65": {
   "jp": "6085ba44",
   "kr": "없어진 게 아니었던 거야."
  },
  "66": {
   "jp": "206ebd78",
   "kr": "순례는 고식에 따라, 은단검을 들고"
  },
  "67": {
   "jp": "ef7db9ab",
   "kr": "다섯 샤리네를 돌고 온 거로군."
  },
  "68": {
   "jp": "fd4ad162",
   "kr": "네. 제대로 다섯 곳 다 돌고 왔어요."
  },
  "69": {
   "jp": "53c05a66",
   "kr": "디네, 테그라, 이그니스, 시플."
  },
  "70": {
   "jp": "92ea9c4f",
   "kr": "그리고, 마지막으로 올도스."
  },
  "71": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "72": {
   "jp": "d9673b08",
   "kr": "우리, 순례 여행을 하는 동안,"
  },
  "73": {
   "jp": "95c2d722",
   "kr": "여기저기서"
  },
  "74": {
   "jp": "3218db16",
   "kr": "하얀마녀 이야기를 들었어."
  },
  "75": {
   "jp": "305d1680",
   "kr": "게르드 말이냐…"
  },
  "76": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "77": {
   "jp": "6e279b73",
   "kr": "그리고, 올도스의 마법의 거울로 봤어."
  },
  "78": {
   "jp": "9c71ccdf",
   "kr": "폴티아가 세계를 파멸로 이끄는 걸."
  },
  "79": {
   "jp": "761f1f7e",
   "kr": "라우알의 파도도…"
  },
  "80": {
   "jp": "3adae119",
   "kr": "………"
  },
  "81": {
   "jp": "47f90a60",
   "kr": "라우알의 파도를 아는 건,"
  },
  "82": {
   "jp": "ec7d7f94",
   "kr": "이계와 이어진 사람뿐이라고,"
  },
  "83": {
   "jp": "e4d5b81c",
   "kr": "대신관님이 알려 주셨어요."
  },
  "84": {
   "jp": "21ecf2d7",
   "kr": "그리고, 20년 전,"
  },
  "85": {
   "jp": "0149dd41",
   "kr": "하얀마녀가 그걸 걱정하고 있었던"
  },
  "86": {
   "jp": "dfe3b1cf",
   "kr": "것 같다고도요."
  },
  "87": {
   "jp": "3adae119",
   "kr": "………"
  },
  "88": {
   "jp": "e13c2d42",
   "kr": "그 아이는…게르드는…"
  },
  "89": {
   "jp": "8d848468",
   "kr": "그래?"
  },
  "90": {
   "jp": "88eff14a",
   "kr": "라우알이 거칠게 날뛰는 파괴의 파도라면,"
  },
  "91": {
   "jp": "74f5d308",
   "kr": "게르드는 마치 조용한 저녁 바다 같았다."
  },
  "92": {
   "jp": "3adae119",
   "kr": "………"
  },
  "93": {
   "jp": "6b374987",
   "kr": "아무래도 운명의 신은"
  },
  "94": {
   "jp": "baff05ca",
   "kr": "아직 이 늙은이에게 역할을 남기신 모양이군."
  },
  "95": {
   "jp": "7be4e5a6",
   "kr": "듀르젤은,"
  },
  "96": {
   "jp": "9495ef92",
   "kr": "잠시 눈을 감고 깊이 생각했다."
  },
  "97": {
   "jp": "da1852ef",
   "kr": "은단검을 가지고 있겠지?"
  },
  "98": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "99": {
   "jp": "5cc33730",
   "kr": "좋아, 해 보자."
  },
  "100": {
   "jp": "b64b56fd",
   "kr": "할아버님. 이걸."
  },
  "101": {
   "jp": "f41b4b6c",
   "kr": "죠안나는"
  },
  "102": {
   "jp": "b5485709",
   "kr": "을(를) 건넸다."
  },
  "103": {
   "jp": "05ae22e5",
   "kr": "듀르젤은"
  },
  "104": {
   "jp": "eee03db5",
   "kr": "를 장비했다."
  },
  "105": {
   "jp": "f2ed9d3e",
   "kr": "따라와라."
  },
  "106": {
   "jp": "4add9b35",
   "kr": "여길 나간다."
  },
  "107": {
   "jp": "10b343ca",
   "kr": "하지만, 아래층은"
  },
  "108": {
   "jp": "060e7fe3",
   "kr": "분명 병사들로 가득할 거예요."
  },
  "109": {
   "jp": "49eda9a8",
   "kr": "이 탑을 설계시킨 건 나다."
  },
  "110": {
   "jp": "0a4a1e9c",
   "kr": "하기야, 레바스는 모르겠다만."
  },
  "111": {
   "jp": "305de3d4",
   "kr": "빠져나가려 마음먹으면"
  },
  "112": {
   "jp": "9e61ddf1",
   "kr": "언제든 여기서 나올 수 있었다."
  },
  "113": {
   "jp": "e1f21de2",
   "kr": "듀르젤은 벽의 돌을 눌렀다."
  },
  "114": {
   "jp": "cbe8eaf5",
   "kr": "굉장해, 이런 장치가 있었구나."
  },
  "115": {
   "jp": "9a6fecaf",
   "kr": "다치지 않게 싸우는 건"
  },
  "116": {
   "jp": "0cd39051",
   "kr": "제법 어렵다고."
  },
  "117": {
   "jp": "71827ad7",
   "kr": "아, 듀르젤 공."
  },
  "118": {
   "jp": "855c7e4d",
   "kr": "처음 뵙겠습니다."
  },
  "119": {
   "jp": "789de14f",
   "kr": "내가 크리스의 삼촌뻘 되는"
  },
  "120": {
   "jp": "a7e18f70",
   "kr": "허크입니다."
  },
  "121": {
   "jp": "b4f77cfb",
   "kr": "삼촌 인사할 때가 아니잖아."
  },
  "122": {
   "jp": "f30428ac",
   "kr": "위험해."
  },
  "123": {
   "jp": "470428ac",
   "kr": "먼저 가라."
  },
  "124": {
   "jp": "37ba4314",
   "kr": "시간은 벌어 주지."
  },
  "125": {
   "jp": "e98c2972",
   "kr": "저도 돕겠습니다."
  },
  "126": {
   "jp": "52308c0f",
   "kr": "쥬리오 군 일행은 어서 가게."
  },
  "127": {
   "jp": "f5e0a67b",
   "kr": "자네들이 안 가면 의미가 없으니까."
  },
  "128": {
   "jp": "2af0c987",
   "kr": "으음."
  },
  "129": {
   "jp": "04863096",
   "kr": "고맙군."
  },
  "130": {
   "jp": "008b3cd2",
   "kr": "지금 문을 열마."
  },
  "131": {
   "jp": "e7039e02",
   "kr": "여긴 우리에게 맡기렴."
  },
  "132": {
   "jp": "e147b7e2",
   "kr": "자, 안쪽으로 가거라."
  },
  "133": {
   "jp": "77da46dd",
   "kr": "난 추격자가 오나"
  },
  "134": {
   "jp": "960d6599",
   "kr": "여기서 망을 본다."
  },
  "135": {
   "jp": "a345c420",
   "kr": "이쪽은 맡겨라."
  },
  "136": {
   "jp": "7142522a",
   "kr": "쥬리오 너희는"
  },
  "137": {
   "jp": "f92e10d5",
   "kr": "어서 듀르젤한테 가라."
  },
  "138": {
   "jp": "38d7b65a",
   "kr": "듀르젤이 일행에 합류했다."
  }
 }
}