 "lines": {
  "0": {
   "jp": "17a61f4f",
   "kr": "바라카"
  },
  "1": {
   "jp": "bb5ac13a",
   "kr": "투기장"
  },
  "2": {
   "jp": "6a2b8042",
   "kr": "심판"
  },
  "3": {
   "jp": "e1afb7ee",
   "kr": "나제"
  },
  "4": {
   "jp": "66a3eef6",
   "kr": "오늘의 메인이벤트!"
  },
  "5": {
   "jp": "0495dddf",
   "kr": "서쪽 코너, 수수께끼의 나그네 쥬리오!"
  },
  "6": {
   "jp": "ba84f28c",
   "kr": "동쪽 코너, 난폭자 바다트!"
  },
  "7": {
   "jp": "ed419c28",
   "kr": "심판의 소개에"
  },
  "8": {
   "jp": "f268992c",
   "kr": "관중은 한층 더 끓어올랐다."
  },
  "9": {
   "jp": "65818315",
   "kr": "시자아악!"
  },
  "10": {
   "jp": "54e55ed9",
   "kr": "(쥬리오, 어디다 휘두르는 거야.)"
  },
  "11": {
   "jp": "d8d94fb1",
   "kr": "(좀 너무 티 나잖아.)"
  },
  "12": {
   "jp": "ae5c01d5",
   "kr": "(그, 그런가.)"
  },
  "13": {
   "jp": "66344c3a",
   "kr": "(내 실력을 믿어라.)"
  },
  "14": {
   "jp": "cdc9a87c",
   "kr": "(그보다 어쩔 거야?)"
  },
  "15": {
   "jp": "4081fa77",
   "kr": "(틈을 봐서 북쪽 출구로 뛰쳐나가자.)"
  },
  "16": {
   "jp": "5bf4b4e5",
   "kr": "(응, 알았어.)"
  },
  "17": {
   "jp": "6c08c951",
   "kr": "이야!"
  },
  "18": {
   "jp": "46814d3c",
   "kr": "(안 돼…)"
  },
  "19": {
   "jp": "571d0658",
   "kr": "(감시하는 병사가 있어…)"
  },
  "20": {
   "jp": "18e81f3e",
   "kr": "(으, 아프잖아.)"
  },
  "21": {
   "jp": "e41ed964",
   "kr": "(있는 힘껏 때릴 것 없잖아.)"
  },
  "22": {
   "jp": "3582d0a6",
   "kr": "(아까랑 말이 다르잖아.)"
  },
  "23": {
   "jp": "e221a216",
   "kr": "(그보다 나갈 수도 없을 것 같아.)"
  },
  "24": {
   "jp": "82865543",
   "kr": "(안 되겠어, 출구에 병사가 있어.)"
  },
  "25": {
   "jp": "aaddf9dd",
   "kr": "(조금 더 싸우는 척하며 기회를 보자.)"
  },
  "26": {
   "jp": "d60e472e",
   "kr": "(승부가 길어지면 의심받아.)"
  },
  "27": {
   "jp": "6e2f5a72",
   "kr": "(그럼 너, 나한테 져 줄래?)"
  },
  "28": {
   "jp": "3d993833",
   "kr": "(싫어, 그런 건.)"
  },
  "29": {
   "jp": "eaadc324",
   "kr": "(그럼, 상황을 볼 수밖에 없군.)"
  },
  "30": {
   "jp": "5c041c6b",
   "kr": "(응.)"
  },
  "31": {
   "jp": "7b85128d",
   "kr": "이야아!"
  },
  "32": {
   "jp": "b1e142be",
   "kr": "바다트"
  },
  "33": {
   "jp": "548ff434",
   "kr": "우랴아!"
  },
  "34": {
   "jp": "925960a3",
   "kr": "아얏!"
  },
  "35": {
   "jp": "aa19e7b8",
   "kr": "쥬리오 녀석 꽤 하는데."
  },
  "36": {
   "jp": "93d12b2c",
   "kr": "쥬리오와 바다트는"
  },
  "37": {
   "jp": "329ac2ba",
   "kr": "점점 뜨거워졌다."
  },
  "38": {
   "jp": "e9374e8f",
   "kr": "그에 따라 장내도 달아올랐다."
  },
  "39": {
   "jp": "191081b1",
   "kr": "하지만 그때…"
  },
  "40": {
   "jp": "3210368f",
   "kr": "어라?"
  },
  "41": {
   "jp": "79814ccc",
   "kr": "어라라…?"
  },
  "42": {
   "jp": "880ee0c3",
   "kr": "쥬리오, 지금이다!"
  },
  "43": {
   "jp": "76a1cf3d",
   "kr": "기회다."
  },
  "44": {
   "jp": "e753bf37",
   "kr": "응, 오케이."
  },
  "45": {
   "jp": "26bc8496",
   "kr": "여자"
  },
  "46": {
   "jp": "8a1fd689",
   "kr": "두 분, 이쪽으로."
  },
  "47": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "48": {
   "jp": "26bc8496",
   "kr": "여자"
  },
  "49": {
   "jp": "e25d2a42",
   "kr": "그 차림으로는"
  },
  "50": {
   "jp": "85abfc53",
   "kr": "금방 추격자에게 붙잡히고 맙니다."
  },
  "51": {
   "jp": "6600d559",
   "kr": "우선 저희 집으로."
  },
  "52": {
   "jp": "41bbdcdc",
   "kr": "어서!"
  }
 }
}