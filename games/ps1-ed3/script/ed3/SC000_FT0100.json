{
 "archive": "/SCE0/SC000.DAT",
 "member": "..\\DATA\\FT0100.BIN",
 "lines": {
  "0": {
   "jp": "bb708123",
   "kr": "라그픽 마을"
  },
  "1": {
   "jp": "1df824f5",
   "kr": "마을 어귀"
  },
  "2": {
   "jp": "89ecea13",
   "kr": "라프 할아버지"
  },
  "3": {
   "jp": "c582dc13",
   "kr": "키리"
  },
  "4": {
   "jp": "e1ae031e",
   "kr": "쥬리오!"
  },
  "5": {
   "jp": "ac88fd13",
   "kr": "은단검을 받기 전엔 마을에서 나가면 안 돼."
  },
  "6": {
   "jp": "7253f8ac",
   "kr": "파수를 서고 있는 내 처지도 좀 생각해 줘."
  },
  "7": {
   "jp": "dd3380a1",
   "kr": "부탁이야, 응?"
  },
  "8": {
   "jp": "b184c514",
   "kr": "네가 나가면 촌장님한테 내가 혼난단 말이야."
  },
  "9": {
   "jp": "621beb91",
   "kr": "내가 순례를 떠난 건 50년도 더 전이니까."
  },
  "10": {
   "jp": "fe6afbfb",
   "kr": "온갖 경치를 보고 왔네만 분명 어디든"
  },
  "11": {
   "jp": "dc11e7cd",
   "kr": "그 시절과는 변해 버렸겠지."
  },
  "12": {
   "jp": "e5d92a32",
   "kr": "이리저리 다녀 봤네만…"
  },
  "13": {
   "jp": "3ed5ff56",
   "kr": "역시"
  },
  "14": {
   "jp": "7574529f",
   "kr": "내 마을은 여기뿐이지."
  },
  "15": {
   "jp": "1d5fe989",
   "kr": "오늘은 날씨가 좋네요."
  },
  "16": {
   "jp": "cfcab79a",
   "kr": "초록 고원도 예쁘겠죠."
  },
  "17": {
   "jp": "4b278f56",
   "kr": "그래, 예쁘겠지."
  },
  "18": {
   "jp": "f707d7d6",
   "kr": "초록 고원엔 큰 멧돼지가 있을까요?"
  },
  "19": {
   "jp": "66e994c5",
   "kr": "저기, 크리스 이쪽으로 안 왔어요?"
  },
  "20": {
   "jp": "bf03b55c",
   "kr": "이런저런 핑계를 대며 나가려 해도 안 된다."
  },
  "21": {
   "jp": "6a56e989",
   "kr": "떠날 때까진 얌전히 마을 안에 있어라."
  },
  "22": {
   "jp": "663c9430",
   "kr": "저기, 촌장님 이야기는"
  },
  "23": {
   "jp": "e80619ad",
   "kr": "늘 저렇게 길어요?"
  },
  "24": {
   "jp": "3b898773",
   "kr": "아, 순례 마음가짐을 들었구나."
  },
  "25": {
   "jp": "f81b46bd",
   "kr": "난 그렇게 길지 않았어."
  },
  "26": {
   "jp": "b56b42fa",
   "kr": "뭐, 쥬리오랑 크리스니까."
  },
  "27": {
   "jp": "dcbfcec7",
   "kr": "길어지는 건 당연하지."
  },
  "28": {
   "jp": "4ef1c07c",
   "kr": "…무슨 뜻이에요?"
  },
  "29": {
   "jp": "dac62351",
   "kr": "계속 망보느라 피곤하죠?"
  },
  "30": {
   "jp": "5f655fbf",
   "kr": "교대해 드릴게요."
  },
  "31": {
   "jp": "219034f6",
   "kr": "나는 너를 감시하는 거라고!"
  }
 }
}
