 "lines": {
  "0": {
   "jp": "2a8d61a9",
   "kr": "마을 구역"
  },
  "1": {
   "jp": "6360b1e8",
   "kr": "류넬"
  },
  "2": {
   "jp": "790e56cd",
   "kr": "필로 선생"
  },
  "3": {
   "jp": "6f88e233",
   "kr": "여관 크라프"
  },
  "4": {
   "jp": "2147b956",
   "kr": "데지레"
  },
  "5": {
   "jp": "0f466786",
   "kr": "페기"
  },
  "6": {
   "jp": "fad55c11",
   "kr": "아우다"
  },
  "7": {
   "jp": "9ba54334",
   "kr": "스필"
  },
  "8": {
   "jp": "5b65362b",
   "kr": "스토바"
  },
  "9": {
   "jp": "ae5668d5",
   "kr": "판차"
  },
  "10": {
   "jp": "3c78bf16",
   "kr": "올도스 마을은 대성당을 중심으로"
  },
  "11": {
   "jp": "3716b905",
   "kr": "펼쳐져 있답니다."
  },
  "12": {
   "jp": "5975b17c",
   "kr": "아주 넓은 마을이니 길 잃지 마."
  },
  "13": {
   "jp": "543d25b7",
   "kr": "미아…"
  },
  "14": {
   "jp": "da4001f0",
   "kr": "이 마을은 성자의 마을이라서"
  },
  "15": {
   "jp": "c41ad7d8",
   "kr": "술집 같은 건 없다고."
  },
  "16": {
   "jp": "59c6b3b7",
   "kr": "좀 아쉽지."
  },
  "17": {
   "jp": "f1a1fdd7",
   "kr": "잘됐구나."
  },
  "18": {
   "jp": "847d9388",
   "kr": "친구 저주,"
  },
  "19": {
   "jp": "bbf0432b",
   "kr": "풀렸다면서."
  },
  "20": {
   "jp": "08b9298d",
   "kr": "올도스에선 옛날부터"
  },
  "21": {
   "jp": "05ee9174",
   "kr": "고난은 신의 축복이라고들 하지."
  },
  "22": {
   "jp": "8710e80e",
   "kr": "올도스에서 이런 일을 겪다니"
  },
  "23": {
   "jp": "250b66f6",
   "kr": "너는 어지간히 신께"
  },
  "24": {
   "jp": "c39a0971",
   "kr": "눈에 들었는지도 모르겠다."
  },
  "25": {
   "jp": "8a802df7",
   "kr": "필로 선생님은 올도스 제일가는 명의야."
  },
  "26": {
   "jp": "5f8f2226",
   "kr": "어떤 병이든 금방 고쳐 준다고."
  },
  "27": {
   "jp": "27338fbb",
   "kr": "여어, 무슨 일이야?"
  },
  "28": {
   "jp": "784c9b2a",
   "kr": "엇, 필로 선생님을 부르러 가는 거야?"
  },
  "29": {
   "jp": "7efa466e",
   "kr": "누가 아프기라도 한 거야?"
  },
  "30": {
   "jp": "c7163cf7",
   "kr": "걱정 마."
  },
  "31": {
   "jp": "8a802df7",
   "kr": "필로 선생님은 올도스 제일가는 명의야."
  },
  "32": {
   "jp": "0302c510",
   "kr": "금방 고쳐 줄 거라고."
  },
  "33": {
   "jp": "177ac378",
   "kr": "20년쯤 전까지는,"
  },
  "34": {
   "jp": "6e424d5e",
   "kr": "올도스엔 대성당밖에 없었는데 말이지."
  },
  "35": {
   "jp": "746bfa01",
   "kr": "어느새인가"
  },
  "36": {
   "jp": "46ea317c",
   "kr": "번듯한 마을이 되어 버렸구먼."
  },
  "37": {
   "jp": "6c2f1e71",
   "kr": "알고 있나?"
  },
  "38": {
   "jp": "2d5ce421",
   "kr": "여기서 수행한 사람이"
  },
  "39": {
   "jp": "de3f762e",
   "kr": "각지의 신관이나 현자가 되어"
  },
  "40": {
   "jp": "7427a122",
   "kr": "온 세상에서 일하고 있다고."
  },
  "41": {
   "jp": "0cf87174",
   "kr": "칸드나 챠펠에"
  },
  "42": {
   "jp": "5d64b788",
   "kr": "몸담은 사람 중에도"
  },
  "43": {
   "jp": "44997766",
   "kr": "여기서 수행한 사람이 많이 있단다."
  },
  "44": {
   "jp": "b83b76b2",
   "kr": "잘 견뎌 냈구먼."
  },
  "45": {
   "jp": "c2df3287",
   "kr": "분명 이 경험이"
  },
  "46": {
   "jp": "4673388d",
   "kr": "자네를 크게 성장시켰을 게야."
  },
  "47": {
   "jp": "9af23809",
   "kr": "퓨엔테까지 가는 거니?"
  },
  "48": {
   "jp": "709979d6",
   "kr": "두 사람은 내게 맡기게."
  },
  "49": {
   "jp": "26e6ce27",
   "kr": "조심해서 다녀오게나."
  },
  "50": {
   "jp": "de019160",
   "kr": "나도,"
  },
  "51": {
   "jp": "cadc6342",
   "kr": "할 수 있는 건 해 보겠네."
  },
  "52": {
   "jp": "c1e025a3",
   "kr": "해 보겠네."
  },
  "53": {
   "jp": "6ecdcda7",
   "kr": "일행분 상태는 좀 어떤가?"
  },
  "54": {
   "jp": "7acf34ff",
   "kr": "필로 선생님 병원이라면"
  },
  "55": {
   "jp": "b6eda7c6",
   "kr": "서쪽에 있는, 세로로 긴 건물일세."
  },
  "56": {
   "jp": "f5e1dc29",
   "kr": "강 위를 가로질러 지은 집이니"
  },
  "57": {
   "jp": "bd874aa7",
   "kr": "금방 알 수 있을 게야."
  },
  "58": {
   "jp": "3311e827",
   "kr": "아, 안녕하세요."
  },
  "59": {
   "jp": "7085cf1e",
   "kr": "저는 염원하던 대성당 참배를"
  },
  "60": {
   "jp": "d0f6c212",
   "kr": "마쳐서 고향으로 돌아가요."
  },
  "61": {
   "jp": "52f1858c",
   "kr": "또, 어딘가에서 만나면 좋겠네요."
  },
  "62": {
   "jp": "86b54625",
   "kr": "이 올도스는 정말 대단한 마을이네요."
  },
  "63": {
   "jp": "92c52f97",
   "kr": "과연 현자들의 마을이에요."
  },
  "64": {
   "jp": "21ae9fb1",
   "kr": "배울 게 많답니다."
  },
  "65": {
   "jp": "23ebbabc",
   "kr": "쥬리오, 고마워…"
  },
  "66": {
   "jp": "5454987b",
   "kr": "같이 대성당에 가자."
  },
  "67": {
   "jp": "a74a1d98",
   "kr": "쥬리오…"
  },
  "68": {
   "jp": "a622f587",
   "kr": "우리, 올도스에 도착했네…"
  },
  "69": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "70": {
   "jp": "e9e066d7",
   "kr": "헤헤…"
  },
  "71": {
   "jp": "d28d431c",
   "kr": "올도스에 도착했다 싶으니"
  },
  "72": {
   "jp": "d6583967",
   "kr": "왠지 긴장이 풀렸나 봐…"
  },
  "73": {
   "jp": "bcfd20d8",
   "kr": "금방 나을 거야."
  },
  "74": {
   "jp": "d2f778c5",
   "kr": "나으면"
  },
  "75": {
   "jp": "5454987b",
   "kr": "같이 대성당에 가자."
  },
  "76": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "77": {
   "jp": "7c05d52b",
   "kr": "크리스는 꽤 힘들어 보인다."
  },
  "78": {
   "jp": "226a1de7",
   "kr": "끝내주게 멋지다고…"
  },
  "79": {
   "jp": "e020c452",
   "kr": "고작 환술사 저주 따위잖아."
  },
  "80": {
   "jp": "69d11caf",
   "kr": "괜찮다고."
  },
  "81": {
   "jp": "54d24693",
   "kr": "난 언제나 운이 좋다니까."
  },
  "82": {
   "jp": "e28d8f94",
   "kr": "윽…"
  },
  "83": {
   "jp": "b040cab9",
   "kr": "미로포스트를 보시면서 나아가시면,"
  },
  "84": {
   "jp": "435ebc58",
   "kr": "길을 잃을 일도 없으리라 생각합니다만…"
  },
  "85": {
   "jp": "462efbce",
   "kr": "부디 마수에는 조심하시기 바랍니다."
  },
  "86": {
   "jp": "f65c409e",
   "kr": "네, 리즈한테 사정을 말해서"
  },
  "87": {
   "jp": "102141a4",
   "kr": "꼭 올도스로 모셔 올게요."
  },
  "88": {
   "jp": "8a241a8a",
   "kr": "필로 선생님께서도 이러시니"
  },
  "89": {
   "jp": "740d053a",
   "kr": "솔직히 조금 걱정되기 시작했습니다."
  },
  "90": {
   "jp": "e334b38c",
   "kr": "두 분은 제가 돌보겠습니다."
  },
  "91": {
   "jp": "284ccfae",
   "kr": "나로선, 병세가 나빠지는 걸"
  },
  "92": {
   "jp": "2fea4f7b",
   "kr": "막는 정도밖에 못 하지만"
  },
  "93": {
   "jp": "d8466ea3",
   "kr": "안심하게나."
  },
  "94": {
   "jp": "3266557d",
   "kr": "미안하지만, 파렌한테 가서"
  },
  "95": {
   "jp": "a72befde",
   "kr": "책을 빌려다 주게."
  },
  "96": {
   "jp": "ad5d0d5d",
   "kr": "나도, 할 수 있는 건 다 해서"
  },
  "97": {
   "jp": "a660f86a",
   "kr": "병세가 나빠지는 걸 막아 두겠네."
  },
  "98": {
   "jp": "839f11da",
   "kr": "우선은"
  },
  "99": {
   "jp": "9bc3d4f3",
   "kr": "여기서 쉬게 해 주십시오."
  },
  "100": {
   "jp": "cf606009",
   "kr": "입국 수속은"
  },
  "101": {
   "jp": "331de24b",
   "kr": "제가 대신 해 두겠습니다."
  },
  "102": {
   "jp": "2fc0c24d",
   "kr": "진심으로 감사드립니다."
  },
  "103": {
   "jp": "17bc3dc8",
   "kr": "폐를 끼쳤습니다."
  },
  "104": {
   "jp": "d7696674",
   "kr": "저는 관문으로 돌아갑니다만,"
  },
  "105": {
   "jp": "867fb558",
   "kr": "얼른 의사에게 보이시는 게 좋겠습니다."
  },
  "106": {
   "jp": "32c04a57",
   "kr": "저주 풀이라면,"
  },
  "107": {
   "jp": "62a8b790",
   "kr": "올도스에는 좋은 선생님이 계십니다."
  },
  "108": {
   "jp": "8952af5e",
   "kr": "필로 선생님께 보이십시오."
  },
  "109": {
   "jp": "787b57b8",
   "kr": "그럼, 저는 이만."
  },
  "110": {
   "jp": "66fea79d",
   "kr": "친절히 대해 주셔서"
  },
  "111": {
   "jp": "88239568",
   "kr": "정말 감사했습니다."
  },
  "112": {
   "jp": "40f8a6a3",
   "kr": "필로 선생님을 불러올게요."
  },
  "113": {
   "jp": "263aa250",
   "kr": "모리슨 씨는 두 사람 곁에 있어 주세요."
  },
  "114": {
   "jp": "92925444",
   "kr": "네, 알겠습니다."
  },
  "115": {
   "jp": "c739eefd",
   "kr": "흐음…"
  },
  "116": {
   "jp": "fadeda7e",
   "kr": "안 되겠군."
  },
  "117": {
   "jp": "dc49921b",
   "kr": "어, 어떤가요?"
  },
  "118": {
   "jp": "3adae119",
   "kr": "………"
  },
  "119": {
   "jp": "e1857942",
   "kr": "으음."
  },
  "120": {
   "jp": "0a2b1419",
   "kr": "이건 강력한 저주야."
  },
  "121": {
   "jp": "79adf6c4",
   "kr": "이런 건 처음이야."
  },
  "122": {
   "jp": "c8107aad",
   "kr": "내 힘으로 고칠 수 있을지는"
  },
  "123": {
   "jp": "4dd716cf",
   "kr": "장담하기 어렵군."
  },
  "124": {
   "jp": "f8fe5971",
   "kr": "어쨌든, 할 만큼 해 보지."
  },
  "125": {
   "jp": "f117bc56",
   "kr": "이런, 안 되겠어…"
  },
  "126": {
   "jp": "3adae119",
   "kr": "………"
  },
  "127": {
   "jp": "1f80c368",
   "kr": "옆 사람은 어떨까."
  },
  "128": {
   "jp": "6412eb4f",
   "kr": "또다."
  },
  "129": {
   "jp": "1b4a1e00",
   "kr": "어찌나 강력한 저주인지."
  },
  "130": {
   "jp": "d49053d2",
   "kr": "이거참, 만만찮구먼."
  },
  "131": {
   "jp": "b0abc7d9",
   "kr": "필로 선생님. 어떻게 안 될까요?"
  },
  "132": {
   "jp": "0df43379",
   "kr": "잘 부탁드리겠습니다."
  },
  "133": {
   "jp": "ad28c941",
   "kr": "으음, 글쎄 말이지."
  },
  "134": {
   "jp": "ba05b1bf",
   "kr": "아, 맞다!"
  },
  "135": {
   "jp": "efb6bb32",
   "kr": "분명 파렌 집에"
  },
  "136": {
   "jp": "16f57f5f",
   "kr": "이런 증상의 저주 푸는 법이"
  },
  "137": {
   "jp": "d971cf70",
   "kr": "적힌 책이 있었지."
  },
  "138": {
   "jp": "9c93e6b1",
   "kr": "미안하지만"
  },
  "139": {
   "jp": "383f9cdd",
   "kr": "파렌한테 가서"
  },
  "140": {
   "jp": "8d319496",
   "kr": "책을 빌려다 주지 않겠나?"
  },
  "141": {
   "jp": "4614a4f5",
   "kr": "파렌 씨네 말이죠."
  },
  "142": {
   "jp": "cabb96ee",
   "kr": "얍!"
  },
  "143": {
   "jp": "fbe26db8",
   "kr": "아, 수고했네."
  },
  "144": {
   "jp": "8fde04bc",
   "kr": "그거야, 그거."
  },
  "145": {
   "jp": "b749621d",
   "kr": "쥬리오는 파렌의 책을 필로에게 건넸다."
  },
  "146": {
   "jp": "80fe43a0",
   "kr": "필로는 곧바로 책장을 넘기며"
  },
  "147": {
   "jp": "8e421a73",
   "kr": "크리스 일행의 증상에 맞는"
  },
  "148": {
   "jp": "5a61a3d1",
   "kr": "저주 푸는 방법이 실려 있지 않은지 찾았다."
  },
  "149": {
   "jp": "830a9937",
   "kr": "으음"
  },
  "150": {
   "jp": "e7a2cbcf",
   "kr": "여기도 아니군."
  },
  "151": {
   "jp": "f3c777d1",
   "kr": "아냐, 아냐."
  },
  "152": {
   "jp": "e994b7a2",
   "kr": "분명히 실려 있었던 것 같은데."
  },
  "153": {
   "jp": "da167b15",
   "kr": "괜찮을까…"
  },
  "154": {
   "jp": "6ba44aa8",
   "kr": "오, 있다!"
  },
  "155": {
   "jp": "4fdd0bb5",
   "kr": "여기야."
  },
  "156": {
   "jp": "2121977f",
   "kr": "어디 보자, 뭐뭐…"
  },
  "157": {
   "jp": "1e919d71",
   "kr": "회복 마법을 튕겨 내는"
  },
  "158": {
   "jp": "f8d132dc",
   "kr": "저주가 걸려 있는 경우…라."
  },
  "159": {
   "jp": "7039bcae",
   "kr": "보통 저주 풀이가 통하지 않을 만큼"
  },
  "160": {
   "jp": "1194c569",
   "kr": "강력한 저주가 걸려 있는 경우,"
  },
  "161": {
   "jp": "d4f78846",
   "kr": "특제 비약을 써서 푸는 방법이 있다."
  },
  "162": {
   "jp": "cf020d29",
   "kr": "또한, 현재 비약의 조합법을"
  },
  "163": {
   "jp": "a3bf0c42",
   "kr": "이어받은 자는"
  },
  "164": {
   "jp": "ec472e3b",
   "kr": "퓨엔테의 조제사 리즈뿐이라고 되어 있다."
  },
  "165": {
   "jp": "32f492a0",
   "kr": "퓨엔테야?"
  },
  "166": {
   "jp": "b623b109",
   "kr": "이웃 나라입니다."
  },
