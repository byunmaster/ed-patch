   "kr": "하이젠성"
  },
  "1": {
   "jp": "09b1bf97",
   "kr": "1층"
  },
  "2": {
   "jp": "5b5733b0",
   "kr": "하이젠 병사"
  },
  "3": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "4": {
   "jp": "4dd6dc80",
   "kr": "레바리"
  },
  "5": {
   "jp": "dcfbd5fe",
   "kr": "휘리, 안녕."
  },
  "6": {
   "jp": "bcafe2e6",
   "kr": "오늘은 친구들도 함께구나."
  },
  "7": {
   "jp": "3f5757f0",
   "kr": "여어, 휘리."
  },
  "8": {
   "jp": "73a4b580",
   "kr": "오늘도 귀엽네."
  },
  "9": {
   "jp": "3f5757f0",
   "kr": "여어, 휘리."
  },
  "10": {
   "jp": "58a454f1",
   "kr": "늘 기운차 보이네."
  },
  "11": {
   "jp": "0af25349",
   "kr": "앗, 휘리…"
  },
  "12": {
   "jp": "16306cff",
   "kr": "벼벼, 별로…"
  },
  "13": {
   "jp": "c9a4b41d",
   "kr": "땡땡이치는 거 아니야."
  },
  "14": {
   "jp": "eff4f52f",
   "kr": "지금 휴식 시간이야."
  },
  "15": {
   "jp": "08fdcf05",
   "kr": "교대 시간이 올 때까지"
  },
  "16": {
   "jp": "5ae9c908",
   "kr": "여기서 대기하는 거야."
  },
  "17": {
   "jp": "010774e8",
   "kr": "하아. 순찰은 피곤해."
  },
  "18": {
   "jp": "271261e6",
   "kr": "한숨 돌리자, 한숨."
  },
  "19": {
   "jp": "8016fbf2",
   "kr": "임금님의 고민이"
  },
  "20": {
   "jp": "3b2c558b",
   "kr": "어렴풋이 이해가 되기 시작했어."
  },
  "21": {
   "jp": "19cd9971",
   "kr": "아무래도 남부의 캐라크 왕이"
  },
  "22": {
   "jp": "67ae4488",
   "kr": "고민거리가 된 모양이야."
  },
  "23": {
   "jp": "197e4c77",
   "kr": "아우님 캐라크 왕과 연락이 닿지 않아서,"
  },
  "24": {
   "jp": "f71c10cb",
   "kr": "이런저런 나쁜 상상을"
  },
  "25": {
   "jp": "33b0b12f",
   "kr": "하고 계신 모양이거든."
  },
  "26": {
   "jp": "0e188e52",
   "kr": "형제는 사이좋게 지내는 게 제일입니다."
  },
  "27": {
   "jp": "53fd671d",
   "kr": "힘을 합쳐,"
  },
  "28": {
   "jp": "1d5c44f4",
   "kr": "협력해서 퓨엔테를 다스린다."
  },
  "29": {
   "jp": "b9e38982",
   "kr": "에네톤 왕의 이상에는 변함이 없습니다만,"
  },
  "30": {
   "jp": "c920a2e8",
   "kr": "서로 연락이 막혀 있으면,"
  },
  "31": {
   "jp": "12c1f323",
   "kr": "쓸데없는 의심도 생기는 법입니다."
  }
 }
}