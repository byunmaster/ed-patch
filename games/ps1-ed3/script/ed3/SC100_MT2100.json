{
 "archive": "/SCE1/SC100.DAT",
 "member": "..\\DATA\\MT2100.BIN",
 "lines": {
  "0": {
   "jp": "e7041a3b",
   "kr": "테그라"
  },
  "1": {
   "jp": "29df4152",
   "kr": "창고 비아노"
  },
  "2": {
   "jp": "ce0fbc7a",
   "kr": "에메나"
  },
  "3": {
   "jp": "0adf5788",
   "kr": "인타"
  },
  "4": {
   "jp": "4af66eec",
   "kr": "에레크 촌장"
  },
  "5": {
   "jp": "4bfc8012",
   "kr": "스카라 부인"
  },
  "6": {
   "jp": "02381c4c",
   "kr": "아아, 어쩌지."
  },
  "7": {
   "jp": "8010f583",
   "kr": "마을이 가루가에게 습격당하다니…"
  },
  "8": {
   "jp": "b0a3bb5c",
   "kr": "지금부터가 바쁜 시기인데."
  },
  "9": {
   "jp": "672996de",
   "kr": "이탄과 보석 출하 준비를 시작하려던 참에."
  },
  "10": {
   "jp": "0b31242b",
   "kr": "이 잔뜩 쌓인 짐 역시 나 혼자서 다"
  },
  "11": {
   "jp": "a5acfb58",
   "kr": "건사해야 하는 건가."
  },
  "12": {
   "jp": "8c166a31",
   "kr": "그래도, 언제까지고 난감해할 순 없지."
  },
  "13": {
   "jp": "82dcc021",
   "kr": "마음 다잡고 출하 준비를 시작할까."
  },
  "14": {
   "jp": "99370e35",
   "kr": "혼자서 이 짐을 어쩌나 하고 있었는데,"
  },
  "15": {
   "jp": "2e15b88b",
   "kr": "배가 뜰 때까지지만 에메나가 도와주기로"
  },
  "16": {
   "jp": "c70a7707",
   "kr": "됐지 뭐야."
  },
  "17": {
   "jp": "e728daa2",
   "kr": "아이고, 살았다."
  },
  "18": {
   "jp": "7ee4f8f5",
   "kr": "정말 살았다."
  },
  "19": {
   "jp": "de68d7a9",
   "kr": "짐도 꽤 정리됐고"
  },
  "20": {
   "jp": "df79656f",
   "kr": "이제 다음 짐 놓을 자리도 생겼다."
  },
  "21": {
   "jp": "69e3486e",
   "kr": "이제 볼일은 끝나셨나요?"
  },
  "22": {
   "jp": "429b5853",
   "kr": "네, 오래 기다리셨죠."
  },
  "23": {
   "jp": "4f7452ab",
   "kr": "이제 출발할 수 있어요."
  },
  "24": {
   "jp": "9618e75d",
   "kr": "그렇군요."
  },
  "25": {
   "jp": "1880de57",
   "kr": "그럼 인타를 불러올게요."
  },
  "26": {
   "jp": "6601e576",
   "kr": "오랫동안 신세 진 땅을 떠나는걸요,"
  },
  "27": {
   "jp": "fb029795",
   "kr": "적어도, 이 정도 보답은 해야지요."
  },
  "28": {
   "jp": "3a19baff",
   "kr": "네갈섬 사람들께 미안해서요."
  },
  "29": {
   "jp": "dd97547e",
   "kr": "조금 더 시간이 걸릴 것 같은데요,"
  },
  "30": {
   "jp": "ba5cab31",
   "kr": "죄송하지만 이 짐 정리가 끝날 때까지"
  },
  "31": {
   "jp": "9bdaebe1",
   "kr": "기다려 주시겠어요?"
  },
  "32": {
   "jp": "ea066033",
   "kr": "잘됐네요."
  },
  "33": {
   "jp": "10d54f1d",
   "kr": "실은 저희도 케빈 할아버지께"
  },
  "34": {
   "jp": "4675e4c4",
   "kr": "부탁받은 볼일이 있어요."
  },
  "35": {
   "jp": "0ee2c97b",
   "kr": "볼일 마치면 다시 올 테니까"
  },
  "36": {
   "jp": "5127e972",
   "kr": "그때까지 여기서"
  },
  "37": {
   "jp": "b00c524c",
   "kr": "기다려 주세요."
  },
  "38": {
   "jp": "9161b689",
   "kr": "쥬리오, 그럼 마을로 돌아가서"
  },
  "39": {
   "jp": "fbfd26b6",
   "kr": "진귀한 보석 이야기라도 들어 보자."
  },
  "40": {
   "jp": "ea066033",
   "kr": "잘됐네요."
  },
  "41": {
   "jp": "4e591420",
   "kr": "실은 저희도 아직 볼일이 안 끝났어요."
  },
  "42": {
   "jp": "0ee2c97b",
   "kr": "볼일 마치면 다시 올 테니까"
  },
  "43": {
   "jp": "5127e972",
   "kr": "그때까지 여기서"
  },
  "44": {
   "jp": "b00c524c",
   "kr": "기다려 주세요."
  },
  "45": {
   "jp": "587470f7",
   "kr": "보석이라면 케빈 할아버지가"
  },
  "46": {
   "jp": "4d57e4bf",
   "kr": "잘 아세요."
  },
  "47": {
   "jp": "3b296e4b",
   "kr": "네. 여기서 기다리고 있을게요."
  },
  "48": {
   "jp": "b35f380c",
   "kr": "저기, 저 선창 쪽 배에"
  },
  "49": {
   "jp": "c664d495",
   "kr": "태워 주는 거야?"
  },
  "50": {
   "jp": "e794c58d",
   "kr": "나, 빨리 타고 싶어."
  },
  "51": {
   "jp": "98ccfa44",
   "kr": "림 형아도 데려왔으면"
  },
  "52": {
   "jp": "a8fd6aee",
   "kr": "좋았을 텐데…"
  },
  "53": {
   "jp": "84165c84",
   "kr": "어머, 인타."
  },
  "54": {
   "jp": "4110a925",
   "kr": "지금 부르러 가려던"
  },
  "55": {
   "jp": "a8fbb26a",
   "kr": "참이었단다."
  },
  "56": {
   "jp": "f3b780af",
   "kr": "신난다!"
  },
  "57": {
   "jp": "ace5a49a",
   "kr": "배 탈 수 있는 거네."
  },
  "58": {
   "jp": "2cd90f4b",
   "kr": "그럼 나도"
  },
  "59": {
   "jp": "70ca6488",
   "kr": "거기까지 바래다주지."
  },
  "60": {
   "jp": "c56d7099",
   "kr": "아아, 나그네인가…"
  },
  "61": {
   "jp": "2029b800",
   "kr": "나는 테그라의 촌장 에레크일세."
  },
  "62": {
   "jp": "2f1281ad",
   "kr": "마을은 가루가 탓에 보시는 대로라네."
  },
  "63": {
   "jp": "2cdd28d9",
   "kr": "모처럼 들러 주었는데"
  },
  "64": {
   "jp": "f230ec9d",
   "kr": "아무 대접도 못 하는구먼…"
  },
  "65": {
   "jp": "44684d9a",
   "kr": "… 미안하네."
  },
  "66": {
   "jp": "7aa2a3a9",
   "kr": "촌장님"
  },
  "67": {
   "jp": "c73eec76",
   "kr": "너무 낙심하지 마세요."
  },
  "68": {
   "jp": "4003b520",
   "kr": "대지가 결실을 잊을 때"
  },
  "69": {
   "jp": "81cc9341",
   "kr": "산은 바다를 넘고, 사람들의 탄식이 울린다."
  },
  "70": {
   "jp": "2569c6ed",
   "kr": "라고… 그때 마녀의 말 그대로일세."
  },
  "71": {
   "jp": "900372c7",
   "kr": "마녀 말이요?"
  },
  "72": {
   "jp": "e1e524c5",
   "kr": "20년쯤 전에 이 마을에 들른 마녀가"
  },
  "73": {
   "jp": "0ce3979f",
   "kr": "샤리네에서 돌아오는 길에 그리 말했다네."
  },
  "74": {
   "jp": "b4003f9b",
   "kr": "그때는 웃어넘기고 말았네만…"
  },
  "75": {
   "jp": "88db22ae",
   "kr": "이미 그때 마녀는 샤리네의 마법의 거울로"
  },
  "76": {
   "jp": "f87247b3",
   "kr": "이 마을이 가루가에게 부서진 지금의 광경을"
  },
  "77": {
   "jp": "d72aeff8",
   "kr": "보고 있었던 게지."
  },
  "78": {
   "jp": "4003b520",
   "kr": "대지가 결실을 잊을 때"
  },
  "79": {
   "jp": "81cc9341",
   "kr": "산은 바다를 넘고, 사람들의 탄식이 울린다."
  },
  "80": {
   "jp": "2569c6ed",
   "kr": "라고… 그때 마녀의 말 그대로일세."
  },
  "81": {
   "jp": "28a67472",
   "kr": "저희가 도움이 될 만한 일"
  },
  "82": {
   "jp": "91cec03c",
   "kr": "뭔가 없을까요?"
  },
  "83": {
   "jp": "6a53848f",
   "kr": "저런…"
  },
  "84": {
   "jp": "0e5c93ed",
   "kr": "마을을 위해 힘을 빌려주겠다는 겐가?"
  },
  "85": {
   "jp": "73d2e82a",
   "kr": "아니, 고맙네."
  },
  "86": {
   "jp": "1ae3fcd4",
   "kr": "허나, 그 마음만으로 충분하네."
  },
  "87": {
   "jp": "d1cca2e6",
   "kr": "테그라 사람은 모두 부지런하다네."
  },
  "88": {
   "jp": "f8258512",
   "kr": "테그라는 고난을 발판 삼아"
  },
  "89": {
   "jp": "237c2d7f",
   "kr": "금세 예전 마을로 되살아날 게야."
  },
  "90": {
   "jp": "08df4902",
   "kr": "자네들은 순례를 계속하게."
  },
  "91": {
   "jp": "e400a7fb",
   "kr": "그러고 보니,"
  },
  "92": {
   "jp": "4b66f7ea",
   "kr": "요즘은 통 샤리네를 찾는"
  },
  "93": {
   "jp": "c73e3726",
   "kr": "마녀도 없어졌네요."
  },
  "94": {
   "jp": "351faf49",
   "kr": "20년쯤 전에 온 마녀가 마지막이에요."
  },
  "95": {
   "jp": "ae0f34ff",
   "kr": "맞아요. 동굴서 이탄이 난다고 알려 준 것도"
  },
  "96": {
   "jp": "17e920b5",
   "kr": "그 마녀였던 것 같아요."
  },
  "97": {
   "jp": "95e51882",
   "kr": "옛날엔 이 섬도 어업이 유일한 생계였는데"
  },
  "98": {
   "jp": "1ee58d91",
   "kr": "그 뒤로 이탄이 난다는 걸 알게 되어,"
  },
  "99": {
   "jp": "102d6223",
   "kr": "어부 아니어도 살아갈 수 있게 됐어요."
  },
  "100": {
   "jp": "6e323aa5",
   "kr": "마을은 가루가에게 부서졌지만,"
  },
  "101": {
   "jp": "0d6547f2",
   "kr": "마을엔 아직 이탄이 있어요. 넉넉한 살림은"
  },
  "102": {
   "jp": "942de176",
   "kr": "못 되어도 아직은 해 나갈 수 있어요."
  },
  "103": {
   "jp": "c2e1a4e0",
   "kr": "그때 그 마녀 덕분일지도 모르겠네요."
  }
 }
}