{
 "archive": "/SCE2/SC205.DAT",
 "member": "..\\DATA\\AR0200.BIN",
 "lines": {
  "0": {
   "jp": "23b3dc64",
   "kr": "엘자 해안"
  },
  "1": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "2": {
   "jp": "b61ff46c",
   "kr": "정말 이 길에선"
  },
  "3": {
   "jp": "f6272359",
   "kr": "단 한 명 여행자를"
  },
  "4": {
   "jp": "3059bc86",
   "kr": "못 만나네."
  },
  "5": {
   "jp": "532568c2",
   "kr": "가루가 소동 탓에,"
  },
  "6": {
   "jp": "5d6548fc",
   "kr": "길이 완전히"
  },
  "7": {
   "jp": "bbaaa259",
   "kr": "봉쇄된 모양이군."
  },
  "8": {
   "jp": "77f2cdd9",
   "kr": "저기, 그러고 보니까."
  },
  "9": {
   "jp": "e59cbb8b",
   "kr": "어째서 우리가 알리지 않아도"
  },
  "10": {
   "jp": "cee20b13",
   "kr": "볼트 사람들은 가루가가 쳐들어온다는 걸"
  },
  "11": {
   "jp": "1492473f",
   "kr": "알고 있는 걸까?"
  },
  "12": {
   "jp": "aabdd0bd",
   "kr": "꼭 볼트를 덮친다고"
  },
  "13": {
   "jp": "3e54c8bc",
   "kr": "정해진 것도 아닌데."
  },
  "14": {
   "jp": "be495b78",
   "kr": "무슨 소리야."
  },
  "15": {
   "jp": "8467d48d",
   "kr": "참, 쥬리오도 정말."
  },
  "16": {
   "jp": "e03e69d0",
   "kr": "그야"
  },
  "17": {
   "jp": "a5983c37",
   "kr": "여행 도중에 로디가"
  },
  "18": {
   "jp": "9e240d8a",
   "kr": "예언을 들었을 정도인걸."
  },
  "19": {
   "jp": "7622f972",
   "kr": "게르드의 예언은 앰비쉬에선"
  },
  "20": {
   "jp": "b19d2ac7",
   "kr": "분명 유명한 이야기일 거야."
  },
  "21": {
   "jp": "c94094c0",
   "kr": "그럴까."
  },
  "22": {
   "jp": "b747d01d",
   "kr": "그치만 보통은 그런 얘기"
  },
  "23": {
   "jp": "e1c3de0b",
   "kr": "안 믿을 것 같은데."
  },
  "24": {
   "jp": "fbc84372",
   "kr": "왜냐면 예언에선 산이 바다를 넘는다든가"
  },
  "25": {
   "jp": "5c45ec14",
   "kr": "그런 말밖에 안 했다며."
  },
  "26": {
   "jp": "06272455",
   "kr": "산과 가루가를 잇는 건"
  },
  "27": {
   "jp": "5367bb39",
   "kr": "우리처럼 마법의 거울을 안 봤으면"
  },
  "28": {
   "jp": "d669f2ff",
   "kr": "좀처럼 못 할 것 같아."
  },
  "29": {
   "jp": "94df9191",
   "kr": "듣고 보니 쥬리오 말이 맞군."
  },
  "30": {
   "jp": "8a06e9ca",
   "kr": "서두르느라 미처 생각 못 했는데"
  },
  "31": {
   "jp": "3867426b",
   "kr": "앰비쉬의 대응은 너무 빨라…"
  },
  "32": {
   "jp": "ce1408ad",
   "kr": "앰비쉬의 왕은 상당히 유능한 왕이든가,"
  },
  "33": {
   "jp": "7efdbe20",
   "kr": "아니면 오컬트를 좋아하는"
  },
  "34": {
   "jp": "9497790d",
   "kr": "수상쩍은 왕, 둘 중 하나군."
  },
  "35": {
   "jp": "d7f139c9",
   "kr": "뭐, 아무튼 서두르자."
  },
  "36": {
   "jp": "cc209ea2",
   "kr": "엉망으로 짓밟힌 넬바를 봤잖아."
  },
  "37": {
   "jp": "4bca9c93",
   "kr": "가루가한테는 병사가 아무리 많아도"
  },
  "38": {
   "jp": "3ed34eb1",
   "kr": "아무 소용이 없다."
  },
  "39": {
   "jp": "7f1fc35d",
   "kr": "하지만, 나한텐 비장의 작전이 있다."
  },
  "40": {
   "jp": "d365b2a5",
   "kr": "또 늦어서"
  },
  "41": {
   "jp": "098e79b9",
   "kr": "볼트가 넬바처럼 당해 버린다면"
  },
  "42": {
   "jp": "c7384c63",
   "kr": "아무리 후회해도 모자랄 테니까."
  },
  "43": {
   "jp": "d093d276",
   "kr": "비장의 작전이라니?"
  },
  "44": {
   "jp": "8bc940f3",
   "kr": "가루가를 만나 봐야 알지."
  },
  "45": {
   "jp": "82b31277",
   "kr": "앰비쉬 병사들이 있어."
  },
  "46": {
   "jp": "535b63d4",
   "kr": "잘됐다, 늦지 않았네."
  },
  "47": {
   "jp": "4def91c3",
   "kr": "저 너머가 볼트야."
  },
  "48": {
   "jp": "744c3042",
   "kr": "뭐야, 나그네인가?"
  },
  "49": {
   "jp": "ded71ea2",
   "kr": "이렇게 큰일 난 때에 볼트에 오다니"
  },
  "50": {
   "jp": "e79b6627",
   "kr": "대체 무슨 생각인 거야."
  },
  "51": {
   "jp": "ef8a561a",
   "kr": "용케, 요새 문지기가 들여보내 줬군."
  },
  "52": {
   "jp": "6e769161",
   "kr": "급한 일이다."
  },
  "53": {
   "jp": "0cff5152",
   "kr": "들여보내 줘."
  },
  "54": {
   "jp": "8db919bd",
   "kr": "그건 안 된다."
  },
  "55": {
   "jp": "56c4e267",
   "kr": "가루가가 볼트에 상륙할지도 모르니까,"
  },
  "56": {
   "jp": "8fecf71f",
   "kr": "위험하니 아무도 들이지 말라 명령을 받았다."
  },
  "57": {
   "jp": "d7c9286b",
   "kr": "미안하지만"
  },
  "58": {
   "jp": "8e2596df",
   "kr": "포기하고 요새까지 돌아가 줘."
  },
  "59": {
   "jp": "f998cf9d",
   "kr": "말도 안 돼."
  },
  "60": {
   "jp": "dd0c758a",
   "kr": "온 길을 되돌아가란 거냐?"
  },
  "61": {
   "jp": "63d14961",
   "kr": "그런 거다."
  },
  "62": {
   "jp": "7e8d30b2",
   "kr": "로디."
  },
  "63": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "64": {
   "jp": "81cf10df",
   "kr": "이거, 이거."
  },
  "65": {
   "jp": "41417c8a",
   "kr": "이걸 보여 주면 어때?"
  },
  "66": {
   "jp": "04c54a6e",
   "kr": "뭔데."
  },
  "67": {
   "jp": "67420289",
   "kr": "앗, 그건가…"
  },
  "68": {
   "jp": "83b836a8",
   "kr": "통할까."
  },
  "69": {
   "jp": "229219ce",
   "kr": "쥬리오는 알프가 남긴 반지를"
  },
  "70": {
   "jp": "17cb1693",
   "kr": "로디에게 건넸다."
  },
  "71": {
   "jp": "7c78a9c1",
   "kr": "로디는 반지를 내보였다."
  },
  "72": {
   "jp": "7ba1a2d4",
   "kr": "자, 잘 보라고."
  },
  "73": {
   "jp": "ab3781cc",
   "kr": "눈 크게 뜨고"
  },
  "74": {
   "jp": "89431443",
   "kr": "자〜알 보라고."
  },
  "75": {
   "jp": "91e7e341",
   "kr": "뭐야"
  },
  "76": {
   "jp": "c73266b7",
   "kr": "갑자기 잘난 척은…"
  },
  "77": {
   "jp": "a9bd59d7",
   "kr": "그냥 반지가 아니냐…"
  },
  "78": {
   "jp": "f94be5d1",
   "kr": "……응?!"
  },
  "79": {
   "jp": "dfc5cb47",
   "kr": "반지를 보던 병사의 표정이 바뀌었다."
  },
  "80": {
   "jp": "1d77c86d",
   "kr": "이건…"
  },
  "81": {
   "jp": "192555dc",
   "kr": "앰비쉬 왕가"
  },
  "82": {
   "jp": "4aaf19af",
   "kr": "안데라가의 문장."
  },
  "83": {
   "jp": "88c2d057",
   "kr": "먹혔나 봐."
  },
  "84": {
   "jp": "62b476ba",
   "kr": "거봐, 역시 먹혔지."
  },
  "85": {
   "jp": "527084ec",
   "kr": "하핫, 어떠냐."
  },
  "86": {
   "jp": "7a65548d",
   "kr": "그렇다면 너희들"
  },
  "87": {
   "jp": "85d8ac52",
   "kr": "나그네로 꾸민 도적이렷다!"
  },
  "88": {
   "jp": "9308c8fe",
   "kr": "대체"
  },
  "89": {
   "jp": "3c23ada0",
   "kr": "어디서 이 반지를 훔쳤느냐!"
  },
  "90": {
   "jp": "20cda86e",
   "kr": "쥬리오&크리스&로디"
  },
  "91": {
   "jp": "5fd075b1",
   "kr": "에〜엣?"
  },
  "92": {
   "jp": "f315f09d",
   "kr": "어〜이, 모두 나와라〜!"
  },
  "93": {
   "jp": "e5e46dcc",
   "kr": "수상한 놈이 있다!"
  },
  "94": {
   "jp": "4e8aba06",
   "kr": "왜 그래!"
  },
  "95": {
   "jp": "eb4ca0c6",
   "kr": "수상한 놈이라고!"
  },
  "96": {
   "jp": "6ae5f00d",
   "kr": "붙잡아라!"
  },
  "97": {
   "jp": "e5a87fc4",
   "kr": "어째서 이리되는 거냐."
  },
  "98": {
   "jp": "c02c9975",
   "kr": "정말…"
  },
  "99": {
   "jp": "5b99b48c",
   "kr": "하하… 미안해."
  }
 }
}