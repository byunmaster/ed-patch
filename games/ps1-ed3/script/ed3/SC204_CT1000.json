{
 "archive": "/SCE2/SC204.DAT",
 "member": "..\\DATA\\CT1000.BIN",
 "lines": {
  "0": {
   "jp": "8f50dc7b",
   "kr": "다츠"
  },
  "1": {
   "jp": "8556fecd",
   "kr": "시트라"
  },
  "2": {
   "jp": "7b016304",
   "kr": "프레인"
  },
  "3": {
   "jp": "9ed7437c",
   "kr": "냅 촌장"
  },
  "4": {
   "jp": "b684746d",
   "kr": "리그레"
  },
  "5": {
   "jp": "b338fe8d",
   "kr": "바스레"
  },
  "6": {
   "jp": "9c3b5f51",
   "kr": "안지"
  },
  "7": {
   "jp": "a2dbf087",
   "kr": "토니카"
  },
  "8": {
   "jp": "a76cf681",
   "kr": "치젤"
  },
  "9": {
   "jp": "c13883d9",
   "kr": "아이고… 루레 씨."
  },
  "10": {
   "jp": "809a1bdd",
   "kr": "잘 와 주었네."
  },
  "11": {
   "jp": "b9b08776",
   "kr": "약소하네만"
  },
  "12": {
   "jp": "08f58e02",
   "kr": "렌즈콩을 가져왔네."
  },
  "13": {
   "jp": "a8d98a32",
   "kr": "늘 미안하네."
  },
  "14": {
   "jp": "3ab3ce1a",
   "kr": "고맙게"
  },
  "15": {
   "jp": "f9f4c063",
   "kr": "받아 두겠네."
  },
  "16": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "17": {
   "jp": "45c96480",
   "kr": "냅 촌장에게 렌즈콩을 건넸다."
  },
  "18": {
   "jp": "d393c829",
   "kr": "어떤가, 냅 촌장."
  },
  "19": {
   "jp": "2b092680",
   "kr": "슬슬 낮잠 촌장 이름을 반납하고"
  },
  "20": {
   "jp": "e853226c",
   "kr": "힘내 보지 않겠나?"
  },
  "21": {
   "jp": "6ee8a382",
   "kr": "그래, 자네 말이 옳네."
  },
  "22": {
   "jp": "c4fa9cc4",
   "kr": "내가 이 모양이니"
  },
  "23": {
   "jp": "8e161417",
   "kr": "마을 사람들에게도 기력이 없는 게지."
  },
  "24": {
   "jp": "650cc60d",
   "kr": "요즘은 나도"
  },
  "25": {
   "jp": "3082c6fd",
   "kr": "이대로는 안 된다고"
  },
  "26": {
   "jp": "bf646b4b",
   "kr": "생각은 하네만."
  },
  "27": {
   "jp": "0fff1181",
   "kr": "아무래도 이렇다 할"
  },
  "28": {
   "jp": "80eac4c7",
   "kr": "좋은 계기를 못 잡아서 말이야…"
  },
  "29": {
   "jp": "e3635233",
   "kr": "아이고… 나그네신가."
  },
  "30": {
   "jp": "c1a9e161",
   "kr": "이런 데까지 흘러들어 와서"
  },
  "31": {
   "jp": "213031a7",
   "kr": "무슨 일인가?"
  },
  "32": {
   "jp": "e4d83503",
   "kr": "혹시"
  },
  "33": {
   "jp": "9a1fbfc7",
   "kr": "여기 촌장님이신가요?"
  },
  "34": {
   "jp": "a8eda887",
   "kr": "아 그렇다네."
  },
  "35": {
   "jp": "8744da5c",
   "kr": "나는 낮잠만 자고 있는"
  },
  "36": {
   "jp": "1ed369a8",
   "kr": "다츠의 얼간이 촌장일세."
  },
  "37": {
   "jp": "7f1ec456",
   "kr": "스스로 얼간이라고 하는 건"
  },
  "38": {
   "jp": "de84725a",
   "kr": "좋지 않아요."
  },
  "39": {
   "jp": "3af35f85",
   "kr": "괜찮다네."
  },
  "40": {
   "jp": "6f2ccd88",
   "kr": "사실이 그러니까."
  },
  "41": {
   "jp": "e0455ad8",
   "kr": "이 마을을 조금 걸어 봤으면"
  },
  "42": {
   "jp": "0c130c46",
   "kr": "잘 알았을 게야."
  },
  "43": {
   "jp": "585ee2a7",
   "kr": "이 마을엔 기력이란 게 없네."
  },
  "44": {
   "jp": "67407dfe",
   "kr": "뭐, 내가 기력이 없으니"
  },
  "45": {
   "jp": "b8d3adb6",
   "kr": "이런 꼴이 된 게지만"
  },
  "46": {
   "jp": "b77cfa66",
   "kr": "마을 사람들이 다들 어딘가 비뚤어졌지."
  },
  "47": {
   "jp": "0b7e0ac3",
   "kr": "엉망일세."
  },
  "48": {
   "jp": "84248606",
   "kr": "다 같이 기운 내서"
  },
  "49": {
   "jp": "4cd57134",
   "kr": "일하면 되잖아요."
  },
  "50": {
   "jp": "71ebfb44",
   "kr": "그 기운이 안 나니 어쩔 수 없네."
  },
  "51": {
   "jp": "6a1692da",
   "kr": "어쩔 수 없다니…"
  },
  "52": {
   "jp": "24c4c029",
   "kr": "옆 다이스 마을만"
  },
  "53": {
   "jp": "87c48463",
   "kr": "점점 커져 가니까"
  },
  "54": {
   "jp": "35b2f871",
   "kr": "다들, 삐쳐 버린 거군요."
  },
  "55": {
   "jp": "b4bfda4b",
   "kr": "뭐, 간단히 말하자면"
  },
  "56": {
   "jp": "52ca7226",
   "kr": "그런 말이네."
  },
  "57": {
   "jp": "7fecd973",
   "kr": "처음에는"
  },
  "58": {
   "jp": "7c765823",
   "kr": "다이스에 지지 않는 넉넉한 마을로 만들려고"
  },
  "59": {
   "jp": "bc74de04",
   "kr": "애도 써 봤네만."
  },
  "60": {
   "jp": "fb49b3bd",
   "kr": "이렇게 차이가 벌어지니"
  },
  "61": {
   "jp": "64ef5104",
   "kr": "아주 패배자 근성이 몸에 배어 버려서,"
  },
  "62": {
   "jp": "fbf404d6",
   "kr": "어찌해 볼 도리가 없네."
  },
  "63": {
   "jp": "c575964c",
   "kr": "마음은 알겠지만…"
  },
  "64": {
   "jp": "c0c7924f",
   "kr": "한 번쯤은 딱 마음먹고"
  },
  "65": {
   "jp": "d1655446",
   "kr": "힘내 봐야 한다고 생각해요."
  },
  "66": {
   "jp": "dc3443be",
   "kr": "좀처럼 계기가 없어서 말일세."
  },
  "67": {
   "jp": "73d2e82a",
   "kr": "아니, 고맙네."
  },
  "68": {
   "jp": "9e38efdf",
   "kr": "자네들 덕분에"
  },
  "69": {
   "jp": "914a5324",
   "kr": "용기가 솟아났다네."
  },
  "70": {
   "jp": "f1078a3a",
   "kr": "그런 말이나 하니까 안 되죠."
  },
  "71": {
   "jp": "92399270",
   "kr": "그럼, 어떤 때라야"
  },
  "72": {
   "jp": "baa8e779",
   "kr": "계기가 된다는 거죠?"
  },
  "73": {
   "jp": "9f2acb23",
   "kr": "마을 사람들이"
  },
  "74": {
   "jp": "39658956",
   "kr": "한순간이라도 밝아졌을 때겠지…"
  },
  "75": {
   "jp": "684e19cb",
   "kr": "언제 밝아지는데요?"
  },
  "76": {
   "jp": "24c41cbc",
   "kr": "으음… 그러고 보니 1년에 한 번,"
  },
  "77": {
   "jp": "f4eb622e",
   "kr": "키타라 악사 트로바가 왔을 때만은"
  },
  "78": {
   "jp": "20df5274",
   "kr": "다들 한순간 밝아지는구먼."
  },
  "79": {
   "jp": "9eb6ef08",
   "kr": "그럼"
  },
  "80": {
   "jp": "b668de98",
   "kr": "그때가 마을을 다시 세울 기회네요."
  },
  "81": {
   "jp": "131a8d3f",
   "kr": "키타라 악사라."
  },
  "82": {
   "jp": "2c097252",
   "kr": "그렇지!"
  },
  "83": {
   "jp": "ea2a4d77",
   "kr": "늘 이맘때 계절이 되면,"
  },
  "84": {
   "jp": "e284b81b",
   "kr": "키타라 악사가 찾아오지."
  },
  "85": {
   "jp": "c9918773",
   "kr": "이건 정말로"
  },
  "86": {
   "jp": "e7899945",
   "kr": "마을을 다시 세울 기회일지 모르지."
  },
  "87": {
   "jp": "ffcfba98",
   "kr": "맞아요"
  },
  "88": {
   "jp": "8acbeb6e",
   "kr": "힘내세요."
  },
  "89": {
   "jp": "5489dc5a",
   "kr": "좋아, 밑져야 본전이지."
  },
  "90": {
   "jp": "09af95cd",
   "kr": "다음에 키타라 악사가 오면 다시 한 번"
  },
  "91": {
   "jp": "941725bc",
   "kr": "처음부터 힘내자고 말해 보겠네."
  },
  "92": {
   "jp": "36417dcb",
   "kr": "힘내세요, 촌장님."
  },
  "93": {
   "jp": "589c58b1",
   "kr": "콩 가져다준 거야〜?"
  },
  "94": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "95": {
   "jp": "4d636dde",
   "kr": "촌장님께 건네 뒀다."
  },
  "96": {
   "jp": "1757385a",
   "kr": "신난다〜"
  },
  "97": {
   "jp": "8cc7fd29",
   "kr": "우리들 있잖아, 다음에 루레가 오면"
  },
  "98": {
   "jp": "1cf7d4d9",
   "kr": "춤을 보여 주려고"
  },
  "99": {
   "jp": "d209cb15",
   "kr": "연습하고 있었어."
  },
  "100": {
   "jp": "49b19262",
   "kr": "봐 줄래?"
  },
  "101": {
   "jp": "da9760af",
   "kr": "오오, 그거 기대되는구나."
  },
  "102": {
   "jp": "cbbef1ae",
   "kr": "보여 주겠니?"
  },
  "103": {
   "jp": "9def55ab",
   "kr": "아이들"
  },
  "104": {
   "jp": "9b20da62",
   "kr": "네!"
  },
  "105": {
   "jp": "7378a02c",
   "kr": "브라보〜!!"
  },
  "106": {
   "jp": "dbf673b1",
   "kr": "왕궁 무용단보다도 훌륭한 춤이로다!"
  },
  "107": {
   "jp": "c875c6d0",
   "kr": "나는 천재를 봤다!"
  },
  "108": {
   "jp": "9def55ab",
   "kr": "아이들"
  },
  "109": {
   "jp": "cecb2fd9",
   "kr": "신난다〜!"
  },
  "110": {
   "jp": "ce0c04a6",
   "kr": "루레 영감이 다음에 올 때는"
  },
  "111": {
   "jp": "be05cb7b",
   "kr": "더 잘하게 돼 있을 거야!"
  },
  "112": {
   "jp": "fcbb69b3",
   "kr": "춤은 1급이다만"
  },
  "113": {
   "jp": "f7d0b89e",
   "kr": "그 영감 소리는 관두렴."
  },
  "114": {
   "jp": "ec6abed1",
   "kr": "…전혀 안 듣는구나."
  },
  "115": {
   "jp": "5dd4d76d",
   "kr": "이 마을엔"
  },
  "116": {
   "jp": "d71a6f97",
   "kr": "나그네가 볼 만한 것 따위 아무것도 없다."
  },
  "117": {
   "jp": "2b47b96b",
   "kr": "둘러봐야 헛수고지."
  },
  "118": {
   "jp": "11d8560e",
   "kr": "일할 마음 따위"
  },
  "119": {
   "jp": "031f7414",
   "kr": "진작에 사라져 버렸어."
  },
  "120": {
   "jp": "9ea43961",
   "kr": "옆 마을이 커지면 커질수록"
  },
  "121": {
   "jp": "f6795d53",
   "kr": "이쪽이 초라하게 느껴져."
  },
  "122": {
   "jp": "4c67ab2e",
   "kr": "비교당하는 것도 익숙해져 버렸어."
  },
  "123": {
   "jp": "8db8a7fd",
   "kr": "어째서 다이스는 그렇게 부유한데"
  },
  "124": {
   "jp": "3ac1af9e",
   "kr": "이 다츠 마을은,"
  },
  "125": {
   "jp": "4a4208cd",
   "kr": "이렇게 가난한 걸까."
  },
  "126": {
   "jp": "8ff908ea",
   "kr": "나는 20년 전에 왔다는 마녀가"
  },
  "127": {
   "jp": "543cff51",
   "kr": "저주를 건 게 아닌가 하고"
  },
  "128": {
   "jp": "95f199c5",
   "kr": "의심하고 있단다."
  },
  "129": {
   "jp": "161a8638",
   "kr": "마녀의 저주를 살 짓은"
  },
  "130": {
   "jp": "ef27ec67",
   "kr": "아무것도 안 했는데 말이야."
  },
  "131": {
   "jp": "fda18f40",
   "kr": "정말이지, 지독하기도 하지."
  },
  "132": {
   "jp": "e5db8010",
   "kr": "이제, 아무래도 좋아."
  },
  "133": {
   "jp": "727320c6",
   "kr": "우린 죽을 때까지"
  },
  "134": {
   "jp": "7532d16c",
   "kr": "이 마을에서, 멍하니 있는 거야."
  },
  "135": {
   "jp": "14e475bf",
   "kr": "그게 어울리는 거야."
  }
 }
}