  "3": {
   "jp": "2dd0a82d",
   "kr": "세렌트"
  },
  "4": {
   "jp": "73553e6d",
   "kr": "여관 피겔"
  },
  "5": {
   "jp": "ce9d9d2e",
   "kr": "여관 아논"
  },
  "6": {
   "jp": "a1fdcbb4",
   "kr": "리코"
  },
  "7": {
   "jp": "41fc85ed",
   "kr": "베네"
  },
  "8": {
   "jp": "cae81ecd",
   "kr": "도착했어."
  },
  "9": {
   "jp": "ce6577a3",
   "kr": "역시 폴티아의 마을이구나."
  },
  "10": {
   "jp": "abddd062",
   "kr": "어쩐지 라그픽 마을과 닮아서"
  },
  "11": {
   "jp": "33de6518",
   "kr": "정겨운 느낌이 들어."
  },
  "12": {
   "jp": "92c47d49",
   "kr": "어서, 죠안나 씨를"
  },
  "13": {
   "jp": "e0d799bb",
   "kr": "찾아보자."
  },
  "14": {
   "jp": "88149875",
   "kr": "네."
  },
  "15": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "16": {
   "jp": "c4ab092e",
   "kr": "도대체, 언제까지 자는 거야?"
  },
  "17": {
   "jp": "ed4b6aa6",
   "kr": "잠꾸러기라니까…"
  },
  "18": {
   "jp": "290576d8",
   "kr": "미, 미안… 그만…"
  },
  "19": {
   "jp": "a03bf17a",
   "kr": "자, 힘내야지."
  },
  "20": {
   "jp": "bb92df7f",
   "kr": "가자."
  },
  "21": {
   "jp": "b2e0ef72",
   "kr": "안 돼."
  },
  "22": {
   "jp": "2f862d54",
   "kr": "아무리 급하다고 해도…"
  },
  "23": {
   "jp": "7c902059",
   "kr": "뭔가 정보를 알게 될지도 모르잖아."
  },
  "24": {
   "jp": "09da7685",
   "kr": "제대로 죠안나 씨랑"
  },
  "25": {
   "jp": "b3ae4652",
   "kr": "만나 두는 편이 좋아."
  },
  "26": {
   "jp": "bf184ce2",
   "kr": "할아버지가 계신 돌페스의 탑은"
  },
  "27": {
   "jp": "2e1ab43a",
   "kr": "반대쪽입니다."
  },
  "28": {
   "jp": "6140f89b",
   "kr": "느긋하게 있을 순 없어요."
  },
  "29": {
   "jp": "7e514438",
   "kr": "아아…"
  },
  "30": {
   "jp": "5de8f018",
   "kr": "끝내 표정 없는 병사가"
  },
  "31": {
   "jp": "7fe7e24d",
   "kr": "나타나 버렸어…"
  },
  "32": {
   "jp": "d759ae37",
   "kr": "할아버지…"
  },
  "33": {
   "jp": "ed52e824",
   "kr": "저는 어찌하면 좋을까요?"
  },
  "34": {
   "jp": "7d10d6b3",
   "kr": "세계는…"
  },
  "35": {
   "jp": "5d31ac3e",
   "kr": "어찌 되어 버리는 걸까요?"
  },
  "36": {
   "jp": "d759ae37",
   "kr": "할아버지…"
  },
  "37": {
   "jp": "abaa0904",
   "kr": "죠안나 씨는 집에 없나 봐요."
  },
  "38": {
   "jp": "5bb54be8",
   "kr": "모처럼, 여기까지 왔는데…"
  },
  "39": {
   "jp": "a5109906",
   "kr": "조급해해도 소용없어요."
  },
  "40": {
   "jp": "f6c71146",
   "kr": "여관에서 몸을 쉬면서 기다리기로 해요."
  },
  "41": {
   "jp": "2bd68e22",
   "kr": "네. 그게 좋겠어요."
  },
  "42": {
   "jp": "ccba608e",
   "kr": "실례합니다, 죠안나 씨인가요?"
  },
  "43": {
   "jp": "28c0f1c3",
   "kr": "네"
  },
  "44": {
   "jp": "b6bbabb6",
   "kr": "제가 죠안나입니다만."
  },
  "45": {
   "jp": "ad6e2132",
   "kr": "저희는"
  },
  "46": {
   "jp": "8421fce4",
   "kr": "듀르젤 씨를 찾아왔어요."
  },
  "47": {
   "jp": "bc3459f2",
   "kr": "할아버지를…"
  },
  "48": {
   "jp": "88149875",
   "kr": "네."
  },
  "49": {
   "jp": "a10fd062",
   "kr": "할아버지라면,"
  },
  "50": {
   "jp": "f8452d88",
   "kr": "돌페스의 탑에 유폐되어 계세요."
  },
  "51": {
   "jp": "9f75113e",
   "kr": "네, 그 일은 듣고 있어요."
  },
  "52": {
   "jp": "2f2b75e8",
   "kr": "이제부터 돌페스의 탑으로 가서"
  },
  "53": {
   "jp": "b064f182",
   "kr": "뵐 생각이에요."
  },
  "54": {
   "jp": "a7f5f146",
   "kr": "죠안나 씨."
  },
  "55": {
   "jp": "d19fb596",
   "kr": "예전에, 허크 씨라는 여행 학자가"
  },
  "56": {
   "jp": "69a554cb",
   "kr": "여기 온 일을 기억하시나요?"
  },
  "57": {
   "jp": "64ddf595",
   "kr": "허크 씨…?"
  },
  "58": {
   "jp": "9c494a14",
   "kr": "저…"
  },
  "59": {
   "jp": "7395e75f",
   "kr": "하얀마녀를 조사하고 계신다는"
  },
  "60": {
   "jp": "6ee43960",
   "kr": "분이시군요."
  },
  "61": {
   "jp": "b334bbae",
   "kr": "네, 그래요."
  },
  "62": {
   "jp": "907bc370",
   "kr": "이 크리스의 삼촌 되는 분인데"
  },
  "63": {
   "jp": "805a3783",
   "kr": "그 허크 씨한테서 들었어요."
  },
  "64": {
   "jp": "2d9740bc",
   "kr": "당신 할아버지가,"
  },
  "65": {
   "jp": "972b6496",
   "kr": "은단검을 들고 순례를 다녀온 사람만 있다면"
  },
  "66": {
   "jp": "6d40908c",
   "kr": "좋겠다고 말씀하셨다고."
  },
  "67": {
   "jp": "7d2a1e93",
   "kr": "네, 제가 허크 씨께"
  },
  "68": {
   "jp": "5ca27383",
   "kr": "말씀드렸어요."
  },
  "69": {
   "jp": "797ff2b0",
   "kr": "할아버지가,"
  },
  "70": {
   "jp": "112cb721",
   "kr": "왜 그런 말을 했는지,"
  },
  "71": {
   "jp": "a8fe923d",
   "kr": "거기까지는 모르겠지만…"
  },
  "72": {
   "jp": "b4e0ca65",
   "kr": "그분의 연구에 관련이 있을까 싶어서…"
  },
  "73": {
   "jp": "07b3c215",
   "kr": "하지만, 할아버지가 말한 건"
  },
  "74": {
   "jp": "c31432c7",
   "kr": "옛 격식을 따르는 순례 여행이에요."
  },
  "75": {
   "jp": "1182c95d",
   "kr": "지금도 순례 여행을 하는 사람은 있어요."
  },
  "76": {
   "jp": "d138456c",
   "kr": "허나."
  },
  "77": {
   "jp": "e77b9156",
   "kr": "은단검을 지니고 정해진 순서 그대로"
  },
  "78": {
   "jp": "c75b0cb3",
   "kr": "다섯 샤리네를 도는 분 같은 건,"
  },
  "79": {
   "jp": "bc6115b8",
   "kr": "요즘은, 좀처럼 없답니다."
  },
  "80": {
   "jp": "b2705a17",
   "kr": "실은 죠안나 씨."
  },
  "81": {
   "jp": "f0f0e748",
   "kr": "이 쥬리오와 크리스가 그래요."
  },
  "82": {
   "jp": "3e562b27",
   "kr": "옛 법식대로 순례 여행을 해 왔죠."
  },
  "83": {
   "jp": "e09a6df7",
   "kr": "네, 그래요."
  },
  "84": {
   "jp": "74ede2cc",
   "kr": "올도스의 대신관님께서도,"
  },
  "85": {
   "jp": "05903a92",
   "kr": "꼭, 듀르젤 씨를 만나라고 하셨어요."
  },
  "86": {
   "jp": "f45b9127",
   "kr": "어째서일까요?"
  },
  "87": {
   "jp": "30581d30",
   "kr": "은단검을 지니고,"
  },
  "88": {
   "jp": "9b28fb9e",
   "kr": "다섯 샤리네를 돌아온 것이군요?"
  },
  "89": {
   "jp": "4c8e6b98",
   "kr": "쥬리오와 크리스는 힘차게 끄덕였다."
  },
  "90": {
   "jp": "8f986d4d",
   "kr": "잠시, 기다려 주세요."
  },
  "91": {
   "jp": "f41b4b6c",
   "kr": "죠안나는 "
  },
  "92": {
   "jp": "eee03db5",
   "kr": "를 장비했다."
  },
  "93": {
   "jp": "18ad0235",
   "kr": "기다리게 했습니다."
  },
  "94": {
   "jp": "2bc0fa37",
   "kr": "저도 돌페스에 가겠습니다."
  },
  "95": {
   "jp": "797ff2b0",
   "kr": "할아버지가,"
  },
  "96": {
   "jp": "b08b4fa5",
   "kr": "왜 당신들을 간절히 바랐는지"
  },
  "97": {
   "jp": "4a0b9ead",
   "kr": "모르겠지만…"
  },
  "98": {
   "jp": "5e4070f9",
   "kr": "저는,"
  },
  "99": {
   "jp": "499eeba7",
   "kr": "당신들을 무사히 할아버지께 데려다 줄"
  },
  "100": {
   "jp": "df25d5cf",
   "kr": "의무가 있는 것 같아요."
  },
  "101": {
   "jp": "7b450f38",
   "kr": "저도 궁정 검사 듀르젤의 손녀예요."
  },
  "102": {
   "jp": "5e7aedca",
   "kr": "짐이 되지는 않을 거예요."
  },
  "103": {
   "jp": "bd168cf8",
   "kr": "죠안나가 일행에 합류했다."
  },
  "104": {
   "jp": "798a52c0",
   "kr": "자, 돌페스로 가시지요."
  },
  "105": {
   "jp": "807bd302",
   "kr": "네, 안녕하세요."
  },
  "106": {
   "jp": "5b2dcd1b",
   "kr": "실례합니다."
  },
  "107": {
   "jp": "bcf76524",
   "kr": "이 마을에 죠안나 씨라는 분이"
  },
  "108": {
   "jp": "65a85e88",
   "kr": "계시지요?"
  },
  "109": {
   "jp": "2b78f956",
   "kr": "네, 있어요."
  },
  "110": {
   "jp": "109bf2f7",
   "kr": "죠안나 씨의 손님이신가요?"
  },
  "111": {
   "jp": "85d99c70",
   "kr": "죠안나 씨라면"
  },
  "112": {
   "jp": "4e3fb078",
   "kr": "우리 집 북쪽 댁이에요."
  },
  "113": {
   "jp": "372dafa6",
   "kr": "북쪽 집이군요. 고마워요."
  },
  "114": {
   "jp": "ed465531",
   "kr": "북쪽의 한 단 높은 집이,"
  },
  "115": {
   "jp": "534011d9",
   "kr": "죠안나 씨의 집이에요."
  },
  "116": {
   "jp": "2abd5539",
   "kr": "듀르젤 님은 어떻게 지내실까요."
  },
  "117": {
   "jp": "bef622da",
   "kr": "그토록 성을 위해 헌신하셨는데,"
  },
  "118": {
   "jp": "fc556f0d",
   "kr": "돌페스의 탑에 유폐되시다니…"
  },
  "119": {
   "jp": "95911f3b",
   "kr": "루돌프 왕은 무슨 생각이신 걸까요…"
  },
  "120": {
   "jp": "261264a8",
   "kr": "이 아로자 마을은 국경으로 가는 길목이니까."
  },
  "121": {
   "jp": "ec9aaf65",
   "kr": "온갖 사람이 지나가지."
  },
  "122": {
   "jp": "7ce8766c",
   "kr": "그런데 얼마 전에 지나간 병단은"
  },
  "123": {
   "jp": "9e2d9943",
   "kr": "예사롭지 않았어."
  },
  "124": {
   "jp": "d67e046a",
   "kr": "그 병단 놈들은,"
  },
  "125": {
   "jp": "53e64dd8",
   "kr": "마치 악마에게 영혼을 빼앗긴 사람처럼"
  },
  "126": {
   "jp": "7cde5c40",
   "kr": "빈 껍데기처럼 표정이 없었지…"
  },
  "127": {
   "jp": "e2a87b78",
   "kr": "나도 위험한 놈들 많이 봤지만,"
  },
  "128": {
   "jp": "78ed71b5",
   "kr": "저런 놈들이 제일 위험하다니까."
  },
  "129": {
   "jp": "d176148b",
   "kr": "죠안나 씨 집?"
  },
  "130": {
   "jp": "09135946",
   "kr": "아아, 듀르젤 공의 손녀딸 말이지."
  },
  "131": {
   "jp": "8f72c3e3",
   "kr": "죠안나 씨 집이라면"
  },
  "132": {
   "jp": "cf587cee",
   "kr": "북서쪽의 조금 높은 곳에 있는 집이야."
  },
  "133": {
   "jp": "cbe22af0",
   "kr": "그러고 보니, 요즘 지나는 병단은"
  },
  "134": {
   "jp": "b430bf1e",
   "kr": "어쩐지 으스스하단 말이지…"
  },
  "135": {
   "jp": "8e5ecfb6",
   "kr": "마치"
  },
  "136": {
   "jp": "dcd6ee39",
   "kr": "넋을 빼앗긴 것처럼"
  },
  "137": {
   "jp": "0e7f1554",
   "kr": "표정이 없어."
  },
  "138": {
   "jp": "962951c1",
   "kr": "요즘은 국경 지나는 나그네가 적어서 말이지."
  },
  "139": {
   "jp": "f3c7e103",
   "kr": "국경에 병사들이 모여 있어서,"
  },
  "140": {
   "jp": "e1414646",
   "kr": "여행을 삼가는 모양이야."
  },
  "141": {
   "jp": "bea65bb1",
   "kr": "여관도 손님이 없어서,"
  },
  "142": {
   "jp": "b66e6db6",
   "kr": "파리만 날리고 있지."
  },
  "143": {
   "jp": "520a1c43",
   "kr": "피곤해 보이는구나."
  },
  "144": {
   "jp": "685f64ee",
   "kr": "좋아, 어차피 다른 손님도 없으니"
  },
  "145": {
   "jp": "dfd6b6fc",
   "kr": "괜찮으면 쉬었다 가렴."
  },
  "146": {
   "jp": "d6cb1e06",
   "kr": "물론, 공짜로 해 주마."
  },
  "147": {
   "jp": "b8a546f4",
   "kr": "왠지, 너희를 재워 주면"
  },
  "148": {
   "jp": "f661bde9",
   "kr": "또 손님이"
  },
  "149": {
   "jp": "6aafea45",
   "kr": "잔뜩 올 것 같은 기분이 들어."
  },
  "150": {
   "jp": "38ba3b40",
   "kr": "조금 쉰다"
  },
  "151": {
   "jp": "8ac0125b",
   "kr": "쉬지 않는다"
  },
  "152": {
   "jp": "c0c2c272",
   "kr": "그러세요."
  },
  "153": {
   "jp": "77d63165",
   "kr": "안쪽 침대에서 누워서 쉬세요."
  },
  "154": {
   "jp": "1d085803",
   "kr": "사양하지 않아도 돼요."
  },
  "155": {
   "jp": "2fdfed7d",
   "kr": "쉬고 싶어지면 언제든 오세요."
  },
  "156": {
   "jp": "50fd57b7",
   "kr": "쉬고 싶어지면, 언제든 오세요."
  },
  "157": {
   "jp": "6b7b94f0",
   "kr": "무셔뜨엉."
  },
  "158": {
   "jp": "3277dba8",
   "kr": "나 말야."
  },
  "159": {
   "jp": "c41f893c",
   "kr": "여기서, 노고 이썽."
  },
  "160": {
   "jp": "f99fd453",
   "kr": "그랬떠니"
  },
  "161": {
   "jp": "ce842abe",
   "kr": "무셔운 어굴 한 뱅사 아떠띠들이"
  },
  "162": {
   "jp": "794f176c",
   "kr": "지나갔떵."
  },
  "163": {
   "jp": "6c3e8497",
   "kr": "아아, 무셔뜨엉."
  },
  "164": {
   "jp": "d28933e0",
