{
 "archive": "/SCE6/SC604.DAT",
 "member": "..\\DATA\\GT2200.BIN",
 "lines": {
  "0": {
   "jp": "dc464821",
   "kr": "기드넬"
  },
  "1": {
   "jp": "4300e71e",
   "kr": "우르기드 저택"
  },
  "2": {
   "jp": "386d7c46",
   "kr": "파시아"
  },
  "3": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "4": {
   "jp": "e9b5c557",
   "kr": "우르기드"
  },
  "5": {
   "jp": "d12a3c7c",
   "kr": "칸다타"
  },
  "6": {
   "jp": "ed306d71",
   "kr": "뭐냐?"
  },
  "7": {
   "jp": "bb3d9012",
   "kr": "이쪽으로 오면 안 된다!"
  },
  "8": {
   "jp": "34945149",
   "kr": "뭐, 뭐야."
  },
  "9": {
   "jp": "6bf05699",
   "kr": "잘난 척하기는."
  },
  "10": {
   "jp": "70b6a22b",
   "kr": "여기엔 바라카의 칸다타 님이"
  },
  "11": {
   "jp": "97d8c192",
   "kr": "데려온 아가씨를 가둬 두고 있다."
  },
  "12": {
   "jp": "4e3bcd24",
   "kr": "가까이 오면 안 된다."
  },
  "13": {
   "jp": "954abb9f",
   "kr": "하긴, 이 철문은"
  },
  "14": {
   "jp": "f7f1988e",
   "kr": "폭탄에도 꿈쩍 안 하지만."
  },
  "15": {
   "jp": "bda0e77a",
   "kr": "와하하하하하…"
  },
  "16": {
   "jp": "375db9fd",
   "kr": "여기는 우르기드 님의 방입니다."
  },
  "17": {
   "jp": "30ee64b8",
   "kr": "기다리세요."
  },
  "18": {
   "jp": "04448f83",
   "kr": "무슨 용건이신가요?"
  },
  "19": {
   "jp": "53d4d067",
   "kr": "지, 진귀한 물건을 손에 넣어서,"
  },
  "20": {
   "jp": "feb4dfaf",
   "kr": "우르기드 님께"
  },
  "21": {
   "jp": "610e40ea",
   "kr": "드리려고요."
  },
  "22": {
   "jp": "7f7303a7",
   "kr": "오오, 그렇습니까."
  },
  "23": {
   "jp": "447e2065",
   "kr": "마침 우르기드 님이 계십니다."
  },
  "24": {
   "jp": "99df96a7",
   "kr": "당신들은 운이 좋군요."
  },
  "25": {
   "jp": "db5c5e6b",
   "kr": "들어가셔도 좋습니다."
  },
  "26": {
   "jp": "7d8360fe",
   "kr": "저는 우르기드 님의"
  },
  "27": {
   "jp": "196df7f6",
   "kr": "시중을 드는 사람인데요,"
  },
  "28": {
   "jp": "60354d3e",
   "kr": "그쪽은요?"
  },
  "29": {
   "jp": "d9a8f6e6",
   "kr": "우린 우르기드한테"
  },
  "30": {
   "jp": "746652e5",
   "kr": "인사하러 온 나그네다."
  },
  "31": {
   "jp": "a83577aa",
   "kr": "그러세요."
  },
  "32": {
   "jp": "7c711199",
   "kr": "잠깐, 물어봐도 되나?"
  },
  "33": {
   "jp": "2654a3ad",
   "kr": "뭔가요?"
  },
  "34": {
   "jp": "8dd5994c",
   "kr": "바라카의 칸다타가 데려온 아가씨가 있잖아."
  },
  "35": {
   "jp": "8830cb05",
   "kr": "아직, 무사한가?"
  },
  "36": {
   "jp": "c217f098",
   "kr": "크리스 씨라는 분이군요."
  },
  "37": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "38": {
   "jp": "e183434b",
   "kr": "이 방과 똑같은 구조의,"
  },
  "39": {
   "jp": "930e53c6",
   "kr": "서쪽 방에 갇혀 있습니다."
  },
  "40": {
   "jp": "588f8acf",
   "kr": "무사하시리라 생각합니다만."
  },
  "41": {
   "jp": "8c3ba355",
   "kr": "크리스 씨를 구하러 오셨나요?"
  },
  "42": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "43": {
   "jp": "8da9d519",
   "kr": "아…?!"
  },
  "44": {
   "jp": "a9336d1e",
   "kr": "쥬리오… 입이 가볍구나."
  },
  "45": {
   "jp": "c7163cf7",
   "kr": "괜찮아."
  },
  "46": {
   "jp": "f9906e66",
   "kr": "이 사람, 좋은 사람이야."
  },
  "47": {
   "jp": "215fd238",
   "kr": "어머, 고마워요."
  },
  "48": {
   "jp": "03d56300",
   "kr": "입 다물고 있을 테니 안심하세요."
  },
  "49": {
   "jp": "d9dbcb59",
   "kr": "부디, 크리스 씨를"
  },
  "50": {
   "jp": "693a2198",
   "kr": "구해 주세요."
  },
  "51": {
   "jp": "a2bb8765",
   "kr": "(고약한 취미…)"
  },
  "52": {
   "jp": "2a88292f",
   "kr": "(우, 우선 크리스가 무사한지부터.)"
  },
  "53": {
   "jp": "98ff57eb",
   "kr": "(캐물어야 해…)"
  },
  "54": {
   "jp": "f7fd5d41",
   "kr": "아, 안녕하세요."
  },
  "55": {
   "jp": "0685a3e8",
   "kr": "우르기드는 뭔가를 우걱우걱 먹고 있다."
  },
  "56": {
   "jp": "4ac764af",
   "kr": "뭔가?"
  },
  "57": {
   "jp": "368c3e97",
   "kr": "난 바쁘단 말이다."
  },
  "58": {
   "jp": "0167fb74",
   "kr": "냉큼 공물을 놓고 용건을 말하게."
  },
  "59": {
   "jp": "cc060ffa",
   "kr": "아, 저기…"
  },
  "60": {
   "jp": "ee3984df",
   "kr": "(쥬리오…)"
  },
  "61": {
   "jp": "e5830768",
   "kr": "(저 녀석 앞에 있는 접시를 봐.)"
  },
  "62": {
   "jp": "3702829a",
   "kr": "(저놈이 먹고 있는 거…)"
  },
  "63": {
   "jp": "be2c8c05",
   "kr": "우르기드 앞에 있는 접시 위에는"
  },
  "64": {
   "jp": "cd173604",
   "kr": "무화과열매가 산더미처럼 쌓여 있다."
  },
  "65": {
   "jp": "29a68f27",
   "kr": "무화과다아…"
  },
  "66": {
   "jp": "17ab3e7a",
   "kr": "응?"
  },
  "67": {
   "jp": "e7063bc8",
   "kr": "무화과가 어쨌다는 거냐?"
  },
  "68": {
   "jp": "c4957967",
   "kr": "이래서야,"
  },
  "69": {
   "jp": "00189613",
   "kr": "무화과 열매가 한 개쯤 있어 봐야"
  },
  "70": {
   "jp": "54214b4e",
   "kr": "소용없잖아…"
  },
  "71": {
   "jp": "12736f03",
   "kr": "하하아."
  },
  "72": {
   "jp": "afaa4925",
   "kr": "어째서 무화과열매가 있는지"
  },
  "73": {
   "jp": "80868198",
   "kr": "놀란 게로군."
  },
  "74": {
   "jp": "3049bc97",
   "kr": "들켰으니 어쩔 수 없지."
  },
  "75": {
   "jp": "a94fb86f",
   "kr": "비밀이다만 가르쳐 주마."
  },
  "76": {
   "jp": "6a6ad3d0",
   "kr": "무화과가 흉작이라는 건 새빨간 거짓말이다."
  },
  "77": {
   "jp": "b48dbd55",
   "kr": "내가 사재기해서 숨겨 뒀지."
  },
  "78": {
   "jp": "cf512ec9",
   "kr": "숨기면 값이 끝도 없이 올라가니까 말이다."
  },
  "79": {
   "jp": "6a09005b",
   "kr": "히히히…"
  },
  "80": {
   "jp": "eef3b9e5",
   "kr": "난 장사의 천재란 말이야."
  },
  "81": {
   "jp": "261b42f9",
   "kr": "칫, 그런 거였냐."
  },
  "82": {
   "jp": "d75376b8",
   "kr": "그래서, 너희는"
  },
  "83": {
   "jp": "5ed1ef91",
   "kr": "뭘 공물로 가져왔느냐?"
  },
  "84": {
   "jp": "4afd677f",
   "kr": "어서 내놓게."
  },
  "85": {
   "jp": "3582de67",
   "kr": "(크윽…)"
  },
  "86": {
   "jp": "09a486fe",
   "kr": "(이제 와서 무화과를 내놓을 수 있겠냐…)"
  },
  "87": {
   "jp": "f867bb2b",
   "kr": "우르기드 님."
  },
  "88": {
   "jp": "f6bbbbd7",
   "kr": "저희가 뭘 가져왔다고 생각하세요?"
  },
  "89": {
   "jp": "30e8ca47",
   "kr": "글쎄다…"
  },
  "90": {
   "jp": "43362a2d",
   "kr": "그렇게까지 뜸을 들이는 걸 보면,"
  },
  "91": {
   "jp": "5abc4685",
   "kr": "꽤 진귀한 물건인 모양이군."
  },
  "92": {
   "jp": "b47d9d23",
   "kr": "됐으니, 어서 보여 주게."
  },
  "93": {
   "jp": "a96055de",
   "kr": "그거예요."
  },
  "94": {
   "jp": "f78de749",
   "kr": "뭔가, 농담이겠지?"
  },
  "95": {
   "jp": "7b1557e9",
   "kr": "우르기드는"
  },
  "96": {
   "jp": "30633aea",
   "kr": "쥬리오가 놓은 무화과를 손에 집었다."
  },
  "97": {
   "jp": "b1797079",
   "kr": "그냥 무화과열매 아니냐."
  },
  "98": {
   "jp": "bccfc9ef",
   "kr": "아니에요."
  },
  "99": {
   "jp": "1667d65c",
   "kr": "그건.."
  },
  "100": {
   "jp": "82e83f1c",
   "kr": "어디…"
  },
  "101": {
   "jp": "cf5572d1",
   "kr": "으음…. 그러니까…."
  },
  "102": {
   "jp": "d07e2129",
   "kr": "그, 그래."
  },
  "103": {
   "jp": "dd98e5c9",
   "kr": "한 개 먹으면 10년 젊어진다는"
  },
  "104": {
   "jp": "3c14ca5d",
   "kr": "환상의 무화과열매예요."
  },
  "105": {
   "jp": "64b6aae6",
   "kr": "뭐?!"
  },
  "106": {
   "jp": "710e35d6",
   "kr": "정말이냐…?"
  },
  "107": {
   "jp": "9fc69086",
   "kr": "(그랬던가?)"
  },
  "108": {
   "jp": "6d717207",
   "kr": "(그런 걸로 하자.)"
  },
  "109": {
   "jp": "806cea2d",
   "kr": "(그러자.)"
  },
  "110": {
   "jp": "e05b96e1",
   "kr": "그럼, 당장"
  },
  "111": {
   "jp": "3a6dd516",
   "kr": "먹어 보기로 하지."
  },
  "112": {
   "jp": "a2731829",
   "kr": "날름〜"
  },
  "113": {
   "jp": "57a0e7d3",
   "kr": "으음, 맛은 좋군."
  },
  "114": {
   "jp": "07c24575",
   "kr": "듣는다. 듣는다. 듣는구나."
  },
  "115": {
   "jp": "e92915e1",
   "kr": "(이봐, 정말이냐…)"
  },
  "116": {
   "jp": "06cb7976",
   "kr": "듣는구나!"
  },
  "117": {
   "jp": "3adae119",
   "kr": "………"
  },
  "118": {
   "jp": "e2582e80",
   "kr": "후우…"
  },
  "119": {
   "jp": "46382fc5",
   "kr": "그럴 리가 없지 않느냐."
  },
  "120": {
   "jp": "1afaa88f",
   "kr": "농담은 접어 두고"
  },
  "121": {
   "jp": "2e953e9d",
   "kr": "어서 진짜 공물을 내놓게."
  },
  "122": {
   "jp": "90c8f54e",
   "kr": "쥬리오&바다트"
  },
  "123": {
   "jp": "9fd58c52",
   "kr": "털썩…"
  },
  "124": {
   "jp": "a1cbfb94",
   "kr": "설마, 무화과 말고는"
  },
  "125": {
   "jp": "36f83b7b",
   "kr": "아무것도 준비 안 했다,"
  },
  "126": {
   "jp": "b78e4c55",
   "kr": "뭐 그런 건 아니겠지?"
  },
  "127": {
   "jp": "f3c4236a",
   "kr": "만약, 그렇다면"
  },
  "128": {
   "jp": "9adb3f08",
   "kr": "너희들의 그 목은"
  },
  "129": {
   "jp": "4a87f338",
   "kr": "여기서 뎅강 날아가게 된다."
  },
  "130": {
   "jp": "90c8f54e",
   "kr": "쥬리오&바다트"
  },
  "131": {
   "jp": "47f5cb28",
   "kr": "오싹…"
  },
  "132": {
   "jp": "53072b3d",
   "kr": "에, 에, 에이, 참."
  },
  "133": {
   "jp": "70ecc04e",
   "kr": "농담이야. 하하하…"
  },
  "134": {
   "jp": "587ca49d",
   "kr": "맞아요."
  },
  "135": {
   "jp": "a67a7177",
   "kr": "알고 계셨죠?"
  },
  "136": {
   "jp": "e4f77aa9",
   "kr": "아하하하하…"
  },
  "137": {
   "jp": "0442f0f9",
   "kr": "그, 그런데"
  },
  "138": {
   "jp": "4abd9031",
   "kr": "당신이 지금"
  },
  "139": {
   "jp": "3b0a52f4",
   "kr": "가장 갖고 싶은 게 뭐냐?"
  },
  "140": {
   "jp": "30e8ca47",
   "kr": "글쎄다…"
  },
  "141": {
   "jp": "3aeb859e",
   "kr": "너희에게 말해 봐야 무리겠지만,"
  },
  "142": {
   "jp": "cbe75fbe",
   "kr": "메나트에는 진홍의 불꽃과"
  },
  "143": {
   "jp": "c46be340",
   "kr": "불리는 보석이 있다더군."
  },
  "144": {
   "jp": "9890befe",
   "kr": "듣자 하니 테그라의 이탄으로만 만들 수 있는"
  },
  "145": {
   "jp": "2f5892f6",
   "kr": "매우 진귀한 보석이라더라."
  },
  "146": {
   "jp": "f8471948",
   "kr": "앗…"
  },
  "147": {
   "jp": "761eafca",
   "kr": "왜 그러냐?"
  },
  "148": {
   "jp": "8ed61cbe",
   "kr": "있어요."
  },
  "149": {
   "jp": "9f554af1",
   "kr": "그거, 갖고 있어요."
  },
  "150": {
   "jp": "1d77c86d",
   "kr": "이건…"
  },
  "151": {
   "jp": "46c23d14",
   "kr": "우르기드가 진홍의 불꽃을 집었다."
  },
  "152": {
   "jp": "bd9a9711",
   "kr": "이건… 이건 진짜다…"
  },
  "153": {
   "jp": "1eea137b",
   "kr": "굉장해… 아름다워…"
  },
  "154": {
   "jp": "c2cd99ca",
   "kr": "(용케, 그런 걸 갖고 있었군.)"
  },
  "155": {
   "jp": "16a94202",
   "kr": "여행 도중에 메나트에 들렀거든."
  },
  "156": {
   "jp": "a02c7506",
   "kr": "거기서 받은 거야."
  },
  "157": {
   "jp": "dc1bf9e6",
   "kr": "흐응."
  },
  "158": {
   "jp": "0251b7d1",
   "kr": "이건 훌륭하구나."
  },
  "159": {
   "jp": "aaad04c1",
   "kr": "진짜를 보는 건 처음이지만"
  },
  "160": {
   "jp": "7e5749a3",
   "kr": "이 광채를 보면"
  },
  "161": {
   "jp": "f952c9c7",
   "kr": "틀림없이 진짜라는 걸 알겠다…"
  },
  "162": {
   "jp": "0f145b40",
   "kr": "소문 이상의 광채다."
  },
  "163": {
   "jp": "9eb6ef08",
   "kr": "그럼"
  },
  "164": {
   "jp": "e5645c11",
   "kr": "우리 부탁도 들어주는 거겠지."
  },
  "165": {
   "jp": "c4633c20",
   "kr": "말해 보게."
  },
  "166": {
   "jp": "74fb5dd2",
   "kr": "바라카의 칸다타가"
  },
  "167": {
   "jp": "65ca6aa1",
   "kr": "크리스라는 여자애를 데려왔잖아."
  },
  "168": {
   "jp": "fa40cc7b",
   "kr": "그 애는 우리 아는 사이라고."
  },
  "169": {
   "jp": "dcf1ef42",
   "kr": "돌려줘."
  },
  "170": {
   "jp": "327fcd89",
   "kr": "크리스?"
  },
  "171": {
   "jp": "bee1378b",
   "kr": "아아."
  },
  "172": {
   "jp": "8d7bf1b8",
   "kr": "무희로 삼겠다고"
  },
  "173": {
   "jp": "ca2084d1",
   "kr": "칸다타가 데려온 아가씨 말이냐."
  },
  "174": {
   "jp": "f7e6c6bb",
   "kr": "무희로…"
  },
  "175": {
   "jp": "e6910bb3",
   "kr": "풋."
  },
  "176": {
   "jp": "646bbf62",
   "kr": "안 어울려."
  },
  "177": {
   "jp": "dde4a738",
   "kr": "실은 나도 그리 생각한다."
  },
  "178": {
   "jp": "63d20beb",
   "kr": "꽤나 고집이 세서"
  },
  "179": {
   "jp": "f15d9201",
   "kr": "말을 도통 안 들으니"
  },
  "180": {
   "jp": "8e780324",
   "kr": "방에 가둬 둔 채다."
  },
  "181": {
   "jp": "3d7d937a",
   "kr": "그럼, 돌려주는 거겠지."
  },
  "182": {
   "jp": "dd238bbd",
   "kr": "흐으음…"
  },
  "183": {
   "jp": "39c506e6",
   "kr": "칸다타의 목소리"
  },
  "184": {
   "jp": "e9cb0308",
   "kr": "우르기드 님, 기다리십쇼!"
  },
  "185": {
   "jp": "b6ea5dec",
   "kr": "기다리십쇼!"
  },
  "186": {
   "jp": "52bd5883",
   "kr": "그 계집애를 쫓아 찾아오다니…"
  },
  "187": {
   "jp": "be7da195",
   "kr": "혹시."
  },
  "188": {
   "jp": "8a4c8f92",
   "kr": "(윽, 칸다타다…)"
  },
  "189": {
   "jp": "830ff027",
   "kr": "정체를 밝혀라!"
  },
  "190": {
   "jp": "2830fb13",
   "kr": "쥬리오 일행은 베일을 빼앗기고 말았다."
  },
  "191": {
   "jp": "1ac8d73b",
   "kr": "앗, 너희들?!"
  },
  "192": {
   "jp": "9514ddaf",
   "kr": "이놈들은"
  },
  "193": {
   "jp": "6ae3ab60",
   "kr": "분명, 사막의 흑표범 앞잡이입니다요."
  },
  "194": {
   "jp": "92ec2be0",
   "kr": "제 집이 당했을 때"
  },
  "195": {
   "jp": "fb766704",
   "kr": "옆에 있던 놈들입죠."
  },
  "196": {
   "jp": "c0b36386",
   "kr": "뭐라고…"
  },
  "197": {
   "jp": "9673c06b",
   "kr": "오해예요."
  },
  "198": {
   "jp": "c7d3fbb8",
   "kr": "우린 말이지 사막의 흑표범 같은 건 몰라."
  },
  "199": {
   "jp": "c57e6a45",
   "kr": "시치미 떼는 점이 또 수상하군."
  },
  "200": {
   "jp": "ca86c3b7",
   "kr": "그건 그렇고"
  },
  "201": {
   "jp": "28f47d33",
   "kr": "투기장에서 싸우게 해 뒀는데,"
  },
  "202": {
   "jp": "66571062",
   "kr": "어째서 이런 데까지…"
  },
  "203": {
   "jp": "c1de5b9e",
   "kr": "그런 건 아무래도 좋다."
  },
  "204": {
   "jp": "ca92d383",
   "kr": "나에게 대드는"
  },
  "205": {
   "jp": "bafff1b8",
   "kr": "얄미운 사막의 흑표범 앞잡이라고!"
  },
  "206": {
   "jp": "4432f579",
   "kr": "절대 용서 못 한다!"
  },
  "207": {
   "jp": "a36d62f9",
   "kr": "병사들아, 당장 붙잡아라!"
  },
  "208": {
   "jp": "b206a3ef",
   "kr": "감시를 붙여서, 헛간에라도 처넣어 둬라!"
  },
  "209": {
   "jp": "08b7f0fb",
   "kr": "아〜아."
  },
  "210": {
   "jp": "52da3277",
   "kr": "거의 다 됐었는데."
  }
 }
