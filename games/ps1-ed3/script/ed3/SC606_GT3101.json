  },
  "170": {
   "jp": "b6dd5526",
   "kr": "쥬리오 군."
  },
  "171": {
   "jp": "cf169ca4",
   "kr": "거기 바지를 집어 주게."
  },
  "172": {
   "jp": "ad3b1fcf",
   "kr": "아, 바지랑 신발이요."
  },
  "173": {
   "jp": "5f018412",
   "kr": "그래, 맞아."
  },
  "174": {
   "jp": "eabebfdd",
   "kr": "참고로"
  },
  "175": {
   "jp": "2f62e522",
   "kr": "어째서 내가 바지와 신발을"
  },
  "176": {
   "jp": "96227555",
   "kr": "통에 붙여 두었는지 알겠나?"
  },
  "177": {
   "jp": "c6077215",
   "kr": "듣고 싶겠지?"
  },
  "178": {
   "jp": "f67d9933",
   "kr": "딱히."
  },
  "179": {
   "jp": "e5dde6f4",
   "kr": "아니, 사실은 듣고 싶을 거야."
  },
  "180": {
   "jp": "4460ee53",
   "kr": "어쩔 수 없지. 알려 주마."
  },
  "181": {
   "jp": "24312de0",
   "kr": "이봐 이봐…"
  },
  "182": {
   "jp": "1c4d7d9e",
   "kr": "통에서 발이 보이면"
  },
  "183": {
   "jp": "72ebbb3a",
   "kr": "병사들은 내가 통 뒤에서 잔다고 여기니까."
  },
  "184": {
   "jp": "81ebbf01",
   "kr": "그동안 터널을 파고 있었다네."
  },
  "185": {
   "jp": "e334ee71",
   "kr": "이름하여"
  },
  "186": {
   "jp": "3d1acc21",
   "kr": "『발이 조금 보이니 있겠거니 작전』"
  },
  "187": {
   "jp": "7ae6b815",
   "kr": "꽤 좋은 작전이지."
  },
  "188": {
   "jp": "14296aed",
   "kr": "그대로잖아요."
  },
  "189": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "190": {
   "jp": "56d29193",
   "kr": "바지랑 신발."
  },
  "191": {
   "jp": "77eee850",
   "kr": "쥬리오는 바지와 신발을 허크에게 건넸다."
  },
  "192": {
   "jp": "704b0998",
   "kr": "아, 미안."
  },
  "193": {
   "jp": "b2543d9d",
   "kr": "지금 바지를 입을 테니"
  },
  "194": {
   "jp": "a4f9f841",
   "kr": "잠깐 기다려 줄래?"
  },
  "195": {
   "jp": "f9d6b19f",
   "kr": "안녕."
  },
  "196": {
   "jp": "1e7f4c10",
   "kr": "쥬리오 군과 크리스."
  },
  "197": {
   "jp": "367a8046",
   "kr": "잘 지낸 것 같군."
  },
  "198": {
   "jp": "7c84d638",
   "kr": "아, 그리고 여행 친구들인가?"
  },
  "199": {
   "jp": "1a34f518",
   "kr": "나는 크리스의 삼촌뻘 되는"
  },
  "200": {
   "jp": "6a5d8495",
   "kr": "허크라는 사람이란다."
  },
  "201": {
   "jp": "912de46e",
   "kr": "앞으로 잘 부탁하네."
  },
  "202": {
   "jp": "0ff6bf3f",
   "kr": "바다트&스텔라"
  },
  "203": {
   "jp": "3adae119",
   "kr": "………"
  },
  "204": {
   "jp": "2b762f39",
   "kr": "이제 됐군."
  },
  "205": {
   "jp": "af43850c",
   "kr": "자, 선 채로 이야기하는 것도 뭣하니"
  },
  "206": {
   "jp": "82ee2f75",
   "kr": "저쪽 테이블로 가자."
  }
 }
