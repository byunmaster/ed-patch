 "lines": {
  "0": {
   "jp": "26fb5f27",
   "kr": "딜트 관문"
  },
  "1": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "2": {
   "jp": "2892c405",
   "kr": "아오프"
  },
  "3": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "4": {
   "jp": "10d35e72",
   "kr": "독방은 차 있으니까"
  },
  "5": {
   "jp": "4631adcd",
   "kr": "너희는 잡거방이다."
  },
  "6": {
   "jp": "cc86ab82",
   "kr": "한방이지만 싸우지 마라."
  },
  "7": {
   "jp": "b4b6897e",
   "kr": "저희 말고"
  },
  "8": {
   "jp": "088d2b23",
   "kr": "아무도 없잖아요."
  },
  "9": {
   "jp": "c9748940",
   "kr": "그게 있단 말이다."
  },
  "10": {
   "jp": "0159b0fb",
   "kr": "별난 감방장님이…"
  },
  "11": {
   "jp": "02f45e39",
   "kr": "늘 저기 통 뒤에서 자고 있다."
  },
  "12": {
   "jp": "2c12f4e5",
   "kr": "어지간히 저 자리가 마음에 드는 모양이야."
  },
  "13": {
   "jp": "882512aa",
   "kr": "뭐, 말만 안 걸면 안전하겠지."
  },
  "14": {
   "jp": "405685f9",
   "kr": "나쁘게 생각 마라."
  },
  "15": {
   "jp": "7271953c",
   "kr": "감방장이 뭐야?"
  },
  "16": {
   "jp": "6751dbcb",
   "kr": "감옥에 오래 있어서"
  },
  "17": {
   "jp": "2d732926",
   "kr": "죄수인데도 병사한테 입김이 센 놈이다."
  },
  "18": {
   "jp": "a5ad5adf",
   "kr": "병사가 한 수 접어 주는 놈이니"
  },
  "19": {
   "jp": "fcb9a5f5",
   "kr": "대개는 엄청난 악당이다."
  },
  "20": {
   "jp": "367c4428",
   "kr": "우리 운이 나쁜 걸까아…"
  },
  "21": {
   "jp": "bb0c2029",
   "kr": "잠깐 보고 올게."
  },
  "22": {
   "jp": "8901996e",
   "kr": "괜찮아?"
  },
  "23": {
   "jp": "f4055a31",
   "kr": "끄떡없어."
  },
  "24": {
   "jp": "f98d10d8",
   "kr": "(진짜다…)"
  },
  "25": {
   "jp": "1907b180",
   "kr": "(통 너머로 발이 보여…)"
  },
  "26": {
   "jp": "f33cf4ba",
   "kr": "남자 코골이"
  },
  "27": {
   "jp": "95eae469",
   "kr": "음냐…"
  },
  "28": {
   "jp": "50afb0fb",
   "kr": "스으… 푸우… 음냐…"
  },
  "29": {
   "jp": "2bf185fd",
   "kr": "(우왓, 자고 있어…)"
  },
  "30": {
   "jp": "27365de0",
   "kr": "어땠어?"
  },
  "31": {
   "jp": "5910a767",
   "kr": "자더라."
  },
  "32": {
   "jp": "84612d80",
   "kr": "어떤 놈이었어?"
  },
  "33": {
   "jp": "83add08c",
   "kr": "발밖에 안 보였어."
  },
  "34": {
   "jp": "87634187",
   "kr": "그래."
  },
  "35": {
   "jp": "723ccdd6",
   "kr": "감옥 안에서 태연히 자다니"
  },
  "36": {
   "jp": "fe2142fe",
   "kr": "대단한 배짱이다."
  },
  "37": {
   "jp": "4acc8a44",
   "kr": "이건 가까이 안 가는 게 낫겠군."
  },
  "38": {
   "jp": "f653aa9a",
   "kr": "그런가 봐요."
  },
  "39": {
   "jp": "a4231f37",
   "kr": "이쪽에 있으면서"
  },
  "40": {
   "jp": "4a320f5f",
   "kr": "되도록 말 안 걸리게 하자."
  },
  "41": {
   "jp": "3ff0d7c0",
   "kr": "그게 좋겠군."
  },
  "42": {
   "jp": "0fa41e34",
   "kr": "그래서 이제 어쩔 건데?"
  },
  "43": {
   "jp": "df71e016",
   "kr": "어떡할까."
  },
  "44": {
   "jp": "543e250f",
   "kr": "어쨌든 여기서 빠져나가야 해."
  },
  "45": {
   "jp": "6e979630",
   "kr": "여기서 나가도 다리가 안 놓여 있으면"
  },
  "46": {
   "jp": "646c6d41",
   "kr": "금방 잡혀 버려요."
  },
  "47": {
   "jp": "b710550c",
   "kr": "다리는 늘 정해진 시간에 놓이는 거지?"
  },
  "48": {
   "jp": "c4a67378",
   "kr": "그래, 병사가 그런 말을 했었지."
  },
  "49": {
   "jp": "ae8e3733",
   "kr": "다리가 놓이는 건 언제일까?"
  },
  "50": {
   "jp": "4bf4505a",
   "kr": "그 시간만 알면"
  },
  "51": {
   "jp": "05ed04df",
   "kr": "타이밍을 봐서"
  },
  "52": {
   "jp": "d50dfa22",
   "kr": "제 폭탄으로 강행 돌파도 할 수 있는데…"
  },
  "53": {
   "jp": "1a0950ab",
   "kr": "아니, 그건 그만두는 게 좋다."
  },
  "54": {
   "jp": "c2dc2188",
   "kr": "다리 건너가 어찌 돼 있는지"
  },
  "55": {
   "jp": "f18a1291",
   "kr": "모르니까 말이다."
  },
  "56": {
   "jp": "a86d63ce",
   "kr": "저쪽에 병사가 수백이면 어쩔 거냐."
  },
  "57": {
   "jp": "1701ae82",
   "kr": "너무 요란하게 벌이면"
  },
  "58": {
   "jp": "48e3b4ac",
   "kr": "무사히 다리를 건너도 저쪽에서 잡힌다고."
  },
  "59": {
   "jp": "1bf40f6e",
   "kr": "그런가… 그러네."
  },
  "60": {
   "jp": "60678285",
   "kr": "어떻게 하든"
  },
  "61": {
   "jp": "1e080bd4",
   "kr": "다리 놓이는 시간이 아니면 안 돼."
  },
  "62": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "63": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "64": {
   "jp": "c6f18775",
   "kr": "창문으로 다리가 보이지 않을까?"
  },
  "65": {
   "jp": "1f93ac08",
   "kr": "아마 국경의 다리가 올라가 있으면"
  },
  "66": {
   "jp": "496d64f9",
   "kr": "창문으로 보일 거야."
  },
  "67": {
   "jp": "1d8b6e53",
   "kr": "보고 올까."
  },
  "68": {
   "jp": "2ae39b3b",
   "kr": "근데, 감방장 옆이야."
  },
  "69": {
   "jp": "072f15f6",
   "kr": "괜찮다. 자고 있으니까."
  },
  "70": {
   "jp": "0d127854",
   "kr": "살금살금 가면 괜찮다니까."
  },
  "71": {
   "jp": "555f9482",
   "kr": "가라, 가라."
  },
  "72": {
   "jp": "41250e05",
   "kr": "남 일이라고…"
  },
  "73": {
   "jp": "4f3c5e27",
   "kr": "이런 건"
  },
  "74": {
   "jp": "e616d8fe",
   "kr": "말 꺼낸 놈이 가는 거다."
  },
  "75": {
   "jp": "2766b624",
   "kr": "알았어."
  },
  "76": {
   "jp": "f33cf4ba",
   "kr": "남자 코골이"
  },
  "77": {
   "jp": "8a43b2e3",
   "kr": "음냐냐…"
  },
  "78": {
   "jp": "ee7da65e",
   "kr": "(철렁…?)"
  },
  "79": {
   "jp": "f33cf4ba",
   "kr": "남자 코골이"
  },
  "80": {
   "jp": "b7c86cdb",
   "kr": "하아아…"
  },
  "81": {
   "jp": "d34ecd71",
   "kr": "(깼나…)"
  },
  "82": {
   "jp": "0609f9a7",
   "kr": "깬 것 같아."
  },
  "83": {
   "jp": "2b2eee5d",
   "kr": "일일이 안 돌아와도 된다."
  },
  "84": {
   "jp": "faf407c6",
   "kr": "남자 목소리"
  },
  "85": {
   "jp": "5b316e9d",
   "kr": "으아아아아…"
  },
  "86": {
   "jp": "faf407c6",
   "kr": "남자 목소리"
  },
  "87": {
   "jp": "8566295e",
   "kr": "잘 잤군."
  },
  "88": {
   "jp": "50e04679",
   "kr": "쾌면, 쾌면."
  },
  "89": {
   "jp": "d373d134",
   "kr": "(기분은 좋아 보여.)"
  },
  "90": {
   "jp": "dab1b601",
   "kr": "(아직 몰라.)"
  },
  "91": {
   "jp": "faf407c6",
   "kr": "남자 목소리"
  },
  "92": {
   "jp": "9ff8092f",
   "kr": "하아아아…"
  },
  "93": {
   "jp": "96edfbb4",
   "kr": "움직인다!"
  },
  "94": {
   "jp": "60123abe",
   "kr": "쉿."
  },
  "95": {
   "jp": "04464f17",
   "kr": "남자의 기척"
  },
  "96": {
   "jp": "1bf6b972",
   "kr": "부스럭… 꼼지락…"
  },
  "97": {
   "jp": "81369c66",
   "kr": "(뭔가 부스럭대고 있어.)"
  },
  "98": {
   "jp": "4f4ef96b",
   "kr": "(모르는 척하고 있자고.)"
  },
  "99": {
   "jp": "70354164",
   "kr": "……"
  },
  "100": {
   "jp": "14401af3",
   "kr": "조용해졌네."
  },
  "101": {
   "jp": "83f72959",
   "kr": "또 잠들어 버렸나 봐요."
  },
  "102": {
   "jp": "e6e38745",
   "kr": "진짜. 발이 보여."
  },
  "103": {
   "jp": "62eeecff",
   "kr": "이봐 이봐."
  },
  "104": {
   "jp": "4668d697",
   "kr": "그리 경계 안 해도 괜찮다."
  },
  "105": {
   "jp": "1065a69e",
   "kr": "아무리 그래도"
  },
  "106": {
   "jp": "d442401a",
   "kr": "대뜸 덮치거나 하진 않는다."
  },
  "107": {
   "jp": "9cd279f3",
   "kr": "좀 별나긴 하지만 말이다."
  },
  "108": {
   "jp": "3de5ce20",
   "kr": "좀 별나다고?"
  },
  "109": {
   "jp": "31fe6149",
   "kr": "그런 게 제일 위험한 거야."
  },
  "110": {
   "jp": "587ca49d",
   "kr": "맞아."
  },
  "111": {
   "jp": "8faf9757",
   "kr": "근데, 쥬리오."
  },
  "112": {
   "jp": "85ccf4ec",
   "kr": "통이 있고"
  },
  "113": {
   "jp": "4ea2ba9a",
   "kr": "별난 사람이라면…"
  },
  "114": {
   "jp": "3ed5ff56",
   "kr": "역시"
  },
  "115": {
   "jp": "7625744b",
   "kr": "허크 아저씨가 떠오르네."
  },
  "116": {
   "jp": "5dd99dbf",
   "kr": "누구냐, 허크 아저씨라니?"
  },
  "117": {
   "jp": "8e78d7c4",
   "kr": "크리스네 삼촌이야."
  },
  "118": {
   "jp": "4de26258",
   "kr": "전에 만났을 때"
  },
  "119": {
   "jp": "9b3c71ce",
   "kr": "대뜸 통 뒤에서 튀어나왔어."
  },
  "120": {
   "jp": "12517e2e",
   "kr": "엄청 별나다니까."
  },
  "121": {
   "jp": "83eec802",
   "kr": "엄청은 좀 심하다."
  },
  "122": {
   "jp": "166b0fc2",
   "kr": "그런가아…"
  },
  "123": {
   "jp": "dc1bf9e6",
   "kr": "흐응."
  },
  "124": {
   "jp": "b4750b91",
   "kr": "별난 친척이 있군."
  },
  "125": {
   "jp": "23cc63fc",
   "kr": "뭐, 그건 됐고."
  },
  "126": {
   "jp": "d88a03d5",
   "kr": "어쨌든 쥬리오."
  },
  "127": {
   "jp": "e55d7e6e",
   "kr": "한 번 더 보고 와라."
  },
  "128": {
   "jp": "d1a94c2d",
   "kr": "이번엔 얼굴도 확실히 말이다."
  },
  "129": {
   "jp": "d6c254e3",
   "kr": "엣, 또 내가…"
  },
  "130": {
   "jp": "8ef68d67",
   "kr": "이대로는"
  },
  "131": {
   "jp": "8f6ee77f",
   "kr": "왠지 불안해서 진정이 안 된다."
  },
  "132": {
   "jp": "7be4eec6",
   "kr": "우리 탈주 작전도 시작 못 한다고."
  },
  "133": {
   "jp": "44d0f2ff",
   "kr": "그야 그렇지만…"
  },
  "134": {
   "jp": "64f11ec9",
   "kr": "괜찮아."
  },
  "135": {
   "jp": "6b240fe9",
   "kr": "쥬리오한테 무슨 일이 생기면"
  },
  "136": {
   "jp": "fe6a1336",
   "kr": "우리 셋이서 어떻게든 할 테니까."
  },
  "137": {
   "jp": "8a9a01e1",
   "kr": "나한테 무슨 일이라니?"
  },
  "138": {
   "jp": "9b87a30a",
   "kr": "괜찮아, 괜찮아."
  },
  "139": {
   "jp": "c02c9975",
   "kr": "정말…"
  },
  "140": {
   "jp": "6b13f9bd",
   "kr": "무슨 일이야?"
  },
  "141": {
   "jp": "6fb197dc",
   "kr": "안 보여."
  },
  "142": {
   "jp": "44270839",
   "kr": "그치만, 발이 저기 보이잖아?"
  },
  "143": {
   "jp": "d53cb74e",
   "kr": "근데… 없어."
  },
  "144": {
   "jp": "c1282e67",
   "kr": "어, 무슨 소리야?"
  },
  "145": {
   "jp": "5529ab51",
   "kr": "어디어디."
  },
  "146": {
   "jp": "3d50fcfb",
   "kr": "…어라."
  },
  "147": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "148": {
   "jp": "efd3f931",
   "kr": "……?!"
  },
  "149": {
   "jp": "7813ef7b",
   "kr": "바로 그거다."
  },
  "150": {
   "jp": "915cdb22",
   "kr": "이것이야말로."
  },
  "151": {
   "jp": "15164e10",
   "kr": "피할 수 없는 운명의 장난."
  },
  "152": {
   "jp": "dba31501",
   "kr": "허, 허…"
  },
  "153": {
   "jp": "f39b7838",
   "kr": "허크 삼촌."
  },
  "154": {
   "jp": "f9d6b19f",
   "kr": "안녕."
  },
  "155": {
   "jp": "03cec9c6",
   "kr": "삼촌, 어째서 여기에?"
  },
  "156": {
   "jp": "90f00ac8",
   "kr": "여어, 라니요."
  },
  "157": {
   "jp": "62eeecff",
   "kr": "이봐 이봐."
  },
  "158": {
   "jp": "150a7a49",
   "kr": "정말 크리스네 삼촌이냐?"
  },
  "159": {
   "jp": "8c8fea34",
   "kr": "아무래도 그런가 봐요."
  },
  "160": {
   "jp": "0dfa61bf",
   "kr": "어째서"
  },
  "161": {
   "jp": "f38218d3",
   "kr": "삼촌이 여기 잡혀 있는 거야?"
