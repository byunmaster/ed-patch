  "165": {
   "jp": "7b7363be",
   "kr": "진정하게, 진정."
  },
  "166": {
   "jp": "7b7393f4",
   "kr": "이것저것 묻고 싶겠지만"
  },
  "167": {
   "jp": "7d7a596b",
