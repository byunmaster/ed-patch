  "162": {
   "jp": "c2685d40",
   "kr": "아저씨"
  },
  "163": {
   "jp": "4b644619",
   "kr": "뭔가 나쁜 짓 했어요?"
  },
  "164": {
   "jp": "34d765fd",
   "kr": "자, 잠깐 기다리게."
