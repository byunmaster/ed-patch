{
 "archive": "/SCE0/SC005.DAT",
 "member": "..\\DATA\\FT3005.BIN",
 "lines": {
  "0": {
   "jp": "c9fab11d",
   "kr": "매발톱호"
  },
  "1": {
   "jp": "0f879f86",
   "kr": "보스레이"
  },
  "2": {
   "jp": "87ed524e",
   "kr": "가톤"
  },
  "3": {
   "jp": "c1b14629",
   "kr": "브루트"
  },
  "4": {
   "jp": "73e57527",
   "kr": "질버 선장"
  },
  "5": {
   "jp": "898074d7",
   "kr": "조리장"
  },
  "6": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "7": {
   "jp": "de0b91f4",
   "kr": "음, 얘기는 알겠다."
  },
  "8": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "9": {
   "jp": "e49cdd7f",
   "kr": "크리스 양의 삼촌이라니."
  },
  "10": {
   "jp": "bc0b1de8",
   "kr": "죄송해요, 질버 선장님."
  },
  "11": {
   "jp": "d370ba8a",
   "kr": "아무래도 시간적 여유가 없던 데다"
  },
  "12": {
   "jp": "74408a4e",
   "kr": "경제 사정도 빠듯했던 터라…"
  },
  "13": {
   "jp": "43778c87",
   "kr": "허나, 이것도 하얀마녀의…"
  },
  "14": {
   "jp": "b0b9ae40",
   "kr": "삼촌!"
  },
  "15": {
   "jp": "7443009c",
   "kr": "…죄송합니다."
  },
  "16": {
   "jp": "c60b7289",
   "kr": "뭐, 죄는 밀항뿐인 듯하고"
  },
  "17": {
   "jp": "ce6156bc",
   "kr": "신원도 알고 있으니"
  },
  "18": {
   "jp": "27ffa000",
   "kr": "크게 소란 피울 것도 없겠지."
  },
  "19": {
   "jp": "d314cd86",
   "kr": "그래도, 죄가 되는 거죠?"
  },
  "20": {
   "jp": "758905bb",
   "kr": "그렇지."
  },
  "21": {
   "jp": "5b35469e",
   "kr": "밀항자의 처분은 선장 소관이다."
  },
  "22": {
   "jp": "11f5fcae",
   "kr": "따라서 목적지인 닐리 항에 닿을 때까지"
  },
  "23": {
   "jp": "a715936c",
   "kr": "방 밖으로 나가는 건 금지하겠다."
  },
  "24": {
   "jp": "d609096a",
   "kr": "닐리에 도착할 때까지 문제가 없으면"
  },
  "25": {
   "jp": "11a59335",
   "kr": "죄는 묻지 않아도 되겠지."
  },
  "26": {
   "jp": "f9bbd455",
   "kr": "고마워요, 질버 선장님."
  },
  "27": {
   "jp": "707f2d50",
   "kr": "괜찮으시겠지요?"
  },
  "28": {
   "jp": "cf012eb7",
   "kr": "허크 씨."
  },
  "29": {
   "jp": "abf4d002",
   "kr": "어쩔 수 없지요."
  },
  "30": {
   "jp": "b0b9ae40",
   "kr": "삼촌!"
  },
  "31": {
   "jp": "0fc80320",
   "kr": "…관대한 처분, 감사합니다."
  },
  "32": {
   "jp": "b2561337",
   "kr": "보스레이."
  },
  "33": {
   "jp": "a32146c1",
   "kr": "허크 씨를 6번 선실로 안내해라."
  },
  "34": {
   "jp": "3c24fcba",
   "kr": "그 뒤엔 선창 작업으로 돌아가고."
  },
  "35": {
   "jp": "2f3c544c",
   "kr": "열쇠는 네가 갖고 있도록."
  },
  "36": {
   "jp": "7966a4db",
   "kr": "예스 서!"
  },
  "37": {
   "jp": "3ff71a68",
   "kr": "자자, 크리스의 삼촌."
  },
  "38": {
   "jp": "b48f0bdb",
   "kr": "구경이나 할 처지가 아니라고."
  },
  "39": {
   "jp": "c1316f26",
   "kr": "질버 선장님, 정말 고마워요."
  },
  "40": {
   "jp": "88239568",
   "kr": "감사해요."
  },
  "41": {
   "jp": "2524045e",
   "kr": "아니, 고마워할 것 없다."
  },
  "42": {
   "jp": "5419824d",
   "kr": "너희 식구 중에 나쁜 놈은 있을 리 없지."
  },
  "43": {
   "jp": "673df02e",
   "kr": "둘을 보고 있으면 잘 안다."
  },
  "44": {
   "jp": "8a90a7a8",
   "kr": "그보다 쥬리오 군."
  },
  "45": {
   "jp": "f7864bac",
   "kr": "로저 씨 건은 어떻게 됐나?"
  },
  "46": {
   "jp": "55470ac4",
   "kr": "뭔가 알아냈나?"
  },
  "47": {
   "jp": "1c0981cf",
   "kr": "네, 그 일 말인데요."
  },
  "48": {
   "jp": "087389f9",
   "kr": "물건이 없어진 건 로저 씨"
  },
  "49": {
   "jp": "8b8eef54",
   "kr": "만이 아니었어요."
  },
  "50": {
   "jp": "3e85aaea",
   "kr": "헤스톤 씨도 금 브로치를"
  },
  "51": {
   "jp": "831510b7",
   "kr": "잃어버렸대요."
  },
  "52": {
   "jp": "83e38c8e",
   "kr": "헤스톤 씨까지?"
  },
  "53": {
   "jp": "8969f674",
   "kr": "생각하고 싶진 않지만…"
  },
  "54": {
   "jp": "b35e744c",
   "kr": "항로를 터는 길손 도둑이"
  },
  "55": {
   "jp": "3a9b695a",
   "kr": "이 배에 숨어들어 있는지도 모른다."
  },
  "56": {
   "jp": "2fcd74b4",
   "kr": "길손 도둑이 뭐예요?"
  },
  "57": {
   "jp": "65a446f5",
   "kr": "아아, 여행자인 척하고"
  },
  "58": {
   "jp": "6b7d7fc4",
   "kr": "금품을 훔치는 도둑이다."
  },
  "59": {
   "jp": "e3424497",
   "kr": "흐〜음."
  },
  "60": {
   "jp": "e791e3a8",
   "kr": "분명 폴티아와 메나트 왕도에서"
  },
  "61": {
   "jp": "be2b90c7",
   "kr": "보내온 수배서가 있었지."
  },
  "62": {
   "jp": "972da254",
   "kr": "쥬리오 군."
  },
  "63": {
   "jp": "51c1a8e9",
   "kr": "거기 책장에 있을 게다."
  },
  "64": {
   "jp": "7a01f295",
   "kr": "좀 읽어 주지 않겠나?"
  },
  "65": {
   "jp": "d850ce56",
   "kr": "수배서가 2통 있습니다."
  },
  "66": {
   "jp": "bc92270e",
   "kr": "어느 걸 볼까요?"
  },
  "67": {
   "jp": "4fe14c4f",
   "kr": "루드에서 온 수배서"
  },
  "68": {
   "jp": "fd4c299b",
   "kr": "넬바에서 온 수배서"
  },
  "69": {
   "jp": "e91a647f",
   "kr": "《젊은 남녀 2인조 절도범》"
  },
  "70": {
   "jp": "6eaf496e",
   "kr": "절도범 86호(남) 87호(여)"
  },
  "71": {
   "jp": "04f87ccc",
   "kr": "성명은 모두 불명이나 늘 둘이서 움직인다."
  },
  "72": {
   "jp": "98588d9f",
   "kr": "미남미녀 콤비."
  },
  "73": {
   "jp": "761838c2",
   "kr": "여자는 변장 남자는 빈집털이에 능하다."
  },
  "74": {
   "jp": "eaa370af",
   "kr": "입이 화근이라 미수가 많다."
  },
  "75": {
   "jp": "0df32486",
   "kr": "이어서 넬바 수배서도"
  },
  "76": {
   "jp": "24736af8",
   "kr": "읽어 다오."
  },
  "77": {
   "jp": "122fbfb9",
   "kr": "《절도범 A-14호(남)》"
  },
  "78": {
   "jp": "505ddbaa",
   "kr": "중년 신사로 변장해 절도를 거듭하고 있다."
  },
  "79": {
   "jp": "c3297330",
   "kr": "행동은 기본적으로 혼자 하지만"
  },
  "80": {
   "jp": "407a4ca0",
   "kr": "배후에는 조직이 관련된 듯하다."
  },
  "81": {
   "jp": "a7a99503",
   "kr": "계획 범죄에 능하고, 조심성 많다."
  },
  "82": {
   "jp": "a5a18059",
   "kr": "수면제를 쓴 범행이 보고되어 있다."
  },
  "83": {
   "jp": "49d39baf",
   "kr": "루드에서 온 수배서도"
  },
  "84": {
   "jp": "55541651",
   "kr": "읽어 주지 않겠나?"
  },
  "85": {
   "jp": "90021316",
   "kr": "으〜음…"
  },
  "86": {
   "jp": "016f8fb9",
   "kr": "루드에서 온 수배서에 있는"
  },
  "87": {
   "jp": "1db03539",
   "kr": "남녀 2인조라는 게 걸리는군."
  },
  "88": {
   "jp": "1c2ff5f1",
   "kr": "그쵸? 역시 그렇게 생각하시죠?"
  },
  "89": {
   "jp": "c833b977",
   "kr": "한 칸 더 옆 책장이다."
  },
  "90": {
   "jp": "f17dadd8",
   "kr": "쥬리오 군, 크리스 양."
  },
  "91": {
   "jp": "e3bcdd85",
   "kr": "이야기 도중이다."
  },
  "92": {
   "jp": "a0ed6390",
   "kr": "여기네."
  },
  "93": {
   "jp": "1d92fddd",
   "kr": "어라, 멀미약은 비었어."
  },
  "94": {
   "jp": "edffbf31",
   "kr": "정말."
  },
  "95": {
   "jp": "665d506f",
   "kr": "하나도 없잖아."
  },
  "96": {
   "jp": "0891fc2e",
   "kr": "질버 선장님도 못 알아채셨구나."
  },
  "97": {
   "jp": "977d09a2",
   "kr": "분명 뱃멀미하는 손님이 많은 걸 거야."
  },
  "98": {
   "jp": "edac2461",
   "kr": "일단 선장님한테 돌아가자."
  },
  "99": {
   "jp": "83d36bac",
   "kr": "실은 전부터 저 2인조가"
  },
  "100": {
   "jp": "a3441df5",
   "kr": "마음에 걸리긴 했다."
  },
  "101": {
   "jp": "782c616f",
   "kr": "뭐니 뭐니 해도"
  },
  "102": {
   "jp": "ca6ed9bf",
   "kr": "배가 뜬 뒤로 한 번도 모습을 안 보이는 건"
  },
  "103": {
   "jp": "f3f6b4c3",
   "kr": "납득이 안 간다."
  },
  "104": {
   "jp": "e3902966",
   "kr": "그렇죠."
  },
  "105": {
   "jp": "bbfb6b1d",
   "kr": "분명 수상해요."
  },
  "106": {
   "jp": "38851f64",
   "kr": "그치만, 너무 사람을 의심하면"
  },
  "107": {
   "jp": "86012a60",
   "kr": "안 될 것 같은데…"
  },
  "108": {
   "jp": "0c1eb833",
   "kr": "그런 소리 할 때가 아니잖아!"
  },
  "109": {
   "jp": "a2a80172",
   "kr": "벌써 도둑맞은 사람이 있는걸."
  },
  "110": {
   "jp": "6aca18e3",
   "kr": "닐리에 닿으면 도망쳐 버린다고."
  },
  "111": {
   "jp": "23216b42",
   "kr": "그전에 어떻게든 해야지!"
  },
  "112": {
   "jp": "af988a23",
   "kr": "좋아, 아무튼 얼굴만이라도"
  },
  "113": {
   "jp": "22ba1deb",
   "kr": "보여 달라고 하자."
  },
  "114": {
   "jp": "738042fe",
   "kr": "내겐 승객의 재산을 지킬 의무가 있다."
  },
  "115": {
   "jp": "902f56d0",
   "kr": "어쩔 수 없지."
  },
  "116": {
   "jp": "f17dadd8",
   "kr": "쥬리오 군, 크리스 양."
  },
  "117": {
   "jp": "69fd4b3d",
   "kr": "같이 와 다오."
  },
  "118": {
   "jp": "0e49b077",
   "kr": "만일을 위해 브루트도 데려가자."
  },
  "119": {
   "jp": "c9144d30",
   "kr": "《항해일지 1일째》"
  },
  "120": {
   "jp": "194ad047",
   "kr": "드디어 올해 항해도 이것으로 끝이다."
  },
  "121": {
   "jp": "f7aadf94",
   "kr": "유빙의 계절이 다가오고 있다."
  },
  "122": {
   "jp": "ffbaf2a4",
   "kr": "닐리에서 돌아 라그나로 가면 겨울 휴가다."
  },
  "123": {
   "jp": "4d59ffce",
   "kr": "올해 마지막 항해에 어울리는 손님이 탔다."
  },
  "124": {
   "jp": "0fb6f98d",
   "kr": "순례 여행자 쥬리오 군과 크리스 양이다."
  },
  "125": {
   "jp": "aa865a89",
   "kr": "이번 항해도 멋지게 해내겠다."
  },
  "126": {
   "jp": "8ade2c1b",
   "kr": "《항해일지 2일째》"
  },
  "127": {
   "jp": "8ac56f6f",
   "kr": "오늘도 날씨는 나무랄 데 없다."
  },
  "128": {
   "jp": "345ccaff",
   "kr": "순례 여행자 쥬리오 군도 크리스 양도,"
  },
  "129": {
   "jp": "cdc67e16",
   "kr": "일 잘하는 착한 아이들이다."
  },
  "130": {
   "jp": "796d4169",
   "kr": "이 속도라면 예정대로 사흘째"
  },
  "131": {
   "jp": "16fb50d9",
   "kr": "새벽엔 닐리에 닿겠지."
  },
  "132": {
   "jp": "e90836db",
   "kr": "순례 여행자에게 축복 있으라!"
  },
  "133": {
   "jp": "966f030c",
   "kr": "그건 그렇고, 이등 선실의 두 사람은"
  },
  "134": {
   "jp": "c9d2172f",
   "kr": "한 번도 선실에서 모습을 보이지 않는다."
  },
  "135": {
   "jp": "8dab2755",
   "kr": "부끄럼쟁이인 걸까…"
  },
  "136": {
   "jp": "b7d928b5",
   "kr": "쥬리오는 티라스일 항해도를 봤습니다."
  },
  "137": {
   "jp": "168847ec",
   "kr": "티라스일 지방은"
  },
  "138": {
   "jp": "359c914c",
   "kr": "넓구나…"
  },
  "139": {
   "jp": "bf9995f8",
   "kr": "촌장님 말씀대로 정말 석 달쯤"
  },
  "140": {
   "jp": "281cad98",
   "kr": "걸릴지도 모르겠네."
  },
  "141": {
   "jp": "cdffa67e",
   "kr": "범죄자는 일을 한 곳과는"
  },
  "142": {
   "jp": "e93c53c7",
   "kr": "다른 나라로 도망치려 한다."
  },
  "143": {
   "jp": "3cc8bf65",
   "kr": "관문이나 나라 사이를 항행하는 배에는"
  },
  "144": {
   "jp": "1dff3a6b",
   "kr": "수배서가 배포되지."
  },
  "145": {
   "jp": "cc5a8b7a",
   "kr": "수배서에 뭔가 단서가 있을지도 모른다."
  },
  "146": {
   "jp": "baf2adc5",
   "kr": "크리스 아가씨."
  },
  "147": {
   "jp": "bd3ccd70",
   "kr": "아직 손을 못 떼겠니?"
  },
  "148": {
   "jp": "281202ec",
   "kr": "네, 죄송해요."
  },
  "149": {
   "jp": "332e62a8",
   "kr": "질버 선장님 부탁으로 멀미약을"
  },
  "150": {
   "jp": "08d5e096",
   "kr": "찾으러 왔거든요."
  },
  "151": {
   "jp": "c24536dc",
   "kr": "그래, 고생이구나."
  },
  "152": {
   "jp": "2cbe48e8",
   "kr": "크리스 아가씨 몫까지 힘내 볼까."
  },
  "153": {
   "jp": "cfed0a53",
   "kr": "뱃사람들을 감탄시킬 요리를"
  },
  "154": {
   "jp": "4ae53cbf",
   "kr": "만들어 주마."
  },
  "155": {
   "jp": "2e3f1bae",
   "kr": "멀미약이 없다고?"
  },
  "156": {
   "jp": "c3db9e3f",
   "kr": "그러고 보니, 지난 항해에서"
  },
  "157": {
   "jp": "17e74696",
   "kr": "배에 약한 부인이 계셨지."
  },
  "158": {
   "jp": "e7935482",
