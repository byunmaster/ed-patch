  },
  "34": {
   "jp": "b5be71f4",
   "kr": "그렇지, 그거야."
  },
  "35": {
   "jp": "0c18c453",
   "kr": "하디로군."
  },
  "36": {
   "jp": "ef54c476",
   "kr": "로디예요."
  },
  "37": {
   "jp": "2298a8ed",
   "kr": "오오, 그래 그래, 로디로군."
  },
  "38": {
   "jp": "a1c75b29",
   "kr": "듣자니 임금님은 그 란디에게"
  },
  "39": {
   "jp": "b03b047a",
   "kr": "특별수훈상을 줄 생각이라더군."
  },
  "40": {
   "jp": "13968d82",
   "kr": "로디예요."
  },
  "41": {
   "jp": "93df71f8",
   "kr": "오오, 그랬지."
  },
  "42": {
   "jp": "4ead110c",
   "kr": "로디였구먼"
  },
  "43": {
   "jp": "64b38cf0",
   "kr": "이번엔 확실히 외웠네."
  },
  "44": {
   "jp": "9b8a4d9c",
   "kr": "굉장하다, 로디."
  },
  "45": {
   "jp": "c4f4f8ad",
   "kr": "하긴 그만큼 애썼으니 당연하지."
  },
  "46": {
   "jp": "b652fee8",
   "kr": "이보게, 일행에게 뭐라 했더라"
  },
  "47": {
   "jp": "19c8fe7a",
   "kr": "신디였던가?"
  },
  "48": {
   "jp": "ef54c476",
   "kr": "로디예요."
  },
  "49": {
   "jp": "b4103b33",
   "kr": "그래 그래, 그 로디에게"
  },
  "50": {
   "jp": "2b61dc88",
   "kr": "이 약을 가져다주게."
  },
  "51": {
   "jp": "ba0ec32c",
   "kr": "좀 쓰지만 효과는 발군!"
  },
  "52": {
   "jp": "ff851cd8",
   "kr": "건강해지는 건 틀림없다네."
  },
  "53": {
   "jp": "14552430",
   "kr": "더는 못 들겠어."
  },
  "54": {
   "jp": "c95ef071",
   "kr": "뭔가 버리자."
