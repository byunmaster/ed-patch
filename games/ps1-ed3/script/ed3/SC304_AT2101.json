  "61": {
   "jp": "ed40ffdd",
   "kr": "고마워요. 푹 잘 잤어요."
  },
  "62": {
   "jp": "660f769b",
   "kr": "성은 너무 조용해요."
  },
  "63": {
   "jp": "cf2860c8",
   "kr": "그러냐, 그거 잘됐구나."
