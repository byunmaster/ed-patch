  },
  "4": {
   "jp": "11cd763b",
   "kr": "죠르노"
  },
  "5": {
   "jp": "ee6a6df7",
   "kr": "좋은 아침, 쥬리오."
  },
  "6": {
   "jp": "194200d4",
   "kr": "좋은 아침…"
  },
  "7": {
   "jp": "06fbe568",
   "kr": "아직 졸린가 봐."
  },
  "8": {
   "jp": "73af6234",
   "kr": "그래도 푹 잘 잤어."
  },
  "9": {
   "jp": "d83550f5",
   "kr": "성에서 자는 것보다 마음이 편해."
  },
  "10": {
   "jp": "4551f3d7",
   "kr": "오늘은 요리 콘테스트야."
  },
  "11": {
   "jp": "72b7efa8",
   "kr": "슬슬 성 사람이"
  },
  "12": {
   "jp": "3d86fd13",
   "kr": "부르러 오지 않을까."
  },
  "13": {
   "jp": "87bc5cd3",
   "kr": "헤헤"
  },
  "14": {
   "jp": "637b42aa",
   "kr": "맛있는 거 잔뜩 먹을 수 있겠네."
  },
  "15": {
   "jp": "e0db4dbe",
   "kr": "안녕하십니까."
  },
  "16": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "17": {
   "jp": "34b4ba19",
   "kr": "안녕하세요〜"
  },
  "18": {
   "jp": "00e151ad",
   "kr": "모시러 왔습니다."
  },
  "19": {
   "jp": "ee74e700",
   "kr": "아직 요리 콘테스트까지는"
  },
  "20": {
   "jp": "536ef45c",
   "kr": "시간이 있습니다만 여유를 두고"
  },
  "21": {
   "jp": "dba24878",
   "kr": "일찍 들렀습니다."
  },
  "22": {
   "jp": "ccd6d4ae",
   "kr": "네, 정중하게 대해 주셔서"
  },
  "23": {
   "jp": "29162a7b",
   "kr": "감사합니다."
  },
  "24": {
   "jp": "2c54da60",
   "kr": "자자, 어서."
  },
  "25": {
   "jp": "592fec00",
   "kr": "가시지요."
  },
  "26": {
   "jp": "c1892018",
   "kr": "얼른 나으면 좋으련만."
  },
  "27": {
   "jp": "0f4432cb",
   "kr": "오오, 잘 잤는가?"
  },
  "28": {
   "jp": "c196d579",
   "kr": "오오, 거기 둘 잠깐 기다려 보게."
  },
  "29": {
   "jp": "52438663",
   "kr": "볼트 싸움에서 다친 여행 검사가"
  },
  "30": {
   "jp": "d4d9b7c5",
   "kr": "성에서 요양하고 있다더구먼."
  },
  "31": {
   "jp": "1e9d13ce",
   "kr": "이름은… 분명…"
  },
  "32": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "33": {
   "jp": "12a25481",
