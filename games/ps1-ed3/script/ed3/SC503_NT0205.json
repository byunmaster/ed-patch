{
 "archive": "/SCE5/SC503.DAT",
 "member": "..\\DATA\\NT0205.BIN",
 "lines": {
  "0": {
   "jp": "3fb24ff7",
   "kr": "하이젠성"
  },
  "1": {
   "jp": "24b7384e",
   "kr": "2층"
  },
  "2": {
   "jp": "5b5733b0",
   "kr": "하이젠 병사"
  },
  "3": {
   "jp": "5ed9a709",
   "kr": "에네톤 왕"
  },
  "4": {
   "jp": "9d57f8ab",
   "kr": "피리아 왕비"
  },
  "5": {
   "jp": "964500f4",
   "kr": "카리스 노인"
  },
  "6": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "7": {
   "jp": "6436bed6",
   "kr": "이런, 너희구나."
  },
  "8": {
   "jp": "ca07fe44",
   "kr": "임금님, 안녕하세요."
  },
  "9": {
   "jp": "a3208212",
   "kr": "오, 휘리로구나."
  },
  "10": {
   "jp": "627cb3e8",
   "kr": "오늘은 친구들과 함께구나."
  },
  "11": {
   "jp": "b2e75706",
   "kr": "임금님, 기운이 없으시네요."
  },
  "12": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "13": {
   "jp": "1562470f",
   "kr": "실은 그렇단다."
  },
  "14": {
   "jp": "96061717",
   "kr": "남퓨엔테의"
  },
  "15": {
   "jp": "5e26dec7",
   "kr": "캐라크 왕 일을 걱정하시는 거죠?"
  },
  "16": {
   "jp": "225a2b59",
   "kr": "엇, 어떻게 알았지?"
  },
  "17": {
   "jp": "9ded6647",
   "kr": "저희, 홀크에 다녀왔어요."
  },
  "18": {
   "jp": "1315776e",
   "kr": "자, 친서예요."
  },
  "19": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는"
  },
  "20": {
   "jp": "b5485709",
   "kr": "을(를) 건넸다."
  },
  "21": {
   "jp": "969bc673",
   "kr": "에네톤 왕은 곧바로 친서를 펼치고,"
  },
  "22": {
   "jp": "bfd46421",
   "kr": "여러 번 깊이 고개를 끄덕이며"
  },
  "23": {
   "jp": "3f39bb32",
   "kr": "캐라크 왕의 전언을 훑어보았다."
  },
  "24": {
   "jp": "9b4c1dd1",
   "kr": "과연, 그랬던 것인가…"
  },
  "25": {
   "jp": "adde1402",
   "kr": "요즘 캐라크와의 연락도 끊기고"
  },
  "26": {
   "jp": "e43aae48",
   "kr": "남북 가도뿐 아니라, 홀크로 이어지는 가도가"
  },
  "27": {
   "jp": "6a415965",
   "kr": "모두 봉쇄됐다 듣고 걱정하고 있었다."
  },
  "28": {
   "jp": "b4973b55",
   "kr": "하얀마녀의 예언도 있으니."
  },
  "29": {
   "jp": "f79903c0",
   "kr": "혹시 캐라크가 하이젠을 노리는 건가 하고"
  },
  "30": {
   "jp": "73395c21",
   "kr": "생각해선 안 될 것까지 상상하고 말았다."
  },
  "31": {
   "jp": "b0e60d09",
   "kr": "하얀마녀의 예언은 경고예요."
  },
  "32": {
   "jp": "b96a0b91",
   "kr": "노력하면 나쁜 일 같은 건"
  },
  "33": {
   "jp": "15d4971d",
   "kr": "일어나지 않게 할 수도 있어요."
  },
  "34": {
   "jp": "5cd64c8f",
   "kr": "나쁜 건 베라트란 녀석이에요."
  },
  "35": {
   "jp": "208465dc",
   "kr": "분명 하얀마녀의 예언을 이용해서,"
  },
  "36": {
   "jp": "6d82322a",
   "kr": "남북이 싸우게 만들려는 거예요."
  },
  "37": {
   "jp": "ebe480e2",
   "kr": "좋아, 알겠다."
  },
  "38": {
   "jp": "aa759b53",
   "kr": "당장 하이젠 병사를 동원해서,"
  },
  "39": {
   "jp": "1b09605f",
   "kr": "루피나스 호수 요새로 보내자."
  },
  "40": {
   "jp": "883f8bb0",
   "kr": "칼리 왕비를 구출하는 거다."
  },
  "41": {
   "jp": "c3a1d0f1",
   "kr": "안 돼요. 그런 짓 하시면!"
  },
  "42": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "43": {
   "jp": "c8674e9d",
   "kr": "요새 사람들은 악당이 아니에요."
  },
  "44": {
   "jp": "0c9dc7d1",
   "kr": "여기서 병사를 데려가면"
  },
  "45": {
   "jp": "7942a4ab",
   "kr": "분명 요새 병사들과 싸움이 나 버릴 거예요."
  },
  "46": {
   "jp": "e203d5f1",
   "kr": "죄 없는 사람이 피를 흘리게 돼요."
  },
  "47": {
   "jp": "80aeb5ea",
   "kr": "응. 안 좋겠어."
  },
  "48": {
   "jp": "a1ad4cb8",
   "kr": "뭔가 좋은 생각은 없는 것일까…"
  },
  "49": {
   "jp": "d6bc055a",
   "kr": "으음…"
  },
  "50": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "51": {
   "jp": "6d774c34",
   "kr": "한동안 에네톤 왕과 함께 고민했다."
  },
  "52": {
   "jp": "59b4d973",
   "kr": "맞다!"
  },
  "53": {
   "jp": "256f4ea4",
   "kr": "까, 깜짝이야…"
  },
  "54": {
   "jp": "0f9460a6",
   "kr": "좋은 작전이 있어요."
  },
  "55": {
   "jp": "27be5a18",
   "kr": "저랑 쥬리오가 요새에 숨어들면 돼요."
  },
  "56": {
   "jp": "d6756896",
   "kr": "어떻게?"
  },
  "57": {
   "jp": "0f28037b",
   "kr": "그런 건 나중에 생각하면 돼."
  },
  "58": {
   "jp": "c8c621c5",
   "kr": "그게 좀처럼"
  },
  "59": {
   "jp": "f30498b4",
   "kr": "떠오르지 않을 것 같은데…"
  },
  "60": {
   "jp": "08b03125",
   "kr": "그런 건 그 자리에서 어떻게든 돼."
  },
  "61": {
   "jp": "7cb8fc49",
   "kr": "됐으니까 들어 봐."
  },
  "62": {
   "jp": "246f2990",
   "kr": "그래서, 몰래 칼리 왕비를 구해 내는 거야."
  },
  "63": {
   "jp": "d6756896",
   "kr": "어떻게?"
  },
  "64": {
   "jp": "44842b3b",
   "kr": "그것도 그때 가서 생각하면 돼."
  },
  "65": {
   "jp": "cfbc0c0d",
   "kr": "그건 분명 작전이 아니야…"
  },
  "66": {
   "jp": "efd1cffd",
   "kr": "괜찮아."
  },
  "67": {
   "jp": "0107a3fe",
   "kr": "그동안 휘리는 서둘러 홀크로 돌아가서,"
  },
  "68": {
   "jp": "0ee41608",
   "kr": "캐라크 왕께 연락하는 거야."
  },
  "69": {
   "jp": "e888bbf9",
   "kr": "요새 남쪽 밖에서 조용히 기다리게 해요."
  },
  "70": {
   "jp": "745cfb8d",
   "kr": "에네톤 왕도 요새 북쪽에서 대기하고 있어요."
  },
  "71": {
   "jp": "3c47d6f4",
   "kr": "칼리 왕비를 구해 내면 이쪽이 이긴 거야."
  },
  "72": {
   "jp": "54e055b3",
   "kr": "베라트 따위 무섭지 않아."
  },
  "73": {
   "jp": "65a2df91",
   "kr": "큰 소리로 신호할 테니까"
  },
  "74": {
   "jp": "dfb8ebbf",
   "kr": "거기서 두 임금님 등장이야."
  },
  "75": {
   "jp": "27da6db4",
   "kr": "등장해서 뭘 하는데?"
  },
  "76": {
   "jp": "ded810de",
   "kr": "뻔하잖아."
  },
  "77": {
   "jp": "4f6681ec",
   "kr": "두 왕이 악수하는 거예요."
  },
  "78": {
   "jp": "52050bc9",
   "kr": "악수?"
  },
  "79": {
   "jp": "f172a96d",
   "kr": "맞아."
  },
  "80": {
   "jp": "1c292d55",
   "kr": "요새 병사들이 보는 앞에서"
  },
  "81": {
   "jp": "c424f8f5",
   "kr": "두 왕이 사이좋게 악수하면,"
  },
  "82": {
   "jp": "429040c5",
   "kr": "오해 따위 금방 풀려."
  },
  "83": {
   "jp": "be0350a1",
   "kr": "응, 좋은 작전일지도 몰라."
  },
  "84": {
   "jp": "4450aaad",
   "kr": "그렇지?"
  },
  "85": {
   "jp": "9ce848cd",
   "kr": "확실히 자네들 말대로"
  },
  "86": {
   "jp": "dc32a0e6",
   "kr": "병사끼리 부딪치면,"
  },
  "87": {
   "jp": "63eb6ed3",
   "kr": "전쟁으로 번질 우려가 있다."
  },
  "88": {
   "jp": "5161e7b7",
   "kr": "그리되면 베라트의 뜻대로다."
  },
  "89": {
   "jp": "729c5208",
   "kr": "하지만, 그렇다고 해서"
  },
  "90": {
   "jp": "630def22",
   "kr": "너희를 위험한 꼴에 빠뜨릴 수도 없지."
  },
  "91": {
   "jp": "838ceb6d",
   "kr": "달리 뾰족한 수도 없고"
  },
  "92": {
   "jp": "5a311818",
   "kr": "괜찮아요, 임금님."
  },
  "93": {
   "jp": "08cf2042",
   "kr": "저, 왠지 잘될 것 같은"
  },
  "94": {
   "jp": "bbdb7166",
   "kr": "기분이 들어요."
  },
  "95": {
   "jp": "271b7d49",
   "kr": "설마, 요새 병사들이"
  },
  "96": {
   "jp": "e43ffde7",
   "kr": "너희에게 칼을 겨누지는 않으리라 생각하지만…"
  },
  "97": {
   "jp": "73028a0d",
   "kr": "베라트에게 부추김을 당하고 있다면"
  },
  "98": {
   "jp": "d4efaa09",
   "kr": "무슨 짓을 할지 알 수 없다."
  },
  "99": {
   "jp": "302bb8e6",
   "kr": "느닷없이 활로 노릴지도 모른다."
  },
  "100": {
   "jp": "f94174c7",
   "kr": "괜찮아요, 임금님."
  },
  "101": {
   "jp": "3ac00c6c",
   "kr": "저희, 도망은 자신 있거든요."
  },
  "102": {
   "jp": "2b5b5686",
   "kr": "달리기는 잘하니까요."
  },
  "103": {
   "jp": "17939696",
   "kr": "게다가, 요새에 잠입하면"
  },
  "104": {
   "jp": "b00d32d8",
   "kr": "제일 먼저 무기고를 찾아 무기를"
  },
  "105": {
   "jp": "cfb6a26e",
   "kr": "못 쓰게 만들어 버릴 거예요."
  },
  "106": {
   "jp": "f97c1d3e",
   "kr": "활이며 화살 따위 불태워 버리면 돼요."
  },
  "107": {
   "jp": "207ae3f0",
   "kr": "과, 과격한 작전이구나…"
  },
  "108": {
   "jp": "c84ee2b9",
   "kr": "역시 임금님도 그렇게 보세요?"
  },
  "109": {
   "jp": "545460f7",
   "kr": "에네톤 왕은 곤혹스러운 표정으로 끄덕였다."
  },
  "110": {
   "jp": "9dac344f",
   "kr": "그래도, 안심하세요."
  },
  "111": {
   "jp": "e8d98eee",
   "kr": "분명 잘될 테니까요."
  },
  "112": {
   "jp": "9ebc800e",
   "kr": "네, 이 수밖에 없어요."
  },
  "113": {
   "jp": "46e2668b",
   "kr": "해 볼 가치는 있어요."
  },
  "114": {
   "jp": "546c2f8f",
   "kr": "이대로면 칼리 왕비를 방패로"
  },
  "115": {
   "jp": "c892e785",
   "kr": "베라트라는 사람이"
  },
  "116": {
   "jp": "d334b410",
   "kr": "무슨 짓을 할지 몰라요."
  },
  "117": {
   "jp": "479294b4",
   "kr": "으음, 그렇군…"
  },
  "118": {
   "jp": "11f90705",
   "kr": "휘리에게까지 그런 말을 들으니"
  },
  "119": {
   "jp": "085d36dd",
   "kr": "그 작전도 제법 괜찮아 보이는구나…"
  },
  "120": {
   "jp": "1feaf54b",
   "kr": "고민되는구나…"
  },
  "121": {
   "jp": "dd8496e9",
   "kr": "여보."
  },
  "122": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "123": {
   "jp": "b8743a16",
   "kr": "당신이 그렇게 우유부단하니까"
  },
  "124": {
   "jp": "3849f06a",
   "kr": "형제 문제 따위를 이용당하고,"
  },
  "125": {
   "jp": "e58967ee",
   "kr": "베라트라는 자에게 나라를 노리는 겁니다."
  },
  "126": {
   "jp": "0efce15b",
   "kr": "애초에 당신은 늘 고민만 하시지요."
  },
  "127": {
   "jp": "989a29fb",
   "kr": "이분들처럼"
  },
  "128": {
   "jp": "769e8641",
   "kr": "자발적인 의견이라는 것은 없으신 겁니까?"
  },
  "129": {
   "jp": "98b29a19",
   "kr": "미안하오…"
  },
  "130": {
   "jp": "5e0734ad",
   "kr": "참고로 저는 이분들 의견에 찬성입니다."
  },
  "131": {
   "jp": "8c038461",
   "kr": "이 작전에도 위험은 있다고 생각합니다만,"
  },
  "132": {
   "jp": "28bccb27",
   "kr": "칼리 왕비님을 생각하면"
  },
  "133": {
   "jp": "65878cc7",
   "kr": "병사를 데려가는 쪽이 더 위험합니다."
  },
  "134": {
   "jp": "ef69aff6",
   "kr": "으음… 알겠다."
  },
  "135": {
   "jp": "d87820f0",
   "kr": "지금 결론을 내리지."
  },
  "136": {
   "jp": "3adae119",
   "kr": "………"
  },
  "137": {
   "jp": "f04c67c5",
   "kr": "……………………"
  },
  "138": {
   "jp": "6d3a8b74",
   "kr": "좋아, 정했다."
  },
  "139": {
   "jp": "c11e7b05",
   "kr": "그 작전으로 하자."
  },
  "140": {
   "jp": "0627c199",
   "kr": "나도 전면적으로 협력한다."
  },
  "141": {
   "jp": "19c37aa6",
   "kr": "이 문제는 전부 자네들에게 맡기겠다."
  },
  "142": {
   "jp": "db2c4f83",
   "kr": "결정!"
  },
  "143": {
   "jp": "6397459e",
   "kr": "그렇게 정해졌으면,"
  },
  "144": {
   "jp": "d91909c6",
   "kr": "당장 루피나스 호수 요새로 가자."
  },
  "145": {
   "jp": "9347ca2e",
   "kr": "그러네요."
  },
  "146": {
   "jp": "a4500c85",
   "kr": "그럼, 저는 홀크로 가서"
  },
  "147": {
   "jp": "afded1ef",
   "kr": "캐라크 왕께 알리고 올게요."
  },
  "148": {
   "jp": "3f5757f0",
   "kr": "여어, 휘리."
  },
  "149": {
   "jp": "b071c084",
   "kr": "또 임금님이 고민하고 계셔."
  },
  "150": {
   "jp": "3181ab52",
   "kr": "위로해 드려."
  },
  "151": {
   "jp": "345d1724",
   "kr": "임금님은 어떠셨어?"
  },
  "152": {
   "jp": "24fdfc08",
   "kr": "괜찮아요, 걱정 없어요."
  },
  "153": {
   "jp": "de186299",
   "kr": "임금님이 고민하시는 걸 보는 건 괴로우니까."
  },
  "154": {
   "jp": "559ab1da",
   "kr": "일단은 다행이야."
  },
  "155": {
   "jp": "cb113360",
   "kr": "또 고민하고 계셔."
  },
  "156": {
   "jp": "c6583b26",
   "kr": "임금님 기운 나셨을까?"
  },
  "157": {
   "jp": "188163ad",
   "kr": "고민의 원인은 해결됐으니"
  },
  "158": {
   "jp": "c93475a4",
   "kr": "분명 이제 괜찮을 거예요."
  },
  "159": {
   "jp": "ea066033",
   "kr": "다행이에요."
  },
  "160": {
   "jp": "53cfb971",
   "kr": "나도 요새 북쪽에서 대기하고 있겠네."
  },
  "161": {
   "jp": "6355f4d6",
   "kr": "신호가 있으면"
  },
  "162": {
   "jp": "022c8e91",
   "kr": "바로 뛰어들 테니까."
  },
  "163": {
   "jp": "f86e4ff5",
   "kr": "부디 무리하지는 말아 주게."
  },
  "164": {
   "jp": "7c169899",
   "kr": "너희에게 만에 하나 무슨 일이 생기면,"
  },
  "165": {
   "jp": "dcf69980",
   "kr": "그야말로 큰일이니까."
  },
  "166": {
   "jp": "f0a5e5f6",
   "kr": "그, 베라트라는 남자."
  },
  "167": {
   "jp": "7b4d502f",
   "kr": "칼리 왕비를 인질로 삼아"
  },
  "168": {
   "jp": "b48110da",
   "kr": "캐라크 왕을 뜻대로 부리고"
  },
  "169": {
   "jp": "69249af0",
   "kr": "남부를 자유로이 주무를 셈이로군요."
  },
  "170": {
   "jp": "3be2d9b2",
   "kr": "그리고 남부를 조종해 북부에 손을 뻗어,"
  },
  "171": {
   "jp": "8b1d9b2b",
   "kr": "머지않아 퓨엔테 전역을 빼앗을 속셈이겠지."
  },
  "172": {
   "jp": "ea9c699e",
   "kr": "얼마나 비열한 남자인가."
  },
  "173": {
   "jp": "5d091358",
   "kr": "요새에 붙잡혀 있는"
  },
  "174": {
   "jp": "d73c36f8",
   "kr": "칼리 왕비를 생각하면"
  },
  "175": {
   "jp": "0259b663",
   "kr": "가슴이 아픕니다."
  },
  "176": {
   "jp": "d1e9c0de",
   "kr": "어서 구해 드리고 싶군요."
  },
  "177": {
   "jp": "b5f2f48f",
   "kr": "분명, 저기 책장에"
  },
  "178": {
   "jp": "a53caad7",
   "kr": "마녀의 예언이 실린 책이 있었는데,"
  },
  "179": {
   "jp": "cfe83642",
   "kr": "읽어 보았는가?"
  },
  "180": {
   "jp": "acd6807a",
   "kr": "하얀마녀는 무엇이든 꿰뚫어 본 모양이구먼."
  },
  "181": {
   "jp": "8b336987",
   "kr": "에네톤 왕께서는 늘 고민하고 계세요."
  },
  "182": {
   "jp": "a82269c7",
   "kr": "뭘 고민하시는지는 모르지만,"
  },
  "183": {
   "jp": "af15b1eb",
   "kr": "고민하는 게 임금님 취미인가 봐요."
  },
  "184": {
   "jp": "a25e47e0",
   "kr": "책등에 《루피나스 호수 곁에서》라고"
  },
  "185": {
   "jp": "738306f4",
   "kr": "적힌 책이 있다."
  },
  "186": {
   "jp": "2b32dbf8",
   "kr": "쥬리오는 손에 들고 책을 펼쳐 보았다."
  },
  "187": {
   "jp": "28a4783d",
   "kr": "《루피나스 호수의 기슭에서》"
  },
  "188": {
   "jp": "d2a44e11",
   "kr": "루피나스 호수 기슭에 펼쳐진 퓨엔테 왕국은"
  },
  "189": {
   "jp": "39596a49",
   "kr": "남북 두 지구로 나뉘어 있다."
  },
  "190": {
   "jp": "09293a01",
   "kr": "북쪽은 형인 에네톤 왕."
  },
  "191": {
   "jp": "e7f316bb",
   "kr": "남쪽은 아우인 캐라크가 각각 다스린다."
  },
  "192": {
   "jp": "5b0b2182",
   "kr": "원래는 북쪽 하이젠성을 도읍으로 삼아"
  },
  "193": {
   "jp": "ad19bed4",
   "kr": "다스렸으나, 쌍둥이 왕자의 탄생을 계기로"
  },
  "194": {
   "jp": "4aad200c",
   "kr": "홀크에도 저택을 지어 지구를 나누었다."
  },
  "195": {
   "jp": "6ee0b532",
   "kr": "홀크와 하이젠, 두 도읍이 태어났다."
  },
  "196": {
   "jp": "f476f4ce",
   "kr": "두 왕의 힘으로 새 나라를 세우기를 바랐다."
  },
  "197": {
   "jp": "cdecf510",
   "kr": "형제는 다투듯 나라 세우기에 힘쓰며"
  },
  "198": {
   "jp": "da22a623",
   "kr": "좋든 나쁘든 서로 겨루었다."
  },
  "199": {
   "jp": "05823ea9",
   "kr": "과연 이를 한탄으로 받아들였을까."
  },
  "200": {
   "jp": "831ead01",
   "kr": "떠돌이 마녀가 남긴 말이 여기 있다."
  },
  "201": {
   "jp": "664c38a8",
   "kr": "『어미가 피를 나눔은 나라 가름이 아니다』"
  },
  "202": {
   "jp": "651e9466",
   "kr": "퓨엔테의 장래를 근심하는 말 같다."
  },
  "203": {
   "jp": "02d53fd7",
   "kr": "너무 어려워서 잘 모르겠어."
  },
  "204": {
   "jp": "8920f6ef",
   "kr": "책등에 《쾌걸 와일드캣》이라고"
  },
  "205": {
   "jp": "738306f4",
   "kr": "적힌 책이 있다."
  },
  "206": {
   "jp": "7c370c7b",
   "kr": "어린이용 이야기인 듯하다."
  },
  "207": {
   "jp": "2b32dbf8",
   "kr": "쥬리오는 손에 들고 책을 펼쳐 보았다."
  },
  "208": {
   "jp": "138e5e5c",
   "kr": "《쾌걸 와일드캣》"
  },
  "209": {
   "jp": "7c3ffd8d",
   "kr": "와일드캣은 우리 편이다."
  },
  "210": {
   "jp": "c48cdac6",
   "kr": "숲속에서 바람처럼 나타나 곤란할 때"
  },
  "211": {
   "jp": "26d92da8",
   "kr": "우리를 구해 준다."
  },
  "212": {
   "jp": "bc760627",
   "kr": "어른들은 산적이라고 부르지만"
  },
  "213": {
   "jp": "b1ed385b",
   "kr": "와일드캣은 좋은 사람이다."
  },
  "214": {
   "jp": "068623b9",
   "kr": "얼마 전에도 곰에게 습격당할 뻔했을 때"
  },
  "215": {
   "jp": "7be1c206",
   "kr": "쓱 나타나 나를 구해 주었다."
  },
  "216": {
   "jp": "4ae1eea8",
   "kr": "숲의 의적 와일드캣. 또 만나고 싶다."
  },
  "217": {
   "jp": "7dcd5147",
   "kr": "너무 어린애용이네."
  },
  "218": {
   "jp": "c09a8deb",
   "kr": "그래도, 와일드캣이란 이름"
  },
  "219": {
   "jp": "f75d9503",
   "kr": "멋있네."
  },
  "220": {
   "jp": "457f44d0",
   "kr": "그런가."
  }
 }
}