  },
  "10": {
   "jp": "75bc4956",
   "kr": "도매상 세르지오"
  },
  "11": {
   "jp": "1c235189",
   "kr": "토니스"
  },
  "12": {
   "jp": "92f4a88d",
   "kr": "라치카"
  },
  "13": {
   "jp": "ebf38677",
   "kr": "사르티"
  },
  "14": {
   "jp": "7ed31e79",
   "kr": "바리"
  },
  "15": {
   "jp": "3790288b",
   "kr": "챠펠의 에바르"
  },
  "16": {
   "jp": "ebf2daeb",
   "kr": "무기상 부레"
  },
  "17": {
   "jp": "1eceebc2",
   "kr": "도구상 이스리"
  },
  "18": {
   "jp": "cd6e71cc",
   "kr": "여기는 자유무역 도시 기드넬이다."
  },
  "19": {
   "jp": "e01420df",
   "kr": "뭐, 천천히 둘러보고 가라."
  },
  "20": {
   "jp": "33098cf8",
   "kr": "남쪽으로 가면"
  },
  "21": {
   "jp": "299ed6b0",
   "kr": "유적 지나 바라카 마을이다."
  },
  "22": {
   "jp": "92eea1ed",
   "kr": "아, 그렇군요."
  },
  "23": {
   "jp": "6008c44c",
   "kr": "유적 쪽에서 나오면"
  },
  "24": {
   "jp": "ed126a9a",
   "kr": "여기로 나오네요."
  },
  "25": {
   "jp": "bfe7fca2",
   "kr": "이쪽은 유적을 지나 바라카로 가는 길이다."
  },
  "26": {
   "jp": "c248d61c",
   "kr": "뭐, 천천히 둘러보고 가게."
  },
  "27": {
   "jp": "b62d9f6b",
   "kr": "여기서 나가면 서쪽 가도를 지나"
  },
  "28": {
   "jp": "5a77fa19",
   "kr": "바라카로 이어진다."
  },
  "29": {
   "jp": "62e759b9",
   "kr": "서쪽 가도는"
  },
  "30": {
   "jp": "65104a31",
   "kr": "여기로 이어져 있었군."
  },
  "31": {
   "jp": "fec37992",
   "kr": "이 길은 바라카로 통하는 서쪽 길이다."
  },
  "32": {
   "jp": "8ba16212",
   "kr": "이쪽으로 바라카에 돌아가도"
  },
  "33": {
   "jp": "45249ebe",
   "kr": "바라카엔 들여보내 주지 않겠지."
  },
  "34": {
   "jp": "0ee8a40f",
   "kr": "특별히 우르기드 님이"
  },
  "35": {
   "jp": "b7235739",
   "kr": "기뻐하실 만한 물건은 없는 모양이군."
  },
  "36": {
   "jp": "5563e6ed",
   "kr": "그럼 여기 통행 허가는 못 준다."
  },
  "37": {
   "jp": "df4332bc",
   "kr": "나는 우르기드 님 저택을 지키는"
  },
  "38": {
   "jp": "cd2dffd3",
   "kr": "자랑스러운 문지기다."
  },
  "39": {
   "jp": "cbd1d6fd",
   "kr": "지나고 싶으면 지나가라."
  },
  "40": {
   "jp": "f3422e83",
   "kr": "이 나라는 자유무역의 나라다."
  },
  "41": {
   "jp": "961f80dc",
   "kr": "사람의 왕래는 모두 자유다."
  },
  "42": {
   "jp": "7e6eb70a",
   "kr": "크리스를 구해낼 때까지"
  },
  "43": {
   "jp": "f697ebda",
   "kr": "기드넬에서 나갈 수는 없어."
  },
  "44": {
   "jp": "b42203a2",
   "kr": "맞다, 여기 묵는 손님은"
  },
  "45": {
   "jp": "bf763eab",
   "kr": "상품 매입하러 온 사람들뿐이잖아."
  },
  "46": {
   "jp": "6005ca22",
   "kr": "그렇다면"
  },
  "47": {
   "jp": "b1f8132a",
   "kr": "우르기드네 문지기가 인정할 만한"
  },
  "48": {
   "jp": "9144aaea",
   "kr": "진귀한 물건을 알고 있을지도 몰라."
  },
  "49": {
   "jp": "758905bb",
   "kr": "그렇군."
  },
  "50": {
   "jp": "7231741b",
   "kr": "잠깐"
  },
  "51": {
   "jp": "b8d1168c",
   "kr": "옆방 사람한테 물어볼까?"
  },
  "52": {
   "jp": "d8440f73",
   "kr": "이 마을은"
  },
  "53": {
   "jp": "682f6d8d",
   "kr": "늘 노점에 상품이 가득 늘어서 있어서"
  },
  "54": {
   "jp": "a4c019fd",
   "kr": "정말 눈이 팔려 버려요."
  },
  "55": {
   "jp": "0186d03d",
   "kr": "저녁 반찬은 뭘로 할까요…"
  },
  "56": {
   "jp": "6ff88a01",
   "kr": "대단하지."
  },
  "57": {
   "jp": "d94a395a",
   "kr": "기드넬은 사막 한가운데 있는 마을인데도"
  },
  "58": {
   "jp": "ec9d7b51",
   "kr": "늘 이렇게 물건이 넘쳐나."
  },
  "59": {
   "jp": "fd1e6795",
   "kr": "우르기드의 힘은 대단한 거라니까."
  },
  "60": {
   "jp": "8d6ae72b",
   "kr": "여기를 걸으면"
  },
  "61": {
   "jp": "6484ecb0",
   "kr": "웬만한 물건은 뭐든 다 있어."
  },
  "62": {
   "jp": "b1138230",
   "kr": "역시 자유무역 도시야."
  },
  "63": {
   "jp": "b30add46",
   "kr": "맛있어 보이는 건 안 팔려나…"
  },
  "64": {
   "jp": "f8f18fe1",
   "kr": "설마, 무화과 같은 게"
  },
  "65": {
   "jp": "58adaf11",
   "kr": "노점에는 안 늘어서 있겠지…"
  },
  "66": {
   "jp": "63a6ae6f",
   "kr": "물건은 잔뜩 파는데"
  },
  "67": {
   "jp": "61796868",
   "kr": "요즘"
  },
  "68": {
   "jp": "c0b903a7",
   "kr": "무화과만은 안 나와 있단 말이지."
  },
  "69": {
   "jp": "b4007877",
   "kr": "어지간히 흉작인 모양이야."
  },
  "70": {
   "jp": "be6a748f",
   "kr": "아〜아, 무화과 먹고 싶다아."
  },
  "71": {
   "jp": "245ac4a5",
   "kr": "바라카에서 칸다타라는 녀석이"
  },
  "72": {
   "jp": "f5f0b2e7",
   "kr": "우르기드의 저택에 와 있다더군."
  },
  "73": {
   "jp": "9d8ef546",
   "kr": "어차피 못된 일 모의라도"
  },
  "74": {
   "jp": "d1291231",
   "kr": "하고 있겠지…"
  },
  "75": {
   "jp": "0a153964",
   "kr": "부자 중에 좋은 놈은 별로 없으니까."
  },
  "76": {
   "jp": "e17d4e3e",
   "kr": "너희도 조심해."
  },
  "77": {
   "jp": "4e689eb8",
   "kr": "우르기드의 저택에 들어가려면"
  },
  "78": {
   "jp": "57518afb",
   "kr": "뭔가 공물을 가져가야만 해."
  },
  "79": {
   "jp": "36e7c253",
   "kr": "욕심 사나운 얄미운 놈이지."
  },
  "80": {
   "jp": "eadae5dd",
   "kr": "내가 험담한 건"
  },
  "81": {
   "jp": "cdaf72f5",
   "kr": "비밀로 해 주세요."
  },
  "82": {
   "jp": "28367dca",
   "kr": "병사한테라도 알려지면 큰일이에요."
  },
  "83": {
   "jp": "acc9a574",
   "kr": "어서 오십시오."
  },
  "84": {
   "jp": "4efab84b",
   "kr": "호상 우르기드 직영 도구 도매상이올시다."
  },
  "85": {
   "jp": "9db25719",
   "kr": "어느 가게 분이신지요?"
  },
  "86": {
   "jp": "7d9ea345",
   "kr": "네? 가게…?"
  },
  "87": {
   "jp": "0158a49b",
   "kr": "이런, 가게 분이 아니십니까?"
  },
  "88": {
   "jp": "027cde55",
   "kr": "여기는 가게끼리 거래하는 도매상이라"
  },
  "89": {
   "jp": "978d17ed",
   "kr": "소매는 하지 않습니다."
  },
  "90": {
   "jp": "6ae9a898",
   "kr": "허, 허, 허, 잘못 찾으셨군요."
  },
  "91": {
   "jp": "8118fab6",
   "kr": "그럼, 밖에 써 놓든가."
  },
  "92": {
   "jp": "a486a2ff",
   "kr": "아이고, 무서워라, 무서워라…"
  },
  "93": {
   "jp": "93914999",
   "kr": "여기는 소매점 분 외에는"
  },
  "94": {
   "jp": "bfcca998",
   "kr": "거래를 하지 않습니다."
  },
  "95": {
   "jp": "4c48ea92",
   "kr": "일반 손님용 도구상이라면"
  },
  "96": {
   "jp": "8951afd7",
   "kr": "마을 북서쪽에 있습니다."
  },
  "97": {
   "jp": "0867bb9f",
   "kr": "양해 바랍니다."
  },
  "98": {
   "jp": "bcaa5c36",
   "kr": "뭐, 느긋하게 쉬다 가게."
  },
  "99": {
   "jp": "27338fbb",
   "kr": "여어, 무슨 일이야?"
  },
  "100": {
   "jp": "1e5aefbd",
   "kr": "좀 여쭤보고 싶은데요."
  },
  "101": {
   "jp": "6d35a9ae",
   "kr": "지금 이 나라 사람들이"
  },
  "102": {
   "jp": "ec0420e3",
   "kr": "누구나 반드시 진귀하다 여길 만한"
  },
  "103": {
   "jp": "7c968cac",
   "kr": "귀중한 물건이 뭘까요?"
  },
  "104": {
   "jp": "4c139ef5",
   "kr": "아아, 매입 상담이군."
  },
  "105": {
   "jp": "988aa448",
   "kr": "글쎄"
  },
  "106": {
   "jp": "d7248e15",
   "kr": "세상에 귀중한 물건은 많이 있지만"
  },
  "107": {
   "jp": "cc5116b7",
   "kr": "지금은 뭐니 뭐니 해도 무화과지."
  },
  "108": {
   "jp": "684d64df",
   "kr": "무화과?"
  },
  "109": {
   "jp": "fc313ba5",
   "kr": "그런 게 말이야?"
  },
  "110": {
   "jp": "15f5712b",
   "kr": "그래. 우습게 볼 일이 아니야."
  },
  "111": {
   "jp": "8f500f65",
   "kr": "올해는 웬일인지 무화과만 흉작이라서."
  },
  "112": {
   "jp": "eaee9a2a",
   "kr": "도무지 시장에 풀리질 않아."
  },
  "113": {
   "jp": "26d952cd",
   "kr": "무화과 맛을 아는 기드나 사람들에게는"
  },
  "114": {
   "jp": "4f2b977f",
   "kr": "아무리 Pia를 쌓아도"
  },
  "115": {
   "jp": "ac099a61",
   "kr": "손이 나올 만큼 갖고 싶은 물건이야."
  },
  "116": {
   "jp": "724c357c",
   "kr": "무화과가 있으면"
  },
  "117": {
   "jp": "419171ab",
   "kr": "누구든 크게 기뻐해."
  },
  "118": {
   "jp": "1e13a3aa",
   "kr": "무화과를 선물로 들고 가면"
  },
  "119": {
   "jp": "3b6ff22a",
   "kr": "우르기드도"
  },
  "120": {
   "jp": "3d6908b9",
   "kr": "저택에 들여보내 주려나."
  },
  "121": {
   "jp": "7e79999b",
   "kr": "아아, 물론이지."
  },
  "122": {
   "jp": "5e4e2665",
   "kr": "부자는 입이 고급이니까."
  },
  "123": {
   "jp": "d4c81209",
   "kr": "두 손 들고 기뻐할걸."
  },
  "124": {
   "jp": "367cc0ab",
   "kr": "난 도구를 매입하러 왔어."
  },
  "125": {
   "jp": "1a1946c5",
   "kr": "이 마을엔 도매상이 있어서 정말 도움이 돼."
  },
  "126": {
   "jp": "6cc10c2b",
   "kr": "여기 도매상"
  },
  "127": {
   "jp": "1baef038",
   "kr": "조금만 더 깎아 주면"
  },
  "128": {
   "jp": "2ff91e61",
   "kr": "더 바랄 게 없을 텐데."
  },
  "129": {
   "jp": "0ee6df6b",
   "kr": "엇, 뭐야?"
  },
  "130": {
   "jp": "3a33c373",
   "kr": "우와앗…!"
  },
  "131": {
   "jp": "d4c2e94e",
   "kr": "뭐야."
  },
  "132": {
   "jp": "182436ba",
   "kr": "지금 앉은 채로"
  },
  "133": {
   "jp": "2bf1dece",
   "kr": "휙"
  },
  "134": {
   "jp": "e3ae6965",
   "kr": "이쪽을 봤죠?"
  },
  "135": {
   "jp": "7bdf8908",
   "kr": "아아, 이거?"
  },
  "136": {
   "jp": "a32923e4",
   "kr": "굉장해…"
  },
  "137": {
   "jp": "36093851",
   "kr": "이 근방에선 의자를 별로 안 쓰거든."
  },
  "138": {
   "jp": "4821da41",
   "kr": "그래서 어릴 적부터"
  },
  "139": {
   "jp": "1af530c2",
   "kr": "이런 놀이를 자주 하지."
  },
  "140": {
   "jp": "678a2aca",
   "kr": "응?"
  },
  "141": {
   "jp": "d73594a1",
   "kr": "아아, 이 근방에서"
  },
  "142": {
   "jp": "6a967df2",
   "kr": "지금 가장 귀한 걸 꼽자면"
  },
  "143": {
   "jp": "9f754bd8",
   "kr": "물론 무화과지."
  },
  "144": {
   "jp": "daf44e21",
   "kr": "무화과가 있으면 누구든 크게 기뻐하지."
  },
  "145": {
   "jp": "5c5d0b5e",
   "kr": "저기, 무화과 있어요?"
  },
  "146": {
   "jp": "684d64df",
   "kr": "무화과?"
  },
  "147": {
   "jp": "ae16a4b6",
   "kr": "그건 안 되오."
  },
  "148": {
   "jp": "803af49b",
   "kr": "무화과는 올해 흉작이라."
  },
  "149": {
   "jp": "e0de114f",
   "kr": "요즘 들어"
  },
  "150": {
   "jp": "d6286bf5",
   "kr": "좀처럼 구할 수가 없다오."
  },
  "151": {
   "jp": "63e5d419",
   "kr": "손님."
  },
  "152": {
   "jp": "c71c11a6",
   "kr": "사과 맛있다오."
  },
  "153": {
   "jp": "f2515ff7",
   "kr": "네〜, 네〜, 어서 오세요오!"
  },
  "154": {
   "jp": "6421f41f",
   "kr": "신선한 채소와 과일부터 무기까지"
  },
  "155": {
   "jp": "272ade39",
   "kr": "뭐든 다 있어요오!"
  },
  "156": {
   "jp": "07d7148e",
   "kr": "뭐든 다 있다며."
  },
  "157": {
   "jp": "27efecce",
   "kr": "무화과는 안 파나?"
  },
  "158": {
   "jp": "9ab7047a",
   "kr": "헉."
  },
  "159": {
   "jp": "540ffddf",
   "kr": "뭐든 다 있다고 하지 않았냐?"
  },
  "160": {
   "jp": "f37b05c5",
   "kr": "그 말 들으면 괴롭다니까."
  },
  "161": {
   "jp": "507b097b",
   "kr": "안 팔아요?"
  },
  "162": {
   "jp": "e129882e",
   "kr": "무화과는 흉작이라니까."
  },
  "163": {
   "jp": "c47b0efe",
