  },
  "189": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "190": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "191": {
   "jp": "33e2e68d",
