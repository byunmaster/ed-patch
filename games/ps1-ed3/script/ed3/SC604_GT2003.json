  "176": {
   "jp": "9d7e6f8f",
   "kr": "이 방에서 기다리기로 할게요."
  },
  "177": {
   "jp": "7014c204",
   "kr": "아아, 그게 좋겠군."
  },
  "178": {
   "jp": "29a43c6e",
   "kr": "그럼, 쥬리오."
  },
  "179": {
   "jp": "0627b9d1",
