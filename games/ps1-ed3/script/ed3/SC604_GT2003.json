 "lines": {
  "0": {
   "jp": "dc464821",
   "kr": "기드넬"
  },
  "1": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "2": {
   "jp": "61b34eb7",
   "kr": "파니마"
  },
  "3": {
   "jp": "e39592b6",
   "kr": "페르타"
  },
  "4": {
   "jp": "c3b93825",
   "kr": "쥬만"
  },
  "5": {
   "jp": "41e92ccf",
   "kr": "라즈무"
  },
  "6": {
   "jp": "3fe5bee4",
   "kr": "오후르"
  },
  "7": {
   "jp": "c5d03ce3",
   "kr": "페르스"
  },
  "8": {
   "jp": "f34e4933",
   "kr": "파렌"
  },
  "9": {
   "jp": "75bc4956",
   "kr": "도매상 세르지오"
  },
  "10": {
   "jp": "1c235189",
   "kr": "토니스"
  },
  "11": {
   "jp": "92f4a88d",
   "kr": "라치카"
  },
  "12": {
   "jp": "ebf38677",
   "kr": "사르티"
  },
  "13": {
   "jp": "7ed31e79",
   "kr": "바리"
  },
  "14": {
   "jp": "3790288b",
   "kr": "챠펠의 에바르"
  },
  "15": {
   "jp": "ebf2daeb",
   "kr": "무기상 부레"
  },
  "16": {
   "jp": "1eceebc2",
   "kr": "도구상 이스리"
  },
  "17": {
   "jp": "e1afb7ee",
   "kr": "나제"
  },
  "18": {
   "jp": "cd6e71cc",
   "kr": "여기는 자유무역 도시 기드넬이다."
  },
  "19": {
   "jp": "e01420df",
   "kr": "뭐, 천천히 둘러보고 가라."
  },
  "20": {
   "jp": "33098cf8",
   "kr": "남쪽으로 가면"
  },
  "21": {
   "jp": "299ed6b0",
   "kr": "유적 지나 바라카 마을이다."
  },
  "22": {
   "jp": "92eea1ed",
   "kr": "아, 그렇군요."
  },
  "23": {
   "jp": "6008c44c",
   "kr": "유적 쪽에서 나오면"
  },
  "24": {
   "jp": "ed126a9a",
   "kr": "여기로 나오네요."
  },
  "25": {
   "jp": "bfe7fca2",
   "kr": "이쪽은 유적을 지나 바라카로 가는 길이다."
  },
  "26": {
   "jp": "c248d61c",
   "kr": "뭐, 천천히 둘러보고 가게."
  },
  "27": {
   "jp": "b62d9f6b",
   "kr": "여기서 나가면 서쪽 가도를 지나"
  },
  "28": {
   "jp": "5a77fa19",
   "kr": "바라카로 이어진다."
  },
  "29": {
   "jp": "62e759b9",
   "kr": "서쪽 가도는"
  },
  "30": {
   "jp": "65104a31",
   "kr": "여기로 이어져 있었군."
  },
  "31": {
   "jp": "fec37992",
   "kr": "이 길은 바라카로 통하는 서쪽 길이다."
  },
  "32": {
   "jp": "d6759a35",
   "kr": "폴티아 국경은 북쪽 출구야."
  },
  "33": {
   "jp": "8ba16212",
   "kr": "이쪽으로 바라카에 돌아가도,"
  },
  "34": {
   "jp": "45249ebe",
   "kr": "바라카엔 들여보내 주지 않겠지."
  },
  "35": {
   "jp": "e4a71fdc",
   "kr": "아아, 너희구나."
  },
  "36": {
   "jp": "e6cc89c5",
   "kr": "이제, 여기는 자유로이 지나도"
  },
  "37": {
   "jp": "74daf700",
   "kr": "상관없단다."
  },
  "38": {
   "jp": "c2a6a85b",
   "kr": "자, 어서."
  },
  "39": {
   "jp": "8d674bc2",
   "kr": "자유롭게 지나가도 돼."
  },
  "40": {
   "jp": "47c42d25",
   "kr": "이런, 그건…"
  },
  "41": {
   "jp": "39b8d86c",
   "kr": "무화과열매 아닌가!"
  },
  "42": {
   "jp": "7ce09afc",
   "kr": "잘도 구했구나."
  },
  "43": {
   "jp": "37f591c0",
   "kr": "그거라면 우르기드 님도"
  },
  "44": {
   "jp": "46a5e733",
   "kr": "기뻐하시겠지."
  },
  "45": {
   "jp": "278d2dda",
   "kr": "좋아, 통행을 허가하마."
  },
  "46": {
   "jp": "78c45a81",
   "kr": "너희는 지나가도 좋다."
  },
  "47": {
   "jp": "cbd1d6fd",
   "kr": "지나고 싶으면 지나가라."
  },
  "48": {
   "jp": "f3422e83",
   "kr": "이 나라는 자유무역의 나라다."
  },
  "49": {
   "jp": "961f80dc",
   "kr": "사람의 왕래는 모두 자유다."
  },
  "50": {
   "jp": "7e6eb70a",
   "kr": "크리스를 구해낼 때까지"
  },
  "51": {
   "jp": "f697ebda",
   "kr": "기드넬에서 나갈 수는 없어."
  },
  "52": {
   "jp": "d8440f73",
   "kr": "이 마을은"
  },
  "53": {
   "jp": "682f6d8d",
   "kr": "늘 노점에 상품이 가득 늘어서 있어서"
  },
  "54": {
   "jp": "a4c019fd",
   "kr": "정말 눈이 팔려 버려요."
  },
  "55": {
   "jp": "0186d03d",
   "kr": "저녁 반찬은 뭘로 할까요…"
  },
  "56": {
   "jp": "6ff88a01",
   "kr": "대단하지."
  },
  "57": {
   "jp": "d94a395a",
   "kr": "기드넬은 사막 한가운데 있는 마을인데도"
  },
  "58": {
   "jp": "ec9d7b51",
   "kr": "늘 이렇게 물건이 넘쳐나."
  },
  "59": {
   "jp": "fd1e6795",
   "kr": "우르기드의 힘은 대단한 거라니까."
  },
  "60": {
   "jp": "8d6ae72b",
   "kr": "여기를 걸으면"
  },
  "61": {
   "jp": "6484ecb0",
   "kr": "웬만한 물건은 뭐든 다 있어."
  },
  "62": {
   "jp": "b1138230",
   "kr": "역시 자유무역 도시야."
  },
  "63": {
   "jp": "5590ff80",
   "kr": "뭐?"
  },
  "64": {
   "jp": "94460a0a",
   "kr": "우르기드를 만났다고?"
  },
  "65": {
   "jp": "3b008291",
   "kr": "마음을 고쳐먹었다고?"
  },
  "66": {
   "jp": "aa4ac6a0",
   "kr": "난 좀 못 믿겠는데."
  },
  "67": {
   "jp": "0aed94f9",
   "kr": "그게 정말이라면 만세를 부를 일이지만."
  },
  "68": {
   "jp": "1102e959",
   "kr": "우르기드가 정말 마음을 고쳐먹었는지"
  },
  "69": {
   "jp": "0f647160",
   "kr": "조금 지켜보기로 하겠어."
  },
  "70": {
   "jp": "245ac4a5",
   "kr": "바라카에서 칸다타라는 녀석이"
  },
  "71": {
   "jp": "f5f0b2e7",
   "kr": "우르기드의 저택에 와 있다더군."
  },
  "72": {
   "jp": "9d8ef546",
   "kr": "어차피 못된 일 모의라도"
  },
  "73": {
   "jp": "d1291231",
   "kr": "하고 있겠지…"
  },
  "74": {
   "jp": "0a153964",
   "kr": "부자 중에 좋은 놈은 별로 없으니까."
  },
  "75": {
   "jp": "e17d4e3e",
   "kr": "너희도 조심해."
  },
  "76": {
   "jp": "12bd66cb",
   "kr": "우르기드 님도"
  },
  "77": {
   "jp": "289fb87c",
   "kr": "조금만 더 우리를 생각해 주시면"
  },
  "78": {
   "jp": "6993675d",
   "kr": "좋을 텐데."
  },
  "79": {
   "jp": "4e689eb8",
   "kr": "우르기드의 저택에 들어가려면,"
  },
  "80": {
   "jp": "57518afb",
   "kr": "뭔가 공물을 가져가야만 해."
  },
  "81": {
   "jp": "36e7c253",
   "kr": "욕심 사나운 얄미운 놈이지."
  },
  "82": {
   "jp": "eadae5dd",
   "kr": "내가 험담한 건"
  },
  "83": {
   "jp": "cdaf72f5",
   "kr": "비밀로 해 주세요."
  },
  "84": {
   "jp": "28367dca",
   "kr": "병사한테라도 알려지면 큰일이에요."
  },
  "85": {
   "jp": "93914999",
   "kr": "여기는 소매점 분 외에는"
  },
  "86": {
   "jp": "bfcca998",
   "kr": "거래를 하지 않습니다."
  },
  "87": {
   "jp": "4c48ea92",
   "kr": "일반 손님용 도구상이라면"
  },
  "88": {
   "jp": "8951afd7",
   "kr": "마을 북서쪽에 있습니다."
  },
  "89": {
   "jp": "0867bb9f",
   "kr": "양해 바랍니다."
  },
  "90": {
   "jp": "bcaa5c36",
   "kr": "뭐, 느긋하게 쉬다 가게."
  },
  "91": {
   "jp": "6c6e43d1",
   "kr": "지금, 무화과를"
  },
  "92": {
   "jp": "fd83bc59",
   "kr": "잔뜩 손에 넣으면,"
  },
  "93": {
   "jp": "82b6b0d9",
   "kr": "큰 부자가 될 수 있을 텐데."
  },
  "94": {
   "jp": "fdc365a4",
   "kr": "아니, 잠깐…"
  },
  "95": {
   "jp": "97212533",
   "kr": "많으면 값이 떨어지려나?"
  },
  "96": {
   "jp": "e1857942",
   "kr": "으음."
  },
  "97": {
   "jp": "4bd6d2b7",
   "kr": "이게 매입의 어려운 점이지."
  },
  "98": {
   "jp": "367cc0ab",
   "kr": "난 도구를 매입하러 왔어."
  },
  "99": {
   "jp": "1a1946c5",
   "kr": "이 마을엔 도매상이 있어서 정말 도움이 돼."
  },
  "100": {
   "jp": "6cc10c2b",
   "kr": "여기 도매상"
  },
  "101": {
   "jp": "1baef038",
   "kr": "조금만 더 깎아 주면"
  },
  "102": {
   "jp": "2ff91e61",
   "kr": "더 바랄 게 없을 텐데."
  },
  "103": {
   "jp": "0ee6df6b",
   "kr": "엇, 뭐야?"
  },
  "104": {
   "jp": "3a33c373",
   "kr": "우와앗…!"
  },
  "105": {
   "jp": "d4c2e94e",
   "kr": "뭐야."
  },
  "106": {
   "jp": "182436ba",
   "kr": "지금, 앉은 채로"
  },
  "107": {
   "jp": "2bf1dece",
   "kr": "휙,"
  },
  "108": {
   "jp": "e3ae6965",
   "kr": "이쪽을 봤죠?"
  },
  "109": {
   "jp": "7bdf8908",
   "kr": "아아, 이거?"
  },
  "110": {
   "jp": "a32923e4",
   "kr": "굉장해…"
  },
  "111": {
   "jp": "36093851",
   "kr": "이 근방에선 의자를 별로 안 쓰거든."
  },
  "112": {
   "jp": "4821da41",
   "kr": "그래서 어릴 적부터"
  },
  "113": {
   "jp": "1af530c2",
   "kr": "이런 놀이를 자주 하지."
  },
  "114": {
   "jp": "7d2b9f9b",
   "kr": "응, 이 근처에서"
  },
  "115": {
   "jp": "6a967df2",
   "kr": "지금, 가장 귀한 걸 꼽자면"
  },
  "116": {
   "jp": "9f754bd8",
   "kr": "물론, 무화과지."
  },
  "117": {
   "jp": "daf44e21",
   "kr": "무화과가 있으면 누구든 크게 기뻐하지."
  },
  "118": {
   "jp": "7dfc75f0",
   "kr": "어서 오쇼, 어서 오쇼!"
  },
  "119": {
   "jp": "f8cf3c87",
   "kr": "들러 보쇼, 구경하쇼."
  },
  "120": {
   "jp": "e8b14abc",
   "kr": "횡재할 물건이 한가득이야!"
  },
  "121": {
   "jp": "f2515ff7",
   "kr": "네〜, 네〜, 어서 오세요오!"
  },
  "122": {
   "jp": "6421f41f",
   "kr": "신선한 채소와 과일부터 무기까지,"
  },
  "123": {
   "jp": "5f75eb3e",
   "kr": "무화과 말고 다른 거라면"
  },
  "124": {
   "jp": "272ade39",
   "kr": "뭐든 다 있어요오!"
  },
  "125": {
   "jp": "91d74b8c",
   "kr": "여어, 거기 총각."
  },
  "126": {
   "jp": "82a5b769",
   "kr": "공교롭게 무화과는 없지만,"
  },
  "127": {
   "jp": "82eb79ba",
   "kr": "여러 가지 물건이 갖춰져 있어."
  },
  "128": {
   "jp": "074d19c8",
   "kr": "구경하고 가세요."
  },
  "129": {
   "jp": "64f15349",
   "kr": "여러분 뒤를 쫓아왔어요."
  },
  "130": {
   "jp": "005edb69",
   "kr": "어째서?"
  },
  "131": {
   "jp": "8d3ffc69",
   "kr": "역시"
  },
  "132": {
   "jp": "9ef93666",
   "kr": "여러분만 우르기드한테"
  },
  "133": {
   "jp": "f466a8ac",
   "kr": "향하게 하는 건 걱정이라서…"
  },
  "134": {
   "jp": "1a9bb5a3",
   "kr": "왜냐면,"
  },
  "135": {
   "jp": "d89e73e0",
   "kr": "우르기드는 골수 악당이니까요."
  },
  "136": {
   "jp": "6edb9124",
   "kr": "여러분 생각을 하니"
  },
  "137": {
   "jp": "3dcbbdb8",
   "kr": "도저히 가만히 있을 수가 없어서"
  },
  "138": {
   "jp": "29ca581a",
   "kr": "그래서, 뒤쫓아 온 거예요."
  },
  "139": {
   "jp": "dafe464b",
   "kr": "뭘, 우리라면 괜찮다고."
  },
  "140": {
   "jp": "641ee2f9",
   "kr": "쥬리오 혼자면 걱정되겠지만,"
  },
  "141": {
   "jp": "f3ecf7a7",
   "kr": "이 바다트가 붙어 있잖아."
  },
  "142": {
   "jp": "9b2dd5ad",
   "kr": "악당 하나둘쯤"
  },
  "143": {
   "jp": "0a9b88d9",
   "kr": "간단히 눕혀 주지."
  },
  "144": {
   "jp": "d1cf185f",
   "kr": "나도"
  },
  "145": {
   "jp": "66de489f",
   "kr": "식은 죽 먹기야."
  },
  "146": {
   "jp": "40748be6",
   "kr": "어머, 씩씩하네요."
  },
  "147": {
   "jp": "2887b528",
   "kr": "전부터 우르기드는"
  },
  "148": {
   "jp": "13c54eb3",
   "kr": "공물 없는 손님과는 만나지 않는다고"
  },
  "149": {
   "jp": "6f956dd2",
   "kr": "들었던 터라서요."
  },
  "150": {
   "jp": "57e7c1a5",
   "kr": "지금 기드나에서 가장 귀하게 여겨지는"
  },
  "151": {
   "jp": "6d06538f",
   "kr": "무화과 열매를 찾아왔습니다."
  },
  "152": {
   "jp": "ebe6bc34",
   "kr": "그럼 받아도 되는 거네요."
  },
  "153": {
   "jp": "58effc7b",
   "kr": "네, 그걸로 어서 크리스 씨를"
  },
  "154": {
   "jp": "8006648a",
   "kr": "구해 내 주세요."
  },
  "155": {
   "jp": "36155dcf",
   "kr": "고맙군."
  },
  "156": {
   "jp": "14552430",
   "kr": "더는 못 들겠어."
  },
  "157": {
   "jp": "c95ef071",
   "kr": "뭔가 버리자."
  },
  "158": {
   "jp": "e9d91b01",
   "kr": ", 손에 넣었다."
  },
  "159": {
   "jp": "264a04e7",
   "kr": "용케 찾았네요."
  },
  "160": {
   "jp": "7197911b",
   "kr": "상인을 위한 채소밭은 흉작이어도,"
  },
  "161": {
   "jp": "0aa77424",
   "kr": "한둘 정도라면,"
  },
  "162": {
   "jp": "03ad3e6d",
   "kr": "자연에서 자란 걸 찾을 수 있어요."
  },
  "163": {
   "jp": "8b478099",
   "kr": "자, 크리스 씨를 구하러 가요."
  },
  "164": {
   "jp": "1d581ddd",
   "kr": "나제 씨도 같이 가 주시는 거예요?"
  },
  "165": {
   "jp": "81306805",
   "kr": "안 돼."
  },
  "166": {
   "jp": "d3d34344",
   "kr": "우르기드 녀석이잖아."
  },
  "167": {
   "jp": "24b79e56",
   "kr": "어떤 비겁한 수를 쓸지"
  },
  "168": {
   "jp": "b6feaeed",
   "kr": "알 수 없다고."
  },
  "169": {
   "jp": "11771f3c",
   "kr": "나제 씨를 위험한 꼴에"
  },
  "170": {
   "jp": "a37fd6ae",
   "kr": "빠뜨릴지도 모르니까"
  },
  "171": {
   "jp": "7e0ec6f8",
   "kr": "절대 안 돼."
  },
  "172": {
   "jp": "7440fe30",
   "kr": "그러네."
