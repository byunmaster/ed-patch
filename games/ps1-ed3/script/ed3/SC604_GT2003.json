  "173": {
   "jp": "3adae119",
   "kr": "………"
  },
  "174": {
   "jp": "d1419925",
   "kr": "… 알겠어요."
  },
  "175": {
   "jp": "6934a25e",
   "kr": "그럼, 저는"
