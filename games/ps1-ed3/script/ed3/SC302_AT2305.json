   "kr": "안데라성"
  },
  "1": {
   "jp": "24b7384e",
   "kr": "2층"
  },
  "2": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "3": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "4": {
   "jp": "1addc969",
   "kr": "죠리나 왕비"
  },
  "5": {
   "jp": "b97d5055",
   "kr": "마기사"
  },
  "6": {
   "jp": "943c8543",
   "kr": "스라브 노인"
  },
  "7": {
   "jp": "b1109aa0",
   "kr": "아, 반갑습니다."
  },
  "8": {
   "jp": "3c1131f2",
   "kr": "콘테스트 때의 그 도둑은"
  },
  "9": {
   "jp": "b0311789",
   "kr": "그 뒤로 모습을 안 보이는군요."
  },
  "10": {
   "jp": "8b37e563",
   "kr": "가끔 그런 자가 나오면"
  },
  "11": {
   "jp": "ba637ba4",
   "kr": "재미있긴 합니다만."
  },
  "12": {
   "jp": "1752d73e",
   "kr": "여기는 알프 왕의 침실입니다."
  },
  "13": {
   "jp": "eea08dbb",
   "kr": "구경을 원하신다면"
  },
  "14": {
   "jp": "d001a873",
   "kr": "부디 마음껏 들어와 보십시오."
  },
  "15": {
   "jp": "2b0ab96a",
   "kr": "하지만 임금님 침대에서"
  },
  "16": {
   "jp": "b72a4db5",
   "kr": "낮잠은 주무시지 마십시오."
  },
  "17": {
   "jp": "70354164",
   "kr": "……"
  },
  "18": {
   "jp": "b635a18d",
   "kr": "네. 이번 건 조금은 재미있었어요."
  },
  "19": {
   "jp": "277da843",
   "kr": "해냈다."
  },
  "20": {
   "jp": "ff7ae00d",
   "kr": "벌써 순례 여행은 끝난 겁니까?"
  },
  "21": {
   "jp": "73b7e499",
   "kr": "아니, 아직인데."
  },
  "22": {
   "jp": "4aefd46e",
   "kr": "잠깐 들러 본 거예요."
  },
  "23": {
   "jp": "e86a84f0",
   "kr": "그렇겠지요."
  },
  "24": {
   "jp": "0fd67f96",
   "kr": "그렇게 빨리 올도스까지"
  },
  "25": {
   "jp": "37ab44ce",
   "kr": "갈 수 있을 리 없으니까요."
  },
  "26": {
   "jp": "1adbf36a",
   "kr": "그럼"
  },
  "27": {
   "jp": "db0432d8",
   "kr": "너무 무리하지 마시고"
  },
  "28": {
   "jp": "de71ec8d",
   "kr": "여행을 계속하십시오."
  },
  "29": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "30": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "31": {
   "jp": "27df4b18",
   "kr": "아, 예."
  },
  "32": {
   "jp": "23de89b6",
   "kr": "앰비쉬는 늘 평화롭고 아름다운 나라입니다."
  },
  "33": {
   "jp": "527afe2c",
   "kr": "내년 요리 콘테스트에도"
  },
  "34": {
   "jp": "af47c992",
   "kr": "꼭 참가해 주십시오."
  },
  "35": {
   "jp": "816ab6ac",
   "kr": "저는 역시"
  },
  "36": {
   "jp": "6f47dbbb",
   "kr": "만들기보다 먹는 게 좋아요."
  },
  "37": {
   "jp": "1d24badd",
   "kr": "정말 먹보라니까."
  },
  "38": {
   "jp": "ac87d3f9",
   "kr": "지금 앰비쉬에서는"
  },
  "39": {
   "jp": "adef4f0b",
   "kr": "갑자기 요리 열풍이 불어닥치고"
  },
  "40": {
   "jp": "1d2de24d",
   "kr": "있답니다."
  },
  "41": {
   "jp": "520e6777",
   "kr": "오오, 쥬리오, 크리스."
  },
  "42": {
   "jp": "6cbe9050",
   "kr": "벌써 올도스에 다녀왔나?"
  },
  "43": {
   "jp": "6a19db05",
   "kr": "아뇨, 그게…"
  },
  "44": {
   "jp": "b7c27048",
   "kr": "아직입니다."
  },
  "45": {
   "jp": "0543f13c",
   "kr": "뭐야, 아직인가?"
  },
  "46": {
   "jp": "8faeef54",
   "kr": "순례 여행은"
  },
  "47": {
   "jp": "41f1a199",
   "kr": "소중한 라그픽 마을의 관습 아닌가."
  },
  "48": {
   "jp": "bbaa7df7",
   "kr": "얼른 마치는 게 좋겠네."
  },
  "49": {
   "jp": "7e9a7c02",
   "kr": "어쨌든 건강해 보여서 다행이에요."
  },
  "50": {
   "jp": "0333739c",
   "kr": "하지만 고향 부모님이 분명 걱정하실 거예요."
  },
  "51": {
   "jp": "2fd00d8d",
   "kr": "순례를 얼른 마치고 한 번 집에 다녀온 뒤에"
  },
  "52": {
   "jp": "eb2bc711",
   "kr": "느긋하게 놀러 오세요."
  },
  "53": {
   "jp": "03d66d05",
   "kr": "아쉽지만 어쩔 수 없네요."
  },
  "54": {
   "jp": "56603ce5",
   "kr": "이게 두 분의 여행이니까요."
  },
  "55": {
   "jp": "7a2e1831",
   "kr": "마기사 님은"
  },
  "56": {
   "jp": "aa6e887a",
   "kr": "이제 완전히 좋아지셨어요."
  },
  "57": {
   "jp": "fb0e7ea9",
   "kr": "남은 건"
  },
  "58": {
   "jp": "a656eb9d",
   "kr": "로디 님이 나으시면"
  },
  "59": {
   "jp": "ccd4fa78",
   "kr": "저도 마음이 놓일 텐데요."
  },
  "60": {
   "jp": "3a44c099",
   "kr": "하지만 개인적으로는 로디 님이"
  },
  "61": {
   "jp": "3f849eb4",
   "kr": "계속 이 성에 계셨으면 좋겠어요."
  },
  "62": {
   "jp": "2381ec77",
   "kr": "시녀는 조금 볼을 붉혔다."
  },
  "63": {
   "jp": "1cc3b732",
   "kr": "어머, 크리스 양. 쥬리오 군."
  },
  "64": {
   "jp": "5d456ec5",
   "kr": "덕분에 완전히 좋아졌어요."
  },
  "65": {
   "jp": "c0745d7b",
   "kr": "다행이에요."
  },
  "66": {
   "jp": "73bd3d12",
   "kr": "크리스 양이라면 올도스에서"
  },
  "67": {
   "jp": "f103d02a",
   "kr": "여러 가지를 배울 수 있을 거예요."
  },
  "68": {
   "jp": "8a17ac3b",
   "kr": "힘내세요."
  },
  "69": {
   "jp": "593cfb1c",
   "kr": "책은 인류가 만들어 낸 훌륭한 보물입니다."
  },
  "70": {
   "jp": "3e272389",
   "kr": "지식의 샘이며"
  },
  "71": {
   "jp": "d54a68bb",
   "kr": "잊어버려도 읽으면 떠올릴 수 있습니다."
  },
  "72": {
   "jp": "8caefc19",
   "kr": "울고 웃고 감동하고"
  },
  "73": {
   "jp": "61cf2894",
   "kr": "책을 읽음으로써 용기가 솟기도 합니다."
  },
  "74": {
   "jp": "edf5d70a",
   "kr": "책에 파묻혀 살고 싶습니다."
  },
  "75": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "76": {
   "jp": "bcf3004a",
   "kr": "꼭 시를 낭독하는 것 같네."
  },
  "77": {
   "jp": "ee1ede99",
   "kr": "노인 웅변대회 같은 거겠지."
  },
  "78": {
   "jp": "eddd666e",
   "kr": "책등에 『안데라 호수』라고 적힌 책이 있다."
  },
  "79": {
   "jp": "db11b8e0",
   "kr": "쥬리오는 그 책을 집어 들어 펼쳐 보았다."
  },
  "80": {
   "jp": "9e00a194",
   "kr": "안데라 호수는 이 땅의 창세 전승에 따르면"
  },
  "81": {
   "jp": "88d3ba39",
   "kr": "산맥만 한 큰 뱀과 싸운 거인의 발자국이라"
  },
  "82": {
   "jp": "16b69357",
   "kr": "한다. 큰 뱀을 이긴 거인은 그 큰 뱀을"
  },
  "83": {
   "jp": "74d0103b",
   "kr": "한 번 어깨에 메고 승리의 함성을 올렸다."
  },
  "84": {
   "jp": "12b1ef18",
   "kr": "호수는 그때의 무게 때문에 생겨났다고"
  },
  "85": {
   "jp": "5f305f6b",
   "kr": "한다. 거인은 앰비쉬 남쪽 국경을"
  },
  "86": {
   "jp": "423e02e4",
   "kr": "따라 큰 뱀을 눕혔다. 그것이 앰비쉬의"
  },
  "87": {
   "jp": "67e5e39e",
   "kr": "대산맥이 되었다."
  },
  "88": {
   "jp": "b27cfc81",
   "kr": "거인의 발자국에는 물이 고여 푸르게 맑은"
  },
  "89": {
   "jp": "47286f9d",
   "kr": "아름다운 호수가 되었다."
  },
  "90": {
   "jp": "1998305e",
   "kr": "책등에 『하얀마녀의 말』이라고\n적힌 책이 있다."
  },
  "91": {
   "jp": "db11b8e0",
   "kr": "쥬리오는 그 책을 집어 들어 펼쳐 보았다."
  },
  "92": {
   "jp": "ac47da45",
   "kr": "그녀의 이름은 게르드. 티라스일을 걸으며"
  },
  "93": {
   "jp": "65bd5bc7",
   "kr": "불길한 말을 남기고 사라졌다. 아직 스무"
  },
  "94": {
   "jp": "8931dcc2",
   "kr": "살도 안 된 처녀는 백은빛 머리 탓에 어느새"
  },
  "95": {
   "jp": "46bf2c75",
   "kr": "사람들 사이에서 하얀마녀로 불리게 되었다."
  },
  "96": {
   "jp": "1a4a2a94",
   "kr": "『재앙의 산이 바다에서 나와 도읍을 부순다』"
  },
  "97": {
   "jp": "b05daa72",
   "kr": "메나트 동해안에서 앰비쉬 전역에 남은"
  },
  "98": {
   "jp": "69a0f202",
   "kr": "게르드의 말이다. 학자들은 바다에서 나타나는"
  },
  "99": {
   "jp": "2bfdd81b",
   "kr": "산을 지진으로 생긴 새 섬이라 해석한다."
  },
  "100": {
   "jp": "6bdbda59",
   "kr": "『대지가 결실을 잊을 때 산은 바다를 넘어"
  },
  "101": {
   "jp": "28c5b0b7",
   "kr": "사람들의 탄식이 메아리친다.』 거의 메나트"
  },
  "102": {
   "jp": "c18b3ba2",
   "kr": "전역에 남은 말. 여기서도 산이 화근이나"
  },
  "103": {
   "jp": "2b706c53",
   "kr": "앞의 산과 달리 해석이 불가능하다."
  },
  "104": {
   "jp": "48ae4fc5",
   "kr": "한편 신비학자 중에는 이 말들을 다른"
  },
  "105": {
   "jp": "ddbb3870",
   "kr": "관점에서 해석하는 이도 있다. 두 말의"
  },
  "106": {
   "jp": "93a45a94",
   "kr": "산은 같고 거대 생물의 습격이라 본다."
  },
  "107": {
   "jp": "2d266f00",
   "kr": "책등에는 『즐거운 요리』라고 적혀 있다."
  },
  "108": {
   "jp": "5de18d79",
   "kr": "쥬리오는 페이지를 펼쳤다."
  },
  "109": {
   "jp": "95b9a5d3",
   "kr": "기본 재료 10가지"
  },
  "110": {
   "jp": "f43c8089",
   "kr": "토마토 퓌레. 양파. 당근. 셀러리."
  },
  "111": {
   "jp": "f8269bdf",
   "kr": "감자. 적포도주. 마늘. 올리브유."
  },
  "112": {
   "jp": "f61b3a94",
   "kr": "향신료. 암염."
  },
  "113": {
   "jp": "530b504d",
   "kr": "이 재료만으로도 토마토스튜가 됩니다."
  },
  "114": {
   "jp": "8f67f03a",
   "kr": "하지만 요리를 더 즐기고 싶은 분은 이"
  },
  "115": {
   "jp": "e5445272",
   "kr": "기본 재료에 몇 가지 재료를 더해서 한 단계"
  },
  "116": {
   "jp": "cf46be83",
   "kr": "위의 요리에 도전해 보세요."
  },
  "117": {
   "jp": "5af1528c",
   "kr": "기본 재료＋쇠고기로 『비프 토마토스튜』나"
  },
  "118": {
   "jp": "bd5b7584",
   "kr": "『쇠고기 적포도주 조림』이 됩니다."
  },
  "119": {
   "jp": "97801ba1",
   "kr": "기본 재료＋비트(붉은 순무)＋양배추＋사워"
  },
  "120": {
   "jp": "aa3462eb",
   "kr": "크림으로 『보르시치』가 됩니다."
  },
  "121": {
   "jp": "32ab4719",
   "kr": "기본 재료＋쇠고기＋데미글라스 소스＋적포도주로"
  },
  "122": {
   "jp": "0464f54e",
   "kr": "『비프스튜』가 됩니다."
  },
  "123": {
   "jp": "1d96a7b6",
   "kr": "기본 재료＋사프란＋생선과 조개로 『부야베스』"
  },
  "124": {
   "jp": "c2ab4054",
   "kr": "가 됩니다."
  },
  "125": {
   "jp": "ef8eb51f",
   "kr": "기본 재료＋쇠고기＋카레 스파이스＋코코넛 밀크"
  },
  "126": {
   "jp": "87a2fc03",
   "kr": "＋요구르트로 『비프 카레』가 됩니다."
  },
  "127": {
   "jp": "8b031196",
   "kr": "쇠고기 대신 해산물을 쓰시면 아주"
  },
  "128": {
   "jp": "4ab62eab",
   "kr": "맛있는 『시푸드 카레』도 됩니다."
  },
  "129": {
   "jp": "600414d2",
   "kr": "이제 당신도 요리 명인."
  },
  "130": {
   "jp": "441fdab4",
   "kr": "훌륭한 맛의 하모니를"
  },
  "131": {
   "jp": "2c6bf784",
   "kr": "부디 맛보십시오."
  },
  "132": {
   "jp": "ab94597a",
   "kr": "앰비쉬성 조리고문 죠르노 그루메"
  },
  "133": {
   "jp": "f6361ccd",
   "kr": "책등에 《요술사 겟페우스의 보물》이라고"
  },
  "134": {
   "jp": "0b5c632c",
   "kr": "적힌 책이 있다."
  },
  "135": {
   "jp": "2b32dbf8",
   "kr": "쥬리오는 손에 들고 책을 펼쳐 보았다."
  },
  "136": {
   "jp": "d6cb9b73",
   "kr": "《요술사 겟페우스의 보물》"
  },
  "137": {
   "jp": "16253682",
   "kr": "일찍이 대마도사 올테가와의 대결에서 진"
  },
  "138": {
   "jp": "f17ea3e9",
   "kr": "요술사 겟페우스. 그는 북쪽 빙산에 틀어박혀"
  },
  "139": {
   "jp": "2d0ae55f",
   "kr": "다시 올테가에게 도전하려고 수행을 쌓았다."
  },
  "140": {
   "jp": "17babc64",
   "kr": "겟페우스의 요술은 결코 사악하지 않았으나"
  },
  "141": {
   "jp": "bac7cf0d",
   "kr": "올테가를 이기는 것만이 목적인 기술은"
  },
  "142": {
   "jp": "78356749",
   "kr": "뜻이 없고 공명심만 앞서 아무리 수행해도"
  },
  "143": {
   "jp": "819c55d7",
   "kr": "다듬어지지 못했다."
  },
  "144": {
   "jp": "9565c1ef",
   "kr": "어느 날 겟페우스에게 악마가 속삭였다."
  },
  "145": {
   "jp": "06e0b3c7",
   "kr": "악마는 힘을 주는 대신 올테가를 쓰러뜨리라"
  },
  "146": {
   "jp": "55b55a6c",
