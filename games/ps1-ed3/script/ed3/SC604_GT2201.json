{
 "archive": "/SCE6/SC604.DAT",
 "member": "..\\DATA\\GT2201.BIN",
 "lines": {
  "0": {
   "jp": "dc464821",
   "kr": "기드넬"
  },
  "1": {
   "jp": "4300e71e",
   "kr": "우르기드 저택"
  },
  "2": {
   "jp": "7be8df5a",
   "kr": "여자 목소리"
  },
  "3": {
   "jp": "e9b5c557",
   "kr": "우르기드"
  },
  "4": {
   "jp": "d12a3c7c",
   "kr": "칸다타"
  },
  "5": {
   "jp": "6e020f8e",
   "kr": "칸다타 녀석만 안 나왔으면 됐는데."
  },
  "6": {
   "jp": "fea45857",
   "kr": "어떡하지…"
  },
  "7": {
   "jp": "6fed5bed",
   "kr": "이런 걸 뭐라고 하는지 아냐?"
  },
  "8": {
   "jp": "11c24e8a",
   "kr": "미라 잡으러 갔다 미라 된다고 하는 거다."
  },
  "9": {
   "jp": "a132e74d",
   "kr": "흐음. 미라가 된 거구나."
  },
  "10": {
   "jp": "7d98ef8e",
   "kr": "큰일이네."
  },
  "11": {
   "jp": "7e8b1a56",
   "kr": "너, 못 알아들었지?"
  },
  "12": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "13": {
   "jp": "c5eb731b",
   "kr": "됐으니 벽을 살피자."
  },
  "14": {
   "jp": "d078ed1c",
   "kr": "벽을 조사해 볼까."
  },
  "15": {
   "jp": "040e2822",
   "kr": "무너지기 쉬운 벽이 있을지도 몰라."
  },
  "16": {
   "jp": "2bd3f75a",
   "kr": "좋아, 조사해 볼까."
  },
  "17": {
   "jp": "03c50f92",
   "kr": "어딘가 출구 없으려나?"
  },
  "18": {
   "jp": "dc723b65",
   "kr": "일단 문을 살펴보자고."
  },
  "19": {
   "jp": "00fc75f0",
   "kr": "철문이야."
  },
  "20": {
   "jp": "63dba711",
   "kr": "잠겨 있어."
  },
  "21": {
   "jp": "2987e0eb",
   "kr": "이건, 나라도 못 부수겠군."
  },
  "22": {
   "jp": "4e9e10dd",
   "kr": "어떻게든 부술 수 없을까."
  },
  "23": {
   "jp": "f4ca3ecd",
   "kr": "이 근처 벽은 나무야."
  },
  "24": {
   "jp": "2ef6a309",
   "kr": "몸으로 부딪치면 부서지지 않을까."
  },
  "25": {
   "jp": "0f89b174",
   "kr": "누가 몸으로 부딪치냐?"
  },
  "26": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "27": {
   "jp": "e0582632",
   "kr": "그 눈길은 뭐냐?"
  },
  "28": {
   "jp": "ffca2107",
   "kr": "그야, 몸통 박치기로 부술 수도 있지만."
  },
  "29": {
   "jp": "edc6d605",
   "kr": "꽤 날쌔게 하지 않으면,"
  },
  "30": {
   "jp": "7d50a9b2",
   "kr": "꾸물대다간, 금방 잡힌다고."
  },
  "31": {
   "jp": "2d4974ef",
   "kr": "폭탄이라도 있으면 몰라도…"
  },
  "32": {
   "jp": "249304a7",
   "kr": "몸통 박치기 한 방으론"
  },
  "33": {
   "jp": "af9ad344",
   "kr": "좀 못 뚫을 것 같군."
  },
  "34": {
   "jp": "bce4ce19",
   "kr": "누가 구하러 와 주지 않나."
  },
  "35": {
   "jp": "abdf3062",
   "kr": "실은"
  },
  "36": {
   "jp": "d6f6d824",
   "kr": "우리가 구하러 온 쪽인데 말이야."
  },
  "37": {
   "jp": "cf222d24",
   "kr": "구하러 왔어요."
  },
  "38": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "39": {
   "jp": "f2dfac84",
   "kr": "정말이냐?"
  },
  "40": {
   "jp": "7aeb7242",
   "kr": "조용히."
  },
  "41": {
   "jp": "db3e4757",
   "kr": "이 벽을 부술게요."
  },
  "42": {
   "jp": "a649a9f8",
   "kr": "부수면"
  },
  "43": {
   "jp": "b04c8fdd",
   "kr": "곧바로 내 뒤를 따라와요."
  },
  "44": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "45": {
   "jp": "cac73e12",
   "kr": "준비됐죠?"
  },
  "46": {
   "jp": "283c1ebf",
   "kr": "좋아."
  },
  "47": {
   "jp": "d2305320",
   "kr": "그럼, 갈게요."
  },
  "48": {
   "jp": "f330a993",
   "kr": "무, 무슨 일이냐?"
  },
  "49": {
   "jp": "09018750",
   "kr": "설마, 사막의 흑표범이…?"
  },
  "50": {
   "jp": "be227394",
   "kr": "붙잡아라!"
  },
  "51": {
   "jp": "f7e495d2",
   "kr": "사막의 흑표범을 붙잡는 게다!"
  }
 }
}