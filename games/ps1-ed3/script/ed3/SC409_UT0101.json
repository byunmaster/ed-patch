{
 "archive": "/SCE4/SC409.DAT",
 "member": "..\\DATA\\UT0101.BIN",
 "lines": {
  "0": {
   "jp": "4b650dea",
   "kr": "시플"
  },
  "1": {
   "jp": "a82af9b4",
   "kr": "샤리네"
  },
  "2": {
   "jp": "324a055b",
   "kr": "시플의 현자"
  },
  "3": {
   "jp": "92e502d7",
   "kr": "이걸로 우리도"
  },
  "4": {
   "jp": "9eb962cf",
   "kr": "드디어 시플의 마법의 거울을"
  },
  "5": {
   "jp": "5f093941",
   "kr": "볼 수 있게 됐어."
  },
  "6": {
   "jp": "387044fa",
   "kr": "현자님,"
  },
  "7": {
   "jp": "06165b58",
   "kr": "당장 마법의 거울을 봐도"
  },
  "8": {
   "jp": "93a7790a",
   "kr": "될까요?"
  },
  "9": {
   "jp": "6728989e",
   "kr": "아, 물론 좋고말고요."
  },
  "10": {
   "jp": "c84e5288",
   "kr": "어서 보시지요."
  },
  "11": {
   "jp": "3223b58a",
   "kr": "우리도 봐도 되는 건가?"
  },
  "12": {
   "jp": "45add927",
   "kr": "네, 괜찮습니다."
  },
  "13": {
   "jp": "9b9960ac",
   "kr": "흔히 마법의 거울은 순례자에게만 보인다지만"
  },
  "14": {
   "jp": "6598a7ee",
   "kr": "그건 순례의 마음을"
  },
  "15": {
   "jp": "b9a85750",
   "kr": "소중히 하는 자에게만 보인다는 뜻입니다."
  },
  "16": {
   "jp": "678fa0d3",
   "kr": "물론 은단검이 필요하나 마법의 거울이"
  },
  "17": {
   "jp": "00d14c25",
   "kr": "움직이면 맑은 마음을 가진 사람이라면"
  },
  "18": {
   "jp": "e122680f",
   "kr": "누구에게든 영상이 보일 겁니다."
  },
  "19": {
   "jp": "77c4417a",
   "kr": "맑은 마음이라. 자신 없는데…"
  },
  "20": {
   "jp": "c679b1ed",
   "kr": "다만 같은 때에 마법의 거울을 보아도"
  },
  "21": {
   "jp": "6affbc42",
   "kr": "보는 이의 뜻에 따라"
  },
  "22": {
   "jp": "6fc1cbcb",
   "kr": "다른 것이 보이는 일도 있는 듯합니다만."
  },
  "23": {
   "jp": "a4fbfd3e",
   "kr": "자, 보시지요."
  },
  "24": {
   "jp": "d6e7b559",
   "kr": "여러분이 지켜 주신 샤리네입니다."
  },
  "25": {
   "jp": "8c92d439",
   "kr": "걱정하실 것 없습니다."
  },
  "26": {
   "jp": "63333416",
   "kr": "숲을 걷고 있는 것 같았어."
  },
  "27": {
   "jp": "34d8f3a9",
   "kr": "응 내가 본 것도 그랬어."
  },
  "28": {
   "jp": "e84b8c28",
   "kr": "숲속에 누가 서 있었어."
  },
  "29": {
   "jp": "f904da1c",
   "kr": "그리고 물소 같은 동물."
  },
  "30": {
   "jp": "1b0a73a2",
   "kr": "쥬리오랑 내가 본 건"
  },
  "31": {
   "jp": "eff3fdca",
   "kr": "같은 영상이었나 봐."
  },
  "32": {
   "jp": "229c0d19",
   "kr": "구스는 어떤 거였어?"
  },
  "33": {
   "jp": "bafc1a21",
   "kr": "나?"
  },
  "34": {
   "jp": "02f63365",
   "kr": "됐어, 내 건."
  },
  "35": {
   "jp": "900d3c35",
   "kr": "알았어. 샤라였지?"
  },
  "36": {
   "jp": "0bb648e4",
   "kr": "마법의 거울은 보는 사람 마음속에서"
  },
  "37": {
   "jp": "09b18a1f",
   "kr": "신경 쓰이는 일이나 앞으로 일어날 일이"
  },
  "38": {
   "jp": "199907ae",
   "kr": "비치는 거야."
  },
  "39": {
   "jp": "81926e6a",
   "kr": "크리스 님."
  },
  "40": {
   "jp": "9a3dfcba",
   "kr": "외람됩니다만 거울 영상의 내용은"
  },
  "41": {
   "jp": "64b91234",
   "kr": "함부로 말하지 않는 것이 관례이옵니다."
  },
  "42": {
   "jp": "c27e3b77",
   "kr": "죄송해요…"
  },
  "43": {
   "jp": "1120bff2",
   "kr": "아뇨, 죄송합니다."
  },
  "44": {
   "jp": "7a50380a",
   "kr": "제가 그만 말이 지나쳤습니다."
  }
 }
}