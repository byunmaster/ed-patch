  },
  "110": {
   "jp": "b0642d72",
   "kr": "일이니까 지키고 있는 거고."
  },
  "111": {
   "jp": "9bf27e3d",
   "kr": "그건 그래."
  },
  "112": {
   "jp": "700b8e4e",
   "kr": "크리스는"
