  "0": {
   "jp": "ff7be70f",
   "kr": "다이스"
  },
  "1": {
   "jp": "3aac6b08",
   "kr": "챠놈의 병사"
  },
  "2": {
   "jp": "a76cf681",
   "kr": "치젤"
  },
  "3": {
   "jp": "a2dbf087",
   "kr": "토니카"
  },
  "4": {
   "jp": "6b8f3c8a",
   "kr": "슈벨"
  },
  "5": {
   "jp": "2a003f2b",
   "kr": "세란"
  },
  "6": {
   "jp": "07cf2d0c",
   "kr": "밀러"
  },
  "7": {
   "jp": "738ebaa1",
   "kr": "여기는 챠놈 대통령"
  },
  "8": {
   "jp": "537b6543",
   "kr": "바론 님의 관저입니다."
  },
  "9": {
   "jp": "c704834f",
   "kr": "용건 없는 분은 들여보낼 수 없습니다."
  },
  "10": {
   "jp": "eff7a1ce",
   "kr": "누나 누가 왔어…"
  },
  "11": {
   "jp": "d6b58306",
   "kr": "쉿!"
  },
  "12": {
   "jp": "f8b7919d",
   "kr": "들키지 않게"
  },
  "13": {
   "jp": "fbd04343",
   "kr": "조용히 있는 거야."
  },
  "14": {
   "jp": "612f6299",
   "kr": "응?"
  },
  "15": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "16": {
   "jp": "32f5e9da",
   "kr": "어?"
  },
  "17": {
   "jp": "6b13f9bd",
   "kr": "무슨 일이야?"
  },
  "18": {
   "jp": "cdfba5c2",
   "kr": "어디 아파?"
  },
  "19": {
   "jp": "64ffac32",
   "kr": "도망쳐!"
  },
  "20": {
   "jp": "9b20da62",
   "kr": "네!"
  },
  "21": {
   "jp": "c9678388",
   "kr": "무슨 일이지?"
  },
  "22": {
   "jp": "78ca62ab",
   "kr": "어째서 도망친 걸까."
  },
  "23": {
   "jp": "4dc7eb06",
   "kr": "우, 우, 우리…"
  },
  "24": {
   "jp": "e7afef1d",
   "kr": "우리는 하나도 안 수상해."
  },
  "25": {
   "jp": "96b62f10",
   "kr": "수상하고 뭐고, 없다고!"
  },
  "26": {
   "jp": "eff1b400",
   "kr": "뭐야…"
  },
  "27": {
   "jp": "8b0db5ed",
   "kr": "너희들"
  },
  "28": {
   "jp": "d663e91b",
   "kr": "이 저택 사람은 아니네."
  },
  "29": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "30": {
   "jp": "d40a12da",
   "kr": "우리한테 볼일 있어?"
  },
  "31": {
   "jp": "93081d0b",
   "kr": "딱히, 볼일은 없지만."
  },
  "32": {
   "jp": "d0e530a7",
   "kr": "갑자기 도망쳐서"
  },
  "33": {
   "jp": "a1804d98",
   "kr": "무슨 일인가 싶어서…"
  },
  "34": {
   "jp": "c7b2e065",
   "kr": "그렇지, 크리스?"
  },
  "35": {
   "jp": "f6eb2598",
   "kr": "그것뿐이지?"
  },
  "36": {
   "jp": "f172a96d",
   "kr": "그래."
  },
  "37": {
   "jp": "7d8cec84",
   "kr": "왜 도망친 거야?"
  },
  "38": {
   "jp": "caf57726",
   "kr": "어째서라니…"
  },
  "39": {
   "jp": "7903f55b",
   "kr": "딱히 이유 같은 건 없지만."
  },
  "40": {
   "jp": "5b09fa6f",
   "kr": "너희들이"
  },
  "41": {
   "jp": "4e169bd2",
   "kr": "갑자기 나타났으니까."
  },
  "42": {
   "jp": "fa92d2a5",
   "kr": "있잖아. 우리는 말이야."
  },
  "43": {
   "jp": "8e634aa8",
   "kr": "커다란 집을 보러 왔을 뿐인데."
  },
  "44": {
   "jp": "c1dd13bd",
   "kr": "병사가 무서운 얼굴로 노려봐."
  },
  "45": {
   "jp": "627ec6b8",
   "kr": "그래서 말이야."
  },
  "46": {
   "jp": "1b265039",
   "kr": "몰래 집 뒤로 돌아가서."
  },
  "47": {
   "jp": "618db1a1",
   "kr": "천천히 보고 있었어."
  },
  "48": {
   "jp": "01421366",
   "kr": "그야 저 병사가"
  },
  "49": {
   "jp": "8d84d4c7",
   "kr": "꼭 도둑 보는 듯한 눈으로"
  },
  "50": {
   "jp": "e05b8ae4",
   "kr": "우릴 보는걸."
  },
  "51": {
   "jp": "a6316fd2",
   "kr": "실례잖아."
  },
  "52": {
   "jp": "dc1bf9e6",
   "kr": "흐응."
  },
  "53": {
   "jp": "8f60abc7",
   "kr": "그랬구나."
  },
  "54": {
   "jp": "fb00b4af",
   "kr": "아무리 다츠가 가난한 마을이라도,"
  },
  "55": {
   "jp": "f489eee3",
   "kr": "우리는 남의 물건에"
  },
  "56": {
   "jp": "fa2c2bd3",
   "kr": "손대거나 하지 않아."
  },
  "57": {
   "jp": "8f7a1709",
   "kr": "이놈, 찾았다!"
  },
  "58": {
   "jp": "43f1ac49",
   "kr": "이런 데서"
  },
  "59": {
   "jp": "c6c6dcf7",
   "kr": "뭘 하고 있는 거냐."
  },
  "60": {
   "jp": "bbadcfe8",
   "kr": "관저 안을 얼쩡거리면"
  },
  "61": {
   "jp": "9ca68598",
   "kr": "안 된다고 했을 텐데!"
  },
  "62": {
   "jp": "14cfd8c6",
   "kr": "불법 침입으로 체포한다."
  },
  "63": {
   "jp": "42d2b12d",
   "kr": "잠깐 기다려요."
  },
  "64": {
   "jp": "5bd95504",
   "kr": "너무하잖아요."
  },
  "65": {
   "jp": "5f14e703",
   "kr": "맞아요. 맞아요."
  },
  "66": {
   "jp": "bb965e05",
   "kr": "저기, 너희를"
  },
  "67": {
   "jp": "9b5d662a",
   "kr": "이상한 눈으로 본 병사가"
  },
  "68": {
   "jp": "47fcd6cb",
   "kr": "이 사람이야?"
  },
  "69": {
   "jp": "635f23ca",
   "kr": "응, 이 병사야."
  },
  "70": {
   "jp": "8cbcad68",
   "kr": "뭐, 뭐야…?"
  },
  "71": {
   "jp": "d6ab67e3",
   "kr": "우린 저택 밖을 산책하고 있었을 뿐이잖아요."
  },
  "72": {
   "jp": "555c4e13",
   "kr": "애초에 애들한테 대고 다짜고짜 고함을"
  },
  "73": {
   "jp": "5744e4d9",
   "kr": "치다니, 어른이 할 짓이 아니잖아요!"
  },
  "74": {
   "jp": "5f14e703",
   "kr": "맞아요. 맞아요."
  },
  "75": {
   "jp": "a88ec72a",
   "kr": "윽… 앗… 그게…"
  },
  "76": {
   "jp": "96d5e24c",
   "kr": "도둑이… 아닐까 싶어서"
  },
  "77": {
   "jp": "ad508ea4",
   "kr": "좀 과민해져 있어서…"
  },
  "78": {
   "jp": "4f3bedc6",
   "kr": "그게 애초에 잘못이에요."
  },
  "79": {
   "jp": "a40ac29d",
   "kr": "그렇게 의심하는 눈으로 보니까"
  },
  "80": {
   "jp": "1ff9301c",
   "kr": "모르는 사이에"
  },
  "81": {
   "jp": "140f811e",
   "kr": "남의 마음을 다치게 하는 거예요."
  },
  "82": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "83": {
   "jp": "65755a5b",
   "kr": "이 아이들을,"
  },
  "84": {
   "jp": "d4cbc469",
   "kr": "처음부터 수상한 사람 보듯 하는 눈으로"
  },
  "85": {
   "jp": "1c9e4693",
   "kr": "봤죠?"
  },
  "86": {
   "jp": "f0b891cd",
   "kr": "당신은"
  },
  "87": {
   "jp": "6c1775f9",
   "kr": "이 두 사람에게 상처를 준 거예요."
  },
  "88": {
   "jp": "6c12c949",
   "kr": "엄청나게!!"
  },
  "89": {
   "jp": "7418b184",
   "kr": "죄, 죄송합니다…"
  },
  "90": {
   "jp": "cc0fa582",
   "kr": "흑…흑…흑…"
  },
  "91": {
   "jp": "6e964f31",
   "kr": "크리스의 지적에 반성한 챠놈 병사는"
  },
  "92": {
   "jp": "16d38bdd",
   "kr": "울음을 터뜨리고 말았다."
  },
  "93": {
   "jp": "0dbd4c6c",
   "kr": "알면 됐어요."
  },
  "94": {
   "jp": "2a2c249f",
   "kr": "가자, 쥬리오."
