  "95": {
   "jp": "bd7ad97b",
   "kr": "확실히 부유한 나라지만 어쩐지 이 나라는"
  },
  "96": {
   "jp": "a150bb8d",
   "kr": "내 성미에 안 맞나 봐."
  },
  "97": {
   "jp": "7dae1183",
   "kr": "응, 나도 그래."
  },
  "98": {
   "jp": "d678b6da",
   "kr": "고마워."
  },
  "99": {
   "jp": "ca08b5af",
   "kr": "아〜, 속 시원해."
  },
  "100": {
   "jp": "d5527c73",
   "kr": "있잖아. 고마워."
  },
  "101": {
   "jp": "efd1cffd",
   "kr": "괜찮아."
  },
  "102": {
   "jp": "80dc5830",
   "kr": "좀 심하게 말했나 봐."
  },
  "103": {
   "jp": "e0e2b7c9",
   "kr": "응, 심하게 말했어."
  },
  "104": {
   "jp": "9274bdc8",
   "kr": "울었잖아."
  },
  "105": {
   "jp": "eea7b281",
   "kr": "뭐야. 쥬리오는"
  },
  "106": {
   "jp": "3898f8c1",
   "kr": "맞아요, 맞아요"
  },
  "107": {
   "jp": "67948a94",
   "kr": "소리밖에 안 했으면서."
  },
  "108": {
   "jp": "e2f19316",
   "kr": "그야, 너무 이것저것 말하면"
  },
  "109": {
   "jp": "0a2215f7",
