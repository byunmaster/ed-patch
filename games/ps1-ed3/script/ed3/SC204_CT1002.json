  "1": {
   "jp": "8556fecd",
   "kr": "시트라"
  },
  "2": {
   "jp": "7b016304",
   "kr": "프레인"
  },
  "3": {
   "jp": "9ed7437c",
   "kr": "냅 촌장"
  },
  "4": {
   "jp": "b684746d",
   "kr": "리그레"
  },
  "5": {
   "jp": "b338fe8d",
   "kr": "바스레"
  },
  "6": {
   "jp": "5d2923e0",
   "kr": "키타라 악사 트로바"
  },
  "7": {
   "jp": "250b9531",
   "kr": "어째서 이리 잘 안 되는 겐가…"
  },
  "8": {
   "jp": "493e9981",
   "kr": "촌장님, 정신 차리세요!"
  },
  "9": {
   "jp": "fea45857",
   "kr": "어떡하지…"
  },
  "10": {
   "jp": "015f22c8",
   "kr": "다들 기운 나게 하려 했는데"
  },
  "11": {
   "jp": "26bf1d44",
   "kr": "반대로 가라앉게 하고 말았다."
  },
  "12": {
   "jp": "c2ade459",
   "kr": "이럴 게 아니었는데."
  },
  "13": {
   "jp": "f17b0dbe",
   "kr": "트로바 씨까지"
  },
  "14": {
   "jp": "276accef",
   "kr": "기운을 잃으면 안 되잖아요!"
  },
  "15": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "16": {
   "jp": "82dadd30",
   "kr": "여분의 현은 없어요?"
  },
  "17": {
   "jp": "ec88e752",
   "kr": "키타라 악사로서 부끄럽게도"
  },
  "18": {
   "jp": "0e23304a",
   "kr": "여분의 현을 다 써 버렸어…"
  },
  "19": {
   "jp": "ba05b1bf",
   "kr": "앗, 맞다!"
  },
  "20": {
   "jp": "bed2d728",
   "kr": "작년에 마을 외곽 크로와 할머니 집에"
  },
  "21": {
   "jp": "5a6759b0",
   "kr": "현을 두고 갔었지."
  },
  "22": {
   "jp": "33a01c9f",
   "kr": "하지만 1년이나 전 일이라서…"
  },
  "23": {
   "jp": "d89cea1d",
   "kr": "크로와 할머니요?"
  },
  "24": {
   "jp": "80ef6310",
   "kr": "알겠어요. 가 볼게요."
  },
  "25": {
   "jp": "a6ef296d",
   "kr": "…이제 틀렸습니다…"
  },
  "26": {
   "jp": "0b441c73",
   "kr": "역시 우린 희망조차 품어선 안 되는 게야."
  },
  "27": {
   "jp": "c99c5352",
   "kr": "짧은 꿈이었군…"
  },
  "28": {
   "jp": "5d1bcc4c",
   "kr": "하하."
  },
  "29": {
   "jp": "a427807f",
   "kr": "현실로 돌아가면 악취 나는 늪과"
  },
  "30": {
   "jp": "daa68f2a",
   "kr": "무너져 가는 이 집…"
  },
  "31": {
   "jp": "98c656d1",
   "kr": "어차피 꿈이야."
  },
  "32": {
   "jp": "1e73fa84",
   "kr": "크로와 할머니 집?"
  },
  "33": {
   "jp": "bba5a13a",
   "kr": "이 마을을 흐르는 강을 조금 거슬러 오르면"
  },
  "34": {
   "jp": "17f4e114",
   "kr": "두 강이 합류하고 있지."
  },
  "35": {
   "jp": "47046b9b",
   "kr": "그걸 오른쪽으로 따라가면 할머니 집일세."
  },
  "36": {
   "jp": "056f5190",
   "kr": "이것도 마녀의 저주려나…"
  },
  "37": {
   "jp": "269a65f7",
   "kr": "나도 이번엔 잘되려니 생각했는데."
  },
  "38": {
   "jp": "b16a191a",
   "kr": "아야야."
  },
  "39": {
   "jp": "a3de8ac9",
   "kr": "또 다리가 아파 오는구나."
  },
  "40": {
   "jp": "6d54011c",
   "kr": "너희들은 현이 끊어진 정도로"
  },
  "41": {
   "jp": "d45f8bc6",
   "kr": "한심하다고 생각하겠지?"
  },
  "42": {
   "jp": "b556c125",
   "kr": "하지만 말이야, 밑바닥에 있는 인간에겐"
  },
  "43": {
   "jp": "3db4452c",
   "kr": "커다란 충격이란 말이다."
  },
  "44": {
   "jp": "33606d1e",
   "kr": "…정말 중요한 때에"
  },
  "45": {
   "jp": "8db411f8",
   "kr": "그런 실수를 하다니…"
  }
 }
