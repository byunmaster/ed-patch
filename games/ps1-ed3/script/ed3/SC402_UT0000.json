   "kr": "끝나면 여기로 와 줘."
  },
  "172": {
   "jp": "689757e8",
   "kr": "조심하십시오."
  },
  "173": {
   "jp": "56782a64",
   "kr": "엇!"
  },
  "174": {
   "jp": "5b8d7982",
   "kr": "엥?"
  },
  "175": {
   "jp": "90038412",
   "kr": "뭐야, 뭐야?"
  },
  "176": {
   "jp": "a4846ed4",
   "kr": "(저기 여관 누나"
  },
  "177": {
   "jp": "5ec76214",
   "kr": "좀 괜찮네…)"
  },
  "178": {
   "jp": "a0c00c08",
   "kr": "저기 여관 언니가"
  },
  "179": {
   "jp": "a79c6810",
   "kr": "마음에 드는 거지?"
  },
  "180": {
   "jp": "db914bba",
   "kr": "윽!"
  },
  "181": {
   "jp": "361ccc6f",
   "kr": "그, 그런 거 아니라고."
  },
  "182": {
   "jp": "a153f1b9",
   "kr": "어차피 너희는"
  },
  "183": {
   "jp": "fe169b37",
   "kr": "마법의 거울을 보고 갈 거지?"
  },
  "184": {
   "jp": "cd37e8af",
   "kr": "그렇다면 나랑 모리슨은"
  },
  "185": {
   "jp": "058ea0c6",
   "kr": "이 여관에서 기다리는 게 낫겠다 싶어서."
  },
  "186": {
   "jp": "e3424497",
   "kr": "흐〜음."
  },
  "187": {
   "jp": "fb0ced63",
   "kr": "좀 궁색한 변명이지만"
  },
  "188": {
   "jp": "9bf27e3d",
   "kr": "그 말도 맞네."
  },
  "189": {
   "jp": "954ad11b",
   "kr": "그럼 일단은"
  },
  "190": {
   "jp": "d671b655",
   "kr": "여관에 자리를 잡는 것으로"
  },
  "191": {
   "jp": "1256f389",
   "kr": "하시지요."
  },
  "192": {
   "jp": "b1434644",
   "kr": "순례 온 나그네일세."
  },
  "193": {
   "jp": "b5578eb0",
   "kr": "샤리네에 가는 것을 허락했네."
  },
  "194": {
   "jp": "5671d2b7",
   "kr": "들여보내게."
  },
  "195": {
   "jp": "3acbac82",
   "kr": "네, 알겠습니다."
  },
  "196": {
   "jp": "48a0c078",
   "kr": "현자님."
  },
  "197": {
   "jp": "4b31d23e",
   "kr": "그럼, 내가 먼저."
  },
  "198": {
   "jp": "7e531639",
   "kr": "따라 오시게."
  },
  "199": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "200": {
   "jp": "14855215",
   "kr": "그럼 우리는 샤리네에 볼일 없으니까"
  },
  "201": {
   "jp": "e1726a51",
   "kr": "여관에서 시간이나 때울까?"
  },
  "202": {
   "jp": "50ce5722",
   "kr": "여관이지, 알았어."
  },
  "203": {
   "jp": "d404d228",
   "kr": "그럼 조심하십시오."
  },
  "204": {
   "jp": "ffb3145e",
   "kr": "현자님은 어디 계실까."
  },
  "205": {
   "jp": "a85e4db5",
   "kr": "시플 안에 계신 건"
  },
  "206": {
   "jp": "aaa920ed",
   "kr": "틀림없는 것 같은데…"
  },
  "207": {
   "jp": "21a95e49",
   "kr": "어디 가는데?"
  },
  "208": {
   "jp": "4151c872",
   "kr": "얼른 시플의 마법의 거울을"
  },
  "209": {
   "jp": "5d0abffb",
   "kr": "보러 가자."
  }
 }
