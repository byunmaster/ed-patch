{
 "archive": "/SCE4/SC401.DAT",
 "member": "..\\DATA\\UR2200.BIN",
 "lines": {
  "0": {
   "jp": "bc10f719",
   "kr": "그레이스산지"
  },
  "1": {
   "jp": "b13b4e29",
   "kr": "윽… 으〜음."
  },
  "2": {
   "jp": "09896491",
   "kr": "이상한데…"
  },
  "3": {
   "jp": "a3d1e990",
   "kr": "아까부터"
  },
  "4": {
   "jp": "8244314d",
   "kr": "몸이 나른하단 말이야."
  },
  "5": {
   "jp": "c8f7dc45",
   "kr": "설마?!"
  },
  "6": {
   "jp": "b5454d65",
   "kr": "카지무의 저주 탓인가…"
  },
  "7": {
   "jp": "f599f9bd",
   "kr": "설마…"
  },
  "8": {
   "jp": "c75d5df7",
   "kr": "이렇게 공들인 저주가"
  },
  "9": {
   "jp": "be9983fa",
   "kr": "세상에 어디 있어."
  },
  "10": {
   "jp": "6bc97bfb",
   "kr": "앗, 크리스. 괜찮아?"
  },
  "11": {
   "jp": "a0ad9869",
   "kr": "모리슨 씨."
  },
  "12": {
   "jp": "2bbd678e",
   "kr": "크리스 상태가 이상해요."
  },
  "13": {
   "jp": "0eb19e7c",
   "kr": "어떡하지…?"
  },
  "14": {
   "jp": "eb2805e4",
   "kr": "크리스는 괴로운 듯이"
  },
  "15": {
   "jp": "01840707",
   "kr": "미간을 찌푸리고 있다."
  },
  "16": {
   "jp": "bd795c18",
   "kr": "괜찮아, 크리스?"
  },
  "17": {
   "jp": "a9f34c6f",
   "kr": "그렇군…"
  },
  "18": {
   "jp": "0089960c",
   "kr": "카지무의 마지막 저주는"
  },
  "19": {
   "jp": "026b6e83",
   "kr": "올도스에 가까워질수록 악화되는"
  },
  "20": {
   "jp": "4fab58c9",
   "kr": "몸을 좀먹는 병이었나…"
  },
  "21": {
   "jp": "bc9942a7",
   "kr": "그, 그럼, 저기."
  },
  "22": {
   "jp": "950a492a",
   "kr": "시플까지 되돌아갈까?"
  },
  "23": {
   "jp": "c6544560",
   "kr": "올도스에서 멀어지면 낫는 거죠?"
  },
  "24": {
   "jp": "b1f5872d",
   "kr": "글쎄요…"
  },
  "25": {
   "jp": "7b848ba1",
   "kr": "안타깝지만"
  },
  "26": {
   "jp": "262b3bc1",
   "kr": "그건 단언할 수 없습니다."
  },
  "27": {
   "jp": "35caf5f0",
   "kr": "쥬리오, 난 괜찮아…"
  },
  "28": {
   "jp": "c41f03eb",
   "kr": "여기까지 왔으면"
  },
  "29": {
   "jp": "e05a7981",
   "kr": "올도스는 이제 코앞이야."
  },
  "30": {
   "jp": "3634c846",
   "kr": "되돌아가는 건 싫어."
  },
  "31": {
   "jp": "033c0fb9",
   "kr": "하지만…"
  },
  "32": {
   "jp": "ea80b6c7",
   "kr": "게다가 시플로 돌아가도"
  },
  "33": {
   "jp": "cbeca9d0",
   "kr": "올도스에 못 간다면"
  },
  "34": {
   "jp": "cb8a5c1b",
   "kr": "우리 여행은 끝나지 않아."
  },
  "35": {
   "jp": "5ffe47a5",
   "kr": "올도스인걸…"
  },
  "36": {
   "jp": "55f9b25e",
   "kr": "힘내서 올도스에 닿으면"
  },
  "37": {
   "jp": "58e29934",
   "kr": "분명 대단한 마법으로 치료해 주는"
  },
  "38": {
   "jp": "ecc05408",
   "kr": "의사 선생님도 있을 거야."
  },
  "39": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "40": {
   "jp": "3fba9792",
   "kr": "나도 크리스 의견에 찬성."
  },
  "41": {
   "jp": "0f498be0",
   "kr": "이유는 좀 다르지만."
  },
  "42": {
   "jp": "3caa2969",
   "kr": "이 저주 덕분에"
  },
  "43": {
   "jp": "f9679720",
   "kr": "카지무의 속셈을 알았어."
  },
  "44": {
   "jp": "13924798",
   "kr": "그놈은 너희를"
  },
  "45": {
   "jp": "5cc223e7",
   "kr": "올도스에 못 가게"
  },
  "46": {
   "jp": "f2dde6a5",
   "kr": "방해하려던 거야."
  },
  "47": {
   "jp": "d92566ab",
   "kr": "그렇군."
  },
  "48": {
   "jp": "58b96b46",
   "kr": "이유는 모르겠지만…"
  },
  "49": {
   "jp": "34b7e636",
   "kr": "분명 너희가 올도스에 가면"
  },
  "50": {
   "jp": "5fe187f8",
   "kr": "그놈들이 곤란해지는 거야."
  },
  "51": {
   "jp": "00a3cc10",
   "kr": "그러니까 샤리네에서 매복하거나"
  },
  "52": {
   "jp": "5a4cb9d0",
   "kr": "막판에 나랑 크리스에게"
  },
  "53": {
   "jp": "7e45ebf0",
   "kr": "저주를 건 거라고 봐."
  },
  "54": {
   "jp": "3434a925",
   "kr": "말하자면…"
  },
  "55": {
   "jp": "84a1997c",
   "kr": "여기서 되돌아가면"
  },
  "56": {
   "jp": "983e0973",
   "kr": "카지무가 노린 대로"
  },
  "57": {
   "jp": "96988fce",
   "kr": "흘러간다는 거지."
  },
  "58": {
   "jp": "244e4882",
   "kr": "마음에 안 들어."
  },
  "59": {
   "jp": "4adc184a",
   "kr": "지당하신 말씀이옵니다."
  },
  "60": {
   "jp": "b8199506",
   "kr": "크리스 님이 말씀하신 대로"
  },
  "61": {
   "jp": "72ffb79d",
   "kr": "올도스에는 챠펠 마법을 쓰는"
  },
  "62": {
   "jp": "8f671574",
   "kr": "명의도 있다고 들었습니다."
  },
  "63": {
   "jp": "c196bafd",
   "kr": "시플에 가도 희망은 없습니다."
  },
  "64": {
   "jp": "7466458b",
   "kr": "올도스로 가시지요."
  },
  "65": {
   "jp": "c196bafd",
   "kr": "시플에 가도 희망은 없습니다."
  },
  "66": {
   "jp": "7466458b",
   "kr": "올도스로 가시지요."
  }
 }
}