  "0": {
   "jp": "1f7ed7e9",
   "kr": "라그나"
  },
  "1": {
   "jp": "aa151e61",
   "kr": "선착장"
  },
  "2": {
   "jp": "233060aa",
   "kr": "수부 짐"
  },
  "3": {
   "jp": "27ab0f1b",
   "kr": "로저"
  },
  "4": {
   "jp": "94c78bc6",
   "kr": "테스"
  },
  "5": {
   "jp": "71933bc7",
   "kr": "구스"
  },
  "6": {
   "jp": "f0bf552a",
   "kr": "샤라"
  },
  "7": {
   "jp": "6333e2dc",
   "kr": "헤스톤"
  },
  "8": {
   "jp": "8ff882ae",
   "kr": "잠깐 기다려!"
  },
  "9": {
   "jp": "d5669452",
   "kr": "매발톱호에 탈 거라면 표를 보여 다오."
  },
  "10": {
   "jp": "4e54245c",
   "kr": "옷, 은단검인가!"
  },
  "11": {
   "jp": "22e365a8",
   "kr": "순례 여행자라면 표 따위 필요 없지."
  },
  "12": {
   "jp": "075c8b07",
   "kr": "슬슬 닐리를 향해 출항한다."
  },
  "13": {
   "jp": "86c4332f",
   "kr": "얼른 승선해 다오."
  },
  "14": {
   "jp": "c3d5f7c0",
   "kr": "자, 테스."
  },
  "15": {
   "jp": "45fe05c8",
   "kr": "먼저 올라가."
  },
  "16": {
   "jp": "5b82d0ff",
   "kr": "후후. 다정하네."
  },
  "17": {
   "jp": "83ed6f58",
   "kr": "수고했네."
  },
  "18": {
   "jp": "77aa6b70",
   "kr": "얼마 안 되지만 받아 두게."
  },
  "19": {
   "jp": "05ea3010",
   "kr": "괘, 괜찮습니까?"
  },
  "20": {
   "jp": "6ef1b5ff",
   "kr": "닐리까지 나를 실어다 주는"
  },
  "21": {
   "jp": "c7ed68b4",
   "kr": "자네들에게 하는 그나마의 감사 표시일세."
  },
  "22": {
   "jp": "c96ff152",
   "kr": "사양할 필요 없네."
  },
  "23": {
   "jp": "3507f81e",
   "kr": "그럼, 고맙게 받죠."
  },
  "24": {
   "jp": "30f74d17",
   "kr": "너 때문에"
  },
  "25": {
   "jp": "9fe9e9d7",
   "kr": "모처럼의 보물은 놓치질 않나"
  },
  "26": {
   "jp": "56a6da52",
   "kr": "길은 잃질 않나, 엉망진창이야!!"
  },
  "27": {
   "jp": "59d43d6a",
   "kr": "하늘은 두 가지를 안 준다잖아?"
  },
  "28": {
   "jp": "c931c54f",
   "kr": "난 미남이니까 조금쯤"
  },
  "29": {
   "jp": "050d873f",
   "kr": "모자라야 딱 좋은 거야."
  },
  "30": {
   "jp": "3a320f54",
   "kr": "보물을 떨어뜨리는 게"
  },
  "31": {
   "jp": "6a633ab6",
   "kr": "조금 모자란 정도라고!?"
  },
  "32": {
   "jp": "b9f5d08d",
   "kr": "눈앞에 미모와 지혜를 갖춘 여자가 있잖아."
  },
  "33": {
   "jp": "9c7a3319",
   "kr": "말버릇 조심하는 게 좋을걸."
  },
  "34": {
   "jp": "dbe52b49",
   "kr": "어디?"
  },
  "35": {
   "jp": "9f33f827",
   "kr": "됐어!"
  },
  "36": {
   "jp": "212f0b08",
   "kr": "얼른 배에 올라타는 거야!"
  },
  "37": {
   "jp": "62b7b586",
   "kr": "올해 마지막 닐리행이야."
  },
  "38": {
   "jp": "1950d549",
   "kr": "매발톱호 준비도 끝났고"
  },
  "39": {
   "jp": "1daf7955",
   "kr": "이제 출항만 기다리면 돼."
  },
  "40": {
   "jp": "23f99189",
   "kr": "오, 순례 떠나는 소년 소녀로군."
  },
  "41": {
   "jp": "48e5666a",
   "kr": "드디어 폴티아를 떠나 메나트로 들어가는군."
  },
  "42": {
   "jp": "0c85e31c",
   "kr": "자, 얼른 타라고."
  }
 }
}
