  "1": {
   "jp": "ff8af593",
   "kr": "홀크 병사"
  },
  "2": {
   "jp": "9bb56284",
   "kr": "베라트"
  },
  "3": {
   "jp": "845a2ab1",
   "kr": "칼리 왕비"
  },
  "4": {
   "jp": "f23bd255",
   "kr": "산적 아페고"
  },
  "5": {
   "jp": "6d0d3c7e",
   "kr": "산적 그네스"
  },
  "6": {
   "jp": "82bf0c0f",
   "kr": "산적 누라"
  },
  "7": {
   "jp": "138252df",
   "kr": "산적 콘타"
  },
  "8": {
   "jp": "125b1c76",
   "kr": "붙잡혔어."
  },
  "9": {
   "jp": "fea45857",
   "kr": "어떡하지…"
  },
  "10": {
   "jp": "dfd79062",
   "kr": "왕들은"
  },
  "11": {
   "jp": "ae16c8c0",
   "kr": "지금쯤 벌써 요새 밖에서"
  },
  "12": {
   "jp": "89a53b8f",
   "kr": "목이 빠지게 기다릴지도 몰라."
  },
  "13": {
   "jp": "177f81a9",
   "kr": "자자"
  },
  "14": {
   "jp": "9662a5f8",
   "kr": "서두르지 않아도 괜찮아요."
  },
  "15": {
   "jp": "50f4f37b",
   "kr": "어떻게든 되겠지요."
  },
  "16": {
   "jp": "b675c833",
   "kr": "그 아이들은 뭐 하는 자들이지…"
  },
  "17": {
   "jp": "f503490e",
   "kr": "내 계획을 눈치챈 모양이지만…"
  },
  "18": {
   "jp": "b86d8ae7",
   "kr": "뭐, 됐다."
  },
  "19": {
   "jp": "8f0a19f5",
   "kr": "어느 쪽이든"
  },
  "20": {
   "jp": "f7a3ab3e",
   "kr": "지금 소동을 일으키면 좋지 않다."
  },
  "21": {
   "jp": "aef17ccc",
   "kr": "이쪽 준비가 갖춰질 때까지는"
  },
  "22": {
   "jp": "4a885b09",
   "kr": "왕비와 함께"
  },
  "23": {
   "jp": "5b1809ff",
   "kr": "인질로 살려 둘까…"
  },
  "24": {
   "jp": "a96c9ccb",
   "kr": "됐어, 샤라."
  },
  "25": {
   "jp": "7b8e8c3a",
   "kr": "좋아, 와."
  },
  "26": {
   "jp": "0c1085cf",
   "kr": "알겠습죠, 누님."
  },
  "27": {
   "jp": "a4599d67",
   "kr": "앗… 이놈들."
  },
  "28": {
   "jp": "7dabaf88",
   "kr": "누가 한꺼번에 다 오랬어."
  },
  "29": {
   "jp": "5dafdb20",
   "kr": "미안하우, 누님."
  },
  "30": {
   "jp": "b62d7d5a",
   "kr": "미안혀."
  },
  "31": {
   "jp": "9ebf16d8",
   "kr": "헤헤헷."
  },
  "32": {
   "jp": "04c36fa7",
   "kr": "뭐 하는 거야… 저놈들."
  },
  "33": {
   "jp": "86488b34",
   "kr": "어이, 얼른 이쪽으로 와."
  },
  "34": {
   "jp": "a8499f17",
   "kr": "으윽!"
  },
  "35": {
   "jp": "689b42c4",
   "kr": "이놈들…"
  },
  "36": {
   "jp": "ec75c9ce",
   "kr": "한꺼번에 오지 말랬잖아."
  },
  "37": {
   "jp": "f3d15505",
   "kr": "또 저질렀네."
  },
  "38": {
   "jp": "5dafdb20",
   "kr": "미안하우, 누님."
  },
  "39": {
   "jp": "b62d7d5a",
   "kr": "미안혀."
  },
  "40": {
   "jp": "9ebf16d8",
   "kr": "헤헤헷."
  },
  "41": {
   "jp": "1c314b11",
   "kr": "알겠냐, 실수하지 마라."
  },
  "42": {
   "jp": "593b271f",
   "kr": "우리 첫 일거리다."
  },
  "43": {
   "jp": "d8d18cee",
   "kr": "헛발질하지 말라고."
  },
  "44": {
   "jp": "7936c872",
   "kr": "이런 데에 요새를 세우다니"
  },
  "45": {
   "jp": "b346a75c",
   "kr": "어차피 나쁜 꿍꿍이라도 꾸미고 있겠지."
  },
  "46": {
   "jp": "b8393b8d",
   "kr": "사양 말고 값나가는 걸 가져가자."
  },
  "47": {
   "jp": "570f6812",
   "kr": "알겠습죠."
  },
  "48": {
   "jp": "5c8c13b1",
   "kr": "요새라면 꽝은 없지."
  },
  "49": {
   "jp": "ce7ff6b5",
   "kr": "보물은 없어도"
  },
  "50": {
   "jp": "2793a6f0",
   "kr": "무기라면 잔뜩 있을 거다."
  },
  "51": {
   "jp": "de530ae3",
   "kr": "아무것도 없으면"
  },
  "52": {
   "jp": "4033a008",
   "kr": "무기를 받아서 팔아치우면 되니까."
  },
  "53": {
   "jp": "a162e984",
   "kr": "역시 형님이여."
  },
  "54": {
   "jp": "b2a933a9",
   "kr": "머리 좋구먼."
  },
  "55": {
   "jp": "d3c2e984",
   "kr": "그렇지."
  },
  "56": {
   "jp": "1ec4ad49",
   "kr": "나답지 않게 조사는 해 뒀거든."
  },
  "57": {
   "jp": "0a7f584a",
   "kr": "창고는 남서쪽 방이다."
  },
  "58": {
   "jp": "7264686d",
   "kr": "예습은 완벽하다고."
  },
  "59": {
   "jp": "943c43d3",
   "kr": "간다."
  },
  "60": {
   "jp": "c2aef283",
   "kr": "(앗…?!)"
  },
  "61": {
   "jp": "6771b7ca",
   "kr": "(젠장…)"
  },
  "62": {
   "jp": "ca114da4",
   "kr": "아야야야… 아파."
  },
  "63": {
   "jp": "ed306d71",
   "kr": "뭐냐?"
  },
  "64": {
   "jp": "bff5f0f8",
   "kr": "사람이 하늘에서 떨어졌다."
  },
  "65": {
   "jp": "7e3be0c1",
   "kr": "이놈, 누구냐?"
  },
  "66": {
   "jp": "eb4e7e96",
   "kr": "우아아아아앗!"
  },
  "67": {
   "jp": "461d4d16",
   "kr": "앗, 서라. 이놈!"
  },
  "68": {
   "jp": "51f157e1",
   "kr": "붙잡아라아!"
  },
  "69": {
   "jp": "89a88797",
   "kr": "저놈, 괜찮은 거냐…"
  },
  "70": {
   "jp": "03413709",
   "kr": "걱정 없습죠."
  },
  "71": {
   "jp": "02be2f32",
   "kr": "저놈, 발 하나는 빠릅죠."
  },
  "72": {
   "jp": "54535476",
   "kr": "쥬리오 같은 놈이네…"
  },
  "73": {
   "jp": "d28a8b25",
   "kr": "그럼, 괜찮겠군."
  },
  "74": {
   "jp": "cf0c335d",
   "kr": "좋은 미끼가 되지. 일을 계속하자고."
  }
 }
}