{
 "archive": "/SCE4/SC406.DAT",
 "member": "..\\DATA\\OT0500.BIN",
 "lines": {
  "0": {
   "jp": "044c0822",
   "kr": "대성당"
  },
  "1": {
   "jp": "a82af9b4",
   "kr": "샤리네"
  },
  "2": {
   "jp": "06a34a37",
   "kr": "대신관 덴켄"
  },
  "3": {
   "jp": "23967d51",
   "kr": "하늘의 샤리네에 잘 왔네."
  },
  "4": {
   "jp": "8e0194e6",
   "kr": "대신관님이야."
  },
  "5": {
   "jp": "cb3431a3",
   "kr": "어떡하지, 어떡하지…"
  },
  "6": {
   "jp": "93d0696d",
   "kr": "긴장돼…"
  },
  "7": {
   "jp": "628d70d1",
   "kr": "쥬리오 쭈뼛거리면 안 돼."
  },
  "8": {
   "jp": "c81421bb",
   "kr": "그치만 우릴 기다린 거잖아."
  },
  "9": {
   "jp": "cc73e043",
   "kr": "무, 무슨 용건일까"
  },
  "10": {
   "jp": "85cf6a8c",
   "kr": "무슨 용건일까…"
  },
  "11": {
   "jp": "4c892d6a",
   "kr": "제대로 인사드리자."
  },
  "12": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "13": {
   "jp": "b5ac783e",
   "kr": "순례 여행으로"
  },
  "14": {
   "jp": "673817d8",
   "kr": "폴티아의 라그픽 마을에서 왔습니다."
  },
  "15": {
   "jp": "607f0e63",
   "kr": "크리스입니다."
  },
  "16": {
   "jp": "0d6e3ff0",
   "kr": "쥬리오예요."
  },
  "17": {
   "jp": "c145943f",
   "kr": "잘 왔네."
  },
  "18": {
   "jp": "821f8235",
   "kr": "덴켄일세."
  },
  "19": {
   "jp": "79b7779e",
   "kr": "기다리고 있었네."
  },
  "20": {
   "jp": "c4dc353e",
   "kr": "저, 저기…"
  },
  "21": {
   "jp": "18edd103",
   "kr": "저희가 오늘 여기 올 걸"
  },
  "22": {
   "jp": "a58ea45c",
   "kr": "알고 계셨어요?"
  },
  "23": {
   "jp": "0cb06bb9",
   "kr": "아니다."
  },
  "24": {
   "jp": "db1d75fe",
   "kr": "자네들이라는 것은"
  },
  "25": {
   "jp": "69f61ad7",
   "kr": "알지 못했네."
  },
  "26": {
   "jp": "dd868222",
   "kr": "어떤 이가 찾아올지는"
  },
  "27": {
   "jp": "ad098b10",
   "kr": "알지 못했네만"
  },
  "28": {
   "jp": "6f9f85b7",
   "kr": "오늘 나타날 줄 알고 있었네."
  },
  "29": {
   "jp": "bde61a74",
   "kr": "그리고 지금"
  },
  "30": {
   "jp": "54bbcad9",
   "kr": "그것이 자네들이라는 것이"
  },
  "31": {
   "jp": "d92994e3",
   "kr": "뚜렷해진 것이라네."
  },
  "32": {
   "jp": "ed4bd12b",
   "kr": "대체 저희한테"
  },
  "33": {
   "jp": "65ff45d4",
   "kr": "어떤 볼일이 있으신가요?"
  },
  "34": {
   "jp": "0867c73f",
   "kr": "이 거울에서 무엇이 보였는지 알려 주게."
  },
  "35": {
   "jp": "6b47ce11",
   "kr": "마법의 거울은 보는 이에 따라"
  },
  "36": {
   "jp": "b933eff8",
   "kr": "다른 것을 비추네."
  },
  "37": {
   "jp": "5528c341",
   "kr": "자네들이라면"
  },
  "38": {
   "jp": "619156b4",
   "kr": "지금 필요로 하는 메시지를"
  },
  "39": {
   "jp": "689585ef",
   "kr": "받을 수 있을 것이네."
  },
  "40": {
   "jp": "6cea1a14",
   "kr": "어, 저기…"
  },
  "41": {
   "jp": "ce3ce795",
   "kr": "뭔가 중대한 일 같은데요."
  },
  "42": {
   "jp": "988acadd",
   "kr": "저희는"
  },
  "43": {
   "jp": "f28d6b20",
   "kr": "그저 순례하는 나그네예요…"
  },
  "44": {
   "jp": "db4b7754",
   "kr": "뭔가 잘못된 게 아닐까요?"
  },
  "45": {
   "jp": "f767b9c2",
   "kr": "틀린 게 아니라고 해도 갑작스러우니"
  },
  "46": {
   "jp": "de8c896c",
   "kr": "이해하기 어려운 것도"
  },
  "47": {
   "jp": "7d989665",
   "kr": "무리가 아니지…"
  },
  "48": {
   "jp": "ed2692c2",
   "kr": "차근차근 이야기해 주지."
  },
  "49": {
   "jp": "3fccb76a",
   "kr": "뭐, 이리로 오시게."
  },
  "50": {
   "jp": "3b107d73",
   "kr": "나는 이곳의 마법의 거울을 매일 보고 있네."
  },
  "51": {
   "jp": "c920a441",
   "kr": "그것이 소임이니 말이야…"
  },
  "52": {
   "jp": "66d7d1a8",
   "kr": "마법의 거울의 영상을 보고"
  },
  "53": {
   "jp": "b0c1f8b7",
   "kr": "세상의 흐름을 점치고"
  },
  "54": {
   "jp": "14a4b3d4",
   "kr": "사람들의 삶을 돕기 위해서지."
  },
  "55": {
   "jp": "955adaee",
   "kr": "그런데 반년쯤 전부터네."
  },
  "56": {
   "jp": "1fd77796",
   "kr": "마법의 거울이 불길한 영상을 비췄네."
  },
  "57": {
   "jp": "e36dc407",
   "kr": "소용돌이치는 어둠, 가루가의 습격."
  },
  "58": {
   "jp": "92db6969",
   "kr": "그리고 별들을 삼키는"
  },
  "59": {
   "jp": "61f76119",
   "kr": "사악한 요기를 뿜는 검은 옷의 사내…"
  },
  "60": {
   "jp": "5c63f0f0",
   "kr": "분명히"
  },
  "61": {
   "jp": "424a550c",
   "kr": "앞으로 닥칠 대규모 재앙의 징조가 분명하네."
  },
  "62": {
   "jp": "4b855a84",
   "kr": "저, 저희가"
  },
  "63": {
   "jp": "bb40126c",
   "kr": "샤리네 거울에서 본 것과 똑같아요…"
  },
  "64": {
   "jp": "18e53e60",
   "kr": "세계에 흩어져 있는 샤리네는"
  },
  "65": {
   "jp": "862ae920",
   "kr": "올도스의 하늘의 샤리네와 이어져"
  },
  "66": {
   "jp": "2cf01f3c",
   "kr": "있는 것이네."
  },
  "67": {
   "jp": "c3e0d7c7",
   "kr": "그리고 그 길을 따라온 자네들은"
  },
  "68": {
   "jp": "b24bff9e",
   "kr": "이곳 마법의 거울에서 지금껏 본 네 거울의"
  },
  "69": {
   "jp": "0cfbe7db",
   "kr": "종합적인 답을 얻을 수 있네."
  },
  "70": {
   "jp": "c2eb5e7e",
   "kr": "저희한테만 답이 보이나요?"
  },
  "71": {
   "jp": "053b005e",
   "kr": "그렇네."
  },
  "72": {
   "jp": "2b969c43",
   "kr": "즉 걸어온 자에게만"
  },
  "73": {
   "jp": "4ac3ce90",
   "kr": "답이 있는 게지."
  },
  "74": {
   "jp": "8a5189fa",
   "kr": "우리가 아무리 속을 태워도"
  },
  "75": {
   "jp": "9021b1fb",
   "kr": "마법의 거울은 대답해 주지 않네."
  },
  "76": {
   "jp": "9efde760",
   "kr": "아무리 사악한 사태가 다가오고 있음을"
  },
  "77": {
   "jp": "a4dbc444",
   "kr": "알고 있어도 구체적인 건 무엇 하나"
  },
  "78": {
   "jp": "4f6dec2a",
   "kr": "알 방도가 없는 것이네."
  },
  "79": {
   "jp": "9b827d71",
   "kr": "대신관님, 잘 알겠습니다."
  },
  "80": {
   "jp": "b63f54d0",
   "kr": "저희가 마법의 거울을 보고"
  },
  "81": {
   "jp": "0da33026",
   "kr": "무엇이 보였는지 알려 드리면 되는 거군요."
  },
  "82": {
   "jp": "2af0c987",
   "kr": "으음."
  },
  "83": {
   "jp": "75d1e8bf",
   "kr": "그러면 무슨 일이 일어날지 알 수 있고"
  },
  "84": {
   "jp": "6ff96a83",
   "kr": "대책도 마련할 수 있네."
  },
  "85": {
   "jp": "777db2d4",
   "kr": "그럼, 어서"
  },
  "86": {
   "jp": "9622e4aa",
   "kr": "마법의 거울을 봐 주겠는가."
  },
  "87": {
   "jp": "3acbac82",
   "kr": "네, 알겠습니다."
  },
  "88": {
   "jp": "b5b2fe87",
   "kr": "그치만"
  },
  "89": {
   "jp": "5be5672d",
   "kr": "왜 저희가 올 걸"
  },
  "90": {
   "jp": "9677de07",
   "kr": "아셨어요?"
  },
  "91": {
   "jp": "5ed3b496",
   "kr": "며칠 전 마법의 거울에서"
  },
  "92": {
   "jp": "f11dea9c",
   "kr": "계시를 받았네."
  },
  "93": {
   "jp": "27a8b55c",
   "kr": "예로부터의 순례에 따라"
  },
  "94": {
   "jp": "7c83bef1",
   "kr": "네 샤리네를 돌아"
  },
  "95": {
   "jp": "c0c97f36",
   "kr": "이 올도스에 도착하는 자가 있으리라고."
  },
  "96": {
   "jp": "c7b2e065",
   "kr": "저기, 크리스."
  },
  "97": {
   "jp": "069e4bf8",
   "kr": "왠지 우리"
  },
  "98": {
   "jp": "00177d21",
   "kr": "선택받은 용사 같아."
  },
  "99": {
   "jp": "68c90481",
   "kr": "무슨 소리야."
  },
  "100": {
   "jp": "6d97d615",
   "kr": "용사니 영웅이니 하는 건"
  },
  "101": {
   "jp": "cee0ba19",
   "kr": "훨씬 더 멋진 사람이라고."
  },
  "102": {
   "jp": "92d9c191",
   "kr": "칫."
  },
  "103": {
   "jp": "3b99dccd",
   "kr": "조금 우쭐해졌던"
  },
  "104": {
   "jp": "acec08ef",
   "kr": "참인데…"
  },
  "105": {
   "jp": "69e92c9a",
   "kr": "선택된 자가 아니라"
  },
  "106": {
   "jp": "de2dc239",
   "kr": "메시지를 받을 수 있는 자라고"
  },
  "107": {
   "jp": "7e882a86",
   "kr": "이해해 주었으면 하네."
  },
  "108": {
   "jp": "b173bb65",
   "kr": "하지만 드물게 없는"
  },
  "109": {
   "jp": "b02cdcd1",
   "kr": "중요한 역할을 운명지어진 분들임에"
  },
  "110": {
   "jp": "6fda1111",
   "kr": "변함은 없네."
  },
  "111": {
   "jp": "9c106ba2",
   "kr": "왠지."
  },
  "112": {
   "jp": "87d8e0a8",
   "kr": "의식하니까 긴장되기 시작했어…"
  },
  "113": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "114": {
   "jp": "39ae54af",
   "kr": "어쨌든 마법의 거울을 보자."
  },
  "115": {
   "jp": "d5433f0e",
   "kr": "(크리스는…)"
  },
  "116": {
   "jp": "dde9cb3c",
   "kr": "(이럴 때는 유난히 불타오른단 말이지…)"
  },
  "117": {
   "jp": "8f8ad548",
   "kr": "자, 가자!"
  },
  "118": {
   "jp": "2da61d1e",
   "kr": "신기해…"
  },
  "119": {
   "jp": "343a5e9c",
   "kr": "영상만이 아니라"
  },
  "120": {
   "jp": "e1d5fda0",
   "kr": "소리도? 말인 걸까…"
  },
  "121": {
   "jp": "682957af",
   "kr": "뭔가 들린 것 같아."
  },
  "122": {
   "jp": "e31026d6",
   "kr": "나도 들렸어."
  },
  "123": {
   "jp": "f9bcb558",
   "kr": "라…우…알…이라고."
  },
  "124": {
   "jp": "e2fbc7bb",
   "kr": "역시 쥬리오도 들렸구나."
  },
  "125": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "126": {
   "jp": "6a630fd4",
   "kr": "라-우-알이라니 뭘까?"
  },
  "127": {
   "jp": "2eff173d",
   "kr": "전혀 모르겠어."
  },
  "128": {
   "jp": "ed6192bb",
   "kr": "그보다"
  },
  "129": {
   "jp": "73c5e32e",
   "kr": "저 문장… 봤어?"
  },
  "130": {
   "jp": "2585b32e",
   "kr": "폴티아의 문장이야."
  },
  "131": {
   "jp": "5b92562e",
   "kr": "그렇다면 저 성은 폴티아의 루드성?"
  },
  "132": {
   "jp": "ac4b26a2",
   "kr": "가 본 적은 없지만…"
  },
  "133": {
   "jp": "a8ad16fb",
   "kr": "분명 그렇지 않을까."
  },
  "134": {
   "jp": "5b76464b",
   "kr": "전쟁을 시작할 생각인 걸까…"
  },
  "135": {
   "jp": "89a36139",
   "kr": "병사가 잔뜩 모여 있었지."
  },
  "136": {
   "jp": "64e2ce5e",
   "kr": "그러고 보니"
  },
  "137": {
   "jp": "28919057",
   "kr": "폴티아군이 병사를"
  },
  "138": {
   "jp": "e712a178",
   "kr": "모으고 있었어."
  },
  "139": {
   "jp": "c160d718",
   "kr": "게다가 마법사 같은"
  },
  "140": {
   "jp": "249ac6ac",
   "kr": "수상한 놈도 보였어."
  },
  "141": {
   "jp": "f5c072c2",
   "kr": "응. 성 안인가?"
  },
  "142": {
   "jp": "5a108fff",
   "kr": "어딘가 천장에 빛나는 구슬을 올리고 있었어."
  },
  "143": {
   "jp": "f0f48ca0",
   "kr": "뭘까…"
  },
  "144": {
   "jp": "3f4f3d35",
   "kr": "우리끼리 생각해도"
  },
  "145": {
   "jp": "2a9188ec",
   "kr": "잘 모르겠어."
  },
  "146": {
   "jp": "516fcdc0",
   "kr": "대신관님께 이야기해 보자."
  }
 }
}