{
 "archive": "/SCE0/SC000.DAT",
 "member": "..\\DATA\\FT0101.BIN",
 "lines": {
  "0": {
   "jp": "bb708123",
   "kr": "라그픽 마을"
  },
  "1": {
   "jp": "1df824f5",
   "kr": "마을 어귀"
  },
  "2": {
   "jp": "ea39b3fe",
   "kr": "여행자"
  },
  "3": {
   "jp": "a417cb4e",
   "kr": "음유시인"
  },
  "4": {
   "jp": "8ef96780",
   "kr": "톨타 촌장"
  },
  "5": {
   "jp": "0b8d576a",
   "kr": "로그"
  },
  "6": {
   "jp": "89ecea13",
   "kr": "라프 할아버지"
  },
  "7": {
   "jp": "7b7c2d71",
   "kr": "쳇."
  },
  "8": {
   "jp": "823c3423",
   "kr": "조심해, 영감!"
  },
  "9": {
   "jp": "7d6a0292",
   "kr": "하마터면 절벽에서 떨어질 뻔했잖아."
  },
  "10": {
   "jp": "9401cdfa",
   "kr": "서둘러, 구스!"
  },
  "11": {
   "jp": "3e6f4e20",
   "kr": "원 참… 험악한 놈들이군."
  },
  "12": {
   "jp": "c04dc287",
   "kr": "뭘 그리 허둥대는 게야."
  },
  "13": {
   "jp": "ff3ef341",
   "kr": "… 응?"
  },
  "14": {
   "jp": "0c5be871",
   "kr": "정말이지…"
  },
  "15": {
   "jp": "cc5c63d9",
   "kr": "이런 값나가 보이는 단검을 떨구고 갔구먼."
  },
  "16": {
   "jp": "4d8a9f27",
   "kr": "어이〜!"
  },
  "17": {
   "jp": "78c522a3",
   "kr": "허, 벌써 안 보이는군…"
  },
  "18": {
   "jp": "f64c3a94",
   "kr": "라프 할아버지!"
  },
  "19": {
   "jp": "4aaf315b",
   "kr": "무슨 일이냐, 쥬리오?"
  },
  "20": {
   "jp": "8963b939",
   "kr": "크리스까지 안색이 변해서."
  },
  "21": {
   "jp": "d9211c15",
   "kr": "음유시인이 여행자랑,"
  },
  "22": {
   "jp": "e44fe3b9",
   "kr": "노래하던 도둑이 한패였어!"
  },
  "23": {
   "jp": "3f2bce22",
   "kr": "무, 무슨 소리를 하는 게냐?"
  },
  "24": {
   "jp": "3a726b8e",
   "kr": "좀 진정하거라."
  },
  "25": {
   "jp": "64604a4b",
   "kr": "정말! 쥬리오가 말하면"
  },
  "26": {
   "jp": "aeb14215",
   "kr": "무슨 소린지 알 수가 없다니까."
  },
  "27": {
   "jp": "7ef86e50",
   "kr": "방금 그 사람들이 은단검을 훔쳐 갔어!"
  },
  "28": {
   "jp": "5ba0db8d",
   "kr": "이런! 큰일이구나."
  },
  "29": {
   "jp": "47c9bff0",
   "kr": "라프 할아버지. 그건…?"
  },
  "30": {
   "jp": "cbc7a28c",
   "kr": "오, 이거 말이냐."
  },
  "31": {
   "jp": "42ef969c",
   "kr": "아까 그 여행자가 나와 스쳐 지날 때"
  },
  "32": {
   "jp": "1d8dc6d6",
   "kr": "떨구고 간 게다."
  },
  "33": {
   "jp": "0b769f73",
   "kr": "그거, 은단검 아니야…"
  },
  "34": {
   "jp": "bcfb54c3",
   "kr": "이런! 어쩐지 어디서 본 적이 있다 했더니."
  },
  "35": {
   "jp": "ec46264d",
   "kr": "아, 아니. 실은 그 애송이가 틈을 보이기에"
  },
  "36": {
   "jp": "d42020b5",
   "kr": "재빨리 빼앗아 뒀단다."
  },
  "37": {
   "jp": "65e908e9",
   "kr": "말도 잘하셔."
  },
  "38": {
   "jp": "67c46de7",
   "kr": "그래도 은단검이 무사해서 다행이야."
  },
  "39": {
   "jp": "8f7461b0",
   "kr": "고마워, 라프 할아버지."
  },
  "40": {
   "jp": "876236ab",
   "kr": "아니, 별거 아니다."
  },
  "41": {
   "jp": "4d0da4f7",
   "kr": "늦었나…"
  },
  "42": {
   "jp": "6485fadc",
   "kr": "안심하게."
  },
  "43": {
   "jp": "95d3f71e",
   "kr": "자, 이렇게."
  },
  "44": {
   "jp": "206e2d50",
   "kr": "수여식에 필요하지 않겠느냐?"
  },
  "45": {
   "jp": "f1e53431",
   "kr": "가져가거라."
  },
  "46": {
   "jp": "6d07b348",
   "kr": "라프 할아버지, 대체 어떻게?"
  },
  "47": {
   "jp": "ad9df04e",
   "kr": "음. 덤벼든 애송이의 멱살을"
  },
  "48": {
   "jp": "cdd60176",
   "kr": "이렇게, 덥석 잡고서는"
  },
  "49": {
   "jp": "fea10cc2",
   "kr": "단숨에 쿵, 하고."
  },
  "50": {
   "jp": "811bab09",
   "kr": "쥬리오, 크리스티나."
  },
  "51": {
   "jp": "645b3d5a",
   "kr": "출발할 시간이다."
  },
  "52": {
   "jp": "425d8961",
   "kr": "은단검 수여식을 치러야지."
  },
  "53": {
   "jp": "499e7dd8",
   "kr": "무엇보다 은단검이 무사해서 다행이다."
  },
  "54": {
   "jp": "e9bd22c6",
   "kr": "자, 마을로 돌아가자."
  },
  "55": {
   "jp": "04bd686c",
   "kr": "이런, 사람 말은 끝까지 듣거라!"
  },
  "56": {
   "jp": "901f48cd",
   "kr": "라프 할아버지."
  },
  "57": {
   "jp": "5226fa62",
   "kr": "거짓말은 좀 더 능숙하게 해야지."
  },
  "58": {
   "jp": "b47d3fe3",
   "kr": "흥."
  }
 }
}