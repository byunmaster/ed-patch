  },
  "4": {
   "jp": "898074d7",
   "kr": "조리장"
  },
  "5": {
   "jp": "d850ce56",
   "kr": "수배서가 2통 있습니다."
  },
  "6": {
   "jp": "bc92270e",
   "kr": "어느 걸 볼까요?"
  },
  "7": {
   "jp": "4fe14c4f",
   "kr": "루드에서 온 수배서"
  },
  "8": {
   "jp": "fd4c299b",
   "kr": "넬바에서 온 수배서"
  },
  "9": {
   "jp": "e91a647f",
   "kr": "《젊은 남녀 2인조 절도범》"
  },
  "10": {
   "jp": "6eaf496e",
   "kr": "절도범 86호(남) 87호(여)"
  },
  "11": {
   "jp": "04f87ccc",
   "kr": "성명은 모두 불명이나 늘 둘이서 움직인다."
  },
  "12": {
   "jp": "98588d9f",
   "kr": "미남미녀 콤비."
  },
  "13": {
   "jp": "761838c2",
   "kr": "여자는 변장 남자는 빈집털이에 능하다."
  },
  "14": {
   "jp": "eaa370af",
   "kr": "입이 화근이라 미수가 많다."
  },
  "15": {
   "jp": "122fbfb9",
   "kr": "《절도범 A-14호(남)》"
  },
  "16": {
   "jp": "505ddbaa",
   "kr": "중년 신사로 변장해 절도를 거듭하고 있다."
  },
  "17": {
   "jp": "c3297330",
   "kr": "행동은 기본적으로 혼자 하지만"
  },
  "18": {
   "jp": "407a4ca0",
   "kr": "배후에는 조직이 관련된 듯하다."
  },
  "19": {
   "jp": "a7a99503",
   "kr": "계획 범죄에 능하고, 조심성 많다."
  },
  "20": {
   "jp": "a5a18059",
   "kr": "수면제를 쓴 범행이 보고되어 있다."
  },
  "21": {
   "jp": "c9144d30",
   "kr": "《항해일지 1일째》"
  },
  "22": {
   "jp": "194ad047",
   "kr": "드디어 올해 항해도 이것으로 끝이다."
  },
  "23": {
   "jp": "f7aadf94",
   "kr": "유빙의 계절이 다가오고 있다."
  },
  "24": {
   "jp": "ffbaf2a4",
   "kr": "닐리에서 돌아 라그나로 가면 겨울 휴가다."
  },
  "25": {
   "jp": "4d59ffce",
   "kr": "올해 마지막 항해에 어울리는 손님이 탔다."
  },
  "26": {
   "jp": "0fb6f98d",
   "kr": "순례 여행자 쥬리오 군과 크리스 양이다."
  },
  "27": {
   "jp": "aa865a89",
   "kr": "이번 항해도 멋지게 해내겠다."
  },
  "28": {
   "jp": "8ade2c1b",
   "kr": "《항해일지 2일째》"
  },
  "29": {
   "jp": "8ac56f6f",
   "kr": "오늘도 날씨는 나무랄 데 없다."
  },
  "30": {
   "jp": "345ccaff",
   "kr": "순례 여행자 쥬리오 군도 크리스 양도,"
  },
  "31": {
   "jp": "cdc67e16",
   "kr": "일 잘하는 착한 아이들이다."
  },
  "32": {
   "jp": "796d4169",
   "kr": "이 속도라면 예정대로 사흘째"
  },
  "33": {
   "jp": "16fb50d9",
   "kr": "새벽엔 닐리에 닿겠지."
  },
  "34": {
   "jp": "e90836db",
   "kr": "순례 여행자에게 축복 있으라!"
  },
  "35": {
   "jp": "966f030c",
   "kr": "그건 그렇고, 이등 선실의 두 사람은"
  },
  "36": {
   "jp": "c9d2172f",
   "kr": "한 번도 선실에서 모습을 보이지 않는다."
  },
  "37": {
   "jp": "8dab2755",
   "kr": "부끄럼쟁이인 걸까…"
  },
  "38": {
   "jp": "b7d928b5",
   "kr": "쥬리오는 티라스일 항해도를 봤습니다."
  },
  "39": {
   "jp": "55fa3ede",
   "kr": "이런 거 볼 때가 아니지."
  },
  "40": {
   "jp": "7923b9a9",
   "kr": "zzz…"
  },
  "41": {
   "jp": "aef3d533",
   "kr": "좋은..느낌으로…"
  },
  "42": {
   "jp": "e24e74fb",
   "kr": "됐… 음냐."
  },
  "43": {
   "jp": "dfb05dd3",
   "kr": "조리장님까지 잠들어 있어."
  },
  "44": {
   "jp": "cfa273b2",
   "kr": "어째서 다들 잠들어 버린 거야?"
  },
  "45": {
   "jp": "7923b9a9",
   "kr": "zzz…."
  },
  "46": {
   "jp": "eb91f7b4",
   "kr": "쿨쿨…"
  },
  "47": {
   "jp": "208ae5f2",
   "kr": "역시 누가 재운 거네."
  },
  "48": {
   "jp": "0f72e8e4",
   "kr": "…잠깐만!"
  },
  "49": {
   "jp": "a3101d8e",
   "kr": "그렇다는 건…"
  },
  "50": {
   "jp": "d41dd987",
   "kr": "배 조종은 누가 하고 있는 거야?"
  },
  "51": {
   "jp": "9b938a9a",
   "kr": "누가라니…"
  },
  "52": {
   "jp": "3ab047ab",
   "kr": "다들 자고 있는걸."
  },
  "53": {
   "jp": "6e46b2f7",
   "kr": "어떻게든 해야 해!"
  },
  "54": {
   "jp": "16ee826d",
   "kr": "배가 항로를 벗어나 버려."
  },
  "55": {
   "jp": "ac4722d3",
   "kr": "하지만, 크리스."
  },
  "56": {
   "jp": "c07318d2",
   "kr": "범인을 잡는 게 먼저야."
  },
  "57": {
   "jp": "b1af7a3d",
   "kr": "지금이라면 도둑맞은 걸"
  },
  "58": {
   "jp": "93e34405",
   "kr": "되찾을 수 있을지도 몰라."
  },
  "59": {
   "jp": "62d76bf4",
   "kr": "그런 말 해 놓고"
  },
  "60": {
   "jp": "a71ad7a1",
   "kr": "쥬리오는 범인이 누군지 알고 있는 거야?"
  },
  "61": {
   "jp": "07003008",
   "kr": "응, 대충은."
  },
  "62": {
   "jp": "13939888",
   "kr": "정말이야? 좀 정리해 보자."
  },
  "63": {
   "jp": "0d54c5cf",
   "kr": "깰 것 같지 않네."
  },
  "64": {
   "jp": "7782ae37",
   "kr": "쥬리오"
  },
  "65": {
   "jp": "a356fb7a",
   "kr": "범인이 누군지 생각해 볼래?"
  },
  "66": {
   "jp": "d7997c33",
   "kr": "뭐야, 모르겠어?"
  },
  "67": {
   "jp": "3c2abd55",
   "kr": "조금 있다가 여기 와서 생각해 보자."
  },
  "68": {
   "jp": "6eec54fc",
   "kr": "그럼, 시작할게."
  },
  "69": {
   "jp": "4e67ff26",
   "kr": "범인의 목적은 뭐라고 봐?"
  },
  "70": {
   "jp": "f174ac96",
   "kr": "매발톱호를 탈취하는 것"
  },
  "71": {
   "jp": "55636978",
   "kr": "손님의 물건을 훔치는 것"
  },
  "72": {
   "jp": "4967ebab",
   "kr": "엇? 그만두는 거야?"
  },
  "73": {
   "jp": "39976205",
   "kr": "범인은 뭘 훔쳤더라?"
  },
  "74": {
   "jp": "b8052110",
   "kr": "코트와 시계"
  },
  "75": {
   "jp": "669fe01e",
   "kr": "금 브로치"
  },
  "76": {
   "jp": "fd36049a",
   "kr": "주방의 생선"
  },
  "77": {
   "jp": "c66f69dd",
   "kr": "앞 질문이 신경 쓰여?"
  },
  "78": {
   "jp": "c45bb2ef",
   "kr": "어떻게 다들 잠재운 거야?"
  },
  "79": {
   "jp": "efa1689f",
   "kr": "럼주로 취하게 했다"
  },
  "80": {
   "jp": "4634fe13",
   "kr": "수면 마법을 썼다"
  },
  "81": {
   "jp": "db6350eb",
   "kr": "홍차에 최면제를 탔다"
  },
  "82": {
   "jp": "7b7aa4dd",
   "kr": "좋아."
  },
  "83": {
   "jp": "3e9f6de9",
   "kr": "바로 앞 질문 말이지?"
  },
  "84": {
   "jp": "1cca40d1",
   "kr": "쥬리오, 그래서 범인은 누구?"
  },
  "85": {
   "jp": "bcb1fe79",
   "kr": "모습을 보이지 않는 수상한 2인조"
  },
  "86": {
   "jp": "b771d38c",
   "kr": "밀항한 허크 삼촌"
  },
  "87": {
   "jp": "ab5a415e",
   "kr": "부자 헤스톤 씨"
  },
  "88": {
   "jp": "a254af1d",
   "kr": "신혼부부 로저&테스"
  },
  "89": {
   "jp": "b28d115b",
   "kr": "헷갈리는 거야?"
  },
  "90": {
   "jp": "457f44d0",
   "kr": "그럴까."
  },
  "91": {
   "jp": "4d243bbc",
   "kr": "하지만 그 두 사람은 한 번도"
  },
  "92": {
   "jp": "b38935b8",
   "kr": "선실에서 안 나왔어."
  },
  "93": {
   "jp": "3d04733a",
   "kr": "아무리 수상해도"
  },
  "94": {
   "jp": "58830668",
   "kr": "그건 무리 아니야?"
  },
  "95": {
   "jp": "6328d3ac",
   "kr": "저런 아저씨라도 내 삼촌이야!"
  },
  "96": {
   "jp": "956ef5db",
   "kr": "계속 방에 갇혀 있었잖아!"
  },
  "97": {
   "jp": "4ee5ed2d",
   "kr": "허크 삼촌은 아니야."
  },
  "98": {
   "jp": "237fd85a",
   "kr": "쥬리오, 대단해!"
  },
  "99": {
   "jp": "ee9167b3",
   "kr": "그럼 저 헤스톤 씨가"
  },
  "100": {
   "jp": "5b9ba0ad",
   "kr": "수배서에 있던 A-14호!"
  },
  "101": {
   "jp": "d17106df",
   "kr": "그러고 보니… 분명"
  },
  "102": {
   "jp": "b6deea36",
   "kr": "수면제를 쓴다고 적혀 있었지."
  },
  "103": {
   "jp": "b6e15eb1",
   "kr": "응. 실은 말이야."
  },
  "104": {
   "jp": "4d854b39",
   "kr": "톤쟈 씨가 계속 자고 있던 게"
  },
  "105": {
   "jp": "65c39501",
   "kr": "마음에 걸렸거든."
  },
  "106": {
   "jp": "a8a751ea",
   "kr": "톤쟈 씨가 깨어 있었다면"
  },
  "107": {
   "jp": "d10a47bd",
   "kr": "로저 씨네 방에 못 들어가잖아."
  },
  "108": {
   "jp": "469c6214",
   "kr": "그래서 수면약으로 잠재운 거야."
  },
  "109": {
   "jp": "194b4aa7",
   "kr": "하지만 금 브로치가 없어진 건?"
  },
  "110": {
   "jp": "b5ded5ea",
   "kr": "분명 거짓말이야."
  },
  "111": {
   "jp": "98030a65",
   "kr": "자기 브로치가 없어지면"
  },
  "112": {
   "jp": "5d6672fc",
   "kr": "의심을 피할 수 있으니까."
  },
  "113": {
   "jp": "7267ee3c",
   "kr": "그래서 은단검을"
  },
  "114": {
   "jp": "4326b17b",
   "kr": "방에 두는 걸 반대한 거네."
  },
  "115": {
   "jp": "5c17d239",
   "kr": "홍차를 안 마신 것도"
  },
  "116": {
   "jp": "2d08ed77",
   "kr": "수면약이 들었을지도 모른다고"
  },
  "117": {
   "jp": "3e39024d",
   "kr": "생각해서였구나!"
  },
  "118": {
   "jp": "613eb85e",
   "kr": "…그건 말이야"
  },
  "119": {
   "jp": "8852e3e0",
   "kr": "홍차를 그다지 좋아하지 않거든."
  },
  "120": {
   "jp": "9536af87",
   "kr": "그래도 대단하잖아!"
  },
  "121": {
   "jp": "a08cb84c",
   "kr": "이걸로 헤스톤 씨가 범인이란 게"
  },
  "122": {
   "jp": "8c4567b3",
   "kr": "확실해졌네!"
  },
  "123": {
   "jp": "16a556f7",
   "kr": "역시 쥬리오!"
  },
  "124": {
   "jp": "251265ab",
   "kr": "그 정도는… 에헤헤."
  },
  "125": {
   "jp": "536774c2",
   "kr": "앗!?"
  },
  "126": {
   "jp": "6b13f9bd",
   "kr": "무슨 일이야?"
  },
  "127": {
   "jp": "bae71629",
   "kr": "바로 아래에서 소리가 났어."
  },
  "128": {
   "jp": "0ad1665c",
   "kr": "다들 자고 있었지…"
  },
  "129": {
   "jp": "ed5ddba2",
   "kr": "그렇다는 건…"
  },
  "130": {
   "jp": "af83921f",
   "kr": "헤스톤 씨!"
  },
  "131": {
   "jp": "8019c56d",
   "kr": "가 보자!"
  },
  "132": {
   "jp": "d6fd5f78",
   "kr": "로저 씨네가 범인이라면"
  },
  "133": {
   "jp": "cfaaca80",
   "kr": "스스로 수면약을 마실 리가 없잖아."
  },
  "134": {
   "jp": "485fed73",
   "kr": "배를 빼앗을 셈이라면"
  },
  "135": {
   "jp": "1a77a5df",
   "kr": "다들 잠재울 리가 없잖아!"
  },
  "136": {
   "jp": "f71433fa",
   "kr": "생선은 큰 쥐 탓이었잖아."
  },
  "137": {
   "jp": "e9424451",
   "kr": "쥬리오 아는 척하면 안 되지."
  },
  "138": {
   "jp": "0a9eb52a",
   "kr": "자는 사람한테서"
  },
  "139": {
   "jp": "6d99277e",
   "kr": "술 냄새는 안 났어."
  },
  "140": {
   "jp": "39b49616",
   "kr": "뭔가 이상해."
  },
  "141": {
   "jp": "e5b9e494",
   "kr": "한 번 더 생각해 보자."
  }
 }
