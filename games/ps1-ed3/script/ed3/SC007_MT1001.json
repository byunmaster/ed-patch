  },
  "15": {
   "jp": "7c3e2fae",
   "kr": "하본"
  },
  "16": {
   "jp": "9531ef63",
   "kr": "행상인 폴베"
  },
  "17": {
   "jp": "3eda6e03",
   "kr": "어부 리크"
  },
  "18": {
   "jp": "4f045262",
   "kr": "어서 오십시오."
  },
  "19": {
   "jp": "4d81a268",
   "kr": "무기를 찾으시는지요?"
  },
  "20": {
   "jp": "dbc31da0",
   "kr": "손님들에게는"
  },
  "21": {
   "jp": "ace49882",
   "kr": "이쯤이 알맞을 듯합니다."
  },
  "22": {
   "jp": "a81e7a27",
   "kr": "받겠습니다."
  },
  "23": {
   "jp": "0fea90dd",
   "kr": "무엇을 사들일까요?"
  },
  "24": {
   "jp": "4b42c90a",
   "kr": "라면"
  },
  "25": {
   "jp": "98210662",
   "kr": "에 사들이겠습니다."
  },
  "26": {
   "jp": "65d811e9",
   "kr": "환전이시죠?"
  },
  "27": {
   "jp": "cbc5c902",
   "kr": "1Goa당 14Pia인데, 괜찮으신가요?"
  },
  "28": {
   "jp": "068d27e4",
   "kr": "을 치르겠습니다."
  },
  "29": {
   "jp": "e81adb75",
   "kr": "라피카가 쌓이면 또 오십시오."
  },
  "30": {
   "jp": "60bf4e0d",
   "kr": "언제든지 사들이겠습니다."
  },
  "31": {
   "jp": "bd08bfed",
   "kr": "그 밖에 무슨 볼일이신지요?"
  },
  "32": {
   "jp": "4122a3f4",
   "kr": "또 들러 주세요."
  },
  "33": {
   "jp": "97d282f2",
   "kr": "손님"
  },
  "34": {
   "jp": "5e6e7ace",
   "kr": "계산대 안에 들어오지 말아 주세요."
  },
  "35": {
   "jp": "6f839a1c",
   "kr": "알데의 칸드에 어서 오세요."
  },
  "36": {
   "jp": "f0b9e74b",
   "kr": "어느 분께 마법을 전수할까요?"
  },
  "37": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "38": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "39": {
   "jp": "3ea86a92",
   "kr": "또 찾아 주세요."
  },
  "40": {
   "jp": "94dfdfa2",
   "kr": "소년 목소리"
  },
  "41": {
   "jp": "49fd0e4b",
   "kr": "아파앗!!"
  },
  "42": {
   "jp": "2f0b8535",
   "kr": "어? 어?"
  },
  "43": {
   "jp": "8b7a772b",
   "kr": "너무해! 밟다니."
  },
  "44": {
   "jp": "73f3da2f",
   "kr": "애써 숨어 있었는데!!"
  },
  "45": {
   "jp": "04cce65c",
   "kr": "미, 미안."
  },
  "46": {
   "jp": "16558fce",
   "kr": "찾〜았다!"
  },
  "47": {
   "jp": "bb846caf",
   "kr": "거봐아 들켜 버렸잖아!"
  },
  "48": {
   "jp": "0384cba9",
   "kr": "자루 안에 있는 것도 편하지 않다고."
  },
  "49": {
   "jp": "9ae3f154",
   "kr": "그, 그럼"
  },
  "50": {
   "jp": "80dc6907",
   "kr": "이번엔 술래잡기 하는 건 어때?"
  },
  "51": {
   "jp": "f0293b98",
   "kr": "와아!"
  },
  "52": {
   "jp": "236e2275",
   "kr": "하자! 하자!"
  },
  "53": {
   "jp": "efb482d0",
   "kr": "좋아."
  },
  "54": {
   "jp": "4d3c9957",
   "kr": "네가 술래다!"
  },
  "55": {
   "jp": "04a3d84c",
   "kr": "에〜!"
  },
  "56": {
   "jp": "912e0efa",
   "kr": "왜, 왜!? 치사해〜"
  },
  "57": {
   "jp": "a25f797b",
   "kr": "어릴 적 우리 같네."
  },
  "58": {
   "jp": "3c27854e",
   "kr": "난 저렇게 말괄량이는 아니었거든."
  },
  "59": {
   "jp": "2eaa0d32",
   "kr": "헤에〜"
  },
  "60": {
   "jp": "f6e8753a",
   "kr": "뭐야!"
  },
  "61": {
   "jp": "71d7eab1",
   "kr": "이 몸은 해적왕 라몬이다!"
  },
  "62": {
   "jp": "b3275035",
   "kr": "얘들아! 닻을 올려라."
  },
  "63": {
   "jp": "7827d358",
   "kr": "옙, 알겠습니다요!"
  },
  "64": {
   "jp": "a74a1d98",
   "kr": "쥬리오…"
  },
  "65": {
   "jp": "316d154c",
   "kr": "지금 숨바꼭질하고 있어."
  },
  "66": {
   "jp": "ee5c183a",
   "kr": "내가 술래라서 바쁘단 말야."
  },
  "67": {
   "jp": "26cca73f",
   "kr": "그러니까 나중에 놀아 줄게."
  },
  "68": {
   "jp": "98b6b775",
   "kr": "… 뭔가, 분해."
  },
  "69": {
   "jp": "4d2274f9",
   "kr": "이번엔 있잖아, 해적 놀이야."
  },
  "70": {
   "jp": "3b0d8f11",
   "kr": "내가 캡틴 토마토야."
  },
  "71": {
   "jp": "19672c6e",
   "kr": "그러려면 캡틴 토마스지?"
  },
  "72": {
   "jp": "2ea87cbe",
   "kr": "아버님 일을"
  },
  "73": {
   "jp": "4c6d7498",
   "kr": "알려 줘서 고마워요."
  },
  "74": {
   "jp": "5eb28931",
   "kr": "정말 살았어요."
  },
  "75": {
   "jp": "343dd462",
   "kr": "토바이한테 자네들을 네갈섬까지 데려다주라고"
  },
  "76": {
   "jp": "885d63ec",
   "kr": "단단히 일러 뒀으니."
  },
  "77": {
   "jp": "1c4d1eff",
   "kr": "선착장에서 기다리고 있을 게다."
  },
  "78": {
   "jp": "e66efdbd",
   "kr": "자네들 준비가 됐으면"
  },
  "79": {
   "jp": "88d3cf4d",
   "kr": "가 보시게."
  },
  "80": {
   "jp": "d53b73f8",
   "kr": "오오, 바다표범의 먹이를 손에 넣었나?"
  },
  "81": {
   "jp": "ac0d13fb",
   "kr": "응? 바다표범이…"
  },
  "82": {
   "jp": "f16ca1e1",
   "kr": "바다표범의 먹이라도 있으면"
  },
  "83": {
   "jp": "ce6a3682",
   "kr": "한동안 바다표범을 쫓아낼 수도"
  },
  "84": {
   "jp": "8489d64e",
   "kr": "있을 텐데 말이다."
  },
  "85": {
   "jp": "18284c69",
   "kr": "아니"
  },
  "86": {
   "jp": "c3cf3b65",
   "kr": "바다표범의 먹이를 가지고 있지 않느냐."
  },
  "87": {
   "jp": "6e604ac6",
   "kr": "그거면 선착장 바다표범들도"
  },
  "88": {
   "jp": "cd254ce2",
   "kr": "비켜 줄 게다."
  },
  "89": {
   "jp": "ac0d13fb",
   "kr": "응? 바다표범이…"
  },
  "90": {
   "jp": "f16ca1e1",
   "kr": "바다표범의 먹이라도 있으면"
  },
  "91": {
   "jp": "ce6a3682",
   "kr": "한동안 바다표범을 쫓아낼 수도"
  },
  "92": {
   "jp": "8489d64e",
   "kr": "있을 텐데 말이다."
  },
  "93": {
   "jp": "73e18e56",
   "kr": "순례 여행이 결실 많은 여행이기를,"
  },
  "94": {
   "jp": "42eca997",
   "kr": "진심으로 빌겠네."
  },
  "95": {
   "jp": "8f3690a1",
   "kr": "토바이라면 선착장에 갔어."
  },
  "96": {
   "jp": "54504028",
   "kr": "아버지한테 혼난 모양이여."
  },
  "97": {
   "jp": "2d05f9d2",
   "kr": "배를 낸다더라."
  },
  "98": {
   "jp": "e48e7a47",
   "kr": "역시, 어부는 배를 안 타면"
  },
  "99": {
   "jp": "54ee437a",
   "kr": "폼이 안 나는 법이여."
  },
  "100": {
   "jp": "6485f9f4",
   "kr": "남자는 배, 여자는 항구랑께."
  },
  "101": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "102": {
   "jp": "23c76720",
   "kr": "……?"
  },
  "103": {
   "jp": "471dd4e7",
   "kr": "봐, 토바이가 기다리고 있구먼."
  },
  "104": {
   "jp": "f5063e40",
   "kr": "준비가 됐으면"
  },
  "105": {
   "jp": "9c57843e",
   "kr": "선착장으로 가 봐."
  },
  "106": {
   "jp": "566dfc22",
   "kr": "아이는 기운차서 좋구먼."
  },
  "107": {
   "jp": "eb3c9aea",
   "kr": "이런 세상에도 아이들이 밝은 것이"
  },
  "108": {
   "jp": "aefd6597",
   "kr": "그나마 위안이지."
  },
  "109": {
   "jp": "5193a353",
   "kr": "라스파의 부탁은 받아들였다."
  },
  "110": {
   "jp": "f81ee718",
   "kr": "다음에 상인이 오면 닐리에 들르도록"
  },
  "111": {
   "jp": "53f7d9c7",
   "kr": "손써 두마."
  },
  "112": {
   "jp": "9b29c0b7",
   "kr": "어찌나 위험한지 원."
  },
  "113": {
   "jp": "253c5a8b",
   "kr": "도저히 배 따위 띄울 형편이 아니야."
  },
  "114": {
   "jp": "9e3c00e6",
   "kr": "다른 마을에서 건널 방법을 생각해 보거라."
  },
  "115": {
   "jp": "2cea5de8",
   "kr": "정말 곤란하구먼."
  },
  "116": {
   "jp": "c89d68fb",
   "kr": "먹을 것도 적은데"
  },
  "117": {
   "jp": "fda95d49",
   "kr": "게다가 바다표범까지 나오다니…"
  },
  "118": {
   "jp": "c05b3406",
   "kr": "어라, 웬일이냐?"
  },
  "119": {
   "jp": "55af3349",
   "kr": "이런, 자네들."
  },
  "120": {
   "jp": "94267a88",
   "kr": "아직 있었나?"
  },
  "121": {
   "jp": "70a0f4c2",
   "kr": "닐리의 촌장님께서"
  },
  "122": {
   "jp": "613ac0ac",
   "kr": "편지를 맡기셨어요."
  },
  "123": {
   "jp": "4c7019db",
   "kr": "에…?"
  },
  "124": {
   "jp": "ed3bfa5e",
   "kr": "닐리 촌장이 보낸 편지라고?"
  },
  "125": {
   "jp": "d65eadf7",
   "kr": "… 불길한 예감이 드는군."
  },
  "126": {
   "jp": "f2d59b04",
   "kr": "그 녀석 일이니"
  },
  "127": {
   "jp": "568a425f",
   "kr": "식량을 보내라든가, 어차피 그런 소리겠지."
  },
  "128": {
   "jp": "0d47c7bf",
   "kr": "이 마을도 빠듯한데 말이다."
  },
  "129": {
   "jp": "b56f0d61",
   "kr": "닐리 사람들은 사람은 좋다만"
  },
  "130": {
   "jp": "8a0b938a",
   "kr": "쟁여 둘 줄을 모른다."
  },
  "131": {
   "jp": "d39f5cfc",
   "kr": "… 안 될 일이지."
  },
  "132": {
   "jp": "2e36c178",
   "kr": "식량 실은 큰 배가 서니까"
  },
  "133": {
   "jp": "a61c567a",
   "kr": "위기감이 모자란 게야."
  },
  "134": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는 "
  },
  "135": {
   "jp": "b5485709",
   "kr": "을(를) 건넸다."
  },
  "136": {
   "jp": "09049957",
   "kr": "흠, 흠, 흠… 과연, 그렇군."
  },
  "137": {
   "jp": "8c2ab6a5",
   "kr": "조금은 마음을 고쳐먹은 모양이군."
  },
  "138": {
   "jp": "8318c448",
   "kr": "상인이 좀 더 닐리에 들르게 해 달라고?"
  },
  "139": {
   "jp": "7949caad",
   "kr": "그쯤이야 어렵지 않은 일이지."
  },
  "140": {
   "jp": "4ac5718d",
   "kr": "아니, 자네들"
  },
  "141": {
   "jp": "5c4348a7",
   "kr": "수고했구먼."
  },
  "142": {
   "jp": "2becee00",
   "kr": "저기, 실례합니다."
  },
  "143": {
   "jp": "50be02cf",
   "kr": "저희 순례 여행을 하는 중인데요,"
  },
  "144": {
   "jp": "bc1d0181",
   "kr": "네갈섬으로 가는 배는 안 뜨나요?"
  },
  "145": {
   "jp": "e1dda8b1",
   "kr": "으〜음, 그게 말이다."
  },
  "146": {
   "jp": "320712ad",
   "kr": "내 걱정거리란다."
  },
  "147": {
   "jp": "7ba6b6d6",
   "kr": "올해는 어째선지 유빙이 일찍 흘러와서."
  },
  "148": {
   "jp": "7eba37d7",
   "kr": "말도 안 되게"
  },
  "149": {
   "jp": "5ca9002c",
   "kr": "유빙을 타고 온 바다표범들이"
  },
  "150": {
   "jp": "3311524c",
   "kr": "마을 둘레 바다에 눌러앉았지."
  },
  "151": {
   "jp": "544a71c8",
   "kr": "갯가에 벌러덩 드러눕질 않나"
  },
  "152": {
   "jp": "e7214e59",
   "kr": "선착장을 둘러싸고 빙글빙글 돌질 않나…"
  },
  "153": {
   "jp": "06419d93",
   "kr": "정말, 큰일이란다."
  },
  "154": {
   "jp": "5d96d589",
   "kr": "바다표범을 쫓아낼 방법이 있다면야."
  },
  "155": {
   "jp": "42af49fe",
   "kr": "순례 여행자들이군요."
  },
  "156": {
   "jp": "333953eb",
   "kr": "지금도 그런 관습이 있다니"
  },
  "157": {
   "jp": "0809de7c",
   "kr": "어쩐지 기뻐요."
  },
  "158": {
   "jp": "c06ea813",
   "kr": "네갈까지 데려다주고 싶지만,"
  },
  "159": {
   "jp": "ee11d964",
   "kr": "바다표범이 막고 있어서 배를 못 띄워요."
  },
  "160": {
   "jp": "5ba15f18",
   "kr": "미안해요."
  },
  "161": {
   "jp": "94545425",
   "kr": "그러고 보니, 쥬리오."
  },
  "162": {
   "jp": "f2b073c1",
   "kr": "닐리 촌장님한테"
  },
  "163": {
   "jp": "d3d32bfd",
   "kr": "편지를 맡았잖아."
  },
  "164": {
   "jp": "d62e2e7d",
   "kr": "잊기 전에"
  },
  "165": {
   "jp": "20b78c82",
   "kr": "얼른 편지를 전하자."
  },
  "166": {
   "jp": "94ecc270",
   "kr": "아아, 이 창고 말이니?"
  },
  "167": {
   "jp": "ea833c42",
   "kr": "바다 건너 네갈섬에선"
  },
  "168": {
   "jp": "5233f29f",
   "kr": "이탄이 난단다."
  },
  "169": {
   "jp": "af04fe38",
   "kr": "이탄이요?"
  },
  "170": {
   "jp": "0ba6c127",
   "kr": "그래, 이탄이라고 한단다."
  },
  "171": {
   "jp": "95e319bf",
   "kr": "석탄보다 질 낮은 연료인데 그걸 여기에"
  },
  "172": {
   "jp": "fcd4a2f3",
   "kr": "쌓아 두었다가 메나트 전역으로 나르지."
  },
  "173": {
   "jp": "3f0c41c7",
   "kr": "창고에 들어가도 상관없지만"
  },
  "174": {
   "jp": "45d8c2b7",
   "kr": "아무 재미난 것도 없단다."
  },
  "175": {
   "jp": "4844c206",
   "kr": "이건 비밀인디"
  },
  "176": {
   "jp": "e071a2f1",
   "kr": "난 하얀마녀의 예언을 믿고,"
  },
  "177": {
   "jp": "11e1c7df",
   "kr": "보리를 길렀당께."
  },
  "178": {
   "jp": "fba2ecf4",
   "kr": "앗, 말해 부렀네…"
  },
  "179": {
   "jp": "9d901f9f",
   "kr": "근디 말이여, 그 덕에 그럭저럭"
  },
  "180": {
   "jp": "9d864d20",
   "kr": "입에 풀칠하고 산당께."
  },
  "181": {
   "jp": "6c15237e",
   "kr": "이 마을 수입원은,"
  },
  "182": {
   "jp": "d3e5accb",
   "kr": "네갈에서 오는 이탄 운송과"
  },
  "183": {
   "jp": "e5ee3aa2",
   "kr": "생선뿐잉께."
  },
  "184": {
   "jp": "ad650e88",
   "kr": "준비가 있으면,"
  },
  "185": {
   "jp": "7ccbf38f",
   "kr": "어쩌고, 아니겄어."
  },
  "186": {
   "jp": "6dfadb34",
   "kr": "어머, 순례 여행자들이에요?"
  },
  "187": {
   "jp": "46197fc6",
   "kr": "하필 안 좋을 때 왔네요."
  },
  "188": {
   "jp": "1dd041df",
   "kr": "치타로 가는 길은 벼랑이 무너져 막혔대요."
  },
  "189": {
   "jp": "3d23c608",
   "kr": "지금은 바다표범 탓에 배도 못 띄우고"
  },
  "190": {
   "jp": "724bf4e2",
   "kr": "치타 길도 안 되면, 난처하게 됐네요."
  },
  "191": {
   "jp": "30a2053c",
   "kr": "미안하구나. 지금은 방이 다 찼단다."
  },
  "192": {
   "jp": "0f15548b",
   "kr": "치타에서 온 여행자가 묵고 있고"
  },
  "193": {
   "jp": "461b91d5",
   "kr": "떠돌이 상인이 곧 올 참이거든."
  },
  "194": {
   "jp": "3af37095",
   "kr": "미안하구나."
  },
  "195": {
   "jp": "2d038c7e",
   "kr": "괜찮다면"
  },
  "196": {
   "jp": "377b663b",
   "kr": "로비에서 쉬다 가려무나."
  },
  "197": {
   "jp": "073b1d00",
   "kr": "이야, 나는 치타에서 왔는데"
  },
  "198": {
   "jp": "80dc12c1",
   "kr": "역시 메나트는 어디나 가난해서"
  },
  "199": {
   "jp": "d54295c5",
   "kr": "큰일이구나."
  },
  "200": {
   "jp": "cb4d6b1e",
   "kr": "힘든 건 치타만이 아니란 걸"
  },
  "201": {
   "jp": "ce2221ec",
   "kr": "잘 알았어."
  },
  "202": {
   "jp": "57c7cad9",
   "kr": "그래도, 어쩌지…"
  },
  "203": {
   "jp": "25694f91",
   "kr": "가도에 벼랑이 무너져서"
  },
  "204": {
   "jp": "737ff220",
   "kr": "치타로 가는 길이 막혔어."
  },
  "205": {
   "jp": "754bb91e",
   "kr": "난처하군…"
  },
  "206": {
   "jp": "8f4f4784",
   "kr": "호오, 자네들 순례 여행자인가?"
  },
  "207": {
   "jp": "34209b1d",
   "kr": "그럼, 그 벼랑 무너진 데서"
  },
  "208": {
   "jp": "ef41abc1",
   "kr": "어지간히 고생했겠구먼."
  },
  "209": {
   "jp": "f3e493ac",
   "kr": "피로엔 단것이 제일이지."
  },
  "210": {
   "jp": "8550f8b0",
   "kr": "이 과자를 먹어 보게."
  },
  "211": {
   "jp": "a796ad10",
   "kr": "와아, 고마워요."
  },
  "212": {
   "jp": "2fba7fff",
   "kr": "본 적 없는 과자네요."
  },
  "213": {
   "jp": "846117cc",
   "kr": "쥬리오는 과자를 덥석 물었다."
  },
  "214": {
   "jp": "2add1538",
   "kr": "우웨〜"
  },
  "215": {
   "jp": "21576de0",
   "kr": "왜 그래, 쥬리오?"
  },
  "216": {
   "jp": "fc55f423",
   "kr": "아, 아무것도 아냐."
  },
  "217": {
   "jp": "bef30804",
   "kr": "크리스도 먹어 봐. 맛있어."
  },
  "218": {
   "jp": "d49c5700",
   "kr": "어쩐지, 수상한데."
  },
  "219": {
   "jp": "2993da07",
   "kr": "오, 미안하네."
  },
  "220": {
   "jp": "134f7be8",
   "kr": "그건"
  },
  "221": {
   "jp": "51e39898",
   "kr": "… 였단다."
  },
  "222": {
   "jp": "f6cfaba1",
   "kr": "?"
  },
  "223": {
   "jp": "01856aa5",
   "kr": "그거 하나 받아도 될까요?"
  },
  "224": {
   "jp": "8b229029",
   "kr": "그런 걸로 괜찮다면 가져가게나."
  },
  "225": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는"
  },
  "226": {
   "jp": "e9d91b01",
   "kr": ", 손에 넣었다."
  },
  "227": {
   "jp": "9b4a6f49",
   "kr": "더는 못 들겠어."
  },
  "228": {
   "jp": "c95ef071",
   "kr": "뭔가 버리자."
  },
  "229": {
   "jp": "290bd3ad",
   "kr": "이걸로 어떻게든 될지도."
  },
  "230": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "231": {
   "jp": "53cfd363",
   "kr": "아저씨, 정말 고마워요."
  },
  "232": {
   "jp": "8b922983",
   "kr": "나는 도구를 파는데"
  },
  "233": {
   "jp": "5e26df6a",
   "kr": "그 밖에 필요한 건 없나?"
  },
  "234": {
   "jp": "d7b27db6",
   "kr": "오, 자네들인가."
  },
  "235": {
   "jp": "6a1eb64a",
   "kr": "뭔가 필요한 물건은 있나?"
  },
  "236": {
   "jp": "dc79df8e",
   "kr": "뭐가 갖고 싶은가?"
  },
  "237": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "238": {
   "jp": "0acce0d1",
   "kr": "면 되겠어."
  },
  "239": {
   "jp": "2903c8c3",
   "kr": "무엇을 사들일까?"
  },
  "240": {
   "jp": "abb8567e",
   "kr": "그렇다면,"
  },
  "241": {
   "jp": "d6d96edb",
   "kr": "로 바꿔 줄게."
  },
  "242": {
   "jp": "a05a47c3",
   "kr": "1Goa당 14Pia에 사 주지."
  },
  "243": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "244": {
   "jp": "7da61f0d",
   "kr": "야."
  },
  "245": {
   "jp": "c0505d25",
   "kr": "라피카가 모이거든 또 와 주게."
  },
  "246": {
   "jp": "9c7bbbf5",
   "kr": "그 밖에 무슨 볼일인가?"
  },
  "247": {
   "jp": "303bf067",
   "kr": "뭔가 갖고 싶은 게 있거든"
  },
  "248": {
   "jp": "e5f0eae6",
   "kr": "또 찾아오게나."
  },
  "249": {
   "jp": "bbfbcfa7",
   "kr": "내 배가 바다표범 탓에"
  },
  "250": {
   "jp": "925d7846",
   "kr": "가라앉아 부렀어어."
  }
 }
}