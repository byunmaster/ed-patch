{
 "archive": "/SCE0/SC000.DAT",
 "member": "..\\DATA\\FT0003.BIN",
 "lines": {
  "0": {
   "jp": "bb708123",
   "kr": "라그픽 마을"
  },
  "1": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "2": {
   "jp": "1c3909b6",
   "kr": "쥬리오 아빠"
  },
  "3": {
   "jp": "ad0e2a6b",
   "kr": "쥬리오 엄마"
  },
  "4": {
   "jp": "f41cc21e",
   "kr": "크리스 아빠"
  },
  "5": {
   "jp": "14600308",
   "kr": "크리스 엄마"
  },
  "6": {
   "jp": "8ef96780",
   "kr": "톨타 촌장"
  },
  "7": {
   "jp": "493dcc93",
   "kr": "페르나 부인"
  },
  "8": {
   "jp": "d0b6da59",
   "kr": "도구점 테르노"
  },
  "9": {
   "jp": "3cfb8627",
   "kr": "픽"
  },
  "10": {
   "jp": "1b89384a",
   "kr": "스콜"
  },
  "11": {
   "jp": "0b8d576a",
   "kr": "로그"
  },
  "12": {
   "jp": "b9f92fd3",
   "kr": "치아나"
  },
  "13": {
   "jp": "17a0f30d",
   "kr": "별 괘씸한 놈들이 다 있구나."
  },
  "14": {
   "jp": "2738167c",
   "kr": "은단검을 훔치려 들다니…"
  },
  "15": {
   "jp": "e11d5c5e",
   "kr": "이 단검은 순례자의 증표다."
  },
  "16": {
   "jp": "b1a93cad",
   "kr": "이걸 안 지니면 여행을 이어 갈 수 없지."
  },
  "17": {
   "jp": "20837268",
   "kr": "부디 여행길에선 도둑을 조심하거라."
  },
  "18": {
   "jp": "57900d0b",
   "kr": "자, 마음을 가다듬고"
  },
  "19": {
   "jp": "782760c3",
   "kr": "은단검 수여식을 시작하자꾸나."
  },
  "20": {
   "jp": "3d455f55",
   "kr": "크흠! …쥬리오, 크리스티나."
  },
  "21": {
   "jp": "e59c3026",
   "kr": "두 사람을 라그픽 마을 촌장의 이름으로"
  },
  "22": {
   "jp": "77d5075b",
   "kr": "성인의 의식인 순례 여행에 보내노라."
  },
  "23": {
   "jp": "36b92271",
   "kr": "바람이 숨결을 전하고 불꽃이 몸을 데우기를."
  },
  "24": {
   "jp": "2b49bd39",
   "kr": "대지가 하루의 양식을"
  },
  "25": {
   "jp": "9200e2f1",
   "kr": "물이 피로를 풀어 주기를."
  },
  "26": {
   "jp": "44c404c2",
   "kr": "…그리고"
  },
  "27": {
   "jp": "af4271a2",
   "kr": "하늘이 두 사람의 행적을 미소로 지켜보기를."
  },
  "28": {
   "jp": "35a495a1",
   "kr": "이에 은단검을 수여한다."
  },
  "29": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "30": {
   "jp": "de8307e6",
   "kr": "음, 그렇게 짐이 많아서는 "
  },
  "31": {
   "jp": "bee6072c",
   "kr": "을(를) 받을 수 없겠구나."
  },
  "32": {
   "jp": "e9463e37",
   "kr": "뭔가 두고 가거라."
  },
  "33": {
   "jp": "dbf6158f",
   "kr": "쥬리오는 "
  },
  "34": {
   "jp": "6c9a91dc",
   "kr": "을(를) 받았다."
  },
  "35": {
   "jp": "5c2aa77e",
   "kr": "자, 기운차게 출발하거라."
  },
  "36": {
   "jp": "7dfd2adc",
   "kr": "그리고 디네를 향해 가거라."
  },
  "37": {
   "jp": "0af83d00",
   "kr": "좋은 추억을 만들어 오렴."
  },
  "38": {
   "jp": "cdf2592e",
   "kr": "순례자는 한번 마을을 나서면"
  },
  "39": {
   "jp": "e41cdd6c",
   "kr": "모든 샤리네를 돌기 전에는"
  },
  "40": {
   "jp": "77a36dcd",
   "kr": "돌아오는 것이 허락되지 않는다."
  },
  "41": {
   "jp": "127e2709",
   "kr": "그럴 각오로 출발하거라."
  },
  "42": {
   "jp": "e94ad828",
   "kr": "그, 뭐냐."
  },
  "43": {
   "jp": "628c4883",
   "kr": "조심해서 가거라."
  },
  "44": {
   "jp": "4946ae94",
   "kr": "크리스를 위험한 일에 휘말리게 하면 안 돼."
  },
  "45": {
   "jp": "974d0d46",
   "kr": "응, 괜찮아."
  },
  "46": {
   "jp": "a2247b20",
   "kr": "그럼, 다녀올게."
  },
  "47": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "48": {
   "jp": "a5a95f95",
   "kr": "무, 무사히 돌아오는 거다."
  },
  "49": {
   "jp": "581fbccb",
   "kr": "으윽, 으으윽…"
  },
  "50": {
   "jp": "c1d53a74",
   "kr": "여보, 울 것까진 없잖아요."
  },
  "51": {
   "jp": "06785b8e",
   "kr": "우리 아버지도 이런 마음이셨겠지."
  },
  "52": {
   "jp": "599ae0ff",
   "kr": "그야 그렇지만 당신 아버님은"
  },
  "53": {
   "jp": "15b3d4f7",
   "kr": "울지 않으셨어요."
  },
  "54": {
   "jp": "2c7e2159",
   "kr": "부디 몸조심하거라."
  },
  "55": {
   "jp": "941823a4",
   "kr": "혹시 여행길에 곤란한 일이 있거든"
  },
  "56": {
   "jp": "395c235c",
   "kr": "가는 곳마다 챠펠이 힘이 되어 줄 게다."
  },
  "57": {
   "jp": "670d8b41",
   "kr": "라그나에는"
  },
  "58": {
   "jp": "a43592e6",
   "kr": "당신 동생이 살고 있죠?"
  },
  "59": {
   "jp": "ff8e51eb",
   "kr": "아, 허크 말이군."
  },
  "60": {
   "jp": "fbe557e1",
   "kr": "어지간히 곤란한 일이 생기거든 의지하거라."
  },
  "61": {
   "jp": "6b4946a9",
   "kr": "좀 별난 녀석이지만 힘이 되어 줄 게다."
  },
  "62": {
   "jp": "a6af09a1",
   "kr": "크리스… 몸조심하렴."
  },
  "63": {
   "jp": "65bde7f3",
   "kr": "엄마, 아빠…"
  },
  "64": {
   "jp": "36f99101",
   "kr": "다녀올게요."
  },
  "65": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "66": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "67": {
   "jp": "47c3d7d3",
   "kr": "분명 긴 여행이 될 거야."
  },
  "68": {
   "jp": "8c57dbfa",
   "kr": "둘이서 힘내자."
  },
  "69": {
   "jp": "77104ad6",
   "kr": "쥬리오와 크리스는 파티를 짰다."
  },
  "70": {
   "jp": "46d656b1",
   "kr": "한번 마을을 나서면"
  },
  "71": {
   "jp": "10e567f7",
   "kr": "순례 여행이 끝날 때까지 돌아올 수 없어."
  },
  "72": {
   "jp": "16b4d93e",
   "kr": "괜찮은 거지?"
  },
  "73": {
   "jp": "dd890a57",
   "kr": "잘 지내라."
  },
  "74": {
   "jp": "acda2435",
   "kr": "모두에게 제대로 인사해야겠다."
  },
  "75": {
   "jp": "a5a95f95",
   "kr": "무, 무사히 돌아오는 거다."
  },
  "76": {
   "jp": "ed80e960",
   "kr": "끓이지 않은 물은 조심하렴."
  },
  "77": {
   "jp": "bb63a116",
   "kr": "자기 목적에만 사로잡혀선 안 된다."
  },
  "78": {
   "jp": "914acd14",
   "kr": "마음도 자라게 해야 한단다."
  },
  "79": {
   "jp": "262f98fd",
   "kr": "꼭 둘 다 무사한 모습을 보여 줘."
  },
  "80": {
   "jp": "da9632c1",
   "kr": "이 여행이 끝나면 떳떳이 어른이 되는 게다."
  },
  "81": {
   "jp": "fc558e3a",
   "kr": "괴로운 일도 있겠지만 꺾이지 말고 힘내거라."
  },
  "82": {
   "jp": "4a0b5a42",
   "kr": "디네는 수정호의 다리를 건넌 곳에 있어."
  },
  "83": {
   "jp": "e0498dd3",
   "kr": "천천히 걸어도"
  },
  "84": {
   "jp": "75bc6428",
   "kr": "그리 오래 걸리진 않을 거야."
  },
  "85": {
   "jp": "0091a132",
   "kr": "둘 다 세상을 잔뜩 보고 오렴."
  },
  "86": {
   "jp": "f42aca9f",
   "kr": "별별 나라가 있어서 재밌다고."
  },
  "87": {
   "jp": "4efd96bd",
   "kr": "맛있는 요리가 있으면 비법을 배워 와 줘."
  },
  "88": {
   "jp": "820397d6",
   "kr": "이번 여행에선 많은 사람을 만나게 될 게다."
  },
  "89": {
   "jp": "90fc1c21",
   "kr": "여행엔 길동무가 있어야 한다잖아?"
  },
  "90": {
   "jp": "795b6fbd",
   "kr": "앞으로 알게 될 사람들을 아끼라고."
  },
  "91": {
   "jp": "6636ec8c",
   "kr": "여차할 때 힘이 되어 줄지도 모르니까."
  },
  "92": {
   "jp": "a7f4d75f",
   "kr": "그리고 마수 중에는 라피카라는 귀한"
  },
  "93": {
   "jp": "426d0adc",
   "kr": "광석을 남기는 놈도 있어."
  },
  "94": {
   "jp": "fd030988",
   "kr": "도구점에 가져가면 사 줄 거야."
  },
  "95": {
   "jp": "0cb19779",
   "kr": "잘하면 넉넉한 여행이 될지도 모르지."
  },
  "96": {
   "jp": "ecb2e49e",
   "kr": "싸우지 마라."
  },
  "97": {
   "jp": "dd890a57",
   "kr": "잘 지내라."
  },
  "98": {
   "jp": "9e153842",
   "kr": "뭘, 처음엔 쓸쓸하겠지만"
  },
  "99": {
   "jp": "dececf55",
   "kr": "금방 익숙해지는 법이야."
  },
  "100": {
   "jp": "c46e5842",
   "kr": "한 살 어려도"
  },
  "101": {
   "jp": "e18be32b",
   "kr": "여차할 땐 쥬리오가 힘내야지."
  },
  "102": {
   "jp": "b60aac40",
   "kr": "여자애를 지키는 건 남자 몫이니까."
  },
  "103": {
   "jp": "7458e60d",
   "kr": "쥬리오오."
  },
  "104": {
   "jp": "5cfcdb3e",
   "kr": "돌아오면 또 놀아 줘."
  }
 }
}