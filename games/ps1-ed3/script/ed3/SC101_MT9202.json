 "member": "..\\DATA\\MT9202.BIN",
 "lines": {
  "0": {
   "jp": "b2086cc7",
   "kr": "테그라 탄광"
  },
  "1": {
   "jp": "b519a5d7",
   "kr": "지하 3층"
  },
  "2": {
   "jp": "fc3838e7",
   "kr": "광부 보리"
  },
  "3": {
   "jp": "7d38049f",
   "kr": "광부 테드"
  },
  "4": {
   "jp": "d564ff61",
   "kr": "광부 아일"
  },
  "5": {
   "jp": "ff96f5c9",
   "kr": "분명 새 샛길이 나올 거다."
  },
  "6": {
   "jp": "951a3207",
   "kr": "어떻게든 될 거야."
  },
  "7": {
   "jp": "856fca4a",
   "kr": "그래도 하나쯤 더 큰 진홍의 불꽃이"
  },
  "8": {
   "jp": "1f967327",
   "kr": "있었으면 좋았을 텐데."
  },
  "9": {
   "jp": "97c08864",
   "kr": "그러고 보니 얼마 전까지"
  },
  "10": {
   "jp": "01a282a0",
   "kr": "너무 커진 진홍의 불꽃이 두 개 있었는데,"
  },
  "11": {
   "jp": "e38cf36f",
   "kr": "나머지 하나는 어디로 갔을까."
  },
  "12": {
   "jp": "d9b724d9",
   "kr": "안 된다니까요, 그런 작전."
  },
  "13": {
   "jp": "344232cd",
   "kr": "그런 짓 하면"
  },
  "14": {
   "jp": "68e75a99",
   "kr": "또 다른 데가 묻혀요."
  },
  "15": {
   "jp": "c389366c",
   "kr": "응, 그랬지."
  },
  "16": {
   "jp": "5ca523f6",
   "kr": "꼼꼼히 벽을 살펴 갈 수밖에 없군."
  },
  "17": {
   "jp": "4c97c9ea",
   "kr": "무너진 돌과 바위로 통로가 막혀 있다!"
  },
  "18": {
   "jp": "59403012",
   "kr": "광부 아저씨들까지"
  },
  "19": {
   "jp": "dd196ecc",
   "kr": "휘말린 모양이네."
  },
  "20": {
   "jp": "d0cdff83",
   "kr": "크리스, 봐!"
  },
  "21": {
   "jp": "cdb4306f",
   "kr": "천장에서 모래가 흐르고 있어."
  },
  "22": {
   "jp": "f87355fb",
   "kr": "재밌네."
  },
  "23": {
   "jp": "c4bd2efe",
   "kr": "봐, 쥬리오."
  },
  "24": {
   "jp": "91e86173",
   "kr": "저기 천장에서 모래가 흘러내려."
  },
  "25": {
   "jp": "5eecc68b",
   "kr": "동굴 천장에서, 먼지처럼"
  },
  "26": {
   "jp": "991283b6",
   "kr": "고운 모래가 흘러내리고 있다."
  },
  "27": {
   "jp": "5da459a5",
   "kr": "무슨 소리야."
  },
  "28": {
   "jp": "35abeec3",
   "kr": "큰일이잖아!"
  },
  "29": {
   "jp": "77948617",
   "kr": "여기도 분명 무너져."
  },
  "30": {
   "jp": "60707587",
   "kr": "위험해."
  },
  "31": {
   "jp": "3464d217",
   "kr": "여기도 무너지는 거"
  },
  "32": {
   "jp": "fefe834c",
   "kr": "아닐까."
  },
  "33": {
   "jp": "35e8c271",
   "kr": "일단"
  },
  "34": {
   "jp": "1c814c12",
   "kr": "아저씨들한테"
  },
  "35": {
   "jp": "8b89fbcb",
   "kr": "알리는 게 좋겠어."
  },
  "36": {
   "jp": "90534653",
   "kr": "뭐?"
  },
  "37": {
   "jp": "843c6b93",
   "kr": "그러냐"
  },
  "38": {
   "jp": "dcb7cd43",
   "kr": "어디 살펴볼까."
  },
  "39": {
   "jp": "932b6056",
   "kr": "정말이다."
  },
  "40": {
   "jp": "0acd3e80",
   "kr": "모래가 새네."
  },
  "41": {
   "jp": "fae9345b",
   "kr": "아저씨"
  },
  "42": {
   "jp": "b4ec913c",
   "kr": "이 천장도 무너지는 거 아녜요?"
  },
  "43": {
   "jp": "b684c0b0",
   "kr": "너무 가까이 가면 위험해요."
  },
  "44": {
   "jp": "140ffcd9",
   "kr": "아니, 괜찮을 거다."
  },
  "45": {
   "jp": "1ba6c2d0",
   "kr": "이 모래 흐르는 모양은"
  },
  "46": {
   "jp": "32696213",
   "kr": "무너질 조짐이 아냐."
  },
  "47": {
   "jp": "49b95baa",
   "kr": "저절로 구멍이"
  },
  "48": {
   "jp": "d2c2cf5e",
   "kr": "뚫릴 때 그런 거지."
  },
  "49": {
   "jp": "07390ec3",
   "kr": "앗, 그런가!"
  },
  "50": {
   "jp": "0148fbca",
   "kr": "이건 살았을지도 모르겠구나."
  },
  "51": {
   "jp": "09e4e5e8",
   "kr": "정말요?"
  },
  "52": {
   "jp": "07f92ef5",
   "kr": "잠깐 천장을 만져 보면 금방 안다."
  },
  "53": {
   "jp": "c994b3be",
   "kr": "내 감이지만, 이 위는 분명 내가"
  },
  "54": {
   "jp": "39266a80",
   "kr": "파던 언저리일 거다."
  },
  "55": {
   "jp": "d92566ab",
   "kr": "과연."
  },
  "56": {
   "jp": "ab3cede9",
   "kr": "네 굴과 이어져 있다면"
  },
  "57": {
   "jp": "c9aac5d5",
   "kr": "여길 올라 위층으로 갈 수 있다."
  },
  "58": {
   "jp": "bb5791e1",
   "kr": "꼬마, 나무 잘 타냐?"
  },
  "59": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "60": {
   "jp": "5f7a3a95",
   "kr": "나무 타기라면 크리스가 더 잘해요."
  },
  "61": {
   "jp": "82352552",
   "kr": "좋아. 그럼, 아가씨."
  },
  "62": {
   "jp": "d14567a7",
   "kr": "우리가 목마를 태워 줄 테니"
  },
  "63": {
   "jp": "032fa30c",
   "kr": "올라가서 천장을 좀 살펴봐 다오."
  },
  "64": {
   "jp": "ba991440",
   "kr": "엇? 제가…"
  },
  "65": {
   "jp": "155ab293",
   "kr": "오를 사람이 가볍지 않으면"
  },
  "66": {
   "jp": "443f3910",
   "kr": "못 받치니까."
  },
  "67": {
   "jp": "7a1e9fa6",
   "kr": "어쩔 수 없네요, 정말."
  },
  "68": {
   "jp": "5989a9f5",
   "kr": "자, 목마를 쌓자."
  },
  "69": {
   "jp": "7958b088",
   "kr": "꼬마가 맨 위다."
  },
  "70": {
   "jp": "122afaf8",
   "kr": "목마, 시작!"
  },
  "71": {
   "jp": "b8787a65",
   "kr": "좋아, 됐다."
  },
  "72": {
   "jp": "e0efe820",
   "kr": "아가씨, 올라와 다오."
  },
  "73": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "74": {
   "jp": "265b37d8",
   "kr": "앗, 보인다."
  },
  "75": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "76": {
   "jp": "bf7c2ff1",
   "kr": "아니, 아무것도 아냐."
  },
  "77": {
   "jp": "70354164",
   "kr": "……"
  },
  "78": {
   "jp": "829b9983",
   "kr": "엿보면 안 돼요."
  },
  "79": {
   "jp": "eabb8866",
   "kr": "됐으니까, 얼른 천장을 살펴봐."
  },
  "80": {
   "jp": "ec4fb5d3",
   "kr": "무겁단 말이야…"
  },
  "81": {
   "jp": "606ebbc1",
   "kr": "엿보면 안 된다니까요."
  },
  "82": {
   "jp": "36f5e77f",
   "kr": "으응… 알고 있어."
  },
  "83": {
   "jp": "dbbe7a43",
   "kr": "아가씨, 됐나."
  },
  "84": {
   "jp": "192418db",
   "kr": "천장을 가볍게 두드려 봐 다오."
  },
  "85": {
   "jp": "5b3d044a",
   "kr": "크리스는 동굴 천장을 가볍게 두드렸다."
  },
  "86": {
   "jp": "fe91f5f8",
   "kr": "크리스가 동굴 천장을 가볍게 두드리자,"
  },
  "87": {
   "jp": "1de202dc",
   "kr": "쏟아지듯 모래가 스르르 흐르고"
  },
  "88": {
   "jp": "eaa0d43c",
   "kr": "천장에 뻥 하고 구멍이 뚫렸다."
  },
  "89": {
   "jp": "432a0d00",
   "kr": "구멍, 구멍이 뚫렸어!"
  },
  "90": {
   "jp": "4f29988c",
   "kr": "모래투성이야."
  },
  "91": {
   "jp": "a5757724",
   "kr": "역시 그렇군."
  },
  "92": {
   "jp": "32cba52c",
   "kr": "아가씨, 올라갈 수 있겠나?"
  },
  "93": {
   "jp": "fbdc5164",
   "kr": "네, 해 볼게요."
  },
  "94": {
   "jp": "c94a3c60",
   "kr": "영차."
  },
  "95": {
   "jp": "a6809905",
   "kr": "아저씨들, 들려요!"
  },
  "96": {
   "jp": "096dd7e8",
   "kr": "위로 올라왔어요."
  },
  "97": {
   "jp": "00085837",
   "kr": "지금 밧줄을 내릴게요오!"
  },
  "98": {
   "jp": "128e6c61",
   "kr": "오, 들린다아."
  },
  "99": {
   "jp": "d0a9684a",
   "kr": "부탁한다아!"
  },
  "100": {
   "jp": "855a792c",
   "kr": "살았다."
  },
  "101": {
   "jp": "eac103bc",
   "kr": "이제 빠져나가겠다."
  },
  "102": {
   "jp": "6eb9e631",
   "kr": "자, 얼른 오르자."
  }
 }
}