{
 "archive": "/SCE1/SC103.DAT",
 "member": "..\\DATA\\MT4110.BIN",
 "lines": {
  "0": {
   "jp": "7851a095",
   "kr": "넬바"
  },
  "1": {
   "jp": "017b0641",
   "kr": "넬바성"
  },
  "2": {
   "jp": "64d6fdbb",
   "kr": "우가나 노인"
  },
  "3": {
   "jp": "16a745be",
   "kr": "정말로 성이 없어져 버렸네."
  },
  "4": {
   "jp": "e01bf4d4",
   "kr": "왠지 무서워."
  },
  "5": {
   "jp": "2cb15501",
   "kr": "가루가는 상륙할 때마다"
  },
  "6": {
   "jp": "f2292c88",
   "kr": "흉포해진다는 것인가…"
  },
  "7": {
   "jp": "a6cad139",
   "kr": "어떻게든 해야 하는데…"
  },
  "8": {
   "jp": "ad1fba3b",
   "kr": "여기에 성이 있었구나…"
  },
  "9": {
   "jp": "e7a718c6",
   "kr": "마을이 저렇게 큰걸."
  },
  "10": {
   "jp": "e66d72a9",
   "kr": "분명 훌륭한 성이었겠지."
  },
  "11": {
   "jp": "b461b400",
   "kr": "가루가를 상대로"
  },
  "12": {
   "jp": "896cd28e",
   "kr": "인간은 속수무책인가…?"
  },
  "13": {
   "jp": "dc8b9d55",
   "kr": "으음…"
  },
  "14": {
   "jp": "60109b53",
   "kr": "이건 너무하군."
  },
  "15": {
   "jp": "2331685f",
   "kr": "가루가의 파괴력이 이 정도라니."
  },
  "16": {
   "jp": "eda19a44",
   "kr": "왠지… 싫다."
  },
  "17": {
   "jp": "86a74469",
   "kr": "가슴속이 답답해…"
  },
  "18": {
   "jp": "2bfff3df",
   "kr": "더는 이런 풍경 보고 싶지 않아."
  },
  "19": {
   "jp": "38ccc20a",
   "kr": "가루가 이놈."
  },
  "20": {
   "jp": "0a3f8f31",
   "kr": "반드시 이 손으로 끝장낸다."
  },
  "21": {
   "jp": "ecb7cbe2",
   "kr": "재앙의 산은 바다에서 나타나"
  },
  "22": {
   "jp": "ac844532",
   "kr": "도읍을 잔해로 만든다, 라…"
  },
  "23": {
   "jp": "3053a847",
   "kr": "이걸 말한 것이었구먼…"
  },
  "24": {
   "jp": "f9ec832b",
   "kr": "노인장, 그 말은?"
  },
  "25": {
   "jp": "d4ca0c0f",
   "kr": "뭐…"
  },
  "26": {
   "jp": "99f81f16",
   "kr": "옛날에 이 마을에 들른 처자가"
  },
  "27": {
   "jp": "1e3883b2",
   "kr": "말했더랬지."
  },
  "28": {
   "jp": "6e62000d",
   "kr": "처자…!?"
  },
  "29": {
   "jp": "0c8888a3",
   "kr": "그 처자란"
  },
  "30": {
   "jp": "65811fed",
   "kr": "하얀마녀를 말함이렷다."
  },
  "31": {
   "jp": "88232373",
   "kr": "말함이렷다, 라니."
  },
  "32": {
   "jp": "c0fdaaec",
   "kr": "알프 씨, 또 말투가 이상해."
  },
  "33": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "34": {
   "jp": "4a0dac4a",
   "kr": "근데 어째서 알프 씨가"
  },
  "35": {
   "jp": "16675bc4",
   "kr": "하얀마녀를 알고 있는 거야?"
  },
  "36": {
   "jp": "16c41954",
   "kr": "그녀는 내 나라에도 같은 말을"
  },
  "37": {
   "jp": "15b078fb",
   "kr": "남겼다네."
  },
  "38": {
   "jp": "6801f87b",
   "kr": "그러고 보니 알프 씨는"
  },
  "39": {
   "jp": "e048da47",
   "kr": "어디 사람이야?"
  },
  "40": {
   "jp": "ae60342f",
   "kr": "아아… 나는 앰비쉬 사람이다."
  },
  "41": {
   "jp": "c33cd780",
   "kr": "아, 그렇구나…"
  },
  "42": {
   "jp": "5fc40d85",
   "kr": "그래서 앰비쉬에 있는 이그니스"
  },
  "43": {
   "jp": "385dfff5",
   "kr": "샤리네를 알고 있었구나."
  },
  "44": {
   "jp": "2af0c987",
   "kr": "으음."
  },
  "45": {
   "jp": "730e7105",
   "kr": "그런 셈이다."
  },
  "46": {
   "jp": "738c4e8c",
   "kr": "허나, 이 땅에도"
  },
  "47": {
   "jp": "9936290c",
   "kr": "하얀마녀가 찾아와, 앰비쉬와 같은"
  },
  "48": {
   "jp": "56b601ac",
   "kr": "말을 남겼을 줄이야…"
  },
  "49": {
   "jp": "777d48b0",
   "kr": "알프 님이라 하셨던가."
  },
  "50": {
   "jp": "b9c23b6a",
   "kr": "넬바는 예언대로 가루가에게 부서졌네."
  },
  "51": {
   "jp": "433d0788",
   "kr": "앰비쉬에도"
  },
  "52": {
   "jp": "c6c33044",
   "kr": "같은 말이 남아 있다면 서두르시게."
  },
  "53": {
   "jp": "661bee89",
   "kr": "한시라도 빨리 나라로 돌아가"
  },
  "54": {
   "jp": "43195828",
   "kr": "국왕에게 가루가 내습을 알리는 편이 좋네."
  },
  "55": {
   "jp": "a519d1c1",
   "kr": "넬바는 예언을 알고도"
  },
  "56": {
   "jp": "61454fc9",
   "kr": "맥없이 가루가에게 부서졌네."
  },
  "57": {
   "jp": "6750f925",
   "kr": "하얀마녀의 말을 헛되이 하는 건"
  },
  "58": {
   "jp": "10ac05a5",
   "kr": "이 넬바 마을 하나로 충분하네."
  },
  "59": {
   "jp": "54dfa14b",
   "kr": "노인장."
  },
  "60": {
   "jp": "d9d88521",
   "kr": "그 충고, 고맙게 받겠습니다."
  },
  "61": {
   "jp": "b1d34c82",
   "kr": "이러고 있을 순 없어."
  },
  "62": {
   "jp": "10d0af16",
   "kr": "당장 출발하자."
  },
  "63": {
   "jp": "9e8f72b3",
   "kr": "응, 맞아."
  },
  "64": {
   "jp": "9017cc26",
   "kr": "쥬리오, 알프 씨."
  },
  "65": {
   "jp": "c9942b65",
   "kr": "우리가 앰비쉬 임금님께"
  },
  "66": {
   "jp": "d834c04d",
   "kr": "가루가 일을 알리는 거야."
  },
  "67": {
   "jp": "d17dad1d",
   "kr": "서두르자."
  },
  "68": {
   "jp": "fed9cff6",
   "kr": "허나, 나는 그렇다 쳐도,"
  },
  "69": {
   "jp": "a24b7604",
   "kr": "자네들은 순례 여행 도중이 아닌가?"
  },
  "70": {
   "jp": "ec2f0f4d",
   "kr": "그런 말"
  },
  "71": {
   "jp": "45639e18",
   "kr": "할 때가 아니야."
  },
  "72": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "73": {
   "jp": "2b8f8d9c",
   "kr": "게다가 우리도 이그니스로"
  },
  "74": {
   "jp": "b948b2ed",
   "kr": "가는 길이고."
  },
  "75": {
   "jp": "449d3132",
   "kr": "방향도 같은걸."
  },
  "76": {
   "jp": "43969fcf",
   "kr": "많은 사람 목숨이 걸려 있어."
  },
  "77": {
   "jp": "beecaae7",
   "kr": "모른 척할 순 없어."
  },
  "78": {
   "jp": "9a0e80bd",
   "kr": "그런가, 고맙네."
  },
  "79": {
   "jp": "875650ad",
   "kr": "자네들은 최고의 길동무일세."
  },
  "80": {
   "jp": "ddbe8269",
   "kr": "가루가는 반드시 나타난다."
  },
  "81": {
   "jp": "06b4952e",
   "kr": "앰비쉬로 서두르시게."
  }
 }
}