  },
  "85": {
   "jp": "127db0a8",
   "kr": "인가."
  },
  "86": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "87": {
   "jp": "15054edb",
   "kr": "받을게."
  },
  "88": {
   "jp": "47dbca29",
   "kr": "이거면 마수도 안 무섭겠어!"
  },
  "89": {
   "jp": "db59450c",
   "kr": "어느 걸 파시겠어요?"
  },
  "90": {
   "jp": "127db0a8",
   "kr": "인가."
  },
  "91": {
   "jp": "abb8567e",
   "kr": "그렇다면"
  },
  "92": {
   "jp": "ef144df2",
