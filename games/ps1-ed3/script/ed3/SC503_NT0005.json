  },
  "102": {
   "jp": "a7bb082c",
   "kr": "고마워."
  },
  "103": {
   "jp": "0e30173e",
   "kr": "무기랑 방어구는 자주 점검하세요."
  },
  "104": {
   "jp": "599fb3d9",
   "kr": "여기 술은 각별히 맛있지."
