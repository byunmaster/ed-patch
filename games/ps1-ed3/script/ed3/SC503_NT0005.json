  },
  "25": {
   "jp": "d0678480",
   "kr": "그러니 쓰는 법은 지극히 신중해야 하옵니다."
  },
  "26": {
   "jp": "3f66c4a1",
   "kr": "하이젠 챠펠에 어서 오십시오."
  },
  "27": {
   "jp": "9cac1cb5",
   "kr": "우리 챠펠의 힘이 필요하십니까?"
  },
  "28": {
   "jp": "34092ac0",
   "kr": "어느 분이 힘을 구하십니까?"
  },
  "29": {
   "jp": "788e1f8c",
   "kr": "어느 마법을 원하십니까?"
  },
  "30": {
   "jp": "50a81083",
   "kr": ", 그렇군요."
  },
  "31": {
   "jp": "e5254e85",
   "kr": "좋습니다, 전수하지요."
  },
  "32": {
   "jp": "634766f0",
   "kr": "우리 챠펠의 힘이 필요할 때는"
  },
  "33": {
   "jp": "02176504",
   "kr": "사양 말고 다시 오십시오."
  },
  "34": {
   "jp": "4c1269e2",
   "kr": "휘리."
  },
  "35": {
   "jp": "53fe4469",
   "kr": "언제 봐도 귀엽구나."
  },
  "36": {
   "jp": "05f9f000",
   "kr": "코르테 씨."
  },
  "37": {
   "jp": "460ca5cb",
   "kr": "마을 망보느라 수고가 많네."
  },
  "38": {
   "jp": "a7960b40",
   "kr": "마을 안은 이상 없어."
  },
  "39": {
   "jp": "09ee6314",
   "kr": "산적은 이 근처를 떠난 모양이고"
  },
  "40": {
   "jp": "2123662d",
   "kr": "하이젠은 아주 평화로워."
  },
  "41": {
   "jp": "3f5757f0",
   "kr": "여어, 휘리."
  },
  "42": {
   "jp": "73a4b580",
   "kr": "오늘도 귀엽네."
  },
  "43": {
   "jp": "1eaddbf3",
   "kr": "맞다."
  },
  "44": {
   "jp": "5c77dba0",
   "kr": "늘 고민하시는 임금님이지만"
  },
  "45": {
   "jp": "58f3e526",
   "kr": "이번엔 유난히"
  },
  "46": {
   "jp": "d06c7f5b",
   "kr": "고민하고 계신 모양이야."
  },
  "47": {
   "jp": "e6cc2ee3",
   "kr": "얼굴 좀 비춰 드리렴."
  },
  "48": {
   "jp": "8ac0e1d1",
   "kr": "분명 휘리 얼굴을"
  },
  "49": {
   "jp": "a4120265",
   "kr": "보시면 기운이 나실 거야."
  },
  "50": {
   "jp": "44610959",
   "kr": "임금님은 어떠셨니?"
  },
  "51": {
   "jp": "478a3d4b",
   "kr": "이제 괜찮아요."
  },
  "52": {
   "jp": "6b4d2745",
   "kr": "고민은 해결된 것 같아요."
  },
  "53": {
   "jp": "18281c1f",
   "kr": "역시 휘리야."
  },
  "54": {
   "jp": "fb1108a2",
   "kr": "리즈의 약도 잘 듣지만"
  },
  "55": {
   "jp": "94ee1b84",
   "kr": "휘리의 웃는 얼굴에는 당할 수 없지."
  },
  "56": {
   "jp": "3dae6e0e",
   "kr": "카라탈에서 무대를 쓰니까"
  },
  "57": {
   "jp": "7253ffb2",
   "kr": "여기 청소는"
  },
  "58": {
   "jp": "1c3363dc",
   "kr": "정성껏 하고 있어."
  },
  "59": {
   "jp": "448804e5",
   "kr": "휘리도"
  },
  "60": {
   "jp": "616c9e2e",
   "kr": "다음엔 노래해 봐."
  },
  "61": {
   "jp": "f958498c",
   "kr": "에, 제가… 부끄러워요."
  },
  "62": {
   "jp": "b34e85de",
   "kr": "다음엔 휘리도"
  },
  "63": {
   "jp": "9bfa6f5a",
   "kr": "노래해 봐."
  },
  "64": {
   "jp": "e188a276",
   "kr": "다들 좋아할 거야."
  },
  "65": {
   "jp": "3f5757f0",
   "kr": "허허, 휘리."
  },
  "66": {
   "jp": "05697358",
   "kr": "잘 있었나."
  },
  "67": {
   "jp": "fbe596aa",
   "kr": "안녕하세요, 론다 씨."
  },
  "68": {
   "jp": "bb3b5872",
   "kr": "허리는 좀 어때요?"
  },
  "69": {
   "jp": "3d57e508",
   "kr": "이제 완전히 좋아졌다네."
  },
  "70": {
   "jp": "4eb4cb32",
   "kr": "휘리가 만들어 준"
  },
  "71": {
   "jp": "7952cdd6",
   "kr": "허브십 덕분이지."
  },
  "72": {
   "jp": "0473c37f",
   "kr": "요즘은 몸이 좋구먼."
  },
  "73": {
   "jp": "6b8e66b5",
   "kr": "고맙네."
  },
  "74": {
   "jp": "41fb6e30",
   "kr": "어서 와, 휘리."
  },
  "75": {
   "jp": "6b9f2192",
   "kr": "늘 상태를 보러 와 주다니"
  },
  "76": {
   "jp": "16d382b3",
   "kr": "넌 정말 다정한 아이야."
  },
  "77": {
   "jp": "a71540f6",
   "kr": "분명 좋은 신붓감이 될 거야."
  },
  "78": {
   "jp": "d862afe1",
   "kr": "벽에 걸린 무기를 봐 줘."
  },
  "79": {
   "jp": "895a8c27",
   "kr": "저렇게까지 반짝반짝 닦는 게"
  },
  "80": {
   "jp": "ab47c9f1",
   "kr": "보통 일이 아니라고."
  },
  "81": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "82": {
   "jp": "37876911",
   "kr": "요즘 좋은 무기가 들어왔죠."
  },
  "83": {
   "jp": "cb18b475",
   "kr": "다룰 수 있다면 남는 장사예요."
  },
  "84": {
   "jp": "20c815c0",
