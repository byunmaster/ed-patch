  },
  "14": {
   "jp": "5b5733b0",
   "kr": "하이젠 병사"
  },
  "15": {
   "jp": "5e859f1a",
   "kr": "마법을 배우러 온 게 아니어도"
  },
  "16": {
   "jp": "8de3bbfe",
   "kr": "편히 쉬다 가세요."
  },
  "17": {
   "jp": "aba1b91a",
   "kr": "여기서는 칸드 마법을 가르쳐 드립니다."
  },
  "18": {
   "jp": "bfb7aed5",
   "kr": "어느 분이 원하시나요?"
  },
  "19": {
   "jp": "c6108ff0",
   "kr": "어느 마법을 원하시나요?"
  },
  "20": {
