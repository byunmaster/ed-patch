   "jp": "16b2a2e8",
   "kr": "루드성"
  },
  "1": {
   "jp": "a9fb6762",
   "kr": "안뜰"
  },
  "2": {
   "jp": "32499e3b",
   "kr": "브리트 대장"
  },
  "3": {
   "jp": "e1aa41d1",
   "kr": "실례했습니다."
  },
  "4": {
   "jp": "16076ebe",
   "kr": "아니, 계획대로다."
  },
  "5": {
   "jp": "855a792c",
   "kr": "덕분에 살았다."
  },
  "6": {
   "jp": "d30cb3ef",
   "kr": "안뜰에는 병사가 많습니다만"
  },
  "7": {
   "jp": "8b69a343",
   "kr": "모두 레바스의 술법으로"
  },
  "8": {
   "jp": "1fcb5871",
   "kr": "의식이 봉인돼 있습니다."
  },
  "9": {
   "jp": "5e35aec5",
   "kr": "레바스는 소대마다 술법을 걸고"
  },
  "10": {
   "jp": "8647022c",
   "kr": "마지막에 그 부대 리더에게 술을 걸어"
  },
  "11": {
   "jp": "7ebada88",
   "kr": "국경으로 보내는 것입니다."
  },
  "12": {
   "jp": "e2fd1e92",
   "kr": "그 사람들과 싸워야만 하나요?"
  },
  "13": {
   "jp": "4ff084fc",
   "kr": "지금 안뜰의 병사들은"
  },
  "14": {
   "jp": "878c8efe",
   "kr": "레바스의 명령이 있을 때까지 안 움직입니다."
  },
  "15": {
   "jp": "415e665e",
   "kr": "싸우지 않아도 됩니다."
  },
  "16": {
   "jp": "51db67a9",
   "kr": "개의치 말고 안으로 가십시오."
  },
  "17": {
   "jp": "50e940e7",
   "kr": "저는 여기서 듀르젤 님의"
  },
  "18": {
   "jp": "2d1c0d7b",
   "kr": "동료분들이 오실 때를 대비해"
  },
  "19": {
   "jp": "62e43d85",
   "kr": "대기하고 있겠습니다."
  },
  "20": {
   "jp": "22ab9243",
   "kr": "고맙군."
  },
  "21": {
   "jp": "2824ee2f",
   "kr": "부디 조심하십시오."
  },
  "22": {
   "jp": "50e940e7",
   "kr": "저는 여기서 듀르젤 님 일행의"
  },
  "23": {
   "jp": "2d1c0d7b",
   "kr": "동료분들이 오실 때를 대비해"
  },
  "24": {
   "jp": "62e43d85",
   "kr": "대기하고 있겠습니다."
  },
  "25": {
   "jp": "e1eebe92",
   "kr": "제가 여기 대기하고 있으니 안심하십시오."
  },
  "26": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "27": {
   "jp": "3adae119",
