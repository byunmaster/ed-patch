{
 "archive": "/SCE1/SC104.DAT",
 "member": "..\\DATA\\MT5110.BIN",
 "lines": {
  "0": {
   "jp": "1a0093fc",
   "kr": "튜엘"
  },
  "1": {
   "jp": "aa151e61",
   "kr": "선착장"
  },
  "2": {
   "jp": "a289eb28",
   "kr": "산토스"
  },
  "3": {
   "jp": "7db13581",
   "kr": "오랜만에 여행을 한 기분이군."
  },
  "4": {
   "jp": "7b32c2d2",
   "kr": "이런 사태가 일어나지 않았다면"
  },
  "5": {
   "jp": "09a96529",
   "kr": "공무가 너무 바빠서"
  },
  "6": {
   "jp": "64909838",
   "kr": "여행은커녕 그럴 겨를도 없었겠지요."
  },
  "7": {
   "jp": "39b48fd5",
   "kr": "저들을 위해서라도"
  },
  "8": {
   "jp": "d6376ece",
   "kr": "앰비쉬 사람들을 위해서라도"
  },
  "9": {
   "jp": "f4813b27",
   "kr": "가루가를 어떻게든 해야겠군."
  },
  "10": {
   "jp": "932099c6",
   "kr": "이미 볼트 연안에 군을 배치했습니다."
  },
  "11": {
   "jp": "dd1a7e04",
   "kr": "가루가는 병력만으로 쓰러뜨릴 상대가 아니다."
  },
  "12": {
   "jp": "6985636b",
   "kr": "그건 넬바의 참상이 증명하고 있다."
  },
  "13": {
   "jp": "d0e264de",
   "kr": "게르드의 예언이 현실이 될 줄이야…"
  },
  "14": {
   "jp": "c0c7e584",
   "kr": "좀 더 일찍 노르딕 왕과 회견해서"
  },
  "15": {
   "jp": "69d49391",
   "kr": "가루가에 맞설 방어책을"
  },
  "16": {
   "jp": "e5e1104c",
   "kr": "마련하게 했어야 했군."
  },
  "17": {
   "jp": "2d8b7867",
   "kr": "내가 산토스인데."
  },
  "18": {
   "jp": "5aaf45d3",
   "kr": "아아, 그런가. 너희도 가루가 얘기를"
  },
  "19": {
   "jp": "58969c4e",
   "kr": "들으러 온 거지?"
  },
  "20": {
   "jp": "e7f4e798",
   "kr": "가루가를 봤다는 것만으로"
  },
  "21": {
   "jp": "7144ee96",
   "kr": "어느새 인기인이 됐어."
  },
  "22": {
   "jp": "9fdca96d",
   "kr": "가루가를 본 건 어느 근처였나?"
  },
  "23": {
   "jp": "5808548a",
   "kr": "동쪽 로프섬이야."
  },
  "24": {
   "jp": "f3a0dc0d",
   "kr": "가루가 녀석 로프섬에서 벌러덩"
  },
  "25": {
   "jp": "479ff8d1",
   "kr": "자빠져 자고 있더라고."
  },
  "26": {
   "jp": "a6d0c8d3",
   "kr": "그놈 그 덩치잖아."
  },
  "27": {
   "jp": "5bbfbc03",
   "kr": "꼭 쿠션에 엎드려"
  },
  "28": {
   "jp": "684964da",
   "kr": "자고 있는 고래 같았어."
  },
  "29": {
   "jp": "dbe9dfee",
   "kr": "됐다! 가루가 녀석"
  },
  "30": {
   "jp": "535e39ef",
   "kr": "테그라, 넬바를 부수고 다니더니"
  },
  "31": {
   "jp": "2ad60ac1",
   "kr": "드디어 지쳤나 보군."
  },
  "32": {
   "jp": "6e2aaf20",
   "kr": "가루가 녀석은 한번 잠들면"
  },
  "33": {
   "jp": "487d2c72",
   "kr": "며칠이고 계속 잔다고 들은 적 있다."
  },
  "34": {
   "jp": "d3ab9e61",
   "kr": "시간을 벌겠어."
  },
  "35": {
   "jp": "ac735b87",
   "kr": "저기, 지금 이 틈에"
  },
  "36": {
   "jp": "f3c66671",
   "kr": "배로 둘러싸서 해치우면 어때?"
  },
  "37": {
   "jp": "f4a5f08b",
   "kr": "내 킥은 강렬하다고."
  },
  "38": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "39": {
   "jp": "9a636caa",
   "kr": "그건 잘 들어."
  },
  "40": {
   "jp": "a0190a0e",
   "kr": "과, 과격한 의견이군."
  },
  "41": {
   "jp": "a492877b",
   "kr": "정말 챠펠 집 딸 맞냐?"
  },
  "42": {
   "jp": "4d523557",
   "kr": "그러다 가루가를 깨우면"
  },
  "43": {
   "jp": "c66370a7",
   "kr": "화나서 날뛰기 시작한다고."
  },
  "44": {
   "jp": "0a0019c1",
   "kr": "게다가 놓치면 성가시네."
  },
  "45": {
   "jp": "5c3a0666",
   "kr": "상처 입은 짐승은 무슨 짓을 할지 모르네."
  },
  "46": {
   "jp": "a14ba251",
   "kr": "공격을 걸 거라면"
  },
  "47": {
   "jp": "f104be50",
   "kr": "달아날 데 없는 곳에서 해야 하네."
  },
  "48": {
   "jp": "9adfe69c",
   "kr": "확실히 그 말대로다."
  },
  "49": {
   "jp": "228bbc7e",
   "kr": "아저씨, 대단하잖아."
  },
  "50": {
   "jp": "b3358501",
   "kr": "생각이 깊군."
  },
  "51": {
   "jp": "70a042b9",
   "kr": "아니, 뭐… 그냥."
  },
  "52": {
   "jp": "190c00b7",
   "kr": "너희들, 진심으로 저 가루가를"
  },
  "53": {
   "jp": "40464521",
   "kr": "쓰러뜨릴 셈인 거냐!?"
  },
  "54": {
   "jp": "0d3f4522",
   "kr": "당연하죠!"
  },
  "55": {
   "jp": "d6649bdb",
   "kr": "저희는 순례 여행자인걸요!"
  },
  "56": {
   "jp": "32ccae2f",
   "kr": "내버려 둘 순 없잖아요."
  },
  "57": {
   "jp": "a34385b1",
   "kr": "엇, 그, 그런 거야?"
  },
  "58": {
   "jp": "13de6798",
   "kr": "나는 틀림없이 앰비쉬 임금님께"
  },
  "59": {
   "jp": "00a23a25",
   "kr": "알리러 가는 것뿐인 줄 알았어."
  },
  "60": {
   "jp": "3fa4a675",
   "kr": "여기선 지금 먼저 가서"
  },
  "61": {
   "jp": "d9e6f67b",
   "kr": "가루가보다 빨리 볼트에 닿는 게 급선무."
  },
  "62": {
   "jp": "949d1ef3",
   "kr": "거기서 맞받아칠 준비를 하는 게 현명하네."
  },
  "63": {
   "jp": "73facca9",
   "kr": "뭐, 어쨌든"
  },
  "64": {
   "jp": "21504ffe",
   "kr": "가루가가 자고 있는 건"
  },
  "65": {
   "jp": "fdab6d33",
   "kr": "고마운 일이다."
  },
  "66": {
   "jp": "5502c1e3",
   "kr": "나머진 이 튜엘 항구에"
  },
  "67": {
   "jp": "bc6c9d09",
   "kr": "볼트에서 오는 배가 와 주면"
  },
  "68": {
   "jp": "53aeb215",
   "kr": "더 고마울 텐데."
  },
  "69": {
   "jp": "8c8bbc2c",
   "kr": "으〜음."
  },
  "70": {
   "jp": "7d0fd57b",
   "kr": "그건 어렵지."
  },
  "71": {
   "jp": "b2525c84",
   "kr": "가루가가 코앞에 있다는 걸 다들 안다고."
  },
  "72": {
   "jp": "2b2eeeb9",
   "kr": "어지간한 일이 아닌 한 겁먹어서"
  },
  "73": {
   "jp": "723f51b3",
   "kr": "당분간 배 따위 안 올걸."
  },
  "74": {
   "jp": "38c50076",
   "kr": "그렇겠지…"
  },
  "75": {
   "jp": "3f77df67",
   "kr": "튜엘에서 볼트로 건너려면"
  },
  "76": {
   "jp": "2214a2c6",
   "kr": "작은 배 따위론 도저히 무리다."
  },
  "77": {
   "jp": "2f2cc90d",
   "kr": "역시 챠놈 경유로 육로로 갈 수밖에 없나."
  },
  "78": {
   "jp": "b2525c84",
   "kr": "가루가가 코앞에 있다는 걸 다들 안다고."
  },
  "79": {
   "jp": "2b2eeeb9",
   "kr": "어지간한 일이 아닌 한 겁먹어서"
  },
  "80": {
   "jp": "723f51b3",
   "kr": "당분간 배 따위 안 올걸."
  },
  "81": {
   "jp": "d1db1aa2",
   "kr": "젠장!"
  },
  "82": {
   "jp": "39a70497",
   "kr": "조금만 더 하면 물 새는 걸 막았는데"
  },
  "83": {
   "jp": "86990531",
   "kr": "그 대형선 탓에 다 망쳤어!"
  },
  "84": {
   "jp": "474e515b",
   "kr": "군선이란 건 입항이 거칠어서 질색이야."
  },
  "85": {
   "jp": "2f05e36b",
   "kr": "그러고 보니 너희 일행이"
  },
  "86": {
   "jp": "2748d3be",
   "kr": "그 배에 올라타던데."
  },
  "87": {
   "jp": "04956a81",
   "kr": "뭐 하는 사람이야? 그 아저씨는."
  },
  "88": {
   "jp": "6d7abdab",
   "kr": "커다란 갤리선이었어."
  },
  "89": {
   "jp": "09a8215c",
   "kr": "근데 가루가에 비하면"
  },
  "90": {
   "jp": "eb8ca0fc",
   "kr": "애들 장난감 같지만."
  }
 }
}