{
 "archive": "/SCE6/SC606.DAT",
 "member": "..\\DATA\\GT3000.BIN",
 "lines": {
  "0": {
   "jp": "26fb5f27",
   "kr": "딜트 관문"
  },
  "1": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "2": {
   "jp": "44a77ad2",
   "kr": "네, 그러시죠."
  },
  "3": {
   "jp": "d386d9dd",
   "kr": "저희 순례 여행에서 돌아오는 길이에요."
  },
  "4": {
   "jp": "92e997c6",
   "kr": "순례가 뭔데?"
  },
  "5": {
   "jp": "dade8e0d",
   "kr": "모르세요?"
  },
  "6": {
   "jp": "07fefcaa",
   "kr": "그래, 그렇다!"
  },
  "7": {
   "jp": "dbdac433",
   "kr": "몰라서 미안하게 됐군!"
  },
  "8": {
   "jp": "aaaf0349",
   "kr": "꺅… 무서워…"
  },
  "9": {
   "jp": "451bafeb",
   "kr": "이봐, 그렇게 소리 지를 건 없잖아."
  },
  "10": {
   "jp": "5e065151",
   "kr": "시끄러워. 불만 있나."
  },
  "11": {
   "jp": "1f5a43bc",
   "kr": "흥…"
  },
  "12": {
   "jp": "a6ffd576",
   "kr": "그럼, 통과시켜 주지 않을 테다."
  },
  "13": {
   "jp": "36e58ee4",
   "kr": "그런〜"
  },
  "14": {
   "jp": "b94b6baf",
   "kr": "말도 안 돼."
  },
  "15": {
   "jp": "c958c03e",
   "kr": "말이 안 돼도 상관없어."
  },
  "16": {
   "jp": "fd75a641",
   "kr": "나는 여기 담당관을 맡고 있다."
  },
  "17": {
   "jp": "eee0a470",
   "kr": "여기서는 내가 제일 높아."
  },
  "18": {
   "jp": "10580e4b",
   "kr": "어머, 그러세요."
  },
  "19": {
   "jp": "3ad29522",
   "kr": "대단하네요."
  },
  "20": {
   "jp": "49524598",
   "kr": "멋져요."
  },
  "21": {
   "jp": "5de75a33",
   "kr": "어, 아, 그래?"
  },
  "22": {
   "jp": "166b0fc2",
   "kr": "그런가아…"
  },
  "23": {
   "jp": "3f0e9fe2",
   "kr": "지나가도 될까요?"
  },
  "24": {
   "jp": "0afce86e",
   "kr": "순례에서 돌아오는 길이었지."
  },
  "25": {
   "jp": "49e1304d",
   "kr": "좋아, 좋아."
  },
  "26": {
   "jp": "398899a6",
   "kr": "자, 어서. 지나가."
  },
  "27": {
   "jp": "766d284d",
   "kr": "쥬리오는 일단 은단검을 보여 주었다."
  },
  "28": {
   "jp": "02bf6af9",
   "kr": "좋아, 됐어."
  },
  "29": {
   "jp": "3a6af625",
   "kr": "도개교가 내려오면 폴티아 쪽으로 가서"
  },
  "30": {
   "jp": "1329ae66",
   "kr": "출구에 있는 담당관에게 한 번 더 보여라."
  },
  "31": {
   "jp": "73923bdc",
   "kr": "그러면 돼."
  },
  "32": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "33": {
   "jp": "96de3eee",
   "kr": "여행자냐?"
  },
  "34": {
   "jp": "5c028cf6",
   "kr": "폴티아에 가는 거냐?"
  },
  "35": {
   "jp": "cd696979",
   "kr": "가는 게 아니라 돌아가는 거죠."
  },
  "36": {
   "jp": "eef406ca",
   "kr": "저흰 폴티아 사람이에요."
  },
  "37": {
   "jp": "960a25c6",
   "kr": "여행에서 돌아오는 길이에요."
  },
  "38": {
   "jp": "beed95cc",
   "kr": "그런가, 실례했군."
  },
  "39": {
   "jp": "caddfd43",
   "kr": "고향에 돌아가는 거라면 문제는 없겠지."
  },
  "40": {
   "jp": "a2ea6736",
   "kr": "지나가도 좋다."
  },
  "41": {
   "jp": "ed306d71",
   "kr": "뭐냐?"
  },
  "42": {
   "jp": "b0573de0",
   "kr": "이 국경은 기드나와의 협의 하에"
  },
  "43": {
   "jp": "6cf16f3a",
   "kr": "폴티아 병사가 지키고 있는 거야."
  },
  "44": {
   "jp": "200f1376",
   "kr": "딱히 문제없다."
  },
  "45": {
   "jp": "a986e73d",
   "kr": "폴티아군이 이 국경을 지키는 건"
  },
  "46": {
   "jp": "67b1b671",
   "kr": "어디까지나 자선 사업이야."
  },
  "47": {
   "jp": "c18d9bbd",
   "kr": "호오, 일반 나그네라니 드문 일이군."
  },
  "48": {
   "jp": "11514993",
   "kr": "지금 이 요새 안은"
  },
  "49": {
   "jp": "1823561a",
   "kr": "폴티아에서 국경 경비로 좌천된"
  },
  "50": {
   "jp": "74b57d4a",
   "kr": "성질 급한 병사들로 가득하니까."
  },
  "51": {
   "jp": "18e7941d",
   "kr": "부디 조심하라고."
  },
  "52": {
   "jp": "8b424793",
   "kr": "거친 병사 따위 안 무서워요."
  },
  "53": {
   "jp": "cb8f1d82",
   "kr": "뭐, 뭐라고!!"
  },
  "54": {
   "jp": "793fa007",
   "kr": "누구 덕에 국경의 평화가"
  },
  "55": {
   "jp": "492e2a3d",
   "kr": "지켜진다고 생각하는 거냐!!"
  },
  "56": {
   "jp": "6c94044c",
   "kr": "으아아아…"
  },
  "57": {
   "jp": "c76876c0",
   "kr": "말버릇을 조심하는 게 좋을 거다."
  },
  "58": {
   "jp": "396342cc",
   "kr": "여기 병사들은 다들 거치니까."
  },
  "59": {
   "jp": "98a9a737",
   "kr": "진짜네. 거친 병사야."
  },
  "60": {
   "jp": "e79fd6cb",
   "kr": "여어, 안녕."
  },
  "61": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "62": {
   "jp": "b7d621b1",
   "kr": "이 국경에 주둔하고 있는 병사들은"
  },
  "63": {
   "jp": "2a7dff0a",
   "kr": "나를 포함해서 어느 쪽인가 하면"
  },
  "64": {
   "jp": "07d790c8",
   "kr": "별 볼 일 없는 녀석들뿐이야."
  },
  "65": {
   "jp": "0ac065ab",
   "kr": "영문도 모르고"
  },
  "66": {
   "jp": "2ce466ed",
   "kr": "여기 경비를 명령받아서"
  },
  "67": {
   "jp": "c6daa623",
   "kr": "하나같이 감정이 격해져 있어."
  },
  "68": {
   "jp": "8a4a7196",
   "kr": "무례가 있을지 모르지만"
  },
  "69": {
   "jp": "5aa84726",
   "kr": "뭐, 너그럽게 봐줘."
  },
  "70": {
   "jp": "342ea0e0",
   "kr": "왜 우리가 기드나의 국경 경비까지"
  },
  "71": {
   "jp": "b90be3c1",
   "kr": "해야만 하는 거냐."
  },
  "72": {
   "jp": "255a1460",
   "kr": "흥, 못 해 먹겠군."
  },
  "73": {
   "jp": "ddaa90e1",
   "kr": "저, 저기."
  },
  "74": {
   "jp": "d4c2e94e",
   "kr": "뭐야."
  },
  "75": {
   "jp": "8186813a",
   "kr": "여기 국경 경비를 명령한 건 누구예요?"
  },
  "76": {
   "jp": "633514ba",
   "kr": "뻔한 걸 묻지 마라."
  },
  "77": {
   "jp": "6875cf05",
   "kr": "당연히 루돌프 왕이시지!"
  },
  "78": {
   "jp": "32467a1c",
   "kr": "루돌프 왕?"
  },
  "79": {
   "jp": "65945873",
   "kr": "레바스 아니고요?"
  },
  "80": {
   "jp": "d5d66019",
   "kr": "그게 누구냐?"
  },
  "81": {
   "jp": "35274be7",
   "kr": "그런 놈은 모른다."
  },
  "82": {
   "jp": "84a4ef34",
   "kr": "나한테 트집이라도 잡겠다는 거냐."
  },
  "83": {
   "jp": "91b03ec7",
   "kr": "깔보지 마라. 빌어먹을."
  },
  "84": {
   "jp": "928a2805",
   "kr": "당신 참 멋지네요."
  },
  "85": {
   "jp": "047e7e11",
   "kr": "그, 그런가."
  },
  "86": {
   "jp": "b81ae56f",
   "kr": "에헤헤. 에헤헤."
  }
 }
}