  },
  "3": {
   "jp": "7992acfd",
   "kr": "친위대장 라트레"
  },
  "4": {
   "jp": "7dd7689a",
   "kr": "노르딕 왕"
  },
  "5": {
   "jp": "88f9f46e",
   "kr": "에포"
  },
  "6": {
   "jp": "fb5207bd",
   "kr": "파시아"
  },
  "7": {
   "jp": "0fa41cad",
   "kr": "시온"
  },
  "8": {
   "jp": "a133d06b",
   "kr": "카리스"
  },
  "9": {
   "jp": "491515da",
   "kr": "오네스"
  },
  "10": {
   "jp": "89f549b1",
   "kr": "무기상 토루"
  },
  "11": {
   "jp": "b33d3b63",
   "kr": "도구상 엘사"
  },
  "12": {
   "jp": "2a711abe",
   "kr": "아포카"
  },
  "13": {
   "jp": "e2af02b9",
   "kr": "제네 할머니"
  },
  "14": {
   "jp": "0fc95ade",
   "kr": "여관 주인 호리"
  },
  "15": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "16": {
   "jp": "b05fdb2a",
   "kr": "… 쥬리오, 일어나 봐!"
  },
  "17": {
   "jp": "6522155f",
   "kr": "응…"
  },
  "18": {
   "jp": "007e597f",
   "kr": "하아〜 잘 잤다."
  },
  "19": {
   "jp": "60a084c8",
   "kr": "안녕〜, 크리스."
  },
  "20": {
   "jp": "533f16b2",
   "kr": "정말!"
  },
  "21": {
   "jp": "3b2b46f9",
   "kr": "안녕〜은 무슨!!"
  },
  "22": {
   "jp": "0a0749b7",
   "kr": "여행 나와서도 이러면"
  },
  "23": {
   "jp": "2cfbabea",
   "kr": "두고 가 버린다고 말했잖아!"
  },
  "24": {
   "jp": "7413084d",
   "kr": "무, 뭘 그렇게 화내는 거야?"
  },
  "25": {
   "jp": "5fe9ca0d",
   "kr": "알프 씨가 없어져 버렸어!"
  },
  "26": {
   "jp": "5590ff80",
   "kr": "네?"
  },
  "27": {
   "jp": "e88e6542",
   "kr": "젠장!"
  },
  "28": {
   "jp": "264417d6",
   "kr": "어떻게 된 거야…"
  },
  "29": {
   "jp": "3cb18c3e",
   "kr": "항구에서 들었는데, 방금 막"
  },
  "30": {
   "jp": "70d09b1f",
   "kr": "커다란 배가 알프 같은 자를"
  },
  "31": {
   "jp": "2ec423e6",
   "kr": "태우고 출항했다더군."
  },
  "32": {
   "jp": "33789959",
   "kr": "노르딕 왕을 알현하질 않나…"
  },
  "33": {
   "jp": "2b5fbafb",
   "kr": "대체 뭐 하는 자냐?"
  },
  "34": {
   "jp": "6f7f6fbf",
   "kr": "잠깐만!"
  },
  "35": {
   "jp": "4587ca15",
   "kr": "반지가 있어."
  },
  "36": {
   "jp": "90534653",
   "kr": "왜요?"
  },
  "37": {
   "jp": "e1aee04a",
   "kr": "어디 좀 보자."
  },
  "38": {
   "jp": "7fbed38a",
   "kr": "아마 알프 씨가 끼고 있던 거야."
  },
  "39": {
   "jp": "65fa0416",
   "kr": "반지를 두고 어디 간 걸까."
  },
  "40": {
   "jp": "40060cd5",
   "kr": "이건…"
  },
  "41": {
   "jp": "b87288bd",
   "kr": "닳아서 알아보기 어렵지만"
  },
  "42": {
   "jp": "ba586e7f",
   "kr": "틀림없는 앰비쉬의 문장이다."
  },
  "43": {
   "jp": "a029a52e",
   "kr": "앰비쉬?"
  },
  "44": {
   "jp": "a9a8fd35",
   "kr": "그 아저씨, 무슨 속셈이야!"
  },
  "45": {
   "jp": "0598a0fd",
   "kr": "아무튼 쥬리오 이걸 갖고 있어라."
  },
  "46": {
   "jp": "b64c5615",
   "kr": "잃지 마라."
  },
  "47": {
   "jp": "a6324f2d",
   "kr": "이봐, 그렇게 짐이 많아서야"
  },
  "48": {
   "jp": "a3c62da5",
   "kr": "움직이기 불편하지?"
  },
  "49": {
   "jp": "6ec5f81e",
   "kr": "뭔가 버리고 가."
  },
  "50": {
   "jp": "dbf6158f",
   "kr": "쥬리오는 "
  },
  "51": {
   "jp": "95b166cd",
   "kr": "을(를) 맡았다."
  },
  "52": {
   "jp": "05dd24ef",
   "kr": "사정은 모르겠지만 아저씨는 마을에 없다."
  },
  "53": {
   "jp": "2791879c",
   "kr": "배가 올 희망도 없다."
  },
  "54": {
   "jp": "8c7092f5",
   "kr": "우린 제 발로 볼트에 갈 수밖에 없는 거다."
  },
  "55": {
   "jp": "c7ede132",
   "kr": "가루가가 오기 전에"
  },
  "56": {
   "jp": "854ac699",
   "kr": "볼트에 닿아야 해!"
  },
  "57": {
   "jp": "62b8cc4f",
   "kr": "응. 앰비쉬에 가면"
  },
  "58": {
   "jp": "08a1bbea",
   "kr": "알프 씨를 만날지도 모르니까."
  },
  "59": {
   "jp": "d4ef5ac8",
   "kr": "좋아, 서두르자!!"
  },
  "60": {
   "jp": "994a58c5",
   "kr": "허가 없인 안 됩니다."
  },
  "61": {
   "jp": "d51298f5",
   "kr": "국왕의 명령입니다."
  },
  "62": {
   "jp": "01228168",
   "kr": "왕이 어떤 사람인지"
  },
  "63": {
   "jp": "b02414e8",
   "kr": "보고 싶었는데…"
  },
  "64": {
   "jp": "a0befd8b",
   "kr": "여기선 안 보여."
  },
  "65": {
   "jp": "62eeecff",
   "kr": "이봐 이봐."
  },
  "66": {
   "jp": "35a75348",
   "kr": "이상한 짓 하다간 붙잡힌다."
  },
  "67": {
   "jp": "4ec8a181",
   "kr": "책장에 책이 있다."
  },
  "68": {
   "jp": "817c8d00",
   "kr": "항해일지 같다."
  },
  "69": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "70": {
   "jp": "7fda17b2",
   "kr": "역시, 빈집에"
  },
  "71": {
   "jp": "7c963726",
   "kr": "멋대로 들어가면 안 돼."
  },
  "72": {
   "jp": "7440fe30",
   "kr": "그러네."
  },
  "73": {
   "jp": "d6ba8904",
   "kr": "어라? 럼주가 있네."
  },
  "74": {
   "jp": "be72b910",
   "kr": "매발톱호 사람들도"
  },
  "75": {
   "jp": "1453c06e",
   "kr": "럼주를 좋아했지."
  },
  "76": {
   "jp": "7732f3c2",
   "kr": "넬바 복구 작업이"
  },
  "77": {
   "jp": "842f499e",
   "kr": "잘 풀리면 좋겠는데."
  },
  "78": {
   "jp": "830197f0",
   "kr": "노르딕 왕도 이런 마을에 계셔서는"
  },
  "79": {
   "jp": "a65edfd5",
   "kr": "제대로 정사를 보실 수 없다."
  },
  "80": {
   "jp": "9c7e8af1",
   "kr": "어라, 여러분이군요."
  },
  "81": {
   "jp": "8a57e1d0",
   "kr": "함께 계시던 그분은 대체 어느 분이십니까?"
  },
  "82": {
   "jp": "115a14d8",
   "kr": "국왕을 태연히 뵙다니."
  },
  "83": {
   "jp": "d1bf3112",
   "kr": "대장님도 그분이 누구신지"
  },
  "84": {
   "jp": "4d6878f6",
   "kr": "알려 주지 않으세요."
  },
  "85": {
   "jp": "2525bed5",
   "kr": "루레 영감님은 이런 때인데도"
  },
  "86": {
   "jp": "8a7668ab",
   "kr": "또 집을 비워 둔 채로"
  },
  "87": {
   "jp": "43d87409",
   "kr": "다이스 마을로 놀러 가 버렸어."
  },
  "88": {
   "jp": "7d3cf0fa",
   "kr": "분명, 늘 그랬듯이"
  },
  "89": {
   "jp": "8ff74fc7",
   "kr": "문지기 하는 손자 레드 씨랑"
  },
  "90": {
   "jp": "be62c221",
   "kr": "관문에서 싸우고 있을걸."
  },
  "91": {
   "jp": "0d044ac3",
   "kr": "루레 영감님은 옛날엔 용감한 뱃사람"
  },
  "92": {
   "jp": "9aaba4dd",
   "kr": "이었다지만, 지금은 손주 속 썩이는"
  },
  "93": {
   "jp": "651915f7",
   "kr": "그냥 불량 영감님이야."
  },
  "94": {
   "jp": "29f0f381",
   "kr": "소문으론, 가루가는 로프섬에 있나 봐요."
  },
  "95": {
   "jp": "fc6f2c63",
   "kr": "배가 고파서 돌아가 주면 좋겠어요."
  },
  "96": {
   "jp": "5261270e",
   "kr": "올해는 흉작에 가루가 탓에"
  },
  "97": {
   "jp": "8f1fcc8a",
   "kr": "메나트는 엉망진창이에요."
  },
  "98": {
   "jp": "25586676",
   "kr": "이웃 나라 챠놈은"
  },
  "99": {
   "jp": "e3b0ae20",
   "kr": "메나트가 이렇게 힘든데도"
  },
  "100": {
   "jp": "987261f8",
   "kr": "식량 원조도 안 해 주네요."
  },
  "101": {
   "jp": "1ffa664d",
   "kr": "부자뿐인 나라는"
  },
  "102": {
   "jp": "202dd2c3",
   "kr": "차갑네요."
  },
  "103": {
   "jp": "6dd4d503",
   "kr": "가루가 탓에, 항구 안에"
  },
  "104": {
   "jp": "1d10caa4",
   "kr": "물고기가 없어져 버렸어."
  },
  "105": {
   "jp": "62b82a03",
   "kr": "산토스도 고생하고 있겠지."
  },
  "106": {
   "jp": "46872718",
   "kr": "이제 챠놈으로 가는 건가?"
  },
  "107": {
   "jp": "4b24e08c",
   "kr": "거긴 화려하지만"
  },
  "108": {
   "jp": "e626cd9b",
   "kr": "말썽도 많으니 조심해."
  },
  "109": {
   "jp": "c8a5059a",
   "kr": "그 나라만큼 빈부 차가"
  },
  "110": {
   "jp": "3deee1a0",
   "kr": "심한 데는 없어."
  },
  "111": {
   "jp": "fc440af1",
   "kr": "밖은 춥겠지."
  },
  "112": {
   "jp": "29380ea0",
   "kr": "천천히 쉬었다 가시게."
  },
  "113": {
   "jp": "41a8b028",
   "kr": "오오, 잘 오셨네."
  },
  "114": {
   "jp": "0ec49b26",
   "kr": "토루가 자랑하는 물건을 봐 주게."
  },
  "115": {
   "jp": "b2707b7e",
   "kr": "이런 건 어떤가?"
  },
  "116": {
   "jp": "9e2d6505",
   "kr": "오오, 좋은 걸 고르셨구먼."
  },
  "117": {
   "jp": "315adb2d",
   "kr": "어디 보자, 분명"
  },
  "118": {
   "jp": "407e4279",
   "kr": "겠군."
  },
  "119": {
   "jp": "e9fd7e34",
   "kr": "필요 없는 건 두고 가시게."
  },
  "120": {
   "jp": "a4db903d",
   "kr": "이 토루가 사들이겠네."
  },
  "121": {
   "jp": "2ac690fd",
   "kr": "오오"
  },
  "122": {
   "jp": "c19170dd",
   "kr": "인가."
  },
  "123": {
   "jp": "7a34f5c7",
   "kr": "으으음"
  },
  "124": {
   "jp": "a1449844",
   "kr": "에 사들이겠어."
  },
  "125": {
   "jp": "89d346c1",
   "kr": "아, 환율은 1 Goa가…"
  },
  "126": {
   "jp": "03da5787",
   "kr": "15 Pia였지, 아마."
  },
  "127": {
   "jp": "76ed6a20",
   "kr": "나쁘진 않다고 보네만."
  },
  "128": {
   "jp": "6bb1fdf5",
   "kr": "으음……"
  },
  "129": {
   "jp": "2798d283",
   "kr": "전부 합쳐"
  },
  "130": {
   "jp": "e0e26d82",
   "kr": "이라고 보네만."
  },
  "131": {
   "jp": "4f250f29",
   "kr": "아마 맞을 걸세."
  },
  "132": {
   "jp": "8f7aac8b",
   "kr": "라피카가 없는 것 같네만…"
  },
  "133": {
   "jp": "e8d7bdd3",
   "kr": "그런가? 아쉽구먼."
  },
  "134": {
   "jp": "20afb447",
   "kr": "이제 볼일은 없는가?"
  },
  "135": {
   "jp": "6d776b0b",
   "kr": "뭐, 천천히 쉬다 가게나."
  },
  "136": {
   "jp": "f71f3f74",
   "kr": "이런, 벌써 가려는가?"
  },
  "137": {
   "jp": "4b7ede84",
   "kr": "또 들러 주게."
  },
  "138": {
   "jp": "d7665590",
   "kr": "밖은 춥죠?"
  },
  "139": {
   "jp": "f111fc32",
   "kr": "괜찮으시면 난롯가에서 몸 좀 녹이세요."
  },
  "140": {
   "jp": "dada5d64",
   "kr": "이 마을에선, 넬바도"
  },
  "141": {
   "jp": "8d7d486d",
   "kr": "챠놈으로 빠지는 관문도 멀어요."
  },
  "142": {
   "jp": "29801591",
   "kr": "준비해 두면 다들 싱글벙글."
  },
  "143": {
   "jp": "bededed9",
   "kr": "마법저항 반지 같은 걸 추천해요."
  },
  "144": {
   "jp": "77d12e1d",
   "kr": "갖고 있어서 손해 볼 게 없는 것들뿐이죠."
  },
  "145": {
   "jp": "28c0f1c3",
   "kr": "네,"
  },
  "146": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "147": {
   "jp": "a81e7a27",
   "kr": "받겠습니다."
  },
  "148": {
   "jp": "e9e65b67",
   "kr": "짐이 많으면 도중에 지쳐 버려요."
  },
  "149": {
   "jp": "93796f24",
   "kr": "필요한 것만 갖추면 다들 싱글벙글."
  },
  "150": {
   "jp": "8fd0ffe1",
   "kr": "무엇을 사들일까요?"
  },
  "151": {
   "jp": "28c0f1c3",
   "kr": "네,"
  },
  "152": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "153": {
   "jp": "0f41ed9b",
   "kr": "을 치르겠습니다."
  },
  "154": {
   "jp": "f7a27176",
   "kr": "환율은 1 Goa가 15 Pia예요."
  },
  "155": {
   "jp": "ae27f5e1",
   "kr": "메나트에서도 평균적인 환율이에요."
  },
  "156": {
   "jp": "1e44c048",
   "kr": "자 그러면요〜"
  },
  "157": {
   "jp": "2798d283",
   "kr": "전부 합쳐"
  },
  "158": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "159": {
   "jp": "014289a4",
   "kr": "저, 계산은 자신 있거든요."
  },
  "160": {
   "jp": "f90ebd6f",
   "kr": "라피카가 없으시네요."
  },
  "161": {
   "jp": "2909fa26",
   "kr": "힘내서 벌어 오세요!"
  },
  "162": {
   "jp": "226d1582",
   "kr": "Pia로 바꾸고 싶어지면"
  },
  "163": {
   "jp": "2cded92a",
   "kr": "언제든 오세요."
  },
  "164": {
   "jp": "c5d8ed9c",
   "kr": "이제 볼일은 없으신가요?"
  },
  "165": {
   "jp": "5f6ba7d6",
   "kr": "볼일이 있으시면"
  },
  "166": {
   "jp": "58c8fb09",
   "kr": "언제든 들러 주세요."
  },
  "167": {
   "jp": "89068b49",
   "kr": "예전엔 더 북적이는 마을이었네만."
  },
  "168": {
   "jp": "75b8c0a2",
