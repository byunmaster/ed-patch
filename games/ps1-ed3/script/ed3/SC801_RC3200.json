  },
  "6": {
   "jp": "b358d3e0",
   "kr": "문은 굳게 닫혀 있다."
  },
  "7": {
   "jp": "78a91d69",
   "kr": "안 되겠다…"
  },
  "8": {
   "jp": "7a24082c",
   "kr": "안쪽에서 빗장이 걸려 있다."
  },
  "9": {
   "jp": "a12fe3b9",
   "kr": "밖에서는 열 수 없을 듯하다."
  },
  "10": {
   "jp": "b358d3e0",
   "kr": "문은 굳게 닫혀 있다."
  },
  "11": {
   "jp": "03b8c248",
   "kr": "나왔다. 마수야!"
  },
  "12": {
   "jp": "e7dad092",
   "kr": "다른 길을 찾자."
  },
  "13": {
   "jp": "55a01a07",
   "kr": "혹시"
  },
  "14": {
   "jp": "a3f2cb08",
   "kr": "옥좌에서 왼쪽으로 나가는 출구에서"
  },
  "15": {
   "jp": "a1459213",
   "kr": "길이 열릴지 몰라."
  },
  "16": {
   "jp": "ae618f3c",
   "kr": "그래, 가 보자."
  },
  "17": {
   "jp": "1255d9ac",
   "kr": "꺄앗?!"
  },
  "18": {
   "jp": "4a5277de",
   "kr": "명중이다아."
  },
  "19": {
   "jp": "ec21327d",
   "kr": "구스!?"
  },
  "20": {
   "jp": "4635a556",
   "kr": "샤라!"
  },
  "21": {
   "jp": "0bfae69e",
   "kr": "여어, 꼬마 녀석들!"
  },
  "22": {
   "jp": "506ac17e",
   "kr": "얘기는 허크한테 들었어."
  },
  "23": {
   "jp": "940fe7f8",
   "kr": "또, 그 녀석이냐…"
  },
  "24": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "25": {
   "jp": "a308a19f",
   "kr": "뭔가 빛났어."
  },
  "26": {
   "jp": "1deded0c",
   "kr": "아까 마수가 갖고 있던 건가?"
  },
  "27": {
   "jp": "57c6887b",
   "kr": "돈 되는 거라면 내가 갖지."
  },
  "28": {
   "jp": "92d9c191",
   "kr": "쳇."
  },
  "29": {
   "jp": "89365ed7",
   "kr": "뭐야, 동열쇠잖아."
  },
  "30": {
   "jp": "da11e333",
   "kr": "시시하네."
  },
  "31": {
   "jp": "9029691e",
   "kr": "줄게."
  },
  "32": {
   "jp": "53f7212b",
   "kr": "소지품이 가득이야."
  },
  "33": {
   "jp": "efcf81d5",
   "kr": "이 열쇠는 마수병이 지녔던 것."
  },
  "34": {
   "jp": "e0731ff4",
   "kr": "나중에 분명 쓸모가 있으리라."
  },
  "35": {
   "jp": "dcec7320",
   "kr": "뭔가를 대신 버리고 가자."
  },
  "36": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "37": {
   "jp": "e9d91b01",
   "kr": ", 손에 넣었다."
  },
  "38": {
   "jp": "d3f4cb7d",
   "kr": "착각하지 마."
  },
  "39": {
   "jp": "76c4274a",
   "kr": "우리는 딱히"
  },
  "40": {
   "jp": "d59b0493",
   "kr": "너희를 도우러 온 게 아니니까."
  },
  "41": {
   "jp": "7c201c28",
   "kr": "보물이라도 있을까 해서"
  },
  "42": {
   "jp": "b79044a9",
   "kr": "기드나의 유적에 원정 갔더니"
  },
  "43": {
   "jp": "793dfbe6",
   "kr": "허크를 만났거든."
  },
  "44": {
   "jp": "f98c72a7",
   "kr": "이 성 쪽이"
  },
  "45": {
   "jp": "39b8ee2d",
   "kr": "좋은 보물을 만날 수 있을 것 같다고 해서."
  },
  "46": {
   "jp": "5f018412",
   "kr": "그래, 맞아."
  },
  "47": {
   "jp": "7e97f4cb",
   "kr": "허크의 전언만 전해 주마."
  },
  "48": {
   "jp": "16d33c3f",
   "kr": "어어, 뭐였더라?"
  },
  "49": {
   "jp": "d9a40edc",
   "kr": "뭔가"
  },
  "50": {
   "jp": "3844e222",
   "kr": "복잡한 소리를 하더라고."
  },
  "51": {
   "jp": "aa1d2e2e",
   "kr": "천구의 표면에는 자라난 표피가"
  },
  "52": {
   "jp": "18c238b2",
   "kr": "붙어 있을 거다."
  },
  "53": {
   "jp": "d9469468",
   "kr": "부수기 전에"
  },
  "54": {
   "jp": "8de8e16f",
   "kr": "표피를 전부 걷어 내지 않으면"
  },
  "55": {
   "jp": "eff9bec0",
   "kr": "안 된다든가 어쩐다든가."
  },
  "56": {
   "jp": "bda32def",
   "kr": "알아들었니?"
  },
  "57": {
   "jp": "e1975356",
   "kr": "허크도 곧 뒤따라온다고 말했어."
  },
  "58": {
   "jp": "afd783db",
   "kr": "그런 셈이다."
  },
  "59": {
   "jp": "78ac7a78",
   "kr": "그럼 간다."
  },
  "60": {
   "jp": "379f0f3e",
   "kr": "녀석들, 간다!"
  },
  "61": {
   "jp": "2d5b404b",
   "kr": "산적들"
  },
  "62": {
   "jp": "8934c674",
