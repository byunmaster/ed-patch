{
 "archive": "/SCE8/SC803.DAT",
 "member": "..\\DATA\\RC6000.BIN",
 "lines": {
  "0": {
   "jp": "4651181e",
   "kr": "이자벨의 탑"
  },
  "1": {
   "jp": "672bb2b9",
   "kr": "천의실"
  },
  "2": {
   "jp": "60c7e863",
   "kr": "레바스"
  },
  "3": {
   "jp": "0ac85db0",
   "kr": "레바스의 목소리"
  },
  "4": {
   "jp": "02e7c8ff",
   "kr": "그래, 그대로 이리로 오너라."
  },
  "5": {
   "jp": "0ac85db0",
   "kr": "레바스의 목소리"
  },
  "6": {
   "jp": "e22b4cc4",
   "kr": "왜 그래, 무섭나?"
  },
  "7": {
   "jp": "0c7b4e0e",
   "kr": "후후후후후…"
  },
  "8": {
   "jp": "c7611fa8",
   "kr": "봐라, 이 천구의를."
  },
  "9": {
   "jp": "4838f126",
   "kr": "어떤가."
  },
  "10": {
   "jp": "677c33c3",
   "kr": "이 확실한 고동…"
  },
  "11": {
   "jp": "c01f9465",
   "kr": "무수한 상념을 흡수한 천구의는"
  },
  "12": {
   "jp": "02f81b3c",
   "kr": "이제 물체이면서 생명을 얻어"
  },
  "13": {
   "jp": "96001675",
   "kr": "최고조까지 성장했다."
  },
  "14": {
   "jp": "93e19e58",
   "kr": "늦었군."
  },
  "15": {
   "jp": "32cf8449",
   "kr": "이제는 내가 손을 댈 필요도 없다."
  },
  "16": {
   "jp": "a9c057f8",
   "kr": "의식은 모두 끝났다."
  },
  "17": {
   "jp": "801f1063",
   "kr": "이제 라우알의 파도가"
  },
  "18": {
   "jp": "cf97b735",
   "kr": "이 세계에 나타나기를 기다릴 뿐이다."
  },
  "19": {
   "jp": "293ca641",
   "kr": "그런…"
  },
  "20": {
   "jp": "1299ddbf",
   "kr": "어째서 이런 짓을…"
  },
  "21": {
   "jp": "0f427018",
   "kr": "영문도 모른 채"
  },
  "22": {
   "jp": "fafc086c",
   "kr": "멸망해 가는 세계와 함께"
  },
  "23": {
   "jp": "3c6d0670",
   "kr": "사라지는 것도 재미있겠지만…"
  },
  "24": {
   "jp": "6ae691c6",
   "kr": "여기까지 온 노력에 경의를 표하며"
  },
  "25": {
   "jp": "085de35f",
   "kr": "알려 주지."
  },
  "26": {
   "jp": "3adae119",
   "kr": "………"
  },
  "27": {
   "jp": "b20edcd4",
   "kr": "너희가 이계라 부르는"
  },
  "28": {
   "jp": "37e2dcff",
   "kr": "우리 세계를 구하기 위해서다."
  },
  "29": {
   "jp": "9bd58052",
   "kr": "마녀의 바다에 뜬 마녀의 섬."
  },
  "30": {
   "jp": "15853999",
   "kr": "너희는 그리 여기는 모양이지만"
  },
  "31": {
   "jp": "9dabe58e",
   "kr": "현실은 조금 다르다."
  },
  "32": {
   "jp": "d0580ee2",
   "kr": "거기에 섬은 없고"
  },
  "33": {
   "jp": "2a7eb820",
   "kr": "있는 건 공간의 『뒤틀림』이다."
  },
  "34": {
   "jp": "69b59742",
   "kr": "그곳에서 두 세계는 이어져"
  },
  "35": {
   "jp": "ba2e385c",
   "kr": "이 세계와 이계의 왕래를"
  },
  "36": {
   "jp": "31cce55f",
   "kr": "유일하게 가능케 하고 있는 것이다."
  },
  "37": {
   "jp": "8e0423b7",
   "kr": "이계에도"
  },
  "38": {
   "jp": "b71e2cdd",
   "kr": "이 세계와 똑같이 인간이 살고"
  },
  "39": {
   "jp": "ca94f648",
   "kr": "사람들의 삶이 있다."
  },
  "40": {
   "jp": "05d6d390",
   "kr": "그 사람들의 삶이"
  },
  "41": {
   "jp": "404952c7",
   "kr": "라우알의 파도로 인해"
  },
  "42": {
   "jp": "5c135c52",
   "kr": "무너지려 하고 있는 것이다."
  },
  "43": {
   "jp": "a291d22e",
   "kr": "그걸 깨달은 건"
  },
  "44": {
   "jp": "a1747c97",
   "kr": "지금으로부터 30년쯤 전의 일이다."
  },
  "45": {
   "jp": "f04a737e",
   "kr": "우리 세계의 인간은"
  },
  "46": {
   "jp": "3720c373",
   "kr": "태어날 때부터 마법을 다뤘다."
  },
  "47": {
   "jp": "54507630",
   "kr": "허나 그것이 화근이 됐다."
  },
  "48": {
   "jp": "99707eee",
   "kr": "마법을 다룰 때 다 삭이지 못한"
  },
  "49": {
   "jp": "51380604",
   "kr": "어두운 상념이 오랜 세월 공간에 쌓여"
  },
  "50": {
   "jp": "b44c6cab",
   "kr": "손쓸 수 없는 괴물이 된 것이다."
  },
  "51": {
   "jp": "bf2325a3",
   "kr": "그게 라우알의 파도다."
  },
  "52": {
   "jp": "de938243",
   "kr": "자기 세계를 구하려고"
  },
  "53": {
   "jp": "ecfca865",
   "kr": "다른 세계를 멸망시켜도 좋다는 말이냐?"
  },
  "54": {
   "jp": "18091395",
   "kr": "우리 세계에서도 의견은 갈렸다."
  },
  "55": {
   "jp": "c0fbf921",
   "kr": "어떤 자는 이 세계에 와서"
  },
  "56": {
   "jp": "b7d573fc",
   "kr": "그것이 과연 용납될 행위인지"
  },
  "57": {
   "jp": "374f669b",
   "kr": "제 발로 걸으며 이 세계를 돌아보기도 했다."
  },
  "58": {
   "jp": "c60acb47",
   "kr": "그게 마녀의 순례…"
  },
  "59": {
   "jp": "1eaddbf3",
   "kr": "그렇다."
  },
  "60": {
   "jp": "771a96e7",
   "kr": "그중에는 하얀마녀라 불린 게르드처럼"
  },
  "61": {
   "jp": "32050086",
   "kr": "이 세계 사람들이 탄식의 상념을 낳지 않도록"
  },
  "62": {
   "jp": "f64644c4",
   "kr": "조언을 남기고 여행한 자도 있다."
  },
  "63": {
   "jp": "fb78898e",
   "kr": "하지만 우리의 결론은 이미 나와 있었다."
  },
  "64": {
   "jp": "7ba94bf8",
   "kr": "라우알의 파도를 이 세계로 몰아내고"
  },
  "65": {
   "jp": "4d21e620",
   "kr": "우리 세계만을 구한다는 길로…"
  },
  "66": {
   "jp": "ead67f9c",
   "kr": "천구의에 탄식의 상념을 가둔 건"
  },
  "67": {
   "jp": "364796c9",
   "kr": "라우알의 파도가 생긴 때의 상황을 만들어"
  },
  "68": {
   "jp": "c1c8bb80",
   "kr": "이 세계로 유도하기 위해서였군요."
  },
  "69": {
   "jp": "63d14961",
   "kr": "그런 거다."
  },
  "70": {
   "jp": "4a6aa48f",
   "kr": "라우알의 파도는"
  },
  "71": {
   "jp": "5173f851",
   "kr": "자신을 키운 탄식의 상념 파장을 좋아한다."
  },
  "72": {
   "jp": "0382b01a",
   "kr": "이 세계가 우리 세계보다"
  },
  "73": {
   "jp": "bca68a32",
   "kr": "탄식의 상념을 많이 지니면"
  },
  "74": {
   "jp": "e523b6b7",
   "kr": "틀림없이 파도는 이 세계로 밀려온다."
  },
  "75": {
   "jp": "edd9d833",
   "kr": "그러기 위해서도"
  },
  "76": {
   "jp": "a06c8510",
   "kr": "우리는 비정해져야만 했다."
  },
  "77": {
   "jp": "36bf99bb",
   "kr": "우리 세계 사람들이 마음속"
  },
  "78": {
   "jp": "492d7ef9",
   "kr": "탄식의 상념을 버리지 않는 한"
  },
  "79": {
   "jp": "8e64b784",
   "kr": "이 작전은 성립하지 못했다."
  },
  "80": {
   "jp": "e089ab0d",
   "kr": "이제 이해가 됐나?"
  },
  "81": {
   "jp": "3adae119",
   "kr": "………"
  },
  "82": {
   "jp": "085bbb5e",
   "kr": "…두 개의…"
  },
  "83": {
   "jp": "60205d78",
   "kr": "두 세계를 둘 다 구할 방법은 없었던 거야?"
  },
  "84": {
   "jp": "7ff0c41b",
   "kr": "없었다."
  },
  "85": {
   "jp": "d348a366",
   "kr": "아니,"
  },
  "86": {
   "jp": "1e35200b",
   "kr": "적어도 내가 조사한 바로는"
  },
  "87": {
   "jp": "068756f8",
   "kr": "다른 방법은 없었다."
  },
  "88": {
   "jp": "51711a10",
   "kr": "그럼, 있을지도 모른다는 거네?"
  },
  "89": {
   "jp": "c1799376",
   "kr": "가능성이란 어디에나 있다."
  },
  "90": {
   "jp": "22aaba08",
   "kr": "허나 시간이 없었다."
  },
  "91": {
   "jp": "6e9b1f36",
   "kr": "안됐지만"
  },
  "92": {
   "jp": "c9631786",
   "kr": "아직 천구의를 파괴당하면"
  },
  "93": {
   "jp": "9ae2fb83",
   "kr": "계획이 물거품이 되니 말이다."
  },
  "94": {
   "jp": "6a974e71",
   "kr": "너희는 여기서 죽어 줘야겠다."
  },
  "95": {
   "jp": "c843015c",
   "kr": "간다!"
  },
  "96": {
   "jp": "fd6f8ba8",
   "kr": "그렇게까지"
  },
  "97": {
   "jp": "dbd8238b",
   "kr": "이 세계를 지키고 싶으냐."
  },
  "98": {
   "jp": "938737a4",
   "kr": "그것도 좋겠지."
  },
  "99": {
   "jp": "6995f7a5",
   "kr": "하지만 강자가 살아남는 것은"
  },
  "100": {
   "jp": "915977d3",
   "kr": "모든 세계에 통하는 법칙이다."
  },
  "101": {
   "jp": "6e9b1f36",
   "kr": "안됐지만"
  },
  "102": {
   "jp": "c9631786",
   "kr": "아직 천구의를 파괴당하면"
  },
  "103": {
   "jp": "9ae2fb83",
   "kr": "계획이 물거품이 되니 말이다."
  },
  "104": {
   "jp": "6a974e71",
   "kr": "너희는 여기서 죽어 줘야겠다."
  },
  "105": {
   "jp": "c843015c",
   "kr": "간다!"
  }
 }
}