 "lines": {
  "0": {
   "jp": "895e479b",
   "kr": "추억의 가도"
  },
  "1": {
   "jp": "74f67775",
   "kr": "허크 아저씨니까"
  },
  "2": {
   "jp": "a6945f74",
   "kr": "걱정 없겠지."
  },
  "3": {
   "jp": "64f11ec9",
   "kr": "괜찮아."
  },
  "4": {
   "jp": "e624bae5",
   "kr": "삼촌이니까"
  },
  "5": {
   "jp": "a08b4fac",
   "kr": "분명 평소 기세로 헤쳐 나가서"
  },
  "6": {
   "jp": "631afea7",
   "kr": "확실히 정보를 알아 올 거야."
  },
  "7": {
   "jp": "9034bf69",
   "kr": "한발 먼저 루드성으로 가서"
  },
  "8": {
   "jp": "eeec6614",
   "kr": "최대한 시간을 벌죠."
  },
  "9": {
   "jp": "f259d076",
   "kr": "라우알의 파도가"
  },
  "10": {
   "jp": "8a3f4c6c",
   "kr": "이 세계에 오는 것은 언제일까요."
  },
  "11": {
   "jp": "172247f3",
   "kr": "적어도 그것을 늦출 방법이 있을까요."
  },
  "12": {
   "jp": "4d63d586",
   "kr": "성에 가서 확인할 수 있으면 좋을 텐데요…"
  },
  "13": {
   "jp": "142b379c",
   "kr": "어차피 우리에게 남은 시간이"
  },
  "14": {
   "jp": "09a99cb0",
   "kr": "적은 건 변함없다."
  },
  "15": {
   "jp": "40f72f23",
   "kr": "지금은 허크 공 믿고 성으로 가자."
  },
  "16": {
   "jp": "393c160e",
   "kr": "천의실로 서둘러야 해!"
  },
  "17": {
   "jp": "0056028e",
   "kr": "루드성으로 서두르자."
  },
  "18": {
   "jp": "0edfa3be",
   "kr": "라우알이 다가오고 있어!"
  }
 }
