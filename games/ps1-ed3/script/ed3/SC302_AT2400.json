  "1": {
   "jp": "cbfe7661",
   "kr": "지하 1층"
  },
  "2": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "3": {
   "jp": "4506b960",
   "kr": "폐하께는 자제분이"
  },
  "4": {
   "jp": "630260b0",
   "kr": "안 계시기도 하니"
  },
  "5": {
   "jp": "82320578",
   "kr": "아예 폐하의 자녀가 되시면 어떻습니까?"
  },
  "6": {
   "jp": "75223412",
   "kr": "하하하."
  },
  "7": {
   "jp": "9d422bdd",
   "kr": "농담입니다, 농담."
  },
  "8": {
   "jp": "3f20e957",
   "kr": "드디어 오늘은"
  },
  "9": {
   "jp": "2373d453",
   "kr": "요리 콘테스트로군요."
  },
  "10": {
   "jp": "e19b2748",
   "kr": "올해는 누가 우승할지"
  },
  "11": {
   "jp": "6c362581",
   "kr": "결과가 기대됩니다."
  },
  "12": {
   "jp": "f379c92b",
   "kr": "여기는 지하 보물창고입니다."
  },
  "13": {
   "jp": "e01be30a",
   "kr": "원래 성 지하에는"
  },
  "14": {
   "jp": "0416c9ae",
   "kr": "분명 감옥 같은 것이"
  },
  "15": {
   "jp": "f23a2ddc",
   "kr": "있기 마련이지만요."
  },
  "16": {
   "jp": "2c468df6",
   "kr": "앰비쉬는 알프 왕의 선정 덕분에"
  },
  "17": {
   "jp": "c6cefc84",
   "kr": "죄를 저지르는 자가 한 사람도 없습니다."
  },
  "18": {
   "jp": "22de95f1",
   "kr": "그래서 감옥은 필요 없지요."
  },
  "19": {
   "jp": "10930a31",
   "kr": "이상하네요?"
  },
  "20": {
   "jp": "e9858b04",
   "kr": "슬슬 교대할 병사가 올 때가 됐습니다만…"
  },
  "21": {
   "jp": "2eab8fdd",
   "kr": "신참 병사라 길을 헤매나 봅니다."
  }
 }
