{
 "archive": "/SCE5/SC506.DAT",
 "member": "..\\DATA\\SR3005.BIN",
 "lines": {
  "0": {
   "jp": "c250b049",
   "kr": "홀크 요새"
  },
  "1": {
   "jp": "5ed9a709",
   "kr": "에네톤 왕"
  },
  "2": {
   "jp": "75e9e435",
   "kr": "캐라크 왕"
  },
  "3": {
   "jp": "845a2ab1",
   "kr": "칼리 왕비"
  },
  "4": {
   "jp": "bc9a11a7",
   "kr": "쥬리오 씨, 크리스 씨."
  },
  "5": {
   "jp": "ca35b267",
   "kr": "수고 많으셨어요."
  },
  "6": {
   "jp": "0450ae32",
   "kr": "걱정하고 있었답니다."
  },
  "7": {
   "jp": "ea5d84b6",
   "kr": "응, 좀."
  },
  "8": {
   "jp": "2915193a",
   "kr": "이런저런 일이 있었어."
  },
  "9": {
   "jp": "55625748",
   "kr": "캐라크."
  },
  "10": {
   "jp": "a51da0ff",
   "kr": "형님."
  },
  "11": {
   "jp": "9ce7dc0b",
   "kr": "어쨌든 칼리 왕비가 무사해서 다행이다."
  },
  "12": {
   "jp": "2becbb07",
   "kr": "형님, 죄송했습니다."
  },
  "13": {
   "jp": "c2d03f62",
   "kr": "제가 떠돌이의 말 따위에"
  },
  "14": {
   "jp": "ebbc27f3",
   "kr": "귀를 기울인 탓에…"
  },
  "15": {
   "jp": "c3124f67",
   "kr": "아니, 나도 잘못했다."
  },
  "16": {
   "jp": "05c84814",
   "kr": "좀 더 우리가 평소부터 마음을 나눴다면,"
  },
  "17": {
   "jp": "d9556f62",
   "kr": "서로 의심을 품는 일 따윈 없었을 것이다."
  },
  "18": {
   "jp": "4be3f6ef",
   "kr": "에네톤 왕과 캐라크 왕은 굳은 악수를 했다."
  },
  "19": {
   "jp": "ea066033",
   "kr": "잘됐어요."
  },
  "20": {
   "jp": "4a80554b",
   "kr": "이렇게 무사히 일을 마칠 수 있었던 건,"
  },
  "21": {
   "jp": "5608d319",
   "kr": "정말로 휘리네 덕분이야."
  },
  "22": {
   "jp": "7038780c",
   "kr": "너희들, 정말 고맙구나."
  },
  "23": {
   "jp": "0199b13a",
   "kr": "정말 다행이에요."
  },
  "24": {
   "jp": "32476d00",
   "kr": "하지만, 임금님들. 안심하시면 안 돼요."
  },
  "25": {
   "jp": "0c8e53a2",
   "kr": "베라트 그 녀석."
  },
  "26": {
   "jp": "483cd551",
   "kr": "언젠가 또 나타날 거라고 했어."
  },
  "27": {
   "jp": "eabd4a55",
   "kr": "그래, 조심하마."
  },
  "28": {
   "jp": "aa370b2f",
   "kr": "하지만, 이제 괜찮다."
  },
  "29": {
   "jp": "f9d1ce60",
   "kr": "우리 형제는 지금 굳은 우애를 확인했단다."
  },
  "30": {
   "jp": "b5486986",
   "kr": "이제 어떤 놈이 나타나서"
  },
  "31": {
   "jp": "bfb4d24b",
   "kr": "부추기려 해도"
  },
  "32": {
   "jp": "892e9e8c",
   "kr": "넘어가는 일은 없다."
  },
  "33": {
   "jp": "9347ca2e",
   "kr": "그렇고말고요."
  },
  "34": {
   "jp": "666f07cd",
   "kr": "이번 소동으로"
  },
  "35": {
   "jp": "b06aca3e",
   "kr": "북과 남의 결속이 한층 강해졌어요."
  },
  "36": {
   "jp": "f5333167",
   "kr": "퓨엔테의 미래는 밝아요."
  },
  "37": {
   "jp": "b724eeb7",
   "kr": "도리어 베라트에게"
  },
  "38": {
   "jp": "273a9f8c",
   "kr": "감사해야겠는걸요."
  },
  "39": {
   "jp": "c13a076d",
   "kr": "그리고, 쾌걸 와일드캣에게도."
  },
  "40": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "41": {
   "jp": "e6381538",
   "kr": "쾌걸 와일드캣?"
  },
  "42": {
   "jp": "f86663b2",
   "kr": "그게 뭔가?"
  },
  "43": {
   "jp": "17dde020",
   "kr": "어머, 소식이 늦으시네요."
  },
  "44": {
   "jp": "3ef02839",
   "kr": "퓨엔테의 평화를 지키는 의적분들이에요."
  },
  "45": {
   "jp": "2535fab4",
   "kr": "도적인가?"
  },
  "46": {
   "jp": "03c65fc2",
   "kr": "아뇨, 의적입니다."
  },
  "47": {
   "jp": "de0ffeba",
   "kr": "캐라크 왕과 에네톤 왕은 굳게 악수하고,"
  },
  "48": {
   "jp": "b1e2c534",
   "kr": "변함없는 형제의 정을 되새겼다."
  },
  "49": {
   "jp": "6ddd0627",
   "kr": "베라트의 사악한 음모는,"
  },
  "50": {
   "jp": "08bbe579",
   "kr": "쥬리오, 크리스, 휘리의 활약과,"
  },
  "51": {
   "jp": "3e3fe306",
   "kr": "구스 일행 쾌걸 와일드캣단의 난입으로"
  },
  "52": {
   "jp": "c8dfaa3d",
   "kr": "미연에 막을 수 있었다."
  },
  "53": {
   "jp": "06674bef",
   "kr": "이제 퓨엔테에 마음의 틈은 없다."
  },
  "54": {
   "jp": "a5c247b8",
   "kr": "북도 남도 없이, 두 왕은 형제의 힘을 합쳐"
  },
  "55": {
   "jp": "08660a76",
   "kr": "평화로운 나라를 세우기로 맹세했다."
  },
  "56": {
   "jp": "e9b27118",
   "kr": "쥬리오 일행은 캐라크 왕과 함께"
  },
  "57": {
   "jp": "7e5407c6",
   "kr": "홀크로 향해, 폴티아를 향한 여행을"
  },
  "58": {
   "jp": "b04a9f33",
   "kr": "재개하기로 했다."
  }
 }
}