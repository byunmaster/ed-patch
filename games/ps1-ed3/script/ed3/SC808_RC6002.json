{
 "archive": "/SCE8/SC808.DAT",
 "member": "..\\DATA\\RC6002.BIN",
 "lines": {
  "0": {
   "jp": "4651181e",
   "kr": "이자벨의 탑"
  },
  "1": {
   "jp": "672bb2b9",
   "kr": "천의실"
  },
  "2": {
   "jp": "84fbc3ff",
   "kr": "좋아, 천구의를 부수자."
  },
  "3": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "4": {
   "jp": "cc29c43b",
   "kr": "먼저 천구의를 감싼"
  },
  "5": {
   "jp": "8e95fec0",
   "kr": "저 징그러운 걸 벗겨 내지 않으면"
  },
  "6": {
   "jp": "d1987926",
   "kr": "안 되겠어."
  },
  "7": {
   "jp": "1079d655",
   "kr": "제가 폭탄으로 해 보죠."
  },
  "8": {
   "jp": "293ca641",
   "kr": "그런…"
  },
  "9": {
   "jp": "d6b0aa4b",
   "kr": "폭탄이 안 통하다니…"
  },
  "10": {
   "jp": "1ac6b5ea",
   "kr": "이봐, 왜 그래?"
  },
  "11": {
   "jp": "3d89c490",
   "kr": "하늘 구름이 심상치 않아."
  },
  "12": {
   "jp": "7e8d30b2",
   "kr": "로디."
  },
  "13": {
   "jp": "561e7cc5",
   "kr": "아, 알프…"
  },
  "14": {
   "jp": "c4cd210d",
   "kr": "모리슨 씨도."
  },
  "15": {
   "jp": "acc96f3f",
   "kr": "모리슨도 나도"
  },
  "16": {
   "jp": "40674d66",
   "kr": "서로 몰래 자네들을 뒤쫓아"
  },
  "17": {
   "jp": "f1947e61",
   "kr": "오고 있었다니…"
  },
  "18": {
   "jp": "d32639a7",
   "kr": "여기 오는 길에 만났다네."
  },
  "19": {
   "jp": "f65798c5",
   "kr": "정말이지, 깜짝 놀랐네."
  },
  "20": {
   "jp": "ed6192bb",
   "kr": "그보다"
  },
  "21": {
   "jp": "a0db4ab5",
   "kr": "천구의를 부숴야 하는데"
  },
  "22": {
   "jp": "e3935f3f",
   "kr": "폭탄도 안 통해."
  },
  "23": {
   "jp": "5cf8ca3b",
   "kr": "저런… 폭탄도 소용없단 말인가?"
  },
  "24": {
   "jp": "404aa586",
   "kr": "아마도 성장한 천구의의 주위는"
  },
  "25": {
   "jp": "25edf706",
   "kr": "정신적인 힘으로 보호받고 있는 것이겠지요."
  },
  "26": {
   "jp": "b520f92a",
   "kr": "물리적인 힘만으로는"
  },
  "27": {
   "jp": "09ff4b25",
   "kr": "효과가 없는지도 모릅니다."
  },
  "28": {
   "jp": "7c8c0a1a",
   "kr": "무슨 방법이 없나?"
  },
  "29": {
   "jp": "3647faf7",
   "kr": "물리적으로도 정신적으로도"
  },
  "30": {
   "jp": "1f4c1233",
   "kr": "양쪽 모두에"
  },
  "31": {
   "jp": "6f3f4692",
   "kr": "영향을 주는 것이 있다면."
  },
  "32": {
   "jp": "cf214660",
   "kr": "예를 들면 진홍의 불꽃처럼?"
  },
  "33": {
   "jp": "77f3b4a3",
   "kr": "네, 그렇습니다."
  },
  "34": {
   "jp": "d8e2e2df",
   "kr": "진홍의 불꽃 폭발은"
  },
  "35": {
   "jp": "33822253",
   "kr": "정신적으로도 정화 작용이 있다 합니다."
  },
  "36": {
   "jp": "59b1b444",
   "kr": "진홍의 불꽃이라면 필시…"
  },
  "37": {
   "jp": "f2a27f73",
   "kr": "진홍의 불꽃이라면"
  },
  "38": {
   "jp": "c9a8c9c2",
   "kr": "로디의 할아버지 케빈에게"
  },
  "39": {
   "jp": "d9e9b39a",
   "kr": "받은 게 있어."
  },
  "40": {
   "jp": "fbebd1b7",
   "kr": "정말?"
  },
  "41": {
   "jp": "573a9a9a",
   "kr": "보여 봐라."
  },
  "42": {
   "jp": "34ef2d14",
   "kr": "자, 이거야."
  },
  "43": {
   "jp": "5ed9f045",
   "kr": "분명 진홍의 불꽃…"
  },
  "44": {
   "jp": "23a9b7fa",
   "kr": "하지만 이건 너무 작아."
  },
  "45": {
   "jp": "6c9467c9",
   "kr": "적어도 내가"
  },
  "46": {
   "jp": "a0dfeb33",
   "kr": "가루가에게 썼을 때만큼"
  },
  "47": {
   "jp": "b2212f0e",
   "kr": "크면 좋을 텐데…"
  },
  "48": {
   "jp": "5a7cb7be",
   "kr": "아니, 포기하기엔 이릅니다."
  },
  "49": {
   "jp": "f1de570e",
   "kr": "마법의 힘으로 키우면 됩니다."
  },
  "50": {
   "jp": "018cffb6",
   "kr": "저 혼자서는 무리일지 모르나"
  },
  "51": {
   "jp": "2ee280a0",
   "kr": "크리스 님과 힘을 합치면"
  },
  "52": {
   "jp": "f99b9dd5",
   "kr": "이 진홍의 불꽃을 키울 수 있겠죠."
  },
  "53": {
   "jp": "8f5c46be",
   "kr": "저도 마법은 조금 쓸 줄 알아요."
  },
  "54": {
   "jp": "abf264b0",
   "kr": "도울게요."
  },
  "55": {
   "jp": "a8d01db8",
   "kr": "네, 해 봐요."
  },
  "56": {
   "jp": "3c5e4ce9",
   "kr": "모리슨, 크리스, 스텔라 세 사람은"
  },
  "57": {
   "jp": "78bcebe7",
   "kr": "진홍의 불꽃을 향해 마법의 힘을 보냈다."
  },
  "58": {
   "jp": "6eb1229d",
   "kr": "진홍의 불꽃에는 세 사람의 힘이 모여"
  },
  "59": {
   "jp": "34b5ec10",
   "kr": "구슬의 크기도"
  },
  "60": {
   "jp": "efa890ee",
   "kr": "순식간에 부풀어 올랐다."
  },
  "61": {
   "jp": "a32923e4",
   "kr": "굉장해…"
  },
  "62": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "63": {
   "jp": "2aac5212",
   "kr": "이제 됐겠지요."
  },
  "64": {
   "jp": "523ddd21",
   "kr": "자, 이걸."
  },
  "65": {
   "jp": "76da94ed",
   "kr": "스텔라는 진홍의 불꽃을 받았다."
  },
  "66": {
   "jp": "b2a00233",
   "kr": "던질게요."
  },
  "67": {
   "jp": "c8a34270",
   "kr": "위험하니 물러나 계세요."
  },
  "68": {
   "jp": "25c7bf24",
   "kr": "구스의 목소리"
  },
  "69": {
   "jp": "25e11b9f",
   "kr": "잠깐!"
  },
  "70": {
   "jp": "b3af1c95",
   "kr": "나한테 맡겨."
  },
  "71": {
   "jp": "a6083436",
   "kr": "한 발밖에 없잖아."
  },
  "72": {
   "jp": "489a6979",
   "kr": "난 백발백중이다."
  },
  "73": {
   "jp": "6091ac68",
   "kr": "내 솜씨를 믿어."
  },
  "74": {
   "jp": "3adae119",
   "kr": "………"
  },
  "75": {
   "jp": "9e0d0654",
   "kr": "스텔라는 진홍의 불꽃을 구스에게 건넸다."
  },
  "76": {
   "jp": "a96bf693",
   "kr": "역시 긴장되는군."
  },
  "77": {
   "jp": "3adae119",
   "kr": "………"
  },
  "78": {
   "jp": "9334a29f",
   "kr": "받아라!"
  }
 }
}