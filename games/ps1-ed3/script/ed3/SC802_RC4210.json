 "member": "..\\DATA\\RC4210.BIN",
 "lines": {
  "0": {
   "jp": "16b2a2e8",
   "kr": "루드성"
  },
  "1": {
   "jp": "173ca740",
   "kr": "지하 통로"
  },
  "2": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "3": {
   "jp": "3b759749",
   "kr": "어라라…"
  },
  "4": {
   "jp": "d8e77171",
   "kr": "길을 잃어버렸네."
  },
  "5": {
   "jp": "2b2d5b91",
   "kr": "이자벨의 탑에서 지하로 내려왔더니"
  },
  "6": {
   "jp": "d90f776e",
   "kr": "어디가 어딘지 모르겠어."
  },
  "7": {
   "jp": "abc3bef7",
   "kr": "너희들, 길 알아?"
  },
  "8": {
   "jp": "82725c0d",
   "kr": "제가 묻고 싶어요."
  },
  "9": {
   "jp": "1e3ab353",
   "kr": "아…"
  },
  "10": {
   "jp": "3a7db01e",
   "kr": "방금 이자벨의 탑에서 내려왔다고 했죠?"
  },
  "11": {
   "jp": "077a00b3",
   "kr": "응, 그래."
  },
  "12": {
   "jp": "00c6f943",
   "kr": "지하로 통하길래"
  },
  "13": {
   "jp": "d288691b",
   "kr": "가벼운 호기심에 내려와 봤더니"
  },
  "14": {
   "jp": "1b0c3c70",
   "kr": "이 꼴이야."
  },
  "15": {
   "jp": "3b1c35a9",
   "kr": "이 지하 통로가"
  },
  "16": {
   "jp": "cae09ac2",
   "kr": "이자벨의 탑으로 통하는 건"
  },
  "17": {
   "jp": "60ac051d",
   "kr": "틀림없는 모양이네요."
  },
  "18": {
   "jp": "bc8c936a",
   "kr": "예상대로다."
  },
  "19": {
   "jp": "858f47dc",
   "kr": "천의실은 이자벨의 탑 옥상에 이어져 있다."
  },
  "20": {
   "jp": "c0e1c5e5",
   "kr": "올바른 길만 찾아낸다면…"
  },
  "21": {
   "jp": "e85c93c4",
   "kr": "난 실컷 헤매느라 지쳐 버렸어."
  },
  "22": {
   "jp": "82fcb8e8",
   "kr": "좀 쉬고 나서"
  },
  "23": {
   "jp": "b1eee658",
   "kr": "느긋하게 출구를 찾기로 할게."
  },
  "24": {
   "jp": "e58200cd",
   "kr": "너희들도"
  },
  "25": {
   "jp": "8d98ddcf",
   "kr": "열심히 해 보라고."
  },
  "26": {
   "jp": "e991b75c",
   "kr": "그런데 이 근처 통로는"
  },
  "27": {
   "jp": "54bc4883",
   "kr": "방향이 틀린 것 같더군."
  },
  "28": {
   "jp": "a0cdee3c",
   "kr": "좀 더 떨어진 데를 찾아보라고."
  }
 }
}