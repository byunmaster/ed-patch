{
 "archive": "/SCE4/SC406.DAT",
 "member": "..\\DATA\\OT0501.BIN",
 "lines": {
  "0": {
   "jp": "044c0822",
   "kr": "대성당"
  },
  "1": {
   "jp": "a82af9b4",
   "kr": "샤리네"
  },
  "2": {
   "jp": "06a34a37",
   "kr": "대신관 덴켄"
  },
  "3": {
   "jp": "b9c8bc69",
   "kr": "게르드의 소식은 알 수 없네."
  },
  "4": {
   "jp": "9ddccbf5",
   "kr": "허나, 하얀마녀의 뜻은"
  },
  "5": {
   "jp": "f7d10bf6",
   "kr": "마법의 거울이며, 자네들 마음 깊이"
  },
  "6": {
   "jp": "52ba6765",
   "kr": "또렷이 살아 있는 듯하네."
  },
  "7": {
   "jp": "c60f3705",
   "kr": "나는 자네들과 이야기하며"
  },
  "8": {
   "jp": "6632bdb5",
   "kr": "강하게 그리 느꼈네."
  },
  "9": {
   "jp": "104ea18c",
   "kr": "조심해서 가시게."
  },
  "10": {
   "jp": "7e7217cc",
   "kr": "대신관 덴켄은 진지한 표정으로 기다렸다."
  },
  "11": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "12": {
   "jp": "d56ff408",
   "kr": "마법의 거울에서 본 것을 대신관께"
  },
  "13": {
   "jp": "c6d534a4",
   "kr": "자세히 알렸다."
  },
  "14": {
   "jp": "4de14fbe",
   "kr": "호오… 그러했는가."
  },
  "15": {
   "jp": "92ae540d",
   "kr": "폴티아에 불온한 움직임이…"
  },
  "16": {
   "jp": "0924395d",
   "kr": "그리고, 지금까지 샤리네에선"
  },
  "17": {
   "jp": "cadfe4dd",
   "kr": "영상밖에 보이지 않았는데,"
  },
  "18": {
   "jp": "7eafc313",
   "kr": "이번엔 소리도 들렸어요."
  },
  "19": {
   "jp": "8e95bd6c",
   "kr": "소리가 들렸다…?"
  },
  "20": {
   "jp": "4ba05b84",
   "kr": "라-우-알이라고,"
  },
  "21": {
   "jp": "400a693a",
   "kr": "무슨 뜻인지 도무지 모르겠지만"
  },
  "22": {
   "jp": "36e58678",
   "kr": "분명 그렇게 들렸어요."
  },
  "23": {
   "jp": "881b3acb",
   "kr": "라-우-알…"
  },
  "24": {
   "jp": "f031183b",
   "kr": "…뭐라고?!"
  },
  "25": {
   "jp": "ebfa28d9",
   "kr": "라우알라니!!"
  },
  "26": {
   "jp": "2fc709e1",
   "kr": "엇…"
  },
  "27": {
   "jp": "fc3a34b2",
   "kr": "그렇게 중요한 일인가요…?"
  },
  "28": {
   "jp": "e8750b93",
   "kr": "설마…"
  },
  "29": {
   "jp": "537a7400",
   "kr": "라우알의 파도가 움직이기 시작할 만큼의"
  },
  "30": {
   "jp": "1ded7e03",
   "kr": "사태였다니…"
  },
  "31": {
   "jp": "fdf705c1",
   "kr": "라우알의 파도가 뭐예요?"
  },
  "32": {
   "jp": "3adae119",
   "kr": "………"
  },
  "33": {
   "jp": "2943dfab",
   "kr": "라우알의 파도란…"
  },
  "34": {
   "jp": "da17102c",
   "kr": "하나의 문명이 멸망할 때"
  },
  "35": {
   "jp": "b4ce207b",
   "kr": "그 대지를 뒤덮는다고 하는 파멸의 파도."
  },
  "36": {
   "jp": "f1b95e29",
   "kr": "파멸의 파도?!"
  },
  "37": {
   "jp": "064beafe",
   "kr": "그러니까,"
  },
  "38": {
   "jp": "cfc3f47d",
   "kr": "라우알의 파도가 흐른다는 건…"
  },
  "39": {
   "jp": "de134819",
   "kr": "이 세계가 멸망한다는 뜻이네."
  },
  "40": {
   "jp": "8cc1f1ef",
   "kr": "세계가 멸망하다니…"
  },
  "41": {
   "jp": "0674ef06",
   "kr": "그런… 말도 안 돼요."
  },
  "42": {
   "jp": "55cd11d0",
   "kr": "하지만, 누가…"
  },
  "43": {
   "jp": "e181190f",
   "kr": "대체 누가,"
  },
  "44": {
   "jp": "eb8e29fd",
   "kr": "라우알의 파도를 불러들였단 말인가…"
  },
  "45": {
   "jp": "a1c99df5",
   "kr": "그건 이계의 마법을 아는 자가 아니면"
  },
  "46": {
   "jp": "e052fd16",
   "kr": "소환할 수 없을 터…"
  },
  "47": {
   "jp": "f2d04a1c",
   "kr": "하물며, 이 세계에서는"
  },
  "48": {
   "jp": "367de3f5",
   "kr": "라우알의 존재는 올도스에서도 일부만"
  },
  "49": {
   "jp": "6b321400",
   "kr": "알 뿐인데…"
  },
  "50": {
   "jp": "f74e5443",
   "kr": "이계의 마법사가,"
  },
  "51": {
   "jp": "3d7a365c",
   "kr": "어딘가에 숨어 있다는 말인가…"
  },
  "52": {
   "jp": "32a21c23",
   "kr": "그리고 방아쇠가 되는 나라가 폴티아."
  },
  "53": {
   "jp": "e801c9e0",
   "kr": "혹시"
  },
  "54": {
   "jp": "66b642d9",
   "kr": "폴티아의 루돌프 왕의 신변에,"
  },
  "55": {
   "jp": "2665b3b0",
   "kr": "무슨 일이 일어나고 있는지도 모르네…"
  },
  "56": {
   "jp": "b89e1a39",
   "kr": "쥬리오, 어떡해."
  },
  "57": {
   "jp": "ef3d03ab",
   "kr": "우리 나라가… 우리 임금님이…"
  },
  "58": {
   "jp": "ce366649",
   "kr": "세계의 파멸로 가는 방아쇠가 되어 버리다니."
  },
  "59": {
   "jp": "c7a6ce32",
   "kr": "대신관님."
  },
  "60": {
   "jp": "2fbcb025",
   "kr": "무엇인가?"
  },
  "61": {
   "jp": "3dc5c779",
   "kr": "저희, 대성당에 들어올 때,"
  },
  "62": {
   "jp": "30dd86d1",
   "kr": "다리 앞에 있던 신관님과 문답을 했어요."
  },
  "63": {
   "jp": "d002eeb5",
   "kr": "마지막 질문으로 이런 걸 물으셨어요."
  },
  "64": {
   "jp": "5016dd37",
   "kr": "마법의 거울은 진실만을 비추는 것인지"
  },
  "65": {
   "jp": "7f470028",
   "kr": "아닌지, 물으셨어요."
  },
  "66": {
   "jp": "0c0ad1e9",
   "kr": "저는 『아니오』라고 답했어요."
  },
  "67": {
   "jp": "92340a49",
   "kr": "왜냐면, 테그라의 마법의 거울에서는"
  },
  "68": {
   "jp": "50906fe6",
   "kr": "가루가에게 부서진 볼트가 비쳤지만,"
  },
  "69": {
   "jp": "36f470af",
   "kr": "볼트는 부서지지 않고 무사했으니까요."
  },
  "70": {
   "jp": "3e08590f",
   "kr": "신관님의 답도 『아니오』였어요."
  },
  "71": {
   "jp": "92f38b3c",
   "kr": "저는 마법의 거울이 비추는 건"
  },
  "72": {
   "jp": "b7fa9c85",
   "kr": "반드시 그렇게 되는 미래가 아니라"
  },
  "73": {
   "jp": "9022cb92",
   "kr": "경고 같은 거라고 생각해요."
  },
  "74": {
   "jp": "f60c1cd1",
   "kr": "맞아, 시플에서는 숲의 영상을 봤어."
  },
  "75": {
   "jp": "b1aa3cfc",
   "kr": "응, 그것도 예언과는 다르잖아."
  },
  "76": {
   "jp": "f5142a46",
   "kr": "그때는 환술사한테 저주를 받은"
  },
  "77": {
   "jp": "1ace8fe7",
   "kr": "직후였어. 마법의 거울에서 본 숲은,"
  },
  "78": {
   "jp": "35479ca1",
   "kr": "알그레스가 있는 미혹의 숲이었던 거야."
  },
  "79": {
   "jp": "d8a36642",
   "kr": "마법의 거울은 우리에게 힌트를 준 거야."
  },
  "80": {
   "jp": "0bfb43d5",
   "kr": "그것도, 저주 증상이 나타나기 전부터…"
  },
  "81": {
   "jp": "a3635aba",
   "kr": "비약을 만드는 데 필요한 알그레스가,"
  },
  "82": {
   "jp": "10c26c40",
   "kr": "미혹의 숲에 있다고 알려 준 거야."
  },
  "83": {
   "jp": "0e4b8d7d",
   "kr": "그런 일이 있었는가…"
  },
  "84": {
   "jp": "bd677fbb",
   "kr": "저는 마법의 거울에서 본 것을"
  },
  "85": {
   "jp": "680a6b57",
   "kr": "전부 진실이라곤 생각하지 않아요."
  },
  "86": {
   "jp": "7b619c3e",
   "kr": "분명, 마법의 거울에 보이는 건"
  },
  "87": {
   "jp": "cfe70f74",
   "kr": "이대로라면 그렇게 되고야 만다는"
  },
  "88": {
   "jp": "199924b7",
   "kr": "경고가 아닐까 싶어요."
  },
  "89": {
   "jp": "7c1dabc8",
   "kr": "그러니까, 마법의 거울에 라우알이 나왔어도,"
  },
  "90": {
   "jp": "29cebd43",
   "kr": "앞으로 저희 행동에 따라서는,"
  },
  "91": {
   "jp": "8d85eda7",
   "kr": "세계가 멸망을 피할 수도 있지 않을까요?"
  },
  "92": {
   "jp": "f36a7bb1",
   "kr": "오랜만에,"
  },
  "93": {
   "jp": "e9e4bae0",
   "kr": "든든한 말을 들려주었구먼."
  },
  "94": {
   "jp": "cea3d3f6",
   "kr": "자네 말이 옳네."
  },
  "95": {
   "jp": "97587164",
   "kr": "나는 사태가 큰 탓에"
  },
  "96": {
   "jp": "41b0dcae",
   "kr": "이 나이에 허둥대고 말았네만,"
  },
  "97": {
   "jp": "1dddd8f8",
   "kr": "마법의 거울이란 본래 그런 것이라네."
  },
  "98": {
   "jp": "05514e22",
   "kr": "크리스, 서둘러 폴티아로 돌아가자."
  },
  "99": {
   "jp": "40682f47",
   "kr": "루드성에 가서 이 눈으로 확인하는 거야."
  },
  "100": {
   "jp": "d29866c4",
   "kr": "가루가 때처럼 말이야."
  },
  "101": {
   "jp": "80030089",
   "kr": "우리가 볼트에 가서"
  },
  "102": {
   "jp": "8456b67a",
   "kr": "무엇을 할 수 있다는"
  },
  "103": {
   "jp": "f709ae22",
   "kr": "보장은 아무것도 없었어."
  },
  "104": {
   "jp": "020caf63",
   "kr": "그래도, 다 같이 애썼으니까"
  },
  "105": {
   "jp": "c60fe168",
   "kr": "마법의 거울 영상과는"
  },
  "106": {
   "jp": "562007ce",
   "kr": "다른 결과가 된 게 아닐까."
  },
  "107": {
   "jp": "c70ad6b2",
   "kr": "응, 분명 그럴 거야."
  },
  "108": {
   "jp": "04c9dd67",
   "kr": "알프랑 로디"
  },
  "109": {
   "jp": "efe3b4ad",
   "kr": "그리고 마기사 씨랑 모리슨 씨도…"
  },
  "110": {
   "jp": "de5324f2",
   "kr": "다 같이 애썼으니까."
  },
  "111": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "112": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "113": {
   "jp": "8c3de3a7",
   "kr": "왠지 조금 늠름해진 것 같아."
  },
  "114": {
   "jp": "166b0fc2",
   "kr": "그런가…"
  },
  "115": {
   "jp": "797c064b",
   "kr": "역시 우리"
  },
  "116": {
   "jp": "88b26fe4",
   "kr": "선택받은 용사였던 거야."
  },
  "117": {
   "jp": "c9b86928",
   "kr": "아직도 그런 소리 하는 거야?"
  },
  "118": {
   "jp": "6d97d615",
   "kr": "용사니 영웅이니 하는 건"
  },
  "119": {
   "jp": "311ed745",
   "kr": "훨씬 더 멋진 사람이라고"
  },
  "120": {
   "jp": "4a88b9ed",
   "kr": "몇 번 말해야 알아듣겠어?"
  },
  "121": {
   "jp": "92d9c191",
   "kr": "칫."
  },
  "122": {
   "jp": "68afe29d",
   "kr": "모처럼 우쭐해졌는데…"
  },
  "123": {
   "jp": "5096244a",
   "kr": "그런 건 아무래도 좋잖아."
  },
  "124": {
   "jp": "af81a184",
   "kr": "자, 쥬리오."
  },
  "125": {
   "jp": "21cf657e",
   "kr": "가자, 루드성으로."
  },
  "126": {
   "jp": "3f953d68",
   "kr": "자네들이 소임을 지고,"
  },
  "127": {
   "jp": "ae8dc09a",
   "kr": "이 시기에 올도스를 찾은 건"
  },
  "128": {
   "jp": "e651b838",
   "kr": "아무래도 우연이 아닌 듯하구먼."
  },
  "129": {
   "jp": "a3c601b5",
   "kr": "결코 선택받은 특별한 힘을"
  },
  "130": {
   "jp": "bbfc83e8",
   "kr": "가진 것도 아닌 듯하네만,"
  },
  "131": {
   "jp": "4d9961b7",
   "kr": "그대들에게서는 희망의 빛이 느껴지네."
  },
  "132": {
   "jp": "f2c2be92",
   "kr": "루드성으로 가 주겠는가?"
  },
  "133": {
   "jp": "73a45e27",
   "kr": "네, 가 볼게요."
  },
  "134": {
   "jp": "37d2cc18",
   "kr": "자네들 덕분에,"
  },
  "135": {
   "jp": "86da60f6",
   "kr": "마법의 거울의 메시지를"
  },
  "136": {
   "jp": "df32a592",
   "kr": "알 수 있었네."
  },
  "137": {
   "jp": "108a3a85",
   "kr": "나도 더 조사를 진행하겠네."
  },
  "138": {
   "jp": "5635e617",
   "kr": "이 올도스에서 힘이 되어 줄 수 있을 게야."
  },
  "139": {
   "jp": "11150a37",
   "kr": "부탁하네."
  },
  "140": {
   "jp": "25dff079",
   "kr": "네, 부탁드려요."
  },
  "141": {
   "jp": "0528fe1a",
   "kr": "맞다, 대신관님."
  },
  "142": {
   "jp": "2badd5a1",
   "kr": "하나 여쭤도 될까요?"
  },
  "143": {
   "jp": "796fce06",
   "kr": "무엇인가?"
  },
  "144": {
   "jp": "4bbb907d",
   "kr": "다섯 샤리네에 있는 마법의 거울과"
  },
  "145": {
   "jp": "c22526b8",
   "kr": "하얀마녀 게르드는,"
  },
  "146": {
   "jp": "1520ecc1",
   "kr": "어떤 연관이 있어요?"
  },
  "147": {
   "jp": "9240d95f",
   "kr": "저희, 여기 오기까지 여러 번"
  },
  "148": {
   "jp": "00056407",
   "kr": "하얀마녀의 소문을 들었어요."
  },
  "149": {
   "jp": "fd53cf24",
   "kr": "하얀마녀라…"
  },
  "150": {
   "jp": "9ada8461",
   "kr": "게르드는 예언을 설하며 순례를 하고 있었지."
  },
  "151": {
   "jp": "6c069952",
   "kr": "20년쯤 전, 이 올도스에도 나타나"
  },
  "152": {
   "jp": "2afd769a",
   "kr": "나도 만난 적이 있네."
  },
  "153": {
   "jp": "eb3b4185",
   "kr": "그랬던 것인가…"
  },
  "154": {
   "jp": "71e26ab1",
   "kr": "게르드는 단편적인 예언을 사람들에게 줬으나,"
  },
  "155": {
   "jp": "4e9dffe3",
   "kr": "라우알의 파도에 대해선 입을 다물고 있었네."
  },
  "156": {
   "jp": "b9ce328b",
   "kr": "이제야 나도 알았네…"
  },
  "157": {
   "jp": "fbd802dc",
   "kr": "게르드는 다 알고 있었던 게야."
  },
  "158": {
   "jp": "26e0e38a",
   "kr": "아마도, 이대로라면 라우알의 파도가 나타나,"
  },
  "159": {
   "jp": "0cfa7942",
   "kr": "세계가 파멸의 위기에 맞닥뜨릴 것을"
  },
  "160": {
   "jp": "df96d4ed",
   "kr": "내다보고 있었던 것이겠지."
  },
  "161": {
   "jp": "5ec669b9",
   "kr": "하지만 그걸 말할 수가 없었지."
  },
  "162": {
   "jp": "5ce9f6bf",
   "kr": "라우알의 파도는 사람들에게"
  },
  "163": {
   "jp": "199bf9ac",
   "kr": "너무나 무거운 선고였던 게야."
  },
  "164": {
   "jp": "88a782c2",
   "kr": "사실 그 무렵엔 마법을 쓰는 자도 적고,"
  },
  "165": {
   "jp": "eaeb39f8",
   "kr": "마법은 지금만큼 사람들에게"
  },
  "166": {
   "jp": "ab542d7e",
   "kr": "받아들여지지 않았네."
  },
  "167": {
   "jp": "96bc1e66",
   "kr": "챠펠이나 칸드도 막 생겨난 터라,"
  },
  "168": {
   "jp": "3f1f1816",
   "kr": "사람들은 아직 본래의 마녀나 마법사에게"
  },
  "169": {
   "jp": "a5c0522c",
   "kr": "의심과 두려움만 품었지."
  },
  "170": {
   "jp": "a967da76",
   "kr": "길거리에서 예언을 설해도"
  },
  "171": {
   "jp": "cd1e6106",
   "kr": "마녀라는 이유만으로 욕을 먹고,"
  },
  "172": {
   "jp": "bdbb689e",
   "kr": "돌을 맞는 일도 드물지 않았네."
  },
  "173": {
   "jp": "8c6aa763",
   "kr": "그런 시대였던 게야."
  },
  "174": {
   "jp": "9786a9db",
   "kr": "사람들을 위해 예언을 설파했는데…"
  },
  "175": {
   "jp": "f9e2e4dc",
   "kr": "가여운 게르드…"
  },
  "176": {
   "jp": "d7f231f0",
   "kr": "그런 사람들에게"
  },
  "177": {
   "jp": "69991641",
   "kr": "세계의 파멸을 설파할 수는 없네."
  },
  "178": {
   "jp": "3d944e35",
   "kr": "게르드는"
  },
  "179": {
   "jp": "db96f93c",
   "kr": "그 뒤로 어떻게 됐을까요?"
  },
  "180": {
   "jp": "f905b833",
   "kr": "살아 계실까요?"
  },
  "181": {
   "jp": "2d6387fc",
   "kr": "안타깝게도, 소식은 모르겠네."
  },
  "182": {
   "jp": "d5130f92",
   "kr": "살아 있다면 소문 하나쯤은"
  },
  "183": {
   "jp": "9dc511de",
   "kr": "들려와도 좋으련만…"
  },
  "184": {
   "jp": "bd41302b",
   "kr": "하지만, 저희는"
  },
  "185": {
   "jp": "41ca5225",
   "kr": "몇 번이나 게르드에게 도움을 받았어요."
  },
  "186": {
   "jp": "3833845b",
   "kr": "가루가의 습격을 막은 것도, 미혹의 숲에"
  },
  "187": {
   "jp": "f1a6886e",
   "kr": "미혹의 숲에 알그레스가 있던 것도,"
  },
  "188": {
   "jp": "32121975",
   "kr": "전부 게르드 덕분이잖아요."
  },
  "189": {
   "jp": "15a6952b",
   "kr": "게르드는 말이야. 아마도…"
  },
  "190": {
   "jp": "93458824",
   "kr": "뒤에 오는 이들을 위해"
  },
  "191": {
   "jp": "1dd58964",
   "kr": "길을 내어 두었던 것이겠지."
  },
  "192": {
   "jp": "2937513d",
   "kr": "언젠가"
  },
  "193": {
   "jp": "31bd68f6",
   "kr": "자네들처럼 귀 기울이는 이가"
  },
  "194": {
   "jp": "bca7ad5e",
   "kr": "나타나리라 믿으면서."
  },
  "195": {
   "jp": "ad7fc343",
   "kr": "저도 그렇게 생각해요."
  },
  "196": {
   "jp": "a45555a1",
   "kr": "응. 그렇구나."
  },
  "197": {
   "jp": "5361c5c6",
   "kr": "그럼, 대신관님."
  },
  "198": {
   "jp": "547df3dc",
   "kr": "저희 루드성에 가 보겠습니다."
  },
  "199": {
   "jp": "dafb95f2",
   "kr": "분명 길목마다 게르드가 남긴 메시지가"
  },
  "200": {
   "jp": "2a9ad120",
   "kr": "아직 몇 가지 있을 게야."
  },
  "201": {
   "jp": "de742133",
   "kr": "그것을 실마리로 삼아 가면"
  },
  "202": {
   "jp": "ccfefcf9",
   "kr": "무엇을 해야 할지 알게 될 게야."
  },
  "203": {
   "jp": "11150a37",
   "kr": "부탁하네."
  }
 }
}