{
 "archive": "/SCE1/SC100.DAT",
 "member": "..\\DATA\\MT2000.BIN",
 "lines": {
  "0": {
   "jp": "e7041a3b",
   "kr": "테그라"
  },
  "1": {
   "jp": "2ac1ee0f",
   "kr": "제시카"
  },
  "2": {
   "jp": "873833a7",
   "kr": "키테로"
  },
  "3": {
   "jp": "220d46f1",
   "kr": "림"
  },
  "4": {
   "jp": "10d51157",
   "kr": "케빈 할아버지"
  },
  "5": {
   "jp": "dada32de",
   "kr": "파일"
  },
  "6": {
   "jp": "c31ae2fe",
   "kr": "챠펠의 몰"
  },
  "7": {
   "jp": "78f4da66",
   "kr": "무기상 잭"
  },
  "8": {
   "jp": "d880fc0c",
   "kr": "도구점 코일"
  },
  "9": {
   "jp": "b906c0a9",
   "kr": "닉"
  },
  "10": {
   "jp": "7c74fac1",
   "kr": "이야, 호되게 당했구먼."
  },
  "11": {
   "jp": "2b530fbf",
   "kr": "엉망진창이네…"
  },
  "12": {
   "jp": "474151c8",
   "kr": "난 여기서 여관을 하고 있었는데 말이야."
  },
  "13": {
   "jp": "ac5ad819",
   "kr": "이래선 당분간은 못 쓰겠네."
  },
  "14": {
   "jp": "da388948",
   "kr": "오늘 밤 난 어디서 자야 하는 거야."
  },
  "15": {
   "jp": "6cbadd42",
   "kr": "정말이지, 가루가 녀석."
  },
  "16": {
   "jp": "7d8cc016",
   "kr": "화가 치미네."
  },
  "17": {
   "jp": "13fa1dab",
   "kr": "엄청나네, 엄청나지?"
  },
  "18": {
   "jp": "9e1e0271",
   "kr": "에메나의 집이 흔적도 없이 사라져 버렸어."
  },
  "19": {
   "jp": "127a7ed4",
   "kr": "이거 너무 심하네."
  },
  "20": {
   "jp": "d1ee41d6",
   "kr": "이래서야"
  },
  "21": {
   "jp": "7f9f2b88",
   "kr": "섬을 떠나려는 것도 무리는 아니지."
  },
  "22": {
   "jp": "1f6745d5",
   "kr": "앗?! 말해 버렸네."
  },
  "23": {
   "jp": "039996f0",
   "kr": "마을 사람들과 헤어지기 힘드니까"
  },
  "24": {
   "jp": "14eb228d",
   "kr": "에메나한테 말하지 말아 달라고 부탁받았거든."
  },
  "25": {
   "jp": "6df5ff59",
   "kr": "뭐, 너희는 나그네니까 괜찮으려나."
  },
  "26": {
   "jp": "3f701eee",
   "kr": "에메나도 홀몸으로 인타를 키우느라"
  },
  "27": {
   "jp": "26d2cc95",
   "kr": "힘드니까. 적어도 대륙에서 잘 살아가"
  },
  "28": {
   "jp": "8618f284",
   "kr": "면 좋겠는데…"
  },
  "29": {
   "jp": "5c2a0d0b",
   "kr": "그래도 인타의 놀이 동무였던 림이 알면"
  },
  "30": {
   "jp": "17e9fedc",
   "kr": "분명 슬퍼하겠지."
  },
  "31": {
   "jp": "9ea9cb8a",
   "kr": "난 림이라고 해."
  },
  "32": {
   "jp": "5be40512",
   "kr": "여긴 가루가한테 부서졌지만"
  },
  "33": {
   "jp": "7f3383e7",
   "kr": "우리 집이라고."
  },
  "34": {
   "jp": "7a3f1938",
   "kr": "우리 집은"
  },
  "35": {
   "jp": "6fbae131",
   "kr": "여기서 계속 엄마가"
  },
  "36": {
   "jp": "5801fbe7",
   "kr": "챠펠을 하고 있어."
  },
  "37": {
   "jp": "10391cf5",
   "kr": "우와."
  },
  "38": {
   "jp": "97ba4ad2",
   "kr": "그럼, 크리스네 집이랑 같네."
  },
  "39": {
   "jp": "7b0e2fe4",
   "kr": "뭐야, 누나네 집도 그런 거야?"
  },
  "40": {
   "jp": "5611b88d",
   "kr": "응, 그래."
  },
  "41": {
   "jp": "4647dfda",
   "kr": "그럼, 누나도"
  },
  "42": {
   "jp": "410daf42",
   "kr": "마법을 조금은 쓸 줄 알지?"
  },
  "43": {
   "jp": "8c2f823b",
   "kr": "이 집은 부서져 버렸지만"
  },
  "44": {
   "jp": "07c94216",
   "kr": "마을 입구 집에서 챠펠을 하니까"
  },
  "45": {
   "jp": "75edf7d7",
   "kr": "괜찮으면 들러 봐."
  },
  "46": {
   "jp": "2c3ba929",
   "kr": "그건 그렇고 인타 녀석"
  },
  "47": {
   "jp": "3c3807fb",
   "kr": "어디 간 걸까."
  },
  "48": {
   "jp": "7bbb420c",
   "kr": "같이 놀기로 약속했는데."
  },
  "49": {
   "jp": "fff08744",
   "kr": "인타 녀석"
  },
  "50": {
   "jp": "b08d9d20",
   "kr": "아직 안 오네."
  },
  "51": {
   "jp": "34ab2fe9",
   "kr": "어디 가 버린 걸까."
  },
  "52": {
   "jp": "edb3ae5e",
   "kr": "오오, 수고했구먼."
  },
  "53": {
   "jp": "79b7779e",
   "kr": "기다리고 있었네."
  },
  "54": {
   "jp": "8cf6a03b",
   "kr": "할아버지, 여기요."
  },
  "55": {
   "jp": "f8d30426",
   "kr": "보석 셋을 제대로"
  },
  "56": {
   "jp": "6990d3e3",
   "kr": "찾아왔어요."
  },
  "57": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "58": {
   "jp": "a1c78f46",
   "kr": "이탄 늪에서 찾은 세 개의 진홍의 불꽃을"
  },
  "59": {
   "jp": "e013239e",
   "kr": "케빈에게 건넸다."
  },
  "60": {
   "jp": "98b41bc0",
   "kr": "정말 고맙네."
  },
  "61": {
   "jp": "c0371978",
   "kr": "과연 순례 나그네로군."
  },
  "62": {
   "jp": "5e44d74a",
   "kr": "케빈은 하나하나 광채를 확인하고"
  },
  "63": {
   "jp": "87f30f3e",
   "kr": "흡족한 듯 끄덕였다."
  },
  "64": {
   "jp": "ad069098",
   "kr": "하나같이 훌륭한 광채로군."
  },
  "65": {
   "jp": "fb6fdb85",
   "kr": "만약 자네들이 없었다면 하마터면 전부"
  },
  "66": {
   "jp": "bf68573b",
   "kr": "폭탄이 돼 버릴 뻔했네."
  },
  "67": {
   "jp": "a2334e88",
   "kr": "정말 자네들 덕분이야."
  },
  "68": {
   "jp": "58b8a3f3",
   "kr": "이건 내 작은 성의일세."
  },
  "69": {
   "jp": "e07c31be",
   "kr": "부디 받아 주게."
  },
  "70": {
   "jp": "b2cbc9a0",
   "kr": "사례는 됐어요."
  },
  "71": {
   "jp": "777edfc6",
   "kr": "그럴 수는 없네."
  },
  "72": {
   "jp": "a4a6d0b8",
   "kr": "내 마음이 편치 않다네."
  },
  "73": {
   "jp": "890a68d4",
   "kr": "받아 주게."
  },
  "74": {
   "jp": "fcf5d3c9",
   "kr": "쥬리오 일행은 답례로 케빈에게서"
  },
  "75": {
   "jp": "c29ccff3",
   "kr": "진홍의 불꽃 하나와 "
  },
  "76": {
   "jp": "0032fe0e",
   "kr": "을(를) 받았습니다."
  },
  "77": {
   "jp": "f023fdc7",
   "kr": "고마워요, 케빈 할아버지."
  },
  "78": {
   "jp": "bb4ae5b2",
   "kr": "소중히 할게요."
  },
  "79": {
   "jp": "99134119",
   "kr": "조심해서 여행을 계속하게."
  },
  "80": {
   "jp": "cf77bb94",
   "kr": "세상엔 뜻밖의 위험도 여럿 있네."
  },
  "81": {
   "jp": "ace49e07",
   "kr": "둘이 힘을 합쳐 어려움을 넘어서 주게."
  },
  "82": {
   "jp": "7375fb66",
   "kr": "그것이 남을 위한 일도 된다면 더욱 좋지."
  },
  "83": {
   "jp": "17be7cba",
   "kr": "자네들은 이 순례 여행을 통해"
  },
  "84": {
   "jp": "b045c949",
   "kr": "부디, 그런 사람이"
  },
  "85": {
   "jp": "e896666f",
   "kr": "되어 주었으면 하네."
  },
  "86": {
   "jp": "aea019e8",
   "kr": "로디 녀석, 나를 두고 가서"
  },
  "87": {
   "jp": "c9bb5259",
   "kr": "또 가루가를 쫓아가다니…"
  },
  "88": {
   "jp": "0b61b42c",
   "kr": "늙은이 걱정을 시키는구먼."
  },
  "89": {
   "jp": "b0eb4815",
   "kr": "그런 작은 배로 나가다니"
  },
  "90": {
   "jp": "83a92006",
   "kr": "목숨을 버리는 거나 같네."
  },
  "91": {
   "jp": "edf6767d",
   "kr": "로디라면…?"
  },
  "92": {
   "jp": "5e72d496",
   "kr": "분명 타라타호에서 스쳐 지난 남자일 거야."
  },
  "93": {
   "jp": "1c6639f1",
   "kr": "그러고 보니 선착장 사람도 말했잖아."
  },
  "94": {
   "jp": "a0b7d61f",
   "kr": "얼굴이 심각하던 그 사람이지."
  },
  "95": {
   "jp": "4e8efa82",
   "kr": "이런, 자네들 로디를 봤단 말인가?"
  },
  "96": {
   "jp": "88149875",
   "kr": "네."
  },
  "97": {
   "jp": "483a8582",
   "kr": "저희 순례로 마법의 거울을 보려고"
  },
  "98": {
   "jp": "0153d6b8",
   "kr": "알데에서 배를 얻어 탔어요."
  },
  "99": {
   "jp": "6063ae24",
   "kr": "항구에 들어설 때"
  },
  "100": {
   "jp": "13f9787b",
   "kr": "로디 씨의 작은 배와 스쳐 지났어요."
  },
  "101": {
   "jp": "07aa6f0c",
   "kr": "저기, 할아버지"
  },
  "102": {
   "jp": "b19fc574",
   "kr": "어째서 로디 씨는"
  },
  "103": {
   "jp": "ceac9aac",
   "kr": "가루가를 쫓아간 거예요?"
  },
  "104": {
   "jp": "36b5918a",
   "kr": "가루가에게 복수하려는 게지."
  },
  "105": {
   "jp": "e3dfc619",
   "kr": "네에?!"
  },
  "106": {
   "jp": "eaabe2b0",
   "kr": "그렇게 굉장한 괴물을"
  },
  "107": {
   "jp": "03b59867",
   "kr": "혼자서 해치울 셈이에요!"
  },
  "108": {
   "jp": "c73d8945",
   "kr": "로디가 아직 어렸을 때지."
  },
  "109": {
   "jp": "76a030a1",
   "kr": "그때는 네갈섬 사람들도 대부분"
  },
  "110": {
   "jp": "8e91d074",
   "kr": "고기잡이로 생계를 꾸리고 있었네."
  },
  "111": {
   "jp": "184c6528",
   "kr": "평소엔 나와 아들이 고기잡이를 나갔는데"
  },
  "112": {
   "jp": "36e87c81",
   "kr": "그날은 로디가 조르지 않았겠나."
  },
  "113": {
   "jp": "21713840",
   "kr": "로디에게는 첫 고기잡이였지."
  },
  "114": {
   "jp": "ac322631",
   "kr": "아들과 로디는 사이좋게 고기잡이를 나갔다."
  },
  "115": {
   "jp": "c238a5fe",
   "kr": "그런데 그 배가 하필이면"
  },
  "116": {
   "jp": "e9c0eb31",
   "kr": "가루가에게 습격당한 게야."
  },
  "117": {
   "jp": "52492629",
   "kr": "아들은 가루가에게 습격당해 죽었다."
  },
  "118": {
   "jp": "293ca641",
   "kr": "그런…"
  },
  "119": {
   "jp": "a6b8a701",
   "kr": "가루가는 얌전한 동물이 아니었나요?"
  },
  "120": {
   "jp": "b9e87edc",
   "kr": "평소에는 말이지…"
  },
  "121": {
   "jp": "73e218fa",
   "kr": "하지만 때때로 무언가에 홀린 듯이"
  },
  "122": {
   "jp": "cc6838bd",
   "kr": "난폭해질 때가 있는 게야."
  },
  "123": {
   "jp": "15e2079c",
   "kr": "마침 이 테그라를 덮친 해수처럼 말이다."
  },
  "124": {
   "jp": "44de0244",
   "kr": "기적적으로 살아남은 로디는"
  },
  "125": {
   "jp": "af576a4b",
   "kr": "사흘이나 표류해 섬에 닿았다."
  },
  "126": {
   "jp": "d791bd35",
   "kr": "그 녀석에게 가루가는 부모의 원수인 게야."
  },
  "127": {
   "jp": "465c7e43",
   "kr": "로디는 원수를 갚겠다며"
  },
  "128": {
   "jp": "a740d3e8",
   "kr": "검을 쥘 나이가 되자 조부인 나를"
  },
  "129": {
   "jp": "c401ac1b",
   "kr": "떠나 테그라를 나갔다."
  },
  "130": {
   "jp": "14f294e2",
   "kr": "로디 씨는"
  },
  "131": {
   "jp": "a4533943",
   "kr": "줄곧 가루가를 쫓고 있었던 거네요."
  },
  "132": {
   "jp": "c496f079",
   "kr": "훌쩍 돌아왔나 싶더니"
  },
  "133": {
   "jp": "a8ca56de",
   "kr": "가루가까지 나타나다니."
  },
  "134": {
   "jp": "237f247c",
   "kr": "정말이지, 어찌 되어 가는 겐지."
  },
  "135": {
   "jp": "196980b4",
   "kr": "아, 맞다."
  },
  "136": {
   "jp": "0c0e7896",
   "kr": "정말이지, 로디 녀석…"
  },
  "137": {
   "jp": "a75068e2",
   "kr": "오? 자네들인가."
  },
  "138": {
   "jp": "1edfd515",
   "kr": "그래,"
  },
  "139": {
   "jp": "6f357d91",
   "kr": "할아버지, 죄송해요. 아직이에요."
  },
  "140": {
   "jp": "8f82ec99",
   "kr": "쥬리오가 길을 잃어버려서."
  },
  "141": {
   "jp": "c1214365",
   "kr": "에〜 내 탓이야?"
  },
  "142": {
   "jp": "ed114fcf",
   "kr": "한 번 더 다녀올게요."
  },
  "143": {
   "jp": "e6384fff",
   "kr": "좀 부탁이 있네만."
  },
  "144": {
   "jp": "77d7cb29",
   "kr": "나 대신 이탄 늪까지 가서"
  },
  "145": {
   "jp": "510a2c03",
   "kr": "보석을 가져와 주지 않겠나."
  },
  "146": {
   "jp": "da1aa8f5",
   "kr": "보석?"
  },
  "147": {
   "jp": "d753f1a5",
   "kr": "가루가 소동 때문에 까맣게 잊고 있었네만"
  },
  "148": {
   "jp": "25376730",
   "kr": "슬슬 보석을 가지러 가지 않으면"
  },
  "149": {
   "jp": "330c8c78",
   "kr": "팔 물건이 못 되고 만다네."
  },
  "150": {
   "jp": "fd5dfd9b",
   "kr": "그게 보석 만들기는 무척 까다롭거든."
  },
  "151": {
   "jp": "9171888c",
   "kr": "이탄에 담그는 시간이 짧거나 길면 안 되네."
  },
  "152": {
   "jp": "5cf10c32",
   "kr": "슬슬 꺼내야 하는 보석이 있는데 말이지."
  },
  "153": {
   "jp": "06c97936",
   "kr": "나는 가루가 습격에 허리를 찧어서"
  },
  "154": {
   "jp": "19cc36e7",
   "kr": "이 꼴이네."
  },
  "155": {
   "jp": "f6cbce11",
   "kr": "어쩔래, 쥬리오?"
  },
  "156": {
   "jp": "763980cc",
   "kr": "우리가 보석을 가져다 드릴까?"
  },
  "157": {
   "jp": "a430ebd0",
   "kr": "그런 말 말고"
  },
  "158": {
   "jp": "be6d6ed4",
   "kr": "가져다 드리자."
  },
  "159": {
   "jp": "18348189",
   "kr": "그래, 그러자."
  },
  "160": {
   "jp": "452f69be",
   "kr": "알겠어요, 케빈 할아버지."
  },
  "161": {
   "jp": "d96fecb9",
   "kr": "저희가 보석을 가져다 드릴게요."
  },
  "162": {
   "jp": "3bbc25be",
   "kr": "미안하구먼 낯선 사람에게"
  },
  "163": {
   "jp": "6933c404",
   "kr": "이런 일까지 부탁하게 되어서."
  },
  "164": {
   "jp": "21beb47f",
   "kr": "케빈 할아버지, 신경 쓰지 마세요. 저희요"
  },
  "165": {
   "jp": "a544f232",
   "kr": "마침 마을에 도움이 되는 일을 하고"
  },
  "166": {
   "jp": "3fa61e15",
   "kr": "싶었거든요. 그래서 그 늪은 어디 있어요?"
  },
  "167": {
   "jp": "4445ad97",
   "kr": "그래. 탄광 바닥에 있네만"
  },
  "168": {
   "jp": "d24b4fa7",
   "kr": "불은 켜져 있고 다른 광부들도 있네."
  },
  "169": {
   "jp": "7ed4a1fa",
   "kr": "둘이라면 걱정 없겠지."
  },
  "170": {
   "jp": "456f11e6",
   "kr": "이탄 늪에 셋을 담가 뒀으니"
  },
  "171": {
   "jp": "1a2d50c5",
   "kr": "그걸 가져와 주게."
  },
  "172": {
   "jp": "3acbac82",
   "kr": "네, 알겠어요."
  },
  "173": {
   "jp": "a73cc200",
   "kr": "맡겨 주세요."
  },
  "174": {
   "jp": "66127521",
   "kr": "그리고."
  },
  "175": {
   "jp": "9d705ec1",
   "kr": "뭔데요?"
  },
  "176": {
   "jp": "d005bbeb",
   "kr": "그리고 이탄 속에 너무 오래 담가서"
  },
  "177": {
   "jp": "1ce10669",
   "kr": "지나치게 커진 보석도 있네만"
  },
  "178": {
   "jp": "0cf64d50",
   "kr": "위험하니 건드려서는 안 되네."
  },
  "179": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "180": {
   "jp": "d289e23d",
   "kr": "왜 위험한데요?"
  },
  "181": {
   "jp": "c865d79c",
   "kr": "어째선지는 나도 잘 모르네만"
  },
  "182": {
   "jp": "c802484d",
   "kr": "탄광의 성분 탓인지 너무 오래 담근 보석은"
  },
  "183": {
   "jp": "47de6ba8",
   "kr": "폭탄처럼 터져 버린다네."
  },
  "184": {
   "jp": "373b9aa1",
   "kr": "작은 충격에도 콰아앙!"
  },
  "185": {
   "jp": "2fddfd41",
   "kr": "하고 말이지…"
  },
  "186": {
   "jp": "51576b68",
   "kr": "저, 정말로"
  },
  "187": {
   "jp": "5286250c",
   "kr": "괜찮은 거예요?"
  },
  "188": {
   "jp": "9cf384dc",
   "kr": "괜찮네."
  },
  "189": {
   "jp": "c8753a4b",
   "kr": "큰 놈에 손대지만 않으면 되네."
  },
  "190": {
   "jp": "25751641",
   "kr": "그럼, 부디 조심하게나."
  },
  "191": {
   "jp": "7228f443",
   "kr": "미안하지만 잘 부탁하네."
  },
  "192": {
   "jp": "ed75573e",
   "kr": "아이고…"
  },
  "193": {
   "jp": "b08b0c01",
   "kr": "가루가의 습격에서 도망칠 때"
  },
  "194": {
   "jp": "c63e31b9",
   "kr": "뭔가에 허리를 찧고 말았구먼."
  },
  "195": {
   "jp": "732a5d0e",
   "kr": "도망치는 발까지 굼뜨다니"
  },
  "196": {
   "jp": "94e16214",
   "kr": "나도 늙었나 보다."
  },
  "197": {
   "jp": "d92d6ce2",
   "kr": "할아버지, 괜찮으세요?"
  },
  "198": {
   "jp": "f3c0108a",
   "kr": "뭘, 이 정도쯤이야."
  },
  "199": {
   "jp": "e486c987",
   "kr": "허참… 남의 집 아이도"
  },
  "200": {
   "jp": "e1bd5eb8",
   "kr": "나를 걱정해 주는데 말이지."
  },
  "201": {
   "jp": "c45e6a4a",
   "kr": "괜찮네. 이제 난 걱정 없네."
  },
  "202": {
   "jp": "613b73c5",
   "kr": "로디 녀석도 운이 없다니까〜"
  },
  "203": {
   "jp": "dbf9a2e9",
   "kr": "모처럼 가루가를 만났는데"
  },
  "204": {
   "jp": "228e2bf8",
   "kr": "탄광에 가 있느라 엇갈렸다니…"
  },
  "205": {
   "jp": "1486366e",
   "kr": "그래서야"
  },
  "206": {
   "jp": "b69391ca",
   "kr": "속이 터질 만하지."
  },
  "207": {
   "jp": "8c1a323e",
   "kr": "케빈 영감도 딱하지만"
  },
  "208": {
   "jp": "424cc1ab",
   "kr": "로디 마음도 알 것 같아."
  },
  "209": {
   "jp": "76709f9f",
   "kr": "케빈 영감도"
  },
  "210": {
   "jp": "19cafd5d",
   "kr": "옛날엔 어부였다만"
  },
  "211": {
   "jp": "b43d8589",
   "kr": "지금은 섬 제일가는 보석 장인이지."
  },
  "212": {
   "jp": "65d28465",
   "kr": "이탄에서 아코야 조개를 기르면 말이지."
  },
  "213": {
   "jp": "5d2e85c3",
   "kr": "그게 참 고운 붉은 보석이 만들어진다고."
  },
  "214": {
   "jp": "8383e8a8",
   "kr": "그건 아무도 흉내 못 내."
  },
  "215": {
   "jp": "39bd9ba6",
   "kr": "잘 오셨어요."
  },
  "216": {
   "jp": "fbdd1552",
   "kr": "집이 부서진 정도로는 쉬지 않는답니다."
  },
  "217": {
   "jp": "4e6745ab",
   "kr": "누구에게 마법을 내릴까요?"
  },
  "218": {
   "jp": "34a10fa6",
   "kr": "어떤 마법을 익힐까요?"
  },
  "219": {
   "jp": "e02a45dc",
   "kr": "그렇죠?"
  },
  "220": {
   "jp": "502353ff",
   "kr": "좋은 마법을 골랐네요."
  },
  "221": {
   "jp": "754ccb1e",
   "kr": "마법은 쓰는 이의 거울."
  },
  "222": {
   "jp": "383bb22b",
   "kr": "부디, 주의를 게을리 마세요."
  },
  "223": {
   "jp": "2ecc20cd",
   "kr": "제가 필요해지면 언제든지 오세요."
  },
  "224": {
   "jp": "3b624d74",
   "kr": "기다리고 있을게요."
  },
  "225": {
   "jp": "b942c21f",
   "kr": "어서 와. 준비해 두면 안심이지."
  },
  "226": {
   "jp": "062961e0",
   "kr": "그래 봐야 가루가한테는 당해 낼 순 없지만."
  },
  "227": {
   "jp": "9dd823dc",
   "kr": "자, 물건을 봐 주겠어?"
  },
  "228": {
   "jp": "557f710e",
   "kr": "이쯤이 손님한테는"
  },
  "229": {
   "jp": "ef8c7352",
   "kr": "쓰기 편할 것 같은데."
  },
  "230": {
   "jp": "59d37cc7",
   "kr": "자, 손에 들고 찬찬히 봐 다오."
  },
  "231": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "232": {
   "jp": "0acce0d1",
   "kr": "면 되겠어."
  },
  "233": {
   "jp": "90cfedee",
   "kr": "뭘 팔아 줄 건데?"
  },
  "234": {
   "jp": "abb8567e",
   "kr": "그렇다면"
  },
  "235": {
   "jp": "d6d96edb",
   "kr": "로 바꿔 줄게."
  },
  "236": {
   "jp": "d91c3c34",
   "kr": "1 Goa당 15 Pia에 사 주지."
  },
  "237": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "238": {
   "jp": "7da61f0d",
   "kr": "야."
  },
  "239": {
   "jp": "a9efabb0",
   "kr": "라피카가 모이면 또 와 줘."
  },
  "240": {
   "jp": "e2cb3ecb",
   "kr": "그 밖에 무슨 볼일이지?"
  },
  "241": {
   "jp": "cd8b865c",
   "kr": "고맙습니다."
  },
  "242": {
   "jp": "52ea78c0",
   "kr": "좋은 물건 사셨어요, 손님."
  },
  "243": {
   "jp": "a2347401",
   "kr": "또 언제든 들러 주세요."
  },
  "244": {
   "jp": "94fdca46",
   "kr": "그야 확실히 여기 무기로는"
  },
  "245": {
   "jp": "08386b11",
   "kr": "가루가한테 못 당하지만 여행에 도움은 돼."
  },
  "246": {
   "jp": "5cfba32c",
   "kr": "또 들러 줘."
  },
  "247": {
   "jp": "4f045262",
   "kr": "어서 오십시오."
  },
  "248": {
   "jp": "f8d8327e",
   "kr": "오늘은 무엇을 찾으시는지요?"
  },
  "249": {
   "jp": "d14b58e9",
   "kr": "무엇을 찾으시나요?"
  },
  "250": {
   "jp": "3e26cd05",
   "kr": "받겠습니다."
  },
  "251": {
   "jp": "f0377acf",
   "kr": "무엇을 사들일까요?"
  },
  "252": {
   "jp": "4b42c90a",
   "kr": "라면"
  },
  "253": {
   "jp": "71b4529e",
   "kr": "에 사들이겠습니다."
  },
  "254": {
   "jp": "65d811e9",
   "kr": "환전이시죠?"
  },
  "255": {
   "jp": "7fa10058",
   "kr": "1 Goa당 15 Pia인데 괜찮으신가요?"
  },
  "256": {
   "jp": "068d27e4",
   "kr": "을 치르겠습니다."
  },
  "257": {
   "jp": "cfb214c8",
   "kr": "라피카가 없으신 것 같습니다만."
  },
  "258": {
   "jp": "92609faf",
   "kr": "그 밖에 필요한 것은 있으신가요?"
  },
  "259": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "260": {
   "jp": "656e07d8",
   "kr": "또 찾아 주시기를 기다리겠습니다."
  },
  "261": {
   "jp": "8091d194",
   "kr": "그러신가요 또 들러 주세요."
  },
  "262": {
   "jp": "b8d3d665",
   "kr": "기다리고 있겠습니다."
  }
 }
