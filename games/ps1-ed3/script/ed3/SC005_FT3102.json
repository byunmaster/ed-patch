 "lines": {
  "0": {
   "jp": "c9fab11d",
   "kr": "매발톱호"
  },
  "1": {
   "jp": "0f879f86",
   "kr": "보스레이"
  },
  "2": {
   "jp": "34bab0be",
   "kr": "쥬리오, 오늘도 힘내자."
  },
  "3": {
   "jp": "542a8d19",
   "kr": "내 오늘 일은 말이야"
  },
  "4": {
   "jp": "9417d141",
   "kr": "빨래랑 요리 돕기야."
  },
  "5": {
   "jp": "a0f59a42",
   "kr": "빨래는 점심까지 끝낼 테니까"
  },
  "6": {
   "jp": "8b89c60f",
   "kr": "쥬리오도 더러운 옷 있으면 내놔."
  },
  "7": {
   "jp": "822bd400",
   "kr": "괜찮아, 내 건…"
  },
  "8": {
   "jp": "b2e0ef72",
   "kr": "안 돼."
  },
  "9": {
   "jp": "83251ec9",
   "kr": "안 빨면 냄새난단 말이야."
  },
  "10": {
   "jp": "ba330f93",
   "kr": "됐다니까."
  },
  "11": {
   "jp": "17bf0cb6",
   "kr": "속옷은 매일 갈아입어야 해."
  },
  "12": {
   "jp": "b21739f2",
   "kr": "잠깐 쥬리오, 보여 봐!"
  },
  "13": {
   "jp": "1a8e327b",
   "kr": "우와!? 됐다니까!"
  },
  "14": {
   "jp": "06949f05",
   "kr": "그만해!"
  },
  "15": {
   "jp": "31f9a9fd",
   "kr": "안 돼!"
  },
  "16": {
   "jp": "50492df3",
   "kr": "됐다니까!"
  },
  "17": {
   "jp": "d82cdaed",
   "kr": "내가 빨 테니까."
  },
  "18": {
   "jp": "88773702",
   "kr": "고집 좀 그만 부려!"
  },
  "19": {
   "jp": "4254aa9a",
   "kr": "이제 갑판 청소 가야 해."
  },
  "20": {
   "jp": "1e457d3f",
   "kr": "속옷부터 내놓고 가!"
  },
  "21": {
   "jp": "533f16b2",
   "kr": "정말!"
  },
  "22": {
   "jp": "cf27eb85",
   "kr": "늘 이렇다니까."
  },
  "23": {
   "jp": "f791190c",
   "kr": "꼬마들은"
  },
  "24": {
   "jp": "92958e05",
   "kr": "아침부터 기운차구먼."
  },
  "25": {
   "jp": "21913edd",
   "kr": "그에 비해 우리는"
  },
  "26": {
   "jp": "c43cb64e",
   "kr": "오늘도 하루, 여기서 가만있는 거야…?"
  },
  "27": {
   "jp": "cd1f455b",
   "kr": "이런 데 계속 있으면"
  },
  "28": {
   "jp": "c5e91019",
   "kr": "뱃멀미 나겠어."
  },
  "29": {
   "jp": "e6349288",
   "kr": "어쩔 거야, 정말."
  },
  "30": {
   "jp": "8b30df82",
   "kr": "실례합니다."
  },
  "31": {
   "jp": "8bef1bb2",
   "kr": "여기에 질버 선장님 안 계세요?"
  },
  "32": {
   "jp": "ab999754",
   "kr": "……!?"
  },
  "33": {
   "jp": "e4e12cc8",
   "kr": "그런 험상궂은 아저씨…"
  },
  "34": {
   "jp": "12507a83",
   "kr": "아니, 선장이라면 안 왔어."
  },
  "35": {
   "jp": "7bd05f14",
   "kr": "정말 고마워요."
  },
  "36": {
   "jp": "eb25c166",
   "kr": "(선장님은 어디 가셨을까?)"
  },
  "37": {
   "jp": "9edc76c3",
   "kr": "(여기 사람은 한 번도 안 나오고.)"
  },
  "38": {
   "jp": "893a9763",
   "kr": "(배 안에도 이상한 일이 있네.)"
  },
  "39": {
   "jp": "106cd90f",
   "kr": "여기엔 선장님 없겠지."
  },
  "40": {
   "jp": "c0d2404d",
   "kr": "여기 사람도 이상하네."
  },
  "41": {
   "jp": "f7290c24",
   "kr": "한 번도 안 나오고…"
  },
  "42": {
   "jp": "cf40a8d5",
   "kr": "아, 선장실에 가야지."
  },
  "43": {
   "jp": "5248839c",
   "kr": "어떤 사람이 있을까?"
  },
  "44": {
   "jp": "73453e74",
   "kr": "아, 망보러 가야지."
  },
  "45": {
   "jp": "d09e38d6",
   "kr": "갑판은 배의 얼굴이다."
  },
  "46": {
   "jp": "4385164a",
   "kr": "구석구석 깨끗이 부탁한다!"
  },
  "47": {
   "jp": "1761f7b4",
   "kr": "선장?"
  },
  "48": {
   "jp": "aabe1b77",
   "kr": "방금 전에 내 일하는 걸 보러 왔었어."
  },
  "49": {
   "jp": "ead779bd",
   "kr": "엇갈렸나 보군."
  },
  "50": {
   "jp": "a5fc4df7",
   "kr": "아무리 크다 해도"
  },
  "51": {
   "jp": "50223657",
   "kr": "이 배 안에 있는 건 틀림없어."
  },
  "52": {
   "jp": "28d9257c",
   "kr": "뭐, 구경 삼아 천천히 찾아라."
  },
  "53": {
   "jp": "a3a02f95",
   "kr": "이번엔 망보기냐?"
  },
  "54": {
   "jp": "eae75334",
   "kr": "서로 힘내 보자고!"
  },
  "55": {
   "jp": "5f6544cf",
   "kr": "벌써 선장님한테 일을 받았냐?"
  },
  "56": {
   "jp": "b8723ee7",
   "kr": "칫!"
  },
  "57": {
   "jp": "dda28411",
   "kr": "저 꼬맹이가 엿보고 있잖아."
  },
  "58": {
   "jp": "7c72c99d",
   "kr": "숨는 거야!"
  },
  "59": {
   "jp": "f3124002",
   "kr": "뭐 하는 거야…"
  },
  "60": {
   "jp": "d5256db1",
   "kr": "여기 있으면 엿볼 수 없잖아."
  },
  "61": {
   "jp": "aa248d30",
   "kr": "너, 계속 그러고 있을 셈이야?"
  },
  "62": {
   "jp": "4b286a32",
   "kr": "쿠궁."
  },
  "63": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "64": {
   "jp": "bda82e99",
   "kr": "아무것도 안 보이네."
  }
 }
}