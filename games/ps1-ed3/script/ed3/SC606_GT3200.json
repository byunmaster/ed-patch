{
 "archive": "/SCE6/SC606.DAT",
 "member": "..\\DATA\\GT3200.BIN",
 "lines": {
  "0": {
   "jp": "26fb5f27",
   "kr": "딜트 관문"
  },
  "1": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "2": {
   "jp": "4a1f6937",
   "kr": "다리지기 랑그"
  },
  "3": {
   "jp": "684b0bdb",
   "kr": "병단장"
  },
  "4": {
   "jp": "1198c6b3",
   "kr": "이런, 다리를 건너온 겐가."
  },
  "5": {
   "jp": "323a57ce",
   "kr": "드문 일이군."
  },
  "6": {
   "jp": "092cbc57",
   "kr": "요즘 들어"
  },
  "7": {
   "jp": "d0c87ae5",
   "kr": "여길 지나는 여행자가 없었으니까."
  },
  "8": {
   "jp": "8df5a380",
   "kr": "루드성에서 오기로 되어 있는"
  },
  "9": {
   "jp": "b72f6b39",
   "kr": "병단이 도착할 때까지"
  },
  "10": {
   "jp": "730111c4",
   "kr": "이 국경은 텅 비어 있다네."
  },
  "11": {
   "jp": "d5e57f30",
   "kr": "다리지기인 나로서는"
  },
  "12": {
   "jp": "47cfdad1",
   "kr": "쓸쓸할 따름일세."
  },
  "13": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "14": {
   "jp": "24343965",
   "kr": "기드나에서 건너온 거니?"
  },
  "15": {
   "jp": "2735f730",
   "kr": "뭐냐?"
  },
  "16": {
   "jp": "cf3ac3d3",
   "kr": "통행자는 아무도 없을 줄 알았는데."
  },
  "17": {
   "jp": "ad6e2132",
   "kr": "저희"
  },
  "18": {
   "jp": "c91e40c6",
   "kr": "순례 여행으로 올도스에 갔다가"
  },
  "19": {
   "jp": "e26d8961",
   "kr": "돌아오는 길이에요."
  },
  "20": {
   "jp": "6184fd51",
   "kr": "아아, 그렇구나."
  },
  "21": {
   "jp": "72640e6b",
   "kr": "그럼, 폴티아 사람이로군."
  },
  "22": {
   "jp": "2f18028c",
   "kr": "어서 와, 어서 와."
  },
  "23": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "24": {
   "jp": "3414382e",
   "kr": "네, 확실히."
  },
  "25": {
   "jp": "3d87c910",
   "kr": "지나가도 좋아."
  },
  "26": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "27": {
   "jp": "54d190ef",
   "kr": "저기, 병사님."
  },
  "28": {
   "jp": "acd0f142",
   "kr": "뭔가?"
  },
  "29": {
   "jp": "d2a5b37c",
   "kr": "남쪽 사람들은"
  },
  "30": {
   "jp": "280e9e28",
   "kr": "짜증이 나 있는 것 같던데."
  },
  "31": {
   "jp": "d9a40edc",
   "kr": "뭔가"
  },
  "32": {
   "jp": "6f56311f",
   "kr": "이쪽은 인원도 적고"
  },
  "33": {
   "jp": "07483399",
   "kr": "느긋해 보여."
  },
  "34": {
   "jp": "b75d5add",
   "kr": "아, 그 얘기냐."
  },
  "35": {
   "jp": "919d5205",
   "kr": "지금 남쪽 병사들은 얼마 전에 여기저기서"
  },
  "36": {
   "jp": "546415d9",
   "kr": "소집을 받은 사람들이야."
  },
  "37": {
   "jp": "02f6ba31",
   "kr": "그들이 간신히 국경을 증축해 완성했는데"
  },
  "38": {
   "jp": "47aa99ef",
   "kr": "성에서 정식 병단이 오게 돼서 말이지."
  },
  "39": {
   "jp": "2fb1f239",
   "kr": "그들이 못마땅한 것도 이해해."
  },
  "40": {
   "jp": "133c4a38",
   "kr": "뭐, 성의 명령이라 어쩔 수 없지."
  },
  "41": {
   "jp": "61696dfe",
   "kr": "이쪽은 느긋하게 할 거야."
  },
  "42": {
   "jp": "c3871a7a",
   "kr": "비밀이다만."
  },
  "43": {
   "jp": "549f25dd",
   "kr": "뭔가 이 국경은"
  },
  "44": {
   "jp": "dc7526b1",
   "kr": "수상한 냄새가 나기 시작했어."
  },
  "45": {
   "jp": "b015fa4c",
   "kr": "얼른 고향에 돌아가는 게 제일이다."
  },
  "46": {
   "jp": "401416d4",
   "kr": "어라, 아직 있었나."
  },
  "47": {
   "jp": "9433ec2a",
   "kr": "얼른 집에 돌아가는 게 좋아."
  },
  "48": {
   "jp": "85b0f684",
   "kr": "봤지, 저놈들 얼굴."
  },
  "49": {
   "jp": "d8098301",
   "kr": "흙인형처럼 표정이 없어서"
  },
  "50": {
   "jp": "936bbbe8",
   "kr": "섬뜩한 무리야…"
  },
  "51": {
   "jp": "6a10f38b",
   "kr": "저런 게 제일 위험한 법이지."
  },
  "52": {
   "jp": "c7e41f45",
   "kr": "이제 얼쩡거리지 말고"
  },
  "53": {
   "jp": "e8da615a",
   "kr": "곧장 돌아가."
  },
  "54": {
   "jp": "c81304ce",
   "kr": "(앗…?)"
  },
  "55": {
   "jp": "92abe408",
   "kr": "지시가 있을 때까지 여기 대기한다."
  },
  "56": {
   "jp": "a8ab5488",
   "kr": "각자 막사로 들어가라."
  },
  "57": {
   "jp": "b803a357",
   "kr": "결국 와 버렸네."
  },
  "58": {
   "jp": "06551424",
   "kr": "창문으로 엿보자."
  },
  "59": {
   "jp": "295c52ae",
   "kr": "여기서는 잘 안 보여."
  },
  "60": {
   "jp": "4e284fbd",
   "kr": "병단장의 뒷모습이 보여."
  },
  "61": {
   "jp": "6982adb4",
   "kr": "(왠지 수상하지…)"
  },
  "62": {
   "jp": "7384551d",
   "kr": "(마치 살아 있는 사람이 아닌 것 같아…)"
  },
  "63": {
   "jp": "f98d10d8",
   "kr": "(진짜다…)"
  },
  "64": {
   "jp": "258e1365",
   "kr": "(예언대로 전혀 표정이 없어…)"
  },
  "65": {
   "jp": "89ed3531",
   "kr": "자, 아로자로 서두르자."
  },
  "66": {
   "jp": "913baea2",
   "kr": "쥬리오 군이 은단검을 들고"
  },
  "67": {
   "jp": "1ef524f2",
   "kr": "죠안나 씨를 만나면…"
  },
  "68": {
   "jp": "55a01a07",
   "kr": "분명"
  },
  "69": {
   "jp": "0dfe9cc2",
   "kr": "라우알의 파도에 대한 대항책이"
  },
  "70": {
   "jp": "fbf5ead1",
   "kr": "발견될 것 같은 기분이 들어."
  },
  "71": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "72": {
   "jp": "78b8f7db",
   "kr": "허크 아저씨랑 바다트도 걱정이지만"
  },
  "73": {
   "jp": "e2b6ff91",
   "kr": "둘이니까 괜찮겠지?"
  },
  "74": {
   "jp": "a3ef318c",
   "kr": "응, 걱정이지만…"
  },
  "75": {
   "jp": "57af7cb1",
   "kr": "분명 괜찮을 거야."
  },
  "76": {
   "jp": "b0d75ef6",
   "kr": "지금은 삼촌이랑 바다트를 믿고"
  },
  "77": {
   "jp": "49b65205",
   "kr": "우리가 해야 할 일을"
  },
  "78": {
   "jp": "7317e33b",
   "kr": "서둘러야 해…"
  },
  "79": {
   "jp": "a97d2346",
   "kr": "크리스, 기운 내."
  },
  "80": {
   "jp": "ae4b3026",
   "kr": "그 둘이잖아."
  },
  "81": {
   "jp": "9861db11",
   "kr": "분명 또 건강한 얼굴로 나타날 거야."
  },
  "82": {
   "jp": "eded91c1",
   "kr": "또 만날 수 있어."
  },
  "83": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "84": {
   "jp": "8912858d",
   "kr": "사막의 나라 기드나에서도"
  },
  "85": {
   "jp": "fd04acc6",
   "kr": "하얀마녀의 발자취를 확인할 수 있었다."
  },
  "86": {
   "jp": "e4856fad",
   "kr": "욕망의 씨앗을 품은 자는 마음을 잃는다."
  },
  "87": {
   "jp": "46d93f3e",
   "kr": "붉은 눈을 가진 자가 재앙을 부를 것이다."
  },
  "88": {
   "jp": "ee200e69",
   "kr": "붉은 눈을 가진 자가 나타날 때,"
  },
  "89": {
   "jp": "1f13f70e",
   "kr": "악한 계획이 움직이기 시작한다…"
  },
  "90": {
   "jp": "813e3f21",
   "kr": "거상 우르기드가 통치하는 기드나는"
  },
  "91": {
   "jp": "7db3c2e1",
   "kr": "붉은 눈을 가진 폴티아의 점성술사,"
  },
  "92": {
   "jp": "eac0f946",
   "kr": "레바스의 표적이 되어 있었던 것이다."
  },
  "93": {
   "jp": "f80827cf",
   "kr": "그 책략은 기드나를 노릴 뿐 아니라"
  },
  "94": {
   "jp": "c8810931",
   "kr": "전 세계에 대한 혼란과 재앙의 준비로서"
  },
  "95": {
   "jp": "e8de8b59",
   "kr": "꾸며진 것이었다."
  },
  "96": {
   "jp": "a355dc25",
   "kr": "나아가 폴티아의 국경에서"
  },
  "97": {
   "jp": "c47202b4",
   "kr": "쥬리오 일행을 기다리던 허크는"
  },
  "98": {
   "jp": "a7c0b827",
   "kr": "하얀마녀 게르드의 마지막 예언이라 할"
  },
  "99": {
   "jp": "86d59a50",
   "kr": "불길한 말을 그들에게 전했다."
  },
  "100": {
   "jp": "06e3bc70",
   "kr": "표정 없는 병사들이 국경을 넘을 때,"
  },
  "101": {
   "jp": "a7ab051e",
   "kr": "주박에 사로잡힌 왕은 이미 힘을 잃고"
  },
  "102": {
   "jp": "8a644dfa",
   "kr": "바다도 산도 이윽고 모두 죽어 스러진다."
  },
  "103": {
   "jp": "f07fc52c",
   "kr": "이계의 여인과, 별을 부리는 남자에게"
  },
  "104": {
   "jp": "487fe085",
   "kr": "재앙의 파도가 끌려오리라…"
  },
  "105": {
   "jp": "e5c643b2",
   "kr": "그리고 그 예언대로,"
  },
  "106": {
   "jp": "f63dd459",
   "kr": "지금 바로,"
  },
  "107": {
   "jp": "5abae7a6",
   "kr": "국경에 표정 없는 병단이 도착한 것이다."
  },
  "108": {
   "jp": "9b1f3bf2",
   "kr": "쥬리오 일행은 작은 희망을 찾아"
  },
  "109": {
   "jp": "fdfe99d1",
   "kr": "아로자에 사는 듀르젤의 손녀 죠안나를"
  },
  "110": {
   "jp": "42797a43",
   "kr": "만나러 국경 길을 서두르는 것이었다."
  },
  "111": {
   "jp": "19502d6b",
   "kr": "제６장　움직이는 예언　끝"
  }
 }
}