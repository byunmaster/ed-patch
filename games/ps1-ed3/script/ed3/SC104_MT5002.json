{
 "archive": "/SCE1/SC104.DAT",
 "member": "..\\DATA\\MT5002.BIN",
 "lines": {
  "0": {
   "jp": "1a0093fc",
   "kr": "튜엘"
  },
  "1": {
   "jp": "0fc95ade",
   "kr": "여관 주인 호리"
  },
  "2": {
   "jp": "d14d7782",
   "kr": "괜찮으려나."
  },
  "3": {
   "jp": "7b6812bb",
   "kr": "잠깐 낮잠 자는 것뿐이다."
  },
  "4": {
   "jp": "6ee4edde",
   "kr": "이쪽은 시간이 아깝다고."
  },
  "5": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "6": {
   "jp": "cadb0695",
   "kr": "네〜에."
  },
  "7": {
   "jp": "e2d9e663",
   "kr": "아주 잠깐만 잘 생각이었지만"
  },
  "8": {
   "jp": "0446c5b9",
   "kr": "네 사람은 어지간히 지쳤던지"
  },
  "9": {
   "jp": "38fc024b",
   "kr": "푹 잠들어 버렸다."
  },
  "10": {
   "jp": "f497d78d",
   "kr": "…님."
  },
  "11": {
   "jp": "39437cb5",
   "kr": "알프레드 님."
  },
  "12": {
   "jp": "7fc368d9",
   "kr": "음…"
  },
  "13": {
   "jp": "2a8aad6f",
   "kr": "염려하고 있었습니다."
  },
  "14": {
   "jp": "cc8ea698",
   "kr": "무사하시니 다행입니다."
  },
  "15": {
   "jp": "ac4aecf8",
   "kr": "(모리슨, 목소리를 낮춰라.)"
  },
  "16": {
   "jp": "8bd7a030",
   "kr": "(저들이 잠에서 깬다.)"
  },
  "17": {
   "jp": "0946098b",
   "kr": "(그건 그렇고, 어디 갔었느냐.)"
  },
  "18": {
   "jp": "59b9b7f1",
   "kr": "(넬바가 혼란한 뒤,)"
  },
  "19": {
   "jp": "89f7af99",
   "kr": "(모습을 찾아 뵈었습니다만,)"
  },
  "20": {
   "jp": "9e0c105c",
   "kr": "(공교롭게도 찾지 못했습니다.)"
  },
  "21": {
   "jp": "533c01da",
   "kr": "(그건, 그…)"
  },
  "22": {
   "jp": "bedd963f",
   "kr": "(방향을 잘못 잡아서,)"
  },
  "23": {
   "jp": "5333e72d",
   "kr": "(치타로 가 버렸다.)"
  },
  "24": {
   "jp": "df00cc14",
   "kr": "(그건 그렇다 치고,)"
  },
  "25": {
   "jp": "6886fbfb",
   "kr": "(너는 지금까지 뭘 하고 있었느냐?)"
  },
  "26": {
   "jp": "f39623a6",
   "kr": "(예. 튜엘로 급히 돌아가 배를 돌려,)"
  },
  "27": {
   "jp": "fcfda092",
   "kr": "(예정대로 가루가의 소재를 확인하고자)"
  },
  "28": {
   "jp": "a4ef46fd",
   "kr": "(가루가의 행방을 쫓고 있었습니다.)"
  },
  "29": {
   "jp": "af657e1c",
   "kr": "(뭐, 뭐라…)"
  },
  "30": {
   "jp": "8bf5f1e7",
   "kr": "(제대로 일을 하고 있었구나.)"
  },
  "31": {
   "jp": "5977d422",
   "kr": "(미안하다… 수고했다.)"
  },
  "32": {
   "jp": "2c609899",
   "kr": "(가루가는 로프섬에서 잠들어 있습니다.)"
  },
  "33": {
   "jp": "eab66dc0",
   "kr": "(학자들 의견으론 짧게 5일,)"
  },
  "34": {
   "jp": "ec79c719",
   "kr": "(길게 10일은 계속 잔다고 합니다.)"
  },
  "35": {
   "jp": "3b748695",
   "kr": "(음. 어부 정보대로군.)"
  },
  "36": {
   "jp": "26f52aef",
   "kr": "(항구에 배를 대 두었습니다.)"
  },
  "37": {
   "jp": "004836be",
   "kr": "(어서, 가시지요.)"
  },
  "38": {
   "jp": "90d99223",
   "kr": "(아까부터 신경 쓰였습니다만)"
  },
  "39": {
   "jp": "f5cf8c12",
   "kr": "(저들은…?)"
  },
  "40": {
   "jp": "01204e7f",
   "kr": "(음.)"
  },
  "41": {
   "jp": "929e89ca",
   "kr": "(여행 도중 신세 진 벗이다.)"
  },
  "42": {
   "jp": "e785cf1b",
   "kr": "(모리슨.)"
  },
  "43": {
   "jp": "d0cfc4fb",
   "kr": "(언제든 출범할 수 있게 대기해라.)"
  },
  "44": {
   "jp": "9ecf519a",
   "kr": "(나도 곧 가겠다.)"
  },
  "45": {
   "jp": "cff79185",
   "kr": "(알겠습니다.)"
  },
  "46": {
   "jp": "96bf5dc0",
   "kr": "(쥬리오, 크리스.)"
  },
  "47": {
   "jp": "bdc9c9f6",
   "kr": "(그리고 로디.)"
  },
  "48": {
   "jp": "30b83c8e",
   "kr": "(같이 데려갈까…)"
  },
  "49": {
   "jp": "2a81a493",
   "kr": "(아니, 그들의 마음은 기쁘지만,)"
  },
  "50": {
   "jp": "476877a5",
   "kr": "(앞으로의 싸움은 너무 위험하다.)"
  },
  "51": {
   "jp": "27090f4f",
   "kr": "(의욕만으로는 가루가를 이길 수 없다.)"
  },
  "52": {
   "jp": "f589b48c",
   "kr": "(특히 로디라는 검사.)"
  },
  "53": {
   "jp": "e7daf3ca",
   "kr": "(그는 진심이다. 가루가와 마주하면,)"
  },
  "54": {
   "jp": "3cd5cd33",
   "kr": "(목숨 다할 때까지 싸울 작정이다.)"
  },
  "55": {
   "jp": "d7d76dba",
   "kr": "(저들은 이곳에 남겨 두고 가는 게)"
  },
  "56": {
   "jp": "f1eda22b",
   "kr": "(좋을지도 모르겠다.)"
  },
  "57": {
   "jp": "870c55f8",
   "kr": "(짧은 동안이었지만, 이것이 내 마음이다.)"
  },
  "58": {
   "jp": "17ee15e2",
   "kr": "(여행의 좋은 벗들이여.)"
  },
  "59": {
   "jp": "d83647a1",
   "kr": "(말없이 떠나는 나를 부디 용서해 다오.)"
  },
  "60": {
   "jp": "f052f5d3",
   "kr": "알프는 자기가 끼고 있던 반지를 빼서"
  },
  "61": {
   "jp": "ef3ac638",
   "kr": "탁자 위에 놓았다."
  },
  "62": {
   "jp": "5204ff6f",
   "kr": "잘 있게."
  },
  "63": {
   "jp": "8d40a425",
   "kr": "신세 졌네."
  },
  "64": {
   "jp": "6d608611",
   "kr": "아뇨, 별말씀을 다 하세요."
  },
  "65": {
   "jp": "689757e8",
   "kr": "조심히 가세요."
  },
  "66": {
   "jp": "93360fdb",
   "kr": "미안."
  }
 }
}