{
 "archive": "/SCE5/SC503.DAT",
 "member": "..\\DATA\\NT1015.BIN",
 "lines": {
  "0": {
   "jp": "4822a33b",
   "kr": "리즈의 집"
  },
  "1": {
   "jp": "dba7b35a",
   "kr": "리즈"
  },
  "2": {
   "jp": "631357d7",
   "kr": "방방"
  },
  "3": {
   "jp": "dc4dc8a2",
   "kr": "그쪽에는 분명 요새 병사가 있을 거예요."
  },
  "4": {
   "jp": "78f1121f",
   "kr": "어서 하이젠으로 가요."
  },
  "5": {
   "jp": "9c32439a",
   "kr": "휘리랑 캐라크 왕이 기다리고 있어."
  },
  "6": {
   "jp": "d78521bd",
   "kr": "서둘러야 해…"
  },
  "7": {
   "jp": "28f14e92",
   "kr": "남북 가도로 가자."
  },
  "8": {
   "jp": "10b5ef60",
   "kr": "크리스가 생각한 작전이잖아."
  },
  "9": {
   "jp": "c3b43502",
   "kr": "어머, 휘리."
  },
  "10": {
   "jp": "b4ffd03b",
   "kr": "어서 오렴."
  },
  "11": {
   "jp": "e168fde3",
   "kr": "비약은 무사히 만들었나 보구나."
  },
  "12": {
   "jp": "7b75a6d3",
   "kr": "네, 어머니."
  },
  "13": {
   "jp": "887f708b",
   "kr": "알그레스가 아직 숲에 있었어요."
  },
  "14": {
   "jp": "5fcd7891",
   "kr": "그래, 잘됐구나."
  },
  "15": {
   "jp": "4721f72b",
   "kr": "분명, 우돌 사람들이"
  },
  "16": {
   "jp": "a0f93f56",
   "kr": "숲을 소중히 여겨 준 덕분이겠지."
  },
  "17": {
   "jp": "faac6726",
   "kr": "안녕하세요, 크리스예요."
  },
  "18": {
   "jp": "2141d739",
   "kr": "제가 저주에 걸려 있었어요."
  },
  "19": {
   "jp": "a5eb17ce",
   "kr": "휘리 씨에게는 정말 신세를 졌습니다."
  },
  "20": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "21": {
   "jp": "5d62753d",
   "kr": "어머, 참 야무진 아가씨네요."
  },
  "22": {
   "jp": "7d5ab9c7",
   "kr": "정말 잘됐어요."
  },
  "23": {
   "jp": "aef8a37d",
   "kr": "편히 쉬다 가세요."
  },
  "24": {
   "jp": "44e0f6ab",
   "kr": "그게요, 어머니."
  },
  "25": {
   "jp": "41b32b22",
   "kr": "느긋하게 있을 수가 없어요."
  },
  "26": {
   "jp": "ee93caf6",
   "kr": "무슨 일 있었니?"
  },
  "27": {
   "jp": "33330e4b",
   "kr": "홀크의 국왕님께 부탁받아서"
  },
  "28": {
   "jp": "165d0755",
   "kr": "하이젠의 국왕님께 친서를 전하러 가요."
  },
  "29": {
   "jp": "2a209349",
   "kr": "어머, 그렇게 중요한 일을?"
  },
  "30": {
   "jp": "bfa78afe",
   "kr": "그럼"
  },
  "31": {
   "jp": "ffaf6e04",
   "kr": "어서 전해 드리고 오렴."
  },
  "32": {
   "jp": "02197780",
   "kr": "부디 실수 없도록 하고."
  },
  "33": {
   "jp": "c3e9e961",
   "kr": "네, 어머니."
  },
  "34": {
   "jp": "cdec91e9",
   "kr": "어서 전하고 오렴."
  },
  "35": {
   "jp": "b7c1ac12",
   "kr": "한눈팔지 말고 가야 한다."
  },
  "36": {
   "jp": "3d71eae7",
   "kr": "휘리도 참,"
  },
  "37": {
   "jp": "876dc080",
   "kr": "엄청난 기세로 달려갔네."
  },
  "38": {
   "jp": "b9bb8e6c",
   "kr": "약초를 캐느라 들과 산을 뛰어다니니까"
  },
  "39": {
   "jp": "68513304",
   "kr": "저 애, 보기보다 튼튼하단 말이야."
  },
  "40": {
   "jp": "5ce40eb9",
   "kr": "건강하게 자라 줘서 다행이야."
  },
  "41": {
   "jp": "74e64140",
   "kr": "쿠히쿠히…"
  },
  "42": {
   "jp": "b2f0fc95",
   "kr": "착하게 있었니?"
  },
  "43": {
   "jp": "57a8f6f0",
   "kr": "집 잘 보고 있어야 해."
  },
  "44": {
   "jp": "74e64140",
   "kr": "쿠히쿠히…"
  },
  "45": {
   "jp": "ab0fdcf9",
   "kr": "방방은"
  },
  "46": {
   "jp": "f27e0227",
   "kr": "왜 이름이 방방일까?"
  },
  "47": {
   "jp": "84266c65",
   "kr": "글쎄, 어디에나"
  },
  "48": {
   "jp": "b6f3cff9",
   "kr": "방방 부딪히니까 그렇겠지."
  },
  "49": {
   "jp": "72387181",
   "kr": "바앙, 바앙!"
  },
  "50": {
   "jp": "bc2da354",
   "kr": "그럼 쥬리오 씨."
  },
  "51": {
   "jp": "340573c9",
   "kr": "상의한 대로,"
  },
  "52": {
   "jp": "95572d1d",
   "kr": "저는 홀크의 캐라크 왕께"
  },
  "53": {
   "jp": "c3fd1244",
   "kr": "알리러 가겠어요."
  },
  "54": {
   "jp": "027052f7",
   "kr": "응, 에네톤 왕 쪽은 괜찮다고 전해 줘."
  },
  "55": {
   "jp": "d0daff7a",
   "kr": "그리고, 왕비님을 구한 신호는"
  },
  "56": {
   "jp": "03117bb6",
   "kr": "크리스가 큰 소리로 외칠 테니까,"
  },
  "57": {
   "jp": "bed8887c",
   "kr": "소리가 들릴 때까지 요새엔 들어가지 말라고."
  },
  "58": {
   "jp": "35fc609f",
   "kr": "네. 알겠어요."
  },
  "59": {
   "jp": "7485d60b",
   "kr": "그럼, 다녀올게요."
  },
  "60": {
   "jp": "baa18e35",
   "kr": "조심하세요."
  }
 }
}