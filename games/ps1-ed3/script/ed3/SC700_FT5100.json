{
 "archive": "/SCE7/SC700.DAT",
 "member": "..\\DATA\\FT5100.BIN",
 "lines": {
  "0": {
   "jp": "07150912",
   "kr": "돌페스"
  },
  "1": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "2": {
   "jp": "7dd494d3",
   "kr": "델포"
  },
  "3": {
   "jp": "18170af0",
   "kr": "챠펠의 도미나"
  },
  "4": {
   "jp": "3b2c83fe",
   "kr": "비다"
  },
  "5": {
   "jp": "b5299042",
   "kr": "호커"
  },
  "6": {
   "jp": "adbd4f65",
   "kr": "지니프"
  },
  "7": {
   "jp": "86322021",
   "kr": "아리스"
  },
  "8": {
   "jp": "7fcfef61",
   "kr": "스팟치"
  },
  "9": {
   "jp": "864de54a",
   "kr": "오닐"
  },
  "10": {
   "jp": "69213772",
   "kr": "술집 라이센"
  },
  "11": {
   "jp": "7b74ec28",
   "kr": "파렐"
  },
  "12": {
   "jp": "5ea7ff21",
   "kr": "보피"
  },
  "13": {
   "jp": "30507d74",
   "kr": "레아노"
  },
  "14": {
   "jp": "a6208964",
   "kr": "아저씨."
  },
  "15": {
   "jp": "83b0d9d0",
   "kr": "빨리 숨바꼭질하자."
  },
  "16": {
   "jp": "8c3e34af",
   "kr": "아직 일하는 중이라 안 돼."
  },
  "17": {
   "jp": "1a7c5602",
   "kr": "(아리스.)"
  },
  "18": {
   "jp": "40a53a9b",
   "kr": "(제대로 부탁해 줄까…)"
  },
  "19": {
   "jp": "511bce04",
   "kr": "(딴 걸 부탁하는 것 같아.)"
  },
  "20": {
   "jp": "30943cec",
   "kr": "저기, 하자."
  },
  "21": {
   "jp": "cb02bec5",
   "kr": "숨바꼭질."
  },
  "22": {
   "jp": "e3ab91cf",
   "kr": "조금만. 조금만."
  },
  "23": {
   "jp": "5555dc8b",
   "kr": "정말 어쩔 수 없구나…"
  },
  "24": {
   "jp": "57bd1698",
   "kr": "조금만이야."
  },
  "25": {
   "jp": "551f7774",
   "kr": "지금이에요."
  },
  "26": {
   "jp": "a977e58c",
   "kr": "가요."
  },
  "27": {
   "jp": "b32947e7",
   "kr": "마을 병사들은"
  },
  "28": {
   "jp": "a3f252f0",
   "kr": "아직 내가 탑에서 나온 걸"
  },
  "29": {
   "jp": "d6450986",
   "kr": "눈치채지 못한 모양이군."
  },
  "30": {
   "jp": "21bb1b59",
   "kr": "하지만 시간문제야."
  },
  "31": {
   "jp": "0a81ea81",
   "kr": "어서 여기서"
  },
  "32": {
   "jp": "7c510424",
   "kr": "떠나는 게 좋아."
  },
  "33": {
   "jp": "9e8f72b3",
   "kr": "응, 맞아."
  },
  "34": {
   "jp": "f6473972",
   "kr": "이 앞은 돌페스의 탑이야."
  },
  "35": {
   "jp": "cb98863a",
   "kr": "예전에는 루드성의 별궁으로 쓰였는데"
  },
  "36": {
   "jp": "8ef8a6d6",
   "kr": "지금은 유폐를 위한 감옥으로 쓰고 있어."
  },
  "37": {
   "jp": "0323e969",
   "kr": "미안하지만"
  },
  "38": {
   "jp": "2d8d8cf5",
   "kr": "일반인은 여기서 앞으론 못 지나가."
  },
  "39": {
   "jp": "fa965e02",
   "kr": "아, 그렇군요…"
  },
  "40": {
   "jp": "dc0ddb88",
   "kr": "아까도 말했듯이"
  },
  "41": {
   "jp": "be963523",
   "kr": "미안하지만 일반인은"
  },
  "42": {
   "jp": "cfd08845",
   "kr": "여기서부터는 못 지나가."
  },
  "43": {
   "jp": "0376d88f",
   "kr": "난 숨바꼭질 술래는"
  },
  "44": {
   "jp": "14273c66",
   "kr": "영 서툴단 말이지…"
  },
  "45": {
   "jp": "eeb63871",
   "kr": "(통과시켜 주지 않으면 탑에 못 가.)"
  },
  "46": {
   "jp": "519cb600",
   "kr": "(죠안나 씨 얘기.)"
  },
  "47": {
   "jp": "10c7c62a",
   "kr": "(듀르젤 씨의 손녀라고 하면)"
  },
  "48": {
   "jp": "6eda3920",
   "kr": "(보내 줄지도 몰라.)"
  },
  "49": {
   "jp": "e27054d5",
   "kr": "(그건 위험해요.)"
  },
  "50": {
   "jp": "2b217709",
   "kr": "(오히려 의심받을지도 몰라…)"
  },
  "51": {
   "jp": "891c364e",
   "kr": "(네. 그렇겠지요…)"
  },
  "52": {
   "jp": "e1b7f583",
   "kr": "챠펠 마법을 다룰 수 있는 이가 있는가?"
  },
  "53": {
   "jp": "d3c0feae",
   "kr": "그렇다면 안쪽 방에서"
  },
  "54": {
   "jp": "cbb1c54f",
   "kr": "도미나가 전수해 주겠지."
  },
  "55": {
   "jp": "88d3cf4d",
   "kr": "가 보시게."
  },
  "56": {
   "jp": "6f002ac7",
   "kr": "20년 전"
  },
  "57": {
   "jp": "6e1376c7",
   "kr": "몹시 뛰어난 마법사가"
  },
  "58": {
   "jp": "0f8bddf8",
   "kr": "이 고장을 찾아온 적이 있네."
  },
  "59": {
   "jp": "7401d3f2",
   "kr": "그 아가씨…"
  },
  "60": {
   "jp": "41432e2b",
   "kr": "아마 게르드라고 했던가…"
  },
  "61": {
   "jp": "e608a631",
   "kr": "하얀마녀라 부르는 자도 있었지."
  },
  "62": {
   "jp": "e0e39dd6",
   "kr": "어찌 지내고 있으려나…"
  },
  "63": {
   "jp": "43a62c96",
   "kr": "하얀마녀는"
  },
  "64": {
   "jp": "3128eb6c",
   "kr": "여기에도 나타났었어?"
  },
  "65": {
   "jp": "6688c794",
   "kr": "호오, 당신도 아시는구려."
  },
  "66": {
   "jp": "6001b8c8",
   "kr": "하얀마녀는 듀르젤 공과 여기 왔었지."
  },
  "67": {
   "jp": "e6a12507",
   "kr": "루드성의 궁정 검사였던 듀르젤 공과 말이야."
  },
  "68": {
   "jp": "b9277829",
   "kr": "그 뒤에 무슨 일이 있었는지는 모르지만"
  },
  "69": {
   "jp": "2e88193a",
   "kr": "얼마 뒤 듀르젤 공은 돌페스의 탑에"
  },
  "70": {
   "jp": "8ea23816",
   "kr": "갇힌 몸이 되고 말았다."
  },
  "71": {
   "jp": "fd2f22d4",
   "kr": "하얀마녀 쪽은"
  },
  "72": {
   "jp": "2d46cd4d",
   "kr": "어떻게 되었는지 알 수 없어."
  },
  "73": {
   "jp": "ad0e76ca",
   "kr": "아무리 물어도"
  },
  "74": {
   "jp": "d520b602",
   "kr": "듀르젤 공은 아무 말도 하지 않는다더군."
  },
  "75": {
   "jp": "ddb0e5ba",
   "kr": "챠펠 마법을 익히실 수 있는 분이"
  },
  "76": {
   "jp": "18fb7eb6",
   "kr": "계신가요?"
  },
  "77": {
   "jp": "f3b2f226",
   "kr": "괜찮으시다면"
  },
  "78": {
   "jp": "fc40d2f1",
   "kr": "챠펠 마법을 전수해 드리지요."
  },
  "79": {
   "jp": "dd09fa95",
   "kr": "어느 분이 원하시나요?"
  },
  "80": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "81": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "82": {
   "jp": "aa928204",
   "kr": "또 들러 주십시오."
  },
  "83": {
   "jp": "6d66c53c",
   "kr": "아리스가 아직 어리니 괜찮지만"
  },
  "84": {
   "jp": "83261815",
   "kr": "어른이 되어서 병사한테라도 반해 버린다면"
  },
  "85": {
   "jp": "157fc688",
   "kr": "좀 걱정이에요."
  },
  "86": {
   "jp": "980b9b5d",
   "kr": "병사들은 일 때문에 여기 있을 뿐인걸…"
  },
  "87": {
   "jp": "4e79bd1a",
   "kr": "근무가 끝나면 자기 마을로"
  },
  "88": {
   "jp": "a76b8e00",
   "kr": "돌아가 버릴 테니까요."
  },
  "89": {
   "jp": "9ac14e3c",
   "kr": "어머, 제가 걱정이 많네요…"
  },
  "90": {
   "jp": "2fb75aa0",
   "kr": "이상하게 병사랑 검사는 여자한테 인기 있어."
  },
  "91": {
   "jp": "9f257dd4",
   "kr": "좀 부럽군."
  },
  "92": {
   "jp": "b56f2e0d",
   "kr": "나도 루드성에 가서 지원해 볼까…"
  },
  "93": {
   "jp": "f3803b03",
   "kr": "딸 아리스는 숨바꼭질을 좋아해서 말이야."
  },
  "94": {
   "jp": "b7d402ec",
   "kr": "가끔 비번인 병사한테"
  },
  "95": {
   "jp": "3b1365ad",
   "kr": "상대해 달라고 하고 있단다."
  },
  "96": {
   "jp": "e62cb5b4",
   "kr": "여기 병사들은 아이한테는 상냥하거든."
  },
  "97": {
   "jp": "73601e5a",
   "kr": "좋은 돌보미가 돼 줘서 도움이 되고 있지."
  },
  "98": {
   "jp": "d8aa74fb",
   "kr": "혼자서 숨바꼭질을 하고 있어도"
  },
  "99": {
   "jp": "a6c1135b",
   "kr": "재미없단 말야."
  },
  "100": {
   "jp": "6bdb6c27",
   "kr": "빨리 뱅사 아저씨가"
  },
  "101": {
   "jp": "8756ed9d",
   "kr": "놀아 주면 좋겠는데."
  },
  "102": {
   "jp": "7bcca1c6",
   "kr": "혹시 네가 아리스니?"
  },
  "103": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "104": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "105": {
   "jp": "c651d03c",
   "kr": "설마 싶기는 하지만"
  },
  "106": {
   "jp": "ef06e168",
   "kr": "아리스에게 부탁해 보자."
  },
  "107": {
   "jp": "9e8f72b3",
   "kr": "응, 맞아."
  },
  "108": {
   "jp": "ba531854",
   "kr": "아리스."
  },
  "109": {
   "jp": "dd7fc1ba",
   "kr": "언니들은 돌페스의 탑 쪽으로 가고 싶은데."
  },
  "110": {
   "jp": "5d96cbca",
   "kr": "그런데 병사 아저씨가 안 보내 줘."
  },
  "111": {
   "jp": "28992b2e",
   "kr": "보내 주게끔"
  },
  "112": {
   "jp": "f4a9ad97",
   "kr": "말 좀 해 줄 수 없을까?"
  },
  "113": {
   "jp": "283c1ebf",
   "kr": "좋아."
  },
  "114": {
   "jp": "eb067211",
   "kr": "헤헤헤."
  },
  "115": {
   "jp": "072a88b4",
   "kr": "못 차즐걸, 메롱."
  },
  "116": {
   "jp": "dfe1b384",
   "kr": "탑 경비를 명받은 쪽이"
  },
  "117": {
   "jp": "f77781df",
   "kr": "우리보다 힘들어 보여."
  },
  "118": {
   "jp": "1a9bb5a3",
   "kr": "왜냐면"
  },
  "119": {
   "jp": "2d7f3095",
   "kr": "경비견 대신 마수를 풀어놓고"
  },
  "120": {
   "jp": "1d77554e",
   "kr": "기른다니까."
  },
  "121": {
   "jp": "2a8ec427",
   "kr": "마수를 풀어놓고요?"
  },
  "122": {
   "jp": "9fc77279",
   "kr": "그래. 마수를 풀어 기르지."
  },
  "123": {
   "jp": "01e7b0f7",
   "kr": "무섭지?"
  },
  "124": {
   "jp": "19886485",
   "kr": "하지만 탑에 안 들어가면 괜찮아."
  },
  "125": {
   "jp": "84d8c89b",
   "kr": "성실한 병사님은 멋져."
  },
  "126": {
   "jp": "7a516bd8",
   "kr": "나 갑옷 차림이 동경돼 버려."
  },
  "127": {
   "jp": "050c771d",
   "kr": "어머, 별일이네."
  },
  "128": {
   "jp": "0955a5ea",
   "kr": "나그네인가."
  },
  "129": {
   "jp": "05c07cde",
   "kr": "그 나이엔 아직 술은 못 내주지만"
  },
  "130": {
   "jp": "a074545a",
   "kr": "뭐, 편히 쉬다 가렴."
  },
  "131": {
   "jp": "e2b29c2e",
   "kr": "우리 손님은 비번인 병사뿐이지만"
  },
  "132": {
   "jp": "52510dd4",
   "kr": "다들 성격 좋은 놈들이야."
  },
  "133": {
   "jp": "e0a8dce7",
   "kr": "시비 걸릴 일은 없으니 안심하라고."
  },
  "134": {
   "jp": "e82f38c5",
   "kr": "우리는 돌페스 마을과 탑 사이를"
  },
  "135": {
   "jp": "f2b68226",
   "kr": "지키는 게 임무야."
  },
  "136": {
   "jp": "907bc35d",
   "kr": "성 쪽은 이래저래 움직임이 있는 모양이지만"
  },
  "137": {
   "jp": "677034bd",
   "kr": "여기는 지루할 만큼"
  },
  "138": {
   "jp": "f5a23847",
   "kr": "느긋하게 지내고 있지."
  },
  "139": {
   "jp": "97dd1488",
   "kr": "흥, 여기가 루드성 별궁으로"
  },
  "140": {
   "jp": "7f79fd73",
   "kr": "번성했다고 자랑하는 건"
  },
  "141": {
   "jp": "2e114f82",
   "kr": "낭만적인 걸 좋아하는 여자들뿐이지."
  },
  "142": {
   "jp": "ed8a2996",
   "kr": "성과 관계가 있건, 없건"
  },
  "143": {
   "jp": "bf3bdde2",
   "kr": "우리 밥벌이하고는 상관없는 일이야."
  },
  "144": {
   "jp": "bb713aa2",
   "kr": "이 돌페스가"
  },
  "145": {
   "jp": "3dc6968c",
   "kr": "루드성의 별궁으로 지어진 것은"
  },
  "146": {
   "jp": "8c0a93f3",
   "kr": "퍽 오래된 이야기지만요."
  },
  "147": {
   "jp": "be223fb3",
   "kr": "이 고장과 루드성의 관계는"
  },
  "148": {
   "jp": "5ed28033",
   "kr": "그것뿐이 아니에요."
  },
  "149": {
   "jp": "b2907cbd",
   "kr": "뭐니 뭐니 해도 루돌프 왕과 이자벨 왕비가"
  },
  "150": {
   "jp": "827ddeed",
   "kr": "처음 만난 곳이거든요."
  },
  "151": {
   "jp": "91baa814",
   "kr": "역시 여자인 저로서는"
  },
  "152": {
   "jp": "b3318b60",
   "kr": "그쪽이 더 흥미롭네요."
  }
 }
}