{
 "archive": "/SCE1/SC100.DAT",
 "member": "..\\DATA\\MT7002.BIN",
 "lines": {
  "0": {
   "jp": "ea7ef945",
   "kr": "타라타호"
  },
  "1": {
   "jp": "fcb6f9f2",
   "kr": "갑판"
  },
  "2": {
   "jp": "5cc70478",
   "kr": "어부 토바이"
  },
  "3": {
   "jp": "4143d47e",
   "kr": "저…정말로…"
  },
  "4": {
   "jp": "ca249e09",
   "kr": "가루가가…나왔어…"
  },
  "5": {
   "jp": "45a7ec58",
   "kr": "네…네갈섬이…"
  },
  "6": {
   "jp": "c2ad7c0b",
   "kr": "테그라가 습격당한 거여…"
  },
  "7": {
   "jp": "59406648",
   "kr": "가루가라니…"
  },
  "8": {
   "jp": "5076f79c",
   "kr": "사람은 습격하지"
  },
  "9": {
   "jp": "1c172cb1",
   "kr": "않는다고 했잖아."
  },
  "10": {
   "jp": "653e9d1e",
   "kr": "저놈, 어디로 헤엄쳐 갈"
  },
  "11": {
   "jp": "a17381e4",
   "kr": "셈일까?"
  },
  "12": {
   "jp": "dd470eb2",
   "kr": "저쪽은 메나트의 수도,"
  },
  "13": {
   "jp": "c005d3bb",
   "kr": "넬바 방향이여."
  },
  "14": {
   "jp": "6d5510f4",
   "kr": "이거, 큰일이구먼."
  },
  "15": {
   "jp": "02e881dc",
   "kr": "저런 놈이 습격해 오면,"
  },
  "16": {
   "jp": "d47377c9",
   "kr": "사람이 만든 성 따위 한 방에 날아가 부러."
  },
  "17": {
   "jp": "64be5e37",
   "kr": "상륙하려나…"
  },
  "18": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "19": {
   "jp": "69157970",
   "kr": "크리스, 토바이 씨."
  },
  "20": {
   "jp": "8f5994e7",
   "kr": "봐요, 저기!"
  },
  "21": {
   "jp": "4a9a536a",
   "kr": "엇? 뭔데."
  },
  "22": {
   "jp": "c3a37860",
   "kr": "봐, 사람이 타고 있어."
  },
  "23": {
   "jp": "b3db8889",
   "kr": "불러 볼까?"
  },
  "24": {
   "jp": "73836b73",
   "kr": "어〜이, 어〜이!"
  },
  "25": {
   "jp": "8d90d25a",
   "kr": "어〜이!"
  },
  "26": {
   "jp": "eae316a1",
   "kr": "칫"
  },
  "27": {
   "jp": "88367ba6",
   "kr": "가 버렸어."
  },
  "28": {
   "jp": "bc2b6837",
   "kr": "가 버렸네."
  },
  "29": {
   "jp": "ca86c3b7",
   "kr": "그건 그렇고"
  },
  "30": {
   "jp": "251232a2",
   "kr": "저 작은 배에 타고 있던 사람."
  },
  "31": {
   "jp": "4cd9f9f2",
   "kr": "무척 심각한 얼굴이었어."
  },
  "32": {
   "jp": "b5c5c7e7",
   "kr": "분명, 가루가한테 엉망이 된"
  },
  "33": {
   "jp": "3870db7a",
   "kr": "테그라 마을 사람이여."
  },
  "34": {
   "jp": "98c91408",
   "kr": "심각한 얼굴도 되겄제."
  },
  "35": {
   "jp": "a2a8f8b4",
   "kr": "네. 그렇겠네요."
  },
  "36": {
   "jp": "640810e5",
   "kr": "그보다"
  },
  "37": {
   "jp": "469dc6b7",
   "kr": "슬슬 네갈섬에 닿겄어."
  },
  "38": {
   "jp": "112ac698",
   "kr": "내릴 준비를 하더라고."
  },
  "39": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "40": {
   "jp": "9b20da62",
   "kr": "네!"
  },
  "41": {
   "jp": "89ba3d14",
   "kr": "얼마 뒤 쥬리오 일행을 태운 타라타호는"
  },
  "42": {
   "jp": "2a8cf1f2",
   "kr": "무사히 네갈섬 선착장에 도착할 수 있었다."
  },
  "43": {
   "jp": "71592c66",
   "kr": "가루가의 피해가 걱정이었지만 보아하니 선착장"
  },
  "44": {
   "jp": "326b4d2c",
   "kr": "에 피해는 없는 듯했다."
  },
  "45": {
   "jp": "034b7889",
   "kr": "테그라 샤리네는 가깝다. 여기까지 오면,"
  },
  "46": {
   "jp": "e904f2a1",
   "kr": "샤리네가 가루가에게 부서지지 않았기를"
  },
  "47": {
   "jp": "078e0e62",
   "kr": "빌 뿐이다. 쥬리오와 크리스는 조급한 마음을"
  },
  "48": {
   "jp": "8cd3c93a",
   "kr": "누르고 타라타호를 뒤로했다."
  }
 }
}