{
 "archive": "/SCE0/SC000.DAT",
 "member": "..\\DATA\\FT0102.BIN",
 "lines": {
  "0": {
   "jp": "bb708123",
   "kr": "라그픽 마을"
  },
  "1": {
   "jp": "1df824f5",
   "kr": "마을 어귀"
  },
  "2": {
   "jp": "89ecea13",
   "kr": "라프 할아버지"
  },
  "3": {
   "jp": "c582dc13",
   "kr": "키리"
  },
  "4": {
   "jp": "d3d3a49a",
   "kr": "시논"
  },
  "5": {
   "jp": "27e4ad4e",
   "kr": "시아라"
  },
  "6": {
   "jp": "fcea3f33",
   "kr": "엘포"
  },
  "7": {
   "jp": "52502f16",
   "kr": "이놈!"
  },
  "8": {
   "jp": "16703c0a",
   "kr": "라프 할아버지…"
  },
  "9": {
   "jp": "c6880c3f",
   "kr": "한 번 마을을 나선 순례자는"
  },
  "10": {
   "jp": "1e7c673d",
   "kr": "여행을 끝낼 때까지 못 돌아오는 건 알지?"
  },
  "11": {
   "jp": "548c0560",
   "kr": "쓸쓸해졌다고 돌아와서는"
  },
  "12": {
   "jp": "baf87b92",
   "kr": "언제까지고 어른이 되지 못한다."
  },
  "13": {
   "jp": "16d1d618",
   "kr": "자, 힘내거라!"
  },
  "14": {
   "jp": "a54c82ab",
   "kr": "그건 그렇고…"
  },
  "15": {
   "jp": "5fce520f",
   "kr": "오오. 마침 잘 왔다."
  },
  "16": {
   "jp": "ae25076e",
   "kr": "자, 들어오거라."
  },
  "17": {
   "jp": "f5aa9fb9",
   "kr": "그럼, 이제 순례를 떠나는"
  },
  "18": {
   "jp": "ada3399e",
   "kr": "젊은 쥬리오와 크리스에게,"
  },
  "19": {
   "jp": "9897bdf3",
   "kr": "이 몸이 한마디만 마음가짐을 일러 주마."
  },
  "20": {
   "jp": "da5154ac",
   "kr": "잘 들어라."
  },
  "21": {
   "jp": "34e10935",
   "kr": "마을을 한 걸음 나서면,"
  },
  "22": {
   "jp": "18afd444",
   "kr": "너희는 여러 일을 만나게 될 게다."
  },
  "23": {
   "jp": "5c9609b1",
   "kr": "좋은 일도 있고, 나쁜 일도 있지."
  },
  "24": {
   "jp": "243b01d5",
   "kr": "하지만"
  },
  "25": {
   "jp": "c31d3802",
   "kr": "설령 나쁜 일에 부딪치더라도"
  },
  "26": {
   "jp": "b069d3db",
   "kr": "어두운 얼굴을 해선 안 된다."
  },
  "27": {
   "jp": "884c69c3",
   "kr": "또 나쁜 일이 생기지 않을까"
  },
  "28": {
   "jp": "835452a8",
   "kr": "벌벌 떨고 있으면,"
  },
  "29": {
   "jp": "de2107b8",
   "kr": "재난이 제 발로 찾아온단다."
  },
  "30": {
   "jp": "620bccdb",
   "kr": "매사는 좋은 쪽으로 생각하거라."
  },
  "31": {
   "jp": "42eb367c",
   "kr": "그게 제일이다."
  },
  "32": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "33": {
   "jp": "7b77d837",
   "kr": "알았어."
  },
  "34": {
   "jp": "6eca10ca",
   "kr": "크리스, 너한테 딱 맞는 게 있다."
  },
  "35": {
   "jp": "3d97c3fc",
   "kr": "자, 가져가거라."
  },
  "36": {
   "jp": "10abf4e4",
   "kr": "…라고 하고 싶다만"
  },
  "37": {
   "jp": "7f7644c1",
   "kr": "짐이 너무 많구나."
  },
  "38": {
   "jp": "7a024bd8",
   "kr": "뭔가 버리는 게 좋겠다."
  },
  "39": {
   "jp": "3e0cc9ad",
   "kr": "크리스는 "
  },
  "40": {
   "jp": "6c9a91dc",
   "kr": "을(를) 받았다."
  },
  "41": {
   "jp": "6b46389f",
   "kr": "라프 할아버지의 소중한 물건 아니야?"
  },
  "42": {
   "jp": "4549e995",
   "kr": "뭘. 옛날에 쓰던 떡갈나무 지팡이란다."
  },
  "43": {
   "jp": "11d864b1",
   "kr": "빨랫대 대신 쓰던 거라서"
  },
  "44": {
   "jp": "c96ff152",
   "kr": "사양할 필요 없단다."
  },
  "45": {
   "jp": "a41c7776",
   "kr": "…고마워, 라프 할아버지."
  },
  "46": {
   "jp": "7279501f",
   "kr": "그럼 안녕, 라프 할아버지."
  },
  "47": {
   "jp": "855aa47f",
   "kr": "너무 촌장님 속 썩이면 안 돼."
  },
  "48": {
   "jp": "81ee2dcb",
   "kr": "제법 큰소리를 치는구나."
  },
  "49": {
   "jp": "4d14d4ce",
   "kr": "길 조심해서 가거라."
  },
  "50": {
   "jp": "8b8fc91c",
   "kr": "라프 할아버지께 인사는 했냐?"
  },
  "51": {
   "jp": "7af9c015",
   "kr": "아무 말 없이 여행을 떠나면 영감님도"
  },
  "52": {
   "jp": "d8d9048c",
   "kr": "섭섭해하실 게다."
  },
  "53": {
   "jp": "44a51d87",
   "kr": "순례 여행이 끝나면 이제 어른이다."
  },
  "54": {
   "jp": "e8ded457",
   "kr": "힘내고 와라!"
  },
  "55": {
   "jp": "5b1214df",
   "kr": "내가 마법사라고?"
  },
  "56": {
   "jp": "8f324611",
   "kr": "으음. 그런 일도 있었을지 모르겠구나."
  },
  "57": {
   "jp": "5ffbb7ac",
   "kr": "그보다 어서 디네로 가지 않으면"
  },
  "58": {
   "jp": "adec00ba",
   "kr": "언제까지고 돌아오지 못한단다."
  },
  "59": {
   "jp": "ed3f5d53",
   "kr": "시논 말이냐?"
  },
  "60": {
   "jp": "fa1b7ea6",
   "kr": "이미 돌아가 버렸단다."
  },
  "61": {
   "jp": "6463e5ac",
   "kr": "그것보다도,"
  },
  "62": {
   "jp": "647f779a",
   "kr": "서둘러 라그나로 가지 않으면"
  },
  "63": {
   "jp": "fd62a283",
   "kr": "배가 떠나 버리면 큰일이란다."
  },
  "64": {
   "jp": "a7829b4b",
   "kr": "자, 힘차게 출발하거라!"
  },
  "65": {
   "jp": "5182bcaa",
   "kr": "라그픽 마을은 처음 와 봤는데"
  },
  "66": {
   "jp": "0ebb703a",
   "kr": "꽤 좋은 곳이네요."
  },
  "67": {
   "jp": "1d06fd42",
   "kr": "라프 씨께서"
  },
  "68": {
   "jp": "4ba2b7bc",
   "kr": "연세에 비해 정정하셔서 안심했어요."
  },
  "69": {
   "jp": "f9c51768",
   "kr": "역시 대마법사님이시네요."
  },
  "70": {
   "jp": "45219a3e",
   "kr": "있지〜, 대마법사님을 만났어."
  },
  "71": {
   "jp": "897e081d",
   "kr": "나도 말이야, 크면"
  },
  "72": {
   "jp": "a13e983d",
   "kr": "대마법사가 되고 싶어."
  },
  "73": {
   "jp": "dfef3654",
   "kr": "쥬리오랑 크리스가 떠나면 쓸쓸해지겠다."
  },
  "74": {
   "jp": "8f95cf9e",
   "kr": "마을 제일가는 장난꾸러기 콤비니까."
  },
  "75": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "76": {
   "jp": "75e7fd68",
   "kr": "그거 칭찬이야!?"
  },
  "77": {
   "jp": "42932eeb",
   "kr": "돌아오면"
  },
  "78": {
   "jp": "cffeb100",
   "kr": "여행 이야기를 잔뜩 들려줘."
  }
 }
}