{
 "archive": "/SCE1/SC101.DAT",
 "member": "..\\DATA\\MT2200.BIN",
 "lines": {
  "0": {
   "jp": "e7041a3b",
   "kr": "테그라"
  },
  "1": {
   "jp": "a82af9b4",
   "kr": "샤리네"
  },
  "2": {
   "jp": "52e856ac",
   "kr": "파스테"
  },
  "3": {
   "jp": "e70ce810",
   "kr": "호프카"
  },
  "4": {
   "jp": "8ae2d354",
   "kr": "테그라 현자"
  },
  "5": {
   "jp": "79248025",
   "kr": "이런이런, 혹시"
  },
  "6": {
   "jp": "c1ce8bf3",
   "kr": "꼭 다 보고 나면 이야기를 들려주게나."
  },
  "7": {
   "jp": "99134119",
   "kr": "조심해서 여행을 계속하게."
  },
  "8": {
   "jp": "7b38d48c",
   "kr": "자네도 순례인가?"
  },
  "9": {
   "jp": "cc7c9551",
   "kr": "네, 저희는 라그픽 마을에서 왔어요."
  },
  "10": {
   "jp": "67db2a07",
   "kr": "오오, 그거 반갑구먼."
  },
  "11": {
   "jp": "26929752",
   "kr": "벌써 마법의 거울은 보았는가?"
  },
  "12": {
   "jp": "95290d86",
   "kr": "아뇨. 이제부터예요."
  },
  "13": {
   "jp": "f89832a0",
   "kr": "그런가 그런가."
  },
  "14": {
   "jp": "39f6db74",
   "kr": "그거 기대되겠구먼."
  },
  "15": {
   "jp": "c1ce8bf3",
   "kr": "꼭 다 보고 나면 이야기를 들려주게나."
  },
  "16": {
   "jp": "bcb5aa98",
   "kr": "갑자기 가루가가 나타나서"
  },
  "17": {
   "jp": "bb48dc8f",
   "kr": "현자님도 퍽 충격이셨던 모양이야."
  },
  "18": {
   "jp": "0428f5fa",
   "kr": "안쪽으로 가신 채 돌아오시질 않아."
  },
  "19": {
   "jp": "4b4727b8",
   "kr": "현자님의 말씀을 듣는 게"
  },
  "20": {
   "jp": "ec69d8cf",
   "kr": "무엇보다 낙이었는데"
  },
  "21": {
   "jp": "aed53305",
   "kr": "어서 돌아와 주시지 않으려나."
  },
  "22": {
   "jp": "f3137700",
   "kr": "어땠나, 현자님 모습은?"
  },
  "23": {
   "jp": "03d40cef",
   "kr": "샤리네가 이리 부서져 버려서"
  },
  "24": {
   "jp": "478133bb",
   "kr": "낙담하고 계셨겠지."
  },
  "25": {
   "jp": "63dfc670",
   "kr": "아무리 현자님이라도 인간일세."
  },
  "26": {
   "jp": "e962a8f9",
   "kr": "가엾게도."
  },
  "27": {
   "jp": "2750057b",
   "kr": "아, 순례자세요?"
  },
  "28": {
   "jp": "3ffa3663",
   "kr": "죄송합니다만"
  },
  "29": {
   "jp": "c0d8b839",
   "kr": "좀 정리하고 싶어서 휴게소 쪽에서"
  },
  "30": {
   "jp": "d1132d92",
   "kr": "책이라도 읽고 계시겠습니까?"
  },
  "31": {
   "jp": "46d99b97",
   "kr": "아, 순례자시군요."
  },
  "32": {
   "jp": "18ad0235",
   "kr": "오래 기다리셨죠."
  },
  "33": {
   "jp": "4a288367",
   "kr": "가루가 탓에 이 샤리네도"
  },
  "34": {
   "jp": "2ef3d66f",
   "kr": "거의 부서져 버렸습니다만"
  },
  "35": {
   "jp": "a6101650",
   "kr": "마법의 거울만은 어떻게든 무사했습니다."
  },
  "36": {
   "jp": "3f12935c",
   "kr": "저희가 마법의 거울을 보는 건"
  },
  "37": {
   "jp": "e261aa42",
   "kr": "이걸로 두 번째예요. 저희 마을에서는"
  },
  "38": {
   "jp": "9d62a40e",
   "kr": "성인식 때 샤리네 순례를 해요."
  },
  "39": {
   "jp": "c5d5ec2b",
   "kr": "네. 라그픽 마을의 성인식은"
  },
  "40": {
   "jp": "f6688c24",
   "kr": "샤리네에선 유명합니다."
  },
  "41": {
   "jp": "9d5f4b09",
   "kr": "우와, 그래요?"
  },
  "42": {
   "jp": "ec966f75",
   "kr": "어쩐지 그런 말 들으니"
  },
  "43": {
   "jp": "b7895268",
   "kr": "기쁜데요."
  },
  "44": {
   "jp": "263bff28",
   "kr": "마법의 거울은 아주 먼 옛날부터 있었지만"
  },
  "45": {
   "jp": "5f6cb390",
   "kr": "지금처럼 일반 분들이 순례 장소로 삼게"
  },
  "46": {
   "jp": "109566ad",
   "kr": "된 건 20년쯤 전부터입니다."
  },
  "47": {
   "jp": "165621a7",
   "kr": "그전까지는 여러분처럼"
  },
  "48": {
   "jp": "e96a5c65",
   "kr": "아주 드물게 성인식을 치르는 분이 오시거나"
  },
  "49": {
   "jp": "f39b7c25",
   "kr": "마녀의 순례 정도밖에 없었던 모양입니다."
  },
  "50": {
   "jp": "874a2f3c",
   "kr": "마녀 순례요?"
  },
  "51": {
   "jp": "1f866234",
   "kr": "마녀들도 순례를 했어요?"
  },
  "52": {
   "jp": "25395f23",
   "kr": "네, 저도 잘은 모릅니다만"
  },
  "53": {
   "jp": "8a9484f2",
   "kr": "마녀와 티라스일에 남은 다섯 마법의 거울은"
  },
  "54": {
   "jp": "2a9e0b61",
   "kr": "깊은 인연이 있는 듯합니다."
  },
  "55": {
   "jp": "cea2bd0b",
   "kr": "마법의 거울은 어쩌면"
  },
  "56": {
   "jp": "22e424fb",
   "kr": "본디 마녀들의 것이었는지도"
  },
  "57": {
   "jp": "3220ba45",
   "kr": "모르겠습니다."
  },
  "58": {
   "jp": "a4fbfd3e",
   "kr": "자, 어서."
  },
  "59": {
   "jp": "da1b3814",
   "kr": "이 앞이 땅을 관장하는 테그라의"
  },
  "60": {
   "jp": "451d464b",
   "kr": "마법의 거울입니다."
  },
  "61": {
   "jp": "d7ea7e5c",
   "kr": "어떠셨습니까."
  },
  "62": {
   "jp": "56bc6bee",
   "kr": "저희는 디네 마법의 거울에서도"
  },
  "63": {
   "jp": "545b674c",
   "kr": "이 테그라에서도 역시…"
  },
  "64": {
   "jp": "50a3756d",
   "kr": "좋지 않은 광경밖에 보이지 않았어요."
  },
  "65": {
   "jp": "1de6292c",
   "kr": "설마… 앞으로 더"
  },
  "66": {
   "jp": "3b8bd79d",
   "kr": "안 좋은 일이 일어나는 건…"
  },
  "67": {
   "jp": "45098ef8",
   "kr": "난… 어쩐지 걱정돼…"
  },
  "68": {
   "jp": "fd9e8179",
   "kr": "마법의 거울 영상은 보는 이의 마음 상태나"
  },
  "69": {
   "jp": "09665475",
   "kr": "앞으로 겪게 될 미래 등"
  },
  "70": {
   "jp": "07906686",
   "kr": "여러 영향을 받아 엮이는 것입니다."
  },
  "71": {
   "jp": "a65fdf35",
   "kr": "마법의 거울에서 본 것이"
  },
  "72": {
   "jp": "feda161b",
   "kr": "반드시 현실이 된다는 법은 없습니다."
  },
  "73": {
   "jp": "715e7d77",
   "kr": "너무 마음에 두지 마십시오."
  },
  "74": {
   "jp": "31efd3bf",
   "kr": "여러분은 성인식 순례에"
  },
  "75": {
   "jp": "87c83f11",
   "kr": "전념하시면 됩니다. 순례도 의문도"
  },
  "76": {
   "jp": "6b266b09",
   "kr": "올도스에서 풀릴 것입니다."
  },
  "77": {
   "jp": "83e088eb",
   "kr": "모든 답은 올도스에 있습니다."
  },
  "78": {
   "jp": "d262a386",
   "kr": "그 전에 여러분은 남은 두 곳의"
  },
  "79": {
   "jp": "0acd6a5f",
   "kr": "샤리네를 찾아가야 합니다."
  },
  "80": {
   "jp": "f1500b4d",
   "kr": "다음은 앰비쉬에 있는 불의 샤리네,"
  },
  "81": {
   "jp": "4917c4e3",
   "kr": "이그니스로 가십시오. 안데라성의"
  },
  "82": {
   "jp": "017cff77",
   "kr": "동쪽 『큰 뱀의 혀』라\n불리는 곳에 있습니다."
  },
  "83": {
   "jp": "5810b6ce",
   "kr": "자, 저도 복구를 도와야겠군요…"
  },
  "84": {
   "jp": "26eda62e",
   "kr": "언제까지 슬퍼하고만 있을 수도"
  },
  "85": {
   "jp": "7c99e9d2",
   "kr": "없으니까요."
  },
  "86": {
   "jp": "45673e25",
   "kr": "여러분의 여행이"
  },
  "87": {
   "jp": "aafa1652",
   "kr": "결실 많은 여행이 되기를"
  },
  "88": {
   "jp": "1059fa49",
   "kr": "빌겠습니다."
  },
  "89": {
   "jp": "f99453e3",
   "kr": "그러고 보니 허크 아저씨도"
  },
  "90": {
   "jp": "660c1182",
   "kr": "마녀와 샤리네가 관계있다고"
  },
  "91": {
   "jp": "a9a8b6cf",
   "kr": "말했었지."
  },
  "92": {
   "jp": "7bda48ce",
   "kr": "삼촌의 마녀 연구도 아주 엉터리는"
  },
  "93": {
   "jp": "68031195",
   "kr": "아니란 얘기네."
  },
  "94": {
   "jp": "a28daad7",
   "kr": "자, 쥬리오. 됐으니까 얼른"
  },
  "95": {
   "jp": "372ffea1",
   "kr": "은단검을 놓아 줘."
  },
  "96": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "97": {
   "jp": "df6f17a6",
   "kr": "방금 그거… 가루가지?"
  },
  "98": {
   "jp": "6277634f",
   "kr": "으, 응…"
  },
  "99": {
   "jp": "53f12ae3",
   "kr": "우린 어째서 이렇게"
  },
  "100": {
   "jp": "6c806b3d",
   "kr": "으스스한 광경만 보는 걸까?"
  },
  "101": {
   "jp": "60b21e76",
   "kr": "마을 사람들은 멋진 경치를 봤다고"
  },
  "102": {
   "jp": "4a6117a6",
   "kr": "말했었는데… 그건 그렇고"
  },
  "103": {
   "jp": "f5608b5d",
   "kr": "방금 그 붉은 빛은 뭐였을까…?"
  },
  "104": {
   "jp": "b10748f9",
   "kr": "붉은 빛…"
  },
  "105": {
   "jp": "30425d77",
   "kr": "그러고 보니 보이긴 했는데 모르겠어."
  },
  "106": {
   "jp": "f0fbfee6",
   "kr": "나 어쩐지 우울해져."
  },
  "107": {
   "jp": "910e58d1",
   "kr": "쥬리오, 이제 어떡할래?"
  },
  "108": {
   "jp": "a25d406c",
   "kr": "나 이대로 이그니스 샤리네로"
  },
  "109": {
   "jp": "d2043154",
   "kr": "선뜻 못 가겠어."
  },
  "110": {
   "jp": "22253d5c",
   "kr": "그래 할아버지께 여쭤보자."
  },
  "111": {
   "jp": "e7276218",
   "kr": "어땠는가, 마법의 거울은?"
  },
  "112": {
   "jp": "cfc62931",
   "kr": "으〜음. 그게…"
  },
  "113": {
   "jp": "215167bd",
   "kr": "쥬리오 일행은"
  },
  "114": {
   "jp": "b15c3d67",
   "kr": "마법의 거울로 본 것을 말했다."
  },
  "115": {
   "jp": "2af0c987",
   "kr": "음."
  },
  "116": {
   "jp": "b3cb2b58",
   "kr": "마음 다잡고 여행을 계속하게."
  },
  "117": {
   "jp": "3d625ec9",
   "kr": "난 이 땅에 남아"
  },
  "118": {
   "jp": "e96e978d",
   "kr": "테그라 사람들을 도울 일을"
  },
  "119": {
   "jp": "7a96b7fe",
   "kr": "하려고 하네."
  },
  "120": {
   "jp": "7be73fb7",
   "kr": "늙었다 해도"
  },
  "121": {
   "jp": "39661679",
   "kr": "아직 여행할 만한 체력은 있네."
  },
  "122": {
   "jp": "e4c6d525",
   "kr": "나도 아직 쓸모가 있다네."
  },
  "123": {
   "jp": "a88e2515",
   "kr": "우리도 테그라 사람들을 위해"
  },
  "124": {
   "jp": "0e3d9b24",
   "kr": "뭔가 해 줄 수 있는 일이"
  },
  "125": {
   "jp": "dd7e48df",
   "kr": "있으면 좋겠는데."
  },
  "126": {
   "jp": "a475edf7",
   "kr": "그래도 토바이 씨가 항구에서"
  },
  "127": {
   "jp": "cb4f1c7b",
   "kr": "기다리고 있잖아."
  },
  "128": {
   "jp": "5c20d679",
   "kr": "시간을 많이 쓸 수는 없어."
  },
  "129": {
   "jp": "757d06c9",
   "kr": "아무튼 테그라 마을로 돌아가자."
  },
  "130": {
   "jp": "c9aa39b0",
   "kr": "뭔가 우리도"
  },
  "131": {
   "jp": "dd17f254",
   "kr": "할 수 있는 일이 있을지 몰라."
  },
  "132": {
   "jp": "18348189",
   "kr": "그래, 그러자."
  },
  "133": {
   "jp": "d2adeedf",
   "kr": "책등에 《해적왕 라몬의 숨긴 보물》이라고"
  },
  "134": {
   "jp": "738306f4",
   "kr": "적힌 책이 있다."
  },
  "135": {
   "jp": "2b32dbf8",
   "kr": "쥬리오는 손에 들고 책을 펼쳐 보았다."
  },
  "136": {
   "jp": "1e2871e6",
   "kr": "《해적왕 라몬의 숨긴 보물》을"
  },
  "137": {
   "jp": "3813a477",
   "kr": "한때 일곱 바다를 휩쓴 해적왕 라몬과"
  },
  "138": {
   "jp": "5d84ff31",
   "kr": "선단은 용감한 캡틴 토마스의 손에"
  },
  "139": {
   "jp": "e18afe45",
   "kr": "에메랄드해로 가라앉았다. 그러나"
  },
  "140": {
   "jp": "444ca704",
   "kr": "라몬이 그때까지 모은 수많은 보물은 끝내"
  },
  "141": {
   "jp": "4f474911",
   "kr": "발견되지 않았다. 조심성 많은 라몬은"
  },
  "142": {
   "jp": "199de04e",
   "kr": "각지에서 빼앗은 보물을 모두 어딘가에"
  },
  "143": {
   "jp": "62e31d58",
   "kr": "숨겼고 단서 하나 없었다."
  },
  "144": {
   "jp": "a890b99b",
   "kr": "수억 Pia라고 소문난 보물은 아직 발견되지"
  },
  "145": {
   "jp": "fa5b3126",
   "kr": "않은 채 그것을 좇는 자들을 끊임없이"
  },
  "146": {
   "jp": "cad66c4c",
   "kr": "홀린다."
  },
  "147": {
   "jp": "2b7e9368",
   "kr": "굉장한데〜"
  },
  "148": {
   "jp": "e54f67cc",
   "kr": "여보게, 젊은이."
  }
 }
}
