{
 "archive": "/SCE8/SC807.DAT",
 "member": "..\\DATA\\RC0001.BIN",
 "lines": {
  "0": {
   "jp": "f80fe789",
   "kr": "루드"
  },
  "1": {
   "jp": "f3b21c53",
   "kr": "성 아랫마을"
  },
  "2": {
   "jp": "bc2e9549",
   "kr": "루돌프 왕"
  },
  "3": {
   "jp": "a48493c1",
   "kr": "이렇게 많은 사람이 배웅해 주니"
  },
  "4": {
   "jp": "e9993557",
   "kr": "왠지 쑥스럽네."
  },
  "5": {
   "jp": "a7932b75",
   "kr": "그래도 기분 좋은걸."
  },
  "6": {
   "jp": "00e39a36",
   "kr": "공주님이 된 것 같아."
  },
  "7": {
   "jp": "22299514",
   "kr": "부디 조심해서 가게."
  },
  "8": {
   "jp": "75afe81e",
   "kr": "루데라 관문까지 모셔다 드리게."
  },
  "9": {
   "jp": "ace6a219",
   "kr": "거기까지라면 마찻길도 있다네."
  },
  "10": {
   "jp": "30fffa15",
   "kr": "마부"
  },
  "11": {
   "jp": "916e88ee",
   "kr": "알겠습니다."
  },
  "12": {
   "jp": "929cc7cb",
   "kr": "쥬리오 군, 크리스 양."
  },
  "13": {
   "jp": "291fdf15",
   "kr": "정말 신세를 졌네."
  },
  "14": {
   "jp": "ddc32c38",
   "kr": "온 세상 사람들은"
  },
  "15": {
   "jp": "2fdd6fdd",
   "kr": "그대들이 이 세계를 위해 애써 준 것을"
  },
  "16": {
   "jp": "d5c5b28d",
   "kr": "결코 잊지 않을 걸세."
  },
  "17": {
   "jp": "3399cdd7",
   "kr": "이봐, 쥬리오."
  },
  "18": {
   "jp": "6cdb5a22",
   "kr": "저것 좀 봐."
  },
  "19": {
   "jp": "e9516b2c",
   "kr": "그건 그렇고 이거."
  },
  "20": {
   "jp": "494ee3dd",
   "kr": "엄청 큰 개로군."
  },
  "21": {
   "jp": "8320d610",
   "kr": "말이야."
  },
  "22": {
   "jp": "75d66a5e",
   "kr": "마차를 개가 끌 리가 없잖아."
  },
  "23": {
   "jp": "8c7476fd",
   "kr": "하하하하, 농담이야."
  },
  "24": {
   "jp": "64a95167",
   "kr": "드디어 쥬리오도"
  },
  "25": {
   "jp": "35ba0e0b",
   "kr": "개와 말을 구별할 수 있게"
  },
  "26": {
   "jp": "6357cf8b",
   "kr": "된 모양이군."
  },
  "27": {
   "jp": "e1eaffd8",
   "kr": "그래도 곰과 개는 아직 구별 못 하는구나."
  },
  "28": {
   "jp": "fe5846bd",
   "kr": "……참."
  },
  "29": {
   "jp": "02e64793",
   "kr": "하하하하…"
  },
  "30": {
   "jp": "64a16347",
   "kr": "앗, 듀르젤 씨가 웃었어."
  },
  "31": {
   "jp": "412c1574",
   "kr": "나도 웃을 때가 있다."
  },
  "32": {
   "jp": "f1faa2dc",
   "kr": "쥬리오, 크리스."
  },
  "33": {
   "jp": "5c58bfe9",
   "kr": "난 말주변이 없어서"
  },
  "34": {
   "jp": "1c6f34e8",
   "kr": "너희에게 고맙다 하고 싶어도"
  },
  "35": {
   "jp": "8723eedf",
   "kr": "말이 잘 안 나온다."
  },
  "36": {
   "jp": "65c72012",
   "kr": "편지를 써 봤다. 나중에 읽어 다오."
  },
  "37": {
   "jp": "c50fc139",
   "kr": "쥬리오 일행은 듀르젤의 편지를 받았다."
  },
  "38": {
   "jp": "dd890a57",
   "kr": "잘 지내라."
  },
  "39": {
   "jp": "d9bb3462",
   "kr": "두 분이 순례 여행을 하지 않으셨더라면"
  },
  "40": {
   "jp": "a96c439e",
   "kr": "하얀마녀의 예언도"
  },
  "41": {
   "jp": "70435292",
   "kr": "물거품이 되었을지 모릅니다."
  },
  "42": {
   "jp": "758f7667",
   "kr": "두 분이 계셔서 정말 다행이에요."
  },
  "43": {
   "jp": "06f31c81",
   "kr": "앰비쉬에도 놀러 와 주게."
  },
  "44": {
   "jp": "7cde8251",
   "kr": "진수성찬 차려 놓고 기다리고 있겠네."
  },
  "45": {
   "jp": "c49f4f82",
   "kr": "진수성찬…"
  },
  "46": {
   "jp": "ab2ab9bd",
   "kr": "응, 갈게."
  },
  "47": {
   "jp": "5182f6d0",
   "kr": "쥬리오 님, 크리스 님"
  },
  "48": {
   "jp": "ba92ae49",
   "kr": "건강하십시오."
  },
  "49": {
   "jp": "d98fed32",
   "kr": "또 뵙겠습니다."
  },
  "50": {
   "jp": "8b26e446",
   "kr": "모리슨 씨도 잘 지내세요."
  },
  "51": {
   "jp": "cd611896",
   "kr": "마기사 씨께도 안부 전해요."
  },
  "52": {
   "jp": "8f9e816c",
   "kr": "네, 전해 두겠습니다."
  },
  "53": {
   "jp": "5c0e3e3d",
   "kr": "마기사도 기뻐하겠지요."
  },
  "54": {
   "jp": "7179fecb",
   "kr": "자, 이걸로 또"
  },
  "55": {
   "jp": "726f5362",
   "kr": "격투가 챔피언을 노릴 수 있겠어."
  },
  "56": {
   "jp": "f56c2d74",
   "kr": "역시 무기 들고 싸우는 건"
  },
  "57": {
   "jp": "b1217900",
   "kr": "영 아니지, 아저씨."
  },
  "58": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "59": {
   "jp": "1797e391",
   "kr": "허크 아저씨가 없잖아."
  },
  "60": {
   "jp": "7197eec1",
   "kr": "아, 응."
  },
  "61": {
   "jp": "5b1956d0",
   "kr": "아저씨라면 볼일이 생겼다며"
  },
  "62": {
   "jp": "d63b571e",
   "kr": "한발 먼저 가 버렸어."
  },
  "63": {
   "jp": "a4068597",
   "kr": "뭐야, 그런 거야?"
  },
  "64": {
   "jp": "439a9bc9",
   "kr": "늘 바쁜 사람이네."
  },
  "65": {
   "jp": "e6c2995b",
   "kr": "그러고 보니 구스 일행도 안 왔군."
  },
  "66": {
   "jp": "06cf3eb8",
   "kr": "그들도 크게 활약했으니"
  },
  "67": {
   "jp": "af0e064e",
   "kr": "우리 앰비쉬에서 특별히 상금이라도"
  },
  "68": {
   "jp": "9152e467",
   "kr": "내릴까 했네만…"
  },
  "69": {
   "jp": "389b6e5e",
   "kr": "분명 지금쯤 재채기하고 있을걸요."
  },
  "70": {
   "jp": "ed0ac1bc",
   "kr": "나중에 알면"
  },
  "71": {
   "jp": "e552ca2d",
   "kr": "엄청 분해할 거야."
  },
  "72": {
   "jp": "87240e6c",
   "kr": "쥬리오 군, 크리스 양."
  },
  "73": {
   "jp": "64062c35",
   "kr": "라우알의 파도는 그렇다 치고"
  },
  "74": {
   "jp": "128e7699",
   "kr": "둘을 만나서 참 좋았어요."
  },
  "75": {
   "jp": "c3ddb984",
   "kr": "앞으로도"
  },
  "76": {
   "jp": "b6da2b26",
   "kr": "이 경험을 살려서"
  },
  "77": {
   "jp": "3b363921",
   "kr": "서로 힘내요."
  },
  "78": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "79": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "80": {
   "jp": "c7758afc",
   "kr": "힘낼게요."
  },
  "81": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "82": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "83": {
   "jp": "eee01ace",
   "kr": "잘 해냈군."
  },
  "84": {
   "jp": "09052928",
   "kr": "너희가 애쓰는 모습엔 늘 감탄했다."
  },
  "85": {
   "jp": "46ed9a13",
   "kr": "로디, 와 줘서 고마워."
  },
  "86": {
   "jp": "98b41bc0",
   "kr": "정말 고맙네."
  },
  "87": {
   "jp": "1c552e59",
   "kr": "알프나 모리슨 씨도 그랬지만"
  },
  "88": {
   "jp": "6eac8c83",
   "kr": "우리를 뒤쫓아 와 준 게"
  },
  "89": {
   "jp": "e7ab9650",
   "kr": "엄청 기뻤어."
  },
  "90": {
   "jp": "1d5df30e",
   "kr": "뭘, 우연이었지만"
  },
  "91": {
   "jp": "bff50de4",
   "kr": "가루가를 조종하던 놈도 해치웠고."
  },
  "92": {
   "jp": "a88fe1ff",
   "kr": "원한은 버렸지만"
  },
  "93": {
   "jp": "6ebe5a7d",
   "kr": "결과적으로 복수가 된 셈이니까."
  },
  "94": {
   "jp": "c97e3fbc",
   "kr": "원래 내가 할 일이기도 했지."
  },
  "95": {
   "jp": "ece8fb10",
   "kr": "로디, 이제부터 어떻게 할 거야?"
  },
  "96": {
   "jp": "02d9d3d0",
   "kr": "더 수행을 쌓기 위해서"
  },
  "97": {
   "jp": "44139738",
   "kr": "또 여행을 떠날 거야."
  },
  "98": {
   "jp": "fabaca53",
   "kr": "그전에"
  },
  "99": {
   "jp": "584fccd4",
   "kr": "듀르젤 공께 검사의 마음가짐을"
  },
  "100": {
   "jp": "6676b070",
   "kr": "배우려고."
  },
  "101": {
   "jp": "a6b9c3bb",
   "kr": "듀르젤은 로디의 시선을 받고"
  },
  "102": {
   "jp": "bfcdad80",
   "kr": "씩 웃어 보였다."
  },
  "103": {
   "jp": "064beafe",
   "kr": "그러니까"
  },
  "104": {
   "jp": "e9365e3e",
   "kr": "듀르젤 씨한테"
  },
  "105": {
   "jp": "dd72b87c",
   "kr": "스승이 되어 달라는 거야?"
  },
  "106": {
   "jp": "62febce5",
   "kr": "그래, 한 수 배울 생각이야."
  },
  "107": {
   "jp": "1070ab02",
   "kr": "그럼 쥬리오의 스승이 로디고"
  },
  "108": {
   "jp": "5796d836",
   "kr": "로디의 스승이"
  },
  "109": {
   "jp": "b8565594",
   "kr": "듀르젤 씨란 거네."
  },
  "110": {
   "jp": "0825e727",
   "kr": "아, 그렇네."
  },
  "111": {
   "jp": "862f1b17",
   "kr": "그런 셈이지."
  },
  "112": {
   "jp": "e2c23c65",
   "kr": "힘내, 로디."
  },
  "113": {
   "jp": "a373df38",
   "kr": "그래, 나도 힘낼 테니"
  },
  "114": {
   "jp": "0f57656a",
   "kr": "너희도"
  },
  "115": {
   "jp": "9a03cd7d",
   "kr": "더욱더 힘내라."
  },
  "116": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "117": {
   "jp": "17c70875",
   "kr": "자, 아쉽지만"
  },
  "118": {
   "jp": "24aaa490",
   "kr": "슬슬 출발하는 게 좋겠네."
  },
  "119": {
   "jp": "a0fa76bd",
   "kr": "이대로라면"
  },
  "120": {
   "jp": "cfd9def5",
   "kr": "밤새 작별 인사를 해도"
  },
  "121": {
   "jp": "513d4874",
   "kr": "끝날 것 같지 않으니 말일세."
  },
  "122": {
   "jp": "8b7b17c4",
   "kr": "괜찮겠나?"
  },
  "123": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "124": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "125": {
   "jp": "efb482d0",
   "kr": "좋아."
  },
  "126": {
   "jp": "916ff6bc",
   "kr": "출발하게."
  },
  "127": {
   "jp": "30fffa15",
   "kr": "마부"
  },
  "128": {
   "jp": "dda15ce3",
   "kr": "이랴〜"
  },
  "129": {
   "jp": "8606c819",
   "kr": "조심해서 돌아가게."
  },
  "130": {
   "jp": "f1f6d9b7",
   "kr": "…또 만나자."
  },
  "131": {
   "jp": "445876cd",
   "kr": "잘 지내요!"
  },
  "132": {
   "jp": "e3490d48",
   "kr": "앰비쉬에도 놀러 오렴."
  },
  "133": {
   "jp": "dd391c6d",
   "kr": "기다리고 있겠습니다."
  },
  "134": {
   "jp": "94a9f156",
   "kr": "안녕〜!"
  },
  "135": {
   "jp": "310ca3c6",
   "kr": "언젠가 또 만나자."
  },
  "136": {
   "jp": "a3bf1d89",
   "kr": "잘 가요, 또 만나요!"
  },
  "137": {
   "jp": "1c0bb4de",
   "kr": "잘 있어요!"
  },
  "138": {
   "jp": "c579ff16",
   "kr": "바이, 바〜이!"
  },
  "139": {
   "jp": "e6d943e4",
   "kr": "다들〜!"
  },
  "140": {
   "jp": "747b027a",
   "kr": "잘 지내〜!"
  },
  "141": {
   "jp": "12e255a2",
   "kr": "잘 있어요〜!"
  },
  "142": {
   "jp": "48bcd1d9",
   "kr": "또 봐〜!"
  },
  "143": {
   "jp": "5405846c",
   "kr": "멋진 동료들 배웅 속에 쥬리오와 크리스는"
  },
  "144": {
   "jp": "b42db18c",
   "kr": "라그픽 마을로 귀로에 올랐다."
  },
  "145": {
   "jp": "5071253b",
   "kr": "이별은 슬펐지만 두 사람의 가슴은 순례를"
  },
  "146": {
   "jp": "84d9c3e2",
   "kr": "무사히 마치고 돌아갈 기쁨으로 가득했다."
  }
 }
