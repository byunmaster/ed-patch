 "lines": {
  "0": {
   "jp": "30f19984",
   "kr": "치타"
  },
  "1": {
   "jp": "dcb705e7",
   "kr": "포고리 촌장"
  },
  "2": {
   "jp": "c5fd6cff",
   "kr": "칸나 부인"
  },
  "3": {
   "jp": "81bc17fa",
   "kr": "에그"
  },
  "4": {
   "jp": "85f50ece",
   "kr": "징가"
  },
  "5": {
   "jp": "5d1bc91c",
   "kr": "유우미"
  },
  "6": {
   "jp": "ecc25ab7",
   "kr": "그레드"
  },
  "7": {
   "jp": "3d83521d",
   "kr": "파블"
  },
  "8": {
   "jp": "b0fb4752",
   "kr": "모즈크"
  },
  "9": {
   "jp": "01aef725",
   "kr": "고로가"
  },
  "10": {
   "jp": "dfffffdd",
   "kr": "드림"
  },
  "11": {
   "jp": "cc2e2744",
   "kr": "히바나"
  },
  "12": {
   "jp": "67962396",
   "kr": "토비"
  },
  "13": {
   "jp": "0c6c7252",
   "kr": "이야아, 어서 오시게."
  },
  "14": {
   "jp": "ad92dc5d",
   "kr": "나는 치타 촌장 포고리일세."
  },
  "15": {
   "jp": "6b7582a5",
   "kr": "자네들도 넬바에서 왔는가?"
  },
  "16": {
   "jp": "a95a4475",
   "kr": "저희는 순례 여행을 하고 있어요."
  },
  "17": {
   "jp": "55fdde35",
   "kr": "그것 참 고생이 많구먼."
  },
  "18": {
   "jp": "fcd8742f",
   "kr": "아니 글쎄, 유난히 손님이 많다 했더니"
  },
  "19": {
   "jp": "96d23c1d",
   "kr": "수도 넬바가"
  },
  "20": {
   "jp": "c546c516",
   "kr": "해수 가루가한테 습격당했다는군."
  },
  "21": {
   "jp": "3ea7f7c9",
   "kr": "이거 큰일이야. 메나트의 대위기라고."
  },
  "22": {
   "jp": "58fcf86f",
   "kr": "저, 촌장님."
  },
  "23": {
   "jp": "13481ac0",
   "kr": "전혀 큰일이라고 생각하시는 것"
  },
  "24": {
   "jp": "6e290599",
   "kr": "처럼 안 보이는데요…"
  },
  "25": {
   "jp": "1da90d2e",
   "kr": "아이고, 역시 들키는구먼."
  },
  "26": {
   "jp": "c98bca3f",
   "kr": "치타는 역참 마을이니까 말일세."
  },
  "27": {
   "jp": "7c6bb4b0",
   "kr": "손님이 늘면 벌이가 되거든."
  },
  "28": {
   "jp": "422726a3",
   "kr": "우와, 큰돈 벌겠네요."
  },
  "29": {
   "jp": "8b3d7617",
   "kr": "그래 그래."
  },
  "30": {
   "jp": "e56e0bfe",
   "kr": "무슨 말씀이세요…"
  },
  "31": {
   "jp": "3a7ddf7f",
   "kr": "가루가한테 집이 부서진 사람 마음도"
  },
  "32": {
   "jp": "c94941a2",
   "kr": "생각해 주세요."
  },
  "33": {
   "jp": "f6e6c513",
   "kr": "그래요."
  },
  "34": {
   "jp": "9334e5f3",
   "kr": "아가씨 말이 맞아요."
  },
  "35": {
   "jp": "29246b97",
   "kr": "아니… 그… 미안하네."
  },
  "36": {
   "jp": "6b41b2ae",
   "kr": "당신도 촌장이면 돈벌이도 좋지만"
  },
  "37": {
   "jp": "b7614c54",
   "kr": "넬바에서 피난 온 사람들을 위해"
  },
  "38": {
   "jp": "6bf1ed18",
   "kr": "뭐라도 해 주자는 마음은 없는 거예요?"
  },
  "39": {
   "jp": "2f48bd82",
   "kr": "하아, 지당하십니다."
  },
  "40": {
   "jp": "d6146909",
   "kr": "그럼 어쩔 건데요?"
  },
  "41": {
   "jp": "362af6d7",
   "kr": "뒤쪽 공터를 피난민들에게 개방하자."
  },
  "42": {
   "jp": "96e47c1a",
   "kr": "그리고 밤이슬을 피하도록"
  },
  "43": {
   "jp": "03ac1b31",
   "kr": "마을 사람들에게 알려 보지."
  },
  "44": {
   "jp": "bec516ed",
   "kr": "여관 반값에 묵게 하는 걸세."
  },
  "45": {
   "jp": "40ad3deb",
   "kr": "역시 돈은 받는군요."
  },
  "46": {
   "jp": "ec102602",
   "kr": "당연하지."
  },
  "47": {
   "jp": "fdcfcfc0",
   "kr": "정말이지, 우리 남편은"
  },
  "48": {
   "jp": "caf89b17",
   "kr": "촌장 주제에 장삿속이 밝아서."
  },
  "49": {
   "jp": "e7d4cf14",
   "kr": "딱한 노릇이야."
  },
  "50": {
   "jp": "1125f137",
   "kr": "본바탕은 좋은 사람인데."
  },
  "51": {
   "jp": "1cdad6fd",
   "kr": "조금 더, 세상을 위해, 남을 위해"
  },
  "52": {
   "jp": "98c6ce17",
   "kr": "봉사해도 좋으련만."
  },
  "53": {
   "jp": "df1ae80f",
   "kr": "걱정 안 해도 돼."
  },
  "54": {
   "jp": "77b8e1ea",
   "kr": "너희는 공짜로 우리 집에"
  },
  "55": {
   "jp": "480d272a",
   "kr": "재워 줄 테니까."
  },
  "56": {
   "jp": "5b8d7982",
   "kr": "네?"
  },
  "57": {
   "jp": "94a8e6a0",
   "kr": "여기 들어오면 안 되는 거였어요?"
  },
  "58": {
   "jp": "85d5f372",
   "kr": "뭐, 벌써 들어와 버렸지만."
  },
  "59": {
   "jp": "dd0c70cb",
   "kr": "그래도 큰일이었어요."
  },
  "60": {
   "jp": "63416a06",
   "kr": "가루가가 갑자기 덮쳐 왔거든요."
  },
  "61": {
   "jp": "1f134f65",
   "kr": "성은 아주 엉망진창이에요."
  },
  "62": {
   "jp": "14e3d2cf",
   "kr": "넬바라면 치타 너머에 있는"
  },
  "63": {
   "jp": "6a4e82e2",
   "kr": "메나트의 수도잖아요?"
  },
  "64": {
   "jp": "588da738",
   "kr": "다들 도망쳐 와도 괜찮은 거예요?"
  },
  "65": {
   "jp": "542ddd1c",
   "kr": "병사와 젊은이들이 있으니까요. 저희는 노인과"
  },
  "66": {
   "jp": "4fe8b34d",
   "kr": "아이들이 위험하지 않게 마을이 정리될 때까지"
  },
  "67": {
   "jp": "40cd241c",
   "kr": "다들 가까운 마을로 피난시키고 있어요."
  },
  "68": {
   "jp": "307acdc5",
   "kr": "그나저나 가루가가 덮쳐 오다니"
  },
  "69": {
   "jp": "515ac8e3",
   "kr": "정말 놀랐어요."
  },
  "70": {
   "jp": "10a2b07f",
   "kr": "여긴 좀 춥다만 지내기는 좋구먼."
  },
  "71": {
   "jp": "9cf1e8b0",
   "kr": "제법 별장 기분일세."
  },
  "72": {
   "jp": "6a3c116d",
   "kr": "후옷, 후옷, 후옷…"
  },
  "73": {
   "jp": "98401284",
   "kr": "가루가는 어디로 향한 겐가…"
  },
  "74": {
   "jp": "919f881d",
   "kr": "그대로 가면 바다를 건너 로프섬."
  },
  "75": {
   "jp": "63914911",
   "kr": "더 나아가면 앰비쉬의 볼트 부근인가."
  },
  "76": {
   "jp": "90e0f189",
   "kr": "이대로면 피해가 번지기만 할 걸세."
  },
  "77": {
   "jp": "272226f5",
   "kr": "누군가 손을 쓰지 않으면 안 되겠구먼…"
  },
  "78": {
   "jp": "e5118644",
   "kr": "넬바에서 걸어왔더니"
  },
  "79": {
   "jp": "834f42d7",
   "kr": "배가 고파졌어."
  },
  "80": {
   "jp": "09bbd582",
   "kr": "계란말이 하나 더 먹어 버릴까."
  },
  "81": {
   "jp": "f7cd2423",
   "kr": "아냐, 참자."
  },
  "82": {
   "jp": "8e6d4aca",
   "kr": "너무 먹으면 살찌니까."
  },
  "83": {
   "jp": "ee08f815",
   "kr": "그레드는 더 먹을래?"
  },
  "84": {
   "jp": "6381ba70",
   "kr": "냠냠냠…"
  },
  "85": {
   "jp": "045c745d",
   "kr": "어머, 그레드도 참…"
  },
  "86": {
   "jp": "46922774",
   "kr": "아직도 더 먹을 것 같네."
  },
  "87": {
   "jp": "d9bac8f8",
   "kr": "냠냠냠… 응."
  },
  "88": {
   "jp": "5a326b81",
   "kr": "여기 계란말이는"
  },
  "89": {
   "jp": "ab6dd52f",
   "kr": "끝내주게 맛있어."
  },
  "90": {
   "jp": "7db06268",
   "kr": "얼마든지 먹을 수 있어."
  },
  "91": {
   "jp": "6381ba70",
   "kr": "냠냠냠…"
  },
  "92": {
   "jp": "f165e524",
   "kr": "누나, 하나 더 줘."
  },
  "93": {
   "jp": "6381ba70",
   "kr": "냠냠냠…"
  },
  "94": {
   "jp": "66420829",
   "kr": "미안해."
  },
  "95": {
   "jp": "f9ff6c73",
   "kr": "오늘 계란말이는 다 팔려 버렸어."
  },
  "96": {
   "jp": "65ab03c2",
   "kr": "다음에 또 들러 줘."
  },
  "97": {
   "jp": "b311c748",
   "kr": "치타 명물, 따끈따끈한 계란말이."
  },
  "98": {
   "jp": "b3c60ebf",
   "kr": "갓 구웠다고. 오늘은 2개에 3 Pia다."
  },
  "99": {
   "jp": "d7ebed81",
   "kr": "어때, 먹고 가라고."
  },
  "100": {
   "jp": "612fb007",
   "kr": "자, 어서 와."
  },
  "101": {
   "jp": "c8aaaa44",
   "kr": "너희도 갓 구운 계란말이 어때?"
  },
  "102": {
   "jp": "5bee1718",
   "kr": "아주 맛있다고."
  },
  "103": {
   "jp": "9a4b8063",
   "kr": "오늘은 특별히 덤을 얹어서"
  },
  "104": {
   "jp": "9c029dac",
   "kr": "계란말이 2개에 3 Pia면 돼."
  },
  "105": {
   "jp": "48d10075",
   "kr": "맛있다고."
  },
  "106": {
   "jp": "fdf5b8a1",
   "kr": "옜다, 2개에 3 Pia."
  },
  "107": {
   "jp": "b13943ac",
   "kr": "뜨거우니까 조심해서 먹어."
  },
  "108": {
   "jp": "0ede3125",
   "kr": "쥬리오 일행은 따끈한 계란말이를"
  },
  "109": {
   "jp": "47514d4e",
   "kr": "하나씩 받아 들었다. 입에 넣자"
  },
  "110": {
   "jp": "0b33761c",
   "kr": "설탕의 달콤한 맛이 퍼졌다."
  },
  "111": {
   "jp": "a07fd9b0",
   "kr": "정말이네, 맛있어…"
  },
  "112": {
   "jp": "0ba1b641",
   "kr": "응, 엄청 맛있어."
  },
  "113": {
   "jp": "391238f4",
   "kr": "봐, 맛있지?"
  },
  "114": {
   "jp": "9a45ee71",
   "kr": "하나씩 더 어때?"
  },
  "115": {
   "jp": "cd8e599c",
   "kr": "이런, Pia가 모자라네."
  },
  "116": {
   "jp": "33a5e20e",
   "kr": "하긴. 아무리 맛있는 계란말이라도"
  },
  "117": {
   "jp": "e8750ed2",
   "kr": "너무 많이 먹으면 배탈이 나니까."
  },
  "118": {
   "jp": "3980b913",
   "kr": "또 먹고 싶어지면 들러 줘."
  },
  "119": {
   "jp": "a7a466af",
   "kr": "그래? 정말 맛있는데 말이야."
  },
  "120": {
   "jp": "66993c3c",
   "kr": "한 번 먹어 두면 분명 좋은 얘깃거리가"
  },
  "121": {
   "jp": "6efff22b",
   "kr": "될 거라고 생각하는데 말이야."
  },
  "122": {
   "jp": "a186f6c3",
   "kr": "느긋하게 쉬었다 가라고."
  },
  "123": {
   "jp": "c8b917bb",
   "kr": "수도 넬바가 가루가에게 습격당했다면서요."
  },
  "124": {
   "jp": "40399c9c",
   "kr": "설마, 가루가가 뭍에 올라오다니…"
  },
  "125": {
   "jp": "36c40575",
   "kr": "이런 일도 다 있네요."
  },
  "126": {
   "jp": "17a53576",
   "kr": "저희 네갈섬 쪽에서 왔는데요"
  },
  "127": {
   "jp": "3b576791",
   "kr": "테그라 마을도 가루가가 부쉈어요."
  },
  "128": {
   "jp": "875339cd",
   "kr": "어쩐지 가루가가 저희를 앞질러 가는 듯해요."
  },
  "129": {
   "jp": "c5e937fa",
   "kr": "어머, 테그라도 가루가에…"
  },
  "130": {
   "jp": "57c84de2",
   "kr": "가루가는 얌전한 동물이라고 들었는데"
  },
  "131": {
   "jp": "ccdb5bd0",
   "kr": "어째서 뭍에 올라와 마을을 부수게 되어"
  },
  "132": {
   "jp": "d5ca2e61",
   "kr": "버린 걸까요."
  },
  "133": {
   "jp": "8b81d1d3",
   "kr": "여어, 넬바에서 온 사람들과도"
  },
  "134": {
   "jp": "04423e62",
   "kr": "사이좋게 잘 지낼 것 같아."
  },
  "135": {
   "jp": "7d9471e4",
   "kr": "어라, 아저씨?"
  },
  "136": {
   "jp": "6697e286",
   "kr": "이 사람들 일행에 끼워 줬나 보네."
  },
  "137": {
   "jp": "aa7c7d09",
   "kr": "잘됐잖아."
  },
  "138": {
   "jp": "79a7f6d3",
   "kr": "함부로 부르지 말게"
  },
  "139": {
   "jp": "88a30a0f",
   "kr": "무례하네."
  },
  "140": {
   "jp": "f8012e18",
   "kr": "뭐야. 이상한 사람이네."
  },
  "141": {
   "jp": "7f9630d7",
   "kr": "뭐, 아저씨."
  },
  "142": {
   "jp": "357916fb",
   "kr": "여행은 길동무라고 하잖아."
  },
  "143": {
   "jp": "28f3dd55",
   "kr": "아무튼 잘됐네."
  },
  "144": {
   "jp": "09037a99",
   "kr": "넬바에서 피난 온 사람들 덕에"
  },
  "145": {
   "jp": "a29cb474",
   "kr": "북적북적해졌지만 이 이상 늘어나면"
  },
  "146": {
   "jp": "70412a13",
   "kr": "마을이 터져 버릴지도 몰라."
  },
  "147": {
   "jp": "f4e337d7",
   "kr": "차라리 마을을 넓혀서"
  },
  "148": {
   "jp": "7906fad4",
   "kr": "집을 더 지어 버리면 되려나."
  },
  "149": {
   "jp": "de3cade3",
   "kr": "그래 맞아."
  },
  "150": {
   "jp": "d5fc853a",
   "kr": "그러면 뭔가 장사를 시작해도"
  },
  "151": {
   "jp": "d3176ee2",
   "kr": "손님이 많으니 분명 벌이가 되겠지."
  },
  "152": {
   "jp": "2100ba9e",
   "kr": "역시 그거라니까."
  },
  "153": {
   "jp": "02d2724c",
   "kr": "참, 마을 북동쪽 언덕에서"
  },
  "154": {
   "jp": "6bc7de6a",
   "kr": "넬바에서 온 남자가 혼자 앉아 있던데"
  },
  "155": {
   "jp": "9752bbce",
   "kr": "친구가 없나, 딱하게도."
  },
  "156": {
   "jp": "f4bac532",
   "kr": "알아?"
  },
  "157": {
   "jp": "7b5ced2e",
   "kr": "알아? 이 마을 술집에서 파는 계란말이는"
  },
