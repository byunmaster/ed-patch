 "lines": {
  "0": {
   "jp": "431d07bf",
   "kr": "꿈결 가도"
  },
  "1": {
   "jp": "9c3b5f51",
   "kr": "안지"
  },
  "2": {
   "jp": "4bce2f05",
   "kr": "바론"
  },
  "3": {
   "jp": "479b4b77",
   "kr": "루레 할아버지, 잠, 잠깐만요!"
  },
  "4": {
   "jp": "abf698a9",
   "kr": "어디 가세요?"
  },
  "5": {
   "jp": "83200804",
   "kr": "이쪽이다, 이쪽."
  },
  "6": {
   "jp": "e614df97",
   "kr": "없네에〜"
  },
  "7": {
   "jp": "f3a7f128",
   "kr": "올해는 안 오려나〜"
  },
  "8": {
   "jp": "353f5c42",
   "kr": "슬슬 음유시인 트로바가"
  },
  "9": {
   "jp": "f4193755",
   "kr": "올 계절인데 말이야."
  },
  "10": {
   "jp": "914cd468",
   "kr": "칫. 재미없어."
  },
  "11": {
   "jp": "7e00ea7f",
   "kr": "다츠로 돌아갈까."
  },
  "12": {
   "jp": "1820c2b0",
   "kr": "이런!"
  },
  "13": {
   "jp": "62a5629c",
   "kr": "다츠에 렌즈콩을 전해 줘야지."
  },
  "14": {
   "jp": "5cf212ad",
   "kr": "너희에게는 신세를 졌구나."
  },
  "15": {
   "jp": "89eb09ad",
   "kr": "아니에요!"
  },
  "16": {
   "jp": "3107f6e6",
   "kr": "루레 할아버지께 다정한 마음을 배웠어요."
  },
  "17": {
   "jp": "b631b0b2",
   "kr": "루레 할아버지는 대단한 사람이에요!"
  },
  "18": {
   "jp": "9231015b",
   "kr": "뭘 뭘, 쑥스럽구먼."
  },
  "19": {
   "jp": "090b1074",
   "kr": "나는 또, 시끄러운 손주가 있는"
  },
  "20": {
   "jp": "594af077",
   "kr": "튜엘로 돌아가야겠다."
  },
  "21": {
   "jp": "d1ca8536",
   "kr": "너희는 어쩔 테냐?"
  },
  "22": {
   "jp": "d7a5c20b",
   "kr": "큰일이다."
  },
  "23": {
   "jp": "78d1dca9",
   "kr": "빨리 볼트에 가지 않으면,"
  },
  "24": {
   "jp": "946ab0a4",
   "kr": "가루가에게 선수를 뺏기고 말아."
  },
  "25": {
   "jp": "587ca49d",
   "kr": "맞아."
  },
  "26": {
   "jp": "35e71782",
   "kr": "서둘러야 해."
  },
  "27": {
   "jp": "c4bdda1f",
   "kr": "뭐, 서두를 건 서두르지만,"
  },
  "28": {
   "jp": "64d9c5f5",
   "kr": "아직 볼트까지는 거리도 있으니까,"
  },
  "29": {
   "jp": "1e2a140d",
   "kr": "여행 채비를 점검해 두는 게 좋겠어."
  },
  "30": {
   "jp": "652dd2fd",
   "kr": "우리는 짐을 점검하고,"
  },
  "31": {
   "jp": "651a2fc0",
   "kr": "필요한 게 있으면"
  },
  "32": {
   "jp": "ef4814de",
   "kr": "보충한 다음에 가기로 할게."
  },
  "33": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "34": {
   "jp": "5e19aa46",
   "kr": "그럼, 여기서 작별이다."
  },
  "35": {
   "jp": "3b6f5402",
   "kr": "나는 슬슬 돌아가 볼까."
  },
  "36": {
   "jp": "2f1d1802",
   "kr": "토마스!"
  },
  "37": {
   "jp": "cb6ce2e9",
   "kr": "조심해서 가라."
  },
  "38": {
   "jp": "5381902a",
   "kr": "하하하!"
  },
  "39": {
   "jp": "10660682",
   "kr": "라몬, 난 겉보기만큼"
  },
  "40": {
   "jp": "d1e71f60",
   "kr": "늙지 않았다고."
  },
  "41": {
   "jp": "132f6e4c",
   "kr": "응…?"
  },
  "42": {
   "jp": "25c26d2c",
   "kr": "토마스?"
  },
  "43": {
   "jp": "8ca1056a",
   "kr": "라몬?"
  },
  "44": {
   "jp": "9549e379",
   "kr": "설마…"
  },
  "45": {
   "jp": "0c458993",
   "kr": "동쪽 다이스 62미로"
  },
  "46": {
   "jp": "524f615a",
   "kr": "남쪽 우돌 국경 306미로"
  },
  "47": {
   "jp": "b1118623",
   "kr": "삼도교 731미로"
  },
  "48": {
   "jp": "7f0feb1a",
