 "lines": {
  "0": {
   "jp": "b2086cc7",
   "kr": "테그라 탄광"
  },
  "1": {
   "jp": "b519a5d7",
   "kr": "지하 3층"
  },
  "2": {
   "jp": "fc3838e7",
   "kr": "광부 보리"
  },
  "3": {
   "jp": "7d38049f",
   "kr": "광부 테드"
  },
  "4": {
   "jp": "d564ff61",
   "kr": "광부 아일"
  },
  "5": {
   "jp": "9aebf270",
   "kr": "이 탄광에서 나는 건 거의 이탄이지만,"
  },
  "6": {
   "jp": "f0c77337",
   "kr": "조금은 석탄도 있단다."
  },
  "7": {
   "jp": "f50a63f0",
   "kr": "자연의 은혜란 고마운 거야."
  },
  "8": {
   "jp": "39569cd9",
   "kr": "이탄 늪은 동굴을 서쪽으로 가면 있다."
  },
  "9": {
   "jp": "e81aa916",
   "kr": "앗, 늪이다."
  },
  "10": {
   "jp": "d4c259c1",
   "kr": "여기가 이탄 늪이구나."
  },
  "11": {
   "jp": "d540a6ee",
   "kr": "엄청 넓네."
  },
  "12": {
   "jp": "b4170200",
   "kr": "어라, 너희들은?"
  },
  "13": {
   "jp": "3516965d",
   "kr": "애들끼리 들어오다니 드물군."
  },
  "14": {
   "jp": "28ea26a5",
   "kr": "무슨 볼일이니?"
  },
  "15": {
   "jp": "5439edbb",
   "kr": "용케 여기까지 왔구나."
  },
  "16": {
   "jp": "ee30cab9",
   "kr": "저희 케빈 할아버지 부탁으로,"
  },
  "17": {
   "jp": "dcd827d7",
   "kr": "늪에 가라앉힌 보석을 가지러 왔어요."
  },
  "18": {
   "jp": "65764796",
   "kr": "여기가 이탄 늪 맞죠?"
  },
  "19": {
   "jp": "21ef3643",
   "kr": "그래, 맞다. 진홍의 불꽃을 가지러 왔구나."
  },
  "20": {
   "jp": "b1c5b03d",
   "kr": "그래도, 보다시피 넓으니까"
  },
  "21": {
   "jp": "911b0b34",
   "kr": "이 안에서 보석을 찾긴 힘들다."
  },
  "22": {
   "jp": "de95dfd9",
   "kr": "그래도, 약속했는걸요."
  },
  "23": {
   "jp": "33a75342",
   "kr": "찾아야 해요."
  },
  "24": {
   "jp": "da364c87",
   "kr": "너무 커져 버린 보석에는"
  },
  "25": {
   "jp": "fbdcb2bb",
   "kr": "손대지 않는 게 좋다."
  },
  "26": {
   "jp": "fa1ad541",
   "kr": "폭발할지도 모르니까."
  },
  "27": {
   "jp": "e96d82b8",
   "kr": "그럼, 난 돌아갈까."
  },
  "28": {
   "jp": "c249815e",
   "kr": "조심해서 찾아라."
  },
  "29": {
   "jp": "40f551ea",
   "kr": "자, 쥬리오. 찾아보자."
  },
  "30": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "31": {
   "jp": "c2c4a2ee",
   "kr": "아, 이건가?"
  },
  "32": {
   "jp": "fa63e804",
   "kr": "우와…"
  },
  "33": {
   "jp": "088b792f",
   "kr": "이게 진홍의 불꽃이구나."
  },
  "34": {
   "jp": "aa23ba63",
   "kr": "무척 예쁘다."
  },
  "35": {
   "jp": "262f6ee9",
   "kr": "쥬리오는 진홍의 불꽃을 얻었다."
  },
  "36": {
   "jp": "21b48d04",
   "kr": "하지만 짐이 가득합니다."
  },
  "37": {
   "jp": "b470d8b7",
   "kr": "보석은 전부 세 개 가라앉혔다고"
  },
  "38": {
   "jp": "f232fc9b",
   "kr": "케빈 할아버지가 말했지."
  },
  "39": {
   "jp": "01e11e8a",
   "kr": "두 개 더 있을 거야."
  },
  "40": {
   "jp": "b8c5dbba",
   "kr": "이걸로 전부네."
  },
  "41": {
   "jp": "61391a49",
   "kr": "응, 테그라 마을로 돌아가자."
  },
  "42": {
   "jp": "e4377459",
   "kr": "커다란 진홍의 불꽃이 있다!"
  },
  "43": {
   "jp": "8c3a5222",
   "kr": "쥬리오 일행은 손대지 않게 조심했다."
  },
  "44": {
   "jp": "76697314",
   "kr": "이거네, 폭발하는 거."
  },
  "45": {
   "jp": "9dc05ed1",
   "kr": "폭발하면 큰일이야."
  },
  "46": {
   "jp": "d3598d6b",
   "kr": "얼른 떨어지는 게 좋아…"
  },
  "47": {
   "jp": "ff9ba434",
   "kr": "그러네."
  },
  "48": {
   "jp": "3f9e15ac",
   "kr": "살〜짝 떨어지자."
  },
  "49": {
   "jp": "90493c0b",
   "kr": "쥬리오는 이탄 속에서 천천히"
  },
  "50": {
   "jp": "cd13e099",
   "kr": "진홍의 불꽃을 집어 들었다."
  },
  "51": {
   "jp": "557fb488",
   "kr": "쥬리오, 떨어뜨리지 마…"
  },
  "52": {
   "jp": "713e4b75",
   "kr": "응, 알고 있어."
  },
  "53": {
   "jp": "e1b7c2b7",
   "kr": "앗…?!"
  },
  "54": {
   "jp": "e7cb7950",
   "kr": "흔들려, 지진이야…"
  },
  "55": {
   "jp": "fea45857",
   "kr": "어떡하지…"
  },
  "56": {
   "jp": "b847b6d8",
   "kr": "통로가 막혀 버렸어."
  },
  "57": {
   "jp": "0dcc220c",
   "kr": "큰일이네."
  },
  "58": {
   "jp": "e0a2c5d6",
   "kr": "이래서야 우린 생매장이잖아."
  },
  "59": {
   "jp": "5994f1a9",
   "kr": "다른 출구는 없을까."
  },
  "60": {
   "jp": "c3679474",
   "kr": "아마 없을걸."
  },
  "61": {
   "jp": "005edb69",
   "kr": "어째서?"
  },
  "62": {
   "jp": "2f34779b",
   "kr": "희망 없는 소리 하지 마."
  },
  "63": {
   "jp": "1a9bb5a3",
   "kr": "왜냐면,"
  },
  "64": {
   "jp": "97cece11",
   "kr": "여기가 이 탄광의"
  },
  "65": {
   "jp": "8a0d2524",
   "kr": "맨 밑바닥이라니까."
  },
  "66": {
   "jp": "5a7d2a5d",
   "kr": "누가 구하러 와 주지 않을까."
  },
  "67": {
   "jp": "70297f6b",
   "kr": "무너진 돌과 바위로 통로가 빽빽이 막혔다!"
  },
  "68": {
   "jp": "de22f3de",
   "kr": "토사 때문에 출구가 막혀 버려"
  },
  "69": {
   "jp": "c0e9ac6b",
   "kr": "더는 나아갈 수 없다."
  },
  "70": {
   "jp": "4f7c5523",
   "kr": "쥬리오 일행의 힘으로는"
  },
  "71": {
   "jp": "8774c637",
   "kr": "어찌할 수 없을 듯하다."
  },
  "72": {
   "jp": "b6fd4418",
   "kr": "그때,"
  },
  "73": {
   "jp": "54949558",
   "kr": "무너진 바위 너머에서"
  },
  "74": {
   "jp": "679800c0",
   "kr": "사람 기척이 났다."
  },
  "75": {
   "jp": "8d90d25a",
   "kr": "어〜이!"
  },
  "76": {
   "jp": "44b2c5c8",
   "kr": "거기 있는 거냐아!"
  },
  "77": {
   "jp": "748c8720",
   "kr": "됐다, 구하러 와 줬어."
  },
  "78": {
   "jp": "9d66c0e7",
   "kr": "네, 여기 있어요!"
  },
  "79": {
   "jp": "b701586e",
   "kr": "다치진 않았나?"
  },
  "80": {
   "jp": "d19aeac9",
   "kr": "괜찮으냐!"
  },
  "81": {
   "jp": "9b484287",
   "kr": "안 다쳤어요. 괜찮아요."
  },
  "82": {
   "jp": "e69093c0",
   "kr": "그런데 통로가 무너져서 못 나가요."
  },
  "83": {
   "jp": "48bac4c5",
   "kr": "다른 출구는 없나요?"
  },
  "84": {
   "jp": "3ef9f4ac",
   "kr": "다른 출구라…"
  },
  "85": {
   "jp": "6e9a28be",
   "kr": "응, 다른 출구를 알려 줘요."
  },
  "86": {
   "jp": "e40ad485",
   "kr": "으음, 다른 출구는…없다!"
  },
  "87": {
   "jp": "e3dfc619",
   "kr": "에엣?!"
  },
  "88": {
   "jp": "a57c11e7",
   "kr": "그렇게 딱 잘라 말하지"
  },
  "89": {
   "jp": "ea1714ee",
   "kr": "않아도 되잖아요…"
  },
  "90": {
   "jp": "179423fe",
   "kr": "미안, 미안."
  },
  "91": {
   "jp": "a0b3b96b",
   "kr": "뭐, 너무 비관적으로 생각하지 마라."
  },
  "92": {
   "jp": "5d0d96f4",
   "kr": "탈출 방법은 아직 있으니까."
  },
  "93": {
   "jp": "0837b9e7",
   "kr": "어떻게 하면 돼요?"
  },
  "94": {
   "jp": "82241233",
   "kr": "응, 잠깐 기다려라."
  },
  "95": {
   "jp": "369d7b44",
   "kr": "지금 여기서 의논해 볼 테니."
  },
  "96": {
   "jp": "ba6f2e3e",
   "kr": "뭐야…"
  },
  "97": {
   "jp": "210da2a4",
   "kr": "아직 생각도 안 한 거잖아."
  },
  "98": {
   "jp": "c6a655a8",
   "kr": "정말 괜찮은 걸까."
  },
  "99": {
   "jp": "97ed051e",
   "kr": "이렇게 요란하게 무너졌으면"
  },
  "100": {
   "jp": "dac62698",
   "kr": "아무리 우리가 셋이 달려들어 파도"
  },
  "101": {
   "jp": "cde16acc",
   "kr": "며칠은 걸린다."
  },
  "102": {
   "jp": "34f07f81",
   "kr": "으음, 그렇군."
  },
  "103": {
   "jp": "140d9dae",
   "kr": "위에서 지원을 불러도 여럿이 한꺼번에"
  },
  "104": {
   "jp": "6fd283c4",
   "kr": "작업할 만큼 넓지도 않고."
  },
  "105": {
   "jp": "5507541c",
   "kr": "좀 위험하지만 그 수를 써 볼까?"
  },
  "106": {
   "jp": "38344d4d",
   "kr": "그 수인가…"
  },
  "107": {
   "jp": "dfcf2d7d",
   "kr": "그래도, 그 방법은 뭐가 일어날지"
  },
  "108": {
   "jp": "1f0e1565",
   "kr": "모르니까 말이야."
  },
  "109": {
   "jp": "cbc5750f",
   "kr": "그래도 뭐, 손쉽게 끝내려면"
  },
  "110": {
   "jp": "7576eb9d",
   "kr": "그 수지."
  },
  "111": {
   "jp": "de7d78d3",
