  },
  "155": {
   "jp": "725827a9",
   "kr": "알았지."
  },
  "156": {
   "jp": "eff7a623",
   "kr": "자, 진홍의 불꽃을 가져와라."
  },
  "157": {
   "jp": "8be0fc72",
   "kr": "알겠나 굴리기 전에는 한마디 해라."
  },
  "158": {
   "jp": "58df9c75",
   "kr": "우리도 피해야 하니까."
  },
  "159": {
   "jp": "725827a9",
   "kr": "알겠지."
  },
  "160": {
   "jp": "aace8142",
   "kr": "응, 알았어."
  },
  "161": {
   "jp": "8be0fc72",
