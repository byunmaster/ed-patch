  },
  "115": {
   "jp": "63119222",
   "kr": "잘 들어라."
  },
  "116": {
   "jp": "e8df4b00",
   "kr": "아까부터 계속 듣고 있는데요."
  },
  "117": {
   "jp": "8a8b1425",
   "kr": "아저씨들, 혹시 꽤 위험한 일을"
