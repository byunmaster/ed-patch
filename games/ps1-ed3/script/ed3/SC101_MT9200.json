  },
  "144": {
   "jp": "b414eb01",
   "kr": "우리도 폭발하잖아요."
  },
  "145": {
   "jp": "364500dd",
   "kr": "멀리서 던지면 되잖아."
  },
  "146": {
   "jp": "b559631f",
   "kr": "그렇게 커다란 거"
  },
  "147": {
   "jp": "db4373f9",
   "kr": "그리 멀리 안 날아가."
  },
  "148": {
   "jp": "d508632b",
   "kr": "굴리면 되는 거다."
  },
  "149": {
   "jp": "e60edb03",
   "kr": "그 정도 충격이면 폭발 안 한다."
  },
  "150": {
   "jp": "e12a96ff",
