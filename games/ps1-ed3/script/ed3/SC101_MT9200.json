  },
  "120": {
   "jp": "51a0b88f",
   "kr": "괜찮다니까."
  },
  "121": {
   "jp": "115bee2a",
   "kr": "이탄 늪은 꽤 넓으니까"
  },
  "122": {
   "jp": "7836e34c",
   "kr": "피할 곳은 많다."
  },
  "123": {
   "jp": "868aac0c",
   "kr": "걱정 없어."
  },
  "124": {
   "jp": "7bced791",
   "kr": "이탄 늪 안에,"
  },
  "125": {
   "jp": "476be9f1",
   "kr": "너무 커져 버린"
  },
  "126": {
   "jp": "748ca140",
   "kr": "진홍의 불꽃이 있었지."
  },
  "127": {
   "jp": "f412cca1",
   "kr": "그걸 폭탄 대신 쓸 수 있다."
  },
  "128": {
   "jp": "bf169aa7",
   "kr": "그런 거 아닐까 했어요."
  },
  "129": {
   "jp": "ee523f81",
   "kr": "그걸로 날려 버리는 거군요."
  },
  "130": {
   "jp": "638cac14",
   "kr": "그렇지."
  },
  "131": {
   "jp": "38c2c2dd",
   "kr": "감이 좋구나, 꼬마."
  },
  "132": {
   "jp": "93840486",
   "kr": "거기까지 들으면"
  },
  "133": {
   "jp": "a2967090",
   "kr": "누구라도 알아요."
