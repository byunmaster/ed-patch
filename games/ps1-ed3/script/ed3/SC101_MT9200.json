  },
  "136": {
   "jp": "5b56f628",
   "kr": "이 토사에 부딪치면 된다."
  },
  "137": {
   "jp": "8b0227a7",
   "kr": "어때, 간단하지?"
  },
  "138": {
   "jp": "4e872455",
   "kr": "옮길 땐 조심해라."
  },
  "139": {
   "jp": "b4ce6cff",
   "kr": "부디 떨어뜨리지 않도록."
  },
  "140": {
