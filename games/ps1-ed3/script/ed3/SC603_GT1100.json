{
 "archive": "/SCE6/SC603.DAT",
 "member": "..\\DATA\\GT1100.BIN",
 "lines": {
  "0": {
   "jp": "b1a96fa6",
   "kr": "유적"
  },
  "1": {
   "jp": "cbfe7661",
   "kr": "지하 1층"
  },
  "2": {
   "jp": "b8987418",
   "kr": "우와"
  },
  "3": {
   "jp": "c4b0ad57",
   "kr": "그나저나 굉장한데."
  },
  "4": {
   "jp": "11dfdff7",
   "kr": "이 드래곤 조각상."
  },
  "5": {
   "jp": "d7afe3ad",
   "kr": "이 유적을 지은 녀석들은"
  },
  "6": {
   "jp": "c0930636",
   "kr": "드래곤이라도 믿었던 걸까."
  },
  "7": {
   "jp": "4fd7e2c8",
   "kr": "바다트는 이 근방 역사를"
  },
  "8": {
   "jp": "dee4a2e3",
   "kr": "잘 모르는 거야?"
  },
  "9": {
   "jp": "0eee7f93",
   "kr": "나는 뼛속까지 떠돌이라서"
  },
  "10": {
   "jp": "4e21a677",
   "kr": "모르겠어."
  },
  "11": {
   "jp": "518d61e2",
   "kr": "하지만 슬쩍 이 근방 토박이한테"
  },
  "12": {
   "jp": "0e31c56f",
   "kr": "들은 적이 있는데, 가가브의 서쪽과"
  },
  "13": {
   "jp": "ea7b5ec9",
   "kr": "옛날에 관계가 있었다고 하더군."
  },
  "14": {
   "jp": "46650c1b",
   "kr": "가가브?"
  },
  "15": {
   "jp": "ed42133e",
   "kr": "이 기드나의 서쪽에 있는,"
  },
  "16": {
   "jp": "a644a846",
   "kr": "북에서 남을 가르는 대지의 갈라진 틈이야."
  },
  "17": {
   "jp": "f6f72b6a",
   "kr": "아, 들어 본 적 있어."
  },
  "18": {
   "jp": "1dc8defb",
   "kr": "지금은 교류가 전혀 없지만"
  },
  "19": {
   "jp": "1db68c14",
   "kr": "이 유적은 가가브 건너편과"
  },
  "20": {
   "jp": "a78f3af2",
   "kr": "관련이 있는지도 모르지."
  },
  "21": {
   "jp": "a42efdbd",
   "kr": "보물 상자가 있다."
  },
  "22": {
   "jp": "88b20049",
   "kr": "오, 보물 상자다."
  },
  "23": {
   "jp": "da331cfd",
   "kr": "뭔가 좋은 게 들어 있을지도 몰라."
  },
  "24": {
   "jp": "78794fd0",
   "kr": "함부로 열면"
  },
  "25": {
   "jp": "0021366a",
   "kr": "안 될 것 같은데."
  },
  "26": {
   "jp": "26d1b1a0",
   "kr": "까다롭게 굴지 마."
  },
  "27": {
   "jp": "7bdb7075",
   "kr": "어차피 임자도 없잖아."
  },
  "28": {
   "jp": "ad5703f4",
   "kr": "여행에 도움이 될 게 들어 있으면"
  },
  "29": {
   "jp": "0a633ed5",
   "kr": "만, 만세 아니냐."
  },
  "30": {
   "jp": "8ee6f0b4",
   "kr": "보아하니 여기 보물은"
  },
  "31": {
   "jp": "903c5cd0",
   "kr": "죽은 자를 위한 부장품도 아닌 듯하고,"
  },
  "32": {
   "jp": "eacf8705",
   "kr": "저주받을 일은 없어."
  },
  "33": {
   "jp": "f43cc728",
   "kr": "그, 그렇지."
  },
  "34": {
   "jp": "2d050a4f",
   "kr": "바다트는 보물 상자를 열었다."
  },
  "35": {
   "jp": "1d8d5090",
   "kr": "꽤 비싸 보이는 검이 있어."
  },
  "36": {
   "jp": "0f036869",
   "kr": "짐을 줄이고 나중에 가지러 올까."
  },
  "37": {
   "jp": "7cfa8c0f",
   "kr": "쥬리오 일행은 고대의 검을 얻었다."
  },
  "38": {
   "jp": "a42efdbd",
   "kr": "보물 상자가 있다."
  },
  "39": {
   "jp": "31a3ff6d",
   "kr": "열어 보자."
  },
  "40": {
   "jp": "b440ecfa",
   "kr": "정말 괜찮을까."
  },
  "41": {
   "jp": "fb538fe6",
   "kr": "괜찮아, 괜찮아."
  },
  "42": {
   "jp": "2d050a4f",
   "kr": "바다트는 보물 상자를 열었다."
  },
  "43": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "44": {
   "jp": "e9d91b01",
   "kr": ", 손에 넣었다."
  }
 }
}