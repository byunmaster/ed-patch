{
 "archive": "/SCE0/SC006.DAT",
 "member": "..\\DATA\\MR1000.BIN",
 "lines": {
  "0": {
   "jp": "41e91668",
   "kr": "전나무 들판"
  },
  "1": {
   "jp": "3d773389",
   "kr": "미겔 할아버지"
  },
  "2": {
   "jp": "5cc70478",
   "kr": "어부 토바이"
  },
  "3": {
   "jp": "9e2d52e5",
   "kr": "으윽…"
  },
  "4": {
   "jp": "7a88ea32",
   "kr": "안 되겠군, 발을 삐고 말았어."
  },
  "5": {
   "jp": "3a3d8771",
   "kr": "괜찮으세요?"
  },
  "6": {
   "jp": "0f5f608e",
   "kr": "아아, 별거 아니다."
  },
  "7": {
   "jp": "3875f62c",
   "kr": "벼랑이 무너져 길이 막혔다고 하기에"
  },
  "8": {
   "jp": "cbd1ae65",
   "kr": "살펴보러 왔다만…"
  },
  "9": {
   "jp": "d34d5a4a",
   "kr": "나이도 잊고"
  },
  "10": {
   "jp": "8bf3daf0",
   "kr": "바위에 올라 우쭐대다가"
  },
  "11": {
   "jp": "59d2fbd9",
   "kr": "발을 헛디디고 말았지."
  },
  "12": {
   "jp": "7f1e377a",
   "kr": "바위에 오르니까 그렇죠."
  },
  "13": {
   "jp": "e1ae031e",
   "kr": "쥬리오!"
  },
  "14": {
   "jp": "fed897a7",
   "kr": "하하하, 아가씨."
  },
  "15": {
   "jp": "d72b4370",
   "kr": "그리 화내지 마라."
  },
  "16": {
   "jp": "7ef0db6c",
   "kr": "이 아이 말이 옳다."
  },
  "17": {
   "jp": "39b02fa1",
   "kr": "그건 그렇고"
  },
  "18": {
   "jp": "9f965348",
   "kr": "알데 마을로 돌아가고 싶다만,"
  },
  "19": {
   "jp": "0bb92499",
   "kr": "삔 발로는 좀 힘겹구나."
  },
  "20": {
   "jp": "9c93e6b1",
   "kr": "미안하지만"
  },
  "21": {
   "jp": "bbd780cd",
   "kr": "알데 마을에서 아들 토바이를 불러와"
  },
  "22": {
   "jp": "3c729009",
   "kr": "주지 않겠나?"
  },
  "23": {
   "jp": "69ba2b57",
   "kr": "노, 농담이지?"
  },
  "24": {
   "jp": "19231500",
   "kr": "가녀린 노인을 두고 가다니."
  },
  "25": {
   "jp": "aa21d8ca",
   "kr": "너희들, 그러고도 사람이냐."
  },
  "26": {
   "jp": "b8481bb6",
   "kr": "응, 농담이지?"
  },
  "27": {
   "jp": "9e38e353",
   "kr": "그럼 여기서 기다리고 있으마."
  },
  "28": {
   "jp": "530b9a72",
   "kr": "해가 저물기 전에는 돌아와 다오."
  },
  "29": {
   "jp": "d2098cd1",
   "kr": "꽤나 고집 센 아이들이구나."
  },
  "30": {
   "jp": "fe0f0b8c",
   "kr": "그리 말해 놓고,"
  },
  "31": {
   "jp": "0e101832",
   "kr": "토바이를 불러다 줄 테지."
  },
  "32": {
   "jp": "1d1f7a13",
   "kr": "난 믿고 기다리마."
  },
  "33": {
   "jp": "fa16e5a6",
   "kr": "그럼, 부탁하마."
  },
  "34": {
   "jp": "9e38e353",
   "kr": "그럼 여기서 기다리고 있으마."
  },
  "35": {
   "jp": "530b9a72",
   "kr": "해가 저물기 전에는 돌아와 다오."
  },
  "36": {
   "jp": "25808df3",
   "kr": "아버지."
  },
  "37": {
   "jp": "44b5e850",
   "kr": "괜찮으신가유?"
  },
  "38": {
   "jp": "5cb7aa4b",
   "kr": "오오, 토바이."
  },
  "39": {
   "jp": "36881538",
   "kr": "드디어 와 줬구나."
  },
  "40": {
   "jp": "c50e0fe1",
   "kr": "두 사람, 미안했구나."
  },
  "41": {
   "jp": "955a09ce",
   "kr": "아버지, 이제 연세도 있으신데"
  },
  "42": {
   "jp": "ad41cbf6",
   "kr": "혼자 나다니는 건 그만두시라니께."
  },
  "43": {
   "jp": "9d20452a",
   "kr": "이분들이 안 오셨으면 어쩔 뻔했슈."
  },
  "44": {
   "jp": "51a7b4f4",
   "kr": "시끄럽다!"
  },
  "45": {
   "jp": "fd06086f",
   "kr": "바다표범 나왔다고 조업 접은 겁쟁이한테,"
  },
  "46": {
   "jp": "6f264ce2",
   "kr": "이러쿵저러쿵 소리 들을 일 없다!"
  },
  "47": {
   "jp": "93af7a72",
   "kr": "냉큼, 나를 업고"
  },
  "48": {
   "jp": "bbb52b75",
   "kr": "마을로 데려가!"
  },
  "49": {
   "jp": "b38a4070",
   "kr": "히이이이…"
  },
  "50": {
   "jp": "86701204",
   "kr": "지가 잘못했슈…"
  },
  "51": {
   "jp": "5514d1ba",
   "kr": "미겔 할아버지는"
  },
  "52": {
   "jp": "eb596dad",
   "kr": "무사히 아들 토바이에게 업혀"
  },
  "53": {
   "jp": "f9bf69f6",
   "kr": "마을로 돌아가게 되었다."
  },
  "54": {
   "jp": "4c85a86c",
   "kr": "쥬리오 일행도"
  },
  "55": {
   "jp": "ee4ec64c",
   "kr": "일단 알데 마을로 돌아가,"
  },
  "56": {
   "jp": "4336d08c",
   "kr": "네갈섬 건너갈 방법을 다시 생각하기로 했다."
  },
  "57": {
   "jp": "12a6e29f",
   "kr": "쥬리오, 착하지? 이제 그만해."
  },
  "58": {
   "jp": "de3b60fe",
   "kr": "…"
  },
  "59": {
   "jp": "658c4041",
   "kr": "쥬리오, 뭐 하는 거야?"
  },
  "60": {
   "jp": "d35e8819",
   "kr": "엇, 또 뭔가 떨어져 있나 해서."
  },
  "61": {
   "jp": "56c9da54",
   "kr": "바보 같아."
  },
  "62": {
   "jp": "5fce0eee",
   "kr": "그런 잡동사니 모아서 뭐가 재미있어?"
  },
  "63": {
   "jp": "e8be4a77",
   "kr": "…분해."
  },
  "64": {
   "jp": "b097176c",
   "kr": "아앗!"
  },
  "65": {
   "jp": "bd2e3a96",
   "kr": "엇, 무슨 일이야, 쥬리오?"
  },
  "66": {
   "jp": "c5ef4fea",
   "kr": "아, 아무것도 아니야."
  },
  "67": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는"
  },
  "68": {
   "jp": "404f4d26",
   "kr": ", 찾았습니다."
  },
  "69": {
   "jp": "aad16827",
   "kr": "하지만"
  },
  "70": {
   "jp": "1c051868",
   "kr": "하지만 크리스에게 들키면 놀림받겠다 싶어"
  },
  "71": {
   "jp": "f62e7b05",
   "kr": "말없이 주웠다."
  },
  "72": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "73": {
   "jp": "8ba5780d",
   "kr": "눈치 못 챘다고 생각하는 거야?"
  },
  "74": {
   "jp": "14d2f277",
   "kr": "그런 쓸모없는 걸 주워서…"
  },
  "75": {
   "jp": "8c93eaca",
   "kr": "흥, 크리스 같은 애가 알 리 없지."
  },
  "76": {
   "jp": "dbf6158f",
   "kr": "쥬리오는"
  },
  "77": {
   "jp": "404f4d26",
   "kr": ", 찾았습니다."
  },
  "78": {
   "jp": "00b4546b",
   "kr": "하지만 더는 들 수 없습니다."
  },
  "79": {
   "jp": "2fdb63de",
   "kr": "쥬리오는 어떻게든"
  },
  "80": {
   "jp": "a1428165",
   "kr": "이(가)"
  },
  "81": {
   "jp": "b2e8dfa9",
   "kr": "갖고 싶어서 나중에 가지러 오려고"
  },
  "82": {
   "jp": "6cbd0d1c",
   "kr": "생각했습니다."
  }
 }
}