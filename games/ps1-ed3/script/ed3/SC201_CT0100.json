  },
  "8": {
   "jp": "b3be7032",
   "kr": "바에트"
  },
  "9": {
   "jp": "39b4c362",
   "kr": "못레"
  },
  "10": {
   "jp": "7bf572e9",
   "kr": "미리스"
  },
  "11": {
   "jp": "746a2177",
   "kr": "그라크"
  },
  "12": {
   "jp": "7270f89f",
   "kr": "아델"
  },
  "13": {
   "jp": "db118d3a",
   "kr": "카밀"
  },
  "14": {
   "jp": "1ff03664",
   "kr": "오오, 다 왔다, 다 왔어."
  },
  "15": {
   "jp": "27bf12f7",
   "kr": "가슴이 뛰는구먼."
  },
  "16": {
   "jp": "3a98aa0f",
   "kr": "그럼, 멋지게 한판 해 볼까."
  },
  "17": {
   "jp": "02fa763a",
   "kr": "그럼 신세 많이 졌네."
  },
  "18": {
   "jp": "2a28ba2e",
   "kr": "고맙네, 자네들."
  },
  "19": {
   "jp": "2cf6be84",
   "kr": "잘 지내게〜!"
  },
  "20": {
   "jp": "5335e7aa",
   "kr": "앗…가 버렸어."
  },
  "21": {
   "jp": "9c57f8bf",
   "kr": "잘 지내게〜, 라니."
  },
  "22": {
   "jp": "03e9b6bf",
   "kr": "역시, 그 영감님한테는"
  },
  "23": {
   "jp": "a11ab82c",
   "kr": "너무 엮이지 않는 편이"
  },
  "24": {
   "jp": "735a699b",
   "kr": "좋을 것 같군."
  },
  "25": {
   "jp": "f14ae519",
   "kr": "무기점에 좋은 물건이 있을지도 모른다."
  },
  "26": {
   "jp": "0bf0e05d",
   "kr": "잠깐 마을 안을 둘러볼까."
  },
  "27": {
   "jp": "70cf608d",
   "kr": "질렸군."
  },
  "28": {
   "jp": "28025c5e",
   "kr": "여기 놈들한테는."
  },
  "29": {
   "jp": "cb748c19",
   "kr": "정말이네."
  },
  "30": {
   "jp": "bc7510e1",
   "kr": "다들 루레 할아버지 같아."
  },
  "31": {
   "jp": "a52dc2b7",
   "kr": "라그픽 마을에선"
  },
  "32": {
   "jp": "8b0a81c3",
   "kr": "축제 때 말고는"
  },
  "33": {
   "jp": "447a6d50",
   "kr": "놀이에 정신 팔리지 않아."
  },
  "34": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "35": {
   "jp": "eba3a349",
   "kr": "아〜앗!"
  },
  "36": {
   "jp": "dd1bb6bf",
   "kr": "뭐야, 무슨 일이야?"
  },
  "37": {
   "jp": "104546f9",
   "kr": "지금쯤, 라그픽 마을에선"
  },
  "38": {
   "jp": "ceb101a6",
   "kr": "감사제가 한창일 텐데…"
  },
  "39": {
   "jp": "08b7f0fb",
   "kr": "아〜아."
  },
  "40": {
   "jp": "b8fc0bf8",
   "kr": "크리스 엄마가 만드신"
  },
  "41": {
   "jp": "fedfd8ca",
   "kr": "브리오슈, 먹고 싶었는데."
  },
  "42": {
   "jp": "e07d2ae5",
   "kr": "쥬리오네 아빠가 해마다 내주시는"
  },
  "43": {
   "jp": "e0a71384",
   "kr": "잭로즈도 맛있잖아."
  },
  "44": {
   "jp": "a91d6699",
   "kr": "뭐야, 그 브리 뭐라는 거랑"
  },
  "45": {
   "jp": "fa1a4e7e",
   "kr": "잭로즈라는 게?"
  },
  "46": {
   "jp": "85cea43b",
   "kr": "라그픽 마을의 과자랑 포도주야."
  },
  "47": {
   "jp": "cbaf4b14",
   "kr": "정말 맛있어!"
  },
  "48": {
   "jp": "67101671",
   "kr": "일 년에 한 번밖에 못 먹으니까."
  },
  "49": {
   "jp": "9a84ab22",
   "kr": "…내년엔 나도 불러 줘."
  },
  "50": {
   "jp": "40316ef8",
   "kr": "다츠는 이쪽이 아니라네."
  },
  "51": {
   "jp": "8d60c9e1",
   "kr": "게다가, 렌즈콩도 안 들었네!"
  },
  "52": {
   "jp": "b71c0adb",
   "kr": "어머, 여행하시는 분이군요."
  },
  "53": {
   "jp": "e9b7e3d0",
   "kr": "다이스 마을은 어떠세요?"
  },
  "54": {
   "jp": "e19875b6",
   "kr": "정말 아름다운 마을이죠."
  },
  "55": {
   "jp": "b713f12c",
   "kr": "이 마을은 카지노 덕분에"
  },
  "56": {
   "jp": "de6ab1e8",
   "kr": "무척 부유한 마을이 되었어요."
  },
  "57": {
   "jp": "0ef16647",
   "kr": "이것도 나라가 직접"
  },
  "58": {
   "jp": "9ce0d5ea",
   "kr": "카지노를 하자고 말을 꺼내신"
  },
  "59": {
   "jp": "d6081982",
   "kr": "바론 님 덕분이에요."
  },
  "60": {
   "jp": "6e112637",
   "kr": "꽤 괜찮은 마을이지?"
  },
  "61": {
   "jp": "54fc3348",
   "kr": "길모퉁이는 죄다 닦여 있고"
  },
  "62": {
   "jp": "bc9ec824",
   "kr": "녹지도 적당히 있어."
  },
  "63": {
   "jp": "e456d656",
   "kr": "이 다이스 마을은 구획 정비가 잘된,"
  },
  "64": {
   "jp": "51124b64",
   "kr": "가장 이상적인 도시라고."
  },
  "65": {
   "jp": "453a7899",
   "kr": "여기 오는 사람은 다들 부러워하지."
  },
  "66": {
   "jp": "73a2cf61",
   "kr": "이 마을과는 달리"
  },
  "67": {
   "jp": "7b0ed8db",
   "kr": "빈민가 쪽은 험한 곳입니다."
  },
  "68": {
   "jp": "6b84f713",
   "kr": "저기 가 보겠다는 생각은"
  },
  "69": {
   "jp": "723ffca6",
   "kr": "하지 않는 게 좋습니다."
  },
  "70": {
   "jp": "50e7ec14",
   "kr": "토란의 도구점에 어서 오세요."
  },
  "71": {
   "jp": "08a05540",
   "kr": "어떤 볼일이신지요?"
  },
  "72": {
   "jp": "8712955a",
   "kr": "쓸 만한 물건이 있으신지요?"
  },
  "73": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "74": {
   "jp": "ee93304e",
   "kr": "입니다."
  },
  "75": {
   "jp": "d220bf22",
   "kr": "필요 없는 물건은 뭐든지요."
  },
  "76": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "77": {
   "jp": "5aa7b82b",
   "kr": "에 사들이겠습니다."
  },
  "78": {
   "jp": "60f2accf",
   "kr": "환전율은 1 Goa당 14 Pia입니다."
  },
  "79": {
   "jp": "74b4488e",
   "kr": "괜찮습니까?"
  },
  "80": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "81": {
   "jp": "0f41ed9b",
   "kr": "을 치르겠습니다."
  },
  "82": {
   "jp": "e32b0c00",
   "kr": "라피카가 모이면"
  },
  "83": {
   "jp": "b41a514b",
   "kr": "또 들러 주세요."
  },
  "84": {
   "jp": "96a0ae96",
   "kr": "그렇습니까, 아쉽네요."
  },
  "85": {
   "jp": "bd08bfed",
   "kr": "그 밖에 무슨 볼일이신지요?"
  },
  "86": {
   "jp": "5f6ba7d6",
   "kr": "볼일이 있으시면"
  },
  "87": {
   "jp": "7dfc109e",
   "kr": "언제든 들러 주십시오."
  },
  "88": {
   "jp": "d169d069",
   "kr": "뭐야?"
  },
  "89": {
   "jp": "bb4a7ab6",
   "kr": "지금 카지노에 가려던"
  },
  "90": {
   "jp": "b38324d8",
   "kr": "참이라고."
  },
  "91": {
   "jp": "6342cdbc",
   "kr": "바쁘다고."
  },
  "92": {
   "jp": "07939d83",
   "kr": "볼일 있으면 빨리 말해."
  },
  "93": {
   "jp": "e09c352d",
   "kr": "카드가 날 기다린다고."
  },
  "94": {
   "jp": "c1259d44",
   "kr": "다이스 사람들은"
  },
  "95": {
   "jp": "7ccb8457",
   "kr": "다들 도박에 푹 빠진 건가요?"
  },
  "96": {
   "jp": "30f97a41",
   "kr": "그야 그렇지."
  },
  "97": {
   "jp": "15ef3ebf",
   "kr": "잘하면 하룻밤에 큰 부자가 될 수 있고"
  },
  "98": {
   "jp": "773b618b",
   "kr": "빗나가도 나라가 번다고."
  },
  "99": {
   "jp": "29f64627",
   "kr": "여기 사는 사람은 손해 볼 게 없지."
  },
  "100": {
   "jp": "eff09a83",
   "kr": "그쯤이면 됐지?"
  },
  "101": {
   "jp": "eb0259e2",
   "kr": "난 간다."
  },
  "102": {
   "jp": "6a61ba29",
   "kr": "카드가 기다린다고."
  },
  "103": {
   "jp": "e4b39b8f",
   "kr": "너희도 카지노에서 놀려고"
  },
  "104": {
   "jp": "aa924662",
   "kr": "일부러 여행을 해서"
  },
  "105": {
   "jp": "6abe4873",
   "kr": "이 마을까지 온 건가?"
  },
  "106": {
   "jp": "77f51718",
   "kr": "아니, 딱히 그럴 생각으로"
  },
  "107": {
   "jp": "6f5fe4af",
   "kr": "들른 건 아니지만…"
  },
  "108": {
   "jp": "88e2705d",
   "kr": "괜찮다니까, 숨기지 않아도."
  },
  "109": {
   "jp": "dccb9cd1",
   "kr": "실컷 놀다 가면 돼."
  },
  "110": {
   "jp": "2b5fb2a6",
   "kr": "어라? 아이 일행도 있나?"
  },
  "111": {
   "jp": "77540172",
   "kr": "이 나라 카지노는 아이도 괜찮으니까,"
  },
  "112": {
   "jp": "5066000d",
   "kr": "안심하고 놀다 가렴."
  },
  "113": {
   "jp": "ca4fcf5f",
   "kr": "여기는 카지노의 마을."
  },
  "114": {
   "jp": "14c5c695",
   "kr": "챠놈에서 가장 부유한"
  },
  "115": {
   "jp": "39a2d08d",
   "kr": "꽃의 도시, 다이스란다."
  },
  "116": {
   "jp": "e3a6ffd7",
   "kr": "당연한 얘기지만"
  },
  "117": {
   "jp": "8d062fd6",
   "kr": "도박이란 이기고 있을 땐 즐겁지만,"
  },
  "118": {
   "jp": "d5d027a9",
   "kr": "지고 있을 땐, 무척 분하지."
  },
  "119": {
   "jp": "112b82bf",
   "kr": "분하니까 그만 한 번 더 하게 되고,"
  },
  "120": {
   "jp": "18e7e405",
   "kr": "더 분해진다. 거기가 함정이지."
  },
  "121": {
   "jp": "5bbc76ab",
   "kr": "빠져들면 인생 끝이야."
  },
  "122": {
   "jp": "575378d2",
   "kr": "어디로 향하시든"
  },
  "123": {
   "jp": "20ac5d6f",
   "kr": "강력한 무기는 여행 필수품입니다."
  },
  "124": {
   "jp": "9702c5f9",
   "kr": "유비무환이지요."
  },
  "125": {
   "jp": "4f045262",
   "kr": "어서 오세요."
  },
  "126": {
   "jp": "eca1a1a2",
   "kr": "다이스의 무기점입니다!"
  },
  "127": {
   "jp": "c62ee462",
   "kr": "바꾸실 거라면, 지금이 기회죠."
  },
  "128": {
   "jp": "e53bb7d0",
   "kr": "마음에 드시는 물건이 있으신지요?"
  },
  "129": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "130": {
   "jp": "ee93304e",
   "kr": "입니다."
  },
  "131": {
   "jp": "b0d9acf4",
   "kr": "짐이 많으면"
  },
  "132": {
   "jp": "e3fd4ecb",
   "kr": "때로는 여행에 방해가 됩니다."
  },
  "133": {
   "jp": "8fd0ffe1",
   "kr": "무엇을 사들일까요?"
  },
  "134": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "135": {
   "jp": "5aa7b82b",
   "kr": "에 사들이겠습니다."
  },
  "136": {
   "jp": "60f2accf",
   "kr": "환전율은 1 Goa당 14 Pia입니다."
  },
  "137": {
   "jp": "11206e72",
   "kr": "좀 낮지만, 챠놈에서는"
  },
  "138": {
   "jp": "e5b83bcb",
   "kr": "이게 시세랍니다."
  },
  "139": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "140": {
   "jp": "0f41ed9b",
   "kr": "을 치르겠습니다."
  },
  "141": {
   "jp": "e32b0c00",
   "kr": "라피카가 모이면"
  },
  "142": {
   "jp": "b41a514b",
   "kr": "또 들러 주세요."
  },
  "143": {
   "jp": "96a0ae96",
   "kr": "그렇습니까, 아쉽네요."
  },
  "144": {
   "jp": "0f938817",
   "kr": "그 밖에 볼일은 없으신지요?"
  },
  "145": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "146": {
   "jp": "656e07d8",
   "kr": "또 찾아 주시기를 기다리겠습니다."
  },
  "147": {
   "jp": "2d000fa1",
   "kr": "안녕, 나는 우돌에서"
  },
  "148": {
   "jp": "3c76bc6e",
   "kr": "여행을 왔는데,"
  },
  "149": {
   "jp": "d3c31171",
   "kr": "다이스는 소문 이상으로 화려한 나라네."
  },
  "150": {
   "jp": "5b79fc63",
   "kr": "그러고 보니, 소문으로는 다이스 마을 옆에"
  },
  "151": {
   "jp": "530fdfaa",
   "kr": "다츠라는 마을이 있다고 들었는데,"
  },
  "152": {
   "jp": "df9480e7",
   "kr": "마을 사람들 얘기에는 안 나오네."
  },
  "153": {
   "jp": "6c2f1e71",
   "kr": "알고 있나?"
  },
  "154": {
   "jp": "6c913692",
   "kr": "다츠란 마을엔 독 늪이 있는데 그게 아무래도"
  },
  "155": {
   "jp": "d87f68b4",
   "kr": "마녀의 저주로 생겼다는 얘기야."
  },
  "156": {
   "jp": "adda0bba",
   "kr": "자세한 건 모르지만,"
  },
  "157": {
   "jp": "1efeb40e",
   "kr": "역시 마녀는 무서운가 봐."
  },
  "158": {
   "jp": "8f47cb15",
   "kr": "우리 남편은 날마다 저를 두고"
  },
  "159": {
   "jp": "c5f1a184",
   "kr": "카지노에 나가요."
  },
  "160": {
   "jp": "ddf95df6",
   "kr": "좀 더 성실하게 일해 줬으면 좋겠어요."
  },
  "161": {
   "jp": "fd3109a4",
   "kr": "다이스에 살면서 이런 말 하기엔 뭣하지만요."
  },
  "162": {
   "jp": "cf2c750f",
   "kr": "아무리 이 마을이 부유해져도"
  },
  "163": {
   "jp": "0d9b12d8",
   "kr": "어딘가 잘못됐다 생각지 않으세요?"
  },
  "164": {
   "jp": "4f4bdb23",
   "kr": "이 마을이 훌륭한 마을이라는 건 거짓말이야."
  },
  "165": {
   "jp": "9e73c172",
   "kr": "옆 마을 다츠를 보면"
  },
  "166": {
   "jp": "25e5d408",
   "kr": "분명, 그런 생각은 안 들 거야."
  },
  "167": {
   "jp": "5df92f4c",
   "kr": "같은 챠놈 나라 안에서,"
  },
  "168": {
   "jp": "adf86ab6",
   "kr": "이렇게 빈부 차가 있는걸."
  },
  "169": {
   "jp": "8758fa64",
   "kr": "뭔가 잘못된 거야."
  },
  "170": {
   "jp": "93614302",
   "kr": "자, 오늘은 뭘로 승부를"
  },
  "171": {
   "jp": "db668af2",
   "kr": "걸어야 좋을까…"
  },
  "172": {
   "jp": "70022b0b",
   "kr": "응? 여어, 마침 잘 와 줬어."
  },
  "173": {
   "jp": "f301042e",
   "kr": "이제부터 카지노로"
  },
  "174": {
   "jp": "70d13f3b",
   "kr": "나가 볼 참인데 말이야."
  },
  "175": {
   "jp": "0a43332d",
   "kr": "카드로 승부할까."
  },
  "176": {
   "jp": "6f4ddece",
   "kr": "아니면 룰렛으로 승부할까."
  },
  "177": {
   "jp": "9e7471b3",
   "kr": "망설여져서 좀처럼 정하기가 어려워."
  },
  "178": {
   "jp": "362629f9",
   "kr": "저기, 너희. 카드랑 룰렛 중에,"
  },
  "179": {
   "jp": "ff50c060",
   "kr": "오늘의 나라면, 어느 쪽을 해야"
  },
  "180": {
   "jp": "8384417c",
   "kr": "운이 따를 것 같아?"
  },
  "181": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "182": {
   "jp": "e1b853f3",
   "kr": "너희가 말한 대로 할게."
  },
  "183": {
   "jp": "1e688df5",
   "kr": "카드가 좋아"
  },
  "184": {
   "jp": "7954e203",
   "kr": "룰렛이야"
  },
  "185": {
   "jp": "6d5885dd",
   "kr": "스스로 정해"
  },
  "186": {
   "jp": "8dddf343",
   "kr": "관두는 게 좋아"
  },
  "187": {
   "jp": "727a1137",
   "kr": "그러지 말고, 응."
  },
  "188": {
   "jp": "7c477646",
   "kr": "조언해 줘."
  },
  "189": {
   "jp": "c943bf57",
   "kr": "그래, 카드가 좋을 것 같아?"
  },
  "190": {
   "jp": "7128a847",
   "kr": "좋았어. 오늘은 카드로"
  },
  "191": {
   "jp": "7f394565",
   "kr": "크게 따 주겠어."
  },
  "192": {
   "jp": "e9ab7fa4",
   "kr": "룰렛이라."
  },
  "193": {
   "jp": "4a2f956a",
   "kr": "응. 그게 좋을지도 모르겠어."
  },
  "194": {
   "jp": "5c68c5ed",
   "kr": "빙글빙글 돌아서 대박이다!"
  },
  "195": {
   "jp": "d07a208f",
   "kr": "아니, 그렇긴 한데…"
  },
  "196": {
   "jp": "444331e1",
   "kr": "이런 건 남이 정해 주는 편이"
  },
  "197": {
   "jp": "f4115029",
   "kr": "왠지 마음이 편하단 말이야."
  },
  "198": {
   "jp": "5dd076b4",
   "kr": "자, 부탁이니까 정해 줘."
  },
  "199": {
   "jp": "27ce9572",
   "kr": "그렇지."
  },
  "200": {
   "jp": "d1efc172",
   "kr": "역시 오늘은 카지노에 가는 건"
  },
  "201": {
   "jp": "e063409c",
   "kr": "그만두기로 할까."
  },
  "202": {
   "jp": "c8b2bfc3",
   "kr": "그렇게 늘 운이 따르리란"
  },
  "203": {
   "jp": "a4fda5b1",
   "kr": "법은 없으니까."
  },
  "204": {
   "jp": "f405d8e9",
   "kr": "반성합니다. 미안해요."
  },
  "205": {
   "jp": "04e7a259",
   "kr": "챠놈은 작은 나라지만 말이야,"
  },
  "206": {
   "jp": "36c4b6b5",
   "kr": "20년간 이어 온 카지노 정책이 결실을 맺어"
  },
  "207": {
   "jp": "1032fbd7",
   "kr": "이렇게 부유해진 거야."
  },
  "208": {
   "jp": "c0c36c50",
   "kr": "옛날엔 도박으로 번영하다니,"
  },
  "209": {
   "jp": "5b12fad7",
   "kr": "안 될 일이라는 의견도 있었지만,"
  },
  "210": {
   "jp": "4fb2669f",
   "kr": "지금은 아무도 그런 말은 안 해."
  },
  "211": {
   "jp": "64262792",
   "kr": "아…강해지고 싶어."
  },
  "212": {
   "jp": "5671e2a1",
   "kr": "일류 검사가 돼서"
  },
  "213": {
   "jp": "be9cb0ba",
   "kr": "여자애한테 인기 끌고 싶어."
  },
  "214": {
   "jp": "1b0321fa",
   "kr": "설마 싶지만"
  },
  "215": {
   "jp": "587699fd",
   "kr": "검사교본을 3권 전부 갖고 있진 않겠지?"
  },
  "216": {
   "jp": "5590ff80",
   "kr": "어?"
  },
  "217": {
   "jp": "e832e305",
   "kr": "그 책이라면 갖고 있어."
  },
  "218": {
   "jp": "06427eae",
   "kr": "저, 정말이야!?"
  },
  "219": {
   "jp": "6325fa0d",
   "kr": "괜찮으면, 이"
  },
  "220": {
   "jp": "a991fa92",
   "kr": "하고"
  },
  "221": {
   "jp": "f01fbd70",
   "kr": "교환해 주지 않을래?"
  },
  "222": {
   "jp": "48c98d2f",
   "kr": "응, 교환해 주지 않을래?"
  },
  "223": {
   "jp": "b047fa1f",
   "kr": "응, 좋아."
  },
  "224": {
   "jp": "42a4dafd",
   "kr": "정말 고마워!"
  },
  "225": {
   "jp": "3861228c",
   "kr": "이 은혜 잊지 않을게!"
  },
  "226": {
   "jp": "c2cf4dc2",
   "kr": "쥬리오는 검사교본 3권과 바꿔"
  },
  "227": {
   "jp": "e9d91b01",
   "kr": ", 손에 넣었다."
  },
  "228": {
   "jp": "8c8bbc2c",
   "kr": "으〜음."
  },
  "229": {
   "jp": "320c43e6",
   "kr": "싫어."
  },
  "230": {
   "jp": "708c1220",
   "kr": "그, 그런〜"
  },
  "231": {
   "jp": "58fe0a61",
   "kr": "하지만 싫다면 어쩔 수 없나…"
  },
  "232": {
   "jp": "d4c6b461",
   "kr": "너희가 바꿔 준 책을 읽고"
  },
  "233": {
   "jp": "6c049840",
   "kr": "검사가 될 테다!"
  },
  "234": {
   "jp": "fe720ae2",
   "kr": "인기 많아지면 좋겠네."
  }
 }
}