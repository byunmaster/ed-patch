{
 "archive": "/SCE4/SC400.DAT",
 "member": "..\\DATA\\OT0050.BIN",
 "lines": {
  "0": {
   "jp": "2a8d61a9",
   "kr": "마을 구역"
  },
  "1": {
   "jp": "83ca85b3",
   "kr": "도구상 라키스"
  },
  "2": {
   "jp": "ed54eb31",
   "kr": "케일 할머니"
  },
  "3": {
   "jp": "ccb95ba0",
   "kr": "파르마"
  },
  "4": {
   "jp": "b7c4671b",
   "kr": "포트"
  },
  "5": {
   "jp": "790e56cd",
   "kr": "필로 선생"
  },
  "6": {
   "jp": "2ddc226e",
   "kr": "올도스는 성스러운 도시라서"
  },
  "7": {
   "jp": "5054afe5",
   "kr": "마을 안에서는 무기 판매는 못 해."
  },
  "8": {
   "jp": "f0fa9cf9",
   "kr": "혹시 무기가 필요하다면"
  },
  "9": {
   "jp": "b98a650c",
   "kr": "관문 밖에 노점이 있으니 가 보라고."
  },
  "10": {
   "jp": "19dd68c0",
   "kr": "여어, 어서 와."
  },
  "11": {
   "jp": "4eb7dec1",
   "kr": "우리 가게엔 자랑거리 물건이 가득하다고."
  },
  "12": {
   "jp": "2a11119e",
   "kr": "뭐, 좀 보고 가라고."
  },
  "13": {
   "jp": "d14b58e9",
   "kr": "무엇을 찾으시나요?"
  },
  "14": {
   "jp": "dc7c84a6",
   "kr": "호오"
  },
  "15": {
   "jp": "5172e78c",
   "kr": "이라니 보는 눈이 높으시네요."
  },
  "16": {
   "jp": "621fdfba",
   "kr": "비밀입니다만"
  },
  "17": {
   "jp": "cc04ff43",
   "kr": "저희 물건에는 올도스의 마법을 구사해서"
  },
  "18": {
   "jp": "b132e9ea",
   "kr": "여러 효과를 담아 뒀어요."
  },
  "19": {
   "jp": "2ebd2b9d",
   "kr": "값은"
  },
  "20": {
   "jp": "d69283b9",
   "kr": "입니다만"
  },
  "21": {
   "jp": "4287a36c",
   "kr": "꼭 도움이 될 거예요."
  },
  "22": {
   "jp": "7dba4922",
   "kr": "무엇을 파시겠습니까?"
  },
  "23": {
   "jp": "941f0265",
   "kr": "인가요?"
  },
  "24": {
   "jp": "67afcad1",
   "kr": "에 사들이겠습니다."
  },
  "25": {
   "jp": "89dc036a",
   "kr": "환전율은 1 Goa당 15 Pia입니다."
  },
  "26": {
   "jp": "74b4488e",
   "kr": "괜찮습니까?"
  },
  "27": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "28": {
   "jp": "ee93304e",
   "kr": "입니다."
  },
  "29": {
   "jp": "f90ebd6f",
   "kr": "라피카가 없으시네요."
  },
  "30": {
   "jp": "2445d3bb",
   "kr": "모이면 언제든지 오세요."
  },
  "31": {
   "jp": "a7c5ef2c",
   "kr": "그 밖에 볼일은 없으신가요?"
  },
  "32": {
   "jp": "2d56d0fa",
   "kr": "또 갖고 싶어지면"
  },
  "33": {
   "jp": "bf1e7633",
   "kr": "언제든 들러 줘."
  },
  "34": {
   "jp": "6e325b82",
   "kr": "어머, 귀여운 순례자로구나."
  },
  "35": {
   "jp": "e4dba546",
   "kr": "떠나보낸 부모님은"
  },
  "36": {
   "jp": "851f287c",
   "kr": "무척 걱정하셨겠구나."
  },
  "37": {
   "jp": "73a60aca",
   "kr": "대성당 참배가 끝나거든"
  },
  "38": {
   "jp": "eaae98d8",
   "kr": "딴 데 들르지 말고"
  },
  "39": {
   "jp": "5f2759af",
   "kr": "곧장 돌아가렴."
  },
  "40": {
   "jp": "85a861a8",
   "kr": "올도스 대성당에 계시는"
  },
  "41": {
   "jp": "df04411c",
   "kr": "신관님들의 말씀은"
  },
  "42": {
   "jp": "c5becaa6",
   "kr": "정말 귀하답니다."
  },
  "43": {
   "jp": "24a64eeb",
   "kr": "분명 앞으로"
  },
  "44": {
   "jp": "3a152945",
   "kr": "인생의 지침이 될 거예요."
  },
  "45": {
   "jp": "0d20a088",
   "kr": "어라, 전에 필로 선생님을"
  },
  "46": {
   "jp": "6a37efc3",
   "kr": "찾던 형아네."
  },
  "47": {
   "jp": "973682c4",
   "kr": "그 친구가 아팠던 거지?"
  },
  "48": {
   "jp": "406f53aa",
   "kr": "역시 명의야, 필로 선생님."
  },
  "49": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "50": {
   "jp": "514ceffe",
   "kr": "뭐야."
  },
  "51": {
   "jp": "031a39ac",
   "kr": "필로 선생님이 고친 게 아니야?"
  },
  "52": {
   "jp": "296c751d",
   "kr": "그래도 기운 차려서 다행이다."
  },
  "53": {
   "jp": "1014ab10",
   "kr": "필로 선생님은 올도스의 명의야."
  },
  "54": {
   "jp": "1484eafe",
   "kr": "형아 친구가 아픈 거지?"
  },
  "55": {
   "jp": "bf323f69",
   "kr": "얼른 나으면 좋겠다."
  },
  "56": {
   "jp": "9f7a3c9d",
   "kr": "필로 선생님이라면"
  },
  "57": {
   "jp": "50a433f9",
   "kr": "아까 이 앞 풍차 있는 데서 만났어."
  },
  "58": {
   "jp": "5f898eca",
   "kr": "분명 아직 계실 거야."
  },
  "59": {
   "jp": "42d0a304",
   "kr": "아름다운 올도스 거리 중에서도"
  },
  "60": {
   "jp": "13842d8a",
   "kr": "역시 이 자리가 제일 좋단 말이지."
  },
  "61": {
   "jp": "5b2dcd1b",
   "kr": "저기요."
  },
  "62": {
   "jp": "885de79e",
   "kr": "저, 필로 선생님이신가요?"
  },
  "63": {
   "jp": "3e3e9645",
   "kr": "아, 그렇다만."
  },
  "64": {
   "jp": "ea066033",
   "kr": "다행이에요."
  },
  "65": {
   "jp": "a4267b28",
   "kr": "겨우 찾았어요."
  },
  "66": {
   "jp": "92190265",
   "kr": "함께 여행하는 친구가"
  },
  "67": {
   "jp": "dcd94018",
   "kr": "환술사한테 저주를 받아서"
  },
  "68": {
   "jp": "cd0fc11a",
   "kr": "큰일이에요."
  },
  "69": {
   "jp": "8b61cd02",
   "kr": "환술사의 저주라고!"
  },
  "70": {
   "jp": "1d2ba825",
   "kr": "그거참, 정말 큰일이군."
  },
  "71": {
   "jp": "2212f88a",
   "kr": "어디에 있는가?"
  },
  "72": {
   "jp": "0c6dae28",
   "kr": "여관에요."
  },
  "73": {
   "jp": "01a21223",
   "kr": "좋아, 당장 가지!"
  }
 }
}