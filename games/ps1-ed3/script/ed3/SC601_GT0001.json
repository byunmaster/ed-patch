  },
  "4": {
   "jp": "51b21381",
   "kr": "로갈"
  },
  "5": {
   "jp": "fef10d32",
   "kr": "레르고"
  },
  "6": {
   "jp": "9655306a",
   "kr": "도마치"
  },
  "7": {
   "jp": "fd743e3c",
   "kr": "프리카"
  },
  "8": {
   "jp": "3ef5800e",
   "kr": "마르셰"
  },
  "9": {
   "jp": "3c4bb93f",
   "kr": "카피레"
  },
  "10": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "11": {
   "jp": "8d45b695",
   "kr": "투기장에서 탈출한 쥬리오와 바다트는"
  },
  "12": {
   "jp": "d325d9c9",
   "kr": "수상한 여자 안내대로"
  },
  "13": {
   "jp": "3c8416f6",
   "kr": "일단 아가씨의 집에 몸을 숨기기로 했다."
  },
  "14": {
   "jp": "26bc8496",
   "kr": "여자"
  },
  "15": {
   "jp": "f5aae462",
   "kr": "저는 나제."
  },
  "16": {
   "jp": "9a76d373",
   "kr": "이 집 안이라면 안심이에요."
  },
  "17": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "18": {
   "jp": "31e9f2a6",
   "kr": "어째서 우릴 구해 준 거지?"
  },
  "19": {
   "jp": "7077711f",
   "kr": "칸다타 집을 부순 게"
  },
  "20": {
   "jp": "17c255dc",
   "kr": "당신들이 아니란 걸 알고 있으니까요."
  },
  "21": {
   "jp": "91ee54db",
   "kr": "죄 없는 사람이 잡혀 있는 걸"
  },
  "22": {
   "jp": "3961e735",
   "kr": "모른 척할 수는 없으니까요…"
  },
  "23": {
   "jp": "2f5df9c8",
   "kr": "흐음, 그런가."
  },
  "24": {
   "jp": "c722abcf",
   "kr": "고맙군."
  },
  "25": {
   "jp": "782c4e91",
   "kr": "저기, 나제 씨."
  },
  "26": {
   "jp": "c6f252ae",
   "kr": "크리스라는 여자애"
  },
  "27": {
   "jp": "c355a861",
   "kr": "모르시나요?"
  },
  "28": {
   "jp": "327fcd89",
   "kr": "크리스?"
  },
  "29": {
   "jp": "63ff094c",
   "kr": "크리스티나라고 해요."
  },
  "30": {
   "jp": "5237af4c",
   "kr": "폭발에 휩쓸려서 감옥까지는 같이 있었는데"
  },
  "31": {
   "jp": "67a1d774",
   "kr": "칸다타라는 놈한테 끌려가 버렸어요."
  },
  "32": {
   "jp": "000f5f97",
   "kr": "어머, 칸다타한테…"
  },
  "33": {
   "jp": "f7a40a90",
   "kr": "그거 큰일이에요."
  },
  "34": {
   "jp": "2a3113d2",
   "kr": "칸다타는 아주 나쁜 놈이거든요."
  },
  "35": {
   "jp": "e49b6606",
   "kr": "걱정이에요…"
  },
  "36": {
   "jp": "6b1d2769",
   "kr": "그러고 보니 칸다타가 이웃 기드넬 마을의"
  },
  "37": {
   "jp": "4465e30d",
   "kr": "거상 우르기드의 시중들 사람을 찾는다는"
  },
  "38": {
   "jp": "43f4cd01",
   "kr": "소문을 들은 적이 있는데…"
  },
  "39": {
   "jp": "a9c703a7",
   "kr": "설마, 기드넬로…"
  },
  "40": {
   "jp": "80c0b58b",
   "kr": "이거 큰일이군."
  },
  "41": {
   "jp": "59e26abb",
   "kr": "얼른 사실을 밝혀내서 그렇다면"
  },
  "42": {
   "jp": "f138a913",
   "kr": "서둘러 구해야겠어."
  },
  "43": {
   "jp": "12a1255c",
   "kr": "엇, 바다트."
  },
  "44": {
   "jp": "b1519e6f",
   "kr": "도와주는 거야?"
  },
  "45": {
   "jp": "ada9054e",
   "kr": "당연하지."
  },
  "46": {
   "jp": "1d278f3c",
   "kr": "거기까지 알고 못 본 척할 수 있겠어."
  },
  "47": {
   "jp": "6d56d99e",
   "kr": "난 강해지려고 격투를 하는 게 아니야."
  },
  "48": {
   "jp": "5ac3e4ae",
   "kr": "강해져서 사람을 구하려고"
  },
  "49": {
   "jp": "88a0bd60",
   "kr": "날 단련하는 거다. 맡겨 둬."
  },
  "50": {
   "jp": "dd79e273",
   "kr": "멋지다."
  },
  "51": {
   "jp": "9764b9ff",
   "kr": "그렇지."
  },
  "52": {
   "jp": "5a89d9d4",
   "kr": "바다트가 파티에 합류했다."
  },
  "53": {
   "jp": "938eae7c",
   "kr": "참, 이걸 쓰세요."
  },
  "54": {
   "jp": "0987adb9",
   "kr": "나제는 베일을 두 장 내밀었다."
  },
  "55": {
   "jp": "ce2c10c8",
   "kr": "얼굴을 가리면"
  },
  "56": {
   "jp": "bb202ac7",
   "kr": "마을에서도 자유롭게 다닐 수 있죠."
  },
  "57": {
   "jp": "df45fd61",
   "kr": "고맙군."
  },
  "58": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "59": {
   "jp": "cf38b16b",
   "kr": "쥬리오 일행은 베일을 써 보았다."
  },
  "60": {
   "jp": "0ce1f022",
   "kr": "둘 다 제법 잘 어울리네요."
  },
  "61": {
   "jp": "0482e59f",
   "kr": "이제 안심하고 밖을 걸을 수 있죠."
  },
  "62": {
   "jp": "938930e7",
   "kr": "칸다타의 집은 이 집 동쪽 두 채예요."
  },
  "63": {
   "jp": "3c643a5e",
   "kr": "한 채는 사막의 흑표범한테 부서졌지만"
  },
  "64": {
   "jp": "e3e95afe",
   "kr": "나머지 한 채는 지금도 도구점을 해요."
  },
  "65": {
   "jp": "afdce0b3",
   "kr": "가게에서 크리스 씨의 소식을 들을 수도"
  },
  "66": {
   "jp": "3220ba45",
   "kr": "모르겠네요."
  },
  "67": {
   "jp": "7d835e25",
   "kr": "네. 나제 씨, 여러모로 고마워요."
  },
  "68": {
   "jp": "91de19e1",
   "kr": "당장 칸다타의 도구점을 알아볼게요."
  },
  "69": {
   "jp": "7d557a31",
   "kr": "어머, 두 분."
  },
  "70": {
   "jp": "6b13f9bd",
   "kr": "무슨 일이야?"
  },
  "71": {
   "jp": "00349b04",
   "kr": "조금 마을이 소란스러워서"
  },
  "72": {
   "jp": "05b620eb",
   "kr": "돌아왔을 뿐이야."
  },
  "73": {
   "jp": "5b10574f",
   "kr": "미아 아니에요."
  },
  "74": {
   "jp": "2c8727f1",
   "kr": "그렇다면 다행이지만"
  },
  "75": {
   "jp": "7d557a31",
   "kr": "어머, 두 분."
  },
  "76": {
   "jp": "6b13f9bd",
   "kr": "무슨 일이야?"
  },
  "77": {
   "jp": "dc9c3c15",
   "kr": "아무래도 크리스는 칸다타한테 끌려가서"
  },
  "78": {
   "jp": "1d2260bb",
   "kr": "기드넬로 간 모양인데"
  },
  "79": {
   "jp": "65dfbd2e",
   "kr": "병사가 마을 출구에서 안 보내 주는 거야."
  },
  "80": {
   "jp": "1a1d141a",
   "kr": "사막의 흑표범이 잡힐 때까지"
  },
  "81": {
   "jp": "4aa4ac0e",
   "kr": "경계가 풀릴 것 같지 않아."
  },
  "82": {
   "jp": "edececbd",
   "kr": "어머…"
  },
  "83": {
   "jp": "01236bdc",
   "kr": "얼른 기드넬로 가고 싶은데"
  },
  "84": {
   "jp": "ae1fd935",
   "kr": "우리끼리는"
  },
  "85": {
   "jp": "607ec919",
   "kr": "마을에서 내보내 주질 않아요."
  },
  "86": {
   "jp": "7b77d837",
   "kr": "알았어요."
  },
  "87": {
   "jp": "89c6c35b",
   "kr": "그럼, 제가 병사한테 말을 해 둘게요."
  },
  "88": {
   "jp": "ab075732",
   "kr": "안면 있는 병사라면"
  },
  "89": {
   "jp": "abecb216",
   "kr": "말을 들어 줄 거예요."
  },
  "90": {
   "jp": "523d6aa4",
   "kr": "참, 유적을 지나는 북쪽 길과"
  },
  "91": {
   "jp": "71dfd6d7",
   "kr": "서쪽으로 도는 가도 두 길이 있는데"
  },
  "92": {
   "jp": "5f703bea",
   "kr": "어느 쪽으로 갈 생각이에요?"
  },
  "93": {
   "jp": "883819e5",
   "kr": "유적 길"
  },
  "94": {
   "jp": "a5aacc17",
   "kr": "서쪽 가도"
  },
  "95": {
   "jp": "fbd90c50",
   "kr": "유적을 지나는 길이군요."
  },
  "96": {
   "jp": "5a072961",
   "kr": "서쪽 가도군요."
  },
  "97": {
   "jp": "7b77d837",
   "kr": "알았어요."
  },
  "98": {
   "jp": "de07b18c",
   "kr": "자, 당장 가요."
  },
  "99": {
   "jp": "78fa4657",
   "kr": "조심하세요."
  },
  "100": {
   "jp": "14485747",
   "kr": "저는 아무것도 해 드릴 수 없지만"
  },
  "101": {
   "jp": "984b5719",
   "kr": "크리스 씨가 무사하기를"
  },
  "102": {
   "jp": "4dbf74cd",
   "kr": "진심으로 바라고 있어요."
  },
  "103": {
   "jp": "acd0f142",
   "kr": "뭔가?"
  },
  "104": {
   "jp": "72fc1720",
   "kr": "도구 사러 온 거야?"
  },
  "105": {
   "jp": "f56263fc",
   "kr": "우리 물건은 비싸."
  },
  "106": {
   "jp": "f1f4f381",
   "kr": "Pia는 두둑이 갖고 있겠지?"
  },
  "107": {
   "jp": "42f2e35e",
   "kr": "너, 궁상맞은 낯짝이네."
  },
  "108": {
   "jp": "ee133e0b",
   "kr": "앗, 그렇구나."
  },
  "109": {
   "jp": "e87c607f",
   "kr": "쇼핑이 아니라 뒷일 말이냐?"
  },
  "110": {
   "jp": "3321edc8",
   "kr": "안됐지만 우리 남편이라면"
  },
  "111": {
   "jp": "34969b53",
   "kr": "지금 기드넬에 가 있어."
  },
  "112": {
   "jp": "6dc4741d",
   "kr": "여자애를 데리고 우르기드 님한테로 말이야."
  },
  "113": {
   "jp": "abf55d13",
   "kr": "그 애도 참 딱하지…"
  },
  "114": {
   "jp": "dad5cfc5",
   "kr": "뭐야, 아닌 거야?"
  },
  "115": {
   "jp": "3dbac7bf",
   "kr": "헷갈리게 하네."
  },
  "116": {
   "jp": "19b5eb6d",
   "kr": "이런, 궁상스러운 손님이로군."
  },
  "117": {
   "jp": "f56263fc",
   "kr": "우리 물건은 비싸."
  },
  "118": {
   "jp": "b08d3915",
   "kr": "미안하지만 돌아가 줘."
  },
  "119": {
   "jp": "92b245b0",
   "kr": "너한테 팔 물건은 없어."
  },
  "120": {
   "jp": "0a0e33d4",
   "kr": "자, 돌아가, 돌아가."
  },
  "121": {
   "jp": "767a5c62",
   "kr": "영업 방해야."
  },
  "122": {
   "jp": "f64f6c70",
   "kr": "대단하지, 이 부서진 꼴…"
  },
  "123": {
   "jp": "f8a635c4",
   "kr": "하하하, 꼴좋다."
  },
  "124": {
   "jp": "ded7178f",
   "kr": "이렇게 엉망진창이 돼 버렸으니."
  },
  "125": {
   "jp": "6c8dd5df",
   "kr": "뒷정리를 부탁받았는데"
  },
  "126": {
   "jp": "a0e3bd30",
   "kr": "이래선 어쩔 도리가 없잖아."
  },
  "127": {
   "jp": "76eeaf98",
   "kr": "하지만 괜찮아."
  },
  "128": {
   "jp": "c831a3f5",
   "kr": "칸다타 집이 이렇게 돼서"
  },
  "129": {
   "jp": "c43a7b21",
   "kr": "어쩐지 속이 후련해졌다고."
  },
  "130": {
   "jp": "b7914182",
   "kr": "사막의 흑표범 만세다."
  },
  "131": {
   "jp": "59b75c55",
   "kr": "기드나 나라는 말이지"
  },
  "132": {
   "jp": "ed0cc286",
   "kr": "거상 우르기드가 다스리고 있다네."
  },
  "133": {
   "jp": "bb234c86",
   "kr": "그래서 이 나라에선 상인이"
  },
  "134": {
   "jp": "c5e9846d",
   "kr": "유난히 잘난 척 굴고 있는 게지."
  },
  "135": {
   "jp": "8889e8fd",
   "kr": "거상 우르기드는"
  },
  "136": {
   "jp": "f965737a",
   "kr": "기드넬의 큰 저택에 살고 있다네."
  },
  "137": {
   "jp": "9ff0a1a8",
   "kr": "나라의 부를 독차지하고서"
  },
  "138": {
   "jp": "0582070b",
   "kr": "참으로 팔자도 좋지."
  },
  "139": {
   "jp": "61760f2d",
   "kr": "큰 소리로는 말 못 하지만"
  },
  "140": {
   "jp": "bbceb743",
   "kr": "칸다타는 우르기드한테 꼼짝도 못 해."
  },
  "141": {
   "jp": "b7b7dcbe",
   "kr": "이 마을에선 으스대지만"
  },
  "142": {
   "jp": "31de51c0",
   "kr": "결국 우물 안 개구리야."
  },
  "143": {
   "jp": "20ee5389",
   "kr": "칸다타는 가끔 공물을 들고"
  },
  "144": {
   "jp": "4e832955",
   "kr": "기드넬로 비위 맞추러 가거든."
  },
  "145": {
   "jp": "7fa9ff7c",
   "kr": "지금도 분명 가 있을 거야."
  },
  "146": {
   "jp": "863d4011",
   "kr": "어머, 나그네네."
  },
  "147": {
   "jp": "2ac2d7c4",
   "kr": "여기 있는 내가 말하기도 이상하지만"
  },
  "148": {
   "jp": "1be38f51",
   "kr": "이 마을은 나그네에게 위험해."
  },
  "149": {
   "jp": "3cc3dec9",
   "kr": "조금이라도 수상해 보이면"
  },
  "150": {
   "jp": "ae3ba98a",
   "kr": "병사에게 붙잡혀서"
  },
  "151": {
   "jp": "828ad620",
   "kr": "투기장에서 싸우게 되거든."
  },
  "152": {
   "jp": "a4ff1b18",
   "kr": "괜한 소리가 아니니까"
  },
  "153": {
   "jp": "346ade15",
   "kr": "어서 이 마을은 떠나는 게 좋아요."
  },
  "154": {
   "jp": "ec3191a7",
   "kr": "사막의 흑표범 소동으로"
  },
  "155": {
   "jp": "d5f31ad4",
   "kr": "병사들이 바짝 날이 서 있으니까."
  },
  "156": {
   "jp": "0fe67b72",
   "kr": "요즘"
  },
  "157": {
   "jp": "577ef774",
   "kr": "사막의 흑표범이라는 민중의 편이"
  },
  "158": {
   "jp": "93a7a66f",
   "kr": "이 근처에 나타난대."
  },
  "159": {
   "jp": "d13ad9c7",
   "kr": "아무래도 그 정체는 여자인 모양인데."
  },
  "160": {
   "jp": "245652f6",
   "kr": "얼굴을 본 사람은 없어. 멋지지."
  },
  "161": {
   "jp": "993065d8",
   "kr": "앞으로도 활약해 줬으면 해."
  },
