{
 "archive": "/SCE2/SC204.DAT",
 "member": "..\\DATA\\CR1100.BIN",
 "lines": {
  "0": {
   "jp": "7ae9c4c7",
   "kr": "독늪 지대"
  },
  "1": {
   "jp": "5d2923e0",
   "kr": "키타라 악사 트로바"
  },
  "2": {
   "jp": "faf407c6",
   "kr": "남자 목소리"
  },
  "3": {
   "jp": "2d3fe42f",
   "kr": "어쩌지…어쩌지…"
  },
  "4": {
   "jp": "eb9a2109",
   "kr": "이쪽인가… 저쪽인가…"
  },
  "5": {
   "jp": "c290a15a",
   "kr": "안 보이네…"
  },
  "6": {
   "jp": "6df962ab",
   "kr": "…?"
  },
  "7": {
   "jp": "686e9958",
   "kr": "트로바 씨 짐을 찾아 주자."
  },
  "8": {
   "jp": "66874312",
   "kr": "이쪽으로 가면"
  },
  "9": {
   "jp": "9c9670e5",
   "kr": "다이스로 돌아가 버려."
  },
  "10": {
   "jp": "e916bf2a",
   "kr": "앗, 저런 데에 사람이 있어."
  },
  "11": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "12": {
   "jp": "db0fd008",
   "kr": "뭘 하는 걸까."
  },
  "13": {
   "jp": "04701f7e",
   "kr": "뭔가 찾으세요?"
  },
  "14": {
   "jp": "35a1a029",
   "kr": "아까 갑자기 마수에게 습격당해 버려서."
  },
  "15": {
   "jp": "05ba4850",
   "kr": "소중한 키타라를"
  },
  "16": {
   "jp": "43a2a472",
   "kr": "강에 떨어뜨리고 말았어."
  },
  "17": {
   "jp": "3cd7cc1d",
   "kr": "가라앉았으려나."
  },
  "18": {
   "jp": "17cacd86",
   "kr": "어머 큰일이네요."
  },
  "19": {
   "jp": "64b13c45",
   "kr": "방금 키타라를 떨어뜨렸다고 했는데,"
  },
  "20": {
   "jp": "a47e0835",
   "kr": "혹시 아저씨,"
  },
  "21": {
   "jp": "4ef42c25",
   "kr": "키타라 악사 트로바 씨인가요?"
  },
  "22": {
   "jp": "aa2fa3c8",
   "kr": "그렇긴 한데."
  },
  "23": {
   "jp": "19252ee0",
   "kr": "근데, 어떻게 나를"
  },
  "24": {
   "jp": "bf5bf543",
   "kr": "알고 있는 거니?"
  },
  "25": {
   "jp": "e33411bd",
   "kr": "역시, 그렇군요."
  },
  "26": {
   "jp": "f409bd25",
   "kr": "다츠 사람들 모두가"
  },
  "27": {
   "jp": "434f5dfa",
   "kr": "트로바 씨 키타라를 듣고 싶어서"
  },
  "28": {
   "jp": "bdcfc90d",
   "kr": "목이 빠지게 기다린다고요."
  },
  "29": {
   "jp": "09fd53fc",
   "kr": "엇, 그건 영광인걸."
  },
  "30": {
   "jp": "0ce4d37c",
   "kr": "쥬리오, 키타라를 찾자."
  },
  "31": {
   "jp": "2a2ab845",
   "kr": "빨리 못 찾으면, 상해 버려."
  },
  "32": {
   "jp": "7440fe30",
   "kr": "그러네."
  },
  "33": {
   "jp": "612f6299",
   "kr": "응?"
  },
  "34": {
   "jp": "28b6cc5d",
   "kr": "있다, 있다!"
  },
  "35": {
   "jp": "7b5c37af",
   "kr": "쥬리오 일행은 키타라를 찾았다!"
  },
  "36": {
   "jp": "c76ec540",
   "kr": "꽤 젖어 버렸어."
  },
  "37": {
   "jp": "bad418b9",
   "kr": "키타라는 괜찮을까."
  },
  "38": {
   "jp": "a13746b8",
   "kr": "얼른 알려 주자."
  },
  "39": {
   "jp": "45f0173d",
   "kr": "트로바 씨!"
  },
  "40": {
   "jp": "1ad193ea",
   "kr": "찾았어요."
  },
  "41": {
   "jp": "bba70730",
   "kr": "자, 이거죠?"
  },
  "42": {
   "jp": "abc6b0a6",
   "kr": "쥬리오는 키타라를 트로바에게 줬다."
  },
  "43": {
   "jp": "727c3f0f",
   "kr": "고마워, 살았어."
  },
  "44": {
   "jp": "db7d64c2",
   "kr": "트로바는 키타라를 꼼꼼히 살폈다."
  },
  "45": {
   "jp": "b94aa729",
   "kr": "강물에 젖어 버린 나무 키타라는"
  },
  "46": {
   "jp": "32d45c71",
   "kr": "물을 머금어 무거워져 있었지만,"
  },
  "47": {
   "jp": "dc9cc1cf",
   "kr": "말려 두면 이상 없이 쓸 수 있겠다."
  },
  "48": {
   "jp": "09d6f598",
   "kr": "안 망가졌어요?"
  },
  "49": {
   "jp": "83febc78",
   "kr": "응, 괜찮은 것 같아."
  },
  "50": {
   "jp": "7d30c01e",
   "kr": "현이 젖은 게 조금 걱정이지만,"
  },
  "51": {
   "jp": "d181aad1",
   "kr": "마르면 문제없을 거야."
  },
  "52": {
   "jp": "ea066033",
   "kr": "다행이다."
  },
  "53": {
   "jp": "a0aa9f29",
   "kr": "그건 그렇고 정말 기쁘구나."
  },
  "54": {
   "jp": "8caba802",
   "kr": "나를 다츠 사람들이"
  },
  "55": {
   "jp": "23ce3b8d",
   "kr": "기다려 주고 있다니."
  },
  "56": {
   "jp": "5d877099",
   "kr": "해마다 들르고 있지만"
  },
  "57": {
   "jp": "4c449c83",
   "kr": "그 마을 사람들은"
  },
  "58": {
   "jp": "eba8946c",
   "kr": "어딘가 가라앉아 있잖니."
  },
  "59": {
   "jp": "c8e5a5c4",
   "kr": "적어도 내 키타라를 듣고"
  },
  "60": {
   "jp": "31f9b116",
   "kr": "조금이라도 기분이"
  },
  "61": {
   "jp": "5d034a04",
   "kr": "밝아졌으면 했거든."
  },
  "62": {
   "jp": "2562d33a",
   "kr": "그럼, 당장 가요."
  },
  "63": {
   "jp": "9c474a51",
   "kr": "다들 기다리고 있어요."
  },
  "64": {
   "jp": "860e617c",
   "kr": "응, 그러자."
  },
  "65": {
   "jp": "761fb16f",
   "kr": "미안하구나, 얘들아."
  },
  "66": {
   "jp": "c6fcf21d",
   "kr": "키타라 찾는 걸 도와"
  },
  "67": {
   "jp": "2722a2bc",
   "kr": "주겠니?"
  },
  "68": {
   "jp": "9796fddf",
   "kr": "아마 이 근처에 있을 것 같은데."
  },
  "69": {
   "jp": "d1050e18",
   "kr": "… 좀 하류로 떠내려갔으려나?"
  }
 }
}