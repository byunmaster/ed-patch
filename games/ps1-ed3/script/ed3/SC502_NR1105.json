{
 "archive": "/SCE5/SC502.DAT",
 "member": "..\\DATA\\NR1105.BIN",
 "lines": {
  "0": {
   "jp": "0bb74e02",
   "kr": "북히츠 가도"
  },
  "1": {
   "jp": "ff8af593",
   "kr": "홀크 병사"
  },
  "2": {
   "jp": "e320eff0",
   "kr": "거기 서세요!"
  },
  "3": {
   "jp": "0f2e7790",
   "kr": "남북 가도는 통행금지다."
  },
  "4": {
   "jp": "ec3f7244",
   "kr": "남부로 가려거든"
  },
  "5": {
   "jp": "6d4bdb2f",
   "kr": "트리프 관문에서 앰비쉬를 빠져나가"
  },
  "6": {
   "jp": "01348430",
   "kr": "동쪽에서 남퓨엔테 국경으로 들어가라."
  },
  "7": {
   "jp": "0888af78",
   "kr": "남북 가도는 포기하고 다른 길로 가세요."
  },
  "8": {
   "jp": "f63ff00a",
   "kr": "되돌아와 버렸어."
  },
  "9": {
   "jp": "8822e405",
   "kr": "지금 요새로 가면 의심받아요."
  },
  "10": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "11": {
   "jp": "8d503388",
   "kr": "남북 가도에서 너무 멀어졌어."
  },
  "12": {
   "jp": "e2543eeb",
   "kr": "망보는 병사한테 말을 걸어서"
  },
  "13": {
   "jp": "843f2559",
   "kr": "상황을 살펴보자."
  },
  "14": {
   "jp": "e1a512cc",
   "kr": "병사가 돌아오기 전에"
  },
  "15": {
   "jp": "130ac141",
   "kr": "빠져나가자!"
  },
  "16": {
   "jp": "9c32439a",
   "kr": "휘리랑 캐라크 왕이 기다리고 있어."
  },
  "17": {
   "jp": "d78521bd",
   "kr": "서둘러야 해…"
  },
  "18": {
   "jp": "e1a512cc",
   "kr": "병사가 돌아오기 전에"
  },
  "19": {
   "jp": "130ac141",
   "kr": "빠져나가자!"
  },
  "20": {
   "jp": "0f2e7790",
   "kr": "남북 가도는 통행금지다."
  },
  "21": {
   "jp": "038e8157",
   "kr": "다른 길로 돌아가라."
  },
  "22": {
   "jp": "14f5c120",
   "kr": "끈질기군."
  },
  "23": {
   "jp": "e8dd5ed9",
   "kr": "통행금지다."
  },
  "24": {
   "jp": "5edab9c8",
   "kr": "산적 놈."
  },
  "25": {
   "jp": "8b1d2dd6",
   "kr": "우리가 무서워서 달아났나."
  },
  "26": {
   "jp": "cd38bab1",
   "kr": "이 가도는 홀크로 통하는 길이다."
  },
  "27": {
   "jp": "13d3d6cc",
   "kr": "그러나 민간인의 통행은 허가할 수 없다."
  },
  "28": {
   "jp": "3ae26a48",
   "kr": "길을 정비하기 위해"
  },
  "29": {
   "jp": "963171aa",
   "kr": "남퓨엔테가 공사를 하고 있기 때문이다."
  },
  "30": {
   "jp": "dbf253e2",
   "kr": "공사가 끝날 때까지 통행금지다."
  },
  "31": {
   "jp": "caf0f314",
   "kr": "다른 길로 가시오."
  },
  "32": {
   "jp": "e5d51ef7",
   "kr": "공사 중이라고 했잖나."
  },
  "33": {
   "jp": "156afdc3",
   "kr": "지나갈 수 없다."
  },
  "34": {
   "jp": "1d6e6b7d",
   "kr": "포기해라."
  },
  "35": {
   "jp": "2cb85d73",
   "kr": "산적 따위 없었다."
  },
  "36": {
   "jp": "360e9259",
   "kr": "뭔가 잘못 본 것 아니냐?"
  },
  "37": {
   "jp": "9af1b109",
   "kr": "못 지나갈 것 같은데."
  },
  "38": {
   "jp": "59b4d973",
   "kr": "맞다!"
  },
  "39": {
   "jp": "37ee5954",
   "kr": "한 번 더 해 보자."
  },
  "40": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "41": {
   "jp": "f9130cc7",
   "kr": "쥬리오, 이쪽. 이쪽."
  },
  "42": {
   "jp": "bcea312a",
   "kr": "좋은 생각 났어?"
  },
  "43": {
   "jp": "88149875",
   "kr": "응."
  },
  "44": {
   "jp": "fa1e5a61",
   "kr": "조금 전에"
  },
  "45": {
   "jp": "c737d938",
   "kr": "이 근처에서 산적 소동이 있었다고"
  },
  "46": {
   "jp": "c1ab3ff8",
   "kr": "말했잖아."
  },
  "47": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "48": {
   "jp": "54248901",
   "kr": "실은 나도"
  },
  "49": {
   "jp": "30348f51",
   "kr": "샤라랑 같이 있을 때 습격당했어."
  },
  "50": {
   "jp": "08b724c3",
   "kr": "엇, 정말?"
  },
  "51": {
   "jp": "298985fe",
   "kr": "괜찮았던 거야?"
  },
  "52": {
   "jp": "af2bf2a8",
   "kr": "에이, 괜찮았으니까"
  },
  "53": {
   "jp": "ad7c63bc",
   "kr": "지금 여기 있는 거잖아."
  },
  "54": {
   "jp": "f23f1f41",
   "kr": "샤라가 해치워 버렸어."
  },
  "55": {
   "jp": "744d2ccc",
   "kr": "순식간에."
  },
  "56": {
   "jp": "2a002179",
   "kr": "흐응, 그런 일이 있었구나."
  },
  "57": {
   "jp": "ab5d6680",
   "kr": "그럼, 작전으로 돌아가서…"
  },
  "58": {
   "jp": "7f5a8b3c",
   "kr": "그러니까 그걸 이용하는 거야."
  },
  "59": {
   "jp": "12ba1bad",
   "kr": "여기서 둘이 크게 소란을 피우자."
  },
  "60": {
   "jp": "a95ba22c",
   "kr": "『산적이 나타났다!』 하고."
  },
  "61": {
   "jp": "efc405b4",
   "kr": "그러면"
  },
  "62": {
   "jp": "7989221a",
   "kr": "분명 망보는 병사들이"
  },
  "63": {
   "jp": "a1c6fb68",
   "kr": "뛰쳐나올 거야."
  },
  "64": {
   "jp": "9d2d702a",
   "kr": "그 틈에 남북 가도를 지나가는 거야."
  },
  "65": {
   "jp": "f9baa3b8",
   "kr": "잘될까 몰라."
  },
  "66": {
   "jp": "81fab7ed",
   "kr": "아마."
  },
  "67": {
   "jp": "3573e8c2",
   "kr": "좋아, 해 볼까?"
  },
  "68": {
   "jp": "ebf1bea8",
   "kr": "요란하게 해 보자."
  },
  "69": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "70": {
   "jp": "4727099b",
   "kr": "산적이다아!"
  },
  "71": {
   "jp": "7e6264b6",
   "kr": "산적이 나타났다!"
  },
  "72": {
   "jp": "213df7d0",
   "kr": "꺄아악!"
  },
  "73": {
   "jp": "94148441",
   "kr": "산적이야아!"
  },
  "74": {
   "jp": "7ef64be1",
   "kr": "산적이라고?"
  },
  "75": {
   "jp": "674c72d9",
   "kr": "이번엔 진짜겠지?"
  },
  "76": {
   "jp": "29c579c5",
   "kr": "어디냐, 어느 쪽이냐?"
  },
  "77": {
   "jp": "2d587866",
   "kr": "저쪽."
  },
  "78": {
   "jp": "9412ee81",
   "kr": "저쪽으로 달려갔어요."
  },
  "79": {
   "jp": "d0b42e30",
   "kr": "좋아, 가 보자."
  },
  "80": {
   "jp": "67dcf6a9",
   "kr": "지금!"
  }
 }
}