{
 "archive": "/SCE6/SC605.DAT",
 "member": "..\\DATA\\GR4100.BIN",
 "lines": {
  "0": {
   "jp": "2815d3ed",
   "kr": "구일 가도"
  },
  "1": {
   "jp": "9bb56284",
   "kr": "베라트"
  },
  "2": {
   "jp": "0c7b4e0e",
   "kr": "후후후후후…"
  },
  "3": {
   "jp": "b82f5258",
   "kr": "너희를 기다리고 있었다."
  },
  "4": {
   "jp": "6b361dc5",
   "kr": "퓨엔테에서는,"
  },
  "5": {
   "jp": "9a72f69e",
   "kr": "잘도 내 숭고한 작전을 방해해 주었더군."
  },
  "6": {
   "jp": "04abd6d7",
   "kr": "베라트다…"
  },
  "7": {
   "jp": "7d045189",
   "kr": "난 결코 굴욕을 잊지 않는 남자다."
  },
  "8": {
   "jp": "6ffaba90",
   "kr": "그저,"
  },
  "9": {
   "jp": "13d22106",
   "kr": "뒤끝 있는 타입이란 거 아냐?"
  },
  "10": {
   "jp": "56a71ac4",
   "kr": "윽…"
  },
  "11": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "12": {
   "jp": "e9853e33",
   "kr": "너희들"
  },
  "13": {
   "jp": "5fb3a511",
   "kr": "퓨엔테에서도 소동을 일으켰었나?"
  },
  "14": {
   "jp": "4a500628",
   "kr": "으, 응. 뭐…"
  },
  "15": {
   "jp": "291e7c30",
   "kr": "여행길 동행이 있는 모양이군."
  },
  "16": {
   "jp": "6e9b1f36",
   "kr": "안됐지만"
  },
  "17": {
   "jp": "320ad20b",
   "kr": "나쁜 놈과 동행이 되었다고"
  },
  "18": {
   "jp": "0b8b6c97",
   "kr": "체념해 주어야겠군."
  },
  "19": {
   "jp": "8b9058ca",
   "kr": "나쁜 놈은 그쪽이지."
  },
  "20": {
   "jp": "8c22991e",
   "kr": "퓨엔테에서 무슨 일이 있었는지는 모르지만,"
  },
  "21": {
   "jp": "1136300a",
   "kr": "그러니까, 쥬리오 군과 크리스 양이"
  },
  "22": {
   "jp": "ce065b93",
   "kr": "당신의 악행을 분쇄했다는 거네요."
  },
  "23": {
   "jp": "a02524c4",
   "kr": "뭐, 그런 셈이다."
  },
  "24": {
   "jp": "9901451f",
   "kr": "허나, 악행이라니 듣기 거북하군."
  },
  "25": {
   "jp": "44d7b091",
   "kr": "숭고한 계획이라고 말해 주었으면 좋겠군."
  },
  "26": {
   "jp": "b315be29",
   "kr": "잠꼬대 같은 소리 하지 마라."
  },
  "27": {
   "jp": "3b601d4e",
   "kr": "흥"
  },
  "28": {
   "jp": "f7fd990e",
   "kr": "시대의 흐름도 모르는 저능한 것들."
  },
  "29": {
   "jp": "4a7cd0cb",
   "kr": "뭐라 하든 좋다."
  },
  "30": {
   "jp": "998e800c",
   "kr": "어쨌든 나는"
  },
  "31": {
   "jp": "af53449a",
   "kr": "저 둘과 결판을 내기 위해,"
  },
  "32": {
   "jp": "94f93387",
   "kr": "여기서 기다리고 있었다."
  },
  "33": {
   "jp": "ff55a414",
   "kr": "그러기 위해"
  },
  "34": {
   "jp": "0aee1b02",
   "kr": "이번엔 레바스 님께 지능뿐 아니라"
  },
  "35": {
   "jp": "e6a2c28d",
   "kr": "전투 능력까지 받았다."
  },
  "36": {
   "jp": "a5289eca",
   "kr": "레바스?"
  },
  "37": {
   "jp": "0e7cace1",
   "kr": "이런"
  },
  "38": {
   "jp": "dac87410",
   "kr": "더 말해 봐야 소용없겠군…"
  },
  "39": {
   "jp": "a153f1b9",
   "kr": "어차피 너희는"
  },
  "40": {
   "jp": "580e3c2d",
   "kr": "여기서 죽을 테니까."
  },
  "41": {
   "jp": "708654c9",
   "kr": "간다!"
  },
  "42": {
   "jp": "fc36eb5c",
   "kr": "꽤나 포기를 모르는 녀석들이군."
  },
  "43": {
   "jp": "3cb3e9ed",
   "kr": "꺾이지 않고 도전하는 기개는 인정해 두지."
  },
  "44": {
   "jp": "0dfee1d3",
   "kr": "하지만, 나를 이길 수 있을까."
  },
  "45": {
   "jp": "28a782b0",
   "kr": "시끄럽게 떠들지 마!"
  },
  "46": {
   "jp": "3adae119",
   "kr": "………"
  },
  "47": {
   "jp": "75a53a6a",
   "kr": "이제 두 번 다시 부활할 수 없겠네."
  },
  "48": {
   "jp": "6e306bcf",
   "kr": "왠지 불쌍한 기분도 들어…"
  },
  "49": {
   "jp": "adfbc2c3",
   "kr": "레바스라는 놈은,"
  },
  "50": {
   "jp": "64456911",
   "kr": "우리 생각 이상의 놈일지도 모르겠군."
  },
  "51": {
   "jp": "d17dad1d",
   "kr": "서두르자."
  },
  "52": {
   "jp": "e24215f7",
   "kr": "여기에 이 남자가 있었다는 건…"
  },
  "53": {
   "jp": "542a12db",
   "kr": "어쩌면"
  },
  "54": {
   "jp": "9a3376f3",
   "kr": "레바스가 이쪽 움직임을 눈치챘을지도"
  },
  "55": {
   "jp": "8b840013",
   "kr": "몰라요."
  },
  "56": {
   "jp": "ef34b90d",
   "kr": "아아,"
  },
  "57": {
   "jp": "22b35fe9",
   "kr": "서둘러 폴티아 국경으로 가는 편이"
  },
  "58": {
   "jp": "735a699b",
   "kr": "좋을 것 같군."
  }
 }
}