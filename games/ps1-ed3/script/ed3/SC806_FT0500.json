{
 "archive": "/SCE8/SC806.DAT",
 "member": "..\\DATA\\FT0500.BIN",
 "lines": {
  "0": {
   "jp": "bb708123",
   "kr": "라그픽 마을"
  },
  "1": {
   "jp": "97f330c3",
   "kr": "서쪽 들판"
  },
  "2": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "3": {
   "jp": "ee55673a",
   "kr": "우리 저 산 훨씬 너머까지"
  },
  "4": {
   "jp": "83dbad68",
   "kr": "다녀온 거구나."
  },
  "5": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "6": {
   "jp": "a40a3735",
   "kr": "메나트, 챠놈, 앰비쉬,"
  },
  "7": {
   "jp": "5c2ac4e0",
   "kr": "우돌, 퓨엔테, 기드나, 그리고 올도스."
  },
  "8": {
   "jp": "7c805193",
   "kr": "여러 마을이 있었지."
  },
  "9": {
   "jp": "89ecea13",
   "kr": "라프 할아버지"
  },
  "10": {
   "jp": "49824015",
   "kr": "세상은 아직 훨씬 넓단다."
  },
  "11": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "12": {
   "jp": "e6138f1a",
   "kr": "다음에 여행을 하게 되면"
  },
  "13": {
   "jp": "676cb26f",
   "kr": "큰 뱀의 등뼈 너머나"
  },
  "14": {
   "jp": "708e44f3",
   "kr": "가가브 너머에도 가 보고 싶어."
  },
  "15": {
   "jp": "b8dd2e1e",
   "kr": "혹시 기회가 되면 이계에도…"
  },
  "16": {
   "jp": "1bdac006",
   "kr": "난 게르드가 태어난 세계를 보고 싶어."
  },
  "17": {
   "jp": "89ecea13",
   "kr": "라프 할아버지"
  },
  "18": {
   "jp": "09947cd7",
   "kr": "여행이 꽤 마음에 들었나 보구나."
  },
  "19": {
   "jp": "0b239daf",
   "kr": "라프 할아버지는"
  },
  "20": {
   "jp": "f0b5fde3",
   "kr": "이계에 가 본 적도"
  },
  "21": {
   "jp": "b7b131a7",
   "kr": "있잖아요?"
  },
  "22": {
   "jp": "89ecea13",
   "kr": "라프 할아버지"
  },
  "23": {
   "jp": "9764b9ff",
   "kr": "그렇지."
  },
  "24": {
   "jp": "479579db",
   "kr": "어째서"
  },
  "25": {
   "jp": "b3214af4",
   "kr": "그렇게 대단한 사람이라는 걸"
  },
  "26": {
   "jp": "a03dd7b2",
   "kr": "다들한테 비밀로 하는 거예요?"
  },
  "27": {
   "jp": "89ecea13",
   "kr": "라프 할아버지"
  },
  "28": {
   "jp": "7f36eb72",
   "kr": "호오, 그렇게 나오는구나."
  },
  "29": {
   "jp": "89ecea13",
   "kr": "라프 할아버지"
  },
  "30": {
   "jp": "83881b10",
   "kr": "잘 들어라, 쥬리오와 크리스."
  },
  "31": {
   "jp": "c02e671c",
   "kr": "앞으로는"
  },
  "32": {
   "jp": "6a979c04",
   "kr": "수행한 마법사가 악한 용을 쓰러뜨리거나."
  },
  "33": {
   "jp": "a1996384",
   "kr": "힘센 검사가"
  },
  "34": {
   "jp": "d2856650",
   "kr": "검 한 자루로 국왕이 되는 시대가 아니란다."
  },
  "35": {
   "jp": "75d55b89",
   "kr": "그걸로 일이 수습되는"
  },
  "36": {
   "jp": "4700d0af",
   "kr": "단순한 세상은"
  },
  "37": {
   "jp": "c9734c52",
   "kr": "이제 사라지고 있어."
  },
  "38": {
   "jp": "4004c2b9",
   "kr": "앞으론 각자가 자기 재능을 살려"
  },
  "39": {
   "jp": "972c7e73",
   "kr": "각자 사는 곳에서"
  },
  "40": {
   "jp": "1e28b703",
   "kr": "모두를 위해 노력한다."
  },
  "41": {
   "jp": "66060886",
   "kr": "그래야만 하는 거란다."
  },
  "42": {
   "jp": "4af11482",
   "kr": "그러기 위해서는"
  },
  "43": {
   "jp": "7c2c262a",
   "kr": "전설의 영웅 따위는"
  },
  "44": {
   "jp": "bb1309ce",
   "kr": "방해만 될 뿐이야."
  },
  "45": {
   "jp": "c02e671c",
   "kr": "앞으로는"
  },
  "46": {
   "jp": "02e341f5",
   "kr": "대지에 뿌리내린 힘이야말로"
  },
  "47": {
   "jp": "5cb8f9d0",
   "kr": "필요한 거란다."
  },
  "48": {
   "jp": "ccdeba3c",
   "kr": "게르드의 마음처럼 말이다."
  }
 }
}