  "179": {
   "jp": "f1f42f14",
   "kr": "바론 님과 루레 님을 존경합니다."
  },
  "180": {
   "jp": "4f045262",
   "kr": "어서 오세요."
  },
  "181": {
   "jp": "a705e53d",
   "kr": "바론 님은 3층에 계십니다."
  },
  "182": {
   "jp": "a0b3b7b8",
   "kr": "늘 수고가 많으십니다."
  },
  "183": {
