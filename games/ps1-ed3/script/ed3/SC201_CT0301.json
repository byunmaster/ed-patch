{
 "archive": "/SCE2/SC201.DAT",
 "member": "..\\DATA\\CT0301.BIN",
 "lines": {
  "0": {
   "jp": "ff7be70f",
   "kr": "다이스"
  },
  "1": {
   "jp": "3aac6b08",
   "kr": "챠놈의 병사"
  },
  "2": {
   "jp": "6b8f3c8a",
   "kr": "슈벨"
  },
  "3": {
   "jp": "2a003f2b",
   "kr": "세란"
  },
  "4": {
   "jp": "07cf2d0c",
   "kr": "밀러"
  },
  "5": {
   "jp": "4bce2f05",
   "kr": "바론"
  },
  "6": {
   "jp": "22a19b13",
   "kr": "토바크"
  },
  "7": {
   "jp": "c35b0bea",
   "kr": "디벨"
  },
  "8": {
   "jp": "9a899637",
   "kr": "자, 저택 안으로 들어가자."
  },
  "9": {
   "jp": "6ddf26da",
   "kr": "정말 괜찮아요?"
  },
  "10": {
   "jp": "5dc6434c",
   "kr": "멋대로 들어가서 병사한테"
  },
  "11": {
   "jp": "349293d3",
   "kr": "혼나는 거 아니에요?"
  },
  "12": {
   "jp": "406ea56b",
   "kr": "아하, 나를 못 믿는 게로군…"
  },
  "13": {
   "jp": "5a41ca17",
   "kr": "아이고."
  },
  "14": {
   "jp": "a0cb9926",
   "kr": "아직 볼일이 안 끝났구먼."
  },
  "15": {
   "jp": "261cd08a",
   "kr": "이보게 이보게."
  },
  "16": {
   "jp": "eb19acd4",
   "kr": "같이 가 주겠다고"
  },
  "17": {
   "jp": "7c9956af",
   "kr": "약속했잖은가."
  },
  "18": {
   "jp": "00cd2e76",
   "kr": "슬슬 올 때가 됐다고"
  },
  "19": {
   "jp": "ac996654",
   "kr": "생각했네."
  },
  "20": {
   "jp": "629251c0",
   "kr": "자네가 쓸쓸해할 것 같아서 말이지."
  },
  "21": {
   "jp": "224f5909",
   "kr": "하핫, 헛소리 마."
  },
  "22": {
   "jp": "ef882f4a",
   "kr": "늘 미안하네."
  },
  "23": {
   "jp": "ecc323fa",
   "kr": "뭘, 신경 쓰지 말게."
  },
  "24": {
   "jp": "59c3d480",
   "kr": "우리 같은 늙은이에게"
  },
  "25": {
   "jp": "d2c3b2e6",
   "kr": "아직 할 수 있는 일이 있다면"
  },
  "26": {
   "jp": "487f435d",
   "kr": "기꺼이 하도록 하지."
  },
  "27": {
   "jp": "10efd6d9",
   "kr": "자."
  },
  "28": {
   "jp": "00b8fe08",
   "kr": "오늘 자네 카지노에서"
  },
  "29": {
   "jp": "678fd84f",
   "kr": "번 몫일세."
  },
  "30": {
   "jp": "a7100f37",
   "kr": "놀랍게도 루레는 카지노에서 번 돈을"
  },
  "31": {
   "jp": "64c79f2f",
   "kr": "전부 바론에게 건네고 말았다."
  },
  "32": {
   "jp": "2c7fec7e",
   "kr": "여전히 고지식하군."
  },
  "33": {
   "jp": "1db62e22",
   "kr": "저기, 어떻게 된 거예요?"
  },
  "34": {
   "jp": "a797a26d",
   "kr": "자기가 카지노서 딴 돈을 전부 쏟아부어"
  },
  "35": {
   "jp": "d3d237c4",
   "kr": "슬럼 사람들을 도우려는 거란다."
  },
  "36": {
   "jp": "109de2be",
   "kr": "슬럼 사람들을…?"
  },
  "37": {
   "jp": "56e557e0",
   "kr": "카지노에서 딴 몫은 됐다고"
  },
  "38": {
   "jp": "491731d3",
   "kr": "몇 번이나 말하고 있네만."
  },
  "39": {
   "jp": "4d7bb9dd",
   "kr": "자기가 내겠다며 듣질 않네."
  },
  "40": {
   "jp": "32609060",
   "kr": "나는 내기를 할 때의"
  },
  "41": {
   "jp": "4af28652",
   "kr": "스릴만으로 충분하네."
  },
  "42": {
   "jp": "1317fa04",
   "kr": "남는 돈은 필요 없네."
  },
  "43": {
   "jp": "7ffc42c3",
   "kr": "루레는 말이야, 나한테 렌즈콩 씨앗을"
  },
  "44": {
   "jp": "0e4233d0",
   "kr": "잔뜩 들여놓게 해서"
  },
  "45": {
   "jp": "42981568",
   "kr": "카지노에서 번 돈으로 사러 온다네."
  },
  "46": {
   "jp": "9caf061c",
   "kr": "그리고 그걸 다츠 마을로 가져가서"
  },
  "47": {
   "jp": "6a8ee44c",
   "kr": "마을 사람들에게 건네지. 언젠가 슬럼 땅에서"
  },
  "48": {
   "jp": "de2440e7",
   "kr": "렌즈콩을 거둘 날을 바라며."
  },
  "49": {
   "jp": "a39cea03",
   "kr": "우와〜, 그랬군요."
  },
  "50": {
   "jp": "ae636d1e",
   "kr": "좋은 얘기네요."
  },
  "51": {
   "jp": "bb7f8bad",
   "kr": "그랬군요…"
  },
  "52": {
   "jp": "34a0b2e0",
   "kr": "루레 영감님이 카지노에 다닌 건"
  },
  "53": {
   "jp": "377996c7",
   "kr": "슬럼 사람들을 돕기 위해서였구나."
  },
  "54": {
   "jp": "f4804a46",
   "kr": "카지노에서 번 돈으로 씨앗을 산다면"
  },
  "55": {
   "jp": "e3913e85",
   "kr": "슬럼 사람들도 구하고"
  },
  "56": {
   "jp": "47bfb33d",
   "kr": "이 나라를 위한 일도 되네요."
  },
  "57": {
   "jp": "e3bcca60",
   "kr": "그렇다네."
  },
  "58": {
   "jp": "dba60592",
   "kr": "어찌나 마음을 써 주는지"
  },
  "59": {
   "jp": "16f4d39e",
   "kr": "이쪽이 미안할 지경이야."
  },
  "60": {
   "jp": "1ced02fe",
   "kr": "본래라면"
  },
  "61": {
   "jp": "687d600a",
   "kr": "내가 제대로 정책을 내걸고"
  },
  "62": {
   "jp": "3ff7cdf2",
   "kr": "대처하면 좋겠지만…"
  },
  "63": {
   "jp": "cc02dad7",
   "kr": "카지노 정책은"
  },
  "64": {
   "jp": "4da537bc",
   "kr": "다이스에는 성공이었지만"
  },
  "65": {
   "jp": "c5a2000d",
   "kr": "이웃에는 큰 빈부의 차를 만들고 말았지."
  },
  "66": {
   "jp": "5c6c60a8",
   "kr": "기력을 잃은 다츠 사람들과 우리의 차는"
  },
  "67": {
   "jp": "2681c676",
   "kr": "벌어지기만 하네. 드러내 놓고 손을 내밀면"
  },
  "68": {
   "jp": "6cc292d5",
   "kr": "오히려 마음을 닫아 버린다네."
  },
  "69": {
   "jp": "af94416e",
   "kr": "그래도 렌즈콩 씨앗이라니 잘 생각했네요."
  },
  "70": {
   "jp": "c1e03b09",
   "kr": "그렇지?"
  },
  "71": {
   "jp": "226a18f3",
   "kr": "그냥 돈을 건네 버리면"
  },
  "72": {
   "jp": "e4314d91",
   "kr": "그들도 받지 않을 걸세."
  },
  "73": {
   "jp": "285b2745",
   "kr": "설령 받는다 해도"
  },
  "74": {
   "jp": "e2abb1d4",
   "kr": "그게 당연해져서 일을 안 하게 되어"
  },
  "75": {
   "jp": "2acc7977",
   "kr": "버려도 안 되니 말이야."
  },
  "76": {
   "jp": "8f493e0d",
   "kr": "렌즈콩 씨앗이라면 삶아 먹을 수도 있고"
  },
  "77": {
   "jp": "167017c1",
   "kr": "다츠 사람들이 일할 마음이 들면"
  },
  "78": {
   "jp": "0b8381b0",
   "kr": "땅을 갈아 스스로 기르면 되는구나."
  },
  "79": {
   "jp": "9318d550",
   "kr": "음, 좋은 생각이다."
  },
  "80": {
   "jp": "4599cb46",
   "kr": "하지만 말이야, 그리 잘되는 것만도"
  },
  "81": {
   "jp": "a86b45c8",
   "kr": "아니라네."
  },
  "82": {
   "jp": "75a9e6d2",
   "kr": "벌써 몇 해나 나는 이걸 계속하고"
  },
  "83": {
   "jp": "5a77ef0a",
   "kr": "있네만 도무지 다츠 사람들은"
  },
  "84": {
   "jp": "6c2b1098",
   "kr": "씨를 뿌리려 하지 않네."
  },
  "85": {
   "jp": "c609c97f",
   "kr": "언젠가 그들이 제 뜻으로"
  },
  "86": {
   "jp": "ffe51e52",
   "kr": "씨를 뿌릴 마음이 들어"
  },
  "87": {
   "jp": "2c8b3540",
   "kr": "주면 좋으련만."
  },
  "88": {
   "jp": "30b0164c",
   "kr": "분명 루레 영감님의 마음은"
  },
  "89": {
   "jp": "c0d817fa",
   "kr": "전해질 거예요."
  },
  "90": {
   "jp": "6fffc102",
   "kr": "나도 그렇게 생각하네."
  },
  "91": {
   "jp": "32dfe1e4",
   "kr": "자, 짐은 1층 창고에 준비해 뒀으니"
  },
  "92": {
   "jp": "08a0036f",
   "kr": "토바크에게 안내시키지."
  },
  "93": {
   "jp": "aeb9bf5a",
   "kr": "토바크."
  },
  "94": {
   "jp": "e98a4403",
   "kr": "늘 그곳이야."
  },
  "95": {
   "jp": "ed022662",
   "kr": "부탁해."
  },
  "96": {
   "jp": "916e88ee",
   "kr": "알겠습니다."
  },
  "97": {
   "jp": "3a282de7",
   "kr": "안내하겠습니다."
  },
  "98": {
   "jp": "fc9b2764",
   "kr": "여기 궤짝 안에"
  },
  "99": {
   "jp": "67502180",
   "kr": "렌즈콩 씨앗이 들어 있습니다."
  },
  "100": {
   "jp": "bfc8e8e8",
   "kr": "들 수 있는 만큼 가져가세요."
  },
  "101": {
   "jp": "098b4534",
   "kr": "늘 고맙네."
  },
  "102": {
   "jp": "3a50c079",
   "kr": "나머진 우리가 하지."
  },
  "103": {
   "jp": "e4996b3c",
   "kr": "잘 부탁드립니다."
  },
  "104": {
   "jp": "52e9a7c4",
   "kr": "자, 자네들."
  },
  "105": {
   "jp": "6848496c",
   "kr": "렌즈콩 자루를 들어 주지 않겠나?"
  },
  "106": {
   "jp": "21ec2c9f",
   "kr": "그리고 가능하면 다츠까지"
  },
  "107": {
   "jp": "d6721711",
   "kr": "함께 가 주었으면 하네만."
  },
  "108": {
   "jp": "d060984e",
   "kr": "훌륭한 일인걸요."
  },
  "109": {
   "jp": "158a8ba4",
   "kr": "물론 도울게요."
  },
  "110": {
   "jp": "e02a45dc",
   "kr": "그렇죠?"
  },
  "111": {
   "jp": "2ef8febf",
   "kr": "좋은 이야기를 들은 답례로"
  },
  "112": {
   "jp": "42359913",
   "kr": "한몫 거들어 볼까."
  },
  "113": {
   "jp": "369de827",
   "kr": "다츠까지라면 그리 멀지도 않고."
  },
  "114": {
   "jp": "b4fba8e4",
   "kr": "와아!"
  },
  "115": {
   "jp": "27f7188a",
   "kr": "가자, 가자."
  },
  "116": {
   "jp": "aaf954a0",
   "kr": "뭐냐, 짐이 가득하냐."
  },
  "117": {
   "jp": "8b479fb3",
   "kr": "어쩔 수 없구먼. 마을에서 뭔가 팔게."
  },
  "118": {
   "jp": "51acd669",
   "kr": "이래서야 렌즈콩을 못 들지."
  },
  "119": {
   "jp": "71ac4b96",
   "kr": "이제 충분하네."
  },
  "120": {
   "jp": "8560bb29",
   "kr": "자, 다츠를 향해 출발일세!"
  },
  "121": {
   "jp": "a9b1f38a",
   "kr": "두 자루면 충분하겠지."
  },
  "122": {
   "jp": "73a73ca2",
   "kr": "좋아, 다음은 다츠다!"
  },
  "123": {
   "jp": "cfb2974a",
   "kr": "한 자루여도 괜찮다고 해 두지."
  },
  "124": {
   "jp": "dd0cd190",
   "kr": "자, 다츠로 가자."
  },
  "125": {
   "jp": "dbc50482",
   "kr": "한 자루라도 좋네."
  },
  "126": {
   "jp": "2f721422",
   "kr": "자, 다츠로 출발일세!!"
  },
  "127": {
   "jp": "a9b1f38a",
   "kr": "두 자루면 충분하겠지."
  },
  "128": {
   "jp": "2f721422",
   "kr": "자, 다츠로 출발일세!!"
  },
  "129": {
   "jp": "972c7ebb",
   "kr": "세 자루나 들어 주다니 고맙구먼."
  },
  "130": {
   "jp": "2f721422",
   "kr": "자, 다츠로 출발일세!!"
  },
  "131": {
   "jp": "be55d860",
   "kr": "좋다, 좋아."
  },
  "132": {
   "jp": "71ac4b96",
   "kr": "이제 충분하네."
  },
  "133": {
   "jp": "af717fee",
   "kr": "다츠로 출발하자꾸나!"
  },
  "134": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은 "
  },
  "135": {
   "jp": "a6255bf0",
   "kr": "을(를) 들었다."
  },
  "136": {
   "jp": "4f045262",
   "kr": "어서 오세요."
  },
  "137": {
   "jp": "e69ec580",
   "kr": "루레 님"
  },
  "138": {
   "jp": "dde35c0e",
   "kr": "늘 감사합니다."
  },
  "139": {
   "jp": "7dfe97aa",
   "kr": "실은 저도 다츠 출신입니다."
  },
  "140": {
   "jp": "4c6f815d",
   "kr": "부디 다츠 사람들이"
  },
  "141": {
   "jp": "f961ade3",
   "kr": "희망을 되찾도록"
  },
  "142": {
   "jp": "7cd94b06",
   "kr": "힘을 보태 주십시오."
  },
  "143": {
   "jp": "06211d57",
   "kr": "그러냐."
  },
  "144": {
   "jp": "7c6b474a",
   "kr": "마침내 다츠 사람들이 일할 마음이"
  },
  "145": {
   "jp": "a3e35cf4",
   "kr": "들어 준 게로구나."
  },
  "146": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "147": {
   "jp": "af89ece1",
   "kr": "너희 덕분이야."
  },
  "148": {
   "jp": "c6622865",
   "kr": "다츠 사람들을 위해"
  },
  "149": {
   "jp": "40b7e311",
   "kr": "렌즈콩을 가져다줘서"
  },
  "150": {
   "jp": "7bd05f14",
   "kr": "정말 고마워요."
  },
  "151": {
   "jp": "d04df47b",
   "kr": "아이고, 루레 님, 어서 오십시오."
  },
  "152": {
   "jp": "331b21c0",
   "kr": "어라, 루레 님이라니…?"
  },
  "153": {
   "jp": "08f11388",
   "kr": "루레 영감님은"
  },
  "154": {
   "jp": "503a7305",
   "kr": "사실 높은 분인가…"
  },
  "155": {
   "jp": "672794c0",
   "kr": "루레 님."
  },
  "156": {
   "jp": "3102b66c",
   "kr": "또 카지노에서 번 모양이군요."
  },
  "157": {
   "jp": "bafddd72",
   "kr": "늘 수고가 많으십니다."
  },
  "158": {
   "jp": "b081b6de",
   "kr": "오, 너희구나."
  },
  "159": {
   "jp": "f0dd673b",
   "kr": "루레 씨는 벌써 돌아갔나?"
  },
  "160": {
   "jp": "b8c28a81",
   "kr": "렌즈콩 씨앗은"
  },
  "161": {
   "jp": "20114c52",
   "kr": "언제든 들여올 수 있게"
  },
  "162": {
   "jp": "2b802c05",
   "kr": "상인과 얘기를 해 뒀다."
  },
  "163": {
   "jp": "3bd0e07b",
   "kr": "다츠 사람들이"
  },
  "164": {
   "jp": "ec6bfc4a",
   "kr": "마음을 먹어 줄 때까지"
