  "3": {
   "jp": "dd8d3a5a",
   "kr": "키르마"
  },
  "4": {
   "jp": "46691b52",
   "kr": "발루"
  },
  "5": {
   "jp": "b5454b11",
   "kr": "진"
  },
  "6": {
   "jp": "e28fc32b",
   "kr": "이르"
  },
  "7": {
   "jp": "df394f68",
   "kr": "루나"
  },
  "8": {
   "jp": "1ddfb66c",
   "kr": "쥬리오, 여기 여관이야."
  },
  "9": {
   "jp": "cf612745",
   "kr": "은단검을 떨어뜨려서 여관에도"
  },
  "10": {
   "jp": "0d247572",
   "kr": "묵을 수 없겠네."
  },
  "11": {
   "jp": "41d22802",
   "kr": "이쪽엔 없는 거 아닐까?"
  },
  "12": {
   "jp": "a6b925e2",
   "kr": "그쪽엔 없을 것 같은데."
  },
  "13": {
   "jp": "bfacf871",
   "kr": "은단검을 찾아야 해."
  },
  "14": {
   "jp": "0c221365",
   "kr": "이 강 꽤 깊은걸."
  },
  "15": {
   "jp": "fea45857",
   "kr": "어떡하지…"
  },
  "16": {
   "jp": "89c7bca5",
   "kr": "안 되겠어…"
  },
  "17": {
   "jp": "bf89e811",
   "kr": "강이 깊어서"
  },
  "18": {
   "jp": "4fdd63ed",
   "kr": "더는 못 나아가겠어."
  },
  "19": {
   "jp": "4c82f8fb",
   "kr": "어머, 어서 오세요."
  },
  "20": {
   "jp": "373fe608",
   "kr": "곤란한 일이 있으면 사양 말고"
  },
  "21": {
   "jp": "a2cc511c",
   "kr": "말해 주세요."
  },
  "22": {
   "jp": "614b0bbb",
   "kr": "(곤란하긴 한데 먼저 그렇게 말하면"
  },
  "23": {
   "jp": "ea667e10",
   "kr": "오히려 말을 못 꺼내겠어…)"
  },
  "24": {
   "jp": "652528b7",
   "kr": "분명 이 강바닥일 거야."
  },
  "25": {
   "jp": "fea45857",
   "kr": "어떡하지…"
  },
  "26": {
   "jp": "fc3868a5",
   "kr": "이 강 꽤 넓은 데다 깊어 보여."
  },
  "27": {
   "jp": "2d60e7e2",
   "kr": "게다가 차갑겠어…"
  },
  "28": {
   "jp": "33f38a85",
   "kr": "응, 곤란한걸."
  },
  "29": {
   "jp": "82525822",
   "kr": "엇? 방금 어딘가에서"
  },
  "30": {
   "jp": "acedbf78",
   "kr": "누가 '곤란해'라고 했어!"
  },
  "31": {
   "jp": "669920a2",
   "kr": "응, 나도 들었어."
  },
  "32": {
   "jp": "3368a3bf",
   "kr": "누군가 곤란해하고 있어요! 도와줘야죠."
  },
  "33": {
   "jp": "eaf53d25",
   "kr": "어디야, 어디!"
  },
  "34": {
   "jp": "2bb1bf60",
   "kr": "저 다리 위다!"
  },
  "35": {
   "jp": "e2eb9a69",
   "kr": "뭐, 뭐야? 이 사람들…"
  },
  "36": {
   "jp": "6725071b",
   "kr": "?????"
  },
  "37": {
   "jp": "1662729c",
   "kr": "우웩… 안심해. 고민거리는"
  },
  "38": {
   "jp": "c929f0ca",
   "kr": "당장 우리가 해결해 주지!"
  },
  "39": {
   "jp": "fc336c5a",
   "kr": "그렇지, 다들!"
  },
  "40": {
   "jp": "dd8d3a5a",
   "kr": "키르마"
  },
  "41": {
   "jp": "50b600ef",
   "kr": "곤란할 땐 서로 도와야죠!"
  },
  "42": {
   "jp": "b5454b11",
   "kr": "진"
  },
  "43": {
   "jp": "e87c08ce",
   "kr": "이 몸한테 맡겨라!"
  },
  "44": {
   "jp": "96728a66",
   "kr": "간쵸"
  },
  "45": {
   "jp": "7a178bcf",
   "kr": "오오!!"
  },
  "46": {
   "jp": "46691b52",
   "kr": "발루"
  },
  "47": {
   "jp": "eeb9d19d",
   "kr": "안심해, 괜찮다니까!"
  },
  "48": {
   "jp": "9cbf1a02",
   "kr": "대, 대단해…"
  },
  "49": {
   "jp": "a6949035",
   "kr": "확실히 어려울 때는 힘이 되어 준다고"
  },
  "50": {
   "jp": "4c27ac4e",
   "kr": "다들 말했지만."
  },
  "51": {
   "jp": "bf8084de",
   "kr": "엇?! 뭐야"
  },
  "52": {
   "jp": "bfd3e690",
   "kr": "형이랑 누나잖아."
  },
  "53": {
   "jp": "4360c688",
   "kr": "잃어버린 걸 아직 못 찾았구나?"
  },
  "54": {
   "jp": "5e5aab85",
   "kr": "으, 응."
  },
  "55": {
   "jp": "5215a1dd",
   "kr": "이 강 속에 떨어뜨린 것 같아."
  },
  "56": {
   "jp": "2432e444",
   "kr": "뭐야, 그런 거였군."
  },
  "57": {
   "jp": "f9715e9e",
   "kr": "자, 다들 찾아라!"
  },
  "58": {
   "jp": "6d3b40c7",
   "kr": "이 마을 사람들… 너무 대단해."
  },
  "59": {
   "jp": "0b0cb863",
   "kr": "나… 나도 그렇게 생각해."
  },
  "60": {
   "jp": "ec2b3bde",
   "kr": "보글보글…"
  },
  "61": {
   "jp": "3e1b14f4",
   "kr": "앗, 여기 있다!"
  },
  "62": {
   "jp": "5f8284c7",
   "kr": "형, 누나."
  },
  "63": {
   "jp": "3c1d8189",
   "kr": "이거 맞지!"
  },
  "64": {
   "jp": "fdab8a1a",
   "kr": "잠수한다!"
  },
  "65": {
   "jp": "fdab8a1a",
   "kr": "잠수한다!"
  },
  "66": {
   "jp": "ed306d71",
   "kr": "뭐여?"
  },
  "67": {
   "jp": "07622745",
   "kr": "가까이 오지 말어."
  },
  "68": {
   "jp": "373afbe8",
   "kr": "고기가 도망간당께."
  },
  "69": {
   "jp": "579b79e9",
   "kr": "아하. 보아하니"
  },
  "70": {
   "jp": "d751d544",
   "kr": "방파제서 낚는 어부가 신기한 게지?"
  },
  "71": {
   "jp": "14b9d1a8",
   "kr": "예전엔 여기도 모래사장이 있었는디 말여."
  },
  "72": {
   "jp": "883fd477",
   "kr": "정기선을 항구에 댈 수 있게 하려고"
  },
  "73": {
   "jp": "61a30ee1",
   "kr": "모래사장을 메워 버린 것이여."
  },
  "74": {
   "jp": "2d84c11d",
   "kr": "아무리 애를 써도 풍어까진 안 되지만"
  },
  "75": {
   "jp": "98bc64cb",
   "kr": "이렇게 방파제서 낚기만 하면"
  },
  "76": {
   "jp": "c91da8b8",
   "kr": "뱃멀미도 안 한당께."
  },
  "77": {
   "jp": "7280de8b",
   "kr": "어머, 여행 중인 분이구나."
  },
  "78": {
   "jp": "72e92419",
   "kr": "무슨 일 있니?"
  },
  "79": {
   "jp": "e4a8ad42",
   "kr": "곤란한 일이 있는 모양이구나."
  },
  "80": {
   "jp": "de0e3733",
   "kr": "아뇨, 괜찮아요."
  },
  "81": {
   "jp": "ddaf4050",
   "kr": "물건을 좀 잃어버려서…"
  },
  "82": {
   "jp": "6b82ad66",
   "kr": "조금 더 찾아볼게요."
  },
  "83": {
   "jp": "263d8ed7",
   "kr": "곤란한 일이 있으면"
  },
  "84": {
   "jp": "be63e0e5",
   "kr": "사양 말고 말해 주렴."
  },
  "85": {
   "jp": "0d004acc",
   "kr": "힘이 되어 줄 테니까."
  },
  "86": {
   "jp": "c765b03f",
   "kr": "고마워요, 아주머니."
  },
  "87": {
   "jp": "1db09958",
   "kr": "안 돼, 쥬리오!"
  },
  "88": {
   "jp": "3845b7fd",
   "kr": "은단검이 없으면 여행을 계속 못 해."
  },
  "89": {
   "jp": "d60409ab",
   "kr": "은단검을 잃어버리면"
  },
  "90": {
   "jp": "e1e5b0ae",
   "kr": "촌장님께 혼난단 말이야〜"
  },
  "91": {
   "jp": "5b70a706",
   "kr": "얼른 찾자."
  }
 }
