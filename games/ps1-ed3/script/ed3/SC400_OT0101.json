{
 "archive": "/SCE4/SC400.DAT",
 "member": "..\\DATA\\OT0101.BIN",
 "lines": {
  "0": {
   "jp": "2a8d61a9",
   "kr": "마을 구역"
  },
  "1": {
   "jp": "790e56cd",
   "kr": "필로 선생"
  },
  "2": {
   "jp": "a2cfc541",
   "kr": "돌아가실 땐 서쪽 길로 가시죠?"
  },
  "3": {
   "jp": "866b9edf",
   "kr": "도중까지 함께 가요."
  },
  "4": {
   "jp": "cf5c2a40",
   "kr": "자, 마지막 마법의 거울을"
  },
  "5": {
   "jp": "29174ea1",
   "kr": "똑똑히 그 눈으로"
  },
  "6": {
   "jp": "700faaca",
   "kr": "보고 오시기 바랍니다."
  },
  "7": {
   "jp": "1e5207ae",
   "kr": "오오, 쥬리오 님."
  },
  "8": {
   "jp": "3b5b75fe",
   "kr": "돌아오셨군요."
  },
  "9": {
   "jp": "033ef83d",
   "kr": "모리슨 씨 두 사람 상태는 어때요?"
  },
  "10": {
   "jp": "b15096e3",
   "kr": "일진일퇴를 거듭하고 있습니다."
  },
  "11": {
   "jp": "65b4159c",
   "kr": "쥬리오 군, 리즈는?"
  },
  "12": {
   "jp": "b8eaebdc",
   "kr": "리즈의 딸 휘리예요."
  },
  "13": {
   "jp": "4648bef9",
   "kr": "어머니 대신 왔어요."
  },
  "14": {
   "jp": "f6b083bc",
   "kr": "그런가, 따님이 있었나."
  },
  "15": {
   "jp": "d110633c",
   "kr": "비약은… 괜찮겠나?"
  },
  "16": {
   "jp": "b7f6ad49",
   "kr": "네. 만드는 법은 배웠어요."
  },
  "17": {
   "jp": "15350021",
   "kr": "바로 준비할게요."
  },
  "18": {
   "jp": "c3b3309d",
   "kr": "휘리, 부탁해."
  },
  "19": {
   "jp": "70b9e035",
   "kr": "네, 해 볼게요."
  },
  "20": {
   "jp": "440d574b",
   "kr": "휘리는 비약 조합을 시작했다."
  },
  "21": {
   "jp": "199a7e28",
   "kr": "주머니에서 몇 가지 허브를 꺼내더니"
  },
  "22": {
   "jp": "f25d0291",
   "kr": "신중하게 분량을 재며 섞은 뒤 물에 풀었다."
  },
  "23": {
   "jp": "f681743e",
   "kr": "허브차 만드는 요령과 비슷했다."
  },
  "24": {
   "jp": "04d8477d",
   "kr": "이제 알그레스 뿔을 넣으면 완성돼요."
  },
  "25": {
   "jp": "c4a1b7a5",
   "kr": "마지막으로 휘리는 알그레스 뿔 가루를 넣고"
  },
  "26": {
   "jp": "950682a7",
   "kr": "약 색이 일정해질 때까지 휘저었다."
  },
  "27": {
   "jp": "ba1edf1e",
   "kr": "유백색 비약이 완성되었다."
  },
  "28": {
   "jp": "f90ebc31",
   "kr": "다 됐어요."
  },
  "29": {
   "jp": "85747183",
   "kr": "이걸 두 분께 먹여 드리세요."
  },
  "30": {
   "jp": "85b997bb",
   "kr": "샤라는 비약을 구스에게 먹였다."
  },
  "31": {
   "jp": "205d993f",
   "kr": "으윽… 으으음."
  },
  "32": {
   "jp": "600a6095",
   "kr": "샤라…?"
  },
  "33": {
   "jp": "cbc98d58",
   "kr": "…샤라잖아!"
  },
  "34": {
   "jp": "30df3d39",
   "kr": "구스가 회복했다!"
  },
  "35": {
   "jp": "1017d4a2",
   "kr": "정말이지"
  },
  "36": {
   "jp": "f3b675a0",
   "kr": "어처구니없는 꼴을 당했다고."
  },
  "37": {
   "jp": "f2bd5f2f",
   "kr": "근데, 샤라…"
  },
  "38": {
   "jp": "2706cae9",
   "kr": "어째서 여기 있는 거야?"
  },
  "39": {
   "jp": "1ae82f67",
   "kr": "있으면 안 되냐?"
  },
  "40": {
   "jp": "c0834aac",
   "kr": "쥬리오는 비약을 크리스에게 먹였다."
  },
  "41": {
   "jp": "1544e628",
   "kr": "윽……"
  },
  "42": {
   "jp": "f3566eeb",
   "kr": "쥬리오……"
  },
  "43": {
   "jp": "622d3ffa",
   "kr": "…쥬리오!"
  },
  "44": {
   "jp": "ef8e29d5",
   "kr": "크리스가 회복했다!"
  },
  "45": {
   "jp": "f4d6769e",
   "kr": "고마워, 쥬리오."
  },
  "46": {
   "jp": "fa47c0a2",
   "kr": "저주가 풀린 것 같아…"
  },
  "47": {
   "jp": "63cb5cf0",
   "kr": "머리가 맑아졌어."
  },
  "48": {
   "jp": "377a84e5",
   "kr": "많은 이들의 도움으로 무사히 크리스와 구스의"
  },
  "49": {
   "jp": "741dfef4",
   "kr": "저주는 풀렸다. 쥬리오는 여태 도와준"
  },
  "50": {
   "jp": "12f27947",
   "kr": "사람들에게 마음속 깊이 감사했다."
  },
  "51": {
   "jp": "44ccb18a",
   "kr": "구스와 샤라는 재회를 기뻐하며"
  },
  "52": {
   "jp": "6389a256",
   "kr": "둘이서 즐겁게 이야기하고 있다."
  },
  "53": {
   "jp": "3145a649",
   "kr": "쥬리오 일행은 저마다 크리스와 구스의 회복을"
  },
  "54": {
   "jp": "02583597",
   "kr": "기뻐했다. 이윽고 알그레스의 뿔을 찾기까지의"
  },
  "55": {
   "jp": "f302cd25",
   "kr": "모험담에 한동안 이야기꽃이 피었다."
  },
  "56": {
   "jp": "624b6398",
   "kr": "쥬리오, 신세 졌다."
  },
  "57": {
   "jp": "8d7bf6ce",
   "kr": "우리 또"
  },
  "58": {
   "jp": "a22a97d0",
   "kr": "둘이서 여행하기로 했어."
  },
  "59": {
   "jp": "5a1dd804",
   "kr": "쇠뿔도 단김에 빼랬으니까."
  },
  "60": {
   "jp": "e51be513",
   "kr": "바로 여기를 뜨기로 했어."
  },
  "61": {
   "jp": "889203bb",
   "kr": "아무래도 고지식한 올도스 분위기는"
  },
  "62": {
   "jp": "1e2253a2",
   "kr": "내 성미엔 안 맞는 모양이라서."
  },
  "63": {
   "jp": "e62c9e29",
   "kr": "느긋한 자유 여행이 최고지."
  },
  "64": {
   "jp": "b6a423ee",
   "kr": "엇, 구스도 샤라 씨도 가 버리는 거야?"
  },
  "65": {
   "jp": "40c1c71d",
   "kr": "아직 샤라 씨한테"
  },
  "66": {
   "jp": "0bcbb17d",
   "kr": "나… 고맙단 말도 못 했는데…"
  },
  "67": {
   "jp": "769f1772",
   "kr": "고맙다고…?"
  },
  "68": {
   "jp": "7e2249c6",
   "kr": "관둬."
  },
  "69": {
   "jp": "e04b26c8",
   "kr": "난 남한테 고맙단 말 들을 일 같은 건"
  },
  "70": {
   "jp": "fc6cd9fd",
   "kr": "한 번도 한 기억이 없어."
  },
  "71": {
   "jp": "99bc0105",
   "kr": "그치만 구스랑 샤라랑 헤어지는 건"
  },
  "72": {
   "jp": "5e871aec",
   "kr": "왠지 슬픈걸."
  },
  "73": {
   "jp": "67337640",
   "kr": "듣기 좋은 소리 하는데."
  },
  "74": {
   "jp": "baeba480",
   "kr": "뭐, 네가 날 의지하는 건 알겠지만"
  },
  "75": {
   "jp": "554d2cbf",
   "kr": "나도 바쁘거든."
  },
  "76": {
   "jp": "c31bc90e",
   "kr": "그런 거 아니야."
  },
  "77": {
   "jp": "3baf424a",
   "kr": "됐어, 쑥스러워할 거 없어."
  },
  "78": {
   "jp": "eaaf686d",
   "kr": "헤어짐이 있으니 만남도 있는 거다."
  },
  "79": {
   "jp": "dcdfe95f",
   "kr": "또 분명 어딘가에서 만나겠지."
  },
  "80": {
   "jp": "78149a7b",
   "kr": "구스 님"
  },
  "81": {
   "jp": "fe2bedd9",
   "kr": "작별 인사로 저도 한마디."
  },
  "82": {
   "jp": "d169d069",
   "kr": "뭐야?"
  },
  "83": {
   "jp": "bfb9e741",
   "kr": "짧은 동안이었습니다만 즐거운 여행이었습니다."
  },
  "84": {
   "jp": "04955c8b",
   "kr": "그리고…"
  },
  "85": {
   "jp": "b2f07f40",
   "kr": "도적 일을 계속하실 생각이시라면"
  },
  "86": {
   "jp": "cf41ca7a",
   "kr": "앰비쉬 말고 다른 땅에서 부탁드립니다."
  },
  "87": {
   "jp": "2634c2bc",
   "kr": "구스 님을 잡고 싶지는 않습니다."
  },
  "88": {
   "jp": "e1857942",
   "kr": "으음."
  },
  "89": {
   "jp": "1254d5f3",
   "kr": "그건 약속 못 하겠는데."
  },
  "90": {
   "jp": "2ae3aee4",
   "kr": "우린 제멋대로인 도적이라서."
  },
  "91": {
   "jp": "9bc07df9",
   "kr": "내일이 되지 않으면"
  },
  "92": {
   "jp": "5bedecdf",
   "kr": "내일 일은 모르는 거야."
  },
  "93": {
   "jp": "2e4c1d44",
   "kr": "구스 님다운 대답이십니다."
  },
  "94": {
   "jp": "0922a25c",
   "kr": "그래야 진정한 도적의 귀감이지요."
  },
  "95": {
   "jp": "7157d182",
   "kr": "저, 저기, 도적이었나?"
  },
  "96": {
   "jp": "d6f8c9ae",
   "kr": "…이 사람."
  },
  "97": {
   "jp": "1d04c5be",
   "kr": "용케 올도스에 들어왔군."
  },
  "98": {
   "jp": "f444f6bb",
   "kr": "이 올도스에는 보이지 않는 결계가 있어서"
  },
  "99": {
   "jp": "886688e4",
   "kr": "나쁜 사람은 못 들어올 텐데…"
  },
  "100": {
   "jp": "6c85a49d",
   "kr": "구스는 나쁜 사람이 아니에요."
  },
  "101": {
   "jp": "4f367367",
   "kr": "왜냐면 제가 아는 한"
  },
  "102": {
   "jp": "cb7065df",
   "kr": "한 번도 도둑질에 성공한 적이 없는걸요."
  },
  "103": {
   "jp": "4a26f825",
   "kr": "윽…"
  },
  "104": {
   "jp": "9dc8700f",
   "kr": "그건 말하지 마."
  },
  "105": {
   "jp": "a58ae4d4",
   "kr": "저, 어쩐지"
  },
  "106": {
   "jp": "8ed7cc13",
   "kr": "알 것 같아요."
  },
  "107": {
   "jp": "3edaa2da",
   "kr": "샤라 씨와 함께 여행하면서"
  },
  "108": {
   "jp": "f714126b",
   "kr": "알게 된 건데요"
  },
  "109": {
   "jp": "bbc27b5a",
   "kr": "무척 다정한 분이에요."
  },
  "110": {
   "jp": "570c8bf8",
   "kr": "분명 구스 씨도 샤라 씨도"
  },
  "111": {
   "jp": "2c959f94",
   "kr": "마음이 아주 맑은 분들이라고 생각해요."
  },
  "112": {
   "jp": "1e0bf4f0",
   "kr": "이거 참…"
  },
  "113": {
   "jp": "96f28ed9",
   "kr": "점점 있기가 거북해지는걸."
  },
  "114": {
   "jp": "a2f1bec5",
   "kr": "그럼, 그렇게 됐으니까."
  },
  "115": {
   "jp": "32ff8921",
   "kr": "우린 이만 작별이다."
  },
  "116": {
   "jp": "167725bb",
   "kr": "그럼 이만."
  },
  "117": {
   "jp": "1cf06bbb",
   "kr": "그럼 이만."
  },
  "118": {
   "jp": "7d2ce020",
   "kr": "잘 가. 또 봐."
  },
  "119": {
   "jp": "b3a51370",
   "kr": "구스 군"
  },
  "120": {
   "jp": "6dfbe568",
   "kr": "아직 무리하지 말게나."
  },
  "121": {
   "jp": "ea480cdf",
   "kr": "그래, 알고 있어."
  },
  "122": {
   "jp": "689757e8",
   "kr": "조심하십시오."
  },
  "123": {
   "jp": "1cf06bbb",
   "kr": "그럼 이만."
  },
  "124": {
   "jp": "ba337272",
   "kr": "가 버렸네."
  },
  "125": {
   "jp": "5b102d79",
   "kr": "또 분명 어딘가에서 만날 거야."
  },
  "126": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "127": {
   "jp": "7826aa52",
   "kr": "자, 저주도 풀렸으니"
  },
  "128": {
   "jp": "cb1402a1",
   "kr": "나도 병원으로 돌아가야겠네."
  },
  "129": {
   "jp": "5aab787e",
   "kr": "슬슬 꾀병인 우비를"
  },
  "130": {
   "jp": "4c3034a4",
   "kr": "침대에서 쫓아내지 않으면"
  },
  "131": {
   "jp": "d98d649e",
   "kr": "병원에 눌러살게 되니까."
  },
  "132": {
   "jp": "72a1ae25",
   "kr": "그럼, 실례."
  },
  "133": {
   "jp": "0c337dcd",
   "kr": "필로 선생님."
  },
  "134": {
   "jp": "5c36cbd1",
   "kr": "여러모로"
  },
  "135": {
   "jp": "88239568",
   "kr": "고마웠어요."
  },
  "136": {
   "jp": "437ae67f",
   "kr": "아니, 뭘."
  },
  "137": {
   "jp": "6516387f",
   "kr": "그럼, 쥬리오 님. 크리스 님."
  },
  "138": {
   "jp": "a9fe42c0",
   "kr": "드디어 대성당에 참배하시는군요."
  },
  "139": {
   "jp": "4dfb8423",
   "kr": "이것으로 순례 여행도 막바지로군요."
  },
  "140": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "141": {
   "jp": "aa17aa23",
   "kr": "저는 여기서 기다리고 있겠습니다."
  },
  "142": {
   "jp": "0778687d",
   "kr": "두 분이 참배를 마치신 모습을 지켜본 뒤"
  },
  "143": {
   "jp": "74090b92",
   "kr": "앰비쉬로 돌아가기로 하겠습니다."
  },
  "144": {
   "jp": "5dc15c60",
   "kr": "그럼, 저도 기다릴게요."
  },
  "145": {
   "jp": "a2cfc541",
   "kr": "돌아가실 땐 서쪽 길로 가시죠?"
  },
  "146": {
   "jp": "866b9edf",
   "kr": "도중까지 함께 가요."
  },
  "147": {
   "jp": "169d88be",
   "kr": "대성당은 어떠셨습니까?"
  },
  "148": {
   "jp": "8407edb5",
   "kr": "안도 무척 훌륭했어요."
  },
  "149": {
   "jp": "53b2c518",
   "kr": "마법의 거울도 봤어요."
  },
  "150": {
   "jp": "f957c3cb",
   "kr": "대신관님과도 이야기했어요."
  },
  "151": {
   "jp": "27e49725",
   "kr": "그것참 다행입니다."
  },
  "152": {
   "jp": "ba7943d9",
   "kr": "저도 예전에"
  },
  "153": {
   "jp": "7ce2be0b",
   "kr": "대성당에서 수행했습니다만"
  },
  "154": {
   "jp": "a505c8f2",
   "kr": "생각이 나는군요…"
  },
  "155": {
   "jp": "aa7752b3",
   "kr": "쥬리오는 아까부터"
  },
  "156": {
   "jp": "5628b726",
   "kr": "계속 감동하고 있어요."
  },
  "157": {
   "jp": "fffbbcda",
   "kr": "아니, 아니"
  },
  "158": {
   "jp": "0b3c2642",
   "kr": "그건 지당한 말씀"
  },
  "159": {
   "jp": "103c7a17",
   "kr": "입니다."
  },
  "160": {
   "jp": "e77c2cca",
   "kr": "어쨌든 이걸로 저도 한시름 덜었습니다."
