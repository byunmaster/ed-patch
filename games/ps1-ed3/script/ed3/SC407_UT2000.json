{
 "archive": "/SCE4/SC407.DAT",
 "member": "..\\DATA\\UT2000.BIN",
 "lines": {
  "0": {
   "jp": "dcfb75fa",
   "kr": "트리프 관문"
  },
  "1": {
   "jp": "c182c53c",
   "kr": "우돌 병사"
  },
  "2": {
   "jp": "e9192f62",
   "kr": "칸드의 에포르"
  },
  "3": {
   "jp": "d740f65a",
   "kr": "우르바"
  },
  "4": {
   "jp": "dcfb75fa",
   "kr": "트리프 관문"
  },
  "5": {
   "jp": "a5fa16b5",
   "kr": "어디로 가겠다는 거야!"
  },
  "6": {
   "jp": "8c71b720",
   "kr": "어서 리즈의 집으로 가자!"
  },
  "7": {
   "jp": "ba930d7e",
   "kr": "그쪽으로 가면"
  },
  "8": {
   "jp": "57b31501",
   "kr": "올도스로 돌아가 버려."
  },
  "9": {
   "jp": "95bcc126",
   "kr": "여어, 수고가 많네."
  },
  "10": {
   "jp": "bcca9870",
   "kr": "여기서부터는 시플이나 올도스"
  },
  "11": {
   "jp": "f1cb5af2",
   "kr": "게다가 퓨엔테 쪽으로 갈 수 있어."
  },
  "12": {
   "jp": "c735845b",
   "kr": "출구를 착각하지 말게나."
  },
  "13": {
   "jp": "96524838",
   "kr": "우돌 쪽으로 빠지는 건 그대로 가세요."
  },
  "14": {
   "jp": "381e8bd8",
   "kr": "하이젠, 홀크로 향할 때는"
  },
  "15": {
   "jp": "5cdc136f",
   "kr": "각 담당자에게 통행증을 보이게나."
  },
  "16": {
   "jp": "bcc97b05",
   "kr": "하이젠 쪽은 왼쪽 방으로"
  },
  "17": {
   "jp": "a05969bb",
   "kr": "홀크 쪽은 오른쪽 방으로 가세요."
  },
  "18": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "19": {
   "jp": "34706559",
   "kr": "오, 은단검이군요."
  },
  "20": {
   "jp": "56af4189",
   "kr": "이쪽은 하이젠으로 가는 길입니다만"
  },
  "21": {
   "jp": "707f2d50",
   "kr": "괜찮으시겠지요?"
  },
  "22": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "23": {
   "jp": "b3907d82",
   "kr": "틀림없어요."
  },
  "24": {
   "jp": "c38a0468",
   "kr": "아, 기억하고말고요."
  },
  "25": {
   "jp": "d5d18eab",
   "kr": "은단검을 보여 줬던 친구군요."
  },
  "26": {
   "jp": "2492696f",
   "kr": "자, 지나가도 돼요."
  },
  "27": {
   "jp": "345d02ed",
   "kr": "혼자서 여행이라니 대단하네."
  },
  "28": {
   "jp": "80b33a22",
   "kr": "자, 지나가세요."
  },
  "29": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "30": {
   "jp": "24489435",
   "kr": "은단검이군요."
  },
  "31": {
   "jp": "3bbcb4da",
   "kr": "지나셔도 괜찮습니다만"
  },
  "32": {
   "jp": "23d72102",
   "kr": "이쪽은 홀크로 향하는 길이에요."
  },
  "33": {
   "jp": "035ddc4f",
   "kr": "정말 괜찮으신가요?"
  },
  "34": {
   "jp": "fd7d460c",
   "kr": "앗, 틀렸다."
  },
  "35": {
   "jp": "714aaac1",
   "kr": "미안해요."
  },
  "36": {
   "jp": "354ce955",
   "kr": "이쪽이 아니었어요."
  },
  "37": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "38": {
   "jp": "04dc0f52",
   "kr": "저는 칸드의 에포르입니다."
  },
  "39": {
   "jp": "f17ac373",
   "kr": "칸드 마법을 쓰실 수 있는 분이 계시면"
  },
  "40": {
   "jp": "b89b05c4",
   "kr": "마법을 전수해 드리지요."
  },
  "41": {
   "jp": "89255841",
   "kr": "어느 분께 전수할까요?"
  },
  "42": {
   "jp": "a8605649",
   "kr": "어느 마법을 원하시나요?"
  },
  "43": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "44": {
   "jp": "ee1ddb7d",
   "kr": "마음이 내키면 저를 찾아와 주세요."
  },
  "45": {
   "jp": "ad2c5716",
   "kr": "조금 전에"
  },
  "46": {
   "jp": "3029249e",
   "kr": "엄청난 미인이"
  },
  "47": {
   "jp": "ca26c4fa",
   "kr": "퓨엔테 쪽으로 걸어갔어."
  },
  "48": {
   "jp": "859493e3",
   "kr": "예뻤지…"
  },
  "49": {
   "jp": "855a3818",
   "kr": "앗, 당신은"
  },
  "50": {
   "jp": "546a04e9",
   "kr": "요전에 여기서 본"
  },
  "51": {
   "jp": "ec0f23d8",
   "kr": "그 미인…"
  },
  "52": {
   "jp": "a8c6f142",
   "kr": "우르바는 샤라를 보고 얼굴이 빨개졌다."
  },
  "53": {
   "jp": "2e6303f6",
   "kr": "한 번 더"
  },
  "54": {
   "jp": "9c484aac",
   "kr": "당신을 보고 싶어서"
  },
  "55": {
   "jp": "85b2ad4e",
   "kr": "여기서 기다리길 잘했어."
  },
  "56": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "57": {
   "jp": "55f48448",
   "kr": "넌 어째서"
  },
  "58": {
   "jp": "a1b24938",
   "kr": "그 미인이랑 같이 있는 거야?"
  },
  "59": {
   "jp": "30543bf7",
   "kr": "무슨 사이인 거야?"
  },
  "60": {
   "jp": "cd40fbd6",
   "kr": "벼, 별로…"
  },
  "61": {
   "jp": "4de3595a",
   "kr": "아무 사이도 아니에요."
  },
  "62": {
   "jp": "38abac5d",
   "kr": "좋겠다."
  },
  "63": {
   "jp": "d49f3254",
   "kr": "미인이랑 여행을 하다니…"
  },
  "64": {
   "jp": "801d0f9f",
   "kr": "미인에다 귀여운 아가씨까지."
  },
  "65": {
   "jp": "969e4b5b",
   "kr": "이야, 눈이 다 호강하네."
  }
 }
}
