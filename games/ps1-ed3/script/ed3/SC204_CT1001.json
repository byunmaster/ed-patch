  },
  "7": {
   "jp": "0a5e1957",
   "kr": "포리쉬"
  },
  "8": {
   "jp": "9c3b5f51",
   "kr": "안지"
  },
  "9": {
   "jp": "b4505917",
   "kr": "시켓트"
  },
  "10": {
   "jp": "00cdd041",
   "kr": "젠느"
  },
  "11": {
   "jp": "a76cf681",
   "kr": "치젤"
  },
  "12": {
   "jp": "a2dbf087",
   "kr": "토니카"
  },
  "13": {
   "jp": "436e6d7f",
   "kr": "트로바아!"
  },
  "14": {
   "jp": "363c61ec",
   "kr": "또 키타라를 들려주는 거야?"
  },
  "15": {
   "jp": "b7b1b2f6",
   "kr": "물론이지."
  },
  "16": {
   "jp": "1e49acf4",
   "kr": "그러려고 온 거니까."
  },
  "17": {
   "jp": "e87fc002",
   "kr": "신난다〜!!"
  },
  "18": {
   "jp": "9c43f1dd",
   "kr": "이런이런, 안지."
  },
  "19": {
   "jp": "4e4951f4",
   "kr": "눈이 핑 돌겠어."
  },
  "20": {
   "jp": "47715783",
   "kr": "그치만, 기쁜걸."
  },
  "21": {
   "jp": "38f31d23",
   "kr": "맞다!"
  },
  "22": {
   "jp": "bd5e5d8e",
   "kr": "모두한테 알려 줘야지!"
  },
  "23": {
   "jp": "6aaffcb6",
   "kr": "트로바 씨."
  },
  "24": {
   "jp": "fda3f7b3",
   "kr": "정말 다들 트로바 씨를 기다렸네요."
  },
  "25": {
   "jp": "1680a0ba",
   "kr": "음유시인이 오는 건"
  },
  "26": {
   "jp": "57a5c38a",
   "kr": "엄청 기쁜 일이에요."
  },
  "27": {
   "jp": "21ddc40a",
   "kr": "왠지 쑥스러워지는걸."
  },
  "28": {
   "jp": "03516df0",
   "kr": "앗, 키타라 악사구먼."
  },
  "29": {
   "jp": "02c9d58c",
   "kr": "키타라가 왔다라!"
  },
  "30": {
   "jp": "3f0ef019",
   "kr": "시트라 할아버지, 여전하시네요."
  },
  "31": {
   "jp": "a5a397dd",
   "kr": "그 말장난."
  },
  "32": {
   "jp": "79264f92",
   "kr": "말장난?"
  },
  "33": {
   "jp": "61231c60",
   "kr": "키타라와 왔다라를 엮은 거야."
  },
  "34": {
   "jp": "a03c93d5",
   "kr": "하하핫!"
  },
  "35": {
   "jp": "574c9d8c",
   "kr": "엄청 재밌어요!"
  },
  "36": {
   "jp": "87befcdf",
   "kr": "…진짜?"
  },
  "37": {
   "jp": "e50cfcac",
   "kr": "오옷!"
  },
  "38": {
   "jp": "e2923093",
   "kr": "트로바 아닌가!"
  },
  "39": {
   "jp": "013b8c67",
   "kr": "진짜로 왔구나!"
  },
  "40": {
   "jp": "73a0f2e9",
   "kr": "프레인 씨도 건강해 보이네요!"
  },
  "41": {
   "jp": "a0edd67f",
   "kr": "자네가 와 주면"
  },
  "42": {
   "jp": "f7aa8e40",
   "kr": "금방 기운이 난다고!"
  },
  "43": {
   "jp": "52502f16",
   "kr": "이놈!"
  },
  "44": {
   "jp": "3bc1f0fa",
   "kr": "어지간히도 오랜만이구먼!"
  },
  "45": {
   "jp": "5ea6a47a",
   "kr": "리그레 할머니."
  },
  "46": {
   "jp": "7b528a97",
   "kr": "다리 상태는 어떠세요?"
  },
  "47": {
   "jp": "0c1ca1c7",
   "kr": "어서 네 키타라를 들려주렴."
  },
  "48": {
   "jp": "0bad6173",
   "kr": "그러면 싹 나을 게야."
  },
  "49": {
   "jp": "4e3eb6c0",
   "kr": "네, 힘내겠습니다."
  },
  "50": {
   "jp": "833b123f",
   "kr": "냅 촌장님, 오랜만입니다."
  },
  "51": {
   "jp": "fd58f9a9",
   "kr": "잘 와 주셨습니다."
  },
  "52": {
   "jp": "7e7c857b",
   "kr": "오시기만을"
  },
  "53": {
   "jp": "db8ebc31",
   "kr": "손꼽아 기다렸습니다."
  },
  "54": {
   "jp": "e807076f",
   "kr": "아뇨, 당치도 않습니다."
  },
  "55": {
   "jp": "060b1c4f",
   "kr": "제가 오는 것을 기다려 주셨다니"
  },
  "56": {
   "jp": "22a59036",
   "kr": "키타라 악사로서"
  },
  "57": {
   "jp": "f3a83c65",
   "kr": "정말 기쁜 일입니다."
  },
  "58": {
   "jp": "bcba2540",
   "kr": "자네들이"
  },
  "59": {
   "jp": "1dd9db2c",
   "kr": "불러와 준 겐가?"
  },
  "60": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "61": {
   "jp": "62a8dbd3",
   "kr": "아니에요, 우연이에요."
  },
  "62": {
   "jp": "0e300329",
   "kr": "오는 길에"
  },
  "63": {
   "jp": "205e298f",
   "kr": "딱 마주쳤어요."
  },
  "64": {
   "jp": "f206c040",
   "kr": "그런가, 그런가."
  },
  "65": {
   "jp": "3565c676",
   "kr": "정말 고맙네."
  },
  "66": {
   "jp": "69cc8f52",
   "kr": "촌장님!"
  },
  "67": {
   "jp": "1324a90b",
   "kr": "얼른 트로바 연주 좀 시켜 주쇼!"
  },
  "68": {
   "jp": "9f3504fe",
   "kr": "자, 그리 서두르지 말게."
  },
  "69": {
   "jp": "ba432ef8",
   "kr": "곧 다들 모일 걸세."
  },
  "70": {
   "jp": "d880df12",
   "kr": "트로바아〜"
  },
  "71": {
   "jp": "d60c0b00",
   "kr": "다들한테 알리고 와 버렸어."
  },
  "72": {
   "jp": "c4b2c287",
   "kr": "고마워, 안지."
  },
  "73": {
   "jp": "9b3f7e62",
   "kr": "착한 아이구나."
  },
  "74": {
   "jp": "27f091e6",
   "kr": "에헤헤."
  },
  "75": {
   "jp": "ad8790fb",
   "kr": "다 모였구먼."
  },
  "76": {
   "jp": "73c515e2",
   "kr": "다들 보다시피"
  },
  "77": {
   "jp": "c04c074b",
   "kr": "오늘은 키타라 악사 트로바 씨가"
  },
  "78": {
   "jp": "668eb0f3",
   "kr": "이 마을에 와 주셨네."
  },
  "79": {
   "jp": "dde27a47",
   "kr": "트로바 씨는"
  },
  "80": {
   "jp": "8334d1b1",
   "kr": "여태껏 몇 번이나 이 마을을"
  },
  "81": {
   "jp": "341d30df",
   "kr": "찾아 주셨네."
  },
  "82": {
   "jp": "4116c34d",
   "kr": "뭔가, 평소랑 다르군."
  },
  "83": {
   "jp": "710be7bd",
   "kr": "촌장이 연설을 하다니."
  },
  "84": {
   "jp": "fbd7f335",
   "kr": "나는 큰 결심을 했다네."
  },
  "85": {
   "jp": "02ffa0f8",
   "kr": "다들 들어 주게!"
  },
  "86": {
   "jp": "414a0200",
   "kr": "여태껏 우리는"
  },
  "87": {
   "jp": "f2a7eeac",
   "kr": "옆 다이스와 이것저것 견주며"
  },
  "88": {
   "jp": "1445f6a5",
   "kr": "주눅만 들어 있었네."
  },
  "89": {
   "jp": "1b318ea0",
   "kr": "그래서는"
  },
  "90": {
   "jp": "4fa9cbf3",
   "kr": "언제까지고"
  },
  "91": {
   "jp": "b6a1c488",
   "kr": "안 되는 게야."
  },
  "92": {
   "jp": "c04c074b",
   "kr": "오늘은 키타라 악사 트로바 씨가"
  },
  "93": {
   "jp": "1f0c540e",
   "kr": "마을에 와 주셨네. 우리 마음을 새로 다잡을"
  },
  "94": {
   "jp": "274462ba",
   "kr": "좋은 기회가 될 걸세."
  },
  "95": {
   "jp": "fd83b4c9",
   "kr": "트로바 씨의 즐거운 연주를 듣고"
  },
  "96": {
   "jp": "2060f6af",
   "kr": "다들 기세를 올려"
  },
  "97": {
   "jp": "db19b969",
   "kr": "다시 태어나 보지 않겠나!"
  },
  "98": {
   "jp": "ac698e3f",
   "kr": "나도 낮잠 촌장 별명을 반납하고"
  },
  "99": {
   "jp": "b75c0a11",
   "kr": "힘껏 애쓸 작정일세."
  },
  "100": {
   "jp": "de1ac649",
   "kr": "어떤가!?"
  },
  "101": {
   "jp": "c1c3d2ac",
   "kr": "알았어, 촌장님."
  },
  "102": {
   "jp": "cc520182",
   "kr": "나도 점점 오늘을 계기로"
  },
  "103": {
   "jp": "16d6c504",
   "kr": "다시 태어날 수 있을 것만 같아."
  },
  "104": {
   "jp": "8425215e",
   "kr": "난 여태 이 마을이 가난한 건"
  },
  "105": {
   "jp": "08153878",
   "kr": "그런 운명이니까 어쩔 수 없다고 여겼어."
  },
  "106": {
   "jp": "318bc533",
   "kr": "하지만, 그게 아니었구나."
  },
  "107": {
   "jp": "e0cb8fa4",
   "kr": "촌장님, 알겠어요."
  },
  "108": {
   "jp": "986e070d",
   "kr": "다 같이 한 번 더,"
  },
  "109": {
   "jp": "e0089921",
   "kr": "이 마을을 활기찬 마을로 만들어 봐요."
  },
  "110": {
   "jp": "ff3298d5",
   "kr": "노력하면, 분명 보답받을 거예요."
  },
  "111": {
   "jp": "084c1add",
   "kr": "그래, 주눅만 들어 있던"
  },
  "112": {
   "jp": "b5da1f51",
   "kr": "우리가 잘못한 거다."
  },
  "113": {
   "jp": "1c621a71",
   "kr": "이 다츠 마을을"
  },
  "114": {
   "jp": "db21927c",
   "kr": "빈민굴처럼 만들어 버린 건"
  },
  "115": {
   "jp": "6215c410",
   "kr": "우리 자신이었다."
  },
  "116": {
   "jp": "5611b88d",
   "kr": "응, 그래."
  },
  "117": {
   "jp": "08ce3e7f",
   "kr": "트로바 씨 연주를 듣고"
  },
  "118": {
   "jp": "ffed74a7",
   "kr": "이 마을을 다시 세우자!"
  },
  "119": {
   "jp": "88789009",
   "kr": "고맙네, 다들."
  },
  "120": {
   "jp": "98b41bc0",
   "kr": "정말 고맙네."
  },
  "121": {
   "jp": "b0087906",
   "kr": "고맙네. 고맙네."
  },
  "122": {
   "jp": "f9b60649",
   "kr": "그럼 트로바 씨에게 키타라"
  },
  "123": {
   "jp": "076b0ece",
   "kr": "연주를 청하겠네."
  },
  "124": {
   "jp": "915f9e46",
   "kr": "트로바 씨"
  },
  "125": {
   "jp": "e4996b3c",
   "kr": "잘 부탁드립니다."
  },
  "126": {
   "jp": "3acbac82",
   "kr": "네, 알겠습니다."
  },
  "127": {
   "jp": "eac490bc",
   "kr": "오늘은 여러분의 기념할 만한 날에"
  },
  "128": {
   "jp": "10e81100",
   "kr": "연주하게 되어"
  },
  "129": {
   "jp": "ad7c5b7e",
   "kr": "대단히 영광입니다."
  },
  "130": {
   "jp": "d8a9c82f",
   "kr": "저는 언젠가 반드시 여러분이"
  },
  "131": {
   "jp": "cac271d6",
   "kr": "기운을 내 주실 때가 오리라 믿고"
  },
  "132": {
   "jp": "03257e36",
   "kr": "몇 번이나 이 마을을 찾아왔습니다."
  },
  "133": {
   "jp": "3e60323f",
   "kr": "지금은 울고 싶을 만큼 감동했습니다."
  },
  "134": {
   "jp": "f23a2372",
   "kr": "그럼 첫 곡을 들어 주십시오."
  },
  "135": {
   "jp": "9251e871",
   "kr": "제목은 『보아라, 내 기운!』입니다."
  },
  "136": {
   "jp": "7cc47ce7",
   "kr": "좋았어 다이스는 아니지만 운 시험이다!"
  },
  "137": {
   "jp": "d5c5b091",
   "kr": "이 곡이 멋지게 성공하면"
  },
  "138": {
   "jp": "e705c65f",
   "kr": "난 오늘부터 다시 태어나 일하겠다!"
  },
  "139": {
   "jp": "2c097252",
   "kr": "그렇지!"
  },
  "140": {
   "jp": "94a14048",
   "kr": "주눅만 들어 있던 어제까지와는"
  },
  "141": {
   "jp": "e0edc693",
   "kr": "작별이다."
  },
  "142": {
   "jp": "d6fbf68a",
   "kr": "혀, 현이… 끊어져 버렸어."
  },
  "143": {
   "jp": "b0b59d6a",
   "kr": "갑자기 시간이 멈춰 버리기라도 한 듯이"
  },
  "144": {
   "jp": "3ce1604c",
   "kr": "마을 사람들은 얼어붙어 버렸다."
  },
  "145": {
   "jp": "1a9224cf",
   "kr": "모처럼 달아오른 사람들의 의욕도"
  },
  "146": {
   "jp": "ee67914e",
   "kr": "현이 끊어진 것과 동시에 날아가 버렸다."
  },
  "147": {
   "jp": "1f393b71",
   "kr": "안 되는구나…"
  },
  "148": {
   "jp": "db56386c",
   "kr": "역시, 이 마을은"
  },
  "149": {
   "jp": "4f1990f3",
   "kr": "가난에서 못 벗어나…"
  },
  "150": {
   "jp": "81993d06",
   "kr": "이게 운명인가 봐."
  },
  "151": {
   "jp": "0cf85da9",
   "kr": "분명 이 마을엔"
  },
  "152": {
   "jp": "4d9702d8",
   "kr": "활기가 있으면 안 되는 거야."
  },
  "153": {
   "jp": "f6dd3952",
   "kr": "다들 기다려요!"
  },
  "154": {
   "jp": "c617dc96",
   "kr": "현 따위"
  },
  "155": {
   "jp": "b4ee37a0",
   "kr": "금방 고칠 수 있으니까요!!"
  }
 }
