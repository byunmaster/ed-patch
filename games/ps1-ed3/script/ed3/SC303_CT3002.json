  "10": {
   "jp": "0f419574",
   "kr": "그렇지."
  },
  "11": {
   "jp": "1abf6761",
   "kr": "사람이 사라질 리가 없지."
  },
  "12": {
   "jp": "3cc8348f",
   "kr": "방금 그 사람…"
  },
  "13": {
   "jp": "00d8012c",
   "kr": "사라져 버렸어."
  },
  "14": {
   "jp": "af676635",
   "kr": "에, 에이, 참."
  },
  "15": {
   "jp": "64d02988",
   "kr": "겁주기는 없기야."
  },
  "16": {
   "jp": "c4578de0",
   "kr": "내 기분 탓일까?"
  },
  "17": {
   "jp": "587ca49d",
   "kr": "맞아."
  },
  "18": {
   "jp": "a878335a",
   "kr": "사람이 사라질 리가 없잖아."
  },
  "19": {
   "jp": "d1e92e3f",
   "kr": "방금 그 남자…"
  },
  "20": {
   "jp": "6b13f9bd",
   "kr": "왜 그러세요?"
