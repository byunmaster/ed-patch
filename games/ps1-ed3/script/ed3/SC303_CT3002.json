  "66": {
   "jp": "cab43ff1",
   "kr": "틀림없을 거예요."
  },
  "67": {
   "jp": "dec211ea",
   "kr": "가루가 소동이 가라앉은 뒤로"
  },
  "68": {
   "jp": "0118b7a0",
   "kr": "다리를 건너는 사람이 줄어든"
