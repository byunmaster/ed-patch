  "60": {
   "jp": "5993fbf8",
   "kr": "아뇨, 없었어요."
  },
  "61": {
   "jp": "f0189e22",
   "kr": "무슨 일 있어요?"
  },
  "62": {
   "jp": "7c415ea9",
   "kr": "아뇨. 됐어요."
