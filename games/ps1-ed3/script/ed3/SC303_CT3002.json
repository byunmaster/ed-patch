  "21": {
   "jp": "a0ad9869",
   "kr": "모리슨 씨."
  },
  "22": {
   "jp": "4c527038",
   "kr": "아뇨, 기분 탓이겠지만"
  },
  "23": {
   "jp": "848390e0",
   "kr": "아까 그 남자가 사라진 것처럼 보였습니다."
  },
  "24": {
   "jp": "fbed1780",
   "kr": "사, 사, 사, 사라졌다니…"
  },
  "25": {
   "jp": "3e8164e0",
   "kr": "아까 그 사람이!"
  },
  "26": {
   "jp": "3ffa9afe",
   "kr": "모리슨 씨, 저희 상대하느라"
  },
  "27": {
   "jp": "bba753cd",
   "kr": "분명 피곤하신 거예요."
  },
  "28": {
   "jp": "587ca49d",
   "kr": "맞아."
  },
  "29": {
   "jp": "1abf6761",
   "kr": "사람이 사라질 리가 없지."
  },
  "30": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "31": {
   "jp": "64c71d47",
   "kr": "네, 수고하셨습니다."
  },
  "32": {
   "jp": "ca86c3b7",
   "kr": "그건 그렇고"
  },
  "33": {
   "jp": "0b5115ae",
   "kr": "오늘은 다리 건너는 사람이 적네요."
  },
  "34": {
   "jp": "3a4dd6af",
   "kr": "정말 그러네요."
  },
  "35": {
   "jp": "8c09a2b4",
   "kr": "우리도 아까 할아버지 한 분과"
  },
  "36": {
   "jp": "00ee3920",
   "kr": "스쳐 지나갔을 뿐인걸요."
  },
  "37": {
   "jp": "bb2a7853",
   "kr": "할아버지?"
  },
  "38": {
   "jp": "e0c73533",
   "kr": "이상한걸…"
  },
  "39": {
   "jp": "50b6f066",
   "kr": "오늘은 할아버지 같은 분"
  },
  "40": {
   "jp": "f2e093e1",
   "kr": "지나가지 않았는데."
  },
  "41": {
   "jp": "b8ca6dc9",
   "kr": "엇, 그치만…우리"
  },
  "42": {
   "jp": "97c55c25",
   "kr": "아까 다리 위에서"
  },
  "43": {
   "jp": "83448f9a",
   "kr": "막 만났는걸요."
  },
  "44": {
   "jp": "45770c86",
   "kr": "또, 농담을 해서"
  },
  "45": {
   "jp": "dcfd9ee5",
   "kr": "아저씨를 겁주려는 거군요."
  },
  "46": {
   "jp": "640be572",
   "kr": "하마터면 속을 뻔했어요."
  },
  "47": {
   "jp": "eb757965",
   "kr": "그게 정말이면 유령이죠."
  },
  "48": {
   "jp": "2268f497",
   "kr": "아하하하하…"
  },
  "49": {
   "jp": "8db702e6",
   "kr": "저자들이 가루가 계획을 방해한 놈들인가…"
  },
  "50": {
   "jp": "8c63a29a",
   "kr": "그만한 힘이 있다고는 여겨지지 않지만,"
  },
  "51": {
   "jp": "8cbe24c6",
   "kr": "보고만은 해 두기로 할까."
  },
  "52": {
   "jp": "9bdb3087",
   "kr": "훗훗훗훗훗…"
  },
  "53": {
   "jp": "10957a32",
   "kr": "대낮부터 유령 따위 안 나와요."
