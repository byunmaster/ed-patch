 "lines": {
  "0": {
   "jp": "ff7be70f",
   "kr": "다이스"
  },
  "1": {
   "jp": "aa985407",
   "kr": "지배인 리바레"
  },
  "2": {
   "jp": "50e6b00a",
   "kr": "마이아"
  },
  "3": {
   "jp": "d9c98b3d",
   "kr": "그란츠"
  },
  "4": {
   "jp": "5837ee16",
   "kr": "앗, 역시"
  },
  "5": {
   "jp": "11819567",
   "kr": "아직 있잖아."
  },
  "6": {
   "jp": "07989791",
   "kr": "정말 못 말려."
  },
  "7": {
   "jp": "624c8aa8",
   "kr": "저기, 루레 영감님."
  },
  "8": {
   "jp": "59498a6c",
   "kr": "적당히 하시고 슬슬 튜엘로"
  },
  "9": {
   "jp": "799d2705",
   "kr": "돌아가시는 게 좋겠어요."
  },
  "10": {
   "jp": "a7cd050f",
   "kr": "옳지, 와라!"
  },
  "11": {
   "jp": "20a883d0",
   "kr": "거기다 들어가라, 들어가!"
  },
  "12": {
   "jp": "b8787a65",
   "kr": "좋아, 좋아."
  },
  "13": {
   "jp": "8eb7cdec",
   "kr": "루레는 룰렛에 푹 빠져서"
  },
  "14": {
   "jp": "9f1cfa1d",
   "kr": "크리스가 말을 걸어도"
  },
  "15": {
   "jp": "7704704e",
   "kr": "전혀 알아차리지 못한다."
  },
  "16": {
   "jp": "f57f6e36",
   "kr": "굴러라!"
  },
  "17": {
   "jp": "228db801",
   "kr": "옳지!"
  },
  "18": {
   "jp": "14852a94",
   "kr": "조금만 더다!"
  },
  "19": {
   "jp": "ac1af797",
   "kr": "안 되겠어."
  },
  "20": {
   "jp": "44a3ca83",
   "kr": "전혀 안 듣고 있어."
  },
  "21": {
   "jp": "5245578e",
   "kr": "룰렛이 멈췄다."
  },
  "22": {
   "jp": "a09b7a0c",
   "kr": "빨강 16."
  },
  "23": {
   "jp": "aa89b1fe",
   "kr": "루레의 대박이다!"
  },
  "24": {
   "jp": "5f60b69f",
   "kr": "호호호오"
  },
  "25": {
   "jp": "72e3eccf",
   "kr": "또, 대박이로다!"
  },
  "26": {
   "jp": "a44b1a34",
   "kr": "미안하이 리바레."
  },
  "27": {
   "jp": "c0077e49",
   "kr": "나를 봉으로 삼겠다는 생각은"
  },
  "28": {
   "jp": "6ba91173",
   "kr": "10만 년은 일러."
  },
  "29": {
   "jp": "5f0503c3",
   "kr": "핫핫핫핫핫…!"
  },
  "30": {
   "jp": "1a2d336f",
   "kr": "크으으으…"
  },
  "31": {
   "jp": "363b0c6e",
   "kr": "어, 어째서 당신은"
  },
  "32": {
   "jp": "558f2f43",
   "kr": "그렇게 운이 좋은 겁니까."
  },
  "33": {
   "jp": "668023ae",
   "kr": "좋네, 가르쳐 주지."
  },
  "34": {
   "jp": "118e6d96",
   "kr": "말하자면"
  },
  "35": {
   "jp": "acbfeacc",
   "kr": "무욕의 승리라네."
  },
  "36": {
   "jp": "1d888e9e",
   "kr": "거짓말 마라. 내기에 이기려고"
  },
  "37": {
   "jp": "f53f6a5d",
   "kr": "카지노에 다니면서,"
  },
  "38": {
   "jp": "79598226",
   "kr": "욕심이 없다니 거짓말이죠."
  },
  "39": {
   "jp": "f6281897",
   "kr": "핫핫핫"
  },
  "40": {
   "jp": "f17bd7f6",
   "kr": "마음대로 말하게나."
  },
  "41": {
   "jp": "162f51e3",
   "kr": "내 승리네."
  },
  "42": {
   "jp": "c0e690be",
   "kr": "루레 영감님."
  },
  "43": {
   "jp": "14c72206",
   "kr": "늘 빈털터리로 돌아온다고"
  },
  "44": {
   "jp": "0340f0a1",
   "kr": "관문 사람들은 말했는데"
  },
  "45": {
   "jp": "b5d7170e",
   "kr": "얘기가 한참 다르잖아요."
  },
  "46": {
   "jp": "5bd08cf6",
   "kr": "오오, 자네들인가."
  },
  "47": {
   "jp": "daac0db9",
   "kr": "잘 지냈는가."
  },
  "48": {
   "jp": "62587f62",
   "kr": "잘 지냈는가가 아니잖아요."
  },
  "49": {
   "jp": "9412b3c3",
   "kr": "이제 실컷 노셨잖아요."
  },
  "50": {
   "jp": "5ab87b29",
   "kr": "이기고 있을 때"
  },
  "51": {
   "jp": "53a6686d",
   "kr": "그만두시는 게 낫지 않아요?"
  },
  "52": {
   "jp": "0c6bf0c0",
   "kr": "그렇구먼."
  },
  "53": {
   "jp": "988e6b4d",
   "kr": "그럼, 조금만 더 하고 나서,"
  },
  "54": {
   "jp": "66521e75",
   "kr": "돌아가기로 할까."
  },
  "55": {
   "jp": "f1a15755",
   "kr": "리바레, 한판 더 하세."
  },
  "56": {
   "jp": "54b68ad7",
   "kr": "내 승부를"
  },
  "57": {
   "jp": "b141198b",
   "kr": "받아 주겠는가?"
  },
  "58": {
   "jp": "5515e805",
   "kr": "물론이죠."
  },
  "59": {
   "jp": "c4888e53",
   "kr": "이대로 먹고 튀게"
  },
  "60": {
   "jp": "ac9e6314",
   "kr": "둘 것 같습니까."
  },
  "61": {
   "jp": "8ff1ce61",
   "kr": "핫핫핫, 또 이겼구먼."
  },
  "62": {
   "jp": "32ee15c5",
   "kr": "유쾌하다, 유쾌해"
  },
  "63": {
   "jp": "167fc398",
   "kr": "참, 유쾌하구먼."
  },
  "64": {
   "jp": "ed218133",
   "kr": "조금만 더 하고 나서"
  },
  "65": {
   "jp": "66521e75",
   "kr": "돌아가기로 할까."
  },
  "66": {
   "jp": "f1a15755",
   "kr": "리바레, 한판 더 하세."
  },
  "67": {
   "jp": "54b68ad7",
   "kr": "내 승부를"
  },
  "68": {
   "jp": "b141198b",
   "kr": "받아 주겠는가?"
  },
  "69": {
   "jp": "5515e805",
   "kr": "물론이죠."
  },
  "70": {
   "jp": "c4888e53",
   "kr": "이대로 먹고 튀게"
  },
  "71": {
   "jp": "ac9e6314",
   "kr": "둘 것 같습니까."
  },
  "72": {
   "jp": "8bd0566c",
   "kr": "할 수 있으면 해 보게."
  },
  "73": {
   "jp": "0c5be871",
   "kr": "정말이지…"
  },
  "74": {
   "jp": "7fab209e",
   "kr": "루레 씨 같은 손님한테 걸리면"
  },
  "75": {
   "jp": "62cf272e",
   "kr": "장사고 뭐고 없당께."
  },
  "76": {
   "jp": "58c6656f",
   "kr": "그렇다고, 이대로 돌려보내면"
  },
  "77": {
   "jp": "0434941e",
   "kr": "나중에 바론 씨한테 크게 혼나고 말이야."
  },
  "78": {
   "jp": "32442e08",
   "kr": "어떻게든 되찾아야 하는데…"
  },
  "79": {
   "jp": "87f0dcab",
   "kr": "마치 보통이랑 반대네."
  },
  "80": {
   "jp": "08f11388",
   "kr": "루레 영감님은"
  },
  "81": {
   "jp": "619bd485",
   "kr": "그렇게 도박에 강한가?"
  },
  "82": {
   "jp": "6a77bf72",
   "kr": "실수였나…"
  },
  "83": {
   "jp": "7e832aa1",
   "kr": "적당히 벌게 해 줘서"
  },
  "84": {
   "jp": "93e55103",
   "kr": "돌려보내는 편이 나았으려나."
  },
  "85": {
   "jp": "9f3e6d89",
   "kr": "대단해요, 저 강함은 보통이 아니에요."
  },
  "86": {
   "jp": "12643c2a",
   "kr": "루레 씨와 지배인의 승부를 처음부터"
  },
  "87": {
   "jp": "8b6741a1",
   "kr": "보고 있었는데요."
  },
  "88": {
   "jp": "57a9252e",
   "kr": "벌써 수십 번이나 승부를 했는데도"
  },
  "89": {
   "jp": "7335a9ce",
   "kr": "저 루레 씨는"
  },
  "90": {
   "jp": "654a5860",
   "kr": "한 번도 지지 않았어요."
  },
  "91": {
   "jp": "259e299d",
   "kr": "저는 눈을 부릅뜨고 봤으니까"
  },
  "92": {
   "jp": "4b012e3c",
   "kr": "자신 있게 말하는데요,"
  },
  "93": {
   "jp": "b5d58dc7",
   "kr": "루레 씨는 속임수 같은 건 안 썼어요."
  },
  "94": {
   "jp": "d07e4551",
   "kr": "틀림없는 강운의 소유자예요."
  },
  "95": {
   "jp": "ca54dd90",
   "kr": "그 운 좀 나눠 받고 싶네요."
  },
  "96": {
   "jp": "3c6c6cbb",
   "kr": "루레 씨는 굉장한 분이네요."
  },
  "97": {
   "jp": "e77c4f74",
   "kr": "분명, 어딘가 마을의 대지주쯤 될 거예요."
  },
  "98": {
   "jp": "924357c9",
   "kr": "멋진 판돈 배짱이에요."
  },
  "99": {
   "jp": "a3d1e990",
   "kr": "아까부터"
  },
  "100": {
   "jp": "42e4ab49",
   "kr": "계속 지배인과 단둘이 승부하고 있어요."
  },
  "101": {
   "jp": "9d16088c",
   "kr": "저 같은 사람은 흉내도 못 내요."
  }
 }
