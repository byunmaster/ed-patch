 "lines": {
  "0": {
   "jp": "6e08114e",
   "kr": "안데라"
  },
  "1": {
   "jp": "f3b21c53",
   "kr": "성 아랫마을"
  },
  "2": {
   "jp": "422ac187",
   "kr": "말테"
  },
  "3": {
   "jp": "c30d2b6d",
   "kr": "고다"
  },
  "4": {
   "jp": "e5f26da7",
   "kr": "챠펠의 포라"
  },
  "5": {
   "jp": "b7f92a25",
   "kr": "피에르"
  },
  "6": {
   "jp": "24b5b26f",
   "kr": "이벨"
  },
  "7": {
   "jp": "0eb99b08",
   "kr": "벨느"
  },
  "8": {
   "jp": "2f88b752",
   "kr": "안느"
  },
  "9": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "10": {
   "jp": "64011b13",
   "kr": "쥬디"
  },
  "11": {
   "jp": "e1181b40",
   "kr": "녹스"
  },
  "12": {
   "jp": "df53b5b6",
   "kr": "트리나 할머니"
  },
  "13": {
   "jp": "5e767095",
   "kr": "리오"
  },
  "14": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "15": {
   "jp": "2ca2db4c",
   "kr": "두 분은 임금님과 아는 분들이시죠."
  },
  "16": {
   "jp": "2e72e9b0",
   "kr": "볼트에서는 신세를 졌습니다."
  },
  "17": {
   "jp": "971209ca",
   "kr": "이제"
  },
  "18": {
   "jp": "652dbb26",
   "kr": "마을을 떠나시다니,"
  },
  "19": {
   "jp": "b1830d60",
   "kr": "섭섭합니다."
  },
  "20": {
   "jp": "a496b05f",
   "kr": "못 보내 드립니다."
  },
  "21": {
   "jp": "db4510d0",
   "kr": "좀 더 이 마을에서 느긋하게"
  },
  "22": {
   "jp": "719226ea",
   "kr": "계세요."
  },
  "23": {
   "jp": "682a8da7",
   "kr": "정말이지, 리오 녀석은…"
  },
  "24": {
   "jp": "4fc3a9c9",
   "kr": "그저 붉은 고추를 사 오라고"
  },
  "25": {
   "jp": "cec5fd22",
   "kr": "부탁했을 뿐인데,"
  },
  "26": {
   "jp": "4f1a7cd2",
   "kr": "어디로 가 버린 걸까."
  },
  "27": {
   "jp": "42932eeb",
   "kr": "돌아오면"
  },
  "28": {
   "jp": "3eb080ce",
   "kr": "돌아오면 오늘이야말로 가만두지 않을 테다."
  },
  "29": {
   "jp": "6e783796",
   "kr": "할멈이 이제 안 돌아와도 된대."
  },
  "30": {
   "jp": "5009d975",
   "kr": "오늘은 어디서 자려나."
  },
  "31": {
   "jp": "a86535c4",
   "kr": "내 생각엔 말이지."
  },
  "32": {
   "jp": "866b6220",
   "kr": "요리 콘테스트는 말테 할멈이"
  },
  "33": {
   "jp": "725739fd",
   "kr": "우승하지 않을까 싶어."
  },
  "34": {
   "jp": "24868225",
   "kr": "뭐니 뭐니 해도"
  },
  "35": {
   "jp": "9033d10f",
   "kr": "의욕이 다르니까."
  },
  "36": {
   "jp": "7ad7f8da",
   "kr": "모나도 이벨도 요리는 잘하지만,"
  },
  "37": {
   "jp": "760b3016",
   "kr": "말테 할멈이 제일 연장자니까."
  },
  "38": {
   "jp": "fc3a4178",
   "kr": "역시, 연륜이지."
  },
  "39": {
   "jp": "8723aad2",
   "kr": "볼트에 갔던 병사한테 들었다만,"
  },
  "40": {
   "jp": "d0fb2631",
   "kr": "가루가 속에 마수가 숨어 있었다더군."
  },
  "41": {
   "jp": "69366800",
   "kr": "얌전한 가루가가 날뛰다니"
  },
  "42": {
   "jp": "1ff97970",
   "kr": "이상하다 여겼다고."
  },
  "43": {
   "jp": "675ce181",
   "kr": "역시 원인은 딴 데 있었구나."
  },
  "44": {
   "jp": "ca86c3b7",
   "kr": "그건 그렇고"
  },
  "45": {
   "jp": "0e8d2dd4",
   "kr": "어떻게 가루가 속에 마수가"
  },
  "46": {
   "jp": "99b9e4df",
   "kr": "들어갔던 걸까."
  },
  "47": {
   "jp": "d8d358d6",
   "kr": "나도 요리 콘테스트에 출전한단다."
  },
  "48": {
   "jp": "6d5f7839",
   "kr": "출전 예정자 중에선 제일 어리지만"
  },
  "49": {
   "jp": "c8cff8a5",
   "kr": "요리라면 누구에게도 지지 않을 자신 있어."
  },
  "50": {
   "jp": "5c2472d1",
   "kr": "성의 조리장 죠르노 님이"
  },
  "51": {
   "jp": "df3d3e14",
   "kr": "눈을 동그랗게 뜰 만한"
  },
  "52": {
   "jp": "644cc3bd",
   "kr": "맛있는 요리를 만들어 보일 거야."
  },
  "53": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "54": {
   "jp": "eed343b4",
   "kr": "뭐야, 르네가 아니었나?"
  },
  "55": {
   "jp": "9f21313c",
   "kr": "르네 녀석 아직 리오를 찾고 있으려나."
  },
  "56": {
   "jp": "179423fe",
   "kr": "미안, 미안."
  },
  "57": {
   "jp": "d763ec19",
   "kr": "르네는 내 딸이란다."
  },
  "58": {
   "jp": "c0ca611a",
   "kr": "리오는 말테 할머니네 손자로,"
  },
  "59": {
   "jp": "90ee6274",
   "kr": "딸의 놀이 친구지."
  },
  "60": {
   "jp": "c268bd14",
   "kr": "내일 요리 콘테스트가 있는데"
  },
  "61": {
   "jp": "609d6d29",
   "kr": "나는 요리를 잘 못해서"
  },
  "62": {
   "jp": "eadd4a44",
   "kr": "나갈 수 있는 사람이 부러워."
  },
  "63": {
   "jp": "4ce9a6d5",
   "kr": "그렇지."
  },
  "64": {
   "jp": "5cdb0f79",
   "kr": "우승한 사람한테 요리를 배워서"
  },
  "65": {
   "jp": "b4939365",
   "kr": "나도 힘내 볼까."
  },
  "66": {
   "jp": "c3871a7a",
   "kr": "비밀이다만."
  },
  "67": {
   "jp": "40cb5455",
   "kr": "녹스는 도구점 안느에게"
  },
  "68": {
   "jp": "3b2a2bac",
   "kr": "반해 있단다."
  },
  "69": {
   "jp": "e76e96ef",
   "kr": "엇, 무슨 일?"
  },
  "70": {
   "jp": "e4705769",
   "kr": "저기. 안느 씨 좋아하죠?"
  },
  "71": {
   "jp": "bae2d557",
   "kr": "게엑!"
  },
  "72": {
   "jp": "7b7366d3",
   "kr": "그렇게..대놓고.."
  },
  "73": {
   "jp": "1a542146",
   "kr": "그런 말…"
  },
  "74": {
   "jp": "b272c208",
   "kr": "… 들으면."
  },
  "75": {
   "jp": "5c0fc0c0",
   "kr": "녹스의 얼굴이 새빨개졌다."
  },
  "76": {
   "jp": "1b02ff05",
   "kr": "크리스, 불쌍하잖아."
  },
  "77": {
   "jp": "cd4e9721",
   "kr": "오지랖은 그만두자."
  },
  "78": {
   "jp": "7b298320",
   "kr": "그래도, 우물쭈물하는 건"
  },
  "79": {
   "jp": "2dab4f45",
   "kr": "보고 있을 수 없어요."
  },
  "80": {
   "jp": "154300cc",
   "kr": "잠깐, 이쪽으로 와 봐요."
  },
  "81": {
   "jp": "8f4e99cd",
   "kr": "벼, 별거 아냐…"
  },
  "82": {
   "jp": "d53ec28d",
   "kr": "난 수상한 사람 아니야."
  },
  "83": {
   "jp": "e9129d60",
   "kr": "이상하네요… 뭘 쭈뼛대는 거예요?"
  },
  "84": {
   "jp": "4714a4b1",
   "kr": "상관없잖아."
  },
  "85": {
   "jp": "4e2242e0",
   "kr": "그래도 서성거리면서"
  },
  "86": {
   "jp": "62329ef9",
   "kr": "쭈뼛대고 있으면,"
  },
  "87": {
   "jp": "c7670703",
   "kr": "수상한 사람으로 보여요."
  },
  "88": {
   "jp": "6560a2f6",
   "kr": "역시, 그런가…"
  },
  "89": {
   "jp": "db4f323a",
   "kr": "딱히 수상한 자는 아닌데 말이야."
  },
  "90": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "91": {
   "jp": "d5719409",
   "kr": "난 말이야… 실은…"
  },
  "92": {
   "jp": "e3e0855d",
   "kr": "도구점 안느 씨의"
  },
  "93": {
   "jp": "6b1cb99d",
   "kr": "콜록, 콜록! … 팬이거든."
  },
  "94": {
   "jp": "8d20e998",
   "kr": "녹스의 얼굴이 붉어졌다."
  },
  "95": {
   "jp": "66bfacb8",
   "kr": "아아… 안느 씨〜"
  },
  "96": {
   "jp": "8359f8c0",
   "kr": "정말 어쩔 수 없네요."
  },
  "97": {
   "jp": "154300cc",
   "kr": "잠깐, 이쪽으로 와 봐요."
  },
  "98": {
   "jp": "a1826fe9",
   "kr": "앗, 왔다."
  },
  "99": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "100": {
   "jp": "ee3f16a0",
   "kr": "죄, 죄, 죄, 죄송합니다."
  },
  "101": {
   "jp": "bcd31cbf",
   "kr": "다, 다, 다치신 데는 없으셨습니까?"
  },
  "102": {
   "jp": "4718110a",
   "kr": "어머, 녹스 씨."
  },
  "103": {
   "jp": "e3059aa2",
   "kr": "녹스 씨야말로 괜찮으세요?"
  },
  "104": {
   "jp": "e53bdc74",
   "kr": "저, 저, 저야 뭐…"
  },
  "105": {
   "jp": "b1437bde",
   "kr": "괜찮습니다."
  },
  "106": {
   "jp": "c0745d7b",
   "kr": "다행이에요."
  },
  "107": {
   "jp": "bd6db350",
   "kr": "안 다치셔서."
  },
  "108": {
   "jp": "b7c28de0",
   "kr": "아, 저저저저…"
  },
  "109": {
   "jp": "73215e11",
   "kr": "아… 안녕하세요."
  },
  "110": {
   "jp": "74fc6180",
   "kr": "안녕하세요, 녹스 씨."
  },
  "111": {
   "jp": "86d4d986",
   "kr": "조, 좋은 날씨네요."
  },
  "112": {
   "jp": "756c842c",
   "kr": "어, 어딘가"
  },
  "113": {
   "jp": "a1e80925",
   "kr": "가시던 참이었습니까?"
  },
  "114": {
   "jp": "45df7455",
   "kr": "아니요."
  },
  "115": {
   "jp": "9a60b039",
   "kr": "녹스 씨 목소리가 조금 들려서요."
  },
  "116": {
   "jp": "211b899d",
   "kr": "그렇군요… 하하, 하하."
  },
  "117": {
   "jp": "00889524",
   "kr": "저, 괜찮으시다면"
  },
  "118": {
   "jp": "5c529a0f",
   "kr": "가게에서 차라도 어떠세요?"
  },
  "119": {
   "jp": "e34edee0",
   "kr": "정말 맛있는 허브차가 있어."
  },
  "120": {
   "jp": "3e4caa26",
   "kr": "저, 저, 저를"
  },
  "121": {
   "jp": "2132c9f7",
   "kr": "차에 초대해"
  },
  "122": {
   "jp": "f57ff789",
   "kr": "주시는 겁니까?"
  },
  "123": {
   "jp": "8d399e4c",
   "kr": "녹스 씨"
  },
  "124": {
   "jp": "a5dd7736",
   "kr": "바쁘신가요?"
  },
  "125": {
   "jp": "bc5b8c5c",
   "kr": "다, 당치도 않습니다!"
  },
  "126": {
   "jp": "488dc1c1",
   "kr": "꼭 함께"
  },
  "127": {
   "jp": "099b8ef7",
   "kr": "차를, 차를, 차를"
  },
  "128": {
   "jp": "d7af985b",
   "kr": "마시게, 해 주십시오!"
  },
  "129": {
   "jp": "8d399e4c",
   "kr": "녹스 씨,"
  },
  "130": {
   "jp": "7f36b3da",
   "kr": "너무 들떠서"
  },
  "131": {
   "jp": "192e1dcf",
   "kr": "말이 이상해요."
  },
  "132": {
   "jp": "e9223ba1",
   "kr": "너희도 같이 어떻겠니?"
  },
  "133": {
   "jp": "cadb0695",
   "kr": "네〜에."
  },
  "134": {
   "jp": "558ed5c7",
   "kr": "안 돼, 쥬리오."
  },
  "135": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "136": {
   "jp": "45754b50",
   "kr": "우리 볼일 있잖아."
  },
  "137": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "138": {
   "jp": "934c53d5",
   "kr": "볼일 같은 게, 있었나?"
  },
  "139": {
   "jp": "b191a979",
   "kr": "됐으니까, 가자."
  },
  "140": {
   "jp": "f248701d",
   "kr": "안느 씨, 녹스 씨."
  },
  "141": {
   "jp": "304267af",
   "kr": "그럼 저희"
  },
  "142": {
   "jp": "bb84da67",
   "kr": "볼일이 있어서 실례할게요."
  },
  "143": {
   "jp": "1ba3cc6b",
   "kr": "앗, 어, 어이. 너희…"
  },
  "144": {
   "jp": "dc0f976b",
   "kr": "테이블에 앉은 녹스와 안느는"
  },
  "145": {
   "jp": "504979d2",
   "kr": "허브티를 마시며 즐겁게 이야기하고 있다."
  },
  "146": {
   "jp": "e39f4805",
   "kr": "잘됐네요, 녹스 씨."
  },
  "147": {
   "jp": "869b3c96",
   "kr": "안느 씨도 녹스 씨를"
  },
  "148": {
   "jp": "98a73d48",
   "kr": "싫어하지는 않는 것 같고"
  },
  "149": {
   "jp": "8e532fde",
   "kr": "저 둘, 잘될지도 몰라."
  },
  "150": {
   "jp": "27347dbb",
   "kr": "저기, 크리스. 볼일이 뭐야?"
  },
  "151": {
   "jp": "efb808be",
   "kr": "에〜, 이제 와서 무슨 소리야."
  },
  "152": {
   "jp": "d3fdc2e9",
   "kr": "정말, 쥬리오는 둔감하다니까."
  },
  "153": {
   "jp": "18196ca6",
   "kr": "둘만 있게 될 기회잖아."
  },
  "154": {
   "jp": "1800ae23",
   "kr": "우리가 있으면 방해잖아."
  },
  "155": {
   "jp": "ee133e0b",
   "kr": "앗, 그렇구나."
  },
  "156": {
   "jp": "c0343bcd",
   "kr": "잡화점 안의 녹스와 안느는"
  },
  "157": {
   "jp": "b9c90633",
   "kr": "허브티를 마시며"
  },
  "158": {
   "jp": "4338a92b",
   "kr": "즐겁게 이야기하고 있다."
  },
  "159": {
   "jp": "2e30c234",
   "kr": "방해하지 않는 게 좋을 것 같아."
  },
  "160": {
   "jp": "3d054291",
   "kr": "도구점을 이용하는 건"
  },
  "161": {
   "jp": "6d52671d",
   "kr": "조금 더 있다가 하자."
  },
  "162": {
   "jp": "50887e09",
   "kr": "고마워, 너희 덕분이야."
  },
  "163": {
   "jp": "8b3d880b",
   "kr": "역시 안느 씨는 멋져."
  },
  "164": {
   "jp": "26a38fef",
   "kr": "안느 씨와 함께"
  },
  "165": {
   "jp": "13cfdc4b",
   "kr": "차를 마시다니 행복해."
  },
  "166": {
   "jp": "9d1547ba",
   "kr": "어머, 너희구나. 어서 와."
  },
  "167": {
   "jp": "14c2ed4a",
   "kr": "녹스 씨 이야기는 정말 즐거워."
  },
  "168": {
   "jp": "327f578d",
   "kr": "아무리 얘기해도 질리지 않아."
  },
  "169": {
   "jp": "2e15d9a4",
   "kr": "다음에 녹스 씨한테"
  },
