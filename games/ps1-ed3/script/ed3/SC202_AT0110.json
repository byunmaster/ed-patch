  "41": {
   "jp": "da88a499",
   "kr": "앰비쉬가 무너져서야 되겠는가."
  },
  "42": {
   "jp": "9b3e3059",
   "kr": ""
  },
  "43": {
   "jp": "83e94553",
   "kr": "가루가를 여기서 막아 내려고"
