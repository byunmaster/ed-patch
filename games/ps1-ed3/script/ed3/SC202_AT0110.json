  "29": {
   "jp": "1b220be0",
   "kr": "대단하지."
  },
  "30": {
   "jp": "63cbf289",
   "kr": "그 나이에 칸드 마스터라니."
  },
  "31": {
   "jp": "cf27455b",
   "kr": "게다가 엄청난 미인이기까지 하고."
