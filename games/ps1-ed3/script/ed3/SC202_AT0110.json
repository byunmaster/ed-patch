  },
  "38": {
   "jp": "f5369be9",
   "kr": "치밀한 요격 작전을 세워"
  },
  "39": {
   "jp": "d724bc98",
   "kr": "싸울 준비는 완벽하다!"
  },
  "40": {
   "jp": "84e1a88b",
   "kr": "고작 해수 한 마리 따위에게 내 고향"
