{
 "archive": "/SCE2/SC206.DAT",
 "member": "..\\DATA\\AT0002.BIN",
 "lines": {
  "0": {
   "jp": "bf50e946",
   "kr": "볼트"
  },
  "1": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "2": {
   "jp": "c566ac45",
   "kr": "…로디."
  },
  "3": {
   "jp": "c7a38ae3",
   "kr": "계속 잠든 채야."
  },
  "4": {
   "jp": "645c6bf4",
   "kr": "괜찮을까."
  },
  "5": {
   "jp": "3e962db2",
   "kr": "여태까지의 무리가 탈이 난 게지."
  },
  "6": {
   "jp": "6b0d2a81",
   "kr": "가루가를 향한 미움이 그를 움직인 걸세."
  },
  "7": {
   "jp": "e5a5350a",
   "kr": "보통 인간이라면"
  },
  "8": {
   "jp": "948646c6",
   "kr": "진작 못 움직이게 됐을 걸세."
  },
  "9": {
   "jp": "e39e1ac9",
   "kr": "몸을 완전히 회복시키기 위해선"
  },
  "10": {
   "jp": "3c59f4be",
   "kr": "한동안 요양이 필요하겠지."
  },
  "11": {
   "jp": "569dca37",
   "kr": "마기사도 힘을 다 써 버려서"
  },
  "12": {
   "jp": "88080bbf",
   "kr": "잠들고 말았습니다."
  },
  "13": {
   "jp": "db5bfa19",
   "kr": "그만한 마법을 쓴 것입니다."
  },
  "14": {
   "jp": "ea58b34e",
   "kr": "푹 쉬게 둡시다."
  },
  "15": {
   "jp": "86632a21",
   "kr": "마기사가 잠들기 전에 말했습니다."
  },
  "16": {
   "jp": "36d158d0",
   "kr": "가루가를 조종하던"
  },
  "17": {
   "jp": "c1a8d01d",
   "kr": "기생수를 쓰러뜨림으로써"
  },
  "18": {
   "jp": "6404aedf",
   "kr": "가루가는 제정신을 되찾았답니다."
  },
  "19": {
   "jp": "d132126d",
   "kr": "이제 마을을 덮치는 일은 없습니다."
  },
  "20": {
   "jp": "353baf4c",
   "kr": "얌전히 자신의 바다로"
  },
  "21": {
   "jp": "c129f91f",
   "kr": "돌아갈 테니"
  },
  "22": {
   "jp": "d3abccc4",
   "kr": "안심하시라는 말이었습니다."
  },
  "23": {
   "jp": "2af0c987",
   "kr": "으음."
  },
  "24": {
   "jp": "687e95fb",
   "kr": "마기사에게도 이번엔 큰 부담을 주고 말았네."
  },
  "25": {
   "jp": "1d880f55",
   "kr": "모리슨. 마기사 곁에 있어 주게."
  },
  "26": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "27": {
   "jp": "12946475",
   "kr": "마음 써 주셔서 감사합니다."
  },
  "28": {
   "jp": "f1faa2dc",
   "kr": "쥬리오, 크리스."
  },
  "29": {
   "jp": "98b41bc0",
   "kr": "정말로 고맙네."
  },
  "30": {
   "jp": "c3c231cd",
   "kr": "로디를 비롯해서"
  },
  "31": {
   "jp": "65a3b9cf",
   "kr": "너희들의 협력이 없었다면"
  },
  "32": {
   "jp": "69c03d61",
   "kr": "작전은 성공하지 못했네."
  },
  "33": {
   "jp": "e1bc7c62",
   "kr": "앰비쉬가"
  },
  "34": {
   "jp": "7e929791",
   "kr": "구원받은 건"
  },
  "35": {
   "jp": "db848633",
   "kr": "정말로 너희들 덕분일세."
  },
  "36": {
   "jp": "5264a195",
   "kr": "고맙네, 감사하네."
  },
  "37": {
   "jp": "c27e4e66",
   "kr": "에이, 어쩐지 쑥스러운걸."
  },
  "38": {
   "jp": "098260aa",
   "kr": "나도…"
  },
  "39": {
   "jp": "32c1f47d",
   "kr": "알프한테 인사까지 받으면"
  },
  "40": {
   "jp": "12719257",
   "kr": "우쭐해져 버린단 말야."
  },
  "41": {
   "jp": "eebe39cc",
   "kr": "그건, 조금 다르거든."
  },
  "42": {
   "jp": "ed6192bb",
   "kr": "그보다"
  },
  "43": {
   "jp": "bb8940a4",
   "kr": "다른 병사들은 괜찮았던 거야?"
  },
  "44": {
   "jp": "27626043",
   "kr": "아아, 가루가에게 튕겨 나간 병사는"
  },
  "45": {
   "jp": "b3a0bdc2",
   "kr": "떨어진 곳이 운 좋게 모래사장이라"
  },
  "46": {
   "jp": "33d5eb4e",
   "kr": "가벼운 부상으로 그쳤네."
  },
  "47": {
   "jp": "c6e56306",
   "kr": "목숨을 잃은 자는 한 사람도 없어."
  },
  "48": {
   "jp": "c766f07d",
   "kr": "정말 다행이야."
  },
  "49": {
   "jp": "00638dbf",
   "kr": "폐하, 실례합니다."
  },
  "50": {
   "jp": "51e1de0d",
   "kr": "웬일인가?"
  },
  "51": {
   "jp": "c85c30ab",
   "kr": "가루가가 바다로 돌아갔습니다."
  },
  "52": {
   "jp": "44bf5e0a",
   "kr": "그건 그렇고, 굉장한 힘입니다."
  },
  "53": {
   "jp": "df64f83a",
   "kr": "그만큼 움직임을 봉했는데도"
  },
  "54": {
   "jp": "cd2f04b7",
   "kr": "너무나 쉽게 돌아갔습니다."
  },
  "55": {
   "jp": "7c2b4533",
   "kr": "자기 집으로 돌아갔네."
  },
  "56": {
   "jp": "06eeeec0",
   "kr": "제정신인 가루가가 상대였다면,"
  },
  "57": {
   "jp": "e32c2f1f",
   "kr": "우리에게 승산은"
  },
  "58": {
   "jp": "86e44103",
   "kr": "없었을지도 모르네."
  },
  "59": {
   "jp": "3c297597",
   "kr": "수고했네."
  },
  "60": {
   "jp": "9177af05",
   "kr": "각자 휴식하도록 전해 주게."
  },
  "61": {
   "jp": "4abd11a6",
   "kr": "옛!"
  },
  "62": {
   "jp": "c018878b",
   "kr": "그런데 이제부터 어쩔 셈인가?"
  },
  "63": {
   "jp": "1eaddbf3",
   "kr": "맞다."
  },
  "64": {
   "jp": "f39e4254",
   "kr": "우리 순례 여행 도중이었지."
  },
  "65": {
   "jp": "bd6613d5",
   "kr": "정말 참."
  },
  "66": {
   "jp": "bbef7b95",
   "kr": "가끔 잠꼬대 같은 소릴 한다니까."
  },
  "67": {
   "jp": "38f9e258",
   "kr": "다음은 이그니스 샤리네지."
  },
  "68": {
   "jp": "5afb24fb",
   "kr": "그런가, 남쪽으로 돌아 앰비쉬를 여행한다면"
  },
  "69": {
   "jp": "afc2b33b",
   "kr": "안데라를 지나게 되겠군."
  },
  "70": {
   "jp": "f1faa2dc",
   "kr": "쥬리오, 크리스."
  },
  "71": {
   "jp": "dbda0fc7",
   "kr": "부디 안데라에 들러 주게."
  },
  "72": {
   "jp": "af1da8e9",
   "kr": "진수성찬으로 대환영할 테니."
  },
  "73": {
   "jp": "c49f4f82",
   "kr": "진수성찬…"
  },
  "74": {
   "jp": "073941c5",
   "kr": "쥬리오 침 흘리고 있잖아."
  },
  "75": {
   "jp": "42973ae3",
   "kr": "꼭 성에 들를게."
  },
  "76": {
   "jp": "3f09f2ba",
   "kr": "네갈섬 근해에서 시작된 가루가 소동은,"
  },
  "77": {
   "jp": "1449486c",
   "kr": "쥬리오 일행의 활약으로,"
  },
  "78": {
   "jp": "16d890f8",
   "kr": "앰비쉬 항구 마을 볼트에서 마침내 해결됐다."
  },
  "79": {
   "jp": "d7fa2525",
   "kr": "쥬리오 일행은 알프레드의 초대를 받아,"
  },
  "80": {
   "jp": "2dc02d08",
   "kr": "안데라성에서의 재회를 기약하고"
  },
  "81": {
   "jp": "b3538f80",
   "kr": "순례 여행으로 돌아가기로 했다."
  },
  "82": {
   "jp": "99bbc9e5",
   "kr": "다음 목적지는 불의 샤리네, 이그니스."
  },
  "83": {
   "jp": "1e3fd736",
   "kr": "하지만, 수수께끼도 남았다."
  },
  "84": {
   "jp": "728f4b77",
   "kr": "가루가에 기생하고 있던"
  },
  "85": {
   "jp": "4b8c6530",
   "kr": "기생수 바제라를"
  },
  "86": {
   "jp": "409fc237",
   "kr": "소환한 것은 누구인가?"
  },
  "87": {
   "jp": "3d7b7f06",
   "kr": "아직, 순례를 계속하는 두 사람은,"
  },
  "88": {
   "jp": "a0246e7b",
   "kr": "자신들이 겪는 모든 일이,"
  },
  "89": {
   "jp": "66695e96",
   "kr": "하나의 굵은 줄기에서 갈라진 가지임을"
  },
  "90": {
   "jp": "394837f7",
   "kr": "깨닫지 못했다…"
  },
  "91": {
   "jp": "42af9751",
   "kr": "제２장　볼트 대결전　끝"
  }
 }
}