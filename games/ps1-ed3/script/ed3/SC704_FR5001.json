{
 "archive": "/SCE7/SC704.DAT",
 "member": "..\\DATA\\FR5001.BIN",
 "lines": {
  "0": {
   "jp": "118f0213",
   "kr": "게르드 언덕"
  },
  "1": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "2": {
   "jp": "1baedf85",
   "kr": "게르드는 레바스에게…"
  },
  "3": {
   "jp": "2761527e",
   "kr": "하지만, 보기에 따라서는"
  },
  "4": {
   "jp": "4b84603f",
   "kr": "스스로 레바스에게 패할 길을 택했다 보는 게"
  },
  "5": {
   "jp": "b9edd9b7",
   "kr": "옳을지도 모른다."
  },
  "6": {
   "jp": "e45b9b5b",
   "kr": "쓰러지는 길을."
  },
  "7": {
   "jp": "a605f309",
   "kr": "게르드의 역할은"
  },
  "8": {
   "jp": "02ef8ebf",
   "kr": "자신과 같은 족속인 이계의 왕비의 음모를"
  },
  "9": {
   "jp": "05680475",
   "kr": "저지하는 데 있었다."
  },
  "10": {
   "jp": "19af872a",
   "kr": "이계의 왕비…?"
  },
  "11": {
   "jp": "a5c5efc5",
   "kr": "내 나쁜 예감이 들어맞은 것이다."
  },
  "12": {
   "jp": "d76d8b6b",
   "kr": "이자벨 왕비…"
  },
  "13": {
   "jp": "17c3b0fe",
   "kr": "역시 돌페스에 밀려온 여자도"
  },
  "14": {
   "jp": "c7501f31",
   "kr": "이계에서 온 마녀였던 것이다."
  },
  "15": {
   "jp": "4694fa5c",
   "kr": "다만, 그 목적은 게르드와 달리"
  },
  "16": {
   "jp": "eb0136a4",
   "kr": "이 세계를 멸망시키는 데 있었다."
  },
  "17": {
   "jp": "a9a0345b",
   "kr": "어째서…?"
  },
  "18": {
   "jp": "35f10518",
   "kr": "왜…"
  },
  "19": {
   "jp": "7424b95e",
   "kr": "이 세계가 멸망당해야 하는 거야?"
  },
  "20": {
   "jp": "0ac68ea3",
   "kr": "모른다."
  },
  "21": {
   "jp": "163c4827",
   "kr": "어쨌든 게르드는 그 폭주를 알고"
  },
  "22": {
   "jp": "c389683b",
   "kr": "이자벨의 음모를 막기 위해"
  },
  "23": {
   "jp": "267ac8fa",
   "kr": "이 세계로 온 것이다."
  },
  "24": {
   "jp": "72b189e7",
   "kr": "그러나 그것은 도저히"
  },
  "25": {
   "jp": "0365e872",
   "kr": "혼자서 단번에"
  },
  "26": {
   "jp": "165e7048",
   "kr": "이룰 수 있는 일이 아니었다."
  },
  "27": {
   "jp": "d4e936da",
   "kr": "게르드는 다음 세대에 맡길 수밖에 없었다."
  },
  "28": {
   "jp": "c9a4a777",
   "kr": "사람들에게 경고를 주고"
  },
  "29": {
   "jp": "df492bb6",
   "kr": "그 호소에 세계가 눈을 돌리지 않으면"
  },
  "30": {
   "jp": "ecc5bcfc",
   "kr": "의미를 이루지 못했다."
  },
  "31": {
   "jp": "1d8f1968",
   "kr": "게르드는 죽임당하는 게"
  },
  "32": {
   "jp": "2659c310",
   "kr": "무섭지 않았을까…?"
  },
  "33": {
   "jp": "976d6d12",
   "kr": "마녀라 해도"
  },
  "34": {
   "jp": "fba0bd1c",
   "kr": "너와 나이도 별로 다르지 않은 아이다."
  },
  "35": {
   "jp": "49ef2963",
   "kr": "그것이 운명임을 알아도"
  },
  "36": {
   "jp": "c34f5e55",
   "kr": "공포를 느끼지 않을 리 없다."
  },
  "37": {
   "jp": "a30bd3de",
   "kr": "사람은 살아 있는 것만으로 멋진 일이다."
  },
  "38": {
   "jp": "a2137ca2",
   "kr": "그것을 버리면서까지"
  },
  "39": {
   "jp": "a3f0214e",
   "kr": "게르드는 우리 세계를 위해 죽었다."
  },
  "40": {
   "jp": "3adae119",
   "kr": "………"
  },
  "41": {
   "jp": "32d66b08",
   "kr": "레바스가 사라진 뒤"
  },
  "42": {
   "jp": "09120051",
   "kr": "나는 몰래 게르드를 여기 묻었다."
  },
  "43": {
   "jp": "4703b25b",
   "kr": "이미 루돌프 왕은"
  },
  "44": {
   "jp": "5d03acc5",
   "kr": "왕비의 마법으로 의식이 봉인되어"
  },
  "45": {
   "jp": "ecc7a9af",
   "kr": "꼭두각시나 다름없었다."
  },
  "46": {
   "jp": "1d51e886",
   "kr": "나는 들키지 않게 레바스와 왕비를 살폈으나"
  },
  "47": {
   "jp": "1275a748",
   "kr": "3년 전, 그놈들이 그걸 눈치채고"
  },
  "48": {
   "jp": "50ab2293",
   "kr": "나를 돌페스의 탑에 유폐한 것이다."
  },
  "49": {
   "jp": "9883c506",
   "kr": "라우알의 파도를 저지할 방법이"
  },
  "50": {
   "jp": "23604fd7",
   "kr": "있습니까?"
  },
  "51": {
   "jp": "aef96182",
   "kr": "단 하나"
  },
  "52": {
   "jp": "25ce7e1d",
   "kr": "게르드가 알려 준 방법이 있다."
  },
  "53": {
   "jp": "e898b212",
   "kr": "그것이 은단검이다."
  },
  "54": {
   "jp": "6660ecc3",
   "kr": "은단검이…?"
  },
  "55": {
   "jp": "1eaddbf3",
   "kr": "그렇다."
  },
  "56": {
   "jp": "f385cd8c",
   "kr": "왕비가 짓게 한 천의실에"
  },
  "57": {
   "jp": "d39ff1ec",
   "kr": "레바스가 의식에 쓰는 천구의가 있다."
  },
  "58": {
   "jp": "bd5c6f5c",
   "kr": "그 천구의가 매개가 되어"
  },
  "59": {
   "jp": "5b89c9ae",
   "kr": "재앙의 파도를 이 세계에 끌어당기고 있다."
  },
  "60": {
   "jp": "d8c851fd",
   "kr": "천구의는 이자벨의 힘에 결계로 보호되나"
  },
  "61": {
   "jp": "b0331b8b",
   "kr": "다섯 샤리네의 힘을 얻은 은단검이라면"
  },
  "62": {
   "jp": "a7a6aace",
   "kr": "그 결계를 깰 수 있다."
  },
  "63": {
   "jp": "872044a4",
   "kr": "하지만 그러려면 조건이 있다."
  },
  "64": {
   "jp": "a72c8af9",
   "kr": "실제로 순례를 해 온 사람이 쓰지 않으면"
  },
  "65": {
   "jp": "7cb82394",
   "kr": "샤리네의 힘은 작용하지 않는다."
  },
  "66": {
   "jp": "68e3b5c1",
   "kr": "천구의를 파괴하면"
  },
  "67": {
   "jp": "71d16471",
   "kr": "라우알의 파도가 이 세계로 오는 걸"
  },
  "68": {
   "jp": "4eed1858",
   "kr": "막을 수 있는 거군요."
  },
  "69": {
   "jp": "6aad6b39",
   "kr": "음, 아마도."
  },
  "70": {
   "jp": "d98f118b",
   "kr": "그렇다면, 이제 시간이 없잖아."
  },
  "71": {
   "jp": "f02542ba",
   "kr": "어서 성으로 가서, 그 천구의라는 걸"
  },
  "72": {
   "jp": "ad337285",
   "kr": "박살 내 버리자."
  },
  "73": {
   "jp": "e8f3455d",
   "kr": "자, 잠깐만."
  },
  "74": {
   "jp": "a629e7e7",
   "kr": "라우알의 파도에 대해서는"
  },
  "75": {
   "jp": "84670f9d",
   "kr": "꽤 알게 되었지만…"
  },
  "76": {
   "jp": "16511bda",
   "kr": "폴티아가 전쟁을 시작하려는 건"
  },
  "77": {
   "jp": "5a9a458e",
   "kr": "어째서일까…?"
  },
  "78": {
   "jp": "408b5b0f",
   "kr": "세계를 파멸시키는 게 목적이라면"
  },
  "79": {
   "jp": "86f0f077",
   "kr": "라우알의 파도만으로 충분하잖아."
  },
  "80": {
   "jp": "dd845a62",
   "kr": "확실히…"
  },
  "81": {
   "jp": "bfb85916",
   "kr": "나도 그게 마음에 걸렸다."
  },
  "82": {
   "jp": "5c773487",
   "kr": "마지막 예언에 있는 표정 없는 병사들의"
  },
  "83": {
   "jp": "9687a781",
   "kr": "설명도 되지 않으니 말이다."
  },
  "84": {
   "jp": "ca782d8c",
   "kr": "성에서 엿들은 이자벨과 레바스 이야기로는"
  },
  "85": {
   "jp": "96518098",
   "kr": "이계에 존재하는 라우알의 파도는"
  },
  "86": {
   "jp": "e3a7aae4",
   "kr": "탄식의 상념에 끌려온다고 한다."
  },
  "87": {
   "jp": "cb92193b",
   "kr": "전쟁이 일어나면 사람들은 슬퍼하고 탄식한다…"
  },
  "88": {
   "jp": "e5803db0",
   "kr": "아마 전쟁은"
  },
  "89": {
   "jp": "2cde2dca",
   "kr": "이계에서 라우알의 파도를 불러들이기 위한"
  },
  "90": {
   "jp": "17b549bc",
   "kr": "미끼일 것이다."
  },
  "91": {
   "jp": "0f9bc998",
   "kr": "너무해…그렇게까지 해서"
  },
  "92": {
   "jp": "51a948f9",
   "kr": "이 세계를 멸망시키려 하다니…"
  },
  "93": {
   "jp": "d0002338",
   "kr": "그럼, 시작할까."
  },
  "94": {
   "jp": "dd0a4856",
   "kr": "게르드는 죽었지만"
  },
  "95": {
   "jp": "5eecfa0e",
   "kr": "이 언덕에는"
  },
  "96": {
   "jp": "204236b2",
   "kr": "아직 게르드의 힘이 살아 있다."
  },
  "97": {
   "jp": "187c03f6",
   "kr": "그 힘을 은단검으로 끌어내는 것이다."
  },
  "98": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "99": {
   "jp": "dd4e35f4",
   "kr": "네 그 지팡이를 묘표 앞에 두어라."
  },
  "100": {
   "jp": "0469f5d9",
   "kr": "챠펠 마법을 쓰는 네 지팡이 속에"
  },
  "101": {
   "jp": "e5466290",
   "kr": "게르드의 힘을 깃들게 하여"
  },
  "102": {
   "jp": "e623027d",
   "kr": "가호를 얻을 수 있을 것이다."
  },
  "103": {
   "jp": "807bdf06",
   "kr": "그 지팡이라니…"
  },
  "104": {
   "jp": "931586ba",
   "kr": "이 지팡이?"
  },
  "105": {
   "jp": "6b58ea56",
   "kr": "라프 할아버지의 지팡이?"
  },
  "106": {
   "jp": "5aa6ef00",
   "kr": "그래, 그 지팡이다."
  },
  "107": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "108": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "109": {
   "jp": "13974049",
   "kr": "샤리네에서 하듯이"
  },
  "110": {
   "jp": "8e24cf04",
   "kr": "은단검을 두는 거다."
  },
  "111": {
   "jp": "587a18b6",
   "kr": "알았어."
  },
  "112": {
   "jp": "a32923e4",
   "kr": "굉장해…"
  },
  "113": {
   "jp": "c478f878",
   "kr": "엄청난 마력이 느껴져…"
  },
  "114": {
   "jp": "e33001a8",
   "kr": "앗, 검도…검도 빛나기 시작했어."
  },
  "115": {
   "jp": "bd76aa55",
   "kr": "지팡이가…"
  },
  "116": {
   "jp": "ab1bc7a9",
   "kr": "라프 할아버지에게 받은 지팡이 모양이"
  },
  "117": {
   "jp": "2edd4e7b",
   "kr": "바뀌었어."
  },
  "118": {
   "jp": "e3a7c5ad",
   "kr": "게르드의 지팡이가 된 것이다."
  },
  "119": {
   "jp": "9d335f48",
   "kr": "그 지팡이는 네가 가져라."
  },
  "120": {
   "jp": "95ebb7fc",
   "kr": "분명 네게 도움이 되어 줄 것이다."
  },
  "121": {
   "jp": "02828d59",
   "kr": "크리스는 게르드의 지팡이를 장비했다."
  },
  "122": {
   "jp": "0cf977aa",
   "kr": "이 검…새것 같아."
  },
  "123": {
   "jp": "18435a27",
   "kr": "아까까지 녹슬어 있었는데…"
  },
  "124": {
   "jp": "4f880a4a",
   "kr": "이것도 게르드의 힘이야?"
  },
  "125": {
   "jp": "2a46aed1",
   "kr": "나도 여기까지는"
  },
  "126": {
   "jp": "5a9e9f36",
   "kr": "예상하지 못했지만"
  },
  "127": {
   "jp": "6a206978",
   "kr": "아무래도 그런 모양이다."
  },
  "128": {
   "jp": "f39600b9",
   "kr": "그 검은 네가 가져라."
  },
  "129": {
   "jp": "6d72891f",
   "kr": "게르드가 주는 선물이다."
  },
  "130": {
   "jp": "243c7343",
   "kr": "하지만, 이 검은"
  },
  "131": {
   "jp": "5d489b0a",
   "kr": "듀르젤 씨의 검이잖아요?"
  },
  "132": {
   "jp": "76b45cff",
   "kr": "검이 검사의 증표였던 시대는"
  },
  "133": {
   "jp": "4091aa33",
   "kr": "끝났는지도 모른다."
  },
  "134": {
   "jp": "9c8fd571",
   "kr": "하지만, 나에게는 나의 고집이 있다."
  },
  "135": {
   "jp": "53410c22",
   "kr": "운명이야 어떻든"
  },
  "136": {
   "jp": "af0285b5",
   "kr": "게르드를 지키지 못한 나에게는"
  },
  "137": {
   "jp": "a360ed02",
   "kr": "이제 검을 들 자격이 없다."
  },
  "138": {
   "jp": "3a6f915c",
   "kr": "게다가 내게는"
  },
  "139": {
   "jp": "14db8910",
   "kr": "왠지, 네가 그 검을 드는 게"
  },
  "140": {
   "jp": "678c1e45",
   "kr": "어울릴 것처럼 여겨진다."
  },
  "141": {
   "jp": "3adae119",
   "kr": "………"
  },
  "142": {
   "jp": "36f2d09b",
   "kr": "응. 알았어."
  },
  "143": {
   "jp": "50e79cbe",
   "kr": "쓰도록 할게."
  },
  "144": {
   "jp": "e8854af9",
   "kr": "(이건, 꼭 가져가야 해.)"
  },
  "145": {
   "jp": "d9116751",
   "kr": "(뭔가 두고 가지 않으면…)"
  },
  "146": {
   "jp": "07c5da00",
   "kr": "쥬리오는 듀르젤의 검을 손에 넣었다."
  },
  "147": {
   "jp": "6e2290d6",
   "kr": "너희를 끌어들이고 만 듯하지만"
  },
  "148": {
   "jp": "80d8868d",
   "kr": "부디 용서해 다오."
  },
  "149": {
   "jp": "91100957",
   "kr": "지금 상황에서는"
  },
  "150": {
   "jp": "d8d588be",
   "kr": "다섯 샤리네를 돌아온 너희에게"
  },
  "151": {
   "jp": "8fc6260b",
   "kr": "희망을 걸 수밖에 없는 것이다."
  },
  "152": {
   "jp": "9554ce88",
   "kr": "신경 쓰지 마세요."
  },
  "153": {
   "jp": "f53cd6cb",
   "kr": "원래 성에는"
  },
  "154": {
   "jp": "4ce6719a",
   "kr": "가 볼 생각이었어요."
  },
  "155": {
   "jp": "f172a96d",
   "kr": "맞아."
  },
  "156": {
   "jp": "9abd9d87",
   "kr": "하얀마녀가 목숨까지 걸었는데"
  },
  "157": {
   "jp": "fb85ec5f",
   "kr": "모른 척 못 해요."
  },
  "158": {
   "jp": "8153b987",
   "kr": "저도 함께 가겠어요."
  },
  "159": {
   "jp": "c3bbc00d",
   "kr": "나도 간다."
  },
  "160": {
   "jp": "6846c461",
   "kr": "저도 모시겠습니다."
  },
  "161": {
   "jp": "5e8be004",
   "kr": "자, 잠깐 기다려."
  },
  "162": {
   "jp": "fb9c0f2d",
   "kr": "다 같이 맞서려는 마음은"
  },
  "163": {
   "jp": "ecaafa66",
   "kr": "소중하다고 생각하지만…"
  },
  "164": {
   "jp": "661d9e4e",
   "kr": "아무래도 나는"
  },
  "165": {
   "jp": "ed588321",
   "kr": "석연치 않은 점이 있어."
  },
  "166": {
   "jp": "f9298d4b",
   "kr": "정말 천구의를 파괴하는 것만으로"
  },
  "167": {
   "jp": "48078931",
   "kr": "원만히 수습될까…?"
  },
  "168": {
   "jp": "9d7b5d3c",
   "kr": "그걸로 라우알의 파도를 막을 수 있다면"
  },
  "169": {
   "jp": "3dd5b2ce",
   "kr": "하얀마녀라면 처음부터 천구의를 못 만들게"
  },
  "170": {
   "jp": "b93138fe",
   "kr": "할 방법은 얼마든지 있었을 거야."
  },
  "171": {
   "jp": "c2685d40",
   "kr": "아저씨"
  },
  "172": {
   "jp": "9d2f9f31",
   "kr": "모처럼 기합이 들어갔는데"
  },
  "173": {
   "jp": "e7e4bf06",
   "kr": "김을 빼고 그러네…"
  },
  "174": {
   "jp": "434f8132",
   "kr": "아니, 허크 공의 말이 옳다."
  },
  "175": {
   "jp": "5398c66f",
   "kr": "아직, 우리가 모르는 진실이 있을 듯하다."
  },
  "176": {
   "jp": "da140203",
   "kr": "조사하고 싶은 게 있어."
  },
  "177": {
   "jp": "08fdd60c",
   "kr": "바다트와 죠안나 씨."
  },
  "178": {
   "jp": "40802a6c",
   "kr": "괜찮다면"
  },
  "179": {
   "jp": "2e62ddfb",
   "kr": "나와 함께 가 주지 않겠어?"
  },
  "180": {
   "jp": "16e726c0",
   "kr": "어디로?"
  },
  "181": {
   "jp": "8deec05a",
   "kr": "기드나로 건너가려고 해."
  },
  "182": {
   "jp": "e2dc29ff",
   "kr": "국경엔 병사가 쫙 깔렸는걸요."
  },
  "183": {
   "jp": "78c0b55a",
   "kr": "뭐, 마음만 먹으면"
  },
  "184": {
   "jp": "6171a807",
   "kr": "방법은 얼마든지 있지."
  },
  "185": {
   "jp": "ff398d7e",
   "kr": "기드나의 유적을 조사해 보고 싶어."
  },
  "186": {
   "jp": "bc2ea9c8",
   "kr": "그곳은 티라스일에서 가장 오래된 유적이야."
  },
  "187": {
   "jp": "a0cba7b1",
   "kr": "어쩌면 라우알의 파도에 대해"
  },
  "188": {
   "jp": "e05737d1",
   "kr": "다른 시점의 기록이 남아 있을지도 모른다."
  },
  "189": {
   "jp": "0de21ea8",
   "kr": "과연…"
  },
  "190": {
   "jp": "29470a3e",
   "kr": "그것은 꼭, 부탁하고 싶다."
  },
  "191": {
   "jp": "d42f2bdf",
   "kr": "그럼, 그렇게 하죠."
  },
  "192": {
   "jp": "b0e0fa01",
   "kr": "나와 바다트와 죠안나 씨는 기드나로."
  },
  "193": {
   "jp": "2f72c684",
   "kr": "그리고, 듀르젤 공과 쥬리오 군과 크리스"
  },
  "194": {
   "jp": "f200a589",
   "kr": "스텔라 씨 네 사람은 루드성으로."
  },
  "195": {
   "jp": "897d4812",
   "kr": "아시겠어요?"
  },
  "196": {
   "jp": "a5c7ab3e",
   "kr": "조사가 끝나는 대로"
  },
  "197": {
   "jp": "a166c3b7",
   "kr": "무슨 일이 있어도 뒤쫓을 테니까요."
  },
  "198": {
   "jp": "0d50ce9c",
   "kr": "반드시 제 보고를 기다려 주세요."
  },
  "199": {
   "jp": "44235bcd",
   "kr": "최대한 시간을 버는 작전으로 부탁드립니다."
  },
  "200": {
   "jp": "877e4f45",
   "kr": "만약, 라우알의 파도가 거기까지 와 있어서"
  },
  "201": {
   "jp": "c4027973",
   "kr": "천구의를 부술 수밖에 없다면요?"
  },
  "202": {
   "jp": "53b6258b",
   "kr": "그건 상황에 따르겠지."
  },
  "203": {
   "jp": "068efc93",
   "kr": "너희 판단에 맡기마."
  },
  "204": {
   "jp": "c261176d",
   "kr": "그 판단이 틀렸다면?"
  },
  "205": {
   "jp": "c2cb2722",
   "kr": "그때는…"
  },
  "206": {
   "jp": "7440fe30",
   "kr": "글쎄다."
  },
  "207": {
   "jp": "4c541917",
   "kr": "그때는"
  },
  "208": {
   "jp": "ded6c5d9",
   "kr": "저승에 가서"
  },
  "209": {
   "jp": "679445f4",
   "kr": "다 같이 게르드에게 사과하자."
  },
  "210": {
   "jp": "8f6c8c1b",
   "kr": "사과하고 싶지 않아."
  },
  "211": {
   "jp": "bc85a43a",
   "kr": "나도야."
  },
  "212": {
   "jp": "254aa863",
   "kr": "자, 시간이 없다."
  },
  "213": {
   "jp": "aac9f43a",
   "kr": "바다트 군, 죠안나 씨."
  },
  "214": {
   "jp": "a7ab0f22",
   "kr": "어서 가도록 하지."
  },
  "215": {
   "jp": "4f4f2ec7",
   "kr": "앗, 아저씨."
  },
  "216": {
   "jp": "f94d7c95",
   "kr": "왜 그러니?"
  },
  "217": {
   "jp": "0d7ecce2",
   "kr": "아저씨 수첩 아직 갖고 있어요."
  },
  "218": {
   "jp": "4ade663b",
   "kr": "아아, 수첩 말이냐."
  },
  "219": {
   "jp": "91e2d6df",
   "kr": "그건 자네가 갖고 있게."
  },
  "220": {
   "jp": "75abc925",
   "kr": "뭔가 도움이 될지도 모른다."
  },
  "221": {
   "jp": "abe9c738",
   "kr": "뭘, 괜찮다."
  },
  "222": {
   "jp": "5068c943",
   "kr": "거기 적힌 것은"
  },
  "223": {
   "jp": "df83a847",
   "kr": "머릿속에 제대〜로 들어 있으니까."
  },
  "224": {
   "jp": "17c037b0",
   "kr": "그럼, 먼저 가마."
  },
  "225": {
   "jp": "0337c396",
   "kr": "자, 의욕이 솟는구나!"
  },
  "226": {
   "jp": "981d7289",
   "kr": "드디어 루드성이네."
  },
  "227": {
   "jp": "b6b2fd45",
   "kr": "허크 씨네"
  },
  "228": {
   "jp": "7fbefb80",
   "kr": "무사히 기드나로 건너갈 수 있을까…"
  },
  "229": {
   "jp": "1913f680",
   "kr": "괜찮을 거예요."
  },
  "230": {
   "jp": "5990a762",
   "kr": "허크 아저씨는"
  },
  "231": {
   "jp": "2b9e2ccc",
   "kr": "엄청 운이 좋거든요."
  },
  "232": {
   "jp": "c800c899",
   "kr": "우리도 가도록 하지."
  },
  "233": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "234": {
   "jp": "a977e58c",
   "kr": "가자."
  },
  "235": {
   "jp": "7d97f304",
   "kr": "분명, 어떻게든 될 거야."
  },
  "236": {
   "jp": "7728794d",
   "kr": "하얀마녀가 남겨 준 길인걸."
  },
  "237": {
   "jp": "e24c7363",
   "kr": "돌페스의 탑에 유폐됐던 늙은 검사 듀르젤과"
  },
  "238": {
   "jp": "8fc99826",
   "kr": "합류한 쥬리오 일행은 하얀마녀를 묻은"
  },
  "239": {
   "jp": "929a6d6a",
   "kr": "언덕으로 안내받았다. 게르드는 이미 없었다."
  },
  "240": {
   "jp": "0d9388f6",
   "kr": "하지만 충격에 떨 여유조차 일행에겐 없다."
  },
  "241": {
   "jp": "6f83ac12",
   "kr": "듀르젤이 전하는 루드성의 현황은 두려운"
  },
  "242": {
   "jp": "b6b8ebef",
   "kr": "사태였다. 라우알의 파도와 얽힌 계획은"
  },
  "243": {
   "jp": "5aca2578",
   "kr": "점성술사 레바스와 이계의 왕비 이자벨이"
  },
  "244": {
   "jp": "12a52875",
   "kr": "꾸민 원대한 계략이었다."
  },
  "245": {
   "jp": "9ff3f85f",
   "kr": "기드나로 향하는 허크, 바다트, 죠안나에게"
  },
  "246": {
   "jp": "4c258cd1",
   "kr": "라우알의 파도에 대한 추가 조사를 맡기고"
  },
  "247": {
   "jp": "66175df8",
   "kr": "쥬리오, 크리스, 듀르젤, 스텔라 네 사람은"
  },
  "248": {
   "jp": "4ce77052",
   "kr": "루드성으로 향할 결의를 굳히는 것이었다."
  },
  "249": {
   "jp": "f3f262e1",
   "kr": "제７장　순례자의 궤적　끝"
  }
 }
}