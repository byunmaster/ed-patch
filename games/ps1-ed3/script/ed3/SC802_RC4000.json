{
 "archive": "/SCE8/SC802.DAT",
 "member": "..\\DATA\\RC4000.BIN",
 "lines": {
  "0": {
   "jp": "16b2a2e8",
   "kr": "루드성"
  },
  "1": {
   "jp": "173ca740",
   "kr": "지하 통로"
  },
  "2": {
   "jp": "e6578a5c",
   "kr": "환술사 카지무"
  },
  "3": {
   "jp": "faf407c6",
   "kr": "남자 목소리"
  },
  "4": {
   "jp": "287e14df",
   "kr": "꺅?"
  },
  "5": {
   "jp": "8ba8824c",
   "kr": "우왓, 뭐야?"
  },
  "6": {
   "jp": "cdba65a0",
   "kr": "으, 환술사 카지무다."
  },
  "7": {
   "jp": "0d93b5c8",
   "kr": "또 만나게 될 줄은"
  },
  "8": {
   "jp": "3e9868e5",
   "kr": "생각도 못 했어."
  },
  "9": {
   "jp": "fea5ea11",
   "kr": "시플의 샤리네에서 쓰러뜨렸는데…"
  },
  "10": {
   "jp": "c0dd8d29",
   "kr": "레바스의 힘이라면"
  },
  "11": {
   "jp": "3b5b440d",
   "kr": "죽은 자를 되살리는 것도"
  },
  "12": {
   "jp": "c5c6049e",
   "kr": "쉽다는 거냐…"
  },
  "13": {
   "jp": "54c6f2a0",
   "kr": "네, 의식을 위해서라면"
  },
  "14": {
   "jp": "f8a443df",
   "kr": "다소 시간이 걸리는 게 흠이지만요."
  },
  "15": {
   "jp": "dbdb73f4",
   "kr": "안심하고 죽을 수 있다는 겁니다."
  },
  "16": {
   "jp": "733c289c",
   "kr": "시플에서는"
  },
  "17": {
   "jp": "381ca182",
   "kr": "잘도 저주를 걸어 줬더군."
  },
  "18": {
   "jp": "7dfbf787",
   "kr": "온순한 가루가에"
  },
  "19": {
   "jp": "dde89c41",
   "kr": "마수를 기생시켜 마을을 덮치게 하다니"
  },
  "20": {
   "jp": "73b34534",
   "kr": "하는 짓이 비겁하잖아."
  },
  "21": {
   "jp": "b0eb0995",
   "kr": "비겁…?"
  },
  "22": {
   "jp": "7ea3c620",
   "kr": "목적을 달성하기 위한 책략에"
  },
  "23": {
   "jp": "bb70fa9f",
   "kr": "비겁도 공정도 없다."
  },
  "24": {
   "jp": "8df66bde",
   "kr": "그러기 위해"
  },
  "25": {
   "jp": "5d1fba46",
   "kr": "몇 번 가루가를 조종하는 실험을 하며"
  },
  "26": {
   "jp": "454b26f1",
   "kr": "준비를 진행하고 있었던 것이다."
  },
  "27": {
   "jp": "ffe443d9",
   "kr": "착실한 노력이라 봐 주시길 바라지요."
  },
  "28": {
   "jp": "7d1baf9a",
   "kr": "15년쯤 전에도"
  },
  "29": {
   "jp": "dc220a59",
   "kr": "그 실험이라는 걸 했던 거로군."
  },
  "30": {
   "jp": "4bd9d31b",
   "kr": "네갈섬 바다에서."
  },
  "31": {
   "jp": "97006fb3",
   "kr": "응…?"
  },
  "32": {
   "jp": "4120edcd",
   "kr": "누구냐?"
  },
  "33": {
   "jp": "12f8887b",
   "kr": "방금 그 말, 똑똑히 들었다!"
  },
  "34": {
   "jp": "12a25481",
   "kr": "로디!"
  },
  "35": {
   "jp": "ebf050fe",
   "kr": "가루가에 대한 복수는 그만뒀지만…"
  },
  "36": {
   "jp": "b9ce3690",
   "kr": "그렇다면 용서할 수 없지."
  },
  "37": {
   "jp": "3c6b5a97",
   "kr": "네놈만은 내가 처리하겠어!"
  },
  "38": {
   "jp": "98f3770f",
   "kr": "호오, 혈기 왕성한 조력자로군요."
  },
  "39": {
   "jp": "2e994c61",
   "kr": "안 돼, 로디."
  },
  "40": {
   "jp": "e1b9c9b9",
   "kr": "카지무는 환술사란 말이야."
  },
  "41": {
   "jp": "7d43dce9",
   "kr": "걱정 마라."
  },
  "42": {
   "jp": "4898cbad",
   "kr": "나는 복수하러 온 게 아니야."
  },
  "43": {
   "jp": "72563492",
   "kr": "올도스의 승병에게"
  },
  "44": {
   "jp": "4160697d",
   "kr": "너희 소문을 들었지."
  },
  "45": {
   "jp": "cee03db6",
   "kr": "뭔가 도움이 될까 싶어서"
  },
  "46": {
   "jp": "a02272e6",
   "kr": "뒤를 쫓아온 거다."
  },
  "47": {
   "jp": "33a89507",
   "kr": "하고 싶은 일이"
  },
  "48": {
   "jp": "09f1f1d9",
   "kr": "아직 많이 있기도 하고."
  },
  "49": {
   "jp": "bf5ed2b8",
   "kr": "뭐, 일단."
  },
  "50": {
   "jp": "aea2f4a0",
   "kr": "지금 하고 싶은 건 너희를 돕는 일이야."
  },
  "51": {
   "jp": "13431a95",
   "kr": "애송이치고는 좋은 소릴 하는군."
  },
  "52": {
   "jp": "eb76052e",
   "kr": "그걸 알고 있다면"
  },
  "53": {
   "jp": "bc1cb1d6",
   "kr": "맡겨도 괜찮겠지."
  },
  "54": {
   "jp": "9591b313",
   "kr": "누구죠, 그분은?"
  },
  "55": {
   "jp": "2d7b9453",
   "kr": "듀르젤 님이야."
  },
  "56": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "57": {
   "jp": "178afab5",
   "kr": "듀…"
  },
  "58": {
   "jp": "ba54f3b1",
   "kr": "듀르젤 님…?"
  },
  "59": {
   "jp": "148d4465",
   "kr": "정, 정말이야?"
  },
  "60": {
   "jp": "5c55f2e9",
   "kr": "이 늙은이를 알아주었나."
  },
  "61": {
   "jp": "729fdc5f",
   "kr": "알다마다."
  },
  "62": {
   "jp": "f51f77aa",
   "kr": "당신이야말로"
  },
  "63": {
   "jp": "e902747d",
   "kr": "내가 계속 동경해 온 영웅이지."
  },
  "64": {
   "jp": "1e6f1262",
   "kr": "좋았어"
  },
  "65": {
   "jp": "5539a0f6",
   "kr": "왠지 힘이 솟는군."
  },
  "66": {
   "jp": "c0286ad0",
   "kr": "여기는 나한테 맡기고"
  },
  "67": {
   "jp": "ea4c5aae",
   "kr": "어서 앞으로 가게."
  },
  "68": {
   "jp": "ddd82c39",
   "kr": "간다!"
  },
  "69": {
   "jp": "a357c84e",
   "kr": "자, 어서 가."
  },
  "70": {
   "jp": "24cb0a13",
   "kr": "여긴 나한테 맡겨!"
  },
  "71": {
   "jp": "033c0fb9",
   "kr": "하지만…"
  },
  "72": {
   "jp": "7e8d30b2",
   "kr": "로디."
  },
  "73": {
   "jp": "f59fb7cd",
   "kr": "나중에 또 만나자."
  },
  "74": {
   "jp": "97c4ebdc",
   "kr": "가자, 생각할 시간 없어."
  },
  "75": {
   "jp": "9d8e0456",
   "kr": "고마워, 로디!"
  },
  "76": {
   "jp": "fc4b4af9",
   "kr": "저주 마법을 조심해!"
  },
  "77": {
   "jp": "5b0f7fc2",
   "kr": "죄송해요, 로디 씨."
  },
  "78": {
   "jp": "79dcd9f3",
   "kr": "부탁드릴게요."
  },
  "79": {
   "jp": "69d11caf",
   "kr": "괜찮아."
  },
  "80": {
   "jp": "79b98e22",
   "kr": "로디라면 이길 수 있어."
  },
  "81": {
   "jp": "64ba9fe2",
   "kr": "이야앗!"
  },
  "82": {
   "jp": "246bae1c",
   "kr": "우오오오아앗!"
  },
  "83": {
   "jp": "43dae349",
   "kr": "나한테 신경 쓰지 마!"
  },
  "84": {
   "jp": "17dd4ee9",
   "kr": "먼저 가!!"
  },
  "85": {
   "jp": "cb743ec7",
   "kr": "로디와 카지무의 모습은 없다."
  }
 }
}