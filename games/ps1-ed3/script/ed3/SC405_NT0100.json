  "2": {
   "jp": "5b5733b0",
   "kr": "하이젠 병사"
  },
  "3": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "4": {
   "jp": "4dd6dc80",
   "kr": "레바리"
  },
  "5": {
   "jp": "e15b4a0e",
   "kr": "여기는 퓨엔테의 북쪽 성."
  },
  "6": {
   "jp": "846f6477",
   "kr": "하이젠성이야."
  },
  "7": {
   "jp": "6e9e883e",
   "kr": "퓨엔테는 북과 남이 독립해 있어서"
  },
  "8": {
   "jp": "1df352af",
   "kr": "이 하이젠성은"
  },
  "9": {
   "jp": "2f9ee449",
   "kr": "형님이신 에네톤 왕께서 다스리셔."
  },
  "10": {
   "jp": "dcfbd5fe",
   "kr": "휘리, 안녕."
  },
  "11": {
   "jp": "bcafe2e6",
   "kr": "오늘은 친구들도 함께구나."
  },
  "12": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "13": {
   "jp": "e15b4a0e",
   "kr": "여기는 퓨엔테의 북쪽 성."
  },
  "14": {
   "jp": "f10ffe78",
   "kr": "하이젠성입니다."
  },
  "15": {
   "jp": "3f5757f0",
   "kr": "여어, 휘리."
  },
  "16": {
   "jp": "73a4b580",
   "kr": "오늘도 귀엽네."
  },
  "17": {
   "jp": "470c3b31",
   "kr": "알현이신가요?"
  },
  "18": {
   "jp": "2b9e4531",
   "kr": "에네톤 왕께서는 2층에 계십니다."
  },
  "19": {
   "jp": "3f5757f0",
   "kr": "여어, 휘리."
  },
  "20": {
   "jp": "58a454f1",
   "kr": "늘 기운차 보이네."
  },
  "21": {
   "jp": "4744300e",
   "kr": "요즘 가도에 산적이 나온다는데."
  },
  "22": {
   "jp": "01e8683a",
   "kr": "싫다아…"
  },
  "23": {
   "jp": "3ae1049a",
   "kr": "바빠지는 건…"
  },
  "24": {
   "jp": "0af25349",
   "kr": "앗, 휘리…"
  },
  "25": {
   "jp": "16306cff",
   "kr": "벼벼, 별로…"
  },
  "26": {
   "jp": "c9a4b41d",
   "kr": "땡땡이치는 거 아니야."
  },
  "27": {
   "jp": "eff4f52f",
   "kr": "지금 휴식 시간이야."
  },
  "28": {
   "jp": "08fdcf05",
   "kr": "교대 시간이 올 때까지"
  },
  "29": {
   "jp": "5ae9c908",
   "kr": "여기서 대기하는 거야."
  },
  "30": {
   "jp": "010774e8",
   "kr": "하아. 순찰은 피곤해."
  },
  "31": {
   "jp": "271261e6",
   "kr": "한숨 돌리자, 한숨."
  },
  "32": {
   "jp": "943fc050",
   "kr": "연회장 청소는 정성껏 해야죠."
  },
  "33": {
   "jp": "dd92a826",
   "kr": "모두가 쉬는 곳인걸요."
  },
  "34": {
   "jp": "106210ed",
   "kr": "늘 깨끗이 해 두고 싶어요."
  },
  "35": {
   "jp": "18f076b2",
   "kr": "앗, 휘리 씨."
  },
  "36": {
   "jp": "6ff20e8e",
   "kr": "지난번에 받은 허브"
  },
  "37": {
   "jp": "2d079da8",
   "kr": "허브차로 하면"
  },
  "38": {
   "jp": "70f6d723",
   "kr": "정말 맛있었어요."
  },
  "39": {
   "jp": "fe982ec8",
   "kr": "잘 먹었어요."
  },
  "40": {
   "jp": "9ea7a47d",
   "kr": "산적은 나오고…"
  },
  "41": {
   "jp": "9896410d",
   "kr": "남쪽 홀크 저택의 아우님과도"
  },
  "42": {
   "jp": "042535ca",
   "kr": "그다지 사이가 좋지 않은 듯하고…"
  },
  "43": {
   "jp": "83d2842f",
   "kr": "에네톤 왕도 앞으로가 힘들겠구먼…"
  },
  "44": {
   "jp": "3f5757f0",
   "kr": "허허, 휘리."
  },
  "45": {
   "jp": "05697358",
   "kr": "잘 있었나."
  },
  "46": {
   "jp": "9861d6c1",
   "kr": "안녕하세요. 레바리 씨."
  },
  "47": {
   "jp": "7bd34b90",
   "kr": "지난번 가져다준"
  },
  "48": {
   "jp": "7cc4aab0",
   "kr": "휘리의 허브차."
  },
  "49": {
   "jp": "aba1718d",
   "kr": "아주 맛있었다네."
  },
  "50": {
   "jp": "7df7d3c8",
   "kr": "또 맛있는 걸 가져다주게나."
  }
 }
