 "lines": {
  "0": {
   "jp": "2a8d61a9",
   "kr": "마을 구역"
  },
  "1": {
   "jp": "c85fb771",
   "kr": "파렌"
  },
  "2": {
   "jp": "2e9b9a8e",
   "kr": "메이아"
  },
  "3": {
   "jp": "1fa3a6ef",
   "kr": "오즈이"
  },
  "4": {
   "jp": "1ada7630",
   "kr": "우비"
  },
  "5": {
   "jp": "2facc6ef",
   "kr": "간호사 에피누"
  },
  "6": {
   "jp": "790e56cd",
   "kr": "필로 선생"
  },
  "7": {
   "jp": "8083d427",
   "kr": "비시오"
  },
  "8": {
   "jp": "5586174a",
   "kr": "칸드의 라름"
  },
  "9": {
   "jp": "04a9fd5c",
   "kr": "롱크"
  },
  "10": {
   "jp": "da55f7ed",
   "kr": "하이마"
  },
  "11": {
   "jp": "5c9fe3f9",
   "kr": "엔시아"
  },
  "12": {
   "jp": "43c517fc",
   "kr": "니젠"
  },
  "13": {
   "jp": "f3fc3045",
   "kr": "티나"
  },
  "14": {
   "jp": "9b6c51f0",
   "kr": "책은 필로 선생님께 받았습니다."
  },
  "15": {
   "jp": "d0aef6b1",
   "kr": "도움이 돼서 정말 다행이에요."
  },
  "16": {
   "jp": "6b867cfc",
   "kr": "삼도교는 보셨나요?"
  },
  "17": {
   "jp": "ba4cd325",
   "kr": "올도스의 수로 물은 말이지."
  },
  "18": {
   "jp": "8002c44f",
   "kr": "삼도교 아래를 흐르는"
  },
  "19": {
   "jp": "9a7da162",
   "kr": "콘도타강의 물이랍니다."
  },
  "20": {
   "jp": "b8d9f085",
   "kr": "올도스의 대신관님은 다음 대신관님께"
  },
  "21": {
   "jp": "675bd8e5",
   "kr": "대를 물려줄 때 대신관님만 알아야 하는"
  },
  "22": {
   "jp": "ae4e49ca",
   "kr": "전승을 남몰래 전해 준다더군."
  },
  "23": {
   "jp": "e914f610",
   "kr": "대체 무엇을 가르치는 걸까."
  },
  "24": {
   "jp": "16058370",
   "kr": "궁금하구먼…"
  },
  "25": {
   "jp": "04b0acce",
   "kr": "필로 선생님이 곧"
  },
  "26": {
   "jp": "6a52a8b7",
   "kr": "돌아오신다고 들었어."
  },
  "27": {
   "jp": "bb157d1b",
   "kr": "그러니까 조금만 더 누워 있을래."
  },
  "28": {
   "jp": "77bdad2d",
   "kr": "쾌차를 축하드려요."
  },
  "29": {
   "jp": "b4ca3e5a",
   "kr": "쥬리오 씨가"
  },
  "30": {
   "jp": "ff92e10e",
   "kr": "무척 애를 쓰며"
  },
  "31": {
   "jp": "7c986a8d",
   "kr": "뛰어다니셨답니다."
  },
  "32": {
   "jp": "91e53fcd",
   "kr": "걱정 끼쳐 드렸어요."
  },
  "33": {
   "jp": "6db1fbfe",
   "kr": "쥬리오한테는 정말 고마워요."
  },
  "34": {
   "jp": "e65f803a",
   "kr": "그만해, 쑥스럽잖아."
  },
  "35": {
   "jp": "257b7ec3",
   "kr": "쥬리오 씨는 귀엽네요."
  },
  "36": {
   "jp": "dadefcbe",
   "kr": "제 타입이에요."
  },
  "37": {
   "jp": "abd38d75",
   "kr": "이봐, 나그네,"
  },
  "38": {
   "jp": "33d53ddb",
   "kr": "올도스를 흐르는 수로가"
  },
  "39": {
   "jp": "5db91e1a",
   "kr": "기막히게 좋지 않아?"
  },
  "40": {
   "jp": "2ea84cf7",
   "kr": "그래서 이 마을은"
  },
  "41": {
   "jp": "8b4c6469",
   "kr": "물의 도시라고도 불린다고."
  },
  "42": {
   "jp": "fc8f7c53",
   "kr": "수로에는 10개의 다리가 놓이고"
  },
  "43": {
   "jp": "5a71ccc0",
   "kr": "11개의 풍차가 시플에서 오는 바람을 받아"
  },
  "44": {
   "jp": "bac106f1",
   "kr": "빙글빙글 돌고 있단다."
  },
  "45": {
   "jp": "4a3bb332",
   "kr": "한가롭구나."
  },
  "46": {
   "jp": "ec935edb",
   "kr": "칸드 마법은 올도스 말고"
  },
  "47": {
   "jp": "f6b1154b",
   "kr": "거의 모든 마을에서도 받을 수 있습니다."
  },
  "48": {
   "jp": "f0ce94a6",
   "kr": "하지만 그중엔 올도스에서 받는 게"
  },
  "49": {
   "jp": "2f6910c2",
   "kr": "본래 모습이라며"
  },
  "50": {
   "jp": "c798b75e",
   "kr": "일부러 찾아오는 사람도 있을 정도지요."
  },
  "51": {
   "jp": "a1b49e2d",
   "kr": "어서 오세요."
  },
  "52": {
   "jp": "aa97c2e1",
   "kr": "올도스 칸드에."
  },
  "53": {
   "jp": "dd09fa95",
   "kr": "어느 분이 원하시나요?"
  },
  "54": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "55": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "56": {
   "jp": "3c2d3ee3",
   "kr": "부디 뜻깊게 써 주세요."
  },
  "57": {
   "jp": "272a3798",
   "kr": "올도스는 말이야."
  },
  "58": {
   "jp": "3703fd00",
   "kr": "마을 구역과 신관 구역, 그리고 대성당의"
  },
  "59": {
   "jp": "f0f34c0d",
   "kr": "세 구역으로 나뉘어 있어."
  },
  "60": {
   "jp": "94639a6d",
   "kr": "대성당에 가려면 신관 구역을"
  },
  "61": {
   "jp": "49b08693",
   "kr": "지나가야만 하지."
  },
  "62": {
   "jp": "cb9d7e71",
   "kr": "신관 구역이란 대성당에서 일하는"
  },
  "63": {
   "jp": "d02dbbd0",
   "kr": "신관들의 집이 있는 곳이야."
  },
  "64": {
   "jp": "4c956016",
   "kr": "신관 구역으로 이어지는 다리에서는"
  },
  "65": {
   "jp": "60dad6fb",
   "kr": "다른 네 샤리네를"
  },
  "66": {
   "jp": "06844d6d",
   "kr": "돌고 온 사람만 들어갈 수 있어."
  },
  "67": {
   "jp": "1d70647d",
   "kr": "이 올도스는"
  },
  "68": {
   "jp": "e231bab3",
   "kr": "칸드와 챠펠의"
  },
  "69": {
   "jp": "1a1a3374",
   "kr": "고향 같은 곳이야."
  },
  "70": {
   "jp": "91bd0b82",
   "kr": "그래서 여기선 재능만 있으면"
  },
  "71": {
   "jp": "30633f96",
   "kr": "거의 모든 마법을"
  },
  "72": {
   "jp": "db45e599",
   "kr": "받을 수 있어."
  },
  "73": {
   "jp": "a46241e1",
   "kr": "순례하러 오신 분이군요?"
  },
  "74": {
   "jp": "a83577aa",
   "kr": "그러세요."
  },
  "75": {
   "jp": "e7b21ac8",
   "kr": "마을의 성인 의식이 순례인 건가요."
  },
  "76": {
   "jp": "5f4338c0",
   "kr": "아주 좋은 습관을 남긴 마을이군요."
  },
  "77": {
   "jp": "09e8c468",
   "kr": "올도스의 대신관은 여기서 제일 높은 분이야."
  },
  "78": {
   "jp": "8e1b6b1b",
   "kr": "뭐, 보통 나라로 치면"
  },
  "79": {
   "jp": "87c8df0a",
   "kr": "임금님 같은 셈이지."
  },
  "80": {
   "jp": "94cbd8d4",
   "kr": "인간적으로도 훌륭하고 아주 좋은 분이야."
  },
  "81": {
   "jp": "ccce0a5b",
   "kr": "생각한 그대로의 마을이에요."
  },
  "82": {
   "jp": "8bdb6f5d",
   "kr": "아름답고 사람들은 모두 상냥하고."
  },
  "83": {
   "jp": "b5675f37",
   "kr": "이 마을에 와서 다행이에요."
  },
  "84": {
   "jp": "3923a8e1",
   "kr": "이 올도스에는"
  },
  "85": {
   "jp": "8f1c0f44",
   "kr": "티라스일 각지에서 많은 사람들이"
  },
  "86": {
   "jp": "22735b2d",
   "kr": "순례나 수행을 위해 찾아오는구나."
  },
  "87": {
   "jp": "6b42b1e7",
   "kr": "그쪽도 그래요?"
  },
  "88": {
   "jp": "9c5b7e6e",
   "kr": "저도 그래요."
  },
  "89": {
   "jp": "75223412",
   "kr": "하하하."
  },
  "90": {
   "jp": "3fc7f1d7",
   "kr": "우비는 눈치채지 못했지만"
  },
  "91": {
   "jp": "d86fdf52",
   "kr": "나는 줄곧 여기 있다네."
  },
  "92": {
   "jp": "2f2267ce",
   "kr": "아무래도 내쫓는 것도 딱하니까 말일세."
  },
  "93": {
   "jp": "7e90abb7",
   "kr": "본인이 마음먹을 때까지"
  },
  "94": {
   "jp": "2bc97b67",
   "kr": "있게 해 주기로 했네."
  },
  "95": {
   "jp": "d3a7d671",
   "kr": "그럼, 조심해서 마을로 돌아가게."
  }
 }
}