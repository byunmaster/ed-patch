{
 "archive": "/SCE4/SC405.DAT",
 "member": "..\\DATA\\NT0200.BIN",
 "lines": {
  "0": {
   "jp": "3fb24ff7",
   "kr": "하이젠성"
  },
  "1": {
   "jp": "24b7384e",
   "kr": "2층"
  },
  "2": {
   "jp": "5b5733b0",
   "kr": "하이젠 병사"
  },
  "3": {
   "jp": "5ed9a709",
   "kr": "에네톤 왕"
  },
  "4": {
   "jp": "9d57f8ab",
   "kr": "피리아 왕비"
  },
  "5": {
   "jp": "964500f4",
   "kr": "카리스 노인"
  },
  "6": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "7": {
   "jp": "8b3783a0",
   "kr": "여기는 알현실입니다."
  },
  "8": {
   "jp": "d7306f15",
   "kr": "안에 에네톤 왕께서 계십니다."
  },
  "9": {
   "jp": "3f5757f0",
   "kr": "여어, 휘리."
  },
  "10": {
   "jp": "227ce37f",
   "kr": "에네톤 왕께서 또 심각하게 고민하고 계셔."
  },
  "11": {
   "jp": "b58b7bbd",
   "kr": "위로해 드려."
  },
  "12": {
   "jp": "be3f8899",
   "kr": "에네톤 임금님은"
  },
  "13": {
   "jp": "5783bb8b",
   "kr": "뭐든 너무 심각하게 생각하세요."
  },
  "14": {
   "jp": "78dfb4ad",
   "kr": "그게 좋은 점이긴 하지만요."
  },
  "15": {
   "jp": "d4c5e787",
   "kr": "휘리 얼굴을 보면"
  },
  "16": {
   "jp": "62730f7e",
   "kr": "조금은 진정되지 않을까."
  },
  "17": {
   "jp": "9ce62781",
   "kr": "에네톤 왕께서는 안에서"
  },
  "18": {
   "jp": "c889e005",
   "kr": "생각에 잠겨 계십니다."
  },
  "19": {
   "jp": "5e1311b6",
   "kr": "되도록"
  },
  "20": {
   "jp": "fa0e94f3",
   "kr": "말을 걸지 않으시는 편이"
  },
  "21": {
   "jp": "15dcf8ab",
   "kr": "좋으실 겁니다."
  },
  "22": {
   "jp": "d0ba9110",
   "kr": "에네톤 왕은"
  },
  "23": {
   "jp": "c705bb28",
   "kr": "남쪽 홀크에 계신 아우님을"
  },
  "24": {
   "jp": "90f9e5a3",
   "kr": "염려하고 계신단다."
  },
  "25": {
   "jp": "72bbcada",
   "kr": "한 나라에 도읍이 둘."
  },
  "26": {
   "jp": "aa871af6",
   "kr": "아무리 아우님이라도, 무슨 생각을 하는지"
  },
  "27": {
   "jp": "7ae407b4",
   "kr": "알 수 없으니까."
  },
  "28": {
   "jp": "d9be5d64",
   "kr": "어찌하면 좋을까…"
  },
  "29": {
   "jp": "947d1c5a",
   "kr": "캐라크는 무슨 생각인지…"
  },
  "30": {
   "jp": "d6bc055a",
   "kr": "으음…"
  },
  "31": {
   "jp": "dd2ac785",
   "kr": "이쪽에서 찾아가는 것도 이상하고…"
  },
  "32": {
   "jp": "3a5feeb8",
   "kr": "에네톤 왕은 혼자 고민하며 중얼거리고 있다."
  },
  "33": {
   "jp": "b214ef5c",
   "kr": "쥬리오 일행이 온 줄도 모른다."
  },
  "34": {
   "jp": "de989548",
   "kr": "후우…"
  },
  "35": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "36": {
   "jp": "c5a0150e",
   "kr": "임금님."
  },
  "37": {
   "jp": "856e83ac",
   "kr": "어머, 기운이 없으세요."
  },
  "38": {
   "jp": "cb37c6f7",
   "kr": "어라, 휘리 아니냐."
  },
  "39": {
   "jp": "7c167e12",
   "kr": "으음. 좀 생각할 게 있어서 말이다."
  },
  "40": {
   "jp": "e19e12ca",
   "kr": "과한 생각은 몸에 독이에요."
  },
  "41": {
   "jp": "44224c71",
   "kr": "그래, 그렇군."
  },
  "42": {
   "jp": "7ffa8ff4",
   "kr": "아직 일어나지도 않은 일을"
  },
  "43": {
   "jp": "3d118aad",
   "kr": "걱정해도 소용없겠지."
  },
  "44": {
   "jp": "758905bb",
   "kr": "그러세."
  },
  "45": {
   "jp": "0f419574",
   "kr": "그렇지."
  },
  "46": {
   "jp": "d678b6da",
   "kr": "고맙다."
  },
  "47": {
   "jp": "d4c5e787",
   "kr": "휘리 얼굴을 보니"
  },
  "48": {
   "jp": "68b9690c",
   "kr": "마음이 편해졌구나."
  },
  "49": {
   "jp": "d09cc02e",
   "kr": "임금님은"
  },
  "50": {
   "jp": "7be7208b",
   "kr": "이것저것 생각하는 것도"
  },
  "51": {
   "jp": "1825df5f",
   "kr": "중요한 일이랍니다."
  },
  "52": {
   "jp": "2b3941e2",
   "kr": "마음껏 생각하시게 두면 되는 겁니다."
  },
  "53": {
   "jp": "d57012e2",
   "kr": "어머, 휘리 씨."
  },
  "54": {
   "jp": "d64b1cf7",
   "kr": "지난번엔 맛있는 허브차를"
  },
  "55": {
   "jp": "b8c197fe",
   "kr": "고마웠어요."
  },
  "56": {
   "jp": "ee86a385",
   "kr": "임금님은 여전히 걱정이 많으세요."
  },
  "57": {
   "jp": "19fadbf3",
   "kr": "틈만 나면"
  },
  "58": {
   "jp": "501d826a",
   "kr": "이것저것 고민하신답니다."
  },
  "59": {
   "jp": "ef7ce013",
   "kr": "임금님의 고민은"
  },
  "60": {
   "jp": "d3dc93fd",
   "kr": "늘 있는 일이니,"
  },
  "61": {
   "jp": "d6ecba2c",
   "kr": "너무 신경 쓰지 않아도 돼요."
  },
  "62": {
   "jp": "8a9c1c29",
   "kr": "에네톤 왕도"
  },
  "63": {
   "jp": "516d4a0f",
   "kr": "이것저것 고민하기 전에"
  },
  "64": {
   "jp": "5b211a48",
   "kr": "책을 읽으면 좋으련만…"
  },
  "65": {
   "jp": "c1bc3fd2",
   "kr": "이런, 휘리로구나."
  },
  "66": {
   "jp": "800f07a6",
   "kr": "오늘도 귀엽구먼."
  },
  "67": {
   "jp": "7012dd2f",
   "kr": "어라?"
  },
  "68": {
   "jp": "18dc99c2",
   "kr": "오늘은 어여쁜 누님도 함께인가?"
  },
  "69": {
   "jp": "98a3523e",
   "kr": "어디서 온 어여쁜 분인고?"
  },
  "70": {
   "jp": "c195097e",
   "kr": "설마, 진짜 누나로"
  },
  "71": {
   "jp": "e2e532a6",
   "kr": "리즈의 숨겨 둔 자식이라거나 하진 않겠지."
  },
  "72": {
   "jp": "9f846158",
   "kr": "샤라 씨라고 해요."
  },
  "73": {
   "jp": "24cacc0d",
   "kr": "예쁜 분이죠."
  },
  "74": {
   "jp": "8b0db5ed",
   "kr": "당신들"
  },
  "75": {
   "jp": "6f5ecbe1",
   "kr": "제법 보는 눈이 있잖아."
  },
  "76": {
   "jp": "fe5f8adb",
   "kr": "으음. 어여쁘긴 하다만…"
  },
  "77": {
   "jp": "ad67a648",
   "kr": "말버릇이 고약하구먼."
  },
  "78": {
   "jp": "0964a59d",
   "kr": "책이라도 좀 더 읽고 공부하는 게 좋겠구먼."
  },
  "79": {
   "jp": "918e835b",
   "kr": "쓸데없는 참견이야."
  },
  "80": {
   "jp": "bb7b1e39",
   "kr": "샤라 씨라."
  },
  "81": {
   "jp": "63d88cb6",
   "kr": "허나, 자넨 미인이니"
  },
  "82": {
   "jp": "299f3ae8",
   "kr": "난 좋구먼."
  },
  "83": {
   "jp": "8b336987",
   "kr": "에네톤 왕께서는 늘 고민하고 계세요."
  },
  "84": {
   "jp": "a82269c7",
   "kr": "뭘 고민하시는지는 모르지만,"
  },
  "85": {
   "jp": "af15b1eb",
   "kr": "고민하는 게 임금님 취미인가 봐요."
  },
  "86": {
   "jp": "ca0e029d",
   "kr": "어머, 휘리 씨."
  },
  "87": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "88": {
   "jp": "4b0fcb12",
   "kr": "오늘 옷도 잘 어울리네요."
  },
  "89": {
   "jp": "e0e8b5d4",
   "kr": "휘리 씨는 정말"
  },
  "90": {
   "jp": "3a197eb4",
   "kr": "뭘 입어도 어울린다니까요."
  },
  "91": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "92": {
   "jp": "24d1ce1b",
   "kr": "이 옷, 어머니가 만들어 주셨어요."
  },
  "93": {
   "jp": "8de3bbfe",
   "kr": "편히 쉬다 가세요."
  },
  "94": {
   "jp": "a25e47e0",
   "kr": "책등에 《루피나스 호수 곁에서》라고"
  },
  "95": {
   "jp": "738306f4",
   "kr": "적힌 책이 있다."
  },
  "96": {
   "jp": "2b32dbf8",
   "kr": "쥬리오는 손에 들고 책을 펼쳐 보았다."
  },
  "97": {
   "jp": "28a4783d",
   "kr": "《루피나스 호수의 기슭에서》"
  },
  "98": {
   "jp": "d2a44e11",
   "kr": "루피나스 호수 기슭의 퓨엔테 왕국은"
  },
  "99": {
   "jp": "39596a49",
   "kr": "남북 두 지구로 나뉘어 있다."
  },
  "100": {
   "jp": "09293a01",
   "kr": "북쪽은 형인 에네톤 왕."
  },
  "101": {
   "jp": "e7f316bb",
   "kr": "남쪽은 아우인 캐라크가 각각 다스린다."
  },
  "102": {
   "jp": "5b0b2182",
   "kr": "원래는 북쪽 하이젠성을 도읍으로 삼아"
  },
  "103": {
   "jp": "ad19bed4",
   "kr": "다스렸으나, 쌍둥이 왕자의 탄생을 계기로"
  },
  "104": {
   "jp": "4aad200c",
   "kr": "홀크에도 저택을 지어 지구를 나누었다."
  },
  "105": {
   "jp": "6ee0b532",
   "kr": "홀크와 하이젠, 두 도읍이 태어났다."
  },
  "106": {
   "jp": "f476f4ce",
   "kr": "두 왕의 힘으로 새 나라를 세우기를 바랐다."
  },
  "107": {
   "jp": "cdecf510",
   "kr": "형제는 다투듯 나라 세우기에 힘쓰며"
  },
  "108": {
   "jp": "da22a623",
   "kr": "좋든 나쁘든 서로 겨루었다."
  },
  "109": {
   "jp": "05823ea9",
   "kr": "과연 이를 한탄으로 받아들였을까."
  },
  "110": {
   "jp": "831ead01",
   "kr": "떠돌이 마녀가 남긴 말이 여기 있다."
  },
  "111": {
   "jp": "664c38a8",
   "kr": "『어미가 피를 나눔은 나라 가름이 아니다』"
  },
  "112": {
   "jp": "651e9466",
   "kr": "퓨엔테의 장래를 근심하는 말 같다."
  },
  "113": {
   "jp": "02d53fd7",
   "kr": "너무 어려워서 잘 모르겠어."
  },
  "114": {
   "jp": "8920f6ef",
   "kr": "책등에 《쾌걸 와일드캣》이라고"
  },
  "115": {
   "jp": "738306f4",
   "kr": "적힌 책이 있다."
  },
  "116": {
   "jp": "7c370c7b",
   "kr": "어린이용 이야기인 듯하다."
  },
  "117": {
   "jp": "2b32dbf8",
   "kr": "쥬리오는 손에 들고 책을 펼쳐 보았다."
  },
  "118": {
   "jp": "138e5e5c",
   "kr": "《쾌걸 와일드캣》"
  },
  "119": {
   "jp": "7c3ffd8d",
   "kr": "와일드캣은 우리 편이다."
  },
  "120": {
   "jp": "c48cdac6",
   "kr": "숲속에서 바람처럼 나타나 곤란할 때"
  },
  "121": {
   "jp": "26d92da8",
   "kr": "우리를 구해 준다."
  },
  "122": {
   "jp": "bc760627",
   "kr": "어른들은 산적이라고 부르지만"
  },
  "123": {
   "jp": "b1ed385b",
   "kr": "와일드캣은 좋은 사람이다."
  },
  "124": {
   "jp": "068623b9",
   "kr": "얼마 전에도 곰에게 습격당할 뻔했을 때"
  },
  "125": {
   "jp": "7be1c206",
   "kr": "쓱 나타나 나를 구해 주었다."
  },
  "126": {
   "jp": "4ae1eea8",
   "kr": "숲의 의적 와일드캣. 또 만나고 싶다."
  },
  "127": {
   "jp": "7dcd5147",
   "kr": "너무 어린애용이네."
  },
  "128": {
   "jp": "c09a8deb",
   "kr": "그래도, 와일드캣이란 이름"
  },
  "129": {
   "jp": "f75d9503",
   "kr": "멋있네."
  },
  "130": {
   "jp": "b64fb6e4",
   "kr": "그런가…"
  }
 }
}