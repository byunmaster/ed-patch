{
 "archive": "/SCE4/SC409.DAT",
 "member": "..\\DATA\\UT0100.BIN",
 "lines": {
  "0": {
   "jp": "4b650dea",
   "kr": "시플"
  },
  "1": {
   "jp": "a82af9b4",
   "kr": "샤리네"
  },
  "2": {
   "jp": "e6578a5c",
   "kr": "환술사 카지무"
  },
  "3": {
   "jp": "ab476ddd",
   "kr": "환술사 카지무의 목소리"
  },
  "4": {
   "jp": "324a055b",
   "kr": "시플의 현자"
  },
  "5": {
   "jp": "9b2bcbd9",
   "kr": "자, 이쪽이다."
  },
  "6": {
   "jp": "3cb762c6",
   "kr": "바람의 샤리네로 가는 길은"
  },
  "7": {
   "jp": "a5ba0c1e",
   "kr": "전설의 미혹의 숲처럼"
  },
  "8": {
   "jp": "335a91d5",
   "kr": "사람을 헤매게 한다."
  },
  "9": {
   "jp": "302e92ac",
   "kr": "숲의 미혹에 빠지지 말고"
  },
  "10": {
   "jp": "3869385c",
   "kr": "마법의 거울 앞까지"
  },
  "11": {
   "jp": "00506343",
   "kr": "스스로 걸어가거라."
  },
  "12": {
   "jp": "b6b74a5d",
   "kr": "재미있겠는걸."
  },
  "13": {
   "jp": "6056da1e",
   "kr": "가자, 쥬리오."
  },
  "14": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "15": {
   "jp": "4086cd88",
   "kr": "생각보다 일찍 왔군."
  },
  "16": {
   "jp": "c6956102",
   "kr": "이런 미로쯤이야 쉬워요."
  },
  "17": {
   "jp": "096c9758",
   "kr": "호오. 그런가, 그런가."
  },
  "18": {
   "jp": "fadba666",
   "kr": "뭐, 상관없다."
  },
  "19": {
   "jp": "af8c72c7",
   "kr": "이 샤리네는 마을에서 떨어져 있으니 말이다."
  },
  "20": {
   "jp": "d7edec64",
   "kr": "너희를 매복해 기다리려면,"
  },
  "21": {
   "jp": "6a84a9b7",
   "kr": "안성맞춤인 곳이었지."
  },
  "22": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "23": {
   "jp": "e8dce6ad",
   "kr": "매복이라니?"
  },
  "24": {
   "jp": "86861dd0",
   "kr": "너희 같은 아이들이"
  },
  "25": {
   "jp": "8a9f7283",
   "kr": "무엇을 할 수 있을지 나로서는 모르겠지만"
  },
  "26": {
   "jp": "e1148d31",
   "kr": "말살하라는 명령이 내려왔다."
  },
  "27": {
   "jp": "5624a56e",
   "kr": "당신, 시플의 현자님이 아니지!"
  },
  "28": {
   "jp": "378ec737",
   "kr": "말살이라니… 뭐야?"
  },
  "29": {
   "jp": "1c9b9d21",
   "kr": "우릴 죽이겠다는 말이야."
  },
  "30": {
   "jp": "cae5e0eb",
   "kr": "어째서?"
  },
  "31": {
   "jp": "f49cc790",
   "kr": "나도 몰라!"
  },
  "32": {
   "jp": "17ec36fd",
   "kr": "내 이름은 환술사 카지무."
  },
  "33": {
   "jp": "70bf1a5e",
   "kr": "앗, 삼도교에서 스쳐 지나갔던…"
  },
  "34": {
   "jp": "d9153c8e",
   "kr": "저기, 잠깐 기다려 봐."
  },
  "35": {
   "jp": "9637e69a",
   "kr": "그렇다면"
  },
  "36": {
   "jp": "ca418b2e",
   "kr": "진짜 현자님은 어디 있는 거야?"
  },
  "37": {
   "jp": "ecd8bfa5",
   "kr": "현자를 죽이면 뒷일이 성가시니 말이다."
  },
  "38": {
   "jp": "847563cc",
   "kr": "시플의 현자는"
  },
  "39": {
   "jp": "ba7e10d5",
   "kr": "조용한 곳에서 잠들어 있지."
  },
  "40": {
   "jp": "fa80f845",
   "kr": "너희는 우리의 가루가 계획을 막았다."
  },
  "41": {
   "jp": "be3443c4",
   "kr": "현자처럼 살려 둘 수는 없다."
  },
  "42": {
   "jp": "ee4ba1d0",
   "kr": "목숨으로 갚아 줘야겠다."
  },
  "43": {
   "jp": "88ea48d0",
   "kr": "저자는 이 샤리네를"
  },
  "44": {
   "jp": "867f9e14",
   "kr": "어쩌려는 셈인가."
  },
  "45": {
   "jp": "0c4103b6",
   "kr": "다행이다…"
  },
  "46": {
   "jp": "579253b8",
   "kr": "마법의 거울엔 이상이 없는 듯하군."
  },
  "47": {
   "jp": "66dfd3d2",
   "kr": "후후후후후…"
  },
  "48": {
   "jp": "35386b9e",
   "kr": "앗?!"
  },
  "49": {
   "jp": "31a058a2",
   "kr": "카지무 목소리!"
  },
  "50": {
   "jp": "ff3b4b0e",
   "kr": "마법의 거울은 안 부쉈다. 안심해도 좋다."
  },
  "51": {
   "jp": "2f5a9f3b",
   "kr": "우리는 어리석지 않다."
  },
  "52": {
   "jp": "517a19d0",
   "kr": "아직 이용 가치가 있는 것을"
  },
  "53": {
   "jp": "d26c2360",
   "kr": "함부로 부술 리가 있겠느냐."
  },
  "54": {
   "jp": "0aec9930",
   "kr": "생각보다 끈질기군요."
  },
  "55": {
   "jp": "673ad8b4",
   "kr": "저 녀석이냐?"
  },
  "56": {
   "jp": "0a68ea29",
   "kr": "너희를 괴롭힌 게."
  },
  "57": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "58": {
   "jp": "4024fa93",
   "kr": "강해 보이는군."
  },
  "59": {
   "jp": "a5121bde",
   "kr": "그야 물론이지요."
  },
  "60": {
   "jp": "947e7ffd",
   "kr": "뒷세계에서는 이름난 살수니까요."
  },
  "61": {
   "jp": "aef73bd4",
   "kr": "넷이서 덤벼도 못 이기려나?"
  },
  "62": {
   "jp": "d35b4bdd",
   "kr": "위험할 겁니다."
  },
  "63": {
   "jp": "4f0f4853",
   "kr": "아직 살아 있으리라고는 생각지 못했습니다."
  },
  "64": {
   "jp": "e43d35cb",
   "kr": "일단 확인하러 들러 봤는데,"
  },
  "65": {
   "jp": "9561fdea",
   "kr": "잘된 모양이군요. 후후후…"
  },
  "66": {
   "jp": "a9e16306",
   "kr": "자, 넷이서 덤벼도 좋습니다."
  },
  "67": {
   "jp": "a3d3fe5f",
   "kr": "덤비세요. 이번엔 확실히 숨통을"
  },
  "68": {
   "jp": "89019c98",
   "kr": "끊어 드리지요."
  },
  "69": {
   "jp": "ae86e439",
   "kr": "현자님."
  },
  "70": {
   "jp": "72f7adf3",
   "kr": "안전한 곳으로 물러나 계세요."
  },
  "71": {
   "jp": "fb8d1eb9",
   "kr": "젠장, 하는 수밖에 없겠군."
  },
  "72": {
   "jp": "9593312d",
   "kr": "쥬리오, 이런 데서 길 잃은 애처럼"
  },
  "73": {
   "jp": "27f740e8",
   "kr": "하지 마."
  },
  "74": {
   "jp": "9c583a02",
   "kr": "그쪽은 시플 마을이야."
  },
  "75": {
   "jp": "15040efb",
   "kr": "저기, 아까 마지막 환술이란"
  },
  "76": {
   "jp": "dc0bb2b0",
   "kr": "무슨 뜻일까?"
  },
  "77": {
   "jp": "63d3f720",
   "kr": "둘 다, 괜찮아?"
  },
  "78": {
   "jp": "06ea2e16",
   "kr": "그래, 아무렇지도 않아."
  },
  "79": {
   "jp": "1d2f2c51",
   "kr": "카지무 녀석, 겁만 주고 말이야."
  },
  "80": {
   "jp": "5701e9ec",
   "kr": "환술에 실패한 모양이군."
  },
  "81": {
   "jp": "ec5a5a04",
   "kr": "크리스 님도 괜찮습니까?"
  },
  "82": {
   "jp": "d96c3f23",
   "kr": "네. 괜찮은 것 같아요."
  },
  "83": {
   "jp": "cc69f90f",
   "kr": "다행이다. 역시 실패였던 거야."
  },
  "84": {
   "jp": "5ab2329f",
   "kr": "아직 안심은 이릅니다."
  },
  "85": {
   "jp": "a879951a",
   "kr": "카지무가 어떤 환술을 썼는지"
  },
  "86": {
   "jp": "05eb4bce",
   "kr": "헤아릴 수 없습니다."
  },
  "87": {
   "jp": "c2b012ee",
   "kr": "조금이라도 어딘가 이상이 있으면,"
  },
  "88": {
   "jp": "2735c9ce",
   "kr": "바로 알려 주십시오."
  },
  "89": {
   "jp": "bb90cd33",
   "kr": "네, 알았어요."
  },
  "90": {
   "jp": "e6578a5c",
   "kr": "환술사 카지무"
  },
  "91": {
   "jp": "58e18eb8",
   "kr": "제법 하는구나."
  },
  "92": {
   "jp": "3cbb5f1c",
   "kr": "그럼, 내가 상대해 주마."
  },
  "93": {
   "jp": "e6578a5c",
   "kr": "환술사 카지무"
  },
  "94": {
   "jp": "52542a7d",
   "kr": "역시, 그저 아이였군."
  }
 }
}