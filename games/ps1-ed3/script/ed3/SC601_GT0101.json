  "0": {
   "jp": "17a61f4f",
   "kr": "바라카"
  },
  "1": {
   "jp": "0af8a3f8",
   "kr": "감옥"
  },
  "2": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "3": {
   "jp": "6df79cd3",
   "kr": "고죠"
  },
  "4": {
   "jp": "79204ab9",
   "kr": "가죠"
  },
  "5": {
   "jp": "7832b6b8",
   "kr": "후아아아〜"
  },
  "6": {
   "jp": "e13a4f20",
   "kr": "잘 잤다."
  },
  "7": {
   "jp": "836e5908",
   "kr": "난 크리스가 걱정돼서 잠을 못 잤어."
  },
  "8": {
   "jp": "60123abe",
   "kr": "쉿."
  },
  "9": {
   "jp": "d90668cf",
   "kr": "곧 시합을 시작해 주마."
  },
  "10": {
   "jp": "810faebf",
   "kr": "여기서 기다려라."
  },
  "11": {
   "jp": "8dae3960",
   "kr": "빨리 해라, 실력이 녹슬겠다."
  },
  "12": {
   "jp": "3b2e1209",
   "kr": "넌 운이 좋군."
  },
  "13": {
   "jp": "3b571fc5",
   "kr": "1회전 상대는 애다."
  },
  "14": {
   "jp": "3642042a",
   "kr": "쳇, 시시하잖아."
  },
  "15": {
   "jp": "f978c4e7",
   "kr": "(어, 어떻게 된 거지…?)"
  },
  "16": {
   "jp": "3238dbb3",
   "kr": "가도를 터는 도적"
  },
  "17": {
   "jp": "95fe9d8f",
   "kr": "가죠와 고죠가 붙잡혔단다."
  },
  "18": {
   "jp": "db6c90aa",
   "kr": "제1시합은 바다트 대 고죠다."
  },
  "19": {
   "jp": "070f753b",
   "kr": "제2시합은 가죠와 너다."
  },
  "20": {
   "jp": "6dbf4482",
   "kr": "안심해라, 네가 가죠를 이기고"
  },
  "21": {
   "jp": "09e417b7",
   "kr": "바다트가 고죠를 이기면,"
  },
  "22": {
   "jp": "dc6c4b0a",
   "kr": "드디어 너는 바다트와 시합할 수 있다."
  },
  "23": {
   "jp": "def58b2f",
   "kr": "재미있어졌군."
  },
  "24": {
   "jp": "5d5cacc7",
   "kr": "(에엣… 계획 실패다)"
  },
  "25": {
   "jp": "96e74253",
   "kr": "투기장 준비가 되는 대로"
  },
  "26": {
   "jp": "31519f52",
   "kr": "곧 시합을 개시한다."
  },
  "27": {
   "jp": "f1d2b293",
   "kr": "손님들은 벌써 달아올랐다."
  },
  "28": {
   "jp": "65795f9e",
   "kr": "자, 제1시합 개시다."
  },
  "29": {
   "jp": "50d6dd28",
   "kr": "자, 나가라."
  },
  "30": {
   "jp": "ccf50cd6",
   "kr": "나랑 붙기 전에 지지 마라."
  },
  "31": {
   "jp": "3adae119",
   "kr": "………"
  }
 }
}