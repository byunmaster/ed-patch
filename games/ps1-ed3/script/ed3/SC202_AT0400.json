 "archive": "/SCE2/SC202.DAT",
 "member": "..\\DATA\\AT0400.BIN",
 "lines": {
  "0": {
   "jp": "bf50e946",
   "kr": "볼트"
  },
  "1": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "2": {
   "jp": "79058ed6",
   "kr": "가루가는 추정으로 80미로는 된다는 얘기다."
  },
  "3": {
   "jp": "7bc484d3",
   "kr": "이 협곡에 꽉 들어찰 만한 크기."
  },
  "4": {
   "jp": "918a60ba",
   "kr": "…부르르."
  },
  "5": {
   "jp": "582f72a8",
   "kr": "지금 건 겁이 아니라 투지야."
  },
  "6": {
   "jp": "33133c14",
   "kr": "나는 가루가의 움직임을 멈추기 위한"
  },
  "7": {
   "jp": "86d473e3",
   "kr": "큰 그물을 준비하고 있어."
  },
  "8": {
   "jp": "80481d78",
   "kr": "특제 밧줄로 만든 그물이니까."
  },
  "9": {
   "jp": "5807ac7e",
   "kr": "이만큼 튼튼하면"
  },
  "10": {
   "jp": "d7016aeb",
   "kr": "고래라도 잡을 수 있다고."
  },
  "11": {
   "jp": "e1097a6a",
   "kr": "고래를요?"
  },
  "12": {
   "jp": "c02e8180",
   "kr": "정말요?"
  },
  "13": {
   "jp": "c501a6a5",
   "kr": "고래를 그물로 잡는다니"
  },
  "14": {
   "jp": "4acbfb90",
   "kr": "들어 본 적 없어요."
  },
  "15": {
   "jp": "9c97af17",
   "kr": "그만큼 튼튼하게 돼 있단 거야."
  },
  "16": {
   "jp": "3a386a2d",
   "kr": "바로 그거야."
  },
  "17": {
   "jp": "740d2469",
   "kr": "너희들."
  },
  "18": {
   "jp": "60a09ad2",
   "kr": "언제 가루가가 올지 모르니까."
  },
  "19": {
   "jp": "a5b084a1",
   "kr": "너무 얼쩡거리지 말고"
  },
  "20": {
   "jp": "63ed7e9f",
   "kr": "얌전히 마을 안에 있는 게 좋아."
  },
  "21": {
   "jp": "0dc93cb6",
   "kr": "이제, 다른 작업은 다 끝나서"
  },
  "22": {
   "jp": "5e239562",
   "kr": "이 앞에 가도 아무도 없어."
  }
 }
}