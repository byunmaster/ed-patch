{
 "archive": "/SCE6/SC604.DAT",
 "member": "..\\DATA\\GT2205.BIN",
 "lines": {
  "0": {
   "jp": "dc464821",
   "kr": "기드넬"
  },
  "1": {
   "jp": "4300e71e",
   "kr": "우르기드 저택"
  },
  "2": {
   "jp": "e9b5c557",
   "kr": "우르기드"
  },
  "3": {
   "jp": "386d7c46",
   "kr": "파시아"
  },
  "4": {
   "jp": "d12a3c7c",
   "kr": "칸다타"
  },
  "5": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "6": {
   "jp": "c9b8d32f",
   "kr": "비비안"
  },
  "7": {
   "jp": "229d0b6d",
   "kr": "이졸데"
  },
  "8": {
   "jp": "e2582e80",
   "kr": "후우…"
  },
  "9": {
   "jp": "bfce900b",
   "kr": "진정됐구먼."
  },
  "10": {
   "jp": "c56d58f2",
   "kr": "내가 말하기도 뭣하다만"
  },
  "11": {
   "jp": "00970b84",
   "kr": "아무래도"
  },
  "12": {
   "jp": "fcbde27c",
   "kr": "머릿속이 마비돼 있었던 모양이야."
  },
  "13": {
   "jp": "aa3d63b9",
   "kr": "우르기드 님, 저도 그렇습니다."
  },
  "14": {
   "jp": "8d3ffc69",
   "kr": "역시"
  },
  "15": {
   "jp": "a13b9bdc",
   "kr": "레바스 탓 아닐까요."
  },
  "16": {
   "jp": "a68f2626",
   "kr": "그래, 분명 그 때문일 게다."
  },
  "17": {
   "jp": "78489a78",
   "kr": "저기, 그 일에 대해서"
  },
  "18": {
   "jp": "b03ee4a4",
   "kr": "가르쳐 주실 수 없을까요?"
  },
  "19": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "20": {
   "jp": "46979adf",
   "kr": "반년쯤 전이었던가."
  },
  "21": {
   "jp": "0b740044",
   "kr": "마침,"
  },
  "22": {
   "jp": "9a4d5d2b",
   "kr": "내가 바라카에서 물건을 들이러 왔을 때였지."
  },
  "23": {
   "jp": "30da9d91",
   "kr": "우르기드 님께 인사를 드리려고"
  },
  "24": {
   "jp": "3384ece4",
   "kr": "이 저택에 들렀지."
  },
  "25": {
   "jp": "7426bc0d",
   "kr": "그때, 그놈이 마침 왔던 거다."
  },
  "26": {
   "jp": "9a12498a",
   "kr": "폴티아의 점성술사, 레바스가."
  },
  "27": {
   "jp": "33018e25",
   "kr": "그런 자가 있다는 건 전부터 알고 있었지만,"
  },
  "28": {
   "jp": "a3aa2bc0",
   "kr": "그때, 그놈은 정식 폴티아 대사로서"
  },
  "29": {
   "jp": "e18d5b48",
   "kr": "나에게 회담을 청해 왔다."
  },
  "30": {
   "jp": "ef51dc86",
   "kr": "내용은… 아아."
  },
  "31": {
   "jp": "3c5fc490",
   "kr": "그때도 한순간"
  },
  "32": {
   "jp": "c52e520b",
   "kr": "몸에 떨림이 스친 걸 기억한다."
  },
  "33": {
   "jp": "82543a2b",
   "kr": "허나, 그놈의 눈을 보았을 때"
  },
  "34": {
   "jp": "d1319107",
   "kr": "이상하게도"
  },
  "35": {
   "jp": "b1fa79be",
   "kr": "맞설 마음 따위 사라져 버렸다."
  },
  "36": {
   "jp": "03cdebcd",
   "kr": "그놈은 기드나에 동맹을 요구해 왔던 거야."
  },
  "37": {
   "jp": "5480fb05",
   "kr": "이제부터 폴티아가 시작하려는"
  },
  "38": {
   "jp": "c9423937",
   "kr": "세계 침략의 발판으로서…"
  },
  "39": {
   "jp": "c19f7921",
   "kr": "우선, 이웃 나라와 손잡겠단 거군."
  },
  "40": {
   "jp": "5a316a70",
   "kr": "그, 그런…?"
  },
  "41": {
   "jp": "2a8f70d4",
   "kr": "세계…침략…"
  },
  "42": {
   "jp": "1b71c977",
   "kr": "우리 나라가…"
  },
  "43": {
   "jp": "5cc3d1af",
   "kr": "그렇게 나쁜 짓을 시작할 리가 없어…"
  },
  "44": {
   "jp": "245ada23",
   "kr": "아니, 그놈의 사악하게 빛나는 붉은 눈은,"
  },
  "45": {
   "jp": "00b02c41",
   "kr": "틀림없는 현실이었다."
  },
  "46": {
   "jp": "7a4e275d",
   "kr": "레바스는 동맹에 동의하는 조건으로"
  },
  "47": {
   "jp": "443c1149",
   "kr": "기드나엔 손대지 않고, 세계 침략 뒤의"
  },
  "48": {
   "jp": "8ed5cac2",
   "kr": "장사에 관한 모든 것을 내게 맡긴다고 했다."
  },
  "49": {
   "jp": "db0e1408",
   "kr": "붉은 눈…"
  },
  "50": {
   "jp": "e4856fad",
   "kr": "욕망의 씨앗을 품은 자는 마음을 잃는다."
  },
  "51": {
   "jp": "46d93f3e",
   "kr": "붉은 눈을 가진 자가 재앙을 부를 것이다."
  },
  "52": {
   "jp": "c9496cd9",
   "kr": "돌아가신 할머니께 들은 말이에요."
  },
  "53": {
   "jp": "d3ed63da",
   "kr": "할머니는"
  },
  "54": {
   "jp": "b5c12b24",
   "kr": "하얀마녀의 예언이라고 하셨어요."
  },
  "55": {
   "jp": "0b03b0f3",
   "kr": "하얀마녀의…?"
  },
  "56": {
   "jp": "9135ae04",
   "kr": "그런 전승이"
  },
  "57": {
   "jp": "c595c856",
   "kr": "이 근방에 남아 있었어요?"
  },
  "58": {
   "jp": "bee65aa7",
   "kr": "전승이라 부를 만큼"
  },
  "59": {
   "jp": "e6dc1059",
   "kr": "알려진 일은 아니지만…"
  },
  "60": {
   "jp": "f2b24598",
   "kr": "20년 전에, 하얀마녀는 여기서 알게 된"
  },
  "61": {
   "jp": "9cbb5b3d",
   "kr": "저의 할머니께만,"
  },
  "62": {
   "jp": "c1ec1770",
   "kr": "털어놓은 모양이에요…"
  },
  "63": {
   "jp": "e2845d70",
   "kr": "하얀마녀는 그때,"
  },
  "64": {
   "jp": "eace67a0",
   "kr": "무언가 몹시 서둘렀던 것 같다고,"
  },
  "65": {
   "jp": "91199836",
   "kr": "할머니는 말씀하셨어요."
  },
  "66": {
   "jp": "eace19f4",
   "kr": "서둘렀다…?"
  },
  "67": {
   "jp": "ebd9eb94",
   "kr": "어딘가로 향하고 있었던 걸까요?"
  },
  "68": {
   "jp": "a557bf9e",
   "kr": "폴티아 쪽으로 향했다고"
  },
  "69": {
   "jp": "91199836",
   "kr": "할머니는 말씀하셨어요."
  },
  "70": {
   "jp": "f0f3cf6d",
   "kr": "붉은 눈을 조심하라."
  },
  "71": {
   "jp": "ca19ad4d",
   "kr": "붉은 눈에 홀리지 마라."
  },
  "72": {
   "jp": "ee200e69",
   "kr": "붉은 눈을 가진 자가 나타날 때,"
  },
  "73": {
   "jp": "1a509c71",
   "kr": "사악한 계획이 움직이기 시작한다고도 했대요."
  },
  "74": {
   "jp": "9d8007cd",
   "kr": "제가 들은 건 그것뿐이지만요."
  },
  "75": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "76": {
   "jp": "3adae119",
   "kr": "………"
  },
  "77": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "78": {
   "jp": "9a65969c",
   "kr": "너희들, 유난히 하얀마녀에"
  },
  "79": {
   "jp": "698e5f7b",
   "kr": "관심이 많은 것 같은데?"
  },
  "80": {
   "jp": "621b085b",
   "kr": "응, 조금."
  },
  "81": {
   "jp": "34dfb284",
   "kr": "그 얼굴은 예사롭지 않군."
  },
  "82": {
   "jp": "f83717c7",
   "kr": "괜찮으면 들려줘 봐."
  },
  "83": {
   "jp": "43478481",
   "kr": "얘기에 따라선, 힘이 되어 주지."
  },
  "84": {
   "jp": "5e5aab85",
   "kr": "으, 응."
  },
  "85": {
   "jp": "2fac01b6",
   "kr": "쥬리오. 어떡할래?"
  },
  "86": {
   "jp": "3846a288",
   "kr": "저, 기드나가 더는 그 레바스의 작전에"
  },
  "87": {
   "jp": "b4284318",
   "kr": "넘어가지 않게 하기 위해서라도"
  },
  "88": {
   "jp": "ddf94f4e",
   "kr": "들려주는 편이 낫다고 생각해."
  },
  "89": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "90": {
   "jp": "e3da605d",
   "kr": "우르기드 님도"
  },
  "91": {
   "jp": "022bd4bc",
   "kr": "잘 들어 주세요."
  },
  "92": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "93": {
   "jp": "27dd366e",
   "kr": "들려주게."
  },
  "94": {
   "jp": "077b4dac",
   "kr": "저희, 폴티아 사람이에요."
  },
  "95": {
   "jp": "dc7e2d08",
   "kr": "폴티아의 작은 마을의 관습으로,"
  },
  "96": {
   "jp": "4924a9d3",
   "kr": "세계의 샤리네를 도는"
  },
  "97": {
   "jp": "573fa659",
   "kr": "순례 여행을 마치고 돌아오는 길이에요."
  },
  "98": {
   "jp": "74b09ecf",
   "kr": "호오, 순례를."
  },
  "99": {
   "jp": "d1c572a2",
   "kr": "허어. 그랬던 거군."
  },
  "100": {
   "jp": "ad6e2132",
   "kr": "저희,"
  },
  "101": {
   "jp": "34c449f3",
   "kr": "마지막 목적지 올도스의 마법의 거울에서"
  },
  "102": {
   "jp": "50b4801f",
   "kr": "아주 불길한 영상을 봤어요."
  },
  "103": {
   "jp": "2787fd73",
   "kr": "아실지도 모르지만,"
  },
  "104": {
   "jp": "7a087616",
   "kr": "샤리네의 마법의 거울은 앞으로 일어날 일을"
  },
  "105": {
   "jp": "5aa35c55",
   "kr": "비추는 신기한 힘이 있어요."
  },
  "106": {
   "jp": "5a13ae2e",
   "kr": "마법의 거울이 비춘 것은"
  },
  "107": {
   "jp": "dd1cfd1d",
   "kr": "전투 준비를 하고 있는 루드성의 모습이었어."
  },
  "108": {
   "jp": "0177a7dc",
   "kr": "안뜰 가득 모인 수많은 병사들."
  },
  "109": {
   "jp": "0fc5eb60",
   "kr": "그리고, 로브를 걸친"
  },
  "110": {
   "jp": "67a2035c",
   "kr": "수상한 남자의 모습이 보였어…"
  },
  "111": {
   "jp": "ba5b837c",
   "kr": "아마, 그게 레바스예요."
  },
  "112": {
   "jp": "be118d73",
   "kr": "그러니까, 쥬리오네가 올도스의 거울에서"
  },
  "113": {
   "jp": "9653968a",
   "kr": "본 대로의 전개가 되어 버렸다는 거군."
  },
  "114": {
   "jp": "b928d021",
   "kr": "되어 버렸다는 거로군."
  },
  "115": {
   "jp": "e44dd3a4",
   "kr": "응, 그렇거든."
  },
  "116": {
   "jp": "00e7752c",
   "kr": "그리고 있잖아, 우리 순례 도중 여기저기서,"
  },
  "117": {
   "jp": "6f58999d",
   "kr": "하얀마녀와 얽힌 이야기를 들었어."
  },
  "118": {
   "jp": "2a04c0d1",
   "kr": "이어 맞춰 생각해 보면…"
  },
  "119": {
   "jp": "11cf8a53",
   "kr": "아무래도, 하얀마녀는 20년 전부터"
  },
  "120": {
   "jp": "8835db3e",
   "kr": "폴티아가 지금처럼 될 걸"
  },
  "121": {
   "jp": "e8e827c5",
   "kr": "알고 있었던 모양이에요."
  },
  "122": {
   "jp": "c6096d8b",
   "kr": "어머."
  },
  "123": {
   "jp": "209401b9",
   "kr": "쥬리오와 크리스는 겪은 일을 얘기하고,"
  },
  "124": {
   "jp": "547807b9",
   "kr": "하얀마녀와 마법의 거울의 관련을 설명했다."
  },
  "125": {
   "jp": "cb269399",
   "kr": "쥬리오 일행은 굳이 『라우알의 파도』만은"
  },
  "126": {
   "jp": "673099b4",
   "kr": "말하지 않았지만, 뜻은 잘 통했다."
  },
  "127": {
   "jp": "bb7f8bad",
   "kr": "그랬군요…"
  },
  "128": {
   "jp": "35d9be06",
   "kr": "파시아가 할머니께 들은 이야기를 합치면,"
  },
  "129": {
   "jp": "cc02da3b",
   "kr": "나도 레바스 때문에 감쪽같이 앞잡이 노릇을"
  },
  "130": {
   "jp": "168c7815",
   "kr": "셈이로군."
  },
  "131": {
   "jp": "092801cb",
   "kr": "앗!"
  },
  "132": {
   "jp": "51e1de0d",
   "kr": "왜 그래?"
  },
  "133": {
   "jp": "21778a59",
   "kr": "그러고 보니, 우르기드 님."
  },
  "134": {
   "jp": "0216cba0",
   "kr": "폴티아 국경 경비는 레바스가 온 이래로,"
  },
  "135": {
   "jp": "1386fa12",
   "kr": "폴티아군에 맡겨 두기만 했습니다."
  },
  "136": {
   "jp": "ed73a67d",
   "kr": "아앗!"
  },
  "137": {
   "jp": "df16840c",
   "kr": "큰일이다!"
  },
  "138": {
   "jp": "e15af507",
   "kr": "어떡하지. 어떡하지. 어떡하지."
  },
  "139": {
   "jp": "2796257d",
   "kr": "이럴 순 없다."
  },
  "140": {
   "jp": "b68f3fa2",
   "kr": "자, 잘못하면…"
  },
  "141": {
   "jp": "1ef9c838",
   "kr": "폴티아 국경은 이미 폴티아군으로,"
  },
  "142": {
   "jp": "e77a4613",
   "kr": "가득 메워져 있을지도 모릅니다요…"
  },
  "143": {
   "jp": "1c473c88",
   "kr": "안 되겠다, 그놈의 붉은 눈 최면술에 걸려,"
  },
  "144": {
   "jp": "4c4638a6",
   "kr": "머리가 멍해져 있었구먼."
  },
  "145": {
   "jp": "be250823",
   "kr": "이러고 있을 순 없다!"
  },
  "146": {
   "jp": "1c5e0f85",
   "kr": "병사를 모아라!"
  },
  "147": {
   "jp": "add456f3",
   "kr": "전군을 몰아 폴티아 국경으로 향한다!"
  },
  "148": {
   "jp": "ef188c9c",
   "kr": "그건 안 돼요."
  },
  "149": {
   "jp": "43e1fcaa",
   "kr": "끄, 끄에…"
  },
  "150": {
   "jp": "23a49731",
   "kr": "사막의 흑표범…"
  },
  "151": {
   "jp": "b45e8aa6",
   "kr": "아무리 병사를 데려간들,"
  },
  "152": {
   "jp": "c9e7c54d",
   "kr": "폴티아가 진심으로 준비를 하고 있었다면,"
  },
  "153": {
   "jp": "2967ccc6",
   "kr": "도저히 승산은 없어요."
  },
  "154": {
   "jp": "ee68e3b7",
   "kr": "계획을 막을 방법은 단 하나."
  },
  "155": {
   "jp": "2d68aee4",
   "kr": "루드성 안으로 숨어들어"
  },
  "156": {
   "jp": "3c187739",
   "kr": "주모자와 직접 맞서는 길뿐이에요."
  },
  "157": {
   "jp": "077a00b3",
   "kr": "응, 그래."
  },
  "158": {
   "jp": "f51c52b1",
   "kr": "이건 분명 우리의 몫이야."
  },
  "159": {
   "jp": "3a9eea9e",
   "kr": "우리 나라가"
  },
  "160": {
   "jp": "9dfd000e",
   "kr": "저지르려는 잘못이니까요."
  },
  "161": {
   "jp": "88149875",
   "kr": "네."
  },
  "162": {
   "jp": "64a9459f",
   "kr": "세상에 재앙을 부르려 한다니"
  },
  "163": {
   "jp": "99e51d36",
   "kr": "내버려 둘 수 없어요."
  },
  "164": {
   "jp": "c3bbc00d",
   "kr": "나도 간다."
  },
  "165": {
   "jp": "93c26510",
   "kr": "뭐니 뭐니 해도, 나는 이럴 때를 위해서,"
  },
  "166": {
   "jp": "e0245abd",
   "kr": "평소부터 수행을 쌓아 왔으니까."
  },
  "167": {
   "jp": "6118c5a4",
   "kr": "정말이야, 바다트."
  },
  "168": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "169": {
   "jp": "c8ef9714",
   "kr": "바다트가 있어 주면 천군만마야."
  },
  "170": {
   "jp": "d75a2224",
   "kr": "물론, 저도 갈게요."
  },
  "171": {
   "jp": "c05d5df4",
   "kr": "스텔라 씨."
  },
  "172": {
   "jp": "cfcc67c2",
   "kr": "우르기드도 칸다타도 제정신으로 돌아왔으니"
  },
  "173": {
   "jp": "40996163",
   "kr": "이 기드나는 이제 괜찮아."
  },
  "174": {
   "jp": "59b37e7f",
   "kr": "하지만, 폴티아가 쳐들어오면"
  },
  "175": {
   "jp": "6663133f",
   "kr": "지금까지 이상으로 기드나는,"
  },
  "176": {
   "jp": "7f1302a3",
   "kr": "아니, 세상은 끔찍한 사태가 돼 버려요."
  },
  "177": {
   "jp": "ae7c9ba2",
   "kr": "무슨 일이 있어도"
  },
  "178": {
   "jp": "5299f278",
   "kr": "그것만은, 막아야 해요…"
  },
  "179": {
   "jp": "8c68dc56",
   "kr": "고마워요, 스텔라 씨."
  },
  "180": {
   "jp": "ba840e61",
   "kr": "스텔라가 파티에 합류했다."
  },
  "181": {
   "jp": "f867bb2b",
   "kr": "우르기드 님."
  },
  "182": {
   "jp": "373eb61a",
   "kr": "부디 병사를 국경으로 보내거나"
  },
  "183": {
   "jp": "39010519",
   "kr": "하지 말아 주세요."
  },
  "184": {
   "jp": "c716ffe8",
   "kr": "그렇군, 되도록 제정신으로 돌아온 걸"
  },
  "185": {
   "jp": "c9dd8294",
   "kr": "레바스가 눈치채지 못하게"
  },
  "186": {
   "jp": "ed847215",
   "kr": "해 두는 편이 낫지 않을까 싶다고."
  },
  "187": {
   "jp": "2def5ccd",
   "kr": "그렇다고, 지금까지처럼"
  },
  "188": {
   "jp": "284b0d3e",
   "kr": "국민에게 악정을 펴는 건 용서 안 해요."
  },
  "189": {
   "jp": "3ec5d9e1",
   "kr": "아, 알았다…"
  },
  "190": {
   "jp": "4d0cb243",
   "kr": "전부 너희가 말하는 대로 하겠다."
  },
  "191": {
   "jp": "7740aaae",
   "kr": "뭐니 뭐니 해도,"
  },
  "192": {
   "jp": "dc554d33",
   "kr": "손님이 있어야 장사가 되는 법이라"
  },
  "193": {
   "jp": "e8ceac81",
   "kr": "그 점은 아주 잘 알고 있다."
  },
  "194": {
   "jp": "db926ac9",
   "kr": "그러니 부탁이다."
  },
  "195": {
   "jp": "6f37d7bc",
   "kr": "폴티아의 계획을 막아서"
  },
  "196": {
   "jp": "5a6fb091",
   "kr": "안심하고 장사할 세상으로 되돌려 주게."
  },
  "197": {
   "jp": "2852950a",
   "kr": "정말입니다. 부탁드립니다."
  },
  "198": {
   "jp": "d2ae6792",
   "kr": "왠지, 아직 장사 생각밖에"
  },
  "199": {
   "jp": "39b3a6c7",
   "kr": "안 하는 것 같은데…"
  },
  "200": {
   "jp": "72085232",
   "kr": "정말 괜찮을까…"
  },
  "201": {
   "jp": "729497a6",
   "kr": "이놈들은 뼛속까지 장사꾼이니까 말이야."
  },
  "202": {
   "jp": "d4a64a16",
   "kr": "그래도, 위험하다는 건 알아챈 모양이다."
  },
  "203": {
   "jp": "9e38bfa9",
   "kr": "지금까지 같은 일은 없겠지."
  },
  "204": {
   "jp": "284a9533",
   "kr": "앗, 그렇지. 이건 돌려주마."
  },
  "205": {
   "jp": "890a68d4",
   "kr": "받아 주게."
  },
  "206": {
   "jp": "7b1557e9",
   "kr": "우르기드는"
  },
  "207": {
   "jp": "eba95ba0",
   "kr": "를"
  },
  "208": {
   "jp": "a207825d",
   "kr": "품에서 꺼냈다."
  },
  "209": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는"
  },
  "210": {
   "jp": "f1e63720",
   "kr": "를 되찾았다."
  },
  "211": {
   "jp": "9b4a6f49",
   "kr": "더는 못 들겠어."
  },
  "212": {
   "jp": "c95ef071",
   "kr": "뭔가 버리자."
  },
  "213": {
   "jp": "de40ca28",
   "kr": "그럼, 당장 국경으로 향하죠."
  },
  "214": {
   "jp": "8a24de54",
   "kr": "한시도 지체할 수 없어요."
  },
  "215": {
   "jp": "74708d4c",
   "kr": "나쁜 뜻은 없었어."
  },
  "216": {
   "jp": "cdb8b7ee",
   "kr": "게다가, 아가씨한테는"
  },
  "217": {
   "jp": "8ef2aef4",
   "kr": "무희는 안 어울리잖아."
  },
  "218": {
   "jp": "12ba1752",
   "kr": "뭐예요."
  },
  "219": {
   "jp": "6f5cee71",
   "kr": "제가 춤 못 춘다고 생각해요?"
  },
  "220": {
   "jp": "9df232c2",
   "kr": "아, 아니."
  },
  "221": {
   "jp": "a707b5b5",
   "kr": "그런 뜻은 아니라…"
  },
  "222": {
   "jp": "d284cdf1",
   "kr": "아무튼 용서해 줘."
  },
  "223": {
   "jp": "8fe19521",
   "kr": "용서해 달라니까아."
  },
  "224": {
   "jp": "fa6a2314",
   "kr": "미안했어."
  },
  "225": {
   "jp": "350f72a6",
   "kr": "요즘 우르기드 님이 엄청 제멋대로라서"
  },
  "226": {
   "jp": "854cfdf3",
   "kr": "이상하다고 생각했어."
  },
  "227": {
   "jp": "63b8f73d",
   "kr": "아, 지금 얘기는 비밀이야."
  },
  "228": {
   "jp": "27dcab52",
   "kr": "우리까지 마법에 걸려 있었던 모양이야."
  },
  "229": {
   "jp": "2af96140",
   "kr": "하지만, 안심해. 이젠 괜찮다."
  },
  "230": {
   "jp": "f371a4bb",
   "kr": "만에 하나, 우르기드 님이"
  },
  "231": {
   "jp": "0b40c11a",
   "kr": "또, 나쁜 마법에 걸리면"
  },
  "232": {
   "jp": "b5b5644c",
   "kr": "이번엔 우리가 제정신으로 되돌려 주마."
  },
  "233": {
   "jp": "878d16e4",
   "kr": "머릿속이 말끔해진 느낌이야."
  },
  "234": {
   "jp": "1c9c7215",
   "kr": "분명, 레바스라는 놈의 마법이"
  },
  "235": {
   "jp": "1e866b96",
   "kr": "우르기드 님께 들어서 그게 우리까지"
  },
  "236": {
   "jp": "b561e43d",
   "kr": "이상하게 만들었던 거로군."
  },
  "237": {
   "jp": "ca86c3b7",
   "kr": "그건 그렇고"
  },
  "238": {
   "jp": "70075a48",
   "kr": "폴티아의 레바스란"
  },
  "239": {
   "jp": "f05bb17b",
   "kr": "대체 뭐 하는 놈이었을까…"
  },
  "240": {
   "jp": "4e1aa915",
   "kr": "정말 다행입니다."
  },
  "241": {
   "jp": "563f6412",
   "kr": "게다가 기드나도,"
  },
  "242": {
   "jp": "74efacb4",
   "kr": "이걸로, 분명 좋아질 거예요."
  },
  "243": {
   "jp": "5e195893",
   "kr": "마음을 고쳐먹은 우르기드 님이라면"
  },
  "244": {
   "jp": "c553ad5e",
   "kr": "모실 보람도 있어요."
  },
  "245": {
   "jp": "b1fd1a5a",
   "kr": "저도 앞으로의 기드나를 위해 힘내겠습니다."
  },
  "246": {
   "jp": "37b27caa",
   "kr": "장사에는 그만한 원동력인 욕심이 필요하다."
  },
  "247": {
   "jp": "d5524581",
   "kr": "하지만 그것 때문에 레바스에게 틈을 보이고,"
  },
  "248": {
   "jp": "693d28aa",
   "kr": "의식을 빼앗기고 있었던 모양이다."
  },
  "249": {
   "jp": "acbc7ad6",
   "kr": "상인의 욕심도 지나치면 좋지 않군."
  },
  "250": {
   "jp": "45f6e2f7",
   "kr": "그걸 잘 알았다."
  },
  "251": {
   "jp": "db55937d",
   "kr": "앞으로는 국민의 살림을 생각하면서"
  },
  "252": {
   "jp": "fa1b4a12",
   "kr": "장사에 힘쓰기로 하겠다."
  },
  "253": {
   "jp": "c4fb4f7b",
   "kr": "그러니 부디,"
  },
  "254": {
   "jp": "2908100f",
   "kr": "폴티아의 위협에서"
  },
  "255": {
   "jp": "b9a5d103",
   "kr": "이 나라를 지켜 주었으면 한다."
  },
  "256": {
   "jp": "5228c631",
   "kr": "아니, 세상 사람들을 위해서도."
  },
  "257": {
   "jp": "a78adddd",
   "kr": "레바스에게 들키지 않게"
  },
  "258": {
   "jp": "c4a5f26a",
   "kr": "조금씩 기드나가 살기 좋은 나라가"
  },
  "259": {
   "jp": "3b3e3b5f",
   "kr": "되도록 나도 거들 생각이다."
  },
  "260": {
   "jp": "f8bf459c",
   "kr": "물론, 바라카의 투기장도 폐지하겠다."
  },
  "261": {
   "jp": "d88ad92d",
   "kr": "그러니 부탁한다."
  },
  "262": {
   "jp": "1e1b856e",
   "kr": "안심하고 장사를 이어 갈 수 있도록"
  },
  "263": {
   "jp": "20b6217d",
   "kr": "폴티아 쪽은 하나 부탁하네."
  },
  "264": {
   "jp": "1a98d6a3",
   "kr": "이걸로 우르기드 님도 조금은 온화해지겠죠."
  },
  "265": {
   "jp": "f294ae48",
   "kr": "사막 남자는"
  },
  "266": {
   "jp": "fcaa66d1",
   "kr": "적당히 제멋대로인 쪽이 난 좋아요."
  }
 }
}