{
 "archive": "/SCE2/SC204.DAT",
 "member": "..\\DATA\\CR2000.BIN",
 "lines": {
  "0": {
   "jp": "7ae9c4c7",
   "kr": "독늪 지대"
  },
  "1": {
   "jp": "2ea467d3",
   "kr": "파피"
  },
  "2": {
   "jp": "486ed1ec",
   "kr": "크로와 할머니"
  },
  "3": {
   "jp": "01154edb",
   "kr": "전부 낚싯줄이 돼 있으면 어쩌지."
  },
  "4": {
   "jp": "5071032b",
   "kr": "안 돼, 크리스."
  },
  "5": {
   "jp": "32f0cdf2",
   "kr": "나쁜 쪽으로 생각하면 나쁜 일을 불러들인다고"
  },
  "6": {
   "jp": "19b16946",
   "kr": "라프 할아버지가 말했잖아."
  },
  "7": {
   "jp": "c8fcf835",
   "kr": "응… 그렇지!"
  },
  "8": {
   "jp": "c0e94392",
   "kr": "미안."
  },
  "9": {
   "jp": "1b2946c5",
   "kr": "이 한 가닥밖에 안 남았어."
  },
  "10": {
   "jp": "8712d25a",
   "kr": "괜찮으려나."
  },
  "11": {
   "jp": "85c293e1",
   "kr": "쥬리오 일행은 키타라 현을 받았다."
  },
  "12": {
   "jp": "d678b6da",
   "kr": "고마워."
  },
  "13": {
   "jp": "796a9086",
   "kr": "아무튼 이걸 트로바 씨한테"
  },
  "14": {
   "jp": "51f8b560",
   "kr": "가져가 볼게."
  },
  "15": {
   "jp": "fc88e390",
   "kr": "뭐야, 인기척이 나길래"
  },
  "16": {
   "jp": "a9e182eb",
   "kr": "키타라 악사 트로바가 온 줄 알았어."
  },
  "17": {
   "jp": "82c627d5",
   "kr": "키타라 악사 트로바?"
  },
  "18": {
   "jp": "25753224",
   "kr": "이 계절이 되면"
  },
  "19": {
   "jp": "9ee70469",
   "kr": "찾아와서,"
  },
  "20": {
   "jp": "5f89debd",
   "kr": "노래를 들려주거든."
  },
  "21": {
   "jp": "849891f9",
   "kr": "늘 다츠에 들렀다가"
  },
  "22": {
   "jp": "c5aa7bb2",
   "kr": "와 주는데 말이야."
  },
  "23": {
   "jp": "b11dcd25",
   "kr": "올해도 몹시 기다려져."
  },
  "24": {
   "jp": "f4aeb51f",
   "kr": "트로바의 키타라 연주는 무척 즐겁거든."
  },
  "25": {
   "jp": "04d9f5fd",
   "kr": "다츠 사람들도,"
  },
  "26": {
   "jp": "00bdb6ae",
   "kr": "트로바 키타라를 듣고 있을 때만은"
  },
  "27": {
   "jp": "031b159e",
   "kr": "밝은 얼굴을 하는데 말이야."
  },
  "28": {
   "jp": "d64e8b09",
   "kr": "에〜!!"
  },
  "29": {
   "jp": "6b0138c0",
   "kr": "벌써, 트로바는 가 버린 거야!?"
  },
  "30": {
   "jp": "7355cc92",
   "kr": "쳇. 못 듣고 놓쳤네."
  },
  "31": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "32": {
   "jp": "52404b42",
   "kr": "키타라 현…"
  },
  "33": {
   "jp": "62852c8e",
   "kr": "어, 어땠으려나."
  },
  "34": {
   "jp": "d32c8f29",
   "kr": "여기 있을지도 모른다고"
  },
  "35": {
   "jp": "d4a67a06",
   "kr": "듣고 왔는데."
  },
  "36": {
   "jp": "784c6be9",
   "kr": "할머니한테 물어봤어?"
  },
  "37": {
   "jp": "49274b63",
   "kr": "미안, 사실대로 말할게."
  },
  "38": {
   "jp": "ffb17ed3",
   "kr": "이 낚싯줄이"
  },
  "39": {
   "jp": "dcad0273",
   "kr": "키타라 현이야."
  },
  "40": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "41": {
   "jp": "e5552913",
   "kr": "에엣?"
  },
  "42": {
   "jp": "9abb55e5",
   "kr": "낚싯줄로 딱 좋았던 터라"
  },
  "43": {
   "jp": "4bcd8ae9",
   "kr": "그만 써 버렸어."
  },
  "44": {
   "jp": "293ca641",
   "kr": "그럴 수가…"
  },
  "45": {
   "jp": "c5851b25",
   "kr": "그럼 키타라 현은 이제 없어?"
  },
  "46": {
   "jp": "39d14b13",
   "kr": "아직 있을 것 같은데."
  },
  "47": {
   "jp": "9fa2647f",
   "kr": "조금만 기다려."
  },
  "48": {
   "jp": "13572e9b",
   "kr": "지금 보고 올게."
  },
  "49": {
   "jp": "dcaca1f7",
   "kr": "어라, 손님인가?"
  },
  "50": {
   "jp": "09a19a4b",
   "kr": "이보게, 크로와 할멈."
  },
  "51": {
   "jp": "a367c502",
   "kr": "오랜만이구먼."
  },
  "52": {
   "jp": "033e3667",
   "kr": "잠깐 일행이 할머니 이야기를"
  },
  "53": {
   "jp": "afa80e97",
   "kr": "듣고 싶다는구먼."
  },
  "54": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "55": {
   "jp": "27c7d21f",
   "kr": "할머니시군요."
  },
  "56": {
   "jp": "68e044d1",
   "kr": "옛날에, 하얀마녀를"
  },
  "57": {
   "jp": "7734a418",
   "kr": "만났다는 할머니."
  },
  "58": {
   "jp": "3e3e9645",
   "kr": "아, 그렇다만."
  },
  "59": {
   "jp": "b0f768b0",
   "kr": "그래도 옛날이라는 건 좀 지나친 말이야."
  },
  "60": {
   "jp": "b6e88b64",
   "kr": "나한테는 고작 20년 전 일이란다."
  },
  "61": {
   "jp": "36064e40",
   "kr": "하기야, 너만 한 나이라면"
  },
  "62": {
   "jp": "53de5a8c",
   "kr": "아주 옛날 일로 여겨지는 것도"
  },
  "63": {
   "jp": "8c336fe3",
   "kr": "무리는 아니겠지만."
  },
  "64": {
   "jp": "c8cca81f",
   "kr": "네, 저흰 그때"
  },
  "65": {
   "jp": "aa1fb546",
   "kr": "태어나지도 않았으니까요."
  },
  "66": {
   "jp": "326c041b",
   "kr": "저기, 할머니."
  },
  "67": {
   "jp": "50be02cf",
   "kr": "저희 순례 여행을 하는 중인데요,"
  },
  "68": {
   "jp": "2fdddae7",
   "kr": "옛날에 여행했다는 마녀에게 관심이 있어요."
  },
  "69": {
   "jp": "906565d8",
   "kr": "하얀마녀 게르드가"
  },
  "70": {
   "jp": "a4dbdbd0",
   "kr": "어떤 사람이었는지"
  },
  "71": {
   "jp": "83633ee7",
   "kr": "들려주시지 않겠어요?"
  },
  "72": {
   "jp": "19a248c7",
   "kr": "글쎄다…"
  },
  "73": {
   "jp": "a9ab2822",
   "kr": "그때 나이는 18살쯤이었을 게다만…"
  },
  "74": {
   "jp": "6d102a7b",
   "kr": "나에게는 평범한 여자애로 보였어."
  },
  "75": {
   "jp": "c613a39a",
   "kr": "푸른빛 도는 아름다운 은빛 머리였지."
  },
  "76": {
   "jp": "c23da9ed",
   "kr": "조용하고, 좋은 아가씨였어."
  },
  "77": {
   "jp": "6d1eaff1",
   "kr": "다만, 마녀인 만큼"
  },
  "78": {
   "jp": "0366d93b",
   "kr": "보통 사람은 모르는 것도"
  },
  "79": {
   "jp": "911b8620",
   "kr": "많이 알고 있었던 모양이야."
  },
  "80": {
   "jp": "25a2237c",
   "kr": "그래서 고민하는 일도 있었던 것 같았어."
  },
  "81": {
   "jp": "85694968",
   "kr": "보통 사람은 모르는 거요?"
  },
  "82": {
   "jp": "1d1771fb",
   "kr": "미래의 일 같은 걸"
  },
  "83": {
   "jp": "e0caaead",
   "kr": "알았던 모양이야."
  },
  "84": {
   "jp": "9889f13f",
   "kr": "정말 대단하다."
  },
  "85": {
   "jp": "319b14fc",
   "kr": "미래의 일 같은 걸"
  },
  "86": {
   "jp": "52eb974b",
   "kr": "알면, 편리하겠네."
  },
  "87": {
   "jp": "4a305da1",
   "kr": "단순하다니까."
  },
  "88": {
   "jp": "69004601",
   "kr": "하얀마녀도 쥬리오만큼 단순했다면"
  },
  "89": {
   "jp": "30a431da",
   "kr": "분명, 고민 같은 건 안 했을 거야."
  },
  "90": {
   "jp": "c54759ff",
   "kr": "뭐가?"
  },
  "91": {
   "jp": "77f029eb",
   "kr": "미래를 안다는 건 말이야."
  },
  "92": {
   "jp": "5b1152d9",
   "kr": "알고 싶지도 않은 것도"
  },
  "93": {
   "jp": "58a4b60e",
   "kr": "알아 버린다는 뜻이야."
  },
  "94": {
   "jp": "1ac2d2eb",
   "kr": "알고 싶지도 않은 것?"
  },
  "95": {
   "jp": "03db7e82",
   "kr": "그야"
  },
  "96": {
   "jp": "2558569d",
   "kr": "모르는 편이 나은 일 말이야."
  },
  "97": {
   "jp": "9dc84481",
   "kr": "무슨 소리야?"
  },
  "98": {
   "jp": "414a91b1",
   "kr": "정말, 둔하다니까."
  },
  "99": {
   "jp": "9db217c3",
   "kr": "좋은 일만 있으면 괜찮겠지만."
  },
  "100": {
   "jp": "4f6b6a67",
   "kr": "이를테면 내일 나쁜 일이 일어날 것을"
  },
  "101": {
   "jp": "4d4ca52d",
   "kr": "알고 있었다 해도"
  },
  "102": {
   "jp": "8ee55514",
   "kr": "피할 수 없다면 싫잖아."
  },
  "103": {
   "jp": "478d1f9d",
   "kr": "피할 수 없어?"
  },
  "104": {
   "jp": "b9fe1ea2",
   "kr": "미리 알고 있었다면"
  },
  "105": {
   "jp": "09828829",
   "kr": "피할 수 있지 않을까."
  },
  "106": {
   "jp": "ecfef3c4",
   "kr": "엇, 그런 걸까…?"
  },
  "107": {
   "jp": "6a8a6bfc",
   "kr": "글쎄다. 아마 지금 너희가"
  },
  "108": {
   "jp": "f4ff1c12",
   "kr": "말한 대로, 바꿀 수 있는 것과"
  },
  "109": {
   "jp": "d77a8139",
   "kr": "바꿀 수 없는 것이 있었던 게지."
  },
  "110": {
   "jp": "2fef8e06",
   "kr": "어찌할 수 없는 미래에"
  },
  "111": {
   "jp": "14c0a36c",
   "kr": "괴로워한 적도 있었을 테고."
  },
  "112": {
   "jp": "25c6a3c2",
   "kr": "어떻게 하면 피할 수 있는 것이라도"
  },
  "113": {
   "jp": "6771d529",
   "kr": "남에게 알릴까 알리지 말까 망설이며"
  },
  "114": {
   "jp": "728416e7",
   "kr": "고민한 적도 있었을 게야."
  },
  "115": {
   "jp": "c439e5aa",
   "kr": "어쩔 도리 없는 일로 주저앉는 건"
  },
  "116": {
   "jp": "1b26ae53",
   "kr": "알겠지만, 피할 수 있는 일이라면"
  },
  "117": {
   "jp": "db7aeeec",
   "kr": "알려 주면 되잖아요."
  },
  "118": {
   "jp": "7440fe30",
   "kr": "그러네."
  },
  "119": {
   "jp": "99e47d75",
   "kr": "자네 말이 맞긴 하다만"
  },
  "120": {
   "jp": "5da77fd5",
   "kr": "현실은 그리 안 된다네."
  },
  "121": {
   "jp": "4a9fb75c",
   "kr": "자네 같으면"
  },
  "122": {
   "jp": "0bae57b9",
   "kr": "정말 일어날지 안 일어날지"
  },
  "123": {
   "jp": "966af106",
   "kr": "모를 일을 믿겠나?"
  },
  "124": {
   "jp": "faa79a50",
   "kr": "사람은 자기한테 좋은 얘기라면"
  },
  "125": {
   "jp": "d9766851",
   "kr": "기꺼이 듣지만, 성가신 이야기라면"
  },
  "126": {
   "jp": "3fe826e0",
   "kr": "재수 없다며 화내는 게 고작이란다."
  },
  "127": {
   "jp": "e3902966",
   "kr": "그렇네요."
  },
  "128": {
   "jp": "1e04da6a",
   "kr": "아무리 마녀라도 18살 소녀였단다."
  },
  "129": {
   "jp": "e1c06822",
   "kr": "제 말 한마디로 사람들이 절망하거나"
  },
  "130": {
   "jp": "23381008",
   "kr": "불안해하는 게 견딜 수 없을 때도 있지."
  },
  "131": {
   "jp": "f23b83f8",
   "kr": "미래 같은 건 모르는 게 낫겠어."
  },
  "132": {
   "jp": "35e28579",
   "kr": "쥬리오도 참 이랬다저랬다 한다니까."
  },
  "133": {
   "jp": "1c6ff301",
   "kr": "그치만 방금 그렇게 생각했는걸…"
  },
  "134": {
   "jp": "7d54f74d",
   "kr": "할머니."
  },
  "135": {
   "jp": "0918e5f7",
   "kr": "그래서 하얀마녀 게르드는"
  },
  "136": {
   "jp": "8a27c3c0",
   "kr": "여기서도 뭔가 말을 남겼어요?"
  },
  "137": {
   "jp": "ac8d2c40",
   "kr": "그래, 말했었지."
  },
  "138": {
   "jp": "1da4bf73",
   "kr": "그리고 그대로 되었어."
  },
  "139": {
   "jp": "bb7dda7e",
   "kr": "저 독 늪 얘기야."
  },
  "140": {
   "jp": "c7ff811d",
   "kr": "다이스는 풍요로워지겠지만"
  },
  "141": {
   "jp": "a37013af",
   "kr": "다츠는 이름조차 잊힐 거라고 말이다."
  },
  "142": {
   "jp": "e311527a",
   "kr": "그 빈부의 격차가 독 늪을 낳는다고 했었지."
  },
  "143": {
   "jp": "56ec9e2b",
   "kr": "20년 전엔 독 늪 같은 건 없었어."
  },
  "144": {
   "jp": "323ebac4",
   "kr": "독 늪은 다츠 사람들의 가라앉은"
  },
  "145": {
   "jp": "57ef7b27",
   "kr": "마음이 만들어 낸 것이란다."
  },
  "146": {
   "jp": "6bf7fe08",
   "kr": "마음은 대지와 초목에도 영향을 준단다."
  },
  "147": {
   "jp": "23eaf2b3",
   "kr": "게르드는 그리 말했지."
  },
  "148": {
   "jp": "54179ec5",
   "kr": "현? 글쎄, 어땠으려나."
  },
  "149": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "150": {
   "jp": "82074949",
   "kr": "아, 맞다 맞다. 키타라 현이라면"
  },
  "151": {
   "jp": "4bf1bce8",
   "kr": "아마 작년에 트로바 씨가 집에 들렀을 때"
  },
  "152": {
   "jp": "ca7928e5",
   "kr": "몇 가닥 두고 갔을 게야."
  },
  "153": {
   "jp": "eee42dd0",
   "kr": "이 할미가 그렇게 노망나진 않았단다."
  },
  "154": {
   "jp": "beff05c2",
   "kr": "파피가 갖고 있다고 했잖니?"
  },
  "155": {
   "jp": "07260133",
   "kr": "파피가 맡아 두고 있지 않을까나."
  }
 }
}