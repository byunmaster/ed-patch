  "1": {
   "jp": "960be68b",
   "kr": "밍케"
  },
  "2": {
   "jp": "2d97474e",
   "kr": "무기상 베로네"
  },
  "3": {
   "jp": "d25f6f31",
   "kr": "칸드의 미사"
  },
  "4": {
   "jp": "5cc70478",
   "kr": "어부 토바이"
  },
  "5": {
   "jp": "f1b4790b",
   "kr": "미라"
  },
  "6": {
   "jp": "d5e1de6a",
   "kr": "어부 유타"
  },
  "7": {
   "jp": "081764f0",
   "kr": "라이마"
  },
  "8": {
   "jp": "8d7a004b",
   "kr": "나달 촌장"
  },
  "9": {
   "jp": "06a4b5ec",
   "kr": "벨 부인"
  },
  "10": {
   "jp": "1d79760b",
   "kr": "관리인 파로"
  },
  "11": {
   "jp": "3ce5d520",
   "kr": "어부 라바"
  },
  "12": {
   "jp": "9fd59822",
   "kr": "사리나"
  },
  "13": {
   "jp": "f2deddb8",
   "kr": "여관 덴타"
  },
  "14": {
   "jp": "7c3e2fae",
   "kr": "하본"
  },
  "15": {
   "jp": "3eda6e03",
   "kr": "어부 리크"
  },
  "16": {
   "jp": "4f045262",
   "kr": "어서 오십시오."
  },
  "17": {
   "jp": "4d81a268",
   "kr": "무기를 찾으시는지요?"
  },
  "18": {
   "jp": "dbc31da0",
   "kr": "손님들에게는"
  },
  "19": {
   "jp": "ace49882",
   "kr": "이쯤이 알맞을 듯합니다."
  },
  "20": {
   "jp": "a81e7a27",
   "kr": "받겠습니다."
  },
  "21": {
   "jp": "0fea90dd",
   "kr": "무엇을 사들일까요?"
  },
  "22": {
   "jp": "4b42c90a",
   "kr": "라면"
  },
  "23": {
   "jp": "98210662",
   "kr": "에 사들이겠습니다."
  },
  "24": {
   "jp": "65d811e9",
   "kr": "환전이시죠?"
  },
  "25": {
   "jp": "cbc5c902",
   "kr": "1Goa당 14Pia인데, 괜찮으신가요?"
  },
  "26": {
   "jp": "068d27e4",
   "kr": "을 치르겠습니다."
  },
  "27": {
   "jp": "e81adb75",
   "kr": "라피카가 쌓이면 또 오십시오."
  },
  "28": {
   "jp": "60bf4e0d",
   "kr": "언제든지 사들이겠습니다."
  },
  "29": {
   "jp": "bd08bfed",
   "kr": "그 밖에 무슨 볼일이신지요?"
  },
  "30": {
   "jp": "4122a3f4",
   "kr": "또 들러 주세요."
  },
  "31": {
   "jp": "97d282f2",
   "kr": "손님"
  },
  "32": {
   "jp": "5e6e7ace",
   "kr": "계산대 안에 들어오지 말아 주세요."
  },
  "33": {
   "jp": "6f839a1c",
   "kr": "알데의 칸드에 어서 오세요."
  },
  "34": {
   "jp": "f0b9e74b",
   "kr": "어느 분께 마법을 전수할까요?"
  },
  "35": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "36": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "37": {
   "jp": "3ea86a92",
   "kr": "또 찾아 주세요."
  },
  "38": {
   "jp": "316d154c",
   "kr": "지금 숨바꼭질하고 있어."
  },
  "39": {
   "jp": "ee5c183a",
   "kr": "내가 술래라서 바쁘단 말야."
  },
  "40": {
   "jp": "26cca73f",
   "kr": "그러니까 나중에 놀아 줄게."
  },
  "41": {
   "jp": "98b6b775",
   "kr": "… 뭔가, 분해."
  },
  "42": {
   "jp": "be546963",
   "kr": "뭐여, 너희냐."
  },
  "43": {
   "jp": "bfb4b704",
   "kr": "또 왔냐."
  },
  "44": {
   "jp": "1fde03d2",
   "kr": "안 된다니께."
  },
  "45": {
   "jp": "ce723694",
   "kr": "뭐여가 뭐예요."
  },
  "46": {
   "jp": "f84c1901",
   "kr": "가도의 벼랑이 무너져서"
  },
  "47": {
   "jp": "15e5b239",
   "kr": "아저씨 아버님이 발을 삐어서"
  },
  "48": {
   "jp": "d95bdf84",
   "kr": "곤란해하고 계셨어요."
  },
  "49": {
   "jp": "d4e2b028",
   "kr": "저기, 얼른 도우러 가요."
  },
  "50": {
   "jp": "d0266993",
   "kr": "엇!?"
  },
  "51": {
   "jp": "bc708dd1",
   "kr": "그거, 큰일이여…"
  },
  "52": {
   "jp": "e7a215eb",
   "kr": "이럴 때가 아녀!"
  },
  "53": {
   "jp": "55265eca",
   "kr": "크리스에게서 아버지 일을 들은 토바이는,"
  },
  "54": {
   "jp": "f5cb2182",
   "kr": "만사를 제쳐 두고 집에서 뛰쳐나갔다."
  },
  "55": {
   "jp": "6427e188",
   "kr": "쥬리오 일행도 걱정이 되어 토바이의 뒤를"
  },
  "56": {
   "jp": "73a7454b",
   "kr": "쫓아 벼랑이 무너진 곳까지 가 보기로 했다."
  },
  "57": {
   "jp": "15202d0e",
   "kr": "뭐여, 볼일 있냐?"
  },
  "58": {
   "jp": "30dcd03c",
   "kr": "저기…"
  },
  "59": {
   "jp": "64c36e46",
   "kr": "저희, 네갈섬에 건너가고 싶은데요."
  },
  "60": {
   "jp": "60060e48",
   "kr": "그래서 뭐냐?"
  },
  "61": {
   "jp": "d5444224",
   "kr": "저기… 그래서…"
  },
  "62": {
   "jp": "83ccf473",
   "kr": "응? 안 들리는디."
  },
  "63": {
   "jp": "6e6b9999",
   "kr": "쥬리오는 어부에게 좀 화가 났다."
  },
  "64": {
   "jp": "218b3f8d",
   "kr": "그래도, 역시 무서웠기에"
  },
  "65": {
   "jp": "20a8a799",
   "kr": "크리스가 대신 설명해 주었다."
  },
  "66": {
   "jp": "d3044ecc",
   "kr": "저희, 순례 여행을 하고 있어요."
  },
  "67": {
   "jp": "ce65babe",
   "kr": "네갈섬에 있는 테그라 샤리네에"
  },
  "68": {
   "jp": "edc8b24c",
   "kr": "가고 싶은데요…"
  },
  "69": {
   "jp": "3f9ab1bd",
   "kr": "이 알데 마을에서"
  },
  "70": {
   "jp": "f71b6971",
   "kr": "어부님 배를 얻어 타라고"
  },
  "71": {
   "jp": "fc5a4cdb",
   "kr": "닐리 사람이 알려 줬어요."
  },
  "72": {
   "jp": "f2924246",
   "kr": "호오, 그렇구먼."
  },
  "73": {
   "jp": "58a492c0",
   "kr": "그거 공교롭게 됐구먼."
  },
  "74": {
   "jp": "d2785729",
   "kr": "배는 못 띄우는디."
  },
  "75": {
   "jp": "d132c2ea",
   "kr": "올해는 유빙이 일러서 말이여."
  },
  "76": {
   "jp": "6585ee3f",
   "kr": "유빙만이면 그나마인디"
  },
  "77": {
   "jp": "85184a7f",
   "kr": "갯가를 바다표범한테 뺏겼어."
  },
  "78": {
   "jp": "b06816bf",
   "kr": "우리도 말이여."
  },
  "79": {
   "jp": "80a10926",
   "kr": "고기잡이 배도 못 띄우는 판국이여."
  },
  "80": {
   "jp": "62cf272e",
   "kr": "장사고 뭐고 없당께."
  },
  "81": {
   "jp": "863a9215",
   "kr": "딴 데를 알아봐."
  },
  "82": {
   "jp": "a8d9f9ff",
   "kr": "미안해요."
  },
  "83": {
   "jp": "63621895",
   "kr": "남편이 지금 기분이 안 좋아서요."
  },
  "84": {
   "jp": "b8053637",
   "kr": "아버님은 어디 가셨으려나."
  },
  "85": {
   "jp": "21ca10d2",
   "kr": "아까까진 서성이셨는데."
  },
  "86": {
   "jp": "42470baa",
   "kr": "너희들, 어디 가냐?"
  },
  "87": {
   "jp": "77356d9c",
   "kr": "선착장은 위험혀."
  },
  "88": {
   "jp": "97bdd4ea",
   "kr": "엄청 큰 바다표범이 있당께."
  },
  "89": {
   "jp": "5d615805",
   "kr": "너희 같은 애들은"
  },
  "90": {
   "jp": "bcdef5f9",
   "kr": "잡아먹혀 부러."
  },
  "91": {
   "jp": "d05e7d2f",
   "kr": "안 되야, 안 되야, 저리 가."
  },
  "92": {
   "jp": "12973f4a",
   "kr": "미겔 영감은"
  },
  "93": {
   "jp": "f3af5f8d",
   "kr": "어디 갔으려나."
  },
  "94": {
   "jp": "c43b7b06",
   "kr": "차라도 같이 마실까"
  },
  "95": {
   "jp": "0f56abca",
   "kr": "했더니만."
  },
  "96": {
   "jp": "8cdc958e",
   "kr": "영감, 어디 갔으려나."
  },
  "97": {
   "jp": "5193a353",
   "kr": "라스파의 부탁은 받아들였다."
  },
  "98": {
   "jp": "f81ee718",
   "kr": "다음에 상인이 오면 닐리에 들르도록"
  },
  "99": {
   "jp": "53f7d9c7",
   "kr": "손써 두마."
  },
  "100": {
   "jp": "9b29c0b7",
   "kr": "어찌나 위험한지 원."
  },
  "101": {
   "jp": "253c5a8b",
   "kr": "도저히 배 따위 띄울 형편이 아니야."
  },
  "102": {
   "jp": "9e3c00e6",
   "kr": "다른 마을에서 건널 방법을 생각해 보거라."
  },
  "103": {
   "jp": "2cea5de8",
   "kr": "정말 곤란하구먼."
  },
  "104": {
   "jp": "c89d68fb",
   "kr": "먹을 것도 적은데"
  },
  "105": {
   "jp": "fda95d49",
   "kr": "게다가 바다표범까지 나오다니…"
  },
  "106": {
   "jp": "c05b3406",
   "kr": "어라, 웬일이냐?"
  },
  "107": {
   "jp": "55af3349",
   "kr": "이런, 자네들."
  },
  "108": {
   "jp": "94267a88",
   "kr": "아직 있었나?"
  },
  "109": {
   "jp": "70a0f4c2",
   "kr": "닐리의 촌장님께서"
  },
  "110": {
   "jp": "613ac0ac",
   "kr": "편지를 맡기셨어요."
  },
  "111": {
   "jp": "4c7019db",
   "kr": "에…?"
  },
  "112": {
   "jp": "ed3bfa5e",
   "kr": "닐리 촌장이 보낸 편지라고?"
  },
  "113": {
   "jp": "d65eadf7",
   "kr": "… 불길한 예감이 드는군."
  },
  "114": {
   "jp": "f2d59b04",
   "kr": "그 녀석 일이니"
  },
  "115": {
   "jp": "568a425f",
   "kr": "식량을 보내라든가, 어차피 그런 소리겠지."
  },
  "116": {
   "jp": "0d47c7bf",
   "kr": "이 마을도 빠듯한데 말이다."
  },
  "117": {
   "jp": "b56f0d61",
   "kr": "닐리 사람들은 사람은 좋다만"
  },
  "118": {
   "jp": "8a0b938a",
   "kr": "쟁여 둘 줄을 모른다."
  },
  "119": {
   "jp": "d39f5cfc",
   "kr": "… 안 될 일이지."
  },
  "120": {
   "jp": "2e36c178",
   "kr": "식량 실은 큰 배가 서니까"
  },
  "121": {
   "jp": "a61c567a",
   "kr": "위기감이 모자란 게야."
  },
  "122": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는 "
  },
  "123": {
   "jp": "b5485709",
   "kr": "을(를) 건넸다."
  },
  "124": {
   "jp": "09049957",
   "kr": "흠, 흠, 흠… 과연, 그렇군."
  },
  "125": {
   "jp": "8c2ab6a5",
   "kr": "조금은 마음을 고쳐먹은 모양이군."
  },
  "126": {
   "jp": "8318c448",
   "kr": "상인이 좀 더 닐리에 들르게 해 달라고?"
  },
  "127": {
   "jp": "7949caad",
   "kr": "그쯤이야 어렵지 않은 일이지."
  },
  "128": {
   "jp": "4ac5718d",
   "kr": "아니, 자네들"
  },
  "129": {
   "jp": "5c4348a7",
   "kr": "수고했구먼."
  },
  "130": {
   "jp": "2becee00",
   "kr": "저기, 실례합니다."
  },
  "131": {
   "jp": "50be02cf",
   "kr": "저희 순례 여행을 하는 중인데요,"
  },
  "132": {
   "jp": "bc1d0181",
   "kr": "네갈섬으로 가는 배는 안 뜨나요?"
  },
  "133": {
   "jp": "e1dda8b1",
   "kr": "으〜음, 그게 말이다."
  },
  "134": {
   "jp": "320712ad",
   "kr": "내 걱정거리란다."
  },
  "135": {
   "jp": "7ba6b6d6",
   "kr": "올해는 어째선지 유빙이 일찍 흘러와서."
  },
  "136": {
   "jp": "7eba37d7",
   "kr": "말도 안 되게"
  },
  "137": {
   "jp": "5ca9002c",
   "kr": "유빙을 타고 온 바다표범들이"
  },
  "138": {
   "jp": "3311524c",
   "kr": "마을 둘레 바다에 눌러앉았지."
  },
  "139": {
   "jp": "544a71c8",
   "kr": "갯가에 벌러덩 드러눕질 않나"
  },
  "140": {
   "jp": "e7214e59",
   "kr": "선착장을 둘러싸고 빙글빙글 돌질 않나…"
  },
  "141": {
   "jp": "06419d93",
   "kr": "정말, 큰일이란다."
  },
  "142": {
   "jp": "5d96d589",
   "kr": "바다표범을 쫓아낼 방법이 있다면야."
  },
  "143": {
   "jp": "42af49fe",
   "kr": "순례 여행자들이군요."
  },
  "144": {
   "jp": "333953eb",
   "kr": "지금도 그런 관습이 있다니"
  },
  "145": {
   "jp": "0809de7c",
   "kr": "어쩐지 기뻐요."
  },
  "146": {
   "jp": "c06ea813",
   "kr": "네갈까지 데려다주고 싶지만,"
  },
  "147": {
   "jp": "ee11d964",
   "kr": "바다표범이 막고 있어서 배를 못 띄워요."
  },
  "148": {
   "jp": "5ba15f18",
   "kr": "미안해요."
  },
  "149": {
   "jp": "94ecc270",
   "kr": "아아, 이 창고 말이니?"
  },
  "150": {
   "jp": "ea833c42",
   "kr": "바다 건너 네갈섬에선"
  },
  "151": {
   "jp": "5233f29f",
   "kr": "이탄이 난단다."
  },
  "152": {
   "jp": "af04fe38",
   "kr": "이탄이요?"
  },
  "153": {
   "jp": "0ba6c127",
   "kr": "그래, 이탄이라고 한단다."
  },
  "154": {
   "jp": "95e319bf",
   "kr": "석탄보다 질 낮은 연료인데 그걸 여기에"
  },
  "155": {
   "jp": "fcd4a2f3",
   "kr": "쌓아 두었다가 메나트 전역으로 나르지."
  },
  "156": {
   "jp": "3f0c41c7",
   "kr": "창고에 들어가도 상관없지만"
  },
  "157": {
   "jp": "45d8c2b7",
   "kr": "아무 재미난 것도 없단다."
  },
  "158": {
   "jp": "4844c206",
   "kr": "이건 비밀인디"
  },
  "159": {
   "jp": "e071a2f1",
   "kr": "난 하얀마녀의 예언을 믿고,"
  },
  "160": {
   "jp": "11e1c7df",
   "kr": "보리를 길렀당께."
  },
  "161": {
   "jp": "fba2ecf4",
   "kr": "앗, 말해 부렀네…"
  },
  "162": {
   "jp": "9d901f9f",
   "kr": "근디 말이여, 그 덕에 그럭저럭"
  },
  "163": {
   "jp": "9d864d20",
   "kr": "입에 풀칠하고 산당께."
  },
  "164": {
   "jp": "6c15237e",
   "kr": "이 마을 수입원은,"
  },
  "165": {
   "jp": "d3e5accb",
   "kr": "네갈에서 오는 이탄 운송과"
  },
  "166": {
   "jp": "e5ee3aa2",
   "kr": "생선뿐잉께."
  },
  "167": {
   "jp": "ad650e88",
   "kr": "준비가 있으면,"
  },
  "168": {
   "jp": "7ccbf38f",
   "kr": "어쩌고, 아니겄어."
  },
  "169": {
   "jp": "6dfadb34",
   "kr": "어머, 순례 여행자들이에요?"
  },
  "170": {
   "jp": "46197fc6",
   "kr": "하필 안 좋을 때 왔네요."
  },
  "171": {
   "jp": "1dd041df",
   "kr": "치타로 가는 길은 벼랑이 무너져 막혔대요."
  },
  "172": {
   "jp": "3d23c608",
   "kr": "지금은 바다표범 탓에 배도 못 띄우고"
  },
  "173": {
   "jp": "724bf4e2",
   "kr": "치타 길도 안 되면, 난처하게 됐네요."
  },
  "174": {
   "jp": "2ac4596c",
   "kr": "바다표범의 먹이라도 있으면"
  },
  "175": {
   "jp": "1d1d0258",
   "kr": "어떻게든 될지도 모르는데 말이죠."
  },
  "176": {
   "jp": "30a2053c",
   "kr": "미안하구나. 지금은 방이 다 찼단다."
  },
  "177": {
   "jp": "0f15548b",
   "kr": "치타에서 온 여행자가 묵고 있고"
  },
  "178": {
   "jp": "461b91d5",
   "kr": "떠돌이 상인이 곧 올 참이거든."
  },
  "179": {
   "jp": "3af37095",
   "kr": "미안하구나."
  },
  "180": {
   "jp": "2d038c7e",
   "kr": "괜찮다면"
  },
  "181": {
   "jp": "377b663b",
   "kr": "로비에서 쉬다 가려무나."
  },
  "182": {
   "jp": "073b1d00",
   "kr": "이야, 나는 치타에서 왔는데"
  },
  "183": {
   "jp": "80dc12c1",
   "kr": "역시 메나트는 어디나 가난해서"
  },
  "184": {
   "jp": "d54295c5",
   "kr": "큰일이구나."
  },
  "185": {
   "jp": "cb4d6b1e",
   "kr": "힘든 건 치타만이 아니란 걸"
  },
  "186": {
   "jp": "ce2221ec",
   "kr": "잘 알았어."
  },
  "187": {
   "jp": "57c7cad9",
   "kr": "그래도, 어쩌지…"
  },
  "188": {
   "jp": "25694f91",
   "kr": "가도에 벼랑이 무너져서"
  },
  "189": {
   "jp": "737ff220",
   "kr": "치타로 가는 길이 막혔어."
  },
  "190": {
   "jp": "754bb91e",
   "kr": "난처하군…"
  },
  "191": {
   "jp": "52175f42",
   "kr": "여기 올 때 벼랑 무너진 데서"
  },
  "192": {
   "jp": "de70a836",
   "kr": "영감을 만났는데,"
  },
  "193": {
   "jp": "a1ca826e",
   "kr": "이 마을 사람이려나…"
  },
  "194": {
   "jp": "bbfbcfa7",
   "kr": "내 배가 바다표범 탓에"
  },
  "195": {
   "jp": "925d7846",
   "kr": "가라앉아 부렀어어."
  }
 }
}