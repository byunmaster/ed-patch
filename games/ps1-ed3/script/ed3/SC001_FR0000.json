{
 "archive": "/SCE0/SC001.DAT",
 "member": "..\\DATA\\FR0000.BIN",
 "lines": {
  "0": {
   "jp": "d2cc7c22",
   "kr": "초록 고원"
  },
  "1": {
   "jp": "fcea3f33",
   "kr": "엘포"
  },
  "2": {
   "jp": "d3d3a49a",
   "kr": "시논"
  },
  "3": {
   "jp": "27e4ad4e",
   "kr": "시아라"
  },
  "4": {
   "jp": "7f285a98",
   "kr": "누가 오는데."
  },
  "5": {
   "jp": "a3231a73",
   "kr": "… 여행자인가?"
  },
  "6": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "7": {
   "jp": "f5132947",
   "kr": "보아하니"
  },
  "8": {
   "jp": "dca966cf",
   "kr": "순례하시는 분이군요."
  },
  "9": {
   "jp": "f54ff94b",
   "kr": "라그픽 마을의 라프 씨를 뵙고 싶어서"
  },
  "10": {
   "jp": "1fe9e5f3",
   "kr": "가족이 다 함께 앰비쉬에서 왔답니다."
  },
  "11": {
   "jp": "8071d517",
   "kr": "라프 할아버지요?"
  },
  "12": {
   "jp": "a7488253",
   "kr": "이런."
  },
  "13": {
   "jp": "d89c9393",
   "kr": "라프 씨를 아시나요?"
  },
  "14": {
   "jp": "c0369ca4",
   "kr": "네, 물론 알아요."
  },
  "15": {
   "jp": "078b8ca9",
   "kr": "라그픽 마을에선 촌장님보다 연로하신걸요."
  },
  "16": {
   "jp": "5e168737",
   "kr": "저… 무슨 폐라도 끼쳤나요?"
  },
  "17": {
   "jp": "b8cdd209",
   "kr": "당치도 않아요!"
  },
  "18": {
   "jp": "8632b48c",
   "kr": "저희는 아주 오래전에 라프 씨께"
  },
  "19": {
   "jp": "b1d491e1",
   "kr": "도움을 받았거든요."
  },
  "20": {
   "jp": "6e99c4cf",
   "kr": "이렇게 아이도 여행할 나이가 되어서"
  },
  "21": {
   "jp": "805dbcaa",
   "kr": "라프 씨를 찾아뵙기로 한 거예요."
  },
  "22": {
   "jp": "ddf7fc0c",
   "kr": "도움을 받았다고요?"
  },
  "23": {
   "jp": "9792eb26",
   "kr": "사람을 잘못 보셨나 봐요."
  },
  "24": {
   "jp": "a5e548ed",
   "kr": "폴티아 제일가는"
  },
  "25": {
   "jp": "de65e8e9",
   "kr": "대마법사인 라프 씨 말이에요."
  },
  "26": {
   "jp": "46f0b8a0",
   "kr": "잘못 볼 사람은 없죠."
  },
  "27": {
   "jp": "55fea988",
   "kr": "대마법사요?"
  },
  "28": {
   "jp": "79f9ccce",
   "kr": "어머, 몰랐어요?"
  },
  "29": {
   "jp": "02c6a6c0",
   "kr": "정말이에요?"
  },
  "30": {
   "jp": "c962ac33",
   "kr": "정말이고 뭐고, 돌아보면 10년 전이에요."
  },
  "31": {
   "jp": "6e166fde",
   "kr": "그때 라프 씨가 늑대 무리를 쫓아내 주지"
  },
  "32": {
   "jp": "9a8229c0",
   "kr": "않았다면 저희는 무사하지 못했을 거예요."
  },
  "33": {
   "jp": "0f7ea686",
   "kr": "당연히 이 아이도 태어나지 못했겠죠."
  },
  "34": {
   "jp": "b40ee023",
   "kr": "저희 가족의 오늘이 있는 건"
  },
  "35": {
   "jp": "cbabfa21",
   "kr": "전부 라프 씨 덕분이랍니다."
  },
  "36": {
   "jp": "7e0bcd5d",
   "kr": "어머."
  },
  "37": {
   "jp": "3133bf2f",
   "kr": "아가씨가 든 그 지팡이는?"
  },
  "38": {
   "jp": "71820ddc",
   "kr": "라프 할아버지한테 받았어요."
  },
  "39": {
   "jp": "c28fab0f",
   "kr": "그거 대단하군요!"
  },
  "40": {
   "jp": "cff93e45",
   "kr": "아가씨, 어지간히 라프 씨"
  },
  "41": {
   "jp": "0bb650c0",
   "kr": "눈에 들었나 보네요."
  },
  "42": {
   "jp": "2fc709e1",
   "kr": "엇…"
  },
  "43": {
   "jp": "53a100b8",
   "kr": "분명 그 지팡이는"
  },
  "44": {
   "jp": "eb40385a",
   "kr": "대마법사인 라프 씨가"
  },
  "45": {
   "jp": "508b2f1d",
   "kr": "그때 들고 있던 지팡이예요."
  },
  "46": {
   "jp": "40002114",
   "kr": "저기, 아빠."
  },
  "47": {
   "jp": "f9c002b1",
   "kr": "빨리 대마법사"
  },
  "48": {
   "jp": "817de5d7",
   "kr": "라프 씨 만나러 가자!"
  },
  "49": {
   "jp": "be40820c",
   "kr": "오오, 그래야지."
  },
  "50": {
   "jp": "8b3d7617",
   "kr": "아 참."
  },
  "51": {
   "jp": "7bf73526",
   "kr": "이 앞 왕도 가도로 빠지는 루데라 관문에"
  },
  "52": {
   "jp": "71e0768c",
   "kr": "사나운 병사가 잔뜩 있었으니 조심해요."
  },
  "53": {
   "jp": "ceb5787d",
   "kr": "먼저 디네로 가는 거죠?"
  },
  "54": {
   "jp": "8c281291",
   "kr": "그럼 왕도 가도는 지나지 않으니 안심이네요."
  },
  "55": {
   "jp": "4b8c1435",
   "kr": "두 사람의 순례 여행이 알찬 여행이 되기를!"
  },
  "56": {
   "jp": "b92bea59",
   "kr": "그럼, 안녕히."
  },
  "57": {
   "jp": "bea3dff3",
   "kr": "또 봐요!"
  },
  "58": {
   "jp": "185ca6f1",
   "kr": "라프 할아버지가"
  },
  "59": {
   "jp": "029afad9",
   "kr": "마법 쓰는 건 여태껏"
  },
  "60": {
   "jp": "7bd159dd",
   "kr": "본 적이 없어."
  },
  "61": {
   "jp": "9f4ef5d4",
   "kr": "사람은 겉만 봐선 모른다지만…"
  },
  "62": {
   "jp": "74f38a9b",
   "kr": "분명 뭔가 착각일 거야."
  },
  "63": {
   "jp": "35ed34fb",
   "kr": "응. 나도 그래."
  }
 }
}