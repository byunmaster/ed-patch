{
 "archive": "/SCE5/SC504.DAT",
 "member": "..\\DATA\\ST0101.BIN",
 "lines": {
  "0": {
   "jp": "57e30d30",
   "kr": "홀크"
  },
  "1": {
   "jp": "f98f24bc",
   "kr": "에니 할머니"
  },
  "2": {
   "jp": "7144f143",
   "kr": "마지오 장로"
  },
  "3": {
   "jp": "c2dc8996",
   "kr": "칸드의 쟝"
  },
  "4": {
   "jp": "008bd540",
   "kr": "슈노"
  },
  "5": {
   "jp": "60167348",
   "kr": "사나"
  },
  "6": {
   "jp": "c3f56eb1",
   "kr": "앗티"
  },
  "7": {
   "jp": "c8cfe2ee",
   "kr": "그쪽은 루피나스 호수 요새가 있는 쪽이야."
  },
  "8": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "9": {
   "jp": "a56689cc",
   "kr": "우린 서둘러 폴티아로 돌아가야 해."
  },
  "10": {
   "jp": "d5e3a9d8",
   "kr": "얼른 가자."
  },
  "11": {
   "jp": "6ddcab48",
   "kr": "이제야 두 왕도"
  },
  "12": {
   "jp": "2c0195b8",
   "kr": "고인이 된 여왕의 뜻을 헤아려"
  },
  "13": {
   "jp": "b9fc6e12",
   "kr": "사이좋게 다스릴 마음이 든 모양이구나."
  },
  "14": {
   "jp": "311098b8",
   "kr": "그 아이가 말한 대로였구먼…"
  },
  "15": {
   "jp": "4f8132af",
   "kr": "말한 그대로라뇨?"
  },
  "16": {
   "jp": "b146ceac",
   "kr": "예전에…"
  },
  "17": {
   "jp": "4209a889",
   "kr": "벌써 20년쯤 전이 되려나…"
  },
  "18": {
   "jp": "3a92eca4",
   "kr": "하얀마녀가"
  },
  "19": {
   "jp": "ed892be6",
   "kr": "이곳을 찾았을 때 하신 말씀이지."
  },
  "20": {
   "jp": "664c38a8",
   "kr": "『어미가 피를 나눔은 나라 가름이 아니다』"
  },
  "21": {
   "jp": "1164151a",
   "kr": "하얀마녀는 그렇게 말했단다."
  },
  "22": {
   "jp": "aed4bf57",
   "kr": "마법은 몸을 지키기 위해 써 주세요."
  },
  "23": {
   "jp": "f8ffb1d7",
   "kr": "숲의 동물을 괴롭히거나 하면 안 돼요."
  },
  "24": {
   "jp": "764d4c9b",
   "kr": "다루실 분이 계시면"
  },
  "25": {
   "jp": "32bd9a92",
   "kr": "칸드 마법을 가르쳐 드리죠."
  },
  "26": {
   "jp": "e05b07d9",
   "kr": "어느 분께 가르쳐 드릴까요?"
  },
  "27": {
   "jp": "27c29648",
   "kr": "어느 마법을 익히시겠어요?"
  },
  "28": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "29": {
   "jp": "f7f576a8",
   "kr": "제가 필요해지시면"
  },
  "30": {
   "jp": "c61fc2a3",
   "kr": "언제든 들러 주세요."
  },
  "31": {
   "jp": "9f71bff8",
   "kr": "한때는 정말로 남북이 전쟁하려나 싶었어."
  },
  "32": {
   "jp": "136accbe",
   "kr": "아무 일 없이 무사히 끝나서 다행이야."
  },
  "33": {
   "jp": "cccd497b",
   "kr": "그 수상쩍은 여행자"
  },
  "34": {
   "jp": "d40d8d57",
   "kr": "베라트라고 한다지요."
  },
  "35": {
   "jp": "cfa7482f",
   "kr": "그렇군요, 달아났나요."
  },
  "36": {
   "jp": "e16e8c8c",
   "kr": "또 어딘가에서 못된 짓을 할 셈일까요."
  },
  "37": {
   "jp": "07a7def7",
   "kr": "정말이지, 저런 여행자는 민폐예요."
  },
  "38": {
   "jp": "02ed396b",
   "kr": "가도를 막고 있던 건"
  },
  "39": {
   "jp": "c052a64d",
   "kr": "베라트의 음모였구나."
  },
  "40": {
   "jp": "e92bc299",
   "kr": "남북 교류를 끊어서"
  },
  "41": {
   "jp": "59862083",
   "kr": "서로의 불안을 키우려"
  },
  "42": {
   "jp": "82cfd179",
   "kr": "했던 건가…"
  },
  "43": {
   "jp": "2ced6943",
   "kr": "교활한 놈이군."
  }
 }
}