{
 "archive": "/SCE8/SC808.DAT",
 "member": "..\\DATA\\RC6010.BIN",
 "lines": {
  "0": {
   "jp": "4651181e",
   "kr": "이자벨의 탑"
  },
  "1": {
   "jp": "672bb2b9",
   "kr": "천의실"
  },
  "2": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "3": {
   "jp": "b1e142be",
   "kr": "바다트"
  },
  "4": {
   "jp": "f3b780af",
   "kr": "해냈다!"
  },
  "5": {
   "jp": "a9139f82",
   "kr": "좋아, 다음은 쥬리오다."
  },
  "6": {
   "jp": "fd044846",
   "kr": "은단검으로 천구의를 노려라."
  },
  "7": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "8": {
   "jp": "c70457d8",
   "kr": "빗맞히지 마."
  },
  "9": {
   "jp": "a83db129",
   "kr": "으, 응…"
  },
  "10": {
   "jp": "a583f5dd",
   "kr": "얍!"
  },
  "11": {
   "jp": "6d4d6da9",
   "kr": "방금 건 뭐야?"
  },
  "12": {
   "jp": "aaa1e8ef",
   "kr": "천구의에 갇혀 있던 혼입니다."
  },
  "13": {
   "jp": "bb705e18",
   "kr": "탄식의 상념과 함께 풀려난 겁니다."
  },
  "14": {
   "jp": "0b7d33a4",
   "kr": "그럼 이제, 루돌프 왕이랑"
  },
  "15": {
   "jp": "fac4f550",
   "kr": "국경으로 간 표정 없는 병사들도"
  },
  "16": {
   "jp": "092c7b6a",
   "kr": "원래대로 돌아오는 거네."
  },
  "17": {
   "jp": "839f11da",
   "kr": "우선은"
  },
  "18": {
   "jp": "4083110a",
   "kr": "사람들을 제정신으로 돌리는 데는"
  },
  "19": {
   "jp": "df698216",
   "kr": "성공한 듯합니다."
  },
  "20": {
   "jp": "d3265cdd",
   "kr": "허크의 목소리"
  },
  "21": {
   "jp": "442d4d29",
   "kr": "이런!"
  },
  "22": {
   "jp": "dc993994",
   "kr": "이런… 늦었나!"
  },
  "23": {
   "jp": "9e3702db",
   "kr": "엇?!"
  },
  "24": {
   "jp": "b0b9ae40",
   "kr": "삼촌!"
  },
  "25": {
   "jp": "3c4394ae",
   "kr": "바다트."
  },
  "26": {
   "jp": "a0e5b603",
   "kr": "실례."
  },
  "27": {
   "jp": "0d5f2cb2",
   "kr": "벌써 이 안은 비었네."
  },
  "28": {
   "jp": "5e5aab85",
   "kr": "으, 응."
  },
  "29": {
   "jp": "1ccbf3ab",
   "kr": "우리"
  },
  "30": {
   "jp": "acededd6",
   "kr": "삼촌이 전한 대로 했어."
  },
  "31": {
   "jp": "3aa22763",
   "kr": "표면에 붙어 있던 걸 떼어 내고서"
  },
  "32": {
   "jp": "175c9eed",
   "kr": "은단검을 찔러 넣었어요."
  },
  "33": {
   "jp": "2b8514cf",
   "kr": "그래, 그건 괜찮은데…"
  },
  "34": {
   "jp": "566f27a4",
   "kr": "기드나의 유적에서 라우알의 파도에 대해"
  },
  "35": {
   "jp": "e77c7ffd",
   "kr": "새로운 사실을 알아냈어."
  },
  "36": {
   "jp": "238d723c",
   "kr": "새로운 사실이란?"
  },
  "37": {
   "jp": "402b83bb",
   "kr": "천구의가 남아 있었다면"
  },
  "38": {
   "jp": "ed85d5ff",
   "kr": "다른 방법도 있었는데…"
  },
  "39": {
   "jp": "011f2afb",
   "kr": "아니, 그건 이따 말할게."
  },
  "40": {
   "jp": "7e16df91",
   "kr": "그보다, 서둘러."
  },
  "41": {
   "jp": "f359c943",
   "kr": "라우알의 파도를 부르는 힘은,"
  },
  "42": {
   "jp": "6dc56f05",
   "kr": "아직 이어지고 있어."
  },
  "43": {
   "jp": "6bb5f5b2",
   "kr": "왕비다."
  },
  "44": {
   "jp": "dfc8b886",
   "kr": "이자벨 왕비가"
  },
  "45": {
   "jp": "a586f9f8",
   "kr": "아직 어딘가에 있을 거다."
  },
  "46": {
   "jp": "3567034d",
   "kr": "의식의 성격상"
  },
  "47": {
   "jp": "c6bd9134",
   "kr": "이 장소에서"
  },
  "48": {
   "jp": "f2194c56",
   "kr": "그리 멀지 않을 겁니다."
  },
  "49": {
   "jp": "8c5a2963",
   "kr": "천구의에서 너무"
  },
  "50": {
   "jp": "35c3ca4a",
   "kr": "멀리 떨어지면"
  },
  "51": {
   "jp": "447b2a9b",
   "kr": "염파가 닿지 않으니까요."
  },
  "52": {
   "jp": "e0d799bb",
   "kr": "찾아봐요."
  },
  "53": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "54": {
   "jp": "171d8a97",
   "kr": "쥬리오 일행은 파티를 짰다."
  },
  "55": {
   "jp": "e1ab7037",
   "kr": "나눠서 왕비를 찾아라."
  },
  "56": {
   "jp": "ae7c9ba2",
   "kr": "어떻게든,"
  },
  "57": {
   "jp": "bac5ec93",
   "kr": "이 세계에 라우알의 파도가 오는 것을"
  },
  "58": {
   "jp": "d492b63a",
   "kr": "막아야만 한다."
  },
  "59": {
   "jp": "69063ad6",
   "kr": "왕비는 어디선가"
  },
  "60": {
   "jp": "73f2f65a",
   "kr": "라우알의 파도를 부르는 술법을"
  },
  "61": {
   "jp": "b6a8534d",
   "kr": "계속하고 있겠지."
  },
  "62": {
   "jp": "6d300fa7",
   "kr": "어쨌든"
  },
  "63": {
   "jp": "207417d2",
   "kr": "그걸 멈추게 하지 않고서는…"
  },
  "64": {
   "jp": "cfa96c2e",
   "kr": "그 왕비를 먼저 찾아야 하네."
  },
  "65": {
   "jp": "0885d94a",
   "kr": "한시도 지체할 수 없습니다."
  },
  "66": {
   "jp": "48fd68ff",
   "kr": "듀르젤 씨."
  },
  "67": {
   "jp": "cd5d14bf",
   "kr": "이 일이 잘 끝나면 부탁이 있어."
  },
  "68": {
   "jp": "1c5d4d64",
   "kr": "들어주겠어?"
  },
  "69": {
   "jp": "6c6cbf52",
   "kr": "그래 네가 살아 있으면 들어주지."
  },
  "70": {
   "jp": "efe3adcb",
   "kr": "그럼 살아남지."
  },
  "71": {
   "jp": "feb579b0",
   "kr": "자, 왕비를 찾아내서"
  },
  "72": {
   "jp": "8b7ca3d6",
   "kr": "어서 결판을 내자고."
  },
  "73": {
   "jp": "3cd4a094",
   "kr": "난 정했어."
  },
  "74": {
   "jp": "34a56f7d",
   "kr": "나중에 루돌프 왕에게 상금을 청구해 주지."
  },
  "75": {
   "jp": "fe0392b1",
   "kr": "3000만 Pia쯤은 받아야겠어."
  },
  "76": {
   "jp": "eef1adc0",
   "kr": "수지가 안 맞는다고."
  },
  "77": {
   "jp": "1017d4a2",
   "kr": "정말이지"
  },
  "78": {
   "jp": "8287f1d5",
   "kr": "너희랑 같이 있으면"
  },
  "79": {
   "jp": "667d845b",
   "kr": "재난뿐이라니까."
  },
  "80": {
   "jp": "70439fdb",
   "kr": "하늘 색이"
  },
  "81": {
   "jp": "787edf87",
   "kr": "꽤 수상하게 변해 가는군."
  },
  "82": {
   "jp": "3ae3fa1a",
   "kr": "이대로는 위험하겠는데."
  },
  "83": {
   "jp": "5cb7b581",
   "kr": "천구의는 완전히 부서졌다."
  },
  "84": {
   "jp": "ed570765",
   "kr": "탄식의 상념이 안 느껴진다."
  }
 }
}