  },
  "13": {
   "jp": "45f0173d",
   "kr": "트로바 씨!"
  },
  "14": {
   "jp": "56d585d5",
   "kr": "크로와 할머니 집에"
  },
  "15": {
   "jp": "efb01a24",
   "kr": "현이 딱 한 가닥 있었어요!"
  },
  "16": {
   "jp": "add0e526",
   "kr": "이제… 됐습니다."
  },
  "17": {
   "jp": "d8c3e7a1",
   "kr": "저는 못 하겠습니다."
  },
  "18": {
   "jp": "3ad43b07",
   "kr": "어째서요!?"
  },
  "19": {
   "jp": "5061974b",
   "kr": "다들, 트로바 씨 연주를"
  },
  "20": {
   "jp": "207323e5",
   "kr": "기다린다고요!"
  },
  "21": {
   "jp": "4a867b64",
   "kr": "…무섭습니다."
  },
  "22": {
   "jp": "f07cd1b2",
   "kr": "또 현이 끊어지면 다츠 사람들은"
  },
  "23": {
   "jp": "4f18341b",
   "kr": "못 일어섭니다."
  },
  "24": {
   "jp": "704034cd",
   "kr": "응석 부리지 마라!!"
  },
  "25": {
   "jp": "0edda951",
   "kr": "끊어졌으면 다시 하면 되잖아!"
  },
  "26": {
   "jp": "e920d86e",
   "kr": "일어설 때까지 몇 번이고 연주하면 된다!!"
  },
  "27": {
   "jp": "656ad641",
   "kr": "여기가 다츠 마을이다!"
  },
  "28": {
   "jp": "f63037bc",
   "kr": "여기를 다시 세울 수밖에 없잖아!"
  },
  "29": {
   "jp": "5fbc54f6",
   "kr": "…다들 살아가고 있다."
  },
  "30": {
   "jp": "f8e61eaf",
   "kr": "그것만으로 훌륭한 마을이다!"
  },
  "31": {
   "jp": "8dbecc80",
   "kr": "로디 씨는 말이야,"
  },
  "32": {
   "jp": "08c2e881",
   "kr": "쓸데없는 소리 마라."
  },
  "33": {
   "jp": "3dd47390",
   "kr": "아니, 말할래!"
  },
  "34": {
   "jp": "5df25d97",
   "kr": "로디 씨는 네갈섬 사람이에요."
  },
  "35": {
   "jp": "5d94d3e8",
   "kr": "네갈섬 소문은 들었습니다…"
  },
  "36": {
   "jp": "6aaffcb6",
   "kr": "트로바 씨."
  },
  "37": {
   "jp": "daa756b4",
   "kr": "한 번만 더 부탁드립니다."
  },
  "38": {
   "jp": "8bd26155",
   "kr": "이 마을은 가루가에게 부서진 것이 아닙니다."
  },
  "39": {
   "jp": "51dc0ef6",
   "kr": "모든 건 한 사람 한 사람의 마음 문제."
  },
  "40": {
   "jp": "a3797275",
   "kr": "부디 힘을 주십시오."
  },
  "41": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "42": {
   "jp": "5b06546b",
   "kr": "제가 약해지면 안 되겠지요."
  },
  "43": {
   "jp": "55b63593",
   "kr": "현을 빌려주세요."
  },
  "44": {
   "jp": "45f0173d",
   "kr": "트로바 씨!"
  },
  "45": {
   "jp": "598f5314",
   "kr": "잘됐다!"
  },
  "46": {
   "jp": "911bf418",
   "kr": "트로바는 익숙하게 현을 갈아 끼웠다."
  },
  "47": {
   "jp": "d0dcea38",
   "kr": "정말 고맙습니다, 여러분."
  },
  "48": {
   "jp": "25d42a83",
   "kr": "한 번 더, 아니."
  },
  "49": {
   "jp": "84671376",
   "kr": "마을이 일어설 때까지 계속 연주하겠습니다."
  },
  "50": {
   "jp": "58009f66",
   "kr": "트로바는 두어 번 현을 튕기더니"
  },
  "51": {
   "jp": "50a9898b",
   "kr": "정신없이 키타라를 연주했다."
  },
  "52": {
   "jp": "5f4ca79d",
   "kr": "트로바아〜!!"
  },
  "53": {
   "jp": "8cf19ee2",
   "kr": "걱정 끼쳤구나, 안지."
  },
  "54": {
   "jp": "03102340",
   "kr": "이제 난 괜찮아."
  },
  "55": {
   "jp": "d6588323",
   "kr": "자, 자신 있는 춤을 보여 주렴."
  },
  "56": {
   "jp": "9b20da62",
   "kr": "네!"
  },
  "57": {
   "jp": "fcc4cf4c",
   "kr": "훌륭한 연주였네."
  },
  "58": {
   "jp": "10d045c3",
   "kr": "흥이 넘쳤네!"
  },
  "59": {
   "jp": "8cb23e8b",
   "kr": "어떤가, 다들."
  },
  "60": {
   "jp": "19a37e31",
   "kr": "이제 오늘부터 힘낼 수 있겠지!"
  },
  "61": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "62": {
   "jp": "ff610483",
   "kr": "이제 빈민굴 소리는"
  },
  "63": {
   "jp": "b001544d",
   "kr": "안 듣는다!"
  },
  "64": {
   "jp": "fdea63a1",
   "kr": "물론이죠!"
  },
  "65": {
   "jp": "a9026419",
   "kr": "다리도 완전히 나았구먼!"
  },
  "66": {
   "jp": "38032fd5",
   "kr": "트로바!"
  },
  "67": {
   "jp": "6649cbdf",
   "kr": "최고였다!"
  },
  "68": {
   "jp": "9fa8fee7",
   "kr": "…다행이다."
  },
  "69": {
   "jp": "a61c1d0f",
   "kr": "정말 다행이다."
  },
  "70": {
   "jp": "03d09d2a",
   "kr": "트로바의 연주로 기운을 되찾은 다츠 사람들."
