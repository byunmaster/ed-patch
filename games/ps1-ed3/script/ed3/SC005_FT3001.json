{
 "archive": "/SCE0/SC005.DAT",
 "member": "..\\DATA\\FT3001.BIN",
 "lines": {
  "0": {
   "jp": "c9fab11d",
   "kr": "매발톱호"
  },
  "1": {
   "jp": "0f879f86",
   "kr": "보스레이"
  },
  "2": {
   "jp": "87ed524e",
   "kr": "가톤"
  },
  "3": {
   "jp": "c1b14629",
   "kr": "브루트"
  },
  "4": {
   "jp": "73e57527",
   "kr": "질버 선장"
  },
  "5": {
   "jp": "898074d7",
   "kr": "조리장"
  },
  "6": {
   "jp": "85752cb7",
   "kr": "그럼, 쥬리오."
  },
  "7": {
   "jp": "983013c0",
   "kr": "선실 청소부터 해 주겠냐?"
  },
  "8": {
   "jp": "62d8b644",
   "kr": "전부 여덟 개의 방이 있으니까."
  },
  "9": {
   "jp": "3ecf5107",
   "kr": "대부분의 손님이"
  },
  "10": {
   "jp": "5a5019f8",
   "kr": "방에서 쉬고 있을 테니까"
  },
  "11": {
   "jp": "98fd2f11",
   "kr": "실례가 없도록 부탁한다."
  },
  "12": {
   "jp": "52156d12",
   "kr": "아, 그리고 선창은 청소 안 해도 돼."
  },
  "13": {
   "jp": "c9144d30",
   "kr": "《항해일지 1일째》"
  },
  "14": {
   "jp": "194ad047",
   "kr": "드디어 올해 항해도 이것으로 끝이다."
  },
  "15": {
   "jp": "f7aadf94",
   "kr": "유빙의 계절이 다가오고 있다."
  },
  "16": {
   "jp": "ffbaf2a4",
   "kr": "닐리에서 돌아 라그나로 가면 겨울 휴가다."
  },
  "17": {
   "jp": "4d59ffce",
   "kr": "올해 마지막 항해에 어울리는 손님이 탔다."
  },
  "18": {
   "jp": "0fb6f98d",
   "kr": "순례 여행자 쥬리오 군과 크리스 양이다."
  },
  "19": {
   "jp": "aa865a89",
   "kr": "이번 항해도 멋지게 해내겠다."
  },
  "20": {
   "jp": "ed17de12",
   "kr": "《티라스일 항해도》"
  },
  "21": {
   "jp": "2f648113",
   "kr": "티라스일 지도다."
  },
  "22": {
   "jp": "8a24e802",
   "kr": "각국 이름과 항구 위치, 항로 등이"
  },
  "23": {
   "jp": "54f424cf",
   "kr": "빽빽이 적혀 있다."
  },
  "24": {
   "jp": "8c3168ef",
   "kr": "우리 집은 안 나오네."
  },
  "25": {
   "jp": "baf2adc5",
   "kr": "크리스 아가씨."
  },
  "26": {
   "jp": "e4fbd94e",
   "kr": "이쪽 맛 좀 봐 주겠니?"
  },
  "27": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "28": {
   "jp": "052fe8ef",
   "kr": "음〜"
  },
  "29": {
   "jp": "bdb8ec31",
   "kr": "저기, 후추를 더"
  },
  "30": {
   "jp": "c74db820",
   "kr": "넣어 봐요."
  },
  "31": {
   "jp": "f41de3da",
   "kr": "앗! 안 된다."
  },
  "32": {
   "jp": "720981da",
   "kr": "그렇게 넣으면 못쓴다〜"
  },
  "33": {
   "jp": "850dae09",
   "kr": "이게 맛있는 거예요."
  },
  "34": {
   "jp": "7117dcc9",
   "kr": "아〜아…"
  },
  "35": {
   "jp": "12ba1752",
   "kr": "뭐야."
  },
  "36": {
   "jp": "06c0bc5c",
   "kr": "뭐 불만 있어?"
  },
  "37": {
   "jp": "70354164",
   "kr": "……"
  },
  "38": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "39": {
   "jp": "68543f7b",
   "kr": "방해되니까 저쪽으로 가!"
  },
  "40": {
   "jp": "57b843d3",
   "kr": "오오, 쥬리오 군."
  },
  "41": {
   "jp": "42038731",
   "kr": "벌써 일해 주고 있는 모양이구나."
  },
  "42": {
   "jp": "5318a2c3",
   "kr": "여기도 청소해 주려는 건가?"
  },
  "43": {
   "jp": "e829e06e",
   "kr": "선장실이라면 괜찮다."
  },
  "44": {
   "jp": "4cfe8d93",
   "kr": "여기는 내가 제대로 정돈하고 있으니까."
  },
  "45": {
   "jp": "c0a40515",
   "kr": "선장 된 자는 뱃사람의 귀감이어야 하지."
  },
  "46": {
   "jp": "36005b9a",
   "kr": "지금 항해일지를 다 적은 참이다."
  },
  "47": {
   "jp": "764fd4bf",
   "kr": "자네들 얘기도 적어 두었지."
  },
  "48": {
   "jp": "d462f904",
   "kr": "선장 일에 관심이 있다면"
  },
  "49": {
   "jp": "7f21fbc9",
   "kr": "항해일지를 읽어도 상관없다."
  },
  "50": {
   "jp": "5f6326b5",
   "kr": "나도 크리스 양의 요리를 먹어 보았다."
  },
  "51": {
   "jp": "167d1735",
   "kr": "그, 뭐랄까…"
  },
  "52": {
   "jp": "b849f208",
   "kr": "독특한 맛이더군."
  },
  "53": {
   "jp": "dd31c718",
   "kr": "너무 힘내다가"
  },
  "54": {
   "jp": "d860def0",
   "kr": "무리하지 않도록 해라."
  },
  "55": {
   "jp": "9bd10f6a",
   "kr": "쥬리오 군"
  },
  "56": {
   "jp": "619b36e0",
   "kr": "주방은 늘 깨끗이 해 두니까"
  },
  "57": {
   "jp": "944a3998",
   "kr": "여기 청소는 됐다."
  },
  "58": {
   "jp": "c57ded2d",
   "kr": "자, 크리스 아가씨."
  },
  "59": {
   "jp": "326ac157",
   "kr": "서둘러라, 서둘러."
  },
  "60": {
   "jp": "e697f4a5",
   "kr": "크리스 아가씨는"
  },
  "61": {
   "jp": "536dcf63",
   "kr": "요리 감각은 있다만…"
  },
  "62": {
   "jp": "088b0f3e",
   "kr": "너무 독창적인 듯하다."
  },
  "63": {
   "jp": "3ede2d1c",
   "kr": "자, 얼른 선원실에 가지 않으면"
  },
  "64": {
   "jp": "4218ee88",
   "kr": "요리가 식어 버린다."
  },
  "65": {
   "jp": "8df587c5",
   "kr": "크리스 아가씨라면"
  },
  "66": {
   "jp": "f749d298",
   "kr": "식사를 들고 선원실로 갔다."
  },
  "67": {
   "jp": "29e2b900",
   "kr": "쥬리오 군 것도 가져갔으니"
  },
  "68": {
   "jp": "f753f603",
   "kr": "가서 먹으렴."
  },
  "69": {
   "jp": "923b0ad7",
   "kr": "다만"
  },
  "70": {
   "jp": "9a5d2bd3",
   "kr": "다만…?"
  },
  "71": {
   "jp": "efb549ed",
   "kr": "오늘만큼은"
  },
  "72": {
   "jp": "943e31d8",
   "kr": "맛을 보장 못 한다."
  },
  "73": {
   "jp": "70354164",
   "kr": "……"
  },
  "74": {
   "jp": "984add28",
   "kr": "뱃사람은 정말 잘도 먹지."
  },
  "75": {
   "jp": "5270af4a",
   "kr": "그러면서 맛에도 까다로워."
  },
  "76": {
   "jp": "853aeb04",
   "kr": "그러니 방심할 수가 없다."
  },
  "77": {
   "jp": "6e73f64e",
   "kr": "여어, 열심이구나."
  },
  "78": {
   "jp": "2ede3961",
   "kr": "나도 망보기 열심히 하고 있다고."
  },
  "79": {
   "jp": "0e1b5b02",
   "kr": "우현 이상 없음. 좌현 이상 없음."
  },
  "80": {
   "jp": "98d16baa",
   "kr": "덤으로 내 머리도 이상 없음!"
  },
  "81": {
   "jp": "70354164",
   "kr": "……"
  },
  "82": {
   "jp": "83f52eab",
   "kr": "이상한 사람."
  },
  "83": {
   "jp": "65e545c6",
   "kr": "오〜 오〜"
  },
  "84": {
   "jp": "eaab4d07",
   "kr": "나는 뱃사람〜 배는 간다〜"
  },
  "85": {
   "jp": "acaee383",
   "kr": "높은 물결쯤이야〜 뭐어 어때〜"
  },
  "86": {
   "jp": "4cd8a741",
   "kr": "일곱 바다쯤이야 한 걸음에〜"
  },
  "87": {
   "jp": "57a1ae81",
   "kr": "여자가 나를 기다린다네〜"
  },
  "88": {
   "jp": "778eaafb",
   "kr": "폭풍은 조금 무섭지만〜"
  },
  "89": {
   "jp": "ebe9701e",
   "kr": "어떻게든 되겠지〜 그쯤이야　헤이!"
  },
  "90": {
   "jp": "de3b60fe",
   "kr": "…"
  },
  "91": {
   "jp": "291b3cec",
   "kr": "이상한 노래."
  },
  "92": {
   "jp": "0f126dcb",
   "kr": "제대로 일해야 밥도 맛있지!"
  },
  "93": {
   "jp": "cc66a646",
   "kr": "깨끗이 청소하라고."
  },
  "94": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "95": {
   "jp": "ce08990b",
   "kr": "이 보스레이의 눈은 못 속인다."
  },
  "96": {
   "jp": "8ef59af0",
   "kr": "아직 덜 한 데가 있지 않냐?"
  },
  "97": {
   "jp": "b6cc7072",
   "kr": "질버 선장은 깔끔한 걸 좋아하시니까."
  },
  "98": {
   "jp": "ee028cf4",
   "kr": "안 보이는 데도 대충 할 순 없어."
  },
  "99": {
   "jp": "b3300f6b",
   "kr": "쥬리오는 생각보다 부지런하구나."
  },
  "100": {
   "jp": "8e3fc61a",
   "kr": "내일도 이 기세로 부탁한다."
  },
  "101": {
   "jp": "2fbaa87f",
   "kr": "수고했다."
  },
  "102": {
   "jp": "a5d66ca4",
   "kr": "슬슬 식사도 될 것 같으니"
  },
  "103": {
   "jp": "cd6215b8",
   "kr": "선원실에서 크리스랑 밥을 먹고"
  },
  "104": {
   "jp": "6f14e5a1",
   "kr": "오늘은 쉬어라."
  },
  "105": {
   "jp": "9d42f647",
   "kr": "다른 손님들 식사는 내가 날라 뒀어."
  },
  "106": {
   "jp": "98783dd0",
   "kr": "내일도 일찍이니까 푹 쉬어라."
  },
  "107": {
   "jp": "45c3b4c7",
   "kr": "바다는 좋구나〜"
  },
  "108": {
   "jp": "0bbec24b",
   "kr": "넓고, 파랗고…"
  },
  "109": {
   "jp": "eff0b3e8",
   "kr": "너도 그렇게 생각하지?"
  },
  "110": {
   "jp": "6b54e82f",
   "kr": "파도만 봐도"
  },
  "111": {
   "jp": "17829465",
   "kr": "질리지 않아요."
  },
  "112": {
   "jp": "ab8be81c",
   "kr": "나, 정말 뱃사람이 되길 잘했어."
  },
  "113": {
   "jp": "22c43ce4",
   "kr": "이야, 크리스가 만든 요리는"
  },
  "114": {
   "jp": "f6d51800",
   "kr": "최고였어!"
  },
  "115": {
   "jp": "fb7acfb0",
   "kr": "정말요?"
  },
  "116": {
   "jp": "f25e798d",
   "kr": "정말이야!"
  },
  "117": {
   "jp": "7347d738",
   "kr": "바다에서 거짓말하면 세이렌의 저주가 내려."
  },
  "118": {
   "jp": "b37bdba1",
   "kr": "주방장님 요리는 최고지."
  },
  "119": {
   "jp": "46a27929",
   "kr": "근데 오늘 이 냄새는 어쩐지"
  },
  "120": {
   "jp": "4b100221",
   "kr": "좀 평소랑 다른데…?"
  },
  "121": {
   "jp": "18caa5af",
   "kr": "간을 바꿨나."
  },
  "122": {
   "jp": "b8d3d122",
   "kr": "예쁘게 담아내는 건"
  },
  "123": {
   "jp": "f16239e0",
   "kr": "즐거워."
  },
  "124": {
   "jp": "d612ec9f",
   "kr": "크리스…"
  },
  "125": {
   "jp": "14d918c6",
   "kr": "왜 수프 안에"
  },
  "126": {
   "jp": "18f567f0",
   "kr": "포크가 들어 있는 거야?"
  },
  "127": {
   "jp": "9aebac6c",
   "kr": "이번엔 반드시 맛있게 만들 거니까!"
  },
  "128": {
   "jp": "a65d66c3",
   "kr": "좋은 냄새지?"
  },
  "129": {
   "jp": "3626f51a",
   "kr": "이 냄새에 끌려서 들어왔구나."
  },
  "130": {
   "jp": "e89fd1d0",
   "kr": "아니야."
  },
  "131": {
   "jp": "f6ec86ed",
   "kr": "청소하러 온 거야."
  },
  "132": {
   "jp": "e89fd1d0",
   "kr": "아니야."
  },
  "133": {
   "jp": "dba5e8ab",
   "kr": "크리스 상태 보러 온 거야."
  },
  "134": {
   "jp": "4b4a592d",
   "kr": "정말일까."
  },
  "135": {
   "jp": "887c675f",
   "kr": "집어 먹으면 안 돼."
  },
  "136": {
   "jp": "f7a7eb55",
   "kr": "어째서 조리장님은"
  },
  "137": {
   "jp": "1defdf55",
   "kr": "이렇게 잘하시는 걸까."
  },
  "138": {
   "jp": "c855ea1e",
   "kr": "여러 접시가 있네."
  },
  "139": {
   "jp": "65a84877",
   "kr": "이건 분명 라그나 거겠지."
  },
  "140": {
   "jp": "bbb32481",
   "kr": "슬슬 다 되겠어."
  },
  "141": {
   "jp": "c77ad276",
   "kr": "조금만 더 하면 뒷정리가 끝나."
  },
  "142": {
   "jp": "dc3728ab",
   "kr": "쥬리오는 방에서 기다려."
  },
  "143": {
   "jp": "302aa428",
   "kr": "비켜 비켜."
  },
  "144": {
   "jp": "eb17d1f2",
   "kr": "바쁘단 말이야."
  },
  "145": {
   "jp": "33fbb79b",
   "kr": "쥬리오도 힘내."
  },
  "146": {
   "jp": "c9ffb848",
   "kr": "쥬리오도 참, 외로움을 타네."
  },
  "147": {
   "jp": "bd517e55",
   "kr": "그런 거 아니야!"
  },
  "148": {
   "jp": "3761ef67",
   "kr": "좀 궁금했을 뿐이야."
  },
  "149": {
   "jp": "31e01601",
   "kr": "방에서 기다릴게."
  }
 }
}