{
 "archive": "/SCE1/SC103.DAT",
 "member": "..\\DATA\\MT4101.BIN",
 "lines": {
  "0": {
   "jp": "7851a095",
   "kr": "넬바"
  },
  "1": {
   "jp": "f3b21c53",
   "kr": "성 아랫마을"
  },
  "2": {
   "jp": "203b1c40",
   "kr": "빌"
  },
  "3": {
   "jp": "8ff5fa0a",
   "kr": "마농 할머니"
  },
  "4": {
   "jp": "79714ffe",
   "kr": "단크 대장"
  },
  "5": {
   "jp": "60f49c58",
   "kr": "메나트 병사"
  },
  "6": {
   "jp": "819ba072",
   "kr": "메나트 병사들"
  },
  "7": {
   "jp": "4cb8fabd",
   "kr": "페네"
  },
  "8": {
   "jp": "e7550555",
   "kr": "바질"
  },
  "9": {
   "jp": "ae9e39b1",
   "kr": "칸드의 가라드"
  },
  "10": {
   "jp": "3aedc896",
   "kr": "시메라 부인"
  },
  "11": {
   "jp": "8cba77fe",
   "kr": "바드"
  },
  "12": {
   "jp": "93a685b5",
   "kr": "콜"
  },
  "13": {
   "jp": "e1b034be",
   "kr": "현재 이 여관은 넬바군 관리 하에 있다."
  },
  "14": {
   "jp": "825d2d95",
   "kr": "미안하지만"
  },
  "15": {
   "jp": "d6251f16",
   "kr": "여행자는 숙박을 삼가 주게."
  },
  "16": {
   "jp": "3c14299b",
   "kr": "군의 행동을 방해하지 마라."
  },
  "17": {
   "jp": "92e66e71",
   "kr": "다음에 찾아 주실 때는"
  },
  "18": {
   "jp": "06eed49b",
   "kr": "멋진 거리를 보여 드리겠다고"
  },
  "19": {
   "jp": "114d4c66",
   "kr": "약속하죠."
  },
  "20": {
   "jp": "1f8ed426",
   "kr": "아… 어지럽다."
  },
  "21": {
   "jp": "bf0abed2",
   "kr": "식량도 없는데 작업은 고되군."
  },
  "22": {
   "jp": "cd006fec",
   "kr": "그래도 나도 넬바 병사다."
  },
  "23": {
   "jp": "5c4b03e1",
   "kr": "이 정도론 안 진다."
  },
  "24": {
   "jp": "eadbc833",
   "kr": "내가 나고 자란 마을이"
  },
  "25": {
   "jp": "3a82d042",
   "kr": "부서지는 게, 이토록 괴롭고"
  },
  "26": {
   "jp": "7d6cb78e",
   "kr": "슬픈 일일 줄은 몰랐어…"
  },
  "27": {
   "jp": "55dd3c2d",
   "kr": "이렇게까지 당하고 나니"
  },
  "28": {
   "jp": "fedb7072",
   "kr": "어쩐지 감각이 마비돼서"
  },
  "29": {
   "jp": "2fa86977",
   "kr": "아무 느낌도 없어."
  },
  "30": {
   "jp": "a6ed6160",
   "kr": "우리 넬바는"
  },
  "31": {
   "jp": "5ee55dae",
   "kr": "이를 계기로, 더욱 멋진 마을이 된다!"
  },
  "32": {
   "jp": "22b2ba28",
   "kr": "라고, 나는 믿고 있어."
  },
  "33": {
   "jp": "8e527947",
   "kr": "잔해 조심해 줘."
  },
  "34": {
   "jp": "8310b391",
   "kr": "어디가 무너질지 모르니까."
  },
  "35": {
   "jp": "e25b7906",
   "kr": "젠장…"
  },
  "36": {
   "jp": "273c69a1",
   "kr": "상처를 한시라도 빨리 낫게 해서"
  },
  "37": {
   "jp": "2c4f958c",
   "kr": "모두를 돕겠어."
  },
  "38": {
   "jp": "26450e00",
   "kr": "가루가 상륙은 마치 산이 쳐들어온 듯했어."
  },
  "39": {
   "jp": "17c54011",
   "kr": "…하지만, 상대도 생물이야."
  },
  "40": {
   "jp": "74beb0a6",
   "kr": "다음에 덮쳐 오면 한 방 먹여 주겠어."
  },
  "41": {
   "jp": "58d06610",
   "kr": "…아야야."
  },
  "42": {
   "jp": "bce6c2eb",
   "kr": "흥분하면, 아직 상처가 쑤셔…"
  },
  "43": {
   "jp": "c4f69534",
   "kr": "나도 명예로운 넬바 병사."
  },
  "44": {
   "jp": "8b10d14e",
   "kr": "어서 복귀해서 이 마을을 되돌려 놓겠어."
  },
  "45": {
   "jp": "dfb977d1",
   "kr": "기다리게 했군."
  },
  "46": {
   "jp": "57c0fddd",
   "kr": "노르딕 왕이 튜엘에 도착했다는"
  },
  "47": {
   "jp": "bbfa8a61",
   "kr": "보고가 들어왔으니 이제 지나가도 된다."
  },
  "48": {
   "jp": "61349871",
   "kr": "여행길 무사하길 빈다."
  },
  "49": {
   "jp": "a6228ceb",
   "kr": "여행자로군."
  },
  "50": {
   "jp": "8088d5e1",
   "kr": "미안하지만 노르딕 왕이"
  },
  "51": {
   "jp": "6b52cc71",
   "kr": "튜엘에 도착할 때까지"
  },
  "52": {
   "jp": "47465104",
   "kr": "가도를 봉쇄하고 있다."
  },
  "53": {
   "jp": "dc30ff48",
   "kr": "이것도 국왕의 안전을 위해서다."
  },
  "54": {
   "jp": "ef4f63c4",
   "kr": "설마, 그 여행하던 여자분이"
  },
  "55": {
   "jp": "f769c56c",
   "kr": "말한 대로 될 줄이야."
  },
  "56": {
   "jp": "9460a967",
   "kr": "나는 아직 어렸으니까"
  },
  "57": {
   "jp": "a0a6b377",
   "kr": "잘은 기억 안 나지만"
  },
  "58": {
   "jp": "940e61a2",
   "kr": "머리카락이 은백색이라 정말 예뻤어."
  },
  "59": {
   "jp": "0b7b8776",
   "kr": "그분은 바다를 건너온 예언자였어."
  },
  "60": {
   "jp": "f26ede01",
   "kr": "…라고 이제 깨달아 봐야 늦었나…"
  },
  "61": {
   "jp": "dae5e9da",
   "kr": "아니 글쎄, 봤다니까. 아까."
  },
  "62": {
   "jp": "9c017d57",
   "kr": "노르딕 왕이 시종을 거느리고"
  },
  "63": {
   "jp": "980b1667",
   "kr": "튜엘 쪽으로 가는 걸 말이야."
  },
  "64": {
   "jp": "8128d1ad",
   "kr": "분명 성이 없어졌으니"
  },
  "65": {
   "jp": "161ed29a",
   "kr": "넬바가 복구될 때까지 튜엘에서"
  },
  "66": {
   "jp": "d2b4035e",
   "kr": "형편을 볼 셈인 게지."
  },
  "67": {
   "jp": "bc6aa01f",
   "kr": "임금님이라면 이런 때야말로"
  },
  "68": {
   "jp": "19b04359",
   "kr": "백성과 한마음이 되어"
  },
  "69": {
   "jp": "d8987def",
   "kr": "나라를 일으켜야 한다고 보는데."
  },
  "70": {
   "jp": "6cd7622c",
   "kr": "뭐, 임금님한텐"
  },
  "71": {
   "jp": "ebed215a",
   "kr": "임금님 나름의 생각이 있겠지만."
  },
  "72": {
   "jp": "3f7a5295",
   "kr": "몰래 숨어선 안 되지."
  },
  "73": {
   "jp": "c7218eba",
   "kr": "어머, 손님?"
  },
  "74": {
   "jp": "fe697976",
   "kr": "저는 이 여관 딸 페네예요."
  },
  "75": {
   "jp": "f342f2b3",
   "kr": "오늘은 못 묵나요?"
  },
  "76": {
   "jp": "5ba15f18",
   "kr": "미안해요."
  },
  "77": {
   "jp": "47c5ff57",
   "kr": "당분간은 병사님들이 빌려서 휴업 중이에요."
  },
  "78": {
   "jp": "64fe88a3",
   "kr": "안쪽에는 다친 병사님도 쉬고 있고요."
  },
  "79": {
   "jp": "2290b395",
   "kr": "지금은 손이 모자라요."
  },
  "80": {
   "jp": "359ee417",
   "kr": "미안해요."
  },
  "81": {
   "jp": "d430e9bc",
   "kr": "도련님과 아가씨는 순례 여행이죠?"
  },
  "82": {
   "jp": "acc99b24",
   "kr": "평생 한 번뿐인 일인데 안됐어요."
  },
  "83": {
   "jp": "a9b4daf1",
   "kr": "죄송해요."
  },
  "84": {
   "jp": "ba9b6693",
   "kr": "다음에 묵으실 때는 서비스해 드릴 테니"
  },
  "85": {
   "jp": "b707a218",
   "kr": "안정되면 또 들러 주십시오."
  },
  "86": {
   "jp": "3e6a7ca5",
   "kr": "정말 죄송합니다."
  },
  "87": {
   "jp": "c3a987ae",
   "kr": "저도 웬만한 마법은 쓸 수 있는데"
  },
  "88": {
   "jp": "5287d79a",
   "kr": "가루가의 걸음을 늦추는 것조차"
  },
  "89": {
   "jp": "7738a8cb",
   "kr": "하지 못했습니다…"
  },
  "90": {
   "jp": "4a23e3a7",
   "kr": "이 땅에 마법을 전한"
  },
  "91": {
   "jp": "ad819af8",
   "kr": "바다 건너온 마녀들에게 면목이 없습니다."
  },
  "92": {
   "jp": "d00ffa4a",
   "kr": "넬바 칸드에 잘 오셨습니다."
  },
  "93": {
   "jp": "89255841",
   "kr": "어느 분께 전수할까요?"
  },
  "94": {
   "jp": "7ce46b82",
   "kr": "어느 마법을 원하시나요?"
  },
  "95": {
   "jp": "941f0265",
   "kr": "말이군요."
  },
  "96": {
   "jp": "01aa32e3",
   "kr": "전수하겠습니다."
  },
  "97": {
   "jp": "d2999fa4",
   "kr": "마법이 그대의 좋은 벗이기를."
  },
  "98": {
   "jp": "fc06e09a",
   "kr": "노르딕 왕이 빠른 건"
  },
  "99": {
   "jp": "30389257",
   "kr": "세금 걷기랑, 달아나는 것뿐이야."
  },
  "100": {
   "jp": "abcf90e2",
   "kr": "앗, 이건 비밀로 해 줘."
  },
  "101": {
   "jp": "4956e304",
   "kr": "메나트 전체가 식량 부족이어도"
  },
  "102": {
   "jp": "d0edc5a0",
   "kr": "성에선 밤마다 무도회."
  },
  "103": {
   "jp": "3f2184a5",
   "kr": "우리 고생을 알기나 하시려나?"
  },
  "104": {
   "jp": "231efdd6",
   "kr": "앗, 이것도 비밀로 해 줘."
  },
  "105": {
   "jp": "0fe888cd",
   "kr": "칸드 마법은 챠펠 마법과 달리"
  },
  "106": {
   "jp": "5eea95bb",
   "kr": "공격적인 마법이 많아."
  },
  "107": {
   "jp": "48d42e9f",
   "kr": "마수를 쫓아내는 데는 편리한 마법이지."
  },
  "108": {
   "jp": "47cd0c9c",
   "kr": "하지만, 아무나 다룰 수 있는 마법은 아냐."
  },
  "109": {
   "jp": "756a0973",
   "kr": "챠펠 마법도 그렇지만 타고난 소양이"
  },
  "110": {
   "jp": "05bda077",
   "kr": "필요하거든."
  },
  "111": {
   "jp": "3a43f686",
   "kr": "너희도 여행을 하고 있다면"
  },
  "112": {
   "jp": "def79b62",
   "kr": "칸드 마법을 다루는 동료가 한 사람쯤 있으면"
  },
  "113": {
   "jp": "604154be",
   "kr": "훨씬 수월할 거야."
  },
  "114": {
   "jp": "804348b0",
   "kr": "조금 전에 말이야."
  },
  "115": {
   "jp": "89c2ee34",
   "kr": "임금님이 시종을 거느리고"
  },
  "116": {
   "jp": "5bd409d5",
   "kr": "튜엘로 떠났거든."
  },
  "117": {
   "jp": "18cdb414",
   "kr": "그래서, 길이 붐비지 않게"
  },
  "118": {
   "jp": "00bed3a5",
   "kr": "튜엘까지 가는 가도는"
  },
  "119": {
   "jp": "561e0ca7",
   "kr": "한동안 못 지나가."
  },
  "120": {
   "jp": "4da84cb7",
   "kr": "높은 분들은 제멋대로라니까."
  }
 }
}