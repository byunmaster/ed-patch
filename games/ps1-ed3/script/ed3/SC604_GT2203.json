{
 "archive": "/SCE6/SC604.DAT",
 "member": "..\\DATA\\GT2203.BIN",
 "lines": {
  "0": {
   "jp": "dc464821",
   "kr": "기드넬"
  },
  "1": {
   "jp": "4300e71e",
   "kr": "우르기드 저택"
  },
  "2": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "3": {
   "jp": "e9b5c557",
   "kr": "우르기드"
  },
  "4": {
   "jp": "d12a3c7c",
   "kr": "칸다타"
  },
  "5": {
   "jp": "b15b6998",
   "kr": "(자, 나와라…)"
  },
  "6": {
   "jp": "b417d9ba",
   "kr": "(헛간 쪽으로 가 버려라…)"
  },
  "7": {
   "jp": "da832568",
   "kr": "또 폭발이냐…?"
  },
  "8": {
   "jp": "82c69d18",
   "kr": "역시 사막의 흑표범은"
  },
  "9": {
   "jp": "b9e345d9",
   "kr": "아직 이 근방에 숨어 있었던 거다."
  },
  "10": {
   "jp": "0eae2ff3",
   "kr": "어쩔 수 없지, 우리도 찾으러 갈까."
  },
  "11": {
   "jp": "3e8df747",
   "kr": "우리만 안 찾았다고"
  },
  "12": {
   "jp": "bfc6456b",
   "kr": "나중에 알려지면"
  },
  "13": {
   "jp": "a0957cc3",
   "kr": "우르기드 님께 크게 혼쭐이 나니까 말이다."
  },
  "14": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "15": {
   "jp": "c6d69e52",
   "kr": "(됐다, 작전대로.)"
  },
  "16": {
   "jp": "377aaec0",
   "kr": "(가자.)"
  },
  "17": {
   "jp": "c8a7d914",
   "kr": "크리스…크리스…"
  },
  "18": {
   "jp": "a8343fa5",
   "kr": "거기 있지, 크리스?"
  },
  "19": {
   "jp": "8c013f88",
   "kr": "쥬리오…?"
  },
  "20": {
   "jp": "0c12bfc3",
   "kr": "너무 늦었잖아."
  },
  "21": {
   "jp": "93360fdb",
   "kr": "미안."
  },
  "22": {
   "jp": "5c6ea166",
   "kr": "구하러 와서"
  },
  "23": {
   "jp": "8e74b4be",
   "kr": "왜 사과를 하고 있냐."
  },
  "24": {
   "jp": "48aa2003",
   "kr": "응, 그러네."
  },
  "25": {
   "jp": "0500300b",
   "kr": "이상하네."
  },
  "26": {
   "jp": "86e75bfd",
   "kr": "뭘 그렇게 구시렁대는 거야?"
  },
  "27": {
   "jp": "2b24a94e",
   "kr": "얼른 여기서 꺼내 줘."
  },
  "28": {
   "jp": "ff710170",
   "kr": "아, 응. 알겠어."
  },
  "29": {
   "jp": "d204bdd7",
   "kr": "이 문을 폭파할 테니까"
  },
  "30": {
   "jp": "569f528e",
   "kr": "물러서 있어."
  },
  "31": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "32": {
   "jp": "e5e40c47",
   "kr": "좋아!"
  },
  "33": {
   "jp": "c076d745",
   "kr": "쥬리오는 폭탄을 설치했다."
  },
  "34": {
   "jp": "96cd0556",
   "kr": "이걸로 된 걸까."
  },
  "35": {
   "jp": "30398a3f",
   "kr": "저기, 이걸로 된 거야?"
  },
  "36": {
   "jp": "dab681ed",
   "kr": "물어봐도 모르겠다만…"
  },
  "37": {
   "jp": "5aa9e7f4",
   "kr": "야, 벌써 불이 붙었다고."
  },
  "38": {
   "jp": "79a86c6d",
   "kr": "우리도"
  },
  "39": {
   "jp": "ad004932",
   "kr": "도망치는 게 낫지 않겠냐?"
  },
  "40": {
   "jp": "942f9d75",
   "kr": "와, 엄청난 기세로 도화선이 타고 있어."
  },
  "41": {
   "jp": "7648f577",
   "kr": "위험하다고."
  },
  "42": {
   "jp": "a361cd11",
   "kr": "어서!"
  },
  "43": {
   "jp": "9a75a3c7",
   "kr": "됐으니까 물러나!"
  },
  "44": {
   "jp": "f3b780af",
   "kr": "해냈다!"
  },
  "45": {
   "jp": "f113e748",
   "kr": "서둘러, 쥬리오!"
  },
  "46": {
   "jp": "1062e8c1",
   "kr": "방금 소리를 듣고"
  },
  "47": {
   "jp": "36410423",
   "kr": "병사들이 돌아온다고!"
  },
  "48": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "49": {
   "jp": "2238d43d",
   "kr": "크리스!"
  },
  "50": {
   "jp": "e1ae031e",
   "kr": "쥬리오!"
  },
  "51": {
   "jp": "6a537236",
   "kr": "서둘러, 탈출한다!"
  },
  "52": {
   "jp": "17ccf1a1",
   "kr": "어라, 이 사람은?"
  },
  "53": {
   "jp": "ade3cda7",
   "kr": "나중에 말할게."
  },
  "54": {
   "jp": "e27b973d",
   "kr": "크리스가 파티에 합류했다."
  },
  "55": {
   "jp": "390f3ec6",
   "kr": "좋아, 가자!"
  },
  "56": {
   "jp": "36ee3907",
   "kr": "이럴 줄 알았다."
  },
  "57": {
   "jp": "eafdf46a",
   "kr": "앗…?"
  },
  "58": {
   "jp": "49ae1f49",
   "kr": "젠장, 우르기드다."
  },
  "59": {
   "jp": "1e2baa99",
   "kr": "병사들은 사막의 흑표범을 찾으러 갔지만"
  },
  "60": {
   "jp": "55e1c49f",
   "kr": "나는 너희가 나타날 거라 짐작하고 있었다."
  },
  "61": {
   "jp": "fd1691d2",
   "kr": "와하하하하…"
  },
  "62": {
   "jp": "f50b7eb8",
   "kr": "보기 좋게 덫에 걸렸구나."
  },
  "63": {
   "jp": "1f8896a3",
   "kr": "얄미운 놈."
  },
  "64": {
   "jp": "7c267a75",
   "kr": "해치워 버릴까?"
  },
  "65": {
   "jp": "bb11d9a0",
   "kr": "맞다, 진홍의 불꽃도 돌려받아야 해."
  },
  "66": {
   "jp": "6c141800",
   "kr": "엇, 진홍의 불꽃을 줬어?"
  },
  "67": {
   "jp": "1a9bb5a3",
   "kr": "그치만"
  },
  "68": {
   "jp": "b1412c63",
   "kr": "진귀한 걸 주지 않으면"
  },
  "69": {
   "jp": "8bd4e4bb",
   "kr": "부탁을 들어주지 않는다고."
  },
  "70": {
   "jp": "204d53c8",
   "kr": "후후후…"
  },
  "71": {
   "jp": "578745f5",
   "kr": "되찾을 수 있으면 해 보아라."
  },
  "72": {
   "jp": "022afbae",
   "kr": "나는 레바스와 계약했다."
  },
  "73": {
   "jp": "b79a46be",
   "kr": "이 몸은 웬만한 자론 안 쓰러진다."
  },
  "74": {
   "jp": "e1b3ba03",
   "kr": "레바스…?"
  },
  "75": {
   "jp": "d6038ae5",
   "kr": "어디서 들어 본 이름이야."
  },
  "76": {
   "jp": "10c47fe9",
   "kr": "보아라!"
  },
  "77": {
   "jp": "b936babd",
   "kr": "이 힘 넘치는 내 몸을!"
  },
  "78": {
   "jp": "2c16edb8",
   "kr": "우오오오오오!"
  },
  "79": {
   "jp": "132cbbad",
   "kr": "우옷… 강해 보여."
  },
  "80": {
   "jp": "c073a508",
   "kr": "각오해라아!"
  },
  "81": {
   "jp": "6c94044c",
   "kr": "으아아아…"
  },
  "82": {
   "jp": "073d6c0e",
   "kr": "칸다타다…"
  },
  "83": {
   "jp": "5a1625f4",
   "kr": "우왓, 앞뒤로 막혔어."
  }
 }
}