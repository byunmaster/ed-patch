 "lines": {
  "0": {
   "jp": "0e815652",
   "kr": "헤즈 가도"
  },
  "1": {
   "jp": "6360b1e8",
   "kr": "류넬"
  },
  "2": {
   "jp": "420b886b",
   "kr": "류넬의 목소리"
  },
  "3": {
   "jp": "5c165bab",
   "kr": "쥬리오 씨〜!"
  },
  "4": {
   "jp": "fd898567",
   "kr": "크리스 씨〜!"
  },
  "5": {
   "jp": "9c939df5",
   "kr": "어라? 저 목소리는…"
  },
  "6": {
   "jp": "3e31baf8",
   "kr": "올도스 문에 있던 류넬 씨다."
  },
  "7": {
   "jp": "1a2de875",
   "kr": "앗, 있다 있다."
  },
  "8": {
   "jp": "e1318685",
   "kr": "겨우 찾았어요."
  },
  "9": {
   "jp": "a1bb8f76",
   "kr": "따라잡아서 다행이에요."
  },
  "10": {
   "jp": "d50f5b90",
   "kr": "류넬 씨, 무슨 일이에요?"
  },
  "11": {
   "jp": "991699fb",
   "kr": "대신관님께서 전하라고 하셔서요."
  },
  "12": {
   "jp": "5f86d3ec",
   "kr": "올도스의 승병을 총동원해서"
  },
  "13": {
   "jp": "a18cd95f",
   "kr": "두 분을 찾고 있었어요."
  },
  "14": {
   "jp": "4897df04",
   "kr": "도중에 국경이 봉쇄되어 있기도 해서"
  },
  "15": {
   "jp": "deb58159",
   "kr": "따라잡지 못할까 싶어 조마조마했어요."
  },
  "16": {
   "jp": "57b3165b",
   "kr": "두 분도 발이 묶여 계셨군요."
  },
  "17": {
   "jp": "b5789287",
   "kr": "대신관님이요?"
  },
  "18": {
   "jp": "e142dbad",
   "kr": "뭔가 새 정보를 알아냈나요?"
  },
  "19": {
   "jp": "119eb3c0",
   "kr": "네, 그렇답니다."
  },
  "20": {
   "jp": "797f9fb2",
   "kr": "대신관 덴켄 님의 전언을 전하겠습니다."
  },
  "21": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "22": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "23": {
   "jp": "d82ba3c9",
   "kr": "폴티아를 둘러싼 암운의 원흉은,"
  },
  "24": {
   "jp": "80adcc54",
   "kr": "아무래도 루드성 안에 있는 모양이다."
  },
  "25": {
   "jp": "70669ad3",
   "kr": "하지만 성 안은 누군가의 손으로"
  },
  "26": {
   "jp": "da6eab9f",
   "kr": "결계가 쳐져 있어, 올도스의 힘으로도"
  },
  "27": {
   "jp": "d8c22919",
   "kr": "엿보기는 어렵다."
  },
  "28": {
   "jp": "30a190a0",
   "kr": "예전에 루드성의 궁정 검사였던"
  },
  "29": {
   "jp": "312aee04",
   "kr": "듀르젤이라는 자가"
  },
  "30": {
   "jp": "d668a38c",
   "kr": "돌페스에 유폐되어 있다고 들었다."
  },
  "31": {
   "jp": "073db588",
   "kr": "루드성으로 가기 전에 듀르젤 공을 만나,"
  },
  "32": {
   "jp": "86051b1e",
   "kr": "미리 성의 내부 사정을"
  },
  "33": {
   "jp": "bb2f016c",
   "kr": "알아 두는 것이 좋겠다고 하십니다."
  },
  "34": {
   "jp": "505be198",
   "kr": "듀르젤 공?"
  },
  "35": {
   "jp": "916852b9",
   "kr": "어디선가 들어 본 이름이야."
  },
  "36": {
   "jp": "35386b9e",
   "kr": "앗?!"
  },
  "37": {
   "jp": "d45636af",
   "kr": "로디가 말했던 사람이야."
  },
  "38": {
   "jp": "49460253",
   "kr": "분명, 스승이라 부를 수 있는 건"
  },
  "39": {
   "jp": "890efcc6",
   "kr": "폴티아의 궁정 검사, 듀르젤 공"
  },
  "40": {
   "jp": "da08d14e",
   "kr": "정도라던가 뭐라던가…"
  },
  "41": {
   "jp": "1db93ea9",
   "kr": "그런 말을 했었어."
  },
  "42": {
   "jp": "a55b79a2",
   "kr": "아, 그때 로디가 말했었지."
  },
  "43": {
   "jp": "dc4a1cfc",
   "kr": "그리고 하나 더."
  },
  "44": {
   "jp": "6b2aa12e",
   "kr": "듀르젤 공은 하얀마녀와"
  },
  "45": {
   "jp": "918273cc",
   "kr": "교류가 있었다고 합니다."
  },
  "46": {
   "jp": "2a62fe4c",
   "kr": "정말요?!"
  },
  "47": {
   "jp": "88149875",
   "kr": "네."
  },
  "48": {
   "jp": "b8cafb5d",
   "kr": "아마도, 하얀마녀에 대해서는"
  },
  "49": {
   "jp": "a9427205",
   "kr": "가장 잘 아는 분일 거라고"
  },
  "50": {
   "jp": "dc87f213",
   "kr": "대신관님께서 말씀하셨어요."
  },
  "51": {
   "jp": "79a3f0f7",
   "kr": "꼭 만나야 해."
  },
  "52": {
   "jp": "27afb4f0",
   "kr": "그래도, 돌페스라는 곳에"
  },
  "53": {
   "jp": "73632593",
   "kr": "유폐되어 있다면서?"
  },
  "54": {
   "jp": "660d56d5",
   "kr": "어떻게 만나려고?"
  },
  "55": {
   "jp": "40bdaad9",
   "kr": "부탁하면,"
  },
  "56": {
   "jp": "2ecc9a02",
   "kr": "면회시켜 주지 않을까."
  },
  "57": {
   "jp": "4a2da10c",
   "kr": "주지 않을까."
  },
  "58": {
   "jp": "a7f2bdff",
   "kr": "유폐라니 붙잡혀 있단 얘기잖아."
  },
  "59": {
   "jp": "f4503936",
   "kr": "뭔가 나쁜 짓이라도 한 걸까?"
  },
  "60": {
   "jp": "b37d47f3",
   "kr": "글쎄요, 그 부분은 저도 잘 모릅니다."
  },
  "61": {
   "jp": "15cb5848",
   "kr": "어쨌든"
  },
  "62": {
   "jp": "842beaca",
   "kr": "듀르젤이란 사람을 만나러 가자."
  },
  "63": {
   "jp": "0b235f84",
   "kr": "돌페스로 가자."
  },
  "64": {
   "jp": "fdf0abdd",
   "kr": "그래, 그렇게 하자."
  },
  "65": {
   "jp": "abfcc4a3",
   "kr": "분명 뭔가 들을 수 있어."
  },
  "66": {
   "jp": "b0a222bf",
   "kr": "그럼 이만 실례할게요."
  },
  "67": {
   "jp": "e523d5b6",
   "kr": "엣, 벌써 가요?"
  },
  "68": {
   "jp": "542f5194",
   "kr": "빨리 올도스로 돌아가서"
  },
  "69": {
   "jp": "94febcc3",
   "kr": "너희에게 확실히 전했다고 보고해야 하니"
  },
  "70": {
   "jp": "b6bd88d9",
   "kr": "대신관님께서 걱정하시니까요."
  },
  "71": {
   "jp": "d9299a73",
   "kr": "그럼, 안녕히."
  },
  "72": {
   "jp": "baa18e35",
   "kr": "조심하세요."
  },
  "73": {
   "jp": "baa28276",
   "kr": "류넬 씨, 고마워요."
  },
  "74": {
   "jp": "1cf06bbb",
   "kr": "그럼 이만."
  },
  "75": {
   "jp": "167725bb",
   "kr": "그럼 이만."
  },
  "76": {
   "jp": "aaf704bb",
   "kr": "듀르젤이란 사람은"
  },
  "77": {
   "jp": "c238799d",
   "kr": "대체 뭘 알고 있는 걸까."
  },
  "78": {
   "jp": "af81a184",
   "kr": "자, 쥬리오."
  },
  "79": {
   "jp": "f9049ce8",
   "kr": "어쨌든 서둘러 가자."
  }
 }
