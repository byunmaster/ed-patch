{
 "archive": "/SCE6/SC606.DAT",
 "member": "..\\DATA\\GT3100.BIN",
 "lines": {
  "0": {
   "jp": "26fb5f27",
   "kr": "딜트 관문"
  },
  "1": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "2": {
   "jp": "f3d96af7",
   "kr": "푸르스"
  },
  "3": {
   "jp": "2892c405",
   "kr": "아오프"
  },
  "4": {
   "jp": "5a257b5b",
   "kr": "우코스 대장"
  },
  "5": {
   "jp": "9f0bb79b",
   "kr": "폴티아로 건너가는 나그네인가?"
  },
  "6": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "7": {
   "jp": "14b66a46",
   "kr": "도개교는"
  },
  "8": {
   "jp": "df3c04e0",
   "kr": "아직 내려올 시간이 아니야."
  },
  "9": {
   "jp": "e2120077",
   "kr": "미안하지만"
  },
  "10": {
   "jp": "19c50cdd",
   "kr": "잠시 동쪽 대합실에서"
  },
  "11": {
   "jp": "437e9aa8",
   "kr": "시간을 보내고 있게."
  },
  "12": {
   "jp": "ed36706e",
   "kr": "동쪽 대합실이구나."
  },
  "13": {
   "jp": "5f018412",
   "kr": "그래, 맞아."
  },
  "14": {
   "jp": "ea8d1d6f",
   "kr": "다리가 이어지면 부르러 가 주지."
  },
  "15": {
   "jp": "5d3e7e4b",
   "kr": "동남쪽 대합실에서 기다리라고 했으니까,"
  },
  "16": {
   "jp": "bfda24a5",
   "kr": "너무 돌아다니지 않는 게 좋을지도."
  },
  "17": {
   "jp": "1cc60b68",
   "kr": "폴티아로 건너가는 나그네라…"
  },
  "18": {
   "jp": "36a8fa21",
   "kr": "정해진 통행 시간이 올 때까지는"
  },
  "19": {
   "jp": "855cf0f5",
   "kr": "도개교가 이어지지 않으니까."
  },
  "20": {
   "jp": "35cc6e9d",
   "kr": "그때까지는 여기서 느긋하게 있으라고."
  },
  "21": {
   "jp": "728dc31e",
   "kr": "확실히, 여기 병사들은 화를 잘 내지만,"
  },
  "22": {
   "jp": "a40c5948",
   "kr": "딱히 수상한 움직임이"
  },
  "23": {
   "jp": "0967b5a1",
   "kr": "있는 것도 아닌 모양이야."
  },
  "24": {
   "jp": "75549dd1",
   "kr": "하지만, 여기 병사 수는 보통이 아닙니다."
  },
  "25": {
   "jp": "41320cf0",
   "kr": "병사들뿐이니까."
  },
  "26": {
   "jp": "6dd9489f",
   "kr": "게다가 다들 날이 서 있는 것 같아."
  },
  "27": {
   "jp": "e4d83503",
   "kr": "혹시"
  },
  "28": {
   "jp": "083a7a0c",
   "kr": "다리 건너 폴티아 쪽에서는,"
  },
  "29": {
   "jp": "da013177",
   "kr": "터무니없는 일이 벌어지고 있는지도 모르지…"
  },
  "30": {
   "jp": "6f53602b",
   "kr": "터무니없는 일이라니?"
  },
  "31": {
   "jp": "4a188c6d",
   "kr": "글쎄다."
  },
  "32": {
   "jp": "7da10303",
   "kr": "뭐, 다리가 이어져서 건너가면"
  },
  "33": {
   "jp": "9ed4841d",
   "kr": "알게 될 일이다."
  },
  "34": {
   "jp": "5f99351d",
   "kr": "도개교가 내려오는 시간이 될 때까지,"
  },
  "35": {
   "jp": "c9faaa53",
   "kr": "그저 여기서 가만히 기다리고 있는 것도,"
  },
  "36": {
   "jp": "77a7a0a8",
   "kr": "왠지 마음이 안 놓여."
  },
  "37": {
   "jp": "7aff9aa6",
   "kr": "조금 더"
  },
  "38": {
   "jp": "ffbd8136",
   "kr": "여기 상황을 조사해 보자."
  },
  "39": {
   "jp": "2336b3a7",
   "kr": "그래, 그렇군. 그러자."
  },
  "40": {
   "jp": "3f4490bc",
   "kr": "그자들 어디까지 왔나?"
  },
  "41": {
   "jp": "612f6299",
   "kr": "응?"
  },
  "42": {
   "jp": "2ae8fdd3",
   "kr": "루드성에서 나온 병단은"
  },
  "43": {
   "jp": "81a25670",
   "kr": "머지않아 북쪽 폴티아 국경에"
  },
  "44": {
   "jp": "438cbf98",
   "kr": "도착할 예정입니다."
  },
  "45": {
   "jp": "6cef374c",
   "kr": "흥, 변경 담당인 우리와는 달리,"
  },
  "46": {
   "jp": "67d44b99",
   "kr": "성에서 오는 정예 병단인가…"
  },
  "47": {
   "jp": "bce214bc",
   "kr": "올 필요도 없는데"
  },
  "48": {
   "jp": "8bd6f5c6",
   "kr": "루돌프 왕은 무슨 생각이신 걸까."
  },
  "49": {
   "jp": "baae0e2c",
   "kr": "더 이상 병력 따위 필요 없는데…"
  },
  "50": {
   "jp": "1f61f0e9",
   "kr": "그 병단은 성의 지령이 있을 때까지"
  },
  "51": {
   "jp": "28c4c160",
   "kr": "북쪽에서 대기한다고 하더군요."
  },
  "52": {
   "jp": "fabf6255",
   "kr": "대체 어떤 지령이 있는 걸까요?"
  },
  "53": {
   "jp": "5df70b45",
   "kr": "글쎄다, 모르겠다."
  },
  "54": {
   "jp": "a4c56f6b",
   "kr": "알고 싶지도 않다."
  },
  "55": {
   "jp": "32d0975a",
   "kr": "설마"
  },
  "56": {
   "jp": "4e6af634",
   "kr": "세계를 상대로 전쟁이라도"
  },
  "57": {
   "jp": "62f9a1f1",
   "kr": "시작할 셈은…"
  },
  "58": {
   "jp": "8e2dce9b",
   "kr": "역시 너도 그렇게 생각하나…"
  },
  "59": {
   "jp": "57d6839f",
   "kr": "거기서 뭐 하냐!"
  },
  "60": {
   "jp": "5acecf3a",
   "kr": "우리 얘길 엿들었구나!"
  },
  "61": {
   "jp": "2132f6eb",
   "kr": "대장!"
  },
  "62": {
   "jp": "fec5acc5",
   "kr": "…데려와라."
  },
  "63": {
   "jp": "bb2ae67e",
   "kr": "들어가"
  },
  "64": {
   "jp": "903c3158",
   "kr": "자, 빨리 해!"
  },
  "65": {
   "jp": "9689fc16",
   "kr": "안됐지만, 회의 내용을 들킨 이상"
  },
  "66": {
   "jp": "f4d974da",
   "kr": "이대로 넘길 수는 없다."
  },
  "67": {
   "jp": "b3de9cee",
   "kr": "아, 아무것도 안 들었어요."
  },
  "68": {
   "jp": "ddca8e3a",
   "kr": "저희는."
  },
  "69": {
   "jp": "554ee36a",
   "kr": "루드성에서 병단이 온다는 건요."
  },
  "70": {
   "jp": "1934de48",
   "kr": "이런…"
  },
  "71": {
   "jp": "683c4d80",
   "kr": "늘 한마디가 많다니까."
  },
  "72": {
   "jp": "eff1b400",
   "kr": "뭐야…"
  },
  "73": {
   "jp": "dcd36e90",
   "kr": "이자들 처분은 나중에 정한다."
  },
  "74": {
   "jp": "dcc7cd9c",
   "kr": "일단 감옥에 넣어 둬라."
  },
  "75": {
   "jp": "b23a7614",
   "kr": "쥬리오&크리스&바다트"
  },
  "76": {
   "jp": "1b86418d",
   "kr": "엣, 또 감옥에 들어가?"
  },
  "77": {
   "jp": "7ae185b8",
   "kr": "전 처음이에요."
  },
  "78": {
   "jp": "6de87882",
   "kr": "병사들과 싸울 수도 없어서,"
  },
  "79": {
   "jp": "6ac3bed7",
   "kr": "쥬리오 일행은 폴티아 국경의 감옥에"
  },
  "80": {
   "jp": "75a964a8",
   "kr": "갇히게 되고 말았다."
  },
  "81": {
   "jp": "ea8d1d6f",
   "kr": "다리가 이어지면 부르러 가 주지."
  },
  "82": {
   "jp": "81ebeb8a",
   "kr": "얌전히 대합실에서 기다려라."
  },
  "83": {
   "jp": "5452da99",
   "kr": "괜히 어슬렁거리며 돌아다니지 마라."
  },
  "84": {
   "jp": "4c2e702a",
   "kr": "죄수들이 하는 말은"
  },
  "85": {
   "jp": "0aa23664",
   "kr": "곧이곧대로 듣지 않아도 된다."
  },
  "86": {
   "jp": "e3ef5342",
   "kr": "놈들은 죄를 지어서 감옥에 들어온 거다."
  },
  "87": {
   "jp": "f0d2cf6e",
   "kr": "그런 놈들 말을"
  },
  "88": {
   "jp": "34debf46",
   "kr": "일일이 듣고 있으면 끝이 없다."
  },
  "89": {
   "jp": "1adbf36a",
   "kr": "뭐"
  },
  "90": {
   "jp": "d7bc5370",
   "kr": "죄수 따위와 엮이지 않는 편이"
  },
  "91": {
   "jp": "ff788c88",
   "kr": "신상에 이롭다."
  },
  "92": {
   "jp": "a7f48bc1",
   "kr": "이런 녀석들을 감시해야 하다니"
  },
  "93": {
   "jp": "d4c06bc3",
   "kr": "정말, 시시한 일이다."
  },
  "94": {
   "jp": "178e3421",
   "kr": "이놈들은 자기가 저지른 죄를"
  },
  "95": {
   "jp": "947b2557",
   "kr": "전혀 반성하지 않아."
  },
  "96": {
   "jp": "59b0c390",
   "kr": "어쩔 도리가 없는 놈들이야."
  },
  "97": {
   "jp": "a5c0f43d",
   "kr": "대기실에서 느긋하게 있으라고."
  },
  "98": {
   "jp": "2666f815",
   "kr": "더 이상 내 일거리를 늘리지 마라."
  },
  "99": {
   "jp": "96de3eee",
   "kr": "여행자냐?"
  },
  "100": {
   "jp": "a5a52c9a",
   "kr": "얼쩡거리지 마라."
  },
  "101": {
   "jp": "b4716e90",
   "kr": "대기실에서 얌전히 있어라."
  },
  "102": {
   "jp": "4feb4c26",
   "kr": "어이어이, 어이어이."
  },
  "103": {
   "jp": "5d8e99c0",
   "kr": "정말이지, 여긴 지독한 데야."
  },
  "104": {
   "jp": "e2bcb33b",
   "kr": "실수로 병사 발을 밟았을 뿐인데"
  },
  "105": {
   "jp": "cdfb7c42",
   "kr": "잡혀 버렸다고."
  },
  "106": {
   "jp": "2fc77303",
   "kr": "큰 소리로는 말 못 하겠지만"
  },
  "107": {
   "jp": "689a35fe",
   "kr": "여기 놈들은 신경이 곤두서 있는 것 같으니까"
  },
  "108": {
   "jp": "f0ab67a0",
   "kr": "너희도 조심하는 게 좋아."
  },
  "109": {
   "jp": "e95fc9bb",
   "kr": "저기저기, 저기저기."
  },
  "110": {
   "jp": "5264992f",
   "kr": "들어 보라고."
  },
  "111": {
   "jp": "62e2de2f",
   "kr": "못 믿겠지만"
  },
  "112": {
   "jp": "e90b6961",
   "kr": "가끔, 이 감옥 창문 밑에서"
  },
  "113": {
   "jp": "f58f53bd",
   "kr": "무슨 소리가 난다고."
  },
  "114": {
   "jp": "faf99da9",
   "kr": "커다란 두더지라도 있는 게 아닐까."
  },
  "115": {
   "jp": "bc43b2ab",
   "kr": "분명 있다니까."
  },
  "116": {
   "jp": "6d5e929b",
   "kr": "커다란 두더지가."
  }
 }
}