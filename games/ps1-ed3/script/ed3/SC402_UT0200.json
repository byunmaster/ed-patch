{
 "archive": "/SCE4/SC402.DAT",
 "member": "..\\DATA\\UT0200.BIN",
 "lines": {
  "0": {
   "jp": "3adb0536",
   "kr": "시플성"
  },
  "1": {
   "jp": "c182c53c",
   "kr": "우돌 병사"
  },
  "2": {
   "jp": "324a055b",
   "kr": "시플의 현자"
  },
  "3": {
   "jp": "e972e001",
   "kr": "스톡 왕"
  },
  "4": {
   "jp": "1e555834",
   "kr": "요리사 푸뇨"
  },
  "5": {
   "jp": "311a1578",
   "kr": "아테리 왕비"
  },
  "6": {
   "jp": "19dd68c0",
   "kr": "아, 어서 오세요."
  },
  "7": {
   "jp": "b23a0948",
   "kr": "여러모로 신세를 졌습니다."
  },
  "8": {
   "jp": "cef794b7",
   "kr": "들었어요."
  },
  "9": {
   "jp": "08206e69",
   "kr": "충분히 조심하세요."
  },
  "10": {
   "jp": "34bbf1ba",
   "kr": "아직 뭔가 있을지도 모르니까요."
  },
  "11": {
   "jp": "92cf3b8e",
   "kr": "우돌 성에 오신 걸 환영합니다."
  },
  "12": {
   "jp": "5c3fbc4d",
   "kr": "무슨 볼일이신가요?"
  },
  "13": {
   "jp": "5aaea8a7",
   "kr": "현자님을 찾고 있는데요"
  },
  "14": {
   "jp": "18fb7eb6",
   "kr": "계신가요?"
  },
  "15": {
   "jp": "f1afc34a",
   "kr": "글쎄요, 분명"
  },
  "16": {
   "jp": "aa0b1279",
   "kr": "계실 거라 생각했는데요…"
  },
  "17": {
   "jp": "8e461d1c",
   "kr": "안쪽 병사에게 물어봐 주시겠어요?"
  },
  "18": {
   "jp": "b1109aa0",
   "kr": "아, 반갑습니다."
  },
  "19": {
   "jp": "6bcb0f39",
   "kr": "저희 병사들도 감사드립니다."
  },
  "20": {
   "jp": "2756d1ce",
   "kr": "대체 여러분을 습격한 자는"
  },
  "21": {
   "jp": "d199253c",
   "kr": "누구일까요."
  },
  "22": {
   "jp": "72545add",
   "kr": "시플도 뒤숭숭해졌습니다."
  },
  "23": {
   "jp": "f49ddaaf",
   "kr": "이곳은 우돌을 다스리는 스톡 왕의 성입니다."
  },
  "24": {
   "jp": "a586b155",
   "kr": "혹시, 순례하시는 분인가요?"
  },
  "25": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "26": {
   "jp": "ce79f89b",
   "kr": "현자님은 좀처럼"
  },
  "27": {
   "jp": "3cc1dfe2",
   "kr": "만나 뵙기가 힘드네요."
  },
  "28": {
   "jp": "5b2dcd1b",
   "kr": "죄송합니다."
  },
  "29": {
   "jp": "8ab32d45",
   "kr": "혹시"
  },
  "30": {
   "jp": "13a1e49c",
   "kr": "시플의 현자님 말씀입니까?"
  },
  "31": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "32": {
   "jp": "1ce138f2",
   "kr": "네네."
  },
  "33": {
   "jp": "25543942",
   "kr": "그렇다네 내가 시플의 현자일세."
  },
  "34": {
   "jp": "f5427ebf",
   "kr": "순례하러 왔는데요,"
  },
  "35": {
   "jp": "de9a5825",
   "kr": "페브라 씨가 샤리네에 들여보내 주질 않아요."
  },
  "36": {
   "jp": "c0e7e0ef",
   "kr": "샤리네에 들어갈 허락을 주세요."
  },
  "37": {
   "jp": "1a25b1f5",
   "kr": "그거 미안하게 됐네."
  },
  "38": {
   "jp": "9c734d1d",
   "kr": "그만, 깜빡 졸아 버려서 말일세."
  },
  "39": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "40": {
   "jp": "74f50dc7",
   "kr": "그럼, 어서 데려다주겠네."
  },
  "41": {
   "jp": "e183f7c6",
   "kr": "역시 진짜 현자님은 부지런하십니다."
  },
  "42": {
   "jp": "9d57d05b",
   "kr": "그 뒤로 매일 샤리네 입구 앞에 서서"
  },
  "43": {
   "jp": "ebba2c9f",
   "kr": "순례자를 맞이하고 계시거든요."
  },
  "44": {
   "jp": "e49f8a4d",
   "kr": "여러모로 감사했습니다."
  },
  "45": {
   "jp": "9df34f01",
   "kr": "무사하셨나요?"
  },
  "46": {
   "jp": "c9308802",
   "kr": "설마 샤리네에서 습격당하시다니"
  },
  "47": {
   "jp": "74ae1ca7",
   "kr": "봉변이셨네요."
  },
  "48": {
   "jp": "b18bddcd",
   "kr": "정말 죄송합니다."
  },
  "49": {
   "jp": "4d58cc89",
   "kr": "저희가 경비를 서고 있었다면"
  },
  "50": {
   "jp": "395192b2",
   "kr": "이런 일도 없었을 텐데요…"
  },
  "51": {
   "jp": "4f045262",
   "kr": "어서 오세요."
  },
  "52": {
   "jp": "25432d8f",
   "kr": "성안은 자유롭게 보셔도 됩니다."
  },
  "53": {
   "jp": "dbbf75f3",
   "kr": "운이 좋으면 스톡 왕도"
  },
  "54": {
   "jp": "29d6c6b1",
   "kr": "뵐 수 있을지도 모르겠군요."
  },
  "55": {
   "jp": "d3d801b7",
   "kr": "오오, 자네들."
  },
  "56": {
   "jp": "ce2d5dbe",
   "kr": "이런? 일행이 바뀌었는가?"
  },
  "57": {
   "jp": "f540f4cc",
   "kr": "임금님."
  },
  "58": {
   "jp": "6c0dc350",
   "kr": "미혹의 숲을 찾고 있는데요"
  },
  "59": {
   "jp": "7aef0bff",
   "kr": "모르시나요?"
  },
  "60": {
   "jp": "dad2b547",
   "kr": "미혹의 숲인가."
  },
  "61": {
   "jp": "e96d9240",
   "kr": "으〜음. 나도 소문으로"
  },
  "62": {
   "jp": "fd977a73",
   "kr": "들은 적은 있네만…"
  },
  "63": {
   "jp": "0c960695",
   "kr": "아마, 큰길가에는 없을 게야."
  },
  "64": {
   "jp": "a6543a46",
   "kr": "어딘가 작은 마을을 지나"
  },
  "65": {
   "jp": "b787cd67",
   "kr": "숲속 깊이 깊이 들어가는 곳이겠지."
  },
  "66": {
   "jp": "c755672b",
   "kr": "알기 쉬운 곳에 있다면"
  },
  "67": {
   "jp": "464e54db",
   "kr": "진작에 나라 사람들에게"
  },
  "68": {
   "jp": "ffffee6d",
   "kr": "알려져 있을 테니 말일세."
  },
  "69": {
   "jp": "d3d801b7",
   "kr": "오오, 자네들."
  },
  "70": {
   "jp": "2607470a",
   "kr": "이번엔 현자를 찾아 준 데다,"
  },
  "71": {
   "jp": "440e5e8b",
   "kr": "샤리네에 나타난 사악한 환술사를"
  },
  "72": {
   "jp": "eddf71a6",
   "kr": "물리쳐 주었다지."
  },
  "73": {
   "jp": "95228fe2",
   "kr": "우돌 국민을 대표해 감사를 표하겠네."
  },
  "74": {
   "jp": "d678b6da",
   "kr": "고맙네."
  },
  "75": {
   "jp": "98b41bc0",
   "kr": "정말 고맙네."
  },
  "76": {
   "jp": "852a0fd1",
   "kr": "아아, 자네들."
  },
  "77": {
   "jp": "8d85aa7b",
   "kr": "고생이 많았네. 정말 미안하네."
  },
  "78": {
   "jp": "e831a2a0",
   "kr": "이 나라에서 위험한 일을 겪게 해서."
  },
  "79": {
   "jp": "7748d691",
   "kr": "샤리네 일은"
  },
  "80": {
   "jp": "46ff5bde",
   "kr": "서둘러 우리가 어떻게든 해 보겠네."
  },
  "81": {
   "jp": "18dd7747",
   "kr": "그때까지 자네들은"
  },
  "82": {
   "jp": "9bffdb54",
   "kr": "여관에서 쉬고 있게나."
  },
  "83": {
   "jp": "b1e0b7fa",
   "kr": "으〜음. 요즘 현자의 태도는 영 글렀군."
  },
  "84": {
   "jp": "8acc74ee",
   "kr": "멋대로 사라지고, 공무도 게을리하고."
  },
  "85": {
   "jp": "96b4fdb6",
   "kr": "도가 지나치군."
  },
  "86": {
   "jp": "752b9601",
   "kr": "대체 무슨 속셈인 게냐."
  },
  "87": {
   "jp": "2a066961",
   "kr": "스톡 왕은 쥬리오 일행을 못 알아채고"
  },
  "88": {
   "jp": "a4d939a2",
   "kr": "푸념하고 있다."
  },
  "89": {
   "jp": "850a0d90",
   "kr": "대단해요. 다들 강하다면서요."
  },
  "90": {
   "jp": "ce1122ef",
   "kr": "현자님이 가짜로 바뀌어 있었다니…"
  },
  "91": {
   "jp": "b1ecd4ea",
   "kr": "그렇다면 진짜 현자님은"
  },
  "92": {
   "jp": "6988ef15",
   "kr": "어디에 계신 걸까요…"
  },
  "93": {
   "jp": "26ddd558",
   "kr": "요즘 현자님의 식성이 변하셨거든."
  },
  "94": {
   "jp": "96ada986",
   "kr": "정말이지"
  },
  "95": {
   "jp": "73799bed",
   "kr": "매일 요리를 만드는 것도"
  },
  "96": {
   "jp": "fbbfd3e4",
   "kr": "쉽지 않아요."
  },
  "97": {
   "jp": "dbfa4e7f",
   "kr": "이곳은 침실입니다."
  },
  "98": {
   "jp": "ddaeda22",
   "kr": "아테리 왕비님이 계시니,"
  },
  "99": {
   "jp": "6555a6aa",
   "kr": "부디, 결례가 없도록"
  },
  "100": {
   "jp": "79dcd9f3",
   "kr": "해 주시기 바랍니다."
  },
  "101": {
   "jp": "9513d34a",
   "kr": "이 근처 바람은 참 부드럽죠."
  },
  "102": {
   "jp": "a4a7f787",
   "kr": "시플 샤리네에서 부는 바람은"
  },
  "103": {
   "jp": "19e8ce40",
   "kr": "언제나 동쪽을 향해"
  },
  "104": {
   "jp": "622e4519",
   "kr": "부드럽게 흐르고 있답니다."
  },
  "105": {
   "jp": "1bd84426",
   "kr": "샤리네를 지켜 주셔서"
  },
  "106": {
   "jp": "8ca8fa1c",
   "kr": "정말 감사합니다."
  },
  "107": {
   "jp": "830a2411",
   "kr": "다친 데는 이제 괜찮나요?"
  },
  "108": {
   "jp": "77612a7a",
   "kr": "너무 무리하지 마시고"
  },
  "109": {
   "jp": "73f370f7",
   "kr": "쉬는 편이 좋을 거예요."
  },
  "110": {
   "jp": "a9ae53b7",
   "kr": "어머, 손님이시군요."
  },
  "111": {
   "jp": "a1471bdc",
   "kr": "성 안을 구경하시나요?"
  },
  "112": {
   "jp": "1367b820",
   "kr": "이 나라는 누구든 반겨요."
  },
  "113": {
   "jp": "1b038f42",
   "kr": "부디, 천천히"
  },
  "114": {
   "jp": "4c3f3d76",
   "kr": "성 안을 둘러보세요."
  },
  "115": {
   "jp": "44eb631a",
   "kr": "아, 네, 네에."
  },
  "116": {
   "jp": "29162a7b",
   "kr": "감사합니다."
  },
  "117": {
   "jp": "094d6f97",
   "kr": "천천히 보세요."
  },
  "118": {
   "jp": "7e4f0f8f",
   "kr": "구린내 나네."
  },
  "119": {
   "jp": "8a018601",
   "kr": "이 방에서"
  },
  "120": {
   "jp": "3fae11e2",
   "kr": "며칠이나 목욕 안 한 놈의"
  },
  "121": {
   "jp": "0ab2626e",
   "kr": "냄새가 나는데…"
  },
  "122": {
   "jp": "9aedb6f3",
   "kr": "정말?"
  },
  "123": {
   "jp": "e5fc70c9",
   "kr": "이래 봬도"
  },
  "124": {
   "jp": "5d329437",
   "kr": "난 여러 나라를 누비는 도둑이야."
  },
  "125": {
   "jp": "df606942",
   "kr": "도둑의 감을 믿으라고."
  },
  "126": {
   "jp": "16dc469b",
   "kr": "자랑할 일은 아니라고 생각하는데."
  },
  "127": {
   "jp": "4fdd0bb5",
   "kr": "여기다."
  },
  "128": {
   "jp": "81c2940f",
   "kr": "쥬리오 일행은 상자를 봤다."
  },
  "129": {
   "jp": "8d68dee6",
   "kr": "시플의 현자가 갇혀 있었다."
  },
  "130": {
   "jp": "bcf4178d",
   "kr": "아야야야…"
  },
  "131": {
   "jp": "c725ffac",
   "kr": "허리가, 허리가..아프구먼…"
  },
  "132": {
   "jp": "3a3d8771",
   "kr": "괜찮으세요?"
  },
  "133": {
   "jp": "686a5e6d",
   "kr": "용케 알아채 주었네."
  },
  "134": {
   "jp": "75985b9e",
   "kr": "큰일 날 뻔했구먼."
  },
  "135": {
   "jp": "009dfa02",
   "kr": "크리스는 시플의 현자에게"
  },
  "136": {
   "jp": "e0cb55b6",
   "kr": "의 마법을 익혔다."
  },
  "137": {
   "jp": "30ec7adf",
   "kr": "시플 현자의 몸이 회복됐다."
  },
  "138": {
   "jp": "992e5fde",
   "kr": "챠펠 마법을 쓸 줄 아는가?"
  },
  "139": {
   "jp": "89754433",
   "kr": "이거, 여러모로 미안하네."
  },
  "140": {
   "jp": "0d545e50",
   "kr": "오오, 이러고 있을 순 없네."
  },
  "141": {
   "jp": "671e29f1",
   "kr": "샤리네가 걱정일세."
  },
  "142": {
   "jp": "9093b2e0",
   "kr": "어서 가서 살펴봐야겠네…"
  },
  "143": {
   "jp": "7af8cd2e",
   "kr": "저희는 순례하는 나그네예요."
  },
  "144": {
   "jp": "40ff0aee",
   "kr": "저희도 같이 갈게요."
  },
  "145": {
   "jp": "35c357a3",
   "kr": "그랬는가."
  },
  "146": {
   "jp": "3d3839e5",
   "kr": "그럼, 같이 가세."
  }
 }
}