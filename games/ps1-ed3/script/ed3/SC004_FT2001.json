{
 "archive": "/SCE0/SC004.DAT",
 "member": "..\\DATA\\FT2001.BIN",
 "lines": {
  "0": {
   "jp": "1f7ed7e9",
   "kr": "라그나"
  },
  "1": {
   "jp": "f38ce153",
   "kr": "여관 주점 잘테"
  },
  "2": {
   "jp": "a2edc7e4",
   "kr": "테너"
  },
  "3": {
   "jp": "36be2f98",
   "kr": "탄블"
  },
  "4": {
   "jp": "b8b5b0ca",
   "kr": "키릴"
  },
  "5": {
   "jp": "e8c8f502",
   "kr": "고메리"
  },
  "6": {
   "jp": "9e5f55ce",
   "kr": "레겐"
  },
  "7": {
   "jp": "cde20e65",
   "kr": "칸드의 눌루"
  },
  "8": {
   "jp": "95410ec2",
   "kr": "약방 리나"
  },
  "9": {
   "jp": "2156a869",
   "kr": "콜바 노인"
  },
  "10": {
   "jp": "87c571ec",
   "kr": "쥬프"
  },
  "11": {
   "jp": "5209efbe",
   "kr": "크룸"
  },
  "12": {
   "jp": "27ab0f1b",
   "kr": "로저"
  },
  "13": {
   "jp": "94c78bc6",
   "kr": "테스"
  },
  "14": {
   "jp": "28b450ac",
   "kr": "안내원 그리제"
  },
  "15": {
   "jp": "97100c24",
   "kr": "보롤 대장"
  },
  "16": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "17": {
   "jp": "058eac3e",
   "kr": "이봐! 잠깐 서라."
  },
  "18": {
   "jp": "5590ff80",
   "kr": "네?"
  },
  "19": {
   "jp": "480e2004",
   "kr": "이 마을에 탈주병이 숨어 있을지 모른다."
  },
  "20": {
   "jp": "3c47635e",
   "kr": "그 불한당이 잡힐 때까지"
  },
  "21": {
   "jp": "3b513328",
   "kr": "누구도 통행을 허가하지 말라는 명령이다."
  },
  "22": {
   "jp": "d7b7e1bf",
   "kr": "얘, 잠깐 기다려 주겠니?"
  },
  "23": {
   "jp": "90534653",
   "kr": "왜요?"
  },
  "24": {
   "jp": "86fcc81d",
   "kr": "너와는 상관없겠지만 상관의 명령으로"
  },
  "25": {
   "jp": "6155a6ab",
   "kr": "아무도 마을 밖에 내보내면 안 되거든."
  },
  "26": {
   "jp": "50b76e26",
   "kr": "미안하지만 참아 주렴."
  },
  "27": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "28": {
   "jp": "7f1945fa",
   "kr": "미안하지만 미성년에겐 술을 못 낸단다."
  },
  "29": {
   "jp": "7f14e157",
   "kr": "대신 닭뼈 수프라도 어떠니?"
  },
  "30": {
   "jp": "b3ce41c4",
   "kr": "손님들은 정말 잘 어울리는구나."
  },
  "31": {
   "jp": "e815952b",
   "kr": "재회를 축하하며 닭뼈 수프나 한 그릇 하렴."
  },
  "32": {
   "jp": "e717138f",
   "kr": "짝꿍인 여자애와는 만났니?"
  },
  "33": {
   "jp": "d755a037",
   "kr": "그것참 잘됐구나!"
  },
  "34": {
   "jp": "9d97a1ba",
   "kr": "기운 내라고 닭뼈 수프나 한 그릇 하렴."
  },
  "35": {
   "jp": "3bab5bf5",
   "kr": "짝꿍인 여자애와 떨어졌다고?"
  },
  "36": {
   "jp": "3f03b618",
   "kr": "분명 금방 찾을 거야."
  },
  "37": {
   "jp": "426cc8f1",
   "kr": "뭐 닭뼈 수프라도 한 그릇 하고 가렴."
  },
  "38": {
   "jp": "e8e7ddf6",
   "kr": "아가씨, 네가 사라졌을 때"
  },
  "39": {
   "jp": "7311a8d6",
   "kr": "이 사람 얼굴을 보여 주고 싶었어."
  },
  "40": {
   "jp": "bba14af9",
   "kr": "아주머니! 그만하세요."
  },
  "41": {
   "jp": "dcc53673",
   "kr": "찾았니?"
  },
  "42": {
   "jp": "511249d7",
   "kr": "그래, 만났구나. 마음이 놓였지?"
  },
  "43": {
   "jp": "58445b66",
   "kr": "나까지 안절부절못했단다."
  },
  "44": {
   "jp": "8d4bb79f",
   "kr": "아, 손님."
  },
  "45": {
   "jp": "f6f6a03f",
   "kr": "네 짝꿍인 듯한 애가 무기점 주인과"
  },
  "46": {
   "jp": "ba0e124c",
   "kr": "얘기하고 있었대."
  },
  "47": {
   "jp": "e8bf89b1",
   "kr": "방금 전이니까 어서 가 보렴."
  },
  "48": {
   "jp": "a00127a6",
   "kr": "같이 있던 여자애를 모르냐고?"
  },
  "49": {
   "jp": "51edf9ff",
   "kr": "붉은 머리에 기 센 아이던데…"
  },
  "50": {
   "jp": "fa5e00a4",
   "kr": "이 주점엔 안 온 것 같은데."
  },
  "51": {
   "jp": "b358b175",
   "kr": "보이면 꼭 알려 주마."
  },
  "52": {
   "jp": "462bb052",
   "kr": "고향을 떠나 혼자라 마음이 허전하겠지만"
  },
  "53": {
   "jp": "849fba5d",
   "kr": "사내잖니?"
  },
  "54": {
   "jp": "4a6e2919",
   "kr": "울면 안 된다."
  },
  "55": {
   "jp": "c2a02e19",
   "kr": "이 마을 무기점 영감은 고집이 세도"
  },
  "56": {
   "jp": "ab17c43b",
   "kr": "속은 참 좋은 사람 같아."
  },
  "57": {
   "jp": "94f91b89",
   "kr": "약자의 편이라고 소문이 자자하지."
  },
  "58": {
   "jp": "e9a701a0",
   "kr": "젊다는 건 좋구나."
  },
  "59": {
   "jp": "3448e3d7",
   "kr": "제 힘을 믿고 나아갈 수 있으니."
  },
  "60": {
   "jp": "f03361cd",
   "kr": "어서 오십시오. 말이 빚는 힘의 세계로."
  },
  "61": {
   "jp": "89255841",
   "kr": "어느 분께 전수할까요?"
  },
  "62": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "63": {
   "jp": "9511d337",
   "kr": "이시군요?"
  },
  "64": {
   "jp": "9030f7b5",
   "kr": "양심에 부끄럽지 않게 쓰십시오."
  },
  "65": {
   "jp": "aa928204",
   "kr": "또 들러 주십시오."
  },
  "66": {
   "jp": "ae2fc154",
   "kr": "지금이야 칸드와 챠펠이 갈라져 있습니다만"
  },
  "67": {
   "jp": "4dbf63e7",
   "kr": "본디는 같은 것이었습니다."
  },
  "68": {
   "jp": "4f045262",
   "kr": "어서 오세요."
  },
  "69": {
   "jp": "1e435714",
   "kr": "실례합니다. 약 있나요?"
  },
  "70": {
   "jp": "4e11075e",
   "kr": "감기인가요? 감기라면…"
  },
  "71": {
   "jp": "0a017548",
   "kr": "증상은 코감기예요? 기침이 안 멎어요?"
  },
  "72": {
   "jp": "bb629ba0",
   "kr": "아니면, 온몸이 나른하다든가."
  },
  "73": {
   "jp": "5590ff80",
   "kr": "네?"
  },
  "74": {
   "jp": "49d6798b",
   "kr": "저… 잘 듣는 걸로 주세요."
  },
  "75": {
   "jp": "75ca61b3",
   "kr": "딱 맞는 약이 있습니다."
  },
  "76": {
   "jp": "53e98ed3",
   "kr": "그런데 더 들 수 없으신 것 같네요."
  },
  "77": {
   "jp": "1eeb0005",
   "kr": "뭔가 처분해 주시겠어요?"
  },
  "78": {
   "jp": "52550325",
   "kr": "네, 이걸 받으세요."
  },
  "79": {
   "jp": "ee93304e",
   "kr": "입니다."
  },
  "80": {
   "jp": "9db782e1",
   "kr": "몸조리 잘하세요."
  },
  "81": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는 "
  },
  "82": {
   "jp": "4d570535",
   "kr": "을(를) 샀다."
  },
  "83": {
   "jp": "81283eeb",
   "kr": "감기는 얼른 나으셔야죠."
  },
  "84": {
   "jp": "9db782e1",
   "kr": "몸조리 잘하세요."
  },
  "85": {
   "jp": "aef4994e",
   "kr": "어서 오세요. 여기는 약방입니다."
  },
  "86": {
   "jp": "156c3c34",
   "kr": "어떤 약이 필요하신가요?"
  },
  "87": {
   "jp": "35f946e9",
   "kr": "엇, 전 건강하니까 약 같은 건"
  },
  "88": {
   "jp": "2e33dd9c",
   "kr": "필요 없어요."
  },
  "89": {
   "jp": "c1bfee78",
   "kr": "약초는 조합하는 방법에 따라"
  },
  "90": {
   "jp": "d76e4a20",
   "kr": "갖가지 효과를 얻습니다."
  },
  "91": {
   "jp": "e7e94359",
   "kr": "이것도 일종의 마법일지 모르죠."
  },
  "92": {
   "jp": "ae5e231f",
   "kr": "이번 징병은 아무래도 불길한 예감이구나."
  },
  "93": {
   "jp": "9a308389",
   "kr": "루돌프 국왕의 좋은 상담역이자"
  },
  "94": {
   "jp": "022898a2",
   "kr": "폴티아 제일가는 검사이기도 한 듀르젤 님이"
  },
  "95": {
   "jp": "9c27bd57",
   "kr": "말려 주시면 좋으련만."
  },
  "96": {
   "jp": "aad16827",
   "kr": "하지만"
  },
  "97": {
   "jp": "f93941b7",
   "kr": "듀르젤 님은"
  },
  "98": {
   "jp": "208d2041",
   "kr": "측근 레바스 님과 뜻이 안 맞는 모양이야."
  },
  "99": {
   "jp": "fed1a864",
   "kr": "어려운 일이로구나."
  },
  "100": {
   "jp": "3d4ebb99",
   "kr": "허크 씨도 마녀나 마법에 빠져 있지 말고"
  },
  "101": {
   "jp": "8786fadb",
   "kr": "얼른 색시나 얻으면 좋을 텐데."
  },
  "102": {
   "jp": "85fb28fe",
   "kr": "허크를 찾아왔니?"
  },
  "103": {
   "jp": "d6c4ed8a",
   "kr": "아아, 그 녀석과는 오랜 지인이지만"
  },
  "104": {
   "jp": "d7132e06",
   "kr": "그렇게까지 별난 놈은 둘도 없단다."
  },
  "105": {
   "jp": "0acc5e49",
   "kr": "탐구심은 남자의 보배지만"
  },
  "106": {
   "jp": "0cc1f1ef",
   "kr": "허크는 그게 인생을 망쳐 놨으니 말이야."
  },
  "107": {
   "jp": "dda177b8",
   "kr": "빚쟁이가 허크한테?"
  },
  "108": {
   "jp": "8409517d",
   "kr": "그거라면 늘 있는 일이야."
  },
  "109": {
   "jp": "851b4d58",
   "kr": "허크는 하얀마녀를 연구한다면서"
  },
  "110": {
   "jp": "7add9df6",
   "kr": "제대로 일한 적이라곤 없단다."
  },
  "111": {
   "jp": "36cdd551",
   "kr": "이제 곧 매발톱호에 탈 수 있다나 봐."
  },
  "112": {
   "jp": "2251bdff",
   "kr": "그렇게 큰 배라니 기대되네."
  },
  "113": {
   "jp": "5d9647c4",
   "kr": "같이 여행하던 여자애가 사라졌다고?"
  },
  "114": {
   "jp": "17501a7b",
   "kr": "후후, 분명 네가 찾아 주길 바라는 거야."
  },
  "115": {
   "jp": "0aba8187",
   "kr": "여자애란 그런 데가 있으니까."
  },
  "116": {
   "jp": "77216f6f",
   "kr": "순례 여행?"
  },
  "117": {
   "jp": "1da226a8",
   "kr": "낭만적인 풍습이네."
  },
  "118": {
   "jp": "d9ff84b5",
   "kr": "네, 어서 오세요."
  },
  "119": {
   "jp": "126c635e",
   "kr": "매발톱호를 이용하시나요?"
  },
  "120": {
   "jp": "e1db1a28",
   "kr": "지금 다음 항해를 준비 중입니다."
  },
  "121": {
   "jp": "326a00a7",
   "kr": "출항까지 잠시만 기다려 주세요."
  },
  "122": {
   "jp": "126c635e",
   "kr": "매발톱호를 이용하시나요?"
  },
  "123": {
   "jp": "93ee8db0",
   "kr": "곧 출항합니다."
  },
  "124": {
   "jp": "76dccf29",
   "kr": "타실 거라면 서둘러 주세요."
  },
  "125": {
   "jp": "bcf10944",
   "kr": "푸른 책등의 책이 있습니다."
  },
  "126": {
   "jp": "c6c5b1eb",
   "kr": "읽어 보시겠습니까?"
  },
  "127": {
   "jp": "ddc9def3",
   "kr": "《여검사 사피 제1권 두 검사》"
  },
  "128": {
   "jp": "b994edba",
   "kr": "그녀가 왜 사피라 불리는지"
  },
  "129": {
   "jp": "717b98ea",
   "kr": "아는 사람은 드물다."
  },
  "130": {
   "jp": "bf989540",
   "kr": "눈동자가 사파이어처럼 푸르러서라고"
  },
  "131": {
   "jp": "c52bf7e2",
   "kr": "말하는 이도 있고"
  },
  "132": {
   "jp": "c922a848",
   "kr": "마음이 보석처럼 차갑다 수군대는 이도 있다."
  },
  "133": {
   "jp": "36ffc3a0",
   "kr": "그녀의 레이피어는 바람보다 붙잡기 어렵고"
  },
  "134": {
   "jp": "38b1cb59",
   "kr": "태양의 존재보다 확실했다."
  },
  "135": {
   "jp": "96771e3d",
   "kr": "남자 검사 사이에 섞여도"
  },
  "136": {
   "jp": "9d7bb90a",
   "kr": "그녀의 기술은 뒤처지기는커녕"
  },
  "137": {
   "jp": "a228421b",
   "kr": "오히려 더욱 빛나는 듯했다."
  },
  "138": {
   "jp": "fa666703",
   "kr": "그런 여검사 사피가"
  },
  "139": {
   "jp": "51e6150f",
   "kr": "유일한 호적수로 인정한 인물이 있었다."
  },
  "140": {
   "jp": "226badb7",
   "kr": "발하라의 검사 블러드."
  },
  "141": {
   "jp": "d9e8dc40",
   "kr": "이 두 검사의 명성은 왕족에게까지 닿았고"
  },
  "142": {
   "jp": "0d783b9d",
   "kr": "그들의 검은 두려움을 몰랐다."
  },
  "143": {
   "jp": "8f869d61",
   "kr": "서로 만나기 전까지는…"
  },
  "144": {
   "jp": "aa275a73",
   "kr": "재미있었어?"
  },
  "145": {
   "jp": "23659733",
   "kr": "그 책은 전부 아홉 권인데"
  },
  "146": {
   "jp": "2c7fab7b",
   "kr": "좀처럼 구할 수가 없어."
  },
  "147": {
   "jp": "7846c167",
   "kr": "또 읽고 싶어지면"
  },
  "148": {
   "jp": "5162594a",
   "kr": "언제든 읽어도 좋아."
  },
  "149": {
   "jp": "91037475",
   "kr": "지금은 괜찮아요."
  },
  "150": {
   "jp": "c0a2b209",
   "kr": "나도 사실은 매발톱호를 타고"
  },
  "151": {
   "jp": "aac71f6d",
   "kr": "여행하고 싶어."
  },
  "152": {
   "jp": "0190b782",
   "kr": "하지만 내가 떠나면 치켓토 파는 사람이"
  },
  "153": {
   "jp": "c7bc4c23",
   "kr": "없어지잖아."
  },
  "154": {
   "jp": "f91d58a0",
   "kr": "내 몫까지 뱃길을 만끽하고 와."
  },
  "155": {
   "jp": "42a705c4",
   "kr": "탈주병이 이 마을에 있다던데…"
  },
  "156": {
   "jp": "291c0a29",
