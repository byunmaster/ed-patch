  },
  "15": {
   "jp": "3790288b",
   "kr": "챠펠의 에바르"
  },
  "16": {
   "jp": "ebf2daeb",
   "kr": "무기상 부레"
  },
  "17": {
   "jp": "1eceebc2",
   "kr": "도구상 이스리"
  },
  "18": {
   "jp": "a3856163",
   "kr": "어라, 유적을 빠져나온 거냐?"
  },
  "19": {
   "jp": "a1c5c307",
   "kr": "용케 길을 안 잃었군."
  },
  "20": {
   "jp": "5b8479f0",
   "kr": "잃었어."
  },
  "21": {
   "jp": "79757294",
   "kr": "그렇겠지."
  },
  "22": {
   "jp": "26eb5d06",
   "kr": "그 유적은 길이 복잡하거든."
  },
  "23": {
   "jp": "a1b49e2d",
   "kr": "어서 오렴."
  },
  "24": {
   "jp": "cd6e71cc",
   "kr": "여기는 자유무역 도시 기드넬이다."
  },
  "25": {
   "jp": "cd6e71cc",
   "kr": "여기는 자유무역 도시 기드넬이다."
  },
  "26": {
   "jp": "e01420df",
   "kr": "뭐, 천천히 둘러보고 가라."
  },
  "27": {
   "jp": "33098cf8",
   "kr": "남쪽으로 가면"
  },
  "28": {
   "jp": "299ed6b0",
   "kr": "유적 지나 바라카 마을이다."
  },
  "29": {
   "jp": "92eea1ed",
   "kr": "아, 그렇군요."
  },
  "30": {
   "jp": "6008c44c",
   "kr": "유적 쪽에서 나오면"
  },
  "31": {
   "jp": "ed126a9a",
   "kr": "여기로 나오네요."
  },
  "32": {
   "jp": "bfe7fca2",
   "kr": "이쪽은 유적을 지나 바라카로 가는 길이다."
  },
  "33": {
   "jp": "c248d61c",
   "kr": "뭐, 천천히 둘러보고 가게."
  },
  "34": {
   "jp": "b62d9f6b",
   "kr": "여기서 나가면 서쪽 가도를 지나"
  },
  "35": {
   "jp": "5a77fa19",
   "kr": "바라카로 이어진다."
  },
  "36": {
   "jp": "62e759b9",
   "kr": "서쪽 가도는"
  },
  "37": {
   "jp": "65104a31",
   "kr": "여기로 이어져 있었군."
  },
  "38": {
   "jp": "fec37992",
   "kr": "이 길은 바라카로 통하는 서쪽 길이다."
  },
  "39": {
   "jp": "8ba16212",
   "kr": "이쪽으로 바라카에 돌아가도,"
  },
  "40": {
   "jp": "45249ebe",
   "kr": "바라카엔 들여보내 주지 않겠지."
  },
  "41": {
   "jp": "ed306d71",
   "kr": "뭐냐?"
  },
  "42": {
   "jp": "a473c2a9",
   "kr": "이 앞은 우르기드 님 저택이다."
  },
  "43": {
   "jp": "22cedede",
   "kr": "일반인의 출입은 금지되어 있다."
  },
  "44": {
   "jp": "db42a32b",
   "kr": "진귀한 공물이라도 있으면"
  },
  "45": {
   "jp": "90db7804",
   "kr": "들여보내도 상관없다만, 우르기드 님은"
  },
  "46": {
   "jp": "d73f1082",
   "kr": "어지간한 물건엔 안 기뻐하신다."
  },
  "47": {
   "jp": "0ee8a40f",
   "kr": "특별히 우르기드 님이"
  },
  "48": {
   "jp": "b7235739",
   "kr": "기뻐하실 만한 물건은 없는 모양이군."
  },
  "49": {
   "jp": "5563e6ed",
   "kr": "그럼 여기 통행 허가는 못 준다."
  },
  "50": {
   "jp": "df4332bc",
   "kr": "나는 우르기드 님 저택을 지키는"
  },
  "51": {
   "jp": "cd2dffd3",
   "kr": "자랑스러운 문지기다."
  },
  "52": {
   "jp": "cbd1d6fd",
   "kr": "지나고 싶으면 지나가라."
  },
  "53": {
   "jp": "f3422e83",
   "kr": "이 나라는 자유무역의 나라다."
  },
  "54": {
   "jp": "961f80dc",
   "kr": "사람의 왕래는 모두 자유다."
  },
  "55": {
   "jp": "7e6eb70a",
   "kr": "크리스를 구해낼 때까지"
  },
  "56": {
   "jp": "f697ebda",
   "kr": "기드넬에서 나갈 수는 없어."
  },
  "57": {
   "jp": "d8440f73",
   "kr": "이 마을은"
  },
  "58": {
   "jp": "682f6d8d",
   "kr": "늘 노점에 상품이 가득 늘어서 있어서"
  },
  "59": {
   "jp": "a4c019fd",
   "kr": "정말 눈이 팔려 버려요."
  },
  "60": {
   "jp": "0186d03d",
   "kr": "저녁 반찬은 뭘로 할까요…"
  },
  "61": {
   "jp": "6ff88a01",
   "kr": "대단하지."
  },
  "62": {
   "jp": "d94a395a",
   "kr": "기드넬은 사막 한가운데 있는 마을인데도"
  },
  "63": {
   "jp": "ec9d7b51",
   "kr": "늘 이렇게 물건이 넘쳐나."
  },
  "64": {
   "jp": "fd1e6795",
   "kr": "우르기드의 힘은 대단한 거라니까."
  },
  "65": {
   "jp": "8d6ae72b",
   "kr": "여기를 걸으면"
  },
  "66": {
   "jp": "6484ecb0",
   "kr": "웬만한 물건은 뭐든 다 있어."
  },
  "67": {
   "jp": "b1138230",
   "kr": "역시 자유무역 도시야."
  },
  "68": {
   "jp": "b30add46",
   "kr": "맛있어 보이는 건 안 팔려나…"
  },
  "69": {
   "jp": "f8f18fe1",
   "kr": "설마, 무화과 같은 게"
  },
  "70": {
   "jp": "58adaf11",
   "kr": "노점에는 안 늘어서 있겠지…"
  },
  "71": {
   "jp": "63a6ae6f",
   "kr": "물건은 잔뜩 파는데"
  },
  "72": {
   "jp": "61796868",
   "kr": "요즘,"
  },
  "73": {
   "jp": "c0b903a7",
   "kr": "무화과만은 안 나와 있단 말이지."
  },
  "74": {
   "jp": "b4007877",
   "kr": "어지간히 흉작인 모양이야."
  },
  "75": {
   "jp": "be6a748f",
   "kr": "아〜아, 무화과 먹고 싶다아."
  },
  "76": {
   "jp": "245ac4a5",
   "kr": "바라카에서 칸다타라는 녀석이"
  },
  "77": {
   "jp": "f5f0b2e7",
   "kr": "우르기드의 저택에 와 있다더군."
  },
  "78": {
   "jp": "9d8ef546",
   "kr": "어차피 못된 일 모의라도"
  },
  "79": {
   "jp": "d1291231",
   "kr": "하고 있겠지…"
  },
  "80": {
   "jp": "0a153964",
   "kr": "부자 중에 좋은 놈은 별로 없으니까."
  },
  "81": {
   "jp": "e17d4e3e",
   "kr": "너희도 조심해."
  },
  "82": {
   "jp": "4e689eb8",
   "kr": "우르기드의 저택에 들어가려면,"
  },
  "83": {
   "jp": "57518afb",
   "kr": "뭔가 공물을 가져가야만 해."
  },
  "84": {
   "jp": "36e7c253",
   "kr": "욕심 사나운 얄미운 놈이지."
  },
  "85": {
   "jp": "eadae5dd",
   "kr": "내가 험담한 건"
  },
  "86": {
   "jp": "cdaf72f5",
   "kr": "비밀로 해 주세요."
  },
  "87": {
   "jp": "28367dca",
   "kr": "병사한테라도 알려지면 큰일이에요."
  },
  "88": {
   "jp": "acc9a574",
   "kr": "어서 오십시오."
  },
  "89": {
   "jp": "4efab84b",
   "kr": "호상 우르기드 직영 도구 도매상이올시다."
  },
  "90": {
   "jp": "9db25719",
   "kr": "어느 가게 분이신지요?"
  },
  "91": {
   "jp": "7d9ea345",
   "kr": "네? 가게…?"
  },
  "92": {
   "jp": "0158a49b",
   "kr": "이런, 가게 분이 아니십니까?"
  },
  "93": {
   "jp": "027cde55",
   "kr": "여기는, 가게끼리 거래하는 도매상이라"
  },
  "94": {
   "jp": "978d17ed",
   "kr": "소매는 하지 않습니다."
  },
  "95": {
   "jp": "6ae9a898",
   "kr": "허, 허, 허, 잘못 찾으셨군요."
  },
  "96": {
   "jp": "8118fab6",
   "kr": "그럼, 밖에 써 놓든가."
  },
  "97": {
   "jp": "a486a2ff",
   "kr": "아이고, 무서워라, 무서워라…"
  },
  "98": {
   "jp": "93914999",
   "kr": "여기는 소매점 분 외에는"
  },
  "99": {
   "jp": "bfcca998",
   "kr": "거래를 하지 않습니다."
  },
  "100": {
   "jp": "4c48ea92",
   "kr": "일반 손님용 도구상이라면"
  },
  "101": {
   "jp": "8951afd7",
   "kr": "마을 북서쪽에 있습니다."
  },
  "102": {
   "jp": "0867bb9f",
   "kr": "양해 바랍니다."
  },
  "103": {
   "jp": "19dd68c0",
   "kr": "여어, 어서 오게."
  },
  "104": {
   "jp": "94944348",
   "kr": "자네들도 매입하러 왔는가?"
  },
  "105": {
   "jp": "55119a6b",
   "kr": "숙소라면 방 하나 비었으니"
  },
  "106": {
   "jp": "fb075d56",
   "kr": "마음대로 쓰게."
  },
  "107": {
   "jp": "219496bc",
   "kr": "엇, 공짜로 묵어도 돼?"
  },
  "108": {
   "jp": "649711c6",
   "kr": "여기 주점 겸 여관은 상인의 매입용으로"
  },
  "109": {
   "jp": "1601a085",
   "kr": "마련한 거니까."
  },
  "110": {
   "jp": "223927e2",
   "kr": "공짜로 묵게 해 줘도"
  },
  "111": {
   "jp": "73b4cb97",
   "kr": "내 배가 아픈 건 아니야. 상관없어."
  },
  "112": {
   "jp": "55119a6b",
   "kr": "숙소라면 방 하나 비었으니"
  },
  "113": {
   "jp": "fb075d56",
   "kr": "마음대로 쓰게."
  },
  "114": {
   "jp": "363e0fd7",
   "kr": "근데, 빨리 크리스를 구해야 해."
  },
  "115": {
   "jp": "c648bd96",
   "kr": "하지만, 안에 들어가려면"
  },
  "116": {
   "jp": "680edac4",
   "kr": "공물이 있어야 하니까."
  },
  "117": {
   "jp": "113d21c2",
   "kr": "일단, 방에서 느긋하게"
  },
  "118": {
   "jp": "48b6ed03",
   "kr": "공물을 뭘로 할지 생각할까."
  },
  "119": {
   "jp": "7440fe30",
   "kr": "그러네."
  },
  "120": {
   "jp": "d304969d",
   "kr": "그럼, 사양 않고 쓰겠어."
  },
  "121": {
   "jp": "363e0fd7",
   "kr": "근데, 빨리 크리스를 구해야 해."
  },
  "122": {
   "jp": "758905bb",
   "kr": "그러세."
  },
  "123": {
   "jp": "5cd7e537",
   "kr": "여어, 자네들도 매입하러 온 건가?"
  },
  "124": {
   "jp": "12d5308f",
   "kr": "기드넬은 시장이 발달해 있으니까."
  },
  "125": {
   "jp": "96eae63c",
   "kr": "상품 매입이 편해서 정말 고마워."
  },
  "126": {
   "jp": "551aa027",
   "kr": "매입 상담이라면 들어주지."
  },
  "127": {
   "jp": "dbbd4742",
   "kr": "이래 봬도, 난 보는 눈이 있거든."
  },
  "128": {
   "jp": "367cc0ab",
   "kr": "난 도구를 매입하러 왔어."
  },
  "129": {
   "jp": "1a1946c5",
   "kr": "이 마을엔 도매상이 있어서 정말 도움이 돼."
  },
  "130": {
   "jp": "6cc10c2b",
   "kr": "여기 도매상"
  },
  "131": {
   "jp": "1baef038",
   "kr": "조금만 더 깎아 주면"
  },
  "132": {
   "jp": "2ff91e61",
   "kr": "더 바랄 게 없을 텐데."
  },
  "133": {
   "jp": "0ee6df6b",
   "kr": "엇, 뭐야?"
  },
  "134": {
   "jp": "3a33c373",
   "kr": "우와앗…!"
  },
  "135": {
   "jp": "d4c2e94e",
   "kr": "뭐야."
  },
  "136": {
   "jp": "182436ba",
   "kr": "지금, 앉은 채로"
  },
  "137": {
   "jp": "2bf1dece",
   "kr": "휙,"
  },
  "138": {
   "jp": "e3ae6965",
   "kr": "이쪽을 봤죠?"
  },
  "139": {
   "jp": "7bdf8908",
   "kr": "아아, 이거?"
  },
  "140": {
   "jp": "a32923e4",
   "kr": "굉장해…"
  },
  "141": {
   "jp": "36093851",
   "kr": "이 근방에선 의자를 별로 안 쓰거든."
  },
  "142": {
   "jp": "4821da41",
   "kr": "그래서 어릴 적부터"
  },
  "143": {
   "jp": "1af530c2",
   "kr": "이런 놀이를 자주 하지."
  },
  "144": {
   "jp": "8555bd54",
   "kr": "으으윽…"
  },
  "145": {
   "jp": "5a5d7aae",
   "kr": "갑자기 돌았더니 속이 안 좋아졌어."
  },
  "146": {
   "jp": "e16dcbb3",
   "kr": "미안, 좀 내버려 둬."
  },
  "147": {
   "jp": "7dfc75f0",
   "kr": "어서 오쇼, 어서 오쇼!"
  },
  "148": {
   "jp": "f8cf3c87",
   "kr": "들러 보쇼, 구경하쇼."
  },
  "149": {
   "jp": "29f1ab12",
   "kr": "횡재할 물건이 한가득이야!"
  },
  "150": {
   "jp": "f2515ff7",
   "kr": "네〜, 네〜, 어서 오세요오!"
  },
  "151": {
   "jp": "6421f41f",
   "kr": "신선한 채소와 과일부터 무기까지,"
  },
  "152": {
   "jp": "272ade39",
   "kr": "뭐든 다 있어요오!"
  },
  "153": {
   "jp": "78cd58b3",
   "kr": "자, 자, 자, 자!"
  },
  "154": {
   "jp": "2ff5b238",
   "kr": "볼일도 없고 바쁘지 않은 분은"
  },
  "155": {
   "jp": "d961ca12",
   "kr": "들러 보시오, 구경하시오!"
  },
  "156": {
   "jp": "e059261a",
   "kr": "남국에서 온 망고부터"
  },
  "157": {
   "jp": "54daa1d3",
   "kr": "탱글, 탱글한 파파야까지,"
  },
  "158": {
   "jp": "7c3129e6",
   "kr": "세계의 과일 총집합!"
  },
  "159": {
   "jp": "9746ac38",
   "kr": "거기 형씨, 구경하시오!"
  },
  "160": {
   "jp": "691c0ef7",
   "kr": "보고 싶다, 보고 싶은 건 여자애다!"
  },
  "161": {
   "jp": "cf5123f0",
