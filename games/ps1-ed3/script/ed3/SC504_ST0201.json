{
 "archive": "/SCE5/SC504.DAT",
 "member": "..\\DATA\\ST0201.BIN",
 "lines": {
  "0": {
   "jp": "57e30d30",
   "kr": "홀크"
  },
  "1": {
   "jp": "b9c84b08",
   "kr": "캐라크 저택"
  },
  "2": {
   "jp": "ff8af593",
   "kr": "홀크 병사"
  },
  "3": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "4": {
   "jp": "75e9e435",
   "kr": "캐라크 왕"
  },
  "5": {
   "jp": "42a37312",
   "kr": "집사 오펠"
  },
  "6": {
   "jp": "74acf54e",
   "kr": "캐라크 왕께서는 이 방에 계신다."
  },
  "7": {
   "jp": "f55a6e5d",
   "kr": "아무쪼록 잘 부탁한다."
  },
  "8": {
   "jp": "d06b3aa8",
   "kr": "처음 뵈어요, 임금님."
  },
  "9": {
   "jp": "9a9164f7",
   "kr": "오."
  },
  "10": {
   "jp": "609c6557",
   "kr": "그대들이 앰비쉬 사자인가?"
  },
  "11": {
   "jp": "6acf4e30",
   "kr": "실은요"
  },
  "12": {
   "jp": "e4e9a49d",
   "kr": "사자라고 할 건 못 돼요."
  },
  "13": {
   "jp": "41df97fc",
   "kr": "알프 왕과 아는 사이인 건 정말이에요."
  },
  "14": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "15": {
   "jp": "a074e0a4",
   "kr": "실은 곤란한 일이 있단다."
  },
  "16": {
   "jp": "aca630d4",
   "kr": "곤란한 일이라뇨?"
  },
  "17": {
   "jp": "b3e8bc20",
   "kr": "자, 안으로 들어오렴."
  },
  "18": {
   "jp": "9405a1c6",
   "kr": "한 달쯤 전의 일이다."
  },
  "19": {
   "jp": "4c244df7",
   "kr": "베라트라는 나그네가 이 저택을 찾아왔단다."
  },
  "20": {
   "jp": "44ea6efc",
   "kr": "그자가 말하기를 북쪽 하이젠의 형이"
  },
  "21": {
   "jp": "83d8932d",
   "kr": "제 영토를 넓히려고"
  },
  "22": {
   "jp": "78dbca37",
   "kr": "이 홀크를 노리고 있다는 거다."
  },
  "23": {
   "jp": "463a2760",
   "kr": "그럴 리 없어요."
  },
  "24": {
   "jp": "53e06005",
   "kr": "저도 쥬리오 씨도"
  },
  "25": {
   "jp": "776fa4a4",
   "kr": "북부를 지나왔지만"
  },
  "26": {
   "jp": "9314fca8",
   "kr": "그런 기색은 조금도 없었는걸요."
  },
  "27": {
   "jp": "084ca32d",
   "kr": "나도 그리 생각한다만."
  },
  "28": {
   "jp": "b167d913",
   "kr": "아무래도 그런 말을 듣고 나면"
  },
  "29": {
   "jp": "8be3dc23",
   "kr": "그만 마음이 쓰여서 말이다."
  },
  "30": {
   "jp": "2993b5dc",
   "kr": "베라트가 말하는 대로"
  },
  "31": {
   "jp": "24239fe8",
   "kr": "혹시 쳐들어올 때를 대비해"
  },
  "32": {
   "jp": "8aad6bba",
   "kr": "준비를 시작해 버렸다."
  },
  "33": {
   "jp": "11594d38",
   "kr": "준비라니"
  },
  "34": {
   "jp": "2ed5d45a",
   "kr": "혹시 전쟁 준비예요?"
  },
  "35": {
   "jp": "758d90ed",
   "kr": "거기까진 아니다만"
  },
  "36": {
   "jp": "ab51f73d",
   "kr": "남북 가도 루피나스 호숫가에"
  },
  "37": {
   "jp": "744bed10",
   "kr": "요새를 짓고 있다."
  },
  "38": {
   "jp": "4138fd6e",
   "kr": "요새를 짓는 건 좋지 않다고 생각해요."
  },
  "39": {
   "jp": "344232cd",
   "kr": "그런 짓 하면"
  },
  "40": {
   "jp": "dc21a6b5",
   "kr": "전쟁할 생각이 없어도"
  },
  "41": {
   "jp": "a53253a0",
   "kr": "전쟁이 돼 버려요."
  },
  "42": {
   "jp": "005edb69",
   "kr": "어째서?"
  },
  "43": {
   "jp": "1a749daf",
   "kr": "그치만 말이에요,"
  },
  "44": {
   "jp": "48234699",
   "kr": "만약 베라트란 사람 말이"
  },
  "45": {
   "jp": "ededfc77",
   "kr": "새빨간 거짓말이면 어쩔 거예요."
  },
  "46": {
   "jp": "947dcb3e",
   "kr": "북쪽 하이젠 임금님 입장에서는"
  },
  "47": {
   "jp": "fa83acfe",
   "kr": "나쁜 마음이 전혀 없는데도"
  },
  "48": {
   "jp": "32a0de15",
   "kr": "갑자기 가도에 요새가 세워지는 거잖아요."
  },
  "49": {
   "jp": "842a8d4e",
   "kr": "거꾸로 홀크 임금님을"
  },
  "50": {
   "jp": "2c975b3b",
   "kr": "수상하게 여기지 않을 수 없어요."
  },
  "51": {
   "jp": "b7c0b7d7",
   "kr": "분명 하이젠 임금님도"
  },
  "52": {
   "jp": "fdb41852",
   "kr": "서둘러 전쟁 준비를 시작하시겠죠."
  },
  "53": {
   "jp": "efc405b4",
   "kr": "그러면"
  },
  "54": {
   "jp": "4783b87f",
   "kr": "어느 쪽도 그럴 마음이 없어도"
  },
  "55": {
   "jp": "a53253a0",
   "kr": "전쟁이 돼 버려요."
  },
  "56": {
   "jp": "86df802d",
   "kr": "네, 쥬리오 씨."
  },
  "57": {
   "jp": "84ca2ca4",
   "kr": "이건 위험해요."
  },
  "58": {
   "jp": "c5a0150e",
   "kr": "임금님."
  },
  "59": {
   "jp": "542ed210",
   "kr": "그 베라트란 사람 수상해요."
  },
  "60": {
   "jp": "e78d46df",
   "kr": "실은 나도 이거 수상하지 않나 하고"
  },
  "61": {
   "jp": "61c0d797",
   "kr": "최근에야 느꼈단다."
  },
  "62": {
   "jp": "2ae63cf6",
   "kr": "요새 건설을 중지시키자고 말해 봤는데…"
  },
  "63": {
   "jp": "5af7ba70",
   "kr": "베라트 그 녀석 완전히 군사 행세를 하며"
  },
  "64": {
   "jp": "31bdd072",
   "kr": "내가 겁먹고 마음이 바뀔까 봐"
  },
  "65": {
   "jp": "026eeb58",
   "kr": "왕비를 인질처럼 요새로 데려가 버린 것이다."
  },
  "66": {
   "jp": "5587a1a5",
   "kr": "왕비님을요?"
  },
  "67": {
   "jp": "9199dcc1",
   "kr": "그렇단다…"
  },
  "68": {
   "jp": "49955dfd",
   "kr": "칼리 왕비는 요새에서 베라트에게"
  },
  "69": {
   "jp": "3b3980f3",
   "kr": "감금되어 있단다."
  },
  "70": {
   "jp": "9d350e03",
   "kr": "만약 내가 작전을 중지하면"
  },
  "71": {
   "jp": "5ab9f5d7",
   "kr": "베라트 그놈"
  },
  "72": {
   "jp": "326f6a82",
   "kr": "왕비에게 무슨 짓을 할지 모른다."
  },
  "73": {
   "jp": "87aa3ff1",
   "kr": "문제가 산더미야."
  },
  "74": {
   "jp": "1adfbedb",
   "kr": "우선 하이젠 임금님께"
  },
  "75": {
   "jp": "78799541",
   "kr": "홀크 쪽에 싸울 마음이 없다는 걸"
  },
  "76": {
   "jp": "651495c1",
   "kr": "제대로 전해 두지 않으면 안 되겠어요."
  },
  "77": {
   "jp": "766c9211",
   "kr": "물론 그런 일은 없다고 생각하지만"
  },
  "78": {
   "jp": "df9ba47e",
   "kr": "하이젠 임금님이 홀크로"
  },
  "79": {
   "jp": "69328394",
   "kr": "쳐들어올 셈인지도 확인해야 해요."
  },
  "80": {
   "jp": "9ade64c6",
   "kr": "그리고 왕비님도 구해 드려야 해요."
  },
  "81": {
   "jp": "51446b27",
   "kr": "베라트라는 분의 신원도"
  },
  "82": {
   "jp": "d3eca615",
   "kr": "확인해 두는 편이 좋겠어요."
  },
  "83": {
   "jp": "2ad3dc3e",
   "kr": "나는 북쪽 형과 싸울 마음 따위"
  },
  "84": {
   "jp": "0f0c0899",
   "kr": "털끝만큼도 없다."
  },
  "85": {
   "jp": "543da178",
   "kr": "뭔가 좋은 수는 없겠느냐?"
  },
  "86": {
   "jp": "7ca4433f",
   "kr": "임금님이 움직이면"
  },
  "87": {
   "jp": "d8200c5a",
   "kr": "베라트가 눈치채서"
  },
  "88": {
   "jp": "05789d68",
   "kr": "왕비님이 위험할지 몰라요."
  },
  "89": {
   "jp": "19874c1c",
   "kr": "겁주지 마."
  },
  "90": {
   "jp": "b7c2c496",
   "kr": "앰비쉬에 응원을 부탁하면"
  },
  "91": {
   "jp": "229643bc",
   "kr": "그거야말로 일이 커져서"
  },
  "92": {
   "jp": "5eac4807",
   "kr": "싸움이 돼 버리고요."
  },
  "93": {
   "jp": "1c53a6b6",
   "kr": "좋아, 북퓨엔테로 가 보자."
  },
  "94": {
   "jp": "2d50e2f8",
   "kr": "임금님은 그냥 여기 계세요."
  },
  "95": {
   "jp": "e22cca2b",
   "kr": "우리가 하이젠에 가서"
  },
  "96": {
   "jp": "8d39c1f2",
   "kr": "북쪽이 어떻게 되어 있는지"
  },
  "97": {
   "jp": "fa11a7ab",
   "kr": "확인하고 올 테니까요."
  },
  "98": {
   "jp": "9fd6f355",
   "kr": "만약 전쟁 준비를 시작했다면"
  },
  "99": {
   "jp": "3d117646",
   "kr": "사정을 말해 오해라고 전할게요."
  },
  "100": {
   "jp": "e5b5b5e8",
   "kr": "그렇게 해요."
  },
  "101": {
   "jp": "26fefa74",
   "kr": "에네톤 왕이시라면 저희 말을"
  },
  "102": {
   "jp": "d6027766",
   "kr": "믿어 주실 거예요."
  },
  "103": {
   "jp": "40053dd5",
   "kr": "캐라크 임금님."
  },
  "104": {
   "jp": "0ddcf996",
   "kr": "서쪽 가도를 지나게 해 주시면"
  },
  "105": {
   "jp": "4d67f310",
   "kr": "약초 캐는 짐승 길을 빠져나가"
  },
  "106": {
   "jp": "ad1cbc88",
   "kr": "루피나스 호수 요새를 피해 하이젠에 가요."
  },
  "107": {
   "jp": "525243ba",
   "kr": "베라트에게 들키지 않을 거예요."
  },
  "108": {
   "jp": "587a18b6",
   "kr": "알겠다."
  },
  "109": {
   "jp": "92e933ce",
   "kr": "너희가 서쪽 가도로 나갈 수 있도록"
  },
  "110": {
   "jp": "4b66528c",
   "kr": "출구 병사들에게 말해 두마."
  },
  "111": {
   "jp": "91d0eea8",
   "kr": "부디 부탁한다."
  },
  "112": {
   "jp": "8f5b17b9",
   "kr": "에네톤에게 이쪽이 싸울 마음이 없음을"
  },
  "113": {
   "jp": "40a08559",
   "kr": "전해 주려무나."
  },
  "114": {
   "jp": "8cf576eb",
   "kr": "베라트의 폭주는 어떻게든 막겠다."
  },
  "115": {
   "jp": "ee07d83f",
   "kr": "칼리 왕비의 구출은"
  },
  "116": {
   "jp": "11418433",
   "kr": "하이젠의 상황을 안 뒤에 해도 된다."
  },
  "117": {
   "jp": "7ceef850",
   "kr": "절대로 싸움을 일으키면 안 돼요."
  },
  "118": {
   "jp": "442962ca",
   "kr": "그래, 꼭 막아 보이마."
  },
  "119": {
   "jp": "1eaddbf3",
   "kr": "그렇지."
  },
  "120": {
   "jp": "d530301b",
   "kr": "그대들이 정식 홀크 사자임을"
  },
  "121": {
   "jp": "1b24269e",
   "kr": "증명할 친서를 쓰겠다."
  },
  "122": {
   "jp": "6324469c",
   "kr": "잠시 기다려 다오."
  },
  "123": {
   "jp": "eb7fbc3b",
   "kr": "이걸 형 에네톤에게 전해 다오."
  },
  "124": {
   "jp": "0a717432",
   "kr": "내 진짜 마음을"
  },
  "125": {
   "jp": "29d2e23c",
   "kr": "알아줄 것이다."
  },
  "126": {
   "jp": "136a87b6",
   "kr": "뭔가 버리지 않으면"
  },
  "127": {
   "jp": "4bcd0f1b",
   "kr": "더는 못 들겠어."
  },
  "128": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은 "
  },
  "129": {
   "jp": "6c9a91dc",
   "kr": "을(를) 받았다."
  },
  "130": {
   "jp": "82fead64",
   "kr": "그리고 병사들에게도 그대들 길을"
  },
  "131": {
   "jp": "01843032",
   "kr": "막지 말라 일러 두마."
  },
  "132": {
   "jp": "f758a9c5",
   "kr": "이봐."
  },
  "133": {
   "jp": "bb5b9761",
   "kr": "부르셨습니까."
  },
  "134": {
   "jp": "6dec39fe",
   "kr": "이들이 서쪽 가도로 하이젠에 갈 수 있도록"
  },
  "135": {
   "jp": "b4a63756",
   "kr": "손을 써 주지 않겠나?"
  },
  "136": {
   "jp": "8b9236cd",
   "kr": "예."
  },
  "137": {
   "jp": "916e88ee",
   "kr": "알겠습니다."
  },
  "138": {
   "jp": "328347fe",
   "kr": "그럼, 임금님."
  },
  "139": {
   "jp": "d7934470",
   "kr": "다녀올게요."
  },
  "140": {
   "jp": "8af7e680",
   "kr": "서, 설마 앰비쉬의 사자분이라곤"
  },
  "141": {
   "jp": "98fd9a8b",
   "kr": "몰랐던지라… 저기."
  },
  "142": {
   "jp": "553a5707",
   "kr": "약속하셨지요?"
  },
  "143": {
   "jp": "e8df31df",
   "kr": "분명 물구나무서서 세 번 돌아 준다고 했지?"
  },
  "144": {
   "jp": "5cb110ec",
   "kr": "약속한다고 했잖아요."
  },
  "145": {
   "jp": "b04d379b",
   "kr": "알았어요〜"
  },
  "146": {
   "jp": "40734986",
   "kr": "좀 물러나서 보고 있어요."
  },
  "147": {
   "jp": "359e7511",
   "kr": "이제 그만 좀 봐줘요."
  },
  "148": {
   "jp": "387d59ea",
   "kr": "임금님께 하이젠에 갈 사자를 부탁받았다고?"
  },
  "149": {
   "jp": "2b827849",
   "kr": "대단하잖아."
  },
  "150": {
   "jp": "00b9c46a",
   "kr": "나도 부탁하마."
  },
  "151": {
   "jp": "7dc69ad6",
   "kr": "아무래도 퓨엔테 형세가"
  },
  "152": {
   "jp": "d9f3d6ce",
   "kr": "심상찮아서 말이다."
  },
  "153": {
   "jp": "7c6a6354",
   "kr": "홀크는 우리가"
  },
  "154": {
   "jp": "908c5cbd",
   "kr": "단단히 지키고 있을 테니"
  },
  "155": {
   "jp": "afa991d3",
   "kr": "잘 부탁한다."
  },
  "156": {
   "jp": "b724494c",
   "kr": "세 번 돈다고 했어요."
  },
  "157": {
   "jp": "0e0215a3",
   "kr": "좀 봐줘요."
  },
  "158": {
   "jp": "52984233",
   "kr": "갑옷을 입은 채로 물구나무라니"
  },
  "159": {
   "jp": "a441c1f1",
   "kr": "보통은 못 해요."
  },
  "160": {
