{
 "archive": "/SCE8/SC805.DAT",
 "member": "..\\DATA\\FR7401.BIN",
 "lines": {
  "0": {
   "jp": "8ae5459a",
   "kr": "왕도 가도"
  },
  "1": {
   "jp": "44e784ce",
   "kr": "쥬리오 일행은 듀르젤의 편지를 열어 보았다."
  },
  "2": {
   "jp": "68d9f2d5",
   "kr": "《듀르젤의 편지》"
  },
  "3": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "4": {
   "jp": "98bdaaf2",
   "kr": "그리고, 크리스."
  },
  "5": {
   "jp": "c87b0957",
   "kr": "너희는 정말 잘해 주었다."
  },
  "6": {
   "jp": "d56d87e1",
   "kr": "자신들이 얼마나 훌륭하고"
  },
  "7": {
   "jp": "769c97f0",
   "kr": "좋은 일을 했는지 아직 실감 안 날지 모르나"
  },
  "8": {
   "jp": "829e064e",
   "kr": "너희는 정말 열심히 했다."
  },
  "9": {
   "jp": "a68964b4",
   "kr": "모두 너희 덕분이다. 감사한다."
  },
  "10": {
   "jp": "5f54d3cd",
   "kr": "이 나로 말하더라도"
  },
  "11": {
   "jp": "f6c268b0",
   "kr": "돌페스의 탑에 너희가 오지 않았다면"
  },
  "12": {
   "jp": "1c48ffbb",
   "kr": "설령 세계가 멸망한다 해도"
  },
  "13": {
   "jp": "02c332a4",
   "kr": "이 무거운 엉덩이를 들지 않았을 것이다."
  },
  "14": {
   "jp": "a68ba18c",
   "kr": "내가 생각해도 정말 꼴사납다."
  },
  "15": {
   "jp": "e80ccce7",
   "kr": "무슨 일이 있어도 굴하지 않고"
  },
  "16": {
   "jp": "2a19a502",
   "kr": "앞을 보며 사는 게 검사의 조건이라 하면서도"
  },
  "17": {
   "jp": "8ccb8c38",
   "kr": "정신 차리니 운명만 기다리는 늙은이였다."
  },
  "18": {
   "jp": "0fb918c3",
   "kr": "나를 궁정 검사의 귀감이라느니,"
  },
  "19": {
   "jp": "5528b191",
   "kr": "희대의 영웅이라느니 불러 주는 이도 있지만"
  },
  "20": {
   "jp": "376a0588",
   "kr": "그런 건 그럴듯한 착각일 뿐이다."
  },
  "21": {
   "jp": "50a4cef6",
   "kr": "내가 하던 궁정 검사라는 것은"
  },
  "22": {
   "jp": "160ebe94",
   "kr": "성의 관리보다 조금 나은 정도의 것이다."
  },
  "23": {
   "jp": "2e35e1fa",
   "kr": "뜻은 어느새 잊히고 정신 차리니 얽매임에"
  },
  "24": {
   "jp": "24d7d542",
   "kr": "묶여서 눈앞밖에 보이지 않게 된다."
  },
  "25": {
   "jp": "a901a995",
   "kr": "그렇게 되면 끝장이다."
  },
  "26": {
   "jp": "bdcf678b",
   "kr": "영웅이란 늘 사람들과 함께해야 한다고 본다."
  },
  "27": {
   "jp": "34c12fef",
   "kr": "그건 특정인의 속셈을 지키는 자도 아니고"
  },
  "28": {
   "jp": "6a18d867",
   "kr": "싸움으로 이름을 떨치는 무인도 아니다."
  },
  "29": {
   "jp": "6f5bfaf6",
   "kr": "누구보다 순수하게 약한 자의 마음을 알고"
  },
  "30": {
   "jp": "39e45952",
   "kr": "앞을 보며 계속 살아갈 수 있는 자일 게다."
  },
  "31": {
   "jp": "4045f529",
   "kr": "나 따위보다"
  },
  "32": {
   "jp": "833f74a2",
   "kr": "오히려 게르드나 너희야말로"
  },
  "33": {
   "jp": "70f6cc7d",
   "kr": "영웅이라 불리기에 어울린다."
  },
  "34": {
   "jp": "ee6acdef",
   "kr": "이 여행을 잊지 마라."
  },
  "35": {
   "jp": "91f7b198",
   "kr": "영웅의 마음을 계속 간직해라."
  },
  "36": {
   "jp": "301ff955",
   "kr": "모처럼 게르드와 너희가 지켜 낸 세계다."
  },
  "37": {
   "jp": "bec4797a",
   "kr": "잘못된 방향으로 나아가지 않게 하는 것도"
  },
  "38": {
   "jp": "3db2b121",
   "kr": "다음 세대를 짊어질 너희의 몫이다."
  },
  "39": {
   "jp": "a7424e39",
   "kr": "자, 이런 이야기가 있다."
  },
  "40": {
   "jp": "24d22558",
   "kr": "옛날이야기라도 읽는 셈 치고 읽어 다오."
  },
  "41": {
   "jp": "be59bdb1",
   "kr": "내가 아직 궁정 검사가 되기 전의 일이다."
  },
  "42": {
   "jp": "c0b0dc1c",
   "kr": "검사를 동경하던 나는"
  },
  "43": {
   "jp": "1d8e27a2",
   "kr": "무사 수행을 자처하며 여행을 이어 갔다."
  },
  "44": {
   "jp": "1658da24",
   "kr": "그러던 때다."
  },
  "45": {
   "jp": "d092e9e7",
   "kr": "돌아온 자 없는 마녀의 섬에서 홀로 돌아와"
  },
  "46": {
   "jp": "a309bd64",
   "kr": "마법의 도시 올도스를 연 대마도사 올테가가"
  },
  "47": {
   "jp": "6adbf791",
   "kr": "그 땅을 떠나 은거했다는 소문을 들었다."
  },
  "48": {
   "jp": "0ed31c4e",
   "kr": "전부터 올테가에게는 관심이 있었다."
  },
  "49": {
   "jp": "7c1f4497",
   "kr": "물론 마법과 검은 다루는 것이 다르지만"
  },
  "50": {
   "jp": "bc5be1eb",
   "kr": "올테가가 닦은 갖가지 마법 이야기는"
  },
  "51": {
   "jp": "283122e1",
   "kr": "검사가 수행하는 것과 닮은 구석이 있어서."
  },
  "52": {
   "jp": "85e81115",
   "kr": "올테가가 대성당에 있는 동안에는"
  },
  "53": {
   "jp": "e43d5410",
   "kr": "너무 황송해서 만나러 갈 수도 없었지만"
  },
  "54": {
   "jp": "4377fa0e",
   "kr": "은거했다면 얘기가 다르다. 나는 올테가의"
  },
  "55": {
   "jp": "10f1c733",
   "kr": "거처를 수소문해 산골 마을에 닿았다."
  },
  "56": {
   "jp": "7e97537f",
   "kr": "대마도사 올테가는 그곳에 있었다."
  },
  "57": {
   "jp": "0d85c96f",
   "kr": "혈기만 왕성하던 당시의 나에게도"
  },
  "58": {
   "jp": "18fb4908",
   "kr": "올테가는 다정하게 대해 주었다."
  },
  "59": {
   "jp": "8efb60f1",
   "kr": "나는 올테가에게 갖가지를 배웠다."
  },
  "60": {
   "jp": "743da1c2",
   "kr": "과연 내가 그것을 어디까지 살렸는지"
  },
  "61": {
   "jp": "523fe3aa",
   "kr": "지금에 와서도 의심스럽지만…"
  },
  "62": {
   "jp": "6a5b831f",
   "kr": "올테가를 마음의 스승으로 우러르는 관계는"
  },
  "63": {
   "jp": "b9f5b8db",
   "kr": "내가 루드성 검사가 된 뒤에도 계속됐다."
  },
  "64": {
   "jp": "fd8660b7",
   "kr": "이윽고 세월이 지나 이자벨이 나타나고"
  },
  "65": {
   "jp": "b278a366",
   "kr": "얼마 뒤에 게르드가 나타났다."
  },
  "66": {
   "jp": "1b2808e8",
   "kr": "이 경위는 전에 이야기한 대로다."
  },
  "67": {
   "jp": "a45f3541",
   "kr": "쓰러진 하얀마녀 곁에 지팡이 하나가 있었다."
  },
  "68": {
   "jp": "ff202007",
   "kr": "나에게는 그 남겨진 지팡이에"
  },
  "69": {
   "jp": "80e22171",
   "kr": "게르드가 세계를 구하려는 마음 같은 것이"
  },
  "70": {
   "jp": "3d368b6e",
   "kr": "담겨 있는 것처럼 여겨져 견딜 수 없었다."
  },
  "71": {
   "jp": "52e083d7",
   "kr": "나는 게르드를 묻은 뒤"
  },
  "72": {
   "jp": "23bfc84c",
   "kr": "게르드의 지팡이를 들고 올테가를 찾아갔다."
  },
  "73": {
   "jp": "d9626a53",
   "kr": "올테가는 그 지팡이를 보고 경악했다."
  },
  "74": {
   "jp": "54abcba8",
   "kr": "교묘히 힘을 봉했지만 지팡이에 담긴 힘은"
  },
  "75": {
   "jp": "85a97711",
   "kr": "예상을 훨씬 뛰어넘었던 것이다."
  },
  "76": {
   "jp": "fe641d13",
   "kr": "지팡이엔 게르드의 의지 자체가 스며 있었다."
  },
  "77": {
   "jp": "207fdcd0",
   "kr": "힘을 지닌 지팡이도 양날의 검과 같다."
  },
  "78": {
   "jp": "e664f55a",
   "kr": "써야 할 때, 써야 할 자가 쓰지 않으면"
  },
  "79": {
   "jp": "a00bf929",
   "kr": "힘은 저주라 불리게 된다."
  },
  "80": {
   "jp": "90c80fb3",
   "kr": "나는 올테가에게 게르드의 지팡이를 맡겼다."
  },
  "81": {
   "jp": "f9fffd97",
   "kr": "올테가는 가진 마법을 모조리 동원해"
  },
  "82": {
   "jp": "3963b392",
   "kr": "게르드의 지팡이를 봉인해 모양을 바꾸고"
  },
  "83": {
   "jp": "fd4df3e7",
   "kr": "힘이 쉽게 발동하지 않도록 손을 쓴 것이다."
  },
  "84": {
   "jp": "7aa51dd4",
   "kr": "그 지팡이를 크리스가 갖게 된 것이다."
  },
  "85": {
   "jp": "354ce29d",
   "kr": "게르드의 상념이 남은 게르드 언덕에서"
  },
  "86": {
   "jp": "e12ca36a",
   "kr": "은단검과 나란히 놓으면 지팡이가 발동하도록"
  },
  "87": {
   "jp": "1a1d7556",
   "kr": "해 준 것은 올테가다."
  },
  "88": {
   "jp": "c3f70428",
   "kr": "그 때문에 올테가는 마력을 거의 잃었다."
  },
  "89": {
   "jp": "4c95821f",
   "kr": "이로써 크리스의 지팡이가"
  },
  "90": {
   "jp": "bdc58edd",
   "kr": "왜 그런 힘을 발휘했는지"
  },
  "91": {
   "jp": "dddf01e3",
   "kr": "알아주었으리라 생각한다."
  },
  "92": {
   "jp": "9eb25b42",
   "kr": "이 이야기만은 꼭 전해 두고 싶었다."
  },
  "93": {
   "jp": "41f07938",
   "kr": "뭐, 어쨌든"
  },
  "94": {
   "jp": "9a72aa12",
   "kr": "너희는 순례 여행을 훌륭히 마쳤다."
  },
  "95": {
   "jp": "fbd1782f",
   "kr": "많은 마을도 보았고"
  },
  "96": {
   "jp": "65383bcc",
   "kr": "셀 수 없는 사람도 만났을 것이다."
  },
  "97": {
   "jp": "7fc4a7a0",
   "kr": "하지만 이것만은 말해 두겠다."
  },
  "98": {
   "jp": "f30d9eb7",
   "kr": "중요한 건 그 경험을 어떻게 받아들이고"
  },
  "99": {
   "jp": "73081891",
   "kr": "어떻게 앞으로의 생활에 살리느냐다."
  },
  "100": {
   "jp": "cbe89bdd",
   "kr": "아무리 귀중한 체험을 많이 해도"
  },
  "101": {
   "jp": "9efd652a",
   "kr": "자신의 인생에 살리지 못하면 의미가 없다."
  },
  "102": {
   "jp": "91f7b198",
   "kr": "영웅의 마음을 계속 간직해라."
  },
  "103": {
   "jp": "37f453c3",
   "kr": "알겠느냐, 훌륭한 어른이 되어라."
  },
  "104": {
   "jp": "2edcded3",
   "kr": "괜히 설교조가 돼 버려서 미안하구나."
  },
  "105": {
   "jp": "dac6c7a4",
   "kr": "늙은이의 푸념이라 여기고 용서해 다오."
  },
  "106": {
   "jp": "2b952faa",
   "kr": "긴 편지가 되고 말았다."
  },
  "107": {
   "jp": "98e85369",
   "kr": "이쯤에서 슬슬 마치도록 하자."
  },
  "108": {
   "jp": "473fa795",
   "kr": "아까 로디가 찾아왔다."
  },
  "109": {
   "jp": "9b716371",
   "kr": "너희를 배웅하고 나면"
  },
  "110": {
   "jp": "edc316ed",
   "kr": "약속대로 부탁을 들어 달라고 하더군."
  },
  "111": {
   "jp": "8bbb478e",
   "kr": "뭐,"
  },
  "112": {
   "jp": "006db351",
   "kr": "젊은 검사가 생각하는 건 짐작이 간다."
  },
  "113": {
   "jp": "0a1b69a7",
   "kr": "나도 그랬으니까."
  },
  "114": {
   "jp": "08213eeb",
   "kr": "쥬리오가 돌려준"
  },
  "115": {
   "jp": "3eb93873",
   "kr": "에스페란사가 쓸모 있을 것 같다."
  },
  "116": {
   "jp": "71e5a6ec",
   "kr": "나도 나이를 먹었다."
  },
  "117": {
   "jp": "344643b9",
   "kr": "노인네가 주책이라 놀림 받는 것도 분하니까."
  },
  "118": {
   "jp": "1b197a6a",
   "kr": "이쯤에서 은퇴하기에는 좋은 기회겠지."
  },
  "119": {
   "jp": "dd890a57",
   "kr": "잘 지내라."
  },
  "120": {
   "jp": "dff533ca",
   "kr": "다음에 만날 일이 있으면"
  },
  "121": {
   "jp": "83665828",
   "kr": "함께 술이라도 한잔하자꾸나."
  },
  "122": {
   "jp": "637b9f76",
   "kr": "듀르젤"
  }
 }
}