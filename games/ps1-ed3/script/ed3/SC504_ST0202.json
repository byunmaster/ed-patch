{
 "archive": "/SCE5/SC504.DAT",
 "member": "..\\DATA\\ST0202.BIN",
 "lines": {
  "0": {
   "jp": "57e30d30",
   "kr": "홀크"
  },
  "1": {
   "jp": "b9c84b08",
   "kr": "캐라크 저택"
  },
  "2": {
   "jp": "ff8af593",
   "kr": "홀크 병사"
  },
  "3": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "4": {
   "jp": "75e9e435",
   "kr": "캐라크 왕"
  },
  "5": {
   "jp": "845a2ab1",
   "kr": "칼리 왕비"
  },
  "6": {
   "jp": "42a37312",
   "kr": "집사 오펠"
  },
  "7": {
   "jp": "f77a8566",
   "kr": "정말로 그대들에게 신세를 졌다."
  },
  "8": {
   "jp": "d678b6da",
   "kr": "고맙다."
  },
  "9": {
   "jp": "e6c74730",
   "kr": "즐거웠어요."
  },
  "10": {
   "jp": "7d5a58e6",
   "kr": "이번 일은 정말로 좋은 공부가 됐다."
  },
  "11": {
   "jp": "b7220fcd",
   "kr": "앞으로는 형제가 힘을 합쳐"
  },
  "12": {
   "jp": "bafda66c",
   "kr": "퓨엔테를 위해 한층 더 노력하겠다."
  },
  "13": {
   "jp": "d85ba607",
   "kr": "그대들이 없었다면"
  },
  "14": {
   "jp": "2df3c176",
   "kr": "이 나라가 어찌 됐을지"
  },
  "15": {
   "jp": "c9eaab30",
   "kr": "알 수 없다."
  },
  "16": {
   "jp": "c3bb8bfd",
   "kr": "쥬리오 군, 크리스 양 휘리 양."
  },
  "17": {
   "jp": "98b41bc0",
   "kr": "정말로 고맙다."
  },
  "18": {
   "jp": "171edb62",
   "kr": "정말 다행이에요."
  },
  "19": {
   "jp": "c95e47cf",
   "kr": "이제 베라트 같은 자가 나타나도,"
  },
  "20": {
   "jp": "e3511782",
   "kr": "끄떡없을 거야."
  },
  "21": {
   "jp": "d31886e3",
   "kr": "그렇고말고."
  },
  "22": {
   "jp": "e768f582",
   "kr": "이제 형제의 신뢰는 쇠보다 굳다."
  },
  "23": {
   "jp": "89513b96",
   "kr": "꾐 따위에 넘어갈 성싶으냐."
  },
  "24": {
   "jp": "786c397f",
   "kr": "임금님 저도 돕겠어요."
  },
  "25": {
   "jp": "d5293971",
   "kr": "앞으로는 홀크와 하이젠에"
  },
  "26": {
   "jp": "9fae2b0c",
   "kr": "자주 들러서,"
  },
  "27": {
   "jp": "831e76ce",
   "kr": "남북 교류를 돕겠습니다."
  },
  "28": {
   "jp": "3684ec46",
   "kr": "그래, 고맙구나."
  },
  "29": {
   "jp": "0f84f5ea",
   "kr": "휘리 양이 그렇게 말해 주면"
  },
  "30": {
   "jp": "de4f7967",
   "kr": "천군만마다."
  },
  "31": {
   "jp": "26097c7a",
   "kr": "자, 쥬리오."
  },
  "32": {
   "jp": "c94f2196",
   "kr": "우린 여행길로 돌아가야 해."
  },
  "33": {
   "jp": "86e61b39",
   "kr": "느긋이 있고 싶지만"
  },
  "34": {
   "jp": "3a15b8c2",
   "kr": "폴티아의 상황이 걱정돼."
  },
  "35": {
   "jp": "7440fe30",
   "kr": "그러네."
  },
  "36": {
   "jp": "af3bb1ea",
   "kr": "어머, 폴티아에도 무슨 일이 있나요?"
  },
  "37": {
   "jp": "cd7678a2",
   "kr": "아직 무슨 일이 있는 건"
  },
  "38": {
   "jp": "7af4ed81",
   "kr": "아니지만,"
  },
  "39": {
   "jp": "cd49b89f",
   "kr": "왠지 불길한 예감이 들어서요…"
  },
  "40": {
   "jp": "8ea975b0",
   "kr": "제 눈으로 보지 않으면 걱정돼서요…"
  },
  "41": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "42": {
   "jp": "9f480b4c",
   "kr": "그럼 아쉽지만 붙잡을 수도 없겠구나."
  },
  "43": {
   "jp": "0cdd6941",
   "kr": "가는 길 조심해서 돌아가거라."
  },
  "44": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "45": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "46": {
   "jp": "dda76e54",
   "kr": "휘리 양은 어떻게 할 거예요?"
  },
  "47": {
   "jp": "784aa775",
   "kr": "그럼 저는 서쪽 가도 갈림길까지"
  },
  "48": {
   "jp": "61800f8c",
   "kr": "쥬리오 씨 일행을"
  },
  "49": {
   "jp": "34423b8a",
   "kr": "배웅해 드리고 오겠어요."
  },
  "50": {
   "jp": "6f3d8c7a",
   "kr": "어머니도 걱정하고 계실 테니까"
  },
  "51": {
   "jp": "3e68f0eb",
   "kr": "거기서 두 분을 배웅하고"
  },
  "52": {
   "jp": "88cb77b2",
   "kr": "한 번 집에 돌아갈까 해요."
  },
  "53": {
   "jp": "35b207b5",
   "kr": "그게 좋겠네요."
  },
  "54": {
   "jp": "b82c1557",
   "kr": "휘리 양"
  },
  "55": {
   "jp": "42b1dcdb",
   "kr": "또 금방 놀러 와요."
  },
  "56": {
   "jp": "362fb90a",
   "kr": "네. 감사합니다."
  },
  "57": {
   "jp": "8af7e680",
   "kr": "서, 설마 앰비쉬의 사자분이라곤"
  },
  "58": {
   "jp": "98fd9a8b",
   "kr": "몰랐던지라…저기."
  },
  "59": {
   "jp": "553a5707",
   "kr": "약속하셨지요?"
  },
  "60": {
   "jp": "e8df31df",
   "kr": "분명 물구나무서서 세 번 돈다고 했지?"
  },
  "61": {
   "jp": "5cb110ec",
   "kr": "약속한다고 했잖아요."
  },
  "62": {
   "jp": "b04d379b",
   "kr": "알았어요〜"
  },
  "63": {
   "jp": "40734986",
   "kr": "좀 물러나서 보고 있어요."
  },
  "64": {
   "jp": "aa99fa90",
   "kr": "또 하라는 거예요?"
  },
  "65": {
   "jp": "d6001d05",
   "kr": "에라 모르겠다."
  },
  "66": {
   "jp": "c498aee8",
   "kr": "몇 번이고 해 주죠!"
  },
  "67": {
   "jp": "902a512b",
   "kr": "너희는 정말 대단하구나!"
  },
  "68": {
   "jp": "cbf89cff",
   "kr": "덕분에 퓨엔테는 다시 하나가 되었다."
  },
  "69": {
   "jp": "1f72adb6",
   "kr": "앞으로는 우리가 퓨엔테의"
  },
  "70": {
   "jp": "e9fa50e0",
   "kr": "평화를 지키마!"
  },
  "71": {
   "jp": "1aae890f",
   "kr": "세 번은 무리인가 봐."
  },
  "72": {
   "jp": "78dff6fc",
   "kr": "이제 좀 봐줘요."
  },
  "73": {
   "jp": "9d7aac73",
   "kr": "갑옷 입고 물구나무서는 것도"
  },
  "74": {
   "jp": "a441c1f1",
   "kr": "보통은 못 해요."
  },
  "75": {
   "jp": "1e7c32a9",
   "kr": "여어, 수고했어."
  },
  "76": {
   "jp": "ae341d74",
   "kr": "대활약이었지."
  },
  "77": {
   "jp": "4c1269e2",
   "kr": "휘리 양."
  },
  "78": {
   "jp": "b855695b",
   "kr": "또 놀러 와 줘."
  },
  "79": {
   "jp": "127e934e",
   "kr": "수고 많으셨습니다."
  },
  "80": {
   "jp": "79411fde",
   "kr": "가도의 봉쇄는 모두 풀렸습니다."
  },
  "81": {
   "jp": "4a98a002",
   "kr": "폐를 끼쳐 드렸습니다."
  },
  "82": {
   "jp": "167f09ff",
   "kr": "퓨엔테 병사를 대표하여,"
  },
  "83": {
   "jp": "91a0e136",
   "kr": "사죄드립니다."
  },
  "84": {
   "jp": "2df9126e",
   "kr": "저는 홀크의 병사입니다만"
  },
  "85": {
   "jp": "c50db1bd",
   "kr": "앞으로는 퓨엔테를 위해 일하겠습니다."
  },
  "86": {
   "jp": "05d4834c",
   "kr": "좁고 치우친 생각이"
  },
  "87": {
   "jp": "b7b05431",
   "kr": "베라트 같은 사내를 불러들이는 것이군요."
  },
  "88": {
   "jp": "ff1d596b",
   "kr": "나도 요새 짓는 걸 조금 거들었다."
  },
  "89": {
   "jp": "34626175",
   "kr": "베라트의 앞잡이 노릇을 하게 되다니."
  },
  "90": {
   "jp": "1c89889f",
   "kr": "조금 분하군."
  },
  "91": {
   "jp": "2536b93c",
   "kr": "역시 베라트는 나쁜 사람이었구나."
  },
  "92": {
   "jp": "adc036fc",
   "kr": "나도 수상하다고 생각했어."
  },
  "93": {
   "jp": "5062b73e",
   "kr": "역시 앰비쉬 임금님의"
  },
  "94": {
   "jp": "c5af6c64",
   "kr": "아는 사이답구나."
  },
  "95": {
   "jp": "6081e85d",
   "kr": "어린데도 대담하고,"
  },
  "96": {
   "jp": "d2b2f5f4",
   "kr": "여러분"
  },
  "97": {
   "jp": "03d46f6c",
   "kr": "정말 멋져요."
  },
  "98": {
   "jp": "1e7c2868",
   "kr": "그럼, 쥬리오 군 크리스 양."
  },
  "99": {
   "jp": "8290af86",
   "kr": "그대들의 여행은 아직 길 듯하다."
  },
  "100": {
   "jp": "f78f9af4",
   "kr": "부디 무리하지 말고"
  },
  "101": {
   "jp": "f8b76605",
   "kr": "조심해서 여행을 이어 가거라."
  },
  "102": {
   "jp": "9b5538f4",
   "kr": "잘 지내거라."
  },
  "103": {
   "jp": "9b70dedd",
   "kr": "신세를 졌습니다."
  },
  "104": {
   "jp": "086df09c",
   "kr": "또 언젠가"
  },
  "105": {
   "jp": "c617251f",
   "kr": "쾌걸 와일드캣에게"
  },
  "106": {
   "jp": "d8765560",
   "kr": "만나고 싶네요."
  },
  "107": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "108": {
   "jp": "85b151e4",
   "kr": "여러분은 이 퓨엔테를"
  },
  "109": {
   "jp": "5298e995",
   "kr": "궁지에서 구해 주셨습니다."
  },
  "110": {
   "jp": "1cd2e5e0",
   "kr": "그야말로 영웅이십니다."
  }
 }
}