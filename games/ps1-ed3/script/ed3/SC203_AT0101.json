  "0": {
   "jp": "bf50e946",
   "kr": "볼트"
  },
  "1": {
   "jp": "29d91607",
   "kr": "어부 로아"
  },
  "2": {
   "jp": "944b7429",
   "kr": "도구상 에레가레"
  },
  "3": {
   "jp": "7c216bed",
   "kr": "어부 모루사"
  },
  "4": {
   "jp": "9f4ea532",
   "kr": "프리제 부인"
  },
  "5": {
   "jp": "119a25fa",
   "kr": "군대라도 당해 낼 리 없다."
  },
  "6": {
   "jp": "87fa7804",
   "kr": "작정하고 날뛰면"
  },
  "7": {
   "jp": "6f239bce",
   "kr": "가루가는 바다 제일의 괴물이다."
  },
  "8": {
   "jp": "429e84c3",
   "kr": "아무리 폐하라도 가루가와 승부하는 건"
  },
  "9": {
   "jp": "1acaf297",
   "kr": "무모하지 않습니까?"
  },
  "10": {
   "jp": "a797499c",
   "kr": "반드시, 이 작전을 성공시키겠네."
  },
  "11": {
   "jp": "9194cb11",
   "kr": "가루가의 진격은 이 볼트에서 막는 것이다."
  },
  "12": {
   "jp": "83f932b3",
   "kr": "드, 드디어 왔군요…"
  },
  "13": {
   "jp": "1e7f7fac",
   "kr": "이 마을은 어떻게 되는 걸까요?"
  },
  "14": {
   "jp": "5d71449f",
   "kr": "폐하!"
  },
  "15": {
   "jp": "4185d5b9",
   "kr": "작전의 성공을 빌겠습니다!"
  },
  "16": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "17": {
   "jp": "a1b479d4",
   "kr": "무슨 볼일로?"
  },
  "18": {
   "jp": "0ca70118",
   "kr": "마음에 드는 게 있나요?"
  },
  "19": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "20": {
   "jp": "af2f0029",
   "kr": "예요."
  },
  "21": {
   "jp": "349c2301",
   "kr": "필요 없는 물건은 기꺼이 사들입니다."
  },
  "22": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "23": {
   "jp": "67afcad1",
   "kr": "에 사들이겠습니다."
  },
  "24": {
   "jp": "8e93c275",
   "kr": "라피카 1개당 15 Pia입니다."
  },
  "25": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "26": {
   "jp": "7da61f0d",
   "kr": "야."
  },
  "27": {
   "jp": "f2181726",
   "kr": "라피카가 없네요."
  },
  "28": {
   "jp": "f300cc06",
   "kr": "벌어 오시면, 또 오세요."
  },
  "29": {
   "jp": "05ecc145",
   "kr": "언제든지 사들이니까요."
  },
  "30": {
   "jp": "a517b0da",
   "kr": "다른 볼일은?"
  },
  "31": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "32": {
   "jp": "e536d2df",
   "kr": "또 오세요."
  },
  "33": {
   "jp": "b0c3da5d",
   "kr": "기어이 왔는가."
  },
  "34": {
   "jp": "d4b80a3d",
   "kr": "이제, 볼트 마을도 끝장이다…"
  },
  "35": {
   "jp": "a91eba0f",
   "kr": "걱정할 것 없다."
  },
  "36": {
   "jp": "bd7ede8b",
   "kr": "우리를 믿어라."
  },
  "37": {
   "jp": "400c581f",
   "kr": "드디어 가루가가 나타났구나."
  },
  "38": {
   "jp": "66cf1f46",
   "kr": "앰비쉬군의 작전이"
  },
  "39": {
   "jp": "ad5cbfae",
   "kr": "성공하면 좋겠는데…"
  },
  "40": {
   "jp": "9b958451",
   "kr": "폐하."
  },
  "41": {
   "jp": "36c91ab8",
   "kr": "아무 도움도 못 드리지만"
  },
  "42": {
   "jp": "9ed86c18",
   "kr": "온 힘을 다해 빌겠습니다."
  },
  "43": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "44": {
   "jp": "dd7c5a13",
   "kr": "무엇보다도 큰 격려가 된다."
  }
 }
