  },
  "110": {
   "jp": "51e1de0d",
   "kr": "왜 그러냐?"
  },
  "111": {
   "jp": "baf2adc5",
   "kr": "크리스 아가씨."
  },
  "112": {
   "jp": "dcb81d5b",
   "kr": "없어진 생선을 찾아올 거예요."
  },
  "113": {
   "jp": "466ff070",
   "kr": "분명 쥐가 한 짓일 게다."
  },
  "114": {
   "jp": "9945be41",
   "kr": "신경 쓸 것 없다."
  },
  "115": {
   "jp": "fc427a4f",
   "kr": "전 챠펠의 딸인걸요."
  },
  "116": {
   "jp": "a1ded5ca",
   "kr": "이런 일은 제대로 해야죠."
  },
  "117": {
   "jp": "7782ae37",
   "kr": "저기, 쥬리오."
  },
  "118": {
   "jp": "6628d916",
   "kr": "방에 돌아가서 갈아입자."
  },
  "119": {
   "jp": "005edb69",
   "kr": "어째서?"
  },
  "120": {
   "jp": "5dc0f6c7",
   "kr": "이대로 괜찮잖아."
  },
  "121": {
   "jp": "13b9c4aa",
   "kr": "순례 여행자로서"
  },
  "122": {
   "jp": "48a7eed0",
   "kr": "없어진 물건을 찾는 거야."
