  "123": {
   "jp": "085a4cae",
   "kr": "칫."
  },
  "124": {
   "jp": "1b5e70d8",
   "kr": "이상한 데서 고집을 부린다니까."
  },
  "125": {
   "jp": "9bb9ddbc",
   "kr": "만약 이게 도난 사건이라면"
  },
  "126": {
   "jp": "13e96a65",
   "kr": "큰일이 된다…"
  },
  "127": {
   "jp": "c8d18366",
   "kr": "그렇다고 손이 빈 사람은 없고…"
  },
  "128": {
   "jp": "71872072",
   "kr": "그래, 쥬리오 군!"
  },
  "129": {
   "jp": "86f6c876",
   "kr": "망보기 뒤라 미안하지만"
  },
  "130": {
   "jp": "263d924a",
   "kr": "조금 조사해 주지 않겠나?"
