  },
  "153": {
   "jp": "a4f5c9d5",
   "kr": "예스 서!!"
  },
  "154": {
   "jp": "076e93d0",
   "kr": "분명 쥐가 한 짓일 게다."
  },
  "155": {
   "jp": "47ccb873",
   "kr": "그리 당황하지 않아도 된다."
  },
  "156": {
   "jp": "635e3193",
   "kr": "크리스 아가씨…"
  },
  "157": {
   "jp": "9601e611",
   "kr": "이제부터가 바쁜데 말이다."
  },
  "158": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "159": {
   "jp": "b602b798",
