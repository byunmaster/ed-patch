  },
  "132": {
   "jp": "b6508fc5",
   "kr": "분명 어딘가에 떨어져 있을 거예요."
  },
  "133": {
   "jp": "582651f6",
   "kr": "찾아볼게요!"
  },
  "134": {
   "jp": "a0d5b03f",
   "kr": "저로선 어떻게 조사할지…"
  },
  "135": {
   "jp": "433aa2ba",
   "kr": "자네 나름대로 조사해 보게."
  },
  "136": {
   "jp": "1098d4a8",
   "kr": "로저 부부와 그리고 나에게 힘이"
  },
  "137": {
   "jp": "2fc78977",
   "kr": "되어 주었으면 한다."
