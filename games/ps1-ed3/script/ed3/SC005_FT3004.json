  },
  "160": {
   "jp": "2b18d143",
   "kr": "그러면 나도 힘을 보탤게."
  },
  "161": {
   "jp": "41939da5",
   "kr": "선장님께 말하고 와 줬구나!"
  },
  "162": {
   "jp": "68e967ab",
   "kr": "그래야 쥬리오지."
  },
  "163": {
   "jp": "fff5780f",
   "kr": "질버 선장님이"
  },
  "164": {
   "jp": "ee1eab75",
