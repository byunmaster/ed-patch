  },
  "139": {
   "jp": "44ed0019",
   "kr": "오오, 크리스 양도 협력해 주는 건가?"
  },
  "140": {
   "jp": "e4b49972",
   "kr": "여성의 눈은 때로 남자보다 날카롭지."
  },
  "141": {
   "jp": "06a4aa66",
   "kr": "기대하고 있네."
  },
  "142": {
   "jp": "11e35b8b",
   "kr": "네!"
  },
  "143": {
   "jp": "8113c4eb",
   "kr": "아니야, 크리스."
  },
  "144": {
   "jp": "015f35ce",
   "kr": "예스 서라고 해야지."
  },
  "145": {
   "jp": "6c637ae4",
   "kr": "그렇구나."
  },
  "146": {
   "jp": "8c879793",
   "kr": "그게 더 뱃사람 같은걸."
  },
  "147": {
   "jp": "c423fb94",
   "kr": "선장님! 한 번 더요."
  },
  "148": {
   "jp": "7197eec1",
   "kr": "아, 아아."
  },
  "149": {
   "jp": "ad7636d8",
   "kr": "크리스 양, 기대하겠다."
  },
  "150": {
   "jp": "7966a4db",
   "kr": "예스 서!"
  },
  "151": {
   "jp": "5958d5ec",
   "kr": "둘 다 최선을 다해 다오."
  },
  "152": {
   "jp": "30c7c2a2",
