  "1": {
   "jp": "0f879f86",
   "kr": "보스레이"
  },
  "2": {
   "jp": "87ed524e",
   "kr": "가톤"
  },
  "3": {
   "jp": "c1b14629",
   "kr": "브루트"
  },
  "4": {
   "jp": "73e57527",
   "kr": "질버 선장"
  },
  "5": {
   "jp": "898074d7",
   "kr": "조리장"
  },
  "6": {
   "jp": "27ab0f1b",
   "kr": "로저"
  },
  "7": {
   "jp": "94c78bc6",
   "kr": "테스"
  },
  "8": {
   "jp": "323319c2",
   "kr": "…그러니까, 로비에서 쉬는 사이에"
  },
  "9": {
   "jp": "4b9ec655",
   "kr": "테스 씨의 코트가 사라졌다…"
  },
  "10": {
   "jp": "b502ba2b",
   "kr": "는 말씀이시죠?"
  },
  "11": {
   "jp": "a9423a97",
   "kr": "신혼여행 기념으로 로저가 사 준"
  },
  "12": {
   "jp": "b86f6229",
   "kr": "소중한 물건이에요."
  },
  "13": {
   "jp": "c0eed020",
   "kr": "없어진 건 코트뿐입니까?"
  },
  "14": {
   "jp": "5b614ecd",
   "kr": "아뇨…"
  },
  "15": {
   "jp": "2613ebd1",
   "kr": "그 밖에 선실에 둔 회중시계도"
  },
  "16": {
   "jp": "d9d92005",
   "kr": "보이지 않아요."
  },
  "17": {
   "jp": "03ad656e",
   "kr": "어느 하나뿐이라면 깜빡 두고 온 것일 수도"
  },
  "18": {
   "jp": "40eb6e46",
   "kr": "있겠지만…"
  },
  "19": {
   "jp": "d7d3a4ef",
   "kr": "설마, 그런〜"
  },
  "20": {
   "jp": "764ba699",
   "kr": "이 배 안에 도둑이 있다니…"
  },
  "21": {
   "jp": "0e524854",
   "kr": "전 그런 거 믿고 싶지 않아요."
  },
  "22": {
   "jp": "fc8b439a",
   "kr": "그야, 이 배 사람들은"
  },
  "23": {
   "jp": "08e8b334",
   "kr": "다들 좋은 사람뿐인걸요."
  },
  "24": {
   "jp": "0f419574",
   "kr": "그렇지."
  },
  "25": {
   "jp": "85513033",
   "kr": "물론 나도 그렇게 생각하지만"
  },
  "26": {
   "jp": "358d7f37",
   "kr": "선장에게 말해 두는 게 좋을 것 같아서."
  },
  "27": {
   "jp": "55f645ac",
   "kr": "말씀해 주셔서 감사합니다."
  },
  "28": {
   "jp": "4a5ad819",
   "kr": "하지만, 이 선내에 도둑이 있다고는"
  },
  "29": {
   "jp": "95623f36",
   "kr": "생각하고 싶지 않군요…"
  },
  "30": {
   "jp": "51059a08",
   "kr": "저도 놓친 게 없는지"
  },
  "31": {
   "jp": "5f1e2645",
   "kr": "다시 살펴보겠습니다."
  },
  "32": {
   "jp": "e1aa41d1",
   "kr": "실례했습니다."
  },
  "33": {
   "jp": "81edc693",
   "kr": "이쪽도 최선을 다해"
  },
  "34": {
   "jp": "665529d3",
   "kr": "조사하겠습니다."
  },
  "35": {
   "jp": "97d49601",
   "kr": "질버 선장님!"
  },
  "36": {
   "jp": "23e27d94",
   "kr": "난처하게 됐군…"
  },
  "37": {
   "jp": "beaff514",
   "kr": "쥬리오 군, 수고했다."
  },
  "38": {
   "jp": "aef1e806",
   "kr": "잠시 쉬고 있어 다오."
  },
  "39": {
   "jp": "de7197ea",
   "kr": "가톤에게 뱃머리 망을 서라고"
  },
  "40": {
   "jp": "46b9fc6c",
   "kr": "전해 주지 않겠나?"
  },
  "41": {
   "jp": "c9144d30",
   "kr": "《항해일지 1일째》"
  },
  "42": {
   "jp": "194ad047",
   "kr": "드디어 올해 항해도 이것으로 끝이다."
  },
  "43": {
   "jp": "f7aadf94",
   "kr": "유빙의 계절이 다가오고 있다."
  },
  "44": {
   "jp": "ffbaf2a4",
   "kr": "닐리에서 돌아 라그나로 가면 겨울 휴가다."
  },
  "45": {
   "jp": "4d59ffce",
   "kr": "올해 마지막 항해에 어울리는 손님이 탔다."
  },
  "46": {
   "jp": "0fb6f98d",
   "kr": "순례 여행자 쥬리오 군과 크리스 양이다."
  },
  "47": {
   "jp": "aa865a89",
   "kr": "이번 항해도 멋지게 해내겠다."
  },
  "48": {
   "jp": "8ade2c1b",
   "kr": "《항해일지 2일째》"
  },
  "49": {
   "jp": "8ac56f6f",
   "kr": "오늘도 날씨는 나무랄 데 없다."
  },
  "50": {
   "jp": "345ccaff",
   "kr": "순례 여행자 쥬리오 군도 크리스 양도,"
  },
  "51": {
   "jp": "cdc67e16",
   "kr": "일 잘하는 착한 아이들이다."
  },
  "52": {
   "jp": "796d4169",
   "kr": "이 속도라면 예정대로 사흘째"
  },
  "53": {
   "jp": "16fb50d9",
   "kr": "새벽엔 닐리에 닿겠지."
  },
  "54": {
   "jp": "e90836db",
   "kr": "순례 여행자에게 축복 있으라!"
  },
  "55": {
   "jp": "966f030c",
   "kr": "그건 그렇고, 이등 선실의 두 사람은"
  },
  "56": {
   "jp": "c9d2172f",
   "kr": "한 번도 선실에서 모습을 보이지 않는다."
  },
  "57": {
   "jp": "8dab2755",
   "kr": "부끄럼쟁이인 걸까…"
  },
  "58": {
   "jp": "b7d928b5",
   "kr": "쥬리오는 티라스일 항해도를 봤습니다."
  },
  "59": {
   "jp": "168847ec",
   "kr": "티라스일 지방은"
  },
  "60": {
   "jp": "359c914c",
   "kr": "넓구나…"
  },
  "61": {
   "jp": "bf9995f8",
   "kr": "촌장님 말씀대로 정말 석 달쯤"
  },
  "62": {
   "jp": "281cad98",
   "kr": "걸릴지도 모르겠네."
  },
  "63": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "64": {
   "jp": "00baf235",
   "kr": "크리스랑 조리장님은 어디 갔지?"
  },
  "65": {
   "jp": "20fddaf9",
   "kr": "잠깐 좀 지나가겠네."
  },
  "66": {
   "jp": "0a671409",
   "kr": "어디 갔었어?"
  },
  "67": {
   "jp": "da01c2c0",
   "kr": "잠깐 선창에."
  },
  "68": {
   "jp": "216d5d02",
   "kr": "아앗!!"
  },
  "69": {
   "jp": "6af865ce",
   "kr": "뭐, 뭔데?"
  },
  "70": {
   "jp": "0e4d881d",
   "kr": "여기 있던 생선이"
  },
  "71": {
   "jp": "9260cd53",
   "kr": "없어졌어!"
  },
  "72": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "73": {
   "jp": "af43a081",
   "kr": "그 눈은 설마…"
  },
  "74": {
   "jp": "bb786083",
   "kr": "순순히 자백해!"
  },
  "75": {
   "jp": "7a1b8d1f",
   "kr": "내, 내가 왔을 땐"
  },
  "76": {
   "jp": "4560cc6f",
   "kr": "생선 같은 거 없었어!"
  },
  "77": {
   "jp": "5bc25bcf",
   "kr": "정말이라니까!"
  },
  "78": {
   "jp": "89ae5ecc",
   "kr": "흠!"
  },
  "79": {
   "jp": "c59d106f",
   "kr": "아무리 배가 고파도"
  },
  "80": {
   "jp": "ee2acb10",
   "kr": "날것으로는 못 먹겠지."
  },
  "81": {
   "jp": "57f911c1",
   "kr": "좋아, 믿어 줄게."
  },
  "82": {
   "jp": "ba47298a",
   "kr": "믿기는 뭘…"
  },
  "83": {
   "jp": "6d3ce5d8",
   "kr": "그보다 말이야, 크리스."
  },
  "84": {
   "jp": "ebd7f4d8",
   "kr": "잠깐 와 봐."
  },
  "85": {
   "jp": "c22e39e6",
   "kr": "뭐야, 쥬리오도 참"
  },
  "86": {
   "jp": "2a0440e9",
   "kr": "쉬쉬하기는."
  },
  "87": {
   "jp": "d38705b8",
   "kr": "없어진 건 생선만이 아니야."
  },
  "88": {
   "jp": "76a9791d",
   "kr": "테스 씨의 코트랑"
  },
  "89": {
   "jp": "0ef7e31d",
   "kr": "로저 씨의 시계도 없어졌어."
  },
  "90": {
   "jp": "d0266993",
   "kr": "엇!?"
  },
  "91": {
   "jp": "77467676",
   "kr": "그럼 도둑이 든 거야?"
  },
  "92": {
   "jp": "09b9035e",
   "kr": "그렇다고 단정할 순 없어."
  },
  "93": {
   "jp": "40eadc1c",
   "kr": "이 배에 도둑이 있다니…"
  },
  "94": {
   "jp": "f8df4d5e",
   "kr": "그래서 쥬리오는"
  },
  "95": {
   "jp": "bdcd7632",
   "kr": "보고만 있겠다고?"
  },
  "96": {
   "jp": "0c7e930d",
   "kr": "그치만, 난 아무것도 못 해."
  },
  "97": {
   "jp": "e3424497",
   "kr": "흐〜음."
  },
  "98": {
   "jp": "27d4fe82",
   "kr": "그럼 쥬리오는 이대로 괜찮은 거네."
  },
  "99": {
   "jp": "8fe07e64",
   "kr": "나라면 스스로 진범을 찾아내서"
  },
  "100": {
   "jp": "bbb08d88",
   "kr": "언짢은 기분을 쫓아낼 텐데."
  },
  "101": {
   "jp": "439d416e",
   "kr": "난 요리하러 돌아갈래."
  },
  "102": {
   "jp": "d612ec9f",
   "kr": "크리스…"
  },
  "103": {
   "jp": "e3902966",
   "kr": "그렇지."
  },
  "104": {
   "jp": "eb68d1b3",
   "kr": "다들 좋은 사람인걸."
  },
  "105": {
   "jp": "e63c54fd",
   "kr": "그래서 내가 찾아내겠다고"
  },
  "106": {
   "jp": "43506da3",
   "kr": "선장님과 약속했어."
  },
  "107": {
   "jp": "ab62cf7d",
   "kr": "그래야지!"
  },
  "108": {
   "jp": "9fa2647f",
   "kr": "잠깐 기다려."
  },
  "109": {
   "jp": "0c5e4e45",
