  },
  "56": {
   "jp": "46518d0b",
   "kr": "그거랑 같은 거란다."
  },
  "57": {
   "jp": "c2ded92b",
   "kr": "사람은 괴로워도 즐겁다고 여길 마음이 있지."
  },
  "58": {
   "jp": "fc7388e9",
   "kr": "그러니 한 번이라도 행복했던 순간이 있다면"
  },
  "59": {
   "jp": "68560304",
   "kr": "그 사람의 인생은 행복했던 거란다."
  },
  "60": {
   "jp": "b032307b",
   "kr": "설령 그게 죽은 뒤라 해도 말이다."
