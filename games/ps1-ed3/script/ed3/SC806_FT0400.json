  },
  "46": {
   "jp": "77ccdad9",
   "kr": "너희에게 묻겠는데"
  },
  "47": {
   "jp": "fa405059",
   "kr": "순례 여행은 어땠느냐?"
  },
  "48": {
   "jp": "77216f6f",
   "kr": "순례 여행?"
  },
  "49": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "50": {
   "jp": "f5fab73e",
   "kr": "처음엔 어떻게 될까 싶었지만,"
