  },
  "26": {
   "jp": "9df14a67",
   "kr": "앗, 라프 할아버지다."
  },
  "27": {
   "jp": "ac8ebab2",
   "kr": "정말 수고했구나."
  },
  "28": {
   "jp": "64f82934",
   "kr": "저기, 라프 할아버지."
  },
  "29": {
   "jp": "abd61f8f",
   "kr": "라프 할아버지는 말이야…"
  },
  "30": {
   "jp": "94643f06",
   "kr": "무슨 일인고."
  },
