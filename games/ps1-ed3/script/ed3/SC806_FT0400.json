  "38": {
   "jp": "ed4ceec4",
   "kr": "동료들에게 배신자 취급받는 길을"
  },
  "39": {
   "jp": "e737cd48",
   "kr": "스스로 택한 거잖아?"
  },
  "40": {
   "jp": "03638a6a",
   "kr": "분명, 괴로웠을 거야."
