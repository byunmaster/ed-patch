 "lines": {
  "0": {
   "jp": "bf50e946",
   "kr": "볼트"
  },
  "1": {
   "jp": "2ead0805",
   "kr": "무기상 바이스"
  },
  "2": {
   "jp": "e42c53a1",
   "kr": "셰라"
  },
  "3": {
   "jp": "ae3acf17",
   "kr": "기무레 노인"
  },
  "4": {
   "jp": "b89f241a",
   "kr": "어부 페스카"
  },
  "5": {
   "jp": "5b955126",
   "kr": "피아라"
  },
  "6": {
   "jp": "5097989c",
   "kr": "챠펠의 모라토"
  },
  "7": {
   "jp": "ce6b4aa1",
   "kr": "이그니스 샤리네가 있는 곳은"
  },
  "8": {
   "jp": "a22a510a",
   "kr": "통칭 『큰 뱀의 혀』라 불리고 있네."
  },
  "9": {
   "jp": "adf962f2",
   "kr": "앰비쉬 남쪽을 막는 대산맥을"
  },
  "10": {
   "jp": "cd9dfa56",
   "kr": "『큰 뱀의 등뼈』라 하는데."
  },
  "11": {
   "jp": "3f69e54e",
   "kr": "그 큰 뱀의 머리에 빗대어진 것이지."
  },
  "12": {
   "jp": "4bd95cd7",
   "kr": "이그니스 샤리네까지는 외길이니까"
  },
  "13": {
   "jp": "e2cd5b8d",
   "kr": "헤맬 일은 없을 걸세."
  },
  "14": {
   "jp": "025430c4",
   "kr": "마을 남쪽으로 나가게."
  },
  "15": {
   "jp": "84f39c9d",
   "kr": "로디는 맡겨 주게."
  },
  "16": {
   "jp": "7d919241",
   "kr": "안데라에 도착하면"
  },
  "17": {
   "jp": "aaed0450",
   "kr": "지금보다 나은 간호를 할 수 있네."
  },
  "18": {
   "jp": "34b519d9",
   "kr": "그럼, 조심해서 가게."
  },
  "19": {
   "jp": "3fdd0600",
   "kr": "꼭 이그니스 다녀오는 길에 성에 들러 주게."
  },
  "20": {
   "jp": "51ae0194",
   "kr": "쥬리오 님, 크리스 님."
  },
  "21": {
   "jp": "d4a72220",
   "kr": "마기사에게서 이것을 맡아 왔습니다."
  },
  "22": {
   "jp": "af2f0029",
   "kr": "예요."
  },
  "23": {
   "jp": "34d3408a",
   "kr": "부디 받아 주십시오."
  },
  "24": {
   "jp": "be640595",
   "kr": "그 아이의 작은 성의입니다."
  },
  "25": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "26": {
   "jp": "e9d91b01",
   "kr": ", 손에 넣었다."
  },
  "27": {
   "jp": "e82dadf5",
   "kr": "그러면 안데라성에서 다시 뵙겠습니다."
  },
  "28": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "29": {
   "jp": "4c4f19a2",
   "kr": "아무래도 짐이 가득하신 모양이군요."
  },
  "30": {
   "jp": "bea8ef0c",
   "kr": "짐을 정리하고 나서 다시 오십시오."
  },
  "31": {
   "jp": "9da47782",
   "kr": "꼭 드리고 싶은 것이 있습니다."
  },
  "32": {
   "jp": "1ede341b",
   "kr": "쥬리오 그쪽은 이그니스가 아니야."
  },
  "33": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "34": {
   "jp": "42dd8796",
   "kr": "남쪽 출구로 가야 해."
  },
  "35": {
   "jp": "59a8b7c4",
   "kr": "쥬리오, 이쪽이 아니야."
  },
  "36": {
   "jp": "42dd8796",
   "kr": "남쪽 출구로 가야 해."
  },
  "37": {
   "jp": "a21d7f1a",
   "kr": "큰 뱀의 혀는 제법 험한 길일세."
  },
  "38": {
   "jp": "0bb6614a",
   "kr": "서두르지 말고 가게나."
  },
  "39": {
   "jp": "a59e3243",
   "kr": "오오, 짐을 정리하셨군요."
  },
  "40": {
   "jp": "af2f0029",
   "kr": "예요."
  },
  "41": {
   "jp": "34d3408a",
   "kr": "부디 받아 주십시오."
  },
  "42": {
   "jp": "be640595",
   "kr": "그 아이의 작은 성의입니다."
  },
  "43": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "44": {
   "jp": "e9d91b01",
   "kr": ", 손에 넣었다."
  },
  "45": {
   "jp": "e82dadf5",
   "kr": "그러면 안데라성에서 다시 뵙겠습니다."
  },
  "46": {
   "jp": "167adffb",
   "kr": "짐이 가득하신 모양이군요."
  },
  "47": {
   "jp": "bea8ef0c",
   "kr": "짐을 정리하고 나서 다시 오십시오."
  },
  "48": {
   "jp": "9da47782",
   "kr": "꼭 드리고 싶은 것이 있습니다."
  },
  "49": {
   "jp": "1374b318",
   "kr": "안데라성에 들러"
  },
  "50": {
   "jp": "7c56c38f",
   "kr": "건강한 모습을 보여 주십시오."
  },
  "51": {
   "jp": "3594021d",
   "kr": "로디…"
  },
  "52": {
   "jp": "344cd770",
   "kr": "더 오래 같이 여행하고 싶었어."
  },
  "53": {
   "jp": "7e8d30b2",
   "kr": "로디."
  },
  "54": {
   "jp": "f17adac4",
   "kr": "빨리 나아."
  },
  "55": {
   "jp": "78f4f238",
   "kr": "마기사 씨."
  },
  "56": {
   "jp": "0333505c",
   "kr": "푹 쉬어."
  },
  "57": {
   "jp": "e6550100",
   "kr": "굉장한 마법이었어."
  },
  "58": {
   "jp": "363ea91b",
   "kr": "나도 더, 더"
  },
  "59": {
   "jp": "495b38eb",
   "kr": "마법을 공부할게요."
  },
  "60": {
   "jp": "acc9a574",
   "kr": "어서 와."
  },
  "61": {
   "jp": "c15128c9",
   "kr": "무슨 볼일이야?"
  },
  "62": {
   "jp": "2c66b937",
   "kr": "찬찬히 봐."
  },
  "63": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "64": {
   "jp": "c8e34810",
   "kr": "야."
  },
  "65": {
   "jp": "aae5b2ba",
   "kr": "어느 거야?"
  },
  "66": {
   "jp": "c19170dd",
   "kr": "인가."
  },
  "67": {
   "jp": "c9931259",
   "kr": "좋아,"
  },
  "68": {
   "jp": "a1449844",
   "kr": "에 사들이겠어."
  },
  "69": {
   "jp": "90ecf113",
   "kr": "환전율은 1 라피카가 15 Pia야."
  },
  "70": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "71": {
   "jp": "c8e34810",
   "kr": "야."
  },
  "72": {
   "jp": "4da5e887",
   "kr": "라피카가 없네."
  },
  "73": {
   "jp": "33a12afb",
   "kr": "또 모아서 와."
  },
  "74": {
   "jp": "65c5e9bc",
   "kr": "내킬 때면 언제든 바꿔 주지."
  },
  "75": {
   "jp": "ef947133",
   "kr": "달리 볼일은 없나?"
  },
  "76": {
   "jp": "6fba2dba",
   "kr": "또 들러 줘."
  },
  "77": {
   "jp": "079dd382",
   "kr": "역시 앰비쉬 병사님이로군."
  },
  "78": {
   "jp": "9753f8c6",
   "kr": "가루가를 바다로 쫓아 보냈으니 말이야."
  },
  "79": {
   "jp": "f762535c",
   "kr": "볼트의 챠펠에 어서 오세요."
  },
  "80": {
   "jp": "89255841",
   "kr": "어느 분께 전수할까요?"
  },
  "81": {
   "jp": "7ce46b82",
   "kr": "어느 마법을 원하시나요?"
  },
  "82": {
   "jp": "941f0265",
   "kr": "말이군요."
  },
  "83": {
   "jp": "01aa32e3",
   "kr": "전수하겠습니다."
  },
  "84": {
   "jp": "5dfde940",
   "kr": "또 마법이 필요하시면"
  },
  "85": {
   "jp": "18d42ff1",
   "kr": "언제든 들러 주세요."
  },
  "86": {
   "jp": "7f0f1af8",
   "kr": "마기사 님의 활약은"
  },
  "87": {
   "jp": "9ee4124a",
   "kr": "챠펠 사람으로서도"
  },
  "88": {
   "jp": "bc567bae",
   "kr": "기쁘기 그지없습니다."
  },
  "89": {
   "jp": "941645e5",
   "kr": "이제 안심하고"
  },
  "90": {
   "jp": "93b15a09",
   "kr": "손님을"
  },
  "91": {
   "jp": "9c81e8b8",
   "kr": "부를 수 있겠어."
  },
  "92": {
   "jp": "98b41bc0",
   "kr": "정말 고마워."
  },
  "93": {
   "jp": "590f8422",
   "kr": "될 대로 되었구먼."
  },
  "94": {
   "jp": "41636165",
   "kr": "다행이야. 다행이야."
  },
  "95": {
   "jp": "695782c5",
   "kr": "자네들한텐 정말로 감사하네."
  },
  "96": {
   "jp": "d678b6da",
   "kr": "고맙네."
  },
  "97": {
   "jp": "8b9c1ff8",
   "kr": "왕님들은 안데라로 향했어."
  },
  "98": {
   "jp": "cd460345",
   "kr": "이제 또 고기잡이 나갈 수 있다."
  },
  "99": {
   "jp": "73a6c617",
   "kr": "자, 쉰 만큼 되찾아야지."
  },
  "100": {
   "jp": "b7787bf2",
   "kr": "대활약이었다면서요."
  },
  "101": {
   "jp": "98b41bc0",
   "kr": "정말 고마워요."
  }
 }
}