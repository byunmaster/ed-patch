   "kr": "무기상 카리오"
  },
  "2": {
   "jp": "8e0dea4d",
   "kr": "마샤"
  },
  "3": {
   "jp": "1ef05bfc",
   "kr": "주점 네우로"
  },
  "4": {
   "jp": "d93d3c74",
   "kr": "단텔"
  },
  "5": {
   "jp": "973c8bc4",
   "kr": "보레"
  },
  "6": {
   "jp": "b5454b11",
   "kr": "진"
  },
  "7": {
   "jp": "46691b52",
   "kr": "발루"
  },
  "8": {
   "jp": "e8b651c8",
   "kr": "라나"
  },
  "9": {
   "jp": "50d4db15",
   "kr": "스레드"
  },
  "10": {
   "jp": "e57d3672",
   "kr": "라스파 촌장"
  },
  "11": {
   "jp": "dc95e75d",
   "kr": "피니카 부인"
  },
  "12": {
   "jp": "10e8d6f2",
   "kr": "나델"
  },
  "13": {
   "jp": "96728a66",
   "kr": "간쵸"
  },
  "14": {
   "jp": "4946dd78",
   "kr": "헴"
  },
  "15": {
   "jp": "5f053583",
   "kr": "행상 트레다"
  },
  "16": {
   "jp": "60916eb5",
   "kr": "스미라"
  },
  "17": {
   "jp": "5b16cfee",
   "kr": "카이"
  },
  "18": {
   "jp": "dd8d3a5a",
   "kr": "키르마"
  },
  "19": {
   "jp": "d79c23ef",
   "kr": "메나트에 어서 오세요."
  },
  "20": {
   "jp": "f0170e90",
   "kr": "저는 입국 심사관 마샤입니다."
  },
  "21": {
   "jp": "3745878c",
   "kr": "뭔가 신고할 물건이 있나요?"
  },
  "22": {
   "jp": "6688975d",
   "kr": "어머?"
  },
  "23": {
   "jp": "dfae09bd",
   "kr": "순례하시는 분들이군요."
  },
  "24": {
   "jp": "f70b5d5d",
   "kr": "그렇다면 신고는 필요 없어요."
  },
  "25": {
   "jp": "9b6b8276",
   "kr": "네, 그렇긴 한데요."
  },
  "26": {
   "jp": "2cb6b856",
   "kr": "그런데 어떻게 아셨어요?"
  },
  "27": {
   "jp": "32b300ae",
   "kr": "그 나이에 아이들끼리만 여행을 하다니요."
  },
  "28": {
   "jp": "9d74f70c",
   "kr": "폴티아 라그픽 마을의 풍습이죠?"
  },
  "29": {
   "jp": "57925567",
   "kr": "입국 관리 안내서에 적혀 있었어요."
  },
  "30": {
   "jp": "18fd737a",
   "kr": "그런데 근래 몇 년은 순례자가 안 온 것"
  },
  "31": {
   "jp": "01f62451",
   "kr": "같아서… 이제 순례 풍습은 없어진 줄"
  },
  "32": {
   "jp": "b87e55a8",
   "kr": "생각했어."
  },
  "33": {
   "jp": "21e8e589",
   "kr": "그게요 제대로 이어지고 있었어요."
  },
  "34": {
   "jp": "ad2c91ae",
   "kr": "보세요."
  },
  "35": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "36": {
   "jp": "a013bdd8",
   "kr": "어머, 이게 은단검이군요."
  },
  "37": {
   "jp": "31f482a6",
   "kr": "이렇게 귀한 걸 보여 주시다니 감격이에요."
  },
  "38": {
   "jp": "7bd05f14",
   "kr": "정말 고마워요."
  },
  "39": {
   "jp": "5e28bc90",
   "kr": "지금 메나트는 흉작이지만,"
  },
  "40": {
   "jp": "29fb169c",
   "kr": "이 마을 사람들은 다들 다정해요."
  },
  "41": {
   "jp": "263d8ed7",
   "kr": "어려운 일이 있으면"
  },
  "42": {
   "jp": "768a4447",
   "kr": "사양 말고 상담해 보세요."
  },
  "43": {
   "jp": "dd877657",
   "kr": "분명, 힘이 되어 줄 테니까요."
  },
  "44": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "45": {
   "jp": "0efbb7b5",
   "kr": "뭔가 어려운 일이 있으면"
  },
  "46": {
   "jp": "19ded300",
   "kr": "언제든지 오세요."
  },
  "47": {
   "jp": "00e746a0",
   "kr": "상담해 드릴게요."
  },
  "48": {
   "jp": "f3fe5d6f",
   "kr": "뭔가 어려운 일이 있나요?"
  },
  "49": {
   "jp": "52127cc2",
   "kr": "언제든 힘이 될게요."
  },
  "50": {
   "jp": "04432005",
   "kr": "이걸 어쩌면 좋아. 이렇게 흉작이어선"
  },
  "51": {
   "jp": "e8bc9809",
   "kr": "내년 씨앗도 못 사겠어."
  },
  "52": {
   "jp": "eb5a6798",
   "kr": "이렇게 심한 흉작이 되다니…"
  },
  "53": {
   "jp": "0f4792ca",
   "kr": "우리가 대체 뭘 잘못했다고…"
  },
  "54": {
   "jp": "7e892485",
   "kr": "20년쯤 전에 하얀마녀가 이곳을 찾아와,"
  },
  "55": {
   "jp": "a310409c",
   "kr": "장차 메나트에 엄청난 흉작이 닥친다는 예언을"
  },
  "56": {
   "jp": "8048ac75",
   "kr": "남겼다는데…"
  },
  "57": {
   "jp": "b441f5ad",
   "kr": "그게 설마"
  },
  "58": {
   "jp": "64ace9b9",
   "kr": "정말로 일어날 줄이야."
  },
  "59": {
   "jp": "f0d4c7d1",
   "kr": "어라? 여행하는 사람인가…"
  },
  "60": {
   "jp": "51aeb146",
   "kr": "나는 이 마을 촌장, 라스파일세."
  },
  "61": {
   "jp": "0e9f6c36",
   "kr": "나그네여, 어떤가?"
  },
  "62": {
   "jp": "d0c3f7c9",
   "kr": "흉작에 허덕이는 나라를 본 소감은?"
  },
  "63": {
   "jp": "a5bd0964",
   "kr": "올해는 특히 철 아닌 눈보라 탓에"
  },
  "64": {
   "jp": "fd9755a0",
   "kr": "보리가 자라지 않아서…"
  },
  "65": {
   "jp": "85303c43",
   "kr": "다들 먹을 것이 없어 곤란하네."
  },
  "66": {
   "jp": "a80962e3",
   "kr": "그때 노르딕 왕이"
  },
  "67": {
   "jp": "a2750b90",
   "kr": "하얀마녀의 말을 믿었더라면."
  },
  "68": {
   "jp": "2b2d13b9",
   "kr": "아니… 아무것도 아닐세."
  },
  "69": {
   "jp": "467c57da",
   "kr": "식량을 구할 방법을"
  },
  "70": {
   "jp": "d42c9503",
   "kr": "궁리해야겠구먼."
  },
  "71": {
   "jp": "863171b5",
   "kr": "이웃 마을 알데까지도 꽤 거리가 있거든."
  },
  "72": {
   "jp": "f15c926b",
   "kr": "육로로 식량을 옮겨 오기도"
  },
  "73": {
   "jp": "cfcce417",
   "kr": "뜻대로 되질 않아요."
  },
  "74": {
   "jp": "800335e2",
   "kr": "지금은 오로지 정기선이 가져오는 식량과"
  },
  "75": {
   "jp": "c12f09ab",
   "kr": "바다에서 잡히는 생선만이 믿을 구석이야."
  },
  "76": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "77": {
   "jp": "3f019315",
   "kr": "여긴 애들이 올 데가 아니야."
  },
  "78": {
   "jp": "38a20b4e",
   "kr": "술밖에 없으니까 말이지."
  },
  "79": {
   "jp": "e3902966",
   "kr": "그러네."
  },
  "80": {
   "jp": "f4479637",
   "kr": "쥬리오, 왜 여기 온 거야?"
  },
  "81": {
   "jp": "d25b6c5d",
   "kr": "왜냐면…"
  },
  "82": {
   "jp": "d0a08157",
   "kr": "저, 궁금한 게 있는데요."
  },
  "83": {
   "jp": "9aed8a58",
   "kr": "흉작으로 힘드시다면서"
  },
  "84": {
   "jp": "6f685d0c",
   "kr": "술만은 넉넉히 있나요?"
  },
  "85": {
   "jp": "22d79dd6",
   "kr": "술도 말이야 아까까진 없었어."
  },
  "86": {
   "jp": "f262c729",
   "kr": "방금 매발톱호가 도착했잖아."
  },
  "87": {
   "jp": "1923fbae",
   "kr": "그래서 럼주가 들어온 거지."
  },
  "88": {
   "jp": "1b814341",
   "kr": "질버 선장도 고생이야."
  },
  "89": {
   "jp": "b1914bcf",
   "kr": "평소면 한잔하고 갈 텐데."
  },
  "90": {
   "jp": "80497916",
   "kr": "유빙이 밀려오니 곧장 되돌아간다더군."
  },
  "91": {
   "jp": "f341bbff",
   "kr": "여긴 어른들 주점이지만"
  },
  "92": {
   "jp": "4045b04e",
   "kr": "곤란한 일이 있으면 언제든 찾아오라고."
  },
  "93": {
   "jp": "7dc470c8",
   "kr": "상담해 줄 테니."
  },
  "94": {
   "jp": "90e9fb67",
   "kr": "어서 오세요!"
  },
  "95": {
   "jp": "04cae254",
   "kr": "오, 도와주려는 거야?"
  },
  "96": {
   "jp": "f2d14090",
   "kr": "미안하지만, 좀 비켜 주겠나?"
  },
  "97": {
   "jp": "46a13787",
   "kr": "따뜻한 걸 위장에 쏟아붓고 싶어서."
  },
  "98": {
   "jp": "5473dc14",
   "kr": "여전히 여기 부야베스는 일품이군."
  },
  "99": {
   "jp": "139e4a55",
   "kr": "몸속까지 따뜻해진다는 게 바로 이런 거지."
  },
  "100": {
   "jp": "a25f661b",
   "kr": "메나트가 흉작이 이어지는 건,"
  },
  "101": {
   "jp": "9aab81b9",
   "kr": "하얀마녀의 저주라는"
  },
  "102": {
   "jp": "c5ec0b9b",
   "kr": "소문이 자자해."
  },
  "103": {
   "jp": "6708987c",
   "kr": "마녀란 거, 무섭구먼."
  },
  "104": {
   "jp": "12c3d17a",
   "kr": "딸꾹…"
  },
  "105": {
   "jp": "739cab40",
   "kr": "어려운 일이 있으면"
  },
  "106": {
   "jp": "a0628cd1",
   "kr": "언제든 찾아오라고. 상담해 줄 테니."
  },
  "107": {
   "jp": "f30eb82a",
   "kr": "끄윽…"
  },
  "108": {
   "jp": "90e9fb67",
   "kr": "어서 오세요!"
  },
  "109": {
   "jp": "f6effbc7",
   "kr": "예로부터 현명한 나그네는 무기도 잘 쓴다고"
  },
  "110": {
   "jp": "731258ed",
   "kr": "합니다."
  },
  "111": {
   "jp": "4ee46c9a",
   "kr": "아껴 가며 여행하는 마음가짐도 필요하지만,"
  },
  "112": {
   "jp": "a3f34434",
   "kr": "여유를 두고 무기를 갖추는 것도 현명하죠."
  },
  "113": {
   "jp": "ec5a878a",
   "kr": "무엇을 드릴까요?"
  },
  "114": {
   "jp": "d14b58e9",
   "kr": "무엇을 찾으시나요?"
  },
  "115": {
   "jp": "a81e7a27",
   "kr": "받겠습니다."
  },
  "116": {
   "jp": "8fd0ffe1",
   "kr": "무엇을 사들일까요?"
  },
  "117": {
   "jp": "4b42c90a",
   "kr": "라면"
  },
  "118": {
   "jp": "98210662",
   "kr": "에 사들이겠습니다."
  },
  "119": {
   "jp": "65d811e9",
   "kr": "환전이시죠?"
  },
  "120": {
   "jp": "7fa10058",
   "kr": "1Goa당 15Pia인데, 괜찮으신가요?"
  },
  "121": {
   "jp": "068d27e4",
   "kr": "을 치르겠습니다."
  },
  "122": {
   "jp": "e81adb75",
   "kr": "라피카가 쌓이면 또 오십시오."
  },
  "123": {
   "jp": "60bf4e0d",
   "kr": "언제든지 사들이겠습니다."
  },
  "124": {
   "jp": "ce85ee3c",
   "kr": "그 밖에 무슨 볼일이신가요?"
  },
  "125": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "126": {
   "jp": "c1b62c53",
   "kr": "또, 필요한 물건이 있으면 들러 주십시오."
  },
  "127": {
   "jp": "caf6f85d",
   "kr": "또 들러 주십시오."
  },
  "128": {
   "jp": "8744802c",
   "kr": "우와아!"
  },
  "129": {
   "jp": "3391db84",
   "kr": "서두르지 않으면 말린 고기 다 팔려 버린다!"
  },
  "130": {
   "jp": "f3b780af",
   "kr": "신난다!"
  },
  "131": {
   "jp": "fdd0a430",
   "kr": "생선 말고 다른 걸 먹겠어."
  },
  "132": {
   "jp": "c07a6143",
   "kr": "자, 방금"
  },
  "133": {
   "jp": "300e7d67",
   "kr": "배로 도착한 멧돼지 말린 고기예요!"
  },
  "134": {
   "jp": "ac906a54",
   "kr": "서두르지 않으면 다 팔려요!"
  },
  "135": {
   "jp": "af04eb7e",
   "kr": "수량이 한정돼 있어요."
  },
  "136": {
   "jp": "533c6ddb",
   "kr": "먼저 오는 사람이 임자죠."
  },
  "137": {
   "jp": "9e4cae8b",
   "kr": "자, 사세요 사세요!"
  },
  "138": {
   "jp": "9a5c0ff9",
   "kr": "미안해요, 1인 1개예요."
  },
  "139": {
   "jp": "fbc09a42",
   "kr": "예. 손님도 말린 고기를 사시려고요?"
  },
  "140": {
   "jp": "6b6b67c0",
   "kr": "4 Pia인데, 괜찮으시죠?"
  },
  "141": {
   "jp": "68f34c14",
   "kr": "고맙습니다!"
  },
  "142": {
   "jp": "0c7293c0",
   "kr": "영양 듬뿍 멧돼지 말린 고기예요!"
  },
  "143": {
   "jp": "27580c2d",
   "kr": "맛있어요!"
  },
  "144": {
   "jp": "27134982",
   "kr": "쥬리오 일행은 말린 고기를 샀다."
  },
  "145": {
   "jp": "fa448be9",
   "kr": "아빠가 잡은 멧돼지 고기일지도 몰라."
  },
  "146": {
   "jp": "d184eb06",
   "kr": "크리스도 먹어 봐. 맛있어."
  },
  "147": {
   "jp": "172f8f76",
   "kr": "벌써 먹어 버렸어."
  },
  "148": {
   "jp": "45b4698f",
   "kr": "이런, Pia가 모자라시네요."
  },
  "149": {
   "jp": "5999de2c",
   "kr": "맛있다니까요."
  },
  "150": {
   "jp": "63b37c50",
   "kr": "나중에 후회 마세요."
  },
  "151": {
   "jp": "e755c280",
   "kr": "손님도 먹어 보라고."
  },
  "152": {
   "jp": "489e7896",
   "kr": "맛있다니까."
  },
  "153": {
   "jp": "e4bdf82d",
   "kr": "폴티아에서 오는 배는 늘"
  },
  "154": {
   "jp": "35a471f4",
   "kr": "먹을 것을 실어다 주니까 말이야."
  },
  "155": {
   "jp": "9a25b76a",
   "kr": "무엇보다 큰 즐거움이지."
  },
  "156": {
   "jp": "6d3caf63",
   "kr": "생선만 먹으면 질리니까 말이야."
  },
  "157": {
   "jp": "8604191a",
   "kr": "가끔은 실컷 고기를 먹고 싶어."
  },
  "158": {
   "jp": "2816bd70",
   "kr": "이 나라에도 멧돼지가 있으면 좋을 텐데."
  },
  "159": {
   "jp": "25c7c62e",
   "kr": "우와!"
  },
  "160": {
   "jp": "fd7af09b",
   "kr": "강이다!"
  },
  "161": {
   "jp": "534c8bbf",
   "kr": "물고기 없나."
