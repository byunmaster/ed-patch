 "lines": {
  "0": {
   "jp": "ea7ef945",
   "kr": "타라타호"
  },
  "1": {
   "jp": "fcb6f9f2",
   "kr": "갑판"
  },
  "2": {
   "jp": "5cc70478",
   "kr": "어부 토바이"
  },
  "3": {
   "jp": "7f31849d",
   "kr": "뭐 하고 있었냐?"
  },
  "4": {
   "jp": "29c71c92",
   "kr": "엄청 늦었구먼."
  },
  "5": {
   "jp": "a07762e4",
   "kr": "토바이 씨가 큰 소리를 내니까"
  },
  "6": {
   "jp": "1a02eb3a",
   "kr": "바다표범이 깼잖아요."
  },
  "7": {
   "jp": "587ca49d",
   "kr": "맞아요."
  },
  "8": {
   "jp": "40e7b474",
   "kr": "어? 미안혀."
  },
  "9": {
   "jp": "d983ade9",
   "kr": "아이고, 잘못했구먼…"
  },
  "10": {
   "jp": "be4e52e3",
   "kr": "토바이는 조금 머뭇거리며 사과했다."
  },
  "11": {
   "jp": "c6a0e25a",
   "kr": "아버지한테 혼나 부렀당께."
  },
  "12": {
   "jp": "c8a9cb29",
   "kr": "어부는 바다에 안 나가면"
  },
  "13": {
   "jp": "2404f858",
   "kr": "사내가 아니라고 말이여."
  },
  "14": {
   "jp": "f6bcfc97",
   "kr": "타라타호 준비는 됐어야."
  },
  "15": {
   "jp": "76d1b8a7",
   "kr": "타라타호요?"
  },
  "16": {
   "jp": "7d6527c2",
   "kr": "… 이상한 이름."
  },
  "17": {
   "jp": "b17d5e80",
   "kr": "쥬리오, 너!"
  },
  "18": {
   "jp": "147d78b0",
   "kr": "태워 달라면서"
  },
  "19": {
   "jp": "b9ac8aa1",
   "kr": "그런 소리 하면 안 되지."
  },
  "20": {
   "jp": "3b2c08a6",
   "kr": "딱히 이상한 이름 아녀."
  },
  "21": {
   "jp": "542ba09e",
   "kr": "이 고장 말로 바다호라는 뜻이여."
  },
  "22": {
   "jp": "f2f032a1",
   "kr": "토바이 씨, 신경 쓰지 마세요."
  },
  "23": {
   "jp": "dccddcfa",
   "kr": "그럼, 죄송하지만"
  },
  "24": {
   "jp": "dc58b517",
   "kr": "네갈섬까지 잘 부탁드려요."
  },
  "25": {
   "jp": "9fa58d69",
   "kr": "좋〜아"
  },
  "26": {
   "jp": "cbd7ab09",
   "kr": "타라타호 출항이여어!!"
  }
 }
}