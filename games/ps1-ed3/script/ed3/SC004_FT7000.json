  },
  "8": {
   "jp": "545a593b",
   "kr": "로이"
  },
  "9": {
   "jp": "a5ea237c",
   "kr": "우와〜!"
  },
  "10": {
   "jp": "d2d37c70",
   "kr": "저게 우리가 탈 배인가?"
  },
  "11": {
   "jp": "250c3b47",
   "kr": "큰 배네."
  },
  "12": {
   "jp": "3d4a36f8",
   "kr": "마침 방금 도착한 모양이야."
  },
  "13": {
   "jp": "d04cdea9",
   "kr": "저기, 더 가까이서 보자!"
  },
  "14": {
   "jp": "6609899d",
   "kr": "배를 타는 건 처음인걸."
  },
  "15": {
   "jp": "170ac42e",
   "kr": "그래. 가 보자."
  },
  "16": {
   "jp": "9058eb80",
   "kr": "배에서 사람이 내려온다."
  },
  "17": {
   "jp": "5bfb7a2e",
   "kr": "어디 사람들일까?"
  },
  "18": {
   "jp": "e2236bad",
   "kr": "사람 많다! 크리…"
  },
  "19": {
   "jp": "28d4cabd",
   "kr": "크리스으!!"
  },
  "20": {
   "jp": "65db15fa",
   "kr": "…어디 가 버린 거야아…"
  },
  "21": {
   "jp": "8ff882ae",
   "kr": "잠깐 기다려!"
  },
  "22": {
   "jp": "d5669452",
   "kr": "매발톱호에 탈 거라면 표를 보여 다오."
  },
  "23": {
   "jp": "4e54245c",
   "kr": "옷, 은단검인가!"
  },
  "24": {
   "jp": "22e365a8",
   "kr": "순례 여행자라면 표 따위 필요 없지."
  },
  "25": {
   "jp": "c425458a",
   "kr": "지금은 다음 항해 준비로 바빠서"
  },
  "26": {
   "jp": "8ee804c2",
   "kr": "아무도 상대 못 해 주니 구경이나 해라."
  },
  "27": {
   "jp": "5357eab9",
   "kr": "난 배로 항해하는 것도 무척 좋지만"
  },
  "28": {
   "jp": "56ea14b0",
   "kr": "선창에 매인 배를 보면서"
  },
  "29": {
   "jp": "6b4ae4df",
   "kr": "느긋하게 쉬는 것도 좋아."
  },
  "30": {
   "jp": "e602ba6f",
   "kr": "매발톱호는 마음에 드냐?"
  },
  "31": {
   "jp": "0a13834c",
   "kr": "오, 순례 여행자로군."
  },
  "32": {
   "jp": "d3781970",
   "kr": "윗갑판이라면 맘대로 돌아다녀도 돼."
  }
