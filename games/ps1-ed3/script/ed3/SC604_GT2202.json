{
 "archive": "/SCE6/SC604.DAT",
 "member": "..\\DATA\\GT2202.BIN",
 "lines": {
  "0": {
   "jp": "dc464821",
   "kr": "기드넬"
  },
  "1": {
   "jp": "4300e71e",
   "kr": "우르기드 저택"
  },
  "2": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "3": {
   "jp": "02fd1347",
   "kr": "무슨 일이 있었을까…?"
  },
  "4": {
   "jp": "a1592d1f",
   "kr": "이 방, 창문이 없으니까"
  },
  "5": {
   "jp": "2ac02a6f",
   "kr": "바깥 상황을 도통 알 수가 없어."
  },
  "6": {
   "jp": "bc2a027f",
   "kr": "이봐, 거기 있잖아!"
  },
  "7": {
   "jp": "2735f730",
   "kr": "뭐냐?"
  },
  "8": {
   "jp": "9cb2d1d6",
   "kr": "시끄럽다."
  },
  "9": {
   "jp": "21f02dac",
   "kr": "무슨 일이 있었던 거야?"
  },
  "10": {
   "jp": "22001dcf",
   "kr": "아까, 쾅 하던 거 뭐야?"
  },
  "11": {
   "jp": "d096994b",
   "kr": "아, 그거 말이냐."
  },
  "12": {
   "jp": "ba18cf38",
   "kr": "듣자니 무희가 될 뻔한 동료를"
  },
  "13": {
   "jp": "9434e332",
   "kr": "구하러 온 녀석들이 있었는데,"
  },
  "14": {
   "jp": "e0dbb592",
   "kr": "실패해서 자기들도 붙잡혔다더군."
  },
  "15": {
   "jp": "c138e1e0",
   "kr": "흐음, 얼빠진 사람도 있네."
  },
  "16": {
   "jp": "b7ecc550",
   "kr": "그게 말이야"
  },
  "17": {
   "jp": "b7ba813c",
   "kr": "그놈들을 사막의 흑표범이 구했다고"
  },
  "18": {
   "jp": "05bef762",
   "kr": "하지 않겠나."
  },
  "19": {
   "jp": "a72ca9c9",
   "kr": "아까 그 폭발 소리는"
  },
  "20": {
   "jp": "edda6c17",
   "kr": "사막의 흑표범 폭탄 소리란 얘기다."
  },
  "21": {
   "jp": "4cb8b38f",
   "kr": "(또 사막의 흑표범…)"
  },
  "22": {
   "jp": "59a75d1a",
   "kr": "어라…?"
  },
  "23": {
   "jp": "fafe0d21",
   "kr": "무희가 될 뻔한 동료라는 게"
  },
  "24": {
   "jp": "0f27e50f",
   "kr": "네 얘기 아니냐?"
  },
  "25": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "26": {
   "jp": "f313ea4f",
   "kr": "아, 맞다."
  },
  "27": {
   "jp": "d406cb0c",
   "kr": "그거, 내 얘기잖아."
  },
  "28": {
   "jp": "9eb6ef08",
   "kr": "그럼"
  },
  "29": {
   "jp": "7835ccb5",
   "kr": "구하러 온 게"
  },
  "30": {
   "jp": "6a57f5ab",
   "kr": "…쥬리오?"
  },
  "31": {
   "jp": "16c43d18",
   "kr": "정말…!"
  },
  "32": {
   "jp": "e8b9d555",
   "kr": "모처럼 여기까지 와 놓고"
  },
  "33": {
   "jp": "7a0d1559",
   "kr": "왜 잡히는 거야."
  },
  "34": {
   "jp": "0c5be871",
   "kr": "정말이지…"
  },
  "35": {
   "jp": "aa7752b3",
   "kr": "쥬리오도 참"
  },
  "36": {
   "jp": "4205fe77",
   "kr": "내가 없으면"
  },
  "37": {
   "jp": "9e3402c0",
   "kr": "아무것도 못 하는걸."
  },
  "38": {
   "jp": "f59b3c36",
   "kr": "저기, 잠깐 괜찮나?"
  },
  "39": {
   "jp": "5ce5363b",
   "kr": "그건 좀, 아닌 것 같은데…"
  },
  "40": {
   "jp": "b221101f",
   "kr": "왜냐면, 네가 먼저 잡혔으니까"
  },
  "41": {
   "jp": "2aa9f7bc",
   "kr": "동료가 구하러 온 거잖나."
  },
  "42": {
   "jp": "6b5f64e8",
   "kr": "네가 안 잡혔더라면"
  },
  "43": {
   "jp": "e0212bc2",
   "kr": "구하러 올 일도 없었던 셈이지."
  },
  "44": {
   "jp": "3c6cd422",
   "kr": "동료를 탓하면 딱하잖나."
  },
  "45": {
   "jp": "2e2e4076",
   "kr": "시끄러워!"
  },
  "46": {
   "jp": "d6b86a97",
   "kr": "끄에에에…"
  },
  "47": {
   "jp": "d7656a16",
   "kr": "우르기드 앞잡이한테"
  },
  "48": {
   "jp": "5af3a9f6",
   "kr": "설교 들을 이유는 없어!"
  },
  "49": {
   "jp": "d68082f6",
   "kr": "에휴…"
  },
  "50": {
   "jp": "97d10e6a",
   "kr": "그 말 들으면 괴롭단 말이지…"
  },
  "51": {
   "jp": "9ecdd972",
   "kr": "쥬리오도 참, 뭘 하는 거야?"
  },
  "52": {
   "jp": "8f4ac64b",
   "kr": "무사히 도망쳤다면,"
  },
  "53": {
   "jp": "280fbe49",
   "kr": "빨리 나를 구하러 와 주면 좋을 텐데."
  },
  "54": {
   "jp": "c02c9975",
   "kr": "정말…"
  },
  "55": {
   "jp": "f59fe29e",
   "kr": "(후우…)"
  },
  "56": {
   "jp": "fbcc5f30",
   "kr": "(어떻게든 여기까지는 무사히 왔다…)"
  },
  "57": {
   "jp": "b4a44d51",
   "kr": "(슬슬 스텔라 씨가 헛간을 폭파할 때다.)"
  }
 }
}