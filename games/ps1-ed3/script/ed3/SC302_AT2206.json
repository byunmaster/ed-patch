  },
  "59": {
   "jp": "01f59571",
   "kr": "심사 결과 발표를 부탁드리겠습니다."
  },
  "60": {
   "jp": "04d8bde1",
   "kr": "어흠."
  },
  "61": {
   "jp": "4d946048",
   "kr": "어느 것이나 훌륭한 요리였네."
  },
  "62": {
   "jp": "1e509f2a",
   "kr": "심사하기가 무척 어려워서"
  },
  "63": {
   "jp": "e9445ab9",
