  "7": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "8": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "9": {
   "jp": "8b6c8ac2",
   "kr": "좋아, 그럼 시작하지."
  },
  "10": {
   "jp": "32c9436f",
   "kr": "출전자 여러분을 안으로 모시게."
  },
  "11": {
   "jp": "77f5f615",
   "kr": "부디 들어오십시오."
  },
  "12": {
   "jp": "8bc88117",
   "kr": "호오, 커튼이라니 센스가 있군."
  },
  "13": {
   "jp": "3d5e442a",
   "kr": "지금부터 앰비쉬국 주최"
  },
  "14": {
   "jp": "ddb70f6e",
   "kr": "요리 콘테스트를 개최하겠습니다."
  },
  "15": {
   "jp": "358e25f2",
   "kr": "폐하, 인사 말씀을."
  },
  "16": {
   "jp": "f9ab1aee",
   "kr": "오늘의 요리 콘테스트는"
  },
  "17": {
   "jp": "a529e4c7",
   "kr": "앰비쉬를 가루가의 습격에서 무사히"
  },
  "18": {
   "jp": "92baa195",
   "kr": "지켜 낸 기념으로 거행하는 것이다."
  },
  "19": {
   "jp": "5881a6a1",
   "kr": "특별 심사위원으로는 볼트에서 우리를 위해"
  },
  "20": {
   "jp": "6bf78632",
   "kr": "함께 싸워 준 쥬리오 군을 맞이했네."
  },
  "21": {
   "jp": "2d8b35ab",
   "kr": "모두, 평소 갈고닦은 요리 솜씨를"
  },
  "22": {
   "jp": "1c7fbf78",
   "kr": "마음껏 뽐내 주게."
  },
  "23": {
   "jp": "ca978f5a",
   "kr": "그리고 본인의 간곡한 희망으로"
  },
  "24": {
   "jp": "61dc4d57",
   "kr": "쥬리오 군과 함께 볼트에서 우리에게"
  },
  "25": {
   "jp": "2fbd78aa",
   "kr": "협력해 준 크리스 양도 참가하고 있네."
  },
  "26": {
   "jp": "a496950a",
   "kr": "죠르노에게 들은 바로는"
  },
  "27": {
   "jp": "6fa24b6b",
   "kr": "크리스 양의 요리도 무척 훌륭한 모양일세."
  },
  "28": {
   "jp": "06a4aa66",
   "kr": "기대하고 있네."
  },
  "29": {
   "jp": "27e513b3",
   "kr": "심사 방법을 설명드리겠습니다."
  },
  "30": {
   "jp": "2a7a85d8",
   "kr": "심사는 알프 왕, 죠리나 왕비, 쥬리오 님,"
  },
  "31": {
   "jp": "566d2f44",
   "kr": "그리고 저 네 사람이 요리를 맛본 뒤"
  },
  "32": {
   "jp": "62995d17",
   "kr": "우열을 가리겠습니다."
  },
  "33": {
   "jp": "cd9d4361",
   "kr": "훌륭한 상품도 마련해 두었으니"
  },
  "34": {
   "jp": "0e467ab8",
   "kr": "부디 기대해 주십시오."
  },
  "35": {
   "jp": "162e8752",
   "kr": "그럼 시작하겠습니다."
  },
  "36": {
   "jp": "612f6299",
   "kr": "응?"
  },
  "37": {
   "jp": "13fb710d",
   "kr": "(맛있다…?)"
  },
  "38": {
   "jp": "3f3fb2d4",
   "kr": "(크리스의 요리가 이렇게 맛있다니…)"
  },
  "39": {
   "jp": "56104fdf",
   "kr": "이상해."
  },
  "40": {
   "jp": "1dbc96d1",
   "kr": "뭐가 이상한데?"
  },
  "41": {
   "jp": "0992826e",
   "kr": "엇, 아니, 그게…"
  },
  "42": {
   "jp": "e74cf6c9",
   "kr": "그러면 잠시 심사에 시간이 걸리므로"
  },
  "43": {
   "jp": "61e3d308",
   "kr": "부디 참가자 여러분은"
  },
  "44": {
   "jp": "79e5c1c0",
   "kr": "의자에 앉아 기다려 주십시오."
  },
  "45": {
   "jp": "41b7717c",
   "kr": "이야, 다들 훌륭한 맛일세."
  },
  "46": {
   "jp": "276ab963",
   "kr": "지당하십니다."
  },
  "47": {
   "jp": "2a4d6b62",
   "kr": "이것도 저것도 다 맛있었어."
  },
  "48": {
   "jp": "4d734744",
   "kr": "신기하게 크리스 요리도"
  },
  "49": {
   "jp": "2b1f83b8",
   "kr": "꽤 괜찮았네."
  },
  "50": {
   "jp": "29631659",
   "kr": "음, 우열을 가리기 어렵군."
  },
  "51": {
   "jp": "6bef4558",
   "kr": "네, 고민되네요."
  },
  "52": {
   "jp": "1ee26133",
   "kr": "소곤소곤소곤…"
  },
  "53": {
   "jp": "c8a6963b",
   "kr": "쑥덕쑥덕쑥덕…"
  },
  "54": {
   "jp": "3a58400e",
   "kr": "흠흠…"
  },
  "55": {
   "jp": "3d71a989",
   "kr": "좋아, 그걸로 되겠지."
