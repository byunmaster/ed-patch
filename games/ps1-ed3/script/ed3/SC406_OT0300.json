 "lines": {
  "0": {
   "jp": "044c0822",
   "kr": "대성당"
  },
  "1": {
   "jp": "2f3badb6",
   "kr": "라텔"
  },
  "2": {
   "jp": "7225b9c9",
   "kr": "승병"
  },
  "3": {
   "jp": "88657cfa",
   "kr": "부에나 신부"
  },
  "4": {
   "jp": "4e93d73a",
   "kr": "피에타 할머니"
  },
  "5": {
   "jp": "c86bd85c",
   "kr": "신관 쿠오레"
  },
  "6": {
   "jp": "90ad8fa0",
   "kr": "신관 안테리"
  },
  "7": {
   "jp": "3a8f995c",
   "kr": "신관 모스"
  },
  "8": {
   "jp": "3e8a2f71",
   "kr": "신관장 레존"
  },
  "9": {
   "jp": "3ce18c08",
   "kr": "아네로"
  },
  "10": {
   "jp": "ed4baf51",
   "kr": "소시에"
  },
  "11": {
   "jp": "a39545a9",
   "kr": "체니"
  },
  "12": {
   "jp": "e82ea387",
   "kr": "과연 올도스 대성당은 대단하구나."
  },
  "13": {
   "jp": "123773c8",
   "kr": "챠펠이든 칸드든 상관없이"
  },
  "14": {
   "jp": "f08f7de1",
   "kr": "마법을 공부한다면 최고의 환경이네."
  },
  "15": {
   "jp": "f82de371",
   "kr": "힘든 여행이었지만"
  },
  "16": {
   "jp": "9aa31648",
   "kr": "여기 와서 정말 다행이야."
  },
  "17": {
   "jp": "d77854ae",
   "kr": "신관장님 말씀은 어떠셨습니까?"
  },
  "18": {
   "jp": "a0b1a8a8",
   "kr": "잘 모르겠던데요."
  },
  "19": {
   "jp": "9e7af97d",
   "kr": "신관장님 말씀은 대단히 존귀한 것입니다."
  },
  "20": {
   "jp": "3c66606c",
   "kr": "지금은 그것을 모르셔도"
  },
  "21": {
   "jp": "7397ce56",
   "kr": "분명 이해할 때가 옵니다."
  },
  "22": {
   "jp": "02152bf6",
   "kr": "자, 어서 지나가십시오."
  },
  "23": {
   "jp": "dc58eff9",
   "kr": "신관장님 말씀은 벌써 들으셨습니까?"
  },
  "24": {
   "jp": "8d879ce6",
   "kr": "위로 올라가시는 것은"
  },
  "25": {
   "jp": "9a3952d3",
   "kr": "신관장님 말씀을 들으신 다음이"
  },
  "26": {
   "jp": "15dcf8ab",
   "kr": "좋으실 겁니다."
  },
  "27": {
   "jp": "d77854ae",
   "kr": "신관장님 말씀은 어떠셨습니까?"
  },
  "28": {
   "jp": "a0b1a8a8",
   "kr": "잘 모르겠던데요."
  },
  "29": {
   "jp": "02660df7",
   "kr": "귀한 말씀일수록 알기 어려운 법입니다."
  },
  "30": {
   "jp": "6dacc38e",
   "kr": "지금은 잘 모르셔도"
  },
  "31": {
   "jp": "4a01752e",
   "kr": "언젠가 분명 이해할 때가 옵니다."
  },
  "32": {
   "jp": "02152bf6",
   "kr": "자, 어서 지나가십시오."
  },
  "33": {
   "jp": "35644a40",
   "kr": "신관장님은 만나 뵈셨습니까?"
  },
  "34": {
   "jp": "2b4b3f8a",
   "kr": "대성당에서 신관장님 말씀을"
  },
  "35": {
   "jp": "6480194e",
   "kr": "방청하실 수 있을 겁니다."
  },
  "36": {
   "jp": "84beff77",
   "kr": "훌륭한 신부가 되기 위해"
  },
  "37": {
   "jp": "6aad6355",
   "kr": "여기서 신세를 지고 있습니다."
  },
  "38": {
   "jp": "482b5de5",
   "kr": "이 올도스에서 착실히 배우고,"
  },
  "39": {
   "jp": "dabcbc8e",
   "kr": "제 마을로 돌아가"
  },
  "40": {
   "jp": "8ddbff00",
   "kr": "사람들을 위해 일하고 싶다고 생각합니다."
  },
  "41": {
   "jp": "6231f0b4",
   "kr": "숙식하며 수행하는 분들을 위해,"
  },
  "42": {
   "jp": "9093eac1",
   "kr": "주변 시중을"
  },
  "43": {
   "jp": "c786f11e",
   "kr": "들어 드리고 있습니다."
  },
  "44": {
   "jp": "492cdb2f",
   "kr": "이곳 신관님들께서는"
  },
  "45": {
   "jp": "9052877d",
   "kr": "참으로 공부에 열심이십니다."
  },
  "46": {
   "jp": "681c0eb8",
   "kr": "정상적인 윤리는 공통의 정의인가…"
  },
  "47": {
   "jp": "1e1094fe",
   "kr": "이곳 서적은"
  },
  "48": {
   "jp": "7475e30d",
   "kr": "참으로 도움이 되네."
  },
  "49": {
   "jp": "7b9af40b",
   "kr": "물은 거울이 되어 마음을 비추는가…"
  },
  "50": {
   "jp": "dda24a30",
   "kr": "디네 샤리네를 노래하고 있구먼."
  },
  "51": {
   "jp": "de9e3be5",
   "kr": "흠, 흠."
  },
  "52": {
   "jp": "9833c257",
   "kr": "불의 온기는 활력과 정열을 끓게 하는가…"
  },
  "53": {
   "jp": "9445bdb3",
   "kr": "으음. 이 문장에서는"
  },
  "54": {
   "jp": "7b00cd78",
   "kr": "이그니스 샤리네의 강인함이 느껴지는구먼."
  },
  "55": {
   "jp": "21b7e277",
   "kr": "땅은 주검을 치유하고 부활로 이끈다…"
  },
  "56": {
   "jp": "bfe9a231",
   "kr": "과연, 가루가에게 파괴된 테그라"
  },
  "57": {
   "jp": "22e24730",
   "kr": "샤리네의 부활을 예지한 듯하네."
  },
  "58": {
   "jp": "c16a90c6",
   "kr": "얼른 네갈섬도"
  },
  "59": {
   "jp": "d655e07f",
   "kr": "본래대로 되면 좋으련만."
  },
  "60": {
   "jp": "50a5abba",
   "kr": "오오, 이건 시플에 관한 게로군."
  },
  "61": {
   "jp": "413dfbe2",
   "kr": "바람은 생명의 숨결과 축복의 노래를 싣는가…"
  },
  "62": {
   "jp": "b351827e",
   "kr": "숲에는 신비한 생명력이 있으니 말이야."
  },
  "63": {
   "jp": "68475a57",
   "kr": "대성당 안에서는 정숙해 주십시오."
  },
  "64": {
   "jp": "11e35b8b",
   "kr": "네!"
  },
  "65": {
   "jp": "68475a57",
   "kr": "대성당 안에서는 정숙해 주십시오."
  },
  "66": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "67": {
   "jp": "11eb074d",
   "kr": "오늘 이야기는 자네들에게는"
  },
  "68": {
   "jp": "09f2eaa8",
   "kr": "조금 어려웠으려나."
  },
  "69": {
   "jp": "507f1756",
   "kr": "뭐, 마음 쓸 것은 없네."
  },
  "70": {
   "jp": "62f308da",
   "kr": "이해는 사람마다의 범위로 하면 된다."
  },
  "71": {
   "jp": "cc4ac496",
   "kr": "중요한 건 스스로 느끼는 것이네."
  },
  "72": {
   "jp": "cc580d18",
   "kr": "그거면 된다네."
  },
  "73": {
   "jp": "796fce06",
   "kr": "무슨 일인가?"
  },
  "74": {
   "jp": "18aca1fa",
   "kr": "이제 곧 끝나니"
  },
  "75": {
   "jp": "aa70b72e",
   "kr": "의자에 앉아서 듣게나."
  },
  "76": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "77": {
   "jp": "5b2dcd1b",
   "kr": "죄송합니다."
  },
  "78": {
   "jp": "2543ff8b",
   "kr": "대성당 안에서 소리가 들린다."
  },
  "79": {
   "jp": "db2d0482",
   "kr": "신관장 레존의 목소리"
  },
  "80": {
   "jp": "d9ba679b",
   "kr": "말하자면…"
  },
  "81": {
   "jp": "4c0465d4",
   "kr": "옛날엔 챠펠과 칸드라는 마법의 구분도 없이"
  },
  "82": {
   "jp": "d6025f9f",
   "kr": "본디 둘 사이에 경계 따위 없는 힘이었네."
  },
  "83": {
   "jp": "3b3fe87e",
   "kr": "하지만 그래서는 힘의 조화를 유지하지 못할까"
  },
  "84": {
   "jp": "7bd12f51",
   "kr": "우려되었다. 스스로도 대마도사였던"
  },
  "85": {
   "jp": "f465a6b4",
   "kr": "올도스의 초대 대신관 올테가는 그리 여겼네."
  },
  "86": {
   "jp": "fa81fac1",
   "kr": "세상의 모든 힘은"
  },
  "87": {
   "jp": "f22f586a",
   "kr": "서로 맞서는 두 존재에 의해"
  },
  "88": {
   "jp": "67737d54",
   "kr": "균형이 지켜지는 것이라네…"
  },
  "89": {
   "jp": "209f537f",
   "kr": "쥬리오 일행에겐 너무 어려워서"
  },
  "90": {
   "jp": "7af29af0",
   "kr": "잘 알 수 없었다."
  },
  "91": {
   "jp": "dd221c7f",
   "kr": "신관장의 이야기는 계속된다."
  },
  "92": {
   "jp": "2af0c987",
   "kr": "으음."
  },
  "93": {
   "jp": "599ab606",
   "kr": "하나가 모든 걸 갖추면,"
  },
  "94": {
   "jp": "0a7b6740",
   "kr": "분명 힘은 만능이 된다."
  },
  "95": {
   "jp": "cdfa6228",
   "kr": "하지만 견줄 것이 존재하지 않는다."
  },
  "96": {
   "jp": "9116ad95",
   "kr": "잘못을 바로잡을 방도가 없는 게야."
  },
  "97": {
   "jp": "1f726829",
   "kr": "만일 만능의 힘을 손에 넣은 자에게"
  },
  "98": {
   "jp": "98616fa3",
   "kr": "교만이 생긴다면,"
  },
  "99": {
   "jp": "de4d9d31",
   "kr": "그자는 힘으로 세상 조화를 흐트러뜨릴지도."
  },
  "100": {
   "jp": "b86a0720",
   "kr": "초대 대신관 올테가는 그것을 염려하여,"
  },
  "101": {
   "jp": "227fae76",
   "kr": "그때까지 있던 마법을"
  },
  "102": {
   "jp": "a43e3e70",
   "kr": "챠펠과 칸드 둘로 나누었네."
  },
  "103": {
   "jp": "826e744f",
   "kr": "어둠과 빛이 있듯이. 달과 태양이 있듯이."
  },
  "104": {
   "jp": "666126db",
   "kr": "또한, 남자와 여자가 있듯이…"
  },
  "105": {
   "jp": "55f4f896",
   "kr": "만물의 법칙에 맞는 조화를 마법에 구했다."
  },
  "106": {
   "jp": "12616370",
   "kr": "이것이 챠펠과 칸드"
  },
  "107": {
   "jp": "1fe0758e",
   "kr": "두 마법의 유래일세."
  },
  "108": {
   "jp": "1b8cf628",
   "kr": "하지만 한 걸음 더 나아가 생각해 보자."
  },
  "109": {
   "jp": "3e47295d",
   "kr": "자제하는 마음을 갖고 도덕을 높인다면"
  },
  "110": {
   "jp": "eecee1c7",
   "kr": "자신의 마법을 두려워할 필요는 없는 것이다."
  },
  "111": {
   "jp": "6265c84f",
   "kr": "우선, 그것을 이해하는 것이"
  },
  "112": {
   "jp": "7df2cf49",
   "kr": "마법을 다루는 자의 마음가짐이라 하겠지."
  },
  "113": {
   "jp": "6f3b55bd",
   "kr": "에헴."
  },
  "114": {
   "jp": "0be1cf4e",
   "kr": "이상으로 오늘의 설법은 마칩니다."
  },
  "115": {
   "jp": "175db2ec",
   "kr": "경청해 주셔서 감사합니다."
  },
  "116": {
   "jp": "8a0634cb",
   "kr": "으〜음, 좋은 말씀이었구먼."
  },
  "117": {
   "jp": "cf3b6f44",
   "kr": "신관장님 말씀은 참으로 알기 쉬워요."
  },
  "118": {
   "jp": "d92566ab",
   "kr": "과연."
  },
  "119": {
   "jp": "b5818a3a",
   "kr": "평소의 마음가짐이 중요하구나."
  },
  "120": {
   "jp": "4be90803",
   "kr": "쥬리오 얘기 잘 알아들었어?"
  },
  "121": {
   "jp": "bbf92527",
   "kr": "대충은."
  },
  "122": {
   "jp": "eda875e1",
   "kr": "그러니까, 나쁜 일에"
  },
  "123": {
   "jp": "5a998d8f",
   "kr": "마법을 쓰면"
  },
  "124": {
   "jp": "4cfd8798",
   "kr": "안 된다는 얘기지."
  },
  "125": {
   "jp": "09f43c29",
   "kr": "아마…"
  },
  "126": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "127": {
   "jp": "e3c598d4",
   "kr": "으음, 귀한 말씀이로군."
  },
  "128": {
   "jp": "a57158d3",
   "kr": "자네들도 서 있지 말고"
  },
  "129": {
   "jp": "36c5ae3d",
   "kr": "앉아서 들으면 어떤가?"
  },
  "130": {
   "jp": "8ecff1bb",
   "kr": "올도스 대성당에서"
  },
  "131": {
   "jp": "4f136d44",
   "kr": "신관장님 말씀을 들을 수 있다니,"
  },
  "132": {
   "jp": "5d5ea4fd",
   "kr": "꿈만 같아요."
  },
  "133": {
   "jp": "93b2a638",
   "kr": "저기저기"
  },
  "134": {
   "jp": "6c0ec257",
   "kr": "무슨 얘기 하는 거야?"
  },
  "135": {
   "jp": "29acf1c9",
   "kr": "뜻 알겠어?"
  },
  "136": {
   "jp": "496b0bd1",
   "kr": "쉿!"
  },
  "137": {
   "jp": "1f3504f7",
   "kr": "신관장님 말씀이 안 들리잖아."
  }
 }
}