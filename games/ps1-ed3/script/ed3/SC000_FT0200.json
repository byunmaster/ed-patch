 "archive": "/SCE0/SC000.DAT",
 "member": "..\\DATA\\FT0200.BIN",
 "lines": {
  "0": {
   "jp": "bb708123",
   "kr": "라그픽 마을"
  },
  "1": {
   "jp": "97f330c3",
   "kr": "서쪽 들판"
  },
  "2": {
   "jp": "07875a83",
   "kr": "살았어, 쥬리오."
  },
  "3": {
   "jp": "b5ed3eed",
   "kr": "약초를 찾고 있는데"
  },
  "4": {
   "jp": "4e5756cc",
   "kr": "갑자기 이렇게 큰 멧돼지가"
  },
  "5": {
   "jp": "dbcc12f5",
   "kr": "튀어나오잖아…"
  },
  "6": {
   "jp": "3e6ffa75",
   "kr": "나, 깜짝 놀랐어."
  },
  "7": {
   "jp": "5958d333",
   "kr": "엇? 멧돼지 전골!?"
  },
  "8": {
   "jp": "2fa7cbe2",
   "kr": "뭐〜야."
  },
  "9": {
   "jp": "79efeebd",
   "kr": "그럼, 날 구하러 온 게 아니었네."
  },
  "10": {
   "jp": "6b745ee5",
   "kr": "저기, 크리스도 멧돼지 먹으러 와."
  },
  "11": {
   "jp": "d678b6da",
   "kr": "고마워."
  },
  "12": {
   "jp": "ad2ec0ec",
   "kr": "근데 내일부터 순례 여행이고,"
  },
  "13": {
   "jp": "23767bec",
   "kr": "한동안 가족과 식사하지 못하니까,"
  },
  "14": {
   "jp": "cbf70093",
   "kr": "나도 오늘 밤은 집에서 먹을래."
  },
  "15": {
   "jp": "ce4d0712",
   "kr": "그렇겠네. 그게 좋겠어."
  },
  "16": {
   "jp": "f4fea089",
   "kr": "근데 큰 멧돼지네."
  },
  "17": {
   "jp": "7399dddb",
   "kr": "집까지 옮기는 거 도와줄게."
  },
  "18": {
   "jp": "f79aa3a9",
   "kr": "혼자선 힘들 것 같으니까."
  }
 }
}