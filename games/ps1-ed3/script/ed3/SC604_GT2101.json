{
 "archive": "/SCE6/SC604.DAT",
 "member": "..\\DATA\\GT2101.BIN",
 "lines": {
  "0": {
   "jp": "dc464821",
   "kr": "기드넬"
  },
  "1": {
   "jp": "4300e71e",
   "kr": "우르기드 저택"
  },
  "2": {
   "jp": "737e4131",
   "kr": "사막의 흑표범"
  },
  "3": {
   "jp": "cde94c98",
   "kr": "탄돌"
  },
  "4": {
   "jp": "386d7c46",
   "kr": "파시아"
  },
  "5": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "6": {
   "jp": "a1f31482",
   "kr": "어서 안으로."
  },
  "7": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "8": {
   "jp": "52c6aa10",
   "kr": "오오, 파시아."
  },
  "9": {
   "jp": "6ec6e422",
   "kr": "이쪽에 수상한 놈 안 왔나?"
  },
  "10": {
   "jp": "8d53eabe",
   "kr": "아뇨, 아무도."
  },
  "11": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "12": {
   "jp": "6f5af2a3",
   "kr": "딴 데를 찾아볼까."
  },
  "13": {
   "jp": "727c3f0f",
   "kr": "고마워, 살았어."
  },
  "14": {
   "jp": "a3b48ae9",
   "kr": "구해 준 건 고맙다만"
  },
  "15": {
   "jp": "a3c1a35c",
   "kr": "우린 당신 때문에"
  },
  "16": {
   "jp": "47e0734c",
   "kr": "계속 험한 꼴만 당했다고."
  },
  "17": {
   "jp": "799518e6",
   "kr": "어쩔 셈이냐."
  },
  "18": {
   "jp": "7083782a",
   "kr": "미안해요."
  },
  "19": {
   "jp": "ae7f12d7",
   "kr": "사막의 흑표범은 복면을 벗는 시늉을 했다."
  },
  "20": {
   "jp": "d04d02d0",
   "kr": "어?"
  },
  "21": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "22": {
   "jp": "bfa2af40",
   "kr": "나, 나제 씨…"
  },
  "23": {
   "jp": "eb6639c5",
   "kr": "나제 씨가… 사막의 흑표범?"
  },
  "24": {
   "jp": "fe642fc6",
   "kr": "여러분에게 폐를 끼칠 생각은"
  },
  "25": {
   "jp": "45e95513",
   "kr": "없었는데… 미안해요."
  },
  "26": {
   "jp": "34cf56fa",
   "kr": "그, 그랬구나…"
  },
  "27": {
   "jp": "efe3a667",
   "kr": "아니, 그, 나제 씨라면 괜찮다고."
  },
  "28": {
   "jp": "ef37660d",
   "kr": "모진 말 해서 미안했다."
  },
  "29": {
   "jp": "ac6d483d",
   "kr": "왜 나제 씨라면 괜찮은 거야?"
  },
  "30": {
   "jp": "c58ae254",
   "kr": "뭐든지다. 괜찮아."
  },
  "31": {
   "jp": "ff4ce87a",
   "kr": "이 나라는 우르기드 뜻대로예요."
  },
  "32": {
   "jp": "9921b0e2",
   "kr": "모두 어떻게든 해야 한다고 생각합니다."
  },
  "33": {
   "jp": "53741062",
   "kr": "하지만 생각만으론 아무것도 해결 안 돼요."
  },
  "34": {
   "jp": "3579a845",
   "kr": "호상들의 무법에 맞서야만 해요."
  },
  "35": {
   "jp": "7372bf50",
   "kr": "기드나에도 아까 파시아 씨 같은 협력자가"
  },
  "36": {
   "jp": "9009f37d",
   "kr": "있습니다. 저는 그분들을 위해서라도"
  },
  "37": {
   "jp": "28a38bbb",
   "kr": "사막의 흑표범이 되어 일어선 거예요."
  },
  "38": {
   "jp": "bd24e7a8",
   "kr": "그랬구나. 좋은 이야기야."
  },
  "39": {
   "jp": "a37d020c",
   "kr": "나도 협력할게."
  },
  "40": {
   "jp": "29064d54",
   "kr": "사막의 흑표범은 기뻐 고개를 끄덕였다."
  },
  "41": {
   "jp": "12ca95fb",
   "kr": "나제라는 이름은"
  },
  "42": {
   "jp": "74401ef2",
   "kr": "관리를 속이기 위한 가명이에요."
  },
  "43": {
   "jp": "466c4a0a",
   "kr": "본명은 스텔라라고 해요."
  },
  "44": {
   "jp": "d91e1f8b",
   "kr": "나제… 사막의 흑표범… 스텔라…"
  },
  "45": {
   "jp": "fa1bac8a",
   "kr": "대체 이름을 몇 개나 갖고 있는 거냐…"
  },
  "46": {
   "jp": "ed18f0a8",
   "kr": "앞으로는 스텔라라고 불러 주세요."
  },
  "47": {
   "jp": "8cfd195e",
   "kr": "스텔라가 거짓 없는 본명이니까요."
  },
  "48": {
   "jp": "22b1afb8",
   "kr": "네, 알겠어요."
  },
  "49": {
   "jp": "9308f847",
   "kr": "방금 소동으로 우르기드는 동요하고 있어요."
  },
  "50": {
   "jp": "18f01297",
   "kr": "저도 협력할게요."
  },
  "51": {
   "jp": "bae0c0ab",
   "kr": "지금이 기회예요. 당장 크리스 씨의"
  },
  "52": {
   "jp": "5e2f380b",
   "kr": "구출 작전을 재개해요."
  },
  "53": {
   "jp": "945a5504",
   "kr": "그치만 크리스가 잡혀 있는 곳은"
  },
  "54": {
   "jp": "b9956379",
   "kr": "철문에 방 벽도 석조란 말이야."
  },
  "55": {
   "jp": "a93c5722",
   "kr": "폭탄으로도 못 뚫어요."
  },
  "56": {
   "jp": "f54f49db",
   "kr": "그건 알아봐 뒀어요."
  },
  "57": {
   "jp": "9babcde7",
   "kr": "그 방은 바깥문과 안문이 있어서"
  },
  "58": {
   "jp": "b1f007c2",
   "kr": "바깥은 철문이지만"
  },
  "59": {
   "jp": "087133a3",
   "kr": "안은 목제 평범한 문이에요."
  },
  "60": {
   "jp": "1e1110ea",
   "kr": "철문만 어떻게든 하면"
  },
  "61": {
   "jp": "4237376f",
   "kr": "안문은 날려 버릴 수 있어요."
  },
  "62": {
   "jp": "d6bc055a",
   "kr": "으음…"
  },
  "63": {
   "jp": "b1b86c74",
   "kr": "철문을 열게 할 방법이 있으면 좋을 텐데."
  },
  "64": {
   "jp": "33d6d0d6",
   "kr": "밖에서 다시 소동을 일으키면"
  },
  "65": {
   "jp": "3022e1f0",
   "kr": "안에 있는 감시병도 상황을 보러"
  },
  "66": {
   "jp": "3406b420",
   "kr": "분명 나올 거예요."
  },
  "67": {
   "jp": "ef3f7f34",
   "kr": "소동을 일으켜요?"
  },
  "68": {
   "jp": "f0e0f6ad",
   "kr": "우리가 지금 있는 이 헛간을 폭파해요."
  },
  "69": {
   "jp": "c85721eb",
   "kr": "이 헛간을?"
  },
  "70": {
   "jp": "13d53f94",
   "kr": "네, 이 헛간을 폭파하면"
  },
  "71": {
   "jp": "a7034b7e",
   "kr": "병사들은 이리로 몰려올 거예요."
  },
  "72": {
   "jp": "d4167bb9",
   "kr": "응, 그렇군."
  },
  "73": {
   "jp": "cbd2b931",
   "kr": "이 헛간은 저택에서 떨어져 있고"
  },
  "74": {
   "jp": "311ce039",
   "kr": "병사들을 불러들여 시간을 벌기에는"
  },
  "75": {
   "jp": "c4c97662",
   "kr": "안성맞춤이다."
  },
  "76": {
   "jp": "bdaf4778",
   "kr": "아까 헛간이 부서져서"
  },
  "77": {
   "jp": "ddd3a390",
   "kr": "우르기드 쪽은 경계를 강화하고 있으니까요."
  },
  "78": {
   "jp": "73d0d7ba",
   "kr": "반드시 이리로 몰려올 거예요."
  },
  "79": {
   "jp": "8358d8f8",
   "kr": "역시, 스텔라 씨."
  },
  "80": {
   "jp": "6ebc5c61",
   "kr": "여긴 제가 폭파할게요."
  },
  "81": {
   "jp": "a38e8ce2",
   "kr": "쥬리오 씨, 이걸."
  },
  "82": {
   "jp": "a13d519d",
   "kr": "스텔라는 쥬리오에게 폭탄을 줬다."
  },
  "83": {
   "jp": "100597bf",
   "kr": "그걸로 방 안의 문을 부숴 주세요."
  },
  "84": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "85": {
   "jp": "ae6c4ea7",
   "kr": "병사들에게 들키지 않도록"
  },
  "86": {
   "jp": "78fa4657",
   "kr": "조심하세요."
  },
  "87": {
   "jp": "83070a3c",
   "kr": "네, 괜찮을 거예요."
  },
  "88": {
   "jp": "1e6f1262",
   "kr": "좋았어"
  },
  "89": {
   "jp": "c182ca5d",
   "kr": "당장 작전 개시다."
  },
  "90": {
   "jp": "cabb96ee",
   "kr": "얍!"
  }
 }
}