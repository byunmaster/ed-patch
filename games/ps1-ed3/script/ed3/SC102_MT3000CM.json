{
 "archive": "/SCE1/SC102.DAT",
 "member": "..\\DATA\\MT3000CM.BIN",
 "lines": {
  "0": {
   "jp": "698552d4",
   "kr": "(모리슨 녀석… 어디로 가 버린 게냐.)"
  },
  "1": {
   "jp": "0343ffc8",
   "kr": "(아니, 곤란하군…)"
  },
  "2": {
   "jp": "b85ce8c0",
   "kr": "아저씨, 뭐 해?"
  },
  "3": {
   "jp": "3adae119",
   "kr": "………"
  },
  "4": {
   "jp": "a3f06cc1",
   "kr": "어라? 쥬리오."
  },
  "5": {
   "jp": "be8ad11c",
   "kr": "이 아저씨, 치타 입구에서 본"
  },
  "6": {
   "jp": "1e9faf53",
   "kr": "좀 이상한 아저씨야."
  },
  "7": {
   "jp": "89fd3a85",
   "kr": "아, 진짜네."
  },
  "8": {
   "jp": "b9fa0dcb",
   "kr": "저기, 아저씨."
  },
  "9": {
   "jp": "bb84ef1b",
   "kr": "이런 데서 뭐 해?"
  },
  "10": {
   "jp": "3078e587",
   "kr": "……응?"
  },
  "11": {
   "jp": "8aa8e0ae",
   "kr": "어쩐지 멍하네."
  },
  "12": {
   "jp": "cf0a3c0f",
   "kr": "배가 고픈 걸지도 몰라."
  },
  "13": {
   "jp": "e7e15c0e",
   "kr": "꾸르르륵!"
  },
  "14": {
   "jp": "ed37476f",
   "kr": "알프의 배가 울렸다."
  },
  "15": {
   "jp": "aaa59133",
   "kr": "응, 그런 것 같네."
  },
  "16": {
   "jp": "7e2dad36",
   "kr": "저기, 아저씨."
  },
  "17": {
   "jp": "5a6cce91",
   "kr": "이런 데서 멍하니 있다가는"
  },
  "18": {
   "jp": "01b9ba7a",
   "kr": "감기 걸려."
  },
  "19": {
   "jp": "23c76720",
   "kr": "……?"
  },
  "20": {
   "jp": "38a4494a",
   "kr": "뭐냐, 너희는!"
  },
  "21": {
   "jp": "3e1ac231",
   "kr": "친절로 말해 주는데"
  },
  "22": {
   "jp": "21422484",
   "kr": "뭐냐는 무슨."
  },
  "23": {
   "jp": "72c768f9",
   "kr": "여행으로 지쳤을 땐"
  },
  "24": {
   "jp": "fc8f4cf9",
   "kr": "오히려 혼자 있으면 위험하단 말이야."
  },
  "25": {
   "jp": "a651d03f",
   "kr": "쓰러져 죽을지도 몰라."
  },
  "26": {
   "jp": "4bb0a42c",
   "kr": "크리스, 그만둬…"
  },
  "27": {
   "jp": "97307bc7",
   "kr": "가도에서 쓰러져 죽는 거라면"
  },
  "28": {
   "jp": "dde10ab1",
   "kr": "그나마 이해가 가지만 마을 안에서"
  },
  "29": {
   "jp": "16a97112",
   "kr": "쓰러져 죽다니 꼴사납잖아."
  },
  "30": {
   "jp": "baf37444",
   "kr": "무례한 것들, 내가 쓰러져 죽는다고!"
  },
  "31": {
   "jp": "a765e818",
   "kr": "감히 이 몸에게… 그런 일이"
  },
  "32": {
   "jp": "bdec7eb1",
   "kr": "있을 수 있겠느냐."
  },
  "33": {
   "jp": "cb473fa7",
   "kr": "아직도 그런 소리."
  },
  "34": {
   "jp": "f567c6e4",
   "kr": "누구든 방심하면 혹독한 일을 당하는 법이야."
  },
  "35": {
   "jp": "a3a12db1",
   "kr": "여행을 할 거면 좀 더 솔직해져야지"
  },
  "36": {
   "jp": "067d24b6",
   "kr": "오래 못 살아, 아저씨."
  },
  "37": {
   "jp": "e824efc4",
   "kr": "아저씨라 부르지 마라!"
  },
  "38": {
   "jp": "15771c59",
   "kr": "그래도 아저씨는 아저씨잖아!!"
  },
  "39": {
   "jp": "4800d17e",
   "kr": "으으으윽…!"
  },
  "40": {
   "jp": "0ae83252",
   "kr": "크리스"
  },
  "41": {
   "jp": "ba6f8c1b",
   "kr": "으, 으으으으읏!!"
  },
  "42": {
   "jp": "895f7613",
   "kr": "쥬리오에게는 노려보는 크리스와 알프 사이에"
  },
  "43": {
   "jp": "00c2c656",
   "kr": "불꽃이 튀는 것처럼 보였다."
  },
  "44": {
   "jp": "1238edef",
   "kr": "찌릿…!!"
  },
  "45": {
   "jp": "3779826c",
   "kr": "으윽… 끙."
  },
  "46": {
   "jp": "71503d00",
   "kr": "훌륭하군…"
  },
  "47": {
   "jp": "c90db68e",
   "kr": "…내가 졌다."
  },
  "48": {
   "jp": "0c4efb2a",
   "kr": "꾸르르륵!"
  },
  "49": {
   "jp": "ab9fc2b1",
   "kr": "알프의 배가 또 울렸다."
  },
  "50": {
   "jp": "d2fc89af",
   "kr": "쥬리오. 분명 에메나 씨한테 받은"
  },
  "51": {
   "jp": "75dc53f6",
   "kr": "말린 보리가 있었지? 그걸 짐에서"
  },
  "52": {
   "jp": "c4234f2a",
   "kr": "좀 꺼내 줘."
  },
  "53": {
   "jp": "b441d8f5",
   "kr": "아, 네."
  },
  "54": {
   "jp": "1abaf612",
   "kr": "음, 이거네."
  },
  "55": {
   "jp": "9999a8c5",
   "kr": "쥬리오는 크리스에게 말린 보리를 줬다."
  },
  "56": {
   "jp": "375b8a47",
   "kr": "아저씨, 졌으니까"
  },
  "57": {
   "jp": "f45f0544",
   "kr": "말을 들으라고."
  },
  "58": {
   "jp": "ff147cba",
   "kr": "자, 이걸 먹어."
  },
  "59": {
   "jp": "45c157c1",
   "kr": "알프는 크리스에게서 말린 보리를 받았다."
  },
  "60": {
   "jp": "2729c7a9",
   "kr": "아가씨…"
  },
  "61": {
   "jp": "db1ff4ab",
   "kr": "됐으니까 얼른 먹어."
  },
  "62": {
   "jp": "27a44bd3",
   "kr": "그래도 보고 있으면… 부끄럽구먼."
  },
  "63": {
   "jp": "5994bd6c",
   "kr": "손이 많이 가는 아저씨네."
  },
  "64": {
   "jp": "d23054d9",
   "kr": "알았어. 우리는 조금 떨어져 있을게."
  },
  "65": {
   "jp": "fb81a05f",
   "kr": "남기지 말고 전부 다 먹어야 해."
  },
  "66": {
   "jp": "bee1378b",
   "kr": "그래."
  }
 }
}