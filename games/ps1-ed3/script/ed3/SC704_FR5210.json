{
 "archive": "/SCE7/SC704.DAT",
 "member": "..\\DATA\\FR5210.BIN",
 "lines": {
  "0": {
   "jp": "118f0213",
   "kr": "게르드 언덕"
  },
  "1": {
   "jp": "f2db36d7",
   "kr": "게르드"
  },
  "2": {
   "jp": "f6419219",
   "kr": "살짝 푸른빛이 도는"
  },
  "3": {
   "jp": "0d87416b",
   "kr": "아름다운 은빛 머리를 하고 있었다."
  },
  "4": {
   "jp": "362f3f03",
   "kr": "게르드를 만나고"
  },
  "5": {
   "jp": "5b4c5f56",
   "kr": "그 아이가 왜 하얀마녀라 불리는지"
  },
  "6": {
   "jp": "2fd40fa6",
   "kr": "바로 알 수 있었다."
  },
  "7": {
   "jp": "094970a2",
   "kr": "마녀라는 말의 울림으로는"
  },
  "8": {
   "jp": "09df4038",
   "kr": "도저히 상상할 수 없다."
  },
  "9": {
   "jp": "b6bba9b4",
   "kr": "투명한 샘물 같은 아이였던 것이다."
  },
  "10": {
   "jp": "84edd189",
   "kr": "게르드는 추격자인 나를 보고"
  },
  "11": {
   "jp": "d01e5d6f",
   "kr": "슬픈 표정을 지었다."
  },
  "12": {
   "jp": "a0ddab3b",
   "kr": "하지만 그 표정은 자신을 위한 게 아니었고"
  },
  "13": {
   "jp": "e6558f4d",
   "kr": "나를 위한 것도 아니었다."
  },
  "14": {
   "jp": "c22526b8",
   "kr": "하얀마녀 게르드는"
  },
  "15": {
   "jp": "e9499d61",
   "kr": "세상 모든 이에게 자애를 향하며"
  },
  "16": {
   "jp": "33c960c1",
   "kr": "다가올 재앙을 염려하고 있었던 것이다."
  },
  "17": {
   "jp": "fa0d70fa",
   "kr": "게르드는 시냇물 소리로 시선을 옮기고"
  },
  "18": {
   "jp": "989f1989",
   "kr": "이렇게 말했다."
  },
  "19": {
   "jp": "5722d73d",
   "kr": "머지않아"
  },
  "20": {
   "jp": "784a74fb",
   "kr": "이 나라도 빈부 차로 마음이 가라앉아"
  },
  "21": {
   "jp": "7afd453b",
   "kr": "시냇물 소리도 마르게 될 거예요."
  },
  "22": {
   "jp": "9cc255e4",
   "kr": "하지만 그건"
  },
  "23": {
   "jp": "210426c9",
   "kr": "누구의 탓도 아니에요."
  },
  "24": {
   "jp": "d6ec16aa",
   "kr": "사람들의 마음이 바라는 것을"
  },
  "25": {
   "jp": "c6e744b4",
   "kr": "자연이 비춰 줄 뿐인 거예요."
  },
  "26": {
   "jp": "07e324f4",
   "kr": "하얀마녀를 체포하라."
  },
  "27": {
   "jp": "5400de15",
   "kr": "힘에 부치면 죽여도 상관없다."
  },
  "28": {
   "jp": "44e61a64",
   "kr": "처음부터 내키지 않는 임무였다."
  },
  "29": {
   "jp": "dd1b8412",
   "kr": "게르드를 만나면서"
  },
  "30": {
   "jp": "b71274fa",
   "kr": "나는 잊어 가던 진실을 되찾은 기분이었다."
  },
  "31": {
   "jp": "7fe25c2e",
   "kr": "나는 한동안 게르드의 순례를"
  },
  "32": {
   "jp": "675b234d",
   "kr": "지켜보기로 했다."
  },
  "33": {
   "jp": "1b0b457a",
   "kr": "게르드는 마을에서 마을로 여행을 이어 가며"
  },
  "34": {
   "jp": "92637f27",
   "kr": "지나간 마을에"
  },
  "35": {
   "jp": "aed03a10",
   "kr": "갖가지 말을 남겼다."
  },
  "36": {
   "jp": "d3172f8e",
   "kr": "사람들에게 내일을 향한 경고를 설한 것이다."
  },
  "37": {
   "jp": "73a46354",
   "kr": "나아갈 길. 명심해야 할 사항…"
  },
  "38": {
   "jp": "4ff47480",
   "kr": "물론 하얀마녀의 말을"
  },
  "39": {
   "jp": "2a058615",
   "kr": "호의적으로 받아들이는 사람만은 아니었다."
  },
  "40": {
   "jp": "68e4220b",
   "kr": "아직 칸드도 챠펠도 없이"
  },
  "41": {
   "jp": "2704e549",
   "kr": "마법이 사람들의 힘이 되기 전이었다."
  },
  "42": {
   "jp": "a8c2c491",
   "kr": "남에게 없는 힘을 가졌다는 이유만으로"
  },
  "43": {
   "jp": "2db2a62b",
   "kr": "다수는 겁먹었고, 어떤 이는 적의를 숨김없이"
  },
  "44": {
   "jp": "a467ed85",
   "kr": "게르드에게 부딪쳤다."
  },
  "45": {
   "jp": "e90326df",
   "kr": "그래도"
  },
  "46": {
   "jp": "b89d6e69",
   "kr": "게르드는 여행을 그만두려 하지 않았다."
  },
  "47": {
   "jp": "ea8bc6d7",
   "kr": "아무리 마녀라 해도 열여덟 살 소녀다."
  },
  "48": {
   "jp": "899481ba",
   "kr": "사람들의 반응에 마음 아파한 적도"
  },
  "49": {
   "jp": "de2ccece",
   "kr": "없었던 건 아니다."
  },
  "50": {
   "jp": "bc7172c6",
   "kr": "그것이 얼마나 중요한 순례인지…"
  },
  "51": {
   "jp": "49a92bf2",
   "kr": "누구를 위한 순례인지…"
  },
  "52": {
   "jp": "b467965e",
   "kr": "그 아이는…"
  },
  "53": {
   "jp": "af109746",
   "kr": "그 의미를 모르는 사람들을 위해 여행하고"
  },
  "54": {
   "jp": "00fe1b35",
   "kr": "스스로를 깎아내리는 순례를 이어 갔다."
  },
  "55": {
   "jp": "4c3a52ed",
   "kr": "말해 봐도 이해받지 못하고."
  },
  "56": {
   "jp": "b7cee96e",
   "kr": "욕을 먹어도"
  },
  "57": {
   "jp": "eb62cf8f",
   "kr": "말대꾸조차 할 수 없다…"
  },
  "58": {
   "jp": "a17951f9",
   "kr": "그것이 얼마나 괴로운 것인지"
  },
  "59": {
   "jp": "8a0f9236",
   "kr": "나는 게르드의 여행을 보며"
  },
  "60": {
   "jp": "ff1cc182",
   "kr": "가슴 아플 만큼 잘 알게 되었다."
  },
  "61": {
   "jp": "b2a0c917",
   "kr": "게르드는 내게 이야기해 주었다."
  },
  "62": {
   "jp": "6de1bd4d",
   "kr": "나의 조국, 폴티아가"
  },
  "63": {
   "jp": "0ff24d7c",
   "kr": "일으키려 하는 잘못을…"
  },
  "64": {
   "jp": "bae60adb",
   "kr": "세계가 맞이하려 하는 재앙의 파도를…"
  },
  "65": {
   "jp": "527ad31d",
   "kr": "그리고 게르드 자신의 목숨이"
  },
  "66": {
   "jp": "d11b6592",
   "kr": "뜻을 다 이루지 못하고 스러질 운명임을…"
  },
  "67": {
   "jp": "086dd0bc",
   "kr": "그 아이는 자기 미래까지도 알고 있었다."
  },
  "68": {
   "jp": "000d3940",
   "kr": "그런데도 게르드는 세계에 희망을 남기려고"
  },
  "69": {
   "jp": "fa8e9e2b",
   "kr": "순례를 계속해야만 했다."
  },
  "70": {
   "jp": "9b9100e1",
   "kr": "이제"
  },
  "71": {
   "jp": "1bb14c8d",
   "kr": "내가 게르드를 붙잡을 수 있을"
  },
  "72": {
   "jp": "3f4991c1",
   "kr": "리가 없었다."
  },
  "73": {
   "jp": "a794e3ec",
   "kr": "나는 폴티아로 돌아가"
  },
  "74": {
   "jp": "6bf967ad",
   "kr": "하얀마녀의 체포를 철회하도록"
  },
  "75": {
   "jp": "ef745449",
   "kr": "진언해 보기로 했다."
  },
  "76": {
   "jp": "39ff412b",
   "kr": "그리고"
  },
  "77": {
   "jp": "66f0c124",
   "kr": "그 전에 한 번 더 이야기를 듣고 싶다고…"
  },
  "78": {
   "jp": "80596f94",
   "kr": "하지만…"
  },
  "79": {
   "jp": "6ecf987c",
   "kr": "운명의 날은 눈이 쌓인 가도에서"
  },
  "80": {
   "jp": "7c8d64ef",
   "kr": "갑자기 찾아온 것이다."
  }
 }
}