{
 "archive": "/SCE8/SC809.DAT",
 "member": "..\\DATA\\RC7001.BIN",
 "lines": {
  "0": {
   "jp": "4651181e",
   "kr": "이자벨의 탑"
  },
  "1": {
   "jp": "a2090e26",
   "kr": "옥상"
  },
  "2": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "3": {
   "jp": "77efe7c9",
   "kr": "게르드는…?"
  },
  "4": {
   "jp": "c9712b21",
   "kr": "라우알의 파도와 함께"
  },
  "5": {
   "jp": "49feea4d",
   "kr": "존재 그 자체가"
  },
  "6": {
   "jp": "6dc88940",
   "kr": "사라져 버렸습니다."
  },
  "7": {
   "jp": "8c10a334",
   "kr": "없어…"
  },
  "8": {
   "jp": "fc6fe900",
   "kr": "없어져 버렸다는 거야?"
  },
  "9": {
   "jp": "4c859428",
   "kr": "이제 어딜 찾아봐도"
  },
  "10": {
   "jp": "60fc7d10",
   "kr": "보이지 않아."
  },
  "11": {
   "jp": "223a4458",
   "kr": "혼조차도…"
  },
  "12": {
   "jp": "69637443",
   "kr": "세계를 구해 준 은인에게,"
  },
  "13": {
   "jp": "569b550a",
   "kr": "고맙다는 말조차 할 수 없는 거네요."
  },
  "14": {
   "jp": "9ffced10",
   "kr": "하얀마녀는 인사 따윈 안 바라."
  },
  "15": {
   "jp": "3b894c32",
   "kr": "그렇죠…"
  },
  "16": {
   "jp": "ee50dcea",
   "kr": "그렇지."
  },
  "17": {
   "jp": "742c320a",
   "kr": "게다가 감사라면"
  },
  "18": {
   "jp": "a48e2fab",
   "kr": "마주하지 않아도 할 수 있다."
  },
  "19": {
   "jp": "11f43c89",
   "kr": "그 마음을 소중히 간직하면 되는 거다."
  },
  "20": {
   "jp": "69b567ec",
   "kr": "나는 하얀마녀가 그렇다는 걸"
  },
  "21": {
   "jp": "e7cac656",
   "kr": "이 세계의 우리에게"
  },
  "22": {
   "jp": "720a4d55",
   "kr": "가르쳐 준 게 아닐까 생각해."
  },
  "23": {
   "jp": "173e6a84",
   "kr": "우리도 꽤 열심히 했는데 말이야."
  },
  "24": {
   "jp": "26f2c77a",
   "kr": "어쩐지 하얀마녀한테"
  },
  "25": {
   "jp": "e8c960c6",
   "kr": "멋진 장면은"
  },
  "26": {
   "jp": "8dd4c85a",
   "kr": "전부 뺏겨 버렸네."
  },
  "27": {
   "jp": "c392ab13",
   "kr": "할 수 없지."
  },
  "28": {
   "jp": "c8ea0939",
   "kr": "유령한텐 못 이기지."
  },
  "29": {
   "jp": "f39b7838",
   "kr": "허크 삼촌."
  },
  "30": {
   "jp": "d04eb3ea",
   "kr": "천의실에서 말하려던"
  },
  "31": {
   "jp": "4b485fc5",
   "kr": "또 하나의 방법이란 뭐야?"
  },
  "32": {
   "jp": "f51c09e6",
   "kr": "그게 기드나의 유적에서 알게 됐지."
  },
  "33": {
   "jp": "b59946a3",
   "kr": "새로운 사실이야?"
  },
  "34": {
   "jp": "0a0b8edd",
   "kr": "그 얘기 말이냐?"
  },
  "35": {
   "jp": "7573cb12",
   "kr": "이제 와선 부끄러운 방법이지."
  },
  "36": {
   "jp": "5cc76a03",
   "kr": "게르드 언덕에"
  },
  "37": {
   "jp": "3a04b609",
   "kr": "듀르젤 공이 새긴 가가브력의"
  },
  "38": {
   "jp": "8bd0035e",
   "kr": "비문이 있었잖아."
  },
  "39": {
   "jp": "087c00a0",
   "kr": "그걸 보고, 혹시나 싶었지."
  },
  "40": {
   "jp": "1cde20e5",
   "kr": "라우알의 파도와 가가브의 큰 균열이"
  },
  "41": {
   "jp": "dcd30a9f",
   "kr": "묘하게 머릿속에서 겹쳐졌어."
  },
  "42": {
   "jp": "20b13b93",
   "kr": "그 답이"
  },
  "43": {
   "jp": "a3fbd81b",
   "kr": "기드나의 유적에 있을 것 같아서."
  },
  "44": {
   "jp": "75425896",
   "kr": "…생각한 대로였어."
  },
  "45": {
   "jp": "757ecb27",
   "kr": "라우알의 파도의 위협은"
  },
  "46": {
   "jp": "a5a656d4",
   "kr": "이번이 처음이 아니었던 거야."
  },
  "47": {
   "jp": "d95e7cda",
   "kr": "지금으로부터 992년 전에도,"
  },
  "48": {
   "jp": "4a6aa48f",
   "kr": "라우알의 파도는"
  },
  "49": {
   "jp": "26a93220",
   "kr": "이 세계에 나타났었어."
  },
  "50": {
   "jp": "1218b8de",
   "kr": "992년 전이라면,"
  },
  "51": {
   "jp": "607c5dff",
   "kr": "가가브력이 시작된 해잖아."
  },
  "52": {
   "jp": "b8ee8d6f",
   "kr": "땅에 새겨진 가가브야말로"
  },
  "53": {
   "jp": "62c1a08d",
   "kr": "일찍이 이빨을 드러낸 라우알의 파도"
  },
  "54": {
   "jp": "59735f98",
   "kr": "가 남긴 발톱 자국이었던 거란다."
  },
  "55": {
   "jp": "c7a48ba6",
   "kr": "과거에도 이계에서 라우알의 파도가"
  },
  "56": {
   "jp": "486c4428",
   "kr": "불려 왔던 거야?"
  },
  "57": {
   "jp": "15ff1836",
   "kr": "아니. 그렇지 않아."
  },
  "58": {
   "jp": "f3055bfd",
   "kr": "라우알의 파도의 근원이 된 상념은"
  },
  "59": {
   "jp": "ccea6017",
   "kr": "이 세계에서 태어나,"
  },
  "60": {
   "jp": "fc91a0a9",
   "kr": "그것을 당시 사람들이 이계로 밀어낸 거야."
  },
  "61": {
   "jp": "ad3002a7",
   "kr": "이 세계 사람들이…"
  },
  "62": {
   "jp": "4736a281",
   "kr": "그런가…"
  },
  "63": {
   "jp": "db7097ad",
   "kr": "그게 이자벨 왕비가 말했던"
  },
  "64": {
   "jp": "ceec6c41",
   "kr": "우리 세계의 죄인 거야."
  },
  "65": {
   "jp": "179bbf07",
   "kr": "죄…?"
  },
  "66": {
   "jp": "359cc6a5",
   "kr": "확실히.. 그 말대로야."
  },
  "67": {
   "jp": "148affbe",
   "kr": "기드나의 유적에,"
  },
  "68": {
   "jp": "9e936657",
   "kr": "그때 사람들이 남긴 비문이 남아 있었어."
  },
  "69": {
   "jp": "087ad0b4",
   "kr": "아무래도 당시에는"
  },
  "70": {
   "jp": "ad578745",
   "kr": "지금보다 정신문명이 발달했던 듯하고,"
  },
  "71": {
   "jp": "10b709b3",
   "kr": "빈번히 마법이 쓰였던 모양이야."
  },
  "72": {
   "jp": "0ede3427",
   "kr": "우리 세계가"
  },
  "73": {
   "jp": "d27aa16b",
   "kr": "재앙의 발단을 만든 거야…"
  },
  "74": {
   "jp": "97fdaf6e",
   "kr": "그래, 그럴지도 몰라."
  },
  "75": {
   "jp": "ff772361",
   "kr": "어쩌면"
  },
  "76": {
   "jp": "a8306ad6",
   "kr": "그 전에도 몇 번이나 같은 일이"
  },
  "77": {
   "jp": "7e1705a6",
   "kr": "되풀이됐는지도 모르지만…"
  },
  "78": {
   "jp": "601cc22b",
   "kr": "이계 사람들이"
  },
  "79": {
   "jp": "fded17cb",
   "kr": "우리를 미워한 것도 당연해."
  },
  "80": {
   "jp": "3f9ce647",
   "kr": "이 세계에"
  },
  "81": {
   "jp": "6a477e25",
   "kr": "그런 과거가 있었다니…"
  },
  "82": {
   "jp": "86ae7356",
   "kr": "우리처럼 마법을 쓰는 자가 있는 것도,"
  },
  "83": {
   "jp": "d761f68b",
   "kr": "과거에 있던 정신문명의 흔적일지도 모르죠."
  },
  "84": {
   "jp": "73aa1a7a",
   "kr": "기드나의 유적에 남겨진 비문에는"
  },
  "85": {
   "jp": "5c99d196",
   "kr": "라우알의 파도 재앙을 벗어날 세 가지 방법이"
  },
  "86": {
   "jp": "bf73d421",
   "kr": "적혀 있었어."
  },
  "87": {
   "jp": "a8544eab",
   "kr": "하나는,"
  },
  "88": {
   "jp": "971468a9",
   "kr": "라우알의 파도를 다른 세계로 쫓아내는 것."
  },
  "89": {
   "jp": "8ad03b54",
   "kr": "예전에 우리 조상이 쓰고,"
  },
  "90": {
   "jp": "c982557b",
   "kr": "이번에 다시 이계 사람들이 쓴 방법이다."
  },
  "91": {
   "jp": "b9e86750",
   "kr": "또 하나는 라우알의 파도가 좋아하는"
  },
  "92": {
   "jp": "6b7789b9",
   "kr": "탄식의 상념이 담긴 물체를 이용해서"
  },
  "93": {
   "jp": "464bf2b4",
   "kr": "봉인을 하는 방법이다."
  },
  "94": {
   "jp": "b0ba1f76",
   "kr": "그런 게 가능한가…"
  },
  "95": {
   "jp": "05e2d9d6",
   "kr": "천의실에서 내가 말하려던 건 이 방법이야."
  },
  "96": {
   "jp": "66ed8262",
   "kr": "라우알의 파도를 끌어들이는 천구의는,"
  },
  "97": {
   "jp": "35341ede",
   "kr": "동시에 이 세계의 비장의 카드도 되었지."
  },
  "98": {
   "jp": "2a37f02e",
   "kr": "끌려온 라우알의 파도는"
  },
  "99": {
   "jp": "face9f48",
   "kr": "반드시 탄식의 상념을 얻으려고"
  },
  "100": {
   "jp": "e877b6d2",
   "kr": "몸을 응축해 그릇 속으로 침입하는 듯하다."
  },
  "101": {
   "jp": "ac3215b0",
   "kr": "그때만은"
  },
  "102": {
   "jp": "85b194b2",
   "kr": "라우알의 파도가 무력해진다고 해."
  },
  "103": {
   "jp": "d92566ab",
   "kr": "그렇군."
  },
  "104": {
   "jp": "7a733150",
   "kr": "천구의 안에 있는 동안"
  },
  "105": {
   "jp": "0b6147aa",
   "kr": "결계를 만들어, 봉인하는"
  },
  "106": {
   "jp": "33ae5c79",
   "kr": "방법이 있었군요."
  },
  "107": {
   "jp": "88149875",
   "kr": "네."
  },
  "108": {
   "jp": "d619a3be",
   "kr": "하지만, 이 방법은 어디까지나 봉인이라서,"
  },
  "109": {
   "jp": "2d6d5ef8",
   "kr": "라우알의 파도의 힘은"
  },
  "110": {
   "jp": "4e96981c",
   "kr": "영원히 남아 버리는 겁니다."
  },
  "111": {
   "jp": "56c4f9f4",
   "kr": "언제 다시 봉인이 풀릴지"
  },
  "112": {
   "jp": "7eedb5bc",
   "kr": "모른다는 얘기네."
  },
  "113": {
   "jp": "14a43a25",
   "kr": "게다가, 탄식의 상념을 희생하기에"
  },
  "114": {
   "jp": "5171db1e",
   "kr": "혼을 빼앗긴 사람들을"
  },
  "115": {
   "jp": "61a27954",
   "kr": "원래대로 되돌릴 수도 없어."
  },
  "116": {
   "jp": "0e57dc6d",
   "kr": "세 번째 방법은?"
  },
  "117": {
   "jp": "139a5d06",
   "kr": "마지막 방법은,"
  },
  "118": {
   "jp": "a0b7f51d",
   "kr": "어두운 상념 덩어리인 라우알의 파도를"
  },
  "119": {
   "jp": "f5336669",
   "kr": "순수한 밝은 상념으로 정화하는 방법이다."
  },
  "120": {
   "jp": "064beafe",
   "kr": "그러니까,"
  },
  "121": {
   "jp": "57419cf9",
   "kr": "지금 게르드가 한 일이다."
  },
  "122": {
   "jp": "3451246a",
   "kr": "지금 돌이켜 보면"
  },
  "123": {
   "jp": "63e3c635",
   "kr": "게르드가 한 방법 이외에는,"
  },
  "124": {
   "jp": "db208b79",
   "kr": "어느 것도 진짜 해결책이 아니었던 셈이야."
  },
  "125": {
   "jp": "b5b2fe87",
   "kr": "그치만"
  },
  "126": {
   "jp": "9ad9bf46",
   "kr": "마지막 방법은 우리끼리는"
  },
  "127": {
   "jp": "af99e63a",
   "kr": "생각해 낼 수 없었고…"
  },
  "128": {
   "jp": "4a6aa48f",
   "kr": "라우알의 파도는"
  },
  "129": {
   "jp": "a75a68d8",
   "kr": "천구의로 향해 오고 있었으니까"
  },
  "130": {
   "jp": "b11b67e1",
   "kr": "봉인할 수밖에 없었겠네."
  },
  "131": {
   "jp": "1f77630f",
   "kr": "그 천구의를 부숴 버렸으니까."
  },
  "132": {
   "jp": "0adb62ce",
   "kr": "사실은,"
  },
  "133": {
   "jp": "56d48400",
   "kr": "이미 쓸 수 있는 수가 없었어."
  },
  "134": {
   "jp": "3d89de72",
   "kr": "하얀마녀가 구해 준 거군."
  },
  "135": {
   "jp": "4a6aa48f",
   "kr": "라우알의 파도는"
  },
  "136": {
   "jp": "5e08f94f",
   "kr": "게르드와 융합해 완전히 소멸했어."
  },
  "137": {
   "jp": "837ea70c",
   "kr": "이 세계도 이계도"
  },
  "138": {
   "jp": "177d50e0",
   "kr": "양쪽 모두"
  },
  "139": {
   "jp": "893f5abf",
   "kr": "게르드 덕에 구원받은 거야."
  },
  "140": {
   "jp": "3adae119",
   "kr": "………"
  },
  "141": {
   "jp": "f393c48f",
   "kr": "자,"
  },
  "142": {
   "jp": "d1880683",
   "kr": "루돌프 왕에게 가 보지 않겠나?"
  },
  "143": {
   "jp": "55374730",
   "kr": "자, 슬픈 얼굴은 그만하자."
  },
  "144": {
   "jp": "40feb184",
   "kr": "옥좌에는"
  },
  "145": {
   "jp": "aca7eaa2",
   "kr": "죠안나 씨가 남아 있을 테니까,"
  },
  "146": {
   "jp": "ad4a5298",
   "kr": "다 같이 가 보자고."
  }
 }
}