  "113": {
   "jp": "54a2b31f",
   "kr": "응, 그런 느낌이 들어."
  },
  "114": {
   "jp": "1b794916",
   "kr": "병사들은 묶여 있었지만,"
  },
  "115": {
   "jp": "dcdbe6e3",
