  },
  "76": {
   "jp": "c01ac9a6",
   "kr": "알겠습죠오!"
  },
  "77": {
   "jp": "339c11d5",
   "kr": "거치적대는 병사는 봐주지 말고"
  },
  "78": {
   "jp": "318e4860",
   "kr": "꽁꽁 묶어 버려!"
  },
  "79": {
   "jp": "2d5b404b",
   "kr": "산적들"
  },
  "80": {
   "jp": "8a75cd76",
   "kr": "오오!"
  },
  "81": {
   "jp": "4727099b",
   "kr": "산적이다아!"
  },
  "82": {
   "jp": "d945803a",
   "kr": "산적이라고?"
  },
  "83": {
   "jp": "d2fd3c64",
   "kr": "엇, 정말 나온 거야?"
  },
  "84": {
   "jp": "7b641b7f",
   "kr": "기회야, 쥬리오."
  },
  "85": {
   "jp": "b30d8d01",
   "kr": "왕비님을 모시고 탈출하자."
  },
  "86": {
   "jp": "c17ccb6e",
   "kr": "응, 근데 어떻게"
  },
  "87": {
   "jp": "4a9aa5aa",
   "kr": "탈출하는데?"
  },
  "88": {
   "jp": "19e0d7dd",
   "kr": "억지로 열면 되잖아."
  },
  "89": {
   "jp": "9e8632aa",
   "kr": "근데 튼튼해 보였어."
  },
  "90": {
   "jp": "652afe82",
   "kr": "아무튼 문을 살펴보자."
  },
  "91": {
   "jp": "53cfa9c7",
   "kr": "앗, 저런 데에 열쇠가 있어."
  },
  "92": {
   "jp": "94ba4a9e",
   "kr": "저 병사 아저씨, 덜렁대네."
