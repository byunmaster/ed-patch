  "19": {
   "jp": "d9095ce6",
   "kr": "안됐지만"
  },
  "20": {
   "jp": "046fad7b",
   "kr": "왕비님을 찾을 때까지"
  },
  "21": {
   "jp": "d8f3a035",
   "kr": "이대로 계시게 하자."
  },
  "22": {
   "jp": "17f4f2ae",
   "kr": "베라트 편을 들면"
  },
  "23": {
   "jp": "2ef68426",
   "kr": "우리가 곤란해지는걸…"
  },
  "24": {
   "jp": "30efd958",
   "kr": "미안해요, 병사 아저씨."
  },
  "25": {
   "jp": "75684b86",
   "kr": "으으으…"
  },
  "26": {
   "jp": "002273c8",
   "kr": "꽤 좋은 펀치였다고…"
  },
  "27": {
   "jp": "3adae119",
   "kr": "………"
  },
  "28": {
   "jp": "ee3b11f1",
   "kr": "홀크 병사는"
  },
  "29": {
   "jp": "4a2ceb95",
   "kr": "망루 기둥에 둘둘 감겨 있다."
  },
  "30": {
   "jp": "ca40dca4",
   "kr": "저기, 쥬리오."
  },
  "31": {
   "jp": "fa0221f8",
   "kr": "여길 덮친 산적은"
  },
  "32": {
   "jp": "cad74497",
   "kr": "의외로 마음이 착한지도 몰라."
  },
  "33": {
   "jp": "005edb69",
   "kr": "어째서?"
  },
  "34": {
   "jp": "dcc6b2a8",
   "kr": "그야, 극악무도한 놈이면 묶어 두지도 않아."
  },
  "35": {
   "jp": "c49cd89b",
   "kr": "단칼에 끝이지."
  },
  "36": {
   "jp": "d98779fb",
   "kr": "크리스도 참… 무서운 소리 하네."
  },
  "37": {
   "jp": "3adae119",
   "kr": "………"
  },
  "38": {
   "jp": "54623cfe",
   "kr": "다들 묶여 있어."
  },
  "39": {
   "jp": "3a9e3add",
   "kr": "베라트의 모습은 없네."
  },
  "40": {
   "jp": "171db2e4",
   "kr": "분명 베라트는 왕비님을 데리고"
  },
  "41": {
   "jp": "05bb016f",
   "kr": "어딘가에 숨어 있는 거야."
  },
  "42": {
   "jp": "5f7180ac",
   "kr": "얼른 왕비님을 찾자."
  },
  "43": {
   "jp": "2b415db0",
   "kr": "시끄러운 건 싫어요."
  },
  "44": {
   "jp": "faf407c6",
   "kr": "남자 목소리"
  },
  "45": {
   "jp": "0d1f662f",
   "kr": "우오오오오…!"
  },
  "46": {
   "jp": "e703ca1a",
   "kr": "홀크 병사 목소리"
  },
  "47": {
   "jp": "b3599daa",
   "kr": "어이, 거기 서라!"
  },
  "48": {
   "jp": "3d092904",
   "kr": "밖이 시끄러워."
  },
  "49": {
   "jp": "6808789a",
   "kr": "뭘까?"
  },
  "50": {
   "jp": "58c3b305",
   "kr": "무슨 일이 생긴 거 아닐까."
  },
  "51": {
   "jp": "a113b987",
   "kr": "시끄럽네요."
  },
  "52": {
   "jp": "6b326b90",
   "kr": "저기, 당신. 가서 보고 오세요."
  },
  "53": {
   "jp": "a880315c",
   "kr": "옛, 저는 보초라서…"
  },
  "54": {
   "jp": "c86cf13c",
   "kr": "보초지만 병사잖아요?"
  },
  "55": {
   "jp": "b784169a",
   "kr": "저는 왕비잖아요."
  },
  "56": {
   "jp": "c81b71ca",
   "kr": "말을 못 듣겠다는 건가요?"
  },
  "57": {
   "jp": "9ebf3b1f",
   "kr": "아뇨, 그럴 리가…"
  },
  "58": {
   "jp": "001f0efa",
   "kr": "그럼, 가서 보고 오세요."
  },
  "59": {
   "jp": "1d83ddcd",
   "kr": "옛, 예."
  },
  "60": {
   "jp": "b5eb73d9",
   "kr": "당장 보고 오겠습니다."
  },
  "61": {
   "jp": "2f36f966",
   "kr": "이게 뭐야아?"
  },
  "62": {
   "jp": "93f756e8",
   "kr": "타 버렸어요."
  },
  "63": {
   "jp": "f1eae485",
   "kr": "이럴 수가…"
  },
  "64": {
   "jp": "aa8005e3",
   "kr": "창도 활도 글렀어."
  },
  "65": {
   "jp": "93b690a9",
   "kr": "깨끗이 잿더미가 됐구먼."
  },
  "66": {
   "jp": "270c52d9",
   "kr": "어째서 여기가 불타는 거야."
  },
  "67": {
   "jp": "3c650afa",
   "kr": "어째서야, 어째서야 어째서냐고."
  },
  "68": {
   "jp": "aadb1f3f",
   "kr": "불 지른 놈을 찾아내면"
  },
  "69": {
   "jp": "8112beb0",
