  },
  "70": {
   "jp": "3adae119",
   "kr": "………"
  },
  "71": {
   "jp": "dace1995",
   "kr": "좋았어. 될 대로 되라지."
  },
  "72": {
   "jp": "33e82820",
   "kr": "요새 안을 이 잡듯 뒤져서"
  },
  "73": {
   "jp": "39a09e7d",
