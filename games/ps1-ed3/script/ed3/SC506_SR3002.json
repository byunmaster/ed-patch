  "97": {
   "jp": "e9d91b01",
   "kr": ", 손에 넣었다."
  },
  "98": {
   "jp": "dfa965ee",
   "kr": "자, 왕비님을 모시고"
  },
  "99": {
   "jp": "fa7f8506",
   "kr": "여기서 나가자."
