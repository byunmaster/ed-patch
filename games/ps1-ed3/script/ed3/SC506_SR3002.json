  "146": {
   "jp": "e4e841ee",
   "kr": "싫어."
  },
  "147": {
   "jp": "56439d90",
   "kr": "엣…?"
  },
  "148": {
   "jp": "55267a31",
   "kr": "나쁜 놈 심부름 따위 할까 봐."
  },
  "149": {
   "jp": "b0499866",
   "kr": "그래, 딱 질색이야."
