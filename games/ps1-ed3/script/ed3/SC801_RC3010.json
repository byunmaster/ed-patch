 "lines": {
  "0": {
   "jp": "16b2a2e8",
   "kr": "루드성"
  },
  "1": {
   "jp": "24b7384e",
   "kr": "2층"
  },
  "2": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "3": {
   "jp": "4fcaadcd",
   "kr": "그레리"
  },
  "4": {
   "jp": "399fe502",
   "kr": "모, 모르는 사이에"
  },
  "5": {
   "jp": "b2a600e2",
   "kr": "성 지하에 미궁 같은 지하 통로가"
  },
  "6": {
   "jp": "7d57b6d9",
   "kr": "생겨 있었어…"
  },
  "7": {
   "jp": "518f7e7b",
   "kr": "어딘가로 이어져 있는 걸까요…"
  },
  "8": {
   "jp": "9369aeb5",
   "kr": "땅 밑바닥까지 깊이 이어지는 듯해서…"
  },
  "9": {
   "jp": "f43c945a",
   "kr": "어쩐지 무서워요."
  },
  "10": {
   "jp": "f6ffe1c4",
   "kr": "오오, 듀르젤 공. 무사하시군요."
  },
  "11": {
   "jp": "84cb8bb6",
   "kr": "그레리."
  },
  "12": {
   "jp": "d843613c",
   "kr": "너도 무사했는가?"
  },
  "13": {
   "jp": "9c1ad970",
   "kr": "네. 왕비와 레바스는 외교를 위해"
  },
  "14": {
   "jp": "799c0bff",
   "kr": "일부 사람만은,"
  },
  "15": {
   "jp": "4697cb42",
   "kr": "세뇌당하지 않고 있었던 것입니다."
  },
  "16": {
   "jp": "0eba4edb",
   "kr": "이제 이 성 남자 중에 멀쩡한 건"
  },
  "17": {
   "jp": "c61dd304",
   "kr": "브리트 대장과"
  },
  "18": {
   "jp": "d36622c7",
   "kr": "저 정도입니다."
  },
  "19": {
   "jp": "9438b1b6",
   "kr": "천의실로 서둘러 주십시오."
  },
  "20": {
   "jp": "779f5db2",
   "kr": "레바스는 의식을"
  },
  "21": {
   "jp": "385b94c8",
   "kr": "마침내 완성하려 하고 있습니다."
  }
 }
