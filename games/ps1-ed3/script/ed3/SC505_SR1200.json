  "4": {
   "jp": "e6d8988f",
   "kr": "짐승 길이지만"
  },
  "5": {
   "jp": "56676c4e",
   "kr": "그리로 가면 하이젠에 갈 수 있죠."
  },
  "6": {
   "jp": "410a8782",
   "kr": "꽤 가까이에 있었구나."
