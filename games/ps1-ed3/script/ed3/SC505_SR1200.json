  "0": {
   "jp": "0e815652",
   "kr": "헤즈 가도"
  },
  "1": {
   "jp": "47bc380f",
   "kr": "쥬리오 씨."
  },
  "2": {
   "jp": "ffd87efe",
   "kr": "이 조금 앞에 북쪽으로 가는 길이 있습니다."
  },
  "3": {
   "jp": "c4f5f75b",
   "kr": "저희 집 남쪽으로 통하는 길이죠."
