{
 "archive": "/SCE2/SC203.DAT",
 "member": "..\\DATA\\AT0401.BIN",
 "lines": {
  "0": {
   "jp": "bf50e946",
   "kr": "볼트"
  },
  "1": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "2": {
   "jp": "b97d5055",
   "kr": "마기사"
  },
  "3": {
   "jp": "cfdfc318",
   "kr": "가루가는 바로 곁까지 와 있습니다만"
  },
  "4": {
   "jp": "9e440686",
   "kr": "어찌 된 일인지 상륙하려 하지 않습니다."
  },
  "5": {
   "jp": "1dca49a7",
   "kr": "횃불 불빛에 반응은 하는 것이냐?"
  },
  "6": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "7": {
   "jp": "5b1df364",
   "kr": "그건 틀림없습니다."
  },
  "8": {
   "jp": "f332026f",
   "kr": "이쪽의 의도를 알아챈 것인가…?"
  },
  "9": {
   "jp": "03045f75",
   "kr": "아무튼 이대로 계속해 주게."
  },
  "10": {
   "jp": "910b88ac",
   "kr": "바다에선 승부가 안 되니 말일세."
  },
  "11": {
   "jp": "4abd11a6",
   "kr": "옛!"
  },
  "12": {
   "jp": "f1faa2dc",
   "kr": "쥬리오, 크리스."
  },
  "13": {
   "jp": "4c938349",
   "kr": "볼트 마을까지 돌아가 있게나."
  },
  "14": {
   "jp": "61ecdde2",
   "kr": "근데."
  },
  "15": {
   "jp": "447819f1",
   "kr": "그런 소리 하지 말고"
  },
  "16": {
   "jp": "5891f395",
   "kr": "빨리 가루가를"
  },
  "17": {
   "jp": "10b8f433",
   "kr": "꾀어내야지."
  },
  "18": {
   "jp": "17b567fc",
   "kr": "좀처럼 이쪽으로 안 온다며?"
  },
  "19": {
   "jp": "d138456c",
   "kr": "허나."
  },
  "20": {
   "jp": "f50591d5",
   "kr": "내게 좋은 생각이 있어."
  },
  "21": {
   "jp": "56a26071",
   "kr": "어떤?"
  },
  "22": {
   "jp": "c0e74755",
   "kr": "먹이로 꾀어내는 거야."
  },
  "23": {
   "jp": "1b2ba562",
   "kr": "응, 그거 명안이야."
  },
  "24": {
   "jp": "672e136c",
   "kr": "역시 크리스야."
  },
  "25": {
   "jp": "ff40dfae",
   "kr": "그런데 먹이는"
  },
  "26": {
   "jp": "ccb18102",
   "kr": "뭘 쓰는데?"
  },
  "27": {
   "jp": "eb37196a",
   "kr": "쥬리오야."
  },
  "28": {
   "jp": "4c7019db",
   "kr": "에…?"
  },
  "29": {
   "jp": "daf9c446",
   "kr": "쥬리오가 먹이가 되는 거야."
  },
  "30": {
   "jp": "62eeecff",
   "kr": "이보게."
  },
  "31": {
   "jp": "134f7be8",
   "kr": "그건"
  },
  "32": {
   "jp": "c43ca8e5",
   "kr": "아무리 그래도…"
  },
  "33": {
   "jp": "afa98ba8",
   "kr": "왜, 왜… 내가?"
  },
  "34": {
   "jp": "ee8fd9f8",
   "kr": "여기서 가루가를 골짜기로 꾀어내야"
  },
  "35": {
   "jp": "b4e08d76",
   "kr": "작전을 진행할 수 있어."
  },
  "36": {
   "jp": "8d76527e",
   "kr": "전 세계의 운명이 걸렸다고."
  },
  "37": {
   "jp": "588a8eda",
   "kr": "그, 그렇다고…"
  },
  "38": {
   "jp": "bcf5c19d",
   "kr": "안심하라니까."
  },
  "39": {
   "jp": "c9283f08",
   "kr": "가루가가 보기엔 우리 따윈 너무 작아서"
  },
  "40": {
   "jp": "bfecb0b0",
   "kr": "먹을 마음도 안 생길 거야."
  },
  "41": {
   "jp": "601ac4a6",
   "kr": "게다가 바다에선 삼켜질 수 있지만"
  },
  "42": {
   "jp": "076d95f5",
   "kr": "물가라면 죽을힘으로 달리면 도망칠 수 있어."
  },
  "43": {
   "jp": "ae08899c",
   "kr": "쥬리오는 달리기가 특기잖아."
  },
  "44": {
   "jp": "626995fb",
   "kr": "에〜"
  },
  "45": {
   "jp": "4fb073cd",
   "kr": "그런 문제가"
  },
  "46": {
   "jp": "314aac45",
   "kr": "아닌 것 같은데…"
  },
  "47": {
   "jp": "2f1d63e5",
   "kr": "알겠지."
  },
  "48": {
   "jp": "fb0516e5",
   "kr": "물가까지 가서 요란을 떨면"
  },
  "49": {
   "jp": "3a8ce2ba",
   "kr": "분명 가루가가 움직일 거야."
  },
  "50": {
   "jp": "4f4180fe",
   "kr": "쥬리오, 마음의 준비는 됐어?"
  },
  "51": {
   "jp": "50e858ab",
   "kr": "해 주는 거지?"
  },
  "52": {
   "jp": "559a6062",
   "kr": "역〜시, 쥬리오."
  },
  "53": {
   "jp": "8bc6125d",
   "kr": "나 울고 싶어졌어."
  },
  "54": {
   "jp": "62bd0795",
   "kr": "미끼인 거니까"
  },
  "55": {
   "jp": "d0a04233",
   "kr": "큰 소리로"
  },
  "56": {
   "jp": "7f7968ce",
   "kr": "요란하게 떠드는 거야."
  },
  "57": {
   "jp": "6490ecff",
   "kr": "그런 건 싫단 말야…"
  },
  "58": {
   "jp": "b44da21e",
   "kr": "너무하잖아."
  },
  "59": {
   "jp": "89c9f6ce",
   "kr": "난"
  },
  "60": {
   "jp": "132f3093",
   "kr": "못 해."
  },
  "61": {
   "jp": "be495b78",
   "kr": "무슨 소리야."
  },
  "62": {
   "jp": "843f11eb",
   "kr": "가루가를 골짜기에 못 몰면 작전이 안 돼."
  },
  "63": {
   "jp": "7f63092a",
   "kr": "딱히 가루가를 상대로 싸우라는"
  },
  "64": {
   "jp": "9dddaf1a",
   "kr": "말이 아니잖아."
  },
  "65": {
   "jp": "ce2b7431",
   "kr": "달리면 되는 거야, 달리면."
  },
  "66": {
   "jp": "36e58ee4",
   "kr": "그런〜"
  },
  "67": {
   "jp": "6ef912ae",
   "kr": "여기선 하는 수밖에 없어."
  },
  "68": {
   "jp": "a548bea2",
   "kr": "울보 쥬리오를 벗어던질"
  },
  "69": {
   "jp": "e0f12920",
   "kr": "좋은 기회야."
  },
  "70": {
   "jp": "2098bdb0",
   "kr": "쥬리오, 부탁할게."
  },
  "71": {
   "jp": "42193801",
   "kr": "믿을 건 쥬리오뿐이니까."
  },
  "72": {
   "jp": "8af53aa4",
   "kr": "자, 힘내!"
  },
  "73": {
   "jp": "df582d50",
   "kr": "……속 편하게 말한다니까."
  },
  "74": {
   "jp": "e16521e0",
   "kr": "하나만 물어봐 두는데"
  },
  "75": {
   "jp": "7675318f",
   "kr": "골짜기 안쪽은 막다른 길 아니지?"
  },
  "76": {
   "jp": "6976d3e3",
   "kr": "그건 괜찮네."
  },
  "77": {
   "jp": "616877d5",
   "kr": "가루가의 거체로는 못 지나가지만"
  },
  "78": {
   "jp": "2d2ac94d",
   "kr": "사람이라면 오를 수 있게 돼 있지."
  },
  "79": {
   "jp": "7a90d837",
   "kr": "그 말 들으니 좀 안심했어."
  },
  "80": {
   "jp": "904b9011",
   "kr": "……조금이지만…"
  },
  "81": {
   "jp": "db01d386",
   "kr": "마기사의 방해를 해서는 안 됩니다."
  },
  "82": {
   "jp": "03552edb",
   "kr": "그녀는 이 작전의 비장의 카드입니다."
  },
  "83": {
   "jp": "7f49f4cb",
   "kr": "가루가가 이 협곡에 안 들어오면"
  },
  "84": {
   "jp": "1f2168d5",
   "kr": "손쓸 방도가 없다!"
  },
  "85": {
   "jp": "2264cf1b",
   "kr": "조용히!"
  },
  "86": {
   "jp": "c82d46ac",
   "kr": "지금 마기사는 자신의 사념을"
  },
  "87": {
   "jp": "8ff9692e",
   "kr": "강대한 마법의 힘으로 바꾸려 하고 있습니다."
  },
  "88": {
   "jp": "3a2329f1",
   "kr": "집중을 흐려선 안 됩니다."
  },
  "89": {
   "jp": "a505c23a",
   "kr": "가루가…"
  },
  "90": {
   "jp": "ac05932f",
   "kr": "내 아버질 바다에 가라앉히고"
  },
  "91": {
   "jp": "667c8632",
   "kr": "마을을 짓부순 괴물…"
  },
  "92": {
   "jp": "6fbb881d",
   "kr": "이 협곡을 네 마지막 풍경으로 해 주마!"
  },
  "93": {
   "jp": "97006fb3",
   "kr": "응…?"
  },
  "94": {
   "jp": "5f674055",
   "kr": "너희들!"
  },
  "95": {
   "jp": "89cb3c5a",
   "kr": "이런 데까지 와서!"
  },
  "96": {
   "jp": "d7563c49",
   "kr": "저기, 무리하지 마."
  },
  "97": {
   "jp": "587ca49d",
   "kr": "맞아."
  },
  "98": {
   "jp": "0f4861f4",
   "kr": "아직 검에 관해서 배우고 싶은 게"
  },
  "99": {
   "jp": "c3bda8c4",
   "kr": "잔뜩 있단 말이야."
  },
  "100": {
   "jp": "0e7bd6fc",
   "kr": "…고맙다."
  },
  "101": {
   "jp": "69d11caf",
   "kr": "괜찮아."
  },
  "102": {
   "jp": "8b56786f",
   "kr": "쥬리오와 크리스는 위험하지 않은 곳에서"
  },
  "103": {
   "jp": "eb228ad3",
   "kr": "내 싸움을 지켜봐 줘."
  },
  "104": {
   "jp": "f22152f3",
   "kr": "위험한 짓은 마라."
  }
 }
}