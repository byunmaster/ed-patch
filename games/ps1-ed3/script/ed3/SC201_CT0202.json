  "169": {
   "jp": "3da44503",
   "kr": "어지간히 이날이 오기를"
  },
  "170": {
   "jp": "ee704e35",
   "kr": "기다렸나 봐."
  },
  "171": {
   "jp": "9fcc392e",
   "kr": "우리도 조금은 도움이 된 모양이군."
  },
  "172": {
   "jp": "1f2836e0",
   "kr": "자아"
  },
  "173": {
   "jp": "6212bef9",
   "kr": "오늘도 슬슬 빈털터리로 돌아갈까."
  },
  "174": {
   "jp": "a196d337",
   "kr": "오늘은 여느 때 없이 마음이 설레는구나."
  },
  "175": {
   "jp": "3badc1e7",
   "kr": "오랜 노력이 이제야"
  },
  "176": {
   "jp": "5c7e0fe1",
   "kr": "결실을 맺으려 하는 거니까."
  },
  "177": {
   "jp": "98cf17fe",
   "kr": "좋아, 거기까지 바래다주마."
  },
  "178": {
   "jp": "e2eb9a09",
   "kr": "오오, 미안하구나."
  },
  "179": {
   "jp": "ee2dbb28",
   "kr": "으… 음."
  },
  "180": {
   "jp": "e782f238",
   "kr": "다들 삶을 바꾸고 싶다고는"
  },
  "181": {
   "jp": "0b342803",
   "kr": "생각하고 있겠지만"
  },
  "182": {
   "jp": "10822627",
   "kr": "뭔가 계기를 못 잡는 모양이네."
  },
  "183": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "184": {
   "jp": "69d3d5a6",
   "kr": "하루아침에 될 일은 아니지."
  },
  "185": {
   "jp": "689e922e",
   "kr": "이제부터일세."
  },
  "186": {
   "jp": "650dbd5d",
   "kr": "물론이고말고."
  },
  "187": {
   "jp": "5cdde835",
   "kr": "여기서 포기할 거라면"
  },
  "188": {
   "jp": "3c92398e",
   "kr": "애초에 손대지도 않았네."
  },
  "189": {
   "jp": "3840bcae",
   "kr": "자, 아드님이 걱정하신다."
  },
  "190": {
   "jp": "8fe432b0",
   "kr": "거기까지 바래다주마."
  },
  "191": {
   "jp": "74e18b1a",
   "kr": "미안하구나."
  }
 }
}