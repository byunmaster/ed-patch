 "lines": {
  "0": {
   "jp": "57e30d30",
   "kr": "홀크"
  },
  "1": {
   "jp": "459e049c",
   "kr": "여관 몬세스"
  },
  "2": {
   "jp": "e59e9805",
   "kr": "챠펠의 파니아"
  },
  "3": {
   "jp": "41e22563",
   "kr": "시오네"
  },
  "4": {
   "jp": "7fa85504",
   "kr": "도구점 시아"
  },
  "5": {
   "jp": "93a11990",
   "kr": "무기상 그라드"
  },
  "6": {
   "jp": "6b2ee78a",
   "kr": "술집 벨드"
  },
  "7": {
   "jp": "0e861c91",
   "kr": "라크"
  },
  "8": {
   "jp": "5addbda3",
   "kr": "유니오"
  },
  "9": {
   "jp": "a89809b7",
   "kr": "리티카"
  },
  "10": {
   "jp": "b50169bf",
   "kr": "루코네"
  },
  "11": {
   "jp": "f7d7ff16",
   "kr": "하하하, 이쪽으로 가면"
  },
  "12": {
   "jp": "14cbcad9",
   "kr": "앰비쉬 국경으로 되돌아가는 거야."
  },
  "13": {
   "jp": "6e8b5584",
   "kr": "이쪽이 아니지?"
  },
  "14": {
   "jp": "1328fb8c",
   "kr": "그래, 반대쪽이야."
  },
  "15": {
   "jp": "9265d7f9",
   "kr": "얼른 가자."
  },
  "16": {
   "jp": "7160d2de",
   "kr": "가도 봉쇄가 풀린 모양이네요."
  },
  "17": {
   "jp": "0450c694",
   "kr": "좋아, 이제 손님이 또 잔뜩 오겠군."
  },
  "18": {
   "jp": "b617ce38",
   "kr": "홀크의 챠펠에 잘 오셨습니다."
  },
  "19": {
   "jp": "bbf6d94f",
   "kr": "부디 편히 쉬다 가십시오."
  },
  "20": {
   "jp": "d7041ee1",
   "kr": "잘 오셨습니다."
  },
  "21": {
   "jp": "307c9445",
   "kr": "여기서는 챠펠 마법을"
  },
  "22": {
   "jp": "8410b96e",
   "kr": "가르쳐 드리고 있습니다."
  },
  "23": {
   "jp": "95d51df4",
   "kr": "어느 분께 가르쳐 드릴까요?"
  },
  "24": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "25": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "26": {
   "jp": "0cc85f80",
   "kr": "마법을 받은 이에게 축복을."
  },
  "27": {
   "jp": "26efd7bc",
   "kr": "캐라크 왕이 정식으로 에네톤 왕과"
  },
  "28": {
   "jp": "94d12399",
   "kr": "화해했다더라."
  },
  "29": {
   "jp": "4d1ef8cc",
   "kr": "다행이야."
  },
  "30": {
   "jp": "4f045262",
   "kr": "어서 오세요."
  },
  "31": {
   "jp": "c514e079",
   "kr": "여기는 도구점입니다."
  },
  "32": {
   "jp": "7196f4c3",
   "kr": "부디 물건을 살펴봐 주세요."
  },
  "33": {
   "jp": "3cebce94",
   "kr": "사서 손해 볼 것 없는 물건뿐이에요."
  },
  "34": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "35": {
   "jp": "35358975",
   "kr": "그럼"
  },
  "36": {
   "jp": "e34b7e21",
   "kr": "에 팔아 드립니다."
  },
  "37": {
   "jp": "8a072d2b",
   "kr": "필요 없는 물건은 무엇이든."
  },
  "38": {
   "jp": "941f0265",
   "kr": "인가요."
  },
  "39": {
   "jp": "abb8567e",
   "kr": "그렇다면"
  },
  "40": {
   "jp": "71b4529e",
   "kr": "에 사들이겠습니다."
  },
  "41": {
   "jp": "59136b4c",
   "kr": "환전율은 1 Goa당 16 Pia입니다."
  },
  "42": {
   "jp": "ad968a20",
   "kr": "꽤 높은 환전율이라고 생각합니다만."
  },
  "43": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "44": {
   "jp": "8b8fd624",
   "kr": "이네요."
  },
  "45": {
   "jp": "c29f11ef",
   "kr": "아쉽네요. 라피카가 없어요."
  },
  "46": {
   "jp": "50891ff0",
   "kr": "그 밖에 볼일은 없으신가요?"
  },
  "47": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "48": {
   "jp": "c676fe68",
   "kr": "또 들러 주세요."
  },
  "49": {
   "jp": "b084c68a",
   "kr": "젊은 애들끼리 잘도 여행하는군."
  },
  "50": {
   "jp": "17dec768",
   "kr": "힘내라고!"
  },
  "51": {
   "jp": "d46ab5be",
   "kr": "어서 와."
  },
  "52": {
   "jp": "44a45548",
   "kr": "좋은 무기가 잔뜩 있다고."
  },
  "53": {
   "jp": "07bdc61d",
   "kr": "뭐, 둘러보고 가라고."
  },
  "54": {
   "jp": "1ad9106a",
   "kr": "어느 게 갖고 싶나?"
  },
  "55": {
   "jp": "f9ec8dac",
   "kr": "망설여지면 사 버려!"
  },
  "56": {
   "jp": "540af711",
   "kr": "고맙수다, 그건 좋은 물건이지."
  },
  "57": {
   "jp": "e52120a4",
   "kr": "보는 눈이 높군."
  },
  "58": {
   "jp": "605ba81d",
   "kr": "자자, 뭐든 사들이지!"
  },
  "59": {
   "jp": "127db0a8",
   "kr": "인가."
  },
  "60": {
   "jp": "241abf97",
   "kr": "그렇다면"
  },
  "61": {
   "jp": "b0e9310f",
   "kr": "에 사지."
  },
  "62": {
   "jp": "cccbc77a",
   "kr": "환전율은 1 Goa당 16 Pia다."
  },
  "63": {
   "jp": "dd726c7e",
   "kr": "지금이 바꿀 때, 놓칠 수 없지!"
  },
  "64": {
   "jp": "00ead2fd",
   "kr": "내지!"
  },
  "65": {
   "jp": "d73f137c",
   "kr": "이봐 이봐, 라피카가 없잖아."
  },
  "66": {
   "jp": "eb56cd33",
   "kr": "정신 좀 차리라고!"
  },
  "67": {
   "jp": "4bca0054",
   "kr": "그 밖에 볼일 없나?"
  },
  "68": {
   "jp": "6e401b93",
   "kr": "자주 들러 달라고!"
  },
  "69": {
   "jp": "93ad74d2",
   "kr": "옛날부터 피는 물보다 진하다는 말이 있지."
  },
  "70": {
   "jp": "65f1f995",
   "kr": "형제의 정은 꽤 강한 법이란다."
  },
  "71": {
   "jp": "e31f8385",
   "kr": "퓨엔테는 북부와 남부로 나뉘어 있단다."
  },
  "72": {
   "jp": "299d6d49",
   "kr": "북부는 형 에네톤 왕이 하이젠에서 다스리고"
  },
  "73": {
   "jp": "84dd419b",
   "kr": "남부는 아우인 캐라크 왕이"
  },
  "74": {
   "jp": "91c4797c",
   "kr": "이 홀크의 저택에서 다스리고 있지."
  },
  "75": {
   "jp": "356962de",
   "kr": "두 사람은 쌍둥이 형제야."
  },
  "76": {
   "jp": "4462d38d",
   "kr": "태어났을 때 싸우지 않도록"
  },
  "77": {
   "jp": "ee62ce0b",
   "kr": "돌아가신 여왕님이 땅을 나누셨다더구나."
  },
  "78": {
   "jp": "4c854285",
   "kr": "북쪽 하이젠 왕도 남쪽 캐라크 왕도"
  },
  "79": {
   "jp": "01a50e88",
   "kr": "근본은 아주 소심하단다."
  },
  "80": {
   "jp": "c00ac351",
   "kr": "그러니 둘이 나란히 딱 좋은 거지."
  },
  "81": {
   "jp": "470e944f",
   "kr": "뭐, 분쟁이 끝나서"
  },
  "82": {
   "jp": "70759d4f",
   "kr": "다행이야, 다행이야."
  },
  "83": {
   "jp": "c239107c",
   "kr": "칼리 왕비님은 요새에 가 계셨구나."
  },
  "84": {
   "jp": "9479c8f7",
   "kr": "난 왕비님을 정말 좋아해."
  },
  "85": {
   "jp": "d6a920ae",
   "kr": "돌아와 주셔서"
  },
  "86": {
   "jp": "171edb62",
   "kr": "정말 다행이야."
  },
  "87": {
   "jp": "88c0f7aa",
   "kr": "가도 출구를 지키던 병사들은"
  },
  "88": {
   "jp": "35b04c32",
   "kr": "곧장 루피나스 호수 요새를 허물러"
  },
  "89": {
   "jp": "a2d92cb1",
   "kr": "갔다더구나."
  },
  "90": {
   "jp": "d433fb13",
   "kr": "짓고, 부수고."
  },
  "91": {
   "jp": "2211bbe5",
   "kr": "병사들도 힘들겠어."
  }
 }
}