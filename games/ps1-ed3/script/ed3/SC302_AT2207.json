  },
  "66": {
   "jp": "246b40d5",
   "kr": "좋아, 이제 샤라다."
  },
  "67": {
   "jp": "545eb12b",
   "kr": "쥬리오는 탁자 밑"
  },
  "68": {
   "jp": "0e9c9417",
