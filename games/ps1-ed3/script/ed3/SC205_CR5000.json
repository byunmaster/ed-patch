  },
  "2": {
   "jp": "8fcf4f84",
   "kr": "트렛케"
  },
  "3": {
   "jp": "b6dbe7a0",
   "kr": "페르코"
  },
  "4": {
   "jp": "ba5d6ed2",
   "kr": "리즈모"
  },
  "5": {
   "jp": "4b0b934c",
   "kr": "푸치"
  },
  "6": {
   "jp": "8ad7d04d",
   "kr": "에니"
  },
  "7": {
   "jp": "7b4dcfba",
   "kr": "라이제"
  },
  "8": {
   "jp": "9c962a2a",
   "kr": "브리오"
  },
  "9": {
   "jp": "251fdcb9",
   "kr": "바리오"
  },
  "10": {
   "jp": "ef1e9e2d",
   "kr": "마르"
  },
  "11": {
   "jp": "c19f97db",
   "kr": "팟신"
  },
  "12": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "13": {
   "jp": "f932f43c",
   "kr": "뭘까."
  },
  "14": {
   "jp": "9359bf01",
   "kr": "자〜, 여러분〜"
  },
  "15": {
   "jp": "1808548b",
   "kr": "들어 주세요〜"
  },
  "16": {
   "jp": "50e81237",
   "kr": "설명해 드릴게요."
  },
  "17": {
   "jp": "d7124b32",
   "kr": "그럼 750미로나 되는 삼도교의"
  },
  "18": {
   "jp": "f8aa2cfc",
   "kr": "이름 유래부터 설명드리죠."
  },
  "19": {
   "jp": "4d32188e",
   "kr": "에〜, 애초에."
  },
  "20": {
   "jp": "2fc7714e",
   "kr": "이 다리가 삼도교라"
  },
  "21": {
   "jp": "b3aceb5a",
   "kr": "이름 붙은 것은 말이죠."
  },
  "22": {
   "jp": "9c8b33ed",
   "kr": "다리를 지을 때"
  },
  "23": {
   "jp": "234c2756",
   "kr": "챠놈, 앰비쉬, 그리고 올도스."
  },
  "24": {
   "jp": "1f2b95f4",
   "kr": "이 세 나라가 돈을 냈기 때문입니다."
  },
  "25": {
   "jp": "5983e10b",
   "kr": "세 나라가 출자한 다리라서 삼도교."
  },
  "26": {
   "jp": "c1faebd4",
   "kr": "알기 쉽죠."
  },
  "27": {
   "jp": "4d27925a",
   "kr": "호호오."
  },
  "28": {
   "jp": "584524d5",
   "kr": "과연 그렇구먼…"
  },
  "29": {
   "jp": "6ea653b7",
   "kr": "질문 있나요?"
  },
  "30": {
   "jp": "cadb0695",
   "kr": "네〜에."
  },
  "31": {
   "jp": "683ef080",
   "kr": "네, 손님 말씀하세요."
  },
  "32": {
   "jp": "80d2d2da",
   "kr": "챠놈과 앰비쉬가 돈을 낸 건"
  },
  "33": {
   "jp": "5a4d9909",
   "kr": "알겠는데, 올도스는 다리가 이어지지도 않는데"
  },
  "34": {
   "jp": "225fb9e0",
   "kr": "왜 돈을 낸 거예요?"
  },
  "35": {
   "jp": "7e3ba30d",
   "kr": "네. 좋은 질문이네요."
  },
  "36": {
   "jp": "cdf9593b",
   "kr": "그건 말이죠. 원래 올도스를 가로지르면"
  },
  "37": {
   "jp": "e9ee5429",
   "kr": "두 나라 사이 왕래는 조금 짧아졌겠지만"
  },
  "38": {
   "jp": "3f6d733b",
   "kr": "올도스는 도시 특성상 일반인은 못 지나가요."
  },
  "39": {
   "jp": "21cc2ddf",
   "kr": "현자들의 도시니까요."
  },
  "40": {
   "jp": "ae952144",
   "kr": "그 점은 역시 현자들입니다."
  },
  "41": {
   "jp": "0859b692",
   "kr": "아무것도 안 하고 모른 척하긴 딱하다며,"
  },
  "42": {
   "jp": "8dc7453c",
   "kr": "원조금을 내어 협력해 준 것입니다."
  },
  "43": {
   "jp": "4d27925a",
   "kr": "호호오."
  },
  "44": {
   "jp": "584524d5",
   "kr": "과연 그렇구먼…"
  },
  "45": {
   "jp": "35531cce",
   "kr": "자〜, 이쪽으로 이동해 주세요〜!"
  },
  "46": {
   "jp": "4ab99250",
   "kr": "저 가운데 섬을 보십시오."
  },
  "47": {
   "jp": "a79b51bc",
   "kr": "멋진 경치죠."
  },
  "48": {
   "jp": "f7db2ed2",
   "kr": "저 가운데 섬이야말로"
  },
  "49": {
   "jp": "5e20de53",
   "kr": "티라스일 삼경에 꼽히는"
  },
  "50": {
   "jp": "13799bc2",
   "kr": "마녀의 디딤돌입니다."
  },
  "51": {
   "jp": "2043ceb5",
   "kr": "다리가 생기기 전, 마녀가 섬을 디딤돌 삼아"
  },
  "52": {
   "jp": "05b0b39c",
   "kr": "퐁, 퐁, 포옹! 하고, 앰비쉬 쪽으로"
  },
  "53": {
   "jp": "ad7cc448",
   "kr": "건넜다는 전승이 남아 있습니다."
  },
  "54": {
   "jp": "dc1bf9e6",
   "kr": "흐응."
  },
  "55": {
   "jp": "3062c74c",
   "kr": "또, 마녀야…"
  },
  "56": {
   "jp": "572cc372",
   "kr": "그리 신경 쓸 일은 아니다."
  },
  "57": {
   "jp": "07149a4e",
   "kr": "티라스일 어디를 가든"
  },
  "58": {
   "jp": "e4c202d5",
   "kr": "마녀 얘기를 듣는 건 당연하다."
  },
  "59": {
   "jp": "947a2f32",
   "kr": "마녀는 온 나라를 구석구석 돌아다녔으니까."
  },
  "60": {
   "jp": "019f449a",
   "kr": "자, 시간이 없다."
  },
  "61": {
   "jp": "6cb7cc9c",
   "kr": "우린 갈 길을 서두르자."
  },
  "62": {
   "jp": "5c97134b",
   "kr": "어라?"
  },
  "63": {
   "jp": "9814e8e2",
   "kr": "손님들은 처음부터 계셨던가요?"
  },
  "64": {
   "jp": "32686d4e",
   "kr": "정말 훌륭한 다리로군."
  },
  "65": {
   "jp": "ad007a84",
   "kr": "이 다리 높이가"
  },
  "66": {
   "jp": "3ce336ee",
   "kr": "얼마나 되는지 알아?"
  },
  "67": {
   "jp": "cb954518",
   "kr": "몰라."
  },
  "68": {
   "jp": "651f0886",
   "kr": "얼마나 되는데?"
  },
  "69": {
   "jp": "15c21d6f",
   "kr": "헤헤."
  },
  "70": {
   "jp": "c77c0bb6",
   "kr": "나도 몰라."
  },
  "71": {
   "jp": "6227f6c8",
   "kr": "높은 데 있으면"
  },
  "72": {
   "jp": "658a1e26",
   "kr": "어째서 다리가 근질근질할까."
  },
  "73": {
   "jp": "9f7f479a",
   "kr": "그런 것도 몰라?"
  },
  "74": {
   "jp": "afd19351",
   "kr": "저기, 어째서?"
  },
  "75": {
   "jp": "4d6b33a7",
   "kr": "나도 몰라."
  },
  "76": {
   "jp": "e9879698",
   "kr": "다리도 훌륭하지만"
  },
  "77": {
   "jp": "ec2408df",
   "kr": "이 근처 경치는 각별하군."
  },
  "78": {
   "jp": "1497d809",
   "kr": "정말 멋진 경치네요."
  },
  "79": {
   "jp": "92ac7c1c",
   "kr": "신혼여행으로 한 번 더"
  },
  "80": {
   "jp": "6006a44b",
   "kr": "여기 와 보고 싶어요."
  },
  "81": {
   "jp": "fe5c69c7",
   "kr": "으〜"
  },
  "82": {
   "jp": "6ce417d7",
   "kr": "나도 날 수 있을 것 같아."
  },
  "83": {
   "jp": "7f4df668",
   "kr": "조, 조금 더 크고 나서 하는 게 어때?"
  },
  "84": {
   "jp": "4d27925a",
   "kr": "호호오."
  },
  "85": {
   "jp": "97ba7481",
   "kr": "흠."
  },
  "86": {
   "jp": "8ead8a4d",
   "kr": "아하〜"
  },
  "87": {
   "jp": "f6cfaba1",
   "kr": "?"
  },
  "88": {
   "jp": "b95ab701",
   "kr": "아까웠구나."
  },
  "89": {
   "jp": "d79a0b99",
   "kr": "조금만 더 빨랐으면"
  },
  "90": {
   "jp": "117a4162",
   "kr": "딱 1만 번째였을 텐데."
  },
  "91": {
   "jp": "e4ebbf19",
   "kr": "기념할 만한"
  },
  "92": {
   "jp": "ea53cec2",
   "kr": "삼도교 1만 번째 이용자입니다."
  },
  "93": {
   "jp": "fd04528b",
   "kr": "네, 이건 기념품입니다."
  },
  "94": {
   "jp": "7b1434d0",
   "kr": "축하드립니다!"
  },
  "95": {
   "jp": "2b904c60",
   "kr": "해냈다,"
  },
  "96": {
   "jp": "6fc80461",
   "kr": "와〜아"
  },
  "97": {
   "jp": "76c45b6c",
   "kr": "해냈다아!"
  },
  "98": {
   "jp": "7b1434d0",
   "kr": "축하드립니다!"
  },
  "99": {
   "jp": "5590ff80",
   "kr": "네?"
  },
  "100": {
   "jp": "12845254",
   "kr": "여러분은 기념할 만한"
  },
  "101": {
   "jp": "1b9aee79",
   "kr": "삼도교 1만 번째 통과자예요!"
  },
  "102": {
   "jp": "406c6f80",
   "kr": "네. 기념품을 드리겠습니다."
  },
  "103": {
   "jp": "50ea4643",
   "kr": "어머, 짐이 가득하네요."
  },
  "104": {
   "jp": "ddd40464",
   "kr": "모처럼의 기념품이니까요."
  },
  "105": {
   "jp": "0e0311f0",
   "kr": "뭔가를 두고 가 주세요."
  },
  "106": {
   "jp": "5ddbf718",
   "kr": "쥬리오 일행은 기념품을 받았습니다."
  },
  "107": {
   "jp": "302cdd52",
   "kr": "축하드립니다!"
  },
  "108": {
   "jp": "37589eb8",
   "kr": "아〜아… 늦었나!"
  },
  "109": {
   "jp": "5d790543",
   "kr": "챠놈의 다리지기 분이"
  },
  "110": {
   "jp": "84d36891",
   "kr": "1만 번째가 곧이라고 말해 줘서"
  },
  "111": {
   "jp": "812dd180",
   "kr": "서둘러 왔는데."
  },
  "112": {
   "jp": "2e615bca",
   "kr": "아까웠구나."
  },
  "113": {
   "jp": "13d57759",
   "kr": "1만 번째였으면"
  },
  "114": {
   "jp": "2c29d7e5",
   "kr": "기념품을 받았을 텐데."
  },
  "115": {
   "jp": "af167034",
   "kr": "정말 잘됐구나."
  },
  "116": {
   "jp": "c768572e",
   "kr": "아까는 아쉬웠지."
  },
  "117": {
   "jp": "d29bfdd6",
   "kr": "뭐, 이번엔 저 아저씨한테"
  },
  "118": {
   "jp": "edc621d1",
   "kr": "체면을 세워 주자고."
  },
  "119": {
   "jp": "cd4d6e5f",
   "kr": "오. 아까 그 사람들이구나."
  },
  "120": {
   "jp": "7b6ac71d",
   "kr": "비누는 도움이 되고 있니?"
  },
  "121": {
   "jp": "9eb866a9",
   "kr": "가끔은, 이런 것도 좋구나."
  },
  "122": {
   "jp": "ce870905",
   "kr": "매일 다리에 서 있으면"
  },
  "123": {
   "jp": "1d827071",
   "kr": "그거야 지루한 법이지."
  },
  "124": {
   "jp": "00ad27d1",
   "kr": "우리한테도 뭔가 안 주려나."
  },
  "125": {
   "jp": "6d35da11",
   "kr": "아쉽게 됐네요."
  },
  "126": {
   "jp": "d8a15665",
   "kr": "2만 번째 때는"
  },
  "127": {
   "jp": "ca524535",
   "kr": "더 근사한 기념품을 마련할 수 있을 겁니다."
  },
  "128": {
   "jp": "913473df",
   "kr": "기념품은 뭘까?"
  },
  "129": {
   "jp": "c8a3bb70",
   "kr": "제법 묵직한데."
  },
  "130": {
   "jp": "9f5f32e2",
   "kr": "비누인가?"
  },
  "131": {
   "jp": "38abac5d",
   "kr": "좋겠다."
  },
  "132": {
   "jp": "37d62098",
   "kr": "기념품은 뭐였어?"
