  "0": {
   "jp": "c250b049",
   "kr": "홀크 요새"
  },
  "1": {
   "jp": "9bb56284",
   "kr": "베라트"
  },
  "2": {
   "jp": "845a2ab1",
   "kr": "칼리 왕비"
  },
  "3": {
   "jp": "f23bd255",
   "kr": "산적 아페고"
  },
  "4": {
   "jp": "6d0d3c7e",
   "kr": "산적 그네스"
  },
  "5": {
   "jp": "82bf0c0f",
   "kr": "산적 누라"
  },
  "6": {
   "jp": "138252df",
   "kr": "산적 콘타"
  },
  "7": {
   "jp": "da167b15",
   "kr": "괜찮을까…"
  },
  "8": {
   "jp": "6c1aeb22",
   "kr": "기절했을 뿐이야."
  },
  "9": {
   "jp": "755dc9aa",
   "kr": "어머, 머리에 혹이 났어."
  },
  "10": {
   "jp": "813b70cb",
   "kr": "왕비님, 괜찮으세요?"
  },
  "11": {
   "jp": "9d4f3f3d",
   "kr": "왕비님, 괜찮아요?"
  },
  "12": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "13": {
   "jp": "a540b075",
   "kr": "저는 괜찮답니다."
  },
  "14": {
   "jp": "590cef5e",
   "kr": "어이, 설명해 봐."
  },
  "15": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "16": {
   "jp": "44cbe919",
   "kr": "쥬리오는 구스 일행에게"
  },
  "17": {
   "jp": "dcd18cd8",
   "kr": "베라트가 꾸미던 계획을 설명했다."
  },
  "18": {
   "jp": "abe77762",
   "kr": "정말로 신세 많이 졌습니다."
  },
  "19": {
   "jp": "3adae119",
   "kr": "………"
  },
  "20": {
   "jp": "8f5df147",
   "kr": "어쨌든 이 베라트인가 하는 놈은"
  },
  "21": {
   "jp": "c7a350ee",
   "kr": "임금님들께 넘기는 게 좋겠어."
  },
  "22": {
   "jp": "48309d8e",
   "kr": "응. 그럴 생각이야."
  },
  "23": {
   "jp": "59568e3d",
   "kr": "앗, 신호하는 걸 잊었어."
  },
  "24": {
   "jp": "b4899fc4",
   "kr": "기왕이면 여기 꼭대기에서 뛰어내려 보든가."
  },
  "25": {
   "jp": "bfbeb80e",
   "kr": "그래, 기분 좋을 것 같네."
  },
  "26": {
   "jp": "35386b9e",
   "kr": "앗?!"
  },
  "27": {
   "jp": "4b1ad8d8",
   "kr": "헉…?!"
  },
  "28": {
   "jp": "36a8e40f",
   "kr": "어어어…"
  },
  "29": {
   "jp": "ecbb903b",
   "kr": "이놈들… 너희 덕분에"
  },
  "30": {
   "jp": "24fe738c",
   "kr": "내 계획은 엉망이 됐다."
  },
  "31": {
   "jp": "c60fe2ad",
   "kr": "두 왕의 의심을 부추겨"
  },
  "32": {
   "jp": "61422a86",
   "kr": "퓨엔테를 시작으로"
  },
  "33": {
   "jp": "d981b370",
   "kr": "세계에 혼란을 일으키려 했다만…"
  },
  "34": {
   "jp": "3fcb57a1",
   "kr": "뜻밖의 방해가 끼어들었군."
  },
  "35": {
   "jp": "34408c5a",
   "kr": "그렇게는 안 둬!"
  },
  "36": {
   "jp": "93a1b72f",
   "kr": "그래!"
  },
  "37": {
   "jp": "9a3a7cec",
   "kr": "네 얼빠진 꼴을 보아하니"
  },
  "38": {
   "jp": "00c18da6",
   "kr": "두목은 따로 있구먼?"
  },
  "39": {
   "jp": "a3691775",
   "kr": "윽."
  },
  "40": {
   "jp": "3adae119",
   "kr": "………"
  },
  "41": {
   "jp": "4b34cab2",
   "kr": "뭐, 됐다."
  },
  "42": {
   "jp": "51834fad",
   "kr": "이번엔 봐주지."
  },
  "43": {
   "jp": "90cd9c47",
   "kr": "하지만 기억해 둬라."
  },
  "44": {
   "jp": "ef70dfd3",
   "kr": "이 빚은 반드시 갚아 주마."
  },
  "45": {
   "jp": "77e37a9e",
   "kr": "이만 간다!"
  },
  "46": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "47": {
   "jp": "00d8012c",
   "kr": "사라져 버렸어."
  },
  "48": {
   "jp": "1ecd6e98",
   "kr": "뭐, 놓치긴 했지만"
  },
  "49": {
   "jp": "58307edb",
   "kr": "이번 승부는 쥬리오네 승리다."
  },
  "50": {
   "jp": "67973a0f",
   "kr": "적어도 이제"
  },
  "51": {
   "jp": "a05acead",
   "kr": "퓨엔테에선 나쁜 짓 못 해."
  },
  "52": {
   "jp": "b3e50e8c",
   "kr": "이봐, 크리스."
  },
  "53": {
   "jp": "943867e6",
   "kr": "신호 아니야? 빨리 해."
  },
  "54": {
   "jp": "dbda8249",
   "kr": "앗, 맞다."
  },
  "55": {
   "jp": "8428b885",
   "kr": "근데 무슨 신호인데?"
  },
  "56": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "57": {
   "jp": "c896ad71",
   "kr": "왕비님을 구출하면"
  },
  "58": {
   "jp": "a3b0b350",
   "kr": "신호하기로 되어 있어."
  },
  "59": {
   "jp": "dc1bf9e6",
   "kr": "흐응."
  },
  "60": {
   "jp": "14a5c33d",
   "kr": "그러면 남북의 임금님들이"
  },
  "61": {
   "jp": "865d76e9",
   "kr": "요새로 들어오기로 되어 있거든."
  },
  "62": {
   "jp": "e23f1564",
   "kr": "아, 그렇구나."
  },
  "63": {
   "jp": "4ca6d633",
   "kr": "뭐어!!"
  },
  "64": {
   "jp": "9d3220c6",
   "kr": "진짜야, 그거?!"
  },
  "65": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "66": {
   "jp": "5ead2ffc",
   "kr": "말도 안 돼!"
  },
  "67": {
   "jp": "d1e46d5e",
   "kr": "우린 산적이라고!"
  },
  "68": {
   "jp": "e61bd8d5",
   "kr": "큰일 났어."
  },
  "69": {
   "jp": "0825e727",
   "kr": "아, 그렇구나."
  },
  "70": {
   "jp": "6cd4ac8b",
   "kr": "잡힐지도 모르겠네."
  },
  "71": {
   "jp": "c7781ddd",
   "kr": "어, 이봐…"
  },
  "72": {
   "jp": "2ba81950",
   "kr": "잠, 잠깐 말려 줘."
  },
  "73": {
   "jp": "b8eb6eb1",
   "kr": "휘리, 들려〜!"
  },
  "74": {
   "jp": "d37d3202",
   "kr": "왕비님은 구해 냈어〜!"
  },
  "75": {
   "jp": "e504c6e8",
   "kr": "네에, 알겠어요〜!"
  },
  "76": {
   "jp": "12aed191",
   "kr": "아아아…"
  },
  "77": {
   "jp": "cd4ca565",
   "kr": "에네톤 임금님〜!"
  },
  "78": {
   "jp": "b5b33620",
   "kr": "오케이예요〜!"
  },
  "79": {
   "jp": "5ed9a709",
   "kr": "에네톤 왕"
  },
  "80": {
   "jp": "198343cc",
   "kr": "알았다〜!"
  },
  "81": {
   "jp": "e2e95fed",
   "kr": "지금 간다〜!"
  },
  "82": {
   "jp": "b6a01955",
   "kr": "왜 신호를 하는 거야?"
  },
  "83": {
   "jp": "fc111fa8",
   "kr": "구스가 신호하라고"
  },
  "84": {
   "jp": "dbe72178",
   "kr": "말했잖아."
  },
  "85": {
   "jp": "78b7f858",
   "kr": "그야, 그렇긴 하지만…"
  },
  "86": {
   "jp": "d85ff7b6",
   "kr": "안 되겠어, 퇴각한다."
  },
  "87": {
   "jp": "731b71be",
   "kr": "이번에도 또"
  },
  "88": {
   "jp": "c0fb5b59",
   "kr": "빈손으로 퇴각이냐."
  },
  "89": {
   "jp": "caa26f7c",
   "kr": "가자!"
  },
  "90": {
   "jp": "20214fe6",
   "kr": "아, 잠깐 기다리세요."
  },
  "91": {
   "jp": "d4c2e94e",
   "kr": "뭐야."
  },
  "92": {
   "jp": "31e96b1f",
   "kr": "당신이 없었다면"
  },
  "93": {
   "jp": "3e21c4d9",
   "kr": "어찌 되었을지 모릅니다."
  },
  "94": {
   "jp": "a0b62067",
   "kr": "작은 성의니 받아 주세요."
  },
  "95": {
   "jp": "e458c6f9",
   "kr": "왕비는 구스에게 보석 목걸이를 건넸다."
  },
  "96": {
   "jp": "c54575c0",
   "kr": "팔면 돈이 됩니다, 돈이."
  },
  "97": {
   "jp": "3a03e12a",
   "kr": "어, 고마워…"
  },
  "98": {
   "jp": "ea604fa0",
   "kr": "구스, 서둘러. 병사들이 온다고!"
  },
  "99": {
   "jp": "92ee2ead",
   "kr": "쥬리오, 크리스. 두고 보자!"
  },
  "100": {
   "jp": "3adae119",
   "kr": "………"
  },
  "101": {
   "jp": "871ef076",
   "kr": "또 만나자."
  },
  "102": {
   "jp": "638df4e1",
