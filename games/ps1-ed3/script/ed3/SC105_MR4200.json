  "0": {
   "jp": "7b08c1b1",
   "kr": "쌍룡곡"
  },
  "1": {
   "jp": "5e587575",
   "kr": "서 쌍룡곡 관문"
  },
  "2": {
   "jp": "2782d87c",
   "kr": "동 튜엘 934미로"
  },
  "3": {
   "jp": "9a9a90e0",
   "kr": "아, 잠깐 기다려 봐."
  },
  "4": {
   "jp": "90534653",
   "kr": "왜요?"
  },
  "5": {
   "jp": "9d56bab2",
   "kr": "로디 씨."
  },
  "6": {
   "jp": "f7e0d94b",
   "kr": "쥬리오, 지금까지 싸우는 걸 보고 알았는데"
  },
  "7": {
   "jp": "37c134ed",
   "kr": "넌 막는 게 전혀 안 돼 있다."
  },
  "8": {
   "jp": "7768e346",
   "kr": "힘으로만 공격해선 안 된다."
  },
  "9": {
   "jp": "43771301",
   "kr": "공수를 함께 갖추지 않으면"
  },
  "10": {
   "jp": "ef7beaea",
   "kr": "지구전을 버텨 낼 수 없어."
  },
  "11": {
   "jp": "aace8142",
   "kr": "응, 알았어."
  },
  "12": {
   "jp": "c17ca245",
   "kr": "정말로 알았어?"
  },
  "13": {
   "jp": "d653d75f",
   "kr": "늘"
  },
  "14": {
   "jp": "aed16e7a",
   "kr": "대답만은 잘한다니까."
  },
  "15": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "16": {
   "jp": "6490f8b3",
   "kr": "크리스는 회복 마법을 쓸 줄 알지만"
  },
  "17": {
   "jp": "59681ac2",
   "kr": "주문 쓰는 때가 나쁘다."
  },
  "18": {
   "jp": "a7b7610f",
   "kr": "되도록 헛되이 쓰지 말고"
  },
  "19": {
   "jp": "389a1f33",
   "kr": "주문을 효과적으로 쓰도록 해라."
  },
  "20": {
   "jp": "a61a5c73",
   "kr": "마법이라고 무한히 쓸 수 있는 건 아니니까."
  },
  "21": {
   "jp": "cadb0695",
   "kr": "네〜에."
  },
  "22": {
   "jp": "aed16e7a",
   "kr": "대답만은 잘한다니까."
  },
  "23": {
   "jp": "bad75cec",
   "kr": "따라 하지 마."
  },
  "24": {
   "jp": "4a3e6897",
   "kr": "참견인가 싶다만"
  },
  "25": {
   "jp": "5e28fa55",
   "kr": "여행 중에 어떤 마수가 나올지 알 수 없다."
  },
  "26": {
   "jp": "1a7c59a4",
   "kr": "지금 정도의 마수라면 괜찮지만"
  },
  "27": {
   "jp": "6c3bb45a",
   "kr": "더 강한 놈이 나오면 힘든 싸움이 된다."
  },
  "28": {
   "jp": "73daed75",
   "kr": "지금 미리 자기 싸움법을 짜 두는 게 좋아."
  },
  "29": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "30": {
   "jp": "aca82459",
   "kr": "네〜에!"
  },
  "31": {
   "jp": "8f6b35e4",
   "kr": "대답만은 잘하는군."
  }
 }
