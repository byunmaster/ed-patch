{
 "archive": "/SCE1/SC104.DAT",
 "member": "..\\DATA\\MT5100.BIN",
 "lines": {
  "0": {
   "jp": "1a0093fc",
   "kr": "튜엘"
  },
  "1": {
   "jp": "e5d10daf",
   "kr": "대합실"
  },
  "2": {
   "jp": "8b93f2fe",
   "kr": "어부 비블"
  },
  "3": {
   "jp": "860b1213",
   "kr": "어부 엘노"
  },
  "4": {
   "jp": "1c768269",
   "kr": "안내양 소티스"
  },
  "5": {
   "jp": "2eaf3051",
   "kr": "기행가 조제프"
  },
  "6": {
   "jp": "d3bd5d33",
   "kr": "가루가 나오는 바다 따위"
  },
  "7": {
   "jp": "01dec3e1",
   "kr": "무시무시해서"
  },
  "8": {
   "jp": "a62b16f4",
   "kr": "고기잡이 못 나가."
  },
  "9": {
   "jp": "c0a1f3ec",
   "kr": "이거 당분간은"
  },
  "10": {
   "jp": "17cf851f",
   "kr": "여기서 빈둥거리고 있는 수밖에"
  },
  "11": {
   "jp": "6edf1c29",
   "kr": "없겠어."
  },
  "12": {
   "jp": "e974bc2c",
   "kr": "아아. 너희 일행이라면"
  },
  "13": {
   "jp": "f7e33234",
   "kr": "아까 큰 배가 데리러 와서"
  },
  "14": {
   "jp": "b6c864c7",
   "kr": "타고 갔어."
  },
  "15": {
   "jp": "c076a046",
   "kr": "차림새 좋은 노인도 같이 있더군."
  },
  "16": {
   "jp": "44ced055",
   "kr": "너희만 두고 간 거냐?"
  },
  "17": {
   "jp": "1e6b7ca3",
   "kr": "넬바처럼 거리가 안 부서져도"
  },
  "18": {
   "jp": "a1a29e35",
   "kr": "우리 어부들한텐"
  },
  "19": {
   "jp": "ced1d3a1",
   "kr": "바다에 못 나가는 것만도 큰 타격이야."
  },
  "20": {
   "jp": "d23e9cfa",
   "kr": "아무리 가루가가 자고 있대도"
  },
  "21": {
   "jp": "e7463977",
   "kr": "언제 깰지 모르니까 말이야."
  },
  "22": {
   "jp": "c9a64e9f",
   "kr": "도무지 일이 안 돼."
  },
  "23": {
   "jp": "b8a2cfc7",
   "kr": "깜짝 놀랐다니까."
  },
  "24": {
   "jp": "9181b2af",
   "kr": "배 따윈 안 올 줄 알았는데"
  },
  "25": {
   "jp": "c905cbbe",
   "kr": "아까 대형선이 왔어."
  },
  "26": {
   "jp": "c02f75da",
   "kr": "저건 앰비쉬 배야."
  },
  "27": {
   "jp": "00c9279e",
   "kr": "이래 봬도 배엔 훤하다고."
  },
  "28": {
   "jp": "bb787d6c",
   "kr": "틀림없어."
  },
  "29": {
   "jp": "5edc2e56",
   "kr": "가루가 소동으로 항행선은 전부 결항."
  },
  "30": {
   "jp": "84cd239d",
   "kr": "덕분에 제 일도 너무 한가해요."
  },
  "31": {
   "jp": "83cb65a7",
   "kr": "평소엔 앰비쉬에서 오는"
  },
  "32": {
   "jp": "2c5d8a01",
   "kr": "손님과 짐으로 무척 북적이거든요."
  },
  "33": {
   "jp": "7145d97a",
   "kr": "아까는 놀랐어요. 아무 연락도 없이"
  },
  "34": {
   "jp": "3e60da6c",
   "kr": "갑자기 갤리선이 입항했거든요."
  },
  "35": {
   "jp": "523265e0",
   "kr": "앰비쉬 국적 배라는 것만은 확실해요."
  },
  "36": {
   "jp": "94c2a8ab",
   "kr": "앰비쉬군 배일지도 몰라요."
  },
  "37": {
   "jp": "f6f6c995",
   "kr": "곤란한 노릇이야."
  },
  "38": {
   "jp": "b2b5c456",
   "kr": "정말이지, 가루가 탓에"
  },
  "39": {
   "jp": "2ca557fc",
   "kr": "정기선도 안 뜨는걸."
  },
  "40": {
   "jp": "dd40dd04",
   "kr": "하긴 난 기행가니까"
  },
  "41": {
   "jp": "91a034d8",
   "kr": "이런 일도 나중에 얘깃거리가 된다면"
  },
  "42": {
   "jp": "566b6ebc",
   "kr": "고맙긴 하지만."
  },
  "43": {
   "jp": "9e7cdde7",
   "kr": "기행가세요?"
  },
  "44": {
   "jp": "0a883faf",
   "kr": "그럼 뭔가"
  },
  "45": {
   "jp": "339fc57a",
   "kr": "재미있는 얘기 들려주세요."
  },
  "46": {
   "jp": "15128f2b",
   "kr": "그렇지. 그럼"
  },
  "47": {
   "jp": "cd380570",
   "kr": "하얀마녀에 관한 얘기는"
  },
  "48": {
   "jp": "d1a1ef7d",
   "kr": "모르나?"
  },
  "49": {
   "jp": "c67e1201",
   "kr": "아아, 하얀마녀 말이군."
  },
  "50": {
   "jp": "a6492fa8",
   "kr": "아쉽지만"
  },
  "51": {
   "jp": "3b99d4e3",
   "kr": "지금은 아무것도 몰라."
  },
  "52": {
   "jp": "a31ed752",
   "kr": "하지만 마녀에 대해선"
  },
  "53": {
   "jp": "89c4c35f",
   "kr": "나도 흥미가 있어."
  },
  "54": {
   "jp": "8a884a3f",
   "kr": "언젠가 조사해 볼 생각이야."
  },
  "55": {
   "jp": "eda0fa17",
   "kr": "그럼, 저기요."
  },
  "56": {
   "jp": "7772d97c",
   "kr": "캡틴 토마스 얘기해 주세요."
  },
  "57": {
   "jp": "4dbbd376",
   "kr": "캡틴 토마스 말이지."
  },
  "58": {
   "jp": "ca4186be",
   "kr": "아아, 토마스는 나도 좋아하지만"
  },
  "59": {
   "jp": "b938ae3e",
   "kr": "모처럼 튜엘에 있잖아."
  },
  "60": {
   "jp": "9052138f",
   "kr": "튜엘과 인연이 있는 얘기를 하자."
  },
  "61": {
   "jp": "2726ee95",
   "kr": "대마도사 올테가라고"
  },
  "62": {
   "jp": "a2da9814",
   "kr": "들어 본 적 있니?"
  },
  "63": {
   "jp": "c722091d",
   "kr": "앗, 알아요."
  },
  "64": {
   "jp": "474d82d1",
   "kr": "용을 퇴치한 대마도사지?"
  },
  "65": {
   "jp": "67bd8771",
   "kr": "그래그래, 잘 아는구나."
  },
  "66": {
   "jp": "7011a9fb",
   "kr": "실은 말이야, 대마도사 올테가가 살던 곳이"
  },
  "67": {
   "jp": "277b42fc",
   "kr": "아무래도 이 근처인 모양이야."
  },
  "68": {
   "jp": "3f84a906",
   "kr": "지금 가루가가 있다는 로프섬에서"
  },
  "69": {
   "jp": "bd2b46e6",
   "kr": "용 퇴치가 있었다는 전승도 있어."
  },
  "70": {
   "jp": "7d14916b",
   "kr": "정말요?"
  },
  "71": {
   "jp": "dab9429a",
   "kr": "하지만 정말 그렇다 해도"
  },
  "72": {
   "jp": "9fd0bd51",
   "kr": "꽤 오랜 옛날 일이잖아요?"
  },
  "73": {
   "jp": "4efb062d",
   "kr": "아니, 우리한텐 옛날 일일지 몰라도"
  },
  "74": {
   "jp": "c365a8b2",
   "kr": "역사의 흐름 속에선 아주 조금 전이야."
  },
  "75": {
   "jp": "f1e1b1e3",
   "kr": "기껏해야 50년쯤 전 일이라고."
  },
  "76": {
   "jp": "67981c16",
   "kr": "다니까."
  },
  "77": {
   "jp": "209c5878",
   "kr": "어쩌면 대마도사 올테가도"
  },
  "78": {
   "jp": "a71b517e",
   "kr": "아직 살아 있을지 몰라."
  },
  "79": {
   "jp": "211e333c",
   "kr": "그럼, 용도 있겠네요."
  },
  "80": {
   "jp": "964d9b7d",
   "kr": "가루가도 있으니까"
  },
  "81": {
   "jp": "339ce860",
   "kr": "용도 분명"
  },
  "82": {
   "jp": "ec9eb4ef",
   "kr": "어딘가에 있을 거야."
  },
  "83": {
   "jp": "835e530d",
   "kr": "그러고 보니 말이야."
  },
  "84": {
   "jp": "2726ee95",
   "kr": "대마도사 올테가는"
  },
  "85": {
   "jp": "b463d97c",
   "kr": "마지막에 어떻게 됐어요?"
  },
  "86": {
   "jp": "71320e1f",
   "kr": "대마도사 올테가는 요술사 겟페우스와"
  },
  "87": {
   "jp": "62621075",
   "kr": "협력해 악마를 무찌른 뒤 하늘의 샤리네가"
  },
  "88": {
   "jp": "8c8e1e4a",
   "kr": "있던 올도스에 대성당을 세웠다고 한다."
  },
  "89": {
   "jp": "5c3ac3b4",
   "kr": "그게 지금 올도스의 시작이야."
  },
  "90": {
   "jp": "92d0f750",
   "kr": "에〜, 그랬군요."
  },
  "91": {
   "jp": "164bde32",
   "kr": "저희랑도 관계있는 거네요."
  },
  "92": {
   "jp": "ee133e0b",
   "kr": "앗, 그렇구나."
  },
  "93": {
   "jp": "ac6f1df9",
   "kr": "너희는 순례 여행자로구나."
  },
  "94": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "95": {
   "jp": "4170ad7c",
   "kr": "그 뒤로 말이야, 대마도사 올테가는"
  },
  "96": {
   "jp": "8959c579",
   "kr": "올도스 초대 대신관을 맡았지만"
  },
  "97": {
   "jp": "f19426c0",
   "kr": "은퇴한 뒤로는 아무도 어떻게 됐는지 몰라."
  },
  "98": {
   "jp": "1950700f",
   "kr": "어쩌면 튜엘로 돌아와"
  },
  "99": {
   "jp": "8dce1b76",
   "kr": "그 근처 길을"
  },
  "100": {
   "jp": "b914ccb8",
   "kr": "느긋하게 걷고 있을지도 모르지."
  },
  "101": {
   "jp": "a059d286",
   "kr": "그런, 설마…"
  },
  "102": {
   "jp": "12e92514",
   "kr": "하하하하…"
  },
  "103": {
   "jp": "294da1af",
   "kr": "아무리 그래도 그건 없겠지."
  },
  "104": {
   "jp": "59086f54",
   "kr": "대마도사 올테가에 대해선"
  },
  "105": {
   "jp": "a627343f",
   "kr": "이 정도야."
  },
  "106": {
   "jp": "24cde9ae",
   "kr": "어떠니 심심풀이는 됐지?"
  },
  "107": {
   "jp": "b6add0ef",
   "kr": "하얀마녀에 대해선"
  },
  "108": {
   "jp": "b465f9d3",
   "kr": "언젠가 제대로 조사해서"
  },
  "109": {
   "jp": "a33bf528",
   "kr": "책으로 낼 생각이야."
  },
  "110": {
   "jp": "90f6d02a",
   "kr": "기대하고 있으렴."
  }
 }
}