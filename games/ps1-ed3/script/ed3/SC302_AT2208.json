  },
  "3": {
   "jp": "602f4809",
   "kr": "죠리나"
  },
  "4": {
   "jp": "11cd763b",
   "kr": "죠르노"
  },
  "5": {
   "jp": "0c7db3e3",
   "kr": "볼트의 싸움도 도둑 소동도"
  },
  "6": {
   "jp": "beafd2c0",
   "kr": "두 분은 제게 있어서"
  },
  "7": {
   "jp": "18967fb0",
   "kr": "두 분은 잊을 수 없는 영웅입니다!"
  },
  "8": {
   "jp": "97f9cff6",
   "kr": "저희가 할 수 있는 일이라면"
  },
  "9": {
   "jp": "12606964",
   "kr": "뭐든 말씀해 주십시오."
  },
  "10": {
   "jp": "7e8d30b2",
   "kr": "로디."
  },
  "11": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "12": {
   "jp": "4d698deb",
   "kr": "이제 떠난다는군."
  },
  "13": {
   "jp": "0c681aa0",
   "kr": "사실은 로디 상태가"
  },
  "14": {
   "jp": "b36505f5",
   "kr": "조금 더 좋아질 때까지"
  },
  "15": {
   "jp": "cc457a6e",
   "kr": "여기 있고 싶은 마음도 들지만."
  },
  "16": {
   "jp": "ceda5616",
   "kr": "걱정은 하고 있다니까."
  },
  "17": {
   "jp": "2de67fa1",
   "kr": "말은 잘하는군."
  },
  "18": {
   "jp": "af6a2c39",
   "kr": "아까 환자 위에서 뛰어다닌 건"
  },
  "19": {
   "jp": "f0256119",
   "kr": "어디 사는 누구냐?"
  },
  "20": {
   "jp": "b379dc3e",
   "kr": "하하하…"
  },
  "21": {
   "jp": "aa7752b3",
   "kr": "쥬리오도 참"
  },
  "22": {
   "jp": "a817e0fb",
   "kr": "웃어서 얼버무리네."
  },
  "23": {
   "jp": "924a7260",
   "kr": "뭐, 걱정 마. 나라면"
  },
  "24": {
   "jp": "2775dace",
   "kr": "체력도 거의 돌아왔다."
  },
  "25": {
   "jp": "0c5dee15",
   "kr": "4, 5일이면 다 나을 거다."
  },
  "26": {
   "jp": "ab508926",
   "kr": "로디 군 수발은"
  },
  "27": {
   "jp": "d6b6c62b",
   "kr": "저희가 책임지고 할 테니까요."
  },
  "28": {
   "jp": "4d634b31",
   "kr": "쥬리오 님 일행은 안심하고"
  },
  "29": {
   "jp": "d4f5732e",
   "kr": "순례 여행을 계속하세요."
  },
  "30": {
   "jp": "c13de397",
   "kr": "감사합니다 왕비님."
  },
  "31": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "32": {
   "jp": "a0110395",
   "kr": "그럼, 슬슬 갈까?"
  },
  "33": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "34": {
   "jp": "cb6ce2e9",
   "kr": "조심해서 가라."
  },
  "35": {
   "jp": "52006b61",
   "kr": "쥬리오도 조금은 검이 늘었지만"
  },
  "36": {
   "jp": "abe45cb4",
   "kr": "세상에는 싸움 잘하는 나쁜 놈들도"
  },
  "37": {
   "jp": "bfdc7fd9",
   "kr": "널려 있다."
  },
  "38": {
   "jp": "23aec671",
   "kr": "여행하는 마음가짐은"
  },
  "39": {
   "jp": "b9ef8a3d",
   "kr": "제 힘을 결코 과신치 않는 것이다."
  },
  "40": {
   "jp": "6638e595",
   "kr": "조금 세졌다고"
  },
  "41": {
   "jp": "13f806f6",
   "kr": "너무 무리하면 큰코다치니까."
  },
  "42": {
   "jp": "379f05a9",
   "kr": "조심해라."
  },
  "43": {
   "jp": "22b1afb8",
   "kr": "응, 알겠어."
  },
  "44": {
   "jp": "d8560402",
   "kr": "고마워, 로디."
  },
  "45": {
   "jp": "a431bc62",
   "kr": "그럼, 문까지 배웅하지."
  },
  "46": {
   "jp": "a2fb3170",
   "kr": "잘 있어, 로디."
  },
  "47": {
   "jp": "1df3607c",
   "kr": "꼭 또 만나자."
  },
  "48": {
   "jp": "1b4ab337",
   "kr": "그래, 또 어딘가에서"
  },
  "49": {
   "jp": "313247ff",
   "kr": "꼭 만날 거다."
  },
  "50": {
   "jp": "78ac7a78",
   "kr": "그럼."
  },
  "51": {
   "jp": "195ed34d",
   "kr": "그럼, 조심해서 가게."
  },
  "52": {
   "jp": "c1e2f72b",
   "kr": "쥬리오, 크리스."
  },
  "53": {
   "jp": "29d51463",
   "kr": "모리슨. 두 사람을 부디 부탁한다."
  },
  "54": {
   "jp": "92925444",
   "kr": "네, 알겠습니다."
  },
  "55": {
   "jp": "5e075004",
   "kr": "그러면 조심히 가세요."
  },
  "56": {
   "jp": "e194ce70",
   "kr": "부모님께 안부 전해 주세요."
  },
  "57": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "58": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "59": {
   "jp": "e6198fd5",
   "kr": "여행이 끝난 뒤라도 좋네."
  },
  "60": {
   "jp": "b855695b",
   "kr": "또 놀러 와 주게."
  },
  "61": {
   "jp": "48f941c8",
   "kr": "어라?"
  },
  "62": {
   "jp": "185c814c",
   "kr": "아직도 이런 데서 어슬렁"
  },
  "63": {
   "jp": "402a40ff",
   "kr": "대고 있었냐?"
  },
  "64": {
   "jp": "df21dd9d",
   "kr": "로디야말로 아직 자고 있었네."
  },
  "65": {
   "jp": "5b835b87",
   "kr": "진짜 아직 못 일어나는 걸까."
  },
  "66": {
   "jp": "14df221a",
   "kr": "뭐, 뭐야…"
  },
  "67": {
   "jp": "29f31708",
   "kr": "그 의심스러운 눈초리는…?"
  },
  "68": {
   "jp": "96c64db0",
   "kr": "자네들 여행길이 무사하길 비네."
  },
  "69": {
   "jp": "e09e75e4",
   "kr": "조심히 가세요."
  },
  "70": {
   "jp": "e194ce70",
   "kr": "부모님께 안부 전해 주세요."
