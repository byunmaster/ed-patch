 "lines": {
  "0": {
   "jp": "bb708123",
   "kr": "라그픽 마을"
  },
  "1": {
   "jp": "0b8d576a",
   "kr": "로그"
  },
  "2": {
   "jp": "d1dadd18",
   "kr": "이상하네, 아무도 없잖아."
  },
  "3": {
   "jp": "3adae119",
   "kr": "………"
  },
  "4": {
   "jp": "33230947",
   "kr": "다들 어디로 가 버린 걸까?"
  },
  "5": {
   "jp": "e8750b93",
   "kr": "설마…"
  },
  "6": {
   "jp": "5590ff80",
   "kr": "네?"
  },
  "7": {
   "jp": "8ce51915",
   "kr": "설마라니… 뭐야?"
  },
  "8": {
   "jp": "d0270275",
   "kr": "아로자 여관에서 꿈을 꿨거든."
  },
  "9": {
   "jp": "daa0c1fe",
   "kr": "꿈이라니, 어떤?"
  },
  "10": {
   "jp": "3adae119",
   "kr": "………"
  },
  "11": {
   "jp": "0a31ff35",
   "kr": "그다지 좋은 꿈은 아니야."
  },
  "12": {
   "jp": "dbcc33d2",
   "kr": "뜸 들이지 말고 말해 줘."
  },
  "13": {
   "jp": "41c22c5b",
   "kr": "괜히 더 걱정되잖아."
  },
  "14": {
   "jp": "5e5aab85",
   "kr": "으, 응."
  },
  "15": {
   "jp": "e9e5f64c",
   "kr": "마을에 돌아온 꿈이었는데"
  },
  "16": {
   "jp": "c4d550a5",
   "kr": "그 꿈이랑 똑같아."
  },
  "17": {
   "jp": "c104c29c",
   "kr": "라프 할아버지도 집에 없었고"
  },
  "18": {
   "jp": "28a18eb7",
   "kr": "마을에도 아무도… 로그 말곤 아무도 없었어."
  },
  "19": {
   "jp": "d0273f90",
   "kr": "로그는 있었어?"
  },
  "20": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "21": {
   "jp": "fcd0112c",
   "kr": "쓰러져 있었어."
  },
  "22": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "23": {
   "jp": "89db00d7",
   "kr": "어디에?"
  },
  "24": {
   "jp": "63205dbd",
   "kr": "이, 이쪽이야."
  },
  "25": {
   "jp": "e1b7c2b7",
   "kr": "앗…?!"
  },
  "26": {
   "jp": "b4b288f8",
   "kr": "거, 거짓말…"
  },
  "27": {
   "jp": "4ca62780",
   "kr": "예지몽…?"
  },
  "28": {
   "jp": "ca20bfdf",
   "kr": "꿈은 그 뒤에 어땠어?"
  },
  "29": {
   "jp": "b2aad109",
   "kr": "모르겠어."
  },
  "30": {
   "jp": "005edb69",
   "kr": "어째서?"
  },
  "31": {
   "jp": "30a3c40d",
   "kr": "누가 깨워서."
  },
  "32": {
   "jp": "66e2dbec",
   "kr": "정말 누가 깨운 거야?"
  },
  "33": {
   "jp": "ac21c7da",
   "kr": "크리스야."
  },
  "34": {
   "jp": "bafc826d",
   "kr": "………그, 그래?"
  },
  "35": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "36": {
   "jp": "ce7aa355",
   "kr": "로그는 꼼짝도 하지 않는다."
  },
  "37": {
   "jp": "7e616f01",
   "kr": "쥬… 쥬리오…"
  },
  "38": {
   "jp": "dfdbde56",
   "kr": "살펴봐 줘."
  },
  "39": {
   "jp": "5e5aab85",
   "kr": "으, 응."
  },
  "40": {
   "jp": "ae2ad21e",
   "kr": "어때?"
  },
  "41": {
   "jp": "ec8a2c85",
   "kr": "아, 아직… 모르겠어."
  },
  "42": {
   "jp": "8de4554f",
   "kr": "흔들어 봐."
  },
  "43": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "44": {
   "jp": "589f011f",
   "kr": "쥬리오는 로그의 어깨에 손을 뻗으려 했다."
  },
  "45": {
   "jp": "a71bb735",
   "kr": "새근. 새근. 새근."
  },
  "46": {
   "jp": "06f6d2f0",
   "kr": "어라."
  },
  "47": {
   "jp": "6df962ab",
   "kr": "…?"
  },
  "48": {
   "jp": "90839179",
   "kr": "아야."
  },
  "49": {
   "jp": "3da4cf30",
   "kr": "뭐야〜아…?"
  },
  "50": {
   "jp": "14c72825",
   "kr": "누구야, 내 머리를 때린 녀석은?"
  },
  "51": {
   "jp": "e7b51c33",
   "kr": "헷갈리게 하네."
  },
  "52": {
   "jp": "8bb618a8",
   "kr": "왜 이런 데서 자고 있는 거야?"
  },
  "53": {
   "jp": "0b4ed79f",
   "kr": "어디 있는 거야〜 누구냐고…?"
  },
  "54": {
   "jp": "6f649f57",
   "kr": "아직 잠이 덜 깼어."
  },
  "55": {
   "jp": "7602cad2",
   "kr": "이쪽이야, 로그."
  },
  "56": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "57": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "58": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "59": {
   "jp": "3ee351df",
   "kr": "돌아왔구나."
  },
  "60": {
   "jp": "91c9b7a0",
   "kr": "어서 와."
  },
  "61": {
   "jp": "86edf279",
   "kr": "로그, 다녀왔어."
  },
  "62": {
   "jp": "e32fd58d",
   "kr": "다녀왔어."
  },
  "63": {
   "jp": "1fa709b7",
   "kr": "저기, 로그. 마을 사람들은?"
  },
  "64": {
   "jp": "5422873c",
   "kr": "게다가 왜 이런 데서 자고 있는 거야?"
  },
  "65": {
   "jp": "728fcba6",
   "kr": "무슨 소리야?"
  },
  "66": {
   "jp": "84de956e",
   "kr": "어제 루드성에서 심부름꾼이 와서"
  },
  "67": {
   "jp": "feeba7cb",
   "kr": "너희가 돌아온다길래"
  },
  "68": {
   "jp": "ff4f1224",
   "kr": "난 밤새워 환영 준비를 하고 있었다고."
  },
  "69": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "70": {
   "jp": "e3dfc619",
   "kr": "에엣?!"
  },
  "71": {
   "jp": "d28315bd",
   "kr": "혼자서 망루를 세우느라"
  },
  "72": {
   "jp": "ee4eeef5",
   "kr": "난 이제"
  },
  "73": {
   "jp": "520a7c9a",
   "kr": "녹초야."
  },
  "74": {
   "jp": "eddfa1e3",
   "kr": "미안해… 로그."
  },
  "75": {
   "jp": "fb538fe6",
   "kr": "괜찮아, 괜찮아."
  },
  "76": {
   "jp": "d7b45e36",
   "kr": "자, 서쪽 들판에 환영 준비가 되어 있다."
  },
  "77": {
   "jp": "4ef85b3f",
   "kr": "다들 기다리고 있어."
  },
  "78": {
   "jp": "566d297d",
   "kr": "가자고!"
  }
 }
