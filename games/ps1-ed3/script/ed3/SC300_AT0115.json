 "archive": "/SCE3/SC300.DAT",
 "member": "..\\DATA\\AT0115.BIN",
 "lines": {
  "0": {
   "jp": "bf50e946",
   "kr": "볼트"
  },
  "1": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "2": {
   "jp": "3633e3d1",
   "kr": "여어, 너희들."
  },
  "3": {
   "jp": "854c065f",
   "kr": "가루가는 조금 전에 바다로 돌아갔어."
  },
  "4": {
   "jp": "8d3ffc69",
   "kr": "역시"
  },
  "5": {
   "jp": "2a475f3b",
   "kr": "원래는 얌전한 동물이었어."
  },
  "6": {
   "jp": "3722049f",
   "kr": "가루가를 사납게 만든 건"
  },
  "7": {
   "jp": "bcd62f73",
   "kr": "안에 숨어 있던"
  },
  "8": {
   "jp": "32cb7b9f",
   "kr": "그 마수였겠지."
  },
  "9": {
   "jp": "49330ad8",
   "kr": "다친 병사는"
  },
  "10": {
   "jp": "01015a2f",
   "kr": "이미 안데라로 향했습니다."
  },
  "11": {
   "jp": "88e5f62b",
   "kr": "대부분의 병사가 곧 안데라로 돌아갑니다."
  },
  "12": {
   "jp": "9ea69d96",
   "kr": "원래 볼트는 병사가 주둔하는"
  },
  "13": {
   "jp": "cf54892b",
   "kr": "마을이 아니니까요."
  },
  "14": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "15": {
   "jp": "c9933e27",
   "kr": "임금님의 친구분."
  },
  "16": {
   "jp": "127e934e",
   "kr": "수고하셨습니다."
  },
  "17": {
   "jp": "4f6c276c",
   "kr": "활약은 들었습니다."
  },
  "18": {
   "jp": "f3aaaab7",
   "kr": "과연 임금님의 친구분."
  },
  "19": {
   "jp": "9b231e17",
   "kr": "이그니스로 가신다면서요."
  },
  "20": {
   "jp": "c251860b",
   "kr": "자, 어서요. 조심하세요."
  },
  "21": {
   "jp": "5272d13c",
   "kr": "이 길로 가면"
  },
  "22": {
   "jp": "59e18042",
   "kr": "이그니스까지 직통입니다."
  },
  "23": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "24": {
   "jp": "f3f196f1",
   "kr": "뭔가 잊은 물건이라도 있나요?"
  },
  "25": {
   "jp": "f5c5f90e",
   "kr": "저기, 모리슨 씨가"
  },
  "26": {
   "jp": "ebaad19b",
   "kr": "건네주고 싶은 게 있다고 했잖아."
  },
  "27": {
   "jp": "5d53eb9f",
   "kr": "이대로 가 버리면 실례야."
  }
 }
}