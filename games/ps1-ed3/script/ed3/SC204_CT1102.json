   "kr": "다츠"
  },
  "1": {
   "jp": "0a5e1957",
   "kr": "포리쉬"
  },
  "2": {
   "jp": "9c3b5f51",
   "kr": "안지"
  },
  "3": {
   "jp": "b4505917",
   "kr": "시켓트"
  },
  "4": {
   "jp": "00cdd041",
   "kr": "젠느"
  },
  "5": {
   "jp": "a76cf681",
   "kr": "치젤"
  },
  "6": {
   "jp": "a2dbf087",
   "kr": "토니카"
  },
  "7": {
   "jp": "2466f8eb",
   "kr": "대장장이 질"
  },
  "8": {
   "jp": "f0f78bdc",
   "kr": "꼭 멋진 마을로 만들어 보일 거야."
  },
  "9": {
   "jp": "c42c6f1d",
   "kr": "우리들도, 힘낼 거야!"
  },
  "10": {
   "jp": "d678b6da",
   "kr": "고마워."
  },
  "11": {
   "jp": "ed49bb98",
   "kr": "너희들한테는"
  },
  "12": {
   "jp": "9a6258a7",
   "kr": "정말 큰 신세를 졌어."
  },
  "13": {
   "jp": "bceb3d79",
   "kr": "아까 키타라 악사 트로바 씨를"
  },
  "14": {
   "jp": "baadc9f8",
   "kr": "데려와 줘서 고마워요."
  },
  "15": {
   "jp": "c5b0eaba",
   "kr": "여러분은 다츠 마을의 은인이에요."
  },
  "16": {
   "jp": "b5f39744",
   "kr": "드디어, 어른들이 진지해진 것 같아."
  },
  "17": {
   "jp": "b56ca91c",
   "kr": "있잖아. 내가 어른이 될 무렵엔"
  },
  "18": {
   "jp": "4d6f8f1a",
   "kr": "분명 이 마을에도 다이스처럼"
  },
  "19": {
   "jp": "4e4d6409",
   "kr": "커다란 집이 잔뜩 설 거야."
  },
  "20": {
   "jp": "6289bd44",
   "kr": "나는 조용히 내 솜씨를 갈고닦고 싶어서"
  },
  "21": {
   "jp": "39f64bcc",
   "kr": "여기 왔다네."
  },
  "22": {
   "jp": "83f8b23f",
   "kr": "다츠 사람들은 지금껏 활기는 없었지만"
  },
  "23": {
   "jp": "18fa44b8",
   "kr": "돈보다 소중한 걸 알고 있지."
  },
  "24": {
   "jp": "17fc2037",
   "kr": "다행히 여기 사람들도 희망을 품었어."
  },
  "25": {
   "jp": "373ab7dc",
   "kr": "이제는 내 솜씨가 크게 쓸모 있겠군."
  },
  "26": {
   "jp": "b36247dc",
   "kr": "이 다츠를 찾아올 정도이니."
  },
  "27": {
   "jp": "ff0527f0",
   "kr": "자네들도 사리사욕으로 움직일 이는 아니겠지."
  },
  "28": {
   "jp": "48624313",
   "kr": "여기서 몇 해째 장사를 안 했네만"
  },
  "29": {
   "jp": "8067ede8",
   "kr": "자네들에게라면 마음 놓고 팔 수 있겠네."
  },
  "30": {
   "jp": "5cff7fe6",
   "kr": "자, 사양 말고 용건을 말해 주게."
  },
  "31": {
   "jp": "dc163cce",
   "kr": "다츠 사람들이 희망을 품어 다행이야."
  },
  "32": {
   "jp": "44baf48a",
   "kr": "이제는 내 솜씨도"
  },
  "33": {
   "jp": "e7dac1e5",
   "kr": "이 마을을 위해 쓰겠네."
  },
  "34": {
   "jp": "eba7b99e",
   "kr": "이것도 자네들 덕분일세."
  },
  "35": {
   "jp": "c56eb8d4",
   "kr": "볼일이 있으면 사양 말게."
  },
  "36": {
   "jp": "5bd08cf6",
   "kr": "오오, 자네들인가."
  },
  "37": {
   "jp": "94618581",
   "kr": "용건은 무엇인가?"
  },
  "38": {
   "jp": "8b25cea1",
   "kr": "몸은 늙었어도, 무기 만드는 일에선"
  },
  "39": {
   "jp": "f182f3f7",
   "kr": "늙지 않았다고 보네."
  },
  "40": {
   "jp": "95327b89",
   "kr": "무얼 찾는가?"
  },
  "41": {
   "jp": "9afdca9a",
   "kr": "를 고르셨나."
  },
  "42": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "43": {
   "jp": "ba465b9d",
   "kr": "에 팔겠네."
  },
  "44": {
   "jp": "d7df4249",
   "kr": "이 다츠에선 재료 모으기가 힘들어서."
  },
  "45": {
   "jp": "27317148",
   "kr": "필요 없는 건 고맙게 사들이지."
  },
  "46": {
   "jp": "29d159fe",
   "kr": "를 팔아 주시겠나?"
  },
  "47": {
   "jp": "abb8567e",
   "kr": "그렇다면,"
  },
  "48": {
   "jp": "a1449844",
   "kr": "에 사들이겠어."
  },
  "49": {
   "jp": "6ae7fa54",
   "kr": "라피카는 무기 만들기에 꼭 필요한 재료."
  },
  "50": {
   "jp": "78f7aaa8",
   "kr": "1 Goa당 20 Pia 주겠네만, 어떤가?"
  },
  "51": {
   "jp": "6b8e66b5",
   "kr": "고맙군."
  },
  "52": {
   "jp": "ff5e0e69",
   "kr": "을 치르지."
  },
  "53": {
   "jp": "302100f9",
   "kr": "라피카가 없는 모양이군."
  },
  "54": {
   "jp": "c334d0cb",
   "kr": "모이면, 언제든 오게나."
  },
  "55": {
   "jp": "45796a6a",
   "kr": "다른 볼일은?"
  },
  "56": {
   "jp": "8ed7d895",
   "kr": "자네들과는 장사를 하네만"
  },
  "57": {
   "jp": "e94e397c",
   "kr": "부디, 다른 마을에서 내 얘기를"
  },
  "58": {
   "jp": "693ed45e",
   "kr": "하지 말아 주게."
  },
  "59": {
   "jp": "89f25c6f",
   "kr": "나는 조용히 솜씨를 갈고닦고 싶다네."
  }
 }
}