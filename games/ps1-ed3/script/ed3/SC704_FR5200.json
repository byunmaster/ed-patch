 "lines": {
  "0": {
   "jp": "118f0213",
   "kr": "게르드 언덕"
  },
  "1": {
   "jp": "bf3a760a",
   "kr": "나는 의문을 품은 채로도,"
  },
  "2": {
   "jp": "65b30b1d",
   "kr": "붙잡기 위해 하얀마녀의 행적을 쫓는 여행을"
  },
  "3": {
   "jp": "879c4306",
   "kr": "시작해야만 했다"
  },
  "4": {
   "jp": "16ccf683",
   "kr": "디네의 샤리네에 나타난 하얀마녀는"
  },
  "5": {
   "jp": "ff872ebf",
   "kr": "라그나에서 배로 메나트로 건너갔다고 들어,"
  },
  "6": {
   "jp": "e3e4b849",
   "kr": "나도 바다를 건넜다."
  },
  "7": {
   "jp": "a8683633",
   "kr": "내가 겨우 하얀마녀를 따라잡은 곳은,"
  },
  "8": {
   "jp": "aeb1525f",
   "kr": "챠놈에 있는 이름도 모르는 마을이었다."
  }
 }
}