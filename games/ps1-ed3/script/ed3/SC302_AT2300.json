   "kr": "이거 한 방 먹었군요."
  },
  "20": {
   "jp": "cde7369d",
   "kr": "좀 더 수행을 쌓아 둘게요."
  },
  "21": {
   "jp": "4f045262",
   "kr": "어서 오십시오."
  },
  "22": {
   "jp": "296ff78b",
   "kr": "안에서 폐하께서 기다리십니다."
  },
  "23": {
   "jp": "4fd3f5dd",
   "kr": "알현실 입구는 이쪽입니다."
