  },
  "25": {
   "jp": "d7041ee1",
   "kr": "잘 오셨습니다."
  },
  "26": {
   "jp": "a4fbfd3e",
   "kr": "자, 어서."
  },
  "27": {
   "jp": "aa8a7fc2",
   "kr": "알현실로 들어가십시오."
  },
  "28": {
   "jp": "2e72e9b0",
   "kr": "볼트에서는 신세를 졌습니다."
  },
  "29": {
   "jp": "cbf40119",
