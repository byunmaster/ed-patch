  },
  "5": {
   "jp": "48048e99",
   "kr": "어서 오십시오."
  },
  "6": {
   "jp": "025a4605",
   "kr": "기다리고 있었습니다."
  },
  "7": {
   "jp": "3d0de8f6",
   "kr": "저 안쪽 방이 알현실입니다."
