  "0": {
   "jp": "b2086cc7",
   "kr": "테그라 탄광"
  },
  "1": {
   "jp": "8a700d52",
   "kr": "지하 2층"
  },
  "2": {
   "jp": "90ce3209",
   "kr": "광부 시라프"
  },
  "3": {
   "jp": "7d38049f",
   "kr": "광부 테드"
  },
  "4": {
   "jp": "fc3838e7",
   "kr": "광부 보리"
  },
  "5": {
   "jp": "d564ff61",
   "kr": "광부 아일"
  },
  "6": {
   "jp": "275e1547",
   "kr": "아까 지진이 있었는데"
  },
  "7": {
   "jp": "5852c76b",
   "kr": "너희 괜찮았니?"
  },
  "8": {
   "jp": "a6ba2d8f",
   "kr": "산사태로 출구가 막혔는데"
  },
  "9": {
   "jp": "c2120a79",
   "kr": "광부 아저씨들이 구해 줬어요."
  },
  "10": {
   "jp": "911965b9",
   "kr": "그랬구나 무사해서 다행이다."
  },
  "11": {
   "jp": "ca986af0",
   "kr": "이제 볼일은 끝났니?"
  },
  "12": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "13": {
   "jp": "6e1d6c17",
   "kr": "그럼, 조심해서 돌아가렴."
  },
  "14": {
   "jp": "54d76edc",
   "kr": "이런…?"
  },
  "15": {
   "jp": "8341600f",
   "kr": "애가 이런 안쪽까지 들어오면 위험하다."
  },
  "16": {
   "jp": "00d45082",
   "kr": "방해되니까, 저쪽으로 가라."
  },
  "17": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "18": {
   "jp": "31db05b5",
   "kr": "케빈 영감이 부탁했다고?"
  },
  "19": {
   "jp": "06c898e7",
   "kr": "영감도 애한테 무리한 걸 시키는군."
  },
  "20": {
   "jp": "bec60af1",
   "kr": "승강기는 옆 갱도다."
  },
  "21": {
   "jp": "628c4883",
   "kr": "조심해서 가거라."
  },
  "22": {
   "jp": "15b70214",
   "kr": "그럼, 조심해서 돌아가라."
  },
  "23": {
   "jp": "09b6cfb0",
   "kr": "이제 이 층이면 괜찮겠지만,"
  },
  "24": {
   "jp": "afbcd475",
   "kr": "조심하는 게 좋으니까."
  },
  "25": {
   "jp": "3462cb5a",
   "kr": "길 따라 북쪽으로 가서"
  },
  "26": {
   "jp": "c2f74efb",
   "kr": "광차가 보이면 왼쪽으로 꺾어라."
  },
  "27": {
   "jp": "c6d9543c",
   "kr": "오른쪽으로 가면 또 이탄 늪으로 돌아간다."
  },
  "28": {
   "jp": "ef2ed6b3",
   "kr": "여기에 승강기를 만들면 편해지겠군."
  },
  "29": {
   "jp": "a3712382",
   "kr": "정말, 좋은 자리를 찾았어."
  },
  "30": {
   "jp": "89e414ea",
   "kr": "이걸로 작업도 잘 풀리겠지."
  },
  "31": {
   "jp": "bd606633",
   "kr": "이야, 어떻게든 살았구나."
  },
  "32": {
   "jp": "629ee249",
   "kr": "뭐야, 역시 여기는"
  },
  "33": {
   "jp": "e940c85b",
   "kr": "내가 파던 곳이다."
  },
  "34": {
   "jp": "3e46113b",
   "kr": "탄광이란 건 너무 파면"
  },
  "35": {
   "jp": "81475da5",
   "kr": "어디가 어떻게 무너질지 모르니까."
  },
  "36": {
   "jp": "1bacd83c",
   "kr": "그래도 우리는 운이 좋았어."
  },
  "37": {
   "jp": "784b8ff3",
   "kr": "아저씨들이 있어 줘서"
  },
  "38": {
   "jp": "5eb28931",
   "kr": "정말 살았어요."
  },
  "39": {
   "jp": "f426ad1a",
   "kr": "뭘, 서로 마찬가지다."
  },
  "40": {
   "jp": "c1ea7224",
   "kr": "우리도 너희가 없었으면"
  },
  "41": {
   "jp": "dce45c47",
   "kr": "못 살아났다."
  },
  "42": {
   "jp": "15b70214",
   "kr": "그럼, 조심해서 돌아가라."
  },
  "43": {
   "jp": "09b6cfb0",
   "kr": "이제 이 층이면 괜찮겠지만,"
  },
  "44": {
   "jp": "afbcd475",
   "kr": "조심하는 게 좋으니까."
  }
 }
}