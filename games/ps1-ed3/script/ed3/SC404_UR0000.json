 "lines": {
  "0": {
   "jp": "4708f8c7",
   "kr": "정적의 숲"
  },
  "1": {
   "jp": "098c0e08",
   "kr": "우돌 국경　풍곡 관문"
  },
  "2": {
   "jp": "85ac53a9",
   "kr": "서쪽 시플 725미로"
  },
  "3": {
   "jp": "f2559ed1",
   "kr": "하〜"
  },
  "4": {
   "jp": "916059a2",
   "kr": "무서웠어."
  },
  "5": {
   "jp": "533f16b2",
   "kr": "정말!"
  },
  "6": {
   "jp": "f381217a",
   "kr": "깜짝 놀랐잖아."
  },
  "7": {
   "jp": "1f08083c",
   "kr": "아니, 미안, 미안."
  },
  "8": {
   "jp": "5b5a1d6c",
   "kr": "그 아가씨한테 약혼자가 있을 줄이야."
  },
  "9": {
   "jp": "8a0d2ed4",
   "kr": "감사하셔야지요."
  },
  "10": {
   "jp": "76cb0337",
   "kr": "쥬리오 님과 크리스 님 덕분에"
  },
  "11": {
   "jp": "bd6bab0f",
   "kr": "무사히 관문을 지날 수 있었습니다."
  },
  "12": {
   "jp": "91ff93d2",
   "kr": "쥬리오 님? 크리스 님?"
  },
  "13": {
   "jp": "0cfcb029",
   "kr": "이 녀석들은 이름만 불러도 충분해."
  },
  "14": {
   "jp": "a082d90a",
   "kr": "오래된 사이잖아!"
  },
  "15": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "16": {
   "jp": "24f5b67f",
   "kr": "아니거든!"
  },
  "17": {
   "jp": "1f8aacd2",
   "kr": "…그런데 당신 누구야?"
  },
  "18": {
   "jp": "2c47c4e2",
   "kr": "저는 앰비쉬 왕의 집사 모리슨입니다."
  },
  "19": {
   "jp": "86665430",
   "kr": "본래라면 그대 따위는"
  },
  "20": {
   "jp": "24cf812a",
   "kr": "지하 감옥에 처넣어 뒀을 것을."
  },
  "21": {
   "jp": "f1168d5f",
   "kr": "헤헤."
  },
  "22": {
   "jp": "6607c8ab",
   "kr": "그렇게 발끈하지 좀 말라고."
  },
  "23": {
   "jp": "a43bff0b",
   "kr": "여긴 이제 앰비쉬가 아니라고."
  },
  "24": {
   "jp": "12a5fd1f",
   "kr": "당신의 직함도 우돌에선 무효지."
  },
  "25": {
   "jp": "b0e480b3",
   "kr": "와, 어려운 것도 다 아네."
  },
  "26": {
   "jp": "1bdadbd5",
   "kr": "그럼!"
  },
  "27": {
   "jp": "6219893a",
   "kr": "괜히 7년이나 도둑질했겠어!"
  },
  "28": {
   "jp": "b176f66d",
   "kr": "뭐, 모리슨 씨."
  },
  "29": {
   "jp": "63e57c48",
   "kr": "편하게 가자고."
  },
  "30": {
   "jp": "0b49e671",
   "kr": "아차!"
  },
  "31": {
   "jp": "5b5d11d1",
   "kr": "제 발로 잡히러 갈 뻔했잖아."
  },
  "32": {
   "jp": "0fbdcf85",
   "kr": "이봐이봐!"
  },
  "33": {
   "jp": "7510ae31",
   "kr": "관문으로 돌아가면 잡힌다고!"
  },
  "34": {
   "jp": "ce957c42",
   "kr": "이쪽은 분명"
  },
  "35": {
   "jp": "5567c6d9",
   "kr": "챠놈으로 가는 관문이었지."
  },
  "36": {
   "jp": "88d626e0",
   "kr": "그럼 이쪽이 아니구나."
  }
 }
}