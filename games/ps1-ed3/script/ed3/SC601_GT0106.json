{
 "archive": "/SCE6/SC601.DAT",
 "member": "..\\DATA\\GT0106.BIN",
 "lines": {
  "0": {
   "jp": "17a61f4f",
   "kr": "바라카"
  },
  "1": {
   "jp": "6d2f5be5",
   "kr": "니모스"
  },
  "2": {
   "jp": "8b4f5e93",
   "kr": "타르사"
  },
  "3": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "4": {
   "jp": "e1afb7ee",
   "kr": "나제"
  },
  "5": {
   "jp": "02bc11e6",
   "kr": "이 마을에서 기드넬로 가려면"
  },
  "6": {
   "jp": "0aad9945",
   "kr": "길이 두 갈래 있어."
  },
  "7": {
   "jp": "4c33daf8",
   "kr": "하나는 북으로 빠져"
  },
  "8": {
   "jp": "d4eb2dbe",
   "kr": "유적을 지나가는 길."
  },
  "9": {
   "jp": "46e04405",
   "kr": "또 하나는 서쪽으로 빠져"
  },
  "10": {
   "jp": "17631f9d",
   "kr": "서쪽으로 돌아가는 길."
  },
  "11": {
   "jp": "ee28ee4b",
   "kr": "길은 둘 다 그게 그거야."
  },
  "12": {
   "jp": "21514f18",
   "kr": "북쪽 유적을 지나는 길은 헤맬지도 모르지만,"
  },
  "13": {
   "jp": "061cffc3",
   "kr": "마수는 적고"
  },
  "14": {
   "jp": "ae61e77e",
   "kr": "뭔가 보물이라도 찾아낼지도 몰라."
  },
  "15": {
   "jp": "1a140421",
   "kr": "서쪽 가도는 마수가 나올지도 모르지만"
  },
  "16": {
   "jp": "d16b6b1b",
   "kr": "길을 헤맬 일은 없어."
  },
  "17": {
   "jp": "924fd396",
   "kr": "어느 쪽을 권한다곤 말 못 해."
  },
  "18": {
   "jp": "53667bca",
   "kr": "칸다타가 여자애를 데리고"
  },
  "19": {
   "jp": "7dd33e40",
   "kr": "마을을 나가는 걸 봤어."
  },
  "20": {
   "jp": "e346220b",
   "kr": "분명 기드넬로 간 거야."
  },
  "21": {
   "jp": "612f6299",
   "kr": "응?"
  },
  "22": {
   "jp": "e9853e33",
   "kr": "너희들"
  },
  "23": {
   "jp": "d8155bce",
   "kr": "어디선가 본 기억이 있는 듯한데…"
  },
  "24": {
   "jp": "cd8d797a",
   "kr": "기분 탓이에요."
  },
  "25": {
   "jp": "3076156b",
   "kr": "그렇지. 기분 탓이겠지."
  },
  "26": {
   "jp": "825050e8",
   "kr": "조금 전에 투기장에서 빠져나간 놈들이 있어."
  },
  "27": {
   "jp": "735e6535",
   "kr": "만약 너희가 그놈들이라면,"
  },
  "28": {
   "jp": "d9007e05",
   "kr": "뻔뻔하게 돌아다닐 리 없겠지."
  },
  "29": {
   "jp": "23c5f890",
   "kr": "그건 그렇고, 너희들."
  },
  "30": {
   "jp": "fb517053",
   "kr": "여기서 도망친 두 명이랑"
  },
  "31": {
   "jp": "c9b5e175",
   "kr": "닮은 것 같단 말이지…"
  },
  "32": {
   "jp": "cd8d797a",
   "kr": "기분 탓이에요."
  },
  "33": {
   "jp": "3669e06c",
   "kr": "응, 그렇지."
  },
  "34": {
   "jp": "d79ee318",
   "kr": "칸다타 님의 명령으로"
  },
  "35": {
   "jp": "1a1d141a",
   "kr": "사막의 흑표범이 잡힐 때까지,"
  },
  "36": {
   "jp": "920a8a60",
   "kr": "여행자의 출입은 금지됐다."
  },
  "37": {
   "jp": "85a88534",
   "kr": "이 마을에 한동안 머물러 주어야겠다."
  },
  "38": {
   "jp": "0678d3b8",
   "kr": "신원 모를 여행자는 출입 금지다."
  },
  "39": {
   "jp": "1a1d141a",
   "kr": "사막의 흑표범이 잡힐 때까지"
  },
  "40": {
   "jp": "bb635569",
   "kr": "이 마을에 당분간 머물러라."
  },
  "41": {
   "jp": "add780f4",
   "kr": "저, 저기, 나제 씨."
  },
  "42": {
   "jp": "f8e1b393",
   "kr": "안녕하십니까."
  },
  "43": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "44": {
   "jp": "27b4469d",
   "kr": "무슨 볼일이죠?"
  },
  "45": {
   "jp": "88149875",
   "kr": "네."
  },
  "46": {
   "jp": "b5baa6d7",
   "kr": "친구들이 기드넬로 가고 싶은데,"
  },
  "47": {
   "jp": "1a1d141a",
   "kr": "사막의 흑표범이 잡힐 때까지"
  },
  "48": {
   "jp": "63fe1e86",
   "kr": "보내 줄 수 없다고 난처해하고 있어요."
  },
  "49": {
   "jp": "8c519f45",
   "kr": "칸다타 님의 명령이라죠?"
  },
  "50": {
   "jp": "47e58a59",
   "kr": "아무리 당신이라도"
  },
  "51": {
   "jp": "4e203572",
   "kr": "명령을 어길 순 없겠죠…"
  },
  "52": {
   "jp": "d50468a3",
   "kr": "나제는 난처한 표정을 지었다."
  },
  "53": {
   "jp": "426a3aea",
   "kr": "그, 그렇게"
  },
  "54": {
   "jp": "fce1e434",
   "kr": "나제 씨가 난처한 얼굴을 하면,"
  },
  "55": {
   "jp": "a4c2d0cb",
   "kr": "제가 다 슬퍼지는걸요…"
  },
  "56": {
   "jp": "0442067f",
   "kr": "기운 내세요."
  },
  "57": {
   "jp": "d2a57090",
   "kr": "뭐, 나그네 한둘 지나간다고"
  },
  "58": {
   "jp": "d0c76290",
   "kr": "상관없어요."
  },
  "59": {
   "jp": "2eda91b7",
   "kr": "자, 지나가세요."
  },
  "60": {
   "jp": "5c2257be",
   "kr": "어머, 정말."
  },
  "61": {
   "jp": "bd0b98b6",
   "kr": "당신 참 믿음직하네요…"
  },
  "62": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "63": {
   "jp": "5ded20a9",
   "kr": "아뇨아뇨, 하핫..하핫.."
  },
  "64": {
   "jp": "bd3b3ca5",
   "kr": "지나가게 해 주신대요."
  },
  "65": {
   "jp": "421e8730",
   "kr": "잘됐네요."
  },
  "66": {
   "jp": "2f552f81",
   "kr": "네. 고마워요, 나제 씨."
  },
  "67": {
   "jp": "baa18e35",
   "kr": "조심하세요."
  },
  "68": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "69": {
   "jp": "354b1ef7",
   "kr": "뭐 두고 갔나."
  },
  "70": {
   "jp": "878679cc",
   "kr": "아까 나간 줄 알았는데"
  },
  "71": {
   "jp": "9657a11c",
   "kr": "돌아온 건가?"
  },
  "72": {
   "jp": "bd2c375f",
   "kr": "나제 씨라면, 집에 돌아갔어."
  },
  "73": {
   "jp": "7620a94a",
   "kr": "헤헤… 내가 믿음직하다더라고."
  },
  "74": {
   "jp": "49e1304d",
   "kr": "됐어, 됐어."
  },
  "75": {
   "jp": "d2a5f93e",
   "kr": "얼마든지 지나가라고."
  },
  "76": {
   "jp": "dc01b164",
   "kr": "믿음직한 내가 허가한 거다."
  },
  "77": {
   "jp": "3b85cc92",
   "kr": "신경 쓰지 말고 지나가."
  }
 }
}