  "1": {
   "jp": "f0d648c4",
   "kr": "접수 아가씨 콜"
  },
  "2": {
   "jp": "faa7ffee",
   "kr": "가나"
  },
  "3": {
   "jp": "9bce56f7",
   "kr": "우돌 입국계원"
  },
  "4": {
   "jp": "c182c53c",
   "kr": "우돌 병사"
  },
  "5": {
   "jp": "21c898cc",
   "kr": "테스타"
  },
  "6": {
   "jp": "7edcbcdd",
   "kr": "킨바리"
  },
  "7": {
   "jp": "fa470da1",
   "kr": "리자"
  },
  "8": {
   "jp": "098c0e08",
   "kr": "우돌 국경　풍곡 관문"
  },
  "9": {
   "jp": "07b65577",
   "kr": "동쪽 삼도교 515미로"
  },
  "10": {
   "jp": "df541a7f",
   "kr": "다이스 368미로"
  },
  "11": {
   "jp": "4d6e5c1b",
   "kr": "우돌 입국이시군요."
  },
  "12": {
   "jp": "5f3488e4",
   "kr": "이 관문에서는 출입국자 서류를 작성합니다."
  },
  "13": {
   "jp": "3971dada",
   "kr": "사무실에서 서류 필요 사항을 기입하세요."
  },
  "14": {
   "jp": "bf31ddd9",
   "kr": "서류가 나올 때까지"
  },
  "15": {
   "jp": "c5d6a5dd",
   "kr": "통과는 허가되지 않으니"
  },
  "16": {
   "jp": "fda4121d",
   "kr": "주의해 주십시오."
  },
  "17": {
   "jp": "d117df1e",
   "kr": "통행 허가가 나왔군요."
  },
  "18": {
   "jp": "1b7bed70",
   "kr": "그거 잘됐네요."
  },
  "19": {
   "jp": "59395133",
   "kr": "이봐요."
  },
  "20": {
   "jp": "a365c767",
   "kr": "아직 너희 서류는"
  },
  "21": {
   "jp": "0fbf87b5",
   "kr": "안 나온 모양이네."
  },
  "22": {
   "jp": "1b769cbf",
   "kr": "대기실에서 기다려 줘."
  },
  "23": {
   "jp": "3fb20537",
   "kr": "우선 사무실에서 수속을 해 줘."
  },
  "24": {
   "jp": "06f31dfd",
   "kr": "안 그러면 통행 허가는 안 나와."
  },
  "25": {
   "jp": "52494cfe",
   "kr": "우돌은 입국 수속이 까다로워."
  },
  "26": {
   "jp": "daad7a1a",
   "kr": "귀찮겠지만 좀 참아 줘."
  },
  "27": {
   "jp": "414057b0",
   "kr": "저희 시플에 가고 싶은데요."
  },
  "28": {
   "jp": "c833c990",
   "kr": "그럼 사무실에서 서류를 기입해 주세요."
  },
  "29": {
   "jp": "4bc12b9f",
   "kr": "서류?"
  },
  "30": {
   "jp": "850b7e1f",
   "kr": "여기 관문은 까다롭네."
  },
  "31": {
   "jp": "91eda01e",
   "kr": "올도스가 가깝기 때문입니다."
  },
  "32": {
   "jp": "a7660891",
   "kr": "사무실은 세 군데 있으니"
  },
  "33": {
   "jp": "276e2ed3",
   "kr": "비어 있는 데서 하세요."
  },
  "34": {
   "jp": "ef923a0f",
   "kr": "수속은 끝나셨나요?"
  },
  "35": {
   "jp": "ccd66851",
   "kr": "그럼 안쪽 대기실에서 기다려 주세요."
  },
  "36": {
   "jp": "3619aebd",
   "kr": "통행 허가가 나왔군요."
  },
  "37": {
   "jp": "2137977b",
   "kr": "우돌에서의 여행이"
  },
  "38": {
   "jp": "a2b0369f",
   "kr": "좋은 추억이 되기를 바랍니다."
  },
  "39": {
   "jp": "b8814eb0",
   "kr": "앗, 미안해."
  },
  "40": {
   "jp": "7c1bf92c",
   "kr": "여기는 아직 서류 만드는 데"
  },
  "41": {
   "jp": "3db88467",
   "kr": "시간이 걸릴 것 같으니"
  },
  "42": {
   "jp": "815a2b2d",
   "kr": "다른 방에서 해 달라고 해 줘."
  },
  "43": {
   "jp": "0305fcb0",
   "kr": "하아〜"
  },
  "44": {
   "jp": "4659d1f7",
   "kr": "서류 더미에 파묻힐 것 같아."
  },
  "45": {
   "jp": "ad55760f",
   "kr": "아냐 아냐, 힘내야지!"
  },
  "46": {
   "jp": "a8d9f9ff",
   "kr": "미안하구나."
  },
  "47": {
   "jp": "fbcac6cb",
   "kr": "다른 사무실에 가 봐 주지 않겠나?"
  },
  "48": {
   "jp": "0f5a68af",
   "kr": "아직도 처리 못 한 서류가 잔뜩 있다네."
  },
  "49": {
   "jp": "432fbb67",
   "kr": "너희는 순례 여행자였구나."
  },
  "50": {
   "jp": "696c73a8",
   "kr": "보통은 수속에"
  },
  "51": {
   "jp": "af90eab7",
   "kr": "더 시간이 걸리거든."
  },
  "52": {
   "jp": "617bb5c5",
   "kr": "우돌 입국 수속은 여기서 하면 돼요?"
  },
  "53": {
   "jp": "99b09cd8",
   "kr": "그래, 괜찮다네."
  },
  "54": {
   "jp": "c9b4a0a9",
   "kr": "거기 서류에 주소와 입국 이유를"
  },
  "55": {
   "jp": "ce510e47",
   "kr": "써 주게."
  },
  "56": {
   "jp": "ddbf6264",
   "kr": "힘드시겠네요."
  },
  "57": {
   "jp": "dfab68aa",
   "kr": "저흰 순례 여행으로 올도스에"
  },
  "58": {
   "jp": "1e9e9ec5",
   "kr": "갈 뿐인데요."
  },
  "59": {
   "jp": "b283483a",
   "kr": "엇, 순례 여행?"
  },
  "60": {
   "jp": "bd9154b4",
   "kr": "어디서 왔니?"
  },
  "61": {
   "jp": "8e07c239",
   "kr": "폴티아의 라그픽 마을이에요."
  },
  "62": {
   "jp": "db44d6d6",
   "kr": "뭐야. 그런 거라면"
  },
  "63": {
   "jp": "be2c599d",
   "kr": "너희가 서류를 쓸 필요는 없어."
  },
  "64": {
   "jp": "5d8bf11a",
   "kr": "은단검을 갖고 있지?"
  },
  "65": {
   "jp": "e7b62ad0",
   "kr": "그걸 보여 주면"
  },
  "66": {
   "jp": "0478f418",
   "kr": "이쪽에서 서류를 만들어 줄게."
  },
  "67": {
   "jp": "25833de0",
   "kr": "물론 동행자도 오케이야."
  },
  "68": {
   "jp": "3ea03c6b",
   "kr": "과연 은단검의 효력은 대단하군요."
  },
  "69": {
   "jp": "84b2fa4e",
   "kr": "확실히 순례 여행자네."
  },
  "70": {
   "jp": "2aa454a2",
   "kr": "금방 끝나니까 대기실에서 기다리게."
  },
  "71": {
   "jp": "f2f565d3",
   "kr": "서류가 되는 대로 부르러 가겠네."
  },
  "72": {
   "jp": "9ae9a934",
   "kr": "부디 마수는 조심하십시오."
  },
  "73": {
   "jp": "bda42760",
   "kr": "좋은 여행 되기를!"
  },
  "74": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "75": {
   "jp": "e4ad8784",
   "kr": "미안해, 시간이 걸려서."
  },
  "76": {
   "jp": "fa30a5c1",
   "kr": "난 말이야, 금방 글자를 틀린다니까."
  },
  "77": {
   "jp": "092801cb",
   "kr": "앗!"
  },
  "78": {
   "jp": "b1b168fd",
   "kr": "틀렸다!"
  },
  "79": {
   "jp": "eb81ef17",
   "kr": "이야, 다이스에서 크게 벌었거든."
  },
  "80": {
   "jp": "b310ea90",
   "kr": "으히히히."
  },
  "81": {
   "jp": "08147b3b",
   "kr": "정말이지, 여기 올 때마다 짜증이 나."
  },
  "82": {
   "jp": "e3bc6a3e",
   "kr": "내 이름은 진저리 날 만큼"
  },
  "83": {
   "jp": "54c9286f",
   "kr": "길거든."
  },
  "84": {
   "jp": "cd068684",
   "kr": "내 이름 듣고 싶어?"
  },
  "85": {
   "jp": "fc651e9b",
   "kr": "좋아. 들려줄게"
  },
  "86": {
   "jp": "d826677e",
   "kr": "내 이름은 말이야, 리윗드-자-카인-"
  },
  "87": {
   "jp": "8ef6c901",
   "kr": "란캬스-엘리자베타-티아-"
  },
  "88": {
   "jp": "cc15510a",
   "kr": "칸나-포시즈라고 해."
  },
  "89": {
   "jp": "09f3e075",
   "kr": "…어디까지가"
  },
  "90": {
   "jp": "b602acf2",
   "kr": "이름인 걸까."
  },
  "91": {
   "jp": "369ec330",
   "kr": "현명하네."
  },
  "92": {
   "jp": "213516b0",
   "kr": "안 듣는 게 좋아."
  },
  "93": {
   "jp": "c02eb20f",
   "kr": "제 약혼자가요 이 관문에서 일해요."
  },
  "94": {
   "jp": "87796db6",
   "kr": "오늘은 그이를 위해 도시락을 만들어 왔어요."
  },
  "95": {
   "jp": "20416852",
   "kr": "와아, 멋지다."
  },
  "96": {
   "jp": "e30e2f8e",
   "kr": "약혼자는 누구예요?"
  },
  "97": {
   "jp": "a6f4a161",
   "kr": "후후. 비밀."
  },
  "98": {
   "jp": "092801cb",
   "kr": "앗!"
  },
  "99": {
   "jp": "54b42867",
   "kr": "저기 저기, 아가씨. 이름이 뭐야?"
  },
  "100": {
   "jp": "7fc4f0a5",
   "kr": "같이 차라도 안 할래?"
  },
  "101": {
   "jp": "4e42239a",
   "kr": "이제 어디 가는데?"
  },
  "102": {
   "jp": "ebeae7ba",
   "kr": "무, 무슨 일이세요."
  },
  "103": {
   "jp": "ba7c231e",
   "kr": "그렇게 한꺼번에 질문하셔도 저…"
  },
  "104": {
   "jp": "8d684276",
   "kr": "그럼, 이름은 뭐라고 하시나?"
  },
  "105": {
   "jp": "71842986",
   "kr": "가나인데요…"
  },
  "106": {
   "jp": "f61e2133",
   "kr": "가나 양인가. 달콤해 보이는 좋은 이름이야."
  },
  "107": {
   "jp": "6eb7dd3d",
   "kr": ""
  },
  "108": {
   "jp": "87dd9d14",
   "kr": "(구스야, 저거.)"
  },
  "109": {
   "jp": "eef4bcf5",
   "kr": "(여자애를 꾀는 모양이야.)"
  },
  "110": {
   "jp": "271c864f",
   "kr": "(샤라는 어떻게 된 걸까?)"
  },
  "111": {
   "jp": "ec7dd090",
   "kr": "(어설퍼서)"
  },
  "112": {
   "jp": "2c0ce35a",
   "kr": "(차인 거 아닐까.)"
  },
  "113": {
   "jp": "aacf8cfb",
   "kr": "(응, 분명 그렇겠지.)"
  },
  "114": {
   "jp": "c1d7e389",
   "kr": "에〜취!"
  },
  "115": {
   "jp": "7410b42c",
   "kr": "누가 내 흉을 보나 본데…"
  },
  "116": {
   "jp": "3b88fb52",
   "kr": "(어찌할까요?)"
  },
  "117": {
   "jp": "7cf44dad",
   "kr": "(미수로 끝났다고는 해도)"
  },
  "118": {
   "jp": "e096236a",
   "kr": "(성에 숨어든 도둑 한 명입니다.)"
  },
  "119": {
   "jp": "da0dfcdc",
   "kr": "(묶어서 병사에게 넘길까요?)"
  },
  "120": {
   "jp": "d5b80c32",
   "kr": "(됐어요, 불쌍하니까.)"
  },
  "121": {
   "jp": "f18de7c2",
   "kr": "(내버려 둬요.)"
  },
  "122": {
   "jp": "35726b40",
   "kr": "(그러네.)"
  },
  "123": {
   "jp": "af0dacc8",
   "kr": "(샤라한테 차인 모양이고)"
  },
  "124": {
   "jp": "3f22e4f9",
   "kr": "(이번만은 너그럽게 봐줍시다.)"
  },
  "125": {
   "jp": "14c888c2",
   "kr": "(저 여자한테도 분명 차일 거예요.)"
  },
  "126": {
   "jp": "73322816",
   "kr": "(그렇네.)"
  },
  "127": {
   "jp": "977aed02",
   "kr": "비켜 주세요!"
  },
  "128": {
   "jp": "f6147366",
   "kr": "안녕히!"
  },
  "129": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "130": {
   "jp": "74b9ca0d",
   "kr": "흥, 뭐야."
  },
  "131": {
   "jp": "e5154de4",
   "kr": "메롱이다."
  },
  "132": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "133": {
   "jp": "d8672d8d",
   "kr": "후후후후후후."
  },
  "134": {
   "jp": "c7df006a",
   "kr": "후후후후후후후후후후."
  },
  "135": {
   "jp": "47f74d83",
   "kr": "차였네."
  },
  "136": {
   "jp": "2b8dc49a",
   "kr": "너, 너희…"
  },
  "137": {
   "jp": "9f3cdfd2",
   "kr": "보고 있었냐?"
  },
  "138": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "139": {
   "jp": "b1599d3c",
   "kr": "똑똑히 보고 있었어."
  },
  "140": {
   "jp": "37f1542a",
   "kr": "크윽, 나답지 않게."
  },
  "141": {
   "jp": "04749bde",
   "kr": "꼴사납다아."
  },
  "142": {
   "jp": "3264666a",
   "kr": "안 되겠다."
  },
  "143": {
   "jp": "ae67e2cf",
   "kr": "이럴 때가 아니라고."
  },
  "144": {
   "jp": "132afe70",
   "kr": "잘 있어라!!"
  },
  "145": {
   "jp": "ad1238bb",
   "kr": "이야, 오래 기다리셨습니다."
  },
  "146": {
   "jp": "f95858e3",
   "kr": "여러분 서류가 다 되었습니다."
  },
  "147": {
   "jp": "35ff4caa",
   "kr": "서쪽 문지기에게 은단검을 보이면"
  },
  "148": {
   "jp": "835c6987",
   "kr": "통과시켜 주도록 말해 두었습니다."
  },
  "149": {
   "jp": "7cf0f9e5",
   "kr": "그럼, 조심하십시오."
  },
  "150": {
   "jp": "34bba07a",
   "kr": "좋은 여행 되기를."
  },
  "151": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "152": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "153": {
   "jp": "a430ebd0",
   "kr": "그런 말 말고"
  },
  "154": {
   "jp": "0cff5152",
   "kr": "좀 지나가게 해 줘."
  },
  "155": {
   "jp": "dc33d810",
   "kr": "서류를 작성하지 않은 자를"
  },
  "156": {
   "jp": "8c97c149",
   "kr": "통과시킬 수는 없다."
  },
  "157": {
   "jp": "60640f64",
   "kr": "먼저 간 일행이"
  },
  "158": {
   "jp": "33ca5d8b",
   "kr": "통행증을 갖고 가 버려서"
  },
  "159": {
   "jp": "dc96d899",
   "kr": "서류 따위 못 만든다고!"
  },
  "160": {
   "jp": "2d60092d",
   "kr": "그럼 못 보낸다."
  },
  "161": {
   "jp": "1fdf6d05",
   "kr": "꽉 막힌 놈이군."
  },
  "162": {
   "jp": "4a8fa9f4",
   "kr": "저기."
  },
  "163": {
   "jp": "b4dbae07",
   "kr": "아, 시끄러워."
  },
  "164": {
   "jp": "2d5107eb",
   "kr": "저기라니까."
  },
  "165": {
   "jp": "284a0f4c",
   "kr": "시끄러워!"
  },
  "166": {
   "jp": "994a90c2",
   "kr": "…또 너희냐."
  },
  "167": {
   "jp": "b4e8b986",
   "kr": "구스가 언제까지고"
  },
  "168": {
   "jp": "9657c3dc",
   "kr": "어슬렁거리고 있으니까 안 되는 거야."
  },
  "169": {
   "jp": "4e704fea",
   "kr": "이런, 동행자인가?"
  },
  "170": {
   "jp": "815c13a7",
   "kr": "흥, 이런 젖비린내 나는 애들과"
  },
  "171": {
   "jp": "26de1902",
   "kr": "한데 묶지 마!"
  },
  "172": {
   "jp": "91e7e341",
   "kr": "뭐야"
  },
  "173": {
   "jp": "8409ff95",
   "kr": "동행자라면 이 애들 서류로"
  },
  "174": {
   "jp": "75722fd6",
   "kr": "여기를 지날 수 있었을 텐데."
  },
  "175": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "176": {
   "jp": "9b25e8e4",
   "kr": "그런 거야?"
  },
  "177": {
   "jp": "64264f99",
   "kr": "뭐야, 너희들."
  },
  "178": {
   "jp": "5443e2ff",
   "kr": "기다렸다고."
  },
  "179": {
   "jp": "efc5d4ff",
   "kr": "자, 얼른 가자고!"
  },
  "180": {
   "jp": "d34244d3",
   "kr": "구스가 파티에 합류했다."
  },
  "181": {
   "jp": "a93b7573",
   "kr": "정말! 막무가내라니까."
  },
  "182": {
   "jp": "9c35d098",
   "kr": "(부탁이다. 제발.)"
  },
  "183": {
   "jp": "93468b76",
   "kr": "(샤라한테 버림받아 관문도 못 지나겠어.)"
  },
  "184": {
   "jp": "b5427467",
   "kr": "(이래서야, 거참… 그…)"
  },
  "185": {
   "jp": "2d309577",
   "kr": "(샤라를 뒤쫓는 것도 못 하겠다고.)"
  },
  "186": {
   "jp": "49481c48",
   "kr": "어쩌지, 크리스?"
  },
  "187": {
   "jp": "673a432a",
   "kr": "어쩔 수 없네."
  },
  "188": {
   "jp": "d2c2efee",
   "kr": "병사님, 여기요."
  },
  "189": {
   "jp": "39852d0e",
   "kr": "아아, 너희가 순례 여행자로군."
  },
  "190": {
   "jp": "0ecd5726",
   "kr": "사서관한테 이야기는 들었다."
  },
  "191": {
   "jp": "0ea3fbb8",
   "kr": "그보다도 이 남자를 동행인으로"
  },
  "192": {
   "jp": "684c465c",
   "kr": "인정하는 건가?"
  },
  "193": {
   "jp": "e386ab24",
   "kr": "네, 할 수 없죠."
  },
  "194": {
   "jp": "de4efdf3",
   "kr": "그치만 두고 가면"
  },
  "195": {
   "jp": "ba21beb4",
   "kr": "구스가 울어 버릴 거예요."
  },
  "196": {
   "jp": "95928c84",
   "kr": "그래 그래, 맘대로 말해라."
  },
  "197": {
   "jp": "6e66ca47",
   "kr": "그럼, 여러분 4명의"
  },
  "198": {
   "jp": "456f6826",
   "kr": "통행을 허가합니다."
  },
  "199": {
   "jp": "8d014cad",
   "kr": "조심해서 가십시오!"
  },
  "200": {
   "jp": "396422e3",
   "kr": "정말이지, 되는 일이 없네."
  },
  "201": {
   "jp": "2fd5d1d4",
   "kr": "가나 양한테는 차이지"
  },
  "202": {
   "jp": "a2020c64",
   "kr": "이런 꼬맹이들이랑"
  },
  "203": {
   "jp": "2ee98f14",
   "kr": "여행하는 신세가 되다니 참."
  },
  "204": {
   "jp": "943488ce",
   "kr": "잠깐 서라!"
  },
  "205": {
   "jp": "d4dd29cf",
   "kr": "네놈이구나!?"
  },
  "206": {
   "jp": "af852f7e",
   "kr": "내 약혼자를 쫓아다닌 놈이!"
  },
  "207": {
   "jp": "76a1bf29",
   "kr": "모처럼 도시락을 갖다 줬는데"
  },
  "208": {
   "jp": "27bab051",
   "kr": "이상한 남자가 말을 걸었다며"
  },
  "209": {
   "jp": "4f98b275",
   "kr": "울면서 돌아가 버렸단 말이다!"
  },
  "210": {
   "jp": "d4d34723",
   "kr": "이크!"
  },
  "211": {
   "jp": "bdd235e7",
   "kr": "왜 우리까지"
  },
  "212": {
   "jp": "0fcffbe6",
   "kr": "도망쳐야 하는 건데!"
  },
  "213": {
   "jp": "7d19d9f1",
   "kr": "딱딱하게 굴지 말라고!"
  },
  "214": {
   "jp": "aee1b964",
   "kr": "서라〜!"
  },
  "215": {
   "jp": "64ccd39a",
   "kr": "안데라에서 알프레드의 환대를 받으며"
  },
  "216": {
   "jp": "bc5c2e3a",
   "kr": "쥬리오 일행은 즐거운 한때를 보냈다."
  },
  "217": {
   "jp": "5b0c7a75",
   "kr": "로디도 순조롭게 회복해 가고"
  },
  "218": {
   "jp": "25d8b43a",
   "kr": "안심하고 순례를 이어 갈 수 있게 됐다."
  },
  "219": {
   "jp": "a0c224c5",
   "kr": "하지만 쥬리오 일행은 중대한 걸 잊었다."
  },
  "220": {
   "jp": "f105d1e4",
   "kr": "가루가를 조종하던 자의 존재를…"
  },
  "221": {
   "jp": "a4c590e1",
   "kr": "새로운 재앙의 소용돌이는 쥬리오 일행을"
  },
  "222": {
   "jp": "5a6f556e",
   "kr": "중심으로 이미 움직이기 시작했던 것이다."
  },
  "223": {
   "jp": "43999f27",
   "kr": "제３장　삼도교의 환영　끝"
  }
 }
}