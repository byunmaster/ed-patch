  "3": {
   "jp": "2ead0805",
   "kr": "무기상 바이스"
  },
  "4": {
   "jp": "e42c53a1",
   "kr": "셰라"
  },
  "5": {
   "jp": "ae3acf17",
   "kr": "기무레 노인"
  },
  "6": {
   "jp": "b89f241a",
   "kr": "어부 페스카"
  },
  "7": {
   "jp": "5b955126",
   "kr": "피아라"
  },
  "8": {
   "jp": "5097989c",
   "kr": "챠펠의 모라토"
  },
  "9": {
   "jp": "82bd0651",
   "kr": "이자들을 어찌할까."
  },
  "10": {
   "jp": "e15854ca",
   "kr": "정말이지, 이 바쁜 때에."
  },
  "11": {
   "jp": "41f18c65",
   "kr": "누명이에요〜"
  },
  "12": {
   "jp": "51a7b4f4",
   "kr": "시끄럽다!"
  },
  "13": {
   "jp": "9ac9f95f",
   "kr": "일단 본부로 연행하자."
  },
  "14": {
   "jp": "f36b878b",
   "kr": "가루가 요격 준비는 모두 갖추었습니다."
  },
  "15": {
   "jp": "d5f464ca",
   "kr": "이제 하늘에 운을 맡길 뿐."
  },
  "16": {
   "jp": "5b902431",
   "kr": "음. 넬바에서 온 횃불도 때맞춰 왔네."
  },
  "17": {
   "jp": "3529e117",
   "kr": "할 수 있는 건 모두 했지."
  },
  "18": {
   "jp": "0fb6f61c",
   "kr": "어떻게든 가루가를 여기서 막고 싶군."
  },
  "19": {
   "jp": "a1dde4c3",
   "kr": "알프 씨!"
  },
  "20": {
   "jp": "6cdb3fdd",
   "kr": "이, 이놈!"
  },
  "21": {
   "jp": "fc00a75e",
   "kr": "무례하지 않느냐!!"
  },
  "22": {
   "jp": "60158578",
   "kr": "역시 오고 말았는가…"
  },
  "23": {
   "jp": "35a4b2c3",
   "kr": "너무해."
  },
  "24": {
   "jp": "6d623849",
   "kr": "우리를 두고 가 버리다니!"
  },
  "25": {
   "jp": "587ca49d",
   "kr": "맞아."
  },
  "26": {
   "jp": "a5e6f452",
   "kr": "아무리 당신이"
  },
  "27": {
   "jp": "9bcc91aa",
   "kr": "앰비쉬의 높으신 분이라 해도"
  },
  "28": {
   "jp": "997d49bf",
   "kr": "그건 아니지."
  },
  "29": {
   "jp": "e1e2f939",
   "kr": "알프레드 왕."
  },
  "30": {
   "jp": "428fd974",
   "kr": "이자들은 분명… 폐하께서 튜엘까지"
  },
  "31": {
   "jp": "b7325764",
   "kr": "함께 여행하신 이들이 아닙니까."
  },
  "32": {
   "jp": "7a974da7",
   "kr": "알프레드 왕?"
  },
  "33": {
   "jp": "dfd995b6",
   "kr": "폐하?"
  },
  "34": {
   "jp": "529baab1",
   "kr": "설마"
  },
  "35": {
   "jp": "994285e9",
   "kr": "…임금님?"
  },
  "36": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "37": {
   "jp": "e1aa41d1",
   "kr": "실례했습니다."
  },
  "38": {
   "jp": "0f2d6ec0",
   "kr": "사과할 필요 없어."
  },
  "39": {
   "jp": "13fc80aa",
   "kr": "무례한 건 그쪽이니까."
  },
  "40": {
   "jp": "e630a042",
   "kr": "어째서 우리가 붙잡혀야 하는 건데!"
  },
  "41": {
   "jp": "26343347",
   "kr": "이 자들이 왕가의 문장이 새겨진 반지를"
  },
  "42": {
   "jp": "32a0f0da",
   "kr": "지니고 있었기 때문입니다."
  },
  "43": {
   "jp": "26e4e79c",
   "kr": "병사는 알프에게 반지를 줬다."
  },
  "44": {
   "jp": "ac3637c2",
   "kr": "이건 내가 답례의 뜻으로"
  },
  "45": {
   "jp": "f733a07a",
   "kr": "두고 간 것일세."
  },
  "46": {
   "jp": "fc060c17",
   "kr": "왕가의 문장이 새겨진 반지를"
  },
  "47": {
   "jp": "af32e394",
   "kr": "이런 자들이 갖고 있는 것이"
  },
  "48": {
   "jp": "9632387d",
   "kr": "수상하다 여겼습니다."
  },
  "49": {
   "jp": "b429c21c",
   "kr": "배가 고파 움직이지도 못하던 사람을"
  },
  "50": {
   "jp": "08af1284",
   "kr": "친절하게 간호해 준 게 누구라고 생각해요."
  },
  "51": {
   "jp": "f8ee9d88",
   "kr": "저희가 있었기에"
  },
  "52": {
   "jp": "e22dc0dd",
   "kr": "소중한 임금님이"
  },
  "53": {
   "jp": "6507851f",
   "kr": "지금 이렇게 무사한 거예요."
  },
  "54": {
   "jp": "a90e71f1",
   "kr": "이게 생명의 은인에 대한 예의예요?"
  },
  "55": {
   "jp": "3898f8c1",
   "kr": "맞아요, 맞아요."
  },
  "56": {
   "jp": "090ace5d",
   "kr": "이자들이 하는 말이"
  },
  "57": {
   "jp": "c24a2278",
   "kr": "사실인지요?"
  },
  "58": {
   "jp": "d0aa6ce4",
   "kr": "음. 정말, 정말일세."
  },
  "59": {
   "jp": "e543a8cd",
   "kr": "여긴 됐으니 맡은 자리로 돌아가게."
  },
  "60": {
   "jp": "4abd11a6",
   "kr": "옛!"
  },
  "61": {
   "jp": "27bba5ca",
   "kr": "아니, 미안하네."
  },
  "62": {
   "jp": "d84877e3",
   "kr": "반지는 답례 뜻도 있었네만"
  },
  "63": {
   "jp": "3bbc2b9e",
   "kr": "이걸 너희가 지니고 있으면"
  },
  "64": {
   "jp": "8b61def2",
   "kr": "다시 만날 수 있을지 모른다고 생각한 걸세."
  },
  "65": {
   "jp": "28155f11",
   "kr": "그대로 헤어지는 건 마음에 남아서 말일세."
  },
  "66": {
   "jp": "5a5405d6",
   "kr": "넬바 왕에게 얼굴이 통하니"
  },
  "67": {
   "jp": "850b9344",
   "kr": "높은 놈, 아니 높은 분일 줄은 짐작했지만."
  },
  "68": {
   "jp": "98938b69",
   "kr": "설마 앰비쉬의 임금님이었다니."
  },
  "69": {
   "jp": "560c9c9b",
   "kr": "아니, 정말 미안하네."
  },
  "70": {
   "jp": "aadd1094",
   "kr": "나도 게르드의 예언이 마음에 걸려서 말일세."
  },
  "71": {
   "jp": "a1b7edb5",
   "kr": "남몰래 넬바를 조사하고 있었다네."
  },
  "72": {
   "jp": "07010191",
   "kr": "조금만 더 일찍 가루가 출현을 확증했다면"
  },
  "73": {
   "jp": "3bdf16e0",
   "kr": "넬바의 노르딕 왕에게 진언해"
  },
  "74": {
   "jp": "1f182712",
   "kr": "요격 준비를 갖추게 할 수도 있었을 텐데."
  },
  "75": {
   "jp": "fd6f05d7",
   "kr": "내가 넬바에 닿자마자 가루가가 나타나"
  },
  "76": {
   "jp": "ba23b8aa",
   "kr": "모리슨과도 떨어지고 잘못 들어 치타에"
  },
  "77": {
   "jp": "04cc751f",
   "kr": "간 참에 너희를 만난 셈일세."
  },
  "78": {
   "jp": "36ee284b",
   "kr": "흐음, 그랬던 거구나."
  },
  "79": {
   "jp": "7b0ae284",
   "kr": "어쨌든 이 반지는 너희들에게 준 물건일세."
  },
  "80": {
   "jp": "48bff6f6",
   "kr": "나의 감사와 우정의 표시라네."
  },
  "81": {
   "jp": "9327df79",
   "kr": "새로이 받아 주게나."
  },
  "82": {
   "jp": "081939fe",
   "kr": "쥬리오 일행은 알프에게서 반지를 받았다."
  },
  "83": {
   "jp": "4de82551",
   "kr": "고마워, 임금님."
  },
  "84": {
   "jp": "9ba80c63",
   "kr": "소중히 할게."
  },
  "85": {
   "jp": "83b2dc29",
   "kr": "임금님, 고마워."
  },
  "86": {
   "jp": "ece29ea9",
   "kr": "임금님이라니, 그만두게."
  },
  "87": {
   "jp": "09b800b9",
   "kr": "너희들이 그리 부르면 영 어색해져 버리네."
  },
  "88": {
   "jp": "68c56ec7",
   "kr": "지금까지처럼 알프면 되네."
  },
  "89": {
   "jp": "8d20ccb0",
   "kr": "그럴 순 없지요."
  },
  "90": {
   "jp": "a126c574",
   "kr": "그래서 알프"
  },
  "91": {
   "jp": "cb4ca1bc",
   "kr": "가루가의 현재 위치는?"
  },
  "92": {
   "jp": "1e1a547e",
   "kr": "상황은 변함없어?"
  },
  "93": {
   "jp": "6f5e1759",
   "kr": "허걱!"
  },
  "94": {
   "jp": "6a367a20",
   "kr": "오늘 아침 보고론 아직 로프섬에 있네."
  },
  "95": {
   "jp": "0af0ebf3",
   "kr": "허나 슬슬 깨어나도 좋을 때지."
  },
  "96": {
   "jp": "4681ac1b",
   "kr": "언제 바다를 건너온다 해도 이상할 게 없지."
  },
  "97": {
   "jp": "47e47bda",
   "kr": "가루가를 맞받아칠 준비는 돼 있어?"
  },
  "98": {
   "jp": "d8c41a7a",
   "kr": "할 수 있는 건 다 했네."
  },
  "99": {
   "jp": "0f7dd9cb",
   "kr": "그런데"
  },
  "100": {
   "jp": "00e890d9",
   "kr": "너희에겐 모처럼 와 줘서 미안하네만"
  },
  "101": {
   "jp": "a2c12be2",
   "kr": "나머지는 앰비쉬군이 맡겠네."
  },
  "102": {
   "jp": "0be425cf",
   "kr": "너희는 순례 여행을 계속하게나."
  },
  "103": {
   "jp": "d32b4035",
   "kr": "알겠지?"
  },
  "104": {
   "jp": "7fd20db6",
   "kr": "아아. 그 일 말인데, 나도\n임금님 의견에 찬성이다."
  },
  "105": {
   "jp": "d3b4ed89",
   "kr": "미안하지만 쥬리오와 크리스가"
  },
  "106": {
   "jp": "df3c6cb2",
   "kr": "가루가 퇴치에 협력해 준다고 해도"
  },
  "107": {
   "jp": "8a6cb15b",
   "kr": "상대가 상대다."
  },
  "108": {
   "jp": "c4007edf",
   "kr": "위험이 따르기도 하고."
  },
  "109": {
   "jp": "0e76a4bd",
   "kr": "솔직히 말해 짐만 될 뿐이다."
  },
  "110": {
   "jp": "36e58ee4",
   "kr": "그런〜"
  },
  "111": {
   "jp": "8b9b8383",
   "kr": "가루가는 내게 맡겨."
  },
  "112": {
   "jp": "d3533c5d",
   "kr": "내가 꼭 쓰러뜨려 주마."
  },
  "113": {
   "jp": "3594021d",
   "kr": "로디…"
  },
  "114": {
   "jp": "64c99a4a",
   "kr": "사실 자네도 위험한 일은 겪게 하기 싫었네."
  },
  "115": {
   "jp": "9b4e2aa9",
   "kr": "허나 여기까지 온 자네를 말릴 수는 없지."
  },
  "116": {
   "jp": "49481c48",
   "kr": "어쩌지, 크리스?"
  },
  "117": {
   "jp": "3b652146",
   "kr": "알프와 로디의 마음도 잘 알겠지만"
  },
  "118": {
   "jp": "02093095",
   "kr": "우리한테도"
  },
  "119": {
   "jp": "9041f703",
   "kr": "뭔가 할 수 있는 일이 있을지도 몰라."
  },
  "120": {
   "jp": "9e8f72b3",
   "kr": "응, 맞아."
  },
  "121": {
   "jp": "a7ece4b4",
   "kr": "이대로 볼트를 지나쳐 이그니스로"
  },
  "122": {
   "jp": "212ec89a",
   "kr": "가는 것도 왠지 마음에 걸리고."
  },
  "123": {
   "jp": "cfc579ac",
   "kr": "있지, 알프."
  },
  "124": {
   "jp": "90737540",
   "kr": "그럼, 이렇게 하자."
  },
  "125": {
   "jp": "8233e19f",
   "kr": "어, 어떻게?"
  },
  "126": {
   "jp": "667bc0e8",
   "kr": "우리는 싸움에는 안 나설게."
  },
  "127": {
   "jp": "11ad03ff",
   "kr": "가루가가 오면 안전한 곳에 숨어 있을게."
  },
  "128": {
   "jp": "d2c3393b",
   "kr": "그러면 되잖아."
  },
  "129": {
   "jp": "919f9dc1",
   "kr": "그때까지는"
  },
  "130": {
   "jp": "08f9d706",
   "kr": "우리가 할 수 있는 일을 돕게 해 줘."
  },
  "131": {
   "jp": "f0704f68",
   "kr": "응, 그거면 되지?"
  },
  "132": {
   "jp": "5e935eeb",
   "kr": "괜찮지 않냐고 해도…"
  },
  "133": {
   "jp": "6b7f8600",
   "kr": "그래도 위험한 일이"
  },
  "134": {
   "jp": "520484c6",
   "kr": "있을지도 모르고…"
  },
  "135": {
   "jp": "8d848468",
   "kr": "그래?"
  },
  "136": {
   "jp": "bf590a38",
   "kr": "생명의 은인 부탁을 못 들어주겠단 거야?"
  },
  "137": {
   "jp": "ccfb96ba",
   "kr": "허나 말일세…"
  },
  "138": {
   "jp": "884a9bf8",
   "kr": "으으으음."
  },
  "139": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "140": {
   "jp": "355f17e8",
   "kr": "…움찔."
  },
  "141": {
   "jp": "8ae4f6b3",
   "kr": "알았네. 알았어."
  },
  "142": {
   "jp": "8d1d930e",
   "kr": "눈싸움으론"
  },
  "143": {
   "jp": "ec3f3fa7",
   "kr": "크리스를 못 당하지."
  },
  "144": {
   "jp": "0a7d8378",
   "kr": "알겠나?"
  },
  "145": {
   "jp": "e2caf072",
   "kr": "쥬리오와 크리스는 전투에는"
  },
  "146": {
   "jp": "2d533f67",
   "kr": "일절 안 나서는 게 조건일세."
  },
  "147": {
   "jp": "a0820762",
   "kr": "약속 지키겠지?"
  },
  "148": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "149": {
   "jp": "035ddc4f",
   "kr": "괜찮으시겠습니까?"
  },
  "150": {
   "jp": "bedd6ec0",
   "kr": "뭐, 와 버린 것이니 어쩔 수 없지."
  },
  "151": {
   "jp": "42b3faec",
   "kr": "내 천막은 맨 동쪽에 있다."
  },
  "152": {
   "jp": "c86dc630",
   "kr": "너희가 묵을 곳을 마련해 둘 테니"
  },
  "153": {
   "jp": "32bec239",
   "kr": "나중에 들러 주게."
  },
  "154": {
   "jp": "32e8e472",
   "kr": "아직 조금 가루가 요격에 관해"
  },
  "155": {
   "jp": "0fb86cfa",
   "kr": "모리슨과 의논하고 싶은 게 있어서 말이네."
  },
  "156": {
   "jp": "c8f1c7b2",
   "kr": "나중에 천막에서 만나세."
  },
  "157": {
   "jp": "22e74382",
   "kr": "마을 안은 자유로이 다니십시오."
  },
  "158": {
   "jp": "eef79c32",
   "kr": "다만 병사들을 방해하지는 마십시오."
  },
  "159": {
   "jp": "890705ee",
   "kr": "실수로 나그네가 볼트에 들어오지 않게"
  },
