{
 "archive": "/SCE6/SC606.DAT",
 "member": "..\\DATA\\GT3102.BIN",
 "lines": {
  "0": {
   "jp": "26fb5f27",
   "kr": "딜트 관문"
  },
  "1": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "2": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "3": {
   "jp": "afc8033c",
   "kr": "자, 앉게나."
  },
  "4": {
   "jp": "f39b7838",
   "kr": "허크 삼촌."
  },
  "5": {
   "jp": "b5783d97",
   "kr": "그렇게 말해도"
  },
  "6": {
   "jp": "f2bf7060",
   "kr": "의자는 아저씨 쪽에만 있잖아요."
  },
  "7": {
   "jp": "8fe3cec7",
   "kr": "오, 그랬던가."
  },
  "8": {
   "jp": "45d72f00",
   "kr": "이거 미안하군."
  },
  "9": {
   "jp": "8ac26858",
   "kr": "혼자 산 지 오래된 터라 말이지."
  },
  "10": {
   "jp": "1143a3cd",
   "kr": "자, 신경 쓰지 말고 앉게나."
  },
  "11": {
   "jp": "c160ced0",
   "kr": "분명히"
  },
  "12": {
   "jp": "d6907ce2",
   "kr": "어딘가 이상해…"
  },
  "13": {
   "jp": "dbd65a59",
   "kr": "일단 쥬리오 일행은 테이블을 둘러싸고"
  },
  "14": {
   "jp": "9dc6ec93",
   "kr": "허크가 왜 여기 붙잡혀 있었는지"
  },
  "15": {
   "jp": "942864b2",
   "kr": "물어보기로 했다."
  },
  "16": {
   "jp": "f39b7838",
   "kr": "허크 삼촌."
  },
  "17": {
   "jp": "9e90d7b3",
   "kr": "어째서 여기 잡혀 있는 거야?"
  },
  "18": {
   "jp": "57e9211a",
   "kr": "딱히 나쁜 짓을 한 건 아니야."
  },
  "19": {
   "jp": "5ab6020d",
   "kr": "이번에도 이른바"
  },
  "20": {
   "jp": "a978e7e3",
   "kr": "피할 수 없는 운명의 장난이라고나"
  },
  "21": {
   "jp": "66d179cb",
   "kr": "할 만한 거란다."
  },
  "22": {
   "jp": "f60ea2a4",
   "kr": "그건 그래,"
  },
  "23": {
   "jp": "c92e88ec",
   "kr": "마른 잎 흩날리는 메나트에서의 일이었지."
  },
  "24": {
   "jp": "8a281b17",
   "kr": "삼촌."
  },
  "25": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "26": {
   "jp": "e226fab8",
   "kr": "그게 잡힌 이유랑 직접 관계가 있어?"
  },
  "27": {
   "jp": "2b822fd0",
   "kr": "아니, 없어."
  },
  "28": {
   "jp": "73fb5d32",
   "kr": "그럴 줄 알았어."
  },
  "29": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "30": {
   "jp": "982a7cd3",
   "kr": "한동안 안 본 사이에"
  },
  "31": {
   "jp": "43e544c5",
   "kr": "추궁이 날카로워졌구나."
  },
  "32": {
   "jp": "5a36b609",
   "kr": "그, 그런가…"
  },
  "33": {
   "jp": "289430cb",
   "kr": "그래서"
  },
  "34": {
   "jp": "9dd837a2",
   "kr": "허크 아저씨가 여기 있는 건"
  },
  "35": {
   "jp": "c5221e5b",
   "kr": "왜예요?"
  },
  "36": {
   "jp": "ef34b90d",
   "kr": "아아,"
  },
  "37": {
   "jp": "a0f104b7",
   "kr": "메나트에 매발톱호가 도착해서"
  },
  "38": {
   "jp": "647154a8",
   "kr": "너희와 헤어지고 나서지."
  },
  "39": {
   "jp": "bea1671d",
   "kr": "곧장 가도를 걷기 시작했는데"
  },
  "40": {
   "jp": "b6cff8d1",
   "kr": "문득 두고 온 물건이 생각나서 말일세."
  },
  "41": {
   "jp": "acc4d8e5",
   "kr": "뭘 두고?"
  },
  "42": {
   "jp": "02839b1c",
   "kr": "내가 하얀마녀에 대해"
  },
  "43": {
   "jp": "d8707130",
   "kr": "지금껏 조사한 것을 적어 둔 수첩이야."
  },
  "44": {
   "jp": "aab9d316",
   "kr": "수첩이 없으면"
  },
  "45": {
   "jp": "caed58b4",
   "kr": "애써 한 조사도 진척이 없으니까."
  },
  "46": {
   "jp": "f9e090ea",
   "kr": "하는 수 없이 닐리로 되돌아가"
  },
  "47": {
   "jp": "a64deac3",
   "kr": "또 매발톱호에 공짜로 태워 달라고 해서"
  },
  "48": {
   "jp": "06970fdb",
   "kr": "라그나로 돌아갔단다."
  },
  "49": {
   "jp": "fae9345b",
   "kr": "삼촌"
  },
  "50": {
   "jp": "4c7d788f",
   "kr": "가끔은 돈 좀 내지 그래."
  },
  "51": {
   "jp": "092f4843",
   "kr": "뭐, 괜찮잖아."
  },
  "52": {
   "jp": "2d87fa5b",
   "kr": "모처럼 질버 선장이 베풀어 준 호의니까."
  },
  "53": {
   "jp": "8b09a22d",
   "kr": "그렇게 거기까진 순조로웠는데"
  },
  "54": {
   "jp": "ef84c22e",
   "kr": "집에 돌아간 참에"
  },
  "55": {
   "jp": "6a64bdc2",
   "kr": "빚쟁이한테 들켜 버렸지 뭔가."
  },
  "56": {
   "jp": "6aa8a773",
   "kr": "조금 도망 다니는 사이에"
  },
  "57": {
   "jp": "1a20c081",
   "kr": "올해 마지막 정기선이 떠나 버렸지."
  },
  "58": {
   "jp": "8747c3d8",
   "kr": "정기선엔 피도 눈물도 없었다네."
  },
  "59": {
   "jp": "b58c9af0",
   "kr": "이제 유빙의 계절이니까."
  },
  "60": {
   "jp": "ff580c00",
   "kr": "그래서 동쪽 길 여행을 포기하고"
  },
  "61": {
   "jp": "719a87a5",
   "kr": "루데라 관문에서 왕도 가도를 지나"
  },
  "62": {
   "jp": "c04d5115",
   "kr": "서쪽 길 여행으로 바꿨다는 거지."
  },
  "63": {
   "jp": "69d34538",
   "kr": "허크 삼촌이"
  },
  "64": {
   "jp": "e6c5de4c",
   "kr": "서쪽 길로 여행해 온 건"
  },
  "65": {
   "jp": "20e29dc2",
   "kr": "알겠는데…"
  },
  "66": {
   "jp": "9e52df7d",
   "kr": "어째서 잡혀 있는 거야?"
  },
  "67": {
   "jp": "99c01386",
   "kr": "잡혔다고?"
  },
  "68": {
   "jp": "fffbbcda",
   "kr": "아니, 아니"
  },
  "69": {
   "jp": "8b9ebd43",
   "kr": "그리 보일지도 모르겠지만"
  },
  "70": {
   "jp": "f5a0be84",
   "kr": "이건 작전이라네."
  },
  "71": {
   "jp": "da793450",
   "kr": "작전?"
  },
  "72": {
   "jp": "25f9fb9b",
   "kr": "삼촌은 말이지,"
  },
  "73": {
   "jp": "2fc1ebe1",
   "kr": "여기서 크리스와 쥬리오 군을"
  },
  "74": {
   "jp": "38707644",
   "kr": "기다리고 있었어."
  },
  "75": {
   "jp": "266f2f10",
   "kr": "우리를?"
  },
  "76": {
   "jp": "87634187",
   "kr": "그래."
  },
  "77": {
   "jp": "9153a08b",
   "kr": "여기선 반드시 지나가니 엇갈릴 일은 없지."
  },
  "78": {
   "jp": "100b9ed9",
   "kr": "게다가 숙박비도 공짜고"
  },
  "79": {
   "jp": "451a43e1",
   "kr": "식사까지 나온다."
  },
  "80": {
   "jp": "a69d27c0",
   "kr": "장기 체류엔 안성맞춤인 곳이지."
  },
  "81": {
   "jp": "c98037a1",
   "kr": "다행히 라그나 고리대금업자가 미상환자 명단에"
  },
  "82": {
   "jp": "74d75619",
   "kr": "내 이름을 올려 둔 덕에"
  },
  "83": {
   "jp": "d531b11c",
   "kr": "순조롭게 이 감옥에 체크인할 수 있었지."
  },
  "84": {
   "jp": "660b3b9b",
   "kr": "핫핫핫…"
  },
  "85": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "86": {
   "jp": "f7df7ada",
   "kr": "………?"
  },
  "87": {
   "jp": "0ff6bf3f",
   "kr": "바다트&스텔라"
  },
  "88": {
   "jp": "f7df7ada",
   "kr": "………?"
  },
  "89": {
   "jp": "d3f0e045",
   "kr": "그러는 크리스 일행이야말로"
  },
  "90": {
   "jp": "66a18d5a",
   "kr": "어째서 잡힌 거지?"
  },
  "91": {
   "jp": "38fe0a65",
   "kr": "병사들이 회의하는 걸"
  },
  "92": {
   "jp": "ebd089f6",
   "kr": "들어 버렸어."
  },
  "93": {
   "jp": "d9a40edc",
   "kr": "뭔가"
  },
  "94": {
   "jp": "0229a80e",
   "kr": "아무래도 들어선 안 될 얘기였던 모양이다."
  },
  "95": {
   "jp": "0ad429a1",
   "kr": "엣, 무슨 얘기?"
  },
  "96": {
   "jp": "05a38c33",
   "kr": "그걸 들으면"
  },
  "97": {
   "jp": "d343036a",
   "kr": "분명 아저씨도 잡혀 버려요."
  },
  "98": {
   "jp": "6d7ab43e",
   "kr": "이미 잡혀 있잖아."
  },
  "99": {
   "jp": "f311dd0f",
   "kr": "아, 그렇네요."
  },
  "100": {
   "jp": "daa3a17d",
   "kr": "그럼 됐나? 하하하…"
  },
  "101": {
   "jp": "7f423039",
   "kr": "하하하하하…"
  },
  "102": {
   "jp": "3adae119",
   "kr": "………"
  },
  "103": {
   "jp": "7100f5ee",
   "kr": "루드성에서"
  },
  "104": {
   "jp": "4705243b",
   "kr": "새 병단이 여기 온다는"
  },
  "105": {
   "jp": "a6067272",
   "kr": "얘길 하고 있었어요."
  },
  "106": {
   "jp": "2f9b0e9f",
   "kr": "그래서, 허크 삼촌."
  },
  "107": {
   "jp": "b5ae766c",
   "kr": "우릴 기다렸다니 무슨 볼일이야?"
  },
  "108": {
   "jp": "7a03f2fb",
   "kr": "아, 그건 말이다."
  },
  "109": {
   "jp": "f053b113",
   "kr": "나는 하얀마녀의 전설을 쫓아"
  },
  "110": {
   "jp": "6309ab8b",
   "kr": "사방을 돌아다니고 있었는데"
  },
  "111": {
   "jp": "718964cc",
   "kr": "우연히도 이 앞 아로자에서"
  },
  "112": {
   "jp": "a26d32ad",
   "kr": "그녀의 소식에 관한 유력한 단서를"
  },
  "113": {
   "jp": "c83ae6fa",
   "kr": "얻을 수 있었단다."
  },
  "114": {
   "jp": "0a2a1fd8",
   "kr": "유력한 실마리?"
  },
  "115": {
   "jp": "5990a762",
   "kr": "허크 삼촌은"
  },
  "116": {
   "jp": "4a302b64",
   "kr": "하얀마녀 연구를 하고 있어."
  },
  "117": {
   "jp": "aa04453d",
   "kr": "흐응, 그래요."
  },
  "118": {
   "jp": "19700d44",
   "kr": "그래서 유력한 실마리란?"
  },
  "119": {
   "jp": "1be5a75f",
   "kr": "그게, 놀랍게도 말이야."
  },
  "120": {
   "jp": "fd9bbd95",
   "kr": "하얀마녀는 티라스일을 한 바퀴 돌아"
  },
  "121": {
   "jp": "7900c8a2",
   "kr": "마지막에는 폴티아로 와 있었던 거야."
  },
  "122": {
   "jp": "385751c7",
   "kr": "루드성으로 향한 거네요."
  },
  "123": {
   "jp": "5b8d7982",
   "kr": "엣?"
  },
  "124": {
   "jp": "2566e4c5",
   "kr": "어떻게 알고 있는 거야…?"
  },
  "125": {
   "jp": "5cd7f583",
   "kr": "그런 느낌이 들었어요."
  },
  "126": {
   "jp": "4c799f8b",
   "kr": "그, 그럼"
  },
  "127": {
   "jp": "b9b4bd5d",
   "kr": "이건 아직 모르겠지."
  },
  "128": {
   "jp": "d3b5a645",
   "kr": "그 아로자에는"
  },
  "129": {
   "jp": "20a4b69d",
   "kr": "일찍이 루드성의 궁정 검사였던"
  },
  "130": {
   "jp": "9e6d50d2",
   "kr": "어떤 사람의 손녀가 살고 있어."
  },
  "131": {
   "jp": "a29010e2",
   "kr": "그 아가씨한테 들었는데"
  },
  "132": {
   "jp": "ce4ebcbd",
   "kr": "궁정 검사였던 할아버지는"
  },
  "133": {
   "jp": "d9beef1b",
   "kr": "하얀마녀와 가까웠던 모양이야."
  },
  "134": {
   "jp": "97ec39d1",
   "kr": "궁정 검사라면 듀르젤이란 사람이잖아."
  },
  "135": {
   "jp": "f66e851e",
   "kr": "쿠궁."
  },
  "136": {
   "jp": "b306c727",
   "kr": "어, 어째서 거기까지"
  },
  "137": {
   "jp": "bf5bf543",
   "kr": "알고 있는 거야?"
  },
  "138": {
   "jp": "632930f4",
   "kr": "올도스의 대신관님이"
  },
  "139": {
   "jp": "36d17646",
   "kr": "듀르젤이란 사람을 만나 보라고"
  },
  "140": {
   "jp": "8513fd3e",
   "kr": "알려 주셨어."
  },
  "141": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "142": {
   "jp": "66f40519",
   "kr": "지금은 돌페스라는 곳에"
  },
  "143": {
   "jp": "39c0446c",
   "kr": "잡혀 있대요."
  },
  "144": {
   "jp": "4823313e",
   "kr": "뭐든 다 알고 있구나…"
  },
  "145": {
   "jp": "690a248a",
   "kr": "재미없네."
  },
  "146": {
   "jp": "35bbb50d",
   "kr": "그야 저희"
  },
  "147": {
   "jp": "a859e406",
   "kr": "순례 여행으로 올도스에 가는 길에"
  },
  "148": {
   "jp": "092f1f35",
   "kr": "하얀마녀 얘길 잔뜩 들었거든요."
  },
  "149": {
   "jp": "1860b685",
   "kr": "올도스에서 여기 오는 동안에도"
  },
  "150": {
   "jp": "105aac31",
   "kr": "퓨엔테나 기드넬에서도 들었어."
  },
  "151": {
   "jp": "947424fd",
   "kr": "쥬리오 일행은 순례 여행에서 겪은"
  },
  "152": {
   "jp": "a72654cc",
   "kr": "하얀마녀와 관계된 일들을"
  },
  "153": {
   "jp": "c565b749",
   "kr": "하나하나 허크에게 설명했다."
  },
  "154": {
   "jp": "05063c1e",
   "kr": "허크는 눈을 빛내며"
  },
  "155": {
   "jp": "2474bfba",
   "kr": "이따금 메모를 하면서"
  },
  "156": {
   "jp": "5338e15b",
   "kr": "쥬리오 일행의 경험을 들었다."
  },
  "157": {
   "jp": "491282af",
   "kr": "쥬리오 일행은 이 기회에 허크, 스텔라,"
  },
  "158": {
   "jp": "8d27f99d",
   "kr": "바다트에게도 라우알의 파도에 대해"
  },
  "159": {
   "jp": "8523e836",
   "kr": "말해 둬야겠다고 생각해, 올도스의 샤리네에서"
  },
  "160": {
   "jp": "fd1c26f7",
   "kr": "대신관에게 들은 것도 모두 이야기했다."
  },
  "161": {
   "jp": "0d5da7b0",
   "kr": "전부 이야기하는 데"
  },
