 "lines": {
  "0": {
   "jp": "c9fab11d",
   "kr": "매발톱호"
  },
  "1": {
   "jp": "a5ab341f",
   "kr": "톤쟈"
  },
  "2": {
   "jp": "87ed524e",
   "kr": "가톤"
  },
  "3": {
   "jp": "c1b14629",
   "kr": "브루트"
  },
  "4": {
   "jp": "898074d7",
   "kr": "조리장"
  },
  "5": {
   "jp": "73e57527",
   "kr": "질버 선장"
  },
  "6": {
   "jp": "f17dadd8",
   "kr": "쥬리오 군, 크리스 양."
  },
  "7": {
   "jp": "4e4c7d1b",
   "kr": "자네들은 정말 일을 잘해 주었다."
  },
  "8": {
   "jp": "9ef9c7ad",
   "kr": "게다가, 도난품이 돌아온 것도"
  },
  "9": {
   "jp": "969d4a35",
   "kr": "본선이 무사히 닐리에 닿은 것도"
  },
  "10": {
   "jp": "40d106d8",
   "kr": "모두 자네들 덕분이다."
  },
  "11": {
   "jp": "6d177fec",
   "kr": "정말로 감사하고 있다."
  },
  "12": {
   "jp": "5bbe858a",
   "kr": "얼마 안 되지만, 감사의 표시다."
  },
  "13": {
   "jp": "55543b18",
   "kr": "받아 두게."
  },
  "14": {
   "jp": "d400f8e0",
   "kr": "질버 선장은 항해를 함께한 동료로서 "
  },
  "15": {
   "jp": "ad25ca87",
   "kr": "을(를) 두 사람에게 건넸다."
  },
  "16": {
   "jp": "f9bbd455",
   "kr": "고마워요, 질버 선장님."
  },
  "17": {
   "jp": "29162a7b",
   "kr": "감사합니다."
  },
  "18": {
   "jp": "28d6ad9a",
   "kr": "맞다, 멀미약을 돌려드려야지."
  },
  "19": {
   "jp": "d4a0a078",
   "kr": "그 약이라면 됐다 가지고 있거라."
  },
  "20": {
   "jp": "57b9f420",
   "kr": "긴 여행이다. 또 필요해질 때도 있겠지."
  },
  "21": {
   "jp": "560d317d",
   "kr": "무사히 올도스에 닿기를 빌고 있겠다."
  },
  "22": {
   "jp": "6e66a294",
   "kr": "힘내거라!"
  },
  "23": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "24": {
   "jp": "11e35b8b",
   "kr": "네!"
  },
  "25": {
   "jp": "0387b6eb",
   "kr": "쥬리오는 뱃사람 재능이 있어."
  },
  "26": {
   "jp": "e9e4ff9e",
   "kr": "혹시, 순례가 끝나고"
  },
  "27": {
   "jp": "0eb8bb31",
   "kr": "마음이 있거든, 매발톱호로 와라!"
  },
  "28": {
   "jp": "9b20da62",
   "kr": "네!"
  },
  "29": {
   "jp": "59b1b434",
   "kr": "…근데, 아직 뭐가 될지"
  },
  "30": {
   "jp": "ceacb640",
   "kr": "모르겠어요."
  },
  "31": {
   "jp": "a03c93d5",
   "kr": "하하핫!"
  },
  "32": {
   "jp": "9f293e81",
   "kr": "하긴 그렇지."
  },
  "33": {
   "jp": "e9611d4e",
   "kr": "난 18살이 될 때까지 빈둥거렸으니까."
  },
  "34": {
   "jp": "74ae61ee",
   "kr": "자, 이별이 괴로워지겠구먼."
  },
  "35": {
   "jp": "83737c54",
   "kr": "아래에서 허크 씨랑 로저 부부가 기다린다."
  },
  "36": {
   "jp": "89701234",
   "kr": "잘 지내라!"
  },
  "37": {
   "jp": "f309e918",
   "kr": "할아버지"
  },
  "38": {
   "jp": "0a92b5ea",
   "kr": "요리 가르쳐 주셔서 고마워요."
  },
  "39": {
   "jp": "2a6f9b4e",
   "kr": "별말을."
  },
  "40": {
   "jp": "e6bc141f",
   "kr": "요리는 애정이다."
  },
  "41": {
   "jp": "b5be8186",
   "kr": "마음을 담아 만든 요리가"
  },
  "42": {
   "jp": "0b3ccc7c",
   "kr": "제일 맛있는 거지."
  },
  "43": {
   "jp": "ed6cb647",
   "kr": "그나저나, 그 2인조는"
  },
  "44": {
   "jp": "35a52cc4",
   "kr": "정말로 별나단 말이야."
  },
  "45": {
   "jp": "ef977e51",
   "kr": "접안하자마자 후딱 내려 버렸다니까."
  },
  "46": {
   "jp": "b7b69da7",
   "kr": "선장님이 사례하려 했는데 말이지."
  },
  "47": {
   "jp": "228e0c1f",
   "kr": "자, 크리스 아가씨."
  },
  "48": {
   "jp": "3d8f693a",
   "kr": "쥬리오 군이 기다린단다."
  },
  "49": {
   "jp": "070c6cec",
   "kr": "으윽 이 나이 되니 눈물이 많아 탈이다."
  },
  "50": {
   "jp": "e7558696",
   "kr": "…할아버지, 몸조심하세요."
  },
  "51": {
   "jp": "21bc526e",
   "kr": "그럼, 또 봐요!"
  },
  "52": {
   "jp": "1e56b798",
   "kr": "순례가 끝나면"
  },
  "53": {
   "jp": "73a4df33",
   "kr": "또, 언젠가 태워 주세요."
  }
 }
}