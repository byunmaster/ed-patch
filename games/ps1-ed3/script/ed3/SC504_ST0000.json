  "1": {
   "jp": "ff8af593",
   "kr": "홀크 병사"
  },
  "2": {
   "jp": "459e049c",
   "kr": "여관 몬세스"
  },
  "3": {
   "jp": "e59e9805",
   "kr": "챠펠의 파니아"
  },
  "4": {
   "jp": "41e22563",
   "kr": "시오네"
  },
  "5": {
   "jp": "7fa85504",
   "kr": "도구점 시아"
  },
  "6": {
   "jp": "93a11990",
   "kr": "무기상 그라드"
  },
  "7": {
   "jp": "6b2ee78a",
   "kr": "술집 벨드"
  },
  "8": {
   "jp": "0e861c91",
   "kr": "라크"
  },
  "9": {
   "jp": "5addbda3",
   "kr": "유니오"
  },
  "10": {
   "jp": "a89809b7",
   "kr": "리티카"
  },
  "11": {
   "jp": "b50169bf",
   "kr": "루코네"
  },
  "12": {
   "jp": "740d2469",
   "kr": "얘들아."
  },
  "13": {
   "jp": "dee1df19",
   "kr": "명령이 내려졌다."
  },
  "14": {
   "jp": "6d4ae94b",
   "kr": "동쪽 국경은 봉쇄되어 있을 거다."
  },
  "15": {
   "jp": "c7cf3653",
   "kr": "가 봤자 지나가지 못한다."
  },
  "16": {
   "jp": "da86b328",
   "kr": "아저씨 말을 못 믿겠거든"
  },
  "17": {
   "jp": "2abfacb6",
   "kr": "가도 상관없다만"
  },
  "18": {
   "jp": "ca9daace",
   "kr": "정말로 못 지나간다."
  },
  "19": {
   "jp": "740d2469",
   "kr": "여러분."
  },
  "20": {
   "jp": "97f7ee24",
   "kr": "기드나로 빠지는 가도는"
  },
  "21": {
   "jp": "742aabbc",
   "kr": "캐라크 왕의 명령으로 봉쇄했습니다."
  },
  "22": {
   "jp": "93dbec53",
   "kr": "엣, 왜요?"
  },
  "23": {
   "jp": "328e47b9",
   "kr": "그럼, 저희"
  },
  "24": {
   "jp": "cc46e6d3",
   "kr": "폴티아에 돌아갈 수 없잖아."
  },
  "25": {
   "jp": "b2aed74d",
   "kr": "캐라크 왕의 명령이 풀릴 때까지"
  },
  "26": {
   "jp": "706d6dab",
   "kr": "이 가도는 지나가실 수 없습니다."
  },
  "27": {
   "jp": "32acc294",
   "kr": "서둘러 하이젠에 가야 해!"
  },
  "28": {
   "jp": "8c511d52",
   "kr": "도착했어요."
  },
  "29": {
   "jp": "37b8460d",
   "kr": "여기가 홀크예요."
  },
  "30": {
   "jp": "740d2469",
   "kr": "너희들."
  },
  "31": {
   "jp": "536eaac7",
   "kr": "지금 홀크에 막 도착했지?"
  },
  "32": {
   "jp": "6c4fc6f6",
   "kr": "네, 그런데요?"
  },
  "33": {
   "jp": "396e0fef",
   "kr": "가도에서 다른 여행자를 만났나?"
  },
  "34": {
   "jp": "cfc5fb3f",
   "kr": "아니요, 아무도 못 만났어요."
  },
  "35": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "36": {
   "jp": "9ffe0b06",
   "kr": "그럼 동쪽 국경 봉쇄는 끝난 모양이군."
  },
  "37": {
   "jp": "492885da",
   "kr": "봉쇄라뇨?"
  },
  "38": {
   "jp": "14ad5da1",
   "kr": "아니, 됐다."
  },
  "39": {
   "jp": "108e61a3",
   "kr": "너희와는 상관없다."
  },
  "40": {
   "jp": "b9c031a3",
   "kr": "이제 나그네가 오지 않는다면"
  },
  "41": {
   "jp": "f342b872",
   "kr": "마을을 나가려는 사람 검사만 하면 되겠군."
  },
  "42": {
   "jp": "a83e50b7",
   "kr": "동쪽 입구는"
  },
  "43": {
   "jp": "4346db21",
   "kr": "나 혼자 지켜도 되겠어."
  },
  "44": {
   "jp": "a7326d2e",
   "kr": "나도 진작부터 베라트는"
  },
  "45": {
   "jp": "1ff97970",
   "kr": "이상하다 여겼다고."
  },
  "46": {
   "jp": "f4fb41b0",
   "kr": "정말이야."
  },
  "47": {
   "jp": "0fc35311",
   "kr": "여기는 봉쇄되어 있습니다."
  },
  "48": {
   "jp": "b7124df9",
   "kr": "봉쇄가 풀릴 때까지"
  },
  "49": {
   "jp": "11f2dc32",
   "kr": "홀크에서 내보내 드릴 수는 없습니다."
  },
  "50": {
   "jp": "293ca641",
   "kr": "그런…"
  },
  "51": {
   "jp": "57929de3",
   "kr": "이래서는 쥬리오 씨 일행이"
  },
  "52": {
   "jp": "e12409d7",
   "kr": "폴티아에"
  },
  "53": {
   "jp": "96cea570",
   "kr": "돌아가지 못하잖아요…"
  },
  "54": {
   "jp": "4ad13e59",
   "kr": "휘리 씨가 말한 짐승 길은?"
  },
  "55": {
   "jp": "36f6bfe0",
   "kr": "그것도 이 앞이에요."
  },
  "56": {
   "jp": "07dbd2f3",
   "kr": "그럼 휘리 씨도"
  },
  "57": {
   "jp": "36e246e1",
   "kr": "집에 못 돌아가겠네."
  },
  "58": {
   "jp": "a07b7d8a",
   "kr": "이래서는"
  },
  "59": {
   "jp": "931735ed",
   "kr": "저도 쥬리오 씨 일행도"
  },
  "60": {
   "jp": "9dacca2d",
   "kr": "이 홀크에서 움직일 수 없어요."
  },
  "61": {
   "jp": "30348de4",
   "kr": "여기 높은 사람한테"
  },
  "62": {
   "jp": "58c30750",
   "kr": "말하는 수밖에 없겠네."
  },
  "63": {
   "jp": "777328b2",
   "kr": "캐라크 왕께서"
  },
  "64": {
   "jp": "bc993447",
   "kr": "여러분의 통행을 막지 말라는"
  },
  "65": {
   "jp": "9211bf6a",
   "kr": "명령을 내리셨습니다."
  },
  "66": {
   "jp": "72398ef3",
   "kr": "믿을 분은 여러분뿐입니다."
  },
  "67": {
   "jp": "e1ef2f1b",
   "kr": "부디 잘 부탁드립니다."
  },
  "68": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "69": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "70": {
   "jp": "be7796ad",
   "kr": "우리 임금님도 참 딱하지요."
  },
  "71": {
   "jp": "5cd5ebb6",
   "kr": "수상쩍은 뜨내기 말을 듣고"
  },
  "72": {
   "jp": "900dae52",
   "kr": "가도를 봉쇄해 버렸다지 뭐예요."
  },
  "73": {
   "jp": "dd2a5816",
   "kr": "이래서야 여행자도 안 와요."
  },
  "74": {
   "jp": "d5e3ffbb",
   "kr": "장사 다 망했어요."
  },
  "75": {
   "jp": "b617ce38",
   "kr": "홀크의 챠펠에 잘 오셨습니다."
  },
  "76": {
   "jp": "bbf6d94f",
   "kr": "부디 편히 쉬다 가십시오."
  },
  "77": {
   "jp": "d7041ee1",
   "kr": "잘 오셨습니다."
  },
  "78": {
   "jp": "307c9445",
   "kr": "여기서는 챠펠 마법을"
  },
  "79": {
   "jp": "8410b96e",
   "kr": "가르쳐 드리고 있습니다."
  },
  "80": {
   "jp": "95d51df4",
   "kr": "어느 분께 가르쳐 드릴까요?"
  },
  "81": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "82": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "83": {
   "jp": "0cc85f80",
   "kr": "마법을 받은 이에게 축복을."
  },
  "84": {
   "jp": "1a95d122",
   "kr": "조금 전에 수상한 나그네가 나타났어."
  },
  "85": {
   "jp": "f5e874be",
   "kr": "좀 잘생긴 젊은이인데"
  },
  "86": {
   "jp": "74332a5a",
   "kr": "눈이 어쩐지 차가워."
  },
  "87": {
   "jp": "525ad34e",
   "kr": "왕의 저택으로 들어갔어."
  },
  "88": {
   "jp": "d9a40edc",
   "kr": "뭔가"
  },
  "89": {
   "jp": "17065ad5",
   "kr": "그 뒤로 홀크 분위기가"
  },
  "90": {
   "jp": "1d836501",
   "kr": "달라진 것 같아."
  },
  "91": {
   "jp": "4f045262",
   "kr": "어서 오세요."
  },
  "92": {
   "jp": "c514e079",
   "kr": "여기는 도구점입니다."
  },
  "93": {
   "jp": "7196f4c3",
   "kr": "부디 물건을 살펴봐 주세요."
  },
  "94": {
   "jp": "3cebce94",
   "kr": "사서 손해 볼 것 없는 물건뿐이에요."
  },
  "95": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "96": {
   "jp": "35358975",
   "kr": "그럼"
  },
  "97": {
   "jp": "e34b7e21",
   "kr": "에 팔아 드립니다."
  },
  "98": {
   "jp": "8a072d2b",
   "kr": "필요 없는 물건은 무엇이든."
  },
  "99": {
   "jp": "941f0265",
   "kr": "인가요."
  },
  "100": {
   "jp": "abb8567e",
   "kr": "그렇다면"
  },
  "101": {
   "jp": "71b4529e",
   "kr": "에 사들이겠습니다."
  },
  "102": {
   "jp": "59136b4c",
   "kr": "환전율은 1 Goa당 16 Pia입니다."
  },
  "103": {
   "jp": "ad968a20",
   "kr": "꽤 높은 환전율이라고 생각합니다만."
  },
  "104": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "105": {
   "jp": "8b8fd624",
   "kr": "이네요."
  },
  "106": {
   "jp": "c29f11ef",
   "kr": "아쉽네요. 라피카가 없어요."
  },
  "107": {
   "jp": "50891ff0",
   "kr": "그 밖에 볼일은 없으신가요?"
  },
  "108": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "109": {
   "jp": "c676fe68",
   "kr": "또 들러 주세요."
  },
  "110": {
   "jp": "b084c68a",
   "kr": "젊은 애들끼리 잘도 여행하는군."
  },
  "111": {
   "jp": "17dec768",
   "kr": "힘내라고!"
  },
  "112": {
   "jp": "d46ab5be",
   "kr": "어서 와."
  },
  "113": {
   "jp": "44a45548",
   "kr": "좋은 무기가 잔뜩 있다고."
  },
  "114": {
   "jp": "07bdc61d",
   "kr": "뭐, 둘러보고 가라고."
  },
  "115": {
   "jp": "1ad9106a",
   "kr": "어느 게 갖고 싶나?"
  },
  "116": {
   "jp": "f9ec8dac",
   "kr": "망설여지면 사 버려!"
  },
  "117": {
   "jp": "540af711",
   "kr": "고맙수다, 그건 좋은 물건이지."
  },
  "118": {
   "jp": "e52120a4",
   "kr": "보는 눈이 높군."
  },
  "119": {
   "jp": "605ba81d",
   "kr": "자자, 뭐든 사들이지!"
  },
  "120": {
   "jp": "127db0a8",
   "kr": "인가."
  },
  "121": {
   "jp": "241abf97",
   "kr": "그렇다면"
  },
  "122": {
   "jp": "b0e9310f",
   "kr": "에 사지."
  },
  "123": {
   "jp": "cccbc77a",
   "kr": "환전율은 1 Goa당 16 Pia다."
  },
  "124": {
   "jp": "dd726c7e",
   "kr": "지금이 바꿀 때, 놓칠 수 없지!"
  },
  "125": {
   "jp": "00ead2fd",
   "kr": "내지!"
  },
  "126": {
   "jp": "d73f137c",
   "kr": "이봐 이봐, 라피카가 없잖아."
  },
  "127": {
   "jp": "eb56cd33",
   "kr": "정신 좀 차리라고!"
  },
  "128": {
   "jp": "4bca0054",
   "kr": "그 밖에 볼일 없나?"
  },
  "129": {
   "jp": "6e401b93",
   "kr": "자주 들러 달라고!"
  },
  "130": {
   "jp": "d00a04e9",
   "kr": "캐라크 왕은 무슨 생각을 하는 겐지."
  },
  "131": {
   "jp": "2c206d75",
   "kr": "남북 가도뿐 아니라"
  },
  "132": {
   "jp": "22c3ac3f",
   "kr": "다른 가도까지 봉쇄해 버리다니…"
  },
  "133": {
   "jp": "e31f8385",
   "kr": "퓨엔테는 북부와 남부로 나뉘어 있단다."
  },
  "134": {
   "jp": "299d6d49",
   "kr": "북부는 형 에네톤 왕이 하이젠에서 다스리고"
  },
  "135": {
   "jp": "84dd419b",
   "kr": "남부는 아우인 캐라크 왕이"
  },
  "136": {
   "jp": "91c4797c",
   "kr": "이 홀크의 저택에서 다스리고 있지."
  },
  "137": {
   "jp": "356962de",
   "kr": "두 사람은 쌍둥이 형제야."
  },
  "138": {
   "jp": "4462d38d",
   "kr": "태어났을 때 싸우지 않도록"
  },
  "139": {
   "jp": "ee62ce0b",
   "kr": "돌아가신 여왕님이 땅을 나누셨다더구나."
  },
  "140": {
   "jp": "4c854285",
   "kr": "북쪽 하이젠 왕도 남쪽 캐라크 왕도"
  },
  "141": {
   "jp": "01a50e88",
   "kr": "근본은 아주 소심하단다."
  },
  "142": {
   "jp": "41c7878d",
   "kr": "그래도 굳이 말하자면"
  },
  "143": {
   "jp": "97f99b52",
   "kr": "캐라크 왕은 궁지에 몰리면"
  },
  "144": {
   "jp": "e6fcedbc",
   "kr": "무슨 짓을 할지 모르는 타입이지."
  },
  "145": {
   "jp": "e8c898f1",
   "kr": "위험해, 위험해."
  },
  "146": {
   "jp": "416dcb0e",
   "kr": "요즘 칼리 왕비님을"
  },
  "147": {
   "jp": "dd08baf2",
   "kr": "통 못 봤어."
  },
  "148": {
   "jp": "6f8a2dcb",
   "kr": "계속 저택에 계시려나…"
  },
  "149": {
   "jp": "2b1dfc66",
   "kr": "나는 왕비님이 정말 좋은데."
  },
  "150": {
   "jp": "e14a0672",
   "kr": "수상쩍은 여행자가 저택에서 나가는 걸 봤어."
  },
  "151": {
   "jp": "52c2785f",
   "kr": "병사를 거느리고 남북 가도로 올라간 듯해."
  }
 }
}