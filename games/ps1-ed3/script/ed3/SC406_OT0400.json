 "lines": {
  "0": {
   "jp": "044c0822",
   "kr": "대성당"
  },
  "1": {
   "jp": "612a33d2",
   "kr": "신관 폴트"
  },
  "2": {
   "jp": "d55f66dc",
   "kr": "엘테 신부"
  },
  "3": {
   "jp": "8419b2d6",
   "kr": "난치"
  },
  "4": {
   "jp": "06a49451",
   "kr": "신관 프네우마"
  },
  "5": {
   "jp": "709be6b7",
   "kr": "아까는"
  },
  "6": {
   "jp": "051d1867",
   "kr": "훌륭한 곡을 연주해 주셔서"
  },
  "7": {
   "jp": "7bd05f14",
   "kr": "정말 고마워요."
  },
  "8": {
   "jp": "b39cd24b",
   "kr": "아뇨 아뇨, 마음에 드셨나요."
  },
  "9": {
   "jp": "fd832f4c",
   "kr": "맑고 신성하고 장엄해서"
  },
  "10": {
   "jp": "207fb329",
   "kr": "마음에 평안을 주는 음색이지요."
  },
  "11": {
   "jp": "07fab58e",
   "kr": "이 파이프오르간 음색을 들으면"
  },
  "12": {
   "jp": "5f55acf1",
   "kr": "여행의 피로도 날아간 것 같다고"
  },
  "13": {
   "jp": "02d577b9",
   "kr": "다들 자주 말씀하십니다."
  },
  "14": {
   "jp": "30dcd03c",
   "kr": "저기…"
  },
  "15": {
   "jp": "5f78cb83",
   "kr": "이 벽의 파이프."
  },
  "16": {
   "jp": "0790a538",
   "kr": "뭐예요?"
  },
  "17": {
   "jp": "ef34b90d",
   "kr": "아아"
  },
  "18": {
   "jp": "4d92af4a",
   "kr": "이건 파이프오르간이라고 합니다."
  },
  "19": {
   "jp": "f6757666",
   "kr": "아주 훌륭한 음색이랍니다."
  },
  "20": {
   "jp": "5339bff3",
   "kr": "나중에 연주해 드리지요."
  },
  "21": {
   "jp": "f210cdef",
   "kr": "기대하고 계세요."
  },
  "22": {
   "jp": "e79fd6cb",
   "kr": "여어, 안녕."
  },
  "23": {
   "jp": "f7fd5d41",
   "kr": "아, 안녕하세요."
  },
  "24": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "25": {
   "jp": "dca966cf",
   "kr": "순례하시는 분이군요."
  },
  "26": {
   "jp": "495fbfbe",
   "kr": "그렇게 긴장하지 않으셔도"
  },
  "27": {
   "jp": "5c500d5e",
   "kr": "괜찮습니다."
  },
  "28": {
   "jp": "8e7ce61e",
   "kr": "부디 느긋하게"
  },
  "29": {
   "jp": "865e5401",
   "kr": "대성당 안을 둘러보세요."
  },
  "30": {
   "jp": "67bd920c",
   "kr": "이야…"
  },
  "31": {
   "jp": "c543ee63",
   "kr": "어쩐지 나한테는"
  },
  "32": {
   "jp": "5150f3c0",
   "kr": "어울리지 않는 데구먼유…"
  },
  "33": {
   "jp": "a94ea8fe",
   "kr": "엄청 훌륭해서유…"
  },
  "34": {
   "jp": "26e161e1",
   "kr": "천국에 있는 것 같구먼."
  },
  "35": {
   "jp": "662b21d6",
   "kr": "나 같은"
  },
  "36": {
   "jp": "00e2ead9",
   "kr": "촌놈은 안절부절못한다니께."
  },
  "37": {
   "jp": "85622ae6",
   "kr": "…안절부절… 안절부절…"
  },
  "38": {
   "jp": "ebe5a13e",
   "kr": "대신관님은 말씀하셨습니다."
  },
  "39": {
   "jp": "ba2f3a56",
   "kr": "세상을 뒤흔들 일이"
  },
  "40": {
   "jp": "4f1c3aa7",
   "kr": "지금 시작되려 하고 있다고…"
  },
  "41": {
   "jp": "12423604",
   "kr": "그게 무엇인지."
  },
  "42": {
   "jp": "7877f758",
   "kr": "올도스의 힘을 총동원해도"
  },
  "43": {
   "jp": "49ee3fa1",
   "kr": "전모는 알 수 없습니다."
  },
  "44": {
   "jp": "2549b830",
   "kr": "하지만 대신관님은"
  },
  "45": {
   "jp": "bdf8be78",
   "kr": "그것을 이해할 수 있는 자가 나타날 거라고"
  },
  "46": {
   "jp": "b1e3248b",
   "kr": "오늘 아침 말씀하셨습니다."
  },
  "47": {
   "jp": "53886df0",
   "kr": "저도 직감으로 알았습니다."
  },
  "48": {
   "jp": "7d68a4c3",
   "kr": "그게 바로 당신들이라는 것을."
  },
  "49": {
   "jp": "a0e5b603",
   "kr": "실례."
  },
  "50": {
   "jp": "e59cbb74",
   "kr": "제가 드릴 수 있는 말씀은 여기까지입니다."
  },
  "51": {
   "jp": "8d746263",
   "kr": "대신관님께 직접 들으세요."
  },
  "52": {
   "jp": "50b32432",
   "kr": "이 위가 올도스의 샤리네입니다."
  },
  "53": {
   "jp": "1ccbf3ab",
   "kr": "우리"
  },
  "54": {
   "jp": "b420e9f7",
   "kr": "폴티아의 라그픽 마을에서"
  },
  "55": {
   "jp": "a4a1b0ff",
   "kr": "순례 여행으로 왔어요."
  },
  "56": {
   "jp": "607f0e63",
   "kr": "크리스입니다."
  },
  "57": {
   "jp": "0d6e3ff0",
   "kr": "쥬리오예요."
  },
  "58": {
   "jp": "510820b7",
   "kr": "저는 신관 프네우마입니다."
  },
  "59": {
   "jp": "29180f69",
   "kr": "먼 길 오시느라 고생하셨습니다."
  },
  "60": {
   "jp": "a6c44635",
   "kr": "그럼, 은단검은 가지고 계시지요?"
  },
  "61": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "62": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "63": {
   "jp": "ee30d556",
   "kr": "네, 확실히 확인했습니다."
  },
  "64": {
   "jp": "2822af07",
   "kr": "그럼, 두 분의 올도스 도착을 축복하며"
  },
  "65": {
   "jp": "21c98218",
   "kr": "진실을 관장하는 신관 폴트가"
  },
  "66": {
   "jp": "3dec04b8",
   "kr": "손님의 찬가를 연주해 드리겠습니다."
  },
  "67": {
   "jp": "d6889f0d",
   "kr": "멋진 음색이야."
  },
  "68": {
   "jp": "1d5a509f",
   "kr": "정말 대단해."
  },
  "69": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "70": {
   "jp": "e3818f3f",
   "kr": "손님의 찬가는 귀한 방문자를"
  },
  "71": {
   "jp": "4185445a",
   "kr": "맞이할 때의 곡입니다."
  },
  "72": {
   "jp": "e1851359",
   "kr": "마치 두 분을 위해 만든 곡 같군요."
  },
  "73": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "74": {
   "jp": "4ab097ce",
   "kr": "자, 샤리네에서 대신관님이 기다리십니다."
  },
  "75": {
   "jp": "78c10562",
   "kr": "어서 올라가십시오."
  },
  "76": {
   "jp": "b5789287",
   "kr": "대신관님이요?"
  }
 }
}