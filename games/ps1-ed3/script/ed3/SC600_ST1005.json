  },
  "8": {
   "jp": "9ee594b2",
   "kr": "폴티아로 서둘러야 해!"
  },
  "9": {
   "jp": "1febd170",
   "kr": "왠지 불길한 예감이 들어."
  },
  "10": {
   "jp": "e1e0bf20",
   "kr": "망사 관문"
  },
  "11": {
   "jp": "e1e0bf20",
   "kr": "망사 관문"
  },
  "12": {
   "jp": "aabbacca",
   "kr": "여기를 빠져나가면 기드나야."
  },
  "13": {
   "jp": "66bd1700",
   "kr": "기드나는 사막 나라죠."
  },
  "14": {
   "jp": "2c62ce2b",
   "kr": "더워."
  },
  "15": {
   "jp": "1b89d9bf",
   "kr": "아, 수속은 끝났군요."
  },
  "16": {
   "jp": "42ac0733",
   "kr": "그럼 사양 말고"
  },
  "17": {
   "jp": "bb3502ec",
   "kr": "당당히 건물 안을 지나가세요."
  },
  "18": {
   "jp": "8c089494",
   "kr": "이 국경을 나서면 이제 사막 지대예요."
  },
  "19": {
   "jp": "701ff6ac",
   "kr": "북상해 바라카까진 마을이 없으니까"
  },
  "20": {
   "jp": "627857e6",
   "kr": "조심해서 가세요."
  },
  "21": {
   "jp": "9fb95aef",
   "kr": "저는 무기 행상을 하고 있죠."
  },
  "22": {
   "jp": "b44ca4e9",
   "kr": "괜찮으시면 물건을 좀 보시겠어요?"
  },
  "23": {
   "jp": "6f6dfffa",
   "kr": "이것도 저것도 추천할 물건뿐이죠."
  },
  "24": {
   "jp": "c19170dd",
   "kr": "인가."
  },
  "25": {
   "jp": "35358975",
   "kr": "그렇다면"
  },
  "26": {
   "jp": "e67c750e",
   "kr": "에 팔죠."
  },
  "27": {
   "jp": "e9ce8a8d",
   "kr": "필요 없는 건 파시는 게 좋아요."
  },
  "28": {
   "jp": "cdc3c88d",
   "kr": "더위로 몸이 지치기 쉬워지거든."
  },
  "29": {
   "jp": "c19170dd",
   "kr": "인가."
  },
  "30": {
   "jp": "abb8567e",
   "kr": "그렇다면"
  },
  "31": {
   "jp": "3a7af3cd",
   "kr": "에 사들이겠습니다."
  },
  "32": {
   "jp": "cccbc77a",
   "kr": "환전율은 1 Goa당 16 Pia다."
  },
  "33": {
   "jp": "1067cefb",
   "kr": "꽤 좋은 시세라고 생각해."
  },
  "34": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "35": {
   "jp": "2094011a",
   "kr": "네요."
  },
  "36": {
   "jp": "5223e554",
   "kr": "자, 떨어뜨리지 마세요."
  },
  "37": {
   "jp": "3efc149a",
   "kr": "라피카가 없네요."
  },
  "38": {
   "jp": "2787903a",
   "kr": "모이면 또 오세요."
  },
  "39": {
   "jp": "02710b29",
   "kr": "다른 볼일은 없나요?"
  },
  "40": {
   "jp": "942ddabe",
   "kr": "정말 고맙습니다."
  },
  "41": {
   "jp": "770a0e77",
   "kr": "아, 여러분은 수속이 끝나셨군요."
  },
  "42": {
   "jp": "c2a6a85b",
   "kr": "자, 어서요."
  },
  "43": {
   "jp": "b212fc4a",
   "kr": "수속은 끝나신 모양이군요."
  },
  "44": {
   "jp": "6ffa9635",
   "kr": "이제 언제든 기드나로 향해"
  },
  "45": {
   "jp": "70444c5e",
   "kr": "좋습니다."
  },
  "46": {
   "jp": "c8eec2f5",
   "kr": "폴티아 국경에는"
  },
  "47": {
   "jp": "cd837a3f",
   "kr": "병사가 많이 모여 있다는 소문이야."
  },
  "48": {
   "jp": "522cd2e1",
   "kr": "왠지 불길한 분위기인 모양이야."
  },
  "49": {
   "jp": "fb4f20f9",
   "kr": "수고 많으셨어요."
  },
  "50": {
   "jp": "f4fbef8d",
   "kr": "자유로이 지나셔도 괜찮아요."
  },
  "51": {
   "jp": "5131f24e",
   "kr": "고향 일이라 신경 쓰이겠지만"
  },
  "52": {
   "jp": "90845956",
   "kr": "전쟁을 걸려 한다니"
  },
  "53": {
   "jp": "229869e0",
   "kr": "근거 없는 소문일지도 모르니까."
  },
  "54": {
   "jp": "f218b275",
   "kr": "너무 담아 두지 않는 게 좋아요."
  },
  "55": {
   "jp": "80d3d552",
   "kr": "여기서 도시락을 먹고 있었어."
  },
  "56": {
   "jp": "71561764",
   "kr": "이 안뜰 멋진 휴식처네."
  },
  "57": {
   "jp": "1ccbf3ab",
   "kr": "우리"
  },
  "58": {
   "jp": "405e69af",
   "kr": "이제부터 우돌로 가는 길이야."
  },
  "59": {
   "jp": "d0083b21",
   "kr": "얼른 삼림욕을 하고 싶어."
  },
  "60": {
   "jp": "9c4b017b",
   "kr": "기드나는 기후가 혹독하니까."
  },
  "61": {
   "jp": "cc06ee9c",
   "kr": "숲이 있는 우돌로라도 가서 새 생활을"
  },
  "62": {
   "jp": "f44f7fb3",
   "kr": "시작해 보려고 왔단다."
  },
  "63": {
   "jp": "a743bc0f",
   "kr": "아이도 좋아하는 것 같고"
  },
  "64": {
   "jp": "af44be7c",
   "kr": "과감하게 기드나를 나와서 다행이야."
  },
  "65": {
   "jp": "82763eb7",
   "kr": "우돌은 정말 좋은 곳이에요."
  },
  "66": {
   "jp": "123baa62",
   "kr": "새 생활 힘내세요."
  },
  "67": {
   "jp": "317a87c5",
   "kr": "그래, 고마워. 힘낼게."
  },
  "68": {
   "jp": "423d3d73",
   "kr": "우돌에서의 생활이 기대되는걸."
  },
  "69": {
   "jp": "2db26c2d",
   "kr": "저희도 우돌에 가요."
  },
  "70": {
   "jp": "266430e6",
   "kr": "우돌 나라에는"
  },
  "71": {
   "jp": "7b74625e",
   "kr": "숲이 잔뜩 있대."
  },
  "72": {
   "jp": "f2443fae",
   "kr": "우와아!"
  }
 }
