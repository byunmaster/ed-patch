  },
  "19": {
   "jp": "141d5f77",
   "kr": "보이"
  },
  "20": {
   "jp": "6b6c9d25",
   "kr": "잠깐, 나그네."
  },
  "21": {
   "jp": "3e0826cb",
   "kr": "이 앞에는 다 허물어진 마을과"
  },
  "22": {
   "jp": "ffa7f64c",
   "kr": "하얀마녀를 만난 적이 있다는"
  },
  "23": {
   "jp": "ffb42c35",
   "kr": "별난 할멈네 집밖에 없어."
  },
  "24": {
   "jp": "7192d355",
   "kr": "별난 할머니?"
  },
  "25": {
   "jp": "c1decb08",
   "kr": "그래. 듣기론 20년 전에"
  },
  "26": {
   "jp": "38f1eefa",
   "kr": "마녀를 만났다나, 안 만났다나."
  },
  "27": {
   "jp": "f09cc80c",
   "kr": "뭐, 믿을 건 못 되지만."
  },
  "28": {
   "jp": "19b644f1",
   "kr": "게다가 빈민가는 나그네가"
  },
  "29": {
   "jp": "8879b111",
   "kr": "들를 만한 곳은 없어."
  },
  "30": {
   "jp": "2f9dd91c",
   "kr": "빈민가엔 원래 다츠라는"
  },
  "31": {
   "jp": "5880528d",
   "kr": "이름이 있지만 아무도 그렇게 안 불러."
  },
  "32": {
   "jp": "b7b234c1",
   "kr": "빈민가면 충분하니까."
  },
  "33": {
   "jp": "2171b865",
   "kr": "빈민가 사람들도 조금만 더"
  },
  "34": {
   "jp": "28b51860",
   "kr": "의욕을 내 주면 좋겠는데 말이야."
  },
  "35": {
   "jp": "8490aa3f",
   "kr": "이 마을은 늘 활기가 있어서 좋아."
  },
  "36": {
   "jp": "ca38fa88",
   "kr": "물론 카지노에서 버는 사람도 있고"
  },
  "37": {
   "jp": "8976f40c",
   "kr": "털리는 사람도 있지만."
  },
  "38": {
   "jp": "7493848c",
   "kr": "다들 물러날 때를 알고 있으니까"
  },
  "39": {
   "jp": "5e2ba017",
   "kr": "생활이 안 될 만큼"
  },
  "40": {
   "jp": "f20dd000",
   "kr": "털리는 사람은 없는 거지."
  },
  "41": {
   "jp": "a723bbcd",
   "kr": "하긴 이 마을에서 도박을 하는 사람은"
  },
  "42": {
   "jp": "9fc3f390",
   "kr": "원래 부자니까 조금쯤 손해를 봐도"
  },
  "43": {
   "jp": "28fc6fe7",
   "kr": "아프지도 가렵지도 않을지 모르지."
  },
  "44": {
   "jp": "cdf5a9a8",
   "kr": "카지노는 정말 즐거워."
  },
  "45": {
   "jp": "2dd2f771",
   "kr": "하지만 초보자는 너무 빠져들지"
  },
  "46": {
   "jp": "77eb0145",
   "kr": "않는 게 좋아."
  },
  "47": {
   "jp": "42a26e81",
   "kr": "뭐니 뭐니 해도"
  },
  "48": {
   "jp": "5c8623d1",
   "kr": "생활에 여유가 있어야 할 수 있는"
  },
  "49": {
   "jp": "49a2f9a2",
   "kr": "귀족의 오락이니까."
  },
  "50": {
   "jp": "994baf87",
   "kr": "여기 카지노 지배인은"
  },
  "51": {
   "jp": "27777836",
   "kr": "늘 2층에서 손님과 큰 승부를 벌인답니다."
  },
  "52": {
   "jp": "780bd5eb",
   "kr": "구경 삼아 보러 가면 어때요?"
  },
  "53": {
   "jp": "ba32c2a4",
   "kr": "이야 정말로."
  },
  "54": {
   "jp": "163c95ef",
   "kr": "큰 승부는 보고만 있어도 긴장돼요."
  },
  "55": {
   "jp": "4db9f5a8",
   "kr": "룰렛을 좋아하는 놈은 문외한이야."
  },
  "56": {
   "jp": "fdfea515",
   "kr": "너희도 그렇게 생각하지?"
  },
  "57": {
   "jp": "2cb7ffe2",
   "kr": "카드야말로 도박의 왕이다."
  },
  "58": {
   "jp": "2b36dddf",
   "kr": "룰렛이 빙글빙글 도는 걸 보고 있으면"
  },
  "59": {
   "jp": "29f9ca2e",
   "kr": "이쪽까지 눈이 돌아 버린다고."
  },
  "60": {
   "jp": "a3ec5764",
   "kr": "그럼, 한밑천 더 벌어 볼까."
  },
  "61": {
   "jp": "423ccd6d",
   "kr": "나는 카드보다 룰렛 쪽이"
  },
  "62": {
   "jp": "c4cc5b63",
   "kr": "성미에 맞는 것 같아."
  },
  "63": {
   "jp": "fcf68948",
   "kr": "카드는 상대와 수 싸움이 있어서"
  },
  "64": {
   "jp": "89923c53",
   "kr": "성가셔서 못 해 먹겠어."
  },
  "65": {
   "jp": "f797d4cc",
   "kr": "룰렛은 100% 그때그때의"
  },
  "66": {
   "jp": "e81323a9",
   "kr": "운에 달렸으니까."
  },
  "67": {
   "jp": "c3afeb63",
   "kr": "깨끗이 단념할 수 있어 좋아."
  },
  "68": {
   "jp": "64150134",
   "kr": "상쾌하네."
  },
  "69": {
   "jp": "62e6eb6a",
   "kr": "오호호호호…"
  },
  "70": {
   "jp": "d521b759",
   "kr": "상쾌, 상쾌"
  },
  "71": {
   "jp": "baf69de2",
   "kr": "웃음이 멈추질 않아."
  },
  "72": {
   "jp": "62e6eb6a",
   "kr": "오호호호호…"
  },
  "73": {
   "jp": "86d0d300",
   "kr": "2층은 특별 도박실이야."
  },
  "74": {
   "jp": "deb7dc73",
   "kr": "내 예상으론 오늘 승부는 크게 요동칠걸."
  },
  "75": {
   "jp": "f28fad30",
   "kr": "루레 영감도 형세가 안 좋아."
  },
  "76": {
   "jp": "b1b6e0cf",
   "kr": "루레 할아버지요?"
  },
  "77": {
   "jp": "51f50355",
   "kr": "아, 단골손님이야."
  },
  "78": {
   "jp": "436b1282",
   "kr": "요즘 너무 따서 지배인 리바레한테 찍혔"
  },
  "79": {
   "jp": "3642d257",
   "kr": "나 보더라…"
  },
  "80": {
   "jp": "081027f6",
   "kr": "지배인 녀석"
  },
  "81": {
   "jp": "d2f0f06c",
   "kr": "지금까지 루레 영감이 번 돈을"
  },
  "82": {
   "jp": "400b50fe",
   "kr": "남김없이 뜯어낼 셈이야."
  },
  "83": {
   "jp": "597210ac",
   "kr": "금화의 광채에 마음을 빼앗긴 채"
  },
  "84": {
   "jp": "9b557ee2",
   "kr": "마법을 써서는 안 됩니다."
  },
  "85": {
   "jp": "5b38044d",
   "kr": "칸드에 어서 오세요."
  },
  "86": {
   "jp": "98347b01",
   "kr": "어느 분이 마법 습득을 원하십니까?"
  },
  "87": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "88": {
   "jp": "dd014f81",
   "kr": "군요."
  },
  "89": {
   "jp": "7fc3d4a6",
   "kr": "도움이 되기를 바랍니다."
  },
  "90": {
   "jp": "cca19cda",
   "kr": "칸드의 힘이 필요하면"
  },
  "91": {
   "jp": "77b60f36",
   "kr": "언제든지 찾아 주십시오."
  },
  "92": {
   "jp": "a0d2ee5a",
   "kr": "이 마을 카지노는 여자든 아이든"
  },
  "93": {
   "jp": "7e153063",
   "kr": "돈만 갖고 있으면"
  },
  "94": {
   "jp": "3f0615a7",
   "kr": "누구든 걸 수 있어."
  },
  "95": {
   "jp": "bd771995",
   "kr": "누구에게나 억만장자가 될 기회가"
  },
  "96": {
   "jp": "38865997",
   "kr": "있다는 거야."
  },
  "97": {
   "jp": "2e40d5ca",
   "kr": "정말 다이스는 멋진 마을이야."
  },
  "98": {
   "jp": "0e87f6ac",
   "kr": "이 마을은 분명 부유한 이들의 것입니다."
  },
  "99": {
   "jp": "e304ea13",
   "kr": "허나 챠펠의 마법은"
  },
  "100": {
   "jp": "d9b4c9b4",
   "kr": "빈부의 차에 얽매이는 것이 아닙니다."
  },
  "101": {
   "jp": "3f6d63e4",
   "kr": "부디 잊지 마시기를."
  },
  "102": {
   "jp": "e7252adf",
   "kr": "여기는 다이스의 챠펠입니다."
  },
  "103": {
   "jp": "f8a02da0",
   "kr": "어느 분께 내려 드릴까요?"
  },
  "104": {
   "jp": "958f8260",
   "kr": "어느 챠펠 마법을 원하시는지요?"
  },
  "105": {
   "jp": "dd014f81",
   "kr": "군요."
  },
  "106": {
   "jp": "8a5d470b",
   "kr": "신념을 저버리지 마세요."
  },
  "107": {
   "jp": "e933f6f4",
   "kr": "치유의 빛이 그대와 함께 있기를 빕니다."
  },
  "108": {
   "jp": "df38ea6f",
   "kr": "너희도 챠펠 마법을 받으러 온 거야?"
  },
  "109": {
   "jp": "541feb18",
   "kr": "하지만 카지노에서 도박에 졌을 때의 충격은"
  },
  "110": {
   "jp": "212665d7",
   "kr": "아무리 챠펠 마법으로도 회복 안 되니까"
  },
  "111": {
   "jp": "aba9349f",
   "kr": "너무 빠져들지 않는 게 좋아."
  },
  "112": {
   "jp": "953b9079",
   "kr": "종종 나그네가 이 거리에 와서"
  },
  "113": {
   "jp": "08f6fb8d",
   "kr": "빈털터리가 되고 만다고."
  },
  "114": {
   "jp": "2c6714ac",
   "kr": "조심하라고. 내 충고야."
  },
  "115": {
   "jp": "fc52bcb2",
   "kr": "저는 머나먼 서쪽 나라에서 카지노에서 놀려고"
  },
  "116": {
   "jp": "32071699",
   "kr": "다이스까지 왔어요. 남들은 저를"
  },
  "117": {
   "jp": "828f686c",
   "kr": "떠돌이 도박꾼이라고 부르죠."
  },
  "118": {
   "jp": "179509ff",
   "kr": "멋있죠?"
  },
  "119": {
   "jp": "877f3f67",
   "kr": "실은 말이죠, 몽땅 잃어버려서"
  },
  "120": {
   "jp": "253413b5",
   "kr": "돌아갈 여비도 없어요."
  },
  "121": {
   "jp": "aad3f01a",
   "kr": "여기 숙박비는 어쩌죠 … 으흐흑."
  },
  "122": {
   "jp": "7b57fca6",
   "kr": "네네, 어서 오세요."
  },
  "123": {
   "jp": "9649b81f",
   "kr": "여기는 여관이에요."
  },
  "124": {
   "jp": "b3b81215",
   "kr": "방은 비어 있답니다."
  },
  "125": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "126": {
   "jp": "f697c3e5",
   "kr": "저희는 순례 여행 중인데요"
  },
  "127": {
   "jp": "7abd78f8",
   "kr": "묵어도 될까요?"
  },
  "128": {
   "jp": "5e766445",
   "kr": "어머, 순례자시군요."
  },
  "129": {
   "jp": "73aec126",
   "kr": "서두르는 여행이라서"
  },
  "130": {
   "jp": "7b42c82d",
   "kr": "묵게 될지 어떨지"
  },
  "131": {
   "jp": "835dd5e9",
   "kr": "아직 잘 모르겠어요."
  },
  "132": {
   "jp": "39a68404",
   "kr": "이건 순례자의 증표인"
  },
  "133": {
   "jp": "13c61395",
   "kr": "은단검이에요."
  },
  "134": {
   "jp": "131d4aa1",
   "kr": "쥬리오는 은단검을 내보였다."
  },
  "135": {
   "jp": "6a7832a8",
   "kr": "어머, 일일이 보여 주지 않으셔도 되는데요."
  },
  "136": {
   "jp": "0ec949ea",
   "kr": "상관없어요. 마음껏 묵고 가세요."
  },
  "137": {
   "jp": "557b7aee",
   "kr": "순례 여행자라면 언제든 대환영이랍니다."
  },
  "138": {
   "jp": "b8b2519f",
   "kr": "미안하지만 나도 같이 묵지."
  },
  "139": {
   "jp": "cc90f074",
   "kr": "어쩔 수 없네요."
  },
  "140": {
   "jp": "f6383651",
   "kr": "이번만이에요."
  },
  "141": {
   "jp": "2a52459f",
   "kr": "제집이라 생각하고 편히 쉬세요."
  },
  "142": {
   "jp": "26a72b57",
   "kr": "이 앞은 바론 씨의 관저야."
  },
  "143": {
   "jp": "c8c1a920",
   "kr": "요즘 저택 주위를 빈민가 아이들이"
  },
  "144": {
   "jp": "b553c266",
   "kr": "어슬렁거린다는 얘기다."
  },
  "145": {
   "jp": "e7d8f3ff",
   "kr": "도둑질하러 들지도 모르니까"
  },
  "146": {
   "jp": "a8fa9042",
   "kr": "경비를 강화한다고"
  },
  "147": {
   "jp": "2c7e74b8",
   "kr": "저택 사람들이 말하더라고."
  },
  "148": {
   "jp": "719980ad",
   "kr": "재산이 있는 것도 문제로군."
  },
  "149": {
   "jp": "6983ae0c",
   "kr": "손님도 블랙잭을 하고 싶구나?"
  },
  "150": {
   "jp": "b3e7f293",
   "kr": "지금은 이 손님을 상대하고 있으니"
  },
  "151": {
   "jp": "e3ac889b",
   "kr": "나중에 와 주지 않겠어?"
  },
  "152": {
   "jp": "3a1acb5a",
   "kr": "승자에게는 금화의 울림을"
  },
  "153": {
   "jp": "df817372",
   "kr": "패자에게는 가벼운 현기증을."
  },
  "154": {
   "jp": "dddad63a",
   "kr": "그중 어느 쪽이든 맛보게 해 줄게."
  },
  "155": {
   "jp": "2bbf3ca6",
   "kr": "음… 에이스는 1이나 11이고"
  },
  "156": {
   "jp": "a48506c6",
   "kr": "킹은 10?"
  },
  "157": {
   "jp": "5f52567c",
   "kr": "난 덧셈이 영 약하단 말이야."
  },
  "158": {
   "jp": "0da9c041",
   "kr": "코인 10장을 100 Pia에 사면"
