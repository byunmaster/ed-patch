{
 "archive": "/SCE1/SC105.DAT",
 "member": "..\\DATA\\MR4300.BIN",
 "lines": {
  "0": {
   "jp": "2c5ba178",
   "kr": "쌍룡곡 관문"
  },
  "1": {
   "jp": "97397cc2",
   "kr": "레드"
  },
  "2": {
   "jp": "2ead2f2b",
   "kr": "관문 병사"
  },
  "3": {
   "jp": "9a0cc98e",
   "kr": "와아."
  },
  "4": {
   "jp": "61ca8a27",
   "kr": "관문이 보여."
  },
  "5": {
   "jp": "e3ff001e",
   "kr": "쌍룡곡 관문을 넘으면 챠놈이다."
  },
  "6": {
   "jp": "793ad055",
   "kr": "그럼, 메나트는"
  },
  "7": {
   "jp": "f1c458cf",
   "kr": "여기까지인 거네."
  },
  "8": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "9": {
   "jp": "63d14961",
   "kr": "그런 셈이다."
  },
  "10": {
   "jp": "b5698c1c",
   "kr": "기어코 나를 못 지나가게 하겠다는 게냐."
  },
  "11": {
   "jp": "8de5e863",
   "kr": "그래. 몇 번이나 그렇게 말했잖아."
  },
  "12": {
   "jp": "771d7bda",
   "kr": "거기를 어떻게든."
  },
  "13": {
   "jp": "dcf276ae",
   "kr": "응, 통과시켜 줘."
  },
  "14": {
   "jp": "f445df00",
   "kr": "안 돼."
  },
  "15": {
   "jp": "93ae2598",
   "kr": "그러지 말고…"
  },
  "16": {
   "jp": "b13365c2",
   "kr": "… 응?"
  },
  "17": {
   "jp": "f445df00",
   "kr": "안 돼."
  },
  "18": {
   "jp": "c7f23262",
   "kr": "오늘만큼은 절대 안 보낸다!"
  },
  "19": {
   "jp": "005bdece",
   "kr": "거기를 어떻게든, 괜찮잖아."
  },
  "20": {
   "jp": "efbe24c9",
   "kr": "안 된다니까!"
  },
  "21": {
   "jp": "6b13f9bd",
   "kr": "무슨 일이야?"
  },
  "22": {
   "jp": "83e402df",
   "kr": "왜 못 지나가게 해?"
  },
  "23": {
   "jp": "43a7a125",
   "kr": "두 분."
  },
  "24": {
   "jp": "b9bca0fe",
   "kr": "얼른 끝내 주지 않겠소?"
  },
  "25": {
   "jp": "98246ba2",
   "kr": "우린 갈 길이 바빠서."
  },
  "26": {
   "jp": "b28e6e54",
   "kr": "오오, 자네들 좀 들어 주게."
  },
  "27": {
   "jp": "2eed0845",
   "kr": "나는 그저 챠놈에 가고 싶을 뿐인데."
  },
  "28": {
   "jp": "62a831d4",
   "kr": "이것 보게, 통행증도 제대로 갖고 있네."
  },
  "29": {
   "jp": "ab95e851",
   "kr": "그런데도 이 애송이가 고집불통이라."
  },
  "30": {
   "jp": "9770b03e",
   "kr": "나를 통과시켜 주질 않는구먼."
  },
  "31": {
   "jp": "5d42d19b",
   "kr": "너무해."
  },
  "32": {
   "jp": "854b815c",
   "kr": "고집은 피차일반이잖소, 영감님!"
  },
  "33": {
   "jp": "fc88ca86",
   "kr": "애초에 생판 모르는 여행자를 편으로"
  },
  "34": {
   "jp": "e372cd3b",
   "kr": "삼으려는 속셈이 치사하다고."
  },
  "35": {
   "jp": "1f5a43bc",
   "kr": "흥…"
  },
  "36": {
   "jp": "d3daa473",
   "kr": "너를 그런 앞뒤 막힌 문지기로"
  },
  "37": {
   "jp": "d95de95f",
   "kr": "키운 기억은 없다!"
  },
  "38": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "39": {
   "jp": "206a9469",
   "kr": "이 사람… 문지기 아저씨의"
  },
  "40": {
   "jp": "fa172f14",
   "kr": "할아버지야?"
  },
  "41": {
   "jp": "8cdac590",
   "kr": "어차피 챠놈 다이스까지 가서"
  },
  "42": {
   "jp": "9970c73f",
   "kr": "도박에 돈을 처박을 속셈이지."
  },
  "43": {
   "jp": "9c6a50c1",
   "kr": "나는 친손자로서 한심하다고."
  },
  "44": {
   "jp": "22ad7bde",
   "kr": "적당히 카지노 좀 그만해!"
  },
  "45": {
   "jp": "f0d1c958",
   "kr": "어차피 빈털터리가 되어서"
  },
  "46": {
   "jp": "c0629484",
   "kr": "무일푼으로 돌아오는 게 뻔해."
  },
  "47": {
   "jp": "2098418a",
   "kr": "호오, 그러냐!"
  },
  "48": {
   "jp": "19b0ae63",
   "kr": "그래, 그렇다!"
  },
  "49": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "50": {
   "jp": "7873c192",
   "kr": "그래, 알았다."
  },
  "51": {
   "jp": "190c9ce2",
   "kr": "안 가면 될 거 아니냐."
  },
  "52": {
   "jp": "a04ba0f2",
   "kr": "그런가, 그런가."
  },
  "53": {
   "jp": "6e09466c",
   "kr": "그럼 어쩌란 말이냐?"
  },
  "54": {
   "jp": "8a5c2325",
   "kr": "너는 이 연약한 늙은이더러"
  },
  "55": {
   "jp": "febe1326",
   "kr": "지금부터 튜엘로 혼자 돌아가라는 게지?"
  },
  "56": {
   "jp": "639fd1c3",
   "kr": "이 근처 가도에는 마수도 많은데."
  },
  "57": {
   "jp": "c3781bab",
   "kr": "터덜터덜 돌아가는 길에 마수 밥이"
  },
  "58": {
   "jp": "9c1c3541",
   "kr": "되면 좋겠다는 게로군?"
  },
  "59": {
   "jp": "44072f60",
   "kr": "그런 말은 한마디도 안 했잖아."
  },
  "60": {
   "jp": "a8b753df",
   "kr": "애초에 늘 아무렇지 않게"
  },
  "61": {
   "jp": "0843fbe9",
   "kr": "혼자 싸돌아다니면서…"
  },
  "62": {
   "jp": "b812a45a",
   "kr": "아이고, 이렇게 차가운 놈이라니."
  },
  "63": {
   "jp": "a1c95fb9",
   "kr": "이제 너한테는 안 부탁한다."
  },
  "64": {
   "jp": "46d3e020",
   "kr": "이 사람들한테 데려가 달라고 하겠다."
  },
  "65": {
   "jp": "1c5a6ab2",
   "kr": "에〜?"
  },
  "66": {
   "jp": "debb1d4e",
   "kr": "왜 그렇게 되는데?"
  },
  "67": {
   "jp": "24312de0",
   "kr": "이봐 이봐…"
  },
  "68": {
   "jp": "32d0975a",
   "kr": "설마"
  },
  "69": {
   "jp": "398b4c1e",
   "kr": "자네들도 나더러 마수 밥이 되라고?"
  },
  "70": {
   "jp": "a5b670ad",
   "kr": "그런 말 안 했는데."
  },
  "71": {
   "jp": "88bcb883",
   "kr": "그럼, 괜찮은 게로군."
  },
  "72": {
   "jp": "a585a16c",
   "kr": "이봐…"
  },
  "73": {
   "jp": "a875f947",
   "kr": "우린 같이 가겠다고"
  },
  "74": {
   "jp": "30cd058d",
   "kr": "승낙한 게 아니라고."
  },
  "75": {
   "jp": "70e33545",
   "kr": "이제, 시간이 아까워."
  },
  "76": {
   "jp": "a5eed4f2",
   "kr": "다이스까지니까"
  },
  "77": {
   "jp": "ddcbb9f8",
   "kr": "데려다줘요."
  },
  "78": {
   "jp": "03bca4e6",
   "kr": "좋다, 미인 아가씨."
  },
  "79": {
   "jp": "9ca1a551",
   "kr": "나도 그 의견에 찬성이다."
  },
  "80": {
   "jp": "2943f5e6",
   "kr": "참, 능청스러운 영감이군."
  },
  "81": {
   "jp": "0b9defe0",
   "kr": "루레가 일행에 합류했다."
  },
  "82": {
   "jp": "a8d9f9ff",
   "kr": "미안하오."
  },
  "83": {
   "jp": "39b11e0b",
   "kr": "늘 이런 식으로"
  },
  "84": {
   "jp": "a3cb8153",
   "kr": "한번 말하면 안 듣는다오."
  },
  "85": {
   "jp": "556a4acd",
   "kr": "이제 오늘은 포기했소."
  },
  "86": {
   "jp": "c719a94d",
   "kr": "미안하지만, 다이스까지 영감님을"
  },
  "87": {
   "jp": "5f848a85",
   "kr": "데려가 주시오."
  },
  "88": {
   "jp": "7dbf4449",
   "kr": "영감님〜!"
  },
  "89": {
   "jp": "93035e3c",
   "kr": "새 짝꿍을 찾았수〜?"
  },
  "90": {
   "jp": "65b52e92",
   "kr": "오〜냐. 그렇지."
  },
  "91": {
   "jp": "aecc8b57",
   "kr": "다이스까지 같이"
  },
  "92": {
   "jp": "88db1086",
   "kr": "가 준다는구나!"
  },
  "93": {
   "jp": "32c6e273",
   "kr": "돈 벌면 뭐라도 먹여 줘요〜!"
  },
  "94": {
   "jp": "2c9c0c06",
   "kr": "뭐라고? 안 들려."
  },
  "95": {
   "jp": "246f3dbf",
   "kr": "됐수!"
  },
  "96": {
   "jp": "05eb5dba",
   "kr": "어차피 털리고 올 거"
  },
  "97": {
   "jp": "4c2b5076",
   "kr": "니까요〜!"
  },
  "98": {
   "jp": "7b9490de",
   "kr": "루레 할아버지는"
  },
  "99": {
   "jp": "9574a379",
   "kr": "꽤 인기가 많으시네요."
  },
  "100": {
   "jp": "48bf6d94",
   "kr": "하하, 별말을."
  },
  "101": {
   "jp": "9afe34a4",
   "kr": "오늘은 괜찮다니까!"
  },
  "102": {
   "jp": "88b255d1",
   "kr": "드디어 챠놈이네."
  },
  "103": {
   "jp": "74db7c72",
   "kr": "그 너머가 우리가 목표하는 앰비쉬야."
  },
  "104": {
   "jp": "6c0c4bef",
   "kr": "좀이 쑤시는군."
  },
  "105": {
   "jp": "5590ff80",
   "kr": "응?"
  },
  "106": {
   "jp": "324b82a1",
   "kr": "이 영감님은"
  },
  "107": {
   "jp": "938e27ae",
   "kr": "카지노를 말하는 거야."
  },
  "108": {
   "jp": "e3b70839",
   "kr": "자 힘차게 가 보자꾸나!"
  },
  "109": {
   "jp": "018a551a",
   "kr": "… 뭔가 김새는군."
  },
  "110": {
   "jp": "c3b399e3",
   "kr": "로프섬에서 가루가가 자는 사이에"
  },
  "111": {
   "jp": "a518524e",
   "kr": "앰비쉬의 항구 마을 볼트로"
  },
  "112": {
   "jp": "cbbcc082",
   "kr": "앞질러 가려는 쥬리오 일행."
  },
  "113": {
   "jp": "b893e720",
   "kr": "과연 쥬리오 일행은 가루가보다 빨리"
  },
  "114": {
   "jp": "c50ae2ef",
   "kr": "볼트에 닿을 수 있을까."
  },
  "115": {
   "jp": "acd8654c",
   "kr": "튜엘에서 사라진 알프는 누구였을까."
  },
  "116": {
   "jp": "41a9d7a5",
   "kr": "루레 노인이 동행자로 더해져"
  },
  "117": {
   "jp": "41b28602",
   "kr": "일행은 메나트를 뒤로했다."
  },
  "118": {
   "jp": "94e5eddd",
   "kr": "제１장　테그라의 보석　끝"
  },
  "119": {
   "jp": "f49ab8bf",
   "kr": "정말 폐를 끼쳐 미안하오."
  },
  "120": {
   "jp": "0ad6a176",
   "kr": "저녁까지는 돌아오세요."
  },
  "121": {
   "jp": "b5ea093a",
   "kr": "알았다, 알았어."
  },
  "122": {
   "jp": "b54f9e88",
   "kr": "아, 레드네 영감님."
  },
  "123": {
   "jp": "3e40dcbb",
   "kr": "또 다이스로"
  },
  "124": {
   "jp": "ae73c5d0",
   "kr": "나서려는 거로군."
  },
  "125": {
   "jp": "26bbae90",
   "kr": "너무 손주를 곤란하게 하지 마쇼."
  },
  "126": {
   "jp": "ebaca046",
   "kr": "요전에 망루 언덕에서 울고 있었다고."
  },
  "127": {
   "jp": "c57cb422",
   "kr": "시끄럽다."
  },
  "128": {
   "jp": "8a686f0f",
   "kr": "오늘이야말로 크게 벌 게다."
  },
  "129": {
   "jp": "bda0e77a",
   "kr": "와하하하하하…"
  },
  "130": {
   "jp": "deca212a",
   "kr": "안 되겠구먼."
  },
  "131": {
   "jp": "bc4bb5c0",
   "kr": "정말, 노름은 못 끊는구먼."
  },
  "132": {
   "jp": "65ee5f21",
   "kr": "루레 영감님, 또 다이스에 가시오?"
  },
  "133": {
   "jp": "fc5f8771",
   "kr": "이제 좀 벌어 오시오."
  },
  "134": {
   "jp": "786ee712",
   "kr": "늘 돌아올 땐 빈털터리라니"
  },
  "135": {
   "jp": "c98214c7",
   "kr": "내보내는 나로서도 괴로워진단 말이오."
  },
  "136": {
   "jp": "7d43dce9",
   "kr": "걱정 마라."
  },
  "137": {
   "jp": "39b2cee5",
   "kr": "오늘은 질 것 같지가 않단 말이다."
  },
  "138": {
   "jp": "cf025e9e",
   "kr": "어제도 그리 말했잖소."
  },
  "139": {
   "jp": "5164e926",
   "kr": "이런, 다이스는 반대 방향이야."
  }
 }
}