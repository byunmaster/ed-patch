 "member": "..\\DATA\\ST0200.BIN",
 "lines": {
  "0": {
   "jp": "57e30d30",
   "kr": "홀크"
  },
  "1": {
   "jp": "b9c84b08",
   "kr": "캐라크 저택"
  },
  "2": {
   "jp": "ff8af593",
   "kr": "홀크 병사"
  },
  "3": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "4": {
   "jp": "75e9e435",
   "kr": "캐라크 왕"
  },
  "5": {
   "jp": "42a37312",
   "kr": "집사 오펠"
  },
  "6": {
   "jp": "43bd76dc",
   "kr": "안 되겠어."
  },
  "7": {
   "jp": "0dcd27bf",
   "kr": "아예 상대도 안 해 주네."
  },
  "8": {
   "jp": "81c3ba9b",
   "kr": "분명 국경에서,"
  },
  "9": {
   "jp": "1ae9192a",
   "kr": "앰비쉬와는 사이가 좋다고"
  },
  "10": {
   "jp": "29f532c9",
   "kr": "했었지요."
  },
  "11": {
   "jp": "03c1fcdc",
   "kr": "앰비쉬의 사자가 아닌 이상,"
  },
  "12": {
   "jp": "e0d6f7ca",
   "kr": "들여보내 주지 않을 것 같네요."
  },
  "13": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "14": {
   "jp": "beb3f26a",
   "kr": "왜 그래, 쥬리오?"
  },
  "15": {
   "jp": "0c3c4bbc",
   "kr": "그거야."
  },
  "16": {
   "jp": "c083f759",
   "kr": "알프한테 받은 반지가 있잖아."
  },
  "17": {
   "jp": "3b3dbd63",
   "kr": "앗, 맞다."
  },
  "18": {
   "jp": "e81547ce",
   "kr": "그 반지가 있잖아."
  },
  "19": {
   "jp": "9adf706c",
   "kr": "우리, 어엿한 앰비쉬의 사자예요."
  },
  "20": {
   "jp": "2bdcd521",
   "kr": "그 알프라는 분은요?"
  },
  "21": {
   "jp": "3dc7f20a",
   "kr": "아, 알프는 말이야"
  },
  "22": {
   "jp": "e6c7cc50",
   "kr": "앰비쉬의 임금님이야."
  },
  "23": {
   "jp": "baab8257",
   "kr": "엄청 좋은 사람이야."
  },
  "24": {
   "jp": "9b694fa5",
   "kr": "좀 이상하지만."
  },
  "25": {
   "jp": "5c312a8b",
   "kr": "국민 아끼고 소탈하고"
  },
  "26": {
   "jp": "f3cc8f52",
   "kr": "누구랑 똑같이 방향치라서요."
  },
  "27": {
   "jp": "f2314863",
   "kr": "강하고, 멋지고"
  },
  "28": {
   "jp": "9796e791",
   "kr": "먹보라니까."
  },
  "29": {
   "jp": "96a0ca5e",
   "kr": "저기…"
  },
  "30": {
   "jp": "3d4e5def",
   "kr": "내가 칭찬하고 있는데."
  },
  "31": {
   "jp": "9c494a14",
   "kr": "저…"
  },
  "32": {
   "jp": "748ca15a",
   "kr": "앰비쉬의 임금님과 친하신가요."
  },
  "33": {
   "jp": "c2b3270a",
   "kr": "쥬리오 씨, 대단하네요."
  },
  "34": {
   "jp": "895972e6",
   "kr": "하지만 임금님을 이름으로 부르는 건"
  },
  "35": {
   "jp": "15e7cb14",
   "kr": "별로 좋지 않아요."
  },
  "36": {
   "jp": "9e8f72b3",
   "kr": "응, 맞아."
  },
  "37": {
   "jp": "d5a4cdf9",
   "kr": "안 되는 줄은 아는데"
  },
  "38": {
   "jp": "66495868",
   "kr": "버릇이 돼서…"
  },
  "39": {
   "jp": "eb86ae51",
   "kr": "그런 건"
  },
  "40": {
   "jp": "83f85dba",
   "kr": "지금 아무래도 상관없어."
  },
  "41": {
   "jp": "7efd6bc1",
   "kr": "작전은 정해졌어."
  },
  "42": {
   "jp": "af81a184",
   "kr": "자, 쥬리오."
  },
  "43": {
   "jp": "1bde57a8",
   "kr": "알프의 반지를 준비해."
  },
  "44": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "45": {
   "jp": "5a0fd938",
   "kr": "쥬리오는 알프의 반지를 확인했다."
  },
  "46": {
   "jp": "3ff6bc57",
   "kr": "그걸 입구 병사에게 보여 주고,"
  },
  "47": {
   "jp": "dd8f1267",
   "kr": "앰비쉬의 사자라고 해서"
  },
  "48": {
   "jp": "d7d6098f",
   "kr": "임금님을 뵙게 해 달라고 하는 거예요."
  },
  "49": {
   "jp": "5aaf8bc6",
   "kr": "그치만 전에 볼트에서 보여 줬을 때,"
  },
  "50": {
   "jp": "4043b4a1",
   "kr": "오히려 의심받아서 붙잡혔잖아."
  },
  "51": {
   "jp": "5c42ca0b",
   "kr": "이번엔 괜찮을까…"
  },
  "52": {
   "jp": "2b164493",
   "kr": "그런 소리 할 때가 아니잖아."
  },
  "53": {
   "jp": "c66afd69",
   "kr": "서둘러 폴티아의 상황을"
  },
  "54": {
   "jp": "6f402fc9",
   "kr": "보러 가야 하니까."
  },
  "55": {
   "jp": "f73bbe16",
   "kr": "좋아, 가자."
  },
  "56": {
   "jp": "cbf00f24",
   "kr": "여러분을 통과시킬 수는 없습니다."
  },
  "57": {
   "jp": "ed75275f",
   "kr": "아까 말하는 걸 잊었는데요."
  },
  "58": {
   "jp": "59d87249",
   "kr": "맞아요, 잊었는데요."
  },
  "59": {
   "jp": "f06a0599",
   "kr": "저희 앰비쉬의 사자인데요."
  },
  "60": {
   "jp": "df16179f",
   "kr": "그렇다고요."
  },
  "61": {
   "jp": "6adcae88",
   "kr": "호오, 그러셨습니까."
  },
  "62": {
   "jp": "533976b3",
   "kr": "그럼, 앰비쉬 사자임을 증명할 물건을"
  },
  "63": {
   "jp": "a367f7fb",
   "kr": "가지고 계시겠지요."
  },
  "64": {
   "jp": "e9d015ac",
   "kr": "보여 주시지요."
  },
  "65": {
   "jp": "aca18df2",
   "kr": "물론이죠."
  },
  "66": {
   "jp": "1fafb068",
   "kr": "쥬리오, 꺼내."
  },
  "67": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "68": {
   "jp": "fbc89dd5",
   "kr": "쥬리오는 알프의 반지를 보였다."
  },
  "69": {
   "jp": "ffc491e0",
   "kr": "으〜음."
  },
  "70": {
   "jp": "4c87c03e",
   "kr": "이건 분명 앰비쉬의 문장…"
  },
  "71": {
   "jp": "5bb050c7",
   "kr": "봐요, 어때요?"
  },
  "72": {
   "jp": "6a1c59f9",
   "kr": "진짜 앰비쉬의 문장이지?"
  },
  "73": {
   "jp": "c6451614",
   "kr": "음, 진짜인 것 같군."
  },
  "74": {
   "jp": "60814151",
   "kr": "그런데"
  },
  "75": {
   "jp": "5f01f6d7",
   "kr": "뭔데요?"
  },
  "76": {
   "jp": "cfe1b761",
   "kr": "이걸 어디서 손에 넣었나?"
  },
  "77": {
   "jp": "e5552913",
   "kr": "에엣?"
  },
  "78": {
   "jp": "6c0be8eb",
   "kr": "서, 설마 못 믿어요?"
  },
  "79": {
   "jp": "f4e951dd",
   "kr": "너희 같은 애들끼리 다니는 여행자가"
  },
  "80": {
   "jp": "12a4703c",
   "kr": "앰비쉬의 사자일 리가 없다."
  },
  "81": {
   "jp": "24d4b618",
   "kr": "실례예요."
  },
  "82": {
   "jp": "002d821f",
   "kr": "성인의 의식인 순례 여행을 마쳤으니"
  },
  "83": {
   "jp": "ff5f3edd",
   "kr": "이제 저흰 어엿한 어른이에요."
  },
  "84": {
   "jp": "77216f6f",
   "kr": "순례 여행?"
  },
  "85": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "86": {
   "jp": "227abf48",
   "kr": "앰비쉬의 사자가 아니었던 겐가."
  },
  "87": {
   "jp": "8a87010f",
   "kr": "병사는 의심의 눈초리로 쥬리오 일행을 봤다."
  },
  "88": {
   "jp": "2e24d2da",
   "kr": "아저씨, 성격 고약하네요."
  },
  "89": {
   "jp": "0bae3086",
   "kr": "필시 그 앰비쉬의 반지는"
  },
  "90": {
   "jp": "ac05efed",
   "kr": "어딘가의 도둑 시장에서"
  },
  "91": {
   "jp": "3556f49d",
   "kr": "싸게 손에 넣었겠지!"
  },
  "92": {
   "jp": "f439248a",
   "kr": "너무해요."
  },
  "93": {
   "jp": "2611c25b",
   "kr": "캐라크 왕을 뵙기를 바라다니,"
  },
  "94": {
   "jp": "c0e05b13",
   "kr": "무슨 속셈이냐."
  },
  "95": {
   "jp": "1a978ea3",
   "kr": "수상하군. 조사해야겠다."
  },
  "96": {
   "jp": "dfacd18e",
   "kr": "말도 안 돼…"
  },
  "97": {
   "jp": "029aa145",
   "kr": "역시… 그렇게 되는 거야…"
  },
  "98": {
   "jp": "764773a7",
   "kr": "무슨 볼일이냐?"
  },
  "99": {
   "jp": "98b149cc",
   "kr": "여긴 캐라크 왕의 저택이다."
  },
  "100": {
   "jp": "1cf30ac7",
   "kr": "보통 사람이 들어와도"
  },
  "101": {
   "jp": "1f781175",
   "kr": "되는 곳이 아니다."
  },
  "102": {
   "jp": "b047b6dc",
   "kr": "꽤 쌀쌀맞은 말투네요."
  },
  "103": {
   "jp": "b47d3fe3",
   "kr": "흥."
  },
  "104": {
   "jp": "013cf348",
   "kr": "나는 친절한 편이다."
  },
  "105": {
   "jp": "3658c0cc",
   "kr": "입구 병사는 분명"
  },
  "106": {
   "jp": "f59f7db1",
   "kr": "나보다"
  },
  "107": {
   "jp": "ae175d00",
   "kr": "더 심한 소리를 할 거다."
  },
  "108": {
   "jp": "25e1b074",
   "kr": "그래요? 재미있겠네요."
  },
  "109": {
   "jp": "0f2fcaa7",
   "kr": "만약 입구 병사가"
  },
  "110": {
   "jp": "036bc7d2",
   "kr": "너희를 저택에 들여보내 준다면,"
  },
  "111": {
   "jp": "5ca68239",
   "kr": "난 여기서 물구나무서서 세 번 돌아 주지."
  },
  "112": {
   "jp": "19334782",
   "kr": "약속한 거예요."
  },
  "113": {
   "jp": "5b3c5a6c",
   "kr": "그래그래, 약속이다."
  },
  "114": {
   "jp": "74ee0a78",
   "kr": "여기서부터는 지나가실 수 없습니다."
  },
  "115": {
   "jp": "e14074d5",
   "kr": "일반인의 방문은 허락되지 않습니다."
  },
  "116": {
   "jp": "a02093c0",
   "kr": "부디 돌아가 주십시오."
  },
  "117": {
   "jp": "7377437a",
   "kr": "앰비쉬의 사자라고 했다가,"
  },
  "118": {
   "jp": "d92f0270",
   "kr": "순례 여행자라고 했다가…"
  },
  "119": {
   "jp": "91e50356",
   "kr": "정말 수상한 놈들이다."
  },
  "120": {
   "jp": "9903419e",
   "kr": "순례 여행 도중에"
  },
  "121": {
   "jp": "59688c91",
   "kr": "앰비쉬의 임금님과 친해졌어요."
  },
  "122": {
   "jp": "2c53213f",
   "kr": "얼른 홀크의 임금님께 뵙게 해 줘요."
  },
  "123": {
   "jp": "09d9f564",
   "kr": "할 말이 있단 말이에요."
  },
  "124": {
   "jp": "073f54fe",
   "kr": "솔직히 답하는 게 신상에 좋을 거다."
  },
  "125": {
   "jp": "557efcea",
   "kr": "너희가 정말로"
  },
  "126": {
   "jp": "2f870802",
   "kr": "앰비쉬에서 온 사자인지"
  },
  "127": {
   "jp": "142fcee1",
   "kr": "금방 알게 될 일이다."
  },
  "128": {
   "jp": "6861121e",
   "kr": "이 아저씨,"
  },
  "129": {
   "jp": "7a1dccd3",
   "kr": "남의 말은 전혀 안 듣는 것 같아."
  },
  "130": {
   "jp": "25e274e4",
   "kr": "기가 막히네, 쥬리오."
  },
  "131": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "132": {
   "jp": "fb019af3",
   "kr": "그럼 두세 가지 묻겠다."
  },
  "133": {
   "jp": "6027824b",
   "kr": "우선 너부터다."
  },
  "134": {
   "jp": "bfae1487",
   "kr": "병사는 크리스부터 물었다."
  },
  "135": {
   "jp": "dd55a1a5",
   "kr": "정말로 앰비쉬의 사자라면"
  },
  "136": {
   "jp": "f8522b9b",
   "kr": "이 정도 질문에는"
  },
  "137": {
   "jp": "bea9c63c",
   "kr": "쉽게 답할 수 있을 거다."
  },
  "138": {
   "jp": "a08bae84",
   "kr": "제1문제"
  },
  "139": {
   "jp": "87fb5864",
   "kr": "앰비쉬의 요리장 이름은 무엇이냐?"
  },
  "140": {
   "jp": "b75e1591",
   "kr": "죠르노 씨잖아요."
  },
  "141": {
   "jp": "18adda61",
   "kr": "윽, 정답이다…"
  },
  "142": {
   "jp": "427e854f",
   "kr": "제2문제"
  },
  "143": {
   "jp": "6b4b9a68",
   "kr": "다음은 꼬마."
  },
  "144": {
   "jp": "51285df3",
   "kr": "병사는 쥬리오에게 물었다."
  },
  "145": {
   "jp": "b34a91b6",
   "kr": "앰비쉬의 칸드 마법사로서"
  },
  "146": {
   "jp": "63343bce",
   "kr": "임금님의 고문을 맡고 있는 분의 이름은?"
  },
  "147": {
   "jp": "c75afffb",
   "kr": "모리슨."
  },
  "148": {
   "jp": "ea864914",
   "kr": "함부로 부르는 게 아니다!"
  },
  "149": {
   "jp": "b1caa98c",
   "kr": "씨, 님, 공 같은 걸 붙여라."
  },
  "150": {
   "jp": "2ca740da",
   "kr": "높으신 분이시니까."
  },
  "151": {
   "jp": "21e83e7c",
   "kr": "그치만 친구인걸요."
  },
  "152": {
   "jp": "860d3670",
   "kr": "또 그런 소리를…"
  },
  "153": {
   "jp": "01ca7033",
   "kr": "정말이에요."
  },
  "154": {
   "jp": "3a0a7d8a",
   "kr": "저기요, 방금 거 정답이잖아요."
  },
  "155": {
   "jp": "7ee615f5",
   "kr": "맞았으면 맞았다고 말해 줘."
  },
  "156": {
   "jp": "124107f4",
   "kr": "제3문제!"
  },
  "157": {
   "jp": "ec17b79e",
   "kr": "병사는 휘리에게 물었다."
  },
  "158": {
   "jp": "e5500f3c",
   "kr": "다음은 너다."
  },
  "159": {
   "jp": "39d86c0f",
   "kr": "병사 아저씨, 잠깐요."
  },
  "160": {
   "jp": "ed306d71",
   "kr": "뭐냐?"
  },
  "161": {
   "jp": "d4e94d12",
   "kr": "말해 두겠는데."
  },
  "162": {
   "jp": "3f174db8",
   "kr": "그 아이와는 앰비쉬를 나온 뒤에"
  },
  "163": {
   "jp": "719a89b5",
   "kr": "함께하게 된 거니까,"
  },
  "164": {
   "jp": "617a06c1",
   "kr": "앰비쉬에 대해 물어도 소용없어."
  },
  "165": {
   "jp": "1fe68fd7",
   "kr": "흥, 갈수록 수상하군."
  },
  "166": {
   "jp": "e0b58a35",
   "kr": "고향은?"
  },
  "167": {
   "jp": "c3f08f44",
   "kr": "퓨엔테예요."
  },
  "168": {
   "jp": "e64a8f07",
   "kr": "딱 남북 중간쯤이에요."
  },
  "169": {
   "jp": "3beca1a4",
   "kr": "외딴집에 살아요."
  },
  "170": {
   "jp": "70faf64e",
   "kr": "이름은?"
  },
  "171": {
   "jp": "8c863d5e",
   "kr": "휘리예요."
  },
  "172": {
   "jp": "d535d6fb",
   "kr": "휘리?"
  },
  "173": {
   "jp": "39ca5816",
   "kr": "가만 어디서 들은 이름인데…"
  },
  "174": {
   "jp": "683a43d6",
   "kr": "으음… 휘리…"
  },
  "175": {
   "jp": "20321c3d",
   "kr": "휘리라…"
  },
  "176": {
   "jp": "3adae119",
   "kr": "………"
  },
  "177": {
   "jp": "536774c2",
   "kr": "앗!?"
  },
  "178": {
   "jp": "8203165b",
   "kr": "조약사 리즈의 딸…아아, 그렇구나."
  },
  "179": {
   "jp": "2e42ef67",
   "kr": "리즈의 딸 휘리 양!"
  },
  "180": {
   "jp": "9b6b8276",
   "kr": "네, 그렇습니다만."
  },
  "181": {
   "jp": "656cdb67",
   "kr": "우리 할멈의 신경통 약을"
  },
  "182": {
   "jp": "1314b3dc",
   "kr": "예전에 받으러 간 적이 있지."
  },
  "183": {
   "jp": "144ecb2d",
   "kr": "그 약은 정말 잘 들었다."
  },
  "184": {
   "jp": "29291726",
   "kr": "덕분에 할멈은 지금도 팔팔해."
  },
  "185": {
   "jp": "ae0c735f",
   "kr": "그랬구나 그 휘리 양이었어."
  },
  "186": {
   "jp": "01f76a84",
   "kr": "많이 컸구나."
  },
  "187": {
   "jp": "6a1fe7a3",
   "kr": "그래, 오늘은 무슨 일이니?"
  },
  "188": {
   "jp": "15c5643f",
   "kr": "태도가 확 달라졌잖아."
  },
  "189": {
   "jp": "cdcdbadb",
   "kr": "살았나 봐…"
  },
  "190": {
   "jp": "217c2108",
   "kr": "이 두 분은"
  },
  "191": {
   "jp": "e0b0084e",
   "kr": "쥬리오 씨와 크리스 씨라고 해요."
  },
  "192": {
   "jp": "2c4362ea",
   "kr": "순례 여행에서 오는 길인데"
  },
  "193": {
   "jp": "b0ebfa56",
   "kr": "가도가 봉쇄되어 있어서"
  },
  "194": {
   "jp": "cdd9f856",
   "kr": "자기 나라로 못 돌아가고 곤란해하고 있어요."
  },
  "195": {
   "jp": "45d27814",
   "kr": "홀크 임금님께 가도를 지나가게 해 주십사"
  },
  "196": {
   "jp": "abb5e174",
   "kr": "부탁드리려고 저택에 온 거예요."
  },
  "197": {
   "jp": "7281e54f",
   "kr": "게다가 이대로면 저도 집에 못 돌아가요."
  },
  "198": {
   "jp": "520053fc",
   "kr": "그렇군, 그랬던 건가."
  },
  "199": {
   "jp": "3b44de99",
   "kr": "그거 곤란하겠구나."
  },
  "200": {
   "jp": "32f9eaf4",
   "kr": "캐라크 왕의 명령으로"
  },
  "201": {
   "jp": "e1d73dcc",
   "kr": "가도는 봉쇄되어 있단다."
  },
  "202": {
   "jp": "2d84b70a",
   "kr": "왜 봉쇄 같은 걸 한 거예요?"
  },
  "203": {
   "jp": "f2cfa878",
   "kr": "그, 그건…"
  },
  "204": {
   "jp": "4ffb98a6",
   "kr": "나로선 뭐라 말 못 하겠구나."
  },
  "205": {
   "jp": "5ddc9907",
   "kr": "수상해."
  },
  "206": {
   "jp": "d3849414",
   "kr": "나도 잘은 모르지만,"
  },
  "207": {
   "jp": "4182cc7f",
   "kr": "베라트라는 나그네가 이 저택을 찾아온 뒤로"
  },
  "208": {
   "jp": "aa2d2b28",
   "kr": "임금님의 모습이 이상하단 말이지."
  },
  "209": {
   "jp": "e400a7fb",
   "kr": "그러고 보니,"
  },
  "210": {
   "jp": "1507cbe9",
   "kr": "너희는 앰비쉬의 사자라고 했지."
  },
  "211": {
   "jp": "9bc41ee9",
   "kr": "질문의 답도 맞았고,"
  },
  "212": {
   "jp": "f7d4eeb1",
   "kr": "앰비쉬와 친하다는 것도"
  },
  "213": {
   "jp": "4a5ad49a",
   "kr": "아주 거짓말만은 아닌 듯하다."
  },
  "214": {
   "jp": "c8f33e44",
   "kr": "앰비쉬의 힘을 빌리면,"
  },
  "215": {
   "jp": "13f01e63",
   "kr": "캐라크 왕의 고민도 풀 수 있을지 몰라."
  },
  "216": {
   "jp": "46cf68e9",
   "kr": "괜찮다면 캐라크 왕을 만나"
  },
  "217": {
   "jp": "54443368",
   "kr": "이야기를 들어 주지 않겠느냐?"
  },
  "218": {
   "jp": "aca18df2",
   "kr": "물론이죠."
  },
  "219": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "220": {
   "jp": "446dd713",
   "kr": "캐라크 왕께 뵙기를 청하고 오마."
  },
  "221": {
   "jp": "a5cdf4dd",
   "kr": "잠시 여기서 기다려 다오."
  },
  "222": {
   "jp": "fe1fde80",
   "kr": "홀크 임금님 고민이 뭘까?"
  },
  "223": {
   "jp": "a4296388",
   "kr": "우리가 풀 수 있는 일이면"
  },
  "224": {
   "jp": "be732d6f",
   "kr": "좋겠는데."
  },
  "225": {
   "jp": "740d2469",
   "kr": "여러분."
  },
  "226": {
   "jp": "f8774ff7",
   "kr": "캐라크 왕께서"
  },
  "227": {
   "jp": "48ca3833",
   "kr": "꼭 만나고 싶으시단다."
  },
  "228": {
   "jp": "8f13ec20",
   "kr": "여기 병사들은"
  },
  "229": {
   "jp": "8e006ec7",
   "kr": "다들 고집불통이에요."
  },
  "230": {
   "jp": "920ecd82",
   "kr": "그래도 근본은 나쁜 사람들이 아니니까"
  },
  "231": {
   "jp": "8f7b2b87",
   "kr": "화내지 말아 주세요."
  }
 }
}