   "kr": "볼트"
  },
  "1": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "2": {
   "jp": "daf28e1e",
   "kr": "바위 지대에 오를 발판도 만들었고"
  },
  "3": {
   "jp": "d8f9ddae",
   "kr": "준비는 만전이다."
  },
  "4": {
   "jp": "971209ca",
   "kr": "이제"
  },
  "5": {
   "jp": "7a4112a7",
   "kr": "가루가가 언제 나타나도"
  },
  "6": {
   "jp": "411a871c",
   "kr": "괜찮다고."
  },
  "7": {
   "jp": "b27f4c85",
   "kr": "어때."
  },
  "8": {
   "jp": "8a794939",
   "kr": "바다에서 온 화톳불 길을"
  },
  "9": {
   "jp": "73a159ba",
   "kr": "여기서 횃불로 잇는 거야."
  },
  "10": {
   "jp": "cfe787c6",
   "kr": "사전 조사에 따르면"
  },
  "11": {
   "jp": "0c79b262",
   "kr": "가루가는 불꽃을 따라 이동한다니까."
  },
  "12": {
   "jp": "4ba0793c",
   "kr": "이걸로 틀림없이"
  },
  "13": {
   "jp": "c23af752",
