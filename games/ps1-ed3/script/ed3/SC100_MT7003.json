{
 "archive": "/SCE1/SC100.DAT",
 "member": "..\\DATA\\MT7003.BIN",
 "lines": {
  "0": {
   "jp": "ea7ef945",
   "kr": "타라타호"
  },
  "1": {
   "jp": "fcb6f9f2",
   "kr": "갑판"
  },
  "2": {
   "jp": "5cc70478",
   "kr": "어부 토바이"
  },
  "3": {
   "jp": "ce0fbc7a",
   "kr": "에메나"
  },
  "4": {
   "jp": "0adf5788",
   "kr": "인타"
  },
  "5": {
   "jp": "0159e9b1",
   "kr": "림!"
  },
  "6": {
   "jp": "d9a123e8",
   "kr": "잘 있어어!!"
  },
  "7": {
   "jp": "fd92abe3",
   "kr": "안녀엉!!"
  },
  "8": {
   "jp": "86e34052",
   "kr": "림의 목소리"
  },
  "9": {
   "jp": "a65c9e30",
   "kr": "인타!"
  },
  "10": {
   "jp": "b4352170",
   "kr": "꼭 편지 보내라아!"
  },
  "11": {
   "jp": "8cd804a2",
   "kr": "안녕히 계세요, 비아노 씨〜!"
  },
  "12": {
   "jp": "89354770",
   "kr": "비아노의 목소리"
  },
  "13": {
   "jp": "3fe3ee44",
   "kr": "순례 여행자들!"
  },
  "14": {
   "jp": "b7b8cc25",
   "kr": "인타네를 부탁한다!"
  },
  "15": {
   "jp": "a78e5863",
   "kr": "비아노 씨도 잘 지내세요!"
  },
  "16": {
   "jp": "c4e2525b",
   "kr": "안녕히 계세요!"
  },
  "17": {
   "jp": "59eaacc6",
   "kr": "출발 진행!!"
  },
  "18": {
   "jp": "c8fdec29",
   "kr": "갑판은 춥잖여."
  },
  "19": {
   "jp": "3b3a26c6",
   "kr": "이 계절 바닷바람은 몸에 사무친다고."
  },
  "20": {
   "jp": "e5549c5d",
   "kr": "안에 들어가는 게 좋여."
  },
  "21": {
   "jp": "ec23a819",
   "kr": "자, 이쪽이여."
  },
  "22": {
   "jp": "3908100d",
   "kr": "쥬리오"
  },
  "23": {
   "jp": "ede5fefc",
   "kr": "네갈섬에도 여러 사람이 있었네."
  },
  "24": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "25": {
   "jp": "c903bb02",
   "kr": "그래도 다들 좋은 사람뿐이었어."
  },
  "26": {
   "jp": "ff9ba434",
   "kr": "그러네."
  },
  "27": {
   "jp": "c7b2e065",
   "kr": "저기, 크리스."
  },
  "28": {
   "jp": "7a2444eb",
   "kr": "20년 전에 우리처럼 여행한 마녀는"
  },
  "29": {
   "jp": "c64fdb91",
   "kr": "어떤 사람이었을까."
  },
  "30": {
   "jp": "5a23f9f7",
   "kr": "지금 메나트의 나쁜 일은 마녀의"
  },
  "31": {
   "jp": "be3887fa",
   "kr": "저주라는 사람도 있고 이탄으로 살게 된"
  },
  "32": {
   "jp": "1b9e9aad",
   "kr": "건 마녀 덕분이라고 고마워하는 사람도 있어."
  },
  "33": {
   "jp": "357033d6",
   "kr": "하얀마녀는 좋은 사람이었을까."
  },
  "34": {
   "jp": "75356312",
   "kr": "아니면 옛날이야기 속 마녀처럼"
  },
  "35": {
   "jp": "06550214",
   "kr": "무섭고 두려운 사람이었을까."
  },
  "36": {
   "jp": "9a7f9562",
   "kr": "역시 마녀라고 하면"
  },
  "37": {
   "jp": "35a0c5ae",
   "kr": "무서운 할머니를 상상해 버리지."
  },
  "38": {
   "jp": "bd5ae5fc",
   "kr": "근데 하얀마녀는 그렇지 않은 모양이야."
  },
  "39": {
   "jp": "0c666adf",
   "kr": "허크 삼촌한테"
  },
  "40": {
   "jp": "884af5ca",
   "kr": "조금 더 이야기를 들어 뒀으면"
  },
  "41": {
   "jp": "317d4a11",
   "kr": "좋았을 텐데."
  },
  "42": {
   "jp": "314db196",
   "kr": "인타 녀석, 너무 기운이 넘쳐."
  },
  "43": {
   "jp": "1fca19a5",
   "kr": "줄곧 혼자서"
  },
  "44": {
   "jp": "2ade666d",
   "kr": "해적 놀이를 하고 있어야."
  },
  "45": {
   "jp": "5d0adb73",
   "kr": "배 진로라면 걱정 없어야."
  },
  "46": {
   "jp": "9b117d52",
   "kr": "참, 치타 가는 길 무너진 벼랑은"
  },
  "47": {
   "jp": "5df0d895",
   "kr": "아직 안 치웠을 텡께"
  },
  "48": {
   "jp": "c0364b73",
   "kr": "벼랑 너머까지 배로 데려다주겄어."
  },
  "49": {
   "jp": "ffaa3fb2",
   "kr": "고마워요, 살았어요."
  },
  "50": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "51": {
   "jp": "1888a9ac",
   "kr": "돌아갈 땐 바람이 반대라 말이여."
  },
  "52": {
   "jp": "fc6d0de8",
   "kr": "붙어서 안 보고 있으면"
  },
  "53": {
   "jp": "c7f74c87",
   "kr": "배가 말을 안 들어서."
  },
  "54": {
   "jp": "dcabea53",
   "kr": "와〜아, 와〜아!"
  },
  "55": {
   "jp": "4fc0941b",
   "kr": "저기, 나는 캡틴 토마스야."
  },
  "56": {
   "jp": "28cbbc41",
   "kr": "나쁜 해적 라몬은"
  },
  "57": {
   "jp": "5a2bf754",
   "kr": "저 돛대 아래에 잡아 뒀어."
  },
  "58": {
   "jp": "12509c9e",
   "kr": "왜 내가 라몬인 거여…"
  },
  "59": {
   "jp": "3284a0b2",
   "kr": "엄마."
  },
  "60": {
   "jp": "98a50379",
   "kr": "나 해적 라몬을 잡았어."
  },
  "61": {
   "jp": "4326974d",
   "kr": "어머 어머…"
  },
  "62": {
   "jp": "58da2845",
   "kr": "토바이 씨"
  },
  "63": {
   "jp": "a9b4daf1",
   "kr": "죄송해요."
  },
  "64": {
   "jp": "fbad6f7e",
   "kr": "헤엥!"
  },
  "65": {
   "jp": "01e190f3",
   "kr": "괜찮다니께."
  },
  "66": {
   "jp": "7d7034fd",
   "kr": "어차피 나는 라몬 역이제."
  },
  "67": {
   "jp": "6c52c3dc",
   "kr": "와하하하하…!"
  },
  "68": {
   "jp": "41128d72",
   "kr": "라몬은 달아났다아!"
  },
  "69": {
   "jp": "8533b48f",
   "kr": "앗, 서라아!"
  },
  "70": {
   "jp": "2e3fdb65",
   "kr": "토바이 덕분에 메나트 대륙으로 가는"
  },
  "71": {
   "jp": "44a3c298",
   "kr": "항해는 즐겁게 이어졌다."
  },
  "72": {
   "jp": "b5f580eb",
   "kr": "쥬리오 일행은 새삼스레"
  },
  "73": {
   "jp": "2a2e649a",
   "kr": "여행지에서 만나는 이들의 따스함을 느꼈다."
  },
  "74": {
   "jp": "8f8e55dc",
   "kr": "이윽고 대륙이 가까워졌다."
  },
  "75": {
   "jp": "c2d956ac",
   "kr": "눈앞에 메나트 대륙의 절벽이 다가왔다."
  },
  "76": {
   "jp": "ae1fd6d8",
   "kr": "토바이는 쥬리오 일행이 치타로 갈 수 있도록"
  },
  "77": {
   "jp": "19611997",
   "kr": "알데 항에 배를 대지 않고 벼랑 무너진"
  },
  "78": {
   "jp": "1e2974f4",
   "kr": "곳을 넘은 자리에 배를 대 주기로 했다."
  },
  "79": {
   "jp": "0d20f4af",
   "kr": "에메나 모자는 한동안 알데에서 지내다"
  },
  "80": {
   "jp": "4ac00cce",
   "kr": "자리를 잡고 나서 닐리로 가기로 했다."
  },
  "81": {
   "jp": "791930b7",
   "kr": "상냥한 닐리 사람들이라면 인타를 따뜻이"
  },
  "82": {
   "jp": "d3a119d3",
   "kr": "맞아 주리라고 쥬리오는 생각했다."
  },
  "83": {
   "jp": "b44f853d",
   "kr": "좋았어, 쥬리오, 크리스."
  },
  "84": {
   "jp": "8d8d3a04",
   "kr": "저 절벽 아래에 댈 거여!"
  },
  "85": {
   "jp": "7444402d",
   "kr": "준비는 됐냐?"
  },
  "86": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "87": {
   "jp": "4ed3b1a4",
   "kr": "준비됐어요!"
  },
  "88": {
   "jp": "5a5083ed",
   "kr": "근데 저 험한 절벽을"
  },
  "89": {
   "jp": "b90d6337",
   "kr": "오를 수 있어요?"
  },
  "90": {
   "jp": "0e6a318f",
   "kr": "저 절벽은 보기엔 험해도"
  },
  "91": {
   "jp": "bb221811",
   "kr": "의외로 쉽게 오를 수 있어야."
  },
  "92": {
   "jp": "ab016ab0",
   "kr": "너희라면 괜찮을 것이여."
  }
 }
}