 "member": "..\\DATA\\MR3400.BIN",
 "lines": {
  "0": {
   "jp": "b2b851f8",
   "kr": "토파즈 해안"
  },
  "1": {
   "jp": "6c819bfe",
   "kr": "어머, 유목이야."
  },
  "2": {
   "jp": "234bcad2",
   "kr": "조류에 떠밀려서"
  },
  "3": {
   "jp": "33aa7e7c",
   "kr": "어딘가 나라에서 흘러온 거구나."
  },
  "4": {
   "jp": "a58fd7d5",
   "kr": "이 근처에 흘러온다면"
  },
  "5": {
   "jp": "58b37c14",
   "kr": "동쪽에 떠 있는 로프섬 쪽에서"
  },
  "6": {
   "jp": "cc52b2f2",
   "kr": "떠내려왔겠지."
  },
  "7": {
   "jp": "4fc3b222",
   "kr": "바다를 천천히 흘러왔구나."
  },
  "8": {
   "jp": "69c162ef",
   "kr": "왠지 낭만적이네."
  },
  "9": {
   "jp": "beea4abd",
   "kr": "그런가. 가루가에게 부서진 마을의 잔해도"
  },
  "10": {
   "jp": "2d6514db",
   "kr": "이렇게 어딘가에 밀려오겠지."
  },
  "11": {
   "jp": "a2a67bc4",
   "kr": "나는 그쪽이 연상되는군."
  },
  "12": {
   "jp": "92b1276c",
   "kr": "가자."
  },
  "13": {
   "jp": "328dae05",
   "kr": "이런 데서 노닥거릴"
  },
  "14": {
   "jp": "af425afd",
   "kr": "틈은 없다."
  }
 }
}