  },
  "165": {
   "jp": "c96fbc1a",
   "kr": "반대하기는 뭣하네만…"
  },
  "166": {
   "jp": "0fc478b1",
   "kr": "역시 나는 이번 징병에는"
  },
  "167": {
   "jp": "1774802e",
   "kr": "찬성할 수 없네!"
  },
  "168": {
   "jp": "437ae67f",
   "kr": "아니 아니."
  },
  "169": {
   "jp": "39c17ad1",
   "kr": "촌장인 내가"
  },
  "170": {
   "jp": "f9c7dae6",
   "kr": "이런 말을 하면 안 되지."
  },
  "171": {
   "jp": "53015f8e",
   "kr": "같이 여행해 온"
  },
  "172": {
   "jp": "3cafe3f1",
   "kr": "여자애는 찾았니?"
  },
  "173": {
   "jp": "7620e655",
   "kr": "크리스."
  },
  "174": {
   "jp": "204d70a7",
   "kr": "네가 사라져서"
  },
  "175": {
   "jp": "df264018",
   "kr": "큰일이었단다."
  },
  "176": {
   "jp": "7455b70c",
   "kr": "정말!"
  },
  "177": {
   "jp": "0b161841",
   "kr": "쥬리오 때문에 창피해!"
  },
  "178": {
   "jp": "b03469f6",
   "kr": "그런 소리 해도"
  },
  "179": {
   "jp": "acffd067",
   "kr": "그렇게 갑자기 사라지면"
  },
  "180": {
   "jp": "fd238b53",
   "kr": "누구라도 놀란다고."
  },
  "181": {
   "jp": "2e60c934",
   "kr": "얼른 그이가 병사를 그만두고"
  },
  "182": {
   "jp": "11097fe3",
   "kr": "돌아오지 않으려나."
  },
  "183": {
   "jp": "401b895c",
   "kr": "난 이제 걱정돼서…"
  },
  "184": {
   "jp": "a15e1af6",
   "kr": "아빠는 있잖아"
  },
  "185": {
   "jp": "cfe78d2a",
   "kr": "엄청 세다고…"
  },
  "186": {
   "jp": "3a490040",
   "kr": "그치만"
  },
  "187": {
   "jp": "1a4d8f34",
   "kr": "같이 있어 주는 편이 좋아."
  },
  "188": {
   "jp": "9c5d53d1",
   "kr": "으…"
  },
  "189": {
   "jp": "788d7dd8",
   "kr": "나는… 군대 같은 데…"
  },
  "190": {
   "jp": "98b41bc0",
   "kr": "정말 고마워."
  },
  "191": {
   "jp": "cc98aa42",
   "kr": "몸이 제대로 돌아오면"
  },
  "192": {
   "jp": "4f7b9cc0",
   "kr": "바로 출발할게."
  },
  "193": {
   "jp": "29243022",
   "kr": "너희와 이 마을 사람들은"
  },
  "194": {
   "jp": "4c56397b",
   "kr": "군대에 쫓기는 우리를 감싸 줬어."
  },
  "195": {
   "jp": "6ebd6160",
   "kr": "이건 평생 잊지 않을게."
  },
  "196": {
   "jp": "786bbde1",
   "kr": "부디 한시라도 빨리 약을 부탁드려요."
  },
  "197": {
   "jp": "3fa0be45",
   "kr": "얼른 크리스 씨에게 약을 건네주세요."
  },
  "198": {
   "jp": "1bd7a8c9",
   "kr": "저는 약을 다룰 줄 잘 모르니까요."
  },
  "199": {
   "jp": "25b88271",
   "kr": "괜찮았어?"
  },
  "200": {
   "jp": "503222cf",
   "kr": "병사에게 안 들켰겠지?"
  },
  "201": {
   "jp": "6179790f",
   "kr": "조금은 믿어 줘."
  },
  "202": {
   "jp": "e85b95aa",
   "kr": "자, 감기약이야."
  },
  "203": {
   "jp": "a08b1f9c",
   "kr": "쥬리오는 크리스에게 감기약을 건넸다."
  },
  "204": {
   "jp": "a3cfcb61",
   "kr": "서둘러, 쥬리오!"
  },
  "205": {
   "jp": "22c5dbb9",
   "kr": "부디 병사에게 들키지 마."
  }
 }
}
