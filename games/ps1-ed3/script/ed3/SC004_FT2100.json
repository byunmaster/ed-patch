{
 "archive": "/SCE0/SC004.DAT",
 "member": "..\\DATA\\FT2100.BIN",
 "lines": {
  "0": {
   "jp": "1f7ed7e9",
   "kr": "라그나"
  },
  "1": {
   "jp": "a395403f",
   "kr": "무기상 다론"
  },
  "2": {
   "jp": "52b6cd4e",
   "kr": "네라 부인"
  },
  "3": {
   "jp": "ed232c66",
   "kr": "카리가 촌장"
  },
  "4": {
   "jp": "8eb6d99d",
   "kr": "셰릴"
  },
  "5": {
   "jp": "ff5ca88e",
   "kr": "아네트"
  },
  "6": {
   "jp": "7810af62",
   "kr": "레로"
  },
  "7": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "8": {
   "jp": "b1d5a167",
   "kr": "조이"
  },
  "9": {
   "jp": "37a4fdad",
   "kr": "패드"
  },
  "10": {
   "jp": "7af25326",
   "kr": "이 잠긴 문은 뭘까?"
  },
  "11": {
   "jp": "dc029ce4",
   "kr": "왠지 기분 나쁜 암호네."
  },
  "12": {
   "jp": "3029fa09",
   "kr": "…울보 쥬리오."
  },
  "13": {
   "jp": "581948c3",
   "kr": "소리가 작아!"
  },
  "14": {
   "jp": "be7acc44",
   "kr": "쳇. 뭐야…"
  },
  "15": {
   "jp": "bd33044a",
   "kr": "울보 쥬리오!!"
  },
  "16": {
   "jp": "38090482",
   "kr": "좋아."
  },
  "17": {
   "jp": "b9322cf0",
   "kr": "어째서 이런 데 숨어 있는 거야?"
  },
  "18": {
   "jp": "377ca4e9",
   "kr": "됐으니 얼른 들어와."
  },
  "19": {
   "jp": "3d74d9e1",
   "kr": "쥬리오 씨군요."
  },
  "20": {
   "jp": "f43056d3",
   "kr": "걱정을 끼쳐 죄송했습니다."
  },
  "21": {
   "jp": "0d159ef4",
   "kr": "전 패드입니다."
  },
  "22": {
   "jp": "ba854a27",
   "kr": "누워 있는 게 동료인 조이입니다."
  },
  "23": {
   "jp": "5ff3c181",
   "kr": "패드와 조이는 탈주병이래."
  },
  "24": {
   "jp": "5d34ddcb",
   "kr": "탈주병?"
  },
  "25": {
   "jp": "8b593b1d",
   "kr": "루드에서 억지로 병사로 끌려가서"
  },
  "26": {
   "jp": "345c72a6",
   "kr": "배로 달아나려고 라그나까지 왔대."
  },
  "27": {
   "jp": "678613a4",
   "kr": "그렇습니다."
  },
  "28": {
   "jp": "87a24ec9",
   "kr": "조금만 더 있으면 배를 탈 수 있었는데"
  },
  "29": {
   "jp": "7cfd4fb0",
   "kr": "조이가 병에 걸려 버려서…"
  },
  "30": {
   "jp": "3d6dd05e",
   "kr": "군에 수배돼 있어서"
  },
  "31": {
   "jp": "ad1326d3",
   "kr": "꼼짝할 수가 없습니다."
  },
  "32": {
   "jp": "81f3779b",
   "kr": "그래서 저 항구의 인파 속에서"
  },
  "33": {
   "jp": "89d7adcc",
   "kr": "친절해 보여서 나한테 말을 건 거야."
  },
  "34": {
   "jp": "bfe0ff2f",
   "kr": "누가 친절해 보인다고?"
  },
  "35": {
   "jp": "bf46703c",
   "kr": "나야. 뻔하잖아."
  },
  "36": {
   "jp": "d88a03d5",
   "kr": "아무튼 쥬리오."
  },
  "37": {
   "jp": "576dc055",
   "kr": "조이의 상태는 눈을 뗄 수 없을 만큼 나빠."
  },
  "38": {
   "jp": "f1da8af3",
   "kr": "내 마법으론 어쩔 도리가 없을 정도로."
  },
  "39": {
   "jp": "de8d9b04",
   "kr": "쥬리오, 약을 사 와."
  },
  "40": {
   "jp": "45d39323",
   "kr": "병사에게 들키지 않게 해야 해."
  },
  "41": {
   "jp": "8d588cc0",
   "kr": "믿고 있을게."
  },
  "42": {
   "jp": "0eb28f83",
   "kr": "이걸로 약을 사다 주세요."
  },
  "43": {
   "jp": "9a621d9c",
   "kr": "아마 모자라진 않을 겁니다."
  },
  "44": {
   "jp": "55f117de",
   "kr": "혹시 거스름돈이 남으면"
  },
  "45": {
   "jp": "16bec72e",
   "kr": "작은 성의니까"
  },
  "46": {
   "jp": "6f3506b5",
   "kr": "넣어 두세요."
  },
  "47": {
   "jp": "ea7bac1a",
   "kr": "엣, 정말요?"
  },
  "48": {
   "jp": "c9bbbe97",
   "kr": "괜찮아요?"
  },
  "49": {
   "jp": "9a8161a8",
   "kr": "네, 죄송하지만"
  },
  "50": {
   "jp": "e4996b3c",
   "kr": "잘 부탁드립니다."
  },
  "51": {
   "jp": "9f04cc9c",
   "kr": "쥬리오는"
  },
  "52": {
   "jp": "8f8076a7",
   "kr": ", 받았습니다."
  },
  "53": {
   "jp": "e778eba3",
   "kr": "운명의 장난으로, 한동안 집을 비웁니다."
  },
  "54": {
   "jp": "35e4fc47",
   "kr": "BY허크"
  },
  "55": {
   "jp": "85fd21bb",
   "kr": "오, 꼬마. 늦었구나."
  },
  "56": {
   "jp": "80eee190",
   "kr": "한참 기다렸다고."
  },
  "57": {
   "jp": "0e656f67",
   "kr": "암호는 「울보 쥬리오」다."
  },
  "58": {
   "jp": "90534653",
   "kr": "뭐예요?"
  },
  "59": {
   "jp": "26a6c66d",
   "kr": "그 암호…"
  },
  "60": {
   "jp": "97a19d06",
   "kr": "크리스라는 애가 부탁하더군."
  },
  "61": {
   "jp": "c8307623",
   "kr": "한 번 더 말해 줄까?"
  },
  "62": {
   "jp": "a85d258a",
   "kr": "알았다니까요."
  },
  "63": {
   "jp": "77db1e8d",
   "kr": "한 번 들으면 알아요."
  },
  "64": {
   "jp": "1048e4ec",
   "kr": "창고 문 앞에 서서 암호를 말해 보라고."
  },
  "65": {
   "jp": "7527a4ef",
   "kr": "그 애가 나올 거다."
  },
  "66": {
   "jp": "0dd57bf4",
   "kr": "창고 문 앞에서 암호를 말하라고."
  },
  "67": {
   "jp": "75996ab0",
   "kr": "손님인가… 말해 두지만, 난 누가 봐도"
  },
  "68": {
   "jp": "89590c85",
   "kr": "고집불통 영감이야. 돈을 아무리 쌓아도"
  },
  "69": {
   "jp": "faac64b1",
   "kr": "쓸 사람에게 맞는 무기밖에 안 팔아."
  },
  "70": {
   "jp": "4668d703",
   "kr": "너희라면 이쯤이 알맞겠지."
  },
  "71": {
   "jp": "15054edb",
   "kr": "받을게."
  },
  "72": {
   "jp": "94e64e60",
   "kr": "소중히 써 줘."
  },
  "73": {
   "jp": "c539a1aa",
   "kr": "필요 없는 건 사 주지."
  },
  "74": {
   "jp": "c7c822f1",
   "kr": "긴 여행엔 가벼운 쪽이 편하니까."
  },
  "75": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "76": {
   "jp": "cb19c981",
   "kr": "에 사도록 하지."
  },
  "77": {
   "jp": "6fe63e1c",
   "kr": "환율은 1 Goa가 15 Pia다."
  },
  "78": {
   "jp": "d899c729",
   "kr": "너만 괜찮다면 사들이도록 하지."
  },
  "79": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "80": {
   "jp": "407e4279",
   "kr": "겠군."
  },
  "81": {
   "jp": "302100f9",
   "kr": "라피카가 없는 모양이군."
  },
  "82": {
   "jp": "04c0ecd4",
   "kr": "힘내서 벌어 오라고."
  },
  "83": {
   "jp": "6eb5bc45",
   "kr": "그 밖엔 무슨 볼일이지?"
  },
  "84": {
   "jp": "9ee6835b",
   "kr": "또 들르라고."
  },
  "85": {
   "jp": "ce4fefdc",
   "kr": "아아, 그때 그 꼬마구나."
  },
  "86": {
   "jp": "0837428d",
   "kr": "세월 가는 건 빠르기도 하지."
  },
  "87": {
   "jp": "4f3912af",
   "kr": "울보 꼬마가 이렇게 의젓해져서."
  },
  "88": {
   "jp": "d2eca6df",
   "kr": "같이 온 아가씨와 떨어졌다고?"
  },
  "89": {
   "jp": "9122d82e",
   "kr": "마을 사람에게 물어보렴."
  },
  "90": {
   "jp": "6a651937",
   "kr": "누군가 본 사람이 있을지도 모르니까."
  },
  "91": {
   "jp": "83bba635",
   "kr": "촌장으로서 그토록 괴로운 소임은 처음이었네."
  },
  "92": {
   "jp": "ef4e96f0",
   "kr": "입대를 원치 않는 이까지"
  },
  "93": {
   "jp": "86359adf",
   "kr": "징병해야 하다니."
  },
  "94": {
   "jp": "c6710a65",
   "kr": "왜 그러니? 시무룩한 얼굴을 하고서."
  },
  "95": {
   "jp": "a5eccff3",
   "kr": "혹시 길을 잃은 거니?"
  },
  "96": {
   "jp": "95d93e39",
   "kr": "엇? 그, 그런 거 아니에요."
  },
  "97": {
   "jp": "28783181",
   "kr": "혼자서도 끄떡없다고요."
  },
  "98": {
   "jp": "846af1a9",
   "kr": "역시 길을 잃었구나."
  },
  "99": {
   "jp": "d5b02654",
   "kr": "또 길을 잃어버렸구나."
  },
  "100": {
   "jp": "3435328a",
   "kr": "앗, 너, 혹시…"
  },
  "101": {
   "jp": "d4d66eda",
   "kr": "언젠가 길을 잃고 울던 애 맞지?"
  },
  "102": {
   "jp": "c0b09db6",
   "kr": "역시 그렇구나!"
  },
  "103": {
   "jp": "226694ca",
   "kr": "반갑네. 그래, 순례 여행이구나."
  },
  "104": {
   "jp": "4aca1b98",
   "kr": "이젠 길을 잃어도 울면 안 된다."
  },
  "105": {
   "jp": "1e55180e",
   "kr": "찾아와 줘서 기뻐."
  },
  "106": {
   "jp": "cb996eb1",
   "kr": "라그나는 어때? 왕도보다는 작지만"
  },
  "107": {
   "jp": "937a9b70",
   "kr": "예쁜 마을이지."
  },
  "108": {
   "jp": "cd82b9b9",
   "kr": "멋진 여자친구랑 함께니까"
  },
  "109": {
   "jp": "68be8595",
   "kr": "여기저기 구경하고 가렴."
  },
  "110": {
   "jp": "4937418a",
   "kr": "이렇게 어린아이를 두고"
  },
  "111": {
   "jp": "77bf289b",
   "kr": "루드로 가 버리다니…"
  },
  "112": {
   "jp": "dc86b3d6",
   "kr": "남자는 왜 병사를 동경하는 걸까?"
  },
  "113": {
   "jp": "8c435f50",
   "kr": "아빠, 아빠는 있잖아…"
  },
  "114": {
   "jp": "f565ab46",
   "kr": "군대에 가 버렸어."
  },
  "115": {
   "jp": "9c5d53d1",
   "kr": "으…"
  },
  "116": {
   "jp": "819821d4",
   "kr": "난..군대 따위…"
  },
  "117": {
   "jp": "5951c8f6",
   "kr": "미리아…"
  },
  "118": {
   "jp": "c541377a",
   "kr": "이제 곧..돌아갈게.."
  },
  "119": {
   "jp": "fc36cf43",
   "kr": "…미리아는 조이의 약혼자입니다."
  },
  "120": {
   "jp": "f006c05e",
   "kr": "징병만 없었다면 지금쯤 결혼식을"
  },
  "121": {
   "jp": "c118ddf3",
   "kr": "올렸을 텐데…"
  },
  "122": {
   "jp": "267fda08",
   "kr": "죄송해요, 쥬리오 씨."
  },
  "123": {
   "jp": "939d5130",
   "kr": "제가 갔다가 들키면 왕도로 끌려가고 맙니다."
  },
  "124": {
   "jp": "6a9cfa2a",
   "kr": "부디, 조이를 위해 약을…"
  },
  "125": {
   "jp": "461320ac",
   "kr": "네. 병사는 무서우니까요."
  },
  "126": {
   "jp": "9497e80e",
   "kr": "맡겨 주세요."
  },
  "127": {
   "jp": "34584cba",
   "kr": "부디 잘 부탁드립니다."
  },
  "128": {
   "jp": "a3cfcb61",
   "kr": "서둘러, 쥬리오!"
  },
  "129": {
   "jp": "1913dc77",
   "kr": "어쨌든 열을 내려야 해."
  }
 }
}