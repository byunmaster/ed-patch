{
 "archive": "/SCE5/SC504.DAT",
 "member": "..\\DATA\\ST0100.BIN",
 "lines": {
  "0": {
   "jp": "57e30d30",
   "kr": "홀크"
  },
  "1": {
   "jp": "f98f24bc",
   "kr": "에니 할머니"
  },
  "2": {
   "jp": "7144f143",
   "kr": "마지오 장로"
  },
  "3": {
   "jp": "c2dc8996",
   "kr": "칸드의 쟝"
  },
  "4": {
   "jp": "008bd540",
   "kr": "슈노"
  },
  "5": {
   "jp": "60167348",
   "kr": "사나"
  },
  "6": {
   "jp": "c3f56eb1",
   "kr": "앗티"
  },
  "7": {
   "jp": "ff8af593",
   "kr": "홀크 병사"
  },
  "8": {
   "jp": "ac1af797",
   "kr": "안 되겠어."
  },
  "9": {
   "jp": "1948b991",
   "kr": "도로 공사가 끝날 때까지 못 지나가."
  },
  "10": {
   "jp": "79380486",
   "kr": "이쪽으로 가면"
  },
  "11": {
   "jp": "c23b3cbf",
   "kr": "요새가 나오는구나."
  },
  "12": {
   "jp": "eff3e870",
   "kr": "여왕님께서 살아 계실 적엔"
  },
  "13": {
   "jp": "e392a5b7",
   "kr": "캐라크 왕도 에네톤 왕도"
  },
  "14": {
   "jp": "bedf9195",
   "kr": "사이가 좋았다만."
  },
  "15": {
   "jp": "c552e1ad",
   "kr": "남북으로 겨루지 말고"
  },
  "16": {
   "jp": "7a7bf553",
   "kr": "형제 둘이 사이좋게 퓨엔테를"
  },
  "17": {
   "jp": "04f18caa",
   "kr": "다스려 주었으면 싶구먼."
  },
  "18": {
   "jp": "a532bc86",
   "kr": "그 처자가 말한 그대로구먼…"
  },
  "19": {
   "jp": "4f8132af",
   "kr": "말한 그대로라뇨?"
  },
  "20": {
   "jp": "b146ceac",
   "kr": "예전에…"
  },
  "21": {
   "jp": "4209a889",
   "kr": "벌써 20년쯤 전이 되려나…"
  },
  "22": {
   "jp": "3a92eca4",
   "kr": "하얀마녀가"
  },
  "23": {
   "jp": "ed892be6",
   "kr": "이곳을 찾았을 때 하신 말씀이지."
  },
  "24": {
   "jp": "664c38a8",
   "kr": "『어미가 피를 나눔은 나라 가름이 아니다』"
  },
  "25": {
   "jp": "1164151a",
   "kr": "하얀마녀는 그렇게 말했단다."
  },
  "26": {
   "jp": "aed4bf57",
   "kr": "마법은 몸을 지키기 위해 써 주세요."
  },
  "27": {
   "jp": "f8ffb1d7",
   "kr": "숲의 동물을 괴롭히거나 하면 안 돼요."
  },
  "28": {
   "jp": "764d4c9b",
   "kr": "다루실 분이 계시면"
  },
  "29": {
   "jp": "32bd9a92",
   "kr": "칸드 마법을 가르쳐 드리죠."
  },
  "30": {
   "jp": "e05b07d9",
   "kr": "어느 분께 가르쳐 드릴까요?"
  },
  "31": {
   "jp": "27c29648",
   "kr": "어느 마법을 익히시겠어요?"
  },
  "32": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "33": {
   "jp": "f7f576a8",
   "kr": "제가 필요해지시면"
  },
  "34": {
   "jp": "c61fc2a3",
   "kr": "언제든 들러 주세요."
  },
  "35": {
   "jp": "e059d347",
   "kr": "임금님은 가도를 봉쇄하고"
  },
  "36": {
   "jp": "66f47bb2",
   "kr": "대체 무엇을 하실 셈일까."
  },
  "37": {
   "jp": "32d0975a",
   "kr": "설마"
  },
  "38": {
   "jp": "239a53d2",
   "kr": "북부와 전쟁할 생각은 아니겠지."
  },
  "39": {
   "jp": "6ceb088f",
   "kr": "임금님은 그 수상쩍은 여행자의"
  },
  "40": {
   "jp": "90806dd9",
   "kr": "꾐에 넘어가 계신 게 아닐까."
  },
  "41": {
   "jp": "8a1f6fc2",
   "kr": "걱정이야."
  },
  "42": {
   "jp": "4390d2b8",
   "kr": "퓨엔테는 어떻게 되어 버릴까."
  },
  "43": {
   "jp": "12886ca6",
   "kr": "엣, 가도가 봉쇄됐다고?"
  },
  "44": {
   "jp": "f8ad0912",
   "kr": "세 갈래 다 막힌 걸까…"
  },
  "45": {
   "jp": "b31939a1",
   "kr": "남북 가도는 도로 공사 때문에"
  },
  "46": {
   "jp": "5ea8acd2",
   "kr": "막았다고 들었는데"
  },
  "47": {
   "jp": "ceca077b",
   "kr": "다른 데도 공사를 시작한 걸까."
  },
  "48": {
   "jp": "6264aa33",
   "kr": "여긴 통행금지다."
  },
  "49": {
   "jp": "2228bd0d",
   "kr": "루피나스 호수 가가 질척이니까"
  },
  "50": {
   "jp": "1a49b391",
   "kr": "길을 고치고 있다."
  },
  "51": {
   "jp": "52d3e7e0",
   "kr": "포기하고 다른 길로 가라."
  },
  "52": {
   "jp": "4d23c286",
   "kr": "그런 말 해 봤자"
  },
  "53": {
   "jp": "3cb1775a",
   "kr": "다른 길도"
  },
  "54": {
   "jp": "9c649d31",
   "kr": "못 지나가잖아요!"
  },
  "55": {
   "jp": "e2b6b678",
   "kr": "그, 그렇게… 화내지 마…"
  },
  "56": {
   "jp": "93496b3b",
   "kr": "이야기는 들었어요."
  },
  "57": {
   "jp": "7dcd3323",
   "kr": "우리를 위해 진실을 찾아 주십시오!"
  }
 }
}