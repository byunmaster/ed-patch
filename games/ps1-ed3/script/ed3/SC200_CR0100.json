 "lines": {
  "0": {
   "jp": "c0e6c7cc",
   "kr": "트루츠 가도"
  },
  "1": {
   "jp": "214fa9c5",
   "kr": "우디"
  },
  "2": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "3": {
   "jp": "8e5a6bde",
   "kr": "나그네라니 드물군."
  },
  "4": {
   "jp": "0800362b",
   "kr": "어라?"
  },
  "5": {
   "jp": "5be2789f",
   "kr": "오."
  },
  "6": {
   "jp": "56254541",
   "kr": "허허, 루레 영감님."
  },
  "7": {
   "jp": "05697358",
   "kr": "안녕하세요."
  },
  "8": {
   "jp": "9aa11dc1",
   "kr": "아저씨는 여기 혼자 사세요?"
  },
  "9": {
   "jp": "e3bcca60",
   "kr": "그렇다네."
  },
  "10": {
   "jp": "c009d2d5",
   "kr": "가끔 손님이 오면 차를 권하는 게"
  },
  "11": {
   "jp": "029f9661",
   "kr": "유일한 낙이지."
  },
  "12": {
   "jp": "6aea4fce",
   "kr": "어떤가?"
  },
  "13": {
   "jp": "84659dac",
   "kr": "허브차라도 마시고 가지 않겠나?"
  },
  "14": {
   "jp": "0547b8da",
   "kr": "와아."
  },
  "15": {
   "jp": "e19336d0",
   "kr": "실례할게요〜"
  },
  "16": {
   "jp": "53493da9",
   "kr": "안녕하신가."
  },
  "17": {
   "jp": "c7a5bda8",
   "kr": "여어, 우디 씨."
  },
  "18": {
   "jp": "22c95139",
   "kr": "오늘도 건강해 보이는구먼."
  },
  "19": {
   "jp": "66a8592d",
   "kr": "호오, 오늘은 일행이 많군."
  },
  "20": {
   "jp": "8dc4f4f9",
   "kr": "떠들썩한 건 좋은 일이지."
  },
  "21": {
   "jp": "daf34ce4",
   "kr": "소개하지."
  },
  "22": {
   "jp": "de79acbc",
   "kr": "이 사람은 내 친구인"
  },
  "23": {
   "jp": "e506952d",
   "kr": "나무꾼 우디 씨."
  },
  "24": {
   "jp": "6ab54c33",
   "kr": "이쪽은 관문에서 함께한 사람들이네."
  },
  "25": {
   "jp": "82e83f1c",
   "kr": "어디…"
  },
  "26": {
   "jp": "eaa21833",
   "kr": "어디 보자…"
  },
  "27": {
   "jp": "70354164",
   "kr": "……"
  },
  "28": {
   "jp": "e338c614",
   "kr": "누구였더라?"
  },
  "29": {
   "jp": "20cda86e",
   "kr": "쥬리오&크리스&로디"
  },
  "30": {
   "jp": "9fd58c52",
   "kr": "털썩…"
  },
  "31": {
   "jp": "64e2ce5e",
   "kr": "그러고 보니"
  },
  "32": {
   "jp": "16e9f461",
   "kr": "아직 이름을 안 물었구먼."
  },
  "33": {
   "jp": "b9db24de",
   "kr": "저는 크리스예요."
  },
  "34": {
   "jp": "d9551584",
   "kr": "저는 쥬리오예요."
  },
  "35": {
   "jp": "c14a6255",
   "kr": "저랑 크리스는 폴티아 왕국의"
  },
  "36": {
   "jp": "cc2d3a97",
   "kr": "라그픽 마을에서 왔어요."
  },
  "37": {
   "jp": "1821eb14",
   "kr": "성인의 의식으로 순례 여행을 하고 있어요."
  },
  "38": {
   "jp": "eb154e52",
   "kr": "난 로디다."
  },
  "39": {
   "jp": "0a56feb3",
   "kr": "사정이 있어 이들과 여행 중이지만"
  },
  "40": {
   "jp": "5b0aad35",
   "kr": "내 목적지는 볼트다."
  },
  "41": {
   "jp": "7707a2c5",
   "kr": "쥬리오, 크리스와는 다르다."
  },
  "42": {
   "jp": "06211d57",
   "kr": "그런가."
  },
  "43": {
   "jp": "c2b03d6d",
   "kr": "뭐, 아무튼"
  },
  "44": {
   "jp": "a4f02e80",
   "kr": "허브티라도 어떤가?"
  },
  "45": {
   "jp": "4a835283",
   "kr": "와아, 허브티."
  },
  "46": {
   "jp": "2f18a79d",
   "kr": "마침 목이 말랐어요."
  },
  "47": {
   "jp": "8467d48d",
   "kr": "참, 쥬리오도 정말."
  },
  "48": {
   "jp": "9b87a30a",
   "kr": "괜찮아, 괜찮아."
  },
  "49": {
   "jp": "d250a7ef",
   "kr": "들어와, 들어와."
  },
  "50": {
   "jp": "c509d64e",
   "kr": "쥬리오 일행은 우디에게"
  },
  "51": {
   "jp": "6e7b276c",
   "kr": "허브티를 대접받았다."
  },
  "52": {
   "jp": "f609d923",
   "kr": "맛있어."
  },
  "53": {
   "jp": "8a554cc9",
   "kr": "정말이네."
  },
  "54": {
   "jp": "4b6b9e56",
   "kr": "이렇게 맛있는 허브티"
  },
  "55": {
   "jp": "d8ec7e81",
   "kr": "태어나서 처음이야."
  },
  "56": {
   "jp": "bd02ac3c",
   "kr": "맛있군."
  },
  "57": {
   "jp": "806f8b49",
   "kr": "기쁜 말을 해 주는구먼."
  },
  "58": {
   "jp": "8c608a05",
   "kr": "이런 곳에서 혼자 살잖나."
  },
  "59": {
   "jp": "21994f56",
   "kr": "취미라면 허브티 정도지."
  },
  "60": {
   "jp": "ddd7f8ec",
   "kr": "틈나면 배합을 이것저것 궁리해서"
  },
  "61": {
   "jp": "dcd36892",
   "kr": "손님한테"
  },
  "62": {
   "jp": "1eabf949",
   "kr": "루레 영감님한테"
  },
  "63": {
   "jp": "ae115228",
   "kr": "마시게 하고 있다네."
  },
  "64": {
   "jp": "da3f7fda",
   "kr": "네, 정말 맛있어요."
  },
  "65": {
   "jp": "c4f499c7",
   "kr": "오늘 건 각별하네."
  },
  "66": {
   "jp": "06211d57",
   "kr": "그런가."
  },
  "67": {
   "jp": "41636165",
   "kr": "잘됐군. 잘됐군."
  },
  "68": {
   "jp": "8eed12c5",
   "kr": "그럼 이 차에"
  },
  "69": {
   "jp": "1379ded3",
   "kr": "그럼 이번에도"
  },
  "70": {
   "jp": "0691b500",
   "kr": "좋은 이름을 붙여 주게."
  },
  "71": {
   "jp": "30854d59",
   "kr": "이 차를 마시면 어쩐지"
  },
  "72": {
   "jp": "a5a9ca07",
   "kr": "푸하〜 하고 뱃속이 따뜻해지네."
  },
  "73": {
   "jp": "44224c71",
   "kr": "그래, 그렇군."
  },
  "74": {
   "jp": "c0cc2ee4",
   "kr": "그럼, 푸핫이니까"
  },
  "75": {
   "jp": "110746ca",
   "kr": "푸허브차라는 건 어떨까?"
  },
  "76": {
   "jp": "0e485a32",
   "kr": "하하하, 푸핫이니까"
  },
  "77": {
   "jp": "33b886fd",
   "kr": "푸허브차라…"
  },
  "78": {
   "jp": "97f69889",
   "kr": "이거 영 재미없군."
  },
  "79": {
   "jp": "d419e3ca",
   "kr": "이야, 푸허브차입니까."
  },
  "80": {
   "jp": "5dbd7124",
   "kr": "즐겁고 꽤 좋은 이름이네요."
  },
  "81": {
   "jp": "9880d7b7",
   "kr": "잘 먹었어요."
  },
  "82": {
   "jp": "2af0c987",
   "kr": "으음."
  },
  "83": {
   "jp": "9a85263c",
   "kr": "로열 스트레이트 플러시!"
  },
  "84": {
   "jp": "fe8c3c1a",
   "kr": "라는 건 어떤가."
  },
  "85": {
   "jp": "72e6983f",
   "kr": "또 도박과 관계된 이름이야?"
  },
  "86": {
   "jp": "8eacf70c",
   "kr": "분명 지난번 건"
  },
  "87": {
   "jp": "0b1db635",
   "kr": "풀하우스 앤드 페어였지."
  },
  "88": {
   "jp": "43249788",
   "kr": "뭐, 괜찮지만."
  },
  "89": {
   "jp": "b4855a64",
   "kr": "그럼, 그렇게 할까."
  },
  "90": {
   "jp": "7631e6a8",
   "kr": "음, 좋은 이름일세."
  },
  "91": {
   "jp": "274245cb",
   "kr": "그럼"
  },
  "92": {
   "jp": "7e63d92b",
   "kr": "오자마자 미안하네만"
  },
  "93": {
   "jp": "aacb5109",
   "kr": "이만 실례하겠네."
  },
  "94": {
   "jp": "691f4237",
   "kr": "이상한 이름을 붙였더니"
  },
  "95": {
   "jp": "219e010b",
   "kr": "얼른 카지노에 가서"
  },
  "96": {
   "jp": "a8576e80",
   "kr": "내기를 하고 싶어졌어."
  },
  "97": {
   "jp": "91e7e341",
   "kr": "뭐야"
  },
  "98": {
   "jp": "807fbb0b",
   "kr": "이상한 이름인 줄"
  },
  "99": {
   "jp": "fef71416",
   "kr": "알고 있잖아."
  },
  "100": {
   "jp": "7fa3fe6b",
   "kr": "오늘은 잘 들러 줬구먼."
  },
  "101": {
   "jp": "05110d41",
   "kr": "또 기회가 있으면 들러 주게나."
  },
  "102": {
   "jp": "29b55ae9",
   "kr": "자, 새 허브티"
  },
  "103": {
   "jp": "2edf4548",
   "kr": "배합이라도"
  },
  "104": {
   "jp": "9b8b30b3",
   "kr": "궁리해 볼까."
  },
  "105": {
   "jp": "e7c1ca77",
   "kr": "뭐 두고 갔나?"
  },
  "106": {
   "jp": "7abcbebe",
   "kr": "아무것도 안 떨어져 있던데."
  },
  "107": {
   "jp": "d8ecd6be",
   "kr": "아니, 한마디만 하고 싶어서."
  },
  "108": {
   "jp": "acd0f142",
   "kr": "뭔가?"
  },
  "109": {
   "jp": "bdee671f",
   "kr": "오늘은 딴다네."
  },
  "110": {
   "jp": "556b594c",
   "kr": "또 그 소리."
  },
  "111": {
   "jp": "f4d69e14",
   "kr": "늘 그렇게 말해 놓고"
  },
  "112": {
   "jp": "ee129803",
   "kr": "빈털터리로"
  },
  "113": {
   "jp": "12004c97",
   "kr": "돌아오면서."
  }
 }
}