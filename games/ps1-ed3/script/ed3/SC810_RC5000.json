{
 "archive": "/SCE8/SC810.DAT",
 "member": "..\\DATA\\RC5000.BIN",
 "lines": {
  "0": {
   "jp": "4651181e",
   "kr": "이자벨의 탑"
  },
  "1": {
   "jp": "97006fb3",
   "kr": "음…?"
  },
  "2": {
   "jp": "384591a1",
   "kr": "이 책은…"
  },
  "3": {
   "jp": "20cf7ad9",
   "kr": "책등에"
  },
  "4": {
   "jp": "08fa9a96",
   "kr": "《검은 파도 소환법》"
  },
  "5": {
   "jp": "a986a7bc",
   "kr": "이"
  },
  "6": {
   "jp": "738306f4",
   "kr": "적힌 책이 있다."
  },
  "7": {
   "jp": "2b84b9c1",
   "kr": "듀르젤은 손에 들고 책을 펼쳐 보았다."
  },
  "8": {
   "jp": "08fa9a96",
   "kr": "《검은 파도 소환법》"
  },
  "9": {
   "jp": "29ef76ca",
   "kr": "이계의 검은 파도는 인간이 내뿜는 탄식의"
  },
  "10": {
   "jp": "cf90ad27",
   "kr": "상념에 끌려온다. 오해, 질투, 전쟁…"
  },
  "11": {
   "jp": "b7a3d6fa",
   "kr": "마음에 숨은 탄식의 씨앗은 무한하다."
  },
  "12": {
   "jp": "9b8d194e",
   "kr": "온갖 탄식의 상념은 정해진 핵 물체를 향해"
  },
  "13": {
   "jp": "0bb633f9",
   "kr": "응축돼 검은 파도를 끄는 힘이 된다."
  },
  "14": {
   "jp": "0e7302b5",
   "kr": "점성술과 마법을 쓰면 힘은 더욱 강해져"
  },
  "15": {
   "jp": "3a6b9738",
   "kr": "검은 파도의 유인을 확실히 하리라."
  },
  "16": {
   "jp": "b2d6b72c",
   "kr": "수상한 책이 잔뜩 늘어서 있다."
  },
  "17": {
   "jp": "671932e9",
   "kr": "쥬리오 일행이 상자를 열었다."
  },
  "18": {
   "jp": "42bb1277",
   "kr": "반지가 있지만, 더는 못 들겠어."
  },
  "19": {
   "jp": "e047da36",
   "kr": "나중에 받으면 되잖아."
  },
  "20": {
   "jp": "e9d91b01",
   "kr": ", 손에 넣었다."
  }
 }
}