{
 "archive": "/SCE4/SC403.DAT",
 "member": "..\\DATA\\UR1100.BIN",
 "lines": {
  "0": {
   "jp": "5391c7b8",
   "kr": "미혹의 숲"
  },
  "1": {
   "jp": "06f6d2f0",
   "kr": "어라."
  },
  "2": {
   "jp": "fa09bef7",
   "kr": "나무다…"
  },
  "3": {
   "jp": "e830638f",
   "kr": "마치 우리를 부르는 것 같아…"
  },
  "4": {
   "jp": "ba05b1bf",
   "kr": "아, 맞다!"
  },
  "5": {
   "jp": "b7805b99",
   "kr": "응?"
  },
  "6": {
   "jp": "57788ebe",
   "kr": "저, 저기 말이야…"
  },
  "7": {
   "jp": "8c6b25cd",
   "kr": "생각났어."
  },
  "8": {
   "jp": "63c609fc",
   "kr": "그러니까 뭘?"
  },
  "9": {
   "jp": "045041d8",
   "kr": "시플의 마법의 거울로 봤어."
  },
  "10": {
   "jp": "9d3d3221",
   "kr": "저 나무들."
  },
  "11": {
   "jp": "98cfd8df",
   "kr": "나무들을?"
  },
  "12": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "13": {
   "jp": "2372c081",
   "kr": "게다가 나도 크리스도"
  },
  "14": {
   "jp": "e37455ae",
   "kr": "숲을 걷는 영상을 봤어."
  },
  "15": {
   "jp": "ac5135e0",
   "kr": "딱 지금처럼."
  },
  "16": {
   "jp": "f90028b3",
   "kr": "그러고 보니"
  },
  "17": {
   "jp": "329621f4",
   "kr": "쥬리오 씨 일행은 순례 여행자"
  },
  "18": {
   "jp": "e92fc82a",
   "kr": "였지요."
  },
  "19": {
   "jp": "2c14bc55",
   "kr": "마법의 거울은 보는 사람의 미래를 비추거나"
  },
  "20": {
   "jp": "89c6867b",
   "kr": "경고나 예언을 정령들이 주는"
  },
  "21": {
   "jp": "27f3a528",
   "kr": "곳이라고 들은 적이 있어요."
  },
  "22": {
   "jp": "2a18d624",
   "kr": "분명 쥬리오 씨가"
  },
  "23": {
   "jp": "8ccfe16a",
   "kr": "이곳에 오게 될 걸"
  },
  "24": {
   "jp": "c58d27d1",
   "kr": "암시했던 거로군요."
  },
  "25": {
   "jp": "5a6f7beb",
   "kr": "알그레스란 어떤 성수일까…"
  },
  "26": {
   "jp": "64c2cb86",
   "kr": "나는 마법의 거울에서"
  },
  "27": {
   "jp": "ae3bc35b",
   "kr": "물소 같은 동물을 숲속에서 봤어."
  },
  "28": {
   "jp": "7c4d275c",
   "kr": "그거예요, 분명."
  },
  "29": {
   "jp": "adb09366",
   "kr": "쥬리오 씨 일행이"
  },
  "30": {
   "jp": "a42306b8",
   "kr": "앞으로 알그레스의 뿔이 필요한 걸 알고"
  },
  "31": {
   "jp": "3631fd21",
   "kr": "마법의 거울을 통해 알려 준 거예요."
  },
  "32": {
   "jp": "1c401bdd",
   "kr": "하지만 누가?"
  },
  "33": {
   "jp": "aa7b9f42",
   "kr": "하얀마녀일까…"
  },
  "34": {
   "jp": "ee59869f",
   "kr": "아는 사이야?"
  },
  "35": {
   "jp": "b868be2e",
   "kr": "그런 건 아니지만…"
  },
  "36": {
   "jp": "c6af8d2a",
   "kr": "왠지 그런 생각이 들었을 뿐이야."
  },
  "37": {
   "jp": "fa22efbf",
   "kr": "누구든 상관없어."
  },
  "38": {
   "jp": "f6920251",
   "kr": "뭐, 여기 온 게"
  },
  "39": {
   "jp": "e13cb06d",
   "kr": "헛걸음은 아니란 거네."
  }
 }
}