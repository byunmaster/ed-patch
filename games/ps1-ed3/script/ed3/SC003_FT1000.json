  },
  "3": {
   "jp": "cb7a2160",
   "kr": "디네의 현자"
  },
  "4": {
   "jp": "31d68e84",
   "kr": "사서관 루트스"
  },
  "5": {
   "jp": "d62f7f2f",
   "kr": "행상인 코레트"
  },
  "6": {
   "jp": "1c7e7bdb",
   "kr": "바시카"
  },
  "7": {
   "jp": "ca48e89f",
   "kr": "호제"
  },
  "8": {
   "jp": "12746fb3",
   "kr": "이린"
  },
  "9": {
   "jp": "cb7a2160",
   "kr": "디네의 현자"
  },
  "10": {
   "jp": "bb1889d9",
   "kr": "누구신지요?"
  },
  "11": {
   "jp": "fc0e58d3",
   "kr": "저, 저희는 라그픽에서 왔어요…"
  },
  "12": {
   "jp": "f3836d07",
   "kr": "오오, 그 단검은…"
  },
  "13": {
   "jp": "6191dfd0",
   "kr": "순례자가 이곳을 찾은 건 몇 해 만입니다."
  },
  "14": {
   "jp": "964ff091",
   "kr": "필시 피곤하실 테니 푹 쉬십시오."
  },
  "15": {
   "jp": "3b6e0d24",
   "kr": "엄청 예쁘다면서요?"
  },
  "16": {
   "jp": "b26cd9f0",
   "kr": "마법의 거울 말이에요."
  },
  "17": {
   "jp": "24edad70",
   "kr": "피로보다도 조금이라도 빨리 마법의 거울을"
  },
  "18": {
   "jp": "2da818dc",
   "kr": "보고 싶어 견딜 수 없나 보군요."
  },
  "19": {
   "jp": "eaa781f3",
   "kr": "좋습니다."
  },
  "20": {
   "jp": "36b39ae0",
   "kr": "허나, 마법의 거울을 보기 전에"
  },
  "21": {
   "jp": "d60a8b15",
   "kr": "제 이야기를 들어 주셔야만 합니다."
  },
  "22": {
   "jp": "326fe61f",
   "kr": "지금 다섯 곳에 남아 있는 이 샤리네들은"
  },
  "23": {
   "jp": "b0d5273a",
   "kr": "사람 기억 너머 옛날에 티라스일을 찾은"
  },
  "24": {
   "jp": "2b2ae679",
   "kr": "마녀들이 세운 것입니다."
  },
  "25": {
   "jp": "00fa2b2e",
   "kr": "마녀?"
  },
  "26": {
   "jp": "367fc737",
   "kr": "마법사가 아니라… 마녀라고요…?"
  },
  "27": {
   "jp": "c1e81450",
   "kr": "그렇습니다. 마녀입니다."
  },
  "28": {
   "jp": "a2b53628",
   "kr": "마녀들은 우리와 달리 주문을 외우지 않아도"
  },
  "29": {
   "jp": "b846e245",
   "kr": "마음먹는 것만으로 마법을 썼지요."
  },
  "30": {
   "jp": "9b9e9729",
   "kr": "이제는 이 샤리네를 찾는 이도 적어져"
  },
  "31": {
   "jp": "948d0152",
   "kr": "마녀들도, 그들의 위업도"
  },
  "32": {
   "jp": "8af92622",
   "kr": "아는 이가 드물어지고 말았습니다."
  },
  "33": {
   "jp": "bfe77d4d",
   "kr": "본디 이 샤리네는 마법을 전수하고"
  },
  "34": {
   "jp": "becc46ae",
   "kr": "마녀의 예언을 돕는 곳이어야 합니다."
  },
  "35": {
   "jp": "96d4c6b9",
   "kr": "저희 여행과 무슨 관계가 있나요?"
  },
  "36": {
   "jp": "77980f1a",
   "kr": "무관하지 않습니다."
  },
  "37": {
   "jp": "6f170a5d",
   "kr": "라그픽 마을의 성인식은 마녀들의 예언을"
  },
  "38": {
   "jp": "880d2b77",
   "kr": "보는 데서 비롯되었다고 합니다."
  },
  "39": {
   "jp": "ade6dcd9",
   "kr": "마법의 거울은 마녀나 아이에게만 보이거든요."
  },
  "40": {
   "jp": "4acf4f91",
   "kr": "그래서 14살에 떠나는 겁니다."
  },
  "41": {
   "jp": "d441352d",
   "kr": "저기… 저, 작년에 병으로…"
  },
  "42": {
   "jp": "b732c4e6",
   "kr": "사실은 벌써 15살이에요."
  },
  "43": {
   "jp": "6d916a5f",
   "kr": "나이는 라그픽 마을의 규칙일 뿐입니다."
  },
  "44": {
   "jp": "0e6a6f16",
   "kr": "분명 괜찮을 겁니다."
  },
  "45": {
   "jp": "f18b0421",
   "kr": "마법의 거울을 믿는 순수한 마음만 있다면."
  },
  "46": {
   "jp": "108a6d1d",
   "kr": "그럼 거울 방으로 안내하지요."
  },
  "47": {
   "jp": "8bd74389",
   "kr": "…두 분 말씀대로라면 갑자기 마법의 거울에"
  },
  "48": {
   "jp": "193a5e11",
   "kr": "먹구름이 꼈다는 말씀이군요?"
  },
  "49": {
   "jp": "7f840aaf",
   "kr": "깜짝 놀랐어요."
  },
  "50": {
   "jp": "30efd040",
   "kr": "그전까지는 무척 예쁜 경치였는데요."
  },
  "51": {
   "jp": "7f484088",
   "kr": "뭔가 나쁜 일이 일어나는 건 아닐까요?"
  },
  "52": {
   "jp": "b730682a",
   "kr": "여태 이런 이야기는 들어 본 적이 없습니다."
  },
  "53": {
   "jp": "63fecdda",
   "kr": "아마 마법의 거울은 순례에 대한"
  },
  "54": {
   "jp": "5c5784b4",
   "kr": "그대들의 불안을 비춘 것이겠지요."
  },
  "55": {
   "jp": "2cfe2622",
   "kr": "그러니 여행에 익숙해지면…"
  },
  "56": {
   "jp": "088f4264",
   "kr": "그렇지요, 다음 테그라 샤리네에선"
  },
  "57": {
   "jp": "8d98b3d8",
   "kr": "멋진 경치를 만날 수 있을 겁니다."
  },
  "58": {
   "jp": "3d5053be",
   "kr": "라그나에서 배로 메나트에 건너가"
  },
  "59": {
   "jp": "832a75c9",
   "kr": "네갈섬으로 향하십시오."
  },
  "60": {
   "jp": "bc0a1573",
   "kr": "거기에 땅의 샤리네가 있습니다."
  },
  "61": {
   "jp": "7fdd886e",
   "kr": "그곳이 다음에 찾아야 할 곳입니다."
  },
  "62": {
   "jp": "40a34fa8",
   "kr": "이제 그런 경치는 보기 싫어요."
  },
  "63": {
   "jp": "35238b2f",
   "kr": "분명 괜찮을 겁니다."
  },
  "64": {
   "jp": "09f43c29",
   "kr": "분명…"
  },
  "65": {
   "jp": "8627ffe5",
   "kr": "혹시 피곤하시다면"
  },
  "66": {
   "jp": "4320d785",
   "kr": "원하는 만큼 이 샤리네에 머무르십시오."
  },
  "67": {
   "jp": "1c2c2879",
   "kr": "참, 현자님."
  },
  "68": {
   "jp": "2a3d2937",
   "kr": "오는 길에 다리가 무너져 있던데"
  },
  "69": {
   "jp": "7fe80a83",
   "kr": "어떻게 된 건가요?"
  },
  "70": {
   "jp": "cced116f",
   "kr": "아, 그 다리 말이군요."
  },
  "71": {
   "jp": "504633f5",
   "kr": "밧줄이 낡았던 모양입니다."
  },
  "72": {
   "jp": "b0c760ad",
   "kr": "루데라 관문의 병사에게"
  },
  "73": {
   "jp": "c32363c5",
   "kr": "수리를 부탁해 두었으니"
  },
  "74": {
   "jp": "3c475e54",
   "kr": "이제 고쳐졌을 겁니다."
  },
  "75": {
   "jp": "d8986072",
   "kr": "그럼 가는 길 조심하십시오."
  },
  "76": {
   "jp": "526330ae",
   "kr": "라그픽 마을 분이시군요?"
  },
  "77": {
   "jp": "971f877a",
   "kr": "혹시 서적에 관심이 있으시다면, 옆 서고를"
  },
  "78": {
   "jp": "900f4775",
   "kr": "둘러보십시오."
  },
  "79": {
   "jp": "6885dfdc",
   "kr": "순례나 샤리네에 관한 것이"
  },
  "80": {
   "jp": "0a2c5061",
   "kr": "적힌 책도 있습니다."
  },
  "81": {
   "jp": "2bcd3967",
   "kr": "마법의 거울 방에 들어가고 싶다면"
  },
  "82": {
   "jp": "a7b4b844",
   "kr": "왼쪽 안쪽 방에 이 샤리네 현자가 계십니다."
  },
  "83": {
   "jp": "b8cb8dd2",
   "kr": "그분께 은단검을 보이십시오."
  },
  "84": {
   "jp": "ec5d9733",
   "kr": "마법의 거울에 불길한 풍경이 비쳤다고요?"
  },
  "85": {
   "jp": "e5084579",
   "kr": "그건… 그래서 현자께선 뭐라 하시던가요?"
  },
  "86": {
   "jp": "e3d49c36",
   "kr": "…음."
  },
  "87": {
   "jp": "60366826",
   "kr": "그러시다면 제가 알려 드릴 것은 없습니다."
  },
  "88": {
   "jp": "70e9f9b7",
   "kr": "거울의 답은 올도스에 있다."
  },
  "89": {
   "jp": "22c90e39",
   "kr": "그리 말해 두지요."
  },
  "90": {
   "jp": "516329cc",
   "kr": "어머, 라그픽 마을에서 왔구나."
  },
  "91": {
   "jp": "05ba17a9",
   "kr": "오는 길에 다치진 않았니?"
  },
  "92": {
   "jp": "a0a9caf1",
   "kr": "마음껏 쉬다 가렴."
  },
  "93": {
   "jp": "cc5d63d5",
   "kr": "여기 현자님들은"
  },
  "94": {
   "jp": "f872c197",
   "kr": "늘 어려운 책만 읽고 계셔서,"
  },
  "95": {
   "jp": "61d12506",
   "kr": "시중드는 난 심심하거든."
  },
  "96": {
   "jp": "1647ef15",
   "kr": "라그픽 마을엔"
  },
  "97": {
   "jp": "70e691df",
   "kr": "멋진 풍습이 있어서 좋겠다."
  },
  "98": {
   "jp": "9d0b4fb1",
   "kr": "둘이서 여행할 수 있다니"
  },
  "99": {
   "jp": "aa6478ba",
   "kr": "정말 부러워."
  },
  "100": {
   "jp": "cd254d56",
   "kr": "순례 여행자를 상대로"
  },
  "101": {
   "jp": "f05efefd",
   "kr": "장사할 수 있다니 운이 좋군."
  },
  "102": {
   "jp": "6ffb68ec",
   "kr": "자, 무엇을 찾으시나?"
  },
  "103": {
   "jp": "aa4b0120",
   "kr": "뭐, 보기만 해도 좋고."
  },
  "104": {
   "jp": "24a2c314",
   "kr": "나름대로 물건은 제법 갖춰 놨다고."
  },
  "105": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "106": {
   "jp": "0acce0d1",
   "kr": "면 되겠어."
  },
  "107": {
   "jp": "186fa5cf",
   "kr": "진귀한 물건을 가졌나?"
  },
  "108": {
   "jp": "abb8567e",
   "kr": "그렇다면,"
  },
  "109": {
   "jp": "d6d96edb",
   "kr": "로 바꿔 줄게."
  },
  "110": {
   "jp": "3abcfddf",
   "kr": "이런, 마수와 싸웠나?"
  },
  "111": {
   "jp": "ba814f56",
   "kr": "어린 나이에 장하구먼."
  },
  "112": {
   "jp": "fd037570",
   "kr": "좋아, 인심 쓰지!"
  },
  "113": {
   "jp": "8b348557",
   "kr": "1 Goa당 16 Pia에 사 주지."
  },
  "114": {
   "jp": "a58aaaf5",
   "kr": "이 되겠군."
  },
  "115": {
   "jp": "4f41e0ca",
   "kr": "구경만 하면 곤란해."
  },
  "116": {
   "jp": "d6a9d4db",
   "kr": "나도 장사하는 몸이라고."
  },
  "117": {
   "jp": "11e7f512",
   "kr": "이제 볼일은 없나?"
  },
  "118": {
   "jp": "2e40b670",
   "kr": "한동안은 여기 있을 테니"
  },
  "119": {
   "jp": "3fcaf993",
   "kr": "부담 없이 들르라고."
  },
  "120": {
   "jp": "e79fd6cb",
   "kr": "여어, 안녕."
  },
  "121": {
   "jp": "8214e25b",
   "kr": "알고 있나? 라그픽 마을 순례자가"
  },
  "122": {
   "jp": "24a94402",
   "kr": "온다는군."
  },
  "123": {
   "jp": "ff772361",
   "kr": "어쩌면"
  },
  "124": {
   "jp": "7184f0ef",
   "kr": "마법의 거울을 보여 줄지도 모른다 싶어서"
  },
  "125": {
   "jp": "c0c6ad99",
   "kr": "이렇게 기다리는 거라네."
  },
  "126": {
   "jp": "b0d6879c",
   "kr": "거울 방엔 순례자만 들어갈 수 있어요."
  },
  "127": {
   "jp": "5aaf72ab",
   "kr": "게다가 벌써 끝나 버렸어요."
  },
  "128": {
   "jp": "ab343751",
   "kr": "끝났다…?"
  },
  "129": {
   "jp": "19a1a9bf",
   "kr": "이럴 수가…"
  },
  "130": {
   "jp": "49a86ea5",
   "kr": "모처럼 라그나에서 찾아왔는데."
  },
  "131": {
   "jp": "46038c96",
   "kr": "아이고…"
  },
  "132": {
   "jp": "92d44e3d",
   "kr": "아, 너희구나."
  },
  "133": {
   "jp": "2754c3b2",
   "kr": "난 현자님 밑에서 일하고 있단다."
  },
  "134": {
   "jp": "3e63c90e",
   "kr": "여기서 수행을 마치면 올도스로 가서"
  },
  "135": {
   "jp": "f39975aa",
   "kr": "장래에는 훌륭한 현자가 되어 보이겠다."
  },
  "136": {
   "jp": "1a40bfa9",
   "kr": "쥬리오는 노트 한 권을 펼쳤다."
  },
  "137": {
   "jp": "bd9e833b",
   "kr": "봐, 이것 봐."
  },
  "138": {
   "jp": "2b46a026",
   "kr": "이 노트에 촌장님이랑 로그 이름이 있어."
  },
  "139": {
   "jp": "c8d3f124",
   "kr": "정말이네."
  },
  "140": {
   "jp": "ff3de8cc",
   "kr": "아, 우리 아빠랑 엄마 이름도 있어."
  },
  "141": {
   "jp": "c9e339e2",
   "kr": "우리 이름도 적어 놓자."
  },
  "142": {
   "jp": "98ab916b",
   "kr": "…쥬리오는 글씨가 엉망이네."
  },
  "143": {
   "jp": "fcd7a0aa",
   "kr": "하아…"
  },
  "144": {
   "jp": "3f37383c",
   "kr": "이 노트를 라그픽 마을 아이들이"
  },
  "145": {
   "jp": "d7e6ab12",
   "kr": "본다고 생각하면…"
  },
  "146": {
   "jp": "92d9c191",
   "kr": "칫."
  },
  "147": {
   "jp": "c2b059ce",
   "kr": "그럼 크리스가 쓰면 됐잖아."
  },
  "148": {
   "jp": "068850d3",
   "kr": "쥬리오는 먼지 쌓인 책을 펼쳤다."
  },
  "149": {
   "jp": "6b722814",
   "kr": "《마녀의 순례》"
  },
  "150": {
   "jp": "145378ed",
   "kr": "샤리네를 도는 마녀가 사라진 지 오래다."
  },
  "151": {
   "jp": "7c15ab21",
   "kr": "마녀들은 어디로 갔을까. 그녀들은"
  },
  "152": {
   "jp": "774ed6b1",
   "kr": "이제 마법의 거울이 필요 없는 걸까?"
  },
  "153": {
   "jp": "949d4a0e",
   "kr": "디네 샤리네를 찾은 마지막 마녀의 기록은"
  },
  "154": {
   "jp": "3b024a78",
   "kr": "가가브력 971년 하얀 마녀의 방문에서"
  },
  "155": {
   "jp": "ac9d55f3",
   "kr": "끊겨 있다. 이후 마녀의 방문은 기록되지"
  },
  "156": {
   "jp": "718899e7",
   "kr": "않고, 마을 관습으로 사람의 순례만 남았다."
  },
  "157": {
   "jp": "11b11520",
   "kr": "어려운 책이네."
  },
  "158": {
   "jp": "1d17c2f9",
   "kr": "졸리기만 해."
  },
  "159": {
   "jp": "3bc701b8",
   "kr": "쥬리오는 책 한 권을 펼쳤다."
  },
  "160": {
   "jp": "8982390b",
   "kr": "《각지의 샤리네》"
  },
  "161": {
   "jp": "db718067",
   "kr": "티라스일에는 다섯 샤리네가 있어"
  },
  "162": {
   "jp": "b54ece6a",
   "kr": "저마다 그 땅에 뿌리내린 역할을 맡는다."
  },
  "163": {
   "jp": "c62b20cc",
   "kr": "물을 다스리는 디네, 땅의 기둥 테그라"
  },
  "164": {
   "jp": "4fabeca9",
   "kr": "불꽃의 수호 이그니스, 바람을 맡은 시플"
  },
  "165": {
   "jp": "53d5d7e6",
   "kr": "그리고 이들을 아우르는 하늘의 올도스다."
  },
  "166": {
   "jp": "b846349f",
   "kr": "쥬리오는 일기 한 권을 펼쳤다."
  },
  "167": {
   "jp": "95f21383",
   "kr": "《마이 다이어리》"
  },
  "168": {
   "jp": "73a4983f",
   "kr": "○월 ×일"
  },
  "169": {
   "jp": "bde3411e",
   "kr": "오늘은 아침부터 비가 내린다."
  },
  "170": {
   "jp": "bd3c7fa5",
   "kr": "그 사람은 지금쯤…"
  },
  "171": {
   "jp": "6b390065",
   "kr": "앗, 제 일기는 읽지 말아 주세요!"
  },
  "172": {
   "jp": "58b8c553",
   "kr": "죄송해요."
  },
  "173": {
   "jp": "2b9ea21a",
   "kr": "쥬리오는 동화 한 권을 펼쳤다."
  },
  "174": {
   "jp": "e893efb1",
   "kr": "《캡틴 토마스》"
  },
  "175": {
   "jp": "55357532",
   "kr": "노을에 물든 에메랄드해에서는"
  },
  "176": {
   "jp": "4e1b6b95",
   "kr": "캡틴 토마스와 해적왕 라몬의"
  },
  "177": {
   "jp": "b7aa77e0",
   "kr": "마지막 싸움이 막 시작되려 했습니다."
  },
  "178": {
   "jp": "b9d82b86",
   "kr": "어릴 적 엄마가 읽어 주셨지."
  },
  "179": {
   "jp": "49d01691",
   "kr": "해적 놀이도 자주 했었지."
  },
  "180": {
   "jp": "86dc1243",
   "kr": "크리스는"
  },
  "181": {
   "jp": "ab19e964",
   "kr": "늘 캡틴 토마스 역이었잖아."
  },
  "182": {
   "jp": "9c5f8926",
