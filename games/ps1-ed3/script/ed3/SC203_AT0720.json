  "0": {
   "jp": "bf50e946",
   "kr": "볼트"
  },
  "1": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "2": {
   "jp": "17b7d53a",
   "kr": "가루가의 숨통을 끊는 거다!"
  },
  "3": {
   "jp": "1b6e636d",
   "kr": "뭐냐?! 방금 건!"
  },
  "4": {
   "jp": "8c20a87b",
   "kr": "퇴, 퇴각!"
  },
  "5": {
   "jp": "f42ef168",
   "kr": "다가가면 튕겨 날아간다 이건가."
  },
  "6": {
   "jp": "780e17c9",
   "kr": "로디는 품속에서"
  },
  "7": {
   "jp": "670588a5",
   "kr": "천에 싼 둥근 것을 꺼냈다."
  },
  "8": {
   "jp": "f1325a0e",
   "kr": "천 안에서 나온 것은"
  },
  "9": {
   "jp": "00cfd05e",
   "kr": "네갈섬에서 쥬리오 일행이 본 것보다"
  },
  "10": {
   "jp": "3b721c98",
   "kr": "훨씬 커다란 진홍의 불꽃이었다."
  },
  "11": {
   "jp": "fe18a4de",
   "kr": "진홍의 불꽃!"
  },
  "12": {
   "jp": "bc55596c",
   "kr": "이런 위험한 물건을"
  },
  "13": {
   "jp": "b40698f3",
   "kr": "멀리서 들고 온 보람이 있었다는 거지."
  },
  "14": {
   "jp": "9d53905f",
   "kr": "가루가!"
  },
  "15": {
   "jp": "3c50d94b",
   "kr": "여태까지의 빚, 몽땅 갚아 주마!!"
  },
  "16": {
   "jp": "d51833b4",
   "kr": "뭐냐?!"
  },
  "17": {
   "jp": "ff81db7a",
   "kr": "저게, 가루가를 조종하던 마수다!"
  },
  "18": {
   "jp": "12a25481",
   "kr": "로디!"
  },
  "19": {
   "jp": "855ddcbc",
   "kr": "우리도 같이 싸울게!"
  },
  "20": {
   "jp": "56f3159c",
   "kr": "이놈은 만만치 않겠는걸."
  },
  "21": {
   "jp": "7021b180",
   "kr": "부탁한다!"
  },
  "22": {
   "jp": "bef1bac2",
   "kr": "네 사람은 기생수를 잡으려 파티를 맺었다!"
  }
