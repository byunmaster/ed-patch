{
 "archive": "/SCE1/SC100.DAT",
 "member": "..\\DATA\\MR5000.BIN",
 "lines": {
  "0": {
   "jp": "23ba9284",
   "kr": "네갈섬"
  },
  "1": {
   "jp": "ce0fbc7a",
   "kr": "에메나"
  },
  "2": {
   "jp": "0adf5788",
   "kr": "인타"
  },
  "3": {
   "jp": "9bb29c2e",
   "kr": "쥬리오 섬사람이 저쪽에서 오네."
  },
  "4": {
   "jp": "66b63ad6",
   "kr": "샤리네가 무사한지 물어보자."
  },
  "5": {
   "jp": "d4ec924a",
   "kr": "응, 그게 좋겠네."
  },
  "6": {
   "jp": "6766e7f9",
   "kr": "저기, 실례합니다."
  },
  "7": {
   "jp": "bcbbe76c",
   "kr": "테그라 마을분이세요?"
  },
  "8": {
   "jp": "9b6b8276",
   "kr": "네, 그렇습니다만."
  },
  "9": {
   "jp": "ff326e69",
   "kr": "저희는 순례 여행 중인데요,"
  },
  "10": {
   "jp": "c17668b8",
   "kr": "샤리네도 가루가에게 심하게 당했나요?"
  },
  "11": {
   "jp": "055b7ad3",
   "kr": "글쎄요, 어떨까요."
  },
  "12": {
   "jp": "8942b56a",
   "kr": "아무튼 마을은 처참한 꼴이에요."
  },
  "13": {
   "jp": "b38c9a4d",
   "kr": "저희 집은 흔적도 없이 사라졌어요."
  },
  "14": {
   "jp": "da77e322",
   "kr": "샤리네도 꽤 피해를 입은 모양이에요."
  },
  "15": {
   "jp": "b22a8c19",
   "kr": "이제 저희는 이 섬에서는 살아갈 수 없어요."
  },
  "16": {
   "jp": "4e4778b9",
   "kr": "대륙의 친척을 의지해 섬을 떠날 생각이에요."
  },
  "17": {
   "jp": "290842b8",
   "kr": "엄마"
  },
  "18": {
   "jp": "077c261c",
   "kr": "배 와 있을까?"
  },
  "19": {
   "jp": "86100d35",
   "kr": "바다가 유빙으로 덮이기 전에는"
  },
  "20": {
   "jp": "07ca1775",
   "kr": "분명 와 줄 거야. 그때까지 항구 창고에서"
  },
  "21": {
   "jp": "75288fd9",
   "kr": "기다리자."
  },
  "22": {
   "jp": "095df3ea",
   "kr": "저, 괜찮으시다면"
  },
  "23": {
   "jp": "d4785f80",
   "kr": "저희를 태워 온 어선이"
  },
  "24": {
   "jp": "275be002",
   "kr": "항구에서 기다려 주고 있어요."
  },
  "25": {
   "jp": "10983b56",
   "kr": "돌아갈 때 같이 태워 주도록"
  },
  "26": {
   "jp": "8333da09",
   "kr": "부탁해 볼까요?"
  },
  "27": {
   "jp": "965da8ce",
   "kr": "네? 정말인가요?"
  },
  "28": {
   "jp": "cc9a7f9f",
   "kr": "그렇게 해 주시겠어요?"
  },
  "29": {
   "jp": "94debbd3",
   "kr": "죄송해요, 꼭 부탁드려요."
  },
  "30": {
   "jp": "19546637",
   "kr": "네. 그렇게 해요."
  },
  "31": {
   "jp": "c89a8ac3",
   "kr": "그럼, 저희가 샤리네에서 돌아올 때까지"
  },
  "32": {
   "jp": "2add1855",
   "kr": "창고에서 기다려 주세요."
  },
  "33": {
   "jp": "c91fb25e",
   "kr": "네, 그렇게 하겠습니다."
  },
  "34": {
   "jp": "0785eb96",
   "kr": "항구 창고에서 기다리겠습니다."
  },
  "35": {
   "jp": "b4645686",
   "kr": "그럼, 실례하겠습니다."
  },
  "36": {
   "jp": "6d172ff4",
   "kr": "기다려 줘."
  },
  "37": {
   "jp": "58b6f752",
   "kr": "기다릴게."
  },
  "38": {
   "jp": "9a4f0e59",
   "kr": "그럼, 빠이빠〜이!"
  },
  "39": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "40": {
   "jp": "6a54f362",
   "kr": "빠이빠〜이!"
  }
 }
}