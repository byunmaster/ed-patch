{
 "archive": "/SCE6/SC606.DAT",
 "member": "..\\DATA\\GT3104.BIN",
 "lines": {
  "0": {
   "jp": "26fb5f27",
   "kr": "딜트 관문"
  },
  "1": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "2": {
   "jp": "5a257b5b",
   "kr": "우코스 대장"
  },
  "3": {
   "jp": "f3d96af7",
   "kr": "푸르스"
  },
  "4": {
   "jp": "2892c405",
   "kr": "아오프"
  },
  "5": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "6": {
   "jp": "081b0cd1",
   "kr": "좋아, 지금!"
  },
  "7": {
   "jp": "7347f446",
   "kr": "자, 따라오게나."
  },
  "8": {
   "jp": "177b42b2",
   "kr": "자유를 향한 탈출이다."
  },
  "9": {
   "jp": "8712d25a",
   "kr": "괜찮을까아."
  },
  "10": {
   "jp": "b86ca7c3",
   "kr": "쥬리오, 시간 없어."
  },
  "11": {
   "jp": "2766b624",
   "kr": "알았어."
  },
  "12": {
   "jp": "ebe70597",
   "kr": "앗, 두더지 소리가 난다."
  },
  "13": {
   "jp": "f15b19f6",
   "kr": "두더지다, 두더지다."
  },
  "14": {
   "jp": "81245980",
   "kr": "역시 두더지야…"
  },
  "15": {
   "jp": "a4e27441",
   "kr": "하지만, 다른 사람 귀엔 안 들린다고"
  },
  "16": {
   "jp": "1d054360",
   "kr": "하니까 말이지."
  },
  "17": {
   "jp": "cd9f2886",
   "kr": "나는 두더지에게 저주받은 걸까."
  },
  "18": {
   "jp": "d0b348e3",
   "kr": "무서우니까, 이제 입 다물어야지…"
  },
  "19": {
   "jp": "d1ae2b1c",
   "kr": "(이쪽이었나…)"
  },
  "20": {
   "jp": "487b6df2",
   "kr": "(자신 없어요?)"
  },
  "21": {
   "jp": "8816849a",
   "kr": "(정확히 측량했다며?)"
  },
  "22": {
   "jp": "381af6ef",
   "kr": "(팔 때는 정확했는데…)"
  },
  "23": {
   "jp": "5195ba6a",
   "kr": "(그만, 재미가 붙어서.)"
  },
  "24": {
   "jp": "642002ad",
   "kr": "(상관없는 터널까지 파 버려서…)"
  },
  "25": {
   "jp": "f93cc548",
   "kr": "(진짜는 어느 거였더라?)"
  },
  "26": {
   "jp": "f338f727",
   "kr": "(나한테 물어도 모른다고.)"
  },
  "27": {
   "jp": "07f7a725",
   "kr": "(흙을 좀 깎아 보면?)"
  },
  "28": {
   "jp": "51a4f913",
   "kr": "허크는 흙을 조금 깎아 보았다."
  },
  "29": {
   "jp": "5aac013b",
   "kr": "(음… 왠지 다른 것 같군.)"
  },
  "30": {
   "jp": "b04dd921",
   "kr": "(이번엔 괜찮아?)"
  },
  "31": {
   "jp": "310e903c",
   "kr": "(아마도.)"
  },
  "32": {
   "jp": "adfb5f0c",
   "kr": "(잠깐 기다려요.)"
  },
  "33": {
   "jp": "9864ac4d",
   "kr": "(바다트 일행, 따라오고 있으려나?)"
  },
  "34": {
   "jp": "71431f43",
   "kr": "(아, 괜찮다.)"
  },
  "35": {
   "jp": "382de98a",
   "kr": "(안심해요.)"
  },
  "36": {
   "jp": "00bc2992",
   "kr": "(오케이.)"
  },
  "37": {
   "jp": "c8237d6f",
   "kr": "(허크 삼촌. 도착했어?)"
  },
  "38": {
   "jp": "536864f0",
   "kr": "(완벽해. 여기가 다리 바로 곁일 거야.)"
  },
  "39": {
   "jp": "cc75c57b",
   "kr": "(정말일까아.)"
  },
  "40": {
   "jp": "72dbc3f3",
   "kr": "(꽤 많이 나아간 것 같은데.)"
  },
  "41": {
   "jp": "bc20449e",
   "kr": "(이런, 미안.)"
  },
  "42": {
   "jp": "992e2ec8",
   "kr": "(조금 서쪽으로 어긋났던 모양이야.)"
  },
  "43": {
   "jp": "81d86884",
   "kr": "(정말, 시간 없어.)"
  },
  "44": {
   "jp": "323700e4",
   "kr": "(꾸물대다간, 다리가 올라가 버려.)"
  },
  "45": {
   "jp": "27a98949",
   "kr": "(이렇게 된 이상, 죽기 아니면 살기다.)"
  },
  "46": {
   "jp": "99febe37",
   "kr": "(여기서 올라가 다리까지 강행 돌파다.)"
  },
  "47": {
   "jp": "e1c3b0f9",
   "kr": "(여차하면 내 폭탄을 쓸 뿐이야.)"
  },
  "48": {
   "jp": "5496e6e5",
   "kr": "우와〜 커다란 개다!"
  },
  "49": {
   "jp": "4abc892e",
   "kr": "정말! 이건 말이야, 말."
  },
  "50": {
   "jp": "25e51ea7",
   "kr": "저런 데에 병사가 있을 줄이야."
  },
  "51": {
   "jp": "937a657d",
   "kr": "이거 곤란하군."
  },
  "52": {
   "jp": "cba2491e",
   "kr": "폭탄을 쓸까요?"
  },
  "53": {
   "jp": "88e34954",
   "kr": "아니, 여기 병사는 예언과 무관해."
  },
  "54": {
   "jp": "4bd3264b",
   "kr": "아무도 다치게 하긴 싫어."
  },
  "55": {
   "jp": "ef039c32",
   "kr": "이쪽으로."
  },
  "56": {
   "jp": "5227b273",
   "kr": "내가 이 말을 타고"
  },
  "57": {
   "jp": "7ca6d74b",
   "kr": "저 병사 위를 뛰어넘겠다."
  },
  "58": {
   "jp": "70922a35",
   "kr": "병사가 동요하는 사이에"
  },
  "59": {
   "jp": "345c23e5",
   "kr": "너희는 다리를 건너는 거야."
  },
  "60": {
   "jp": "d32b4035",
   "kr": "알겠지?"
  },
  "61": {
   "jp": "fae9345b",
   "kr": "삼촌"
  },
  "62": {
   "jp": "134f550e",
   "kr": "승마 잘했어?"
  },
  "63": {
   "jp": "24be9c8e",
   "kr": "삼촌은 이래 봬도"
  },
  "64": {
   "jp": "466bc615",
   "kr": "하얀마녀 연구에 몸을 바치는"
  },
  "65": {
   "jp": "9ca3fc29",
   "kr": "떠돌이 학자거든."
  },
  "66": {
   "jp": "33970867",
   "kr": "말 한두 마리쯤"
  },
  "67": {
   "jp": "3e94a4c6",
   "kr": "자면서도 다룰 수 있고말고."
  },
  "68": {
   "jp": "be3f9840",
   "kr": "쥬리오는 자면서도"
  },
  "69": {
   "jp": "e29eab89",
   "kr": "침대까지 갈 수 있는 거랑 똑같은 거네."
  },
  "70": {
   "jp": "14e3aee5",
   "kr": "응, 뭐?"
  },
  "71": {
   "jp": "283c1ebf",
   "kr": "좋아."
  },
  "72": {
   "jp": "057e48b1",
   "kr": "그럼, 작전 개시."
  },
  "73": {
   "jp": "e376835f",
   "kr": "하하, 이상하네."
  },
  "74": {
   "jp": "6f67c179",
   "kr": "빨리 안 하면 다리가 올라가요."
  },
  "75": {
   "jp": "fef3589f",
   "kr": "요즘 들어"
  },
  "76": {
   "jp": "651d8a31",
   "kr": "말을 안 탔으니까 말이야."
  },
  "77": {
   "jp": "d0d6c3b5",
   "kr": "그래. 이쪽 말로 하자."
  },
  "78": {
   "jp": "1ee6ca8c",
   "kr": "뒤에서 뛰어 올라타면 틀림없지."
  },
  "79": {
   "jp": "2fe981ad",
   "kr": "무, 뭐냐!?"
  },
  "80": {
   "jp": "d4397c14",
   "kr": "지금밖에 기회는 없어요!"
  },
  "81": {
   "jp": "9cc7bac8",
   "kr": "허크 삼촌이…"
  },
  "82": {
   "jp": "86fe2a65",
   "kr": "여긴 나한테 맡겨라."
  },
  "83": {
   "jp": "516dc802",
   "kr": "너흰 다리를 건너라!"
  },
  "84": {
   "jp": "5c7c5ebc",
   "kr": "으, 응!"
  },
  "85": {
   "jp": "442d4d29",
   "kr": "이런!"
  },
  "86": {
   "jp": "64b18c5b",
   "kr": "옮겨 탄다!"
  },
  "87": {
   "jp": "99ae98e9",
   "kr": "실패다아아아〜"
  },
  "88": {
   "jp": "523fffe1",
   "kr": "나중에 만나자!"
  },
  "89": {
   "jp": "1bad4876",
   "kr": "걱정 마라!"
  },
  "90": {
   "jp": "7ea8549a",
   "kr": "쥬리오 군!"
  },
  "91": {
   "jp": "3c82193d",
   "kr": "이걸!!"
  },
  "92": {
   "jp": "d33aa2c3",
   "kr": "반드시 쫓아갈 테니 안심하게!"
  },
  "93": {
   "jp": "587a18b6",
   "kr": "알았어요."
  },
  "94": {
   "jp": "5ae45fd1",
   "kr": "꼭이에요!"
  },
  "95": {
   "jp": "afaf3c16",
   "kr": "예!"
  },
  "96": {
   "jp": "873e9ea7",
   "kr": "어서 서둘러."
  },
  "97": {
   "jp": "8119458e",
   "kr": "뭐 저런 놈들이…"
  },
  "98": {
   "jp": "01cb0690",
   "kr": "괜찮을까…"
  },
  "99": {
   "jp": "3dacfa98",
   "kr": "허크 아저씨랑 바다트니까"
  },
  "100": {
   "jp": "5fcc5d63",
   "kr": "분명 괜찮을 거야."
  },
  "101": {
   "jp": "15cb5848",
   "kr": "어쨌든"
  },
  "102": {
   "jp": "7bfd7bfd",
   "kr": "우리는 아로자로 가요."
  },
  "103": {
   "jp": "f701bd44",
   "kr": "우선,"
  },
  "104": {
   "jp": "94755437",
   "kr": "죠안나 씨를 만나 보는 게"
  },
  "105": {
   "jp": "f8a40b0b",
   "kr": "먼저인 것 같아요."
  },
  "106": {
   "jp": "171d8a97",
   "kr": "쥬리오 일행은 파티를 맺었다."
  },
  "107": {
   "jp": "04e88df5",
   "kr": "이걸 잊으면 안 되지."
  },
  "108": {
   "jp": "f2f8391c",
   "kr": "쥬리오, 짐이 가득이야."
  },
  "109": {
   "jp": "118472db",
   "kr": "뭔가 두고 가지 않으면"
  },
  "110": {
   "jp": "7142522a",
   "kr": "쥬리오 일행은"
  },
  "111": {
   "jp": "e9d91b01",
   "kr": ", 손에 넣었다."
  }
 }
}