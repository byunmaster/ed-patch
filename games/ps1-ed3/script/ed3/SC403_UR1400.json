{
 "archive": "/SCE4/SC403.DAT",
 "member": "..\\DATA\\UR1400.BIN",
 "lines": {
  "0": {
   "jp": "5391c7b8",
   "kr": "미혹의 숲"
  },
  "1": {
   "jp": "f8471948",
   "kr": "앗…"
  },
  "2": {
   "jp": "544d59f0",
   "kr": "알그레스…?"
  },
  "3": {
   "jp": "e9c82fed",
   "kr": "저게…"
  },
  "4": {
   "jp": "2197f06d",
   "kr": "잠깐만요, 알그레스."
  },
  "5": {
   "jp": "221a5152",
   "kr": "우리는 숲에도"
  },
  "6": {
   "jp": "38426f5d",
   "kr": "당신에게도"
  },
  "7": {
   "jp": "bfc53e08",
   "kr": "결코 해를 끼치지 않을게."
  },
  "8": {
   "jp": "7717f6b7",
   "kr": "부탁이 있어요."
  },
  "9": {
   "jp": "8b97a650",
   "kr": "부탁이야, 알그레스."
  },
  "10": {
   "jp": "fe1ecd4c",
   "kr": "얘기 좀 들어 줘."
  },
  "11": {
   "jp": "8c8bdfb4",
   "kr": "내 친구가 저주에 걸려서…"
  },
  "12": {
   "jp": "941ad6bc",
   "kr": "저주를 푸는 약을 만들려면"
  },
  "13": {
   "jp": "2c7ed363",
   "kr": "네 뿔을 조금만 나눠 줬으면 해."
  },
  "14": {
   "jp": "373d0641",
   "kr": "아주 조금, 가루만큼이면 돼요."
  },
  "15": {
   "jp": "cc704edd",
   "kr": "부탁이에요, 알그레스."
  },
  "16": {
   "jp": "c8d3e311",
   "kr": "조금만 당신의 소중한 뿔을 나눠 주세요."
  },
  "17": {
   "jp": "103c34f7",
   "kr": "알그레스는 뿔을 내밀듯이 고개를 숙이고"
  },
  "18": {
   "jp": "b83db20a",
   "kr": "멈춰 섰다."
  },
  "19": {
   "jp": "8e73cced",
   "kr": "고마워요, 알그레스."
  },
  "20": {
   "jp": "6cae0856",
   "kr": "휘리는 알그레스가 놀라지 않도록"
  },
  "21": {
   "jp": "843af789",
   "kr": "조심하면서 뿔을 조금만 잘랐다."
  },
  "22": {
   "jp": "a90c1a03",
   "kr": "고마워요"
  },
  "23": {
   "jp": "b3c30d32",
   "kr": "이거면 충분해요."
  },
  "24": {
   "jp": "5642d932",
   "kr": "알그레스, 고마워."
  },
  "25": {
   "jp": "38fa6543",
   "kr": "은혜는 잊지 않을게."
  },
  "26": {
   "jp": "114d00a4",
   "kr": "잘 있어, 알그레스."
  },
  "27": {
   "jp": "ff988cf1",
   "kr": "이걸로 약을 만들 수 있어요."
  },
  "28": {
   "jp": "7787e32c",
   "kr": "올도스로 가요."
  },
  "29": {
   "jp": "d357e9e0",
   "kr": "응."
  }
 }
}