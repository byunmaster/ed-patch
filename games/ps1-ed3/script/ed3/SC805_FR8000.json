{
 "archive": "/SCE8/SC805.DAT",
 "member": "..\\DATA\\FR8000.BIN",
 "lines": {
  "0": {
   "jp": "8ae5459a",
   "kr": "왕도 가도"
  },
  "1": {
   "jp": "51142472",
   "kr": "시작할까."
  },
  "2": {
   "jp": "6b084437",
   "kr": "혹시 내가 이겨도 원망하지 마라."
  },
  "3": {
   "jp": "6103e8e6",
   "kr": "이길 수 있으려나."
  },
  "4": {
   "jp": "0e30eccb",
   "kr": "글쎄…"
  },
  "5": {
   "jp": "398944dc",
   "kr": "간격을 잡는 법이 제법이군."
  },
  "6": {
   "jp": "24afd40f",
   "kr": "당신께 칭찬을 듣다니 영광이다."
  },
  "7": {
   "jp": "3101e008",
   "kr": "힘으로 하는 건 늙은이한테 버겁군."
  },
  "8": {
   "jp": "adbb3b48",
   "kr": "이야앗!"
  },
  "9": {
   "jp": "cf09188d",
   "kr": "우오옷…?"
  },
  "10": {
   "jp": "138634c5",
   "kr": "역시 대단하군."
  },
  "11": {
   "jp": "ab8bb131",
   "kr": "검이 부러졌다."
  },
  "12": {
   "jp": "3adae119",
   "kr": "………"
  },
  "13": {
   "jp": "290c6a35",
   "kr": "이래서는 승부를 이어 갈 수 없겠군."
  },
  "14": {
   "jp": "ee51cc08",
   "kr": "확실히 그 검은 에스페란사."
  },
  "15": {
   "jp": "8b63ff67",
   "kr": "희망이라는 뜻의 이름을 가진 검이지?"
  },
  "16": {
   "jp": "bee1378b",
   "kr": "그래."
  },
  "17": {
   "jp": "668dc775",
   "kr": "희망이 사라졌다는 건가?"
  },
  "18": {
   "jp": "aa91f1b1",
   "kr": "아니, 희망은 하나가 아니다."
  },
  "19": {
   "jp": "9fc0c8cb",
   "kr": "하나의 희망이 사라져도"
  },
  "20": {
   "jp": "8dacb555",
   "kr": "또 다른 새로운 희망이 어딘가에 생긴다."
  },
  "21": {
   "jp": "ec00a793",
   "kr": "당신의 새로운 희망이란"
  },
  "22": {
   "jp": "d5edaaae",
   "kr": "쥬리오와 크리스를 말하는 건가."
  },
  "23": {
   "jp": "04c98698",
   "kr": "그건 세계의 희망이다."
  },
  "24": {
   "jp": "8587dd84",
   "kr": "굳이 말하자면"
  },
  "25": {
   "jp": "17235faf",
   "kr": "이 나에게 있어서의 새로운 희망이란"
  },
  "26": {
   "jp": "adcb6678",
   "kr": "아무래도 너인 모양이군."
  },
  "27": {
   "jp": "d3b53ce3",
   "kr": "한 방 먹었군."
  },
  "28": {
   "jp": "d166395e",
   "kr": "《추신》"
  },
  "29": {
   "jp": "46d603ce",
   "kr": "쥬리오에게."
  },
  "30": {
   "jp": "3894f443",
   "kr": "튼튼하고 날카로운 검만이 좋은 검은 아니다."
  },
  "31": {
   "jp": "85e06bcd",
   "kr": "때로는 날이 빠지고 곧 부러질 듯한 검이"
  },
  "32": {
   "jp": "1b70b07f",
   "kr": "최고의 명검이 되기도 한다."
  },
  "33": {
   "jp": "ad14d75e",
   "kr": "인간 세상도 마찬가지일 것이다."
  }
 }
}