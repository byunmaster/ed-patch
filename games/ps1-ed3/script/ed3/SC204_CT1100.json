  },
  "1": {
   "jp": "0a5e1957",
   "kr": "포리쉬"
  },
  "2": {
   "jp": "9c3b5f51",
   "kr": "안지"
  },
  "3": {
   "jp": "b4505917",
   "kr": "시켓트"
  },
  "4": {
   "jp": "00cdd041",
   "kr": "젠느"
  },
  "5": {
   "jp": "a76cf681",
   "kr": "치젤"
  },
  "6": {
   "jp": "a2dbf087",
   "kr": "토니카"
  },
  "7": {
   "jp": "2466f8eb",
   "kr": "대장장이 질"
  },
  "8": {
   "jp": "3aa46844",
   "kr": "너무해〜!"
  },
  "9": {
   "jp": "bc1824d6",
   "kr": "너, 너무해…"
  },
  "10": {
   "jp": "5572e922",
   "kr": "제법인데."
  },
  "11": {
   "jp": "9a39109a",
   "kr": "여자로 두기엔 아깝군."
  },
  "12": {
   "jp": "37f2353e",
   "kr": "나도 다이스 사람들처럼"
  },
  "13": {
   "jp": "bef52f45",
   "kr": "예쁜 옷을 입어 보고 싶단다."
  },
  "14": {
   "jp": "ed7b3a96",
   "kr": "하지만, 무리지."
  },
  "15": {
   "jp": "71a0dc8a",
   "kr": "이 마을에선, 하루 먹고살기도"
  },
  "16": {
   "jp": "c809a6d7",
   "kr": "벅찬걸."
  },
  "17": {
   "jp": "8cd41f3f",
   "kr": "아, 루레 영감!"
  },
  "18": {
   "jp": "81b592a1",
   "kr": "콩 줘"
  },
  "19": {
   "jp": "fab7f62b",
   "kr": "한 알만이라도, 응."
  },
  "20": {
   "jp": "d3006d23",
   "kr": "한 알만."
  },
  "21": {
   "jp": "4530236a",
   "kr": "나중에 촌장님께 받거라."
  },
  "22": {
   "jp": "ef6bd546",
   "kr": "구두쇠!"
  },
  "23": {
   "jp": "30f8cae0",
   "kr": "앗, 외지인이다."
  },
  "24": {
   "jp": "175b6e00",
   "kr": "우리들을"
  },
  "25": {
   "jp": "8eb22118",
   "kr": "이상한 눈으로 보지 마."
  },
  "26": {
   "jp": "9cccdb40",
   "kr": "흥!"
  },
  "27": {
   "jp": "c94b6a86",
   "kr": "무시하면, 가만 안 둔다!"
  },
  "28": {
   "jp": "afa39657",
   "kr": "이런 땅에선 보리도 안 자라."
  },
  "29": {
   "jp": "aa87b376",
   "kr": "게다가 독 늪은 해마다 넓어져."
  },
  "30": {
   "jp": "84044e0a",
   "kr": "그러다 강까지 말라 버리겠지."
  },
  "31": {
   "jp": "efc405b4",
   "kr": "그렇게 되면"
  },
  "32": {
   "jp": "f5497aec",
   "kr": "이 마을도 정말 끝이다."
  },
  "33": {
   "jp": "a60168c4",
   "kr": "앞날은 캄캄해."
  },
  "34": {
   "jp": "ea683655",
   "kr": "이 마을 사람들은,"
  },
  "35": {
   "jp": "40f38d5f",
   "kr": "옆 마을 다이스가 쑥쑥 발전해 가는"
  },
  "36": {
   "jp": "e0ebe66e",
   "kr": "걸 보고 비관적이 되어 버린 거예요."
  },
  "37": {
   "jp": "b48494a1",
   "kr": "남과 비교하며 주저앉는 건"
  },
  "38": {
   "jp": "baac2bd1",
   "kr": "나쁜 일이라고 알고는 있지만"
  },
  "39": {
   "jp": "559a55dc",
   "kr": "이제 어쩔 도리가 없어요."
  },
  "40": {
   "jp": "7f058b97",
   "kr": "일하는 것마저 싫어져서"
  },
  "41": {
   "jp": "08a54033",
   "kr": "지금은 살아갈 기력까지"
  },
  "42": {
   "jp": "1255524e",
   "kr": "사라질 것 같아요."
  },
  "43": {
   "jp": "90625097",
   "kr": "저리 가!"
  },
  "44": {
   "jp": "7e857143",
   "kr": "저번엔 고마웠어."
  },
  "45": {
   "jp": "62140f2e",
   "kr": "너희들은 친구야."
  },
  "46": {
   "jp": "48605e6a",
   "kr": "있잖아."
  },
  "47": {
   "jp": "7588f274",
   "kr": "여기는 다츠라고 하는"
  },
  "48": {
   "jp": "cbd75e9e",
   "kr": "어엿한 이름이 있단 말이야."
  },
  "49": {
   "jp": "0ad5276f",
   "kr": "빈민굴이라고 하면"
  },
  "50": {
   "jp": "232adf8e",
   "kr": "가만 안 둘 거야."
  },
  "51": {
   "jp": "9a9db927",
   "kr": "토니카"
  },
  "52": {
   "jp": "6ed03465",
   "kr": "외지인과 말하면 안 돼!"
  },
  "53": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "54": {
   "jp": "5dee5604",
   "kr": "있잖아, 나 말이야."
  },
  "55": {
   "jp": "18b896c8",
   "kr": "언젠가 저 다이스의 저택 같은"
  },
  "56": {
   "jp": "137bce32",
   "kr": "커다란 집에 살고 싶어."
  },
  "57": {
   "jp": "6289bd44",
   "kr": "나는 조용히 내 솜씨를 갈고닦고 싶어서"
  },
  "58": {
   "jp": "39f64bcc",
   "kr": "여기 왔다네."
  },
  "59": {
   "jp": "ba4fc271",
   "kr": "여기 사람들은 활기는 없어도"
  },
  "60": {
   "jp": "7098bc77",
   "kr": "돈이 전부라 여기는 무리와는 달라."
  },
  "61": {
   "jp": "fb0272fb",
   "kr": "계기만 있으면 훌륭한 인생을"
  },
  "62": {
   "jp": "97e6477a",
   "kr": "보낼 수 있는 사람들뿐일세."
  },
  "63": {
   "jp": "b36247dc",
   "kr": "이 다츠를 찾아올 정도이니."
  },
  "64": {
   "jp": "ff0527f0",
   "kr": "자네들도 사리사욕으로 움직일 이는 아니겠지."
  },
  "65": {
   "jp": "48624313",
   "kr": "여기서 몇 해째 장사를 안 했네만"
  },
  "66": {
   "jp": "8067ede8",
   "kr": "자네들에게라면 마음 놓고 팔 수 있겠네."
  },
  "67": {
   "jp": "5cff7fe6",
   "kr": "자, 사양 말고 용건을 말해 주게."
  },
  "68": {
   "jp": "5bd08cf6",
   "kr": "오오, 자네들인가."
  },
  "69": {
   "jp": "94618581",
   "kr": "용건은 무엇인가?"
  },
  "70": {
   "jp": "8b25cea1",
   "kr": "몸은 늙었어도, 무기 만드는 일에선"
  },
  "71": {
   "jp": "f182f3f7",
   "kr": "늙지 않았다고 보네."
  },
  "72": {
   "jp": "95327b89",
   "kr": "무얼 찾는가?"
  },
  "73": {
   "jp": "9afdca9a",
   "kr": "를 고르셨나."
  },
  "74": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "75": {
   "jp": "ba465b9d",
   "kr": "에 팔겠네."
  },
  "76": {
   "jp": "d7df4249",
   "kr": "이 다츠에선 재료 모으기가 힘들어서."
  },
  "77": {
   "jp": "27317148",
   "kr": "필요 없는 건 고맙게 사들이지."
  },
  "78": {
   "jp": "29d159fe",
   "kr": "를 팔아 주시겠나?"
  },
  "79": {
   "jp": "abb8567e",
   "kr": "그렇다면,"
  },
  "80": {
   "jp": "a1449844",
   "kr": "에 사들이겠어."
  },
  "81": {
   "jp": "6ae7fa54",
   "kr": "라피카는 무기 만들기에 꼭 필요한 재료."
  },
  "82": {
   "jp": "78f7aaa8",
   "kr": "1 Goa당 20 Pia 주겠네만, 어떤가?"
  },
  "83": {
   "jp": "6b8e66b5",
   "kr": "고맙군."
  },
  "84": {
   "jp": "ff5e0e69",
   "kr": "을 치르지."
  },
  "85": {
   "jp": "302100f9",
   "kr": "라피카가 없는 모양이군."
  },
  "86": {
   "jp": "c334d0cb",
   "kr": "모이면, 언제든 오게나."
  },
  "87": {
   "jp": "45796a6a",
   "kr": "다른 볼일은?"
  },
  "88": {
   "jp": "8ed7d895",
   "kr": "자네들과는 장사를 하네만"
  },
  "89": {
   "jp": "e94e397c",
   "kr": "부디, 다른 마을에서 내 얘기를"
  },
  "90": {
   "jp": "693ed45e",
   "kr": "하지 말아 주게."
  },
  "91": {
   "jp": "89f25c6f",
   "kr": "나는 조용히 솜씨를 갈고닦고 싶다네."
  }
 }
