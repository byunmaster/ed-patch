{
 "archive": "/SCE0/SC000.DAT",
 "member": "..\\DATA\\FT0001.BIN",
 "lines": {
  "0": {
   "jp": "bb708123",
   "kr": "라그픽 마을"
  },
  "1": {
   "jp": "1c3909b6",
   "kr": "쥬리오 아빠"
  },
  "2": {
   "jp": "ad0e2a6b",
   "kr": "쥬리오 엄마"
  },
  "3": {
   "jp": "f41cc21e",
   "kr": "크리스 아빠"
  },
  "4": {
   "jp": "14600308",
   "kr": "크리스 엄마"
  },
  "5": {
   "jp": "8ef96780",
   "kr": "톨타 촌장"
  },
  "6": {
   "jp": "493dcc93",
   "kr": "페르나 부인"
  },
  "7": {
   "jp": "0b8d576a",
   "kr": "로그"
  },
  "8": {
   "jp": "d0b6da59",
   "kr": "도구점 테르노"
  },
  "9": {
   "jp": "1b89384a",
   "kr": "스콜"
  },
  "10": {
   "jp": "b9f92fd3",
   "kr": "치아나"
  },
  "11": {
   "jp": "3cfb8627",
   "kr": "픽"
  },
  "12": {
   "jp": "6d1ecafe",
   "kr": "틀림없이 두 손 들 줄 알았다만…"
  },
  "13": {
   "jp": "edd022ee",
   "kr": "잘했다! 이놈은 훌륭한 큰 멧돼지구나."
  },
  "14": {
   "jp": "0ee6230c",
   "kr": "역시 내 아들이야."
  },
  "15": {
   "jp": "a4a68ca5",
   "kr": "크리스도 같이 있네. 마침 잘됐다."
  },
  "16": {
   "jp": "7ab5bb20",
   "kr": "늦기 전에 촌장님께 가서"
  },
  "17": {
   "jp": "50e745db",
   "kr": "순례의 마음가짐을 듣고 오렴."
  },
  "18": {
   "jp": "84503fac",
   "kr": "돌아올 때까지는"
  },
  "19": {
   "jp": "e6231269",
   "kr": "전골을 만들어 둘 테니까."
  },
  "20": {
   "jp": "95b48cd1",
   "kr": "귀찮은 건"
  },
  "21": {
   "jp": "85441d29",
   "kr": "얼른 끝내 버려야지."
  },
  "22": {
   "jp": "09429712",
   "kr": "크리스, 가자."
  },
  "23": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "24": {
   "jp": "06c6a327",
   "kr": "그렇게 울보였던 쥬리오가"
  },
  "25": {
   "jp": "158802c6",
   "kr": "벌써 순례를 떠나다니."
  },
  "26": {
   "jp": "9cc9b789",
   "kr": "참, 세월 가는 건 빠르기도 하지…"
  },
  "27": {
   "jp": "62fe874e",
   "kr": "그러게요, 여보."
  },
  "28": {
   "jp": "554e86d5",
   "kr": "우리 아들의 여행길에 건배!"
  },
  "29": {
   "jp": "5cf733a0",
   "kr": "건배!"
  },
  "30": {
   "jp": "4f915dc7",
   "kr": "건배〜!"
  },
  "31": {
   "jp": "c7c058ae",
   "kr": "이렇게 순례 전날 밤은 깊어 갔다."
  },
  "32": {
   "jp": "e2345252",
   "kr": "제대로 듣고 왔느냐?"
  },
  "33": {
   "jp": "91c9b7a0",
   "kr": "어서 오렴."
  },
  "34": {
   "jp": "f99d95d3",
   "kr": "내일 준비는 다 끝냈니?"
  },
  "35": {
   "jp": "6aca7e00",
   "kr": "그럼 쥬리오의 잔치를 열어 볼까."
  },
  "36": {
   "jp": "0e4fea54",
   "kr": "자, 정말 맛있는 멧돼지 전골도"
  },
  "37": {
   "jp": "77a1d2b8",
   "kr": "아주 잘됐단다."
  },
  "38": {
   "jp": "b0528864",
   "kr": "그럼 얼른 끝내고 오렴."
  },
  "39": {
   "jp": "27cad298",
   "kr": "그러고 나서 잔치를 하자꾸나."
  },
  "40": {
   "jp": "a5a854cc",
   "kr": "꾸물대다간 해가 저물겠구나."
  },
  "41": {
   "jp": "aa68577a",
   "kr": "엄마 오르골이 듣고 싶어?"
  },
  "42": {
   "jp": "7b7aa4dd",
   "kr": "그래, 좋아."
  },
  "43": {
   "jp": "dec57288",
   "kr": "쥬리오는 오르골을 열었다."
  },
  "44": {
   "jp": "37d669b2",
   "kr": "언제 들어도 예쁜 곡이네."
  },
  "45": {
   "jp": "4450aaad",
   "kr": "그렇지?"
  },
  "46": {
   "jp": "008f9f1c",
   "kr": "나도 이 곡 정말 좋아해."
  },
  "47": {
   "jp": "0b89131f",
   "kr": "내일 아침, 데리러 갈게."
  },
  "48": {
   "jp": "3fdfbe33",
   "kr": "그러고 나서 같이 촌장님한테 가자."
  },
  "49": {
   "jp": "dc7873cd",
   "kr": "그치만 늦잠 자면 가만 안 둘 거야."
  },
  "50": {
   "jp": "1823226c",
   "kr": "오, 쥬리오구나. 내일부터 딸을 부탁한다."
  },
  "51": {
   "jp": "12b22561",
   "kr": "말괄량이지만 저래 봬도 여자다운 데도 있다"
  },
  "52": {
   "jp": "f5466480",
   "kr": "…있을 테니까."
  },
  "53": {
   "jp": "c3c0f835",
   "kr": "내일부터 딸을 부탁한다."
  },
  "54": {
   "jp": "bd8c17f9",
   "kr": "배로 메나트에 건너가면"
  },
  "55": {
   "jp": "74578f99",
   "kr": "폴티아와는 딴판으로 추워진다."
  },
  "56": {
   "jp": "e1257681",
   "kr": "감기 조심하거라."
  },
  "57": {
   "jp": "88371b23",
   "kr": "식사는 꼬박꼬박 챙기렴."
  },
  "58": {
   "jp": "57141602",
   "kr": "여행지에서 몸이 상하면"
  },
  "59": {
   "jp": "62732bfc",
   "kr": "무척 서러운 법이니까."
  },
  "60": {
   "jp": "a7f201cd",
   "kr": "마음이 안 놓이느냐?"
  },
  "61": {
   "jp": "f1b9dda0",
   "kr": "나도 그랬단다."
  },
  "62": {
   "jp": "5a37d5da",
   "kr": "허나 내일을 위해 제대로 쉬어야 하느니라."
  },
  "63": {
   "jp": "36e08256",
   "kr": "오, 쥬리오와 크리스티나로구나."
  },
  "64": {
   "jp": "31656994",
   "kr": "그럼 내일부터 떠날 순례에 대해"
  },
  "65": {
   "jp": "135d777d",
   "kr": "잠깐 이야기해 두자꾸나."
  },
  "66": {
   "jp": "a04b2eb5",
   "kr": "길어질지도 모르지만 참고 들으렴."
  },
  "67": {
   "jp": "2a6bab1a",
   "kr": "자. 쥬리오, 크리스티나."
  },
  "68": {
   "jp": "34a1f08b",
   "kr": "드디어 둘은 내일부터 성인의 의식인"
  },
  "69": {
   "jp": "1b353228",
   "kr": "순례 여행을 떠나게 되는데…"
  },
  "70": {
   "jp": "5a5d9110",
   "kr": "어떤 것인지는 알고 있느냐?"
  },
  "71": {
   "jp": "6f3e9d89",
   "kr": "쥬리오."
  },
  "72": {
   "jp": "428cf35c",
   "kr": "여행지에서 그렇게 아는 척하면 안 된다."
  },
  "73": {
   "jp": "e33f2fc6",
   "kr": "잘 듣거라."
  },
  "74": {
   "jp": "bc17ad66",
   "kr": "솔직해서 좋구나. 그럼 설명하마."
  },
  "75": {
   "jp": "ec36b4d1",
   "kr": "아득한 옛날부터 티라스일 지방에는"
  },
  "76": {
   "jp": "0e9d9d15",
   "kr": "샤리네라 불리는 다섯 사당이 있고"
  },
  "77": {
   "jp": "033735a0",
   "kr": "거기엔 저마다 마법의 거울이 모셔져 있다."
  },
  "78": {
   "jp": "101f4e01",
   "kr": "그 거울을 다 돌아보는 게 성인의 의식이며"
  },
  "79": {
   "jp": "e8130bcf",
   "kr": "순례 여행이란다. 라그픽 마을 사람은 모두"
  },
  "80": {
   "jp": "a53cf766",
   "kr": "이 의식을 마치고 어른이 되었단다."
  },
  "81": {
   "jp": "ba87b0a2",
   "kr": "처음엔 어디로 가면 돼요?"
  },
  "82": {
   "jp": "c581c4d4",
   "kr": "디네 샤리네다."
  },
  "83": {
   "jp": "8de4bae9",
   "kr": "그다음은 현자의 말에 따라"
  },
  "84": {
   "jp": "550948ce",
   "kr": "올도스로 향하거라."
  },
  "85": {
   "jp": "5ef6dc18",
   "kr": "올도스에서 마지막 마법의 거울을 보는 것이"
  },
  "86": {
   "jp": "eeba3359",
   "kr": "순례 여행의 본래 목적이다."
  },
  "87": {
   "jp": "a1e38731",
   "kr": "올도스라는 데까지 얼마나 걸려요?"
  },
  "88": {
   "jp": "d3a9eaa1",
   "kr": "긴 여행이 될 게다. 글쎄, 한 달…"
  },
  "89": {
   "jp": "bba63191",
   "kr": "한 달 반… 쯤 되려나."
  },
  "90": {
   "jp": "d8e34204",
   "kr": "게다가 돌아오는 길도 만만찮다."
  },
  "91": {
   "jp": "10c0b546",
   "kr": "올도스를 나설 무렵엔 닐리의 배는 유빙으로"
  },
  "92": {
   "jp": "a93f36de",
   "kr": "다니지 못하니, 서쪽으로 돌아 폴티아로"
  },
  "93": {
   "jp": "88f8d3fb",
   "kr": "돌아와야만 한다."
  },
  "94": {
   "jp": "5c49a3c1",
   "kr": "아마 이 마을에 돌아오는 건…"
  },
  "95": {
   "jp": "84d4e503",
   "kr": "잘 풀려도 석 달 뒤겠지."
  },
  "96": {
   "jp": "06feb5a5",
   "kr": "석 달이나!?"
  },
  "97": {
   "jp": "3b34a07a",
   "kr": "그동안 드는 돈은 어떡해요?"
  },
  "98": {
   "jp": "67eb78f4",
   "kr": "그거라면 걱정 말거라. 순례를 떠나는 자는"
  },
  "99": {
   "jp": "7d8fc491",
   "kr": "은단검을 지니는 관례가 있지."
  },
  "100": {
   "jp": "3b2ba76b",
   "kr": "그게 있는 한 숙박비도 뱃삯도 모두 공짜다."
  },
  "101": {
   "jp": "13778cf3",
   "kr": "게다가 관문에서 통행증 노릇도 한단다."
  },
  "102": {
   "jp": "6ef987e1",
   "kr": "그러니 둘은 제 걸음대로 조급해하지 말고"
  },
  "103": {
   "jp": "bf2ba6eb",
   "kr": "여행을 이어 가면 된다."
  },
  "104": {
   "jp": "23bf5196",
   "kr": "잘 듣거라. 쥬리오, 크리스티나."
  },
  "105": {
   "jp": "e5a7a7fb",
   "kr": "중요한 건 순례를 끝내는 게 아니라"
  },
  "106": {
   "jp": "6d415c38",
   "kr": "여행에서 무엇을 찾느냐란다."
  },
  "107": {
   "jp": "f0d36877",
   "kr": "뭐, 내가 일러 줄 마음가짐은 이쯤이려나."
  },
  "108": {
   "jp": "873b22f5",
   "kr": "오늘은 푹 쉬고 내일에 대비하거라."
  },
  "109": {
   "jp": "5a218bed",
   "kr": "은단검은 내일 떠날 때 주도록 하마."
  },
  "110": {
   "jp": "fc2b21b6",
   "kr": "결국 마음대로 여행하면 되는 거죠?"
  },
  "111": {
   "jp": "49671dd9",
   "kr": ""
  },
  "112": {
   "jp": "4299d755",
   "kr": "…크리스."
  },
  "113": {
   "jp": "7fe38e9b",
   "kr": "부디 쥬리오에게서 눈을 떼지 말거라."
  },
  "114": {
   "jp": "e76c302d",
   "kr": "자, 둘 다 내일 준비를 하고"
  },
  "115": {
   "jp": "e10042f0",
   "kr": "오늘 밤은 푹 자거라."
  },
  "116": {
   "jp": "85752cb7",
   "kr": "그럼, 쥬리오."
  },
  "117": {
   "jp": "8f91ce47",
   "kr": "난 집에 갈게."
  },
  "118": {
   "jp": "ee12e022",
   "kr": "응. 내일 봐."
  },
  "119": {
   "jp": "66a5730b",
   "kr": "마법의 거울이 비추는 경치도 아름답지만"
  },
  "120": {
   "jp": "6c843eeb",
   "kr": "여행지에서 만나는 사람들과의"
  },
  "121": {
   "jp": "bd036831",
   "kr": "추억도 분명 더없이 소중할 거야."
  },
  "122": {
   "jp": "84b5655f",
   "kr": "오, 쥬리오냐."
  },
  "123": {
   "jp": "9099422a",
   "kr": "촌장님 부탁으로"
  },
  "124": {
   "jp": "dd805298",
   "kr": "이 울타리를 고치는 중이야."
  },
  "125": {
   "jp": "259f0542",
   "kr": "촌장님 긴 이야기는 여전하군."
  },
  "126": {
   "jp": "7e2967a0",
   "kr": "나도 여행 마음가짐을 들을 땐"
  },
  "127": {
   "jp": "59af5a4d",
   "kr": "가볍게 세 시간은 들었으니까."
  },
  "128": {
   "jp": "0a1d326f",
   "kr": "긴 순례 여행에선 괴로운 일도 있을 게다."
  },
  "129": {
   "jp": "44d397e5",
   "kr": "하지만 다시 이 마을에 돌아왔을 땐"
  },
  "130": {
   "jp": "375b2b1b",
   "kr": "분명 멋진 추억으로 바뀌어 있을 거야."
  },
  "131": {
   "jp": "1300fc3c",
   "kr": "쥬리오오, 놀아 줘!"
  },
  "132": {
   "jp": "f3342704",
   "kr": "에〜? 좀 피곤한데."
  },
  "133": {
   "jp": "e5d27b6d",
   "kr": "그치만 쥬리오는 내일부터 없잖아."
  },
  "134": {
   "jp": "d7b02859",
   "kr": "그으러니까 놀아 줘어."
  },
  "135": {
   "jp": "e8f4303e",
   "kr": "안 놀아 주면 삐뚤어질 거야."
  },
  "136": {
   "jp": "9eb5f5fc",
   "kr": "조, 좋아! 술래잡기다."
  },
  "137": {
   "jp": "4c8a897c",
   "kr": "이제 비틀비틀해."
  },
  "138": {
   "jp": "7ef9443e",
   "kr": "더 해 줘!"
  },
  "139": {
   "jp": "821d233f",
   "kr": "쥬리오가 순례를 떠나 있는 동안"
  },
  "140": {
   "jp": "f69704b6",
   "kr": "이 아이가 쓸쓸해하겠구나."
  },
  "141": {
   "jp": "bff98db9",
   "kr": "촌장님 이야기를 듣고 왔냐?"
  },
  "142": {
   "jp": "68d14034",
   "kr": "그럼, 내일은 은단검 수여식이겠군."
  },
  "143": {
   "jp": "d68030a3",
   "kr": "얼른 준비를 갖춰야지."
  },
  "144": {
   "jp": "9f12f638",
   "kr": "내일은 나도 장사를 안 하거든."
  },
  "145": {
   "jp": "d71f26f7",
   "kr": "살 거면 지금이야."
  },
  "146": {
   "jp": "265b31c5",
   "kr": "자, 무슨 볼일이지?"
  },
  "147": {
   "jp": "ac5d48bb",
   "kr": "쥬리오는 어릴 적부터"
  },
  "148": {
   "jp": "cc2e8790",
   "kr": "쓸데없는 걸 사는 버릇이 있었지."
  },
  "149": {
   "jp": "adc4d538",
   "kr": "자, 물건은 제대로 골라서 사라고."
  },
  "150": {
   "jp": "a03edca0",
   "kr": "그래."
  },
  "151": {
   "jp": "99668f10",
   "kr": "자, 찬찬히 골라 봐."
  },
  "152": {
   "jp": "c2065a34",
   "kr": "인가?"
  },
  "153": {
