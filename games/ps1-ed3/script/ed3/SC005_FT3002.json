 "lines": {
  "0": {
   "jp": "c9fab11d",
   "kr": "매발톱호"
  },
  "1": {
   "jp": "0f879f86",
   "kr": "보스레이"
  },
  "2": {
   "jp": "87ed524e",
   "kr": "가톤"
  },
  "3": {
   "jp": "c1b14629",
   "kr": "브루트"
  },
  "4": {
   "jp": "73e57527",
   "kr": "질버 선장"
  },
  "5": {
   "jp": "898074d7",
   "kr": "조리장"
  },
  "6": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "7": {
   "jp": "bfa78afe",
   "kr": "그럼"
  },
  "8": {
   "jp": "3f2eec29",
   "kr": "오늘은 갑판 청소를 부탁한다."
  },
  "9": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "10": {
   "jp": "bdebe7b3",
   "kr": "쥬리오 덕분에 큰 도움이 된다."
  },
  "11": {
   "jp": "d75a9643",
   "kr": "여객선이라도 일이 많아서 말이야."
  },
  "12": {
   "jp": "9e7c10a7",
   "kr": "난 선창 점검이 있으니까"
  },
  "13": {
   "jp": "61272b27",
   "kr": "미안하지만 돌아올 때까지"
  },
  "14": {
   "jp": "6cfed1b5",
   "kr": "갑판 청소를 끝내 줘."
  },
  "15": {
   "jp": "509d7315",
   "kr": "잘 부탁한다!"
  },
  "16": {
   "jp": "a6ed64b9",
   "kr": "꽤 재밌어, 이거."
  },
  "17": {
   "jp": "37bb1702",
   "kr": "오, 쥬리오."
  },
  "18": {
   "jp": "d6c91cb0",
   "kr": "갑판 청소 수고했다."
  },
  "19": {
   "jp": "b27f4c85",
   "kr": "어떠냐."
  },
  "20": {
   "jp": "8532e38f",
   "kr": "푸르고 드넓은 바다를 여행하는 뱃사람 생활도"
  },
  "21": {
   "jp": "e4707775",
   "kr": "나쁘지 않지?"
  },
  "22": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "23": {
   "jp": "9967f499",
   "kr": "최고예요."
  },
  "24": {
   "jp": "027cc541",
   "kr": "그치만 늘 이렇게 잔잔한 날만"
  },
  "25": {
   "jp": "d3df2a69",
   "kr": "없단다. 폭풍이 치는 날도 있고, 바다 괴물"
  },
  "26": {
   "jp": "ca83845e",
   "kr": "과 마주칠 때도 있고."
  },
  "27": {
   "jp": "922de81d",
   "kr": "해수 가루가라고 아냐?"
  },
  "28": {
   "jp": "ef6fe97e",
   "kr": "고래보다 커다란 바다 괴물이야."
  },
  "29": {
   "jp": "ac5202e1",
   "kr": "가루가에게 습격당하면 버텨 낼 재간이 없어."
  },
  "30": {
   "jp": "fa0c6f4c",
   "kr": "고래보다 커요!?"
  },
  "31": {
   "jp": "9f9d1f8b",
   "kr": "그래, 엄청나게 크다."
  },
  "32": {
   "jp": "729d23d1",
   "kr": "바다에는 인간의 상상을 훨씬 넘어선 생물이"
  },
  "33": {
   "jp": "250b9dda",
   "kr": "잔뜩 살고 있어."
  },
  "34": {
   "jp": "239f6978",
   "kr": "그런〜"
  },
  "35": {
   "jp": "344c01cd",
   "kr": "그렇게 큰 괴물에게 습격당하면"
  },
  "36": {
   "jp": "0f440716",
   "kr": "어떡해요?"
  },
  "37": {
   "jp": "54b11b7b",
   "kr": "하하하, 괜찮아."
  },
  "38": {
   "jp": "547252a3",
   "kr": "가루가는 크지만"
  },
  "39": {
   "jp": "b5cce956",
   "kr": "평소엔 얌전한 동물이야."
  },
  "40": {
   "jp": "e574d45b",
   "kr": "이쪽이 놈의 보금자리에 다가가지 않으면"
  },
  "41": {
   "jp": "85aa2b97",
   "kr": "덤비지는 않아."
  },
  "42": {
   "jp": "4dfe8270",
   "kr": "하기야, 배가 항로를 벗어나"
  },
  "43": {
   "jp": "f4b580eb",
   "kr": "가루가 둥지에라도 들어가면"
  },
  "44": {
   "jp": "aa1fef95",
   "kr": "끝장이지만."
  },
  "45": {
   "jp": "824a8cf1",
   "kr": "뱃사람 일이란 건"
  },
  "46": {
   "jp": "17d4adf0",
   "kr": "늘 위험과 맞닿아 있다는 거야."
  },
  "47": {
   "jp": "abc053b2",
   "kr": "뭐, 그런 건 우리한테 맡기고"
  },
  "48": {
   "jp": "2476b332",
   "kr": "쥬리오는 갑판 청소나 힘내라."
  },
  "49": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "50": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "51": {
   "jp": "158cb7ee",
   "kr": "크리스."
  },
  "52": {
   "jp": "567b22d5",
   "kr": "쥬리오도 힘내고 있구나."
  },
  "53": {
   "jp": "5061bccf",
   "kr": "자, 다음은 이걸 말려야지."
  },
  "54": {
   "jp": "782c8a59",
   "kr": "이렇게나?"
  },
  "55": {
   "jp": "92f1fef6",
   "kr": "크리스도 힘들겠다."
  },
  "56": {
   "jp": "8d6ee1a2",
   "kr": "근데, 어떻게 말려?"
  },
  "57": {
   "jp": "f804085d",
   "kr": "그게 문제야."
  },
  "58": {
   "jp": "18584afd",
   "kr": "아이고, 짐 정리는 고되구먼."
  },
  "59": {
   "jp": "a739e7c9",
   "kr": "오, 크리스."
  },
  "60": {
   "jp": "69ccfa66",
   "kr": "그거 말리려고?"
  },
  "61": {
   "jp": "e74cac1b",
   "kr": "좋아, 내가 널어 주마."
  },
  "62": {
   "jp": "65556e9a",
   "kr": "자."
  },
  "63": {
   "jp": "32de2271",
   "kr": "대충 이런 거지!"
  },
  "64": {
   "jp": "b4ffcb2d",
   "kr": "보스레이 씨, 고마워요."
  },
  "65": {
   "jp": "882f8c0a",
   "kr": "굉장해요!"
  },
  "66": {
   "jp": "ccadc348",
   "kr": "그보다도"
  },
  "67": {
   "jp": "c24f1012",
   "kr": "쥬리오는 갑판 청소 끝냈냐?"
  },
  "68": {
   "jp": "454d6116",
   "kr": "네, 끝났어요."
  },
  "69": {
   "jp": "2fbaa87f",
   "kr": "수고했다."
  },
  "70": {
   "jp": "4998de06",
   "kr": "나머진 느긋이 쉬어라."
  },
  "71": {
   "jp": "9cd9508b",
   "kr": "일 더 하고 싶어요."
  },
  "72": {
   "jp": "991b661b",
   "kr": "다음은 뭘 하면 돼요?"
  },
  "73": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "74": {
   "jp": "f07dfce2",
   "kr": "정말이냐. 요즘 애치고는"
  },
  "75": {
   "jp": "12acfe9e",
   "kr": "별난 녀석이군."
  },
  "76": {
   "jp": "ccdb3ba7",
   "kr": "그럼, 쥬리오는 질버 선장님께"
  },
  "77": {
   "jp": "7a902374",
   "kr": "알맞은 일이 없는지 여쭤 봐라."
  },
  "78": {
   "jp": "295a61f8",
   "kr": "크리스는 주방 돕기다."
  },
  "79": {
   "jp": "6ff41fa2",
   "kr": "오늘도 맛난 요리를 부탁한다."
  },
  "80": {
   "jp": "aca82459",
   "kr": "네〜에!"
  },
  "81": {
   "jp": "8eca9d93",
   "kr": "난 얼른 주방에 갈게."
  },
  "82": {
   "jp": "899a71af",
   "kr": "난 질버 선장님한테 가야지."
  },
  "83": {
   "jp": "60b3c823",
   "kr": "난 짐 점검 계속이다."
  },
  "84": {
   "jp": "bac09fe0",
   "kr": "그럼, 야무지게 가 보자고!"
  },
  "85": {
   "jp": "8bc4cb89",
   "kr": "오오!"
  },
  "86": {
   "jp": "97d49601",
   "kr": "질버 선장님!"
  },
  "87": {
   "jp": "59a75d1a",
   "kr": "어라…?"
  },
  "88": {
   "jp": "5990ac5e",
   "kr": "어디 갔을까."
  },
  "89": {
   "jp": "c9144d30",
   "kr": "《항해일지 1일째》"
  },
  "90": {
   "jp": "194ad047",
   "kr": "드디어 올해 항해도 이것으로 끝이다."
  },
  "91": {
   "jp": "f7aadf94",
   "kr": "유빙의 계절이 다가오고 있다."
  },
  "92": {
   "jp": "ffbaf2a4",
   "kr": "닐리에서 돌아 라그나로 가면 겨울 휴가다."
  },
  "93": {
   "jp": "4d59ffce",
   "kr": "올해 마지막 항해에 어울리는 손님이 탔다."
  },
  "94": {
   "jp": "0fb6f98d",
   "kr": "순례 여행자 쥬리오 군과 크리스 양이다."
  },
  "95": {
   "jp": "aa865a89",
   "kr": "이번 항해도 멋지게 해내겠다."
  },
  "96": {
   "jp": "a593457f",
   "kr": "오늘 것은 아직 안 적었네."
  },
  "97": {
   "jp": "b7d928b5",
   "kr": "쥬리오는 티라스일 항해도를 봤습니다."
  },
  "98": {
   "jp": "5ae75e00",
   "kr": "다음에 갈 테그라가… 어디 보자."
  },
  "99": {
   "jp": "920c9bfe",
   "kr": "아, 있다!"
  },
  "100": {
   "jp": "dafe7bd2",
   "kr": "디네의 높은 분이 말한 대로다."
  },
  "101": {
   "jp": "73b4cb50",
   "kr": "테그라는 섬이니까 또 배를 탈 수 있어!"
  },
  "102": {
   "jp": "27b3d902",
   "kr": "바〜다〜 저편에〜"
  },
  "103": {
   "jp": "19028291",
   "kr": "무〜엇이〜 있을까〜"
  },
  "104": {
   "jp": "8cc08816",
   "kr": "기다려라〜 해적 라몬〜"
  },
  "105": {
   "jp": "16dc2031",
   "kr": "나는〜 나아는〜 바다의 왕자〜"
  },
  "106": {
   "jp": "979bd495",
   "kr": "캡틴〜 토〜마스〜"
  },
  "107": {
   "jp": "4637f1aa",
   "kr": "무슨 노래예요?"
  },
  "108": {
   "jp": "354bb064",
   "kr": "좋은 노래지?"
  },
  "109": {
   "jp": "78d3ee2e",
   "kr": "캡틴 토마스의 노래다."
  },
  "110": {
   "jp": "a930cafb",
   "kr": "앗, 캡틴 토마스라면 알아요."
  },
  "111": {
   "jp": "d2d842f9",
   "kr": "어릴 적 엄마가 자주 읽어 주셨거든요."
  },
  "112": {
   "jp": "58eb64b6",
   "kr": "그 동화에도 노래가 있었군요."
  },
  "113": {
   "jp": "eec9701c",
   "kr": "아니."
  },
  "114": {
   "jp": "30d63dd9",
   "kr": "작사 작곡 가톤."
  },
  "115": {
   "jp": "09a8177c",
   "kr": "…농담이야."
  },
  "116": {
   "jp": "0f2aebec",
   "kr": "……"
  },
  "117": {
   "jp": "13c1a841",
   "kr": "선장은 이 시간이면"
  },
  "118": {
   "jp": "86587b52",
   "kr": "선내를 순찰하고 있을 거다."
  },
  "119": {
   "jp": "7e8c402c",
   "kr": "자, 힘차게 가 보자고!"
  },
  "120": {
   "jp": "2b29bb06",
   "kr": "보이는 건 온통 수평선…"
  },
  "121": {
   "jp": "31b40fef",
   "kr": "매발톱호가 내 집처럼 느껴지는 거"
  },
  "122": {
   "jp": "bce94d72",
   "kr": "알겠지?"
  },
  "123": {
   "jp": "28df8b99",
   "kr": "아아. 질버 선장이라면,"
  },
  "124": {
   "jp": "14ea9d8d",
   "kr": "아까 방에서 나가는 걸 봤어."
  },
  "125": {
   "jp": "986b8c05",
   "kr": "오늘도 갑판 청소니?"
  },
  "126": {
   "jp": "442bb90f",
   "kr": "참, 질버 선장이 칭찬하더구나."
  },
  "127": {
   "jp": "fd35efc8",
   "kr": "쥬리오 군은 일 잘하는 착한 애라고."
  },
  "128": {
   "jp": "474e139b",
   "kr": "에헤헤, 쑥스럽네요."
  },
  "129": {
   "jp": "8078d4b6",
   "kr": "오늘도 크리스 아가씨와의"
  },
  "130": {
   "jp": "229fbb0d",
   "kr": "합작 요리로 가야겠군."
  },
  "131": {
   "jp": "226460ea",
   "kr": "질버 선장은"
  },
  "132": {
   "jp": "b8001a23",
   "kr": "이 배와 승무원을 정말로 소중히 여긴다."
  },
  "133": {
   "jp": "05766a6f",
   "kr": "시간이 나면 선내 여기저기를"
  },
  "134": {
   "jp": "ed0b7815",
   "kr": "순찰하고 있단다."
  },
  "135": {
   "jp": "778e382a",
   "kr": "오늘이야말로 맛있게 만들 거야."
  },
  "136": {
   "jp": "099177d4",
   "kr": "쥬리오도 힘내!"
  },
  "137": {
   "jp": "da9a1423",
   "kr": "비켜, 비켜."
  },
  "138": {
   "jp": "1f3f0a41",
   "kr": "오늘이야말로 뱃사람들 모두를"
  },
  "139": {
   "jp": "061ce9c0",
   "kr": "감탄하게 만들 거니까."
  },
  "140": {
   "jp": "0f17e8aa",
   "kr": "우선은 밑준비야."
  },
  "141": {
   "jp": "3d075f94",
   "kr": "이쯤까지는 자신 있는데 말이야."
  },
  "142": {
   "jp": "fe9e0663",
   "kr": "쥬리오! 게으름 피우고 있네!"
  },
  "143": {
   "jp": "adf46355",
   "kr": "얼른 일이나 해."
  },
  "144": {
   "jp": "e82c34db",
   "kr": "아니야!"
  },
  "145": {
   "jp": "68b6a8b0",
   "kr": "선장님을 찾고 있어."
  }
 }
}