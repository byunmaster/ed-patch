{
 "archive": "/SCE1/SC103.DAT",
 "member": "..\\DATA\\MT4100.BIN",
 "lines": {
  "0": {
   "jp": "7851a095",
   "kr": "넬바"
  },
  "1": {
   "jp": "f3b21c53",
   "kr": "성 아랫마을"
  },
  "2": {
   "jp": "203b1c40",
   "kr": "빌"
  },
  "3": {
   "jp": "8ff5fa0a",
   "kr": "마농 할머니"
  },
  "4": {
   "jp": "79714ffe",
   "kr": "단크 대장"
  },
  "5": {
   "jp": "60f49c58",
   "kr": "메나트 병사"
  },
  "6": {
   "jp": "819ba072",
   "kr": "메나트 병사들"
  },
  "7": {
   "jp": "4cb8fabd",
   "kr": "페네"
  },
  "8": {
   "jp": "e7550555",
   "kr": "바질"
  },
  "9": {
   "jp": "ae9e39b1",
   "kr": "칸드의 가라드"
  },
  "10": {
   "jp": "3aedc896",
   "kr": "시메라 부인"
  },
  "11": {
   "jp": "8cba77fe",
   "kr": "바드"
  },
  "12": {
   "jp": "93a685b5",
   "kr": "콜"
  },
  "13": {
   "jp": "4bec4459",
   "kr": "흠, 여행자인가?"
  },
  "14": {
   "jp": "1d8cadc0",
   "kr": "미안하지만 이 여관은 넬바군 임시 사령부로"
  },
  "15": {
   "jp": "3768b04b",
   "kr": "쓰고 있다."
  },
  "16": {
   "jp": "54697b87",
   "kr": "미안하지만 숙박은 삼가 주게."
  },
  "17": {
   "jp": "a2cade77",
   "kr": "너무 어슬렁대지 마라."
  },
  "18": {
   "jp": "0e63e9d8",
   "kr": "긍지 높은 넬바 병사의 오기를 보여 주마."
  },
  "19": {
   "jp": "b1d9671c",
   "kr": "우린 주저앉지 않는다."
  },
  "20": {
   "jp": "67341228",
   "kr": "어릴 땐 아버지 일을 거들곤 했지."
  },
  "21": {
   "jp": "5cd3806c",
   "kr": "아버지는 마을 제일의 목수였거든."
  },
  "22": {
   "jp": "1601a62d",
   "kr": "곧 마을을 원래대로 돌려놓겠다."
  },
  "23": {
   "jp": "7fceb920",
   "kr": "내가 나고 자란 마을을"
  },
  "24": {
   "jp": "22722f2e",
   "kr": "반드시 원래대로 돌려놓겠어."
  },
  "25": {
   "jp": "b040f44e",
   "kr": "가루가 녀석, 두고 보자."
  },
  "26": {
   "jp": "ff43c9f8",
   "kr": "넬바 최대의 마을이"
  },
  "27": {
   "jp": "7a5a378b",
   "kr": "이렇게 쉽게 무너지다니."
  },
  "28": {
   "jp": "e5857898",
   "kr": "이런이런…"
  },
  "29": {
   "jp": "eb9d8d06",
   "kr": "그건 그렇고"
  },
  "30": {
   "jp": "72bda9ae",
   "kr": "요란하게도 부숴 놨군."
  },
  "31": {
   "jp": "5061d08d",
   "kr": "좋았어!"
  },
  "32": {
   "jp": "3918112e",
   "kr": "한번 힘내 볼까!"
  },
  "33": {
   "jp": "fbcdb1ef",
   "kr": "전보다 멋진 마을로 만들겠어."
  },
  "34": {
   "jp": "41c50f1a",
   "kr": "우선 비바람은 피할 수 있게 하자."
  },
  "35": {
   "jp": "3f10baf3",
   "kr": "잠깐 너희들."
  },
  "36": {
   "jp": "49fce6bf",
   "kr": "위험하니까"
  },
  "37": {
   "jp": "3b891ee6",
   "kr": "너무 가까이 오지 마라."
  },
  "38": {
   "jp": "e25b7906",
   "kr": "젠장…"
  },
  "39": {
   "jp": "19f0a2a7",
   "kr": "이런 때 다쳐서 못 움직이다니!"
  },
  "40": {
   "jp": "1529e21d",
   "kr": "지금이 이 나라에서 가장 중요한 때인데."
  },
  "41": {
   "jp": "26450e00",
   "kr": "가루가 상륙은 마치 산이 쳐들어온 듯했어."
  },
  "42": {
   "jp": "17c54011",
   "kr": "…하지만, 상대도 생물이야."
  },
  "43": {
   "jp": "74beb0a6",
   "kr": "다음에 덮쳐 오면 한 방 먹여 주겠어."
  },
  "44": {
   "jp": "58d06610",
   "kr": "…아야야."
  },
  "45": {
   "jp": "bce6c2eb",
   "kr": "흥분하면, 아직 상처가 쑤셔…"
  },
  "46": {
   "jp": "c4f69534",
   "kr": "나도 명예로운 넬바 병사."
  },
  "47": {
   "jp": "8b10d14e",
   "kr": "어서 복귀해서 이 마을을 되돌려 놓겠어."
  },
  "48": {
   "jp": "dfb977d1",
   "kr": "기다리게 했군."
  },
  "49": {
   "jp": "57c0fddd",
   "kr": "노르딕 왕이 튜엘에 도착했다는"
  },
  "50": {
   "jp": "bbfa8a61",
   "kr": "보고가 들어왔으니 이제 지나가도 된다."
  },
  "51": {
   "jp": "61349871",
   "kr": "여행길 무사하길 빈다."
  },
  "52": {
   "jp": "a6228ceb",
   "kr": "여행자로군."
  },
  "53": {
   "jp": "8088d5e1",
   "kr": "미안하지만 노르딕 왕이"
  },
  "54": {
   "jp": "6b52cc71",
   "kr": "튜엘에 도착할 때까지"
  },
  "55": {
   "jp": "47465104",
   "kr": "가도를 봉쇄하고 있다."
  },
  "56": {
   "jp": "0841db48",
   "kr": "당분간 넬바에서 기다려 주시오."
  },
  "57": {
   "jp": "a0504f68",
   "kr": "아, 이거 참…"
  },
  "58": {
   "jp": "346e2b0f",
   "kr": "아무리 우리 집만 무사해도 말이지."
  },
  "59": {
   "jp": "b14f1830",
   "kr": "마을이 이 꼴이니 마냥 기쁠 순 없어."
  },
  "60": {
   "jp": "ec5bee3b",
   "kr": "집이 부서진 사람들에게 안됐고"
  },
  "61": {
   "jp": "b4d84aaf",
   "kr": "『몰인정한 놈』이라 불리고 싶진 않으니까."
  },
  "62": {
   "jp": "0914eb80",
   "kr": "으〜음, 괴로운 노릇이야."
  },
  "63": {
   "jp": "3a71495d",
   "kr": "역시 이럴 때는"
  },
  "64": {
   "jp": "6ebd71ae",
   "kr": "심각한 얼굴을 하는 편이 나은 걸까…"
  },
  "65": {
   "jp": "dae5e9da",
   "kr": "아니 글쎄, 봤다니까. 아까."
  },
  "66": {
   "jp": "9c017d57",
   "kr": "노르딕 왕이 시종을 거느리고"
  },
  "67": {
   "jp": "980b1667",
   "kr": "튜엘 쪽으로 가는 걸 말이야."
  },
  "68": {
   "jp": "8128d1ad",
   "kr": "분명 성이 없어졌으니"
  },
  "69": {
   "jp": "161ed29a",
   "kr": "넬바가 복구될 때까지 튜엘에서"
  },
  "70": {
   "jp": "d2b4035e",
   "kr": "형편을 볼 셈인 게지."
  },
  "71": {
   "jp": "bc6aa01f",
   "kr": "임금님이라면 이런 때야말로"
  },
  "72": {
   "jp": "19b04359",
   "kr": "백성과 한마음이 되어"
  },
  "73": {
   "jp": "d8987def",
   "kr": "나라를 일으켜야 한다고 보는데."
  },
  "74": {
   "jp": "6cd7622c",
   "kr": "뭐, 임금님한텐"
  },
  "75": {
   "jp": "ebed215a",
   "kr": "임금님 나름의 생각이 있겠지만."
  },
  "76": {
   "jp": "3f7a5295",
   "kr": "몰래 숨어선 안 되지."
  },
  "77": {
   "jp": "c7218eba",
   "kr": "어머, 손님?"
  },
  "78": {
   "jp": "fe697976",
   "kr": "저는 이 여관 딸 페네예요."
  },
  "79": {
   "jp": "9837aaa9",
   "kr": "저, 오늘은 재워 주실 수 없나요?"
  },
  "80": {
   "jp": "5ba15f18",
   "kr": "미안해요."
  },
  "81": {
   "jp": "47c5ff57",
   "kr": "당분간은 병사님들이 빌려서 휴업 중이에요."
  },
  "82": {
   "jp": "ecd91223",
   "kr": "안쪽엔 다친 병사님도 요양 중이고"
  },
  "83": {
   "jp": "198733c7",
   "kr": "지금은 손이 모자라요. 미안해요."
  },
  "84": {
   "jp": "e1d67df5",
   "kr": "밤이 되면 병사님들이 많이 돌아오니까"
  },
  "85": {
   "jp": "2c75e8a5",
   "kr": "묵는 건 안 되지만 그때까지는"
  },
  "86": {
   "jp": "0bf7d79f",
   "kr": "편히 쉬셔도 괜찮아요."
  },
  "87": {
   "jp": "a9b4daf1",
   "kr": "죄송해요."
  },
  "88": {
   "jp": "ba9b6693",
   "kr": "다음에 묵으실 때는 서비스해 드릴 테니"
  },
  "89": {
   "jp": "b707a218",
   "kr": "안정되면 또 들러 주십시오."
  },
  "90": {
   "jp": "3e6a7ca5",
   "kr": "정말 죄송합니다."
  },
  "91": {
   "jp": "209ae904",
   "kr": "옛날엔, 티라스일 사람들도"
  },
  "92": {
   "jp": "e43294e0",
   "kr": "지금보다 강한 마법을 썼습니다."
  },
  "93": {
   "jp": "d81dd1ec",
   "kr": "허나, 마법을 형식으로만 받아들인 결과"
  },
  "94": {
   "jp": "1e03d922",
   "kr": "가루가가 와도, 마을이 부서져도"
  },
  "95": {
   "jp": "3aa7f745",
   "kr": "쓸모 있는 마법을 못 썼습니다…"
  },
  "96": {
   "jp": "d0bc7ff1",
   "kr": "한탄스럽다 생각지 않습니까?"
  },
  "97": {
   "jp": "4a23e3a7",
   "kr": "이 땅에 마법을 전한"
  },
  "98": {
   "jp": "ad819af8",
   "kr": "바다 건너온 마녀들에게 면목이 없습니다."
  },
  "99": {
   "jp": "d00ffa4a",
   "kr": "넬바 칸드에 잘 오셨습니다."
  },
  "100": {
   "jp": "89255841",
   "kr": "어느 분께 전수할까요?"
  },
  "101": {
   "jp": "7ce46b82",
   "kr": "어느 마법을 원하시나요?"
  },
  "102": {
   "jp": "941f0265",
   "kr": "말이군요."
  },
  "103": {
   "jp": "01aa32e3",
   "kr": "전수하겠습니다."
  },
  "104": {
   "jp": "d2999fa4",
   "kr": "마법이 그대의 좋은 벗이기를."
  },
  "105": {
   "jp": "96032764",
   "kr": "노르딕 왕은"
  },
  "106": {
   "jp": "6cbe4be2",
   "kr": "아무래도 튜엘로 피난한 모양이야."
  },
  "107": {
   "jp": "801e6551",
   "kr": "높은 분들은 달아날 데가 있어 좋겠네."
  },
  "108": {
   "jp": "0fe888cd",
   "kr": "칸드 마법은 챠펠 마법과 달리"
  },
  "109": {
   "jp": "5eea95bb",
   "kr": "공격적인 마법이 많아."
  },
  "110": {
   "jp": "48d42e9f",
   "kr": "마수를 쫓아내는 데는 편리한 마법이지."
  },
  "111": {
   "jp": "47cd0c9c",
   "kr": "하지만, 아무나 다룰 수 있는 마법은 아냐."
  },
  "112": {
   "jp": "756a0973",
   "kr": "챠펠 마법도 그렇지만 타고난 소양이"
  },
  "113": {
   "jp": "05bda077",
   "kr": "필요하거든."
  },
  "114": {
   "jp": "3a43f686",
   "kr": "너희도 여행을 하고 있다면"
  },
  "115": {
   "jp": "def79b62",
   "kr": "칸드 마법을 다루는 동료가 한 사람쯤 있으면"
  },
  "116": {
   "jp": "604154be",
   "kr": "훨씬 수월할 거야."
  },
  "117": {
   "jp": "804348b0",
   "kr": "조금 전에 말이야."
  },
  "118": {
   "jp": "d1c047da",
   "kr": "임금님이 시종을 데리고"
  },
  "119": {
   "jp": "5bd409d5",
   "kr": "튜엘로 떠났거든."
  },
  "120": {
   "jp": "18cdb414",
   "kr": "그래서, 길이 붐비지 않게"
  },
  "121": {
   "jp": "00bed3a5",
   "kr": "튜엘까지 가는 가도는"
  },
  "122": {
   "jp": "561e0ca7",
   "kr": "한동안 못 지나가."
  },
  "123": {
   "jp": "4da84cb7",
   "kr": "높은 분들은 제멋대로라니까."
  },
  "124": {
   "jp": "978f8226",
   "kr": "들어라! 우리 왕도 넬바는"
  },
  "125": {
   "jp": "75310bdc",
   "kr": "지금 존망의 위기에 있다!"
  },
  "126": {
   "jp": "8d6d1c0f",
   "kr": "이 마을에, 다시 불빛과"
  },
  "127": {
   "jp": "26274503",
   "kr": "사람들의 웃음소리를 되찾는 거다!"
  },
  "128": {
   "jp": "8b03cc58",
   "kr": "그리고 하루라도 빨리"
  },
  "129": {
   "jp": "31597430",
   "kr": "노르딕 왕을 모실 수 있도록"
  },
  "130": {
   "jp": "3916405a",
   "kr": "넬바성을 복구한다."
  },
  "131": {
   "jp": "567df29e",
   "kr": "그럼 각자, 위치로!!"
  },
  "132": {
   "jp": "afaf3c16",
   "kr": "예!"
  },
  "133": {
   "jp": "52502f16",
   "kr": "이놈!"
  },
  "134": {
   "jp": "d4460f89",
   "kr": "문밖으로 나오지 못하겠느냐!"
  },
  "135": {
   "jp": "e6024306",
   "kr": "상황이 정말 심각하네."
  },
  "136": {
   "jp": "4d4f79e8",
   "kr": "그래도 다들, 이 마을을 어서 원래대로"
  },
  "137": {
   "jp": "09a924f8",
   "kr": "되돌리자는 마음이 전해져 와."
  },
  "138": {
   "jp": "ff91bb5f",
   "kr": "나라 위해 몸 바치는 병사…"
  },
  "139": {
   "jp": "65b4c9e4",
   "kr": "이게 이상적인 걸세."
  }
 }
}