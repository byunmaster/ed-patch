{
 "archive": "/SCE2/SC205.DAT",
 "member": "..\\DATA\\CT3000.BIN",
 "lines": {
  "0": {
   "jp": "ec4ac565",
   "kr": "삼도교"
  },
  "1": {
   "jp": "d4f10e64",
   "kr": "폰테"
  },
  "2": {
   "jp": "4374bacd",
   "kr": "모스트"
  },
  "3": {
   "jp": "5df07921",
   "kr": "사이트"
  },
  "4": {
   "jp": "0554d85e",
   "kr": "이테르"
  },
  "5": {
   "jp": "e4db6bdd",
   "kr": "여기가 삼도교 입구네."
  },
  "6": {
   "jp": "623bb8f7",
   "kr": "우와〜 정말 굉장히 훌륭하게 지었네."
  },
  "7": {
   "jp": "8697c957",
   "kr": "챠놈과 앰비쉬를 잇는,"
  },
  "8": {
   "jp": "1b3528cf",
   "kr": "티라스일 최대의 큰 다리다."
  },
  "9": {
   "jp": "ca1177a0",
   "kr": "처음 지났을 때는 나도 감동했지."
  },
  "10": {
   "jp": "acc9a574",
   "kr": "어서 오세요."
  },
  "11": {
   "jp": "199a17f6",
   "kr": "삼도교에 잘 오셨어요."
  },
  "12": {
   "jp": "b1d921b5",
   "kr": "다리 견학만 하시겠습니까?"
  },
  "13": {
   "jp": "3e03af61",
   "kr": "아니면 다리를 건너"
  },
  "14": {
   "jp": "4c2f18b5",
   "kr": "앰비쉬에 입국하시겠습니까?"
  },
  "15": {
   "jp": "c5ab15cd",
   "kr": "입국한다"
  },
  "16": {
   "jp": "4c41567c",
   "kr": "견학만"
  },
  "17": {
   "jp": "153ac890",
   "kr": "우린 견학만 하면 돼요."
  },
  "18": {
   "jp": "2e0ce423",
   "kr": "무슨 소리야, 쥬리오."
  },
  "19": {
   "jp": "5be1a169",
   "kr": "우리 앰비쉬에 가는 거잖아."
  },
  "20": {
   "jp": "c2046eb9",
   "kr": "정말, 가끔 잠꼬대 같은 소리 한다니까."
  },
  "21": {
   "jp": "db6d3a2a",
   "kr": "못 말린다니까."
  },
  "22": {
   "jp": "9048e47a",
   "kr": "앰비쉬에 입국할게요."
  },
  "23": {
   "jp": "0b466704",
   "kr": "네, 입국할게요."
  },
  "24": {
   "jp": "8ac89ff0",
   "kr": "네. 입국이시군요."
  },
  "25": {
   "jp": "c8f1697f",
   "kr": "자, 지나가십시오."
  },
  "26": {
   "jp": "74dd9beb",
   "kr": "어라, 돈은 안 내도 돼요?"
  },
  "27": {
   "jp": "7a4e5eea",
   "kr": "이 다리는 관광세도 들지 않고"
  },
  "28": {
   "jp": "47c006d0",
   "kr": "통행증도 필요 없습니다."
  },
  "29": {
   "jp": "c6b69d4f",
   "kr": "다만, 다리를 통과하는 사람 수를"
  },
  "30": {
   "jp": "0abf6061",
   "kr": "확인하고 있을 뿐이에요."
  },
  "31": {
   "jp": "2b21478a",
   "kr": "좋은 여행 이야깃거리가 될 거예요."
  },
  "32": {
   "jp": "d40617b0",
   "kr": "찬찬히 경치를 즐기면서 건너십시오."
  },
  "33": {
   "jp": "865ebe9f",
   "kr": "옛날엔 이 다리가 없어서"
  },
  "34": {
   "jp": "bac08aa2",
   "kr": "앰비쉬 쪽으로 가는 게"
  },
  "35": {
   "jp": "444171f4",
   "kr": "큰일이었다는 이야기예요."
  },
  "36": {
   "jp": "a9d96ad6",
   "kr": "올도스는 지나갈 수 없고,"
  },
  "37": {
   "jp": "a2fbd6c2",
   "kr": "나그네는 우돌까지 돌아서,"
  },
  "38": {
   "jp": "1873b232",
   "kr": "육로로 갈 수밖에 없었지요."
  },
  "39": {
   "jp": "5f4d0d8b",
   "kr": "그건 그렇고 사람의 힘이란"
  },
  "40": {
   "jp": "3a566226",
   "kr": "대단한 거예요."
  },
  "41": {
   "jp": "cb554252",
   "kr": "이런 다리를 만들어 버리니까요."
  },
  "42": {
   "jp": "7125f768",
   "kr": "이야〜, 훌륭한 다리네요오."
  },
  "43": {
   "jp": "7c9ebd3c",
   "kr": "시골에 돌아가 자랑할 거리가"
  },
  "44": {
   "jp": "4fc57d88",
   "kr": "또 하나 늘었어요."
  },
  "45": {
   "jp": "3271a0f6",
   "kr": "어디서 도시락을 먹을까."
  },
  "46": {
   "jp": "3d085045",
   "kr": "날씨 좋은 게 제일이죠."
  },
  "47": {
   "jp": "af4d04bb",
   "kr": "나는 앰비쉬 쪽에서 왔어."
  },
  "48": {
   "jp": "cda3b736",
   "kr": "너희들은"
  },
  "49": {
   "jp": "c4c0e1c0",
   "kr": "이제부터 저쪽으로?"
  },
  "50": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "51": {
   "jp": "b9177796",
   "kr": "이제 다리를 건널 거예요."
  },
  "52": {
   "jp": "c14c5feb",
   "kr": "그럼, 조심하는 게 좋을 거야."
  },
  "53": {
   "jp": "5740a077",
   "kr": "항구 마을 볼트에선 가루가가 덮쳐 올지도"
  },
  "54": {
   "jp": "c4e89103",
   "kr": "모른다는 소문이 자자해."
  },
  "55": {
   "jp": "a68c47d8",
   "kr": "안데라성에서는 병사가 잔뜩 와 있고,"
  },
  "56": {
   "jp": "90789020",
   "kr": "이제부터 대결전이 시작될 분위기였어."
  },
  "57": {
   "jp": "3a0aab46",
   "kr": "너무 바닷가로 가지 않는 게 좋을 거야."
  },
  "58": {
   "jp": "4079e011",
   "kr": "그런가."
  },
  "59": {
   "jp": "c10449a6",
   "kr": "아직 가루가는 나타나지 않은 모양이군."
  },
  "60": {
   "jp": "6675c873",
   "kr": "늦진 않겠네."
  },
  "61": {
   "jp": "6f6e898d",
   "kr": "가루가 따위에"
  },
  "62": {
   "jp": "062cc969",
   "kr": "얽히지 않는 게 좋을 거야."
  }
 }
}