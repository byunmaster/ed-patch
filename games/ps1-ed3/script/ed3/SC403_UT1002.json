{
 "archive": "/SCE4/SC403.DAT",
 "member": "..\\DATA\\UT1002.BIN",
 "lines": {
  "0": {
   "jp": "e5bc39f1",
   "kr": "토네리코"
  },
  "1": {
   "jp": "9fbb527a",
   "kr": "라바 촌장"
  },
  "2": {
   "jp": "37a4fdad",
   "kr": "패드"
  },
  "3": {
   "jp": "b1d5a167",
   "kr": "조이"
  },
  "4": {
   "jp": "51219ef2",
   "kr": "미리아"
  },
  "5": {
   "jp": "335e7819",
   "kr": "패드. 조이."
  },
  "6": {
   "jp": "5a170d59",
   "kr": "미혹의 숲으로 통하는 문을 열게나."
  },
  "7": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "8": {
   "jp": "34556de9",
   "kr": "문을 엽니다."
  },
  "9": {
   "jp": "6daca440",
   "kr": "조심해서 가시게."
  },
  "10": {
   "jp": "20b4c7e2",
   "kr": "네. 고마워요."
  },
  "11": {
   "jp": "17b1d99c",
   "kr": "어떤가."
  },
  "12": {
   "jp": "edafbc8b",
   "kr": "미혹의 숲은 꽤나 만만찮지."
  },
  "13": {
   "jp": "a1077513",
   "kr": "차분히 길을 찾지 않으면"
  },
  "14": {
   "jp": "1732f944",
   "kr": "숲 안쪽에서 돌아오기도 어렵네."
  },
  "15": {
   "jp": "d72ab56c",
   "kr": "예전에 숲에 든 사람에게 들었는데"
  },
  "16": {
   "jp": "13884cf9",
   "kr": "이상한 석비가 있을 겁니다."
  },
  "17": {
   "jp": "e9d1bf41",
   "kr": "석비의 작용만 이해하면"
  },
  "18": {
   "jp": "cc6b5b9b",
   "kr": "어떻게든 될 것 같습니다만…"
  },
  "19": {
   "jp": "437c8019",
   "kr": "조심하세요."
  },
  "20": {
   "jp": "47bc380f",
   "kr": "쥬리오 씨."
  },
  "21": {
   "jp": "e278bcad",
   "kr": "알그레스가 있었군요?"
  },
  "22": {
   "jp": "117a2e74",
   "kr": "무사하셨군요."
  },
  "23": {
   "jp": "513f3c60",
   "kr": "용케 무사히 돌아왔구먼."
  },
  "24": {
   "jp": "1efb604b",
   "kr": "말 안 했네만 미혹의 숲 결계는"
  },
  "25": {
   "jp": "02c0ec48",
   "kr": "일찍이 하얀마녀 게르드가 숲과 짐승들을"
  },
  "26": {
   "jp": "6bab5723",
   "kr": "지키려고 만든 것일세."
  },
  "27": {
   "jp": "bb7f8bad",
   "kr": "그랬군요…"
  },
  "28": {
   "jp": "0590b9e2",
   "kr": "20년 전 이 땅을 찾은 게르드는"
  },
  "29": {
   "jp": "91371936",
   "kr": "사라지는 자연과 멸종하는 짐승들을 구하려고"
  },
  "30": {
   "jp": "7320a4e8",
   "kr": "여기에 마을을 짓고 숲을 지켜보라 일렀네."
  },
  "31": {
   "jp": "c443397c",
   "kr": "그것이 토네리코 마을의 시작일세."
  },
  "32": {
   "jp": "96309366",
   "kr": "숲이 남아 있어 준 덕분에…"
  },
  "33": {
   "jp": "c19e0939",
   "kr": "하얀마녀 덕분에"
  },
  "34": {
   "jp": "f5ee36b0",
   "kr": "저희는 알그레스의 뿔을 손에"
  },
  "35": {
   "jp": "03a41824",
   "kr": "넣을 수 있었어요."
  },
  "36": {
   "jp": "bd65b027",
   "kr": "하얀마녀께 감사해야겠네요."
  },
  "37": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "38": {
   "jp": "cf85031c",
   "kr": "자, 가시게."
  },
  "39": {
   "jp": "6953a1da",
   "kr": "모처럼 받은 알그레스의 뿔을"
  },
  "40": {
   "jp": "cbdabf66",
   "kr": "헛되이 해선 안 되네."
  },
  "41": {
   "jp": "f0fd009f",
   "kr": "어서 동료들에게 돌아가"
  },
  "42": {
   "jp": "a93ee2d0",
   "kr": "저주를 풀어 주게."
  },
  "43": {
   "jp": "930449fc",
   "kr": "촌장님."
  },
  "44": {
   "jp": "08e644d6",
   "kr": "조이 씨. 패드 씨."
  },
  "45": {
   "jp": "127a3052",
   "kr": "그리고 미리아 씨."
  },
  "46": {
   "jp": "3ac3804f",
   "kr": "여러모로 고마웠어요."
  },
  "47": {
   "jp": "bbb3451c",
   "kr": "얼른 크리스와 구스에게 돌아가"
  },
  "48": {
   "jp": "8eb304a3",
   "kr": "저주를 풀어 주고 싶으니"
  },
  "49": {
   "jp": "af63775d",
   "kr": "이만 실례할게요."
  },
  "50": {
   "jp": "f78e1809",
   "kr": "그래, 어서 가 보게."
  },
  "51": {
   "jp": "1cf06bbb",
   "kr": "그럼 이만."
  },
  "52": {
   "jp": "9b019ded",
   "kr": "쥬리오, 샤라, 휘리 세 사람은"
  },
  "53": {
   "jp": "46ac1257",
   "kr": "미혹의 숲에서 성수 알그레스에게 뿔을 받고"
  },
  "54": {
   "jp": "ae239051",
   "kr": "환술사 카지무에게 저주받은 크리스와 구스를"
  },
  "55": {
   "jp": "f2bab553",
   "kr": "구하려고 곧장 올도스로 서둘렀다."
  }
 }
}