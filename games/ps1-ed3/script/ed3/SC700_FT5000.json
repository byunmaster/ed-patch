{
 "archive": "/SCE7/SC700.DAT",
 "member": "..\\DATA\\FT5000.BIN",
 "lines": {
  "0": {
   "jp": "07150912",
   "kr": "돌페스"
  },
  "1": {
   "jp": "6deb6730",
   "kr": "치카"
  },
  "2": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "3": {
   "jp": "f4426211",
   "kr": "무기상 로이드"
  },
  "4": {
   "jp": "ef058870",
   "kr": "도구상 메렌다"
  },
  "5": {
   "jp": "f2abc503",
   "kr": "사페레"
  },
  "6": {
   "jp": "1f34c4fa",
   "kr": "세논"
  },
  "7": {
   "jp": "1809c811",
   "kr": "레페르트"
  },
  "8": {
   "jp": "661faa30",
   "kr": "칸드의 멧켄"
  },
  "9": {
   "jp": "cc4b519c",
   "kr": "알고 계세요?"
  },
  "10": {
   "jp": "0d72dea0",
   "kr": "요즘 세금이니 징병이니"
  },
  "11": {
   "jp": "90005071",
   "kr": "꽤 가혹해지고 있거든요."
  },
  "12": {
   "jp": "4bdebeba",
   "kr": "이 돌페스는"
  },
  "13": {
   "jp": "f907a08c",
   "kr": "본래 왕의 별궁으로 번성한 고장이라"
  },
  "14": {
   "jp": "4be22432",
   "kr": "그 정도는 아니지만…"
  },
  "15": {
   "jp": "1196721f",
   "kr": "작은 마을 같은 데서는"
  },
  "16": {
   "jp": "ba89f1a5",
   "kr": "폴티아를 버리고 다른 나라로 달아날"
  },
  "17": {
   "jp": "ad7edc8f",
   "kr": "마을 사람들도 있대요."
  },
  "18": {
   "jp": "68cf6821",
   "kr": "성 쪽은 왠지 어수선해 보이던데…"
  },
  "19": {
   "jp": "1bbf72aa",
   "kr": "그에 비하면 돌페스는 조용하기만 해."
  },
  "20": {
   "jp": "c6888ca0",
   "kr": "역시 내가 순찰을 도는 덕분인가."
  },
  "21": {
   "jp": "fdfb7e08",
   "kr": "아무 일도 안 일어나는 게 제일이지."
  },
  "22": {
   "jp": "8e781207",
   "kr": "요즘 난 자주 그런 생각을 해."
  },
  "23": {
   "jp": "274245cb",
   "kr": "자"
  },
  "24": {
   "jp": "44227abf",
   "kr": "다음 보초는 내 차례군."
  },
  "25": {
   "jp": "80fddb92",
   "kr": "옷도 갈아입었고, 세수도 했다."
  },
  "26": {
   "jp": "c7712254",
   "kr": "좋아, 준비는 됐어."
  },
  "27": {
   "jp": "011a5c89",
   "kr": "교대 시간까지 여기서 대기다."
  },
  "28": {
   "jp": "acc9a574",
   "kr": "어서 와."
  },
  "29": {
   "jp": "f59de76f",
   "kr": "우리는 돌페스 경비대에"
  },
  "30": {
   "jp": "3a20e1aa",
   "kr": "무기를 대고 있거든."
  },
  "31": {
   "jp": "44a45548",
   "kr": "좋은 무기가 잔뜩 있다고."
  },
  "32": {
   "jp": "20c815c0",
   "kr": "뭐가 필요하죠?"
  },
  "33": {
   "jp": "127db0a8",
   "kr": "인가."
  },
  "34": {
   "jp": "35358975",
   "kr": "그러면"
  },
  "35": {
   "jp": "15054edb",
   "kr": "받을게."
  },
  "36": {
   "jp": "47dbca29",
   "kr": "이거면 마수도 안 무섭겠어!"
  },
  "37": {
   "jp": "db59450c",
   "kr": "어느 걸, 파시겠어요?"
  },
  "38": {
   "jp": "127db0a8",
   "kr": "인가."
  },
  "39": {
   "jp": "abb8567e",
   "kr": "그렇다면,"
  },
  "40": {
   "jp": "ef144df2",
   "kr": "낼게."
  },
  "41": {
   "jp": "c5facdab",
   "kr": "환전율은 1 Goa당 15 Pia야."
  },
  "42": {
   "jp": "bf01e5cf",
   "kr": "괜찮아요?"
  },
  "43": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "44": {
   "jp": "a58aaaf5",
   "kr": "이 되겠군."
  },
  "45": {
   "jp": "07239858",
   "kr": "어린데 열심히 하시네요!"
  },
  "46": {
   "jp": "4da5e887",
   "kr": "라피카가 없네."
  },
  "47": {
   "jp": "0c183a55",
   "kr": "자, 힘내서 벌어 오세요!"
  },
  "48": {
   "jp": "fe9e8427",
   "kr": "그래요, 아쉽네요."
  },
  "49": {
   "jp": "02710b29",
   "kr": "다른 볼일은 없나요?"
  },
  "50": {
   "jp": "a7bb082c",
   "kr": "고마워."
  },
  "51": {
   "jp": "0e30173e",
   "kr": "무기랑 방어구는 자주 점검하세요."
  },
  "52": {
   "jp": "e05ece10",
   "kr": "이 돌페스 마을은 말이지."
  },
  "53": {
   "jp": "35597c94",
   "kr": "해안이 피서지로 적합해서,"
  },
  "54": {
   "jp": "a0fead28",
   "kr": "루드성의 별궁으로 지어진 곳이야."
  },
  "55": {
   "jp": "c13cfc61",
   "kr": "하기야"
  },
  "56": {
   "jp": "63990c73",
   "kr": "벌써 20년 전부터"
  },
  "57": {
   "jp": "c44be5bd",
   "kr": "임금님은 여기 오시지 않지만."
  },
  "58": {
   "jp": "4a7c2964",
   "kr": "듣자니 병사들 말로는,"
  },
  "59": {
   "jp": "7485ef61",
   "kr": "지금은 왕비님을 위해 지은 돌페스의 탑도"
  },
  "60": {
   "jp": "d38a6a4c",
   "kr": "감옥으로 쓰이고 있다더군."
  },
  "61": {
   "jp": "a3f09e01",
   "kr": "어머, 어서 오세요."
  },
  "62": {
   "jp": "98fc8d42",
   "kr": "무엇을 드릴까요?"
  },
  "63": {
   "jp": "d14b58e9",
   "kr": "무엇을 찾으시나요?"
  },
  "64": {
   "jp": "dd014f81",
   "kr": "이네요."
  },
  "65": {
   "jp": "35358975",
   "kr": "그럼"
  },
  "66": {
   "jp": "ee93304e",
   "kr": "입니다."
  },
  "67": {
   "jp": "7dba4922",
   "kr": "무엇을 파시겠습니까?"
  },
  "68": {
   "jp": "941f0265",
   "kr": "인가요."
  },
  "69": {
   "jp": "abb8567e",
   "kr": "그렇다면,"
  },
  "70": {
   "jp": "67afcad1",
   "kr": "에 사들이겠습니다."
  },
  "71": {
   "jp": "89dc036a",
   "kr": "환전율은 1 Goa당 15 Pia입니다."
  },
  "72": {
   "jp": "74b4488e",
   "kr": "괜찮습니까?"
  },
  "73": {
   "jp": "2798d283",
   "kr": "전부"
  },
  "74": {
   "jp": "ee93304e",
   "kr": "입니다."
  },
  "75": {
   "jp": "f90ebd6f",
   "kr": "라피카가 없으시네요."
  },
  "76": {
   "jp": "2445d3bb",
   "kr": "모이면, 언제든지 오세요."
  },
  "77": {
   "jp": "a7c5ef2c",
   "kr": "그 밖에 볼일은 없으신가요?"
  },
  "78": {
   "jp": "88239568",
   "kr": "감사합니다."
  },
  "79": {
   "jp": "496b6fe6",
   "kr": "여어, 교대 병사는"
  },
  "80": {
   "jp": "373b14db",
   "kr": "이 병영에서 갈아입는단다."
  },
  "81": {
   "jp": "b05f3137",
   "kr": "역시 갑옷을 벗으면 몸이 가벼워서 좋군."
  },
  "82": {
   "jp": "de22b738",
   "kr": "자, 이제 술집이라도 가 볼까."
  },
  "83": {
   "jp": "88269bb9",
   "kr": "여긴 평화로우니까."
  },
  "84": {
   "jp": "839cdc4b",
   "kr": "경비대가 주둔할 필요는 없지만."
  },
  "85": {
   "jp": "00b1f7a1",
   "kr": "루돌프 왕과 인연이 있는 별궁이라"
  },
  "86": {
   "jp": "31914a60",
   "kr": "일단 병사인 우리가 지키고 있는 거야."
  },
  "87": {
   "jp": "daac0db9",
   "kr": "안녕하세요."
  },
  "88": {
   "jp": "f01fca80",
   "kr": "여기서는 칸드 마법을 전수해 드립니다."
  },
  "89": {
   "jp": "f6f3f8dd",
   "kr": "칸드 마법 쓰는 분 중 필요한 분이 있다면,"
  },
  "90": {
   "jp": "edac0270",
   "kr": "전수해 드리지요."
  },
  "91": {
   "jp": "bfb7aed5",
   "kr": "어느 분이 원하시나요?"
  },
  "92": {
   "jp": "c6108ff0",
   "kr": "어느 마법을 원하시나요?"
  },
  "93": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "94": {
   "jp": "e978aaae",
   "kr": "알겠습니다."
  },
  "95": {
   "jp": "cd66dac6",
   "kr": "가르쳐 드리지요."
  },
  "96": {
   "jp": "aa928204",
   "kr": "또 들러 주십시오."
  },
  "97": {
   "jp": "a1e3dad9",
   "kr": "폴티아 왕비님의 이름을 아세요?"
  },
  "98": {
   "jp": "daf8241a",
   "kr": "이자벨 왕비님이라고 하세요."
  },
  "99": {
   "jp": "b455e167",
   "kr": "왕비님은"
  },
  "100": {
   "jp": "a46ea926",
   "kr": "무척 아름다운 분이라던데,"
  },
  "101": {
   "jp": "b6417acb",
   "kr": "한 번이라도 좋으니 뵙고 싶어요."
  }
 }
}