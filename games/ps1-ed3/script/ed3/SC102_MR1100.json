{
 "archive": "/SCE1/SC102.DAT",
 "member": "..\\DATA\\MR1100.BIN",
 "lines": {
  "0": {
   "jp": "41e91668",
   "kr": "전나무 들판"
  },
  "1": {
   "jp": "c3207776",
   "kr": "로베트"
  },
  "2": {
   "jp": "730aec4a",
   "kr": "여어, 난 떠돌이 상인 로베트일세."
  },
  "3": {
   "jp": "e99e63a9",
   "kr": "알데에서 장사를 하려고 왔는데,"
  },
  "4": {
   "jp": "df3e558f",
   "kr": "벼랑이 무너져 길이 막혔거든."
  },
  "5": {
   "jp": "4256143d",
   "kr": "포기하고 돌아가는 길이라네."
  },
  "6": {
   "jp": "82710479",
   "kr": "아쉬워요."
  },
  "7": {
   "jp": "a3a9e96f",
   "kr": "알데 사람들도, 그 너머 닐리 사람들도"
  },
  "8": {
   "jp": "12ed5c2f",
   "kr": "다들 상인 아저씨가 오기를 기다리고 있어요."
  },
  "9": {
   "jp": "7c7a56da",
   "kr": "그리 말해도 말이지…"
  },
  "10": {
   "jp": "81ce4a23",
   "kr": "그 벼랑이 저 모양이라 당분간은 글렀네."
  },
  "11": {
   "jp": "0d584bc7",
   "kr": "뭐, 또 금방 오면 되지."
  },
  "12": {
   "jp": "83fcd8db",
   "kr": "그건 그렇고 자네들 뭔가 필요한 건 없는가?"
  },
  "13": {
   "jp": "6bdbd0c1",
   "kr": "괜찮다면 물건을 보고 가지 않겠나."
  },
  "14": {
   "jp": "f34b1579",
   "kr": "나는 좀 더"
  },
  "15": {
   "jp": "033aa80b",
   "kr": "여기서 느긋하게 쉬어 갈까 하네."
  },
  "16": {
   "jp": "5681b02e",
   "kr": "조심해서 가게."
  },
  "17": {
   "jp": "6f6816b5",
   "kr": "뭘 찾으시는가?"
  },
  "18": {
   "jp": "620e2cd4",
   "kr": "일세."
  },
  "19": {
   "jp": "690dd8d9",
   "kr": "무얼 팔아 주시려나."
  },
  "20": {
   "jp": "b0fdc289",
   "kr": "라면"
  },
  "21": {
   "jp": "feafc91f",
   "kr": "이라네."
  },
  "22": {
   "jp": "9f7a5154",
   "kr": "환전이지?"
  },
  "23": {
   "jp": "2b391634",
   "kr": "요즘 영 경기가 나빠서 말이야."
  },
  "24": {
   "jp": "c628cc3c",
   "kr": "미안하지만 1Goa당 13Pia인데 괜찮나?"
  },
  "25": {
   "jp": "d359bb25",
   "kr": "옜네,"
  },
  "26": {
   "jp": "620e2cd4",
   "kr": "일세."
  },
  "27": {
   "jp": "fe88e564",
   "kr": "라피카가 모이면 또 와 주게."
  },
  "28": {
   "jp": "9b5431ec",
   "kr": "그 밖에 필요한 건 있는가?"
  }
 }
}