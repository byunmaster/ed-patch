{
 "archive": "/SCE8/SC800.DAT",
 "member": "..\\DATA\\RC1010.BIN",
 "lines": {
  "0": {
   "jp": "f80fe789",
   "kr": "루드"
  },
  "1": {
   "jp": "f3b21c53",
   "kr": "성 아랫마을"
  },
  "2": {
   "jp": "ad16b899",
   "kr": "칸드의 오우렘"
  },
  "3": {
   "jp": "3b882df9",
   "kr": "미아사 할머니"
  },
  "4": {
   "jp": "6f47e2af",
   "kr": "루이"
  },
  "5": {
   "jp": "32499e3b",
   "kr": "브리트 대장"
  },
  "6": {
   "jp": "d9208a17",
   "kr": "이곳에서는 칸드 마법을 전수해 드립니다."
  },
  "7": {
   "jp": "e0ce7a59",
   "kr": "칸드 마법을 다루실 분이 계신다면"
  },
  "8": {
   "jp": "edac0270",
   "kr": "전수해 드리겠습니다."
  },
  "9": {
   "jp": "01b5c18d",
   "kr": "어느 분께 전수할까요?"
  },
  "10": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "11": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "12": {
   "jp": "f739f830",
   "kr": "칸드의 힘이 필요할 때는"
  },
  "13": {
   "jp": "c61fc2a3",
   "kr": "언제든, 들러 주십시오."
  },
  "14": {
   "jp": "0a89b43c",
   "kr": "칸드와 챠펠은"
  },
  "15": {
   "jp": "0ed6c09e",
   "kr": "그 양쪽 마법이 다 있어야"
  },
  "16": {
   "jp": "5a731d8b",
   "kr": "사람에게 쓸모가 있는 것이네."
  },
  "17": {
   "jp": "b69096fa",
   "kr": "챠펠을 남기고"
  },
  "18": {
   "jp": "71b812c9",
   "kr": "칸드만을 추방하려 하다니…"
  },
  "19": {
   "jp": "918b6c32",
   "kr": "그 생각 자체가 그릇된 것이야."
  },
  "20": {
   "jp": "b609cf52",
   "kr": "칸드 마법을 추방하려 하다니…"
  },
  "21": {
   "jp": "1017d4a2",
   "kr": "정말이지"
  },
  "22": {
   "jp": "4bc1fee1",
   "kr": "괘씸한 생각이네."
  },
  "23": {
   "jp": "40e2cf44",
   "kr": "어머, 손님이신가요."
  },
  "24": {
   "jp": "1406616f",
   "kr": "부디, 편히 쉬세요."
  },
  "25": {
   "jp": "7fb1d348",
   "kr": "여기서 기다리면"
  },
  "26": {
   "jp": "b829373e",
   "kr": "브리트라는 사람이 오는 거죠?"
  },
  "27": {
   "jp": "89a05dd4",
   "kr": "정말 믿어도 돼요?"
  },
  "28": {
   "jp": "05577e3a",
   "kr": "무언가를 믿지 않으면"
  },
  "29": {
   "jp": "c1c82583",
   "kr": "일은 하나도 진전되지 않는 법이다."
  },
  "30": {
   "jp": "b469d4f5",
   "kr": "그런 것이다."
  },
  "31": {
   "jp": "2d5f28a0",
   "kr": "앗, 왔어요."
  },
  "32": {
   "jp": "4f0faf2b",
   "kr": "듀르젤 님."
  },
  "33": {
   "jp": "e34987fd",
   "kr": "오랜만에 뵙습니다."
  },
  "34": {
   "jp": "52413715",
   "kr": "브릿드, 변함없군."
  },
  "35": {
   "jp": "3547500d",
   "kr": "예, 덕분입니다."
  },
  "36": {
   "jp": "de410588",
   "kr": "본론부터 말하겠다. 성에 들어가고 싶다."
  },
  "37": {
   "jp": "eeac3fec",
   "kr": "길을 터 줄 수 없겠나?"
  },
  "38": {
   "jp": "85a13be0",
   "kr": "물론입니다."
  },
  "39": {
   "jp": "23d86711",
   "kr": "듀르젤 님이 돌페스에 유폐되시기 전에"
  },
  "40": {
   "jp": "003a8fae",
   "kr": "말씀하신 대로,"
  },
  "41": {
   "jp": "d20a118b",
   "kr": "레바스와 왕비는 감시하고 있었습니다."
  },
  "42": {
   "jp": "272f0758",
   "kr": "이제 이계의 침략은 분명합니다."
  },
  "43": {
   "jp": "bf4bc90f",
   "kr": "성 안 상황은 어떤가?"
  },
  "44": {
   "jp": "4bd9ed0c",
   "kr": "하아…"
  },
  "45": {
   "jp": "ebdcc7f7",
   "kr": "이분들은?"
  },
  "46": {
   "jp": "7febda53",
   "kr": "상관없다."
  },
  "47": {
   "jp": "088e2c91",
   "kr": "폴티아를 지키기 위해 모인 동료다."
  },
  "48": {
   "jp": "28c89ea5",
   "kr": "숨길 필요 없다."
  },
  "49": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "50": {
   "jp": "4e4ee538",
   "kr": "얼마 전부터"
  },
  "51": {
   "jp": "343e0a11",
   "kr": "국경에 투입을 시작한 병사들입니다만…"
  },
  "52": {
   "jp": "43a6de71",
   "kr": "그들은 레바스의 수상한 술법으로"
  },
  "53": {
   "jp": "44b20f8e",
   "kr": "혼을 빼앗긴 병사들입니다."
  },
  "54": {
   "jp": "dc1f31cb",
   "kr": "혼을 빼앗겼다니…?"
  },
  "55": {
   "jp": "176d457e",
   "kr": "병사들에게 의식은 없습니다."
  },
  "56": {
   "jp": "6311dd93",
   "kr": "그들은 명령받는 대로"
  },
  "57": {
   "jp": "64409fc1",
   "kr": "공포도 연민도 느끼지 않고 행동하는,"
  },
  "58": {
   "jp": "3cdf5102",
   "kr": "무서운 병단입니다."
  },
  "59": {
   "jp": "cc401d79",
   "kr": "이럴 수가…"
  },
  "60": {
   "jp": "31768aa6",
   "kr": "레바스가 명령을 내리면 끝이라는 거로군."
  },
  "61": {
   "jp": "509fe1cb",
   "kr": "저기, 그 빼앗긴 혼은"
  },
  "62": {
   "jp": "ec9b4ec2",
   "kr": "어떻게 됐을까요…?"
  },
  "63": {
   "jp": "152dd25a",
   "kr": "확실히 단언은 못 합니다만,"
  },
  "64": {
   "jp": "93b32f02",
   "kr": "레바스는 천구의로 갖가지 술법을 부립니다."
  },
  "65": {
   "jp": "45203641",
   "kr": "아마, 병사들의 혼은"
  },
  "66": {
   "jp": "e02e5839",
   "kr": "천구의에 빨려 들어간 게 아닌가 하는데…"
  },
  "67": {
   "jp": "1d786c96",
   "kr": "천구의에…"
  },
  "68": {
   "jp": "44064fc2",
   "kr": "그런 일이 있을 수 있는가…"
  },
  "69": {
   "jp": "05905602",
   "kr": "레바스의 의식을 본 자는 없습니다만,"
  },
  "70": {
   "jp": "586d0049",
   "kr": "왕비와 그런 이야기를 나누는 것을"
  },
  "71": {
   "jp": "64a59500",
   "kr": "들은 적이 있습니다."
  },
  "72": {
   "jp": "dbd2c544",
   "kr": "분명"
  },
  "73": {
   "jp": "6bb54cf6",
   "kr": "그 혼이 파도 부르는 힘도 된다고."
  },
  "74": {
   "jp": "f3ad27ac",
   "kr": "역시, 라우알의 파도와도"
  },
  "75": {
   "jp": "46a9058c",
   "kr": "관계가 있는 거군요."
  },
  "76": {
   "jp": "6a2636d9",
   "kr": "한시라도 빨리,"
  },
  "77": {
   "jp": "35f98afd",
   "kr": "천구의를 파괴하는 것 외에는"
  },
  "78": {
   "jp": "b239d401",
   "kr": "방법이 없는가…"
  },
  "79": {
   "jp": "02c71a4b",
   "kr": "겉으로는 아직 알려지지 않았습니다만,"
  },
  "80": {
   "jp": "72d97aa7",
   "kr": "이미 루돌프 왕은 집착을 잃었습니다."
  },
  "81": {
   "jp": "53f27946",
   "kr": "루돌프 왕은 옥좌에 앉으신 채"
  },
  "82": {
   "jp": "f6383a45",
   "kr": "레바스의 술법 탓에"
  },
  "83": {
   "jp": "0ec9b4b1",
   "kr": "한 걸음도 움직이지 못하십니다."
  },
  "84": {
   "jp": "73384f9e",
   "kr": "죄송합니다."
  },
  "85": {
   "jp": "5d2626a6",
   "kr": "제가 곁에 있으면서도…"
  },
  "86": {
   "jp": "69e9fe74",
   "kr": "브리트, 자신을 탓하지 마라."
  },
  "87": {
   "jp": "4f49445a",
   "kr": "상대는 이계의 여왕이다."
  },
  "88": {
   "jp": "57ff4577",
   "kr": "아무리 너라도 어쩔 도리가 없다."
  },
  "89": {
   "jp": "ed6192bb",
   "kr": "그보다"
  },
  "90": {
   "jp": "8ad776d7",
   "kr": "아무래도 길은 뚜렷하게 드러난 듯하다."
  },
  "91": {
   "jp": "c23dc50f",
   "kr": "『잔물결은 끝났다』라는 신호를"
  },
  "92": {
   "jp": "c106919a",
   "kr": "여관의 산페로부터 받았습니다만,"
  },
  "93": {
   "jp": "db62f7aa",
   "kr": "역시…전부…"
  },
  "94": {
   "jp": "69967c5f",
   "kr": "커다란 재앙은 피할 수 없는 사실인 듯하다."
  },
  "95": {
   "jp": "004a2cb6",
   "kr": "예전에, 듀르젤 님은"
  },
  "96": {
   "jp": "ca068b40",
   "kr": "잔물결이 끝난 것을 확인하면 돌아오시겠다고"
  },
  "97": {
   "jp": "6e817ef8",
   "kr": "말씀하셨지요."
  },
  "98": {
   "jp": "880248bf",
   "kr": "여기 있는 쥬리오와 크리스는"
  },
  "99": {
   "jp": "fbb5900d",
   "kr": "은단검을 지니고"
  },
  "100": {
   "jp": "d0c15cb8",
   "kr": "다섯 샤리네를 순례해 왔다."
  },
  "101": {
   "jp": "3ad32bdf",
   "kr": "즉, 이 둘이 여기 있다는 사실이,"
  },
  "102": {
   "jp": "21c5b48d",
   "kr": "그와 짝을 이루는 커다란 재앙 또한"
  },
  "103": {
   "jp": "3edcc9c4",
   "kr": "현실이라는 것을 증명하고 있는 것이다."
  },
  "104": {
   "jp": "3d2b1800",
   "kr": "그래서 나는…"
  },
  "105": {
   "jp": "8f3244cd",
   "kr": "돌페스의 탑에서 나올 결의를 한 것이다."
  },
  "106": {
   "jp": "d139556c",
   "kr": "잔물결은 이미 끝나고"
  },
  "107": {
   "jp": "cf59e7b1",
   "kr": "커다란 재앙이 밀려오고 있는 거군요."
  },
  "108": {
   "jp": "155c9ced",
   "kr": "성에 들어갈 수 있게 채비를 부탁한다."
  },
  "109": {
   "jp": "3acbac82",
   "kr": "네, 알겠습니다."
  },
  "110": {
   "jp": "8e9e8a58",
   "kr": "문 안쪽에서"
  },
  "111": {
   "jp": "0d844832",
   "kr": "되도록 대기하고 있겠습니다."
  },
  "112": {
   "jp": "7fc0a376",
   "kr": "듀르젤 님 일행이"
  },
  "113": {
   "jp": "5a8321a9",
   "kr": "입구의 병사에게 말을 거시면"
  },
  "114": {
   "jp": "7770e912",
   "kr": "때를 보아, 나가겠습니다."
  },
  "115": {
   "jp": "7539ec51",
   "kr": "불온한 자를 조사한다고 하면"
  },
  "116": {
   "jp": "c6ad9509",
   "kr": "병사들에게 의심받지 않고"
  },
  "117": {
   "jp": "599d5716",
   "kr": "성 안에 들어가실 수 있을 겁니다."
  },
  "118": {
   "jp": "6b871b08",
   "kr": "좋다, 그렇게 하지."
  },
  "119": {
   "jp": "b1290d4c",
   "kr": "아, 브리트 씨."
  },
  "120": {
   "jp": "f93db022",
   "kr": "그리고요."
  },
  "121": {
   "jp": "bbebdb40",
   "kr": "나중에 저희를 뒤쫓아서"
  },
  "122": {
   "jp": "63a1e2bc",
   "kr": "동료 몇 명이 와요."
  },
  "123": {
   "jp": "587a18b6",
   "kr": "알았다."
  },
  "124": {
   "jp": "ca949b40",
   "kr": "그럼, 그 사람들도"
  },
  "125": {
   "jp": "04633543",
   "kr": "어떻게든 성에 들어오도록"
  },
  "126": {
   "jp": "d7c422af",
   "kr": "애써 보마."
  },
  "127": {
   "jp": "d2a69e43",
   "kr": "브리트, 부탁한다."
  },
  "128": {
   "jp": "28c0f1c3",
   "kr": "네"
  },
  "129": {
   "jp": "cd08b2f4",
   "kr": "할 수 있는 일은 해 보겠습니다."
  },
  "130": {
   "jp": "6934a25e",
   "kr": "그럼, 저는"
  },
  "131": {
   "jp": "f7906e49",
   "kr": "곧바로 성문 쪽으로."
  },
  "132": {
   "jp": "af9eb3e3",
   "kr": "음. 부탁한다."
  },
  "133": {
   "jp": "1245017b",
   "kr": "한 번 성 안에 들어가면"
  },
  "134": {
   "jp": "6b966ab2",
   "kr": "그리 쉽게는 돌아오지 못한다."
  },
  "135": {
   "jp": "8910b4b2",
   "kr": "준비를 갖추려면 지금이다."
  },
  "136": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "137": {
   "jp": "8b9236cd",
   "kr": "네."
  },
  "138": {
   "jp": "ab06709a",
   "kr": "각오는 됐어요."
  }
 }
}