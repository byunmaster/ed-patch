  "2": {
   "jp": "11cd763b",
   "kr": "죠르노"
  },
  "3": {
   "jp": "7ca94334",
   "kr": "시녀"
  },
  "4": {
   "jp": "ba87f6d2",
   "kr": "앰비쉬 병사"
  },
  "5": {
   "jp": "d4bcfdad",
   "kr": "오늘도 건강해 보이셔서 다행입니다."
  },
  "6": {
   "jp": "7e3378c5",
   "kr": "두 분이 오시고 나서"
  },
  "7": {
   "jp": "883e8f6e",
   "kr": "성 안이 활기차진 듯합니다."
  },
  "8": {
   "jp": "c4448347",
   "kr": "오늘 요리 콘테스트에 출전하시는 분은"
  },
  "9": {
   "jp": "308cd3f3",
   "kr": "모나 님, 이벨 님, 말테 님"
  },
  "10": {
   "jp": "33481d99",
   "kr": "세 분이시옵니다."
  },
  "11": {
   "jp": "b6bfff91",
   "kr": "모두 앰비쉬에서 이름난"
  },
  "12": {
   "jp": "dda6f639",
   "kr": "요리 명인. 분명 훌륭한 요리를 여럿"
  },
  "13": {
   "jp": "62b3751c",
   "kr": "만들어 주실 것입니다."
  },
  "14": {
   "jp": "91b246c5",
   "kr": "출품하시는 요리는 각자 집에서 만들어"
  },
  "15": {
   "jp": "bcf78395",
   "kr": "정오까지 이곳으로 가져오시게"
  },
  "16": {
   "jp": "3f73aeb7",
   "kr": "되어 있습니다."
  },
  "17": {
   "jp": "cf28818c",
   "kr": "그럼, 저는 밑준비를 위해 주방에 있으니"
  },
  "18": {
   "jp": "eb7ffe61",
   "kr": "무슨 일이 있으시면"
  },
  "19": {
   "jp": "0c4e049d",
   "kr": "그쪽으로 들러 주십시오."
  },
  "20": {
   "jp": "507e4046",
   "kr": "네, 고마워요."
  },
  "21": {
   "jp": "06cd6fa2",
   "kr": "그럼"
  },
  "22": {
   "jp": "ebbc6053",
   "kr": "로디에게 에토스 할아버지한테"
  },
  "23": {
   "jp": "e20e3692",
   "kr": "받아 둔 약을 건네러 가자."
  },
  "24": {
   "jp": "7440fe30",
   "kr": "그러네."
  },
  "25": {
   "jp": "958eae18",
   "kr": "저기요."
  },
  "26": {
   "jp": "6ee2b9b3",
   "kr": "식칼은 갖춰져 있나요?"
  },
  "27": {
   "jp": "027d7765",
   "kr": "예, 있사옵니다."
  },
  "28": {
   "jp": "1330cb4d",
   "kr": "아무렴, 안데라성 주방인걸요."
  },
  "29": {
   "jp": "8b967fdf",
   "kr": "저기, 저기."
  },
  "30": {
   "jp": "1e7345ce",
   "kr": "조미료도 있어요?"
  },
  "31": {
   "jp": "b0d921dd",
   "kr": "조금은 있을 겁니다만."
  },
  "32": {
   "jp": "085f62b5",
   "kr": "냄비는요?"
  },
  "33": {
   "jp": "c3035b10",
   "kr": "물론 있사옵니다."
  },
  "34": {
   "jp": "750e3b43",
   "kr": "…크리스, 그만 좀 물어."
  },
  "35": {
   "jp": "ff4d759d",
   "kr": "그치만 신경 쓰이잖아."
  },
  "36": {
   "jp": "c1a169fe",
