  "44": {
   "jp": "3908100d",
   "kr": "쥬리오"
  },
  "45": {
   "jp": "3cd9efd8",
   "kr": "로디가 낫는 게 싫은 거야!"
  },
  "46": {
   "jp": "e1ae031e",
   "kr": "쥬리오!"
  },
  "47": {
   "jp": "603f3f2a",
   "kr": "로디한테 가는 거야!"
  },
  "48": {
   "jp": "97d5e979",
   "kr": "크리스"
  },
  "49": {
   "jp": "f739e67d",
   "kr": "그쪽은 로디 방이 아니야."
