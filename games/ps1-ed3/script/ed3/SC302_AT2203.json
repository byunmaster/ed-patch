  "39": {
   "jp": "50e64649",
   "kr": "맛이었지요."
  },
  "40": {
   "jp": "feb17f58",
   "kr": "올해는 누가 우승할는지요."
  },
  "41": {
   "jp": "3908100d",
   "kr": "쥬리오"
  },
  "42": {
   "jp": "db33a89c",
   "kr": "로디에게 약을 건네주자."
  },
  "43": {
   "jp": "7b0e7c8f",
   "kr": "얼른 기운 차렸으면 좋겠는걸."
