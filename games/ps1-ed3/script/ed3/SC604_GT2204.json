 "lines": {
  "0": {
   "jp": "dc464821",
   "kr": "기드넬"
  },
  "1": {
   "jp": "4300e71e",
   "kr": "우르기드 저택"
  },
  "2": {
   "jp": "e9b5c557",
   "kr": "우르기드"
  },
  "3": {
   "jp": "d12a3c7c",
   "kr": "칸다타"
  },
  "4": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "5": {
   "jp": "1c449907",
   "kr": "앞뒤로 막혔어."
  },
  "6": {
   "jp": "d490d700",
   "kr": "못 도망친다, 너희들."
  },
  "7": {
   "jp": "e4d796b7",
   "kr": "후후후후…"
  },
  "8": {
   "jp": "bc8a3d63",
   "kr": "궁지에 몰아넣었다."
  },
  "9": {
   "jp": "70354164",
   "kr": "……"
  },
  "10": {
   "jp": "97006fb3",
   "kr": "음…?"
  },
  "11": {
   "jp": "51a50b03",
   "kr": "자, 이쪽으로."
  },
  "12": {
   "jp": "d678b6da",
   "kr": "고마워요."
  },
  "13": {
   "jp": "50519b74",
   "kr": "갑자기 폭탄을 던지기까지 하다니"
  },
  "14": {
   "jp": "87d43b87",
   "kr": "피도 눈물도 없는 놈이군."
  },
  "15": {
   "jp": "c13cfc61",
   "kr": "하기야"
  },
  "16": {
   "jp": "03d2983e",
   "kr": "그 정도론 아프지도 가렵지도 않다만…"
  },
  "17": {
   "jp": "0076aa0f",
   "kr": "레바스 님의 힘을 맛보아라!"
  },
  "18": {
   "jp": "5a383138",
   "kr": "뭐… 뭐야, 이놈들?"
  },
  "19": {
   "jp": "91db2f2e",
   "kr": "우르기드도 칸다타도"
  },
  "20": {
   "jp": "9f4cb37f",
   "kr": "아무래도 평범한 인간은 아닌 모양이에요."
  },
  "21": {
   "jp": "17518722",
   "kr": "아까, 레바스와 계약했다느니 하던데."
  },
  "22": {
   "jp": "a5289eca",
   "kr": "레바스?"
  },
  "23": {
   "jp": "ca139c84",
   "kr": "폴티아의 점성술사 레바스 말인가요?"
  },
  "24": {
   "jp": "843c6b93",
   "kr": "그렇구나,"
  },
  "25": {
   "jp": "62c6ca7a",
   "kr": "그래서 어디서 들어 본 이름이라고"
  },
  "26": {
   "jp": "8719326a",
   "kr": "생각했던 거야."
  },
  "27": {
   "jp": "0cb125b3",
   "kr": "어쨌든 간에"
  },
  "28": {
   "jp": "0c6454fa",
   "kr": "싸우는 수밖에 없겠군."
  },
  "29": {
   "jp": "3a1219ed",
   "kr": "쥬리오 일행은 전투 태세를 취했다."
  },
  "30": {
   "jp": "e0c673ae",
   "kr": "쥬리오, 그쪽은 부탁한다."
  },
  "31": {
   "jp": "aace8142",
   "kr": "응, 알았어."
  },
  "32": {
   "jp": "a1d87b38",
   "kr": "무서운 놈들이다."
  },
  "33": {
   "jp": "f08169d3",
   "kr": "폴티아의 점성술사 레바스는"
  },
  "34": {
   "jp": "18ee7da2",
   "kr": "수상한 술법을 쓴다고 들었습니다."
  },
  "35": {
   "jp": "f3b1e432",
   "kr": "아마 우르기드와 칸다타는"
  },
  "36": {
   "jp": "a81c4bb3",
   "kr": "레바스의 술법으로 마수의 힘을"
  },
  "37": {
   "jp": "e8a5538f",
   "kr": "갖추게 된 것이겠지요."
  },
  "38": {
   "jp": "79cceee3",
   "kr": "그런 게 가능해?"
  },
  "39": {
   "jp": "e0bcb102",
   "kr": "네, 사악한 마법을 쓰는 자가"
  },
  "40": {
   "jp": "e8abe974",
   "kr": "거기에 점성술의 힘까지 빌렸다면,"
  },
  "41": {
   "jp": "7a65d856",
   "kr": "불가능한 일이 아니에요."
  },
  "42": {
   "jp": "49f99965",
   "kr": "유난히 잘 아네."
  },
  "43": {
   "jp": "c5166f88",
   "kr": "앗."
  },
  "44": {
   "jp": "cfd2dd4e",
   "kr": "살아 있어요."
  },
  "45": {
   "jp": "dd54c2ae",
   "kr": "으… 으윽…"
  },
  "46": {
   "jp": "9e2d52e5",
   "kr": "으윽…"
  },
  "47": {
   "jp": "85c053dd",
   "kr": "이놈이."
  },
  "48": {
   "jp": "e4ea71ab",
   "kr": "정말 질긴 놈들이군."
  },
  "49": {
   "jp": "cccac2ec",
   "kr": "기다려, 아니에요."
  },
  "50": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "51": {
   "jp": "6657eec0",
   "kr": "원래대로 돌아온 것 같아."
  },
  "52": {
   "jp": "27f633c4",
   "kr": "지금까지 뭔가에 의식을 빼앗겨 있었던 거야."
  },
  "53": {
   "jp": "19e3fc67",
   "kr": "아까 같은 사악한 느낌이 없어."
  },
  "54": {
   "jp": "16bccf71",
   "kr": "응, 왠지 나도"
  },
  "55": {
   "jp": "65f8fdcd",
   "kr": "그런 기분이 들어."
  },
  "56": {
   "jp": "d39734ee",
   "kr": "그럼 어쩔 수 없군."
  },
  "57": {
   "jp": "783e6fea",
   "kr": "더 괴롭혀 봐야 소용없다."
  },
  "58": {
   "jp": "5171f41d",
   "kr": "어디, 기합을 넣어 줄까."
  },
  "59": {
   "jp": "a583f5dd",
   "kr": "얍!"
  },
  "60": {
   "jp": "1e7b4cac",
   "kr": "아야…?!"
  },
  "61": {
   "jp": "87ba5eb1",
   "kr": "아야야야…"
  },
  "62": {
   "jp": "97006fb3",
   "kr": "음…?"
  },
  "63": {
   "jp": "5fdfe6d2",
   "kr": "어라."
  },
  "64": {
   "jp": "6213a864",
   "kr": "내가 이런 데서"
  },
  "65": {
   "jp": "2bdab1f1",
   "kr": "뭘 하고 있는 거지?"
  },
  "66": {
   "jp": "1aa2063b",
   "kr": "왠지…"
  },
  "67": {
   "jp": "16f77193",
   "kr": "개운한 기분이긴 한데,"
  },
  "68": {
   "jp": "21978028",
   "kr": "허리가 조금 뻐근하군."
  },
  "69": {
   "jp": "a583f5dd",
   "kr": "얍!"
  },
  "70": {
   "jp": "636d401e",
   "kr": "으윽…?!"
  },
  "71": {
   "jp": "bcc8536b",
   "kr": "후우."
  },
  "72": {
   "jp": "f10d767b",
   "kr": "왠지, 개운하군."
  },
  "73": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "74": {
   "jp": "ba739a38",
   "kr": "나는?"
  },
  "75": {
   "jp": "2a89cc3b",
   "kr": "어떻게 된 거지?"
  },
  "76": {
   "jp": "86ae4fef",
   "kr": "두 사람 다 제정신으로 돌아온 것 같아."
  },
  "77": {
   "jp": "4354ab04",
   "kr": "우르기드 님!"
  },
  "78": {
   "jp": "9d7045d2",
   "kr": "칸다타 님!"
  },
  "79": {
   "jp": "73979bce",
   "kr": "아야야야…"
  },
  "80": {
   "jp": "3bbd63a2",
   "kr": "머리는 개운해졌지만,"
  },
  "81": {
   "jp": "d42fbf93",
   "kr": "하여간 온몸이 여기저기 아프다."
  },
  "82": {
   "jp": "7f5a4573",
   "kr": "침대로 옮겨 다오."
  },
  "83": {
   "jp": "ca8e01c3",
   "kr": "앗, 지금 당장."
  },
  "84": {
   "jp": "79307635",
   "kr": "쥬리오 일행과의 격렬한 전투로,"
  },
  "85": {
   "jp": "3186f106",
   "kr": "우르기드와 칸다타의 의식을 빼앗고 있던"
  },
  "86": {
   "jp": "9fff017e",
   "kr": "사악한 것이 사라졌다."
  },
  "87": {
   "jp": "6d8efd4b",
   "kr": "모여든 병사들도 사정을 받아들이고,"
  },
  "88": {
   "jp": "9d180bc7",
   "kr": "우르기드와 칸다타는"
  },
  "89": {
   "jp": "57a97c0b",
   "kr": "곧바로 저택 안으로 옮겨졌다."
  }
 }
