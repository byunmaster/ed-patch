 "member": "..\\DATA\\SR3003.BIN",
 "lines": {
  "0": {
   "jp": "c250b049",
   "kr": "홀크 요새"
  },
  "1": {
   "jp": "9bb56284",
   "kr": "베라트"
  },
  "2": {
   "jp": "845a2ab1",
   "kr": "칼리 왕비"
  },
  "3": {
   "jp": "f23bd255",
   "kr": "산적 아페고"
  },
  "4": {
   "jp": "6d0d3c7e",
   "kr": "산적 그네스"
  },
  "5": {
   "jp": "82bf0c0f",
   "kr": "산적 누라"
  },
  "6": {
   "jp": "138252df",
   "kr": "산적 콘타"
  },
  "7": {
   "jp": "8942de95",
   "kr": "참 나, 썰렁한 요새로군."
  },
  "8": {
   "jp": "18cc102c",
   "kr": "아무것도 없잖아."
  },
  "9": {
   "jp": "bd45941d",
   "kr": "돌아갈까."
  },
  "10": {
   "jp": "bc8c5b91",
   "kr": "가자, 가자."
  },
  "11": {
   "jp": "b7ff4798",
   "kr": "달렸더니 피곤해."
  },
  "12": {
   "jp": "07a9ce2e",
   "kr": "모처럼 병사들을 묶어 놨더니"
  },
  "13": {
   "jp": "05e94142",
   "kr": "헛수고였다는 거잖아."
  },
  "14": {
   "jp": "8d3ffc69",
   "kr": "역시"
  },
  "15": {
   "jp": "a6dfa8ca",
   "kr": "구스가 세운 작전이잖아."
  },
  "16": {
   "jp": "8f91bdcb",
   "kr": "시끄러워."
  },
  "17": {
   "jp": "d04d02d0",
   "kr": "어?"
  },
  "18": {
   "jp": "5b8d7982",
   "kr": "엇?"
  },
  "19": {
   "jp": "ac94448d",
   "kr": "재수 없는 놈을 찾았다."
  },
  "20": {
   "jp": "3399cdd7",
   "kr": "이봐, 쥬리오."
  },
  "21": {
   "jp": "beedafe5",
   "kr": "앗?"
  },
  "22": {
   "jp": "c3e0c7c0",
   "kr": "어머."
  },
  "23": {
   "jp": "817f780e",
   "kr": "이런 데서,"
  },
  "24": {
   "jp": "ce12375c",
   "kr": "뭘 샛길로 새고 있는 거야."
  },
  "25": {
   "jp": "8bd55969",
   "kr": "너희들?"
  },
  "26": {
   "jp": "4736a281",
   "kr": "그런가…"
  },
  "27": {
   "jp": "eb28aaa9",
   "kr": "아이라고 방심했는데,"
  },
  "28": {
   "jp": "df11d1aa",
   "kr": "너희, 산적 일당이었구나."
  },
  "29": {
   "jp": "cba2e920",
   "kr": "우리가 산적 일당?"
  },
  "30": {
   "jp": "d5026a96",
   "kr": "(구스네랑 한패인 줄 아나 봐.)"
  },
  "31": {
   "jp": "1598daf3",
   "kr": "(말도 안 돼.)"
  },
  "32": {
   "jp": "abffc06b",
   "kr": "(망루 위에 있는 놈은 누구지?)"
  },
  "33": {
   "jp": "098537d2",
   "kr": "(어쩐지 심상찮은 분위기…)"
  },
  "34": {
   "jp": "57872654",
   "kr": "나는 베라트."
  },
  "35": {
   "jp": "15ce3775",
   "kr": "내 요새에 잠입하다니 가상한 산적이로군."
  },
  "36": {
   "jp": "dec561fd",
   "kr": "분명 이름난 산적단이겠지."
  },
  "37": {
   "jp": "4b57b653",
   "kr": "이름을 대라!"
  },
  "38": {
   "jp": "cb0fe232",
   "kr": "샤라, 이름 대래."
  },
  "39": {
   "jp": "7fe227f1",
   "kr": "이름 같은 건 안 지었어."
  },
  "40": {
   "jp": "a8068078",
   "kr": "아무거나 대충 말해 줘."
  },
  "41": {
   "jp": "b20d7a00",
   "kr": "그럼, 산적 브라더스는 어때?"
  },
  "42": {
   "jp": "7aa2540f",
   "kr": "역시, 넌 센스가 없어."
  },
  "43": {
   "jp": "d08501e7",
   "kr": "우리는"
  },
  "44": {
   "jp": "0e0e9b6a",
   "kr": "쾌걸 와일드캣단이다!"
  },
  "45": {
   "jp": "2094ba6e",
   "kr": "기억해 둬."
  },
  "46": {
   "jp": "e15bd220",
   "kr": "호오, 쾌걸 와일드캣단이라…"
  },
  "47": {
   "jp": "70f5fb19",
   "kr": "꽤 좋은 이름이군."
  },
  "48": {
   "jp": "c5862391",
   "kr": "쾌걸 와일드캣단, 잘 들어라!"
  },
  "49": {
   "jp": "15b03915",
   "kr": "홀크의 칼리 왕비는 내가 맡고 있다."
  },
  "50": {
   "jp": "3d6cf0d1",
   "kr": "손을 대면 왕비의 목숨은 없다."
  },
  "51": {
   "jp": "49c908f8",
   "kr": "어서 여기서 물러가라!"
  },
  "52": {
   "jp": "62eeecff",
   "kr": "이봐 이봐."
  },
  "53": {
   "jp": "5ea6b3d6",
   "kr": "그딴 건 우리랑"
  },
  "54": {
   "jp": "4978cf22",
   "kr": "전혀, 조금도,"
  },
  "55": {
   "jp": "50122e9b",
   "kr": "털끝만큼도 상관없어."
  },
  "56": {
   "jp": "d80c80da",
   "kr": "모처럼 왔는데,"
  },
  "57": {
   "jp": "c5dc70d8",
   "kr": "돈 될 만한 게 없어서 화가 나 있다고."
  },
  "58": {
   "jp": "18b9badf",
   "kr": "최악의 경우 무기를 훔쳐서"
  },
  "59": {
   "jp": "46a4ff71",
   "kr": "돈으로 바꾸면 된다고 생각했는데,"
  },
  "60": {
   "jp": "78ea707c",
   "kr": "무기까지 타 버렸고 말이야."
  },
  "61": {
   "jp": "95c55dd7",
   "kr": "뭐라고…"
  },
  "62": {
   "jp": "10b21ebd",
   "kr": "그럼 무기고에 불을 붙인 건"
  },
  "63": {
   "jp": "a7ba2c86",
   "kr": "네놈들이 아니었나?"
  },
  "64": {
   "jp": "a3101d8e",
   "kr": "그렇다는 건…"
  },
  "65": {
   "jp": "5279d25e",
   "kr": "엇…뭐? 뭐?"
  },
  "66": {
   "jp": "c94065ec",
   "kr": "우린 몰라."
  },
  "67": {
   "jp": "b70ff07c",
   "kr": "저기, 크리스."
  },
  "68": {
   "jp": "ed5e7183",
   "kr": "그, 그래…"
  },
  "69": {
   "jp": "40d03da7",
   "kr": "나는 챠펠 마법이라면 조금 쓸 수 있지만,"
  },
  "70": {
   "jp": "95e7817a",
   "kr": "불은 못 내거든. 그렇지?"
  },
  "71": {
   "jp": "0c3acfae",
   "kr": "수상한데."
  },
  "72": {
   "jp": "b02a2068",
   "kr": "앗, 이봐."
  },
  "73": {
   "jp": "04069884",
   "kr": "멋대로 다가오지 마…"
  },
  "74": {
   "jp": "292f737e",
   "kr": "왕비의 목숨은 없다!"
  },
  "75": {
   "jp": "47fc8b5d",
   "kr": "너희도 잘 들어라!"
  },
  "76": {
   "jp": "ff89767d",
   "kr": "거기 여자 산적! 활을 든 모양인데,"
  },
  "77": {
   "jp": "66873d93",
   "kr": "나를 겨누면 왕비의 목숨은 없다!"
  },
  "78": {
   "jp": "0ad29a4a",
   "kr": "닥쳐!"
  },
  "79": {
   "jp": "81b51b09",
   "kr": "남의 얘기에 끼어들지 마!"
  },
  "80": {
   "jp": "7e39018a",
   "kr": "우리는,"
  },
  "81": {
   "jp": "2d61a1e5",
   "kr": "그쪽 꼬마들한테 볼일이 있어!"
  },
  "82": {
   "jp": "ea472376",
   "kr": "야, 너희들!"
  },
  "83": {
   "jp": "860d19fe",
   "kr": "그럼 무기를 태운 건 네놈들이로군!"
  },
  "84": {
   "jp": "1a749daf",
   "kr": "그치만 말이야,"
  },
  "85": {
   "jp": "e2a7129f",
   "kr": "무기 같은 건 위험하기만 하잖아!"
  },
  "86": {
   "jp": "f172a96d",
   "kr": "맞아."
  },
  "87": {
   "jp": "31f40588",
   "kr": "전쟁에 쓸 무기 따위,"
  },
  "88": {
   "jp": "cd479209",
   "kr": "태워 버렸다고!"
  },
  "89": {
   "jp": "1fdd2946",
   "kr": "그거 잘하셨네요."
  },
  "90": {
   "jp": "91e7e341",
   "kr": "뭐냐,"
  },
  "91": {
   "jp": "02633d31",
   "kr": "또 저 애들한테 방해받은 거야…"
  },
  "92": {
   "jp": "b38807bf",
   "kr": "난 이제 지긋지긋해."
  },
  "93": {
   "jp": "6d8ad717",
   "kr": "이 멍청이!"
  },
  "94": {
   "jp": "75dc4d50",
   "kr": "팔면 돈이 됐단 말이다. 돈이!"
  },
  "95": {
   "jp": "67ba591e",
   "kr": "야호, 구스!"
  },
  "96": {
   "jp": "e99fb97b",
   "kr": "분하면 우릴 잡아 보시지!"
  },
  "97": {
   "jp": "6131370a",
   "kr": "여기선,"
  },
  "98": {
   "jp": "4315840e",
   "kr": "자랑거리인 밧줄 던지기도 닿지 않을걸!"
  },
  "99": {
   "jp": "e03cdf47",
   "kr": "야호, 야호."
  },
  "100": {
   "jp": "1929ad3c",
   "kr": "저 자식."
  },
  "101": {
   "jp": "4652fe91",
   "kr": "할 말 다 하고 있네…"
  },
  "102": {
   "jp": "4204cd29",
   "kr": "거기서라면"
  },
  "103": {
   "jp": "a9b28871",
   "kr": "돌 던지기밖에 못 하겠지!"
  },
  "104": {
   "jp": "4b084a6b",
   "kr": "(응…?)"
  },
  "105": {
   "jp": "0597761b",
   "kr": "시끄러워!"
  },
  "106": {
   "jp": "508da950",
   "kr": "하지만 컨트롤이 형편없어서,"
  },
  "107": {
   "jp": "bcf61e03",
   "kr": "맞지는 않겠지만!"
  },
  "108": {
   "jp": "a7e2a96e",
   "kr": "이놈이…"
  },
  "109": {
   "jp": "9fff9340",
   "kr": "(구스…)"
  },
  "110": {
   "jp": "d960be3f",
   "kr": "(응?)"
  },
  "111": {
   "jp": "beed25df",
   "kr": "(……………)"
  },
  "112": {
   "jp": "0a3555c1",
   "kr": "(호오…)"
  },
  "113": {
   "jp": "14c4333d",
   "kr": "구스는 샤라에게 눈빛으로 답했다."
  },
  "114": {
   "jp": "5b99f25d",
   "kr": "이봐, 너희."
  },
  "115": {
   "jp": "650b70c7",
   "kr": "무기고를 태운 건 이제 됐으니"
  },
  "116": {
   "jp": "e47d7eec",
   "kr": "나를 무시하지 마라."
  },
  "117": {
   "jp": "8ec4e30a",
   "kr": "왕비를 맡고 있단 말이다."
  },
  "118": {
   "jp": "d14d7782",
   "kr": "괜찮으려나."
  },
  "119": {
   "jp": "3d7d8af0",
   "kr": "여기서 떨어뜨리기만 해도,"
  },
  "120": {
   "jp": "d5b70424",
   "kr": "왕비는 끝장이란 말이다."
  },
  "121": {
   "jp": "250ee3d8",
   "kr": "이상한 짓 하지 마라."
  },
  "122": {
   "jp": "0d7f3ed5",
   "kr": "시끄러워, 꺼져 있어!"
  },
  "123": {
   "jp": "2a7f6fcf",
   "kr": "야, 꼬맹이들!"
  },
  "124": {
   "jp": "53735836",
   "kr": "오늘이라는 오늘은 참을성도 바닥났다."
  },
  "125": {
   "jp": "b1ef1e5d",
   "kr": "왜 너희는"
  },
  "126": {
   "jp": "9c59ca59",
   "kr": "맨날 맨날,"
  },
  "127": {
   "jp": "aef4f69d",
   "kr": "우리 일을 방해하기만 하는 거야!"
  },
  "128": {
   "jp": "f89ed8cc",
   "kr": "흥이다."
  },
  "129": {
   "jp": "108c1f87",
   "kr": "산적 일당한테 불평 들을 이유 없어!"
  },
  "130": {
   "jp": "ec03a6fa",
   "kr": "(또 무시하고 있어…)"
  },
  "131": {
   "jp": "d3618e30",
   "kr": "구스는 돌을 주워 들었다."
  },
  "132": {
   "jp": "0c5c246d",
   "kr": "더는 못 참겠다."
  },
  "133": {
   "jp": "bc6bb6a8",
   "kr": "아무리 꼬맹이라도 봐주지 않는다!"
  },
  "134": {
   "jp": "ac6806ef",
   "kr": "맞을 리가 있나!"
  },
  "135": {
   "jp": "e03cdf47",
   "kr": "야호, 야호."
  },
  "136": {
   "jp": "077c1afd",
   "kr": "받아라, 내 강속구를!"
  },
  "137": {
   "jp": "7c2d6794",
   "kr": "맞았다~."
  },
  "138": {
   "jp": "a1bb3006",
   "kr": "어, 어째서…?"
  }
 }
}