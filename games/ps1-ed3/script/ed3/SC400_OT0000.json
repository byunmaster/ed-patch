  },
  "1": {
   "jp": "c85fb771",
   "kr": "파렌"
  },
  "2": {
   "jp": "2e9b9a8e",
   "kr": "메이아"
  },
  "3": {
   "jp": "1fa3a6ef",
   "kr": "오즈이"
  },
  "4": {
   "jp": "1ada7630",
   "kr": "우비"
  },
  "5": {
   "jp": "2facc6ef",
   "kr": "간호사 에피누"
  },
  "6": {
   "jp": "790e56cd",
   "kr": "필로 선생"
  },
  "7": {
   "jp": "8083d427",
   "kr": "비시오"
  },
  "8": {
   "jp": "5586174a",
   "kr": "칸드의 라름"
  },
  "9": {
   "jp": "04a9fd5c",
   "kr": "롱크"
  },
  "10": {
   "jp": "da55f7ed",
   "kr": "하이마"
  },
  "11": {
   "jp": "5c9fe3f9",
   "kr": "엔시아"
  },
  "12": {
   "jp": "43c517fc",
   "kr": "니젠"
  },
  "13": {
   "jp": "f3fc3045",
   "kr": "티나"
  },
  "14": {
   "jp": "5b2dcd1b",
   "kr": "죄송합니다."
  },
  "15": {
   "jp": "d27716f6",
   "kr": "지금 명상 수행 중이라서"
  },
  "16": {
   "jp": "ae242f21",
   "kr": "나중에 와 주시지 않겠습니까?"
  },
  "17": {
   "jp": "5b8d7982",
   "kr": "네?"
  },
  "18": {
   "jp": "e1d396ae",
   "kr": "필로 선생님께"
  },
  "19": {
   "jp": "ebca9a68",
   "kr": "책을 빌려다 달라고요."
  },
  "20": {
   "jp": "06ef01f8",
   "kr": "아, 책을 빌리러 오셨군요."
  },
  "21": {
   "jp": "8c81f3aa",
   "kr": "남을 돕는 일은 무엇보다 귀한 행동입니다."
  },
  "22": {
   "jp": "35e9b223",
   "kr": "잠시만 기다려 주세요."
  },
  "23": {
   "jp": "20a5ed7e",
   "kr": "지금 저주 풀이 책을 가져오겠습니다."
  },
  "24": {
   "jp": "37b1c0ff",
   "kr": "저는 상관없습니다만"
  },
  "25": {
   "jp": "cb660f33",
   "kr": "당신의 소지품이 너무 많아서"
  },
  "26": {
   "jp": "deca8a5e",
   "kr": "넘겨드릴 수 없는 모양이에요."
  },
  "27": {
   "jp": "9b6c51f0",
   "kr": "책은 필로 선생님께 받았습니다."
  },
  "28": {
   "jp": "d0aef6b1",
   "kr": "도움이 돼서 정말 다행이에요."
  },
  "29": {
   "jp": "d14a0740",
   "kr": "책은 볼일이 끝난 뒤에"
  },
  "30": {
   "jp": "75ec4a90",
   "kr": "필로 선생님께 돌려받을 테니"
  },
  "31": {
   "jp": "d92fe82f",
   "kr": "신경 쓰지 않아도 됩니다."
  },
  "32": {
   "jp": "6b867cfc",
   "kr": "삼도교는 보셨나요?"
  },
  "33": {
   "jp": "ba4cd325",
   "kr": "올도스의 수로 물은 말이지."
  },
  "34": {
   "jp": "8002c44f",
   "kr": "삼도교 아래를 흐르는"
  },
  "35": {
   "jp": "9a7da162",
   "kr": "콘도타강의 물이랍니다."
  },
  "36": {
   "jp": "b8d9f085",
   "kr": "올도스의 대신관님은 다음 대신관님께"
  },
  "37": {
   "jp": "675bd8e5",
   "kr": "대를 물려줄 때 대신관님만 알아야 하는"
  },
  "38": {
   "jp": "ae4e49ca",
   "kr": "전승을 남몰래 전해 준다더군."
  },
  "39": {
   "jp": "e914f610",
   "kr": "대체, 무엇을 가르치는 걸까."
  },
  "40": {
   "jp": "16058370",
   "kr": "궁금하구먼…"
  },
  "41": {
   "jp": "c5e0687e",
   "kr": "필로 선생님 병원이라면,"
  },
  "42": {
   "jp": "3e60e404",
   "kr": "우리 집 바로 남쪽 집이라네."
  },
  "43": {
   "jp": "b3a6016d",
   "kr": "나도 예전에"
  },
  "44": {
   "jp": "7117da2d",
   "kr": "필로 선생님께 허리 치료를"
  },
  "45": {
   "jp": "130a1af5",
   "kr": "받은 적이 있다네."
  },
  "46": {
   "jp": "3ea44fa2",
   "kr": "말끔히 나았지."
  },
  "47": {
   "jp": "cf59826e",
   "kr": "그 선생, 솜씨는 확실하다네."
  },
  "48": {
   "jp": "04b0acce",
   "kr": "필로 선생님이 곧"
  },
  "49": {
   "jp": "6a52a8b7",
   "kr": "돌아오신다고 들었어."
  },
  "50": {
   "jp": "bb157d1b",
   "kr": "그러니까, 조금만 더 누워 있을래."
  },
  "51": {
   "jp": "240ba949",
   "kr": "필로 선생님은"
  },
  "52": {
   "jp": "2aa0ca2b",
   "kr": "여관으로 회진 나가셨대."
  },
  "53": {
   "jp": "3736a78a",
   "kr": "슬슬 누워 있는 것도 질렸고,"
  },
  "54": {
   "jp": "8d6669d3",
   "kr": "나도 집에 갈까 봐."
  },
  "55": {
   "jp": "d7380ed2",
   "kr": "필로 선생님, 환자인 나를 두고"
  },
  "56": {
   "jp": "c2dfc03a",
   "kr": "어디로 가 버린 걸까."
  },
  "57": {
   "jp": "1f20506e",
   "kr": "매정하다니까,"
  },
  "58": {
   "jp": "ff31a814",
   "kr": "그 선생님…"
  },
  "59": {
   "jp": "77bdad2d",
   "kr": "쾌차를 축하드려요."
  },
  "60": {
   "jp": "b4ca3e5a",
   "kr": "쥬리오 씨가"
  },
  "61": {
   "jp": "ff92e10e",
   "kr": "무척 애를 쓰며"
  },
  "62": {
   "jp": "7c986a8d",
   "kr": "뛰어다니셨답니다."
  },
  "63": {
   "jp": "91e53fcd",
   "kr": "걱정 끼쳐 드렸어요."
  },
  "64": {
   "jp": "6db1fbfe",
   "kr": "쥬리오한테는 정말 고마워요."
  },
  "65": {
   "jp": "e65f803a",
   "kr": "그만해, 쑥스럽잖아."
  },
  "66": {
   "jp": "257b7ec3",
   "kr": "쥬리오 씨는 귀엽네요."
  },
  "67": {
   "jp": "dadefcbe",
   "kr": "제 타입이에요."
  },
  "68": {
   "jp": "35356466",
   "kr": "안심하세요."
  },
  "69": {
   "jp": "5ffdcabe",
   "kr": "선생님이 보고 계시다면,"
  },
  "70": {
   "jp": "86288a37",
   "kr": "증상이 더는"
  },
  "71": {
   "jp": "9a1fd4cc",
   "kr": "나빠지지는 않을 거예요."
  },
  "72": {
   "jp": "7236e0de",
   "kr": "남은 건 약이네요."
  },
  "73": {
   "jp": "3934c60a",
   "kr": "비약만 손에 넣으면 좋을 텐데요."
  },
  "74": {
   "jp": "4a1a6f3e",
   "kr": "우비도 참"
  },
  "75": {
   "jp": "256d1731",
   "kr": "그냥 과식해서 배탈 난 건데"
  },
  "76": {
   "jp": "6773fc4a",
   "kr": "또 선생님 험담을 하고 있어."
  },
  "77": {
   "jp": "6fbddad3",
   "kr": "어쩔 수 없다니까…"
  },
  "78": {
   "jp": "8b191402",
   "kr": "필로 선생님이라면, 바람도 쐴 겸"
  },
  "79": {
   "jp": "eb4ad46d",
   "kr": "산책 나가셨어요."
  },
  "80": {
   "jp": "e19bcc21",
   "kr": "분명 남쪽 풍차 있는 데일 거예요."
  },
  "81": {
   "jp": "abd38d75",
   "kr": "이봐, 나그네,"
  },
  "82": {
   "jp": "33d53ddb",
   "kr": "올도스를 흐르는 수로가"
  },
  "83": {
   "jp": "5db91e1a",
   "kr": "기막히게 좋지 않아?"
  },
  "84": {
   "jp": "2ea84cf7",
   "kr": "그래서 이 마을은"
  },
  "85": {
   "jp": "8b4c6469",
   "kr": "물의 도시라고도 불린다고."
  },
  "86": {
   "jp": "fc8f7c53",
   "kr": "수로에는 10개의 다리가 놓이고,"
  },
  "87": {
   "jp": "5a71ccc0",
   "kr": "11개의 풍차가 시플에서 오는 바람을 받아"
  },
  "88": {
   "jp": "bac106f1",
   "kr": "빙글빙글 돌고 있단다."
  },
  "89": {
   "jp": "4a3bb332",
   "kr": "한가롭구나."
  },
  "90": {
   "jp": "ec935edb",
   "kr": "칸드 마법은 올도스 말고"
  },
  "91": {
   "jp": "f6b1154b",
   "kr": "거의 모든 마을에서도 받을 수 있습니다."
  },
  "92": {
   "jp": "f0ce94a6",
   "kr": "하지만 그중엔 올도스에서 받는 게"
  },
  "93": {
   "jp": "2f6910c2",
   "kr": "본래 모습이라며,"
  },
  "94": {
   "jp": "c798b75e",
   "kr": "일부러 찾아오는 사람도 있을 정도지요."
  },
  "95": {
   "jp": "a1b49e2d",
   "kr": "어서 오세요."
  },
  "96": {
   "jp": "aa97c2e1",
   "kr": "올도스 칸드에."
  },
  "97": {
   "jp": "b563be96",
   "kr": "어느 분이 마법을 익히시나요?"
  },
  "98": {
   "jp": "ddf24eea",
   "kr": "어느 마법을 원하시는지요?"
  },
  "99": {
   "jp": "9511d337",
   "kr": "맞나요?"
  },
  "100": {
   "jp": "3c2d3ee3",
   "kr": "부디, 뜻깊게 써 주세요."
  },
  "101": {
   "jp": "272a3798",
   "kr": "올도스는 말이야."
  },
  "102": {
   "jp": "3703fd00",
   "kr": "마을 구역과 신관 구역, 그리고 대성당의"
  },
  "103": {
   "jp": "f0f34c0d",
   "kr": "세 구역으로 나뉘어 있어."
  },
  "104": {
   "jp": "94639a6d",
   "kr": "대성당에 가려면 신관 구역을"
  },
  "105": {
   "jp": "49b08693",
   "kr": "지나가야만 하지."
  },
  "106": {
   "jp": "cb9d7e71",
   "kr": "신관 구역이란 대성당에서 일하는"
  },
  "107": {
   "jp": "d02dbbd0",
   "kr": "신관들의 집이 있는 곳이야."
  },
  "108": {
   "jp": "4c956016",
   "kr": "신관 구역으로 이어지는 다리에서는,"
  },
  "109": {
   "jp": "60dad6fb",
   "kr": "다른 네 샤리네를"
  },
  "110": {
   "jp": "06844d6d",
   "kr": "돌고 온 사람만 들어갈 수 있어."
  },
  "111": {
   "jp": "1d70647d",
   "kr": "이 올도스는"
  },
  "112": {
   "jp": "e231bab3",
   "kr": "칸드와 챠펠의"
  },
  "113": {
   "jp": "1a1a3374",
   "kr": "고향 같은 곳이야."
  },
  "114": {
   "jp": "91bd0b82",
   "kr": "그래서 여기선 재능만 있으면"
  },
  "115": {
   "jp": "30633f96",
   "kr": "거의 모든 마법을"
  },
  "116": {
   "jp": "db45e599",
   "kr": "받을 수 있어."
  },
  "117": {
   "jp": "a46241e1",
   "kr": "순례하러 오신 분이군요?"
  },
  "118": {
   "jp": "a83577aa",
   "kr": "그러세요."
  },
  "119": {
   "jp": "e7b21ac8",
   "kr": "마을의 성인 의식이 순례인 건가요."
  },
  "120": {
   "jp": "5f4338c0",
   "kr": "아주 좋은 습관을 남긴 마을이군요."
  },
  "121": {
   "jp": "09e8c468",
   "kr": "올도스의 대신관은 여기서 제일 높은 분이야."
  },
  "122": {
   "jp": "8e1b6b1b",
   "kr": "뭐, 보통 나라로 치면"
  },
  "123": {
   "jp": "87c8df0a",
   "kr": "임금님 같은 셈이지."
  },
  "124": {
   "jp": "94cbd8d4",
   "kr": "인간적으로도 훌륭하고 아주 좋은 분이야."
  },
  "125": {
   "jp": "ccce0a5b",
   "kr": "생각한 그대로의 마을이에요."
  },
  "126": {
   "jp": "8bdb6f5d",
   "kr": "아름답고, 사람들은 모두 상냥하고."
  },
  "127": {
   "jp": "b5675f37",
   "kr": "이 마을에 와서 다행이에요."
  },
  "128": {
   "jp": "3923a8e1",
   "kr": "이 올도스에는"
  },
  "129": {
   "jp": "8f1c0f44",
   "kr": "티라스일 각지에서 많은 사람들이"
  },
  "130": {
   "jp": "22735b2d",
   "kr": "순례나 수행을 위해 찾아오는구나."
  },
  "131": {
   "jp": "6b42b1e7",
   "kr": "그쪽도 그래요?"
  },
  "132": {
   "jp": "9c5b7e6e",
   "kr": "저도 그래요."
  },
  "133": {
   "jp": "45b7a58b",
   "kr": "네. 이게 그 책입니다."
  },
  "134": {
   "jp": "bb7118a3",
   "kr": "부디 가져가 주세요."
  },
  "135": {
   "jp": "d678b6da",
   "kr": "고맙습니다."
  },
  "136": {
   "jp": "7824af38",
   "kr": "빌려 갈게요."
  },
  "137": {
   "jp": "5a041974",
   "kr": "쥬리오는 파렌의 책을 손에 넣었다."
  },
  "138": {
   "jp": "75223412",
   "kr": "하하하."
  },
  "139": {
   "jp": "3fc7f1d7",
   "kr": "우비는 눈치채지 못했지만"
  },
  "140": {
   "jp": "d86fdf52",
   "kr": "나는 줄곧 여기 있다네."
  },
  "141": {
   "jp": "2f2267ce",
   "kr": "아무래도, 내쫓는 것도 딱하니까 말일세."
  },
  "142": {
   "jp": "7e90abb7",
   "kr": "본인이 마음먹을 때까지"
  },
  "143": {
   "jp": "2bc97b67",
   "kr": "있게 해 주기로 했네."
  },
  "144": {
   "jp": "d3a7d671",
   "kr": "그럼, 조심해서 마을로 돌아가게."
  }
 }
}