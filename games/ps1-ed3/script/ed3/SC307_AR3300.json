 "lines": {
  "0": {
   "jp": "e7e8c17c",
   "kr": "안데라 가도"
  },
  "1": {
   "jp": "98b0d098",
   "kr": "그럼, 가시지요."
  },
  "2": {
   "jp": "7b5243f4",
   "kr": "다음 샤리네가 있는 시플에 가려면"
  },
  "3": {
   "jp": "4c77b52d",
   "kr": "다이스가 있던 챠놈까지"
  },
  "4": {
   "jp": "17781c65",
   "kr": "되돌아가야 하는 거지?"
  },
  "5": {
   "jp": "52dedbd4",
   "kr": "올 때는 앰비쉬 해안을 따라 북쪽으로"
  },
  "6": {
   "jp": "83a55772",
   "kr": "돌아왔지만, 이번엔 남쪽으로 요새까지"
  },
  "7": {
   "jp": "e4100f7b",
   "kr": "그다음 삼도교를 건너면 되겠네."
  },
  "8": {
   "jp": "929c4a3c",
   "kr": "그렇습니다."
  },
  "9": {
   "jp": "8ba70ba2",
   "kr": "이 가도를 따라가면 요새가 나옵니다."
  },
  "10": {
   "jp": "4234675d",
   "kr": "자, 가시지요."
  },
  "11": {
   "jp": "c843aaff",
   "kr": "앰비쉬의 왕도 안데라"
  },
  "12": {
   "jp": "2640a02e",
   "kr": "서쪽 돗타 요새 1227미로"
  }
 }
