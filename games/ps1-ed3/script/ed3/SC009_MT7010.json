{
 "archive": "/SCE0/SC009.DAT",
 "member": "..\\DATA\\MT7010.BIN",
 "lines": {
  "0": {
   "jp": "ea7ef945",
   "kr": "타라타호"
  },
  "1": {
   "jp": "628fbc82",
   "kr": "선내"
  },
  "2": {
   "jp": "5cc70478",
   "kr": "어부 토바이"
  },
  "3": {
   "jp": "915bbe9c",
   "kr": "『캡틴 토마스』는 최고여."
  },
  "4": {
   "jp": "352ac464",
   "kr": "나도 어부가 아니었다면 일곱 바다를 누비며"
  },
  "5": {
   "jp": "e5c8a20e",
   "kr": "큰 모험을 했을 거라고."
  },
  "6": {
   "jp": "c81f70f8",
   "kr": "저도 『캡틴 토마스』 정말 좋아해요."
  },
  "7": {
   "jp": "5fdec2d9",
   "kr": "해적왕 라몬과의 마지막 승부 장면 같은 건"
  },
  "8": {
   "jp": "c11d1736",
   "kr": "몇 번을 읽어도 두근거려요."
  },
  "9": {
   "jp": "aded9e7f",
   "kr": "그래. 그렇지, 그렇지."
  },
  "10": {
   "jp": "25a78657",
   "kr": "역시 좋제."
  },
  "11": {
   "jp": "c2646be0",
   "kr": "여자애는 모를 것이여."
  },
  "12": {
   "jp": "1b2dedea",
   "kr": "근데 크리스는 달라요."
  },
  "13": {
   "jp": "a29d7ab7",
   "kr": "무슨 뜻이야?"
  },
  "14": {
   "jp": "75e4e2a1",
   "kr": "걱정 안 해도 느긋하게 있으면"
  },
  "15": {
   "jp": "c536d538",
   "kr": "타라타호가 안전하게 네갈섬 항구까지"
  },
  "16": {
   "jp": "62e43cde",
   "kr": "데려다줄 것이여."
  },
  "17": {
   "jp": "fa48a583",
   "kr": "타라타호 명물"
  },
  "18": {
   "jp": "687289c8",
   "kr": "보리 위에 올린 해산물 카레 필라프여."
  },
  "19": {
   "jp": "60e5c0b4",
   "kr": "맛있당께."
  },
  "20": {
   "jp": "b75b78e7",
   "kr": "우와아, 맛있겠다!"
  },
  "21": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "22": {
   "jp": "34c4ac57",
   "kr": "잘 먹겠습니다아!"
  },
  "23": {
   "jp": "4976a0b7",
   "kr": "냠냠냠냠…냠냠냠냠…"
  },
  "24": {
   "jp": "86e02bdc",
   "kr": "…냠냠냠냠 … 냠냠냠냠"
  },
  "25": {
   "jp": "b1c8cd97",
   "kr": "냠냠냠… 냠 냠냠냠…"
  },
  "26": {
   "jp": "de989548",
   "kr": "후우…"
  },
  "27": {
   "jp": "922f0c17",
   "kr": "아〜, 맛있었다."
  },
  "28": {
   "jp": "30c7c2a2",
   "kr": "쥬리오&크리스"
  },
  "29": {
   "jp": "f6feda67",
   "kr": "잘 먹었습니다!"
  },
  "30": {
   "jp": "d5a99c94",
   "kr": "그치, 맛있었제."
  },
  "31": {
   "jp": "982bdc5e",
   "kr": "네, 엄청 맛있었어요."
  },
  "32": {
   "jp": "8fbcff1f",
   "kr": "책장에 책이 있습니다."
  },
  "33": {
   "jp": "36dc0076",
   "kr": "『캡틴 토마스』의 책입니다."
  },
  "34": {
   "jp": "e5e0339b",
   "kr": "표지에는 『캡틴 토마스의 대항해』라고"
  },
  "35": {
   "jp": "9f45ca92",
   "kr": "적혀 있다. 쥬리오가 제일 좋아하는 얘기다."
  },
  "36": {
   "jp": "91638776",
   "kr": "조금 길지만 읽어 보시겠어요?"
  },
  "37": {
   "jp": "b5a6092b",
   "kr": "《캡틴 토마스의 대항해》"
  },
  "38": {
   "jp": "0184bd96",
   "kr": "아침 햇살에 바다가 반짝반짝 빛났다."
  },
  "39": {
   "jp": "d549eedd",
   "kr": "에메랄드해. 일곱 바다에서 가장 고운 바다."
  },
  "40": {
   "jp": "32cbd6e6",
   "kr": "갈매기는 날고 돌고래는 무리 지어 간다."
  },
  "41": {
   "jp": "2a6705f5",
   "kr": "흰 돛을 활짝 펴고 물살을 가르는 배가"
  },
  "42": {
   "jp": "a37509d7",
   "kr": "있었다. 캡틴 토마스가 이끄는 「하얀"
  },
  "43": {
   "jp": "3040f4f7",
   "kr": "철새」 프라네토스호다."
  },
  "44": {
   "jp": "b4b294b0",
   "kr": "프라네토스호는 오늘도 자유로이 간다."
  },
  "45": {
   "jp": "3b369e6f",
   "kr": "캡틴 토마스는 마침내 해적왕 라몬의 소굴 "
  },
  "46": {
   "jp": "085d837c",
   "kr": "을 찾아냈다. 바다의 무법자, 해적왕 라몬."
  },
  "47": {
   "jp": "f4301af4",
   "kr": "이 아름다운 에메랄드해에 본거지가 있을 줄"
  },
  "48": {
   "jp": "6b4d5582",
   "kr": "누가 상상했으랴…"
  },
  "49": {
   "jp": "bc5178d4",
   "kr": "「이번엔 놓치지 않는다!」 아침 갑판에 선"
  },
  "50": {
   "jp": "f70cac55",
   "kr": "캡틴 토마스는 구릿빛 굵은 팔에"
  },
  "51": {
   "jp": "a7ed4411",
   "kr": "힘을 주며 중얼거렸다. 승부는 저녁, 해적섬"
  },
  "52": {
   "jp": "ca40022d",
   "kr": "남서쪽 1200미로 해역이다."
  },
  "53": {
   "jp": "555b3799",
   "kr": "프라네토스호는 순조로이 나아가 한낮이 지나"
  },
  "54": {
   "jp": "6c6ee67b",
   "kr": "예정 해역에 닿았다. 라몬과는 여러 번"
  },
  "55": {
   "jp": "03e4d511",
   "kr": "싸웠지만 놈의 앞마당은 처음이다. 어떤"
  },
  "56": {
   "jp": "5dffcfe1",
   "kr": "함정이 있을지 모른다. 토마스는 닻을 내리고"
  },
  "57": {
   "jp": "e8c76cec",
   "kr": "망꾼을 세웠다. 해가 기울 무렵 라몬이"
  },
  "58": {
   "jp": "4bac74c5",
   "kr": "이끄는 선단이 보였다. 그 수는 여섯 척."
  },
  "59": {
   "jp": "cf2d7574",
   "kr": "하나같이 특대 대포를 단 전함. 이쪽도 대포"
  },
  "60": {
   "jp": "5a4f3135",
   "kr": "는 있지만 프라네토스호 한 척뿐이다."
  },
  "61": {
   "jp": "1d161891",
   "kr": "하지만 여기서 적에게 등을 보일 수는 없다."
  },
  "62": {
   "jp": "508115c6",
   "kr": "「오늘이야말로 자웅을 겨룰 때다…」"
  },
  "63": {
   "jp": "25814845",
   "kr": "저녁놀에 물든 에메랄드해에서 캡틴 토마스"
  },
  "64": {
   "jp": "be817d64",
   "kr": "와 해적왕 라몬의 마지막 싸움이 시작됐다"
  },
  "65": {
   "jp": "50c42819",
   "kr": "라몬의 포격이 시작됐다. 소리만 요란한"
  },
  "66": {
   "jp": "a3cf3fe5",
   "kr": "뿐 닿지 않는다. 캡틴 토마스는 바람을"
  },
  "67": {
   "jp": "00fb1a1a",
   "kr": "탔다. 「이놈! 바람을 빼앗겼구나!」 라몬은"
  },
  "68": {
   "jp": "9f1cca65",
   "kr": "분하게 외쳤다. 이래서는 포탄이 안 맞는다."
  },
  "69": {
   "jp": "c3c28ed1",
   "kr": "하지만 이제부터가 진짜 캡틴 토마스"
  },
  "70": {
   "jp": "a9648629",
   "kr": "의 작전이었다. 「돛을 활짝 펼쳐라!!」"
  },
  "71": {
   "jp": "34045376",
   "kr": "그 소리에 돛대마다 일제히 흰 꽃이 폈다."
  },
  "72": {
   "jp": "3ee854c0",
   "kr": "프라네토스호는 포탄처럼 튀어나갔다."
  },
  "73": {
   "jp": "1f3996a1",
   "kr": "바람 탄 프라네토스호를 아무도 못 막는다."
  },
  "74": {
   "jp": "dee03b16",
   "kr": "「라몬의 배에 들이받는다! 백병전이다!」"
  },
  "75": {
   "jp": "95e1401c",
   "kr": "타륜이 도르래처럼 돌고 프라네토스호는 라몬의"
  },
  "76": {
   "jp": "8a0fad5f",
   "kr": "배를 향해 곧장 진로를 잡았다."
  },
  "77": {
   "jp": "3820d926",
   "kr": "방해하는 배에는 포탄으로 답례다."
  },
  "78": {
   "jp": "0d47cfe0",
   "kr": "프라네토스호는 목표에 닿기 전 이미 세 척을"
  },
  "79": {
   "jp": "43d0bdf7",
   "kr": "가라앉혔다. 「캡틴 토마스, 건방진 놈!」"
  },
  "80": {
   "jp": "b694b843",
   "kr": "라몬은 분해서 발을 굴렀다."
  },
  "81": {
   "jp": "aa7d6d09",
   "kr": "라몬의 배 옆구리에 프라네토스호가 박혔다."
  },
  "82": {
   "jp": "c7c44d59",
   "kr": "「올라타라! 뛰어 건너라!」 맞붙은 두 배의"
  },
  "83": {
   "jp": "f3944d12",
   "kr": "선원이 뒤엉켜 백병전이 시작됐다."
  },
  "84": {
   "jp": "4f126d9e",
   "kr": "토마스는 라몬을 찾아 가라앉는 배를 달린다."
  },
  "85": {
   "jp": "95102644",
   "kr": "「라몬! 어디 있느냐! 이 캡틴 토마스가"
  },
  "86": {
   "jp": "0b89ddcd",
   "kr": "상대다!!」 라몬이 뒤에서 느닷없이"
  },
  "87": {
   "jp": "8e2c5606",
   "kr": "덮쳤다. 「이얍!」 토마스는 슬쩍 피한다."
  },
  "88": {
   "jp": "c1c7ee0f",
   "kr": "「비겁한 놈!」 부딪는 검에서 불꽃이 튄다."
  },
  "89": {
   "jp": "d82fafd3",
   "kr": "물이 찬 선체가 크게 기울기 시작했다."
  },
  "90": {
   "jp": "5ea9ef06",
   "kr": "「라몬! 오늘이야말로 네놈의 최후다!」"
  },
  "91": {
   "jp": "9d7b8b7e",
   "kr": "「그건… 글쎄다. 너도 끝장이다!」"
  },
  "92": {
   "jp": "5711c7de",
   "kr": "다급한 라몬은 화약에 불을 붙였다."
  },
  "93": {
   "jp": "931736a4",
   "kr": "「모두들, 바다로 뛰어들어라!!」"
  },
  "94": {
   "jp": "4753a405",
   "kr": "캡틴 토마스는 외치며 바다로 뛰어들었다."
  },
  "95": {
   "jp": "be2a8f6c",
   "kr": "두 배는 맞붙은 채 굉음과 함께 날아갔다."
  },
  "96": {
   "jp": "6317fec9",
   "kr": "캡틴의 마지막 항해는 이렇게 막을 내렸다."
  },
  "97": {
   "jp": "85e4be16",
   "kr": "이 해전 뒤 해적 소동은 사라졌다."
  },
  "98": {
   "jp": "f4920d1b",
   "kr": "그러나 그 뒤로 캡틴 토마스의 늠름한 모습을"
  },
  "99": {
   "jp": "ba3f84c7",
   "kr": "본 이도 없다. 우리는 철새를 볼 때마다"
  },
  "100": {
   "jp": "e1c273ee",
   "kr": "떠올리리라. 프라네토스호를 몰고 일곱 바다를"
  },
  "101": {
   "jp": "4ab17b13",
   "kr": "건넌 사나이. 캡틴 토마스가 있었음을…"
  },
  "102": {
   "jp": "634cfe9f",
   "kr": "ＥＮＤ"
  },
  "103": {
   "jp": "98cc51a9",
   "kr": "쥬리오는 토바이도 『캡틴 토마스』"
  },
  "104": {
   "jp": "ad7c4a15",
   "kr": "팬이라는 걸 알고 조금 기분이 좋아졌다."
  },
  "105": {
   "jp": "ca40dca4",
   "kr": "저기, 쥬리오."
  },
  "106": {
   "jp": "5b329419",
   "kr": "통만 보면 왠지 허크 삼촌이"
  },
  "107": {
   "jp": "34d75e1f",
   "kr": "튀어나올 것 같아."
  },
  "108": {
   "jp": "52cb78e9",
   "kr": "그래도 난 또 만나고 싶어."
  },
  "109": {
   "jp": "6e1d7a48",
   "kr": "어머, 나도 그래."
  },
  "110": {
   "jp": "9d138e39",
   "kr": "허크 삼촌은 좀 별나지만"
  },
  "111": {
   "jp": "85dc71bc",
   "kr": "난 정말 좋아."
  },
  "112": {
   "jp": "bfde6773",
   "kr": "응, 나도 좋아해."
  },
  "113": {
   "jp": "52502f16",
   "kr": "이놈!"
  },
  "114": {
   "jp": "e4b0c478",
   "kr": "탁자 위에 올라가는 거 아니여."
  },
  "115": {
   "jp": "9dd3c193",
   "kr": "얼른 내려오라고."
  },
  "116": {
   "jp": "7083782a",
   "kr": "미안해요."
  },
  "117": {
   "jp": "8800e25a",
   "kr": "몇 번을 말해야 알아듣겄냐?"
  },
  "118": {
   "jp": "c2053e9c",
   "kr": "아니, 그만 그만."
  }
 }
}