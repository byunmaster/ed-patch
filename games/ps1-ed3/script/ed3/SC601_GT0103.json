 "lines": {
  "0": {
   "jp": "17a61f4f",
   "kr": "바라카"
  },
  "1": {
   "jp": "0af8a3f8",
   "kr": "감옥"
  },
  "2": {
   "jp": "bef8b2be",
   "kr": "기드나 병사"
  },
  "3": {
   "jp": "79204ab9",
   "kr": "가죠"
  },
  "4": {
   "jp": "4164cecf",
   "kr": "저 녀석, 병원 신세다."
  },
  "5": {
   "jp": "70eb3487",
   "kr": "(마, 말 걸지 마…)"
  },
  "6": {
   "jp": "2c5d3593",
   "kr": "(지금 두근두근하고 있는데…)"
  },
  "7": {
   "jp": "0883ed40",
   "kr": "자, 다음은 네 차례다."
  },
  "8": {
   "jp": "72cf6c44",
   "kr": "빨리 나와라. 손님들 기다린다."
  },
  "9": {
   "jp": "c72ad5e0",
   "kr": "쥬리오의 심장은 뛰고 있었다."
  },
  "10": {
   "jp": "d4846f92",
   "kr": "마수와의 싸움은 몇 번이나 겪었지만,"
  },
  "11": {
   "jp": "07a69e69",
   "kr": "극악무도한 자와 싸우는 건 처음이었다."
  },
  "12": {
   "jp": "516775ee",
   "kr": "그것도 단 혼자서…"
  },
  "13": {
   "jp": "bb079970",
   "kr": "바다트와의 계획은,"
  },
  "14": {
   "jp": "ed3e2ff6",
   "kr": "이 시합에 못 이기면 실행할 수 없다."
  },
  "15": {
   "jp": "ae7c9ba2",
   "kr": "어떻게든"
  },
  "16": {
   "jp": "58d887d2",
   "kr": "이겨야만 했다."
  },
  "17": {
   "jp": "2429fcb6",
   "kr": "좋았어!"
  },
  "18": {
   "jp": "f003caf5",
   "kr": "쥬리오는 억지로 기합을 넣었다."
  },
  "19": {
   "jp": "9caba34f",
   "kr": "괜찮을까, 저 녀석."
  }
 }
}