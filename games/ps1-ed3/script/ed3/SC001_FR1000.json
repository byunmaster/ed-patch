{
 "archive": "/SCE0/SC001.DAT",
 "member": "..\\DATA\\FR1000.BIN",
 "lines": {
  "0": {
   "jp": "990eaece",
   "kr": "수정호"
  },
  "1": {
   "jp": "c3b33230",
   "kr": "구름다리"
  },
  "2": {
   "jp": "12746fb3",
   "kr": "이린"
  },
  "3": {
   "jp": "8cfc5617",
   "kr": "아, 너희들."
  },
  "4": {
   "jp": "031e7f53",
   "kr": "디네 샤리네에 가는 거니?"
  },
  "5": {
   "jp": "d357e9e0",
   "kr": "네."
  },
  "6": {
   "jp": "03476442",
   "kr": "순례 여행이에요."
  },
  "7": {
   "jp": "5cb00447",
   "kr": "그럼, 라그픽 마을에서!?"
  },
  "8": {
   "jp": "6fbaef35",
   "kr": "그거 힘들었겠구나."
  },
  "9": {
   "jp": "10e0cc90",
   "kr": "공교롭게도 이 앞 다리가 무너져서 말이야."
  },
  "10": {
   "jp": "26d1ef87",
   "kr": "위험하니까 내가 지키고 있단다."
  },
  "11": {
   "jp": "876b666f",
   "kr": "돌아가야 하지만 아랫길로 가면"
  },
  "12": {
   "jp": "b6e6802b",
   "kr": "문제없이 닿을 수 있으니까."
  },
  "13": {
   "jp": "c08b3d79",
   "kr": "도중에 있는 동굴은 좀 넓으니까"
  },
  "14": {
   "jp": "7d9dc078",
   "kr": "헤매지 않게 조심하렴."
  },
  "15": {
   "jp": "6d3117d2",
   "kr": "루데라 관문의 병사에게 지원을 부탁해 뒀으니"
  },
  "16": {
   "jp": "cd001426",
   "kr": "너희가 디네에서 돌아올 무렵엔"
  },
  "17": {
   "jp": "8a41452a",
   "kr": "고쳐져 있을 거야."
  },
  "18": {
   "jp": "fa02f1fd",
   "kr": "가는 길 조심하렴."
  },
  "19": {
   "jp": "eb40173f",
   "kr": "다리에서 수정호를 구경하는 것도 좋지만"
  },
  "20": {
   "jp": "1cc2bf78",
   "kr": "떨어지지 않게 조심해."
  },
  "21": {
   "jp": "e0c33827",
   "kr": "순례 여행은 이제 막 시작됐어."
  },
  "22": {
   "jp": "517cd3ce",
   "kr": "달리기만 하면 못 찾는 것도 있단다."
  },
  "23": {
   "jp": "c420c96e",
   "kr": "제 걸음대로 가는 게 좋아."
  },
  "24": {
   "jp": "e5ab9b9c",
   "kr": "어라?"
  },
  "25": {
   "jp": "405f1cf1",
   "kr": "다리가 무너져 있어."
  },
  "26": {
   "jp": "fb1df18d",
   "kr": "정말이네."
  },
  "27": {
   "jp": "8ade1851",
   "kr": "어떻게 된 걸까?"
  }
 }
}
