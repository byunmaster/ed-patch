{
 "archive": "/SCE6/SC606.DAT",
 "member": "..\\DATA\\GT3103.BIN",
 "lines": {
  "0": {
   "jp": "26fb5f27",
   "kr": "딜트 관문"
  },
  "1": {
   "jp": "1fe2873d",
   "kr": "폴티아 병사"
  },
  "2": {
   "jp": "2892c405",
   "kr": "아오프"
  },
  "3": {
   "jp": "cec274f4",
   "kr": "허크"
  },
  "4": {
   "jp": "bb7f8bad",
   "kr": "그랬군요…"
  },
  "5": {
   "jp": "bd60b96d",
   "kr": "라우알의 파도…"
  },
  "6": {
   "jp": "632f04c2",
   "kr": "놀랐군."
  },
  "7": {
   "jp": "39788025",
   "kr": "나한텐 규모가 너무 큰 얘기다."
  },
  "8": {
   "jp": "e1857942",
   "kr": "으음."
  },
  "9": {
   "jp": "7f0a1eac",
   "kr": "참으로 뜻깊은 여행을 해 왔구나."
  },
  "10": {
   "jp": "2ba70922",
   "kr": "내 조사보다"
  },
  "11": {
   "jp": "c42b40b1",
   "kr": "훨씬 자세하지 않은가."
  },
  "12": {
   "jp": "de63c591",
   "kr": "이 둘한테는 못 당한다."
  },
  "13": {
   "jp": "8daa62fb",
   "kr": "허크 씨"
  },
  "14": {
   "jp": "c58b2d71",
   "kr": "뭐, 기죽지 말라고."
  },
  "15": {
   "jp": "f8a9a141",
   "kr": "기가 죽는다고?"
  },
  "16": {
   "jp": "5a0982ba",
   "kr": "이 내가?"
  },
  "17": {
   "jp": "660b3b9b",
   "kr": "핫핫핫…"
  },
  "18": {
   "jp": "21e4c8e3",
   "kr": "아직 비장의 정보가 있거든."
  },
  "19": {
   "jp": "0a01daf0",
   "kr": "비장의 정보?"
  },
  "20": {
   "jp": "2cb76a5c",
   "kr": "바로 그것이,"
  },
  "21": {
   "jp": "7b981c27",
   "kr": "내가 여기서 너희를 기다린"
  },
  "22": {
   "jp": "373b6cbc",
   "kr": "이유란다."
  },
  "23": {
   "jp": "457da51b",
   "kr": "하지만, 이건 웃고 넘길 일이 아니군."
  },
  "24": {
   "jp": "1559c7f4",
   "kr": "허크는 갑자기 진지한 얼굴이 되었다."
  },
  "25": {
   "jp": "61a472e2",
   "kr": "아로자에 사는 그 아가씨"
  },
  "26": {
   "jp": "234f73f6",
   "kr": "죠안나 씨라고 하는데 말이야."
  },
  "27": {
   "jp": "695817a3",
   "kr": "그 죠안나 씨가"
  },
  "28": {
   "jp": "a40f8396",
   "kr": "듀르젤 공에게서 구전으로"
  },
  "29": {
   "jp": "f40481c0",
   "kr": "하얀마녀의 예언을 들었던 거야."
  },
  "30": {
   "jp": "1a0870f6",
   "kr": "마지막 예언을 말이야."
  },
  "31": {
   "jp": "405ce40d",
   "kr": "하얀마녀의… 마지막 예언?"
  },
  "32": {
   "jp": "87634187",
   "kr": "그래."
  },
  "33": {
   "jp": "6c7a5833",
   "kr": "그 뒤로 하얀마녀에 관한 전승은 없고,"
  },
  "34": {
   "jp": "7c88d2e4",
   "kr": "하얀마녀가 죽어 버린 것인지"
  },
  "35": {
   "jp": "8c55e8ad",
   "kr": "아니면 살아 있는 것인지 그건 알 수 없다."
  },
  "36": {
   "jp": "7a1e779e",
   "kr": "다만, 듀르젤 공이 들은 것이"
  },
  "37": {
   "jp": "d74b1946",
   "kr": "마지막 예언이라는 것은,"
  },
  "38": {
   "jp": "97c278c0",
   "kr": "아마 틀림없을 거다."
  },
  "39": {
   "jp": "ae183003",
   "kr": "마지막 예언은 이렇다."
  },
  "40": {
   "jp": "06e3bc70",
   "kr": "표정 없는 병사들이 국경을 넘을 때,"
  },
  "41": {
   "jp": "a7ab051e",
   "kr": "주박에 사로잡힌 왕은 이미 힘을 잃고,"
  },
  "42": {
   "jp": "8a644dfa",
   "kr": "바다도 산도, 이윽고 모두 죽어 스러진다."
  },
  "43": {
   "jp": "f07fc52c",
   "kr": "이계의 여인과, 별을 부리는 남자에게,"
  },
  "44": {
   "jp": "4d476d94",
   "kr": "재앙의 파도가 끌려오리라."
  },
  "45": {
   "jp": "615f9949",
   "kr": "재앙의 파도… 라우알의 파도네요."
  },
  "46": {
   "jp": "75d99266",
   "kr": "이계의 여인이라니?"
  },
  "47": {
   "jp": "da6674cc",
   "kr": "그런 건 지금까지의 예언엔 없었어."
  },
  "48": {
   "jp": "d357e9e0",
   "kr": "응."
  },
  "49": {
   "jp": "e6ed0990",
   "kr": "하얀마녀가 폴티아에 온 뒤에야"
  },
  "50": {
   "jp": "c0155296",
   "kr": "비로소 알게 된 걸까…"
  },
  "51": {
   "jp": "724c1264",
   "kr": "별을 부리는 남자란"
  },
  "52": {
   "jp": "8a5e24e4",
   "kr": "분명 레바스겠지."
  },
  "53": {
   "jp": "919c141b",
   "kr": "왕이 어쩌고 하는 것도 있었는데,"
  },
  "54": {
   "jp": "4a5dc54e",
   "kr": "당연히 그건 루드성의"
  },
  "55": {
   "jp": "3e188eac",
   "kr": "루돌프 왕이겠지."
  },
  "56": {
   "jp": "15a12fd1",
   "kr": "마지막 예언에 있는 표정 없는 병사들이란,"
  },
  "57": {
   "jp": "b9019fb9",
   "kr": "아무래도 너희가 들은"
  },
  "58": {
   "jp": "c3debfee",
   "kr": "여기로 오고 있다는 병단을 말하는 것 같군."
  },
  "59": {
   "jp": "198ae122",
   "kr": "이대로라면"
  },
  "60": {
   "jp": "c43b4ca8",
   "kr": "라우알의 파도가 온다는 것도"
  },
  "61": {
   "jp": "a0b5115f",
   "kr": "피할 수 없는 운명인 것 같아."
  },
  "62": {
   "jp": "a60e72b1",
   "kr": "이러고 있을 수는 없겠어."
  },
  "63": {
   "jp": "b6dd5526",
   "kr": "쥬리오 군."
  },
  "64": {
   "jp": "8b50be87",
   "kr": "은단검을 갖고 있지."
  },
  "65": {
   "jp": "05e86858",
   "kr": "응. 물론 가지고 있어."
  },
  "66": {
   "jp": "dcec71c6",
   "kr": "근데, 왜요?"
  },
  "67": {
   "jp": "ecef813c",
   "kr": "아로자에 사는 죠안나 씨가"
  },
  "68": {
   "jp": "0e24bbc4",
   "kr": "알려 준 건데."
  },
  "69": {
   "jp": "eab5e4a5",
   "kr": "지금은 돌페스에 유폐된 듀르젤 공이"
  },
  "70": {
   "jp": "0ad503f5",
   "kr": "붙잡히기 전에, 고식대로 은단검을 들고"
  },
  "71": {
   "jp": "b00f3e28",
   "kr": "다섯 샤리네를 순례하는 자만 있다면…"
  },
  "72": {
   "jp": "f2dad107",
   "kr": "… 라고"
  },
  "73": {
   "jp": "74eed8a3",
   "kr": "자주 되뇌었다더군."
  },
  "74": {
   "jp": "cb979e3a",
   "kr": "그거 우리 얘기잖아."
  },
  "75": {
   "jp": "ccb06fd6",
   "kr": "응. 조건에 딱 맞아."
  },
  "76": {
   "jp": "6bf9844e",
   "kr": "그래. 그래서 여기서 기다렸던 거야."
  },
  "77": {
   "jp": "17251e48",
   "kr": "게다가 여기서 기다리다 마지막 예언에 있는"
  },
  "78": {
   "jp": "3838e12e",
   "kr": "표정 없는 병단이 나타나면,"
  },
  "79": {
   "jp": "8f063d7c",
   "kr": "바로 예언을 확인할 수 있으니까요?"
  },
  "80": {
   "jp": "ebb3c66a",
   "kr": "바로 그거다."
  },
  "81": {
   "jp": "f609bac6",
   "kr": "역시 허크 삼촌."
  },
  "82": {
   "jp": "e34de661",
   "kr": "사실은 천재 아니야…"
  },
  "83": {
   "jp": "1fc22caa",
   "kr": "에헴."
  },
  "84": {
   "jp": "12173002",
   "kr": "뭐, 듀르젤 공께 얘길 들으면"
  },
  "85": {
   "jp": "947f13ed",
   "kr": "더 확실해지겠지만."
  },
  "86": {
   "jp": "511cb65e",
   "kr": "아무래도 나는,"
  },
  "87": {
   "jp": "dcfc9e1d",
   "kr": "은단검이 다섯 샤리네와 하얀마녀."
  },
  "88": {
   "jp": "6c2f14e7",
   "kr": "그리고 라우알의 파도."
  },
  "89": {
   "jp": "a6778475",
   "kr": "이 셋을 잇는 열쇠라는 생각이 자꾸 들어."
  },
  "90": {
   "jp": "dc02471a",
   "kr": "너희도 알고 있겠지만,"
  },
  "91": {
   "jp": "d327986a",
   "kr": "성인식인 순례 여행은 예전 마녀나"
  },
  "92": {
   "jp": "6487d061",
   "kr": "마법사의 순례를 따라 해 남은 것이다."
  },
  "93": {
   "jp": "cd0ec8cb",
   "kr": "예전엔 많은 마을에 그 관습이 있었지만,"
  },
  "94": {
   "jp": "7bc99c05",
   "kr": "지금은 손에 꼽을 만큼밖에"
  },
  "95": {
   "jp": "8a888f77",
   "kr": "그 관습이 남은 마을은 없어."
  },
  "96": {
   "jp": "59423040",
   "kr": "물론, 시대가 흐르면서"
  },
  "97": {
   "jp": "6374d0a5",
   "kr": "사람들의 습관과 생활이 변하는 건 당연하다."
  },
  "98": {
   "jp": "17f3deea",
   "kr": "허나, 생각해 보게나."
  },
  "99": {
   "jp": "c7ff6ace",
   "kr": "도대체 누가, 어떤 이유로 순례를 시작해서,"
  },
  "100": {
   "jp": "0b115391",
   "kr": "우리에게 은단검을 주었을까…?"
  },
  "101": {
   "jp": "bfb9948d",
   "kr": "샤리네나 마법의 존재만 해도"
  },
  "102": {
   "jp": "1af50963",
   "kr": "아직껏 아무도 설명하지 못한다네."
  },
  "103": {
   "jp": "46bdfb53",
   "kr": "마지막 예언에,"
  },
  "104": {
   "jp": "ca508142",
   "kr": "이계의 여인이라는 대목이 있었죠."
  },
  "105": {
   "jp": "517aac5b",
   "kr": "그래, 바로 거기야."
  },
  "106": {
   "jp": "c044d914",
   "kr": "어쩌면, 이 수수께끼는 우리가 아는"
  },
  "107": {
   "jp": "6b0c4487",
   "kr": "이 세계뿐 아니라, 본디 이계의 영향을 받아"
  },
  "108": {
   "jp": "e3c82952",
   "kr": "존재하는 것인지도 몰라…"
  },
  "109": {
   "jp": "414cdbb4",
   "kr": "사실 그렇게, 내게는 생각되기 시작했단다."
  },
  "110": {
   "jp": "6aefd918",
   "kr": "라우알의 파도는"
  },
  "111": {
   "jp": "d127f2aa",
   "kr": "이계와 이어진 자만이 안다고,"
  },
  "112": {
   "jp": "279df701",
   "kr": "대신관 덴켄 님이 말씀하셨다지?"
  },
  "113": {
   "jp": "9cf7c33a",
   "kr": "응. 그래."
  },
  "114": {
   "jp": "6bf40c81",
   "kr": "좋아. 어쨌든 아로자로 가자."
  },
  "115": {
   "jp": "79cc79e0",
   "kr": "은단검을 지니고 순례를 해 온 너희를"
  },
  "116": {
   "jp": "fc84834b",
   "kr": "죠안나 씨 곁으로 데려가면,"
  },
  "117": {
   "jp": "ed9cca67",
   "kr": "분명 뭔가 새로운 정보를 얻을 수 있겠지."
  },
  "118": {
   "jp": "574f4117",
   "kr": "그다음 돌페스로 가서"
  },
  "119": {
   "jp": "a233b777",
   "kr": "듀르젤 공을 만나야 해. 마지막 예언이"
  },
  "120": {
   "jp": "15c947c5",
   "kr": "움직이기 시작했다면 남은 시간은 적다."
  },
  "121": {
   "jp": "85ce6358",
   "kr": "그건 그렇고…"
  },
  "122": {
   "jp": "f9ea4435",
   "kr": "나도 풍문으로 들은 적이 있는데,"
  },
  "123": {
   "jp": "3c910efb",
   "kr": "듀르젤이라면,"
  },
  "124": {
   "jp": "742916c1",
   "kr": "전설에 가까운 검의 달인이지."
  },
  "125": {
   "jp": "5b0a4a61",
   "kr": "게다가,"
  },
  "126": {
   "jp": "3c8ddf9f",
   "kr": "왕에게 충성하는 검사의 귀감이라고까지 한다."
  },
  "127": {
   "jp": "1166a915",
   "kr": "바다트도 듀르젤이란 사람을"
  },
  "128": {
   "jp": "ce66fad6",
   "kr": "알고 있었구나."
  },
  "129": {
   "jp": "15a30da7",
   "kr": "그러고 보니, 로디도 말했었지."
  },
  "130": {
   "jp": "052742ce",
   "kr": "로디라니?"
  },
  "131": {
   "jp": "40a1b87e",
   "kr": "순례 도중에 함께 여행한 검사야."
  },
  "132": {
   "jp": "99bb506c",
   "kr": "로디도 듀르젤은 유일하게 자신이 존경하는"
  },
  "133": {
   "jp": "fcdac88c",
   "kr": "대단한 검사라고 말했어."
  },
  "134": {
   "jp": "68bb3b00",
   "kr": "그렇지. 역시 그렇군."
  },
  "135": {
   "jp": "c7a1b1ac",
   "kr": "그래서 이상한 거다."
  },
  "136": {
   "jp": "e2944e90",
   "kr": "그런 사람이 어째서 유폐된 거냐?"
  },
  "137": {
   "jp": "f819e545",
   "kr": "응, 이상하네."
  },
  "138": {
   "jp": "bc7eaed1",
   "kr": "근데, 삼촌."
  },
  "139": {
   "jp": "fcade4f6",
   "kr": "여기서 어떻게 빠져나가는 거야?"
  },
  "140": {
   "jp": "4a490a10",
   "kr": "역시 저기 구멍?"
  },
  "141": {
   "jp": "d8466ea3",
   "kr": "안심하게."
  },
  "142": {
   "jp": "a0716f86",
   "kr": "이날을 위해"
  },
  "143": {
   "jp": "49dc2126",
   "kr": "내가 정확히 측량해서 판 탈출구다."
  },
  "144": {
   "jp": "e6fafbf7",
   "kr": "한 치의 어긋남 없이 다리 곁으로 통한다고."
  },
  "145": {
   "jp": "ab561fdf",
   "kr": "지표에 흙 한 겹만 남겨"
  },
  "146": {
   "jp": "07a21e0e",
   "kr": "바로 무너지게 해 뒀지."
  },
  "147": {
   "jp": "08bccea3",
   "kr": "근데, 걱정인 건 다리 놓이는 시간을"
  },
  "148": {
   "jp": "c6d8b36a",
   "kr": "모른다는 거다."
  },
  "149": {
   "jp": "24dfe315",
   "kr": "애써 밖에 나가도"
  },
  "150": {
   "jp": "d1326b7f",
   "kr": "다리가 안 내려와 있으면"
  },
  "151": {
   "jp": "1e9b7224",
   "kr": "저쪽으로 건널 수 없으니."
  },
  "152": {
   "jp": "4ef979bb",
   "kr": "그것도 걱정 없어."
  },
  "153": {
   "jp": "dd1785bf",
   "kr": "내 배꼽시계에 따르면"
  },
  "154": {
   "jp": "802007cb",
   "kr": "슬슬 병사가 순찰 올 때다."
  },
  "155": {
   "jp": "c7473ed5",
   "kr": "그 병사가 돌아가면"
  },
  "156": {
   "jp": "4c6131d7",
   "kr": "마침 다리가 놓이는 시간이지."
  },
  "157": {
   "jp": "915d2b14",
   "kr": "뭘, 괜찮아."
  },
  "158": {
   "jp": "4cb0be97",
   "kr": "내가 판 구멍을 지나면"
  },
  "159": {
   "jp": "5775421a",
   "kr": "다리가 내려온 뒤에도 충분히 늦지 않아."
  },
  "160": {
   "jp": "6bf775e4",
   "kr": "자, 슬슬 병사가 온다."
  },
  "161": {
   "jp": "65dd43c9",
   "kr": "달라진 건 없군."
  },
  "162": {
   "jp": "ba5fdfd0",
   "kr": "오늘은 두더지가 조용해."
  },
  "163": {
   "jp": "8671556e",
   "kr": "아직도 두더지 타령이냐."
  },
  "164": {
   "jp": "159163d8",
   "kr": "그렇게 큰 두더지가 어디 있다고."
  },
  "165": {
   "jp": "a943555b",
   "kr": "어라. 너희들, 딱하게 됐군."
  },
  "166": {
   "jp": "8a2b5a40",
   "kr": "허크 선생 얘기에"
  },
  "167": {
   "jp": "89e7f82b",
   "kr": "말려든 모양이구나."
  },
  "168": {
   "jp": "48d5d40f",
   "kr": "선생은 잘 땐 조용한데"
  },
  "169": {
   "jp": "497cc2b4",
   "kr": "한번 말을 꺼내면 안 멈추니까."
  },
  "170": {
   "jp": "209db0f7",
   "kr": "우리도 애를 먹었다고."
  },
  "171": {
   "jp": "b885d51e",
   "kr": "허크 선생"
  },
  "172": {
   "jp": "9993eb7f",
   "kr": "신참을 너무 괴롭히지 마쇼."
  },
  "173": {
   "jp": "19de89fa",
   "kr": "자네도 어때?"
  },
  "174": {
   "jp": "509b1658",
   "kr": "지금, 재미있는 얘길 시작하려던 참이거든."
