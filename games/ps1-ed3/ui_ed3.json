{
 "disc": "ed3",
 "strings": {
  "0x0010BC": {
   "jp": "c92b4cda",
   "kr": "예"
  },
  "0x0010C2": {
   "jp": "f9015853",
   "kr": "아니오"
  },
  "0x0010DC": {
   "jp": "95fd9267",
   "kr": "사기"
  },
  "0x0010E6": {
   "jp": "511a48e6",
   "kr": "팔기"
  },
  "0x0010F0": {
   "jp": "68847720",
   "kr": "환전하기"
  },
  "0x097D8E": {
   "jp": "0392b9aa",
   "kr": "벌을 불러 적을 공격."
  },
  "0x097DAA": {
   "jp": "d94ba004",
   "kr": "진공의 칼날로 적을 공격한다."
  },
  "0x097DCC": {
   "jp": "b0f399c5",
   "kr": "적을 재운다."
  },
  "0x097DDC": {
   "jp": "d552cf8f",
   "kr": "적을 잠시 행동불능케 한다."
  },
  "0x097DFE": {
   "jp": "4df90374",
   "kr": "파티 한명의 ＨＰ를 조금 회복한다."
  },
  "0x097E26": {
   "jp": "a31fc01e",
   "kr": "파티 한명의 ＨＰ를 회복한다."
  },
  "0x097E4A": {
   "jp": "15b9dda9",
   "kr": "파티 전원의 ＨＰ를 회복한다."
  },
  "0x097E6A": {
   "jp": "c67aaae5",
   "kr": "전투불능이 된 동료를 되살린다."
  },
  "0x097E8E": {
   "jp": "42bbd2fd",
   "kr": "그 캐릭터 옆에 있어야 쓸 수 있다."
  },
  "0x097EBA": {
   "jp": "48b006eb",
   "kr": "파티 한 명의 ＶＰ 회복."
  },
  "0x097EDE": {
   "jp": "54f84bbb",
   "kr": "ＨＰ 최저 동료를 후방 탈출."
  },
  "0x097F02": {
   "jp": "6c0fcd3d",
   "kr": "대상을 투명하게 한다."
  },
  "0x097F1E": {
   "jp": "12c09086",
   "kr": "적 전체를 불로 공격."
  },
  "0x097F36": {
   "jp": "0492d00c",
   "kr": "적 하나를 불로 공격."
  },
  "0x097F4E": {
   "jp": "27873cb5",
   "kr": "안개로 적을 혼란시킨다."
  },
  "0x097F6C": {
   "jp": "eb7c5607",
   "kr": "혼란한 캐릭터는 제멋대로 행동한다."
  },
  "0x097F9C": {
   "jp": "6f8c0ff7",
   "kr": "대미지를 줄이는 배리어를 친다."
  },
  "0x097FC2": {
   "jp": "9a651f6d",
   "kr": "공격력과 마력을 상승시킨다."
  },
  "0x097FDE": {
   "jp": "3dbe6ad8",
   "kr": "잠시 동안, 건 아군 외 시간을 멈춘다."
  },
  "0x09800C": {
   "jp": "27ff0763",
   "kr": "적을 얼려 대미지를 준다."
  },
  "0x098030": {
   "jp": "eb28bf25",
   "kr": "적 하나의 ＶＰ 소비를 배로."
  },
  "0x09804E": {
   "jp": "26ceefea",
   "kr": "한 명의 ＶＰ 소비를 절반으로."
  },
  "0x098078": {
   "jp": "4df90374",
   "kr": "파티 한 명의 ＨＰ를 조금 회복한다."
  },
  "0x09D188": {
   "jp": "7ac94c1a",
   "kr": "보"
  },
  "0x09D18C": {
   "jp": "ffab9d02",
   "kr": "기"
  },
  "0x09D190": {
   "jp": "479a48d2",
   "kr": "읽는다"
  },
  "0x09D198": {
   "jp": "f6901ca3",
   "kr": "사"
  },
  "0x09D19C": {
   "jp": "af2b29a9",
   "kr": "용"
  },
  "0x09D1A0": {
   "jp": "7ca67446",
   "kr": "버린다"
  },
  "0x09D1A8": {
   "jp": "98cc6b29",
   "kr": "하얀마녀에 대해"
  },
  "0x09D1BA": {
   "jp": "460cd70c",
   "kr": "샤리네에 대해"
  },
  "0x09D1CC": {
   "jp": "f150c3e8",
   "kr": "마녀와 얽힌 땅"
  },
  "0x09D1DE": {
   "jp": "122adbf2",
   "kr": "진홍의 불꽃"
  },
  "0x09D1F0": {
   "jp": "4254c71d",
   "kr": "그 밖의 기록"
  },
  "0x09D20A": {
   "jp": "71a73598",
   "kr": "종류："
  },
  "0x09D212": {
   "jp": "b6b5c23c",
   "kr": "효과："
  },
  "0x09D21A": {
   "jp": "bd7a8115",
   "kr": "마법："
  },
  "0x09D222": {
   "jp": "26533f83",
   "kr": "장비："
  },
  "0x09D22A": {
