  },
  "0x097DFE": {
   "jp": "4df90374",
   "kr": "파티 한명의 ＨＰ를 조금 회복한다."
  },
  "0x097E26": {
   "jp": "a31fc01e",
   "kr": "파티 한명의 ＨＰ를 회복한다."
