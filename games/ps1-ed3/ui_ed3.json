  },
  "0x09D270": {
   "jp": "b138263f",
   "kr": "망토"
  },
  "0x09D278": {
   "jp": "4dd92945",
   "kr": "방패"
  },
  "0x09D27C": {
   "jp": "a6046e00",
   "kr": "팔갑"
  },
  "0x09D282": {
   "jp": "24e0e193",
   "kr": "반지"
  },
  "0x09D288": {
   "jp": "949a73cd",
   "kr": "장신구"
  },
  "0x09D290": {
   "jp": "95a23799",
   "kr": "기타 장비"
  },
  "0x09D2A0": {
   "jp": "6db0d0b8",
   "kr": "파이어"
  },
  "0x09D2AA": {
   "jp": "1dd134c3",
   "kr": "벌 부르기"
  },
  "0x09D2B4": {
   "jp": "b7929ac1",
   "kr": "칼바람"
  },
  "0x09D2C0": {
   "jp": "29fc051a",
   "kr": "프리즈"
  },
  "0x09D2CA": {
   "jp": "007c4689",
   "kr": "썬더"
  },
  "0x09D2D4": {
   "jp": "c68f17df",
   "kr": "정화"
  },
  "0x09D2DA": {
   "jp": "2bd8d7b9",
   "kr": "실드 서클"
  },
  "0x09D2EC": {
   "jp": "6db14209",
   "kr": "슬립"
  },
  "0x09D2F6": {
   "jp": "c442caef",
   "kr": "거미줄"
  },
  "0x09D300": {
   "jp": "9fb28ce6",
   "kr": "워프"
  },
  "0x09D308": {
   "jp": "bd934d74",
   "kr": "어둠의 속박"
  },
  "0x09D310": {
   "jp": "1a2e920b",
   "kr": "없음"
  },
  "0x09D316": {
   "jp": "6dfa4720",
   "kr": "녹슨 검이 은단검의 힘으로 변한 것."
  },
  "0x09D344": {
   "jp": "1272361e",
   "kr": "뇌격을 쓸 수 있다."
  },
  "0x09D362": {
   "jp": "5a72ced0",
   "kr": "라프의 지팡이가 은단검의 힘으로 변한 것."
  },
  "0x09D392": {
   "jp": "898013ec",
   "kr": "마법 정화를 쓸 수 있다."
  },
  "0x09D3B4": {
   "jp": "d0770625",
   "kr": "순례의 증표인 단검"
  },
  "0x09D3CA": {
   "jp": "e85f1225",
   "kr": "통행증 대신도 된다."
  },
  "0x09D3E2": {
   "jp": "2591e683",
   "kr": "쓸모 불명"
  },
  "0x09D3EE": {
   "jp": "5f52bde7",
   "kr": "삼도교에서 받은 １만째 기념품"
  },
  "0x09D418": {
   "jp": "d215bf55",
   "kr": "쓸모 불명"
  },
  "0x09D426": {
   "jp": "e685027c",
   "kr": "어떤 감기든 즉시 낫는 약."
  },
  "0x09D44A": {
   "jp": "533a5211",
   "kr": "닐리 읍장 라스파가 알데 촌장에게 보낸 편지."
  },
  "0x09D47C": {
   "jp": "c5dd394e",
   "kr": "바다표범의 먹이. 원료는 어패류"
  },
  "0x09D4A2": {
   "jp": "8e3bed70",
   "kr": "뱃멀미에 잘 듣는\n매발톱호의 상비약."
  },
  "0x09D4C8": {
   "jp": "187765f3",
   "kr": "이탄에서 나는 붉은 보석."
  },
  "0x09D4E6": {
   "jp": "544729d5",
   "kr": "보리를 한 번 끓여 말린 것."
  },
  "0x09D508": {
   "jp": "9ee3084a",
   "kr": "오래 두고 먹을 수 있어\n휴대식이 된다."
  },
  "0x09D524": {
   "jp": "8becd3fa",
   "kr": "앰비쉬 문장이 새겨진 낡은 반지."
  },
  "0x09D54A": {
   "jp": "12ec810e",
   "kr": "메마른 땅에도 자라는 렌즈콩 씨앗"
  },
  "0x09D56A": {
   "jp": "ae4edbc0",
   "kr": "먹을 수도 있다."
  },
  "0x09D580": {
   "jp": "096936bc",
   "kr": "에토스 노인이 로디에게 줄 약."
  },
  "0x09D5AA": {
   "jp": "f51f8ace",
   "kr": "캐라크가 형과 화해하려고 준비한 친서."
  },
  "0x09D5D8": {
   "jp": "a80cd3c6",
   "kr": "왕비가 갇힌 감옥 열쇠."
  },
  "0x09D5F6": {
   "jp": "6b35194a",
   "kr": "귀한 천연 무화과 열매."
  },
  "0x09D612": {
   "jp": "a9316ade",
   "kr": "여기선 못 쓴다."
  },
  "0x09D626": {
   "jp": "f9f8d9e0",
   "kr": "버려도 될까?"
  },
  "0x09D63A": {
   "jp": "fb7acfb0",
   "kr": "정말?"
  },
  "0x09D646": {
   "jp": "826ed9cd",
   "kr": "없어져 버린다?"
  },
  "0x09D65A": {
   "jp": "5469f5cc",
   "kr": "버릴 건가?"
  },
  "0x09D830": {
   "jp": "e3caec78",
   "kr": "메나트국"
  },
  "0x09D83C": {
   "jp": "501c164d",
   "kr": "챠놈국"
  },
  "0x09D848": {
   "jp": "32f12df5",
   "kr": "앰비쉬국"
  },
  "0x09D858": {
   "jp": "76f02cfe",
   "kr": "우돌국"
  },
  "0x09D862": {
   "jp": "d31e89fe",
   "kr": "올도스"
  },
  "0x09D86C": {
   "jp": "40f183d0",
   "kr": "퓨엔테국"
  },
  "0x09D87A": {
   "jp": "ae0f3412",
   "kr": "기드나국"
  },
  "0x09D884": {
   "jp": "ae3eefbf",
   "kr": "폴티아국"
  },
  "0x09D894": {
   "jp": "041d3250",
   "kr": "《샤리네에 대하여》"
  },
  "0x09D8AA": {
   "jp": "926745a7",
   "kr": "예부터 티라스일에는 샤리네라"
  },
  "0x09D8D8": {
   "jp": "71e2742f",
   "kr": "불리는 사당"
  },
  "0x09D8EE": {
   "jp": "de50d836",
   "kr": "다섯이 있다.\n물의 디네,\n땅의 테그라,"
  },
  "0x09D91C": {
   "jp": "54e2f8f5",
   "kr": "불의 이그니스,\n바람의 시플,\n그리고"
  },
  "0x09D948": {
   "jp": "5179fdab",
   "kr": "네 샤리네를 아우르는\n하늘의 올도스다."
  },
  "0x09D970": {
   "jp": "14a1dff5",
   "kr": "저마다 마법의 거울이\n놓여 라그픽 마을"
  },
  "0x09D99E": {
   "jp": "82e82c37",
   "kr": "등 일부 지역에 남은"
  },
  "0x09D9CE": {
   "jp": "80709ed5",
   "kr": "성인식 순례지다.\n마법의 거울은 오래전부터"
  },
  "0x09D9FC": {
   "jp": "51583ebb",
   "kr": "있었는데 본디 마녀와 마법사가 마법"
  },
  "0x09DA2A": {
   "jp": "cc520850",
   "kr": "전수 장소로 쓰던 듯하다."
  },
  "0x09DA3C": {
   "jp": "ca42d6c1",
   "kr": "지금은 그들의"
  },
  "0x09DA58": {
   "jp": "0959f931",
   "kr": "발길이 끊겼다.\n어째서 그들은 샤리네를"
  },
  "0x09DA8A": {
   "jp": "fab37178",
   "kr": "찾지 않게 되었을까?\n사람이 마법의 본질을"
  },
  "0x09DABA": {
   "jp": "b95ae348",
   "kr": "모른 채 그저 주문으로 쓰기 시작한 탓일까."
  },
  "0x09DADC": {
   "jp": "4d6d4520",
   "kr": "어쨌든 티라스일에 흩어진 다섯 샤리네는"
  },
  "0x09DB0E": {
   "jp": "8019eafd",
   "kr": "그들과 깊은 인연이 있음에 틀림없다."
  },
  "0x09DB3A": {
   "jp": "2b86cb2e",
   "kr": "《마녀에 얽힌 땅》"
  },
  "0x09DB50": {
   "jp": "8a54c09a",
   "kr": "티라스일 전역에서 마녀의 이름이 붙은"
  },
  "0x09DB7A": {
   "jp": "cc32f309",
   "kr": "지명은 눈에 띄는 것만 해도 세 곳이다."
  },
  "0x09DB9C": {
   "jp": "96ac7d71",
   "kr": "마녀의 바다\n마녀의 섬\n마녀의 디딤돌이다."
  },
  "0x09DBC8": {
   "jp": "5d1a83cc",
   "kr": "마녀의 바다"
  },
  "0x09DBD2": {
   "jp": "ec776609",
   "kr": "폴티아\n메나트\n챠놈\n우돌\n기드나"
  },
  "0x09DC04": {
   "jp": "f1464a8d",
   "kr": "의 해안선에 닿은 내해를 가리킨다.\n"
  },
  "0x09DC34": {
   "jp": "75a2fd82",
   "kr": "마녀 전설 상당수가 여기서 비롯했다."
  },
  "0x09DC5C": {
   "jp": "a5ff8c53",
   "kr": "마녀의 섬"
  },
  "0x09DC66": {
   "jp": "cf4b2504",
   "kr": "마녀의 바다\n어딘가에 마녀의 섬이"
  },
  "0x09DC96": {
   "jp": "36a6b7b7",
   "kr": "있다고 한다.\n거기서 살아 돌아온 이는\n"
  },
  "0x09DCC8": {
   "jp": "cb3e3118",
   "kr": "올도스 개조 올테가뿐이라 한다."
  },
  "0x09DCEC": {
   "jp": "61b0a544",
   "kr": "마녀의 디딤돌"
  },
  "0x09DCFA": {
   "jp": "e39b4c4b",
   "kr": "삼도교 가운데 섬은 마녀의 디딤돌. 놓이기"
  },
  "0x09DD2A": {
   "jp": "531a7f2f",
   "kr": "전 마녀가\n가운데 섬 딛고\n챠놈에서"
  },
  "0x09DD5A": {
   "jp": "596eb3ff",
   "kr": "앰비쉬로 건넌 데서 유래했다."
  },
  "0x09DD82": {
   "jp": "6c736408",
   "kr": "《진홍의 불꽃》"
  },
  "0x09DD98": {
   "jp": "f4a07922",
   "kr": "메나트국 네갈섬에서만 나는 보석."
  },
  "0x09DDC2": {
   "jp": "0caf4acd",
   "kr": "네갈섬 테그라 탄광 깊은 이탄"
  },
  "0x09DDEC": {
   "jp": "3ba780f3",
   "kr": "늪에서 아코야조개를 양식해 만든다."
  },
  "0x09DE06": {
   "jp": "a326d293",
   "kr": "제법 전수에 하얀마녀의 관여도 짐작된다."
  },
  "0x09DE34": {
   "jp": "6c169705",
   "kr": "값이 매우 높고 광채에"
  },
  "0x09DE66": {
   "jp": "e0d03313",
   "kr": "홀리는 이도 많다.\n다만 수확 때를 놓치면"
  },
  "0x09DE96": {
   "jp": "167b83b8",
   "kr": "폭발물로 자라는 양면성이 있다."
  },
  "0x09DEC0": {
   "jp": "0b3ae823",
   "kr": "일설에 진홍의 불꽃의\n비밀은 보석의 정화\n"
  },
  "0x09DEEA": {
   "jp": "389a4e3f",
   "kr": "작용이 보는 이의 마음을"
  },
  "0x09DF1C": {
   "jp": "048a9ad8",
   "kr": "빼앗는다고 한다."
  },
  "0x09DF4A": {
   "jp": "dfa1828f",
   "kr": "《그 밖의 메모》"
  },
  "0x09DF60": {
   "jp": "d2c5a27d",
   "kr": "여기에 적는 것은 나의 양심. 혹시"
  },
  "0x09DF7E": {
   "jp": "3f8e12e9",
   "kr": "이 수첩을 주운 사람은 보지 말고 돌려줘."
  },
  "0x09DFAC": {
   "jp": "13e8ea36",
   "kr": "빚 목록"
  },
  "0x09DFB8": {
   "jp": "6d84c076",
   "kr": "곳치"
  },
  "0x09DFC2": {
   "jp": "326907a1",
   "kr": "�1388 Pia"
  },
  "0x09DFCC": {
   "jp": "78fadccc",
   "kr": "돗치"
  },
  "0x09DFD6": {
   "jp": "465b71e6",
   "kr": "�d48 Pia"
  },
  "0x09DFE0": {
   "jp": "6f715341",
   "kr": "앗치"
  },
  "0x09DFEA": {
   "jp": "e9fee81e",
   "kr": "�11f8 Pia"
  },
  "0x09DFF4": {
   "jp": "8e1145d7",
   "kr": "갚을 마음은 있다."
  },
  "0x09E008": {
   "jp": "892377ff",
   "kr": "이 기회에\n죄책감은 생각하지 말자."
  },
  "0x09E034": {
   "jp": "77487195",
   "kr": "응. 그게 좋다."
  },
  "0x09E048": {
   "jp": "554039cc",
   "kr": "【메나트국】"
  },
  "0x09E058": {
   "jp": "da06daa6",
   "kr": "「대지가 결실을 잊을 때 산은\n"
  },
  "0x09E076": {
   "jp": "15f73eea",
   "kr": "바다를 넘고\n사람들의 탄식이 메아리친다」"
  },
  "0x09E0A4": {
   "jp": "dbbb7370",
   "kr": "』년쯤 전\n테그라 샤리네에 들른"
  },
  "0x09E0CE": {
   "jp": "c83faea2",
   "kr": "하얀마녀가 한 말이라 한다."
  },
  "0x09E0F0": {
   "jp": "981df4bd",
   "kr": "테그라 동굴에서 이탄이 난다고"
  },
  "0x09E120": {
   "jp": "26a54d93",
   "kr": "알려 준 것도 하얀마녀인 듯하다."
  },
  "0x09E150": {
   "jp": "7e401c9d",
   "kr": "섬사람은 어업에만\n기대 살았으나 이탄\n"
  },
  "0x09E180": {
   "jp": "49103c5a",
   "kr": "덕에 다른 생계도 얻게 되었다."
  },
  "0x09E1A4": {
   "jp": "389d37a3",
   "kr": "메나트에선 흉작을 마녀 저주라 하는"
  },
  "0x09E1D4": {
   "jp": "8ec316ca",
   "kr": "이도 있다.\n허나 같은 메나트 네갈섬은\n"
  },
  "0x09E204": {
   "jp": "debbe7c5",
   "kr": "이탄 채굴법을 전해 감사받는다. 수수께끼다."
  },
  "0x09E236": {
   "jp": "5840a4e2",
   "kr": "넬바에도 같은 전설이 남아 있다."
  },
  "0x09E262": {
   "jp": "8e95e121",
   "kr": "같은 일이 일어난다는 뜻일까?"
  },
  "0x09E292": {
   "jp": "c4321d02",
   "kr": "넬바에서 전설을 하나 더 찾았다.\n「재앙의"
  },
  "0x09E2BE": {
   "jp": "6be28215",
   "kr": "산이 바다에서 솟아\n도읍을 부순다」"
  },
  "0x09E2F2": {
   "jp": "372605af",
   "kr": "또한 이 하얀마녀의 말은"
  },
  "0x09E30E": {
   "jp": "548aba85",
   "kr": "앰비쉬 쪽에도 같은 것이 남아 있다."
  },
  "0x09E340": {
   "jp": "0a27414d",
   "kr": "튜엘에서 노파에게 하얀마녀의 이름을 배웠다."
  },
  "0x09E372": {
   "jp": "d3e8d02b",
   "kr": "하얀마녀의 이름이 게르드임을 알았다."
  },
  "0x09E396": {
   "jp": "2c6acd5c",
   "kr": "게르드… 얼마나 애수를 품은 울림인가."
  },
  "0x09E3C0": {
   "jp": "9e5f9eb2",
   "kr": "【챠놈국】"
  },
  "0x09E3D0": {
   "jp": "26582961",
   "kr": "다이스 근처 외딴 마을에 독 늪이 있는데,\n"
  },
  "0x09E3F4": {
   "jp": "34baaca5",
   "kr": "그 늪이 생긴 것이 하얀마녀의 저주 탓이라는"
  },
  "0x09E41E": {
   "jp": "a47510d1",
   "kr": "소문도 있다. 하얀마녀는 나쁜 마녀인가…."
  },
  "0x09E44A": {
   "jp": "57e8e450",
   "kr": "슬럼 노파에게 게르드 모습을 들었다."
  },
  "0x09E474": {
   "jp": "917313a9",
   "kr": "게르드는"
  },
  "0x09E482": {
   "jp": "406c72f2",
   "kr": "」쯤이었다고 한다."
  },
  "0x09E49A": {
   "jp": "ada54790",
   "kr": "가령"
  },
  "0x09E4A0": {
   "jp": "8b337507",
   "kr": "」세였다면\n지금은"
  },
  "0x09E4BC": {
   "jp": "86f82c11",
   "kr": "９살?"
  },
  "0x09E4C4": {
   "jp": "e5bcd915",
   "kr": "음…\n꼭 만나 보고 싶다."
  },
  "0x09E4E6": {
   "jp": "6d6b7260",
   "kr": "【앰비쉬국】"
  },
  "0x09E4FA": {
   "jp": "d90b8922",
   "kr": "칸드 마스터 마기사는 다섯 살 때 게르드를"
  },
  "0x09E528": {
   "jp": "e730d36a",
   "kr": "만나 마법의\n올바른\n사용법과 사람을\n"
  },
  "0x09E554": {
   "jp": "bc758980",
   "kr": "대하는 법, 예언을 받아들이는 법 등을"
  },
  "0x09E582": {
   "jp": "ccbe0a98",
   "kr": "배웠다고 한다. 게르드는 어느 쪽이냐"
  },
  "0x09E59C": {
   "jp": "20412851",
   "kr": "하면 챠펠 계통의 마법에 능했던 모양이다."
  },
  "0x09E5C4": {
   "jp": "457170d0",
   "kr": "앰비쉬에는"
  },
  "0x09E5D6": {
   "jp": "cca55542",
   "kr": "하얀마녀에 대해 쓰인 책이 있다."
  },
  "0x09E5FA": {
   "jp": "c30fbd7b",
   "kr": "《하얀마녀의 말》"
  },
  "0x09E60E": {
   "jp": "5ff41e2e",
   "kr": "귀찮지만\n전문을 옮겨 적는다."
  },
  "0x09E630": {
   "jp": "22a05a65",
   "kr": "그녀의 이름은 게르드. 티라스일을\n"
  },
  "0x09E662": {
   "jp": "c76926ad",
   "kr": "두루 걸으며 불길한\n말을 남기고 사라졌다."
  },
  "0x09E692": {
   "jp": "8931dcc2",
   "kr": "스무 살이 못 된 처녀는 백은빛 머리카락"
  },
  "0x09E6C2": {
   "jp": "46bf2c75",
   "kr": "탓에 어느새 하얀마녀라 불렸다."
  },
  "0x09E6EA": {
   "jp": "6be28215",
   "kr": "「재앙의 산이\n바다에서 솟아 도읍을"
  },
  "0x09E71C": {
   "jp": "779051d6",
   "kr": "부순다」\n메나트 동해안에서 앰비쉬 전역에"
  },
  "0x09E74C": {
   "jp": "69a0f202",
   "kr": "남은 게르드의 말이다. 학자들은 바다에서"
  },
  "0x09E77C": {
   "jp": "2bfdd81b",
   "kr": "나타난 산을 지진이 낳은 새 섬으로 푼다."
  },
  "0x09E7A8": {
   "jp": "10f7769c",
   "kr": "「대지가 결실을\n잊을 때 산은 바다를\n"
  },
  "0x09E7D4": {
   "jp": "806128e0",
   "kr": "넘고 탄식이 메아리친다」\n메나트 거의"
  },
  "0x09E802": {
   "jp": "c18b3ba2",
   "kr": "전역에 남은 말."
  },
  "0x09E832": {
   "jp": "2b706c53",
   "kr": "여기서도 산이 화근이나 풀이가 안 된다."
  },
  "0x09E860": {
   "jp": "48ae4fc5",
   "kr": "신비학자 중에는 달리 풀이하는 이도 있다."
  },
  "0x09E890": {
   "jp": "ddbb3870",
   "kr": "두 산은 같으며 바다에서 오는"
  },
  "0x09E8C0": {
   "jp": "93a45a94",
   "kr": "거대 생물의 습격이라 한다."
  },
  "0x09E8F0": {
   "jp": "bceecd53",
   "kr": "【우돌국】"
  },
  "0x09E8FE": {
   "jp": "1af56fc2",
   "kr": "우돌국 지방에서는 아직 하얀마녀의 메시지를"
  },
  "0x09E92C": {
   "jp": "dc3daa8d",
   "kr": "확인하지 못했다. 하지만 우돌에는 시플의"
  },
  "0x09E956": {
   "jp": "8d83be64",
   "kr": "샤리네가 있다. 분명 무언가 남겼을 것이다."
  },
  "0x09E986": {
   "jp": "70325258",
   "kr": "추가. 시플 정보."
  },
  "0x09E9A4": {
   "jp": "9a0c1bfc",
   "kr": "「미혹의 숲은 시플의 바람에 가지를 흔든다」"
  },
  "0x09E9D6": {
   "jp": "2ceb4bf8",
   "kr": "하얀마녀가 시플에서 남긴 말."
  },
  "0x09E9FE": {
   "jp": "9f9fe734",
   "kr": "【올도스】"
  },
  "0x09EA0C": {
   "jp": "5a90fd2f",
   "kr": "올도스에서는"
  },
  "0x09EA1A": {
   "jp": "109b742f",
   "kr": "하얀마녀가 말을 남기지 않은 듯하다."
  },
  "0x09EA40": {
   "jp": "2aa6d84b",
   "kr": "계속 조사가 필요하다."
  },
  "0x09EA56": {
   "jp": "5896e07f",
   "kr": "【퓨엔테국】"
  },
  "0x09EA68": {
   "jp": "8b77a68f",
   "kr": "퓨엔테국에는 하얀마녀로 보이는\n"
  },
  "0x09EA90": {
   "jp": "52d3d55f",
   "kr": "여행하는 마녀가 등장하는 기록이 있다."
  },
  "0x09EAB0": {
   "jp": "28a4783d",
   "kr": "《루피나스 호숫가에서》"
  },
  "0x09EACA": {
   "jp": "5ff41e2e",
   "kr": "귀찮지만\n전문을 옮겨 적는다."
  },
  "0x09EAEC": {
   "jp": "d2a44e11",
   "kr": "루피나스 호수 호반의 퓨엔테국은 남북"
  },
  "0x09EB18": {
   "jp": "a2beb322",
   "kr": "둘로 갈라져 있다. 북은 형인 에네톤"
  },
  "0x09EB44": {
   "jp": "e7f316bb",
   "kr": "왕, 남은 동생 캐라크가 다스린다."
  },
  "0x09EB6E": {
   "jp": "a5701a6b",
   "kr": "본래 북쪽 하이젠 성이"
  },
  "0x09EB96": {
   "jp": "ad19bed4",
   "kr": "수도였으나 쌍둥이"
  },
  "0x09EBC2": {
   "jp": "accb9617",
   "kr": "왕자가 태어나자\n홀크에도 저택을 지어"
  },
  "0x09EBEC": {
   "jp": "d874b874",
   "kr": "나라를 갈랐다.\n두 왕의 힘으로 새 나라를"
  },
  "0x09EC16": {
   "jp": "1fe24bb3",
   "kr": "세우려 한 것이다.\n떠돌이 마녀가 남긴\n"
  },
  "0x09EC44": {
   "jp": "831ead01",
   "kr": "말이 있다. 「어머니가 피를"
  },
  "0x09EC68": {
   "jp": "20d3359e",
   "kr": "가르는 것은 나라를\n가르기 위함이 아니다」"
  },
  "0x09EC9A": {
   "jp": "651e9466",
   "kr": "퓨엔테의 장래를 우려하는 말 같다."
  },
  "0x09ECC6": {
   "jp": "2d568f8c",
   "kr": "【기드나국】"
  },
  "0x09ECD4": {
   "jp": "9e3d14e2",
   "kr": "기드나는 미확인."
  },
  "0x09ECE6": {
   "jp": "967b694c",
   "kr": "계속 조사가 필요하다."
  },
  "0x09ECFE": {
   "jp": "c973e6a6",
   "kr": "【폴티아국】"
  },
  "0x09ED12": {
   "jp": "289e415c",
   "kr": "죠안나의 증언. 조부 듀르젤에게 전해 들은"
  },
  "0x09ED42": {
   "jp": "aac3731d",
   "kr": "이야기. 「표정 없는 병사들이 국경을 넘을\n"
  },
  "0x09ED6E": {
   "jp": "4a94814e",
   "kr": "때 주박에 사로잡힌 왕은 이미 힘을 잃고,\n"
  },
  "0x09ED94": {
   "jp": "4896ba37",
   "kr": "바다도 산도 이윽고\n모두 죽어 없어진다."
  },
  "0x09EDC6": {
   "jp": "3f951153",
   "kr": "이계의 여인과 별을 다루는 사내에게"
  },
  "0x09EDF6": {
   "jp": "0566d6ac",
   "kr": "재앙의 파도가 이끌리리라」 이 무슨"
  },
  "0x09EE0C": {
   "jp": "dcd3f587",
   "kr": "불길한 예언인가. 이것이 하얀마녀 게르드의"
  },
  "0x09EE34": {
   "jp": "967b694c",
   "kr": "마지막 예언이라니. 계속 조사가 필요하다."
  },
  "0x09F0B8": {
   "jp": "473aecd8",
   "kr": "이 책을 손에 든 그대는 일류 검사가 된다!"
  },
  "0x09F0E6": {
   "jp": "7a192890",
   "kr": "저자 반카 훅 4세가 말하니 틀림없다."
  },
  "0x09F118": {
   "jp": "5c977e2e",
   "kr": "아마도. 먼저 기본의 기본, 베기다."
  },
  "0x09F136": {
   "jp": "03de7306",
   "kr": "요령은 상체를 흐트러뜨리지 않고 검을"
  },
  "0x09F160": {
   "jp": "b1d7dd27",
   "kr": "내리치며 그 순간 쓰는 팔 쪽 발로"
  },
  "0x09F192": {
   "jp": "ab34b379",
   "kr": "중심을 옮기는 것. 이게 전부다."
  },
  "0x09F1C0": {
   "jp": "c7f18eac",
   "kr": "나머지는 실전에서 익히게."
  },
  "0x09F1EE": {
   "jp": "34472735",
   "kr": "제2권에서는 필살의 찌르기를 가르치지."
  },
  "0x09F21C": {
   "jp": "779bfd42",
   "kr": "그때까지 정진하게."
  },
  "0x09F24A": {
   "jp": "236935d3",
   "kr": "그럼 「검사교본"
  },
  "0x09F25C": {
   "jp": "bb19670d",
   "kr": "2」에서 다시 만나세"
  },
  "0x09F278": {
   "jp": "7c58eaae",
   "kr": "자, 이번에는 필살의 찌르기에 관해서다."
  },
  "0x09F2A0": {
   "jp": "786d218e",
   "kr": "요령은 검을 곧게 쥐고 상대의 아래에서"
  },
  "0x09F2D2": {
   "jp": "4b35f92d",
   "kr": "위로 향하듯 찌르기를 잘게 내지르는 것."
  },
  "0x09F304": {
   "jp": "c7f18eac",
   "kr": "이뿐이다. 나머지는 실전에서 요령을 잡게."
  },
  "0x09F332": {
   "jp": "aa7b46ee",
   "kr": "자, 제3권에서는 궁극의 후리기를 가르치지."
  },
  "0x09F360": {
   "jp": "779bfd42",
   "kr": "그때까지 각자 정진하게."
  },
  "0x09F38E": {
   "jp": "236935d3",
   "kr": "그럼 「검사교본"
  },
  "0x09F3A0": {
   "jp": "2ba8c353",
   "kr": "3」에서 다시 만나세"
  },
  "0x09F3BC": {
   "jp": "0823dc34",
   "kr": "자, 이번엔 궁극의 후리기다."
  },
  "0x09F3E4": {
   "jp": "69bbfb9e",
   "kr": "요령은 상대의 움직임을 잘 보고,"
  },
  "0x09F412": {
   "jp": "5eea4980",
   "kr": "상대의 검을 받아 되밀 체력을 갖추는 것."
  },
  "0x09F444": {
   "jp": "c7f18eac",
   "kr": "이게 전부다. 나머지는 실전에서 익히게."
  },
  "0x09F472": {
   "jp": "a11939a6",
   "kr": "자, 아쉽지만 이 책도 이 권으로 끝이다."
  },
  "0x09F49E": {
   "jp": "41bc5f19",
   "kr": "끝까지 읽은 그대는 이제 일류 검사다!!"
  },
  "0x09F4CC": {
   "jp": "87ca3659",
   "kr": "허나 정진을 게을리 말게."
  },
  "0x09F4F4": {
   "jp": "7c7f31f3",
   "kr": "중요한 건 실전에서 요령을 익히는 일이다."
  },
  "0x09F520": {
   "jp": "4e85d510",
   "kr": "저자 「최강이자 무적의 검사」 반카 훅 4세"
  },
  "0x09F552": {
   "jp": "0abd3a84",
   "kr": "〜두 검사〜"
  },
  "0x09F562": {
   "jp": "a028e968",
   "kr": "그녀가 왜 사피라 불리는지\n"
  },
  "0x09F586": {
   "jp": "717b98ea",
   "kr": "아는 이는 적다."
  },
  "0x09F598": {
   "jp": "bf989540",
   "kr": "눈동자가 사파이어처럼 푸르기 때문이라는"
  },
  "0x09F5BC": {
   "jp": "250cd06a",
   "kr": "이도 있고, 마음이 보석처럼 차갑기\n"
  },
  "0x09F5D0": {
   "jp": "c922a848",
   "kr": "때문이라 수군대는 이도 있다."
  },
  "0x09F5FE": {
   "jp": "d94b8a32",
   "kr": "그녀의 레이피어는 바람보다 붙잡기 어렵고\n"
  },
  "0x09F626": {
   "jp": "38b1cb59",
   "kr": "태양이 떠 있다는 사실보다 확실했다."
  },
  "0x09F644": {
   "jp": "96771e3d",
   "kr": "남자 검사들 틈에 섞여도 그녀의"
  },
  "0x09F65A": {
   "jp": "397681dc",
   "kr": "기량은 뒤떨어지기는커녕 오히려\n"
  },
  "0x09F67A": {
   "jp": "a228421b",
   "kr": "더욱 빛을 더하는 듯했다."
  },
  "0x09F696": {
   "jp": "fa666703",
   "kr": "그런 여검사 사피가 유일한"
  },
  "0x09F6AE": {
   "jp": "51e6150f",
   "kr": "호적수로 인정한 인물이 있었다."
  },
  "0x09F6CE": {
   "jp": "226badb7",
   "kr": "발하라의 검사 블러드."
  },
  "0x09F6E8": {
   "jp": "540a2b0f",
   "kr": "이 두 검사의 명성은 왕족에게까지 닿았고,\n"
  },
  "0x09F710": {
   "jp": "0d783b9d",
   "kr": "그들의 검은 두려움을 몰랐다."
  },
  "0x09F730": {
   "jp": "8f869d61",
   "kr": "서로 만나기 전까지는…."
  },
  "0x09F750": {
   "jp": "65b4ce5c",
   "kr": "〜어느 결투〜"
  },
  "0x09F75E": {
   "jp": "ad40faa6",
   "kr": "사피와 블러드의 첫 만남은"
  },
  "0x09F784": {
   "jp": "a044dec4",
   "kr": "시리도록 추운 그믐밤이었다."
  },
  "0x09F7A8": {
   "jp": "a32a3f7e",
   "kr": "사피는 톨마린 자작에게"
  },
  "0x09F7CC": {
   "jp": "c51526f1",
   "kr": "고용돼 어느 결투에 얽혔다."
  },
  "0x09F7E6": {
   "jp": "3bb6254d",
   "kr": "상대는 사교계에 소문난"
  },
  "0x09F806": {
   "jp": "7d922303",
   "kr": "히스이 남작가 장남 가네트."
  },
  "0x09F826": {
   "jp": "f326b8e0",
   "kr": "그의 행실은 도를 넘었고"
  },
  "0x09F83E": {
   "jp": "a780f660",
   "kr": "톨마린 자작은 그 모욕을"
  },
  "0x09F866": {
   "jp": "54154743",
   "kr": "삼킬 수 없었다."
  },
  "0x09F88A": {
   "jp": "ddcb0a01",
   "kr": "귀족 결투는 대리인을"
  },
  "0x09F8A2": {
   "jp": "4909bccf",
   "kr": "세우는 것이 상식이라"
  },
  "0x09F8BE": {
   "jp": "89ed635b",
   "kr": "톨마린가는 사피를,"
  },
  "0x09F8DA": {
   "jp": "3010c6f9",
   "kr": "히스이가는 블러드를 지명했다."
  },
  "0x09F8FE": {
   "jp": "0e6da33f",
   "kr": "의뢰인을 뒤에"
  },
  "0x09F91E": {
   "jp": "04c168c1",
   "kr": "두고 두 검사는 마주 섰다."
  },
  "0x09F938": {
   "jp": "8b343f10",
   "kr": "사피와 블러드에게 신호는 불필요했다."
  },
  "0x09F966": {
   "jp": "cd005534",
   "kr": "서로의 눈에 살의가 깃들자 검 뽑는"
  },
  "0x09F984": {
   "jp": "b37ed1ad",
   "kr": "소리가 달밤에 울렸다."
  },
  "0x09F9B0": {
   "jp": "3ecaa418",
   "kr": "〜흔들리는 연기〜"
  },
  "0x09F9C0": {
   "jp": "0ede3e41",
   "kr": "사피의 레이피어가 달빛을 반사하며 호를"
  },
  "0x09F9EE": {
   "jp": "6c83e910",
   "kr": "그린다. 맞서는 블러드의 커틀러스는 그 호를"
  },
  "0x09FA0A": {
   "jp": "4a2722af",
   "kr": "제압하듯 곧은 움직임을 보인다."
  },
  "0x09FA32": {
   "jp": "5552466a",
   "kr": "사피는 검을 맞대는 상대에게"
  },
  "0x09FA4E": {
   "jp": "e53ecf43",
   "kr": "처음으로 경외심을 품었다."
  },
  "0x09FA68": {
   "jp": "e23962f2",
   "kr": "실제로 그녀의 빠른 찌르기를 모조리"
  },
  "0x09FA84": {
   "jp": "ff4c7083",
   "kr": "막아 낸 것은 블러드가 처음이었다."
  },
  "0x09FAB2": {
   "jp": "864f43f4",
   "kr": "블러드 또한 그녀의 타고난 유연함에 적잖이"
  },
  "0x09FADC": {
   "jp": "d834c747",
   "kr": "놀라고 있었다. 그리고 무엇보다, 그 힘이"
  },
  "0x09FAFA": {
   "jp": "be26a73a",
   "kr": "어떤 자를 향한 증오에서 나온다는 사실에."
  },
  "0x09FB26": {
   "jp": "9a73cac3",
   "kr": "강철과 강철이 어둠 속의 별이 된다."
  },
  "0x09FB3C": {
   "jp": "6aa2c056",
   "kr": "두 사람의 가쁜 숨이"
  },
  "0x09FB54": {
   "jp": "12d49925",
   "kr": "은하의 구름으로 화한다."
  },
  "0x09FB76": {
   "jp": "02400e3d",
   "kr": "톨마린 자작은 가네트 남작에 대한 적의조차"
  },
  "0x09FB9C": {
   "jp": "a45eebe6",
   "kr": "잊고, 건장한 장년 검사에게 맞서는 작은"
  },
  "0x09FBCA": {
   "jp": "96d0f568",
   "kr": "체구 아가씨의 검놀림에 매료되어 있었다."
  },
  "0x09FBF0": {
   "jp": "94f02cb8",
   "kr": "한편 가네트 남작은 침착한"
  },
  "0x09FC1E": {
   "jp": "0fe67bc0",
   "kr": "몸짓으로 파이프를 태우고 있었다."
  },
  "0x09FC38": {
   "jp": "a35c5878",
   "kr": "그 연기의 의미를 사피와 블러드는"
  },
  "0x09FC5E": {
   "jp": "5b6e2f64",
   "kr": "알 턱이 없었다."
  },
  "0x09FC74": {
   "jp": "d8185032",
   "kr": "〜팔의 상처〜"
  },
  "0x09FC80": {
   "jp": "70a53851",
   "kr": "영원히 이어질 듯하던 두 사람의 공방은"
  },
  "0x09FCA4": {
   "jp": "6439a84f",
   "kr": "누구도 예상하지 못한 결말을 맞는다."
  },
  "0x09FCC8": {
   "jp": "441b359b",
   "kr": "사피가 특기로 삼는\n되받아치기 일격을"
  },
  "0x09FCF0": {
   "jp": "40a35e42",
   "kr": "블러드에게 날리려던 때였다."
  },
  "0x09FD1A": {
   "jp": "a4ed5054",
   "kr": "그녀의 왼팔에 격렬한 통증이 내달렸다."
  },
  "0x09FD3C": {
   "jp": "e1c2db0a",
   "kr": "블러드가 이 틈을 놓칠 리 없다."
  },
  "0x09FD60": {
   "jp": "a6ad9081",
   "kr": "그의 커틀러스는 귀를\n찢는 금속음을 내며"
  },
  "0x09FD8A": {
   "jp": "d98b99a8",
   "kr": "사피의 레이피어를 튕겨 날렸다."
  },
  "0x09FDAE": {
   "jp": "0d56f474",
   "kr": "자세가 무너진 사피에게\n"
  },
  "0x09FDC8": {
   "jp": "24f6ee83",
   "kr": "블러드의 마지막 일격이 닥친다."
  },
  "0x09FDE6": {
   "jp": "bf081c27",
   "kr": "사피는 눈꺼풀을 질끈\n감고 죽음의 칼날을"
  },
  "0x09FE14": {
   "jp": "2bec6240",
   "kr": "기다렸다. 그러나 블러드는 몸을 돌려"
  },
  "0x09FE42": {
   "jp": "cf86fb5a",
   "kr": "잡목림을 향해 커틀러스를 던졌다."
  },
  "0x09FE5A": {
   "jp": "68d363b2",
   "kr": "한순간 뒤, 둔탁한 소리와 함께"
  },
  "0x09FE88": {
   "jp": "80287067",
   "kr": "크로스보우를 든 사내가 땅에 쓰러진다."
  },
  "0x09FE9A": {
   "jp": "224dc729",
   "kr": "사피는 왼팔 깊숙이 박힌"
  },
  "0x09FEBE": {
   "jp": "e89a61aa",
   "kr": "화살을 뽑으며 일어섰다."
  },
  "0x09FEDC": {
   "jp": "05b81e97",
   "kr": "그 눈에 제삼자를\n끌어들인 가네트에 대한"
  },
  "0x09FF08": {
   "jp": "077344d2",
   "kr": "분노의 빛을 띤 채."
  },
  "0x09FF22": {
   "jp": "b81f56d2",
   "kr": "살기 어린 사피를 말린 것은 블러드였다."
  },
  "0x09FF50": {
   "jp": "27e7b97b",
   "kr": "어둠에 숨어 화살을 쏘게 한 가네트 남작은"
  },
  "0x09FF7C": {
   "jp": "7cd6745c",
   "kr": "결투의 예법을 어긴 탓에 작위를 박탈당한다."
  },
  "0x09FFA8": {
   "jp": "fd90ad55",
   "kr": "이미 검사의 소임은 끝난 것이다."
  },
  "0x09FFCE": {
   "jp": "9208776a",
   "kr": "〜회색가〜"
  },
  "0x09FFDA": {
   "jp": "cd61318b",
   "kr": "날이 밝아 오고 있었다."
  },
  "0x09FFF4": {
   "jp": "cf00b913",
   "kr": "사피는 다친 왼팔을 감싸며"
  },
  "0x0A001C": {
   "jp": "38b57325",
   "kr": "그레이타운의 좁은 골목을 걷고 있다. 왕국의"
  },
  "0x0A0042": {
   "jp": "2212876f",
   "kr": "쓰레기 하치장, 빈민굴, 막된 여자들의"
  },
  "0x0A006C": {
   "jp": "cc337886",
   "kr": "거처. 그레이타운을 정식 이름으로 부르는"
  },
  "0x0A0096": {
   "jp": "1f9deb1e",
   "kr": "이는 드물다. 그런 거리에, 사파이어라"
  },
  "0x0A00BC": {
   "jp": "ab468b9f",
   "kr": "이름을 댄 뒤로 그녀는 눌러살고 있었다."
  },
  "0x0A00D4": {
   "jp": "5bd93eb1",
   "kr": "무너져 가는 낡은 저택이 보이기 시작했다."
  },
  "0x0A00F6": {
   "jp": "9c598ff7",
   "kr": "직업도 분명치 않은 자들이 멋대로"
  },
  "0x0A0122": {
   "jp": "325685a4",
   "kr": "사는 구역. 사피가 아메지스와"
  },
  "0x0A0150": {
   "jp": "f9a2cfa5",
   "kr": "지내는 방도 거기에 있다."
  },
  "0x0A0170": {
   "jp": "ca05a5ca",
   "kr": "이곳 사람들에게 모자란 것은 약간의 금화와"
  },
  "0x0A019A": {
   "jp": "9da36791",
   "kr": "최소한의 배려뿐이다. 한 줌의 귀족"
  },
  "0x0A01C6": {
   "jp": "7effa479",
   "kr": "계급이 그들에게서 빵을 빼앗는다."
  },
  "0x0A01EC": {
   "jp": "0f9684f5",
   "kr": "빵을 위해 사람은 양심을 판다…."
  },
  "0x0A020E": {
   "jp": "9d695cbb",
   "kr": "「지금의 내게는 어울리는군….」\n사피는"
  },
  "0x0A0234": {
   "jp": "12ae38ee",
   "kr": "그런 생각과 팔의 통증에 쓴웃음을 흘렸다."
  },
  "0x0A0246": {
   "jp": "c9f0e33a",
   "kr": "솜이 삐져나온 허름한 침대가 지금은 그립게"
  },
  "0x0A0276": {
   "jp": "2e36ea04",
   "kr": "느껴진다. 이제 막 여덟 살이 된 아메지스가"
  },
  "0x0A0296": {
   "jp": "9ea9e818",
   "kr": "사피를 맞아 준다."
  },
  "0x0A02B0": {
   "jp": "d8742f4d",
   "kr": "그 티 없는 웃음을 보고\n"
  },
  "0x0A02D0": {
   "jp": "9754dd78",
   "kr": "사피는 의식이 멀어지는 것을 느꼈다."
  },
  "0x0A02F6": {
   "jp": "5f4b1f8b",
   "kr": "〜악몽〜"
  },
  "0x0A0300": {
   "jp": "e977f308",
   "kr": "촛불에 일렁이는 그림자."
  },
  "0x0A0318": {
   "jp": "0f38e7f9",
   "kr": "섬뜩하게 휜 단검의 빛."
  },
  "0x0A0332": {
   "jp": "606a7346",
   "kr": "몇 밤이고 되풀이된 악몽."
  },
  "0x0A0350": {
   "jp": "286a8a48",
   "kr": "이것은 꿈이라는 것을 그녀는 알고 있었다."
  },
  "0x0A0374": {
   "jp": "93f16a50",
   "kr": "보기 괴로운 광경에서 눈을 떼지 못한다는"
  },
  "0x0A03A2": {
   "jp": "ce6c8d8b",
   "kr": "것도. 그림자가 광기의 칼날을 치켜든다."
  },
  "0x0A03BE": {
   "jp": "4239a3e0",
   "kr": "「도망쳐!」 몇 번이고 되풀이된 말."
  },
  "0x0A03CC": {
   "jp": "3fe92667",
   "kr": "벽에 흩뿌려지는 짙붉은 핏방울."
  },
  "0x0A03EA": {
   "jp": "5086962e",
   "kr": "피의 흐름과 함께 꺼져 가는 사랑하는"
  },
  "0x0A0404": {
   "jp": "6846f7d7",
   "kr": "이의 목숨. 주검을 눈앞에 두고"
  },
  "0x0A042E": {
   "jp": "11d9e0c7",
   "kr": "멍해진 어린 날의 자신. 결투"
  },
  "0x0A045C": {
   "jp": "d8132a09",
   "kr": "뒤 블러드가 한 말이 되살아난다. 「검에"
  },
  "0x0A0484": {
   "jp": "3cdec35b",
   "kr": "품은 증오는 너 자신을 먹어 치울 것이다.」"
  },
  "0x0A04AE": {
   "jp": "0fa0ce63",
   "kr": "어린 자신이 피로 물든 검을 든 사피로"
  },
  "0x0A04DE": {
   "jp": "c7a06b0e",
   "kr": "바뀐다. 굳게 다문 입술, 묶은 갈색 머리."
  },
  "0x0A0502": {
   "jp": "0c8e0ab7",
   "kr": "그리고 보는 이를 떨게 하는"
  },
  "0x0A0532": {
   "jp": "f08c1b49",
   "kr": "차가운 푸른 눈동자. 「아니야!」"
  },
  "0x0A0540": {
   "jp": "2377168d",
   "kr": "사피는 자신의 비명으로 악몽에서 풀려났다."
  },
  "0x0A0572": {
   "jp": "642d6478",
   "kr": "〜부친의 검〜"
  },
  "0x0A057E": {
   "jp": "44f19bd6",
   "kr": "식은땀이 뺨을 타고 흘러내린다."
  },
  "0x0A0596": {
   "jp": "8ca1092e",
   "kr": "아메지스가 걱정스러운 얼굴로 사피를 바라보고"
  },
  "0x0A05C6": {
   "jp": "b471f414",
   "kr": "있다. 그녀는 결투 뒤 나흘이나 내리 잠들어"
  },
  "0x0A05EC": {
   "jp": "e8d68362",
   "kr": "있었다. 사피는 아메지스에게 미소를 보였다."
  },
  "0x0A0612": {
   "jp": "39d9281f",
   "kr": "작은 사내아이는 기특하게도 한숨도 자지"
  },
  "0x0A0638": {
   "jp": "4fc44fa8",
   "kr": "않고 그녀를 간호해 주었던 것이다."
  },
  "0x0A0654": {
   "jp": "05d298ff",
   "kr": "안심한 아메지스는 잠들기 전에"
  },
  "0x0A0676": {
   "jp": "c0e1565f",
   "kr": "사피에게 작은 가죽 주머니와 봉인된 양피지"
  },
  "0x0A0690": {
   "jp": "975c77b8",
   "kr": "두루마리를 건넸다. 그녀가 계속 잠든 사이에"
  },
  "0x0A06B4": {
   "jp": "20068dcf",
   "kr": "전해진 것이라고 한다. 가죽 주머니에는"
  },
  "0x0A06E0": {
   "jp": "96cb2a66",
   "kr": "훌륭하게 연마된 사파이어가 들어 있었다."
  },
  "0x0A0710": {
   "jp": "29ea0a2b",
   "kr": "톨마린 자작다운 멋들어진 보수다."
  },
  "0x0A0732": {
   "jp": "695147a3",
   "kr": "이어서 무심히 양피지를 펼친다."
  },
  "0x0A0750": {
   "jp": "c63f767d",
   "kr": "사피는 정성껏 적힌 글자를 좇으며 빨라지는"
  },
  "0x0A077C": {
   "jp": "9511a52e",
   "kr": "심장 박동을 누르느라 필사적이었다."
  },
  "0x0A07A0": {
   "jp": "cf3cb2d5",
   "kr": "어전 시합의 소집장. 기다리고 기다리던"
  },
  "0x0A07B4": {
   "jp": "3e3396b5",
   "kr": "때가 마침내 온 것이다. 그녀는 벽판"
  },
  "0x0A07D8": {
   "jp": "8ca2055e",
   "kr": "사이에 숨겨 두었던 검 한 자루를 꺼내"
  },
  "0x0A0808": {
   "jp": "39978959",
   "kr": "아메지스의 편안한 잠든 얼굴에 속삭였다."
  },
  "0x0A0832": {
   "jp": "8601c4ec",
   "kr": "「이 검이 모든 걸 끝내 줄 거야….」"
  },
  "0x0A0864": {
   "jp": "0161ab81",
   "kr": "〜재전의 때〜"
  },
  "0x0A0872": {
   "jp": "7b5e2166",
   "kr": "토파즈 국왕의 어전 시합에는"
  },
  "0x0A0898": {
   "jp": "05a9ed4f",
   "kr": "나라의 정예 검사들이 모였다."
  },
  "0x0A08BC": {
   "jp": "ec028152",
   "kr": "그중에서도 블러드와 사피가"
  },
  "0x0A08E8": {
   "jp": "1a5a1bcd",
   "kr": "주목받았다."
  },
  "0x0A0912": {
   "jp": "d3b42671",
   "kr": "피와 기술에 굶주린 귀족들"
  },
  "0x0A093E": {
   "jp": "ace7a323",
   "kr": "시선 속 블러드와 사피는 무릎"
  },
  "0x0A096C": {
   "jp": "629ec550",
   "kr": "꿇을 줄 몰랐고 다시 검을 맞댔다."
  },
  "0x0A098E": {
   "jp": "7a580656",
   "kr": "승자에게는 일급 검사의 칭호가 주어진다."
  },
  "0x0A09BE": {
   "jp": "d4797c10",
   "kr": "사피에게 칭호는 무가치하다."
  },
  "0x0A09EA": {
   "jp": "33b1933e",
   "kr": "블러드를 응시하며 호흡을 가다듬었다."
  },
  "0x0A0A18": {
   "jp": "fe12c1ad",
   "kr": "눈앞의 남자를 쓰러뜨리면 검사의 삶은"
  },
  "0x0A0A48": {
   "jp": "a2962230",
   "kr": "끝난다. 사피는 사브르를 뽑아 질풍"
  },
  "0x0A0A74": {
   "jp": "1866b8e0",
   "kr": "같은 공세로 블러드를 압도했다."
  },
  "0x0A0AA2": {
   "jp": "c9848504",
   "kr": "머리에 찌르기 두 번, 옆구리에"
  },
  "0x0A0ACC": {
   "jp": "cee39dd6",
   "kr": "후리기 한 번, 한 치 오차 없이."
  },
  "0x0A0AEA": {
   "jp": "dc6a53a6",
   "kr": "처음엔 밀리던 블러드가 단조로운"
  },
  "0x0A0B14": {
   "jp": "cd4d915d",
   "kr": "공격을 잇는 사피에게 반격한다."
  },
  "0x0A0B42": {
   "jp": "314bb96e",
   "kr": "사피는 틈만 보이면 같은"
  },
  "0x0A0B70": {
   "jp": "3120d330",
   "kr": "공격을 되풀이할 뿐."
  },
  "0x0A0B8A": {
   "jp": "d920415e",
   "kr": "사피는 발버둥 같은 공격을 되풀이한다."
  },
  "0x0A0BBC": {
   "jp": "b84d94f3",
   "kr": "하지만 마지막엔 손목을 틀어 머리로 쳤다."
  },
  "0x0A0BEE": {
   "jp": "810a6bb4",
   "kr": "페인트인 줄 알아도 블러드의"
  },
  "0x0A0C1C": {
   "jp": "8dbacec0",
   "kr": "몸은 길든 대로 반응하고 만다."
  },
  "0x0A0C4A": {
   "jp": "a0ffcade",
   "kr": "이마에 겨눈 사브르에"
  },
  "0x0A0C6A": {
   "jp": "52f43563",
   "kr": "블러드는 커틀러스를 던졌다."
  },
  "0x0A0C92": {
   "jp": "4fd25f13",
   "kr": "여검사가 나라의 검사를 이겼다."
  },
  "0x0A0CBA": {
   "jp": "690d30bb",
   "kr": "〜복수의 칼날〜"
  },
  "0x0A0CC8": {
   "jp": "bc645348",
   "kr": "사피는 꼼짝 않고"
  },
  "0x0A0CE2": {
   "jp": "2115c4b7",
   "kr": "토파즈 국왕이 내려오길 기다렸다."
  },
  "0x0A0D10": {
   "jp": "a34772c7",
   "kr": "「남자였다면 궁정 검사가 됐을 것을.」"
  },
  "0x0A0D3A": {
   "jp": "4b0cd564",
   "kr": "다가온 국왕이 사피의"
  },
  "0x0A0D6C": {
   "jp": "73b1acea",
   "kr": "검을 보고 중얼거렸다."
  },
  "0x0A0D84": {
   "jp": "ab956245",
   "kr": "「… 실핑…」"
  },
  "0x0A0DA4": {
   "jp": "54148f04",
   "kr": "이 명검을 쓰던 검사는"
  },
  "0x0A0DD0": {
   "jp": "d36cb5bf",
   "kr": "유능한 탓에 왕족의 비밀을"
  },
  "0x0A0DF0": {
   "jp": "f91ddf43",
   "kr": "알고 죽음을 맞았다."
  },
  "0x0A0E08": {
   "jp": "9a0d3073",
   "kr": "그 명령을 내린 이가 토파즈 국왕이다."
  },
  "0x0A0E32": {
   "jp": "c16e3e16",
   "kr": "국왕의 이변을 알고 달려오는 병사보다"
  },
  "0x0A0E5E": {
   "jp": "505bfbdd",
   "kr": "빨리 사브르 끝이 국왕의 목에 닿았다."
  },
  "0x0A0E8E": {
   "jp": "158cdbaa",
   "kr": "사피의 눈은 차갑게 타는 보석."
  },
  "0x0A0EBC": {
   "jp": "938f3b09",
   "kr": "증오로 타는 사파이어. 한 걸음이면"
  },
  "0x0A0EE0": {
   "jp": "bbf497ae",
   "kr": "아버지를 죽인 남자의 목숨을 끊는다."
  },
  "0x0A0F0C": {
   "jp": "b80f9154",
   "kr": "국왕의 늙은 눈에 제 모습을"
  },
  "0x0A0F36": {
   "jp": "0a03fb1f",
   "kr": "본 사피는 블러드의 말을 떠올렸다."
  },
  "0x0A0F5E": {
   "jp": "3cdec35b",
   "kr": "「검에 감춘 증오는 자신을 집어삼킨다」"
  },
  "0x0A0F88": {
   "jp": "47427ffb",
   "kr": "증오는 증오를 부른다."
  },
  "0x0A0FA8": {
   "jp": "4895108a",
   "kr": "사피가 싸워 온 것은 제 안에서"
  },
  "0x0A0FD2": {
   "jp": "474a1e47",
   "kr": "푸르게 타오르는 증오였다."
  },
  "0x0A0FF2": {
   "jp": "b3c0e1d4",
   "kr": "그녀는 실핑을 칼집에"
  },
  "0x0A101A": {
   "jp": "6ecc7088",
   "kr": "거두고 조용히 떠났다."
  },
  "0x0A103A": {
   "jp": "d8424d7c",
   "kr": "아무도 움직이지 못하는 가운데 눈의"
  },
  "0x0A1068": {
   "jp": "505c7256",
   "kr": "불꽃은 호수의 고요로 변해 갔다."
  },
