 },
 "event:0xab9b": {
  "t": "\\n어쨌든 말할 수 있는 건, 「이셀하사」라 불리는, 풍요로운 자연에",
  "by": "human",
  "pad": "right"
 },
 "event:0xabdb": {
  "t": "\\n축복받은 세계가 있고, 그 은혜를 받으며 살아가는",
  "by": "human",
  "pad": "right"
 },
 "event:0xac15": {
  "t": "\\n사람들이 살고 있다는 것뿐이었다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xac3f": {
  "t": "이셀하사의 거의 한복판에 자리한 론윌 섬과, 그보다",
  "by": "human",
  "pad": "right"
 },
 "event:0xac7a": {
  "t": "\\n훨씬 작은 사스아이 섬으로 이루어진 파렌 왕국은, 국토가",
  "by": "human",
  "pad": "right"
 },
 "event:0xacb8": {
  "t": "\\n좁은 탓도 있어, 이렇다 할 특산물이 없는 가난한 나라였다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xacf4": {
  "t": "\\n허나 거기 사는 사람들은 가난한 살림쯤 아랑곳하지 않고,",
  "by": "human",
  "pad": "right"
 },
 "event:0xad2e": {
  "t": "\\n마음씨 고운 아스엘 왕 아래, 평화로운 나날을 보내고 있었다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xad6d": {
  "t": "그런데 어느 밤, 예고 없는 이변이 수도 루디아를 덮쳤다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xada4": {
  "t": "\\n몬스터들이 떼 지어 성으로 쳐들어온 것이다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xadd6": {
  "t": "\\n갑작스러운 야습인 데다, 어째선지 성문 빗장이 풀려 있어,",
  "by": "human",
  "pad": "right"
 },
 "event:0xae10": {
  "t": "\\n몬스터들은 쉽사리 성 안에 침입, 병사들과 싸움이 붙는다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xae4c": {
  "t": "\\n여태 몬스터 따위 본 적도 없는 병사들은 놀라 허둥대고",
  "by": "human",
  "pad": "right"
 },
 "event:0xae86": {
  "t": "한동안 혼전이 이어진다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xae9f": {
  "t": "\\n허나 날이 밝을 무렵에는 몬스터의 기세가 꺾이기 시작해, 마침내",
  "by": "human",
  "pad": "right"
 },
 "event:0xaedf": {
  "t": "쫓겨나고 만다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xaef4": {
  "t": "\\n큰 위기를 벗어나 사람들은 환호하지만, 그것도 곧 가라앉고 만다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xaf38": {
  "t": "\\n국왕 아스엘이 몬스터에게 살해되었다고 전해졌기 때문이다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xaf79": {
  "t": "이때, 세자인 세리오스 왕자는 겨우 6살.",
  "by": "human",
  "pad": "right"
 },
 "event:0xafa6": {
  "t": "\\n단 한 사람, 아스엘 왕의 임종을 지켰다는 측근 아크담은,",
  "by": "human",
  "pad": "right"
 },
 "event:0xafe4": {
  "t": "\\n왕에게서 섭정을 명받았다며, 세리오스 왕자가 16살 생일에",
  "by": "human",
  "pad": "right"
 },
 "event:0xb022": {
  "t": "\\n왕위를 이을 때까지 파렌의 정무를 맡겠다고 선언한다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xb05c": {
  "t": "그리고 왕자는 왕위를 이을 때까지 사스아이 섬 엘아스타 마을에서",
  "by": "human",
  "pad": "right"
 },
 "event:0xb09b": {
  "t": "\\n자라게 되었다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xb0b7": {
  "t": "　　　　　　그로부터 약 10년의 세월이 흘렀다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xb496": {
  "t": "인간들은 다른 생명을 죽이고 제 세상인 양 세계를 지배하며,",
  "by": "human",
  "pad": "right"
 },
 "event:0xb4d4": {
  "t": "\\n하늘과 바다를 더럽히고, 세계를 부수어 간다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xb50f": {
  "t": "인간이야말로, 세계에 어둠을 불러와, 멸망시키는",
  "by": "human",
  "pad": "right"
 },
 "event:0xb5a8": {
  "t": "나를 쓰러뜨리다니 ",
  "by": "human",
  "pad": "right"
 },
 "event:0xb613": {
  "t": "이제 한 번 더, 너희에게 미래를 맡기마.",
  "by": "human",
  "pad": "right"
 },
 "event:0xb6fe": {
  "t": "「무슨 일이야, 왕자님.」",
  "by": "human",
  "pad": "right"
 },
 "event:0xb7b8": {
  "t": "「인간이 참된 파괴자라고 ",
  "by": "human",
  "pad": "right"
 },
 "event:0xb9f8": {
  "t": "「인생이란 긴 여행이 ",
  "by": "human",
  "pad": "right"
 },
 "event:0xba97": {
  "t": " 영웅의 전설",
  "by": "human",
  "pad": "right"
 },
 "event:0xb546": {
  "t": "참된 파괴자다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xb55c": {
  "t": "인간들을 멸하고, 세계를 정화해, 멸망에서 지키는 것이 내 소임",
  "by": "human",
  "pad": "right"
 },
 "event:0xb5cd": {
  "t": "아직 희망은 있다는 뜻인가 ",
  "by": "human",
  "pad": "right"
 },
 "event:0xb5f6": {
  "t": "젊은이들이여, 들으라.",
  "by": "human",
  "pad": "right"
 },
 "event:0xb657": {
  "t": "같은 잘못을 되풀이하지 않도록,",
  "by": "human",
  "pad": "right"
 },
 "event:0xb689": {
  "t": "역사가 되풀이되지 않도록,",
  "by": "human",
  "pad": "right"
 },
 "event:0xb6b3": {
  "t": "그리고,",
  "by": "human",
  "pad": "right"
 },
 "event:0xb6c2": {
  "t": "세계가 다시 나를 필요로 하지 않도록 ",
  "by": "human",
  "pad": "right"
 },
 "event:0xb717": {
  "t": "\\n세리오스「우리가 한 일은 정말 옳았던 걸까?」",
  "by": "human",
  "pad": "right"
 },
 "event:0xb760": {
  "t": "「아그니쟈는 세계를 지키려고 인간을 멸한다고",
  "by": "human",
  "pad": "right"
 },
 "event:0xb79f": {
  "t": "말했어.」",
  "by": "human",
  "pad": "right"
 },
 "event:0xb7e6": {
  "t": "「그렇다면 우리가 한 일은 ",
  "by": "human",
  "pad": "right"
 },
 "event:0xb813": {
  "t": "류난「허나, 아그니쟈는 우리에게 이 세계의 미래를",
  "by": "human",
  "pad": "right"
 },
 "event:0xb855": {
  "t": "맡긴다고도 했습니다.」",
  "by": "human",
  "pad": "right"
 },
 "event:0xb87c": {
  "t": "「앞으로 우리, 아니 모든 인간의 행동이 세계를",
  "by": "human",
  "pad": "right"
 },
 "event:0xb8ba": {
  "t": "구할 수 있을지에 달려 있는 것입니다.」",
  "by": "human",
  "pad": "right"
 },
 "event:0xb8eb": {
  "t": "「아그니쟈는 세계의, 아니, 자연의 위기를 알리려",
  "by": "human",
  "pad": "right"
 },
 "event:0xb92a": {
  "t": "우리 앞에 나타난 것인지도 모르겠네.」",
  "by": "human",
  "pad": "right"
 },
 "event:0xb95e": {
  "t": "게일  「끙끙 앓아 봐야 아무것도 시작 안 돼.」",
  "by": "human",
  "pad": "right"
 },
 "event:0xb997": {
  "t": "류난「게일의 말이 맞습니다.",
  "by": "human",
  "pad": "right"
 },
 "event:0xb9c4": {
  "t": "우리 여행은 이제 막 시작된 것입니다.」",
  "by": "human",
  "pad": "right"
 },
 "event:0xba17": {
  "t": "세리오스「좋아, 다들에게로 돌아가자.",
  "by": "human",
  "pad": "right"
 },
 "event:0xba4b": {
  "t": "어머니와 디나 공주가 기다려.」",
  "by": "human",
  "pad": "right"
 },
 "event:0xba79": {
  "t": "「어허, 말은 잘하는군.」",
  "by": "human",
  "pad": "right"
 },
 "event:0xbaa7": {
  "t": "  제작 저작",
  "by": "human",
  "pad": "right"
 },
