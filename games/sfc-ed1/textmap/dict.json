 "D5:00": {
  "jp_len": 10,
  "kr": "보물상자를 열었다.",
  "state": "draft"
 },
 "D5:01": {
  "jp_len": 10,
  "kr": "보물상자 안에는",
  "state": "draft"
 },
 "D5:02": {
  "jp_len": 9,
  "kr": "들어 있었습니다.",
  "state": "draft"
 },
 "D5:03": {
  "jp_len": 8,
  "kr": "어서 오십시오",
  "state": "draft"
 },
 "D5:04": {
  "jp_len": 11,
  "kr": "여기는 도구점입니다만",
  "state": "draft"
 },
 "D5:05": {
  "jp_len": 11,
  "kr": "어떤 볼일이신가요?",
  "state": "draft",
  "note": "원문 「どんな ごようですか?」를 따른다 — PS1 의 「어떤 볼일이신지요?」는 그 맵의 원문(왕자를 맞는 자리)이라 등급이 한 칸 높다"
 },
 "D5:06": {
  "jp_len": 11,
  "kr": "또 오세요.",
  "state": "draft"
 },
 "D5:07": {
  "jp_len": 16,
  "kr": "무기와 방어구 가게입니다만",
  "state": "draft",
  "note": "칸 제약 — 사전 문자열 버퍼($174C, 30B)에 맞추려고 「여기는」을 뺐다(deviations.md)"
 },
 "D5:08": {
  "jp_len": 10,
  "kr": "이런? 더는",
  "state": "draft"
 },
 "D5:09": {
  "jp_len": 10,
  "kr": "지니실 수 없겠군요.",
  "state": "draft",
  "note": "持てない = 더 못 지닌다(소지 한도)"
 },
 "D5:0A": {
  "jp_len": 13,
  "kr": "어느 것을 사시겠습니까?",
  "state": "draft"
 },
