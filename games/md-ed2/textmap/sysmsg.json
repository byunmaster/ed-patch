 "0327ca": {
  "jp": "9c49f640b4",
  "ours": "<1e>병사<04>\n아, 왕자님, 무기고에 무슨\n볼일이시옵니까?<07>"
 },
 "032802": {
  "jp": "3a0ec78268",
  "ours": "<08>무엇을 맡기시겠습니까?<07>",
  "src": "canon:ed2"
 },
 "03281e": {
  "jp": "94569ce6de",
  "ours": "<08>무엇을 꺼내시겠습니까?<07>",
  "src": "canon:ed2"
 },
 "032838": {
  "jp": "91de36557a",
  "ours": "<08>또 볼일이 있으시면\n언제든 오십시오.<00>",
  "src": "ours:ed2-manual"
 },
 "032870": {
  "jp": "fdbd7c5348",
  "ours": "<08>왕자님, 죄송합니다만\n더 이상은 맡을 수 없습니다.<05><06>",
  "src": "ours:ed2-manual"
 },
 "0328aa": {
  "jp": "969fd2f098",
  "ours": "<08>왕자님, 더는 소지품을\n가지실 수 없는 듯합니다만…<05><06>",
  "src": "ours:ed2-manual"
 },
 "0328e6": {
  "jp": "67f3eb3f0c",
  "ours": "<08>왕자님께서 맡기신 물건은\n아무것도 없습니다.<05><06>",
  "src": "ours:ed2-manual"
 },
 "03291e": {
  "jp": "479a2abf34",
  "ours": "<08>왕자님, 맡아 둔 물건은\n더 없습니다.<05><06>",
  "src": "ours:ed2-manual"
 },
 "032b90": {
  "jp": "6ac9e41773",
  "ours": "<1e>마르크<04>\n나는 주문을 파는 마을을\n알려 주는 안내인 같은 것일세.<05><06>"
 },
 "032bd8": {
  "jp": "a1ff926890",
  "ours": "어느 주문이 궁금한 게냐?<07>",
  "src": "ours:ed2-manual"
 },
 "032bfa": {
  "jp": "5ee5c5751e",
  "ours": "<08><0e>…\n그거라면 <06>",
  "src": "ours:ed2-manual"
 },
 "032c14": {
  "jp": "eab3ecab5f",
  "ours": "에 가면\n팔고 있느니라.<05><06>",
  "src": "ours:ed2-manual"
 },
 "032c2c": {
  "jp": "e779d5826f",
  "ours": "<08>주문이 있는 곳을 알고 싶거든\n또 찾아오너라.<00>",
  "src": "ours:ed2-manual"
 },
 "03331a": {
  "jp": "5518e88259",
  "ours": "<1e>디임<04>\n어느 주문책이 필요한가?<07>"
 },
 "033342": {
  "jp": "eea3607edf",
  "ours": "필요 없다는 게냐.\n그렇다면 필요할 때 오너라.<00>",
  "src": "ours:ed2-manual"
 },
 "033372": {
  "jp": "a5a6266982",
  "ours": "<0e>… 그걸로 되겠느냐?<00>",
  "src": "ours:ed2-manual"
 },
 "033384": {
  "jp": "2d5105d27b",
  "ours": "더는 가질 수 없다네.\n소지품을 줄이고 오게나.<00>",
  "src": "ours:ed2-manual"
 },
 "035c58": {
  "jp": "10cc70c376",
  "ours": "<1e>세리오스<1f>\n다툼은 언제나\n사소한 어긋남에서 비롯된다.<07>"
 },
 "035c90": {
  "jp": "621e18e2eb",
  "ours": "<08>아트라스, 명심해 두어라.<06>"
 },
 "035cb0": {
  "jp": "4b898acc1f",
  "ours": "<1e>플로라<1f>\n저기, 아트라스님.<07>"
 },
 "035cd0": {
  "jp": "0b1d2e31ca",
  "ours": "<08>드레이크 씨도 프래드 씨도\n사실은 좋은 분들인데\n어째서 그렇게 슬픈 일이\n일어난 걸까요.<07>"
 },
 "035d3c": {
  "jp": "60143cc82e",
  "ours": "<08><1e>아트라스<1f>\n아마 아무도 나쁜 게 아닐 거야.<07>"
 },
 "035d6a": {
  "jp": "132f105e2a",
  "ours": "<08>어쩌면 나도 같은 일을\n했을지도 몰라.\n다만 모두가 조금씩 서로\n오해했을 뿐이야.<07>"
 },
 "035dd8": {
  "jp": "5819690ea2",
  "ours": "<08>그것뿐이야.<07>"
 },
 "035df6": {
  "jp": "4a21861c7e",
