 "streams": {
  "04cc": {
   "jp": "b482a78bec",
   "ours": "<1e>남자<04><01>왕자님, 용의 알은 불길한 물건인 걸까요? 모처럼 기뻐하고 있었는데…<00>",
   "src": "ps1-exact"
  },
  "0522": {
   "jp": "bd9811ad0b",
   "ours": "<1e>남자<04><01>이렇게 될 거였다면 용의 알 같은 건 나오지 않는 편이 좋았을 겁니다.<00>",
   "src": "ps1-exact"
  },
  "0572": {
   "jp": "bc39873b15",
   "ours": "<1e>남자<04><120015><0f:05cb>",
   "src": "ps1-exact"
  },
  "057d": {
   "jp": "9fa520d79f",
   "ours": "앗 왕자님, 몬스터가 크루즈 마을을 덮쳐서 무너뜨려 버렸답니다.<00>",
   "src": "ps1-exact"
  },
  "05cb": {
   "jp": "926d37cb0d",
   "ours": ""
  },
  "05d1": {
   "jp": "c8a783159f",
   "ours": "앗 왕자님, 몬스터 수가 점점 늘고 흉포해졌다고 하더군요.<00>",
   "src": "ours:ed2-manual"
  },
  "061d": {
   "jp": "49dffdfa98",
   "ours": "몬스터가 늘었나 싶더니 이번엔 갑자기 사라지다니. 이건 대체 무슨 일일까요?<00>",
   "src": "ours:ed2-manual"
  },
  "0680": {
   "jp": "8abe3ba974",
   "ours": "<1e>남자<04><01>왕자님, 무기점 스코트는<120015><0f:0718>",
   "src": "ps1-exact"
  },
  "06a8": {
   "jp": "32b7b9e279",
   "ours": "지진이 일어난 뒤로 계속 누워만 있어요.\f만약 몬스터가 덮치면 어쩔 셈인지 모르겠네요.<00>",
   "src": "ours:ed2-manual"
  },
  "0718": {
   "jp": "346e86c43a",
   "ours": "무기점은 그만두고 생선 가게를 시작하겠다고 하더라고요.<00>",
   "src": "ours:ed2-manual"
  },
  "0750": {
   "jp": "e5742fefb1",
   "ours": "<1e>남자<04><120015><0f:07b2>",
   "src": "ps1-exact"
  },
  "075b": {
   "jp": "b549c275f6",
   "ours": "아무리 몬스터가 나와도 세리오스 님이 계시면 분명 해치워 주실 겁니다.<00>",
   "src": "ps1-exact"
  },
  "07b2": {
   "jp": "147119d5df",
   "ours": ""
  },
  "07b8": {
   "jp": "89d0634011",
   "ours": "모레스톤과 솔디스에서는 몬스터가 사라졌다고 들었는데 정말일까요?<00>",
   "src": "ours:ed2-manual"
  },
  "080f": {
   "jp": "1d4b115308",
   "ours": "파렌의 몬스터는 사라졌지만 온리크 쪽은 어떻게 되어 있을까요?<00>",
   "src": "ours:ed2-manual"
  },
  "086a": {
   "jp": "5f4091730d",
   "ours": "<1e>여자<04><120015><0f:08da>",
   "src": "ps1-exact"
  },
  "0875": {
   "jp": "4078d313cd",
   "ours": "크루즈가 짓밟혔다더군요. 이곳에도 몇 명 피난 왔는데 용케 다치지 않았어요.<00>",
   "src": "ps1-exact"
  },
  "08da": {
   "jp": "1edca955f8",
   "ours": ""
  },
  "08e0": {
   "jp": "3d80361e9b",
   "ours": "이대로 몬스터가 늘어나면 이 마을도 크루즈처럼 무너지고 말까요?<00>",
   "src": "ours:ed2-manual"
  },
  "0932": {
   "jp": "44a3355584",
   "ours": "그대로 몬스터가 계속 늘면 어떻게 되나 걱정하고 있었어요. 다행이에요.<00>",
   "src": "ours:ed2-manual"
  },
  "0984": {
   "jp": "705e5e6f86",
   "ours": "<1e>여자<04><01>용의 알이 나온 건 좋은 일의 전조라고 생각했는데, 어쩌다 이런 일이 벌어졌을까…<00>",
   "src": "ps1-exact"
  },
  "09ee": {
   "jp": "a73f4e4950",
   "ours": "<1e>노인<04><01>아론 어르신은 크루즈 마을이 짓밟혀 버려서 완전히 기가 꺾이셨습니다.<00>",
   "src": "ps1-exact"
  },
  "0a46": {
   "jp": "f46ed02e59",
   "ours": "<1e>병사<04><120015><0f:0ae5>",
   "src": "ps1-exact"
  },
  "0a53": {
   "jp": "1807505389",
   "ours": "몬스터가 나타났다는데도 어째서인지 국민에게서 위기감이 느껴지지 않습니다.\f세리오스 님이 어떻게든 해 주실 거라 믿어서일까요?<00>",
   "src": "ours:ed2-manual"
  },
  "0ae5": {
   "jp": "0fcd39bd11",
   "ours": "왕자님, 루디아는 안심하시옵소서.<1100f0><0f:0b36>",
   "src": "ps1-exact"
  },
  "0b16": {
   "jp": "680e78413e",
   "ours": "저희가 반드시 지켜 내겠습니다.<00>",
   "src": "ours:ed2-manual"
  },
  "0b36": {
   "jp": "6251c06199",
   "ours": "\f그놈들이 언제 또 나타나도 좋도록 준비하고 있으니까요.<00>",
   "src": "ours:ed2-manual"
  },
  "0b78": {
   "jp": "bb85070441",
   "ours": "<1e>병사<04><120015><0f:0bd8>",
   "src": "ps1-exact"
  },
  "0b85": {
   "jp": "ff1794c2d0",
   "ours": "왕자님, 안심하시옵소서. 혹여 몬스터가 온다면 저희가 해치우겠습니다.<00>",
   "src": "ps1-exact"
  },
  "0bd8": {
   "jp": "5bebf1573d",
   "ours": ""
  },
  "0bde": {
   "jp": "f2461160ca",
   "ours": "아무리 몬스터가 많아져도 이 마을에는 한 마리도 들이지 않겠습니다. 안심하십시오.<00>",
   "src": "ours:ed2-manual"
  },
  "0c31": {
   "jp": "604ed2ca98",
   "ours": "왕자님, 안심하시옵소서. 혹여 또 몬스터가 나타나도 저희가 해치우겠습니다.<00>",
   "src": "ours:ed2-manual"
  },
  "0c90": {
   "jp": "24b5fd2374",
   "ours": "<1e>스코트<04><01>앗, 왕자님. 지진이 났을 때 집에 있던 무기가 저를 향해 떨어졌습니다.\f지금도 무기를 보면 몸이 떨리는 것이 멈추질 않습니다.<120015><0f:0d2c>",
   "src": "ps1-exact"
  },
  "0d2b": {
   "jp": "5ba93c9db0",
   "ours": ""
  },
  "0d2c": {
   "jp": "5c74a39966",
   "ours": "\f그래서 이제 무기점은 그만두고 생선 가게나 시작할까 합니다.<00>",
   "src": "ours:ed2-manual"
  },
  "0d70": {
   "jp": "2927e8a9b9",
   "ours": "<1e>아론<04><01>오오, 아트라스님. 제 추억의 장소인 크루즈가 무너져 버렸사옵니다.\f모처럼 그곳에서 느긋하게 살고 있었는데…<00>",
   "src": "ps1-exact"
  },
  "0e02": {
   "jp": "d8c283689c",
   "ours": "<1e>여자<04><120015><0f:0eaa>",
   "src": "ps1-exact"
  },
  "0e0d": {
   "jp": "54439a153a",
   "ours": "몬스터가 쳐들어왔을 때 마을에는 저와 아론 씨밖에 없었어요. 다른 남자들은 광산을 도우러 가 있었거든요.\f그래서 그 끔찍한 일을 겪은 건 우리 둘뿐이에요.<00>",
   "src": "ours:ed2-manual"
  },
  "0eaa": {
   "jp": "9bb80d8342",
   "ours": "이 마을도 크루즈처럼<1100f0><0f:0ee4>",
   "src": "ours:ed2-manual"
  },
  "0ec8": {
   "jp": "71c7fd63d1",
   "ours": "되지 않으면 좋으련만.<00>",
   "src": "ours:ed2-manual"
  },
  "0ee4": {
   "jp": "80565e98ac",
   "ours": "되지 않아서 다행이에요.<00>",
   "src": "ours:ed2-manual"
  },
  "0efc": {
   "jp": "c4fe952a1f",
   "ours": "<1e>바텐더<04><01>아, 왕자님, 어서 오십시오. 술은 내어 드릴 수 없지만 편히 쉬었다 가십시오.<00>",
   "src": "ps1-exact"
  },
  "0f60": {
   "jp": "2c26c18857",
   "ours": "<1e>도구점<04><01>어라 왕자님, 어서 오십시오. 무슨 일로 오셨나요?<07>",
   "src": "ps1-exact"
  },
  "0fa4": {
   "jp": "aa0e4b4250",
   "ours": "또 오세요.<00>",
   "src": "ps1-exact"
  },
  "0420": {
   "jp": "063ca88a93",
   "ours": ""
  },
  "0472": {
   "jp": "53f58d93f9",
   "ours": ""
  },
  "0fc0": {
   "jp": "7f1cf1d5cf",
   "ours": "어라? 더 이상 못 들 것 같군요.\f<06>",
   "src": "ps1-exact"
  },
  "0fe6": {
   "jp": "b324606d0b",
