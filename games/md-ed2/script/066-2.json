  },
  "0b13": {
   "jp": "af57eacbdb",
   "ours": "<0b><1b><0b><36><0b><62><0b><74>어느 걸 파시겠습니까?<07>",
   "src": "ours:ed2-manual"
  },
  "0b3b": {
