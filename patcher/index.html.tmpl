<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>영웅전설 II 만트라 DOS판 복원 패치</title>
<meta name="description" content="만트라 DOS 이식판의 이벤트 버그를 고치는 브라우저 패처. 파일은 업로드되지 않습니다.">
<!-- 3.5" 디스켓 파비콘. data URI 라 외부 요청이 생기지 않는다(브라우저의 favicon.ico 자동 조회도 막는다) -->
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' shape-rendering='crispEdges'%3E%3Crect width='16' height='16' fill='%23000'/%3E%3Crect x='1' y='1' width='14' height='14' fill='%23484858'/%3E%3Crect x='4' y='1' width='8' height='5' fill='%23c8c8d8'/%3E%3Crect x='9' y='2' width='3' height='4' fill='%23000'/%3E%3Crect x='3' y='8' width='10' height='7' fill='%23fff'/%3E%3Crect x='4' y='10' width='8' height='1' fill='%23888'/%3E%3Crect x='4' y='12' width='6' height='1' fill='%23888'/%3E%3C/svg%3E">
<style>
@FONTS@
  /* ── 픽셀 스타일 ────────────────────────────────────────────────────────────
     그라데이션·블러·둥근 모서리·그림자를 쓰지 않는다. 면은 단색이고 형태는
     굵은 검정 테두리로만 낸다. 크기·간격은 4px 그리드에 맞춘다. */
  :root {
    --bg:#ffffff;
    --ink:#000000;          /* 모든 외곽선 */
    --paper:#f8f8f0;        /* 종이 */
    --case:#c8c4b0;         /* 케이스 면 */
    --case-l:#e0dcc8;       /* 케이스 밝은 면(윗면 하이라이트) */
    --case-d:#908c78;       /* 케이스 어두운 면 */
    --steel:#b8bcc8;        /* 디스켓 셔터 */
    --disk:#484858;         /* 디스켓 몸체 */
    --scr:#101010;          /* CRT 유리 */

    --gray:#d8d8d0; --white:#ffffff; --green:#54fc54; --red:#fc5454;
    --yellow:#fcfc54; --cyan:#54fcfc;
    --grn-d:#00a800;        /* 케이스 위 초록(모델명·LED) */
    --red-d:#d82800;
    /* 갈무리 — 한글 픽셀 폰트. 서브셋에 없는 글자만 뒤 폰트로 떨어진다.
       픽셀 폰트는 고유 격자의 정수배로만 써야 획이 안 뭉개진다:
         --sans  갈무리9  → 18px (2×9)   본문
         --title 갈무리11 → 33px (3×11)  제목
         --mono  갈무리모노11 → 22px (2×11)  CRT
       본문 크기를 22px 에서 한 단계 낮추려니 11px 격자로는 11px 밖에 없어서
       (너무 작다) 본문만 9px 격자 폰트로 갈아 끼웠다. */
    --mono: "GalmuriMono11", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    /* 22px 과 11px 사이 단계가 필요할 때 — 9px 격자라 18px 로 쓴다 */
    --mono9: "GalmuriMono9", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    --sans: "Galmuri9", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR",
            system-ui, sans-serif;
    --title: "Galmuri11", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR",
             system-ui, sans-serif;
  }
  * { box-sizing:border-box; }
  html,body { margin:0; }
  body {
    min-height:100dvh;
    background:var(--bg); color:var(--gray);
    font:11px/1.6 var(--mono);
    padding:20px 16px; display:flex; flex-direction:column; align-items:center;
    -webkit-font-smoothing:none; font-smooth:never;
    /* 픽셀 폰트가 서브픽셀 보정으로 흐려지지 않게 */
    text-rendering:geometricPrecision;
  }
  /* 헤더(안내) - 본체(장비) - 푸터(고지).
     height 로 창에 가두면 안 된다. 장비는 4:3 을 지키려고 크기가 고정이라 줄어들
     수가 없고, 글상자(안내 250 + 고지 200)만으로도 이미 450px 을 먹는다. 가두면
     장비가 갈 곳이 없어 헤더 위로 삐져나온다.
     min-height 로 두면 넉넉할 때는 장비가 바닥에 붙고, 모자라면 페이지가 그냥
     스크롤된다 — 겹쳐서 안 보이는 것보다 낫다. */
  .layout { width:min(1000px,100%); min-height:calc(100dvh - 40px);
            display:flex; flex-direction:column; }
  .layout > .notice { flex:0 0 auto; }
  /* min-height:0 을 주면 안 된다 — 장비는 4:3 고정이라 줄어들 수가 없어서, 줄일
     여지를 열어 두면 상자만 작아지고 장비가 헤더 위로 삐져나온다. */
  /* 기본은 '장비 + 말풍선' 묶음을 가운데 둔다(좁은 창에서 말풍선이 안 잘리게). */
  .scene { --glass:440px; flex:1 1 auto;
           display:flex; align-items:center; justify-content:center; }
  /* 장비 + 디스켓 묶음. 바닥 정렬이라 디스켓이 본체(타워) 옆에 온다.
     묶음째로 .scene 한가운데 놓이므로 세로 여백이 위아래 같아진다. */
  .group { display:flex; align-items:flex-end; gap:44px; }

  .notice {
    width:100%; background:transparent; color:var(--ink);
    border:4px solid var(--ink); padding:16px 20px 14px; font-family:var(--sans);
  }
  .notice.top { margin:0 0 20px; }
  .notice.legal { margin:20px 0 0; }
  /* 제목만 33px, 나머지 글은 전부 18px 로 통일한다. 케이스에 인쇄된 글자
     (디스켓 라벨·모델명)만 예외인데, 그건 문서가 아니라 그림의 일부이고
     라벨 폭이 90px 라 18px 가 물리적으로 안 들어간다. */
  .notice h1 { font-family:var(--title); font-size:33px; font-weight:700;
               letter-spacing:0; margin:0 0 14px; line-height:1.3; }
  .notice h2 { font-size:18px; font-weight:700; letter-spacing:0; margin:0 0 10px; }
  .notice p { margin:0 0 8px; font-size:18px; font-weight:400; line-height:1.55; word-break:keep-all; }
  .notice p:last-child { margin-bottom:0; }
  .notice .k { font-weight:700; color:#b02800; }
  .notice .step { font-weight:700; }
  .notice.legal { padding:14px 20px 12px; }
  /* 접이식 — 넓은 창에서는 늘 펼쳐 두고 손잡이 표시도 숨긴다. 좁은 창에서만
     접힌다. 모바일에선 패처가 아예 못 도는데(File System Access 부재) 이 문단들은
     패치 절차 설명이라 지금 쓸 수 없는 내용이다. 접어 두는 편이 낫다. */
  .fold > summary { list-style:none; cursor:default; }
  .fold > summary::-webkit-details-marker { display:none; }
  .fold > summary h2 { display:inline; }
  .fold-only { display:none; }
  @media (max-width:880px) {
    .fold > summary { cursor:pointer; font-size:18px; font-weight:700;
                      padding:2px 0; user-select:none; }
    .fold-only { display:list-item; }
    .fold > summary::after { content:" ▼"; }
    .fold:not([open]) > summary::after { content:" ▶"; }
    .fold[open] > summary { margin-bottom:8px; }
  }

  /* 고지 제목만 본문(18)과 헤더 제목(33) 사이 단계로. 22 = 2×11 이라 갈무리11 */
  .notice.legal h2 { font-family:var(--title); font-size:22px; margin:0 0 10px; }

  /* ── 모니터 ── */
  /* 화면 유리를 정확히 4:3 으로 고정한다. 예전처럼 높이만 줄이면 폭은 그대로라
     납작해져서 비율이 깨졌다. 그래서 크기를 고정하고, 창이 낮으면 아래 높이별
     미디어쿼리가 폭과 높이를 4:3 인 채로 같이 줄인다.
       --glass = 유리 폭. 유리 높이는 그 3/4. 모니터 케이스 = 유리 + 32px.
     본체는 모니터보다 넓다 — 실물 데스크탑이 그렇고, 드라이브 베이 자리도 는다. */
  .rig-body { width:calc(var(--glass) + 112px); max-width:100%;
              display:flex; flex-direction:column; align-items:center; }
  .monitor {
    flex:0 0 auto; width:calc(var(--glass) + 32px);
    display:flex; flex-direction:column;
    background:var(--case); border:4px solid var(--ink);
    padding:12px 12px 16px;
  }
  .screen { flex:0 0 auto; height:calc(var(--glass) * 3 / 4);
            background:var(--scr); border:4px solid var(--ink); padding:10px 12px;
            position:relative; overflow:hidden; }
  .screen::after {   /* 주사선 */
    content:""; position:absolute; inset:0; pointer-events:none; z-index:4;
    background:repeating-linear-gradient(#0000 0 2px, #00000066 2px 4px);
  }
  #crt {
    height:100%; overflow-y:auto; overscroll-behavior:contain;
    font-size:22px; line-height:1.45; white-space:pre-wrap; word-break:break-word;
  }
  .off #crt { visibility:hidden; }
  #crt::-webkit-scrollbar { width:6px; }
  #crt::-webkit-scrollbar-thumb { background:#ffffff30; }
  .l-dim{color:#b4b4ac} .l-ok{color:var(--green)} .l-err{color:var(--red)}
  .l-warn{color:var(--yellow)} .l-hi{color:var(--white)} .l-key{color:var(--cyan)}
  .anykey { color:var(--white); }
  .cursor { display:inline-block; width:.55em; height:1em; vertical-align:-.15em;
            background:var(--gray); animation:blink 1s step-end infinite; }
  @keyframes blink { 50% { opacity:0; } }

  /* CRT 켜짐/꺼짐 — 세로로 접혔다 점으로 수축 */
  /* 지원하지 않는 브라우저 — 화면을 블루스크린으로 덮는다 */
  .bsod {
    position:absolute; inset:0; z-index:6; background:#0000aa; color:#fff;
    font-family:var(--mono); font-size:11px; line-height:1.9;
    padding:10% 8%; display:flex; flex-direction:column; align-items:center;
    justify-content:center; text-align:center; word-break:keep-all;
  }
  .bsod[hidden] { display:none; }
  .bsod b { background:#fff; color:#0000aa; font-weight:400; padding:0 10px; margin-bottom:1.6em; }
  .bsod p { margin:0 0 1.1em; }
  .bsod ul { margin:0 0 1.4em; padding:0; list-style:none; text-align:left; }
  .bsod li { margin:0 0 .3em; }
  .bsod .blink { animation:blink 1s step-end infinite; }

  .crt-fx { position:absolute; inset:0; z-index:5; pointer-events:none; transform-origin:center; opacity:0; }
  .crt-fx.off { background:#e8f8e8; animation:crtOff .3s steps(4) forwards; }
  .crt-fx.on  { background:#e8f8e8; animation:crtOn .3s steps(4) forwards; }
  @keyframes crtOff {
    0%{transform:scale(1,1);opacity:1} 50%{transform:scale(1,.06);opacity:1}
    99%{transform:scale(.04,.06);opacity:1} 100%{opacity:0}
  }
  @keyframes crtOn {
    0%{transform:scale(.04,.06);opacity:1} 50%{transform:scale(1,.06);opacity:1}
    99%{transform:scale(1,1);opacity:1} 100%{opacity:0}
  }

  .mon-face { flex:0 0 auto; display:flex; justify-content:flex-end; align-items:center; height:12px; margin-top:8px; }
  .mon-led { width:8px; height:8px; background:var(--grn-d); border:2px solid var(--ink); }
  .off .mon-led { background:var(--case-d); }

  /* 목 + 받침 — 본체 위에 얹힌다 */
  .neck { width:80px; height:16px; margin:0 auto; background:var(--case-d);
          border:4px solid var(--ink); border-top:0; border-bottom:0; }
  .foot { position:relative; z-index:3; width:180px; height:12px; margin:0 auto -4px;
          background:var(--case); border:4px solid var(--ink); }

  /* ── 본체 ── */
  .tower {
    position:relative; z-index:2; width:100%; min-height:112px;
    background:var(--case); border:4px solid var(--ink);
    padding:12px; display:flex; align-items:stretch; gap:12px;
  }
  /* 실물 케이스처럼 모델명(위) → 표시등(가운데) → 환풍구(아래) 순으로 쌓는다 */
  .tower-l { flex:1 1 auto; min-width:0; display:flex; flex-direction:column; gap:10px; }
  .ctrl { display:flex; align-items:center; gap:7px; margin-top:2px; }
  .led { width:8px; height:8px; background:var(--case-d); border:2px solid var(--ink); flex:0 0 auto; }
  .led.pwr { background:var(--grn-d); }
  .powered .led.hdd { background:var(--grn-d); animation:hddblink 1.6s steps(1) infinite; }
  @keyframes hddblink { 0%,70%{opacity:.35} 74%,86%{opacity:1} 90%{opacity:.35} 96%{opacity:1} 100%{opacity:.35} }
  .off .led.pwr, .off .led.hdd { background:var(--case-d); animation:none; }
  .led.net { background:var(--case-d); }   /* 안 쓰는 자리 — 늘 꺼져 있다 */
  /* 드라이브 LED — 디스켓이 들어 있는 동안만 점멸, 접근 중에는 빨강 */
  .loaded .led.act { background:var(--grn-d); animation:bayblink 1.8s steps(1) infinite; }
  .loaded .led.act.busy { background:var(--red-d); animation:none; }
  @keyframes bayblink { 0%,55%{opacity:.35} 60%,72%{opacity:1} 78%{opacity:.35} 88%{opacity:1} 100%{opacity:.35} }
  /* 케이스에 실크스크린으로 찍힌 글자 — 발광이 아니다. 초록은 베이지 위에서
     대비가 너무 낮아 안 읽혔다. 실물처럼 짙은 글자로 인쇄한다. */
  .model { font-size:11px; font-weight:700; letter-spacing:.1em; color:#3a3830; }
  .off .model { color:#3a3830; }
  .vents { margin-top:auto; display:flex; flex-direction:column; gap:5px; }
  .vents span { height:4px; background:var(--case-d); }

  /* 드라이브 베이 */
  .bays { flex:0 0 auto; width:176px; display:flex; flex-direction:column; gap:7px; }
  .bay { position:relative; height:26px; background:var(--case-l); border:3px solid var(--ink); }
  .bay .led { position:absolute; top:50%; left:8px; margin-top:-4px; }
  .slot { position:absolute; top:50%; right:8px; transform:translateY(-50%);
          width:124px; height:7px; background:var(--ink); }
  .floppy:focus-visible { outline:3px solid #0060c0; outline-offset:3px; }
  /* 5.25" 와 CD-ROM 은 둘 다 쓰지 않는 자리 — 크기·모양이 똑같은 빈 직사각형
     커버로 막아 둔다(홈 없음). 3.5" 베이와 높이도 같다. */
  .bay.cover { background:var(--case); }

  .pwr-btn {   /* 늘 켜져 있다 — 장식 */
    flex:0 0 auto; align-self:flex-start; width:24px; height:24px;
    background:var(--grn-d); border:3px solid var(--ink);
  }


  /* ── 디스켓 ── */
  .tray { display:flex; flex-direction:column;
          align-items:center; padding-bottom:6px; }
  /* 실제 3.5" 디스켓 — 우상단만 사선으로 깎여 있고(오삽입 방지), 좌상단은 직각이다.
     셔터는 상단 가장자리에 붙은 넓은 은색 금속판이고, 가운데보다 왼쪽에서 시작해
     오른쪽에 헤드 창이 뚫려 있다(실물 사진 기준). 이전엔 작고 가운데였다.
     폭 124px — 라벨 안쪽 86px 에 "ED2 PATCH"(81px)가 들어가는 최소 크기다.
     제품명이 길어지면 이 폭도 같이 키워야 한다. */
  .floppy {
    position:relative; z-index:3; width:124px; aspect-ratio:90/94; padding:0; cursor:pointer;
    background:var(--ink); border:0;      /* 바깥 겹 = 테두리 */
    clip-path:polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);
    font:inherit; color:var(--paper);
  }
  /* clip-path 는 border 까지 잘라내 사선에 테두리가 남지 않는다.
     그래서 바깥(검정)·안쪽(몸체) 두 겹의 clip-path 로 테두리를 만든다. */
  .floppy::before {
    content:""; position:absolute; inset:4px; z-index:0; background:var(--disk);
    clip-path:polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%);
  }
  .floppy:hover:not(:disabled) { transform:translate(-2px,-2px); filter:brightness(1.15); }
  .floppy:disabled { cursor:default; }
  /* 셔터는 몸체 위쪽 가장자리에 맞붙는다 — 위 테두리를 빼서 몸체 테두리와 잇는다 */
  .fd-top { position:absolute; inset:4px 4px auto; height:30px; z-index:1;
            display:flex; justify-content:flex-start; padding-left:22px; }
  .fd-shutter { width:66px; height:30px; background:var(--steel);
                border:3px solid var(--ink); border-top:0; position:relative; }
  .fd-shutter::after {   /* 헤드 창 — 셔터 오른쪽에 뚫린 사각 구멍 */
    content:""; position:absolute; top:7px; bottom:6px; right:7px; width:22px;
    background:var(--ink); }
  .label { position:absolute; left:9px; right:9px; top:38px; bottom:9px; overflow:hidden;
           z-index:1; background:var(--paper); color:#181820;
           border:2px solid var(--ink); padding:6px 7px; text-align:left;
           font-family:var(--mono9); font-size:18px; line-height:1.35; word-break:keep-all; }
  .label b { display:block; font-size:18px; font-weight:400; letter-spacing:0;
             border-bottom:2px solid #c8c4b0; padding-bottom:4px; margin-bottom:5px; }
  .label .ver { display:block; font-size:18px; font-weight:400; letter-spacing:0; }
  .floppy.stowed { visibility:hidden; }
  /* 디스켓이 드라이브로 들어가는 동안 말풍선이 떠 있으면 어색하다.
     visibility 라 자리는 남아 디스켓 위치가 흔들리지 않는다. */
  .bubble.gone { visibility:hidden; }

  /* 슬롯까지의 이동량(--dx/--dy)과 디스켓 높이(--fh)는 JS 가 실측해 넣는다 */
  .floppy.in  { animation:insert .8s steps(12) forwards; pointer-events:none; }
  .floppy.out { animation:eject .6s steps(10) backwards; pointer-events:none; }
  /* 슬롯으로 다가가면서 작아진다 — 디스켓(116px)이 베이(폭 절반)보다 커서,
     크기 그대로 들어가면 슬롯을 뚫고 지나가는 것처럼 보인다. */
  @keyframes insert {
    0%   { transform:translate(0,0) scale(1); clip-path:inset(0 0 0 0); }
    45%  { transform:translate(var(--dx), var(--dy)) scale(var(--fs)); clip-path:inset(0 0 0 0); }
    100% { transform:translate(var(--dx), calc(var(--dy) - var(--fh) * var(--fs))) scale(var(--fs));
           clip-path:inset(100% 0 0 0); }
  }
  @keyframes eject {
    0%   { transform:translate(var(--dx), calc(var(--dy) - var(--fh) * var(--fs))) scale(var(--fs));
           clip-path:inset(100% 0 0 0); }
    50%  { transform:translate(var(--dx), var(--dy)) scale(var(--fs)); clip-path:inset(0 0 0 0); }
    100% { transform:translate(0,0) scale(1); clip-path:inset(0 0 0 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .floppy.in, .floppy.out { animation-duration:.01s; }
    .cursor, .powered .led.hdd { animation:none; }
    .crt-fx.off, .crt-fx.on { animation-duration:.01s; }
  }

  /* ── 디스켓 말풍선 ── */
  /* 복원 항목을 디스켓에 붙여 둔다. 항목이 늘어도 여기가 세로로 늘 뿐이고,
     디스켓이 여러 장이 되면 장마다 제 말풍선을 달면 된다. */
  /* width:max-content = 줄바꿈이 안 일어나는 최소 폭. 항목이 길어져도
     한 줄을 유지하고, max-width 를 넘을 때만 접힌다. */
  .bubble { position:relative; width:max-content; max-width:400px; margin:0 0 18px;
            background:var(--paper); color:var(--ink);
            border:4px solid var(--ink);
            padding:12px 14px; font-family:var(--sans); }
  .bubble b { display:block; font-size:18px; font-weight:700; margin:0 0 6px; }
  .bubble ul { margin:0; padding:0; list-style:none; }
  .bubble li { font-size:18px; line-height:1.4; margin:0 0 4px; word-break:keep-all; }
  .bubble li::before { content:"▶ "; }
  .bubble li:last-child { margin-bottom:0; }
  /* 꼬리 — 바로 아래 디스켓을 가리킨다(디스켓이 가운데라 꼬리도 가운데).
     겹친 삼각형 두 개로 테두리 있는 꼬리를 만든다. */
  .bubble::before, .bubble::after { content:""; position:absolute; top:100%; left:50%; }
  .bubble::before { margin-left:-16px; border:16px solid transparent;
                    border-bottom:0; border-top-color:var(--ink); }
  .bubble::after  { margin-left:-11px; border:11px solid transparent;
                    border-bottom:0; border-top-color:var(--paper); }

  .btn { display:block; width:100%; margin:10px 0 0; padding:8px 10px;
         font:inherit; font-size:18px; font-family:var(--sans); font-weight:700;
         color:var(--ink); background:var(--case-l); cursor:pointer;
         border:3px solid var(--ink); }
  .btn:hover:not(:disabled) { background:var(--white); }
  .btn:active:not(:disabled) { transform:translate(2px,2px); }
  .btn:disabled { display:none; }
  .btn:focus-visible { outline:3px solid #0060c0; outline-offset:3px; }

  /* ── 영상 미리보기 ── */
  /* CRT 안에서 재생한다. 페이지를 열 때는 아무것도 안 불러오고, 미리보기를 누른
     순간에만 유튜브에 요청이 나간다 — 그전까지 이 페이지의 외부 요청은 0이다. */
  .video { position:absolute; inset:0; z-index:5; background:#000; }
  .video[hidden] { display:none; }
  .video iframe, .video > div { width:100%; height:100%; border:0; display:block; }

  footer { width:min(1000px,100%); font-size:11px; color:#78787f; text-align:center; }
  footer:empty, footer:has(> span:empty) { display:none; }
  a { color:#303038; }


  /* ── 낮은 창 ───────────────────────────────────────────────────────────────
     .layout 을 창 높이에 고정해 뒀으므로, 안에 든 것들의 최소 높이 합이 그걸
     넘으면 갈 곳이 없어 위로 삐져나온다(헤더를 덮는다). 그래서 창이 낮아질수록
     단계적으로 덜 중요한 것부터 줄인다. */
  /* 4:3 을 유지한 채 장비를 통째로 한 단계씩 줄인다(유리 폭만 바꾸면 된다) */
  /* 넉넉한 창에서는 장비를 페이지 정중앙에 놓는다.
     3열 그리드([여백][장비][여백])로 두되, 말풍선이 든 3열의 폭을 0 으로 잡아
     양옆 여백을 같게 만든다 — 그래야 장비가 한가운데 온다. 말풍선은 그 자리에서
     오른쪽으로 넘쳐 그려지는데, 1280px 이상에서만 켜므로 잘릴 일이 없다. */
  /* 창 높이에 맞춰 장비를 잘게 줄인다. 유리 폭 하나만 바꾸면 4:3 은 알아서 유지된다.
     경계값은 실측에서 나왔다 — 글상자·여백이 525px 을 고정으로 먹고 장비 높이가
     0.75×유리 + 192px 이므로, 여유 = 창높이 − 717 을 0.75 로 나눈 값이 상한이다. */
  @media (max-height:1120px) {
    .notice h1 { font-size:22px; margin-bottom:10px; }
    .notice { padding:13px 18px 11px; }
  }
  /* 구간은 '아래쪽 끝'에서 성립해야 한다 — 상한식에 그 구간의 최저 높이를 넣어
     정했다. 예: (1000,1040] 구간은 vh=1001 기준 (1001-717)/0.75 = 379 → 368 채택. */
  @media (max-height:1040px) { .scene { --glass:368px; } .tower { min-height:96px; } }
  @media (max-height:1000px) { .scene { --glass:304px; } .tower { min-height:88px; }
                               /* 22px 은 좁아진 유리에 안 들어가고 11px 은 너무 작다.
                                  9px 격자 폰트로 갈아 18px 단계를 만든다. */
                               #crt { font-family:var(--mono9); font-size:18px; } }
  @media (max-height:960px)  { .scene { --glass:272px; }
                               #crt { font-family:var(--mono); font-size:11px; } }
  @media (max-height:920px)  { .scene { --glass:208px; } }
  @media (max-height:700px) {
    .scene { padding:16px 0; }
  }

  /* 좁은 화면 — 장비(640) + 여백(44) + 디스켓(116)이 안 들어간다.
     세로로 쌓고 페이지 스크롤을 되살린다. 높이를 창에 가두면 내용이 잘린다. */
  @media (max-width:880px) {
    body { height:auto; min-height:100dvh; overflow:visible; }
    .layout { height:auto; }
    .scene { padding:24px 0; }
    .group { flex-wrap:wrap; justify-content:center; align-items:center; gap:24px; }
    /* 세로로 쌓이는 구간에서는 장비가 폭을 꽉 채운다. 폭이 --glass 를 벗어나므로
       유리 비율은 aspect-ratio 로 다시 잡는다 — 여기선 페이지가 스크롤되니
       aspect-ratio 가 flex 축소를 막는 문제도 생기지 않는다. */
    .rig-body { height:auto; width:100%; }
    .monitor { flex:0 0 auto; width:100%; }
    .screen { flex:0 0 auto; height:auto; aspect-ratio:4/3; }
  }
  /* 손에 든 화면 — 글자를 줄이면 안 된다. 데스크탑과 같은 18px 을 그대로 쓴다.
     화면이 좁으니 줄 수가 늘 뿐이고, 페이지는 어차피 스크롤된다.
     위 높이별 쿼리가 11px 로 눌러 놓은 것도 여기서 되돌린다(뒤에 와서 이긴다). */
  @media (max-width:520px) {
    body { padding:12px 8px; }
    .notice { padding:14px 14px 12px; }
    .notice h1 { font-size:22px; }
    .notice h2, .notice p, .notice li { font-size:18px; }
    #crt { font-size:22px; }
    .bsod { font-size:18px; }
    /* 본체는 가로 배치를 유지한다 — 폭을 꽉 채우게 됐으니 눕힐 이유가 없다.
       베이만 조금 좁혀 좁은 화면에서도 왼쪽 표시등 자리가 남게 한다. */
    .bays { width:min(176px, 46%); }
  }
</style>
</head>
<body>

<div class="layout">
  <div class="notice top">
    <h1>영웅전설 II — 만트라 DOS판 복원 패치</h1>
    <p><span class="step">디스켓을 클릭</span>하여 설치된 폴더를 선택하면 패치가 적용됩니다.</p>
    <details class="fold" open>
      <summary class="fold-only">패치 전 확인</summary>
      <p>직접 소장한 정발판에 적용합니다. 파일은 <span class="k">브라우저 밖으로 나가지 않고</span>, 판본을 대조해 다르거나 이미 패치된 파일은 건드리지 않습니다. 원본은 <span class="k">.BAK</span> 으로 남습니다.</p>
      <p>게임이 <span class="k">Program Files</span> 같은 시스템 폴더에 있으면 브라우저가 접근을 막습니다 — 폴더를 바탕화면으로 복사해 패치한 뒤 되돌려 놓으세요.</p>
    </details>
  </div>

  <div class="scene">
   <div class="group">
    <div class="rig-body" id="rig">
      <div class="monitor">
        <div class="screen">
          <div id="crt" role="log" aria-live="polite" aria-label="패치 진행 상황"></div>
          <div class="video" id="video" hidden>
            <div id="player"></div>
          </div>
          <div class="crt-fx" id="fx" aria-hidden="true"></div>
          <div class="bsod" id="bsod" hidden role="alert">
            <b>ED PATCH PC</b>
            <p>이 브라우저에서는 패치를 실행할 수 없습니다.</p>
            <ul>
              <li>* File System Access 를 지원하지 않습니다.</li>
              <li>* Chrome 또는 Edge(데스크톱)로 다시 열어 주세요.</li>
            </ul>
            <p>계속하려면 브라우저를 바꾸십시오 <span class="blink">_</span></p>
          </div>
        </div>
        <div class="mon-face"><span class="mon-led" aria-hidden="true"></span></div>
      </div>
      <div class="neck" aria-hidden="true"></div>
      <div class="foot" aria-hidden="true"></div>

      <div class="tower">
        <div class="tower-l">
          <div class="model">ED PATCH PC</div>
          <div class="ctrl">
            <span class="led pwr" aria-hidden="true"></span>
            <span class="led hdd" aria-hidden="true"></span>
            <span class="led net" aria-hidden="true"></span>
          </div>
          <div class="vents" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>
        <div class="bays">
          <div class="bay">
            <span class="led act" id="act" aria-hidden="true"></span>
            <span class="slot" id="slot"></span>
          </div>
          <div class="bay cover" aria-hidden="true"></div>
          <div class="bay cover" aria-hidden="true"></div>
        </div>
        <span class="pwr-btn" aria-hidden="true"></span>
      </div>

    </div>

    <div class="tray">
      <div class="bubble">
        <b>복원 항목</b>
        <ul id="items"></ul>
      </div>
      <button class="floppy" id="floppy" aria-label="패치 디스켓 넣기">
        <span class="fd-top" aria-hidden="true">
          <span class="fd-shutter"></span>
        </span>
        <span class="label" id="fdlabel"></span>
      </button>
    </div>
   </div>
  </div>

  <div class="notice legal">
    <details class="fold" open>
    <summary><h2>고 지</h2></summary>
    <p>비영리 팬 복원 프로젝트이며 원작에 대한 어떠한 권리도 주장하지 않습니다. 『영웅전설』 시리즈의 모든 권리는 Nihon Falcom Corporation 및 각 권리자에게 있습니다.</p>
    <p>바뀐 바이트만 담은 차분 패치이며 게임 원본 데이터를 포함하지 않습니다. 상업적 이용을 금지하며, 권리자의 요청이 있을 경우 배포를 즉시 중단합니다.</p>
    </details>
  </div>
</div>

<footer><span id="src"></span></footer>

<script>
const SPECS = @PATCHES@;
const REPO = "@REPO@";
const VERSION = "@VERSION@";
const VIDEO = "@VIDEO@";          // 유튜브 영상 ID. 비우면 미리보기 버튼이 숨는다

const $ = (s) => document.querySelector(s);
const crt = $("#crt"), act = $("#act"), floppy = $("#floppy"), rig = $("#rig");
const fx = $("#fx");
const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

/* ---------- 패치 데이터 ---------- */

function hexToBytes(h) {
  const n = h.length >> 1, out = new Uint8Array(n);
  for (let i = 0; i < n; i++) out[i] = parseInt(h.substr(i * 2, 2), 16);
  return out;
}
/* 판정은 전적으로 파일 전체 sha1 로 한다. 스펙에 원본 바이트를 담지 않기 때문이고
   (patches/*.json 은 이 페이지에 통째로 인라인돼 공개 배포된다), 구간 비교보다
   오히려 엄격하다 — 스펙이 안 건드리는 자리가 달라도 잡아낸다. */
async function sha1(buf) {
  if (!crypto.subtle) return null;               // 비보안 컨텍스트 (아래에서 안내)
  const d = await crypto.subtle.digest("SHA-1", buf);
  return [...new Uint8Array(d)].map((b) => b.toString(16).padStart(2, "0")).join("");
}

const TARGETS = new Map();                        // 기본이름(소문자) -> 대상 정보
for (const spec of SPECS)
  for (const meta of spec.files)
    TARGETS.set(meta.file.split("/").pop().toLowerCase(), {
      meta, rel: meta.file.replace(/\//g, "\\"),
      patches: spec.patches.filter((p) => p.file === meta.file),
      bytes: spec.patches.reduce((n, p) => p.file === meta.file ? n + p.to.length / 2 : n, 0),
    });

async function inspect(bytes, t) {
  if (bytes.length !== t.meta.size)
    return { state: "mismatch", why: "크기 다름",
             hint: "이름만 같은 다른 파일입니다." };
  const h = await sha1(bytes);
  if (!h)
    return { state: "mismatch", why: "확인 불가",
             hint: "https 로 접속해야 파일을 검사할 수 있습니다." };
  if (h === t.meta.sha1_to)
    return { state: "applied", why: "패치됨" };
  if (h !== t.meta.sha1_from)
    return { state: "mismatch", why: "판본 다름",
             hint: "정발판 원본이 맞는지 확인하세요." };
  return { state: "ready" };
}
function applyTo(bytes, t) {
  const out = new Uint8Array(bytes);
  for (const p of t.patches) out.set(hexToBytes(p.to), parseInt(p.offset, 16));
  return out;
}

function esc(s) { return String(s).replace(/[&<>"]/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[c])); }

/* 디스켓 라벨은 제품명과 버전만 진다. 복원 항목은 위 안내 박스로 뺐다 —
   항목이 몇 개로 늘어도 라벨은 그대로다(라벨은 세로로 늘어날 자리가 없다). */
$("#fdlabel").innerHTML =
  "<b>ED2 PATCH</b>" + (VERSION ? `<span class="ver">v${esc(VERSION)}</span>` : "");

/* 복원 항목 — 스펙에서 만든다. 스펙이 늘면 말풍선이 세로로 늘어난다. */
$("#items").innerHTML = SPECS.map((s) =>
  `<li>${esc(s.label || s.name.replace(/^이슈\s*#\d+\s*—\s*/, ""))}</li>`).join("");

/* ---------- 화면에 트는 영상 ---------- */

/* 복원된 이벤트 녹화가 CRT 의 기본 화면이다. 무음으로 반복 재생하다가,
   패치가 시작되면 비켜서 로그를 보여주고, 끝나면 다시 돌아온다.
   무음인 이유는 브라우저가 소리 있는 자동재생을 막기 때문이다 — 재생 컨트롤을
   남겨 뒀으니 소리는 사용자가 켤 수 있다.

   주의: 이걸 기본으로 두면 페이지를 여는 순간 유튜브에 요청이 나간다.
   그게 싫으면 patcher.sh 의 VIDEO 를 비우면 된다 — 그러면 예전처럼 도스 화면만
   뜨고 이 페이지의 외부 요청은 0이 된다. */
let ytLoading = null;
function loadYT() {
  if (ytLoading) return ytLoading;
  ytLoading = new Promise((resolve) => {
    window.onYouTubeIframeAPIReady = resolve;
    const s = document.createElement("script");
    s.src = "https://www.youtube.com/iframe_api";
    s.onerror = () => resolve(null);        // 차단·오프라인이면 조용히 포기한다
    document.head.appendChild(s);
  });
  return ytLoading;
}

let player = null;
async function showVideo() {
  if (!VIDEO || !supported) return;
  $("#video").hidden = false;
  await loadYT();
  if (!window.YT || !YT.Player) { $("#video").hidden = true; return; }
  if (player) { if (player.playVideo) player.playVideo(); return; }
  player = new YT.Player("player", {
    videoId: VIDEO,
    host: "https://www.youtube-nocookie.com",   // 추적 쿠키를 덜 남기는 도메인
    playerVars: {
      autoplay: 1, mute: 1, playsinline: 1, rel: 0, modestbranding: 1,
      loop: 1, playlist: VIDEO,   // 단일 영상 반복은 playlist 를 같이 줘야 먹는다
    },
    events: { onError: hideVideo },
  });
}
/* 패치 로그를 보여주는 동안만 비킨다. 정지가 아니라 일시정지라 돌아오면 이어진다. */
function hideVideo() {
  $("#video").hidden = true;
  if (player && player.pauseVideo) player.pauseVideo();
}

/* ---------- CRT 출력 ---------- */

const sleep = (ms) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));

function put(text, cls) {
  const s = document.createElement("span");
  if (cls) s.className = cls;
  s.textContent = text + "\n";
  crt.insertBefore(s, $("#caret"));
  crt.scrollTop = crt.scrollHeight;
}
async function line(text, cls, ms = 55) { put(text, cls); await sleep(ms); }
function pad(s, n) { return s + " ".repeat(Math.max(0, n - s.length)); }
function caret(on) {
  let c = $("#caret");
  if (!c) { c = document.createElement("span"); c.id = "caret"; crt.appendChild(c); }
  c.innerHTML = on ? '<span class="l-dim">C:\\ED2&gt;</span> <span class="cursor"></span>' : "";
  crt.scrollTop = crt.scrollHeight;
}

/* ---------- 전원 / 부팅 ---------- */

let power = "off";        // off | booting | on
let busy = false;         // 패치 진행 중
let fddIn = false;        // 디스켓이 드라이브에 들어있나
let timers = [];
const supported = !!window.showDirectoryPicker;


function clearTimers() { timers.forEach(clearTimeout); timers = []; }
function flash(cls) {
  fx.className = "crt-fx";
  void fx.offsetWidth;            // 애니메이션 재시작
  fx.classList.add(cls);
}
function syncUI() {
  rig.classList.toggle("off", power === "off");
  rig.classList.toggle("powered", power === "on");
  // 드라이브 LED — 디스켓이 들어 있는 동안만 점멸(토출하면 꺼진다)
  rig.classList.toggle("loaded", fddIn && power === "on");
  floppy.disabled = !(power === "on" && !fddIn && !busy && supported);
  $(".bubble").classList.toggle("gone", fddIn || busy);
  floppy.classList.toggle("stowed", fddIn);
  floppy.title = supported ? "디스켓을 드라이브에 넣습니다" : "Chrome · Edge 가 필요합니다";
}

/** 프롬프트 화면 — 부팅 연출 없이 곧바로 쓸 수 있는 상태로 둔다. */
async function boot() {
  power = "on";
  syncUI();
  crt.innerHTML = "";
  caret(true);
  if (!supported) {                      // 화면을 블루스크린으로 덮고 디스켓도 잠근다
    $("#bsod").hidden = false;
    caret(false);
    return;
  }
  // 화면에 유일한 컨트롤이 디스켓이라는 걸 여기서 알려준다 — 그림처럼 보여서
  // 클릭할 수 있다는 게 잘 안 읽힌다.
  await line("패치 준비 완료.", "l-dim");
  await line("");
  await line("▶ 디스켓을 클릭하세요.", "l-hi");
  await line("");
  caret(true);
  showVideo();
}

/* ---------- 폴더 접근 ---------- */

async function findEntry(dir, name, kind) {
  const want = name.toLowerCase();
  for await (const [n, h] of dir.entries())
    if (h.kind === kind && n.toLowerCase() === want) return h;
  return null;
}
async function collectDirs(root) {
  const dirs = [root];
  const scena = await findEntry(root, "SCENA", "directory");
  if (scena) dirs.push(scena);
  return dirs;
}

async function run(root) {
  act.classList.add("busy");
  await line("디스크 검사 중 . . .", "l-dim", 260);

  const found = [];
  for (const dir of await collectDirs(root))
    for (const [base, t] of TARGETS) {
      const fh = await findEntry(dir, base, "file");
      if (fh && !found.some((f) => f.t === t)) found.push({ dir, fh, base, t });
    }

  if (!found.length) {
    act.classList.remove("busy");
    await line("!! 대상 파일을 찾지 못했습니다.", "l-err");
    await line(" ED2MAIN.EXE 나 SCENA 가 있는", "l-dim");
    await line(" 폴더를 선택하세요.", "l-dim");
    caret(true);
    return;
  }

  // 일부만 있으면 손대지 않는다 — 반만 패치된 게임은 원래보다 고약하다.
  const absent = [...TARGETS.values()].filter((t) => !found.some((f) => f.t === t));
  if (absent.length) {
    act.classList.remove("busy");
    await line("!! 파일이 빠졌습니다.", "l-err");
    for (const t of absent) await line(` ${t.rel}`, "l-err", 60);
    await line(" 패치를 적용하지 않았습니다.", "l-warn");
    caret(true);
    return;
  }

  const jobs = [];
  for (const f of found) {
    const bytes = new Uint8Array(await (await f.fh.getFile()).arrayBuffer());
    const r = await inspect(bytes, f.t);
    const mark = r.state === "ready" ? ["OK", "l-ok"]
               : r.state === "applied" ? [r.why, "l-warn"] : [r.why, "l-err"];
    await line(`${pad(f.t.rel, 16)}${pad(String(f.t.meta.size), 6)}${mark[0]}`, mark[1], 90);
    if (r.hint) await line(` ${r.hint}`, "l-dim", 60);
    jobs.push({ ...f, bytes, r });
  }

  // 하나라도 판본이 어긋나면 나머지도 건드리지 않는다. 짝이 안 맞는 조합으로
  // 패치되면 증상이 더 이상해진다.
  if (jobs.some((j) => j.r.state === "mismatch")) {
    act.classList.remove("busy");
    await line("");
    await line("!! 판본이 맞지 않습니다.", "l-err");
    await line(" 패치를 적용하지 않았습니다.", "l-warn");
    caret(true);
    return;
  }

  const todo = jobs.filter((j) => j.r.state === "ready");
  if (!todo.length) {
    act.classList.remove("busy");
    await line("");
    const allDone = jobs.every((j) => j.r.state === "applied");
    await line(allDone ? "이미 패치되어 있습니다." : "패치할 파일이 없습니다.",
               allDone ? "l-ok" : "l-warn");
    caret(true);
    return;
  }

  await line("");
  await line("패치 적용 중 . . .", "l-dim", 220);
  let done = 0;
  for (const j of todo) {
    try {
      if (!(await findEntry(j.dir, j.base + ".bak", "file"))) {
        const bh = await j.dir.getFileHandle(j.base.toUpperCase() + ".BAK", { create: true });
        const bw = await bh.createWritable();
        await bw.write(j.bytes); await bw.close();
      }
      const w = await j.fh.createWritable();
      await w.write(applyTo(j.bytes, j.t)); await w.close();
      await line(`${pad(j.t.rel, 16)}${pad(String(j.t.bytes) + "B", 6)}완료`, "l-ok", 130);
      done++;
    } catch (e) {
      await line(`${pad(j.t.rel, 16)}${e.message}`, "l-err", 60);
    }
  }

  act.classList.remove("busy");
  await line("");
  if (done) {
    await line(`${done}개 파일 패치 완료.`, "l-hi");
    await line("원본은 .BAK 으로 보존했습니다.", "l-dim");
  }
  caret(true);
}

/** 도스처럼 "아무 키나 누르십시오"를 띄우고 실제로 기다린다.
 *  마우스도 받는다 — 키보드가 없는 기기에서 갇히지 않게. */
function waitAnyKey() {
  caret(false);
  const p = document.createElement("span");
  p.className = "anykey";
  p.innerHTML = '\n아무 키나 누르십시오 . . . <span class="cursor"></span>';
  crt.insertBefore(p, $("#caret"));
  crt.scrollTop = crt.scrollHeight;
  return new Promise((resolve) => {
    const done = () => {
      removeEventListener("keydown", done);
      removeEventListener("pointerdown", done);
      // 문구는 로그에 남긴다 — 지우면 무슨 일이 있었는지 흔적이 사라진다.
      // 다 기다렸다는 표시로 커서만 끈다.
      p.querySelector(".cursor")?.remove();
      resolve();
    };
    addEventListener("keydown", done);
    addEventListener("pointerdown", done);
  });
}

/* ---------- 디스켓 투입 / 토출 ---------- */

/** 책상 위 디스켓 → 드라이브 슬롯까지의 이동량과 디스켓 높이를 실측한다. */
function aim() {
  floppy.style.transform = "";                  // 남은 변위가 누적되지 않게 초기화하고 잰다
  const f = floppy.getBoundingClientRect(), s = $("#slot").getBoundingClientRect();
  floppy.style.setProperty("--dx", (s.left + s.width / 2 - (f.left + f.width / 2)).toFixed(1) + "px");
  floppy.style.setProperty("--dy", (s.top + s.height / 2 - f.top).toFixed(1) + "px");
  floppy.style.setProperty("--fh", f.height.toFixed(1) + "px");
  // 슬롯 폭에 맞춰 줄어드는 배율. 슬롯이 디스켓보다 크면 1(확대는 하지 않는다).
  floppy.style.setProperty("--fs", Math.min(1, s.width / f.width).toFixed(3));
}

async function insert() {
  if (power !== "on" || fddIn || busy || !supported) return;

  let root;
  try {
    root = await window.showDirectoryPicker({ mode: "readwrite", id: "ed2" });
  } catch (e) {
    if (e.name !== "AbortError") {        // 취소는 조용히 넘긴다
      crt.innerHTML = ""; caret(false);
      await line("!! " + e.message, "l-err");
      caret(true);
    }
    return;
  }

  busy = true; syncUI();
  aim();
  floppy.classList.remove("out");
  floppy.classList.add("in");
  await sleep(950);
  // stowed 를 먼저 붙이고 in 을 뗀다. 순서가 반대면 애니메이션 종료 상태가 풀리면서
  // 디스켓이 책상 제자리에 한 프레임 나타났다 사라진다.
  fddIn = true;
  syncUI();
  floppy.classList.remove("in");
  hideVideo();                          // 디스켓이 다 들어간 뒤에 도스 화면으로 바꾼다
  crt.innerHTML = ""; caret(false);
  act.classList.add("busy");
  await line("A:\\ 디스켓을 읽는 중 . . .", "l-dim", 340);
  act.classList.remove("busy");
  busy = false; syncUI();
  await run(root);
  // 로그를 다 읽을 때까지 기다린다. 시간으로 끊으면 읽는 도중에 영상이 덮어버린다.
  await waitAnyKey();
  await ejectDisk();
  showVideo();
}

/** 작업이 끝나면 자동으로 토출한다 — 사용자가 따로 꺼낼 일이 없다. */
async function ejectDisk() {
  if (!fddIn) return;
  busy = true; syncUI();
  act.classList.add("busy");
  await sleep(220);
  act.classList.remove("busy");
  fddIn = false;
  floppy.classList.remove("stowed", "in");
  aimKeep();
  floppy.classList.add("out");
  await sleep(760);
  floppy.classList.remove("out");
  floppy.style.transform = "";
  busy = false; syncUI();
  if (power === "on") { await line("A:\\ 디스켓을 꺼냈습니다.", "l-dim"); caret(true); }
}
/** 토출은 이미 잰 --dx/--dy 를 그대로 쓴다(디스켓이 숨어 있어 다시 잴 수 없다). */
function aimKeep() {
  if (!floppy.style.getPropertyValue("--dx")) aim();
}

floppy.addEventListener("click", insert);

/* ---------- 배치 ---------- */

// 데스크톱은 헤더-본체-푸터를 세로로 쌓고 본체가 남는 높이를 먹는다(CSS flex).
// 화면이 낮으면 모니터가 세로로 줄고, 넘치는 로그는 CRT 안에서만 스크롤된다 —
// 페이지 자체에는 스크롤바가 생기지 않는다. 축소(transform:scale)는 쓰지 않는다.
// 글자가 픽셀 폰트라 정수배가 아닌 배율에서 획이 뭉개지기 때문이다.
addEventListener("resize", () => { if (!fddIn) aim(); });

/* 좁은 창에서만 접는다. 넓은 창에서는 손잡이가 숨겨져 있어 열고 닫을 수 없으므로
   반드시 펼쳐 둔 상태를 유지해야 한다. */
const narrow = matchMedia("(max-width:880px)");
function syncFolds() {
  document.querySelectorAll(".fold").forEach((d) => { d.open = !narrow.matches; });
}
narrow.addEventListener("change", syncFolds);
syncFolds();

if (REPO) $("#src").innerHTML = `소스 · <a href="${REPO}">${esc(REPO)}</a>`;
syncUI();
boot();
</script>
</body>
</html>
